// Application benchmark: config loader simulation.
// Simulates parsing nested configuration entries: each entry has a section
// (enum), a key (integer token), and a value (integer) with basic validation
// via Result.  Exercises nested struct allocation, Result error handling,
// enum match, and iteration over 10,000 config key-value pairs.
// No file I/O — pure computation with a deterministic dataset.
use std::host::stdio

enum ConfigSection {
    Server {
        port_base: i32,
    },
    Database {
        pool_base: i32,
    },
    Logging {
        level_id: i32,
    },
    Feature {
        flag: i32,
    },
}

struct ConfigEntry {
    section: ConfigSection,
    key: i32,
    value: i32,
}

fn make_entry(section: ConfigSection, key: i32, value: i32) -> ConfigEntry {
    ConfigEntry { section: section, key: key, value: value }
}

fn parse_ok_entry(i: i32, bucket: i32) -> ConfigEntry {
    if bucket == 0 {
        make_entry(ConfigSection::Server { port_base: i * 2 }, i, i * 7 + 3)
    } else {
        if bucket == 1 {
            make_entry(ConfigSection::Database { pool_base: i + 10 }, i, i * 7 + 3)
        } else {
            if bucket == 2 {
                make_entry(ConfigSection::Logging { level_id: i - i / 4 * 4 }, i, i * 7 + 3)
            } else {
                make_entry(ConfigSection::Feature { flag: i - i / 2 * 2 }, i, i * 7 + 3)
            }
        }
    }
}

fn parse_entry(i: i32) -> Result<i32, String> {
    let bucket: i32 = i - i / 4 * 4
    if i - i / 100 * 100 == 0 {
        Result::Err("reserved key")
    } else {
        Result::Ok(entry_weight(parse_ok_entry(i, bucket)))
    }
}

fn entry_weight(e: ConfigEntry) -> i32 {
    match e.section {
        ConfigSection::Server { port_base } => port_base + e.value,
        ConfigSection::Database { pool_base } => pool_base * 2 + e.value,
        ConfigSection::Logging { level_id } => level_id + e.value,
        ConfigSection::Feature { flag } => flag + e.value,
    }
}

fn main() {
    let mut sum: i32 = 0
    let mut skipped: i32 = 0
    let mut i: i32 = 1
    while i <= 10000 {
        let result: Result<i32, String> = parse_entry(i)
        match result {
            Result::Ok(w) => {
                sum = sum + w
                if sum > 1000000 {
                    sum = sum - 1000000
                }
            },
            Result::Err(_) => {
                skipped = skipped + 1
            },
        }
        i = i + 1
    }
    stdio::println((sum).to_string())
    stdio::println((skipped).to_string())
}
