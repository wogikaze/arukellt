// Stdlib benchmark: text operations (split, join, replace, case, trim).
// Exercises std::text hot paths: split, join, replace, to_lower, to_upper,
// trim, repeat, and contains.
use std::host::stdio
use std::text

fn main() {
    let base = "  Hello, Arukellt World!  "
    let mut checksum: i32 = 0
    let mut iter: i32 = 0
    while iter < 200 {
        // Trim
        let trimmed = base.trim()
        checksum = checksum + trimmed.len_bytes()

        // Split and join
        let parts = trimmed.split(" ")
        let rejoined = parts.join(",")
        checksum = checksum + rejoined.len_bytes()

        // Replace
        let replaced = rejoined.replace("Arukellt", "STDLIB")
        checksum = checksum + replaced.len_bytes()

        // Case conversion
        let lower = replaced.to_lower()
        let upper = replaced.to_upper()
        checksum = checksum + lower.len_bytes()
        checksum = checksum + upper.len_bytes()

        // Contains
        if replaced.contains("STDLIB") {
            checksum = checksum + 1
        }
        if replaced.starts_with("Hello") {
            checksum = checksum + 2
        }
        if replaced.ends_with("!") {
            checksum = checksum + 4
        }

        // Repeat
        let repeated = "x".repeat(10)
        checksum = checksum + repeated.len_bytes()

        // Builder
        let mut sb = ""
        sb = sb.concat("a")
        sb = sb.concat("b")
        sb = sb.concat("c").concat("\n")
        sb = sb
        checksum = checksum + sb.len_bytes()

        iter = iter + 1
    }
    stdio::println((checksum).to_string())
}
