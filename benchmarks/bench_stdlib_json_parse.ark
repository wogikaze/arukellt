// Stdlib benchmark: JSON parse, access, and stringify.
// Exercises std::json::parse, json_get, json_as_*, and stringify on
// structured JSON data (nested objects, arrays, scalars).
use std::host::stdio::Stdio
use std::json::parser
use std::text
fn main() {
    // Build a JSON object string
    let json_str = "{\"name\":\"bench\",\"count\":42,\"active\":true,\"tags\":[\"a\",\"b\",\"c\"],\"meta\":{\"v\":1}}".concat("")

    let mut sum: i32 = 0
    let mut iter: i32 = 0
    while iter < 50 {
        // Parse
        match parser::JsonValue::parse(json_str) {
            Result::Ok(val) => {
                // Object field access
                let name = val.get_field("name")
                match name {
                    Option::Some(_) => sum = sum + 1,
                    None => sum = sum + 10,
                }
                let count = val.get_field("count")
                match count {
                    Option::Some(cv) => {
                        let n = cv.as_i32()
                        match n {
                            Option::Some(v) => sum = sum + v,
                            None => sum = sum + 100,
                        }
                    },
                    None => sum = sum + 200,
                }
                let active = val.get_field("active")
                match active {
                    Option::Some(av) => {
                        let b = av.as_bool()
                        match b {
                            Option::Some(v) => if v { sum = sum + 7 } else { sum = sum + 70 },
                            None => sum = sum + 300,
                        }
                    },
                    None => sum = sum + 400,
                }
                // Nested access
                let meta = val.get_field("meta")
                match meta {
                    Option::Some(mv) => {
                        let v = mv.get_field("v")
                        match v {
                            Option::Some(vv) => {
                                let n = vv.as_i32()
                                match n {
                                    Option::Some(x) => sum = sum + x,
                                    None => sum = sum + 500,
                                }
                            },
                            None => sum = sum + 600,
                        }
                    },
                    None => sum = sum + 700,
                }
                // Stringify
                let _ = val.to_text()
                let _ = parser::JsonValue::pretty_text(val, 2)
            },
            Result::Err(_) => sum = sum + 1000,
        }
        iter = iter + 1
    }
    Stdio::println((sum).to_string())
}
