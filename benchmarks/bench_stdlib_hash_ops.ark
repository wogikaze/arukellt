// Stdlib benchmark: hash map insert/get with String keys and i32 values.
// Exercises the canonical generic HashMap<String, i32> method surface
// (insert/get/contains_key/remove/len), which lowers to the __hm_si
// intrinsic adapters. The table grows past its initial capacity (16) via
// Ark-side rehash + __hm_*_adopt (#895); checksum 35000 = 100 len +
// sum(7*i for i in 0..100) + 100 contains + 50 removes*2 + 50 len.
use std::host::stdio
use std::text
fn main() {
    let m = HashMap::new<String, i32>()
    let mut checksum: i32 = 0
    let mut i: i32 = 0

    // Insert 100 entries (String key, i32 value)
    while i < 100 {
        let key = "key_".concat((i).to_string())
        let prev = m.insert(key, i * 7)
        match prev {
            Option::Some(_) => checksum = checksum + 1000,
            None => {},
        }
        i = i + 1
    }
    checksum = checksum + m.len()

    // Get each entry
    i = 0
    while i < 100 {
        let key = "key_".concat((i).to_string())
        match m.get(key) {
            Option::Some(v) => checksum = checksum + v,
            None => checksum = checksum + 10000,
        }
        i = i + 1
    }

    // Containment check
    i = 0
    while i < 100 {
        let key = "key_".concat((i).to_string())
        if m.contains_key(key) {
            checksum = checksum + 1
        }
        i = i + 1
    }

    // Remove every other entry
    i = 0
    while i < 100 {
        let key = "key_".concat((i).to_string())
        match m.remove(key) {
            Option::Some(_) => checksum = checksum + 2,
            None => checksum = checksum + 20000,
        }
        i = i + 2
    }

    // Remaining size
    checksum = checksum + m.len()

    stdio::println((checksum).to_string())
}
