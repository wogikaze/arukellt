// I/O-heavy benchmark: repeated host filesystem read/write with string payloads.
// Exercises std::host::fs write/read host calls, string construction, Result
// matching, and deterministic checksum accumulation.
use std::host::fs::Fs
use std::host::stdio
use std::text
fn line_for(i: i32) -> String {
    "record:".concat((i).to_string()).concat(":payload:abcdefghijklmnopqrstuvwxyz0123456789").concat("\n")
}

fn main() {
    let mut path = "arukellt_bench_io_file_io.txt"
    let mut data = String_new()
    let mut i: i32 = 0
    while i < 200 {
        data = data.concat(line_for(i))
        i = i + 1
    }

    let mut checksum: i32 = 0
    let mut iter: i32 = 0
    while iter < 20 {
        let write_result = Fs::write_string(path, data.clone())
        match write_result {
            Result::Ok(_) => {},
            Result::Err(e) => {
                stdio::println("write error: ".concat(e))
                return
            },
        }

        let read_result = Fs::read_to_string(path)
        match read_result {
            Result::Ok(contents) => {
                checksum = checksum + len(contents)
            },
            Result::Err(e) => {
                stdio::println("read error: ".concat(e))
                return
            },
        }
        iter = iter + 1
    }

    stdio::println((len(data)).to_string())
    stdio::println((checksum).to_string())
}
