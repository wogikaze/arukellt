use std::host::stdio::Stdio
use std::core::iter
fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < 1000 {
        push(v, i)
        i = i + 1
    }
    Stdio::println((v.len()).to_string())
    let mut sum: i32 = 0
    let mut j: i32 = 0
    while j < v.len() {
        sum = sum + get_unchecked(v, j)
        j = j + 1
    }
    Stdio::println((sum).to_string())
    if v.iter().contains(500) {
        Stdio::println("found 500")
    } else {
        Stdio::println("not found 500")
    }
    if v.iter().contains(9999) {
        Stdio::println("found 9999")
    } else {
        Stdio::println("not found 9999")
    }
}
