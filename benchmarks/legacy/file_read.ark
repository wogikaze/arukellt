// file_read.ark — File I/O heavy benchmark (ADR-002 fixture).
// Writes a file once, then reads it many times to stress the host fs
// path and string construction.
use std::host::fs::Fs
use std::host::stdio::Stdio
use std::text
fn main() {
    let mut path = "arukellt_bench_file_read.txt"
    let payload = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJ\n"
    let mut data = String_from("")
    let mut i: i32 = 0
    while i < 200 {
        data = data.concat(payload)
        i = i + 1
    }

    let write_result = Fs::write_string(path, data.clone())
    match write_result {
        Result::Ok(_) => {},
        Result::Err(e) => {
            Stdio::println("write error: ".concat(e))
            return
        },
    }

    let mut checksum: i32 = 0
    let mut iter: i32 = 0
    while iter < 50 {
        let read_result = Fs::read_to_string(path)
        match read_result {
            Result::Ok(contents) => {
                checksum = checksum + contents.len()
            },
            Result::Err(e) => {
                Stdio::println("read error: ".concat(e))
                return
            },
        }
        iter = iter + 1
    }

    Stdio::println((checksum).to_string())
}
