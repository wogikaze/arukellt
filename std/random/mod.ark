//! Deterministic pseudo-random helper functions.
//!
//! Host entropy lives in `std::host::random`. This module only provides
//! seeded helpers so callers can reason about reproducibility.
//!
//! The canonical surface is the `Rng` receiver type: `Rng::new(seed)` wraps
//! the normalized seed, then `next`, `range`, or `shuffle` derive values from
//! it without touching host entropy.

fn normalize_seed(seed_val: i32) -> i32 {
    if seed_val == 0 {
        42
    } else {
        seed_val
    }
}

/// Generate the next deterministic pseudo-random value from a seed.
///
/// Uses a xorshift32-style step and never returns zero.
fn next_seeded(seed_val: i32) -> i32 {
    let mut x = normalize_seed(seed_val)
    x = x ^ (x << 13)
    x = x ^ (x >> 17)
    x = x ^ (x << 5)
    if x == 0 {
        1
    } else {
        x
    }
}

/// Map a seed to a deterministic value in `[lo, hi)`.
///
/// If `hi <= lo`, returns `lo`.
fn seeded_range_from(seed_val: i32, lo: i32, hi: i32) -> i32 {
    let r = next_seeded(seed_val)
    let range = hi - lo
    if range <= 0 {
        lo
    } else {
        let val = r % range
        if val < 0 {
            lo + val + range
        } else {
            lo + val
        }
    }
}

fn shuffle_i32_from(v: Vec<i32>, seed_val: i32) -> Vec<i32> {
    let n = v.len()
    let mut result = Vec::new<i32>()
    let mut i = 0
    while i < n {
        result.push(get_unchecked(v, i))
        i = i + 1
    }
    let mut seed = normalize_seed(seed_val)
    let mut j = n - 1
    while j > 0 {
        seed = next_seeded(seed)
        let idx = seeded_range_from(seed, 0, j + 1)
        let tmp = get_unchecked(result, j)
        result.set(j, get_unchecked(result, idx))
        result.set(idx, tmp)
        j = j - 1
    }
    result
}

/// Deterministic xorshift32 random source.
pub struct Rng {
    seed: i32,
}

impl Rng {
    /// Creates a deterministic source from an explicit seed.
    ///
    /// Seed `0` is normalized to `42`, matching the former seeded helpers.
    fn new(seed_val: i32) -> Rng {
        Rng { seed: normalize_seed(seed_val) }
    }

    /// Returns the next pseudo-random value; never zero.
    fn next(self: Rng) -> i32 {
        next_seeded(self.seed)
    }

    /// Returns a deterministic value in `[lo, hi)`.
    ///
    /// If `hi <= lo`, returns `lo`.
    fn range(self: Rng, lo: i32, hi: i32) -> i32 {
        seeded_range_from(self.seed, lo, hi)
    }

    /// Returns a shuffled copy of `v`.
    fn shuffle(self: Rng, v: Vec<i32>) -> Vec<i32> {
        shuffle_i32_from(v, self.seed)
    }
}
