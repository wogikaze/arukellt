//! Container `Debug` renderings for `std::text`.
//!
//! Scalar and `String` `Debug` implementations live in `std::core::convert`
//! and are reached through `value.fmt_debug()`. The compiler cannot yet
//! resolve a generic `impl Debug for Vec<T>`; a `Vec<i32>` receiver also loses
//! its element type inside an inherent method, so the container renderings
//! stay associated functions on `DebugFormat` instead of free functions.
use std::core::convert

/// Namespace for container `Debug` renderings.
pub struct DebugFormat {
}

impl DebugFormat {
    /// `Debug` rendering of `Vec<i32>`: `[1, 2, 3]`.
    fn vec_i32(v: Vec<i32>) -> String {
        let n = v.len()
        let mut out = "["
        let mut i = 0
        while i < n {
            match get(v, i) {
                Option::Some(value) => {
                    out = __intrinsic_concat(out, value.fmt_debug())
                }
                Option::None => {}
            }
            if i < n - 1 {
                out = __intrinsic_concat(out, ", ")
            }
            i = i + 1
        }
        __intrinsic_concat(out, "]")
    }

    /// `Debug` rendering of `Vec<i64>`: `[1, 2, 3]`.
    fn vec_i64(v: Vec<i64>) -> String {
        let n = v.len()
        let mut out = "["
        let mut i = 0
        while i < n {
            match get(v, i) {
                Option::Some(value) => {
                    out = __intrinsic_concat(out, value.fmt_debug())
                }
                Option::None => {}
            }
            if i < n - 1 {
                out = __intrinsic_concat(out, ", ")
            }
            i = i + 1
        }
        __intrinsic_concat(out, "]")
    }

    /// `Debug` rendering of `Vec<f64>`: `[1.5, 2.5]`.
    fn vec_f64(v: Vec<f64>) -> String {
        let n = v.len()
        let mut out = "["
        let mut i = 0
        while i < n {
            match get(v, i) {
                Option::Some(value) => {
                    out = __intrinsic_concat(out, value.fmt_debug())
                }
                Option::None => {}
            }
            if i < n - 1 {
                out = __intrinsic_concat(out, ", ")
            }
            i = i + 1
        }
        __intrinsic_concat(out, "]")
    }

    /// `Debug` rendering of `Vec<bool>`: `[true, false]`.
    fn vec_bool(v: Vec<bool>) -> String {
        let n = v.len()
        let mut out = "["
        let mut i = 0
        while i < n {
            match get(v, i) {
                Option::Some(value) => {
                    out = __intrinsic_concat(out, value.fmt_debug())
                }
                Option::None => {}
            }
            if i < n - 1 {
                out = __intrinsic_concat(out, ", ")
            }
            i = i + 1
        }
        __intrinsic_concat(out, "]")
    }

    /// `Debug` rendering of `Vec<String>`: `["a", "b"]`.
    fn vec_string(v: Vec<String>) -> String {
        let n = v.len()
        let mut out = "["
        let mut i = 0
        while i < n {
            match get(v, i) {
                Option::Some(value) => {
                    out = __intrinsic_concat(out, value.fmt_debug())
                }
                Option::None => {}
            }
            if i < n - 1 {
                out = __intrinsic_concat(out, ", ")
            }
            i = i + 1
        }
        __intrinsic_concat(out, "]")
    }

    /// `Debug` rendering of `Option<i32>`: `Some(42)` / `None`.
    fn option_i32(value: Option<i32>) -> String {
        match value {
            Option::Some(inner) => __intrinsic_concat(
                "Some(",
                __intrinsic_concat(inner.fmt_debug(), ")")
            ),
            Option::None => "None",
        }
    }

    /// `Debug` rendering of `Option<String>`: `Some("msg")` / `None`.
    fn option_string(value: Option<String>) -> String {
        match value {
            Option::Some(inner) => __intrinsic_concat(
                "Some(",
                __intrinsic_concat(inner.fmt_debug(), ")")
            ),
            Option::None => "None",
        }
    }

    /// `Debug` rendering of `Result<i32, String>`: `Ok(42)` / `Err("msg")`.
    fn result_i32_string(value: Result<i32, String>) -> String {
        match value {
            Result::Ok(inner) => __intrinsic_concat(
                "Ok(",
                __intrinsic_concat(inner.fmt_debug(), ")")
            ),
            Result::Err(error) => __intrinsic_concat(
                "Err(",
                __intrinsic_concat(error.fmt_debug(), ")")
            ),
        }
    }

    /// `Debug` rendering of `Result<String, String>`: `Ok("ok")` / `Err("msg")`.
    fn result_string_string(value: Result<String, String>) -> String {
        match value {
            Result::Ok(inner) => __intrinsic_concat(
                "Ok(",
                __intrinsic_concat(inner.fmt_debug(), ")")
            ),
            Result::Err(error) => __intrinsic_concat(
                "Err(",
                __intrinsic_concat(error.fmt_debug(), ")")
            ),
        }
    }
}
