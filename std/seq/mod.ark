//! Deprecated `Vec<i32>` sequence helpers plus the provisional `sort_by`.
//!
//! `map`/`filter`/`take`/`skip`/`fold`/`sum` and the query helpers
//! (`binary_search`, `min_i32`, `max_i32`, `seq_reverse`,
//! `seq_contains`, `unique`, `count_eq`) are deprecated compatibility
//! entries. The transformation helpers delegate to the lazy iterator methods;
//! the query helpers keep local i32 loops so this deprecated module stays
//! independent of the `std::collections::vec` extension surface. Each wrapper
//! retires with the #703 Wave 2.
//!
//! `sort_by<T: Ord>` remains provisional: its `Vec<T: Ord>` method replacement
//! is not correct for `Vec<i64>` at 5+ elements on every target yet (#965).
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

use std::core
use std::core::cmp
use std::core::iter

// ─── Transformation operations ──────────────────────────────────────────────
/// Apply `f` to every element of `v` and collect the results.
pub fn map_i32_i32(v: Vec<i32>, f: fn(i32) -> i32) -> Vec<i32> {
    v.iter().map(f).collect()
}

/// Keep only elements of `v` for which `f` returns `true`.
pub fn filter_i32(v: Vec<i32>, f: fn(i32) -> bool) -> Vec<i32> {
    v.iter().filter(f).collect()
}

/// Return the first `n` elements of `v`.
pub fn take_i32(v: Vec<i32>, n: i32) -> Vec<i32> {
    v.iter().take(n).collect()
}

/// Return all elements of `v` after skipping the first `n`.
pub fn skip_i32(v: Vec<i32>, n: i32) -> Vec<i32> {
    v.iter().skip(n).collect()
}

/// Reduce `v` to a single value using `f`, starting from `init`.
pub fn fold_i32_i32(v: Vec<i32>, init: i32, f: fn(i32, i32) -> i32) -> i32 {
    v.iter().fold(init, f)
}

// ─── Query operations ────────────────────────────────────────────────────────
pub fn binary_search(v: Vec<i32>, target: i32) -> i32 {
    let mut lo: i32 = 0
    let mut hi: i32 = len(v) - 1
    let mut result: i32 = 0 - 1
    while lo <= hi {
        let mid: i32 = lo + (hi - lo) / 2
        let current = get_unchecked(v, mid)
        if current == target {
            result = mid
            lo = hi + 1
        } else if current < target {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    result
}

pub fn min_i32(v: Vec<i32>) -> i32 {
    let count: i32 = len(v)
    let mut best = get_unchecked(v, 0)
    let mut index: i32 = 1
    while index < count {
        let current = get_unchecked(v, index)
        if current < best {
            best = current
        }
        index = index + 1
    }
    best
}

pub fn max_i32(v: Vec<i32>) -> i32 {
    let count: i32 = len(v)
    let mut best = get_unchecked(v, 0)
    let mut index: i32 = 1
    while index < count {
        let current = get_unchecked(v, index)
        if current > best {
            best = current
        }
        index = index + 1
    }
    best
}

pub fn sum_i32(v: Vec<i32>) -> i32 {
    v.iter().sum()
}

pub fn seq_reverse(v: Vec<i32>) -> Vec<i32> {
    v.iter().rev().collect()
}

pub fn seq_contains(v: Vec<i32>, target: i32) -> bool {
    v.iter().contains(target)
}

pub fn unique(v: Vec<i32>) -> Vec<i32> {
    let count: i32 = len(v)
    let mut out: Vec<i32> = Vec::new<i32>()
    let mut index: i32 = 0
    while index < count {
        let value = get_unchecked(v, index)
        let mut seen: bool = false
        let mut scan: i32 = 0
        while scan < len(out) {
            if get_unchecked(out, scan) == value {
                seen = true
                break
            }
            scan = scan + 1
        }
        if !seen {
            push(out, value)
        }
        index = index + 1
    }
    out
}

pub fn count_eq(v: Vec<i32>, target: i32) -> i32 {
    v.iter().count_eq(target)
}

// ── comparison-based algorithms (Ord trait) ─────────────────────────────────

/// Sorts `v` in place into ascending order using the `Ord::cmp` method.
///
/// Uses an insertion sort — O(n²) worst case but stable and allocation-free.
/// The input `Vec<T>` is mutated in place and also returned for convenience.
///
/// Retained as `provisional` by #917: the `Vec<T: Ord>` replacement
/// (`v.sort()`) miscompiles `Vec<i64>` at 5+ elements on the linear and
/// core-emit paths, so this allocation-free form stays the reachable generic
/// `Ord` sort until the method scratch layout is fixed (#965).
pub fn sort_by<T: Ord>(mut v: Vec<T>) -> Vec<T> {
    let n: i32 = len(v)
    let mut i: i32 = 1
    while i < n {
        let mut j: i32 = i
        while j > 0 {
            let cur = get_unchecked(v, j)
            let prev = get_unchecked(v, j - 1)
            match prev.cmp(cur) {
                Ordering::Greater => {
                    set(v, j, prev)
                    set(v, j - 1, cur)
                }
                _ => {
                    break
                }
            }
            j = j - 1
        }
        i = i + 1
    }
    v
}
