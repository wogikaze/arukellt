//! Ordered collection types backed by flat sorted vectors.
//!
//! `SortedMap` and `BTreeMap` store `i32` key/value pairs sorted by key;
//! `BTreeSet` stores sorted unique `i32` values, `IndexSet` stores unique
//! values in insertion order, `IndexMap` keeps insertion order, and `BitSet`
//! packs bit flags into 32-bit words. Every store is a flat `Vec<i32>`: a
//! nested generic container does not lower on both targets, so the layout is
//! packed instead.
//!
//! The receiver methods below are the canonical surface. The `sorted_map_*`
//! and `bitset_*` free functions remain callable as `deprecated` entries
//! through the ADR-087 window; the `btree_*`, `btree_set_*`, `index_map_*`,
//! and `index_set_*` free functions were retired with E0100 replacement hints.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

// ── Sorted map store ─────────────────────────────────────────────────────
// Layout: [count, key0, value0, key1, value1, ...] sorted by key.

fn ordered_map_new_store() -> Vec<i32> {
    let mut entries: Vec<i32> = Vec::new<i32>()
    push(entries, 0)
    entries
}

fn ordered_map_len(entries: Vec<i32>) -> i32 {
    get_unchecked(entries, 0)
}

fn ordered_map_find_idx(entries: Vec<i32>, key: i32) -> i32 {
    let count: i32 = get_unchecked(entries, 0)
    let mut lo: i32 = 0
    let mut hi: i32 = count
    while lo < hi {
        let mid: i32 = (lo + hi) / 2
        let mid_key: i32 = get_unchecked(entries, 1 + mid * 2)
        if mid_key < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

fn ordered_map_get(entries: Vec<i32>, key: i32) -> i32 {
    let count: i32 = get_unchecked(entries, 0)
    let idx: i32 = ordered_map_find_idx(entries, key)
    if idx < count {
        let found_key: i32 = get_unchecked(entries, 1 + idx * 2)
        if found_key == key {
            get_unchecked(entries, 1 + idx * 2 + 1)
        } else {
            0
        }
    } else {
        0
    }
}

fn ordered_map_contains(entries: Vec<i32>, key: i32) -> bool {
    let count: i32 = get_unchecked(entries, 0)
    let idx: i32 = ordered_map_find_idx(entries, key)
    if idx < count {
        get_unchecked(entries, 1 + idx * 2) == key
    } else {
        false
    }
}

fn ordered_map_insert(mut entries: Vec<i32>, key: i32, value: i32) {
    let count: i32 = get_unchecked(entries, 0)
    let idx: i32 = ordered_map_find_idx(entries, key)
    if idx < count {
        let found_key: i32 = get_unchecked(entries, 1 + idx * 2)
        if found_key == key {
            set(entries, 1 + idx * 2 + 1, value)
        } else {
            push(entries, 0)
            push(entries, 0)
            let mut i: i32 = count - 1
            while i >= idx {
                let src: i32 = 1 + i * 2
                let dst: i32 = 1 + (i + 1) * 2
                set(entries, dst, get_unchecked(entries, src))
                set(entries, dst + 1, get_unchecked(entries, src + 1))
                i = i - 1
            }
            set(entries, 1 + idx * 2, key)
            set(entries, 1 + idx * 2 + 1, value)
            set(entries, 0, count + 1)
        }
    } else {
        push(entries, key)
        push(entries, value)
        set(entries, 0, count + 1)
    }
}

fn ordered_map_remove(mut entries: Vec<i32>, key: i32) {
    let count: i32 = get_unchecked(entries, 0)
    let idx: i32 = ordered_map_find_idx(entries, key)
    if idx < count {
        let found_key: i32 = get_unchecked(entries, 1 + idx * 2)
        if found_key == key {
            let mut i: i32 = idx
            while i < count - 1 {
                let src: i32 = 1 + (i + 1) * 2
                let dst: i32 = 1 + i * 2
                set(entries, dst, get_unchecked(entries, src))
                set(entries, dst + 1, get_unchecked(entries, src + 1))
                i = i + 1
            }
            let _: Option<i32> = pop(entries)
            let _: Option<i32> = pop(entries)
            set(entries, 0, count - 1)
        }
    }
}

fn ordered_map_keys(entries: Vec<i32>) -> Vec<i32> {
    let count: i32 = get_unchecked(entries, 0)
    let mut keys: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < count {
        push(keys, get_unchecked(entries, 1 + i * 2))
        i = i + 1
    }
    keys
}

fn ordered_map_range(entries: Vec<i32>, start: i32, end: i32) -> Vec<i32> {
    let count: i32 = get_unchecked(entries, 0)
    let mut result: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < count {
        let key: i32 = get_unchecked(entries, 1 + i * 2)
        if key >= start {
            if key < end {
                push(result, key)
            }
        }
        i = i + 1
    }
    result
}

/// Map from `i32` keys to `i32` values, read back in ascending key order.
///
/// Lookups binary-search the sorted pair vector (`O(log n)`); insertion and
/// removal shift the tail (`O(n)`). A missing key returns `0` from `get` and
/// `false` from `contains`, matching the deprecated free functions.
pub struct SortedMap {
    entries: Vec<i32>,
}

impl SortedMap {
    /// Creates an empty map.
    fn new() -> SortedMap {
        SortedMap { entries: ordered_map_new_store() }
    }

    /// Returns the number of entries.
    fn len(self: SortedMap) -> i32 {
        ordered_map_len(self.entries)
    }

    /// Returns the first sorted index whose key is not less than `key`.
    fn find_idx(self: SortedMap, key: i32) -> i32 {
        ordered_map_find_idx(self.entries, key)
    }

    /// Returns the value for `key`, or `0` when the key is absent.
    fn get(self: SortedMap, key: i32) -> i32 {
        ordered_map_get(self.entries, key)
    }

    /// Returns true when `key` has an entry.
    fn contains(self: SortedMap, key: i32) -> bool {
        ordered_map_contains(self.entries, key)
    }

    /// Inserts or overwrites the entry for `key`.
    fn insert(mut self: SortedMap, key: i32, value: i32) {
        ordered_map_insert(self.entries, key, value)
    }
}

/// Map from `i32` keys to `i32` values with key-sorted iteration.
///
/// The historical `btree_*` family was backed by a sorted vector, not a node
/// tree; the receiver methods keep that storage and contract. Use `remove`,
/// `keys`, and `range` on top of the `SortedMap` read surface.
pub struct BTreeMap {
    entries: Vec<i32>,
}

impl BTreeMap {
    /// Creates an empty map.
    fn new() -> BTreeMap {
        BTreeMap { entries: ordered_map_new_store() }
    }

    /// Inserts or overwrites the entry for `key`.
    fn insert(mut self: BTreeMap, key: i32, value: i32) {
        ordered_map_insert(self.entries, key, value)
    }

    /// Returns the value for `key`, or `0` when the key is absent.
    fn get(self: BTreeMap, key: i32) -> i32 {
        ordered_map_get(self.entries, key)
    }

    /// Removes the entry for `key` when present.
    fn remove(mut self: BTreeMap, key: i32) {
        ordered_map_remove(self.entries, key)
    }

    /// Returns true when `key` has an entry.
    fn contains_key(self: BTreeMap, key: i32) -> bool {
        ordered_map_contains(self.entries, key)
    }

    /// Returns the number of entries.
    fn len(self: BTreeMap) -> i32 {
        ordered_map_len(self.entries)
    }

    /// Returns all keys in ascending order.
    fn keys(self: BTreeMap) -> Vec<i32> {
        ordered_map_keys(self.entries)
    }

    /// Returns the keys in `[start, end)` in ascending order.
    fn range(self: BTreeMap, start: i32, end: i32) -> Vec<i32> {
        ordered_map_range(self.entries, start, end)
    }
}

// ── Sorted set store ─────────────────────────────────────────────────────
// Layout: [count, value0, value1, ...] sorted ascending, unique.

fn ordered_set_new_store() -> Vec<i32> {
    let mut entries: Vec<i32> = Vec::new<i32>()
    push(entries, 0)
    entries
}

fn ordered_set_find_idx(entries: Vec<i32>, value: i32) -> i32 {
    let count: i32 = get_unchecked(entries, 0)
    let mut lo: i32 = 0
    let mut hi: i32 = count
    while lo < hi {
        let mid: i32 = (lo + hi) / 2
        let mid_value: i32 = get_unchecked(entries, 1 + mid)
        if mid_value < value {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

fn ordered_set_insert(mut entries: Vec<i32>, value: i32) -> bool {
    let count: i32 = get_unchecked(entries, 0)
    let idx: i32 = ordered_set_find_idx(entries, value)
    if idx < count {
        let found_value: i32 = get_unchecked(entries, 1 + idx)
        if found_value == value {
            false
        } else {
            push(entries, 0)
            let mut i: i32 = count - 1
            while i >= idx {
                set(entries, 1 + i + 1, get_unchecked(entries, 1 + i))
                i = i - 1
            }
            set(entries, 1 + idx, value)
            set(entries, 0, count + 1)
            true
        }
    } else {
        push(entries, value)
        set(entries, 0, count + 1)
        true
    }
}

fn ordered_set_contains(entries: Vec<i32>, value: i32) -> bool {
    let count: i32 = get_unchecked(entries, 0)
    let idx: i32 = ordered_set_find_idx(entries, value)
    if idx < count {
        get_unchecked(entries, 1 + idx) == value
    } else {
        false
    }
}

fn ordered_set_len(entries: Vec<i32>) -> i32 {
    get_unchecked(entries, 0)
}

/// Set of unique `i32` values, read back in ascending order.
///
/// `insert` returns true only when the value was newly added; membership
/// binary-searches the sorted value vector.
pub struct BTreeSet {
    entries: Vec<i32>,
}

impl BTreeSet {
    /// Creates an empty set.
    fn new() -> BTreeSet {
        BTreeSet { entries: ordered_set_new_store() }
    }

    /// Inserts `value` and returns true when it was not already present.
    fn insert(mut self: BTreeSet, value: i32) -> bool {
        ordered_set_insert(self.entries, value)
    }

    /// Returns true when `value` is present.
    fn contains(self: BTreeSet, value: i32) -> bool {
        ordered_set_contains(self.entries, value)
    }

    /// Returns the number of values.
    fn len(self: BTreeSet) -> i32 {
        ordered_set_len(self.entries)
    }
}

// ── Insertion-order map store ────────────────────────────────────────────
// Layout: [count, key0, value0, key1, value1, ...] in insertion order.

fn index_map_new_store() -> Vec<i32> {
    let mut entries: Vec<i32> = Vec::new<i32>()
    push(entries, 0)
    entries
}

fn index_map_insert(mut entries: Vec<i32>, key: i32, value: i32) {
    let count: i32 = get_unchecked(entries, 0)
    let mut i: i32 = 0
    let mut found: bool = false
    while i < count {
        let existing_key: i32 = get_unchecked(entries, 1 + i * 2)
        if existing_key == key {
            set(entries, 1 + i * 2 + 1, value)
            found = true
            i = count
        } else {
            i = i + 1
        }
    }
    if found == false {
        push(entries, key)
        push(entries, value)
        set(entries, 0, count + 1)
    }
}

fn index_map_get(entries: Vec<i32>, key: i32) -> i32 {
    let count: i32 = get_unchecked(entries, 0)
    let mut i: i32 = 0
    let mut result: i32 = 0
    while i < count {
        let existing_key: i32 = get_unchecked(entries, 1 + i * 2)
        if existing_key == key {
            result = get_unchecked(entries, 1 + i * 2 + 1)
            i = count
        } else {
            i = i + 1
        }
    }
    result
}

fn index_map_len(entries: Vec<i32>) -> i32 {
    get_unchecked(entries, 0)
}

fn index_map_keys(entries: Vec<i32>) -> Vec<i32> {
    let count: i32 = get_unchecked(entries, 0)
    let mut keys: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < count {
        push(keys, get_unchecked(entries, 1 + i * 2))
        i = i + 1
    }
    keys
}

/// Map from `i32` keys to `i32` values that keeps insertion order.
///
/// Lookup and insertion scan the pair vector linearly (`O(n)`), so this type
/// is for small ordered maps; unlike `BTreeMap`, `keys()` never reorders.
pub struct IndexMap {
    entries: Vec<i32>,
}

impl IndexMap {
    /// Creates an empty map.
    fn new() -> IndexMap {
        IndexMap { entries: index_map_new_store() }
    }

    /// Inserts or overwrites the entry for `key` without moving it.
    fn insert(mut self: IndexMap, key: i32, value: i32) {
        index_map_insert(self.entries, key, value)
    }

    /// Returns the value for `key`, or `0` when the key is absent.
    fn get(self: IndexMap, key: i32) -> i32 {
        index_map_get(self.entries, key)
    }

    /// Returns the number of entries.
    fn len(self: IndexMap) -> i32 {
        index_map_len(self.entries)
    }

    /// Returns all keys in insertion order.
    fn keys(self: IndexMap) -> Vec<i32> {
        index_map_keys(self.entries)
    }
}

// ── Insertion-order set store ─────────────────────────────────────────────
// Layout: [count, value0, value1, ...] in insertion order, unique.

fn index_set_new_store() -> Vec<i32> {
    let mut entries: Vec<i32> = Vec::new<i32>()
    push(entries, 0)
    entries
}

fn index_set_contains(entries: Vec<i32>, value: i32) -> bool {
    let count: i32 = get_unchecked(entries, 0)
    let mut i: i32 = 0
    let mut found: bool = false
    while i < count {
        let existing_value: i32 = get_unchecked(entries, 1 + i)
        if existing_value == value {
            found = true
            i = count
        } else {
            i = i + 1
        }
    }
    found
}

fn index_set_insert(mut entries: Vec<i32>, value: i32) -> bool {
    let already: bool = index_set_contains(entries, value)
    if already == false {
        let count: i32 = get_unchecked(entries, 0)
        push(entries, value)
        set(entries, 0, count + 1)
        true
    } else {
        false
    }
}

fn index_set_len(entries: Vec<i32>) -> i32 {
    get_unchecked(entries, 0)
}

/// Set of unique `i32` values that keeps insertion order.
///
/// `insert` returns true only when the value was newly added; every operation
/// scans the flat value vector (`O(n)`).
pub struct IndexSet {
    entries: Vec<i32>,
}

impl IndexSet {
    /// Creates an empty set.
    fn new() -> IndexSet {
        IndexSet { entries: index_set_new_store() }
    }

    /// Inserts `value` and returns true when it was not already present.
    fn insert(mut self: IndexSet, value: i32) -> bool {
        index_set_insert(self.entries, value)
    }

    /// Returns true when `value` is present.
    fn contains(self: IndexSet, value: i32) -> bool {
        index_set_contains(self.entries, value)
    }

    /// Returns the number of values.
    fn len(self: IndexSet) -> i32 {
        index_set_len(self.entries)
    }
}

// ── Bit set store ─────────────────────────────────────────────────────────
// Layout: [capacity_in_bits, word0, word1, ...], 32 bits per word.

const BITSET_DEFAULT_CAPACITY: i32 = 256
const BITSET_BITS_PER_WORD: i32 = 32

fn bitset_store(capacity: i32) -> Vec<i32> {
    let mut store: Vec<i32> = Vec::new<i32>()
    push(store, capacity)
    let words: i32 = (capacity + BITSET_BITS_PER_WORD - 1) / BITSET_BITS_PER_WORD
    let mut i: i32 = 0
    while i < words {
        push(store, 0)
        i = i + 1
    }
    store
}

fn bitset_mark_store(mut store: Vec<i32>, bit: i32) {
    let word: i32 = bit / BITSET_BITS_PER_WORD
    let offset: i32 = bit % BITSET_BITS_PER_WORD
    let old: i32 = get_unchecked(store, 1 + word)
    let mask: i32 = 1 << offset
    set(store, 1 + word, old | mask)
}

fn bitset_unmark_store(mut store: Vec<i32>, bit: i32) {
    let word: i32 = bit / BITSET_BITS_PER_WORD
    let offset: i32 = bit % BITSET_BITS_PER_WORD
    let old: i32 = get_unchecked(store, 1 + word)
    let mask: i32 = 1 << offset
    let inverted: i32 = mask ^ 0 - 1
    set(store, 1 + word, old & inverted)
}

fn bitset_test_store(store: Vec<i32>, bit: i32) -> bool {
    let word: i32 = bit / BITSET_BITS_PER_WORD
    let offset: i32 = bit % BITSET_BITS_PER_WORD
    let value: i32 = get_unchecked(store, 1 + word)
    let shifted: i32 = value >> offset
    let masked: i32 = shifted & 1
    masked == 1
}

fn bitset_count_store(store: Vec<i32>) -> i32 {
    let capacity: i32 = get_unchecked(store, 0)
    let words: i32 = (capacity + BITSET_BITS_PER_WORD - 1) / BITSET_BITS_PER_WORD
    let mut total: i32 = 0
    let mut w: i32 = 0
    while w < words {
        let mut value: i32 = get_unchecked(store, 1 + w)
        while value != 0 {
            value = value & (value - 1)
            total = total + 1
        }
        w = w + 1
    }
    total
}

fn bitset_union_store(left: Vec<i32>, right: Vec<i32>) -> Vec<i32> {
    let left_capacity: i32 = get_unchecked(left, 0)
    let right_capacity: i32 = get_unchecked(right, 0)
    let mut capacity: i32 = left_capacity
    if right_capacity > left_capacity {
        capacity = right_capacity
    }
    let mut result: Vec<i32> = bitset_store(capacity)
    let left_words: i32 = (left_capacity + BITSET_BITS_PER_WORD - 1) / BITSET_BITS_PER_WORD
    let right_words: i32 = (right_capacity + BITSET_BITS_PER_WORD - 1) / BITSET_BITS_PER_WORD
    let words: i32 = (capacity + BITSET_BITS_PER_WORD - 1) / BITSET_BITS_PER_WORD
    let mut i: i32 = 0
    while i < words {
        let mut left_word: i32 = 0
        let mut right_word: i32 = 0
        if i < left_words {
            left_word = get_unchecked(left, 1 + i)
        }
        if i < right_words {
            right_word = get_unchecked(right, 1 + i)
        }
        set(result, 1 + i, left_word | right_word)
        i = i + 1
    }
    result
}

fn bitset_intersection_store(left: Vec<i32>, right: Vec<i32>) -> Vec<i32> {
    let left_capacity: i32 = get_unchecked(left, 0)
    let right_capacity: i32 = get_unchecked(right, 0)
    let mut capacity: i32 = left_capacity
    if right_capacity < left_capacity {
        capacity = right_capacity
    }
    let mut result: Vec<i32> = bitset_store(capacity)
    let words: i32 = (capacity + BITSET_BITS_PER_WORD - 1) / BITSET_BITS_PER_WORD
    let mut i: i32 = 0
    while i < words {
        let left_word: i32 = get_unchecked(left, 1 + i)
        let right_word: i32 = get_unchecked(right, 1 + i)
        set(result, 1 + i, left_word & right_word)
        i = i + 1
    }
    result
}

/// Fixed-capacity bit array backed by 32-bit words.
///
/// `new` reserves 256 bits; `with_capacity` reserves an explicit bit count.
/// Bits outside the capacity are not addressable, and `union` /
/// `intersection` size the result by the larger / smaller operand capacity.
pub struct BitSet {
    store: Vec<i32>,
}

impl BitSet {
    /// Creates an empty set with 256 bits of capacity.
    fn new() -> BitSet {
        BitSet { store: bitset_store(BITSET_DEFAULT_CAPACITY) }
    }

    /// Creates an empty set with `capacity` bits of capacity.
    fn with_capacity(capacity: i32) -> BitSet {
        BitSet { store: bitset_store(capacity) }
    }

    /// Sets `bit`.
    fn mark(mut self: BitSet, bit: i32) {
        bitset_mark_store(self.store, bit)
    }

    /// Clears `bit`.
    fn unmark(mut self: BitSet, bit: i32) {
        bitset_unmark_store(self.store, bit)
    }

    /// Sets `bit`; alias of `mark`.
    fn set(mut self: BitSet, bit: i32) {
        bitset_mark_store(self.store, bit)
    }

    /// Clears `bit`; alias of `unmark`.
    fn clear(mut self: BitSet, bit: i32) {
        bitset_unmark_store(self.store, bit)
    }

    /// Returns true when `bit` is set.
    fn test(self: BitSet, bit: i32) -> bool {
        bitset_test_store(self.store, bit)
    }

    /// Returns the number of set bits.
    fn count(self: BitSet) -> i32 {
        bitset_count_store(self.store)
    }

    /// Returns a new set with the bits of both operands.
    fn union(self: BitSet, other: BitSet) -> BitSet {
        BitSet { store: bitset_union_store(self.store, other.store) }
    }

    /// Returns a new set with the bits present in both operands.
    fn intersection(self: BitSet, other: BitSet) -> BitSet {
        BitSet { store: bitset_intersection_store(self.store, other.store) }
    }
}

// ── Deprecated free functions (ADR-087 window) ───────────────────────────

pub fn sorted_map_new() -> Vec<i32> {
    ordered_map_new_store()
}

pub fn sorted_map_len(entries: Vec<i32>) -> i32 {
    ordered_map_len(entries)
}

pub fn sorted_map_find_idx(entries: Vec<i32>, key: i32) -> i32 {
    ordered_map_find_idx(entries, key)
}

pub fn sorted_map_get(entries: Vec<i32>, key: i32) -> i32 {
    ordered_map_get(entries, key)
}

pub fn sorted_map_contains(entries: Vec<i32>, key: i32) -> bool {
    ordered_map_contains(entries, key)
}

pub fn sorted_map_insert(mut entries: Vec<i32>, key: i32, value: i32) {
    ordered_map_insert(entries, key, value)
}

pub fn bitset_new() -> Vec<i32> {
    bitset_store(BITSET_DEFAULT_CAPACITY)
}

pub fn bitset_mark(mut store: Vec<i32>, bit: i32) {
    bitset_mark_store(store, bit)
}

pub fn bitset_unmark(mut store: Vec<i32>, bit: i32) {
    bitset_unmark_store(store, bit)
}

pub fn bitset_test(store: Vec<i32>, bit: i32) -> bool {
    bitset_test_store(store, bit)
}

test mod "ordered_map" {
    test "sorted_map_insert_get" {
        let mut m = SortedMap::new()
        m.insert(3, 30)
        m.insert(1, 10)
        assert(m.get(3) == 30)
        assert(m.get(1) == 10)
    }
    test "sorted_map_missing_returns_zero" {
        let mut m = SortedMap::new()
        m.insert(1, 10)
        assert(m.get(99) == 0)
    }
    test "sorted_map_contains" {
        let mut m = SortedMap::new()
        m.insert(5, 50)
        assert(m.contains(5))
        assert(m.contains(6) == false)
    }
    test "sorted_map_len" {
        let mut m = SortedMap::new()
        m.insert(1, 10)
        m.insert(2, 20)
        assert(m.len() == 2)
    }
    test "sorted_map_overwrites_existing_key" {
        let mut m = SortedMap::new()
        m.insert(1, 10)
        m.insert(1, 99)
        assert(m.get(1) == 99)
        assert(m.len() == 1)
    }
    test "find_idx_locates_insertion_point" {
        let mut m = SortedMap::new()
        m.insert(10, 1)
        m.insert(20, 2)
        m.insert(30, 3)
        assert(m.find_idx(15) == 1)
        assert(m.find_idx(20) == 1)
        assert(m.find_idx(40) == 3)
    }
    test "btree_insert_get" {
        let mut m = BTreeMap::new()
        m.insert(7, 70)
        assert(m.get(7) == 70)
        assert(m.contains_key(7))
    }
    test "middle_insert_preserves_values" {
        // Shifting the pair vector must move each key together with its value.
        let mut m = BTreeMap::new()
        m.insert(30, 300)
        m.insert(10, 100)
        m.insert(50, 500)
        m.insert(20, 200)
        m.insert(40, 400)
        assert(m.len() == 5)
        assert(m.get(10) == 100)
        assert(m.get(20) == 200)
        assert(m.get(30) == 300)
        assert(m.get(40) == 400)
        assert(m.get(50) == 500)
        let keys = m.keys()
        assert(keys.len() == 5)
        assert(keys.get_unchecked(3) == 40)
        assert(keys.get_unchecked(4) == 50)
    }
    test "btree_remove" {
        let mut m = BTreeMap::new()
        m.insert(1, 10)
        m.insert(2, 20)
        m.remove(1)
        assert(m.contains_key(1) == false)
        assert(m.len() == 1)
    }
    test "remove_preserves_remaining_values" {
        // The tail shift must move whole pairs, not just the key slot.
        let mut m = BTreeMap::new()
        m.insert(10, 100)
        m.insert(20, 200)
        m.insert(30, 300)
        m.insert(40, 400)
        m.remove(20)
        assert(m.len() == 3)
        assert(m.contains_key(20) == false)
        assert(m.get(10) == 100)
        assert(m.get(30) == 300)
        assert(m.get(40) == 400)
    }
    test "btree_keys_sorted" {
        let mut m = BTreeMap::new()
        m.insert(30, 3)
        m.insert(10, 1)
        m.insert(20, 2)
        let ks = m.keys()
        assert(ks.get_unchecked(0) == 10)
        assert(ks.get_unchecked(1) == 20)
        assert(ks.get_unchecked(2) == 30)
    }
    test "btree_range_exclusive_end" {
        let mut m = BTreeMap::new()
        m.insert(10, 1)
        m.insert(20, 2)
        m.insert(30, 3)
        let r = m.range(10, 30)
        assert(r.len() == 2)
        assert(r.get_unchecked(0) == 10)
        assert(r.get_unchecked(1) == 20)
    }
    test "btree_set_insert_dedup" {
        let mut s = BTreeSet::new()
        assert(s.insert(5))
        assert(s.insert(5) == false)
        assert(s.len() == 1)
    }
    test "btree_set_contains" {
        let mut s = BTreeSet::new()
        s.insert(8)
        assert(s.contains(8))
        assert(s.contains(9) == false)
    }
    test "index_map_insert_get" {
        let mut m = IndexMap::new()
        m.insert(2, 200)
        assert(m.get(2) == 200)
        assert(m.len() == 1)
    }
    test "index_map_keys_preserves_insertion" {
        let mut m = IndexMap::new()
        m.insert(9, 90)
        m.insert(1, 10)
        let ks = m.keys()
        assert(ks.len() == 2)
        assert(ks.get_unchecked(0) == 9)
    }
    test "index_set_dedup" {
        let mut s = IndexSet::new()
        assert(s.insert(4))
        assert(s.insert(4) == false)
        assert(s.len() == 1)
        assert(s.contains(4))
    }
}

test mod "bitset" {
    test "new_has_no_bits" {
        let bs = BitSet::new()
        assert(bs.count() == 0)
        assert(bs.test(0) == false)
    }
    test "mark_and_test" {
        let mut bs = BitSet::new()
        bs.mark(3)
        assert(bs.test(3))
        assert(bs.test(4) == false)
    }
    test "unmark_clears" {
        let mut bs = BitSet::new()
        bs.mark(3)
        bs.unmark(3)
        assert(bs.test(3) == false)
    }
    test "crosses_word_boundary" {
        let mut bs = BitSet::new()
        bs.mark(31)
        bs.mark(32)
        bs.mark(33)
        assert(bs.test(32))
        assert(bs.count() == 3)
    }
    test "count_tracks_marks" {
        let mut bs = BitSet::new()
        bs.mark(0)
        bs.mark(100)
        assert(bs.count() == 2)
    }
    test "union_combines_bits" {
        let mut a = BitSet::new()
        a.mark(1)
        let mut b = BitSet::new()
        b.mark(2)
        let u = a.union(b)
        assert(u.test(1))
        assert(u.test(2))
        assert(u.count() == 2)
    }
    test "intersection_common_bits" {
        let mut a = BitSet::new()
        a.mark(1)
        a.mark(2)
        let mut b = BitSet::new()
        b.mark(2)
        b.mark(3)
        let i = a.intersection(b)
        assert(i.test(2))
        assert(i.test(1) == false)
        assert(i.count() == 1)
    }
}
