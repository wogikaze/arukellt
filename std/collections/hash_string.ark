//! String-keyed HashMap implementation for GC and linear-memory targets.
//!
//! Uses target-aware builtins (`__hm_si_*`) so open-addressing logic stays in
//! Ark while backing storage differs between flat `HashMap<String, i32>` (T1) and a GC
//! struct with parallel arrays (T3). The functions here are non-public MIR
//! lowering targets for the `impl HashMap<K, V>` and `impl HashSet<String>`
//! methods; the user spelling is `HashMap::new<K, V>()` /
//! `HashMap::with_capacity<K, V>(n)` / `HashSet::new<String>()` /
//! `HashSet::with_capacity<String>(n)` plus receiver methods.
//!
//! The capacity / bulk-maintenance group (`with_capacity`, `capacity`,
//! `reserve`, `try_reserve`, `shrink_to_fit`, `clear`, `drain`,
//! `remove_entry`, `extend`) has one implementation per pair in this family.
//! Linear-target stores share the flat bucket layout, so those targets reach
//! the same counters through the `__hm_*` bridge; wasm32-gc allocates and
//! adopts its parallel arrays through the same bridge.
//!
//! `HashSet<String>` is a key view over that same `HashMap<String, i32>`
//! store: its membership operations use the keys/flags arrays, the value slot
//! is always 0, and its capacity group delegates to the map targets. The set
//! surface therefore has a real bucket capacity rather than a parallel
//! `Vec<String>` facade.

use std::core::hash
fn hm_si_clear_slots(m: HashMap<String, i32>, cap: i32) {
    __hm_si_set_size(m, 0)
    let mut i: i32 = 0
    while i < cap {
        __hm_si_set_flag(m, i, 0)
        i = i + 1
    }
}

/// Create a HashMap<String, i32> backing store.
fn hashmap_str_i32_new() -> HashMap<String, i32> {
    __hm_si_new()
}

// Growth: rebuild into a donor table at 0.75 load and adopt its storage,
// so the probe bound stays a fallback instead of silently dropping
// inserts past the initial capacity (#895). The donor must be dropped
// immediately after __hm_*_adopt — it keeps stale refs to the new arrays.
fn hm_si_grow(m: HashMap<String, i32>) {
    let old_cap: i32 = __hm_si_cap(m)
    let dst: HashMap<String, i32> = __hm_si_new_with_cap(old_cap * 2)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_si_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_str_set_probe(dst, __hm_si_get_key(m, i), __hm_si_get_val(m, i))
        }
        i = i + 1
    }
    __hm_si_adopt(m, dst)
}

fn hm_si_ensure_insert_capacity(m: HashMap<String, i32>, key: String) {
    if !hashmap_str_contains(m, key) {
        let cap: i32 = __hm_si_cap(m)
        let needed: i32 = __hm_si_size(m) + 1
        if cap * 3 < needed * 4 {
            hm_si_grow(m)
        }
    }
}

/// String-keyed set: store key in keys array, value in values array.
/// The table grows before the load factor exceeds 0.75.
fn hashmap_str_set(m: HashMap<String, i32>, key: String, value: i32) -> bool {
    hm_si_ensure_insert_capacity(m, key.clone())
    hashmap_str_set_probe(m, key, value)
}

fn hashmap_str_set_probe(m: HashMap<String, i32>, key: String, value: i32) -> bool {
    let cap: i32 = __hm_si_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut done: bool = false
    while probes < cap {
        let flag: i32 = __hm_si_get_flag(m, idx)
        if flag == 0 || flag == 2 {
            __hm_si_set_key(m, idx, key)
            __hm_si_set_val(m, idx, value)
            __hm_si_set_flag(m, idx, 1)
            __hm_si_set_size(m, __hm_si_size(m) + 1)
            done = true
            probes = cap
        } else {
            let k: String = __hm_si_get_key(m, idx)
            if k.eq(key) {
                __hm_si_set_val(m, idx, value)
                done = true
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    done
}

/// String-keyed get: return Some(value) or None.
fn hashmap_str_get(m: HashMap<String, i32>, key: String) -> Option<i32> {
    let cap: i32 = __hm_si_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut result: Option<i32> = None
    while probes < cap {
        let flag: i32 = __hm_si_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: String = __hm_si_get_key(m, idx)
                if k.eq(key) {
                    result = Some(__hm_si_get_val(m, idx))
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    result
}

/// String-keyed contains.
fn hashmap_str_contains(m: HashMap<String, i32>, key: String) -> bool {
    let cap: i32 = __hm_si_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut found: bool = false
    while probes < cap {
        let flag: i32 = __hm_si_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: String = __hm_si_get_key(m, idx)
                if k.eq(key) {
                    found = true
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    found
}

/// String-keyed remove.
fn hashmap_str_remove(m: HashMap<String, i32>, key: String) -> Option<i32> {
    let cap: i32 = __hm_si_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut result: Option<i32> = None
    while probes < cap {
        let flag: i32 = __hm_si_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: String = __hm_si_get_key(m, idx)
                if k.eq(key) {
                    result = Some(__hm_si_get_val(m, idx))
                    __hm_si_set_flag(m, idx, 2)
                    __hm_si_set_size(m, __hm_si_size(m) - 1)
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    result
}

/// String-keyed len.
fn hashmap_str_len(m: HashMap<String, i32>) -> i32 {
    __hm_si_size(m)
}

/// `HashMap::insert` for HashMap<String, i32>: return the previous value.
fn hashmap_str_insert(m: HashMap<String, i32>, key: String, value: i32) -> Option<i32> {
    let old: Option<i32> = hashmap_str_get(m, key.clone())
    let _stored: bool = hashmap_str_set(m, key, value)
    old
}

/// `HashMap::is_empty` for HashMap<String, i32>.
fn hashmap_str_is_empty(m: HashMap<String, i32>) -> bool {
    hashmap_str_len(m) == 0
}

/// Return a Vec<String> of all keys currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_i32_keys(m: HashMap<String, i32>) -> Vec<String> {
    let cap: i32 = __hm_si_cap(m)
    let mut result: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_si_get_flag(m, i) == 1 {
            result.push(__hm_si_get_key(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<i32> of all values currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_i32_values(m: HashMap<String, i32>) -> Vec<i32> {
    let cap: i32 = __hm_si_cap(m)
    let mut result: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_si_get_flag(m, i) == 1 {
            result.push(__hm_si_get_val(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<(String, i32)> snapshot of all entries currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_i32_entries(m: HashMap<String, i32>) -> Vec<(String, i32)> {
    let cap: i32 = __hm_si_cap(m)
    let mut result: Vec<(String, i32)> = Vec::new<(String, i32)>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_si_get_flag(m, i) == 1 {
            result.push((__hm_si_get_key(m, i), __hm_si_get_val(m, i)))
        }
        i = i + 1
    }
    result
}

// ─── HashMap<String,i32> capacity / bulk maintenance ───────────────────────
// Non-public lowering targets for the generic capacity surface. Linear-target
// stores share the flat Vec layout, while wasm32-gc uses the compiler-managed
// keys/values/flags arrays, so every operation stays on the __hm_si_* bridge
// instead of reading a concrete bucket layout.

fn hashmap_str_with_capacity(cap: i32) -> HashMap<String, i32> {
    // The gc store indexes its arrays by capacity, so zero must clamp the
    // same way the flat store does.
    let mut actual_cap: i32 = cap
    if actual_cap < 1 {
        actual_cap = 1
    }
    __hm_si_new_with_cap(actual_cap)
}

fn hashmap_str_capacity(m: HashMap<String, i32>) -> i32 {
    __hm_si_cap(m)
}

// Smallest power-of-two bucket count that preserves the 0.75 load factor the
// insert path already maintains.
fn hashmap_str_min_capacity(entries: i32) -> i32 {
    let mut cap: i32 = 1
    while cap * 3 < entries * 4 {
        cap = cap * 2
    }
    cap
}

fn hashmap_str_rehash_to(m: HashMap<String, i32>, requested_cap: i32) {
    let old_cap: i32 = __hm_si_cap(m)
    let mut target_cap: i32 = hashmap_str_min_capacity(__hm_si_size(m))
    if requested_cap > target_cap {
        target_cap = requested_cap
    }
    if target_cap == old_cap {
        return
    }
    let dst: HashMap<String, i32> = __hm_si_new_with_cap(target_cap)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_si_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_str_set_probe(dst, __hm_si_get_key(m, i), __hm_si_get_val(m, i))
        }
        i = i + 1
    }
    __hm_si_adopt(m, dst)
}

fn hashmap_str_reserve(m: HashMap<String, i32>, additional: i32) {
    if additional > 0 {
        let needed_cap: i32 = hashmap_str_min_capacity(__hm_si_size(m) + additional)
        if needed_cap > __hm_si_cap(m) {
            hashmap_str_rehash_to(m, needed_cap)
        }
    }
}

fn hashmap_str_try_reserve(m: HashMap<String, i32>, additional: i32) -> bool {
    hashmap_str_reserve(m, additional)
    true
}

fn hashmap_str_shrink_to_fit(m: HashMap<String, i32>) {
    let target_cap: i32 = hashmap_str_min_capacity(__hm_si_size(m))
    if target_cap < __hm_si_cap(m) {
        hashmap_str_rehash_to(m, target_cap)
    }
}

fn hashmap_str_clear(m: HashMap<String, i32>) {
    hm_si_clear_slots(m, __hm_si_cap(m))
}

fn hashmap_str_drain(m: HashMap<String, i32>) -> Vec<(String, i32)> {
    let result: Vec<(String, i32)> = hashmap_str_i32_entries(m)
    hashmap_str_clear(m)
    result
}

fn hashmap_str_remove_entry(m: HashMap<String, i32>, key: String) -> Option<(String, i32)> {
    let old: Option<i32> = hashmap_str_remove(m, key.clone())
    match old {
        Option::Some(value) => Option::Some((key, value)),
        Option::None => Option::None,
    }
}

fn hashmap_str_extend(m: HashMap<String, i32>, other: HashMap<String, i32>) {
    let mut pending: Vec<(String, i32)> = hashmap_str_i32_entries(other)
    while pending.len() > 0 {
        match pending.pop() {
            Option::Some(pair) => {
                let (key, value) = pair
                let _stored: bool = hashmap_str_set(m, key, value)
            }
            Option::None => {}
        }
    }
}

// ─── HashMap<i32,String> — GC-aware implementation using __hm_is_* primitives ─────

fn hashmap_i32_str_new() -> HashMap<i32, String> {
    __hm_is_new()
}

fn hm_is_grow(m: HashMap<i32, String>) {
    let old_cap: i32 = __hm_is_cap(m)
    let dst: HashMap<i32, String> = __hm_is_new_with_cap(old_cap * 2)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_is_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_i32_str_set_probe(dst, __hm_is_get_key(m, i), __hm_is_get_val(m, i))
        }
        i = i + 1
    }
    __hm_is_adopt(m, dst)
}

fn hm_is_ensure_insert_capacity(m: HashMap<i32, String>, key: i32) {
    if !hashmap_i32_str_contains(m, key) {
        let cap: i32 = __hm_is_cap(m)
        let needed: i32 = __hm_is_size(m) + 1
        if cap * 3 < needed * 4 {
            hm_is_grow(m)
        }
    }
}

/// i32-keyed set: grows before the load factor exceeds 0.75 (#895).
fn hashmap_i32_str_set(m: HashMap<i32, String>, key: i32, value: String) -> bool {
    hm_is_ensure_insert_capacity(m, key)
    hashmap_i32_str_set_probe(m, key, value)
}

fn hashmap_i32_str_set_probe(m: HashMap<i32, String>, key: i32, value: String) -> bool {
    let cap: i32 = __hm_is_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut done: bool = false
    while probes < cap {
        let flag: i32 = __hm_is_get_flag(m, idx)
        if flag == 0 || flag == 2 {
            __hm_is_set_key(m, idx, key)
            __hm_is_set_val(m, idx, value)
            __hm_is_set_flag(m, idx, 1)
            __hm_is_set_size(m, __hm_is_size(m) + 1)
            done = true
            probes = cap
        } else {
            let k: i32 = __hm_is_get_key(m, idx)
            if k == key {
                __hm_is_set_val(m, idx, value)
                done = true
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    done
}

fn hashmap_i32_str_get(m: HashMap<i32, String>, key: i32) -> Option<String> {
    let cap: i32 = __hm_is_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut result: Option<String> = None
    while probes < cap {
        let flag: i32 = __hm_is_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: i32 = __hm_is_get_key(m, idx)
                if k == key {
                    result = Some(__hm_is_get_val(m, idx))
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    result
}

fn hashmap_i32_str_contains(m: HashMap<i32, String>, key: i32) -> bool {
    let cap: i32 = __hm_is_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut found: bool = false
    while probes < cap {
        let flag: i32 = __hm_is_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: i32 = __hm_is_get_key(m, idx)
                if k == key {
                    found = true
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    found
}

fn hashmap_i32_str_remove(m: HashMap<i32, String>, key: i32) -> Option<String> {
    let cap: i32 = __hm_is_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut result: Option<String> = None
    while probes < cap {
        let flag: i32 = __hm_is_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: i32 = __hm_is_get_key(m, idx)
                if k == key {
                    result = Some(__hm_is_get_val(m, idx))
                    __hm_is_set_flag(m, idx, 2)
                    __hm_is_set_size(m, __hm_is_size(m) - 1)
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    result
}

fn hashmap_i32_str_len(m: HashMap<i32, String>) -> i32 {
    __hm_is_size(m)
}

/// `HashMap::insert` for HashMap<i32, String>: return the previous value.
fn hashmap_i32_str_insert(m: HashMap<i32, String>, key: i32, value: String) -> Option<String> {
    let old: Option<String> = hashmap_i32_str_get(m, key)
    let _stored: bool = hashmap_i32_str_set(m, key, value)
    old
}

/// `HashMap::is_empty` for HashMap<i32, String>.
fn hashmap_i32_str_is_empty(m: HashMap<i32, String>) -> bool {
    hashmap_i32_str_len(m) == 0
}

/// Return a Vec<i32> of all keys currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_i32_str_keys(m: HashMap<i32, String>) -> Vec<i32> {
    let cap: i32 = __hm_is_cap(m)
    let mut result: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_is_get_flag(m, i) == 1 {
            result.push(__hm_is_get_key(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<String> of all values currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_i32_str_values(m: HashMap<i32, String>) -> Vec<String> {
    let cap: i32 = __hm_is_cap(m)
    let mut result: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_is_get_flag(m, i) == 1 {
            result.push(__hm_is_get_val(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<(i32, String)> snapshot of all entries currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_i32_str_entries(m: HashMap<i32, String>) -> Vec<(i32, String)> {
    let cap: i32 = __hm_is_cap(m)
    let mut result: Vec<(i32, String)> = Vec::new<(i32, String)>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_is_get_flag(m, i) == 1 {
            result.push((__hm_is_get_key(m, i), __hm_is_get_val(m, i)))
        }
        i = i + 1
    }
    result
}

// ─── HashMap<i32,String> capacity / bulk maintenance ───────────────────────

fn hashmap_i32_str_with_capacity(cap: i32) -> HashMap<i32, String> {
    let mut actual_cap: i32 = cap
    if actual_cap < 1 {
        actual_cap = 1
    }
    __hm_is_new_with_cap(actual_cap)
}

fn hashmap_i32_str_capacity(m: HashMap<i32, String>) -> i32 {
    __hm_is_cap(m)
}

fn hashmap_i32_str_min_capacity(entries: i32) -> i32 {
    let mut cap: i32 = 1
    while cap * 3 < entries * 4 {
        cap = cap * 2
    }
    cap
}

fn hashmap_i32_str_rehash_to(m: HashMap<i32, String>, requested_cap: i32) {
    let old_cap: i32 = __hm_is_cap(m)
    let mut target_cap: i32 = hashmap_i32_str_min_capacity(__hm_is_size(m))
    if requested_cap > target_cap {
        target_cap = requested_cap
    }
    if target_cap == old_cap {
        return
    }
    let dst: HashMap<i32, String> = __hm_is_new_with_cap(target_cap)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_is_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_i32_str_set_probe(dst, __hm_is_get_key(m, i), __hm_is_get_val(m, i))
        }
        i = i + 1
    }
    __hm_is_adopt(m, dst)
}

fn hashmap_i32_str_reserve(m: HashMap<i32, String>, additional: i32) {
    if additional > 0 {
        let needed_cap: i32 = hashmap_i32_str_min_capacity(__hm_is_size(m) + additional)
        if needed_cap > __hm_is_cap(m) {
            hashmap_i32_str_rehash_to(m, needed_cap)
        }
    }
}

fn hashmap_i32_str_try_reserve(m: HashMap<i32, String>, additional: i32) -> bool {
    hashmap_i32_str_reserve(m, additional)
    true
}

fn hashmap_i32_str_shrink_to_fit(m: HashMap<i32, String>) {
    let target_cap: i32 = hashmap_i32_str_min_capacity(__hm_is_size(m))
    if target_cap < __hm_is_cap(m) {
        hashmap_i32_str_rehash_to(m, target_cap)
    }
}

fn hashmap_i32_str_clear(m: HashMap<i32, String>) {
    let cap: i32 = __hm_is_cap(m)
    __hm_is_set_size(m, 0)
    let mut i: i32 = 0
    while i < cap {
        __hm_is_set_flag(m, i, 0)
        i = i + 1
    }
}

fn hashmap_i32_str_drain(m: HashMap<i32, String>) -> Vec<(i32, String)> {
    let result: Vec<(i32, String)> = hashmap_i32_str_entries(m)
    hashmap_i32_str_clear(m)
    result
}

fn hashmap_i32_str_remove_entry(m: HashMap<i32, String>, key: i32) -> Option<(i32, String)> {
    let old: Option<String> = hashmap_i32_str_remove(m, key)
    match old {
        Option::Some(value) => Option::Some((key, value)),
        Option::None => Option::None,
    }
}

fn hashmap_i32_str_extend(m: HashMap<i32, String>, other: HashMap<i32, String>) {
    let mut pending: Vec<(i32, String)> = hashmap_i32_str_entries(other)
    while pending.len() > 0 {
        match pending.pop() {
            Option::Some(pair) => {
                let (key, value) = pair
                let _stored: bool = hashmap_i32_str_set(m, key, value)
            }
            Option::None => {}
        }
    }
}

// ─── HashMap<String,String> — GC-aware implementation using __hm_ss_* primitives ─

fn hashmap_str_str_new() -> HashMap<String, String> {
    __hm_ss_new()
}

fn hm_ss_grow(m: HashMap<String, String>) {
    let old_cap: i32 = __hm_ss_cap(m)
    let dst: HashMap<String, String> = __hm_ss_new_with_cap(old_cap * 2)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_ss_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_str_str_set_probe(dst, __hm_ss_get_key(m, i), __hm_ss_get_val(m, i))
        }
        i = i + 1
    }
    __hm_ss_adopt(m, dst)
}

fn hm_ss_ensure_insert_capacity(m: HashMap<String, String>, key: String) {
    if !hashmap_str_str_contains(m, key) {
        let cap: i32 = __hm_ss_cap(m)
        let needed: i32 = __hm_ss_size(m) + 1
        if cap * 3 < needed * 4 {
            hm_ss_grow(m)
        }
    }
}

/// String→String set: grows before the load factor exceeds 0.75 (#895).
fn hashmap_str_str_set(m: HashMap<String, String>, key: String, value: String) -> bool {
    hm_ss_ensure_insert_capacity(m, key.clone())
    hashmap_str_str_set_probe(m, key, value)
}

fn hashmap_str_str_set_probe(m: HashMap<String, String>, key: String, value: String) -> bool {
    let cap: i32 = __hm_ss_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut done: bool = false
    while probes < cap {
        let flag: i32 = __hm_ss_get_flag(m, idx)
        if flag == 0 || flag == 2 {
            __hm_ss_set_key(m, idx, key)
            __hm_ss_set_val(m, idx, value)
            __hm_ss_set_flag(m, idx, 1)
            __hm_ss_set_size(m, __hm_ss_size(m) + 1)
            done = true
            probes = cap
        } else {
            let k: String = __hm_ss_get_key(m, idx)
            if k.eq(key) {
                __hm_ss_set_val(m, idx, value)
                done = true
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    done
}

fn hashmap_str_str_get(m: HashMap<String, String>, key: String) -> Option<String> {
    let cap: i32 = __hm_ss_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut result: Option<String> = None
    while probes < cap {
        let flag: i32 = __hm_ss_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: String = __hm_ss_get_key(m, idx)
                if k.eq(key) {
                    result = Some(__hm_ss_get_val(m, idx))
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    result
}

fn hashmap_str_str_contains(m: HashMap<String, String>, key: String) -> bool {
    let cap: i32 = __hm_ss_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut found: bool = false
    while probes < cap {
        let flag: i32 = __hm_ss_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: String = __hm_ss_get_key(m, idx)
                if k.eq(key) {
                    found = true
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    found
}

fn hashmap_str_str_remove(m: HashMap<String, String>, key: String) -> Option<String> {
    let cap: i32 = __hm_ss_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut result: Option<String> = None
    while probes < cap {
        let flag: i32 = __hm_ss_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: String = __hm_ss_get_key(m, idx)
                if k.eq(key) {
                    result = Some(__hm_ss_get_val(m, idx))
                    __hm_ss_set_flag(m, idx, 2)
                    __hm_ss_set_size(m, __hm_ss_size(m) - 1)
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    result
}

fn hashmap_str_str_len(m: HashMap<String, String>) -> i32 {
    __hm_ss_size(m)
}

/// `HashMap::insert` for HashMap<String, String>: return the previous value.
fn hashmap_str_str_insert(m: HashMap<String, String>, key: String, value: String) -> Option<String> {
    let old: Option<String> = hashmap_str_str_get(m, key.clone())
    let _stored: bool = hashmap_str_str_set(m, key, value)
    old
}

/// `HashMap::is_empty` for HashMap<String, String>.
fn hashmap_str_str_is_empty(m: HashMap<String, String>) -> bool {
    hashmap_str_str_len(m) == 0
}

/// Return a Vec<String> of all keys currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_str_keys(m: HashMap<String, String>) -> Vec<String> {
    let cap: i32 = __hm_ss_cap(m)
    let mut result: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_ss_get_flag(m, i) == 1 {
            result.push(__hm_ss_get_key(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<String> of all values currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_str_values(m: HashMap<String, String>) -> Vec<String> {
    let cap: i32 = __hm_ss_cap(m)
    let mut result: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_ss_get_flag(m, i) == 1 {
            result.push(__hm_ss_get_val(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<(String, String)> snapshot of all entries currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_str_entries(m: HashMap<String, String>) -> Vec<(String, String)> {
    let cap: i32 = __hm_ss_cap(m)
    let mut result: Vec<(String, String)> = Vec::new<(String, String)>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_ss_get_flag(m, i) == 1 {
            result.push((__hm_ss_get_key(m, i), __hm_ss_get_val(m, i)))
        }
        i = i + 1
    }
    result
}

// ─── HashMap<String,String> capacity / bulk maintenance ────────────────────

fn hashmap_str_str_with_capacity(cap: i32) -> HashMap<String, String> {
    let mut actual_cap: i32 = cap
    if actual_cap < 1 {
        actual_cap = 1
    }
    __hm_ss_new_with_cap(actual_cap)
}

fn hashmap_str_str_capacity(m: HashMap<String, String>) -> i32 {
    __hm_ss_cap(m)
}

fn hashmap_str_str_min_capacity(entries: i32) -> i32 {
    let mut cap: i32 = 1
    while cap * 3 < entries * 4 {
        cap = cap * 2
    }
    cap
}

fn hashmap_str_str_rehash_to(m: HashMap<String, String>, requested_cap: i32) {
    let old_cap: i32 = __hm_ss_cap(m)
    let mut target_cap: i32 = hashmap_str_str_min_capacity(__hm_ss_size(m))
    if requested_cap > target_cap {
        target_cap = requested_cap
    }
    if target_cap == old_cap {
        return
    }
    let dst: HashMap<String, String> = __hm_ss_new_with_cap(target_cap)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_ss_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_str_str_set_probe(dst, __hm_ss_get_key(m, i), __hm_ss_get_val(m, i))
        }
        i = i + 1
    }
    __hm_ss_adopt(m, dst)
}

fn hashmap_str_str_reserve(m: HashMap<String, String>, additional: i32) {
    if additional > 0 {
        let needed_cap: i32 = hashmap_str_str_min_capacity(__hm_ss_size(m) + additional)
        if needed_cap > __hm_ss_cap(m) {
            hashmap_str_str_rehash_to(m, needed_cap)
        }
    }
}

fn hashmap_str_str_try_reserve(m: HashMap<String, String>, additional: i32) -> bool {
    hashmap_str_str_reserve(m, additional)
    true
}

fn hashmap_str_str_shrink_to_fit(m: HashMap<String, String>) {
    let target_cap: i32 = hashmap_str_str_min_capacity(__hm_ss_size(m))
    if target_cap < __hm_ss_cap(m) {
        hashmap_str_str_rehash_to(m, target_cap)
    }
}

fn hashmap_str_str_clear(m: HashMap<String, String>) {
    let cap: i32 = __hm_ss_cap(m)
    __hm_ss_set_size(m, 0)
    let mut i: i32 = 0
    while i < cap {
        __hm_ss_set_flag(m, i, 0)
        i = i + 1
    }
}

fn hashmap_str_str_drain(m: HashMap<String, String>) -> Vec<(String, String)> {
    let result: Vec<(String, String)> = hashmap_str_str_entries(m)
    hashmap_str_str_clear(m)
    result
}

fn hashmap_str_str_remove_entry(m: HashMap<String, String>, key: String) -> Option<(String, String)> {
    let old: Option<String> = hashmap_str_str_remove(m, key.clone())
    match old {
        Option::Some(value) => Option::Some((key, value)),
        Option::None => Option::None,
    }
}

fn hashmap_str_str_extend(m: HashMap<String, String>, other: HashMap<String, String>) {
    let mut pending: Vec<(String, String)> = hashmap_str_str_entries(other)
    while pending.len() > 0 {
        match pending.pop() {
            Option::Some(pair) => {
                let (key, value) = pair
                let _stored: bool = hashmap_str_str_set(m, key, value)
            }
            Option::None => {}
        }
    }
}

// ─── HashSet<String> — key view over the HashMap<String, i32> bucket store ──
// The set keeps no separate layout: membership lives in the same keys/flags
// arrays as HashMap<String, i32>, the value slot is always 0, and capacity /
// reserve / try_reserve / shrink_to_fit reuse the map's 0.75 load-factor
// machinery. These are private MIR lowering targets for `impl HashSet<String>`,
// not public free functions (ADR-046).

fn hashset_str_new() -> HashMap<String, i32> {
    hashmap_str_i32_new()
}

/// Create an empty String set with at least `cap` bucket slots (minimum 1).
/// The set is a key view over the map store, so construction goes through the
/// map's capacity constructor and keeps its zero-clamp and load-factor plan.
fn hashset_str_with_capacity(cap: i32) -> HashMap<String, i32> {
    hashmap_str_with_capacity(cap)
}

fn hashset_str_insert(m: HashMap<String, i32>, value: String) -> bool {
    if hashmap_str_contains(m, value.clone()) {
        false
    } else {
        let _stored: bool = hashmap_str_set(m, value, 0)
        true
    }
}

fn hashset_str_contains(m: HashMap<String, i32>, value: String) -> bool {
    hashmap_str_contains(m, value)
}

fn hashset_str_remove(m: HashMap<String, i32>, value: String) -> bool {
    match hashmap_str_remove(m, value) {
        Option::Some(_) => true,
        Option::None => false,
    }
}

fn hashset_str_len(m: HashMap<String, i32>) -> i32 {
    hashmap_str_len(m)
}

fn hashset_str_is_empty(m: HashMap<String, i32>) -> bool {
    hashmap_str_is_empty(m)
}

/// Snapshot the set members for `HashSet<String>::to_vec` and the
/// `IntoIterator` / `Clone` / `Debug` impls. The keys are copied out of the
/// occupied slots, so a caller cannot observe later set mutation through the
/// returned Vec. The order is the store's bucket order, not insertion order.
fn hashset_str_to_vec(m: HashMap<String, i32>) -> Vec<String> {
    hashmap_str_i32_keys(m)
}

// ─── HashSet<String> aggregate and capacity operations ─────────────────────
// The set-algebra helpers build a fresh key store from both operands; neither
// operand is mutated. They are private MIR lowering targets for the
// `impl HashSet<String>` methods, not public free functions (ADR-046).

fn hashset_str_union(a: HashMap<String, i32>, b: HashMap<String, i32>) -> HashMap<String, i32> {
    let mut result: HashMap<String, i32> = hashset_str_new()
    let ak: Vec<String> = hashmap_str_i32_keys(a)
    let mut i: i32 = 0
    while i < ak.len() {
        let _ = hashset_str_insert(result, ak.get_unchecked(i))
        i = i + 1
    }
    let bk: Vec<String> = hashmap_str_i32_keys(b)
    let mut j: i32 = 0
    while j < bk.len() {
        let _ = hashset_str_insert(result, bk.get_unchecked(j))
        j = j + 1
    }
    result
}

fn hashset_str_intersection(a: HashMap<String, i32>, b: HashMap<String, i32>) -> HashMap<String, i32> {
    let mut result: HashMap<String, i32> = hashset_str_new()
    let ak: Vec<String> = hashmap_str_i32_keys(a)
    let mut i: i32 = 0
    while i < ak.len() {
        let value: String = ak.get_unchecked(i)
        if hashset_str_contains(b, value.clone()) {
            let _ = hashset_str_insert(result, value)
        }
        i = i + 1
    }
    result
}

fn hashset_str_difference(a: HashMap<String, i32>, b: HashMap<String, i32>) -> HashMap<String, i32> {
    let mut result: HashMap<String, i32> = hashset_str_new()
    let ak: Vec<String> = hashmap_str_i32_keys(a)
    let mut i: i32 = 0
    while i < ak.len() {
        let value: String = ak.get_unchecked(i)
        if !hashset_str_contains(b, value.clone()) {
            let _ = hashset_str_insert(result, value)
        }
        i = i + 1
    }
    result
}

fn hashset_str_capacity(m: HashMap<String, i32>) -> i32 {
    hashmap_str_capacity(m)
}

fn hashset_str_reserve(m: HashMap<String, i32>, additional: i32) {
    hashmap_str_reserve(m, additional)
}

fn hashset_str_try_reserve(m: HashMap<String, i32>, additional: i32) -> bool {
    hashmap_str_try_reserve(m, additional)
}

fn hashset_str_shrink_to_fit(m: HashMap<String, i32>) {
    hashmap_str_shrink_to_fit(m)
}

fn hashset_str_clear(m: HashMap<String, i32>) {
    hashmap_str_clear(m)
}

fn hashset_str_extend(m: HashMap<String, i32>, other: HashMap<String, i32>) {
    // Insert from a key snapshot: growing the destination while iterating the
    // source would not terminate for `s.extend(s)`.
    let incoming: Vec<String> = hashmap_str_i32_keys(other)
    let mut i: i32 = 0
    while i < incoming.len() {
        let _ = hashset_str_insert(m, incoming.get_unchecked(i))
        i = i + 1
    }
}

/// `HashMap<String, i32>` retain lowering target: evaluate the predicate against
/// key/value snapshots, then remove the rejected keys from the live store.
fn hashmap_str_retain(mut map: HashMap<String, i32>, keep: fn((String, i32)) -> bool) {
    let keys: Vec<String> = hashmap_str_i32_keys(map)
    let values: Vec<i32> = hashmap_str_i32_values(map)
    let mut drop_indices: Vec<i32> = Vec::new<i32>()
    let mut index: i32 = 0
    while index < keys.len() {
        let key: String = keys.get_unchecked(index)
        let value: i32 = values.get_unchecked(index)
        if keep((key, value)) == false {
            drop_indices.push(index)
        }
        index = index + 1
    }
    let mut drop_index: i32 = 0
    while drop_index < drop_indices.len() {
        let removed_index: i32 = drop_indices.get_unchecked(drop_index)
        let key: String = keys.get_unchecked(removed_index)
        let _ = hashmap_str_remove(map, key)
        drop_index = drop_index + 1
    }
}

/// `HashMap<i32, String>` retain lowering target: evaluate the predicate against
/// key/value snapshots, then remove the rejected keys from the live store.
fn hashmap_i32_str_retain(mut map: HashMap<i32, String>, keep: fn((i32, String)) -> bool) {
    let keys: Vec<i32> = hashmap_i32_str_keys(map)
    let values: Vec<String> = hashmap_i32_str_values(map)
    let mut drop_indices: Vec<i32> = Vec::new<i32>()
    let mut index: i32 = 0
    while index < keys.len() {
        let key: i32 = keys.get_unchecked(index)
        let value: String = values.get_unchecked(index)
        if keep((key, value)) == false {
            drop_indices.push(index)
        }
        index = index + 1
    }
    let mut drop_index: i32 = 0
    while drop_index < drop_indices.len() {
        let removed_index: i32 = drop_indices.get_unchecked(drop_index)
        let key: i32 = keys.get_unchecked(removed_index)
        let _ = hashmap_i32_str_remove(map, key)
        drop_index = drop_index + 1
    }
}

/// `HashMap<String, String>` retain lowering target: evaluate the predicate against
/// key/value snapshots, then remove the rejected keys from the live store.
fn hashmap_str_str_retain(mut map: HashMap<String, String>, keep: fn((String, String)) -> bool) {
    let keys: Vec<String> = hashmap_str_str_keys(map)
    let values: Vec<String> = hashmap_str_str_values(map)
    let mut drop_indices: Vec<i32> = Vec::new<i32>()
    let mut index: i32 = 0
    while index < keys.len() {
        let key: String = keys.get_unchecked(index)
        let value: String = values.get_unchecked(index)
        if keep((key, value)) == false {
            drop_indices.push(index)
        }
        index = index + 1
    }
    let mut drop_index: i32 = 0
    while drop_index < drop_indices.len() {
        let removed_index: i32 = drop_indices.get_unchecked(drop_index)
        let key: String = keys.get_unchecked(removed_index)
        let _ = hashmap_str_str_remove(map, key)
        drop_index = drop_index + 1
    }
}
