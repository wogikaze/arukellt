// ─── HashSet<String> API (linear scan over Vec<String>) ──────────────────────

fn vec_string_index_of(items: Vec<String>, value: String) -> i32 {
    let mut i: i32 = 0
    while i < len(items) {
        if eq(get_unchecked(items, i), value) {
            return i
        }
        i = i + 1
    }
    -1
}

fn vec_string_remove_at(mut items: Vec<String>, index: i32) {
    let n: i32 = len(items)
    let mut i: i32 = index
    while i < n - 1 {
        set(items, i, get_unchecked(items, i + 1))
        i = i + 1
    }
    let _last: Option<String> = pop(items)
}

pub fn hashset_str_new() -> Vec<String> {
    Vec::new<String>()
}

pub fn hashset_str_insert(mut s: Vec<String>, value: String) -> bool {
    if vec_string_index_of(s, clone(value)) >= 0 {
        false
    } else {
        push(s, value)
        true
    }
}

pub fn hashset_str_contains(s: Vec<String>, value: String) -> bool {
    vec_string_index_of(s, value) >= 0
}

pub fn hashset_str_remove(mut s: Vec<String>, value: String) -> bool {
    let idx: i32 = vec_string_index_of(s, value)
    if idx < 0 {
        false
    } else {
        vec_string_remove_at(s, idx)
        true
    }
}

pub fn hashset_str_len(s: Vec<String>) -> i32 {
    len(s)
}

pub fn hashset_str_is_empty(s: Vec<String>) -> bool {
    len(s) == 0
}

/// Snapshot the `Vec<String>` set store for `HashSet<String>::to_vec` and the
/// `IntoIterator` / `Clone` / `Debug` impls. Elements are cloned so a caller
/// cannot observe later set mutation through the returned Vec. The order is
/// the store's insertion order, not a hash bucket layout.
fn hashset_str_to_vec(s: Vec<String>) -> Vec<String> {
    let mut result: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < len(s) {
        push(result, clone(get_unchecked(s, i)))
        i = i + 1
    }
    result
}

// ─── HashSet<String> aggregate operations ──────────────────────────────────
// The set-algebra helpers build a fresh store from both operands; neither
// operand is mutated, so elements enter the result through `clone`. They are
// private MIR lowering targets for the `impl HashSet<String>` methods, not
// public free functions (ADR-046). `capacity` / `reserve` / `shrink_to_fit`
// have no counterpart here: the String store is a linear `Vec<String>` with no
// bucket layout, so there is no capacity to report or reserve.

fn hashset_str_union(a: Vec<String>, b: Vec<String>) -> Vec<String> {
    let mut result: Vec<String> = hashset_str_new()
    let mut i: i32 = 0
    while i < len(a) {
        let _ = hashset_str_insert(result, clone(get_unchecked(a, i)))
        i = i + 1
    }
    let mut j: i32 = 0
    while j < len(b) {
        let _ = hashset_str_insert(result, clone(get_unchecked(b, j)))
        j = j + 1
    }
    result
}

fn hashset_str_intersection(a: Vec<String>, b: Vec<String>) -> Vec<String> {
    let mut result: Vec<String> = hashset_str_new()
    let mut i: i32 = 0
    while i < len(a) {
        let value: String = get_unchecked(a, i)
        if hashset_str_contains(b, clone(value)) {
            let _ = hashset_str_insert(result, value)
        }
        i = i + 1
    }
    result
}

fn hashset_str_difference(a: Vec<String>, b: Vec<String>) -> Vec<String> {
    let mut result: Vec<String> = hashset_str_new()
    let mut i: i32 = 0
    while i < len(a) {
        let value: String = get_unchecked(a, i)
        if !hashset_str_contains(b, clone(value)) {
            let _ = hashset_str_insert(result, value)
        }
        i = i + 1
    }
    result
}

fn hashset_str_clear(mut s: Vec<String>) {
    while len(s) > 0 {
        let _ = pop(s)
    }
}

fn hashset_str_extend(mut s: Vec<String>, other: Vec<String>) {
    // Insert from a snapshot: growing the destination while iterating the
    // source would not terminate for `s.extend(s)`.
    let incoming: Vec<String> = hashset_str_to_vec(other)
    let mut i: i32 = 0
    while i < len(incoming) {
        let _ = hashset_str_insert(s, get_unchecked(incoming, i))
        i = i + 1
    }
}
