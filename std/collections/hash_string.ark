//! String-keyed HashMap implementation for GC and linear-memory targets.
//!
//! Uses target-aware builtins (`__hm_si_*`) so open-addressing logic stays in
//! Ark while backing storage differs between flat `HashMap<String, i32>` (T1) and a GC
//! struct with parallel arrays (T3). The functions here are non-public MIR
//! lowering targets for the `impl HashMap<K, V>` methods; the user spelling
//! is `HashMap::new<K, V>()` plus receiver methods.

use std::core::hash
use std::prelude::{clone, eq}
fn hm_si_clear_slots(m: HashMap<String, i32>, cap: i32) {
    __hm_si_set_size(m, 0)
    let mut i: i32 = 0
    while i < cap {
        __hm_si_set_flag(m, i, 0)
        i = i + 1
    }
}

/// Create a HashMap<String, i32> backing store.
fn hashmap_str_i32_new() -> HashMap<String, i32> {
    __hm_si_new()
}

// Growth: rebuild into a donor table at 0.75 load and adopt its storage,
// so the probe bound stays a fallback instead of silently dropping
// inserts past the initial capacity (#895). The donor must be dropped
// immediately after __hm_*_adopt — it keeps stale refs to the new arrays.
fn hm_si_grow(m: HashMap<String, i32>) {
    let old_cap: i32 = __hm_si_cap(m)
    let dst: HashMap<String, i32> = __hm_si_new_with_cap(old_cap * 2)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_si_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_str_set_probe(dst, __hm_si_get_key(m, i), __hm_si_get_val(m, i))
        }
        i = i + 1
    }
    __hm_si_adopt(m, dst)
}

fn hm_si_ensure_insert_capacity(m: HashMap<String, i32>, key: String) {
    if !hashmap_str_contains(m, key) {
        let cap: i32 = __hm_si_cap(m)
        let needed: i32 = __hm_si_size(m) + 1
        if cap * 3 < needed * 4 {
            hm_si_grow(m)
        }
    }
}

/// String-keyed set: store key in keys array, value in values array.
/// The table grows before the load factor exceeds 0.75.
fn hashmap_str_set(m: HashMap<String, i32>, key: String, value: i32) -> bool {
    hm_si_ensure_insert_capacity(m, clone(key))
    hashmap_str_set_probe(m, key, value)
}

fn hashmap_str_set_probe(m: HashMap<String, i32>, key: String, value: i32) -> bool {
    let cap: i32 = __hm_si_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut done: bool = false
    while probes < cap {
        let flag: i32 = __hm_si_get_flag(m, idx)
        if flag == 0 || flag == 2 {
            __hm_si_set_key(m, idx, key)
            __hm_si_set_val(m, idx, value)
            __hm_si_set_flag(m, idx, 1)
            __hm_si_set_size(m, __hm_si_size(m) + 1)
            done = true
            probes = cap
        } else {
            let k: String = __hm_si_get_key(m, idx)
            if eq(k, key) {
                __hm_si_set_val(m, idx, value)
                done = true
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    done
}

/// String-keyed get: return Some(value) or None.
fn hashmap_str_get(m: HashMap<String, i32>, key: String) -> Option<i32> {
    let cap: i32 = __hm_si_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut result: Option<i32> = None
    while probes < cap {
        let flag: i32 = __hm_si_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: String = __hm_si_get_key(m, idx)
                if eq(k, key) {
                    result = Some(__hm_si_get_val(m, idx))
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    result
}

/// String-keyed contains.
fn hashmap_str_contains(m: HashMap<String, i32>, key: String) -> bool {
    let cap: i32 = __hm_si_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut found: bool = false
    while probes < cap {
        let flag: i32 = __hm_si_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: String = __hm_si_get_key(m, idx)
                if eq(k, key) {
                    found = true
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    found
}

/// String-keyed remove.
fn hashmap_str_remove(m: HashMap<String, i32>, key: String) -> Option<i32> {
    let cap: i32 = __hm_si_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut result: Option<i32> = None
    while probes < cap {
        let flag: i32 = __hm_si_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: String = __hm_si_get_key(m, idx)
                if eq(k, key) {
                    result = Some(__hm_si_get_val(m, idx))
                    __hm_si_set_flag(m, idx, 2)
                    __hm_si_set_size(m, __hm_si_size(m) - 1)
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    result
}

/// String-keyed len.
fn hashmap_str_len(m: HashMap<String, i32>) -> i32 {
    __hm_si_size(m)
}

/// `HashMap::insert` for HashMap<String, i32>: return the previous value.
fn hashmap_str_insert(m: HashMap<String, i32>, key: String, value: i32) -> Option<i32> {
    let old: Option<i32> = hashmap_str_get(m, clone(key))
    let _stored: bool = hashmap_str_set(m, key, value)
    old
}

/// `HashMap::is_empty` for HashMap<String, i32>.
fn hashmap_str_is_empty(m: HashMap<String, i32>) -> bool {
    hashmap_str_len(m) == 0
}

/// Return a Vec<String> of all keys currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_i32_keys(m: HashMap<String, i32>) -> Vec<String> {
    let cap: i32 = __hm_si_cap(m)
    let mut result: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_si_get_flag(m, i) == 1 {
            push(result, __hm_si_get_key(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<i32> of all values currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_i32_values(m: HashMap<String, i32>) -> Vec<i32> {
    let cap: i32 = __hm_si_cap(m)
    let mut result: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_si_get_flag(m, i) == 1 {
            push(result, __hm_si_get_val(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<(String, i32)> snapshot of all entries currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_i32_entries(m: HashMap<String, i32>) -> Vec<(String, i32)> {
    let cap: i32 = __hm_si_cap(m)
    let mut result: Vec<(String, i32)> = Vec::new<(String, i32)>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_si_get_flag(m, i) == 1 {
            push(result, (__hm_si_get_key(m, i), __hm_si_get_val(m, i)))
        }
        i = i + 1
    }
    result
}

// ─── HashMap<i32,String> — GC-aware implementation using __hm_is_* primitives ─────

fn hashmap_i32_str_new() -> HashMap<i32, String> {
    __hm_is_new()
}

fn hm_is_grow(m: HashMap<i32, String>) {
    let old_cap: i32 = __hm_is_cap(m)
    let dst: HashMap<i32, String> = __hm_is_new_with_cap(old_cap * 2)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_is_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_i32_str_set_probe(dst, __hm_is_get_key(m, i), __hm_is_get_val(m, i))
        }
        i = i + 1
    }
    __hm_is_adopt(m, dst)
}

fn hm_is_ensure_insert_capacity(m: HashMap<i32, String>, key: i32) {
    if !hashmap_i32_str_contains(m, key) {
        let cap: i32 = __hm_is_cap(m)
        let needed: i32 = __hm_is_size(m) + 1
        if cap * 3 < needed * 4 {
            hm_is_grow(m)
        }
    }
}

/// i32-keyed set: grows before the load factor exceeds 0.75 (#895).
fn hashmap_i32_str_set(m: HashMap<i32, String>, key: i32, value: String) -> bool {
    hm_is_ensure_insert_capacity(m, key)
    hashmap_i32_str_set_probe(m, key, value)
}

fn hashmap_i32_str_set_probe(m: HashMap<i32, String>, key: i32, value: String) -> bool {
