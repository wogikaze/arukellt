//! HashMap<i32, fn> helpers for GC funcref value ABI (#833).
//!
//! Kept separate from `hash_string.ark` so stage-2 rebuilds that still load
//! String-keyed maps do not require the previous compiler to know `__hm_if_*`.

use std::core::hash

pub fn hashmap_i32_fn_new() -> HashMap<i32, fn(i32) -> i32> {
    __hm_if_new()
}

pub fn hashmap_i32_fn_set(m: HashMap<i32, fn(i32) -> i32>, key: i32, value: fn(i32) -> i32) -> bool {
    let cap: i32 = __hm_if_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut done: bool = false
    while probes < cap {
        let flag: i32 = __hm_if_get_flag(m, idx)
        if flag == 0 || flag == 2 {
            __hm_if_set_key(m, idx, key)
            __hm_if_set_val(m, idx, value)
            __hm_if_set_flag(m, idx, 1)
            __hm_if_set_size(m, __hm_if_size(m) + 1)
            done = true
            probes = cap
        } else {
            let k: i32 = __hm_if_get_key(m, idx)
            if k == key {
                __hm_if_set_val(m, idx, value)
                done = true
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    done
}

pub fn hashmap_i32_fn_get(m: HashMap<i32, fn(i32) -> i32>, key: i32) -> Option<fn(i32) -> i32> {
    let cap: i32 = __hm_if_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut result: Option<fn(i32) -> i32> = None
    while probes < cap {
        let flag: i32 = __hm_if_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: i32 = __hm_if_get_key(m, idx)
                if k == key {
                    result = Some(__hm_if_get_val(m, idx))
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    result
}

pub fn hashmap_i32_fn_contains(m: HashMap<i32, fn(i32) -> i32>, key: i32) -> bool {
    let cap: i32 = __hm_if_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut found: bool = false
    while probes < cap {
        let flag: i32 = __hm_if_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: i32 = __hm_if_get_key(m, idx)
                if k == key {
                    found = true
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    found
}

pub fn hashmap_i32_fn_remove(m: HashMap<i32, fn(i32) -> i32>, key: i32) -> Option<fn(i32) -> i32> {
    let cap: i32 = __hm_if_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut result: Option<fn(i32) -> i32> = None
    while probes < cap {
        let flag: i32 = __hm_if_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else {
            if flag == 1 {
                let k: i32 = __hm_if_get_key(m, idx)
                if k == key {
                    result = Some(__hm_if_get_val(m, idx))
                    __hm_if_set_flag(m, idx, 2)
                    __hm_if_set_size(m, __hm_if_size(m) - 1)
                    probes = cap
                } else {
                    idx = (idx + 1) % cap
                    probes = probes + 1
                }
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    result
}

pub fn hashmap_i32_fn_len(m: HashMap<i32, fn(i32) -> i32>) -> i32 {
    __hm_if_size(m)
}
