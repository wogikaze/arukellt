//! HashMap<i32, fn> implementation for GC funcref value ABI (#833).
//!
//! Kept separate from `hash_string.ark` so stage-2 rebuilds that still load
//! String-keyed maps do not require the previous compiler to know `__hm_if_*`.
//! The functions here are non-public MIR lowering targets for the
//! `impl HashMap<K, V>` methods; the user spelling is `HashMap::new<K, V>()`
//! plus receiver methods.

use std::core::hash

fn hashmap_i32_fn_new() -> HashMap<i32, fn(i32) -> i32> {
    __hm_if_new()
}

fn hm_if_grow(m: HashMap<i32, fn(i32) -> i32>) {
    let old_cap: i32 = __hm_if_cap(m)
    let dst: HashMap<i32, fn(i32) -> i32> = __hm_if_new_with_cap(old_cap * 2)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_if_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_i32_fn_set_probe(dst, __hm_if_get_key(m, i), __hm_if_get_val(m, i))
        }
        i = i + 1
    }
    __hm_if_adopt(m, dst)
}

fn hm_if_ensure_insert_capacity(m: HashMap<i32, fn(i32) -> i32>, key: i32) {
    if !hashmap_i32_fn_contains(m, key) {
        let cap: i32 = __hm_if_cap(m)
        let needed: i32 = __hm_if_size(m) + 1
        if cap * 3 < needed * 4 {
            hm_if_grow(m)
        }
    }
}

/// i32→fn set: grows before the load factor exceeds 0.75 (#895).
fn hashmap_i32_fn_set(m: HashMap<i32, fn(i32) -> i32>, key: i32, value: fn(i32) -> i32) -> bool {
    hm_if_ensure_insert_capacity(m, key)
    hashmap_i32_fn_set_probe(m, key, value)
}

fn hashmap_i32_fn_set_probe(m: HashMap<i32, fn(i32) -> i32>, key: i32, value: fn(i32) -> i32) -> bool {
    let cap: i32 = __hm_if_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut done: bool = false
    while probes < cap {
        let flag: i32 = __hm_if_get_flag(m, idx)
        if flag == 0 || flag == 2 {
            __hm_if_set_key(m, idx, key)
            __hm_if_set_val(m, idx, value)
            __hm_if_set_flag(m, idx, 1)
            __hm_if_set_size(m, __hm_if_size(m) + 1)
            done = true
            probes = cap
        } else {
            let k: i32 = __hm_if_get_key(m, idx)
            if k == key {
                __hm_if_set_val(m, idx, value)
                done = true
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        }
    }
    done
}

fn hashmap_i32_fn_get(m: HashMap<i32, fn(i32) -> i32>, key: i32) -> Option<fn(i32) -> i32> {
    let cap: i32 = __hm_if_cap(m)
    let hashed: i32 = key.hash()
    let mut idx: i32 = hashed % cap
    let mut probes: i32 = 0
    let mut result: Option<fn(i32) -> i32> = None
    while probes < cap {
        let flag: i32 = __hm_if_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else if flag == 1 {
            let k: i32 = __hm_if_get_key(m, idx)
            if k == key {
                result = Some(__hm_if_get_val(m, idx))
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        } else {
            idx = (idx + 1) % cap
            probes = probes + 1
        }
    }
    result
}

fn hashmap_i32_fn_contains(m: HashMap<i32, fn(i32) -> i32>, key: i32) -> bool {
    let cap: i32 = __hm_if_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut found: bool = false
    while probes < cap {
        let flag: i32 = __hm_if_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else if flag == 1 {
            let k: i32 = __hm_if_get_key(m, idx)
            if k == key {
                found = true
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        } else {
            idx = (idx + 1) % cap
            probes = probes + 1
        }
    }
    found
}

fn hashmap_i32_fn_remove(m: HashMap<i32, fn(i32) -> i32>, key: i32) -> Option<fn(i32) -> i32> {
    let cap: i32 = __hm_if_cap(m)
    let hashed: i32 = key.hash()
    let mut idx: i32 = hashed % cap
    let mut probes: i32 = 0
    let mut result: Option<fn(i32) -> i32> = None
    while probes < cap {
        let flag: i32 = __hm_if_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else if flag == 1 {
            let k: i32 = __hm_if_get_key(m, idx)
            if k == key {
                result = Some(__hm_if_get_val(m, idx))
                __hm_if_set_flag(m, idx, 2)
                __hm_if_set_size(m, __hm_if_size(m) - 1)
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        } else {
            idx = (idx + 1) % cap
            probes = probes + 1
        }
    }
    result
}

fn hashmap_i32_fn_len(m: HashMap<i32, fn(i32) -> i32>) -> i32 {
    __hm_if_size(m)
}

/// Return a Vec<i32> of all keys currently in a HashMap<i32, fn>.
fn hashmap_i32_fn_keys(m: HashMap<i32, fn(i32) -> i32>) -> Vec<i32> {
    let cap: i32 = __hm_if_cap(m)
    let mut result: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_if_get_flag(m, i) == 1 {
            push(result, __hm_if_get_key(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<fn(i32) -> i32> of all values currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_i32_fn_values(m: HashMap<i32, fn(i32) -> i32>) -> Vec<fn(i32) -> i32> {
    let cap: i32 = __hm_if_cap(m)
    let mut result: Vec<fn(i32) -> i32> = Vec::new<fn(i32) -> i32>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_if_get_flag(m, i) == 1 {
            push(result, __hm_if_get_val(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<(i32, fn(i32) -> i32)> snapshot of all entries.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_i32_fn_entries(m: HashMap<i32, fn(i32) -> i32>) -> Vec<(i32, fn(i32) -> i32)> {
    let cap: i32 = __hm_if_cap(m)
    let mut result: Vec<(i32, fn(i32) -> i32)> = Vec::new<(i32, fn(i32) -> i32)>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_if_get_flag(m, i) == 1 {
            push(result, (__hm_if_get_key(m, i), __hm_if_get_val(m, i)))
        }
        i = i + 1
    }
    result
}

/// Insert a function value and return the previous value if present.
/// `HashMap::insert` lowering target for the i32/fn family (#874).
fn hashmap_i32_fn_insert(
    m: HashMap<i32, fn(i32) -> i32>,
    key: i32,
    value: fn(i32) -> i32
) -> Option<fn(i32) -> i32> {
    let old: Option<fn(i32) -> i32> = hashmap_i32_fn_get(m, key)
    let _stored: bool = hashmap_i32_fn_set(m, key, value)
    old
}

fn hashmap_i32_fn_is_empty(m: HashMap<i32, fn(i32) -> i32>) -> bool {
    hashmap_i32_fn_len(m) == 0
}
