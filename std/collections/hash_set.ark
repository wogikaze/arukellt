//! std::collections::hash_set — `HashSet<i32>` / `HashSet<String>` type surface
//!
//! `HashSet::new<T>()` plus the receiver methods are the canonical spelling for
//! the flat `i32` set store in `std::collections::hash` and the String-keyed
//! bucket store in `std::collections::hash_string`. MIR rewrites the shell
//! calls to the store functions, so the shell bodies never recurse at runtime.
//!
//! The aggregate operations (`to_vec`, `union`, `intersection`, `difference`,
//! `capacity`, `reserve`, `try_reserve`, `shrink_to_fit`, `clear`, `extend`)
//! are available on both element families. `HashSet<String>` is a key view
//! over the `HashMap<String, i32>` bucket store: membership uses the same
//! keys/flags arrays, the value slot is always 0, and the capacity group
//! reuses the map's 0.75 load-factor machinery. Both element families
//! implement `FromIterator<VecIter<T>>`, `IntoIterator`, `Clone`, `Eq`, and
//! `Debug`.
//!
//! `iter` returns a `VecIter<T>` over a snapshot and `retain` evaluates its
//! predicate against a snapshot before reinserting kept elements; Arukellt v2
//! has no general borrow, so a borrowed set cursor is not exposed.
//!
//! The `hashset_i32_*` / `hashset_str_*` compatibility adapters were retired in
//! #917; this module's only public symbols are `HashSet` and its methods.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability
//! required.

use std::collections::hash
use std::collections::hash_string
use std::core::clone
use std::core::cmp
use std::core::convert
use std::core::iter

/// A set of unique `i32` or `String` values.
///
/// Construct with `HashSet::new<i32>()` / `HashSet::new<String>()`, or collect
/// a `VecIter` with `HashSet::from_iter`, and use the receiver methods; the
/// `i32` operations lower to the flat hash store, and the `String` operations
/// lower to the key view over the String-keyed map's bucket store. The storage
/// representation is private.
pub struct HashSet<T> {
}

impl<T> HashSet<T> {
    /// Creates an empty set.
    fn new() -> HashSet<T> {
        HashSet::new<T>()
    }
}

impl HashSet<i32> {
    /// Inserts `value` and returns true when it was not already present.
    fn insert(mut self: HashSet<i32>, value: i32) -> bool {
        self.insert(value)
    }

    /// Returns true when `value` is present in the set.
    fn contains(self: HashSet<i32>, value: i32) -> bool {
        self.contains(value)
    }

    /// Removes `value` and returns true when it was present.
    fn remove(mut self: HashSet<i32>, value: i32) -> bool {
        self.remove(value)
    }

    /// Returns the number of elements in the set.
    fn len(self: HashSet<i32>) -> i32 {
        self.len()
    }

    /// Returns true when the set has no elements.
    fn is_empty(self: HashSet<i32>) -> bool {
        self.is_empty()
    }

    /// Returns all elements as a `Vec<i32>` in implementation-defined order.
    fn to_vec(self: HashSet<i32>) -> Vec<i32> {
        self.to_vec()
    }

    /// Returns a cursor over a snapshot of the set's elements.
    ///
    /// The cursor owns the snapshot, so later set writes are not observed.
    /// Element order is the store's bucket order, which is implementation-
    /// defined; compare sets with `Eq`, not iteration order.
    fn iter(self: HashSet<i32>) -> VecIter<i32> {
        let values: Vec<i32> = self.to_vec()
        values.iter()
    }

    /// Keeps only elements for which `keep` returns true.
    ///
    /// The predicate is evaluated against a snapshot, then matching elements
    /// are reinserted, so `keep` never observes a partially rebuilt store.
    fn retain(mut self: HashSet<i32>, keep: fn(i32) -> bool) {
        let values: Vec<i32> = self.to_vec()
        self.clear()
        let mut index: i32 = 0
        while index < values.len() {
            let value: i32 = values.get_unchecked(index)
            if keep(value) {
                let _ = self.insert(value)
            }
            index = index + 1
        }
    }

    /// Returns a new set with the elements present in either set.
    fn union(self: HashSet<i32>, other: HashSet<i32>) -> HashSet<i32> {
        self.union(other)
    }

    /// Returns a new set with the elements present in both sets.
    fn intersection(self: HashSet<i32>, other: HashSet<i32>) -> HashSet<i32> {
        self.intersection(other)
    }

    /// Returns a new set with the elements present in `self` but not `other`.
    fn difference(self: HashSet<i32>, other: HashSet<i32>) -> HashSet<i32> {
        self.difference(other)
    }

    /// Returns the current bucket capacity.
    fn capacity(self: HashSet<i32>) -> i32 {
        self.capacity()
    }

    /// Ensures room for at least `additional` more elements.
    fn reserve(mut self: HashSet<i32>, additional: i32) {
        self.reserve(additional)
    }

    /// Fallible reserve facade. The flat store has no recoverable allocation
    /// error channel, so `true` means the reserve completed.
    fn try_reserve(mut self: HashSet<i32>, additional: i32) -> bool {
        self.try_reserve(additional)
    }

    /// Shrinks the bucket capacity while preserving the load-factor invariant.
    fn shrink_to_fit(self: HashSet<i32>) {
        self.shrink_to_fit()
    }

    /// Removes all elements, setting the size to zero.
    fn clear(mut self: HashSet<i32>) {
        self.clear()
    }

    /// Inserts every element of `other` that is not already present.
    fn extend(mut self: HashSet<i32>, other: HashSet<i32>) {
        self.extend(other)
    }
}

impl HashSet<String> {
    /// Inserts `value` and returns true when it was not already present.
    fn insert(mut self: HashSet<String>, value: String) -> bool {
        self.insert(value)
    }

    /// Returns true when `value` is present in the set.
    fn contains(self: HashSet<String>, value: String) -> bool {
        self.contains(value)
    }

    /// Removes `value` and returns true when it was present.
    fn remove(mut self: HashSet<String>, value: String) -> bool {
        self.remove(value)
    }

    /// Returns the number of elements in the set.
    fn len(self: HashSet<String>) -> i32 {
        self.len()
    }

    /// Returns true when the set has no elements.
    fn is_empty(self: HashSet<String>) -> bool {
        self.is_empty()
    }

    /// Returns all elements as a `Vec<String>` snapshot in bucket order.
    fn to_vec(self: HashSet<String>) -> Vec<String> {
        self.to_vec()
    }

    /// Returns a cursor over a snapshot of the set's elements.
    ///
    /// The cursor owns the snapshot, so later set writes are not observed.
    /// Element order is the store's bucket order, which is implementation-
    /// defined; compare sets with `Eq`, not iteration order.
    fn iter(self: HashSet<String>) -> VecIter<String> {
        let values: Vec<String> = self.to_vec()
        values.iter()
    }

    /// Keeps only elements for which `keep` returns true.
    ///
    /// The predicate is evaluated against a snapshot, then matching elements
    /// are reinserted, so `keep` never observes a partially rebuilt store.
    fn retain(mut self: HashSet<String>, keep: fn(String) -> bool) {
        let values: Vec<String> = self.to_vec()
        self.clear()
        let mut index: i32 = 0
        while index < values.len() {
            let value: String = values.get_unchecked(index)
            if keep(value) {
                let _ = self.insert(value)
            }
            index = index + 1
        }
    }

    /// Returns a new set with the elements present in either set.
    fn union(self: HashSet<String>, other: HashSet<String>) -> HashSet<String> {
        self.union(other)
    }

    /// Returns a new set with the elements present in both sets.
    fn intersection(self: HashSet<String>, other: HashSet<String>) -> HashSet<String> {
        self.intersection(other)
    }

    /// Returns a new set with the elements present in `self` but not `other`.
    fn difference(self: HashSet<String>, other: HashSet<String>) -> HashSet<String> {
        self.difference(other)
    }

    /// Returns the current bucket capacity.
    fn capacity(self: HashSet<String>) -> i32 {
        self.capacity()
    }

    /// Ensures room for at least `additional` more elements.
    fn reserve(mut self: HashSet<String>, additional: i32) {
        self.reserve(additional)
    }

    /// Fallible reserve facade. The bucket store has no recoverable allocation
    /// error channel, so `true` means the reserve completed.
    fn try_reserve(mut self: HashSet<String>, additional: i32) -> bool {
        self.try_reserve(additional)
    }

    /// Shrinks the bucket capacity while preserving the load-factor invariant.
    fn shrink_to_fit(self: HashSet<String>) {
        self.shrink_to_fit()
    }

    /// Removes all elements, setting the size to zero.
    fn clear(mut self: HashSet<String>) {
        self.clear()
    }

    /// Inserts every element of `other` that is not already present.
    fn extend(mut self: HashSet<String>, other: HashSet<String>) {
        self.extend(other)
    }
}

// The set shell owns no fields, so `into_iter` snapshots the elements through
// the store's `to_vec` (matching `HashMap::into_iter`). The cursor is the
// shared `VecIter<T>` producer; no HashSet-specific iterator type is needed.
// Iteration follows the store's bucket order, which is implementation-defined;
// compare sets with Eq, not iteration order.
impl IntoIterator for HashSet<i32> {
    type Item = i32
    type IntoIter = VecIter<i32>

    fn into_iter(self: HashSet<i32>) -> VecIter<i32> {
        let values: Vec<i32> = self.to_vec()
        VecIter { vec: values, index: 0, length: values.len() }
    }
}

impl Clone for HashSet<i32> {
    fn clone(self: HashSet<i32>) -> HashSet<i32> {
        let values: Vec<i32> = self.to_vec()
        let mut result: HashSet<i32> = HashSet::new<i32>()
        let mut index: i32 = 0
        while index < values.len() {
            let _ = result.insert(values.get_unchecked(index))
            index = index + 1
        }
        result
    }
}

/// Equality compares the member sets, not the bucket layout or capacity.
impl Eq for HashSet<i32> {
    fn eq(self: HashSet<i32>, other: HashSet<i32>) -> bool {
        if self.len() != other.len() {
            return false
        }
        let values: Vec<i32> = self.to_vec()
        let mut index: i32 = 0
        while index < values.len() {
            if !other.contains(values.get_unchecked(index)) {
                return false
            }
            index = index + 1
        }
        true
    }
}

// Elements render in the store's bucket order (implementation-defined).
impl Debug for HashSet<i32> {
    fn fmt_debug(self: HashSet<i32>) -> String {
        let values: Vec<i32> = self.to_vec()
        let mut out: String = String_from("HashSet [")
        let mut index: i32 = 0
        while index < values.len() {
            if index > 0 {
                out = out.concat(String_from(", "))
            }
            out = out.concat(values.get_unchecked(index).fmt_debug())
            index = index + 1
        }
        out.concat(String_from("]"))
    }
}

// FromIterator is selected from its source type, so the concrete element
// family has to own the impl. A single `impl<T> FromIterator<VecIter<T>>`
// would be the one parametric impl ADR-078 allows, but its body cannot insert
// into the monomorphic store. The cursor is drained with `next` rather than
// `collect`: `collect` forwards to a generic helper whose mono instance is not
// specialized when the call sits in a concrete loaded-module body, leaving an
// unreachable stub at runtime (#917).
impl FromIterator<VecIter<i32>> for HashSet<i32> {
    fn from_iter(mut it: VecIter<i32>) -> HashSet<i32> {
        let mut result: HashSet<i32> = HashSet::new<i32>()
        while true {
            match it.next() {
                Option::Some(value) => { let _ = result.insert(value) },
                Option::None => { break },
            }
        }
        result
    }
}

impl FromIterator<VecIter<String>> for HashSet<String> {
    fn from_iter(mut it: VecIter<String>) -> HashSet<String> {
        let mut result: HashSet<String> = HashSet::new<String>()
        while true {
            match it.next() {
                Option::Some(value) => { let _ = result.insert(value) },
                Option::None => { break },
            }
        }
        result
    }
}

impl IntoIterator for HashSet<String> {
    type Item = String
    type IntoIter = VecIter<String>

    fn into_iter(self: HashSet<String>) -> VecIter<String> {
        let values: Vec<String> = self.to_vec()
        VecIter { vec: values, index: 0, length: values.len() }
    }
}

impl Clone for HashSet<String> {
    fn clone(self: HashSet<String>) -> HashSet<String> {
        let values: Vec<String> = self.to_vec()
        let mut result: HashSet<String> = HashSet::new<String>()
        let mut index: i32 = 0
        while index < values.len() {
            let _ = result.insert(values.get_unchecked(index))
            index = index + 1
        }
        result
    }
}

/// Equality compares the member sets, not the bucket order or capacity.
impl Eq for HashSet<String> {
    fn eq(self: HashSet<String>, other: HashSet<String>) -> bool {
        if self.len() != other.len() {
            return false
        }
        let values: Vec<String> = self.to_vec()
        let mut index: i32 = 0
        while index < values.len() {
            if !other.contains(values.get_unchecked(index)) {
                return false
            }
            index = index + 1
        }
        true
    }
}

// Elements render in the store's bucket order (implementation-defined).
impl Debug for HashSet<String> {
    fn fmt_debug(self: HashSet<String>) -> String {
        let values: Vec<String> = self.to_vec()
        let mut out: String = String_from("HashSet [")
        let mut index: i32 = 0
        while index < values.len() {
            if index > 0 {
                out = out.concat(String_from(", "))
            }
            out = out.concat(values.get_unchecked(index).fmt_debug())
            index = index + 1
        }
        out.concat(String_from("]"))
    }
}

test mod "hashset" {
    test "new_is_empty" {
        let s: HashSet<i32> = HashSet::new<i32>()
        assert(s.is_empty())
        assert(s.len() == 0)
    }
    test "insert_returns_true_first_time" {
        let mut s: HashSet<i32> = HashSet::new<i32>()
        assert(s.insert(7))
        assert(s.len() == 1)
    }
    test "insert_duplicate_returns_false" {
        let mut s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(7)
        assert(s.insert(7) == false)
        assert(s.len() == 1)
    }
    test "contains_after_insert" {
        let mut s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(42)
        assert(s.contains(42))
        assert(s.contains(43) == false)
    }
    test "remove_existing" {
        let mut s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(5)
        assert(s.remove(5))
        assert(s.contains(5) == false)
        assert(s.len() == 0)
    }
    test "remove_missing_returns_false" {
        let mut s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(5)
        assert(s.remove(6) == false)
    }
    test "union_combines" {
        let mut a: HashSet<i32> = HashSet::new<i32>()
        let _ = a.insert(1)
        let _ = a.insert(2)
        let mut b: HashSet<i32> = HashSet::new<i32>()
        let _ = b.insert(2)
        let _ = b.insert(3)
        let u: HashSet<i32> = a.union(b)
        assert(u.len() == 3)
        assert(u.contains(1))
        assert(u.contains(3))
    }
    test "intersection_common_only" {
        let mut a: HashSet<i32> = HashSet::new<i32>()
        let _ = a.insert(1)
        let _ = a.insert(2)
        let mut b: HashSet<i32> = HashSet::new<i32>()
        let _ = b.insert(2)
        let _ = b.insert(3)
        let i: HashSet<i32> = a.intersection(b)
        assert(i.len() == 1)
        assert(i.contains(2))
    }
    test "difference_excludes_b" {
        let mut a: HashSet<i32> = HashSet::new<i32>()
        let _ = a.insert(1)
        let _ = a.insert(2)
        let mut b: HashSet<i32> = HashSet::new<i32>()
        let _ = b.insert(2)
        let d: HashSet<i32> = a.difference(b)
        assert(d.len() == 1)
        assert(d.contains(1))
    }
    test "clear_resets" {
        let mut s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(1)
        let _ = s.insert(2)
        s.clear()
        assert(s.is_empty())
    }
    test "extend_merges" {
        let mut s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(1)
        let mut other: HashSet<i32> = HashSet::new<i32>()
        let _ = other.insert(2)
        let _ = other.insert(3)
        s.extend(other)
        assert(s.len() == 3)
    }
    test "many_insert_no_dup_growth" {
        let mut s: HashSet<i32> = HashSet::new<i32>()
        let mut i = 0
        while i < 40 {
            let _ = s.insert(i)
            i = i + 1
        }
        assert(s.is_empty() == false)
        assert(s.len() == 40)
        assert(s.contains(0))
        assert(s.contains(39))
    }
    test "string_membership" {
        let mut s: HashSet<String> = HashSet::new<String>()
        assert(s.insert("red"))
        assert(s.insert("green"))
        assert(s.contains("red"))
        assert(s.remove("red"))
        assert(s.len() == 1)
        assert(s.contains("green"))
    }
    test "from_iter_dedups_i32" {
        let mut values: Vec<i32> = Vec::new<i32>()
        push(values, 4)
        push(values, 5)
        push(values, 4)
        let s: HashSet<i32> = HashSet::from_iter(values.iter())
        assert(s.len() == 2)
        assert(s.contains(4))
        assert(s.contains(5))
    }
    test "string_traits" {
        let mut s: HashSet<String> = HashSet::new<String>()
        assert(s.insert("red"))
        assert(s.insert("blue"))
        assert(s.insert("red"))
        assert(s.len() == 2)
        assert(s.contains("blue"))
        let copy: HashSet<String> = s.clone()
        assert(copy.eq(s))
        let values: Vec<String> = s.to_vec()
        assert(values.len() == 2)
        let mut total: i32 = 0
        for word in s {
            total = total + word.len()
        }
        assert(total == 7)
    }
}
