//! std::collections::hash_set — `HashSet<i32>` / `HashSet<String>` type surface
//!
//! `HashSet::new<T>()` plus the receiver methods are the canonical spelling for
//! the flat `i32` set store in `std::collections::hash` and the `Vec<String>`
//! facade in `std::collections::hash_string`. MIR rewrites the shell calls to
//! the store functions, so the shell bodies never recurse at runtime.
//!
//! The aggregate operations (`to_vec`, `union`, `intersection`, `difference`,
//! `capacity`, `reserve`, `shrink_to_fit`, `clear`, `extend`) are available on
//! `HashSet<i32>`. The `String` surface keeps the membership lane; its store
//! has no aggregate operations yet.
//!
//! The `hashset_i32_*` / `hashset_str_*` compatibility adapters were retired in
//! #917; this module's only public symbols are `HashSet` and its methods.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability
//! required.

use std::collections::hash
use std::collections::hash_string
use std::core::clone
use std::core::cmp
use std::core::convert
use std::core::iter

/// A set of unique `i32` or `String` values.
///
/// Construct with `HashSet::new<i32>()` / `HashSet::new<String>()` and use the
/// receiver methods; the `i32` aggregate and membership operations lower to the
/// flat hash store, and the `String` membership operations lower to the
/// `Vec<String>` facade. The storage representation is private.
pub struct HashSet<T> {
}

impl<T> HashSet<T> {
    /// Creates an empty set.
    fn new() -> HashSet<T> {
        HashSet::new<T>()
    }
}

impl HashSet<i32> {
    /// Inserts `value` and returns true when it was not already present.
    fn insert(self: HashSet<i32>, value: i32) -> bool {
        self.insert(value)
    }

    /// Returns true when `value` is present in the set.
    fn contains(self: HashSet<i32>, value: i32) -> bool {
        self.contains(value)
    }

    /// Removes `value` and returns true when it was present.
    fn remove(self: HashSet<i32>, value: i32) -> bool {
        self.remove(value)
    }

    /// Returns the number of elements in the set.
    fn len(self: HashSet<i32>) -> i32 {
        self.len()
    }

    /// Returns true when the set has no elements.
    fn is_empty(self: HashSet<i32>) -> bool {
        self.is_empty()
    }

    /// Returns all elements as a `Vec<i32>` in implementation-defined order.
    fn to_vec(self: HashSet<i32>) -> Vec<i32> {
        self.to_vec()
    }

    /// Returns a new set with the elements present in either set.
    fn union(self: HashSet<i32>, other: HashSet<i32>) -> HashSet<i32> {
        self.union(other)
    }

    /// Returns a new set with the elements present in both sets.
    fn intersection(self: HashSet<i32>, other: HashSet<i32>) -> HashSet<i32> {
        self.intersection(other)
    }

    /// Returns a new set with the elements present in `self` but not `other`.
    fn difference(self: HashSet<i32>, other: HashSet<i32>) -> HashSet<i32> {
        self.difference(other)
    }

    /// Returns the current bucket capacity.
    fn capacity(self: HashSet<i32>) -> i32 {
        self.capacity()
    }

    /// Ensures room for at least `additional` more elements.
    fn reserve(self: HashSet<i32>, additional: i32) {
        self.reserve(additional)
    }

    /// Shrinks the bucket capacity while preserving the load-factor invariant.
    fn shrink_to_fit(self: HashSet<i32>) {
        self.shrink_to_fit()
    }

    /// Removes all elements, setting the size to zero.
    fn clear(self: HashSet<i32>) {
        self.clear()
    }

    /// Inserts every element of `other` that is not already present.
    fn extend(self: HashSet<i32>, other: HashSet<i32>) {
        self.extend(other)
    }
}

impl HashSet<String> {
    /// Inserts `value` and returns true when it was not already present.
    fn insert(self: HashSet<String>, value: String) -> bool {
        self.insert(value)
    }

    /// Returns true when `value` is present in the set.
    fn contains(self: HashSet<String>, value: String) -> bool {
        self.contains(value)
    }

    /// Removes `value` and returns true when it was present.
    fn remove(self: HashSet<String>, value: String) -> bool {
        self.remove(value)
    }

    /// Returns the number of elements in the set.
    fn len(self: HashSet<String>) -> i32 {
        self.len()
    }

    /// Returns true when the set has no elements.
    fn is_empty(self: HashSet<String>) -> bool {
        self.is_empty()
    }
}

// The set shell owns no fields, so `into_iter` snapshots the elements through
// the store's `to_vec` (matching `HashMap::into_iter`). The cursor is the
// shared `VecIter<T>` producer; no HashSet-specific iterator type is needed.
// Iteration follows the store's bucket order, which is implementation-defined;
// compare sets with Eq, not iteration order.
impl IntoIterator for HashSet<i32> {
    type Item = i32
    type IntoIter = VecIter<i32>

    fn into_iter(self: HashSet<i32>) -> VecIter<i32> {
        let values: Vec<i32> = self.to_vec()
        VecIter { vec: values, index: 0, length: len(values) }
    }
}

impl Clone for HashSet<i32> {
    fn clone(self: HashSet<i32>) -> HashSet<i32> {
        let values: Vec<i32> = self.to_vec()
        let result: HashSet<i32> = HashSet::new<i32>()
        let mut index: i32 = 0
        while index < len(values) {
            let _ = result.insert(get_unchecked(values, index))
            index = index + 1
        }
        result
    }
}

/// Equality compares the member sets, not the bucket layout or capacity.
impl Eq for HashSet<i32> {
    fn eq(self: HashSet<i32>, other: HashSet<i32>) -> bool {
        if self.len() != other.len() {
            return false
        }
        let values: Vec<i32> = self.to_vec()
        let mut index: i32 = 0
        while index < len(values) {
            if !other.contains(get_unchecked(values, index)) {
                return false
            }
            index = index + 1
        }
        true
    }
}

// Elements render in the store's bucket order (implementation-defined).
impl Debug for HashSet<i32> {
    fn fmt_debug(self: HashSet<i32>) -> String {
        let values: Vec<i32> = self.to_vec()
        let mut out: String = String_from("HashSet [")
        let mut index: i32 = 0
        while index < len(values) {
            if index > 0 {
                out = out.concat(String_from(", "))
            }
            out = out.concat(get_unchecked(values, index).fmt_debug())
            index = index + 1
        }
        out.concat(String_from("]"))
    }
}

test mod "hashset" {
    test "new_is_empty" {
        let s: HashSet<i32> = HashSet::new<i32>()
        assert(s.is_empty())
        assert(s.len() == 0)
    }
    test "insert_returns_true_first_time" {
        let s: HashSet<i32> = HashSet::new<i32>()
        assert(s.insert(7))
        assert(s.len() == 1)
    }
    test "insert_duplicate_returns_false" {
        let s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(7)
        assert(s.insert(7) == false)
        assert(s.len() == 1)
    }
    test "contains_after_insert" {
        let s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(42)
        assert(s.contains(42))
        assert(s.contains(43) == false)
    }
    test "remove_existing" {
        let s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(5)
        assert(s.remove(5))
        assert(s.contains(5) == false)
        assert(s.len() == 0)
    }
    test "remove_missing_returns_false" {
        let s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(5)
        assert(s.remove(6) == false)
    }
    test "union_combines" {
        let a: HashSet<i32> = HashSet::new<i32>()
        let _ = a.insert(1)
        let _ = a.insert(2)
        let b: HashSet<i32> = HashSet::new<i32>()
        let _ = b.insert(2)
        let _ = b.insert(3)
        let u: HashSet<i32> = a.union(b)
        assert(u.len() == 3)
        assert(u.contains(1))
        assert(u.contains(3))
    }
    test "intersection_common_only" {
        let a: HashSet<i32> = HashSet::new<i32>()
        let _ = a.insert(1)
        let _ = a.insert(2)
        let b: HashSet<i32> = HashSet::new<i32>()
        let _ = b.insert(2)
        let _ = b.insert(3)
        let i: HashSet<i32> = a.intersection(b)
        assert(i.len() == 1)
        assert(i.contains(2))
    }
    test "difference_excludes_b" {
        let a: HashSet<i32> = HashSet::new<i32>()
        let _ = a.insert(1)
        let _ = a.insert(2)
        let b: HashSet<i32> = HashSet::new<i32>()
        let _ = b.insert(2)
        let d: HashSet<i32> = a.difference(b)
        assert(d.len() == 1)
        assert(d.contains(1))
    }
    test "clear_resets" {
        let s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(1)
        let _ = s.insert(2)
        s.clear()
        assert(s.is_empty())
    }
    test "extend_merges" {
        let s: HashSet<i32> = HashSet::new<i32>()
        let _ = s.insert(1)
        let other: HashSet<i32> = HashSet::new<i32>()
        let _ = other.insert(2)
        let _ = other.insert(3)
        s.extend(other)
        assert(s.len() == 3)
    }
    test "many_insert_no_dup_growth" {
        let s: HashSet<i32> = HashSet::new<i32>()
        let mut i = 0
        while i < 40 {
            let _ = s.insert(i)
            i = i + 1
        }
        assert(s.is_empty() == false)
        assert(s.len() == 40)
        assert(s.contains(0))
        assert(s.contains(39))
    }
    test "string_membership" {
        let s: HashSet<String> = HashSet::new<String>()
        assert(s.insert("red"))
        assert(s.insert("green"))
        assert(s.contains("red"))
        assert(s.remove("red"))
        assert(s.len() == 1)
        assert(s.contains("green"))
    }
}
