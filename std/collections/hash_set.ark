//! std::collections::hash_set — HashSet API
//!
//! Re-exports the HashSet operations from std::collections::hash.
//! Vec<i32> is backed by the monomorphic hash::hashset_* functions.

use std::collections::hash
use std::collections::hash_string

/// Create a new Vec<i32>.
pub fn hashset_i32_new() -> Vec<i32> {
    hash::hashset_new()
}

/// Insert a value into a Vec<i32>. Returns true if the value was newly inserted.
pub fn hashset_i32_insert(s: Vec<i32>, value: i32) -> bool {
    hash::hashset_insert(s, value)
}

/// Returns true if the Vec<i32> contains the value.
pub fn hashset_i32_contains(s: Vec<i32>, value: i32) -> bool {
    hash::hashset_contains(s, value)
}

/// Remove a value from the Vec<i32>. Returns true if the value was present.
pub fn hashset_i32_remove(s: Vec<i32>, value: i32) -> bool {
    hash::hashset_remove(s, value)
}

/// Return the number of elements in the Vec<i32>.
pub fn hashset_i32_len(s: Vec<i32>) -> i32 {
    hash::hashset_len(s)
}

/// Returns true if the Vec<i32> is empty.
pub fn hashset_i32_is_empty(s: Vec<i32>) -> bool {
    hash::hashset_is_empty(s)
}

/// Convert the Vec<i32> to a Vec<i32>.
pub fn hashset_i32_to_vec(s: Vec<i32>) -> Vec<i32> {
    hash::hashset_to_vec(s)
}

/// Return the union of two Vec<i32>s.
pub fn hashset_i32_union(a: Vec<i32>, b: Vec<i32>) -> Vec<i32> {
    hash::hashset_union(a, b)
}

/// Return the intersection of two Vec<i32>s.
pub fn hashset_i32_intersection(a: Vec<i32>, b: Vec<i32>) -> Vec<i32> {
    hash::hashset_intersection(a, b)
}

/// Return the difference of two Vec<i32>s (elements in a but not b).
pub fn hashset_i32_difference(a: Vec<i32>, b: Vec<i32>) -> Vec<i32> {
    hash::hashset_difference(a, b)
}

/// Return the current bucket capacity of the Vec<i32>.
pub fn hashset_i32_capacity(s: Vec<i32>) -> i32 {
    hash::hashset_capacity(s)
}

/// Ensure the Vec<i32> can hold at least `additional` more elements
/// without exceeding the load-factor threshold.
pub fn hashset_i32_reserve(s: Vec<i32>, additional: i32) {
    hash::hashset_reserve(s, additional)
}

/// Shrink the Vec<i32> to the minimum capacity preserving the load-factor
/// invariant.
pub fn hashset_i32_shrink_to_fit(s: Vec<i32>) {
    hash::hashset_shrink_to_fit(s)
}

/// Remove all elements from the Vec<i32>, resetting size to 0.
pub fn hashset_i32_clear(s: Vec<i32>) {
    hash::hashset_clear(s)
}

/// Extend a Vec<i32> with all elements from another set (`other`).
/// Mirrors Rust's `HashSet::extend`.
pub fn hashset_i32_extend(s: Vec<i32>, other: Vec<i32>) {
    hash::hashset_extend(s, other)
}

/// Create a new HashSet<String>.
pub fn hashset_str_new() -> Vec<String> {
    hash_string::hashset_str_new()
}

test mod "hashset_i32" {
    test "new_is_empty" {
        let s = hashset_i32_new()
        assert(hashset_i32_is_empty(s))
        assert(hashset_i32_len(s) == 0)
    }
    test "insert_returns_true_first_time" {
        let s = hashset_i32_new()
        assert(hashset_i32_insert(s, 7))
        assert(hashset_i32_len(s) == 1)
    }
    test "insert_duplicate_returns_false" {
        let s = hashset_i32_new()
        hashset_i32_insert(s, 7)
        assert(hashset_i32_insert(s, 7) == false)
        assert(hashset_i32_len(s) == 1)
    }
    test "contains_after_insert" {
        let s = hashset_i32_new()
        hashset_i32_insert(s, 42)
        assert(hashset_i32_contains(s, 42))
        assert(hashset_i32_contains(s, 43) == false)
    }
    test "remove_existing" {
        let s = hashset_i32_new()
        hashset_i32_insert(s, 5)
        assert(hashset_i32_remove(s, 5))
        assert(hashset_i32_contains(s, 5) == false)
        assert(hashset_i32_len(s) == 0)
    }
    test "remove_missing_returns_false" {
        let s = hashset_i32_new()
        hashset_i32_insert(s, 5)
        assert(hashset_i32_remove(s, 6) == false)
    }
    test "union_combines" {
        let a = hashset_i32_new()
        hashset_i32_insert(a, 1)
        hashset_i32_insert(a, 2)
        let b = hashset_i32_new()
        hashset_i32_insert(b, 2)
        hashset_i32_insert(b, 3)
        let u = hashset_i32_union(a, b)
        assert(hashset_i32_len(u) == 3)
        assert(hashset_i32_contains(u, 1))
        assert(hashset_i32_contains(u, 3))
    }
    test "intersection_common_only" {
        let a = hashset_i32_new()
        hashset_i32_insert(a, 1)
        hashset_i32_insert(a, 2)
        let b = hashset_i32_new()
        hashset_i32_insert(b, 2)
        hashset_i32_insert(b, 3)
        let i = hashset_i32_intersection(a, b)
        assert(hashset_i32_len(i) == 1)
        assert(hashset_i32_contains(i, 2))
    }
    test "difference_excludes_b" {
        let a = hashset_i32_new()
        hashset_i32_insert(a, 1)
        hashset_i32_insert(a, 2)
        let b = hashset_i32_new()
        hashset_i32_insert(b, 2)
        let d = hashset_i32_difference(a, b)
        assert(hashset_i32_len(d) == 1)
        assert(hashset_i32_contains(d, 1))
    }
    test "clear_resets" {
        let s = hashset_i32_new()
        hashset_i32_insert(s, 1)
        hashset_i32_insert(s, 2)
        hashset_i32_clear(s)
        assert(hashset_i32_is_empty(s))
    }
    test "extend_merges" {
        let s = hashset_i32_new()
        hashset_i32_insert(s, 1)
        let other = hashset_i32_new()
        hashset_i32_insert(other, 2)
        hashset_i32_insert(other, 3)
        hashset_i32_extend(s, other)
        assert(hashset_i32_len(s) == 3)
    }
    test "many_insert_no_dup_growth" {
        let s = hashset_i32_new()
        let mut i = 0
        while i < 40 {
            hashset_i32_insert(s, i)
            i = i + 1
        }
        assert(hashset_i32_len(s) == 40)
        assert(hashset_i32_contains(s, 0))
        assert(hashset_i32_contains(s, 39))
    }
}

/// Insert a value into a HashSet<String>. Returns true if the value was newly inserted.
pub fn hashset_str_insert(s: Vec<String>, value: String) -> bool {
    hash_string::hashset_str_insert(s, value)
}

/// Returns true if the HashSet<String> contains the value.
pub fn hashset_str_contains(s: Vec<String>, value: String) -> bool {
    hash_string::hashset_str_contains(s, value)
}

/// Remove a value from the HashSet<String>. Returns true if the value was present.
pub fn hashset_str_remove(s: Vec<String>, value: String) -> bool {
    hash_string::hashset_str_remove(s, value)
}

/// Return the number of elements in the HashSet<String>.
pub fn hashset_str_len(s: Vec<String>) -> i32 {
    hash_string::hashset_str_len(s)
}

/// Returns true if the HashSet<String> is empty.
pub fn hashset_str_is_empty(s: Vec<String>) -> bool {
    hash_string::hashset_str_is_empty(s)
}
