//! HashMap<String, fn> implementation for GC funcref value ABI (#838).
//!
//! Kept separate from `hash_string.ark` / `hash_fn.ark` so stage-2 rebuilds that
//! still load those modules do not require the previous compiler to know `__hm_sf_*`.
//! The functions here are non-public MIR lowering targets for the
//! `impl HashMap<K, V>` methods; the user spelling is `HashMap::new<K, V>()`
//! plus receiver methods.

use std::core::hash
fn hashmap_str_fn_new() -> HashMap<String, fn(i32) -> i32> {
    __hm_sf_new()
}

fn hm_sf_grow(m: HashMap<String, fn(i32) -> i32>) {
    let old_cap: i32 = __hm_sf_cap(m)
    let dst: HashMap<String, fn(i32) -> i32> = __hm_sf_new_with_cap(old_cap * 2)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_sf_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_str_fn_set_probe(dst, __hm_sf_get_key(m, i), __hm_sf_get_val(m, i))
        }
        i = i + 1
    }
    __hm_sf_adopt(m, dst)
}

fn hm_sf_ensure_insert_capacity(m: HashMap<String, fn(i32) -> i32>, key: String) {
    if !hashmap_str_fn_contains(m, key) {
        let cap: i32 = __hm_sf_cap(m)
        let needed: i32 = __hm_sf_size(m) + 1
        if cap * 3 < needed * 4 {
            hm_sf_grow(m)
        }
    }
}

/// String→fn set: grows before the load factor exceeds 0.75 (#895).
fn hashmap_str_fn_set(
    m: HashMap<String, fn(i32) -> i32>,
    key: String,
    value: fn(i32) -> i32
) -> bool {
    hm_sf_ensure_insert_capacity(m, key.clone())
    hashmap_str_fn_set_probe(m, key, value)
}

fn hashmap_str_fn_set_probe(
    m: HashMap<String, fn(i32) -> i32>,
    key: String,
    value: fn(i32) -> i32
) -> bool {
    let cap: i32 = __hm_sf_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut done: bool = false
    while probes < cap {
        let flag: i32 = __hm_sf_get_flag(m, idx)
        if flag == 0 || flag == 2 {
            __hm_sf_set_key(m, idx, key)
            __hm_sf_set_val(m, idx, value)
            __hm_sf_set_flag(m, idx, 1)
            __hm_sf_set_size(m, __hm_sf_size(m) + 1)
            done = true
            probes = cap
        } else if __hm_sf_get_key(m, idx).eq(key) {
            __hm_sf_set_val(m, idx, value)
            done = true
            probes = cap
        } else {
            idx = (idx + 1) % cap
            probes = probes + 1
        }
    }
    done
}

fn hashmap_str_fn_get(
    m: HashMap<String, fn(i32) -> i32>,
    key: String
) -> Option<fn(i32) -> i32> {
    let cap: i32 = __hm_sf_cap(m)
    let hashed: i32 = key.hash()
    let mut idx: i32 = hashed % cap
    let mut probes: i32 = 0
    let mut result: Option<fn(i32) -> i32> = None
    while probes < cap {
        let flag: i32 = __hm_sf_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else if flag == 1 {
            let k: String = __hm_sf_get_key(m, idx)
            if k.eq(key) {
                result = Some(__hm_sf_get_val(m, idx))
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        } else {
            idx = (idx + 1) % cap
            probes = probes + 1
        }
    }
    result
}

fn hashmap_str_fn_contains(m: HashMap<String, fn(i32) -> i32>, key: String) -> bool {
    let cap: i32 = __hm_sf_cap(m)
    let h: i32 = key.hash()
    let mut idx: i32 = h % cap
    let mut probes: i32 = 0
    let mut found: bool = false
    while probes < cap {
        let flag: i32 = __hm_sf_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else if flag == 1 {
            let k: String = __hm_sf_get_key(m, idx)
            if k.eq(key) {
                found = true
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        } else {
            idx = (idx + 1) % cap
            probes = probes + 1
        }
    }
    found
}

fn hashmap_str_fn_remove(
    m: HashMap<String, fn(i32) -> i32>,
    key: String
) -> Option<fn(i32) -> i32> {
    let cap: i32 = __hm_sf_cap(m)
    let hashed: i32 = key.hash()
    let mut idx: i32 = hashed % cap
    let mut probes: i32 = 0
    let mut result: Option<fn(i32) -> i32> = None
    while probes < cap {
        let flag: i32 = __hm_sf_get_flag(m, idx)
        if flag == 0 {
            probes = cap
        } else if flag == 1 {
            let k: String = __hm_sf_get_key(m, idx)
            if k.eq(key) {
                result = Some(__hm_sf_get_val(m, idx))
                __hm_sf_set_flag(m, idx, 2)
                __hm_sf_set_size(m, __hm_sf_size(m) - 1)
                probes = cap
            } else {
                idx = (idx + 1) % cap
                probes = probes + 1
            }
        } else {
            idx = (idx + 1) % cap
            probes = probes + 1
        }
    }
    result
}

fn hashmap_str_fn_len(m: HashMap<String, fn(i32) -> i32>) -> i32 {
    __hm_sf_size(m)
}

/// Return a Vec<String> of all keys currently in a HashMap<String, fn>.
fn hashmap_str_fn_keys(m: HashMap<String, fn(i32) -> i32>) -> Vec<String> {
    let cap: i32 = __hm_sf_cap(m)
    let mut result: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_sf_get_flag(m, i) == 1 {
            push(result, __hm_sf_get_key(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<fn(i32) -> i32> of all values currently in the map.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_fn_values(m: HashMap<String, fn(i32) -> i32>) -> Vec<fn(i32) -> i32> {
    let cap: i32 = __hm_sf_cap(m)
    let mut result: Vec<fn(i32) -> i32> = Vec::new<fn(i32) -> i32>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_sf_get_flag(m, i) == 1 {
            push(result, __hm_sf_get_val(m, i))
        }
        i = i + 1
    }
    result
}

/// Return a Vec<(String, fn(i32) -> i32)> snapshot of all entries.
/// Bucket order is implementation-defined; callers must not rely on it.
fn hashmap_str_fn_entries(m: HashMap<String, fn(i32) -> i32>) -> Vec<(String, fn(i32) -> i32)> {
    let cap: i32 = __hm_sf_cap(m)
    let mut result: Vec<(String, fn(i32) -> i32)> = Vec::new<(String, fn(i32) -> i32)>()
    let mut i: i32 = 0
    while i < cap {
        if __hm_sf_get_flag(m, i) == 1 {
            push(result, (__hm_sf_get_key(m, i), __hm_sf_get_val(m, i)))
        }
        i = i + 1
    }
    result
}

/// Insert a function value and return the previous value if present.
/// `HashMap::insert` lowering target for the String/fn family (#874).
fn hashmap_str_fn_insert(
    m: HashMap<String, fn(i32) -> i32>,
    key: String,
    value: fn(i32) -> i32
) -> Option<fn(i32) -> i32> {
    let old: Option<fn(i32) -> i32> = hashmap_str_fn_get(m, key)
    let _stored: bool = hashmap_str_fn_set(m, key, value)
    old
}

fn hashmap_str_fn_is_empty(m: HashMap<String, fn(i32) -> i32>) -> bool {
    hashmap_str_fn_len(m) == 0
}

// ─── Capacity / bulk maintenance ───────────────────────────────────────────
// Lowering targets for the generic capacity surface. String keys and fnref
// values live in the compiler-managed bucket arrays, so every operation goes
// through the __hm_sf_* bridge.

fn hashmap_str_fn_with_capacity(cap: i32) -> HashMap<String, fn(i32) -> i32> {
    let mut actual_cap: i32 = cap
    if actual_cap < 1 {
        actual_cap = 1
    }
    __hm_sf_new_with_cap(actual_cap)
}

fn hashmap_str_fn_capacity(m: HashMap<String, fn(i32) -> i32>) -> i32 {
    __hm_sf_cap(m)
}

fn hashmap_str_fn_min_capacity(entries: i32) -> i32 {
    let mut cap: i32 = 1
    while cap * 3 < entries * 4 {
        cap = cap * 2
    }
    cap
}

fn hashmap_str_fn_rehash_to(m: HashMap<String, fn(i32) -> i32>, requested_cap: i32) {
    let old_cap: i32 = __hm_sf_cap(m)
    let mut target_cap: i32 = hashmap_str_fn_min_capacity(__hm_sf_size(m))
    if requested_cap > target_cap {
        target_cap = requested_cap
    }
    if target_cap == old_cap {
        return
    }
    let dst: HashMap<String, fn(i32) -> i32> = __hm_sf_new_with_cap(target_cap)
    let mut i: i32 = 0
    while i < old_cap {
        if __hm_sf_get_flag(m, i) == 1 {
            let _stored: bool = hashmap_str_fn_set_probe(dst, __hm_sf_get_key(m, i), __hm_sf_get_val(m, i))
        }
        i = i + 1
    }
    __hm_sf_adopt(m, dst)
}

fn hashmap_str_fn_reserve(m: HashMap<String, fn(i32) -> i32>, additional: i32) {
    if additional > 0 {
        let needed_cap: i32 = hashmap_str_fn_min_capacity(__hm_sf_size(m) + additional)
        if needed_cap > __hm_sf_cap(m) {
            hashmap_str_fn_rehash_to(m, needed_cap)
        }
    }
}

fn hashmap_str_fn_try_reserve(m: HashMap<String, fn(i32) -> i32>, additional: i32) -> bool {
    hashmap_str_fn_reserve(m, additional)
    true
}

fn hashmap_str_fn_shrink_to_fit(m: HashMap<String, fn(i32) -> i32>) {
    let target_cap: i32 = hashmap_str_fn_min_capacity(__hm_sf_size(m))
    if target_cap < __hm_sf_cap(m) {
        hashmap_str_fn_rehash_to(m, target_cap)
    }
}

fn hashmap_str_fn_clear(m: HashMap<String, fn(i32) -> i32>) {
    let cap: i32 = __hm_sf_cap(m)
    __hm_sf_set_size(m, 0)
    let mut i: i32 = 0
    while i < cap {
        __hm_sf_set_flag(m, i, 0)
        i = i + 1
    }
}

fn hashmap_str_fn_drain(m: HashMap<String, fn(i32) -> i32>) -> Vec<(String, fn(i32) -> i32)> {
    let result: Vec<(String, fn(i32) -> i32)> = hashmap_str_fn_entries(m)
    hashmap_str_fn_clear(m)
    result
}

fn hashmap_str_fn_remove_entry(
    m: HashMap<String, fn(i32) -> i32>,
    key: String
) -> Option<(String, fn(i32) -> i32)> {
    let old: Option<fn(i32) -> i32> = hashmap_str_fn_remove(m, key.clone())
    match old {
        Option::Some(value) => Option::Some((key, value)),
        Option::None => Option::None,
    }
}

fn hashmap_str_fn_extend(
    m: HashMap<String, fn(i32) -> i32>,
    other: HashMap<String, fn(i32) -> i32>
) {
    let mut pending: Vec<(String, fn(i32) -> i32)> = hashmap_str_fn_entries(other)
    while len(pending) > 0 {
        match pending.pop() {
            Option::Some(pair) => {
                let (key, value) = pair
                let _stored: bool = hashmap_str_fn_set(m, key, value)
            }
            Option::None => {}
        }
    }
}
