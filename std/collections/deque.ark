//! `Deque<T>`, `Queue<T>`, and `Stack<T>` — linear collections over shared
//! two-stack storage.
//!
//! Storage is a pair of `Vec<T>` stacks: `front_items` holds the front half in
//! reverse order and `back_items` holds the back half in order. When one side
//! empties during a pop, the other side is reversed into it, so every element
//! moves at most once per traversal between the two stacks. A growable ring
//! buffer would need preallocated element slots; a generic struct field of
//! `Vec<Option<T>>` (or raw slot writes) does not lower on `wasm32-gc`, so this
//! representation is used instead while keeping the same public contract.
//!
//! `capacity` / `reserve` expose the logical reservation: pushes grow it and
//! `reserve` rebuilds both stacks through `Vec::with_capacity` so the
//! reservation is backed by the vector allocators.
//!
//! `Queue<T>` and `Stack<T>` are restricted newtypes over `Deque<T>`. Their
//! `push` / `pop` names encode the direction so callers do not have to
//! remember which `Deque` end implements FIFO or LIFO. They share the
//! `DequeIter` / `DequeIntoIter` cursors instead of declaring look-alike
//! iterator types.
//!
//! Cursors hold the collection handle rather than a borrowed reference, so the
//! type checker does not yet reject a push / pop / clear while an iterator is
//! alive. Do not structurally modify a collection during iteration; the
//! borrow / lifetime design will enforce this later (ADR-086 §5).
//!
//! `FromIterator<VecIter<T>>` fills the logical front-to-back order from a
//! `Vec` cursor and `Eq` compares length plus that order while ignoring the
//! capacity reservation. ADR-078 §3 allows one parametric impl per
//! (trait, self constructor), so the collection's own cursors cannot be added
//! as further `FromIterator` sources; the shared `VecIter<T>` source is used
//! for `Deque`, `Queue`, and `Stack`.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

use std::core::iter
use std::core::clone
use std::core::cmp
use std::core::convert
use std::text

/// Double-ended queue with private two-stack storage.
///
/// Elements are reachable only through the methods below. Empty pops and peeks
/// return `Option::None`; there is no `0` sentinel and no panic path.
pub struct Deque<T> {
    front_items: Vec<T>,
    back_items: Vec<T>,
    reserved: i32,
}

// Logical index → physical slot. `front_items` is stored back-to-front so the
// last slot is the front element; `back_items` is stored front-to-back.
fn deque_at<T>(deque: Deque<T>, index: i32) -> T {
    let front_len: i32 = len(deque.front_items)
    if index < front_len {
        return get_unchecked(deque.front_items, front_len - 1 - index)
    }
    get_unchecked(deque.back_items, index - front_len)
}

fn deque_replace_at<T>(mut deque: Deque<T>, index: i32, value: T) -> T {
    let front_len: i32 = len(deque.front_items)
    if index < front_len {
        let slot: i32 = front_len - 1 - index
        let old: T = get_unchecked(deque.front_items, slot)
        set(deque.front_items, slot, value)
        return old
    }
    let slot: i32 = index - front_len
    let old: T = get_unchecked(deque.back_items, slot)
    set(deque.back_items, slot, value)
    old
}

// Logical-order equality shared by `Deque`, `Queue`, and `Stack`. Comparing
// the two stacks slot by slot would report `[front 1, 2]` and `[back 1, 2]`
// as different even though both read front to back as `1, 2`, so each side
// maps its logical index onto whichever stack currently owns that element.
fn deque_items_eq<T: Eq>(left: Deque<T>, right: Deque<T>) -> bool {
    let left_front: i32 = len(left.front_items)
    let right_front: i32 = len(right.front_items)
    let count: i32 = left_front + len(left.back_items)
    if count != right_front + len(right.back_items) {
        return false
    }
    let mut index: i32 = 0
    while index < count {
        let left_value: T = if index < left_front {
            get_unchecked(left.front_items, left_front - 1 - index)
        } else {
            get_unchecked(left.back_items, index - left_front)
        }
        let right_value: T = if index < right_front {
            get_unchecked(right.front_items, right_front - 1 - index)
        } else {
            get_unchecked(right.back_items, index - right_front)
        }
        if !left_value.eq(right_value) {
            return false
        }
        index = index + 1
    }
    true
}

fn normalized_capacity(capacity: i32) -> i32 {
    if capacity > 0 { capacity } else { 0 }
}

impl<T> Deque<T> {
    /// Creates an empty deque.
    fn new() -> Deque<T> {
        Deque { front_items: Vec::new<T>(), back_items: Vec::new<T>(), reserved: 0 }
    }

    /// Creates an empty deque with a logical capacity reservation.
    ///
    /// A negative `capacity` is treated as `0`; this never panics.
    fn with_capacity(capacity: i32) -> Deque<T> {
        let cap: i32 = normalized_capacity(capacity)
        Deque { front_items: Vec::with_capacity<T>(cap), back_items: Vec::new<T>(), reserved: cap }
    }

    /// Inserts `value` at the back.
    fn push_back(mut self: Deque<T>, value: T) {
        push(self.back_items, value)
        self.note_growth()
    }

    /// Inserts `value` at the front.
    fn push_front(mut self: Deque<T>, value: T) {
        push(self.front_items, value)
        self.note_growth()
    }

    /// Removes and returns the back element, or `None` when empty.
    fn pop_back(mut self: Deque<T>) -> Option<T> {
        if len(self.back_items) == 0 {
            while len(self.front_items) > 0 {
                match pop(self.front_items) {
                    Option::Some(value) => push(self.back_items, value),
                    Option::None => { break },
                }
            }
        }
        pop(self.back_items)
    }

    /// Removes and returns the front element, or `None` when empty.
    fn pop_front(mut self: Deque<T>) -> Option<T> {
        if len(self.front_items) == 0 {
            while len(self.back_items) > 0 {
                match pop(self.back_items) {
                    Option::Some(value) => push(self.front_items, value),
                    Option::None => { break },
                }
            }
        }
        pop(self.front_items)
    }

    /// Peeks at the front element without removing it.
    fn front(self: Deque<T>) -> Option<T> {
        if len(self.front_items) > 0 {
            return Option::Some(get_unchecked(self.front_items, len(self.front_items) - 1))
        }
        if len(self.back_items) > 0 {
            return Option::Some(get_unchecked(self.back_items, 0))
        }
        Option::None
    }

    /// Peeks at the back element without removing it.
    fn back(self: Deque<T>) -> Option<T> {
        if len(self.back_items) > 0 {
            return Option::Some(get_unchecked(self.back_items, len(self.back_items) - 1))
        }
        if len(self.front_items) > 0 {
            return Option::Some(get_unchecked(self.front_items, 0))
        }
        Option::None
    }

    /// Returns the number of elements.
    fn len(self: Deque<T>) -> i32 {
        len(self.front_items) + len(self.back_items)
    }

    /// Returns true when the deque has no elements.
    fn is_empty(self: Deque<T>) -> bool {
        len(self.front_items) + len(self.back_items) == 0
    }

    /// Removes all elements while keeping the logical capacity reservation.
    fn clear(mut self: Deque<T>) {
        pop_all(self.front_items)
        pop_all(self.back_items)
    }

    /// Returns the logical capacity reservation.
    fn capacity(self: Deque<T>) -> i32 {
        self.reserved
    }

    /// Ensures room for at least `len + additional` elements.
    ///
    /// `additional <= 0` is a no-op, matching the documented contract.
    fn reserve(mut self: Deque<T>, additional: i32) {
        if additional <= 0 {
            return
        }
        let needed: i32 = len(self.front_items) + len(self.back_items) + additional
        if self.reserved >= needed {
            return
        }
        let front_cap: i32 = len(self.front_items)
        let back_cap: i32 = needed - front_cap
        let mut new_front: Vec<T> = Vec::with_capacity<T>(front_cap)
        while len(self.front_items) > 0 {
            match pop(self.front_items) {
                Option::Some(value) => push(new_front, value),
                Option::None => { break },
            }
        }
        let mut new_back: Vec<T> = Vec::with_capacity<T>(back_cap)
        while len(self.back_items) > 0 {
            match pop(self.back_items) {
                Option::Some(value) => push(new_back, value),
                Option::None => { break },
            }
        }
        self.front_items = new_front
        self.back_items = new_back
        self.reserved = needed
    }

    /// Returns a read-only cursor over the elements, front to back.
    fn iter(self: Deque<T>) -> DequeIter<T> {
        DequeIter { deque: self, index: 0 }
    }

    /// Returns a writable cursor whose `set_current` replaces the last element
    /// returned by `next`.
    fn iter_mut(self: Deque<T>) -> DequeIterMut<T> {
        DequeIterMut { deque: self, index: 0, current: 0 - 1, stopped: false }
    }

    // Capacity is observable state. Pushes only ever raise it, and reserve
    // raises it before rebuilding storage, so capacity() never reports less
    // than len().
    fn note_growth(mut self: Deque<T>) {
        let count: i32 = len(self.front_items) + len(self.back_items)
        if count > self.reserved {
            self.reserved = count
        }
    }
}

fn pop_all<T>(mut values: Vec<T>) {
    while len(values) > 0 {
        match pop(values) {
            Option::Some(_) => {},
            Option::None => { break },
        }
    }
}

/// Read-only cursor over a `Deque<T>`, front to back.
pub struct DequeIter<T> {
    deque: Deque<T>,
    index: i32,
}

impl<T> Iterator for DequeIter<T> {
    type Item = T

    fn next(mut self: DequeIter<T>) -> Option<T> {
        let count: i32 = len(self.deque.front_items) + len(self.deque.back_items)
        if self.index >= count {
            return Option::None
        }
        let value: T = deque_at(self.deque, self.index)
        self.index = self.index + 1
        Option::Some(value)
    }

    fn collect(mut self: DequeIter<T>) -> Vec<T> {
        let mut out: Vec<T> = Vec::new<T>()
        let count: i32 = len(self.deque.front_items) + len(self.deque.back_items)
        while self.index < count {
            push(out, deque_at(self.deque, self.index))
            self.index = self.index + 1
        }
        out
    }

    fn count(mut self: DequeIter<T>) -> i32 {
        let count: i32 = len(self.deque.front_items) + len(self.deque.back_items)
        let remaining: i32 = count - self.index
        self.index = count
        remaining
    }
}

impl<T> IntoIterator for DequeIter<T> {
    type Item = T
    type IntoIter = DequeIter<T>

    fn into_iter(self: DequeIter<T>) -> DequeIter<T> {
        self
    }
}

/// Writable cursor over a `Deque<T>`, front to back.
///
/// `set_current` replaces the element returned by the previous `next` call and
/// returns the old value. Before the first `next`, and after `next` has
/// reported the end, it returns `None` and leaves the deque unchanged.
pub struct DequeIterMut<T> {
    deque: Deque<T>,
    index: i32,
    current: i32,
    stopped: bool,
}

impl<T> Iterator for DequeIterMut<T> {
    type Item = T

    fn next(mut self: DequeIterMut<T>) -> Option<T> {
        let count: i32 = len(self.deque.front_items) + len(self.deque.back_items)
        if self.index >= count {
            self.stopped = true
            return Option::None
        }
        let value: T = deque_at(self.deque, self.index)
        self.current = self.index
        self.index = self.index + 1
        Option::Some(value)
    }

    fn collect(mut self: DequeIterMut<T>) -> Vec<T> {
        let mut out: Vec<T> = Vec::new<T>()
        let count: i32 = len(self.deque.front_items) + len(self.deque.back_items)
        while self.index < count {
            push(out, deque_at(self.deque, self.index))
            self.index = self.index + 1
        }
        out
    }

    fn count(mut self: DequeIterMut<T>) -> i32 {
        let count: i32 = len(self.deque.front_items) + len(self.deque.back_items)
        let remaining: i32 = count - self.index
        self.index = count
        remaining
    }
}

impl<T> DequeIterMut<T> {
    /// Replaces the last element yielded by `next` and returns the old value.
    fn set_current(mut self: DequeIterMut<T>, value: T) -> Option<T> {
        if self.stopped || self.current < 0 {
            return Option::None
        }
        Option::Some(deque_replace_at(self.deque, self.current, value))
    }
}

impl<T> IntoIterator for DequeIterMut<T> {
    type Item = T
    type IntoIter = DequeIterMut<T>

    fn into_iter(self: DequeIterMut<T>) -> DequeIterMut<T> {
        self
    }
}

/// Owning cursor over a `Deque<T>`, front to back.
pub struct DequeIntoIter<T> {
    deque: Deque<T>,
}

impl<T> Iterator for DequeIntoIter<T> {
    type Item = T

    fn next(mut self: DequeIntoIter<T>) -> Option<T> {
        self.deque.pop_front()
    }

    fn collect(mut self: DequeIntoIter<T>) -> Vec<T> {
        let mut out: Vec<T> = Vec::new<T>()
        while true {
            match self.deque.pop_front() {
                Option::Some(value) => push(out, value),
                Option::None => { break },
            }
        }
        out
    }

    fn count(mut self: DequeIntoIter<T>) -> i32 {
        let remaining: i32 = len(self.deque.front_items) + len(self.deque.back_items)
        self.deque.clear()
        remaining
    }
}

impl<T> IntoIterator for DequeIntoIter<T> {
    type Item = T
    type IntoIter = DequeIntoIter<T>

    fn into_iter(self: DequeIntoIter<T>) -> DequeIntoIter<T> {
        self
    }
}

impl<T> IntoIterator for Deque<T> {
    type Item = T
    type IntoIter = DequeIntoIter<T>

    fn into_iter(self: Deque<T>) -> DequeIntoIter<T> {
        DequeIntoIter { deque: self }
    }
}

impl<T: Clone> Clone for Deque<T> {
    fn clone(self: Deque<T>) -> Deque<T> {
        let mut copy: Deque<T> = Deque {
            front_items: Vec::with_capacity<T>(self.reserved),
            back_items: Vec::new<T>(),
            reserved: self.reserved
        }
        let mut i: i32 = 0
        while i < len(self.front_items) + len(self.back_items) {
            copy.push_back((deque_at(self, i)).clone())
            i = i + 1
        }
        copy
    }
}

/// Equality compares length and logical front-to-back order.
///
/// The capacity reservation is storage state, not collection state, so a
/// reserved-but-empty deque equals an unreserved empty deque (ADR-086 §6).
impl<T: Eq> Eq for Deque<T> {
    fn eq(self: Deque<T>, other: Deque<T>) -> bool {
        deque_items_eq(self, other)
    }
}

impl<T: Debug> Debug for Deque<T> {
    fn fmt_debug(self: Deque<T>) -> String {
        String_from("Deque ").concat(deque_debug_items(self))
    }
}

// ADR-078 §3 permits at most one parametric impl per (trait, self
// constructor), so `Deque<T>` cannot also implement the other ADR-086 §6
// sources (`DequeIter<T>` / `DequeIntoIter<T>`): they would overlap on the
// same constructor head. `Vec` is the one producer that feeds every
// collection kind, so the shared `VecIter<T>` source is the implemented one.
impl<T> FromIterator<VecIter<T>> for Deque<T> {
    fn from_iter(mut it: VecIter<T>) -> Deque<T> {
        let items: Vec<T> = it.collect()
        let count: i32 = len(items)
        Deque {
            front_items: Vec::new<T>(),
            back_items: items,
            reserved: count
        }
    }
}

fn deque_debug_items<T: Debug>(deque: Deque<T>) -> String {
    let mut out: String = String_from("[")
    let mut index: i32 = 0
    let count: i32 = len(deque.front_items) + len(deque.back_items)
    while index < count {
        if index > 0 {
            out = out.concat(String_from(", "))
        }
        out = out.concat((deque_at(deque, index)).fmt_debug())
        index = index + 1
    }
    out.concat(String_from("]"))
}

/// First-in first-out queue backed by `Deque<T>`.
///
/// `push` appends at the back and `pop` removes from the front. `front` and
/// `back` observe both ends without removing elements. Empty pops and peeks
/// return `Option::None`. `iter` walks front to back, the same order as `pop`.
pub struct Queue<T> {
    deque: Deque<T>,
}

impl<T> Queue<T> {
    /// Creates an empty queue.
    fn new() -> Queue<T> {
        // Calling Deque::new<T>() from generic wrapper code emits the
        // unmonomorphized constructor on wasm32-gc; the nested literal lets the
        // field-type instantiation select the concrete Deque layout.
        Queue {
            deque: Deque {
                front_items: Vec::new<T>(),
                back_items: Vec::new<T>(),
                reserved: 0
            }
        }
    }

    /// Creates an empty queue with a logical capacity reservation.
    ///
    /// A negative `capacity` is treated as `0`; this never panics.
    fn with_capacity(capacity: i32) -> Queue<T> {
        let cap: i32 = normalized_capacity(capacity)
        Queue {
            deque: Deque {
                front_items: Vec::with_capacity<T>(cap),
                back_items: Vec::new<T>(),
                reserved: cap
            }
        }
    }

    /// Appends `value` at the back of the queue.
    fn push(mut self: Queue<T>, value: T) {
        self.deque.push_back(value)
    }

    /// Removes and returns the front element, or `None` when empty.
    fn pop(mut self: Queue<T>) -> Option<T> {
        self.deque.pop_front()
    }

    /// Peeks at the front element without removing it.
    fn front(self: Queue<T>) -> Option<T> {
        self.deque.front()
    }

    /// Peeks at the back element without removing it.
    fn back(self: Queue<T>) -> Option<T> {
        self.deque.back()
    }

    /// Returns the number of elements.
    fn len(self: Queue<T>) -> i32 {
        self.deque.len()
    }

    /// Returns true when the queue has no elements.
    fn is_empty(self: Queue<T>) -> bool {
        self.deque.is_empty()
    }

    /// Removes all elements while keeping the logical capacity reservation.
    fn clear(mut self: Queue<T>) {
        self.deque.clear()
    }

    /// Returns the logical capacity reservation.
    fn capacity(self: Queue<T>) -> i32 {
        self.deque.capacity()
    }

    /// Ensures room for at least `len + additional` elements.
    fn reserve(mut self: Queue<T>, additional: i32) {
        self.deque.reserve(additional)
    }

    /// Returns a read-only cursor over the elements, front to back.
    fn iter(self: Queue<T>) -> DequeIter<T> {
        DequeIter { deque: self.deque, index: 0 }
    }
}

impl<T> IntoIterator for Queue<T> {
    type Item = T
    type IntoIter = DequeIntoIter<T>

    fn into_iter(self: Queue<T>) -> DequeIntoIter<T> {
        DequeIntoIter { deque: self.deque }
    }
}

impl<T: Clone> Clone for Queue<T> {
    fn clone(self: Queue<T>) -> Queue<T> {
        Queue { deque: self.deque.clone() }
    }
}

impl<T: Debug> Debug for Queue<T> {
    fn fmt_debug(self: Queue<T>) -> String {
        // Format through the wrapped deque and replace its prefix. Passing the
        // nested generic struct field through the shared free function does not
        // lower on wasm32-gc, but the field method call does.
        let rendered: String = self.deque.fmt_debug()
        String_from("Queue ").concat(slice(rendered, 6, len(rendered)))
    }
}

impl<T: Eq> Eq for Queue<T> {
    fn eq(self: Queue<T>, other: Queue<T>) -> bool {
        deque_items_eq(self.deque, other.deque)
    }
}

impl<T> FromIterator<VecIter<T>> for Queue<T> {
    fn from_iter(mut it: VecIter<T>) -> Queue<T> {
        let items: Vec<T> = it.collect()
        let count: i32 = len(items)
        Queue {
            deque: Deque {
                front_items: Vec::new<T>(),
                back_items: items,
                reserved: count
            }
        }
    }
}

/// Last-in first-out stack backed by `Deque<T>`.
///
/// `push` appends at the back, and `pop` / `peek` address the back. `iter`
/// walks bottom to top (push order), which is the reverse of `pop` order, so a
/// stack traversal is not silently LIFO. Empty pops and peeks return
/// `Option::None`.
pub struct Stack<T> {
    deque: Deque<T>,
}

impl<T> Stack<T> {
    /// Creates an empty stack.
    fn new() -> Stack<T> {
        // Same nested-literal requirement as Queue::new.
        Stack {
            deque: Deque {
                front_items: Vec::new<T>(),
                back_items: Vec::new<T>(),
                reserved: 0
            }
        }
    }

    /// Creates an empty stack with a logical capacity reservation.
    ///
    /// A negative `capacity` is treated as `0`; this never panics.
    fn with_capacity(capacity: i32) -> Stack<T> {
        let cap: i32 = normalized_capacity(capacity)
        Stack {
            deque: Deque {
                front_items: Vec::with_capacity<T>(cap),
                back_items: Vec::new<T>(),
                reserved: cap
            }
        }
    }

    /// Pushes `value` on top of the stack.
    fn push(mut self: Stack<T>, value: T) {
        self.deque.push_back(value)
    }

    /// Removes and returns the top element, or `None` when empty.
    fn pop(mut self: Stack<T>) -> Option<T> {
        self.deque.pop_back()
    }

    /// Peeks at the top element without removing it.
    fn peek(self: Stack<T>) -> Option<T> {
        self.deque.back()
    }

    /// Returns the number of elements.
    fn len(self: Stack<T>) -> i32 {
        self.deque.len()
    }

    /// Returns true when the stack has no elements.
    fn is_empty(self: Stack<T>) -> bool {
        self.deque.is_empty()
    }

    /// Removes all elements while keeping the logical capacity reservation.
    fn clear(mut self: Stack<T>) {
        self.deque.clear()
    }

    /// Returns the logical capacity reservation.
    fn capacity(self: Stack<T>) -> i32 {
        self.deque.capacity()
    }

    /// Ensures room for at least `len + additional` elements.
    fn reserve(mut self: Stack<T>, additional: i32) {
        self.deque.reserve(additional)
    }

    /// Returns a read-only cursor over the elements, bottom to top.
    fn iter(self: Stack<T>) -> DequeIter<T> {
        DequeIter { deque: self.deque, index: 0 }
    }
}

impl<T> IntoIterator for Stack<T> {
    type Item = T
    type IntoIter = DequeIntoIter<T>

    fn into_iter(self: Stack<T>) -> DequeIntoIter<T> {
        DequeIntoIter { deque: self.deque }
    }
}

impl<T: Clone> Clone for Stack<T> {
    fn clone(self: Stack<T>) -> Stack<T> {
        Stack { deque: self.deque.clone() }
    }
}

impl<T: Debug> Debug for Stack<T> {
    fn fmt_debug(self: Stack<T>) -> String {
        let rendered: String = self.deque.fmt_debug()
        String_from("Stack ").concat(slice(rendered, 6, len(rendered)))
    }
}

impl<T: Eq> Eq for Stack<T> {
    fn eq(self: Stack<T>, other: Stack<T>) -> bool {
        deque_items_eq(self.deque, other.deque)
    }
}

impl<T> FromIterator<VecIter<T>> for Stack<T> {
    fn from_iter(mut it: VecIter<T>) -> Stack<T> {
        let items: Vec<T> = it.collect()
        let count: i32 = len(items)
        Stack {
            deque: Deque {
                front_items: Vec::new<T>(),
                back_items: items,
                reserved: count
            }
        }
    }
}
