//! Experimental compiler-oriented collections.
//!
//! Provides Arena (bump allocator), SlotMap (deletion-safe handle map), and
//! Interner (value-to-symbol bidirectional map) suitable for compiler/IDE
//! toolchain use.
//!
//! **Stability:** All APIs in this module are **experimental** and may change
//! in v4+.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.
// --- Arena (bump allocator) ---
//
// Layout of backing Vec<i32>: [count, value_0, value_1, ...]
// ArenaId = i32 index (monotonically increasing).
use std::prelude::{eq}
pub fn arena_new() -> Vec<i32> {
    let a: Vec<i32> = Vec::new<i32>()
    push(a, 0)
    a
}

pub fn arena_alloc(a: Vec<i32>, val: i32) -> i32 {
    let idx: i32 = get_unchecked(a, 0)
    push(a, val)
    set(a, 0, idx + 1)
    idx
}

pub fn arena_get(a: Vec<i32>, idx: i32) -> i32 {
    get_unchecked(a, 1 + idx)
}

pub fn arena_len(a: Vec<i32>) -> i32 {
    get_unchecked(a, 0)
}

// --- SlotMap (deletion-safe handle map, monomorphic i32 values) ---
//
// Layout of backing Vec<i32>:
//   [count, max_key, value_0, alive_0, value_1, alive_1, ...]
// SlotKey = i32 (the slot index, stable across removes).
// alive_N = 1 if slot N is active, 0 if removed.
pub fn slotmap_new() -> Vec<i32> {
    let m: Vec<i32> = Vec::new<i32>()
    push(m, 0)
    push(m, 0)
    m
}

pub fn slotmap_insert(m: Vec<i32>, value: i32) -> i32 {
    let key: i32 = get_unchecked(m, 1)
    push(m, value)
    push(m, 1)
    set(m, 1, key + 1)
    let count: i32 = get_unchecked(m, 0)
    set(m, 0, count + 1)
    key
}

pub fn slotmap_get(m: Vec<i32>, key: i32) -> Option<i32> {
    let max_key: i32 = get_unchecked(m, 1)
    if key < 0 || key >= max_key {
        return None
    }
    let is_alive: i32 = get_unchecked(m, 2 + key * 2 + 1)
    if is_alive == 0 {
        return None
    }
    Some(get_unchecked(m, 2 + key * 2))
}

pub fn slotmap_remove(m: Vec<i32>, key: i32) -> Option<i32> {
    let max_key: i32 = get_unchecked(m, 1)
    if key < 0 || key >= max_key {
        return None
    }
    let slot_alive: i32 = get_unchecked(m, 2 + key * 2 + 1)
    if slot_alive == 0 {
        return None
    }
    let val: i32 = get_unchecked(m, 2 + key * 2)
    set(m, 2 + key * 2 + 1, 0)
    let count: i32 = get_unchecked(m, 0)
    set(m, 0, count - 1)
    Some(val)
}

pub fn slotmap_contains(m: Vec<i32>, key: i32) -> bool {
    let max_key: i32 = get_unchecked(m, 1)
    if key < 0 || key >= max_key {
        return false
    }
    get_unchecked(m, 2 + key * 2 + 1) == 1
}

pub fn slotmap_len(m: Vec<i32>) -> i32 {
    get_unchecked(m, 0)
}

// --- Interner (value <-> Symbol bidirectional map, String values) ---
//
// Backed by Vec<String>: index = Symbol (i32).
// intern returns the existing Symbol if value was already interned.
// lookup returns Option<String> for the given Symbol.
pub fn interner_new() -> Vec<String> {
    Vec::new<String>()
}

pub fn interner_intern(i: Vec<String>, value: String) -> i32 {
    let n: i32 = len(i)
    let mut idx: i32 = 0
    while idx < n {
        if eq(get_unchecked(i, idx), value) {
            return idx
        }
        idx = idx + 1
    }
    push(i, value)
    n
}

pub fn interner_lookup(i: Vec<String>, sym: i32) -> Option<String> {
    let n: i32 = len(i)
    if sym < 0 || sym >= n {
        return None
    }
    Some(get_unchecked(i, sym))
}

pub fn interner_len(i: Vec<String>) -> i32 {
    len(i)
}

test mod "arena" {
    test "alloc_returns_sequential_ids" {
        let a = arena_new()
        assert(arena_alloc(a, 100) == 0)
        assert(arena_alloc(a, 200) == 1)
        assert(arena_alloc(a, 300) == 2)
    }
    test "get_reads_stored_value" {
        let a = arena_new()
        let idx = arena_alloc(a, 77)
        assert(arena_get(a, idx) == 77)
    }
    test "len_tracks_allocs" {
        let a = arena_new()
        arena_alloc(a, 1)
        arena_alloc(a, 2)
        assert(arena_len(a) == 2)
    }
}

test mod "slotmap" {
    test "insert_returns_key" {
        let m = slotmap_new()
        let k = slotmap_insert(m, 42)
        let r = match slotmap_get(m, k) {
            Option::Some(v) => v,
            Option::None => 0 - 1,
        }
        assert(r == 42)
    }
    test "get_missing_key_is_none" {
        let m = slotmap_new()
        let r = match slotmap_get(m, 0) {
            Option::Some(v) => 1,
            Option::None => 2,
        }
        assert(r == 2)
    }
    test "remove_drops_entry" {
        let m = slotmap_new()
        let k = slotmap_insert(m, 5)
        let removed = match slotmap_remove(m, k) {
            Option::Some(v) => v,
            Option::None => 0 - 1,
        }
        assert(removed == 5)
        assert(slotmap_contains(m, k) == false)
    }
    test "contains_and_len" {
        let m = slotmap_new()
        let k1 = slotmap_insert(m, 1)
        slotmap_insert(m, 2)
        assert(slotmap_contains(m, k1))
        assert(slotmap_len(m) == 2)
    }
    test "keys_stable_across_remove" {
        let m = slotmap_new()
        let k1 = slotmap_insert(m, 10)
        let k2 = slotmap_insert(m, 20)
        slotmap_remove(m, k1)
        let r = match slotmap_get(m, k2) {
            Option::Some(v) => v,
            Option::None => 0 - 1,
        }
        assert(r == 20)
    }
}

test mod "interner" {
    test "intern_dedup_same_string" {
        let i = interner_new()
        let a = interner_intern(i, "sym")
        let b = interner_intern(i, "sym")
        assert(a == b)
        assert(interner_len(i) == 1)
    }
    test "intern_distinct_strings" {
        let i = interner_new()
        let a = interner_intern(i, "x")
        let b = interner_intern(i, "y")
        assert(a != b)
        assert(interner_len(i) == 2)
    }
    test "lookup_roundtrip" {
        let i = interner_new()
        let sym = interner_intern(i, "name")
        let r = match interner_lookup(i, sym) {
            Option::Some(s) => s,
            Option::None => "missing",
        }
        assert(r == "name")
    }
    test "lookup_out_of_range_is_none" {
        let i = interner_new()
        interner_intern(i, "a")
        let r = match interner_lookup(i, 99) {
            Option::Some(s) => 1,
            Option::None => 2,
        }
        assert(r == 2)
    }
}
