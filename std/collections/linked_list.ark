//! `LinkedList<T>` and legacy free-function helpers for a doubly-linked list.
//!
//! `LinkedList<T>` is a `Vec`-backed node pool with a free list. Node metadata
//! (`prev` / `next` indices and a value index) lives in parallel `Vec<i32>`
//! vectors, and element values live in an append-only `Vec<T>` log. Both-end
//! push / pop and peek are O(1); front-to-back traversal is O(n). `clear` drops
//! the value log and keeps the node-pool capacity.
//!
//! The older `linked_list_*` free functions below operate on a monomorphic
//! `Vec<i32>` layout and remain only for the ADR-086 migration window. New code
//! should use `LinkedList<T>`.
//!
//! Cursors hold the list handle rather than a borrowed reference, so the type
//! checker does not yet reject a push / pop / clear while an iterator is alive.
//! Do not structurally modify a list during iteration; the borrow / lifetime
//! design will enforce this later (ADR-086 §5).
//!
//! `FromIterator<VecIter<T>>` appends the cursor values front to back, and `Eq`
//! compares length plus iteration order while ignoring node-pool state.
//! ADR-078 §3 allows one parametric impl per (trait, self constructor), so the
//! list cursors cannot be added as further `FromIterator` sources.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.
//!
//! ## Legacy layout
//!
//! The backing `Vec<i32>` stores:
//! ```text
//! [head, tail, free_head, count, capacity,
//!  node_0_prev, node_0_next, node_0_value,
//!  node_1_prev, node_1_next, node_1_value, ...]
//! ```
//! where `head`, `tail`, `free_head` are node indices or `-1` (nil).

// Do not import `std::collections::vec` here. Loading that module's own
// `impl Vec<T>` shadows the prelude Vec constructor inside this module's
// generic code; `LinkedList::new<String>()` then emits the unmonomorphized
// `Vec::new<T>` and fails wasm32-gc validation (#710).

use std::core::clone
use std::core::cmp
use std::core::convert
use std::core::iter
use std::text

// ── internal layout constants ───────────────────────────────────────────────

const HEADER_LEN: i32 = 5
const NODE_FIELDS: i32 = 3   // prev, next, value
const PREV_OFFSET: i32 = 0
const NEXT_OFFSET: i32 = 1
const VALUE_OFFSET: i32 = 2

const NIL: i32 = 0 - 1

fn slot_prev(buf: Vec<i32>, node: i32) -> i32 {
    get_unchecked(buf, HEADER_LEN + node * NODE_FIELDS + PREV_OFFSET)
}

fn slot_next(buf: Vec<i32>, node: i32) -> i32 {
    get_unchecked(buf, HEADER_LEN + node * NODE_FIELDS + NEXT_OFFSET)
}

fn slot_value(buf: Vec<i32>, node: i32) -> i32 {
    get_unchecked(buf, HEADER_LEN + node * NODE_FIELDS + VALUE_OFFSET)
}

fn set_slot_prev(buf: Vec<i32>, node: i32, val: i32) {
    set(buf, HEADER_LEN + node * NODE_FIELDS + PREV_OFFSET, val)
}

fn set_slot_next(buf: Vec<i32>, node: i32, val: i32) {
    set(buf, HEADER_LEN + node * NODE_FIELDS + NEXT_OFFSET, val)
}

fn set_slot_value(buf: Vec<i32>, node: i32, val: i32) {
    set(buf, HEADER_LEN + node * NODE_FIELDS + VALUE_OFFSET, val)
}

fn header_head(buf: Vec<i32>) -> i32 {
    get_unchecked(buf, 0)
}

fn header_tail(buf: Vec<i32>) -> i32 {
    get_unchecked(buf, 1)
}

fn header_free(buf: Vec<i32>) -> i32 {
    get_unchecked(buf, 2)
}

fn header_count(buf: Vec<i32>) -> i32 {
    get_unchecked(buf, 3)
}

fn header_capacity(buf: Vec<i32>) -> i32 {
    get_unchecked(buf, 4)
}

fn set_header(buf: Vec<i32>, slot: i32, val: i32) {
    set(buf, slot, val)
}

fn set_header_head(buf: Vec<i32>, val: i32) {
    set(buf, 0, val)
}

fn set_header_tail(buf: Vec<i32>, val: i32) {
    set(buf, 1, val)
}

fn set_header_free(buf: Vec<i32>, val: i32) {
    set(buf, 2, val)
}

fn set_header_count(buf: Vec<i32>, val: i32) {
    set(buf, 3, val)
}

fn set_header_capacity(buf: Vec<i32>, val: i32) {
    set(buf, 4, val)
}

// ── node allocation ─────────────────────────────────────────────────────────

fn alloc_node(buf: Vec<i32>) -> i32 {
    let free_head = header_free(buf)
    if free_head != NIL {
        let next_free = slot_next(buf, free_head)
        set_header_free(buf, next_free)
        set_slot_prev(buf, free_head, NIL)
        set_slot_next(buf, free_head, NIL)
        return free_head
    }
    // Grow: append a new node slot
    let cap = header_capacity(buf)
    push(buf, NIL)  // prev
    push(buf, NIL)  // next
    push(buf, 0)    // value
    set_header_capacity(buf, cap + 1)
    return cap
}

fn free_node(buf: Vec<i32>, node: i32) {
    set_slot_prev(buf, node, NIL)
    set_slot_next(buf, node, header_free(buf))
    set_header_free(buf, node)
}

// ── public API ──────────────────────────────────────────────────────────────

/// Create a new empty legacy i32 list over a `Vec<i32>` node pool.
pub fn linked_list_new() -> Vec<i32> {
    let buf = Vec::new<i32>()
    push(buf, NIL)  // head
    push(buf, NIL)  // tail
    push(buf, NIL)  // free_head
    push(buf, 0)    // count
    push(buf, 0)    // capacity
    buf
}

/// Push a value to the front of the legacy i32 list. O(1).
pub fn linked_list_push_front(buf: Vec<i32>, value: i32) {
    let node = alloc_node(buf)
    set_slot_value(buf, node, value)
    let old_head = header_head(buf)
    set_slot_next(buf, node, old_head)
    if old_head != NIL {
        set_slot_prev(buf, old_head, node)
    } else {
        set_header_tail(buf, node)
    }
    set_header_head(buf, node)
    set_header_count(buf, header_count(buf) + 1)
}

/// Push a value to the back of the legacy i32 list. O(1).
pub fn linked_list_push_back(buf: Vec<i32>, value: i32) {
    let node = alloc_node(buf)
    set_slot_value(buf, node, value)
    let old_tail = header_tail(buf)
    set_slot_prev(buf, node, old_tail)
    if old_tail != NIL {
        set_slot_next(buf, old_tail, node)
    } else {
        set_header_head(buf, node)
    }
    set_header_tail(buf, node)
    set_header_count(buf, header_count(buf) + 1)
}

/// Pop and return the front value of the legacy i32 list, or `fallback` if empty. O(1).
pub fn linked_list_pop_front(buf: Vec<i32>, fallback: i32) -> i32 {
    let head = header_head(buf)
    if head == NIL {
        return fallback
    }
    let value = slot_value(buf, head)
    let next = slot_next(buf, head)
    set_header_head(buf, next)
    if next != NIL {
        set_slot_prev(buf, next, NIL)
    } else {
        set_header_tail(buf, NIL)
    }
    free_node(buf, head)
    set_header_count(buf, header_count(buf) - 1)
    value
}

/// Pop and return the back value of the legacy i32 list, or `fallback` if empty. O(1).
pub fn linked_list_pop_back(buf: Vec<i32>, fallback: i32) -> i32 {
    let tail = header_tail(buf)
    if tail == NIL {
        return fallback
    }
    let value = slot_value(buf, tail)
    let prev = slot_prev(buf, tail)
    set_header_tail(buf, prev)
    if prev != NIL {
        set_slot_next(buf, prev, NIL)
    } else {
        set_header_head(buf, NIL)
    }
    free_node(buf, tail)
    set_header_count(buf, header_count(buf) - 1)
    value
}

/// Peek the front value of the legacy i32 list, or `fallback` if empty. O(1).
pub fn linked_list_front(buf: Vec<i32>, fallback: i32) -> i32 {
    let head = header_head(buf)
    if head == NIL {
        return fallback
    }
    slot_value(buf, head)
}

/// Peek the back value of the legacy i32 list, or `fallback` if empty. O(1).
pub fn linked_list_back(buf: Vec<i32>, fallback: i32) -> i32 {
    let tail = header_tail(buf)
    if tail == NIL {
        return fallback
    }
    slot_value(buf, tail)
}

/// Return the number of elements in the legacy i32 list. O(1).
pub fn linked_list_len(buf: Vec<i32>) -> i32 {
    header_count(buf)
}

/// Return true if the legacy i32 list is empty. O(1).
pub fn linked_list_is_empty(buf: Vec<i32>) -> bool {
    header_count(buf) == 0
}

/// Remove all elements from the legacy i32 list. O(1) (resets headers).
pub fn linked_list_clear(buf: Vec<i32>) {
    set_header_head(buf, NIL)
    set_header_tail(buf, NIL)
    set_header_free(buf, NIL)
    set_header_count(buf, 0)
    // Note: capacity stays; node slots are reused on next push.
}

/// Copy the legacy i32 list into a `Vec<i32>` in front-to-back order. O(n).
pub fn linked_list_to_vec(buf: Vec<i32>) -> Vec<i32> {
    let result = Vec::new<i32>()
    let mut node = header_head(buf)
    while node != NIL {
        push(result, slot_value(buf, node))
        node = slot_next(buf, node)
    }
    result
}

// ── LinkedList<T> (ADR-086 Phase 3) ─────────────────────────────────────────

/// Doubly-linked list with O(1) push / pop at both ends.
///
/// Fields are private; construct with `LinkedList::new<T>()`. Empty pops and
/// peeks return `Option::None`. Removed node slots are recycled through a free
/// list, while element values are appended to a log that `clear` drops. The
/// log grows with the number of pushes since the last `clear`, not with the
/// live list length.
pub struct LinkedList<T> {
    values: Vec<T>,
    node_values: Vec<i32>,
    prev_links: Vec<i32>,
    next_links: Vec<i32>,
    head: i32,
    tail: i32,
    free_head: i32,
    length: i32,
}

impl<T> LinkedList<T> {
    /// Creates an empty list.
    fn new() -> LinkedList<T> {
        LinkedList {
            values: Vec::new<T>(),
            node_values: Vec::new<i32>(),
            prev_links: Vec::new<i32>(),
            next_links: Vec::new<i32>(),
            head: NIL,
            tail: NIL,
            free_head: NIL,
            length: 0
        }
    }

    /// Inserts `value` at the front. O(1).
    fn push_front(self: LinkedList<T>, value: T) {
        let node: i32 = self.allocate_node(value)
        let old_head: i32 = self.head
        set(self.next_links, node, old_head)
        if old_head != NIL {
            set(self.prev_links, old_head, node)
        } else {
            self.tail = node
        }
        self.head = node
        self.length = self.length + 1
    }

    /// Inserts `value` at the back. O(1).
    fn push_back(self: LinkedList<T>, value: T) {
        let node: i32 = self.allocate_node(value)
        let old_tail: i32 = self.tail
        set(self.prev_links, node, old_tail)
        if old_tail != NIL {
            set(self.next_links, old_tail, node)
        } else {
            self.head = node
        }
        self.tail = node
        self.length = self.length + 1
    }

    /// Removes and returns the front element, or `None` when empty.
    fn pop_front(self: LinkedList<T>) -> Option<T> {
        if self.head == NIL {
            return Option::None
        }
        let node: i32 = self.head
        let value: T = linked_list_value_at(self, node)
        let next: i32 = get_unchecked(self.next_links, node)
        self.head = next
        if next != NIL {
            set(self.prev_links, next, NIL)
        } else {
            self.tail = NIL
        }
        self.recycle_node(node)
        self.length = self.length - 1
        Option::Some(value)
    }

    /// Removes and returns the back element, or `None` when empty.
    fn pop_back(self: LinkedList<T>) -> Option<T> {
        if self.tail == NIL {
            return Option::None
        }
        let node: i32 = self.tail
        let value: T = linked_list_value_at(self, node)
        let prev: i32 = get_unchecked(self.prev_links, node)
        self.tail = prev
        if prev != NIL {
            set(self.next_links, prev, NIL)
        } else {
            self.head = NIL
        }
        self.recycle_node(node)
        self.length = self.length - 1
        Option::Some(value)
    }

    /// Peeks at the front element without removing it.
    fn front(self: LinkedList<T>) -> Option<T> {
        if self.head == NIL {
            return Option::None
        }
        Option::Some(linked_list_value_at(self, self.head))
    }

    /// Peeks at the back element without removing it.
    fn back(self: LinkedList<T>) -> Option<T> {
        if self.tail == NIL {
            return Option::None
        }
        Option::Some(linked_list_value_at(self, self.tail))
    }

    /// Returns the number of elements.
    fn len(self: LinkedList<T>) -> i32 {
        self.length
    }

    /// Returns true when the list has no elements.
    fn is_empty(self: LinkedList<T>) -> bool {
        self.length == 0
    }

    /// Removes all elements and drops every retained node value.
    ///
    /// The node pool capacity is kept for reuse.
    fn clear(self: LinkedList<T>) {
        self.head = NIL
        self.tail = NIL
        self.free_head = NIL
        self.length = 0
        drop_values(self.values)
        drop_values(self.node_values)
        drop_values(self.prev_links)
        drop_values(self.next_links)
    }

    /// Returns a read-only cursor over the elements, front to back.
    fn iter(self: LinkedList<T>) -> LinkedListIter<T> {
        let first: i32 = self.head
        let count: i32 = self.length
        LinkedListIter { list: self, node: first, remaining: count }
    }

    /// Returns a writable cursor whose `set_current` replaces the last element
    /// returned by `next`.
    fn iter_mut(self: LinkedList<T>) -> LinkedListIterMut<T> {
        let first: i32 = self.head
        let count: i32 = self.length
        LinkedListIterMut {
            list: self,
            node: first,
            current: NIL,
            remaining: count,
            stopped: false
        }
    }

    // Node slots are recycled through the free list, but values are appended
    // to a log and indexed through `node_values`: a new value is never written
    // into an old `Vec<T>` slot. Generic `set` / raw array writes on `Vec<T>`
    // do not lower when T is a reference type on wasm32-gc, and the i32-index
    // write below is safe for every T.
    fn allocate_node(self: LinkedList<T>, value: T) -> i32 {
        let value_index: i32 = len(self.values)
        push(self.values, value)
        if self.free_head != NIL {
            let node: i32 = self.free_head
            self.free_head = get_unchecked(self.next_links, node)
            set(self.prev_links, node, NIL)
            set(self.next_links, node, NIL)
            set(self.node_values, node, value_index)
            return node
        }
        let node: i32 = len(self.node_values)
        push(self.node_values, value_index)
        push(self.prev_links, NIL)
        push(self.next_links, NIL)
        node
    }

    fn recycle_node(self: LinkedList<T>, node: i32) {
        set(self.prev_links, node, NIL)
        set(self.next_links, node, self.free_head)
        self.free_head = node
    }
}

fn linked_list_value_at<T>(list: LinkedList<T>, node: i32) -> T {
    get_unchecked(list.values, get_unchecked(list.node_values, node))
}

fn drop_values<T>(values: Vec<T>) {
    while len(values) > 0 {
        match pop(values) {
            Option::Some(_) => {},
            Option::None => { break },
        }
    }
}

/// Read-only cursor over a `LinkedList<T>`, front to back.
pub struct LinkedListIter<T> {
    list: LinkedList<T>,
    node: i32,
    remaining: i32,
}

impl Iterator for LinkedListIter<T> {
    type Item = T

    fn next(self: LinkedListIter<T>) -> Option<T> {
        if self.remaining <= 0 {
            return Option::None
        }
        let value: T = linked_list_value_at(self.list, self.node)
        self.node = get_unchecked(self.list.next_links, self.node)
        self.remaining = self.remaining - 1
        Option::Some(value)
    }

    fn collect(self: LinkedListIter<T>) -> Vec<T> {
        let out: Vec<T> = Vec::new<T>()
        while self.remaining > 0 {
            push(out, linked_list_value_at(self.list, self.node))
            self.node = get_unchecked(self.list.next_links, self.node)
            self.remaining = self.remaining - 1
        }
        out
    }

    fn count(self: LinkedListIter<T>) -> i32 {
        let remaining: i32 = self.remaining
        self.remaining = 0
        self.node = NIL
        remaining
    }
}

impl IntoIterator for LinkedListIter<T> {
    type Item = T
    type IntoIter = LinkedListIter<T>

    fn into_iter(self: LinkedListIter<T>) -> LinkedListIter<T> {
        self
    }
}

/// Writable cursor over a `LinkedList<T>`, front to back.
///
/// `set_current` replaces the element returned by the previous `next` call and
/// returns the old value. Before the first `next`, and after `next` has
/// reported the end, it returns `None` and leaves the list unchanged.
pub struct LinkedListIterMut<T> {
    list: LinkedList<T>,
    node: i32,
    current: i32,
    remaining: i32,
    stopped: bool,
}

impl Iterator for LinkedListIterMut<T> {
    type Item = T

    fn next(self: LinkedListIterMut<T>) -> Option<T> {
        if self.remaining <= 0 {
            self.stopped = true
            return Option::None
        }
        let value: T = linked_list_value_at(self.list, self.node)
        self.current = self.node
        self.node = get_unchecked(self.list.next_links, self.node)
        self.remaining = self.remaining - 1
        Option::Some(value)
    }

    fn collect(self: LinkedListIterMut<T>) -> Vec<T> {
        let out: Vec<T> = Vec::new<T>()
        while self.remaining > 0 {
            push(out, linked_list_value_at(self.list, self.node))
            self.node = get_unchecked(self.list.next_links, self.node)
            self.remaining = self.remaining - 1
        }
        out
    }

    fn count(self: LinkedListIterMut<T>) -> i32 {
        let remaining: i32 = self.remaining
        self.remaining = 0
        self.node = NIL
        remaining
    }
}

impl<T> LinkedListIterMut<T> {
    /// Replaces the last element yielded by `next` and returns the old value.
    fn set_current(self: LinkedListIterMut<T>, value: T) -> Option<T> {
        if self.stopped || self.current < 0 {
            return Option::None
        }
        if self.current >= len(self.list.values) {
            return Option::None
        }
        let old: T = linked_list_value_at(self.list, self.current)
        set(self.list.values, self.current, value)
        Option::Some(old)
    }
}

impl IntoIterator for LinkedListIterMut<T> {
    type Item = T
    type IntoIter = LinkedListIterMut<T>

    fn into_iter(self: LinkedListIterMut<T>) -> LinkedListIterMut<T> {
        self
    }
}

/// Owning cursor over a `LinkedList<T>`, front to back.
pub struct LinkedListIntoIter<T> {
    list: LinkedList<T>,
}

impl Iterator for LinkedListIntoIter<T> {
    type Item = T

    fn next(self: LinkedListIntoIter<T>) -> Option<T> {
        self.list.pop_front()
    }

    fn collect(self: LinkedListIntoIter<T>) -> Vec<T> {
        let out: Vec<T> = Vec::new<T>()
        while self.list.length > 0 {
            match self.list.pop_front() {
                Option::Some(value) => push(out, value),
                Option::None => { break },
            }
        }
        out
    }

    fn count(self: LinkedListIntoIter<T>) -> i32 {
        let remaining: i32 = self.list.length
        self.list.clear()
        remaining
    }
}

impl IntoIterator for LinkedListIntoIter<T> {
    type Item = T
    type IntoIter = LinkedListIntoIter<T>

    fn into_iter(self: LinkedListIntoIter<T>) -> LinkedListIntoIter<T> {
        self
    }
}

impl IntoIterator for LinkedList<T> {
    type Item = T
    type IntoIter = LinkedListIntoIter<T>

    fn into_iter(self: LinkedList<T>) -> LinkedListIntoIter<T> {
        LinkedListIntoIter { list: self }
    }
}

impl<T: Clone> Clone for LinkedList<T> {
    fn clone(self: LinkedList<T>) -> LinkedList<T> {
        // `LinkedList::new<T>()` from generic impl code emits the
        // unmonomorphized constructor, so build the empty pool directly.
        let copy: LinkedList<T> = LinkedList {
            values: Vec::new<T>(),
            node_values: Vec::new<i32>(),
            prev_links: Vec::new<i32>(),
            next_links: Vec::new<i32>(),
            head: NIL,
            tail: NIL,
            free_head: NIL,
            length: 0
        }
        let mut node: i32 = self.head
        while node != NIL {
            copy.push_back((linked_list_value_at(self, node)).clone())
            node = get_unchecked(self.next_links, node)
        }
        copy
    }
}

/// Equality compares length and logical front-to-back order.
///
/// The node-pool capacity and recycled slots are storage state, not list
/// state, so the same logical list compares equal (ADR-086 §6).
impl<T: Eq> Eq for LinkedList<T> {
    fn eq(self: LinkedList<T>, other: LinkedList<T>) -> bool {
        if self.length != other.length {
            return false
        }
        let mut left: i32 = self.head
        let mut right: i32 = other.head
        while left != NIL {
            // Read the value log inline rather than through
            // `linked_list_value_at`: the helper return loses the concrete
            // element type in the monomorphised impl, and the `eq` call then
            // validates with a boxed ABI on wasm32-gc.
            let left_value: T = get_unchecked(self.values, get_unchecked(self.node_values, left))
            let right_value: T = get_unchecked(other.values, get_unchecked(other.node_values, right))
            if !left_value.eq(right_value) {
                return false
            }
            left = get_unchecked(self.next_links, left)
            right = get_unchecked(other.next_links, right)
        }
        true
    }
}

impl<T: Debug> Debug for LinkedList<T> {
    fn fmt_debug(self: LinkedList<T>) -> String {
        String_from("LinkedList ").concat(linked_list_debug_items(self))
    }
}

// ADR-078 §3 permits at most one parametric impl per (trait, self
// constructor), so `LinkedList<T>` cannot also implement the other ADR-086 §6
// sources (`LinkedListIter<T>` / `LinkedListIntoIter<T>`). `VecIter<T>` is the
// uniform cross-collection source, so it is the implemented one.
impl<T> FromIterator<VecIter<T>> for LinkedList<T> {
    fn from_iter(it: VecIter<T>) -> LinkedList<T> {
        let values: Vec<T> = it.collect()
        let count: i32 = len(values)
        let node_values: Vec<i32> = Vec::new<i32>()
        let prev_links: Vec<i32> = Vec::new<i32>()
        let next_links: Vec<i32> = Vec::new<i32>()
        // The value log is already in traversal order, so node `i` owns value
        // `i` and the links are simply the adjacent indices. Building the pool
        // from indices keeps this path free of element movement.
        let mut index: i32 = 0
        while index < count {
            push(node_values, index)
            push(prev_links, index - 1)
            push(next_links, index + 1)
            index = index + 1
        }
        if count > 0 {
            set(next_links, count - 1, NIL)
        }
        let head: i32 = if count > 0 { 0 } else { NIL }
        LinkedList {
            values: values,
            node_values: node_values,
            prev_links: prev_links,
            next_links: next_links,
            head: head,
            tail: count - 1,
            free_head: NIL,
            length: count
        }
    }
}

fn linked_list_debug_items<T: Debug>(list: LinkedList<T>) -> String {
    let mut out: String = String_from("[")
    let mut node: i32 = list.head
    let mut first: bool = true
    while node != NIL {
        if !first {
            out = out.concat(String_from(", "))
        }
        out = out.concat((linked_list_value_at(list, node)).fmt_debug())
        first = false
        node = get_unchecked(list.next_links, node)
    }
    out.concat(String_from("]"))
}

test mod "linked_list" {
    test "new_is_empty" {
        let l = linked_list_new()
        assert(linked_list_is_empty(l))
        assert(linked_list_len(l) == 0)
    }
    test "push_front_order" {
        let l = linked_list_new()
        linked_list_push_front(l, 1)
        linked_list_push_front(l, 2)
        assert(linked_list_front(l, 0 - 1) == 2)
        assert(linked_list_back(l, 0 - 1) == 1)
    }
    test "push_back_order" {
        let l = linked_list_new()
        linked_list_push_back(l, 1)
        linked_list_push_back(l, 2)
        assert(linked_list_front(l, 0 - 1) == 1)
        assert(linked_list_back(l, 0 - 1) == 2)
    }
    test "pop_front_fifo" {
        let l = linked_list_new()
        linked_list_push_back(l, 10)
        linked_list_push_back(l, 20)
        assert(linked_list_pop_front(l, 0 - 1) == 10)
        assert(linked_list_pop_front(l, 0 - 1) == 20)
    }
    test "pop_back_lifo" {
        let l = linked_list_new()
        linked_list_push_back(l, 10)
        linked_list_push_back(l, 20)
        assert(linked_list_pop_back(l, 0 - 1) == 20)
        assert(linked_list_pop_back(l, 0 - 1) == 10)
    }
    test "pop_empty_returns_fallback" {
        let l = linked_list_new()
        assert(linked_list_pop_front(l, 77) == 77)
        assert(linked_list_pop_back(l, 88) == 88)
    }
    test "peek_empty_returns_fallback" {
        let l = linked_list_new()
        assert(linked_list_front(l, 55) == 55)
        assert(linked_list_back(l, 66) == 66)
    }
    test "len_after_pops" {
        let l = linked_list_new()
        linked_list_push_back(l, 1)
        linked_list_push_back(l, 2)
        linked_list_pop_front(l, 0 - 1)
        assert(linked_list_len(l) == 1)
    }
    test "clear_resets" {
        let l = linked_list_new()
        linked_list_push_back(l, 1)
        linked_list_push_back(l, 2)
        linked_list_clear(l)
        assert(linked_list_is_empty(l))
        assert(linked_list_len(l) == 0)
    }
    test "to_vec_front_to_back" {
        let l = linked_list_new()
        linked_list_push_back(l, 3)
        linked_list_push_back(l, 4)
        linked_list_push_front(l, 2)
        let v = linked_list_to_vec(l)
        assert(v.len() == 3)
        assert(v.get_unchecked(0) == 2)
        assert(v.get_unchecked(1) == 3)
        assert(v.get_unchecked(2) == 4)
    }
    test "push_after_drain_reuses" {
        let l = linked_list_new()
        linked_list_push_back(l, 1)
        linked_list_pop_front(l, 0 - 1)
        linked_list_push_back(l, 9)
        assert(linked_list_len(l) == 1)
        assert(linked_list_front(l, 0 - 1) == 9)
    }
    test "single_element_both_ends" {
        let l = linked_list_new()
        linked_list_push_back(l, 5)
        assert(linked_list_front(l, 0 - 1) == 5)
        assert(linked_list_back(l, 0 - 1) == 5)
    }
}
