//! `LinkedList<T>` — a doubly-linked list.
//!
//! `LinkedList<T>` is a `Vec`-backed node pool with a free list. Node metadata
//! (`prev` / `next` indices and a value index) lives in parallel `Vec<i32>`
//! vectors, and element values live in an append-only `Vec<T>` log. Both-end
//! push / pop and peek are O(1); front-to-back traversal is O(n). `clear` drops
//! the value log and keeps the node-pool capacity.
//!
//! The former `linked_list_*` free functions and their monomorphic `Vec<i32>`
//! layout were retired under ADR-046 / ADR-086 §8. The receiver methods below
//! are the only public surface; old calls fail with E0100 hints.
//!
//! Cursors hold the list handle rather than a borrowed reference, so the type
//! checker does not yet reject a push / pop / clear while an iterator is alive.
//! Do not structurally modify a list during iteration; the borrow / lifetime
//! design will enforce this later (ADR-086 §5).
//!
//! `FromIterator<VecIter<T>>` appends the cursor values front to back, and `Eq`
//! compares length plus iteration order while ignoring node-pool state.
//! ADR-078 §3 allows one parametric impl per (trait, self constructor), so the
//! list cursors cannot be added as further `FromIterator` sources.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

// Do not import `std::collections::vec` here. Loading that module's own
// `impl Vec<T>` shadows the prelude Vec constructor inside this module's
// generic code; `LinkedList::new<String>()` then emits the unmonomorphized
// `Vec::new<T>` and fails wasm32-gc validation (#710).

use std::core::clone
use std::core::cmp
use std::core::convert
use std::core::iter
use std::text

// ── internal layout constants ───────────────────────────────────────────────

const NIL: i32 = 0 - 1

// ── LinkedList<T> (ADR-086 Phase 3) ─────────────────────────────────────────

/// Doubly-linked list with O(1) push / pop at both ends.
///
/// Fields are private; construct with `LinkedList::new<T>()`. Empty pops and
/// peeks return `Option::None`. Removed node slots are recycled through a free
/// list, while element values are appended to a log that `clear` drops. The
/// log grows with the number of pushes since the last `clear`, not with the
/// live list length.
pub struct LinkedList<T> {
    values: Vec<T>,
    node_values: Vec<i32>,
    prev_links: Vec<i32>,
    next_links: Vec<i32>,
    head: i32,
    tail: i32,
    free_head: i32,
    length: i32,
}

impl<T> LinkedList<T> {
    /// Creates an empty list.
    fn new() -> LinkedList<T> {
        LinkedList {
            values: Vec::new<T>(),
            node_values: Vec::new<i32>(),
            prev_links: Vec::new<i32>(),
            next_links: Vec::new<i32>(),
            head: NIL,
            tail: NIL,
            free_head: NIL,
            length: 0
        }
    }

    /// Inserts `value` at the front. O(1).
    fn push_front(mut self: LinkedList<T>, value: T) {
        let node: i32 = self.allocate_node(value)
        let old_head: i32 = self.head
        self.next_links.set(node, old_head)
        if old_head != NIL {
            self.prev_links.set(old_head, node)
        } else {
            self.tail = node
        }
        self.head = node
        self.length = self.length + 1
    }

    /// Inserts `value` at the back. O(1).
    fn push_back(mut self: LinkedList<T>, value: T) {
        let node: i32 = self.allocate_node(value)
        let old_tail: i32 = self.tail
        self.prev_links.set(node, old_tail)
        if old_tail != NIL {
            self.next_links.set(old_tail, node)
        } else {
            self.head = node
        }
        self.tail = node
        self.length = self.length + 1
    }

    /// Removes and returns the front element, or `None` when empty.
    fn pop_front(mut self: LinkedList<T>) -> Option<T> {
        if self.head == NIL {
            return Option::None
        }
        let node: i32 = self.head
        let value: T = linked_list_value_at(self, node)
        let next: i32 = self.next_links.get_unchecked(node)
        self.head = next
        if next != NIL {
            self.prev_links.set(next, NIL)
        } else {
            self.tail = NIL
        }
        self.recycle_node(node)
        self.length = self.length - 1
        Option::Some(value)
    }

    /// Removes and returns the back element, or `None` when empty.
    fn pop_back(mut self: LinkedList<T>) -> Option<T> {
        if self.tail == NIL {
            return Option::None
        }
        let node: i32 = self.tail
        let value: T = linked_list_value_at(self, node)
        let prev: i32 = self.prev_links.get_unchecked(node)
        self.tail = prev
        if prev != NIL {
            self.next_links.set(prev, NIL)
        } else {
            self.head = NIL
        }
        self.recycle_node(node)
        self.length = self.length - 1
        Option::Some(value)
    }

    /// Peeks at the front element without removing it.
    fn front(self: LinkedList<T>) -> Option<T> {
        if self.head == NIL {
            return Option::None
        }
        Option::Some(linked_list_value_at(self, self.head))
    }

    /// Peeks at the back element without removing it.
    fn back(self: LinkedList<T>) -> Option<T> {
        if self.tail == NIL {
            return Option::None
        }
        Option::Some(linked_list_value_at(self, self.tail))
    }

    /// Returns the number of elements.
    fn len(self: LinkedList<T>) -> i32 {
        self.length
    }

    /// Returns true when the list has no elements.
    fn is_empty(self: LinkedList<T>) -> bool {
        self.length == 0
    }

    /// Removes all elements and drops every retained node value.
    ///
    /// The node pool capacity is kept for reuse.
    fn clear(mut self: LinkedList<T>) {
        self.head = NIL
        self.tail = NIL
        self.free_head = NIL
        self.length = 0
        drop_values(self.values)
        drop_values(self.node_values)
        drop_values(self.prev_links)
        drop_values(self.next_links)
    }

    /// Returns a read-only cursor over the elements, front to back.
    fn iter(self: LinkedList<T>) -> LinkedListIter<T> {
        let first: i32 = self.head
        let count: i32 = self.length
        LinkedListIter { list: self, node: first, remaining: count }
    }

    /// Returns a writable cursor whose `set_current` replaces the last element
    /// returned by `next`.
    fn iter_mut(self: LinkedList<T>) -> LinkedListIterMut<T> {
        let first: i32 = self.head
        let count: i32 = self.length
        LinkedListIterMut {
            list: self,
            node: first,
            current: NIL,
            remaining: count,
            stopped: false
        }
    }

    // Node slots are recycled through the free list, but values are appended
    // to a log and indexed through `node_values`: a new value is never written
    // into an old `Vec<T>` slot. Generic `set` / raw array writes on `Vec<T>`
    // do not lower when T is a reference type on wasm32-gc, and the i32-index
    // write below is safe for every T.
    fn allocate_node(mut self: LinkedList<T>, value: T) -> i32 {
        let value_index: i32 = self.values.len()
        self.values.push(value)
        if self.free_head != NIL {
            let node: i32 = self.free_head
            self.free_head = self.next_links.get_unchecked(node)
            self.prev_links.set(node, NIL)
            self.next_links.set(node, NIL)
            self.node_values.set(node, value_index)
            return node
        }
        let node: i32 = self.node_values.len()
        self.node_values.push(value_index)
        self.prev_links.push(NIL)
        self.next_links.push(NIL)
        node
    }

    fn recycle_node(mut self: LinkedList<T>, node: i32) {
        self.prev_links.set(node, NIL)
        self.next_links.set(node, self.free_head)
        self.free_head = node
    }
}

fn linked_list_value_at<T>(list: LinkedList<T>, node: i32) -> T {
    list.values.get_unchecked(list.node_values.get_unchecked(node))
}

fn drop_values<T>(mut values: Vec<T>) {
    while values.len() > 0 {
        match values.pop() {
            Option::Some(_) => {},
            Option::None => { break },
        }
    }
}

/// Read-only cursor over a `LinkedList<T>`, front to back.
pub struct LinkedListIter<T> {
    list: LinkedList<T>,
    node: i32,
    remaining: i32,
}

impl<T> Iterator for LinkedListIter<T> {
    type Item = T

    fn next(mut self: LinkedListIter<T>) -> Option<T> {
        if self.remaining <= 0 {
            return Option::None
        }
        let value: T = linked_list_value_at(self.list, self.node)
        self.node = self.list.next_links.get_unchecked(self.node)
        self.remaining = self.remaining - 1
        Option::Some(value)
    }

    fn collect(mut self: LinkedListIter<T>) -> Vec<T> {
        let mut out: Vec<T> = Vec::new<T>()
        while self.remaining > 0 {
            out.push(linked_list_value_at(self.list, self.node))
            self.node = self.list.next_links.get_unchecked(self.node)
            self.remaining = self.remaining - 1
        }
        out
    }

    fn count(mut self: LinkedListIter<T>) -> i32 {
        let remaining: i32 = self.remaining
        self.remaining = 0
        self.node = NIL
        remaining
    }
}

impl<T> IntoIterator for LinkedListIter<T> {
    type Item = T
    type IntoIter = LinkedListIter<T>

    fn into_iter(self: LinkedListIter<T>) -> LinkedListIter<T> {
        self
    }
}

/// Writable cursor over a `LinkedList<T>`, front to back.
///
/// `set_current` replaces the element returned by the previous `next` call and
/// returns the old value. Before the first `next`, and after `next` has
/// reported the end, it returns `None` and leaves the list unchanged.
pub struct LinkedListIterMut<T> {
    list: LinkedList<T>,
    node: i32,
    current: i32,
    remaining: i32,
    stopped: bool,
}

impl<T> Iterator for LinkedListIterMut<T> {
    type Item = T

    fn next(mut self: LinkedListIterMut<T>) -> Option<T> {
        if self.remaining <= 0 {
            self.stopped = true
            return Option::None
        }
        let value: T = linked_list_value_at(self.list, self.node)
        self.current = self.node
        self.node = self.list.next_links.get_unchecked(self.node)
        self.remaining = self.remaining - 1
        Option::Some(value)
    }

    fn collect(mut self: LinkedListIterMut<T>) -> Vec<T> {
        let mut out: Vec<T> = Vec::new<T>()
        while self.remaining > 0 {
            out.push(linked_list_value_at(self.list, self.node))
            self.node = self.list.next_links.get_unchecked(self.node)
            self.remaining = self.remaining - 1
        }
        out
    }

    fn count(mut self: LinkedListIterMut<T>) -> i32 {
        let remaining: i32 = self.remaining
        self.remaining = 0
        self.node = NIL
        remaining
    }
}

impl<T> LinkedListIterMut<T> {
    /// Replaces the last element yielded by `next` and returns the old value.
    fn set_current(mut self: LinkedListIterMut<T>, value: T) -> Option<T> {
        if self.stopped || self.current < 0 {
            return Option::None
        }
        if self.current >= self.list.values.len() {
            return Option::None
        }
        let old: T = linked_list_value_at(self.list, self.current)
        self.list.values.set(self.current, value)
        Option::Some(old)
    }
}

impl<T> IntoIterator for LinkedListIterMut<T> {
    type Item = T
    type IntoIter = LinkedListIterMut<T>

    fn into_iter(self: LinkedListIterMut<T>) -> LinkedListIterMut<T> {
        self
    }
}

/// Owning cursor over a `LinkedList<T>`, front to back.
pub struct LinkedListIntoIter<T> {
    list: LinkedList<T>,
}

impl<T> Iterator for LinkedListIntoIter<T> {
    type Item = T

    fn next(mut self: LinkedListIntoIter<T>) -> Option<T> {
        self.list.pop_front()
    }

    fn collect(mut self: LinkedListIntoIter<T>) -> Vec<T> {
        let mut out: Vec<T> = Vec::new<T>()
        while self.list.length > 0 {
            match self.list.pop_front() {
                Option::Some(value) => out.push(value),
                Option::None => { break },
            }
        }
        out
    }

    fn count(mut self: LinkedListIntoIter<T>) -> i32 {
        let remaining: i32 = self.list.length
        self.list.clear()
        remaining
    }
}

impl<T> IntoIterator for LinkedListIntoIter<T> {
    type Item = T
    type IntoIter = LinkedListIntoIter<T>

    fn into_iter(self: LinkedListIntoIter<T>) -> LinkedListIntoIter<T> {
        self
    }
}

impl<T> IntoIterator for LinkedList<T> {
    type Item = T
    type IntoIter = LinkedListIntoIter<T>

    fn into_iter(self: LinkedList<T>) -> LinkedListIntoIter<T> {
        LinkedListIntoIter { list: self }
    }
}

impl<T: Clone> Clone for LinkedList<T> {
    fn clone(self: LinkedList<T>) -> LinkedList<T> {
        // `LinkedList::new<T>()` from generic impl code emits the
        // unmonomorphized constructor, so build the empty pool directly.
        let mut copy: LinkedList<T> = LinkedList {
            values: Vec::new<T>(),
            node_values: Vec::new<i32>(),
            prev_links: Vec::new<i32>(),
            next_links: Vec::new<i32>(),
            head: NIL,
            tail: NIL,
            free_head: NIL,
            length: 0
        }
        let mut node: i32 = self.head
        while node != NIL {
            copy.push_back((linked_list_value_at(self, node)).clone())
            node = self.next_links.get_unchecked(node)
        }
        copy
    }
}

/// Equality compares length and logical front-to-back order.
///
/// The node-pool capacity and recycled slots are storage state, not list
/// state, so the same logical list compares equal (ADR-086 §6).
impl<T: Eq> Eq for LinkedList<T> {
    fn eq(self: LinkedList<T>, other: LinkedList<T>) -> bool {
        if self.length != other.length {
            return false
        }
        let mut left: i32 = self.head
        let mut right: i32 = other.head
        while left != NIL {
            // Read the value log inline rather than through
            // `linked_list_value_at`: the helper return loses the concrete
            // element type in the monomorphised impl, and the `eq` call then
            // validates with a boxed ABI on wasm32-gc.
            let left_value: T = self.values.get_unchecked(self.node_values.get_unchecked(left))
            let right_value: T = other.values.get_unchecked(other.node_values.get_unchecked(right))
            if !left_value.eq(right_value) {
                return false
            }
            left = self.next_links.get_unchecked(left)
            right = other.next_links.get_unchecked(right)
        }
        true
    }
}

impl<T: Debug> Debug for LinkedList<T> {
    fn fmt_debug(self: LinkedList<T>) -> String {
        String_from("LinkedList ").concat(linked_list_debug_items(self))
    }
}

// ADR-078 §3 permits at most one parametric impl per (trait, self
// constructor), so `LinkedList<T>` cannot also implement the other ADR-086 §6
// sources (`LinkedListIter<T>` / `LinkedListIntoIter<T>`). `VecIter<T>` is the
// uniform cross-collection source, so it is the implemented one.
impl<T> FromIterator<VecIter<T>> for LinkedList<T> {
    fn from_iter(mut it: VecIter<T>) -> LinkedList<T> {
        let values: Vec<T> = it.collect()
        let count: i32 = values.len()
        let mut node_values: Vec<i32> = Vec::new<i32>()
        let mut prev_links: Vec<i32> = Vec::new<i32>()
        let mut next_links: Vec<i32> = Vec::new<i32>()
        // The value log is already in traversal order, so node `i` owns value
        // `i` and the links are simply the adjacent indices. Building the pool
        // from indices keeps this path free of element movement.
        let mut index: i32 = 0
        while index < count {
            node_values.push(index)
            prev_links.push(index - 1)
            next_links.push(index + 1)
            index = index + 1
        }
        if count > 0 {
            next_links.set(count - 1, NIL)
        }
        let head: i32 = if count > 0 { 0 } else { NIL }
        LinkedList {
            values: values,
            node_values: node_values,
            prev_links: prev_links,
            next_links: next_links,
            head: head,
            tail: count - 1,
            free_head: NIL,
            length: count
        }
    }
}

fn linked_list_debug_items<T: Debug>(list: LinkedList<T>) -> String {
    let mut out: String = String_from("[")
    let mut node: i32 = list.head
    let mut first: bool = true
    while node != NIL {
        if !first {
            out = out.concat(String_from(", "))
        }
        out = out.concat((linked_list_value_at(list, node)).fmt_debug())
        first = false
        node = list.next_links.get_unchecked(node)
    }
    out.concat(String_from("]"))
}

fn expect_list_i32(value: Option<i32>, expected: i32) {
    match value {
        Option::Some(actual) => assert(actual == expected),
        Option::None => assert(false),
    }
}

fn expect_list_none_i32(value: Option<i32>) {
    match value {
        Option::Some(_) => assert(false),
        Option::None => {},
    }
}

test mod "linked_list" {
    test "new_is_empty" {
        let list: LinkedList<i32> = LinkedList::new<i32>()
        assert(list.is_empty())
        assert(list.len() == 0)
    }
    test "push_front_order" {
        let mut list: LinkedList<i32> = LinkedList::new<i32>()
        list.push_front(1)
        list.push_front(2)
        expect_list_i32(list.front(), 2)
        expect_list_i32(list.back(), 1)
    }
    test "push_back_order" {
        let mut list: LinkedList<i32> = LinkedList::new<i32>()
        list.push_back(1)
        list.push_back(2)
        expect_list_i32(list.front(), 1)
        expect_list_i32(list.back(), 2)
    }
    test "pop_front_fifo" {
        let mut list: LinkedList<i32> = LinkedList::new<i32>()
        list.push_back(10)
        list.push_back(20)
        expect_list_i32(list.pop_front(), 10)
        expect_list_i32(list.pop_front(), 20)
    }
    test "pop_back_lifo" {
        let mut list: LinkedList<i32> = LinkedList::new<i32>()
        list.push_back(10)
        list.push_back(20)
        expect_list_i32(list.pop_back(), 20)
        expect_list_i32(list.pop_back(), 10)
    }
    test "pop_empty_returns_none" {
        let mut list: LinkedList<i32> = LinkedList::new<i32>()
        expect_list_none_i32(list.pop_front())
        expect_list_none_i32(list.pop_back())
    }
    test "peek_empty_returns_none" {
        let list: LinkedList<i32> = LinkedList::new<i32>()
        expect_list_none_i32(list.front())
        expect_list_none_i32(list.back())
    }
    test "len_after_pops" {
        let mut list: LinkedList<i32> = LinkedList::new<i32>()
        list.push_back(1)
        list.push_back(2)
        list.pop_front()
        assert(list.len() == 1)
    }
    test "clear_resets" {
        let mut list: LinkedList<i32> = LinkedList::new<i32>()
        list.push_back(1)
        list.push_back(2)
        list.clear()
        assert(list.is_empty())
        assert(list.len() == 0)
    }
    test "iter_collect_front_to_back" {
        let mut list: LinkedList<i32> = LinkedList::new<i32>()
        list.push_back(3)
        list.push_back(4)
        list.push_front(2)
        let values: Vec<i32> = list.iter().collect()
        assert(values.len() == 3)
        assert(values.get_unchecked(0) == 2)
        assert(values.get_unchecked(1) == 3)
        assert(values.get_unchecked(2) == 4)
    }
    test "push_after_drain_reuses" {
        let mut list: LinkedList<i32> = LinkedList::new<i32>()
        list.push_back(1)
        list.pop_front()
        list.push_back(9)
        assert(list.len() == 1)
        expect_list_i32(list.front(), 9)
    }
    test "single_element_both_ends" {
        let mut list: LinkedList<i32> = LinkedList::new<i32>()
        list.push_back(5)
        expect_list_i32(list.front(), 5)
        expect_list_i32(list.back(), 5)
    }
}
