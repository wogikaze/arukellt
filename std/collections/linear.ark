//! Legacy linear collection helpers: monomorphic deque and priority queue.
//!
//! The `deque_*` functions are the pre-ADR-086 free-function surface: an
//! `i32` ring buffer laid out as `[head, tail, count, cap, ...data(cap)]`.
//! They stay callable through the ADR-014 deprecation window, but new code
//! should use `std::collections::deque::Deque<T>` (plus `Queue<T>` /
//! `Stack<T>`); the manifest points every `deque_*` entry at its method
//! replacement.
//!
//! `PriorityQueue` (`pq_*`) is a binary min-heap, not a linear ADT, and keeps
//! its own owner (ADR-086 §8).
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.
// --- Deque (ring buffer) ---
pub fn deque_new() -> Vec<i32> {
    let cap: i32 = 16
    let d: Vec<i32> = Vec::new<i32>()
    push(d, 0)
    push(d, 0)
    push(d, 0)
    push(d, cap)
    let mut i: i32 = 0
    while i < cap {
        push(d, 0)
        i = i + 1
    }
    d
}

pub fn deque_push_back(d: Vec<i32>, val: i32) {
    let tail: i32 = get_unchecked(d, 1)
    let count: i32 = get_unchecked(d, 2)
    let cap: i32 = get_unchecked(d, 3)
    set(d, 4 + tail, val)
    set(d, 1, (tail + 1) % cap)
    set(d, 2, count + 1)
}

pub fn deque_push_front(d: Vec<i32>, val: i32) {
    let head: i32 = get_unchecked(d, 0)
    let count: i32 = get_unchecked(d, 2)
    let cap: i32 = get_unchecked(d, 3)
    let new_head: i32 = (head - 1 + cap) % cap
    set(d, 4 + new_head, val)
    set(d, 0, new_head)
    set(d, 2, count + 1)
}

pub fn deque_pop_front(d: Vec<i32>) -> i32 {
    let head: i32 = get_unchecked(d, 0)
    let cap: i32 = get_unchecked(d, 3)
    let val: i32 = get_unchecked(d, 4 + head)
    set(d, 0, (head + 1) % cap)
    let count: i32 = get_unchecked(d, 2)
    set(d, 2, count - 1)
    val
}

pub fn deque_pop_back(d: Vec<i32>) -> i32 {
    let tail: i32 = get_unchecked(d, 1)
    let cap: i32 = get_unchecked(d, 3)
    let new_tail: i32 = (tail - 1 + cap) % cap
    let val: i32 = get_unchecked(d, 4 + new_tail)
    set(d, 1, new_tail)
    let count: i32 = get_unchecked(d, 2)
    set(d, 2, count - 1)
    val
}

pub fn deque_len(d: Vec<i32>) -> i32 {
    get_unchecked(d, 2)
}

pub fn deque_is_empty(d: Vec<i32>) -> bool {
    get_unchecked(d, 2) == 0
}

// --- PriorityQueue (min-heap) ---
pub fn pq_new() -> Vec<i32> {
    let pq: Vec<i32> = Vec::new<i32>()
    push(pq, 0)
    pq
}

pub fn pq_push(pq: Vec<i32>, val: i32) {
    let count: i32 = get_unchecked(pq, 0)
    push(pq, val)
    set(pq, 0, count + 1)
    let mut idx: i32 = count
    let mut cont: bool = idx > 0
    while cont {
        let parent: i32 = (idx - 1) / 2
        let child_val: i32 = get_unchecked(pq, 1 + idx)
        let parent_val: i32 = get_unchecked(pq, 1 + parent)
        if child_val < parent_val {
            set(pq, 1 + idx, parent_val)
            set(pq, 1 + parent, child_val)
            idx = parent
            cont = idx > 0
        } else {
            cont = false
        }
    }
}

pub fn pq_pop(pq: Vec<i32>) -> i32 {
    let count: i32 = get_unchecked(pq, 0)
    let result: i32 = get_unchecked(pq, 1)
    let last: i32 = get_unchecked(pq, count)
    set(pq, 1, last)
    set(pq, 0, count - 1)
    let new_count: i32 = count - 1
    let mut idx: i32 = 0
    let mut cont: bool = true
    while cont {
        let left: i32 = idx * 2 + 1
        let right: i32 = idx * 2 + 2
        let mut smallest: i32 = idx
        if left < new_count {
            if get_unchecked(pq, 1 + left) < get_unchecked(pq, 1 + smallest) {
                smallest = left
            }
        }
        if right < new_count {
            if get_unchecked(pq, 1 + right) < get_unchecked(pq, 1 + smallest) {
                smallest = right
            }
        }
        if smallest != idx {
            let tmp: i32 = get_unchecked(pq, 1 + idx)
            set(pq, 1 + idx, get_unchecked(pq, 1 + smallest))
            set(pq, 1 + smallest, tmp)
            idx = smallest
        } else {
            cont = false
        }
    }
    result
}

pub fn pq_peek(pq: Vec<i32>) -> i32 {
    get_unchecked(pq, 1)
}

pub fn pq_len(pq: Vec<i32>) -> i32 {
    get_unchecked(pq, 0)
}

pub fn pq_is_empty(pq: Vec<i32>) -> bool {
    get_unchecked(pq, 0) == 0
}

pub fn pq_clear(pq: Vec<i32>) {
    set(pq, 0, 0)
}

// --- Additional Deque accessors ---
/// Peek at the front element without removing it.
/// Returns 0 when the deque is empty (check deque_is_empty first).
pub fn deque_front(d: Vec<i32>) -> i32 {
    let head: i32 = get_unchecked(d, 0)
    get_unchecked(d, 4 + head)
}

/// Peek at the back element without removing it.
/// Returns 0 when the deque is empty (check deque_is_empty first).
pub fn deque_back(d: Vec<i32>) -> i32 {
    let tail: i32 = get_unchecked(d, 1)
    let cap: i32 = get_unchecked(d, 3)
    let back_idx: i32 = (tail - 1 + cap) % cap
    get_unchecked(d, 4 + back_idx)
}

/// Reset the deque to empty (preserves capacity).
pub fn deque_clear(d: Vec<i32>) {
    set(d, 0, 0)
    set(d, 1, 0)
    set(d, 2, 0)
}

/// Copy all deque elements (front to back) into a new Vec<i32>.
pub fn deque_to_vec(d: Vec<i32>) -> Vec<i32> {
    let head: i32 = get_unchecked(d, 0)
    let count: i32 = get_unchecked(d, 2)
    let cap: i32 = get_unchecked(d, 3)
    let result: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < count {
        let idx: i32 = (head + i) % cap
        push(result, get_unchecked(d, 4 + idx))
        i = i + 1
    }
    result
}
// Layout: [head, tail, count, cap, ...data(cap)]
// Layout: [count, ...heap_data]
// Sift up
// Sift down
test mod "deque" {
    test "new_count" {
        let d = deque_new()
        assert(deque_len(d) == 0)
    }
    test "push_pop" {
        let d = deque_new()
        deque_push_back(d, 42)
        assert(deque_pop_front(d) == 42)
    }
    test "push_front" {
        let d = deque_new()
        deque_push_front(d, 9)
        assert(deque_front(d) == 9)
    }
}

test mod "deque_order" {
    test "fifo_back_in_front_out" {
        let d = deque_new()
        deque_push_back(d, 1)
        deque_push_back(d, 2)
        deque_push_back(d, 3)
        assert(deque_pop_front(d) == 1)
        assert(deque_pop_front(d) == 2)
    }
    test "mixed_ends_front_first" {
        let d = deque_new()
        deque_push_back(d, 2)
        deque_push_front(d, 1)
        deque_push_back(d, 3)
        assert(deque_front(d) == 1)
        assert(deque_back(d) == 3)
    }
    test "lifo_pop_back" {
        let d = deque_new()
        deque_push_back(d, 1)
        deque_push_back(d, 2)
        deque_push_back(d, 3)
        assert(deque_pop_back(d) == 3)
        assert(deque_pop_back(d) == 2)
        assert(deque_pop_back(d) == 1)
    }
    test "len_tracks_pushes" {
        let d = deque_new()
        deque_push_back(d, 1)
        deque_push_back(d, 2)
        assert(deque_len(d) == 2)
        deque_pop_front(d)
        assert(deque_len(d) == 1)
    }
    test "is_empty_after_drain" {
        let d = deque_new()
        deque_push_back(d, 1)
        deque_pop_front(d)
        assert(deque_is_empty(d))
    }
    test "clear_resets" {
        let d = deque_new()
        deque_push_back(d, 1)
        deque_push_back(d, 2)
        deque_clear(d)
        assert(deque_len(d) == 0)
        assert(deque_is_empty(d))
    }
    test "to_vec_front_to_back" {
        let d = deque_new()
        deque_push_back(d, 10)
        deque_push_back(d, 20)
        deque_push_back(d, 30)
        let v = deque_to_vec(d)
        assert(v.len() == 3)
        assert(v.get_unchecked(0) == 10)
        assert(v.get_unchecked(2) == 30)
    }
    test "wrap_around_beyond_initial_cap" {
        let d = deque_new()
        let mut i = 0
        while i < 20 {
            deque_push_back(d, i)
            i = i + 1
        }
        assert(deque_len(d) == 20)
        assert(deque_pop_front(d) == 0)
    }
}

test mod "priority_queue" {
    test "new_is_empty" {
        let q = pq_new()
        assert(pq_is_empty(q))
        assert(pq_len(q) == 0)
    }
    test "pop_returns_min" {
        let q = pq_new()
        pq_push(q, 5)
        pq_push(q, 1)
        pq_push(q, 3)
        assert(pq_pop(q) == 1)
    }
    test "pop_ascending_order" {
        let q = pq_new()
        pq_push(q, 4)
        pq_push(q, 1)
        pq_push(q, 3)
        pq_push(q, 2)
        assert(pq_pop(q) == 1)
        assert(pq_pop(q) == 2)
        assert(pq_pop(q) == 3)
        assert(pq_pop(q) == 4)
    }
    test "peek_shows_min_without_pop" {
        let q = pq_new()
        pq_push(q, 7)
        pq_push(q, 2)
        assert(pq_peek(q) == 2)
        assert(pq_len(q) == 2)
    }
    test "duplicates_pop_in_count" {
        let q = pq_new()
        pq_push(q, 1)
        pq_push(q, 1)
        pq_push(q, 1)
        assert(pq_len(q) == 3)
        assert(pq_pop(q) == 1)
        assert(pq_len(q) == 2)
    }
    test "clear_resets_heap" {
        let q = pq_new()
        pq_push(q, 9)
        pq_clear(q)
        assert(pq_is_empty(q))
    }
    test "interleaved_push_pop" {
        let q = pq_new()
        pq_push(q, 8)
        pq_push(q, 1)
        assert(pq_pop(q) == 1)
        pq_push(q, 0)
        assert(pq_pop(q) == 0)
        assert(pq_pop(q) == 8)
    }
}
