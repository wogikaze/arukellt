//! std::collections::hash_map — HashMap generic API
//!
//! `impl HashMap<K, V>` is the only public spelling: `HashMap::new<K, V>()`
//! plus receiver methods. `HashMap<i32, i32>` is the flat `Vec<i32>` store in
//! `std::collections::hash`, so its methods lower directly there. The other
//! supported pairs lower to the non-public implementation functions in
//! `std::collections::hash_string` / `hash_fn` / `hash_str_fn`; no typed
//! adapter is part of the public surface.
//!
//! The capacity / bulk-maintenance surface (`with_capacity`, `capacity`,
//! `reserve`, `try_reserve`, `shrink_to_fit`, `clear`, `drain`,
//! `remove_entry`, `extend`) is accepted for every supported pair and lowered
//! per pair: the flat `HashMap<i32, i32>` store exposes its counters directly,
//! while the String and fn-valued stores use their compiler-managed bucket
//! arrays through the non-public `__hm_*` bridge. The declarations below are
//! the flat pair's shells; the other pairs are checked by the typechecker's
//! HashMap method table so the pinned bootstrap can still typecheck this
//! module. MIR rewrites every call to the implementation function for the
//! receiver's pair, so the shell bodies never run.
//!
//! `iter`, `entry`, and `retain` are source-level generic methods rather than
//! store lowering targets. Arukellt v2 has no general `&T` / `&mut T`, so a
//! borrowed cursor cannot be expressed soundly: `iter` snapshots the occupied
//! pairs into `HashMapIter<K, V>`, and `entry` returns an owned `Entry<K, V>`
//! handle that writes back through the map. Both carry the map/element values
//! by handle and document the snapshot boundary. `retain` rebuilds in place by
//! removing the rejected keys, so the map handle and its bucket capacity are
//! preserved.

use std::core::iter

// Canonical v2 API. These generic shells provide the source-level contract;
// MIR rewrites each supported specialization to the per-pair implementation
// functions. The rewrite is required so the shell bodies never recurse at
// runtime.
impl<K, V> HashMap<K, V> {
    fn new() -> HashMap<K, V> {
        HashMap::new<K, V>()
    }

    fn insert(mut self, key: K, value: V) -> Option<V> {
        self.insert(key, value)
    }

    fn get(self, key: K) -> Option<V> {
        self.get(key)
    }

    fn contains_key(self, key: K) -> bool {
        self.contains_key(key)
    }

    fn remove(mut self, key: K) -> Option<V> {
        self.remove(key)
    }

    fn len(self) -> i32 {
        self.len()
    }

    fn is_empty(self) -> bool {
        self.is_empty()
    }

    // Snapshot accessors. `entries` returns typed `(K, V)` pairs; the flat
    // `[k0, v0, ...]` store spelling is a non-public lowering target.
    fn keys(self) -> Vec<K> {
        self.keys()
    }

    fn values(self) -> Vec<V> {
        self.values()
    }

    fn entries(self) -> Vec<(K, V)> {
        self.entries()
    }

    /// Keeps only entries for which `keep` accepts the `(K, V)` pair.
    ///
    /// The predicate receives one owned pair rather than two borrowed
    /// arguments because v2 has no reference pairs. The shell only carries
    /// the source contract; MIR rewrites the call to the per-pair store
    /// target, which evaluates the predicate against a snapshot before
    /// removing rejected keys.
    fn retain(mut self, keep: fn((K, V)) -> bool) {
        self.retain(keep)
    }
}

/// Owned handle for one map key.
///
/// Rust's `Entry<'a, K, V>` borrows the map; without a borrow checker the
/// handle owns the map and key instead. `or_insert` / `or_insert_with` resolve
/// the current value when consumed, so another write between `entry` and
/// `or_insert` is visible. The handle must not outlive the map value it was
/// opened from.
pub struct Entry<K, V> {
    map: HashMap<K, V>,
    key: K,
}

impl Entry<i32, i32> {
    /// Returns the key this entry was opened for.
    fn key(self: Entry<i32, i32>) -> i32 {
        let key: i32 = self.key
        key
    }

    /// Returns the stored value, inserting `default` when the key is absent.
    fn or_insert(mut self: Entry<i32, i32>, default: i32) -> i32 {
        let lookup: i32 = self.key
        match self.map.get(lookup) {
            Option::Some(value) => value,
            Option::None => {
                let store_key: i32 = self.key
                let _ = self.map.insert(store_key, default)
                default
            },
        }
    }

    /// Returns the stored value, inserting `make()` when the key is absent.
    fn or_insert_with(mut self: Entry<i32, i32>, make: fn() -> i32) -> i32 {
        let lookup: i32 = self.key
        match self.map.get(lookup) {
            Option::Some(value) => value,
            Option::None => {
                let inserted: i32 = make()
                let store_key: i32 = self.key
                let _ = self.map.insert(store_key, inserted)
                inserted
            },
        }
    }
}
impl Entry<String, i32> {
    /// Returns the key this entry was opened for.
    fn key(self: Entry<String, i32>) -> String {
        let key: String = self.key
        key
    }

    /// Returns the stored value, inserting `default` when the key is absent.
    fn or_insert(mut self: Entry<String, i32>, default: i32) -> i32 {
        let lookup: String = self.key
        match self.map.get(lookup) {
