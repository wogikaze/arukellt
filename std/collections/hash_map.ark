// For-in over a map converts through this parametric impl. The body
// snapshots the occupied keys into a Vec<K> through the generic
// HashMap::keys() method (which monomorphizes to the per-family keys
// implementation) and wraps it in the shared VecIter<K> producer, so both
// backends share one source-level meaning without a map-specific
// iterator state type (#691/#860).
impl<K, V> IntoIterator for HashMap<K, V> {
    type Item = K
    type IntoIter = VecIter<K>

    fn into_iter(self: HashMap<K, V>) -> VecIter<K> {
        let ks: Vec<K> = self.keys()
        VecIter { vec: ks, index: 0, length: ks.len() }
    }
}

// FromIterator consumes the snapshot cursor produced by `iter`; a generic
// body cannot allocate the pair-specific store (the `HashMap::new<K, V>()`
// shell would recurse instead of lowering), so each concrete pair owns one
// impl. The body drains the cursor with `next` because `collect` forwards to
// a generic helper whose mono instance is not specialized here (#917).
impl FromIterator<HashMapIter<i32, i32>> for HashMap<i32, i32> {
    fn from_iter(mut it: HashMapIter<i32, i32>) -> HashMap<i32, i32> {
        let mut result: HashMap<i32, i32> = HashMap::new<i32, i32>()
        for pair in it {
            let (key, value) = pair
            let _ = result.insert(key, value)
        }
        result
    }
}

impl FromIterator<HashMapIter<String, i32>> for HashMap<String, i32> {
    fn from_iter(mut it: HashMapIter<String, i32>) -> HashMap<String, i32> {
        let mut result: HashMap<String, i32> = HashMap::new<String, i32>()
        for pair in it {
            let (key, value) = pair
            let _ = result.insert(key, value)
        }
        result
    }
}

