//! std::collections::hash_map — HashMap generic API
//!
//! `impl HashMap<K, V>` is the only public spelling: `HashMap::new<K, V>()`
//! plus receiver methods. `HashMap<i32, i32>` is the flat `Vec<i32>` store in
//! `std::collections::hash`, so its methods lower directly there. The other
//! supported pairs lower to the non-public implementation functions in
//! `std::collections::hash_string` / `hash_fn` / `hash_str_fn`; no typed
//! adapter is part of the public surface.

use std::core::iter

// Canonical v2 API. These generic shells provide the source-level contract;
// MIR rewrites each supported specialization to the per-pair implementation
// functions. The rewrite is required so the shell bodies never recurse at
// runtime.
impl<K, V> HashMap<K, V> {
    fn new() -> HashMap<K, V> {
        HashMap::new<K, V>()
    }

    fn insert(mut self, key: K, value: V) -> Option<V> {
        self.insert(key, value)
    }

    fn get(self, key: K) -> Option<V> {
        self.get(key)
    }

    fn contains_key(self, key: K) -> bool {
        self.contains_key(key)
    }

    fn remove(mut self, key: K) -> Option<V> {
        self.remove(key)
    }

    fn len(self) -> i32 {
        self.len()
    }

    fn is_empty(self) -> bool {
        self.is_empty()
    }
}

// For-in over a map converts through this parametric impl. The body
// snapshots the occupied keys into a Vec<K> through the generic
// HashMap::keys() method (which monomorphizes to the per-family keys
// implementation) and wraps it in the shared VecIter<K> producer, so both
// backends share one source-level meaning without a map-specific
// iterator state type (#691/#860).
impl<K, V> IntoIterator for HashMap<K, V> {
    type Item = K
    type IntoIter = VecIter<K>

    fn into_iter(self: HashMap<K, V>) -> VecIter<K> {
        let ks: Vec<K> = self.keys()
        VecIter { vec: ks, index: 0, length: len(ks) }
    }
}
