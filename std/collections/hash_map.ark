/// Return a Vec<String> of all keys currently in a HashMap<String, fn>.
pub fn hashmap_str_fn_keys(m: HashMap<String, fn(i32) -> i32>) -> Vec<String> {
    hash_str_fn::hashmap_str_fn_keys(m)
}

