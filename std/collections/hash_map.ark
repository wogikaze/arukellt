//! std::collections::hash_map — HashMap generic API
//!
//! `impl HashMap<K, V>` is the only public spelling: `HashMap::new<K, V>()`
//! plus receiver methods. `HashMap<i32, i32>` is the flat `Vec<i32>` store in
//! `std::collections::hash`, so its methods lower directly there. The other
//! supported pairs lower to the non-public implementation functions in
//! `std::collections::hash_string` / `hash_fn` / `hash_str_fn`; no typed
//! adapter is part of the public surface.
//!
//! The capacity / bulk-maintenance surface (`with_capacity`, `capacity`,
//! `reserve`, `try_reserve`, `shrink_to_fit`, `clear`, `drain`,
//! `remove_entry`, `extend`) is accepted for every supported pair and lowered
//! per pair: the flat `HashMap<i32, i32>` store exposes its counters directly,
//! while the String and fn-valued stores use their compiler-managed bucket
//! arrays through the non-public `__hm_*` bridge. The declarations below are
//! the flat pair's shells; the other pairs are checked by the typechecker's
//! HashMap method table so the pinned bootstrap can still typecheck this
//! module. MIR rewrites every call to the implementation function for the
//! receiver's pair, so the shell bodies never run.

use std::core::iter

// Canonical v2 API. These generic shells provide the source-level contract;
// MIR rewrites each supported specialization to the per-pair implementation
// functions. The rewrite is required so the shell bodies never recurse at
// runtime.
impl<K, V> HashMap<K, V> {
    fn new() -> HashMap<K, V> {
        HashMap::new<K, V>()
    }

    fn insert(mut self, key: K, value: V) -> Option<V> {
        self.insert(key, value)
    }

    fn get(self, key: K) -> Option<V> {
        self.get(key)
    }

    fn contains_key(self, key: K) -> bool {
        self.contains_key(key)
    }

    fn remove(mut self, key: K) -> Option<V> {
        self.remove(key)
    }

    fn len(self) -> i32 {
        self.len()
    }

    fn is_empty(self) -> bool {
        self.is_empty()
    }

    // Snapshot accessors. `entries` returns typed `(K, V)` pairs; the flat
    // `[k0, v0, ...]` store spelling is a non-public lowering target.
    fn keys(self) -> Vec<K> {
        self.keys()
    }

    fn values(self) -> Vec<V> {
        self.values()
    }

    fn entries(self) -> Vec<(K, V)> {
        self.entries()
    }
}

// Flat-pair declarations for the capacity / bulk-maintenance surface. MIR
// rewrites each call to the implementation function for the receiver's pair
// (the non-flat targets live in `std::collections::hash_string` / `hash_fn` /
// `hash_str_fn`); the bodies here only carry the source contract and never
// run.
impl HashMap<i32, i32> {
    /// Creates an empty map with at least `cap` bucket slots (minimum 1).
    fn with_capacity(cap: i32) -> HashMap<i32, i32> {
        HashMap::with_capacity<i32, i32>(cap)
    }

    /// Returns the current bucket capacity.
    fn capacity(self: HashMap<i32, i32>) -> i32 {
        self.capacity()
    }

    /// Ensures room for at least `additional` more entries.
    fn reserve(mut self: HashMap<i32, i32>, additional: i32) {
        self.reserve(additional)
    }

    /// Fallible reserve facade. The flat store has no recoverable allocation
    /// error channel, so `true` means the reserve completed.
    fn try_reserve(mut self: HashMap<i32, i32>, additional: i32) -> bool {
        self.try_reserve(additional)
    }

    /// Shrinks buckets to the minimum that preserves the load factor.
    fn shrink_to_fit(mut self: HashMap<i32, i32>) {
        self.shrink_to_fit()
    }

    /// Removes every entry while keeping the bucket capacity.
    fn clear(mut self: HashMap<i32, i32>) {
        self.clear()
    }

    /// Removes every entry and returns them as typed pairs.
    fn drain(mut self: HashMap<i32, i32>) -> Vec<(i32, i32)> {
        self.drain()
    }

    /// Removes `key` and returns it together with its value.
    fn remove_entry(mut self: HashMap<i32, i32>, key: i32) -> Option<(i32, i32)> {
        self.remove_entry(key)
    }

    /// Inserts every entry of `other`, overwriting existing keys.
    fn extend(mut self: HashMap<i32, i32>, other: HashMap<i32, i32>) {
        self.extend(other)
    }
}

// For-in over a map converts through this parametric impl. The body
// snapshots the occupied keys into a Vec<K> through the generic
// HashMap::keys() method (which monomorphizes to the per-family keys
// implementation) and wraps it in the shared VecIter<K> producer, so both
// backends share one source-level meaning without a map-specific
// iterator state type (#691/#860).
impl<K, V> IntoIterator for HashMap<K, V> {
    type Item = K
    type IntoIter = VecIter<K>

    fn into_iter(self: HashMap<K, V>) -> VecIter<K> {
        let ks: Vec<K> = self.keys()
        VecIter { vec: ks, index: 0, length: len(ks) }
    }
}
