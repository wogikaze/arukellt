/// Snapshot cursor over the `(K, V)` pairs of a `HashMap`.
///
/// The cursor owns the pairs captured by `HashMap::iter`; later map writes are
/// not observed. Pair order is bucket order, which is implementation-defined.
pub struct HashMapIter<K, V> {
    keys: Vec<K>,
    values: Vec<V>,
    index: i32,
    length: i32,
}

impl<K, V> HashMapIter<K, V> {
    /// Returns true when no more pairs remain.
    fn is_empty(self: HashMapIter<K, V>) -> bool {
        self.index >= self.length
    }
}

impl<K, V> Iterator for HashMapIter<K, V> {
    type Item = (K, V)

    fn next(mut self: HashMapIter<K, V>) -> Option<(K, V)> {
        if self.index >= self.length {
            return Option::None
        }
        let key: K = get_unchecked(self.keys, self.index)
        let value: V = get_unchecked(self.values, self.index)
        self.index = self.index + 1
        Option::Some((key, value))
    }

    fn collect(mut self: HashMapIter<K, V>) -> Vec<(K, V)> {
        let mut result: Vec<(K, V)> = Vec::new<(K, V)>()
        while true {
            match self.next() {
                Option::Some(pair) => push(result, pair),
                Option::None => { break },
            }
        }
        result
    }

    fn count(mut self: HashMapIter<K, V>) -> i32 {
        let mut total: i32 = 0
        while true {
            match self.next() {
                Option::Some(_) => total = total + 1,
                Option::None => { break },
            }
        }
        total
    }
}

impl<K, V> IntoIterator for HashMapIter<K, V> {
    type Item = (K, V)
    type IntoIter = HashMapIter<K, V>

    fn into_iter(self: HashMapIter<K, V>) -> HashMapIter<K, V> {
        self
    }
}

// Flat-pair declarations for the capacity / bulk-maintenance surface. MIR
// rewrites each call to the implementation function for the receiver's pair
// (the non-flat targets live in `std::collections::hash_string` / `hash_fn` /
// `hash_str_fn`); the bodies here only carry the source contract and never
// run.

impl HashMap<i32, i32> {
    /// Creates an empty map with at least `cap` bucket slots (minimum 1).
    fn with_capacity(cap: i32) -> HashMap<i32, i32> {
        HashMap::with_capacity<i32, i32>(cap)
    }

    /// Returns the current bucket capacity.
    fn capacity(self: HashMap<i32, i32>) -> i32 {
        self.capacity()
    }

    /// Ensures room for at least `additional` more entries.
    fn reserve(mut self: HashMap<i32, i32>, additional: i32) {
        self.reserve(additional)
    }

    /// Fallible reserve facade. The flat store has no recoverable allocation
    /// error channel, so `true` means the reserve completed.
    fn try_reserve(mut self: HashMap<i32, i32>, additional: i32) -> bool {
        self.try_reserve(additional)
    }

    /// Shrinks buckets to the minimum that preserves the load factor.
    fn shrink_to_fit(mut self: HashMap<i32, i32>) {
        self.shrink_to_fit()
    }

    /// Removes every entry while keeping the bucket capacity.
    fn clear(mut self: HashMap<i32, i32>) {
        self.clear()
    }

    /// Removes every entry and returns them as typed pairs.
    fn drain(mut self: HashMap<i32, i32>) -> Vec<(i32, i32)> {
        self.drain()
    }

    /// Removes `key` and returns it together with its value.
    fn remove_entry(mut self: HashMap<i32, i32>, key: i32) -> Option<(i32, i32)> {
        self.remove_entry(key)
    }

    /// Inserts every entry of `other`, overwriting existing keys.
    fn extend(mut self: HashMap<i32, i32>, other: HashMap<i32, i32>) {
        self.extend(other)
    }

    /// Returns a snapshot cursor over the map's `(K, V)` pairs.
    ///
    /// The cursor owns the snapshots, so later map writes are not observed.
    /// Pair order is the store's bucket order, which is implementation-defined.
    fn iter(self: HashMap<i32, i32>) -> HashMapIter<i32, i32> {
        let keys: Vec<i32> = self.keys()
        let values: Vec<i32> = self.values()
        HashMapIter {
            keys: keys,
            values: values,
            index: 0,
            length: keys.len(),
        }
    }

    /// Opens an owned entry handle for `key`.
    fn entry(self: HashMap<i32, i32>, key: i32) -> Entry<i32, i32> {
        Entry {
            map: self,
            key: key,
        }
    }

}

/// `HashMap<String, i32>` source-level iterator / entry / retain surface.
///
/// These methods live on the concrete pair so their return types stay
/// concrete; a generic shell cannot allocate or infer the pair's cursor
/// without the borrowed-reference machinery v2 does not have yet.
impl HashMap<String, i32> {
    /// Returns a snapshot cursor over the map's `(K, V)` pairs.
    fn iter(self: HashMap<String, i32>) -> HashMapIter<String, i32> {
        let keys: Vec<String> = self.keys()
        let values: Vec<i32> = self.values()
        HashMapIter {
            keys: keys,
            values: values,
            index: 0,
            length: keys.len(),
        }
    }

    /// Opens an owned entry handle for `key`.
    fn entry(self: HashMap<String, i32>, key: String) -> Entry<String, i32> {
        Entry {
            map: self,
            key: key,
        }
    }

}

