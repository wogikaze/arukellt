// Canonical v2 API. These generic shells provide the source-level contract;
// MIR rewrites each supported specialization to the typed adapter above. The
// rewrite is required so the shell bodies never recurse at runtime, and can be
// removed with the legacy adapters after the ADR-014 deprecation window.
impl HashMap<K, V> {
    fn new() -> HashMap<K, V> {
        HashMap::new<K, V>()
    }

    fn insert(self, key: K, value: V) -> Option<V> {
        self.insert(key, value)
    }

    fn get(self, key: K) -> Option<V> {
        self.get(key)
    }

    fn contains_key(self, key: K) -> bool {
        self.contains_key(key)
    }

    fn remove(self, key: K) -> Option<V> {
        self.remove(key)
    }

    fn len(self) -> i32 {
        self.len()
    }

    fn is_empty(self) -> bool {
        self.is_empty()
    }
}

// For-in over a concrete map converts through these impls. Each one
// snapshots the occupied keys into a Vec and reuses the matching Vec
// iterator, so both backends share the same source-level meaning without a
// map-specific iterator state type.
impl IntoIterator for HashMap<i32, i32> {
    type Item = i32
    type IntoIter = VecIter<i32>

    fn into_iter(self: HashMap<i32, i32>) -> VecIter<i32> {
        hashmap_i32_i32_keys(self).iter()
    }
}

impl IntoIterator for HashMap<String, i32> {
    type Item = String
    type IntoIter = VecIter<String>

    fn into_iter(self: HashMap<String, i32>) -> VecIter<String> {
        hashmap_str_i32_keys(self).iter()
    }
}

impl IntoIterator for HashMap<i32, String> {
    type Item = i32
    type IntoIter = VecIter<i32>

    fn into_iter(self: HashMap<i32, String>) -> VecIter<i32> {
        hashmap_i32_str_keys(self).iter()
    }
}

impl IntoIterator for HashMap<String, String> {
    type Item = String
    type IntoIter = VecIter<String>

    fn into_iter(self: HashMap<String, String>) -> VecIter<String> {
        hashmap_str_str_keys(self).iter()
    }
}

impl IntoIterator for HashMap<i32, fn(i32) -> i32> {
    type Item = i32
    type IntoIter = VecIter<i32>

    fn into_iter(self: HashMap<i32, fn(i32) -> i32>) -> VecIter<i32> {
        hashmap_i32_fn_keys(self).iter()
    }
}

impl IntoIterator for HashMap<String, fn(i32) -> i32> {
    type Item = String
    type IntoIter = VecIter<String>

    fn into_iter(self: HashMap<String, fn(i32) -> i32>) -> VecIter<String> {
        hashmap_str_fn_keys(self).iter()
    }
}

/// Create a new HashSet<String>.
pub fn hashset_str_new() -> Vec<String> {
    Vec::new<String>()
}

/// Insert a value into a HashSet<String>. Returns true if the value was newly inserted.
pub fn hashset_str_insert(s: Vec<String>, value: String) -> bool {
    if hash_map_vec_string_index_of(s, clone(value)) >= 0 {
        false
    } else {
        push(s, value)
        true
    }
}

/// Returns true if the HashSet<String> contains the value.
pub fn hashset_str_contains(s: Vec<String>, value: String) -> bool {
    hash_map_vec_string_index_of(s, value) >= 0
}

/// Remove a value from the HashSet<String>. Returns true if the value was present.
pub fn hashset_str_remove(s: Vec<String>, value: String) -> bool {
    let idx: i32 = hash_map_vec_string_index_of(s, value)
    if idx < 0 {
        false
    } else {
        hash_map_vec_string_remove_at(s, idx)
        true
    }
}

/// Return the number of elements in a HashSet<String>.
pub fn hashset_str_len(s: Vec<String>) -> i32 {
    len(s)
}

/// Returns true if the HashSet<String> is empty.
pub fn hashset_str_is_empty(s: Vec<String>) -> bool {
    len(s) == 0
}

fn hash_map_vec_string_index_of(items: Vec<String>, value: String) -> i32 {
    let mut i: i32 = 0
    while i < len(items) {
        if eq(get_unchecked(items, i), value) {
            return i
        }
        i = i + 1
    }
    -1
}

fn hash_map_vec_string_remove_at(items: Vec<String>, index: i32) {
    let n: i32 = len(items)
    let mut i: i32 = index
    while i < n - 1 {
        set(items, i, get_unchecked(items, i + 1))
        i = i + 1
    }
    let _last: Option<String> = pop(items)
}
