//! `Trie` — a prefix tree with `String` keys and `i32` values.
//!
//! A trie (prefix tree) stores key-value pairs where keys are strings, enabling
//! prefix-based lookups: "does any key start with `P`?", "find all values
//! with prefix `P`". Common uses include autocomplete, routing tables, and
//! symbol interning.
//!
//! Implemented as a Vec-backed node pool. Each node has:
//! - 256 child slots (one per byte value), each an index into the node pool
//!   or `-1` (no child)
//! - a `has_value` flag (0 or 1)
//! - an associated `i32` value
//!
//! Construct with `Trie::new()` and use the receiver methods; the former
//! `trie_*` free functions were retired by #917 with E0100 replacement hints.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.
//!
//! ## Node pool layout
//!
//! The backing `Vec<i32>` stores:
//! ```text
//! [root_index, node_count, free_head,
//!  node_0: child_0..child_255, has_value, value,
//!  node_1: child_0..child_255, has_value, value, ...]
//! ```
//! Each node occupies `256 + 2` slots.

use std::collections::vec
const HEADER_LEN: i32 = 3
const CHILDREN_PER_NODE: i32 = 256
const NODE_SLOTS: i32 = 258   // 256 children + has_value + value
const HAS_VALUE_OFFSET: i32 = 256
const VALUE_OFFSET: i32 = 257

const NIL: i32 = 0 - 1

fn header_root(buf: Vec<i32>) -> i32 {
    buf.get_unchecked(0)
}

fn header_count(buf: Vec<i32>) -> i32 {
    buf.get_unchecked(1)
}

fn header_free(buf: Vec<i32>) -> i32 {
    buf.get_unchecked(2)
}

fn set_header_root(mut buf: Vec<i32>, val: i32) {
    set(buf, 0, val)
}

fn set_header_count(mut buf: Vec<i32>, val: i32) {
    set(buf, 1, val)
}

fn set_header_free(mut buf: Vec<i32>, val: i32) {
    set(buf, 2, val)
}

fn node_base(node: i32) -> i32 {
    HEADER_LEN + node * NODE_SLOTS
}

fn child_index(node: i32, byte: i32) -> i32 {
    node_base(node) + byte
}

fn get_child(buf: Vec<i32>, node: i32, byte: i32) -> i32 {
    buf.get_unchecked(child_index(node, byte))
}

fn set_child(mut buf: Vec<i32>, node: i32, byte: i32, val: i32) {
    set(buf, child_index(node, byte), val)
}

fn node_has_value(buf: Vec<i32>, node: i32) -> bool {
    buf.get_unchecked(node_base(node) + HAS_VALUE_OFFSET) != 0
}

fn node_value(buf: Vec<i32>, node: i32) -> i32 {
    buf.get_unchecked(node_base(node) + VALUE_OFFSET)
}

fn set_node_value(mut buf: Vec<i32>, node: i32, has_val: i32, val: i32) {
    set(buf, node_base(node) + HAS_VALUE_OFFSET, has_val)
    set(buf, node_base(node) + VALUE_OFFSET, val)
}

fn alloc_node(mut buf: Vec<i32>) -> i32 {
    let free_head = header_free(buf)
    if free_head != NIL {
        // Reuse a freed node — clear its children
        let mut b = 0
        while b < CHILDREN_PER_NODE {
            set(buf, node_base(free_head) + b, NIL)
            b = b + 1
        }
        set_node_value(buf, free_head, 0, 0)
        // Pop from free list (stored in child slot 0)
        let next_free = get_child(buf, free_head, 0)
        set_header_free(buf, next_free)
        return free_head
    }
    // Grow: append a new node
    let mut b = 0
    while b < CHILDREN_PER_NODE {
        push(buf, NIL)
        b = b + 1
    }
    push(buf, 0)  // has_value
    push(buf, 0)  // value
    let new_node = header_count(buf)
    set_header_count(buf, new_node + 1)
    new_node
}

fn count_values_in_subtree(buf: Vec<i32>, node: i32) -> i32 {
    let mut count = 0
    if node_has_value(buf, node) {
        count = 1
    }
    let mut b = 0
    while b < CHILDREN_PER_NODE {
        let child = get_child(buf, node, b)
        if child != NIL {
            count = count + count_values_in_subtree(buf, child)
        }
        b = b + 1
    }
    count
}

/// Prefix tree over `String` keys with `i32` values.
///
/// The node pool is private: use `insert`, `get`, `contains`, `has_prefix`,
/// `remove`, and `count_with_prefix`. A missing key returns `Option::None` and
/// `remove` returns `false`; `has_prefix` and `count_with_prefix` match keys,
/// not just node paths, so a stored prefix is not a key.
pub struct Trie {
    nodes: Vec<i32>,
}

impl Trie {
    /// Creates an empty trie. The root node is allocated on the first insert.
    fn new() -> Trie {
        let mut nodes: Vec<i32> = Vec::new<i32>()
        push(nodes, NIL)  // root (allocated on first insert)
        push(nodes, 0)    // node_count
        push(nodes, NIL)  // free_head
        Trie { nodes: nodes }
    }

    /// Inserts a key-value pair. An existing key is updated in place.
    fn insert(mut self: Trie, key: String, value: i32) {
        let root = header_root(self.nodes)
        let mut current = root
        if current == NIL {
            current = alloc_node(self.nodes)
            set_header_root(self.nodes, current)
        }
        let key_len = key.len()
        let mut i = 0
        while i < key_len {
            let byte = key.byte_at(i)
            let child = get_child(self.nodes, current, byte)
            if child == NIL {
                let new_node = alloc_node(self.nodes)
                set_child(self.nodes, current, byte, new_node)
                current = new_node
            } else {
                current = child
            }
            i = i + 1
        }
        set_node_value(self.nodes, current, 1, value)
    }

    /// Returns the value for `key`, or `Option::None`.
    fn get(self: Trie, key: String) -> Option<i32> {
        let root = header_root(self.nodes)
        if root == NIL {
            return Option::None
        }
        let mut current = root
        let key_len = key.len()
        let mut i = 0
        while i < key_len {
            let byte = key.byte_at(i)
            let child = get_child(self.nodes, current, byte)
            if child == NIL {
                return Option::None
            }
            current = child
            i = i + 1
        }
        if node_has_value(self.nodes, current) {
            return Option::Some(node_value(self.nodes, current))
        }
        Option::None
    }

    /// Returns true when `key` is stored.
    fn contains(self: Trie, key: String) -> bool {
        match self.get(key) {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    /// Returns true when any stored key starts with `prefix`.
    fn has_prefix(self: Trie, prefix: String) -> bool {
        let root = header_root(self.nodes)
        if root == NIL {
            return false
        }
        let mut current = root
        let prefix_len = prefix.len()
        let mut i = 0
        while i < prefix_len {
            let byte = prefix.byte_at(i)
            let child = get_child(self.nodes, current, byte)
            if child == NIL {
                return false
            }
            current = child
            i = i + 1
        }
        true
    }

    /// Removes `key` and returns true when it was present.
    ///
    /// This clears the node's value flag only; node cleanup is deferred, so
    /// removed keys leave their child path in the pool.
    fn remove(mut self: Trie, key: String) -> bool {
        let root = header_root(self.nodes)
        if root == NIL {
            return false
        }
        let mut current = root
        let key_len = key.len()
        let mut i = 0
        while i < key_len {
            let byte = key.byte_at(i)
            let child = get_child(self.nodes, current, byte)
            if child == NIL {
                return false
            }
            current = child
            i = i + 1
        }
        if node_has_value(self.nodes, current) {
            set_node_value(self.nodes, current, 0, 0)
            return true
        }
        false
    }

    /// Counts stored keys that start with `prefix`.
    ///
    /// O(n) in the size of the subtree under the prefix node.
    fn count_with_prefix(self: Trie, prefix: String) -> i32 {
        let root = header_root(self.nodes)
        if root == NIL {
            return 0
        }
        let mut current = root
        let prefix_len = prefix.len()
        let mut i = 0
        while i < prefix_len {
            let byte = prefix.byte_at(i)
            let child = get_child(self.nodes, current, byte)
            if child == NIL {
                return 0
            }
            current = child
            i = i + 1
        }
        count_values_in_subtree(self.nodes, current)
    }
}

test mod "trie" {
    test "insert_get_roundtrip" {
        let mut t = Trie::new()
        t.insert("abc", 42)
        let r = match t.get("abc") {
            Option::Some(v) => v,
            Option::None => 0 - 1,
        }
        assert(r == 42)
    }
    test "get_missing_is_none" {
        let mut t = Trie::new()
        t.insert("abc", 1)
        let r = match t.get("abd") {
            Option::Some(v) => 1,
            Option::None => 2,
        }
        assert(r == 2)
    }
    test "contains_inserted_key" {
        let mut t = Trie::new()
        t.insert("hello", 7)
        assert(t.contains("hello"))
        assert(t.contains("hell") == false)
    }
    test "shared_prefix_keys_independent" {
        let mut t = Trie::new()
        t.insert("car", 1)
        t.insert("cart", 2)
        t.insert("carton", 3)
        let r = match t.get("car") {
            Option::Some(v) => v,
            Option::None => 0 - 1,
        }
        assert(r == 1)
        assert(t.contains("carton"))
    }
    test "prefix_is_not_key" {
        let mut t = Trie::new()
        t.insert("carton", 3)
        assert(t.contains("car") == false)
        assert(t.has_prefix("car"))
    }
    test "has_prefix_absent" {
        let mut t = Trie::new()
        t.insert("dog", 1)
        assert(t.has_prefix("cat") == false)
    }
    test "remove_key" {
        let mut t = Trie::new()
        t.insert("key", 9)
        assert(t.remove("key"))
        assert(t.contains("key") == false)
    }
    test "remove_missing_returns_false" {
        let mut t = Trie::new()
        t.insert("key", 9)
        assert(t.remove("lock") == false)
    }
    test "count_with_prefix" {
        let mut t = Trie::new()
        t.insert("car", 1)
        t.insert("cart", 2)
        t.insert("dog", 3)
        assert(t.count_with_prefix("car") == 2)
        assert(t.count_with_prefix("do") == 1)
        assert(t.count_with_prefix("x") == 0)
    }
    test "count_with_prefix_full_key" {
        let mut t = Trie::new()
        t.insert("ab", 1)
        t.insert("abc", 2)
        assert(t.count_with_prefix("abc") == 1)
    }
}
