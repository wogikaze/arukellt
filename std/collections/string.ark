//! std::collections::string — String manipulation functions
//!
//! Representation-sensitive helpers go through `std::core::raw` (RFC-006).
use std::core::raw::{RawArray, RawString}
use std::prelude::{to_lowercase}
pub fn eq(a: String, b: String) -> bool {
    __core_string_eq_impl(a, b)
}

pub fn clone(s: String) -> String {
    __core_string_clone_impl(s)
}

pub fn slice(s: String, start: i32, end: i32) -> String {
    __core_string_slice_impl(s, start, end)
}

fn __core_string_len_impl(s: String) -> i32 {
    RawString::len_bytes(s)
}

fn __core_string_char_at_impl(s: String, index: i32) -> i32 {
    RawString::byte_at_unchecked(s, index)
}

fn __core_string_is_continuation_byte(byte: i32) -> bool {
    byte >= 128 && byte <= 191
}

// Returns the validated UTF-8 width at a byte boundary. Invalid input is
// represented by zero internally; public scalar APIs convert that condition to
// None or advance one replacement byte, so it never becomes a public sentinel.
fn __core_string_utf8_width_impl(s: String, index: i32) -> i32 {
    let string_len = RawString::len_bytes(s)
    if index < 0 || index >= string_len {
        return 0
    }
    let first = RawString::byte_at_unchecked(s, index)
    if first <= 127 {
        return 1
    }
    if first >= 194 && first <= 223 {
        if index + 1 >= string_len {
            return 0
        }
        if __core_string_is_continuation_byte(
            RawString::byte_at_unchecked(s, index + 1)
        ) {
            return 2
        }
        return 0
    }
    if first >= 224 && first <= 239 {
        if index + 2 >= string_len {
            return 0
        }
        let second = RawString::byte_at_unchecked(s, index + 1)
        let third = RawString::byte_at_unchecked(s, index + 2)
        if !__core_string_is_continuation_byte(second) ||
        !__core_string_is_continuation_byte(third) {
            return 0
        }
        if first == 224 && second < 160 {
            return 0
        }
        if first == 237 && second > 159 {
            return 0
        }
        return 3
    }
    if first >= 240 && first <= 244 {
        if index + 3 >= string_len {
            return 0
        }
        let second = RawString::byte_at_unchecked(s, index + 1)
        let third = RawString::byte_at_unchecked(s, index + 2)
        let fourth = RawString::byte_at_unchecked(s, index + 3)
        if !__core_string_is_continuation_byte(second) ||
        !__core_string_is_continuation_byte(third) ||
        !__core_string_is_continuation_byte(fourth) {
            return 0
        }
        if first == 240 && second < 144 {
            return 0
        }
        if first == 244 && second > 143 {
            return 0
        }
        return 4
    }
    0
}

// Byte-vector variant used by `String::from_utf8_lossy` and
// `String::try_from_utf8`. It mirrors the string helper so out-of-range
// elements stay invalid instead of being truncated by the runtime's
// byte-string constructor.
fn __core_string_utf8_width_vec_impl(bytes: Vec<i32>, index: i32) -> i32 {
    let byte_len = len(bytes)
    if index < 0 || index >= byte_len {
        return 0
    }
    let first = get_unchecked(bytes, index)
    if first < 0 || first > 255 {
        return 0
    }
    if first <= 127 {
        return 1
    }
    if first >= 194 && first <= 223 {
        if index + 1 >= byte_len {
            return 0
        }
        if __core_string_is_continuation_byte(get_unchecked(bytes, index + 1)) {
            return 2
        }
        return 0
    }
    if first >= 224 && first <= 239 {
        if index + 2 >= byte_len {
            return 0
        }
        let second = get_unchecked(bytes, index + 1)
        let third = get_unchecked(bytes, index + 2)
        if !__core_string_is_continuation_byte(second) ||
        !__core_string_is_continuation_byte(third) {
            return 0
        }
        if first == 224 && second < 160 {
            return 0
        }
        if first == 237 && second > 159 {
            return 0
        }
        return 3
    }
    if first >= 240 && first <= 244 {
        if index + 3 >= byte_len {
            return 0
        }
        let second = get_unchecked(bytes, index + 1)
        let third = get_unchecked(bytes, index + 2)
        let fourth = get_unchecked(bytes, index + 3)
        if !__core_string_is_continuation_byte(second) ||
        !__core_string_is_continuation_byte(third) ||
        !__core_string_is_continuation_byte(fourth) {
            return 0
        }
        if first == 240 && second < 144 {
            return 0
        }
        if first == 244 && second > 143 {
            return 0
        }
        return 4
    }
    0
}

fn __core_string_is_utf8_boundary_impl(s: String, index: i32) -> bool {
    let string_len = RawString::len_bytes(s)
    if index < 0 || index > string_len {
        return false
    }
    if index == 0 || index == string_len {
        return true
    }
    !__core_string_is_continuation_byte(RawString::byte_at_unchecked(s, index))
}

// The public API exposes a character, but scalar values use the same i32
// runtime representation as the compiler's character literals. Keep this
// decoder numeric so arithmetic remains explicit at the representation boundary.
fn __core_string_decode_codepoint_impl(s: String, index: i32, width: i32) -> i32 {
    let first = RawString::byte_at_unchecked(s, index)
    if width == 1 {
        return first
    }
    let second = RawString::byte_at_unchecked(s, index + 1)
    if width == 2 {
        return (first - 192) * 64 + second - 128
    }
    let third = RawString::byte_at_unchecked(s, index + 2)
    if width == 3 {
        return (first - 224) * 4096 + (second - 128) * 64 + third - 128
    }
    let fourth = RawString::byte_at_unchecked(s, index + 3)
    (first - 240) * 262144 + (second - 128) * 4096 +
    (third - 128) * 64 + fourth - 128
}

fn __core_string_char_byte_index_impl(s: String, char_index: i32) -> i32 {
    if char_index < 0 {
        return 0 - 1
    }
    let string_len = RawString::len_bytes(s)
    let mut byte_index = 0
    let mut scalar_index = 0
    while byte_index < string_len && scalar_index < char_index {
        let width = __core_string_utf8_width_impl(s, byte_index)
        if width > 0 {
            byte_index = byte_index + width
        } else {
            byte_index = byte_index + 1
        }
        scalar_index = scalar_index + 1
    }
    if scalar_index == char_index {
        return byte_index
    }
    0 - 1
}

fn __core_string_char_len_impl(s: String) -> i32 {
    let string_len = RawString::len_bytes(s)
    let mut byte_index = 0
    let mut count = 0
    while byte_index < string_len {
        let width = __core_string_utf8_width_impl(s, byte_index)
        if width > 0 {
            byte_index = byte_index + width
        } else {
            byte_index = byte_index + 1
        }
        count = count + 1
    }
    count
}

fn __core_string_codepoint_at_impl(s: String, char_index: i32) -> Option<char> {
    let byte_index = __core_string_char_byte_index_impl(s, char_index)
    let string_len = RawString::len_bytes(s)
    if byte_index < 0 || byte_index >= string_len {
        return None
    }
    let width = __core_string_utf8_width_impl(s, byte_index)
    if width == 0 {
        return None
    }
    Some(__core_string_decode_codepoint_impl(s, byte_index, width))
}

fn __core_string_try_slice_bytes_impl(s: String, start: i32, end: i32) -> Option<String> {
    let string_len = RawString::len_bytes(s)
    if start < 0 || end < start || end > string_len {
        return None
    }
    if !__core_string_is_utf8_boundary_impl(s, start) ||
    !__core_string_is_utf8_boundary_impl(s, end) {
        return None
    }
    Some(__core_string_slice_impl(s, start, end))
}

fn __core_string_slice_chars_impl(s: String, start: i32, end: i32) -> String {
    if start < 0 || end < start {
        return RawString::new()
    }
    let byte_start = __core_string_char_byte_index_impl(s, start)
    let byte_end = __core_string_char_byte_index_impl(s, end)
    if byte_start < 0 || byte_end < 0 {
        return RawString::new()
    }
    __core_string_slice_impl(s, byte_start, byte_end)
}

fn __core_string_try_slice_chars_impl(s: String, start: i32, end: i32) -> Option<String> {
    if start < 0 || end < start {
        return None
    }
    let byte_start = __core_string_char_byte_index_impl(s, start)
    let byte_end = __core_string_char_byte_index_impl(s, end)
    if byte_start < 0 || byte_end < 0 {
        return None
    }
    Some(__core_string_slice_impl(s, byte_start, byte_end))
}

fn __core_string_new_impl() -> String {
    RawString::new()
}

fn __core_string_clone_impl(s: String) -> String {
    RawString::clone(s)
}

fn __core_string_from_bytes_impl(bytes: Vec<i32>) -> String {
    RawString::from_bytes(bytes)
}

fn __core_string_len_bytes_impl(s: String) -> i32 {
    RawString::len_bytes(s)
}

fn __core_string_is_empty_impl(s: String) -> bool {
    RawString::len_bytes(s) == 0
}

fn __core_string_eq_impl(a: String, b: String) -> bool {
    let string_len = RawString::len_bytes(a)
    if string_len != RawString::len_bytes(b) {
        return false
    }
    let mut index = 0
    while index < string_len {
        if RawString::byte_at_unchecked(a, index) !=
        RawString::byte_at_unchecked(b, index) {
            return false
        }
        index = index + 1
    }
    true
}

fn __core_string_push_range(mut bytes: Vec<i32>, s: String, start: i32, end: i32) {
    let mut index = start
    while index < end {
        // Concrete i32 push CoreOp body (generic Vec<T> push is unreachable on LM).
        push(bytes, RawString::byte_at_unchecked(s, index))
        index = index + 1
    }
}

fn __core_string_push_byte(mut bytes: Vec<i32>, byte: i32) {
    push(bytes, byte)
}

fn __core_string_slice_impl(s: String, start: i32, end: i32) -> String {
    let string_len = RawString::len_bytes(s)
    if start < 0 || end < start || end > string_len {
        return RawString::new()
    }
    let mut bytes = RawArray::new<i32>(end - start)
    __core_string_push_range(bytes, s, start, end)
    RawString::from_bytes(bytes)
}

fn __core_string_concat_impl(a: String, b: String) -> String {
    let a_len = RawString::len_bytes(a)
    let b_len = RawString::len_bytes(b)
    let mut bytes = RawArray::new<i32>(a_len + b_len)
    __core_string_push_range(bytes, a, 0, a_len)
    __core_string_push_range(bytes, b, 0, b_len)
    RawString::from_bytes(bytes)
}

fn __core_string_ascii_case_impl(s: String, to_lowercase: bool) -> String {
    let string_len = RawString::len_bytes(s)
    let mut bytes = RawArray::new<i32>(string_len)
    let mut index = 0
    while index < string_len {
        let mut byte = RawString::byte_at_unchecked(s, index)
        if to_lowercase && byte >= 65 && byte <= 90 {
            byte = byte + 32
        }
        if !to_lowercase && byte >= 97 && byte <= 122 {
            byte = byte - 32
        }
        push(bytes, byte)
        index = index + 1
    }
    RawString::from_bytes(bytes)
}

fn __core_string_to_lowercase_impl(s: String) -> String {
    __core_string_ascii_case_impl(s, true)
}

fn __core_string_to_uppercase_impl(s: String) -> String {
    __core_string_ascii_case_impl(s, false)
}

fn __core_string_is_ascii_whitespace(byte: i32) -> bool {
    byte == 32 || byte == 9 || byte == 10 || byte == 13
}

fn __core_string_trim_start_index(s: String) -> i32 {
    let string_len = RawString::len_bytes(s)
    let mut index = 0
    while index < string_len {
        if !__core_string_is_ascii_whitespace(RawString::byte_at_unchecked(s, index)) {
            return index
        }
        index = index + 1
    }
    string_len
}

fn __core_string_trim_end_index(s: String) -> i32 {
    let mut index = RawString::len_bytes(s)
    while index > 0 {
        if !__core_string_is_ascii_whitespace(RawString::byte_at_unchecked(s, index - 1)) {
            return index
        }
        index = index - 1
    }
    0
}

fn __core_string_trim_start_impl(s: String) -> String {
    __core_string_slice_impl(s, __core_string_trim_start_index(s), RawString::len_bytes(s))
}

fn __core_string_trim_end_impl(s: String) -> String {
    __core_string_slice_impl(s, 0, __core_string_trim_end_index(s))
}

fn __core_string_trim_impl(s: String) -> String {
    __core_string_slice_impl(s, __core_string_trim_start_index(s), __core_string_trim_end_index(s))
}

fn __core_string_repeat_impl(s: String, count: i32) -> String {
    if count <= 0 {
        return RawString::new()
    }
    let string_len = RawString::len_bytes(s)
    let mut bytes = RawArray::new<i32>(string_len * count)
    let mut repetition = 0
    while repetition < count {
        __core_string_push_range(bytes, s, 0, string_len)
        repetition = repetition + 1
    }
    RawString::from_bytes(bytes)
}

fn __core_string_pad_left_impl(s: String, width: i32) -> String {
    __core_string_pad_left_fill_impl(s, width, " ")
}

fn __core_string_pad_right_impl(s: String, width: i32) -> String {
    __core_string_pad_right_fill_impl(s, width, " ")
}

fn __core_string_pad_left_fill_impl(s: String, width: i32, fill: String) -> String {
    let string_len = RawString::len_bytes(s)
    if string_len >= width {
        return s
    }
    let padding = __core_string_repeat_impl(fill, width - string_len)
    let padded = __core_string_concat_impl(padding, s)
    let padded_len = RawString::len_bytes(padded)
    __core_string_slice_impl(padded, padded_len - width, padded_len)
}

fn __core_string_pad_right_fill_impl(s: String, width: i32, fill: String) -> String {
    let string_len = RawString::len_bytes(s)
    if string_len >= width {
        return s
    }
    let padding = __core_string_repeat_impl(fill, width - string_len)
    __core_string_slice_impl(__core_string_concat_impl(s, padding), 0, width)
}

fn __core_string_replace_impl(s: String, from: String, replacement: String) -> String {
    let string_len = RawString::len_bytes(s)
    let pattern_len = RawString::len_bytes(from)
    if pattern_len == 0 {
        return __core_string_slice_impl(s, 0, string_len)
    }
    let replacement_len = RawString::len_bytes(replacement)
    let mut bytes = RawArray::new<i32>(string_len)
    let mut index = 0
    while index < string_len {
        if index + pattern_len <= string_len && __core_string_region_matches(s, from, index) {
            __core_string_push_range(bytes, replacement, 0, replacement_len)
            index = index + pattern_len
        } else {
            __core_string_push_byte(bytes, RawString::byte_at_unchecked(s, index))
            index = index + 1
        }
    }
    RawString::from_bytes(bytes)
}

fn __core_string_push_part(parts: Vec<String>, part: String) {
    // Avoid generic push shell: use the free CoreOp aliases, not the sealed
    // raw namespace wrappers.
    let n: i32 = raw_array_len(parts)
    let mut grown: Vec<String> = raw_array_grow(parts, n + 1)
    raw_array_set_unchecked(grown, n, part)
}

fn __core_string_split_impl(s: String, delimiter: String) -> Vec<String> {
    let parts = Vec::new<String>()
    let string_len = RawString::len_bytes(s)
    let delimiter_len = RawString::len_bytes(delimiter)
    if delimiter_len == 0 {
        // Empty haystack + empty delimiter → one empty part (chars(""), split("","")).
        if string_len == 0 {
            __core_string_push_part(parts, __core_string_slice_impl(s, 0, 0))
            return parts
        }
        let mut index = 0
        while index < string_len {
            __core_string_push_part(parts, __core_string_slice_impl(s, index, index + 1))
            index = index + 1
        }
        return parts
    }
    let mut part_start = 0
    let mut index = 0
    while index + delimiter_len <= string_len {
        if __core_string_region_matches(s, delimiter, index) {
            __core_string_push_part(parts, __core_string_slice_impl(s, part_start, index))
            index = index + delimiter_len
            part_start = index
        } else {
            index = index + 1
        }
    }
    __core_string_push_part(parts, __core_string_slice_impl(s, part_start, string_len))
    parts
}

fn __core_string_join_impl(parts: Vec<String>, separator: String) -> String {
    // Avoid __core_string_push_range: mixed GC-ref/i32 params scramble MIR
    // locals on wasm32-gc and trap mid-join (#807). concat is intrinsic-backed.
    let part_count = len(parts)
    if part_count == 0 {
        return String_from("")
    }
    let mut out = get_unchecked(parts, 0)
    let mut index = 1
    while index < part_count {
        out = concat(out, separator)
        out = concat(out, get_unchecked(parts, index))
        index = index + 1
    }
    out
}

fn __core_string_lines_impl(s: String) -> Vec<String> {
    __core_string_split_impl(__core_string_replace_impl(s, "\r\n", "\n"), "\n")
}

fn __core_string_chars_impl(s: String) -> Vec<String> {
    let parts = Vec::new<String>()
    let string_len = RawString::len_bytes(s)
    if string_len == 0 {
        __core_string_push_part(parts, __core_string_slice_impl(s, 0, 0))
        return parts
    }
    let mut byte_index = 0
    while byte_index < string_len {
        let width = __core_string_utf8_width_impl(s, byte_index)
        let scalar_width = if width > 0 { width } else { 1 }
        __core_string_push_part(parts, __core_string_slice_impl(
                s, byte_index, byte_index + scalar_width
            ))
        byte_index = byte_index + scalar_width
    }
    parts
}

fn __core_string_region_matches(s: String, needle: String, start: i32) -> bool {
    let needle_len = RawString::len_bytes(needle)
    let mut index = 0
    while index < needle_len {
        if RawString::byte_at_unchecked(s, start + index) !=
        RawString::byte_at_unchecked(needle, index) {
            return false
        }
        index = index + 1
    }
    true
}

fn __core_string_starts_with_impl(s: String, prefix: String) -> bool {
    if RawString::len_bytes(prefix) > RawString::len_bytes(s) {
        return false
    }
    __core_string_region_matches(s, prefix, 0)
}

fn __core_string_ends_with_impl(s: String, suffix: String) -> bool {
    if RawString::len_bytes(suffix) > RawString::len_bytes(s) {
        return false
    }
    __core_string_region_matches(
        s,
        suffix,
        RawString::len_bytes(s) - RawString::len_bytes(suffix)
    )
}

fn __core_string_index_of_impl(s: String, needle: String) -> i32 {
    let string_len = RawString::len_bytes(s)
    let needle_len = RawString::len_bytes(needle)
    if needle_len == 0 {
        return 0
    }
    if needle_len > string_len {
        return 0 - 1
    }
    let mut index = 0
    while index <= string_len - needle_len {
        if __core_string_region_matches(s, needle, index) {
            return index
        }
        index = index + 1
    }
    0 - 1
}

fn __core_string_contains_impl(s: String, needle: String) -> bool {
    __core_string_index_of_impl(s, needle) >= 0
}

pub fn starts_with(s: String, prefix: String) -> bool {
    __core_string_starts_with_impl(s, prefix)
}

pub fn ends_with(s: String, suffix: String) -> bool {
    __core_string_ends_with_impl(s, suffix)
}

pub fn index_of(s: String, needle: String) -> i32 {
    __core_string_index_of_impl(s, needle)
}

pub fn contains(s: String, needle: String) -> bool {
    __core_string_contains_impl(s, needle)
}

pub fn to_lower(s: String) -> String {
    __core_string_to_lowercase_impl(s)
}

pub fn to_upper(s: String) -> String {
    __core_string_to_uppercase_impl(s)
}

pub fn trim(s: String) -> String {
    __core_string_trim_impl(s)
}

pub fn trim_start(s: String) -> String {
    __core_string_trim_start_impl(s)
}

pub fn trim_end(s: String) -> String {
    __core_string_trim_end_impl(s)
}

pub fn repeat(s: String, count: i32) -> String {
    __core_string_repeat_impl(s, count)
}

pub fn pad_left(s: String, width: i32) -> String {
    __core_string_pad_left_impl(s, width)
}

pub fn pad_right(s: String, width: i32) -> String {
    __core_string_pad_right_impl(s, width)
}

pub fn replace(s: String, from: String, replacement: String) -> String {
    __core_string_replace_impl(s, from, replacement)
}

pub fn split(s: String, delim: String) -> Vec<String> {
    __core_string_split_impl(s, delim)
}

pub fn join(parts: Vec<String>, sep: String) -> String {
    __core_string_join_impl(parts, sep)
}

pub fn lines(s: String) -> Vec<String> {
    __core_string_lines_impl(s)
}

pub fn byte_at(s: String, index: i32) -> i32 {
    __core_string_char_at_impl(s, index)
}

pub fn push_char(mut s: String, c: char) {
    __intrinsic_push_char(s, c)
}

// ---------------------------------------------------------------------------
// Inherent impl blocks for String — method syntax (approach (a) for #700).
// ---------------------------------------------------------------------------

/// Inherent methods on `String` — method-syntax wrappers around intrinsics.
impl String {

    /// Decodes `bytes` as UTF-8, replacing each invalid sequence with U+FFFD.
    fn from_utf8_lossy(bytes: Vec<i32>) -> String {
        let mut result = Vec::new<i32>()
        let byte_len = len(bytes)
        let mut index = 0
        while index < byte_len {
            let width = __core_string_utf8_width_vec_impl(bytes, index)
            if width == 0 {
                push(result, 239)
                push(result, 191)
                push(result, 189)
                index = index + 1
            } else {
                let mut offset = 0
                while offset < width {
                    push(result, get_unchecked(bytes, index + offset))
                    offset = offset + 1
                }
                index = index + width
            }
        }
        __intrinsic_string_from_bytes(result)
    }

    /// Decodes `bytes` as UTF-8 and returns `None` when the input is invalid.
    fn try_from_utf8(bytes: Vec<i32>) -> Option<String> {
        let mut result = Vec::new<i32>()
        let byte_len = len(bytes)
        let mut index = 0
        while index < byte_len {
            let width = __core_string_utf8_width_vec_impl(bytes, index)
            if width == 0 {
                return None
            }
            let mut offset = 0
            while offset < width {
                push(result, get_unchecked(bytes, index + offset))
                offset = offset + 1
            }
            index = index + width
        }
        Some(__intrinsic_string_from_bytes(result))
    }

    /// Returns the length of the string in bytes.
    fn len(self: String) -> i32 {
        __core_string_len_impl(self)
    }

    /// Returns the length of the string in bytes.
    fn len_bytes(self: String) -> i32 {
        __core_string_len_bytes_impl(self)
    }

    /// Byte-order key shared by the String ordering operators and Ord::cmp.
    /// Returns -1 (self < other), 0 (equal), or 1 (self > other). The `__`
