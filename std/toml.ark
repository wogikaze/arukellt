//! TOML streaming scanner utilities for `std::toml`.
//!
//! The text-scanning surface is the `TomlText` namespace (`parse_line`,
//! `find_section`, `find_value`, `find_raw_value`, `parse_string_array`) used
//! by the compiler's manifest/script/project parsers (#917, ADR-046). The DOM
//! with `pub enum TomlValue` lives in `std/toml/parser.ark` (re-exported as
//! `std::toml`) to avoid the bootstrap compiler stubbing the entire module; the
//! document entry points are `TomlValue::parse` and `v.to_text()`.

use std::prelude::{byte_at, clone, eq, slice, substring}
use std::text
/// Filter a single TOML source line: returns the line unchanged for key=value
/// lines and returns `""` for comments and blank lines.
fn toml_text_parse_line(line: String) -> String {
    let n: i32 = len(line)
    if n == 0 {
        ""
    } else {
        let first: String = slice(line, 0, 1)
        if eq(first, "#") {
            ""
        } else {
            line
        }
    }
}

/// Extract the body of a TOML section `[section]` from `content`.
/// Returns the text between the section header and the next section header
/// (or end of content).  Returns an empty string if the section is not found.
fn toml_text_find_section(content: String, section: String) -> String {
    let section_header = (String_from("[")).concat(clone(section).concat(String_from("]")))
    let header_len = len(section_header)
    let content_len = len(content)
    let mut i = 0
    while i < content_len {
        if i == 0 || byte_at(content, i - 1) == 10 {
            let j_max = content_len - i
            let match_len = if header_len < j_max { header_len } else { j_max }
            let mut j = 0
            while j < match_len && byte_at(content, i + j) == byte_at(section_header, j) {
                j = j + 1
            }
            if j == header_len && (i + j >= content_len || byte_at(content, i + j) == 10) {
                let section_start = i + j
                if section_start >= content_len {
                    return String_new()
                }
                let body_start = if byte_at(content, section_start) == 10 { section_start + 1 } else { section_start }
                let mut k = body_start
                while k < content_len {
                    if byte_at(content, k) == 10 && k + 1 < content_len && byte_at(content, k + 1) == 91 {
                        return substring(content, body_start, k)
                    }
                    k = k + 1
                }
                return substring(content, body_start, content_len)
            }
        }
        i = i + 1
    }
    String_new()
}

/// Extract the string value of `key = "value"` from a TOML content block.
/// Scans line-by-line for a line starting with `key` followed by optional
/// whitespace, `=`, optional whitespace, and a double-quoted string.
/// Returns the unquoted string value, or an empty string if not found.
fn toml_text_find_value(content: String, key: String) -> String {
    let content_len = len(content)
    let key_len = len(key)
    let mut line_start = 0
    let mut i = 0
    while i < content_len {
        if byte_at(content, i) == 10 || i == content_len - 1 {
            let line_end = if byte_at(content, i) == 10 { i } else { i + 1 }
            let line = substring(content, line_start, line_end)
            let line_len = len(line)
            if line_len > key_len + 3 {
                if eq(substring(line, 0, key_len), clone(key)) {
                    let mut j = key_len
                    while j < line_len && byte_at(line, j) == 32 { j = j + 1 }
                    if j < line_len && byte_at(line, j) == 61 {
                        j = j + 1
                        while j < line_len && byte_at(line, j) == 32 { j = j + 1 }
                        if j < line_len && byte_at(line, j) == 34 {
                            let val_start = j + 1
                            let mut k = val_start
                            while k < line_len && byte_at(line, k) != 34 { k = k + 1 }
                            return substring(line, val_start, k)
                        }
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    String_new()
}

/// Extract the raw value text after `key =` from a TOML content block.
/// Unlike `toml_text_find_value` (quoted strings only), this returns the remainder
/// of the line so array values like `["W0006", "unused-import"]` can be parsed.
fn toml_text_find_raw_value(content: String, key: String) -> String {
    let content_len = len(content)
    let key_len = len(key)
    let mut line_start = 0
    let mut i = 0
    while i < content_len {
        if byte_at(content, i) == 10 || i == content_len - 1 {
            let line_end = if byte_at(content, i) == 10 { i } else { i + 1 }
            let line = substring(content, line_start, line_end)
            let line_len = len(line)
            if line_len > key_len + 3 {
                if eq(substring(line, 0, key_len), clone(key)) {
                    let mut j = key_len
                    while j < line_len && byte_at(line, j) == 32 { j = j + 1 }
                    if j < line_len && byte_at(line, j) == 61 {
                        j = j + 1
                        while j < line_len && byte_at(line, j) == 32 { j = j + 1 }
                        return substring(line, j, line_len)
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    String_new()
}

/// Parse a TOML array string like `["W0006", "unused-import"]` into a Vec<String>.
fn toml_text_parse_string_array(raw: String) -> Vec<String> {
    let result = Vec::new<String>()
    let raw_len = len(raw)
    if raw_len == 0 {
        return result
    }
    let mut i = 0
    while i < raw_len && byte_at(raw, i) == 32 { i = i + 1 }
    if i >= raw_len || byte_at(raw, i) != 91 {
        return result
    }
    i = i + 1
    while i < raw_len {
        while i < raw_len && (byte_at(raw, i) == 32 || byte_at(raw, i) == 44) { i = i + 1 }
        if i >= raw_len || byte_at(raw, i) == 93 {
            return result
        }
        if byte_at(raw, i) != 34 {
            i = i + 1
            continue
        }
        i = i + 1
        let start = i
        while i < raw_len && byte_at(raw, i) != 34 { i = i + 1 }
        push(result, substring(raw, start, i))
        if i < raw_len { i = i + 1 }
    }
    result
}

// ─── Re-exports from std/toml/parser.ark ────────────────────────────────────
// The DOM types and their associated functions live in std/toml/parser.ark and
// are re-exported by the pub use below, so callers spell the document entry
// points as `TomlValue::parse` and `v.to_text()` (#917, ADR-046).

/// Namespace for TOML text scanning helpers.
pub struct TomlText {}

impl TomlText {
    /// Filter one TOML source line; comments and blank lines become "".
    fn parse_line(line: String) -> String {
        toml_text_parse_line(line)
    }

    /// Extract the body of `[section]` from raw TOML text.
    fn find_section(content: String, section: String) -> String {
        toml_text_find_section(content, section)
    }

    /// Extract a quoted string value for `key = "..."` from raw TOML text.
    fn find_value(content: String, key: String) -> String {
        toml_text_find_value(content, key)
    }

    /// Extract the raw text after `key =` (arrays and unquoted values).
    fn find_raw_value(content: String, key: String) -> String {
        toml_text_find_raw_value(content, key)
    }

    /// Parse a TOML string-array literal into its element strings.
    fn parse_string_array(raw: String) -> Vec<String> {
        toml_text_parse_string_array(raw)
    }
}

pub use std::toml::parser
