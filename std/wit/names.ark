//! WIT naming helpers (#706).
//!
//! Shared naming helpers used by both `std::wit` and the compiler's
//! component-model layer.  These convert between the kebab-case names
//! used in WIT source text and the snake_case / PascalCase identifiers
//! used in Arukellt surface syntax.
//!
//! `WitName` is an empty namespace type: ADR-046 forbids user-reachable
//! free functions and the language cannot put associated functions in a
//! module namespace, so the helpers are called as `WitName::to_kebab(name)`
//! (#917).
//!
//! - `WitName::to_kebab` — snake_case / PascalCase → kebab-case
//! - `WitName::to_snake` — kebab-case → snake_case
//! - `WitName::to_pascal` — kebab-case / snake_case → PascalCase

use std::text

/// Namespace for WIT identifier case conversion.
pub struct WitName {}

impl WitName {
    /// Convert an Arukellt identifier (snake_case or PascalCase) to WIT
    /// kebab-case.
    ///
    /// Examples:
    ///   `my_func`   → `my-func`
    ///   `MyFunc`    → `my-func`
    ///   `myFunc`    → `my-func`
    ///   `my-func`   → `my-func` (already kebab)
    fn to_kebab(name: String) -> String {
        let mut out = String_from("")
        let n = name.len()
        let mut i = 0
        while i < n {
            let ch = name.byte_at(i)
            if ch == 95 {
                // underscore → hyphen
                out = String::concat(out, String_from("-"))
            } else if ch >= 65 && ch <= 90 {
                // A-Z: insert hyphen before (unless at start or previous is hyphen)
                if out.len() > 0 {
                    let prev = out.byte_at(out.len() - 1)
                    if prev != 45 {
                        out = String::concat(out, String_from("-"))
                    }
                }
                out = String::concat(out, char_to_string(ch + 32))
            } else if ch == 45 {
                // already a hyphen
                out = String::concat(out, String_from("-"))
            } else {
                out = String::concat(out, name.slice(i, i + 1))
            }
            i = i + 1
        }
        out
    }

    /// Convert a WIT kebab-case name to Arukellt snake_case.
    ///
    /// Examples:
    ///   `my-func`   → `my_func`
    ///   `parse-markdown` → `parse_markdown`
    fn to_snake(name: String) -> String {
        let mut out = String_from("")
        let n = name.len()
        let mut i = 0
        while i < n {
            let ch = name.byte_at(i)
            if ch == 45 {
                out = String::concat(out, String_from("_"))
            } else {
                out = String::concat(out, name.slice(i, i + 1))
            }
            i = i + 1
        }
        out
    }

    /// Convert a kebab-case or snake_case name to PascalCase.
    ///
    /// Examples:
    ///   `my-func`   → `MyFunc`
    ///   `my_func`   → `MyFunc`
    ///   `document`  → `Document`
    fn to_pascal(name: String) -> String {
        let mut out = String_from("")
        let n = name.len()
        let mut i = 0
        let mut capitalize_next = true
        while i < n {
            let ch = name.byte_at(i)
            if ch == 45 || ch == 95 {
                capitalize_next = true
            } else if capitalize_next {
                if ch >= 97 && ch <= 122 {
                    out = String::concat(out, char_to_string(ch - 32))
                } else {
                    out = String::concat(out, name.slice(i, i + 1))
                }
                capitalize_next = false
            } else {
                out = String::concat(out, name.slice(i, i + 1))
            }
            i = i + 1
        }
        out
    }

    /// Capitalize the first letter of a name (used for record/enum type names).
    /// This is a simpler form of `to_pascal` that only uppercases the first
    /// character without changing word boundaries.
    ///
    /// Examples:
    ///   `document`  → `Document`
    ///   `Document`  → `Document`
    fn capitalize(name: String) -> String {
        if name.len() == 0 {
            return String_new()
        }
        let first = name.byte_at(0)
        if first >= 97 && first <= 122 {
            String::concat(char_to_string(first - 32), name.slice(1, name.len()))
        } else {
            name.clone()
        }
    }
}
