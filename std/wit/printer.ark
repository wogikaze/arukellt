//! WIT text printer (#044 subset).
//!
//! The printer surface follows ADR-044/ADR-046: `World::to_wit`,
//! `Interface::to_wit`, and `WitFunc::to_wit` are receiver methods.
//! `WitType::wit_text` owns the type rendering, so the printer no longer
//! duplicates that match (#917).

use std::wit::types
use std::wit::world::{Interface, WitFunc, World}
use std::text

impl WitFunc {
    /// Render one function member line of an interface body.
    fn to_wit(self: WitFunc) -> String {
        let mut line = String::concat("  ", String::concat(self.name, ": func("))
        let n = self.params.len()
        let mut i = 0
        while i < n {
            let param = get_unchecked(self.params, i)
            if i > 0 {
                line = String::concat(line, ", ")
            }
            let param_ty = param.ty
            line = String::concat(line, String::concat(param.name, String::concat(": ", param_ty.wit_text())))
            i = i + 1
        }
        line = String::concat(line, ")")
        let result: Option<types::WitType> = self.result
        match result {
            Option::Some(ret) => String::concat(line, String::concat(" -> ", ret.wit_text())),
            None => line,
        }
    }
}

impl Interface {
    /// Render an interface block with the given `import` / `export` keyword.
    fn to_wit(self: Interface, kind: String) -> String {
        let mut out = String::concat(kind, String::concat(" ", String::concat(self.name, " {\n")))
        let n = self.functions.len()
        let mut i = 0
        while i < n {
            let func = get_unchecked(self.functions, i)
            out = String::concat(out, String::concat(func.to_wit(), "\n"))
            i = i + 1
        }
        String::concat(out, "}\n")
    }
}

impl World {
    /// Render the world and its imported / exported interfaces.
    fn to_wit(self: World) -> String {
        let mut out = String::concat("world ", String::concat(self.name, " {\n"))
        let import_count = self.imports.len()
        let mut i = 0
        while i < import_count {
            let iface = get_unchecked(self.imports, i)
            out = String::concat(out, iface.to_wit(String_from("import")))
            i = i + 1
        }
        let export_count = self.exports.len()
        i = 0
        while i < export_count {
            let iface = get_unchecked(self.exports, i)
            out = String::concat(out, iface.to_wit(String_from("export")))
            i = i + 1
        }
        String::concat(out, "}\n")
    }
}
