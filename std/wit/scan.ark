//! WIT text scan utilities (#706).
//!
//! Low-level WIT text scanning helpers shared between the WIT parser
//! and the compiler's `wit_parse_text_scan` module. `WitText` is an empty
//! namespace type: ADR-046 forbids user-reachable free functions and the
//! language cannot put associated functions in a module namespace, so the
//! helpers are called as `WitText::trim(s)` (#917).
//!
//! This module is intentionally kept free of `std::wit::types` dependencies
//! so it can be loaded by the bootstrap compiler without overflowing the
//! call stack.

/// Namespace for WIT text scanning helpers.
pub struct WitText {}

impl WitText {
    /// Find character `ch` in `s` starting at offset `from`.  Returns -1 if
    /// not found.
    fn find_char(s: String, ch: i32, from: i32) -> i32 {
        let n = len(s)
        let mut i = from
        while i < n {
            if s.byte_at(i) == ch {
                return i
            }
            i = i + 1
        }
        0 - 1
    }

    /// Trim leading and trailing ASCII whitespace from `s`.
    fn trim(s: String) -> String {
        let n = len(s)
        let mut start = 0
        while start < n {
            let ch = s.byte_at(start)
            if ch != 32 && ch != 9 && ch != 13 && ch != 10 {
                break
            }
            start = start + 1
        }
        let mut end = n
        while end > start {
            let ch = s.byte_at(end - 1)
            if ch != 32 && ch != 9 && ch != 13 && ch != 10 {
                break
            }
            end = end - 1
        }
        s.slice(start, end)
    }

    /// Strip a `@version` suffix from a package path.
    fn strip_version(pkg: String) -> String {
        let at = WitText::find_char(pkg, 64, 0)
        if at < 0 {
            return pkg.clone()
        }
        pkg.slice(0, at)
    }

    /// Return the trimmed substring before the first colon in `s`.
    fn before_colon(s: String) -> String {
        let colon = WitText::find_char(s, 58, 0)
        if colon < 0 {
            return WitText::trim(s)
        }
        WitText::trim(s.slice(0, colon))
    }

    /// Return the trimmed substring after the first colon in `param`.
    fn split_param(param: String) -> String {
        let colon = WitText::find_char(param, 58, 0)
        if colon < 0 {
            return WitText::trim(param)
        }
        WitText::trim(param.slice(colon + 1, len(param)))
    }

    /// Split `inner` on top-level commas (tracking `<`/`>` nesting) into a
    /// `Vec<String>` of trimmed items.
    fn split_csv_items(inner: String) -> Vec<String> {
        let mut items = Vec::new<String>()
        let n = len(inner)
        let mut start = 0
        let mut depth = 0
        let mut i = 0
        while i < n {
            let ch = inner.byte_at(i)
            if ch == 60 {
                depth = depth + 1
            }
            if ch == 62 {
                depth = depth - 1
            }
            if ch == 44 && depth == 0 {
                push(items, WitText::trim(inner.slice(start, i)))
                start = i + 1
            }
            i = i + 1
        }
        if start < n {
            push(items, WitText::trim(inner.slice(start, n)))
        }
        items
    }

    /// Return the offset of the start of the line containing `pos`.
    fn line_start(text: String, pos: i32) -> i32 {
        let mut i = pos
        while i > 0 {
            if text.byte_at(i - 1) == 10 {
                return i
            }
            i = i - 1
        }
        0
    }

    /// Return the offset of the end of the line containing `pos` (exclusive).
    fn line_end(text: String, pos: i32) -> i32 {
        let n = len(text)
        let mut i = pos
        while i < n {
            if text.byte_at(i) == 10 {
                return i
            }
            i = i + 1
        }
        n
    }
}
