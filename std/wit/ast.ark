//! WIT AST node types and full WIT 1.0 text parser (#706).
//!
//! This module provides a recursive-descent parser for WIT 1.0 text
//! syntax covering: package, world, interface, record, enum, flags,
//! variant, resource, own/borrow, type aliases, use, and func
//! declarations.
//!
//! The parser produces a `WitNode` tree that can be inspected with
//! `WitNode::kind`, `WitNode::name`, and other accessor methods.

use std::wit::types
use std::wit::types::{WitType}
use std::prelude::{byte_at, clone, eq, index_of, slice, substring, values}
use std::text

// ─── AST node type ───────────────────────────────────────────────

/// A node in the parsed WIT AST.
pub enum WitNode {
    Package(String, Vec<WitNode>),
    World(String, Vec<WitNode>),
    Interface(String, Vec<WitNode>),
    Record(String, Vec<types::WitField>),
    Enum(String, Vec<String>),
    Flags(String, Vec<String>),
    Variant(String, Vec<types::WitVariantCase>),
    Resource(String, Vec<types::WitField>),
    TypeAlias(String, types::WitType),
    Use(String, String),
    Func(String, Vec<types::WitParam>, Option<types::WitType>),
    Import(String, String),
    Export(String, String),
    Error(String),
}

// ─── AST accessors ───────────────────────────────────────────────

impl WitNode {
    /// Return the kind string of this node (e.g. `"world"`, `"record"`).
    fn kind(self: WitNode) -> String {
        match self {
            WitNode::Package(_, _) => "package",
            WitNode::World(_, _) => "world",
            WitNode::Interface(_, _) => "interface",
            WitNode::Record(_, _) => "record",
            WitNode::Enum(_, _) => "enum",
            WitNode::Flags(_, _) => "flags",
            WitNode::Variant(_, _) => "variant",
            WitNode::Resource(_, _) => "resource",
            WitNode::TypeAlias(_, _) => "type",
            WitNode::Use(_, _) => "use",
            WitNode::Func(_, _, _) => "func",
            WitNode::Import(_, _) => "import",
            WitNode::Export(_, _) => "export",
            WitNode::Error(_) => "error",
        }
    }

    /// Return the name string of this node.
    fn name(self: WitNode) -> String {
        match self {
            WitNode::Package(name, _) => clone(name),
            WitNode::World(name, _) => clone(name),
            WitNode::Interface(name, _) => clone(name),
            WitNode::Record(name, _) => clone(name),
            WitNode::Enum(name, _) => clone(name),
            WitNode::Flags(name, _) => clone(name),
            WitNode::Variant(name, _) => clone(name),
            WitNode::Resource(name, _) => clone(name),
            WitNode::TypeAlias(name, _) => clone(name),
            WitNode::Use(path, _) => clone(path),
            WitNode::Func(name, _, _) => clone(name),
            WitNode::Import(path, _) => clone(path),
            WitNode::Export(path, _) => clone(path),
            WitNode::Error(msg) => clone(msg),
        }
    }

    /// Return the number of child items in a container node
    /// (package, world, interface).  Returns 0 for leaf nodes.
    fn child_count(self: WitNode) -> i32 {
        match self {
            WitNode::Package(_, items) => len(items),
            WitNode::World(_, items) => len(items),
            WitNode::Interface(_, items) => len(items),
            WitNode::Record(_, fields) => len(fields),
            WitNode::Enum(_, variants) => len(variants),
            WitNode::Flags(_, members) => len(members),
            WitNode::Variant(_, cases) => len(cases),
            WitNode::Resource(_, fields) => len(fields),
            WitNode::Func(_, params, _) => len(params),
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => 0,
        }
    }

    /// Return the child `WitNode` at `index` for container nodes
    /// (package, world, interface).  Returns `WitNode::Error` on out-of-bounds.
    fn child_at(self: WitNode, index: i32) -> WitNode {
        match self {
            WitNode::Package(_, items) => {
                if index < 0 || index >= len(items) {
                    WitNode::Error(String_from("child_at: index out of bounds"))
                } else {
                    get_unchecked(items, index)
                }
            },
            WitNode::World(_, items) => {
                if index < 0 || index >= len(items) {
                    WitNode::Error(String_from("child_at: index out of bounds"))
                } else {
                    get_unchecked(items, index)
                }
            },
            WitNode::Interface(_, items) => {
                if index < 0 || index >= len(items) {
                    WitNode::Error(String_from("child_at: index out of bounds"))
                } else {
                    get_unchecked(items, index)
                }
            },
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => WitNode::Error(String_from("child_at: not a container node")),
        }
    }

    /// Return the first interface name reachable from a package or world node.
    /// This keeps traversal in the AST module without exposing a recursive enum
    /// value to callers that only need metadata.
    fn first_interface_name(self: WitNode) -> String {
        match self {
            WitNode::Interface(name, _) => clone(name),
            WitNode::Package(_, items) => {
                for i in 0..len(items) {
                    match get_unchecked(items, i) {
                        WitNode::Interface(name, _) => return clone(name),
                        WitNode::World(_, world_items) => {
                            for j in 0..len(world_items) {
                                match get_unchecked(world_items, j) {
                                    WitNode::Interface(name, _) => return clone(name),
                                    _ => {},
                                }
                            }
                        },
                        _ => {},
                    }
                }
                String_new()
            },
            WitNode::World(_, items) => {
                for i in 0..len(items) {
                    match get_unchecked(items, i) {
                        WitNode::Interface(name, _) => return clone(name),
                        _ => {},
                    }
                }
                String_new()
            },
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => String_new(),
        }
    }

    /// Return the field name at `index` for record/resource nodes.
    fn field_name_at(self: WitNode, index: i32) -> String {
        match self {
            WitNode::Record(_, fields) => {
                if index < 0 || index >= len(fields) {
                    String_new()
                } else {
                    clone(get_unchecked(fields, index).name)
                }
            },
            WitNode::Resource(_, fields) => {
                if index < 0 || index >= len(fields) {
                    String_new()
                } else {
                    clone(get_unchecked(fields, index).name)
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => String_new(),
        }
    }

    /// Return the field type at `index` for record/resource nodes.
    fn field_type_at(self: WitNode, index: i32) -> types::WitType {
        match self {
            WitNode::Record(_, fields) => {
                if index < 0 || index >= len(fields) {
                    WitType::Unknown(0)
                } else {
                    get_unchecked(fields, index).ty
                }
            },
            WitNode::Resource(_, fields) => {
                if index < 0 || index >= len(fields) {
                    WitType::Unknown(0)
                } else {
                    get_unchecked(fields, index).ty
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => WitType::Unknown(0),
        }
    }

    /// Return the enum variant name at `index`.
    fn enum_variant_at(self: WitNode, index: i32) -> String {
        match self {
            WitNode::Enum(_, variants) => {
                if index < 0 || index >= len(variants) {
                    String_new()
                } else {
                    clone(get_unchecked(variants, index))
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => String_new(),
        }
    }

    /// Return the flags member name at `index`.
    fn flags_member_at(self: WitNode, index: i32) -> String {
        match self {
            WitNode::Flags(_, members) => {
                if index < 0 || index >= len(members) {
                    String_new()
                } else {
                    clone(get_unchecked(members, index))
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => String_new(),
        }
    }

    /// Return the variant case name at `index`.
    fn variant_case_name_at(self: WitNode, index: i32) -> String {
        match self {
            WitNode::Variant(_, cases) => {
                if index < 0 || index >= len(cases) {
                    String_new()
                } else {
                    clone(get_unchecked(cases, index).name)
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => String_new(),
        }
    }

    /// Return whether the variant case at `index` has a payload type.
    fn variant_case_has_payload(self: WitNode, index: i32) -> bool {
        match self {
            WitNode::Variant(_, cases) => {
                if index < 0 || index >= len(cases) {
                    return false
                }
                let case_ty: Option<types::WitType> = get_unchecked(cases, index).ty
                match case_ty {
                    Option::Some(_) => true,
                    Option::None => false,
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => false,
        }
    }

    /// Return the variant case payload type (or `Unknown(0)` if none).
    fn variant_case_type_at(self: WitNode, index: i32) -> types::WitType {
        match self {
            WitNode::Variant(_, cases) => {
                if index < 0 || index >= len(cases) {
                    return WitType::Unknown(0)
                }
                let case_ty: Option<types::WitType> = get_unchecked(cases, index).ty
                match case_ty {
                    Option::Some(ty) => ty,
                    Option::None => WitType::Unknown(0),
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => WitType::Unknown(0),
        }
    }

    /// Return the func param count.
    fn func_param_count(self: WitNode) -> i32 {
        match self {
            WitNode::Func(_, params, _) => len(params),
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => 0,
        }
    }

    /// Return the func param name at `index`.
    fn func_param_name_at(self: WitNode, index: i32) -> String {
        match self {
            WitNode::Func(_, params, _) => {
                if index < 0 || index >= len(params) {
                    String_new()
                } else {
                    clone(get_unchecked(params, index).name)
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => String_new(),
        }
    }

    /// Return the func param type at `index`.
    fn func_param_type_at(self: WitNode, index: i32) -> types::WitType {
        match self {
            WitNode::Func(_, params, _) => {
                if index < 0 || index >= len(params) {
                    WitType::Unknown(0)
                } else {
                    get_unchecked(params, index).ty
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => WitType::Unknown(0),
        }
    }

    /// Return whether a func has a result type.
    fn func_has_result(self: WitNode) -> bool {
        match self {
            WitNode::Func(_, _, result) => {
                let r: Option<types::WitType> = result
                match r {
                    Option::Some(_) => true,
                    Option::None => false,
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => false,
        }
    }

    /// Return the func result type (or `Unknown(0)` if none).
    fn func_result(self: WitNode) -> types::WitType {
        match self {
            WitNode::Func(_, _, result) => {
                let r: Option<types::WitType> = result
                match r {
                    Option::Some(ty) => ty,
                    Option::None => WitType::Unknown(0),
                }
            },
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => WitType::Unknown(0),
        }
    }

    /// Return the type alias target type.
    fn type_alias_target(self: WitNode) -> types::WitType {
        match self {
            WitNode::TypeAlias(_, ty) => ty,
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => WitType::Unknown(0),
        }
    }

    /// Return the use path.
    fn use_path(self: WitNode) -> String {
        match self {
            WitNode::Use(path, _) => clone(path),
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => String_new(),
        }
    }

    /// Return the use alias (may be empty).
    fn use_alias(self: WitNode) -> String {
        match self {
            WitNode::Use(_, alias) => clone(alias),
            WitNode::Package(_, _) |
            WitNode::World(_, _) |
            WitNode::Interface(_, _) |
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => String_new(),
        }
    }

    /// Parse a canonical WIT document into a `WitNode` tree.
    fn parse(source: String) -> WitNode {
        parse_wit_document(source)
    }

    /// Parse a canonical WIT document and seal its import metadata inside the
    /// AST module.  Keeping the recursive `WitNode` local to this module avoids
    /// passing its GC enum representation through the parser/compiler boundary.
    fn import_metadata(source: String) -> String {
        let parsed = parse_wit_document(source)
        parsed.import_serialized()
    }

    /// Serialize canonical WIT metadata while the recursive AST remains inside
    /// `std::wit`. Compiler callers receive only String data, which is stable on
    /// both the linear-memory bootstrap host and the wasm32-gc target.
    fn import_serialized(self: WitNode) -> String {
        match self {
            WitNode::Interface(name, items) => wit_import_serialized_interface(String_new(), name, items),
            WitNode::Package(package, items) => wit_import_serialized_container(package, items),
            WitNode::World(_, items) => wit_import_serialized_container(String_new(), items),
            WitNode::Record(_, _) |
            WitNode::Enum(_, _) |
            WitNode::Flags(_, _) |
            WitNode::Variant(_, _) |
            WitNode::Resource(_, _) |
            WitNode::TypeAlias(_, _) |
            WitNode::Use(_, _) |
            WitNode::Func(_, _, _) |
            WitNode::Import(_, _) |
            WitNode::Export(_, _) |
            WitNode::Error(_) => String_new(),
        }
    }
}

fn wit_import_package_name(package: String) -> String {
    let at = index_of(clone(package), "@")
    if at < 0 {
        package
    } else {
        substring(package, 0, at)
    }
}

fn wit_import_package_version(package: String) -> String {
    let at = index_of(clone(package), "@")
    if at < 0 {
        String_new()
    } else {
        substring(package, at + 1, len(package))
    }
}

fn wit_import_serialized_string_list(values: Vec<String>) -> String {
    let mut out = String_new()
    for i in 0..len(values) {
        if i > 0 {
            out = String::concat(out, String_from("~"))
        }
        out = String::concat(out, clone(get_unchecked(values, i)))
    }
    out
}

fn wit_import_serialized_param_types(params: Vec<types::WitParam>) -> String {
    let mut out = String_new()
    for i in 0..len(params) {
        if i > 0 {
            out = String::concat(out, String_from("~"))
        }
        out = String::concat(out, get_unchecked(params, i).ty.wit_text())
    }
    out
}

fn wit_import_serialized_field_names(fields: Vec<types::WitField>) -> String {
    let mut names = Vec::new<String>()
    for i in 0..len(fields) {
        push(names, clone(get_unchecked(fields, i).name))
    }
    wit_import_serialized_string_list(names)
}

fn wit_import_serialized_field_types(fields: Vec<types::WitField>) -> String {
    let mut out = String_new()
    for i in 0..len(fields) {
        if i > 0 {
            out = String::concat(out, String_from("~"))
        }
        out = String::concat(out, get_unchecked(fields, i).ty.wit_text())
    }
    out
}

fn wit_import_serialized_enum_variants(variants: Vec<String>) -> String {
    wit_import_serialized_string_list(variants)
}

fn wit_import_serialized_variant_names(cases: Vec<types::WitVariantCase>) -> String {
    let mut names = Vec::new<String>()
    for i in 0..len(cases) {
        push(names, clone(get_unchecked(cases, i).name))
    }
    wit_import_serialized_string_list(names)
}

fn wit_import_serialized_variant_payloads(cases: Vec<types::WitVariantCase>) -> String {
    let mut out = String_new()
    for i in 0..len(cases) {
        if i > 0 {
            out = String::concat(out, String_from("~"))
        }
        let case_ty: Option<types::WitType> = get_unchecked(cases, i).ty
        let payload = match case_ty {
            Option::Some(ty) => ty.wit_text(),
            Option::None => String_new(),
        }
        out = String::concat(out, payload)
    }
    out
}

fn wit_import_serialized_entry(kind: String, name: String, first: String, second: String) -> String {
    let mut entry = String::concat(String_from(";"), String::concat(kind, String_from("|")))
    entry = String::concat(entry, name)
    entry = String::concat(entry, String_from("|"))
    entry = String::concat(entry, first)
    entry = String::concat(entry, String_from("|"))
    String::concat(entry, String::concat(second, String_from(";")))
}

fn wit_import_serialized_interface(package: String, name: String, items: Vec<WitNode>) -> String {
    let package_name = wit_import_package_name(clone(package))
    let package_version = wit_import_package_version(package)
    let mut out = String::concat(String_from("header|"), package_name)
    out = String::concat(out, String_from("|"))
    out = String::concat(out, package_version)
    out = String::concat(out, String_from("|"))
    out = String::concat(out, String::concat(name, String_from(";")))
    for i in 0..len(items) {
        match get_unchecked(items, i) {
            WitNode::Func(func_name, params, result) => {
                let r: Option<types::WitType> = result
                let result_text = match r {
                    Option::Some(ty) => ty.wit_text(),
                    Option::None => String_new(),
                }
                out = String::concat(out, wit_import_serialized_entry(
                        String_from("func"),
                        func_name,
                        wit_import_serialized_param_types(params),
                        result_text
                    ))
            },
            WitNode::Record(record_name, fields) => {
                out = String::concat(out, wit_import_serialized_entry(
                        String_from("record"),
                        record_name,
                        wit_import_serialized_field_names(fields),
                        wit_import_serialized_field_types(fields)
                    ))
            },
            WitNode::Enum(enum_name, variants) => {
                out = String::concat(out, wit_import_serialized_entry(
                        String_from("enum"),
                        enum_name,
                        wit_import_serialized_enum_variants(variants),
                        String_new()
                    ))
            },
            WitNode::Variant(variant_name, cases) => {
                out = String::concat(out, wit_import_serialized_entry(
                        String_from("variant"),
                        variant_name,
                        wit_import_serialized_variant_names(cases),
                        wit_import_serialized_variant_payloads(cases)
                    ))
            },
            _ => {},
        }
    }
    out
}

fn wit_import_serialized_container(package: String, items: Vec<WitNode>) -> String {
    for i in 0..len(items) {
        match get_unchecked(items, i) {
            WitNode::Interface(name, interface_items) => {
                return wit_import_serialized_interface(package, name, interface_items)
            },
            WitNode::World(_, world_items) => {
                for j in 0..len(world_items) {
                    match get_unchecked(world_items, j) {
                        WitNode::Interface(name, interface_items) => {
                            return wit_import_serialized_interface(clone(package), name, interface_items)
                        },
                        _ => {},
                    }
                }
            },
            _ => {},
        }
    }
    String_new()
}

// ─── Parser ──────────────────────────────────────────────────────

/// Skip whitespace (space, tab, newline, carriage return).
fn p_skip_ws(s: String, pos: i32) -> i32 {
    let n = len(s)
    let mut i = pos
    while i < n {
        let c = byte_at(s, i)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            return i
        }
    }
    i
}

/// Skip whitespace and comments (`//` line comments and `/* */` block comments).
fn p_skip_ws_comments(s: String, pos: i32) -> i32 {
    let n = len(s)
    let mut i = pos
    while i < n {
        let c = byte_at(s, i)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            if c == 47 && i + 1 < n && byte_at(s, i + 1) == 47 {
                // line comment
                i = i + 2
                while i < n && byte_at(s, i) != 10 {
                    i = i + 1
                }
            } else {
                if c == 47 && i + 1 < n && byte_at(s, i + 1) == 42 {
                    // block comment
                    i = i + 2
                    while i + 1 < n {
                        if byte_at(s, i) == 42 && byte_at(s, i + 1) == 47 {
                            i = i + 2
                            break
                        }
                        i = i + 1
                    }
                } else {
                    return i
                }
            }
        }
    }
    i
}

/// Read an identifier-like word.  Stops at whitespace, `{}();:,<>=$@/-` etc.
/// For WIT, kebab-case names include `-`, so we allow `-` in words.
fn p_word(s: String, pos: i32) -> (String, i32) {
    let n = len(s)
    let start = pos
    let mut i = pos
    while i < n {
        let c = byte_at(s, i)
        if c == 32 || c == 9 || c == 10 || c == 13 || c == 58 || c == 40 || c == 41 || c == 44 || c == 59 || c == 123 || c == 125 || c == 60 || c == 62 || c == 61 || c == 36 || c == 64 {
            break
        }
        i = i + 1
    }
    let word = slice(s, start, i)
    return (word, i)
}

/// Read a path-like word that may include `:` and `/` and `@` and `.`.
/// Used for package paths and use/import paths.
fn p_path(s: String, pos: i32) -> (String, i32) {
    let n = len(s)
    let start = pos
    let mut i = pos
    while i < n {
        let c = byte_at(s, i)
        if c == 32 || c == 9 || c == 10 || c == 13 || c == 40 || c == 41 || c == 44 || c == 59 || c == 123 || c == 125 || c == 60 || c == 62 || c == 61 || c == 36 {
            break
        }
        i = i + 1
    }
    let path = slice(s, start, i)
    return (path, i)
}

/// Find a matching closing brace starting at `pos` (which should be `{`).
/// Returns the index of the closing `}`, or -1 if not found.
fn p_find_matching_brace(s: String, pos: i32) -> i32 {
    let n = len(s)
    if pos >= n || byte_at(s, pos) != 123 {
        return 0 - 1
    }
    let mut depth = 0
    let mut i = pos
    while i < n {
        let c = byte_at(s, i)
        if c == 123 {
            depth = depth + 1
        }
        if c == 125 {
            depth = depth - 1
            if depth == 0 {
                return i
            }
        }
        i = i + 1
    }
    0 - 1
}

/// Parse a WIT type from a type-name string.
fn p_type_name(name: String) -> types::WitType {
    if eq(name, "bool") {
        return WitType::Bool
    }
    if eq(name, "u8") {
        return WitType::U8
    }
    if eq(name, "u16") {
        return WitType::U16
    }
    if eq(name, "u32") {
        return WitType::U32
    }
    if eq(name, "u64") {
        return WitType::U64
    }
    if eq(name, "s8") {
        return WitType::S8
    }
    if eq(name, "s16") {
        return WitType::S16
    }
    if eq(name, "s32") {
        return WitType::S32
    }
    if eq(name, "s64") {
        return WitType::S64
    }
    if eq(name, "f32") {
        return WitType::F32
    }
    if eq(name, "f64") {
        return WitType::F64
    }
    if eq(name, "char") {
        return WitType::Char
    }
    if eq(name, "string") {
        return WitType::String
    }
    // Preserve named references for the compiler metadata adapter. The
    // compiler resolves the name after this syntax-level parse.
    types::WitType::Resource(name)
}

/// Parse a WIT type from source starting at `pos`.  Returns the type
/// and the position after the type.
fn p_type(s: String, pos: i32) -> (types::WitType, i32) {
    let mut i = p_skip_ws_comments(s, pos)
    let n = len(s)
    let (word, p1) = p_word(s, i)
    i = p1
    if eq(word, "list") {
        i = p_skip_ws_comments(s, i)
        if i < n && byte_at(s, i) == 60 {
            let (inner, p2) = p_type(s, i + 1)
            i = p_skip_ws_comments(s, p2)
            if i < n && byte_at(s, i) == 62 {
                i = i + 1
            }
            return (WitType::list(inner), i)
        }
        return (WitType::list(WitType::Unknown(0)), i)
    }
    if eq(word, "option") {
        i = p_skip_ws_comments(s, i)
        if i < n && byte_at(s, i) == 60 {
            let (inner, p3) = p_type(s, i + 1)
            i = p_skip_ws_comments(s, p3)
            if i < n && byte_at(s, i) == 62 {
                i = i + 1
            }
            return (WitType::option(inner), i)
        }
        return (WitType::option(WitType::Unknown(0)), i)
    }
    if eq(word, "tuple") {
        i = p_skip_ws_comments(s, i)
        if i >= n || byte_at(s, i) != 60 {
            return (types::WitType::Tuple(Vec::new<WitType>()), i)
        }
        let mut items = Vec::new<WitType>()
        i = p_skip_ws_comments(s, i + 1)
        while i < n && byte_at(s, i) != 62 {
            let (item, p6) = p_type(s, i)
            push(items, item)
            i = p_skip_ws_comments(s, p6)
            if i < n && byte_at(s, i) == 44 {
                i = p_skip_ws_comments(s, i + 1)
            } else {
                break
            }
        }
        if i < n && byte_at(s, i) == 62 {
            i = i + 1
        }
        return (types::WitType::Tuple(items), i)
    }
    if eq(word, "own") {
        i = p_skip_ws_comments(s, i)
        if i < n && byte_at(s, i) == 60 {
            let (inner, p4) = p_type(s, i + 1)
            i = p_skip_ws_comments(s, p4)
            if i < n && byte_at(s, i) == 62 {
                i = i + 1
            }
            return (types::WitType::Resource(String::concat("own<", String::concat(inner.wit_text(), ">"))), i)
        }
        return (types::WitType::Resource(String_new()), i)
    }
    if eq(word, "borrow") {
        i = p_skip_ws_comments(s, i)
        if i < n && byte_at(s, i) == 60 {
            let (inner, p5) = p_type(s, i + 1)
            i = p_skip_ws_comments(s, p5)
            if i < n && byte_at(s, i) == 62 {
                i = i + 1
            }
            return (types::WitType::Resource(String::concat("borrow<", String::concat(inner.wit_text(), ">"))), i)
        }
        return (types::WitType::Resource(String_new()), i)
    }
    if eq(word, "result") || eq(word, "future") || eq(word, "stream") {
        let constructor = clone(word)
        i = p_skip_ws_comments(s, i)
        if i >= n || byte_at(s, i) != 60 {
            return (types::WitType::Resource(constructor), i)
        }
        let (first, p7) = p_type(s, i + 1)
        i = p_skip_ws_comments(s, p7)
        let mut rendered = String::concat(constructor, "<")
        rendered = String::concat(rendered, first.wit_text())
        if i < n && byte_at(s, i) == 44 {
            let (second, p8) = p_type(s, i + 1)
            rendered = String::concat(rendered, String::concat(", ", second.wit_text()))
            i = p_skip_ws_comments(s, p8)
        }
        if i < n && byte_at(s, i) == 62 {
            i = i + 1
        }
        return (types::WitType::Resource(String::concat(rendered, ">")), i)
    }
    // Preserve package-qualified type references for the resolver.
    if i < n && byte_at(s, i) == 58 {
        let (suffix, p9) = p_path(s, i)
        return (types::WitType::Resource(String::concat(word, suffix)), p9)
    }
    let fallback_type = p_type_name(word)
    return (fallback_type, i)
}

/// Parse function parameters inside `(...)`.
fn p_params(s: String, pos: i32) -> (Vec<types::WitParam>, i32) {
    let mut params = Vec::new<WitParam>()
    let mut i = p_skip_ws_comments(s, pos)
    let n = len(s)
    while i < n {
        i = p_skip_ws_comments(s, i)
        if i < n && byte_at(s, i) == 41 {
            return (params, i + 1)
        }
        let (pname, p1) = p_word(s, i)
        i = p_skip_ws_comments(s, p1)
        if i >= n || byte_at(s, i) != 58 {
            return (params, i)
        }
        i = p_skip_ws_comments(s, i + 1)
        let (ty, p2) = p_type(s, i)
        push(params, WitParam::new(pname, ty))
        i = p_skip_ws_comments(s, p2)
        if i < n && byte_at(s, i) == 44 {
            i = i + 1
        }
    }
    return (params, i)
}

/// Parse a func declaration: `name: func(params) -> result;`
fn p_func(s: String, pos: i32) -> (WitNode, i32) {
    let (fname, p1) = p_word(s, pos)
    let mut i = p_skip_ws_comments(s, p1)
    if i < len(s) && byte_at(s, i) == 58 {
        i = p_skip_ws_comments(s, i + 1)
        let (kw, p2) = p_word(s, i)
        if eq(kw, "func") {
            i = p_skip_ws_comments(s, p2)
            if i < len(s) && byte_at(s, i) == 40 {
                let (params, p3) = p_params(s, i + 1)
                i = p_skip_ws_comments(s, p3)
                let mut result = Option::None
                if i + 1 < len(s) && byte_at(s, i) == 45 && byte_at(s, i + 1) == 62 {
                    i = p_skip_ws_comments(s, i + 2)
                    let (ty, p4) = p_type(s, i)
                    result = Option::Some(ty)
                    i = p4
                }
                if i < len(s) && byte_at(s, i) == 59 {
                    i = i + 1
                }
                return (WitNode::Func(fname, params, result), i)
            }
        }
    }
    let error = WitNode::Error(String_from("expected func"))
    return (error, pos)
}

/// Parse record fields inside `{ ... }`.
fn p_record_fields(s: String, pos: i32) -> (Vec<types::WitField>, i32) {
    let mut fields = Vec::new<WitField>()
    let mut i = p_skip_ws_comments(s, pos)
    let n = len(s)
    while i < n {
        i = p_skip_ws_comments(s, i)
        if i < n && byte_at(s, i) == 125 {
            return (fields, i + 1)
        }
        let (fname, p1) = p_word(s, i)
        i = p_skip_ws_comments(s, p1)
        if i >= n || byte_at(s, i) != 58 {
            return (fields, i)
        }
        i = p_skip_ws_comments(s, i + 1)
        let (ty, p2) = p_type(s, i)
        push(fields, types::WitField { name: fname, ty: ty })
        i = p_skip_ws_comments(s, p2)
        if i < n && byte_at(s, i) == 44 {
            i = i + 1
        }
    }
    return (fields, i)
}

/// Parse enum variants inside `{ ... }`.
fn p_enum_variants(s: String, pos: i32) -> (Vec<String>, i32) {
    let mut variants = Vec::new<String>()
    let mut i = p_skip_ws_comments(s, pos)
    let n = len(s)
    while i < n {
        i = p_skip_ws_comments(s, i)
        if i < n && byte_at(s, i) == 125 {
            return (variants, i + 1)
        }
        let (vname, p1) = p_word(s, i)
        if len(vname) > 0 {
            push(variants, vname)
        }
        i = p_skip_ws_comments(s, p1)
        if i < n && byte_at(s, i) == 44 {
            i = i + 1
        }
    }
    return (variants, i)
}

/// Parse variant cases inside `{ ... }`.
/// Each case is `name` or `name(type)`.
fn p_variant_cases(s: String, pos: i32) -> (Vec<types::WitVariantCase>, i32) {
    let mut cases = Vec::new<WitVariantCase>()
    let mut i = p_skip_ws_comments(s, pos)
    let n = len(s)
    while i < n {
        i = p_skip_ws_comments(s, i)
        if i < n && byte_at(s, i) == 125 {
            return (cases, i + 1)
        }
        let (cname, p1) = p_word(s, i)
        i = p_skip_ws_comments(s, p1)
        let mut payload = Option::None
        if i < n && byte_at(s, i) == 40 {
            let (ty, p2) = p_type(s, i + 1)
            payload = Option::Some(ty)
            i = p_skip_ws_comments(s, p2)
            if i < n && byte_at(s, i) == 41 {
                i = i + 1
            }
        }
        push(cases, types::WitVariantCase { name: cname, ty: payload })
        i = p_skip_ws_comments(s, i)
        if i < n && byte_at(s, i) == 44 {
            i = i + 1
        }
    }
    return (cases, i)
}

/// Parse a single declaration inside an interface or world body.
/// Returns the parsed `WitNode` and the position after it.
fn p_decl(s: String, pos: i32) -> (WitNode, i32) {
    let mut i = p_skip_ws_comments(s, pos)
    let n = len(s)
    if i >= n {
        return (WitNode::Error(String_from("unexpected end of input")), i)
    }
    if byte_at(s, i) == 125 {
        return (WitNode::Error(String_from("}")), i)
    }
    let (kw, p1) = p_word(s, i)
    // Check for import/export with path: `import path: iface;`
    if eq(kw, "import") || eq(kw, "export") {
        i = p_skip_ws_comments(s, p1)
        // Check if next is a path (followed by `:` and then a keyword like `interface` or `func`)
        let (path, p2) = p_path(s, i)
        i = p_skip_ws_comments(s, p2)
        if i < n && byte_at(s, i) == 58 {
            // `import path: interface { ... }` or `import path: func(...);`
            i = p_skip_ws_comments(s, i + 1)
            let (kind_word, p3) = p_word(s, i)
            if eq(kind_word, "interface") {
                i = p_skip_ws_comments(s, p3)
                if i < n && byte_at(s, i) == 123 {
                    let close = p_find_matching_brace(s, i)
                    if close < 0 {
                        return (WitNode::Error(String_from("unterminated interface")), i)
                    }
                    let body = substring(s, i + 1, close)
                    let (items, _) = p_body(body, 0)
                    if eq(kw, "import") {
                        return (WitNode::Import(path, String_from("interface")), close + 1)
                    } else {
                        // For inline export interface, we return the interface node
                        // but also record the export path
                        let _ = items  // consume to avoid unused warning
                        return (WitNode::Export(path, String_from("interface")), close + 1)
                    }
                }
            } else {
                if eq(kind_word, "func") {
                    // `import path: func(...);`
                    i = p_skip_ws_comments(s, p3)
                    if i < n && byte_at(s, i) == 40 {
                        let (params, p4) = p_params(s, i + 1)
                        i = p_skip_ws_comments(s, p4)
                        let mut result = Option::None
                        if i + 1 < n && byte_at(s, i) == 45 && byte_at(s, i + 1) == 62 {
                            i = p_skip_ws_comments(s, i + 2)
                            let (ty, p5) = p_type(s, i)
                            result = Option::Some(ty)
                            i = p5
                        }
                        if i < n && byte_at(s, i) == 59 {
                            i = i + 1
                        }
                        let func_node = WitNode::Func(path, params, result)
                        if eq(kw, "import") {
                            return (WitNode::Import(path, String_from("func")), i)
                        } else {
                            let _ = func_node
                            return (WitNode::Export(path, String_from("func")), i)
                        }
                    }
                }
            }
        }
        // Bare `import path;` or `export path;`
        i = p_skip_ws_comments(s, p2)
        if i < n && byte_at(s, i) == 59 {
            i = i + 1
        }
        if eq(kw, "import") {
            return (WitNode::Import(path, String_new()), i)
        } else {
            return (WitNode::Export(path, String_new()), i)
        }
    }
    if eq(kw, "use") {
        i = p_skip_ws_comments(s, p1)
        let (path, p2) = p_path(s, i)
        i = p_skip_ws_comments(s, p2)
        let mut alias = String_new()
        // Check for `as alias`
        let (as_kw, p3) = p_word(s, i)
        if eq(as_kw, "as") {
            i = p_skip_ws_comments(s, p3)
            let (aname, p4) = p_word(s, i)
            alias = aname
            i = p4
        }
        if i < n && byte_at(s, i) == 59 {
            i = i + 1
        }
        return (WitNode::Use(path, alias), i)
    }
    if eq(kw, "type") {
        i = p_skip_ws_comments(s, p1)
        let (tname, p2) = p_word(s, i)
        i = p_skip_ws_comments(s, p2)
        // Expect `=`
        if i < n && byte_at(s, i) == 61 {
            i = p_skip_ws_comments(s, i + 1)
            let (ty, p3) = p_type(s, i)
            i = p3
            if i < n && byte_at(s, i) == 59 {
                i = i + 1
            }
            return (WitNode::TypeAlias(tname, ty), i)
        }
        return (WitNode::Error(String_from("expected = in type alias")), i)
    }
    if eq(kw, "record") {
        i = p_skip_ws_comments(s, p1)
        let (rname, p2) = p_word(s, i)
        i = p_skip_ws_comments(s, p2)
        if i < n && byte_at(s, i) == 123 {
            let (fields, p3) = p_record_fields(s, i + 1)
            i = p3
            if i < n && byte_at(s, i) == 59 {
                i = i + 1
            }
            return (WitNode::Record(rname, fields), i)
        }
        return (WitNode::Error(String_from("expected { in record")), i)
    }
    if eq(kw, "enum") {
        i = p_skip_ws_comments(s, p1)
        let (ename, p2) = p_word(s, i)
        i = p_skip_ws_comments(s, p2)
        if i < n && byte_at(s, i) == 123 {
            let (variants, p3) = p_enum_variants(s, i + 1)
            i = p3
            if i < n && byte_at(s, i) == 59 {
                i = i + 1
            }
            return (WitNode::Enum(ename, variants), i)
        }
        return (WitNode::Error(String_from("expected { in enum")), i)
    }
    if eq(kw, "flags") {
        i = p_skip_ws_comments(s, p1)
        let (fname, p2) = p_word(s, i)
        i = p_skip_ws_comments(s, p2)
        if i < n && byte_at(s, i) == 123 {
            let (members, p3) = p_enum_variants(s, i + 1)
            i = p3
            if i < n && byte_at(s, i) == 59 {
                i = i + 1
            }
            return (WitNode::Flags(fname, members), i)
        }
        return (WitNode::Error(String_from("expected { in flags")), i)
    }
    if eq(kw, "variant") {
        i = p_skip_ws_comments(s, p1)
        let (vname, p2) = p_word(s, i)
        i = p_skip_ws_comments(s, p2)
        if i < n && byte_at(s, i) == 123 {
            let (cases, p3) = p_variant_cases(s, i + 1)
            i = p3
            if i < n && byte_at(s, i) == 59 {
                i = i + 1
            }
            return (WitNode::Variant(vname, cases), i)
        }
        return (WitNode::Error(String_from("expected { in variant")), i)
    }
    if eq(kw, "resource") {
        i = p_skip_ws_comments(s, p1)
        let (rname, p2) = p_word(s, i)
        i = p_skip_ws_comments(s, p2)
        if i < n && byte_at(s, i) == 123 {
            let (fields, p3) = p_record_fields(s, i + 1)
            i = p3
            if i < n && byte_at(s, i) == 59 {
                i = i + 1
            }
            return (WitNode::Resource(rname, fields), i)
        }
        // resource without body: `resource handle;`
        if i < n && byte_at(s, i) == 59 {
            i = i + 1
            let empty_fields: Vec<WitField> = Vec::new<WitField>()
            return (WitNode::Resource(rname, empty_fields), i)
        }
        let error = WitNode::Error(String_from("expected { or ; in resource"))
        return (error, i)
    }
    if eq(kw, "interface") {
        i = p_skip_ws_comments(s, p1)
        let (iname, p2) = p_word(s, i)
        i = p_skip_ws_comments(s, p2)
        if i < n && byte_at(s, i) == 123 {
            let close = p_find_matching_brace(s, i)
            if close < 0 {
                return (WitNode::Error(String_from("unterminated interface")), i)
            }
            let body = substring(s, i + 1, close)
            let (items, _) = p_body(body, 0)
            return (WitNode::Interface(iname, items), close + 1)
        }
        return (WitNode::Error(String_from("expected { in interface")), i)
    }
    // Otherwise, it might be a func declaration: `name: func(...)`
    // Rewind to the start of the word and try parsing as func
    i = p_skip_ws_comments(s, pos)
    let (func_node, func_pos) = p_func(s, i)
    if !eq(func_node.kind(), "error") {
        return (func_node, func_pos)
    }
    // Skip unknown token
    let error = WitNode::Error(String::concat(String_from("unknown declaration: "), kw))
    return (error, p1)
}

/// Parse a body (sequence of declarations) inside `{ ... }`.
fn p_body(s: String, pos: i32) -> (Vec<WitNode>, i32) {
    let mut items = Vec::new<WitNode>()
    let mut i = p_skip_ws_comments(s, pos)
    let n = len(s)
    while i < n {
        i = p_skip_ws_comments(s, i)
        if i >= n || byte_at(s, i) == 125 {
            return (items, i)
        }
        let (node, p1) = p_decl(s, i)
        if !eq(node.kind(), "error") {
            push(items, node)
        } else {
            // Check if it's just a closing brace marker
            if eq(node.name(), "}") {
                return (items, i)
            }
        }
        i = p1
        if i >= n {
            break
        }
    }
    return (items, i)
}

/// Parse a world declaration.
fn p_world(s: String, pos: i32) -> (WitNode, i32) {
    let mut i = p_skip_ws_comments(s, pos)
    let (kw, p1) = p_word(s, i)
    if !eq(kw, "world") {
        return (WitNode::Error(String_from("expected world")), p1)
    }
    i = p_skip_ws_comments(s, p1)
    let (wname, p2) = p_word(s, i)
    i = p_skip_ws_comments(s, p2)
    if i >= len(s) || byte_at(s, i) != 123 {
        return (WitNode::Error(String_from("expected { after world name")), i)
    }
    let close = p_find_matching_brace(s, i)
    if close < 0 {
        return (WitNode::Error(String_from("unterminated world")), i)
    }
    let body = substring(s, i + 1, close)
    let (items, _) = p_body(body, 0)
    let node = WitNode::World(wname, items)
    return (node, close + 1)
}

/// Parse an interface declaration.
fn p_interface(s: String, pos: i32) -> (WitNode, i32) {
    let mut i = p_skip_ws_comments(s, pos)
    let (kw, p1) = p_word(s, i)
    if !eq(kw, "interface") {
        return (WitNode::Error(String_from("expected interface")), p1)
    }
    i = p_skip_ws_comments(s, p1)
    let (iname, p2) = p_word(s, i)
    i = p_skip_ws_comments(s, p2)
    if i >= len(s) || byte_at(s, i) != 123 {
        return (WitNode::Error(String_from("expected { after interface name")), i)
    }
    let close = p_find_matching_brace(s, i)
    if close < 0 {
        return (WitNode::Error(String_from("unterminated interface")), i)
    }
    let body = substring(s, i + 1, close)
    let (items, _) = p_body(body, 0)
    let node = WitNode::Interface(iname, items)
    return (node, close + 1)
}

/// Parse a package declaration: `package test:foo@1.0.0;`
fn p_package_decl(s: String, pos: i32) -> (String, i32) {
    let mut i = p_skip_ws_comments(s, pos)
    let (kw, p1) = p_word(s, i)
    if !eq(kw, "package") {
        return (String_new(), p1)
    }
    i = p_skip_ws_comments(s, p1)
    let (path, p2) = p_path(s, i)
    i = p_skip_ws_comments(s, p2)
    if i < len(s) && byte_at(s, i) == 59 {
        i = i + 1
    }
    return (path, i)
}

/// Parse a full WIT source text into a `WitNode` tree.
///
/// The source may start with `package ...;` followed by `world` or
/// `interface` declarations, or it may be a single declaration
/// (`record`, `enum`, `flags`, `variant`, `resource`, `type`, `use`).
///
/// Returns the top-level node.  If the source contains a package
/// declaration followed by multiple items, returns a `Package` node
/// containing the items.
fn parse_wit_document(source: String) -> WitNode {
    let mut i = p_skip_ws_comments(source, 0)
    let n = len(source)
    if i >= n {
        return WitNode::Error(String_from("empty input"))
    }
    // Check for package declaration
    let (first_word, _) = p_word(source, i)
    if eq(first_word, "package") {
        let (pkg, p1) = p_package_decl(source, i)
        i = p_skip_ws_comments(source, p1)
        // Parse all top-level items (world, interface, etc.)
        let mut items = Vec::new<WitNode>()
        while i < n {
            i = p_skip_ws_comments(source, i)
            if i >= n {
                break
            }
            let (kw, _) = p_word(source, i)
            if eq(kw, "world") {
                let (node, p2) = p_world(source, i)
                push(items, node)
                i = p2
            } else {
                if eq(kw, "interface") {
                    let (node, p2) = p_interface(source, i)
                    push(items, node)
                    i = p2
                } else {
                    // Try generic decl
                    let (node, p2) = p_decl(source, i)
                    if !eq(node.kind(), "error") {
                        push(items, node)
                    }
                    i = p2
                }
            }
            i = p_skip_ws_comments(source, i)
        }
        return WitNode::Package(pkg, items)
    }
    // No package — try single top-level declaration
    if eq(first_word, "world") {
        let (node, _) = p_world(source, i)
        return node
    }
    if eq(first_word, "interface") {
        let (node, _) = p_interface(source, i)
        return node
    }
    // Try as a single declaration (record, enum, flags, variant, resource, type, use, func)
    let (node, _) = p_decl(source, i)
    node
}
