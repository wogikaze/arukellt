//! WIT world and interface builders (#044).
//!
//! The builder entry points are associated functions on `World`,
//! `Interface`, and `WitFunc`; mutations are receiver methods. The former
//! free `world_*` / `interface_*` / `wit_*` builders were retired by the
//! #917 wave (ADR-044/ADR-046).

use std::wit::types
use std::prelude::{clone}

pub struct WitFunc {
    name: String,
    params: Vec<types::WitParam>,
    result: Option<types::WitType>,
}

pub struct Interface {
    name: String,
    functions: Vec<WitFunc>,
}

pub struct World {
    name: String,
    imports: Vec<Interface>,
    exports: Vec<Interface>,
}

impl WitFunc {
    /// Create a function signature for a world or interface member.
    fn new(name: String, params: Vec<types::WitParam>, result: Option<types::WitType>) -> WitFunc {
        WitFunc {
            name: name,
            params: params,
            result: result,
        }
    }
}

impl Interface {
    /// Create an empty interface with the given name.
    fn new(name: String) -> Interface {
        Interface {
            name: name,
            functions: Vec::new<WitFunc>(),
        }
    }

    /// Append a function to the interface body.
    fn add_func(self: Interface, func: WitFunc) {
        push(self.functions, func)
    }
}

impl World {
    /// Create an empty world with the given name.
    fn new(name: String) -> World {
        World {
            name: name,
            imports: Vec::new<Interface>(),
            exports: Vec::new<Interface>(),
        }
    }

    /// Append an imported interface to the world.
    fn add_import(self: World, iface: Interface) {
        push(self.imports, iface)
    }

    /// Append an exported interface to the world.
    fn add_export(self: World, iface: Interface) {
        push(self.exports, iface)
    }

    /// Return the world name.
    fn name(self: World) -> String {
        clone(self.name)
    }

    /// Return the number of exported interfaces.
    fn exports_len(self: World) -> i32 {
        len(self.exports)
    }
}
