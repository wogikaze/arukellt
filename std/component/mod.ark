//! Experimental component-model helpers.
//!
//! Version constants and canonical ABI lift/lower helpers are associated
//! functions on `Component`; resource handle tables live in
//! `std::component::handle` (SlotMap-backed, #473 phase 1). The former
//! `canonical_abi_version` / `component_model_version` and
//! `canonical_*` free functions were retired by the #917 component waves
//! (ADR-044/ADR-046).
//!
//! Canonical scratch storage uses linear memory offsets 256–65535
//! (65280 bytes per call).

use std::collections::compiler
use std::core::error
use std::prelude::{byte_at}
use std::text
const CANONICAL_SCRATCH_BASE: i32 = 256
const CANONICAL_SCRATCH_LIMIT: i32 = 65280

/// Pointer/count pair describing a canonical ABI list in scratch storage.
pub struct CanonicalSlice {
    ptr: i32,
    len: i32,
}

pub struct Component {}

fn scratch_bump(mut scratch: Vec<i32>, nbytes: i32) -> Result<i32, error::Error> {
    let base = get_unchecked(scratch, 0)
    let next = base + nbytes
    if nbytes < 0 || next > CANONICAL_SCRATCH_BASE + CANONICAL_SCRATCH_LIMIT {
        return Err(error::Error::ComponentError(String_from("MemoryOverflow")))
    }
    set(scratch, 0, next)
    Ok(base)
}

fn scratch_write_byte(mut scratch: Vec<i32>, offset: i32, b: i32) {
    let idx = offset - CANONICAL_SCRATCH_BASE + 1
    while len(scratch) <= idx {
        push(scratch, 0)
    }
    set(scratch, idx, b)
}

fn scratch_read_byte(scratch: Vec<i32>, offset: i32) -> i32 {
    let idx = offset - CANONICAL_SCRATCH_BASE + 1
    if idx < 1 || idx >= len(scratch) {
        return 0
    }
    get_unchecked(scratch, idx)
}

impl Component {
    /// Return the canonical ABI version number.
    fn canonical_abi_version() -> i32 {
        1
    }

    /// Return the component model version string.
    fn model_version() -> String {
        "0.2.0"
    }

    /// Create the scratch vector with the canonical ABI base offset.
    fn scratch_new() -> Vec<i32> {
        let mut s = Vec::new<i32>()
        push(s, CANONICAL_SCRATCH_BASE)
        s
    }

    /// Lower `s` into scratch storage and return its pointer/length slice.
    fn lower_string(mut scratch: Vec<i32>, s: String) -> Result<CanonicalSlice, error::Error> {
        set(scratch, 0, CANONICAL_SCRATCH_BASE)
        let n = len(s)
        let ptr = scratch_bump(scratch, n)
        match ptr {
            Result::Ok(start) => {
                let mut i = 0
                while i < n {
                    scratch_write_byte(scratch, start + i, byte_at(s, i))
                    i = i + 1
                }
                Ok(CanonicalSlice { ptr: start, len: n })
            },
            Result::Err(e) => Err(e),
        }
    }

    /// Lift a canonical string slice from scratch storage.
    fn lift_string(scratch: Vec<i32>, cslice: CanonicalSlice) -> Result<String, error::Error> {
        Component::lift_string_at(scratch, cslice.ptr, cslice.len)
    }

    /// Lift a canonical string slice from an explicit pointer/length pair.
    fn lift_string_at(scratch: Vec<i32>, ptr: i32, slen: i32) -> Result<String, error::Error> {
        if slen < 0 || ptr < CANONICAL_SCRATCH_BASE {
            return Err(error::Error::InvalidArgument(String_from("canonical_lift_string")))
        }
        if slen > CANONICAL_SCRATCH_LIMIT {
            return Err(error::Error::ComponentError(String_from("MemoryOverflow")))
        }
        let mut out = ""
        let mut i = 0
        while i < slen {
            let b = scratch_read_byte(scratch, ptr + i)
            out = out.concat(char_to_string(b))
            i = i + 1
        }
        Ok(out)
    }

    /// Lower an i32 list into scratch storage and return its pointer/count slice.
    fn lower_list_i32(mut scratch: Vec<i32>, items: Vec<i32>) -> Result<CanonicalSlice, error::Error> {
        set(scratch, 0, CANONICAL_SCRATCH_BASE)
        let count = len(items)
        let bytes = count * 4
        let ptr = scratch_bump(scratch, bytes)
        match ptr {
            Result::Ok(start) => {
                let mut i = 0
                while i < count {
                    let v = get_unchecked(items, i)
                    let off = start + i * 4
                    scratch_write_byte(scratch, off, v)
                    scratch_write_byte(scratch, off + 1, 0)
                    scratch_write_byte(scratch, off + 2, 0)
                    scratch_write_byte(scratch, off + 3, 0)
                    i = i + 1
                }
                Ok(CanonicalSlice { ptr: start, len: count })
            },
            Result::Err(e) => Err(e),
        }
    }

    /// Lift an i32 list from a canonical slice in scratch storage.
    fn lift_list_i32(scratch: Vec<i32>, cslice: CanonicalSlice) -> Result<Vec<i32>, error::Error> {
        Component::lift_list_i32_at(scratch, cslice.ptr, cslice.len)
    }

    /// Lift an i32 list from an explicit pointer/count pair.
    fn lift_list_i32_at(scratch: Vec<i32>, ptr: i32, count: i32) -> Result<Vec<i32>, error::Error> {
        if count < 0 || ptr < CANONICAL_SCRATCH_BASE {
            return Err(error::Error::InvalidArgument(String_from("canonical_lift_list_i32")))
        }
        if count * 4 > CANONICAL_SCRATCH_LIMIT {
            return Err(error::Error::ComponentError(String_from("MemoryOverflow")))
        }
        let mut out = Vec::new<i32>()
        let mut i = 0
        while i < count {
            push(out, scratch_read_byte(scratch, ptr + i * 4))
            i = i + 1
        }
        Ok(out)
    }
}
