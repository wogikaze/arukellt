//! Resource handle table for Component Model boundaries (#044, #473).
//!
//! `HandleTable<T>` is monomorphized per payload type. The i32 table uses
//! SlotMap layout from `std::collections::compiler` and exposes receiver
//! methods on `HandleTableI32` (ADR-044/ADR-046). The former untyped
//! `handle_*` and `handle_table_i32_*` free functions were retired by the
//! #917 component wave.

use std::collections::compiler

pub struct HandleTableI32 {
    slots: Vec<i32>,
}

impl HandleTableI32 {
    /// Create an empty Component Model handle table (SlotMap-backed storage).
    fn new() -> HandleTableI32 {
        HandleTableI32 { slots: compiler::slotmap_new() }
    }

    /// Insert `value` and return a stable handle index.
    fn insert(self: HandleTableI32, value: i32) -> i32 {
        compiler::slotmap_insert(self.slots, value)
    }

    /// Look up a live handle without removing it.
    fn get(self: HandleTableI32, handle: i32) -> Option<i32> {
        compiler::slotmap_get(self.slots, handle)
    }

    /// Drop a handle and return its value, if still live.
    fn remove(self: HandleTableI32, handle: i32) -> Option<i32> {
        compiler::slotmap_remove(self.slots, handle)
    }

    /// Return the number of live handles in the table.
    fn len(self: HandleTableI32) -> i32 {
        compiler::slotmap_len(self.slots)
    }
}
