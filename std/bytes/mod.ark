                                                                                                                                                                                            if eq(c, "u") {
                                                                                                                                                                                                46
                                                                                                                                                                                            } else {
                                                                                                                                                                                                if eq(c, "v") {
                                                                                                                                                                                                    47
                                                                                                                                                                                                } else {
                                                                                                                                                                                                    if eq(c, "w") {
                                                                                                                                                                                                        48
