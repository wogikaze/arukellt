/// Deprecated: use `Vec::to_base64` instead.
pub fn base64_encode(b: Vec<i32>) -> String {
    b.to_base64()
}

/// Deprecated: use `Bytes::from_base64` instead.
pub fn base64_decode(s: String) -> Vec<i32> {
    Bytes::from_base64(s)
}

// ─── LEB128 decode ───────────────────────────────────────────────────────────
/// Decode an unsigned LEB128 u32 from a ByteCursor.
/// Returns 0 if the cursor is empty or the encoding is malformed/overlong.
/// Advances the cursor position by the number of bytes consumed.
/// Deprecated: use `Vec::read_leb128_u32` instead.
pub fn leb128_decode_u32(c: Vec<i32>) -> i32 {
    c.read_leb128_u32()
}

/// Decode a signed LEB128 i32 from a ByteCursor.
/// Advances the cursor position.
/// Deprecated: use `Vec::read_leb128_i32` instead.
pub fn leb128_decode_i32(c: Vec<i32>) -> i32 {
    c.read_leb128_i32()
}

// ─── LEB128 u64 ──────────────────────────────────────────────────────────────
// NOTE: u64 is not a distinct type; i64 is used throughout.
/// Deprecated: use `Bytes::from_leb128_u64` instead.
pub fn leb128_encode_u64(x: i64) -> Vec<i32> {
    Bytes::from_leb128_u64(x)
}

/// Decode an unsigned LEB128 u64 from a ByteCursor.
/// Returns the decoded value as i64.
/// Deprecated: use `Vec::read_leb128_u64` instead.
pub fn leb128_decode_u64(c: Vec<i32>) -> i64 {
    c.read_leb128_u64()
}
test mod "bytes" {
    test "new_empty" {
        let b: Vec<i32> = Vec::new<i32>()
        assert(b.len() == 0)
    }
    test "from_str" {
        let b: Vec<i32> = "ab".to_utf8_bytes()
        assert(b.len() == 2)
    }
    test "push" {
        let b: Vec<i32> = Vec::new<i32>()
        b.push_byte(255)
        assert(b.len() == 1)
    }
}

test mod "bytes_ops" {
    test "get_reads_byte" {
        let b: Vec<i32> = "ab".to_utf8_bytes()
        assert(b.get_unchecked(0) == 97)
        assert(b.get_unchecked(1) == 98)
    }
    test "eq_identical" {
        let a: Vec<i32> = "xy".to_utf8_bytes()
        let b: Vec<i32> = "xy".to_utf8_bytes()
        assert(a.equals_bytes(b))
    }
    test "eq_different_len" {
        let a: Vec<i32> = "x".to_utf8_bytes()
        let b: Vec<i32> = "xy".to_utf8_bytes()
        assert(a.equals_bytes(b) == false)
    }
    test "concat_appends" {
        let a: Vec<i32> = "ab".to_utf8_bytes()
        let c: Vec<i32> = "cd".to_utf8_bytes()
        let r: Vec<i32> = a.concat_bytes(c)
        assert(r.len() == 4)
        assert(r.get_unchecked(3) == 100)
    }
    test "slice_middle" {
        let b: Vec<i32> = "abcd".to_utf8_bytes()
        let s: Vec<i32> = b.slice_bytes(1, 3)
        assert(s.len() == 2)
        assert(s.get_unchecked(0) == 98)
    }
    test "string_roundtrip" {
        let b: Vec<i32> = "hi".to_utf8_bytes()
        let s: String = String::from_utf8_lossy(b)
        assert(s.to_utf8_bytes().equals_bytes("hi".to_utf8_bytes()))
    }
    test "byte_length_ascii" { assert("abc".len_bytes() == 3) }
    test "hex_char_digits" {
        assert(eq(hex_char(0), "0"))
        assert(eq(hex_char(9), "9"))
        assert(eq(hex_char(10), "a"))
        assert(eq(hex_char(15), "f"))
    }
    test "hex_val_char_valid" {
        assert(hex_val_char("0") == 0)
        assert(hex_val_char("9") == 9)
        assert(hex_val_char("a") == 10)
        assert(hex_val_char("f") == 15)
        assert(hex_val_char("F") == 15)
    }
    test "hex_encode_ascii" {
        let b: Vec<i32> = "a".to_utf8_bytes()
        assert(eq(b.to_hex(), "61"))
    }
    test "hex_decode_roundtrip" {
        let d: Vec<i32> = Bytes::from_hex("dead")
        assert(d.len() == 2)
        assert(d.get_unchecked(0) == 222)
        assert(d.get_unchecked(1) == 173)
    }
    test "from_array_masks" {
        let xs: Vec<i32> = Vec::new<i32>()
        push(xs, 0)
        push(xs, 257)
        let b: Vec<i32> = Bytes::from_array(xs)
        assert(b.get_unchecked(0) == 0)
        assert(b.get_unchecked(1) == 1)
    }
}

test mod "bytes_endian" {
    test "u16_le_layout" {
        let b: Vec<i32> = Bytes::from_u16_le(4660)
        assert(b.get_unchecked(0) == 52)
        assert(b.get_unchecked(1) == 18)
    }
    test "u16_le_roundtrip" {
        let b: Vec<i32> = Bytes::from_u16_le(258)
        assert(b.to_u16_le() == 258)
    }
    test "u32_le_layout" {
        let b: Vec<i32> = Bytes::from_u32_le(1)
        assert(b.len() == 4)
        assert(b.get_unchecked(0) == 1)
        assert(b.get_unchecked(3) == 0)
    }
    test "u32_le_roundtrip" {
        let b: Vec<i32> = Bytes::from_u32_le(70000)
        assert(b.to_u32_le() == 70000)
    }
    test "u32_be_layout" {
        let b: Vec<i32> = Bytes::from_u32_be(1)
        assert(b.get_unchecked(0) == 0)
        assert(b.get_unchecked(3) == 1)
    }
    test "u32_be_roundtrip" {
        let b: Vec<i32> = Bytes::from_u32_be(70000)
        assert(b.to_u32_be() == 70000)
    }
    test "leb128_small_single_byte" {
        let e: Vec<i32> = Bytes::from_leb128_u32(127)
        assert(e.len() == 1)
        assert(e.get_unchecked(0) == 127)
    }
    test "leb128_128_two_bytes" {
        let e: Vec<i32> = Bytes::from_leb128_u32(128)
        assert(e.len() == 2)
        assert(e.get_unchecked(0) == 128)
        assert(e.get_unchecked(1) == 1)
    }
    test "leb128_u32_decode_roundtrip" {
        let e: Vec<i32> = Bytes::from_leb128_u32(624485)
        let c: Vec<i32> = e.byte_cursor()
        assert(c.read_leb128_u32() == 624485)
    }
    test "leb128_i32_decode_negative" {
        let e: Vec<i32> = Bytes::from_leb128_i32(0 - 64)
        let c: Vec<i32> = e.byte_cursor()
        assert(c.read_leb128_i32() == 0 - 64)
    }
    test "leb128_u64_roundtrip" {
        let e: Vec<i32> = Bytes::from_leb128_u64(i32_to_i64(300))
        let c: Vec<i32> = e.byte_cursor()
        assert(c.read_leb128_u64() == i32_to_i64(300))
    }
}

test mod "bytes_buf_cursor" {
    test "buf_push_u8" {
        let b: Vec<i32> = Vec::new<i32>()
        b.push_byte(65)
        assert(b.len() == 1)
    }
    test "buf_push_u16_le_two_bytes" {
        let b: Vec<i32> = Vec::new<i32>()
        b.push_u16_le(258)
        assert(b.len() == 2)
        assert(b.get_unchecked(0) == 2)
        assert(b.get_unchecked(1) == 1)
    }
    test "buf_push_u32_le_four_bytes" {
        let b: Vec<i32> = Vec::new<i32>()
        b.push_u32_le(1)
        assert(b.len() == 4)
    }
    test "buf_push_u64_le_eight_bytes" {
        let b: Vec<i32> = Vec::new<i32>()
        b.push_u64_le(i32_to_i64(1))
        assert(b.len() == 8)
    }
    test "buf_extend_appends" {
        let b: Vec<i32> = Vec::new<i32>()
        b.push_byte(1)
        b.extend_bytes("xy".to_utf8_bytes())
        assert(b.len() == 3)
    }
    test "buf_freeze_keeps_bytes" {
        let b: Vec<i32> = "ok".to_utf8_bytes()
        let frozen: Vec<i32> = b.freeze()
        assert(frozen.equals_bytes(b))
    }
    test "cursor_read_u8_advances" {
        let c: Vec<i32> = "ab".to_utf8_bytes().byte_cursor()
        assert(c.read_u8() == 97)
        assert(c.cursor_pos() == 1)
        assert(c.cursor_remaining() == 1)
    }
    test "cursor_read_u16_le" {
        let c: Vec<i32> = Bytes::from_u16_le(258).byte_cursor()
        assert(c.read_u16_le() == 258)
    }
    test "cursor_read_u32_le" {
        let c: Vec<i32> = Bytes::from_u32_le(70000).byte_cursor()
        assert(c.read_u32_le() == 70000)
    }
    test "cursor_try_read_u8_empty_is_none" {
        let c: Vec<i32> = Vec::new<i32>().byte_cursor()
        let r = match c.try_read_u8() {
            Option::Some(v) => 1,
            Option::None => 2,
        }
        assert(r == 2)
    }
    test "cursor_read_bytes_takes_n" {
        let c: Vec<i32> = "abcd".to_utf8_bytes().byte_cursor()
        let r: Vec<i32> = c.read_bytes(2)
        assert(r.len() == 2)
        assert(c.cursor_remaining() == 2)
    }
    test "base64_roundtrip" {
        let b: Vec<i32> = "hi".to_utf8_bytes()
        let encoded: String = b.to_base64()
        let decoded: Vec<i32> = Bytes::from_base64(encoded)
        assert(decoded.equals_bytes(b))
    }
}
