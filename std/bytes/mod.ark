//! Binary data helpers over the shared `Vec<i32>` byte layout.
//!
//! Each element is treated as a byte in the `0..=255` range. `Bytes`,
//! `ByteBuf`, and `ByteCursor` are all `Vec<i32>` at runtime; the canonical
//! API is the method / associated surface on this module:
//!
//! - `b.push_byte(x)`, `b.len()`, `b.get_unchecked(i)` for byte buffers;
//!   `String::to_utf8_bytes` / `String::from_utf8_lossy` for text conversion.
//! - `Bytes::from_hex(s)` / `b.to_hex()`, `Bytes::from_base64(s)` /
//!   `b.to_base64()`.
//! - `Bytes::from_u16_le(x)` / `b.to_u16_le()` and the u32 LE/BE pairs.
//! - `Bytes::from_leb128_*` / `c.read_leb128_*`.
//! - `data.byte_cursor()` plus `c.cursor_pos()`, `c.cursor_remaining()`,
//!   `c.read_u8()`, `c.try_read_u8()`, and the wider readers.
//!
//! The public free functions below are deprecated under ADR-087 and remain
//! callable only through the 0.x deprecation window; W0009 names the
//! replacement and `remove_in` is the upper bound.
//!
//! `try_read_u64_le` stays deferred: constructing `Some(i64)` still emits
//! invalid Wasm, so use `c.read_u64_le()` and its `-1` sentinel.
//!
//! u8/u16/u32/u64 are not first-class types in the current runtime. All byte
//! values are represented as i32 (masked to 0-255 on write); 64-bit values
//! use i64. Vec<u8> is unavailable; Vec<i32> is used throughout.

use std::collections::string
use std::text
use std::prelude::{eq, i32_to_i64, i64_to_i32, slice}

/// Namespace for byte-vector constructors and decoders.
///
/// Ark has no module-level associated functions, so the receiver-less
/// encoders live on an empty type (ADR-046). Every function returns the
/// shared `Vec<i32>` byte layout.
pub struct Bytes {}

impl Bytes {
    /// Copies `xs` into a new byte buffer, masking each element to 8 bits.
    fn from_array(xs: Vec<i32>) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        let n = len(xs)
        let mut i = 0
        while i < n {
            push(result, get_unchecked(xs, i) & 255)
            i = i + 1
        }
        result
    }

    /// Decodes a hex string. Invalid pairs are skipped, matching `hex_decode`.
    fn from_hex(s: String) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        let n: i32 = len(s)
        let mut i: i32 = 0
        while i + 1 < n {
            let hi_ch: String = slice(s, i, i + 1)
            let lo_ch: String = slice(s, i + 1, i + 2)
            let hi: i32 = hex_val_char(hi_ch)
            let lo: i32 = hex_val_char(lo_ch)
            if hi >= 0 {
                if lo >= 0 {
                    push(result, hi * 16 + lo)
                }
            }
            i = i + 2
        }
        result
    }

    /// Decodes a base64 string. Invalid quartets are skipped.
    fn from_base64(s: String) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        let n = len(s)
        let mut i = 0
        while i + 3 < n {
            let c0 = base64_val(slice(s, i, i + 1))
            let c1 = base64_val(slice(s, i + 1, i + 2))
            let c2 = base64_val(slice(s, i + 2, i + 3))
            let c3 = base64_val(slice(s, i + 3, i + 4))
            if c0 >= 0 {
                if c1 >= 0 {
                    push(result, (c0 << 2) | (c1 >> 4))
                    if c2 >= 0 {
                        push(result, ((c1 & 15) << 4) | (c2 >> 2))
                        if c3 >= 0 {
                            push(result, ((c2 & 3) << 6) | c3)
                        }
                    }
                }
            }
            i = i + 4
        }
        result
    }

    /// Encodes the low 16 bits of `x` as two little-endian bytes.
    fn from_u16_le(x: i32) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        push(result, x & 255)
        push(result, x >> 8 & 255)
        result
    }

    /// Encodes `x` as four little-endian bytes.
    fn from_u32_le(x: i32) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        push(result, x & 255)
        push(result, x >> 8 & 255)
        push(result, x >> 16 & 255)
        push(result, x >> 24 & 255)
        result
    }

    /// Encodes `x` as four big-endian bytes.
    fn from_u32_be(x: i32) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        push(result, x >> 24 & 255)
        push(result, x >> 16 & 255)
        push(result, x >> 8 & 255)
        push(result, x & 255)
        result
    }

    /// Encodes an unsigned LEB128 u32 value.
    fn from_leb128_u32(x: i32) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        let mut val: i32 = x
        let mut done: bool = false
        while done == false {
            let byte: i32 = val & 127
            val = val >> 7
            if val != 0 {
                push(result, byte | 128)
            } else {
                push(result, byte)
                done = true
            }
        }
        result
    }

    /// Encodes a signed LEB128 i32 value.
    fn from_leb128_i32(x: i32) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        let mut val: i32 = x
        let mut done: bool = false
        while done == false {
            let byte: i32 = val & 127
            val = val >> 7
            if val == 0 {
                if (byte & 64) == 0 {
                    push(result, byte)
                    done = true
                } else {
                    push(result, byte | 128)
                    push(result, 0)
                    done = true
                }
            } else {
                if val == 0 - 1 {
                    if (byte & 64) != 0 {
                        push(result, byte)
                        done = true
                    } else {
                        push(result, byte | 128)
                        push(result, 127)
                        done = true
                    }
                } else {
                    push(result, byte | 128)
                }
            }
        }
        result
    }

    /// Encodes an unsigned LEB128 u64 value (represented as i64).
    fn from_leb128_u64(x: i64) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        let mut val: i64 = x
        let mut done: bool = false
        while done == false {
            let byte: i32 = i64_to_i32(val & i32_to_i64(127))
            val = val >> i32_to_i64(7)
            if val != i32_to_i64(0) {
                push(result, byte | 128)
            } else {
                push(result, byte)
                done = true
            }
        }
        result
    }
}

/// Byte-buffer, encoder, and cursor methods over `Vec<i32>`.
///
/// The cursor layout is `c[0] = position`, `c[1..] = data bytes`; the methods
/// below advance that position in place. `try_*` readers are the preferred
/// spelling and return `Option` instead of the legacy `-1` sentinel.
impl Vec<i32> {
    /// Appends one byte, masking the value to 0-255.
    fn push_byte(self: Vec<i32>, byte: i32) {
        push(self, byte & 255)
    }

    /// Compares length and byte content.
    fn equals_bytes(self: Vec<i32>, other: Vec<i32>) -> bool {
        let al: i32 = len(self)
        let bl: i32 = len(other)
        if al != bl {
            return false
        }
        let mut i: i32 = 0
        while i < al {
            if get_unchecked(self, i) != get_unchecked(other, i) {
                return false
            }
            i = i + 1
        }
        true
    }

    /// Returns a new buffer containing `self` followed by `other`.
    fn concat_bytes(self: Vec<i32>, other: Vec<i32>) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        let an = len(self)
        let bn = len(other)
        let mut i = 0
        while i < an {
            push(result, get_unchecked(self, i))
            i = i + 1
        }
        i = 0
        while i < bn {
            push(result, get_unchecked(other, i))
            i = i + 1
        }
        result
    }

    /// Extracts `[start, end)` as a new buffer.
    fn slice_bytes(self: Vec<i32>, start: i32, end: i32) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        let mut i = start
        while i < end {
            push(result, get_unchecked(self, i))
            i = i + 1
        }
        result
    }

    /// Encodes every byte as two lowercase hex digits.
    fn to_hex(self: Vec<i32>) -> String {
        let mut result: String = ""
        let mut i: i32 = 0
        let n: i32 = len(self)
        while i < n {
            let byte: i32 = get_unchecked(self, i) & 255
            let hi: i32 = byte >> 4
            let lo: i32 = byte & 15
            result = result.concat(hex_char(hi).concat(hex_char(lo)))
            i = i + 1
        }
        result
    }

    /// Encodes the bytes as standard base64 with `=` padding.
    fn to_base64(self: Vec<i32>) -> String {
        let mut result = ""
        let n = len(self)
        let mut i = 0
        while i < n {
            let b0 = get_unchecked(self, i) & 255
            let b1 = if i + 1 < n {
                get_unchecked(self, i + 1) & 255
            } else {
                0
            }
            let b2 = if i + 2 < n {
                get_unchecked(self, i + 2) & 255
            } else {
                0
            }
            // Parenthesize: `==`/`<<` bind tighter than `&` in Ark.
            let idx0 = b0 >> 2
            let idx1 = ((b0 & 3) << 4) | (b1 >> 4)
            let idx2 = ((b1 & 15) << 2) | (b2 >> 6)
            let idx3 = b2 & 63
            result = result.concat(base64_char(idx0))
            result = result.concat(base64_char(idx1))
            if i + 1 < n {
                result = result.concat(base64_char(idx2))
            } else {
                result = result.concat("=")
            }
            if i + 2 < n {
                result = result.concat(base64_char(idx3))
            } else {
                result = result.concat("=")
            }
            i = i + 3
        }
        result
    }

    /// Reads two little-endian bytes as i32.
    fn to_u16_le(self: Vec<i32>) -> i32 {
        let lo: i32 = get_unchecked(self, 0) & 255
        let hi: i32 = get_unchecked(self, 1) & 255
        lo + hi * 256
    }

    /// Reads four little-endian bytes as i32.
    fn to_u32_le(self: Vec<i32>) -> i32 {
        let b0: i32 = get_unchecked(self, 0) & 255
        let b1: i32 = get_unchecked(self, 1) & 255
        let b2: i32 = get_unchecked(self, 2) & 255
        let b3: i32 = get_unchecked(self, 3) & 255
        b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    }

    /// Reads four big-endian bytes as i32.
    fn to_u32_be(self: Vec<i32>) -> i32 {
        let b0: i32 = get_unchecked(self, 0) & 255
        let b1: i32 = get_unchecked(self, 1) & 255
        let b2: i32 = get_unchecked(self, 2) & 255
        let b3: i32 = get_unchecked(self, 3) & 255
        b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
    }

    /// Appends the low 16 bits of `x` as little-endian bytes.
    fn push_u16_le(self: Vec<i32>, x: i32) {
        push(self, x & 255)
        push(self, x >> 8 & 255)
    }

    /// Appends `x` as four little-endian bytes.
    fn push_u32_le(self: Vec<i32>, x: i32) {
        push(self, x & 255)
        push(self, x >> 8 & 255)
        push(self, x >> 16 & 255)
        push(self, x >> 24 & 255)
    }

    /// Appends `x` as eight little-endian bytes.
    fn push_u64_le(self: Vec<i32>, x: i64) {
        let mask: i64 = i32_to_i64(255)
        push(self, i64_to_i32(x & mask))
        push(self, i64_to_i32(x >> i32_to_i64(8) & mask))
        push(self, i64_to_i32(x >> i32_to_i64(16) & mask))
        push(self, i64_to_i32(x >> i32_to_i64(24) & mask))
        push(self, i64_to_i32(x >> i32_to_i64(32) & mask))
        push(self, i64_to_i32(x >> i32_to_i64(40) & mask))
        push(self, i64_to_i32(x >> i32_to_i64(48) & mask))
        push(self, i64_to_i32(x >> i32_to_i64(56) & mask))
    }

    /// Appends every byte of `other`.
    fn extend_bytes(self: Vec<i32>, other: Vec<i32>) {
        let n = len(other)
        let mut i = 0
        while i < n {
            push(self, get_unchecked(other, i))
            i = i + 1
        }
    }

    /// Marks a buffer as finished. `Bytes` and `ByteBuf` share the same
    /// `Vec<i32>` layout, so this returns the buffer unchanged.
    fn freeze(self: Vec<i32>) -> Vec<i32> {
        self
    }

    /// Wraps `self` as a cursor (`c[0] = 0`, then the data bytes).
    fn byte_cursor(self: Vec<i32>) -> Vec<i32> {
        let c: Vec<i32> = Vec::new<i32>()
        push(c, 0)
        let n = len(self)
        let mut i = 0
        while i < n {
            push(c, get_unchecked(self, i))
            i = i + 1
        }
        c
    }

    /// Returns the current cursor position.
    fn cursor_pos(self: Vec<i32>) -> i32 {
        get_unchecked(self, 0)
    }

    /// Returns the number of unread bytes.
    fn cursor_remaining(self: Vec<i32>) -> i32 {
        len(self) - 1 - get_unchecked(self, 0)
    }

    /// Reads one byte and advances the cursor; returns -1 at EOF.
    fn read_u8(self: Vec<i32>) -> i32 {
        let pos = get_unchecked(self, 0)
        if self.cursor_remaining() < 1 {
            0 - 1
        } else {
            let byte = get_unchecked(self, pos + 1)
            set(self, 0, pos + 1)
            byte
        }
    }

    /// Reads two little-endian bytes; returns -1 when fewer than 2 remain.
    fn read_u16_le(self: Vec<i32>) -> i32 {
        if self.cursor_remaining() < 2 {
            0 - 1
        } else {
            let b0 = self.read_u8() & 255
            let b1 = self.read_u8() & 255
            b0 + b1 * 256
        }
    }

    /// Reads four little-endian bytes; returns -1 when fewer than 4 remain.
    fn read_u32_le(self: Vec<i32>) -> i32 {
        if self.cursor_remaining() < 4 {
            0 - 1
        } else {
            let b0 = self.read_u8() & 255
            let b1 = self.read_u8() & 255
            let b2 = self.read_u8() & 255
            let b3 = self.read_u8() & 255
            b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
        }
    }

    /// Reads eight little-endian bytes as i64; returns -1 at EOF.
    fn read_u64_le(self: Vec<i32>) -> i64 {
        if self.cursor_remaining() < 8 {
            i32_to_i64(0) - i32_to_i64(1)
        } else {
            let b0 = i32_to_i64(self.read_u8() & 255)
            let b1 = i32_to_i64(self.read_u8() & 255)
            let b2 = i32_to_i64(self.read_u8() & 255)
            let b3 = i32_to_i64(self.read_u8() & 255)
            let b4 = i32_to_i64(self.read_u8() & 255)
            let b5 = i32_to_i64(self.read_u8() & 255)
            let b6 = i32_to_i64(self.read_u8() & 255)
            let b7 = i32_to_i64(self.read_u8() & 255)
            let k256: i64 = i32_to_i64(256)
            let k65536: i64 = i32_to_i64(65536)
            let k16m: i64 = i32_to_i64(16777216)
            let k32: i64 = k65536 * k65536
            let k40: i64 = k32 * k256
            let k48: i64 = k32 * k65536
            let k56: i64 = k48 * k256
            b0 + b1 * k256 + b2 * k65536 + b3 * k16m + b4 * k32 + b5 * k40 + b6 * k48 + b7 * k56
        }
    }

    /// Reads four big-endian bytes; returns -1 when fewer than 4 remain.
    fn read_u32_be(self: Vec<i32>) -> i32 {
        if self.cursor_remaining() < 4 {
            0 - 1
        } else {
            let b0 = self.read_u8() & 255
            let b1 = self.read_u8() & 255
            let b2 = self.read_u8() & 255
            let b3 = self.read_u8() & 255
            b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
        }
    }

    /// Reads `n` bytes into a new buffer; returns an empty buffer at EOF.
    fn read_bytes(self: Vec<i32>, n: i32) -> Vec<i32> {
        let result: Vec<i32> = Vec::new<i32>()
        if self.cursor_remaining() < n {
            result
        } else {
            let mut i = 0
            while i < n {
                push(result, self.read_u8())
                i = i + 1
            }
            result
        }
    }

    /// Reads one byte as `Option`; `None` at EOF.
    fn try_read_u8(self: Vec<i32>) -> Option<i32> {
        if self.cursor_remaining() < 1 {
            None
        } else {
            let pos = get_unchecked(self, 0)
            let byte = get_unchecked(self, pos + 1)
            set(self, 0, pos + 1)
            Some(byte)
        }
    }

    /// Reads two little-endian bytes as `Option`; `None` when short.
    fn try_read_u16_le(self: Vec<i32>) -> Option<i32> {
        if self.cursor_remaining() < 2 {
            None
        } else {
            let b0 = self.read_u8() & 255
            let b1 = self.read_u8() & 255
            Some(b0 + b1 * 256)
        }
    }

    /// Reads four little-endian bytes as `Option`; `None` when short.
    fn try_read_u32_le(self: Vec<i32>) -> Option<i32> {
        if self.cursor_remaining() < 4 {
            None
        } else {
            let b0 = self.read_u8() & 255
            let b1 = self.read_u8() & 255
            let b2 = self.read_u8() & 255
            let b3 = self.read_u8() & 255
            Some(b0 + b1 * 256 + b2 * 65536 + b3 * 16777216)
        }
    }

    /// Reads four big-endian bytes as `Option`; `None` when short.
    fn try_read_u32_be(self: Vec<i32>) -> Option<i32> {
        if self.cursor_remaining() < 4 {
            None
        } else {
            let b0 = self.read_u8() & 255
            let b1 = self.read_u8() & 255
            let b2 = self.read_u8() & 255
            let b3 = self.read_u8() & 255
            Some(b0 * 16777216 + b1 * 65536 + b2 * 256 + b3)
        }
    }

    /// Reads `n` bytes as `Option`; `None` when short.
    fn try_read_bytes(self: Vec<i32>, n: i32) -> Option<Vec<i32>> {
        if self.cursor_remaining() < n {
            None
        } else {
            let result: Vec<i32> = Vec::new<i32>()
            let mut i = 0
            while i < n {
                push(result, self.read_u8())
                i = i + 1
            }
            Some(result)
        }
    }

    /// Decodes an unsigned LEB128 u32 from the cursor.
    fn read_leb128_u32(self: Vec<i32>) -> i32 {
        let mut result = 0
        let mut shift = 0
        let mut done = false
        while done == false {
            if self.cursor_remaining() < 1 {
                done = true
            } else {
                let byte = self.read_u8()
                result = result | ((byte & 127) << shift)
                shift = shift + 7
                if (byte & 128) == 0 {
                    done = true
                }
                if shift >= 35 {
                    done = true
                }
            }
        }
        result
    }

    /// Decodes a signed LEB128 i32 from the cursor.
    fn read_leb128_i32(self: Vec<i32>) -> i32 {
        let mut result = 0
        let mut shift = 0
        let mut last_byte = 0
        let mut done = false
        while done == false {
            if self.cursor_remaining() < 1 {
                done = true
            } else {
                let byte = self.read_u8()
                last_byte = byte
                result = result | ((byte & 127) << shift)
                shift = shift + 7
                if (byte & 128) == 0 {
                    done = true
                }
                if shift >= 35 {
                    done = true
                }
            }
        }
        if shift < 32 {
            if (last_byte & 64) != 0 {
                result = result | ((0 - 1) << shift)
            }
        }
        result
    }

    /// Decodes an unsigned LEB128 u64 from the cursor as i64.
    fn read_leb128_u64(self: Vec<i32>) -> i64 {
        let mut result: i64 = i32_to_i64(0)
        let mut shift: i64 = i32_to_i64(0)
        let mut done: bool = false
        while done == false {
            if self.cursor_remaining() < 1 {
                done = true
            } else {
                let byte = self.read_u8()
                let chunk = i32_to_i64(byte & 127) << shift
                result = result | chunk
                shift = shift + i32_to_i64(7)
                if (byte & 128) == 0 {
                    done = true
                }
                if shift >= i32_to_i64(70) {
                    done = true
                }
            }
        }
        result
    }
}

// ── Deprecated free-function surface (ADR-087 Wave 1) ───────────────────────
// The method / associated surface above is canonical. These wrappers stay
// resolvable through the 0.x deprecation window; the manifest carries the
// W0009 replacement and remove_in metadata, and the changelog records the
// wave. Remove them when the ADR-087 window closes.
/// Deprecated: use `Vec::new` instead.
pub fn bytes_new() -> Vec<i32> {
    Vec::new<i32>()
}

/// Create a byte buffer from the raw bytes of a UTF-8 string.
/// Deprecated: use `String::to_utf8_bytes` instead.
pub fn bytes_from_string(s: String) -> Vec<i32> {
    s.to_utf8_bytes()
}

/// Decode the buffer as UTF-8, replacing each invalid sequence with U+FFFD.
/// Deprecated: use `String::from_utf8_lossy` instead.
pub fn string_from_bytes(b: Vec<i32>) -> String {
    String::from_utf8_lossy(b)
}

/// Deprecated: use `Vec::len` instead.
pub fn bytes_len(b: Vec<i32>) -> i32 {
    b.len()
}

/// Deprecated: use `Vec::get_unchecked` instead.
pub fn bytes_get(b: Vec<i32>, index: i32) -> i32 {
    b.get_unchecked(index)
}

/// Deprecated: use `Vec::push_byte` instead.
pub fn bytes_push(b: Vec<i32>, byte: i32) {
    b.push_byte(byte)
}

/// Deprecated: use `Vec::equals_bytes` instead.
pub fn bytes_eq(a: Vec<i32>, b: Vec<i32>) -> bool {
    a.equals_bytes(b)
}

/// Concatenate two byte buffers into a new one.
/// Deprecated: use `Vec::concat_bytes` instead.
pub fn bytes_concat(a: Vec<i32>, b: Vec<i32>) -> Vec<i32> {
    a.concat_bytes(b)
}

/// Extract a sub-range of bytes as a new buffer.
/// Deprecated: use `Vec::slice_bytes` instead.
pub fn bytes_slice(b: Vec<i32>, start: i32, end: i32) -> Vec<i32> {
    b.slice_bytes(start, end)
}

/// Deprecated: use `String::len_bytes` instead.
pub fn byte_length(s: String) -> i32 {
    s.len_bytes()
}

// --- Hex encoding ---
fn hex_char(nibble: i32) -> String {
    if nibble < 10 {
        (nibble).to_string()
    } else {
        if nibble == 10 {
            "a"
        } else {
            if nibble == 11 {
                "b"
            } else {
                if nibble == 12 {
                    "c"
                } else {
                    if nibble == 13 {
                        "d"
                    } else {
                        if nibble == 14 {
                            "e"
                        } else {
                            "f"
                        }
                    }
                }
            }
        }
    }
}

/// Deprecated: use `Vec::to_hex` instead.
pub fn hex_encode(b: Vec<i32>) -> String {
    b.to_hex()
}

fn hex_val_char(ch: String) -> i32 {
    if eq(ch, "0") {
        0
    } else {
        if eq(ch, "1") {
            1
        } else {
            if eq(ch, "2") {
                2
            } else {
                if eq(ch, "3") {
                    3
                } else {
                    if eq(ch, "4") {
                        4
                    } else {
                        if eq(ch, "5") {
                            5
                        } else {
                            if eq(ch, "6") {
                                6
                            } else {
                                if eq(ch, "7") {
                                    7
                                } else {
                                    if eq(ch, "8") {
                                        8
                                    } else {
                                        if eq(ch, "9") {
                                            9
                                        } else {
                                            if eq(ch, "a") {
                                                10
                                            } else {
                                                if eq(ch, "b") {
                                                    11
                                                } else {
                                                    if eq(ch, "c") {
                                                        12
                                                    } else {
                                                        if eq(ch, "d") {
                                                            13
                                                        } else {
                                                            if eq(ch, "e") {
                                                                14
                                                            } else {
                                                                if eq(ch, "f") {
                                                                    15
                                                                } else {
                                                                    if eq(ch, "A") {
                                                                        10
                                                                    } else {
                                                                        if eq(ch, "B") {
                                                                            11
                                                                        } else {
                                                                            if eq(ch, "C") {
                                                                                12
                                                                            } else {
                                                                                if eq(ch, "D") {
                                                                                    13
                                                                                } else {
                                                                                    if eq(ch, "E") {
                                                                                        14
                                                                                    } else {
                                                                                        if eq(ch, "F") {
                                                                                            15
                                                                                        } else {
                                                                                            0 - 1
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

