                                                                                                                                                                                                                50
                                                                                                                                                                                                            } else {
                                                                                                                                                                                                                if eq(c, "z") {
                                                                                                                                                                                                                    51
                                                                                                                                                                                                                } else {
                                                                                                                                                                                                                    if eq(c, "0") {
                                                                                                                                                                                                                        52
                                                                                                                                                                                                                    } else {
                                                                                                                                                                                                                        if eq(c, "1") {
                                                                                                                                                                                                                            53
                                                                                                                                                                                                                        } else {
                                                                                                                                                                                                                            if eq(c, "2") {
                                                                                                                                                                                                                                54
                                                                                                                                                                                                                            } else {
                                                                                                                                                                                                                                if eq(c, "3") {
                                                                                                                                                                                                                                    55
                                                                                                                                                                                                                                } else {
                                                                                                                                                                                                                                    if eq(c, "4") {
                                                                                                                                                                                                                                        56
                                                                                                                                                                                                                                    } else {
                                                                                                                                                                                                                                        if eq(c, "5") {
                                                                                                                                                                                                                                            57
                                                                                                                                                                                                                                        } else {
                                                                                                                                                                                                                                            if eq(c, "6") {
                                                                                                                                                                                                                                                58
                                                                                                                                                                                                                                            } else {
                                                                                                                                                                                                                                                if eq(c, "7") {
                                                                                                                                                                                                                                                    59
                                                                                                                                                                                                                                                } else {
                                                                                                                                                                                                                                                    if eq(c, "8") {
                                                                                                                                                                                                                                                        60
                                                                                                                                                                                                                                                    } else {
                                                                                                                                                                                                                                                        if eq(c, "9") {
                                                                                                                                                                                                                                                            61
                                                                                                                                                                                                                                                        } else {
                                                                                                                                                                                                                                                            if eq(c, "+") {
                                                                                                                                                                                                                                                                62
                                                                                                                                                                                                                                                            } else {
                                                                                                                                                                                                                                                                if eq(c, "/") {
                                                                                                                                                                                                                                                                    63
                                                                                                                                                                                                                                                                } else {
                                                                                                                                                                                                                                                                    0 - 1
                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                }
                                                                                                                                                                                                                            }
                                                                                                                                                                                                                        }
                                                                                                                                                                                                                    }
                                                                                                                                                                                                                }
                                                                                                                                                                                                            }
                                                                                                                                                                                                        }
                                                                                                                                                                                                    }
                                                                                                                                                                                                }
                                                                                                                                                                                            }
                                                                                                                                                                                        }
                                                                                                                                                                                    }
                                                                                                                                                                                }
                                                                                                                                                                            }
                                                                                                                                                                        }
                                                                                                                                                                    }
                                                                                                                                                                }
                                                                                                                                                            }
                                                                                                                                                        }
                                                                                                                                                    }
                                                                                                                                                }
