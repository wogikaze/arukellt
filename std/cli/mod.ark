//! std::cli — command-line parsing over an explicit argument vector.
//!
//! Argument-vector reads live on `std::host::env::Env`: `Env::args`,
//! `Env::arg_count`, `Env::arg_at`, and `Env::has_flag`. `Cli` owns the
//! helpers that scan an explicit `Vec<String>` (typically produced by
//! `Env::args()`): `Cli::flag` and `Cli::option` (ADR-046). The module exposes
//! no free function.
use std::prelude::{slice}
use std::text

/// Namespace for command-line parsing helpers over an explicit argument vector.
pub struct Cli {}

impl Cli {
    /// Returns `true` when `args` contains `name` verbatim.
    ///
    /// Unlike `Env::has_flag`, this takes an explicit argument vector so the
    /// caller can pass a filtered or synthetic list.
    fn flag(args: Vec<String>, name: String) -> bool {
        let mut i = 0
        while i < len(args) {
            if get_unchecked(args, i) == name {
                return true
            }
            i = i + 1
        }
        false
    }

    /// Looks for `name` or `name=<value>` in `args` and returns the associated
    /// value, or `None` when not found.
    ///
    /// Supported forms:
    /// - `--flag value`  (next element)
    /// - `--flag=value`  (embedded `=`)
    fn option(args: Vec<String>, name: String) -> Option<String> {
        let n = len(args)
        let prefix = name.concat("=")
        let prefix_len = len(prefix)
        let mut i = 0
        while i < n {
            let arg = get_unchecked(args, i)
            let arg_len = len(arg)
            if arg_len > prefix_len {
                let head = slice(arg, 0, prefix_len)
                if head == prefix {
                    return Some(slice(arg, prefix_len, arg_len))
                }
            }
            if arg == name && i + 1 < n {
                return Some(get_unchecked(args, i + 1))
            }
            i = i + 1
        }
        None
    }
}
