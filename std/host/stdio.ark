//! Host standard I/O helpers backed by the print and stdin intrinsics.
//!
//! `Stdio` is the only public surface of this module (ADR-046, ADR-094):
//! `Stdio::read_stdin`, `Stdio::print`, `Stdio::println`, and
//! `Stdio::eprintln`. The module exposes no free function.
//!
//! These APIs are explicitly host-bound. Byte-faithful typed sinks are
//! `std::io::Stdout` / `std::io::Stderr`; this module keeps the string-shaped
//! standard-stream helpers.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). Requires WASI stdout/stderr capability.

/// Namespace for the host standard-stream operations.
pub struct Stdio {}

impl Stdio {
    /// Reads stdin until EOF and returns the bytes read as a `String`.
    ///
    /// Returns an empty string when stdin is already at EOF.
    fn read_stdin() -> String {
        // The `__intrinsic_stdin_read_to_string` binding lowers to the
        // runtime.read_stdin handler; the body keeps the declaration describing
        // the real stdin contract for a path that resolves it directly, instead
        // of leaving a placeholder that silently returns "".
        __intrinsic_stdin_read_to_string()
    }

    /// Writes a string to stdout without appending a newline.
    ///
    /// `String<__Printable>` is the declared print boundary: the emitter
    /// converts String, char, bool, i32, i64 and f64 arguments to String before
    /// this call, so the parameter keeps those source types legal without
    /// pretending a scalar is already a String. `__Printable` is an internal
    /// marker type argument; the representation stays String and the
    /// typechecker owns the accepted set.
    fn print(s: String<__Printable>) {
        __intrinsic_print(s)
    }

    /// Writes a string to stdout and appends a newline.
    fn println(s: String<__Printable>) {
        __intrinsic_println(s)
    }

    /// Writes a string to stderr and appends a newline.
    fn eprintln(s: String<__Printable>) {
        __intrinsic_eprintln(s)
    }
}
