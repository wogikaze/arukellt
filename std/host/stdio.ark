//! Host standard I/O helpers backed by the current print and stdin intrinsics.
//!
//! These APIs are explicitly host-bound. They are not part of the pure
//! standard-library surface and must be imported from `std::host::stdio`.
//! Byte-faithful typed sinks are `std::io::Stdout` / `std::io::Stderr`; this
//! module keeps the string-shaped `print` / `println` / `eprintln` helpers.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). Requires WASI stdout/stderr capability.

/// Reads stdin until EOF and returns the bytes read as a `String`.
///
/// Returns an empty string when stdin is already at EOF.
pub fn read_stdin() -> String {
    // Call sites of `stdio::read_stdin` are lowered to the runtime.read_stdin
    // CoreOp (see corehir/core_op_binding_generated.ark), so an emitted program
    // does not call this definition. The intrinsic body keeps the declaration
    // describing the real stdin contract for a path that resolves it
    // directly, instead of leaving a placeholder that silently returns "".
    __intrinsic_stdin_read_to_string()
}

/// Writes a string to stdout without appending a newline.
pub fn print(s: String) {
    __intrinsic_print(s)
}

/// Writes a string to stdout and appends a newline.
pub fn println(s: String) {
    __intrinsic_println(s)
}

/// Writes a string to stderr and appends a newline.
pub fn eprintln(s: String) {
    __intrinsic_eprintln(s)
}
