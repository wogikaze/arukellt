//! Host clock helpers.
//!
//! Provides monotonic and wall-clock time reads backed by WASI clock intrinsics.
//! Clock reads are host-bound. Pure duration math lives in `std::time`.
//!
//! The `Clock` namespace type is the only host surface (ADR-046): the stable
//! free functions were deleted in the ADR-087 Wave 2 change, so a qualified old
//! free call fails with an E0100 hint that names `Clock`.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). Requires `--allow-clock` capability.

/// Namespace for the host clock reads.
///
/// The associated functions are the canonical spelling; the WASI clock
/// intrinsics stay behind this impl.
pub struct Clock {}

impl Clock {
    /// Returns a monotonic timestamp in nanoseconds.
    ///
    /// The value is suitable for measuring elapsed time and is not a
    /// wall-clock reading.
    fn monotonic_now() -> i64 {
        __intrinsic_clock_now()
    }

    /// Returns the current wall-clock time in milliseconds since the Unix epoch.
    fn now_ms() -> i64 {
        __intrinsic_clock_now_ms()
    }
}
