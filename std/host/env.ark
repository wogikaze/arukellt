//! Host environment helpers.
//!
//! Arguments use the existing WASI CLI path. Environment and current working
//! directory use the versioned runtime ABI so WASI P2 components can run under
//! stock Wasmtime without an Arukellt-specific host linker.

pub fn args() -> Vec<String> {
    __intrinsic_args()
}

pub fn arg_count() -> i32 {
    __intrinsic_arg_count()
}

pub fn arg_at(index: i32) -> Option<String> {
    let v = args()
    if index < 0 || index >= len(v) {
        return None
    }
    Some(get_unchecked(v, index))
}

pub fn var(name: String) -> Option<String> {
    __runtime_abi_env_var(name)
}

pub fn get_var(name: String) -> Option<String> {
    __runtime_abi_env_var(name)
}

pub fn var_or_default(name: String, default: String) -> String {
    match __runtime_abi_env_var(name) {
        Option::Some(v) => v,
        Option::None => default,
    }
}

/// Returns a stable snapshot encoding of the environment.
///
/// Records are NUL-delimited `KEY=VALUE` strings. This documented snapshot
/// format is the portable equivalent of an environment iterator until the
/// language has a first-class iterator over host key/value pairs.
pub fn vars_snapshot() -> Result<String, String> {
    __runtime_abi_env_vars()
}

/// Returns the runtime current directory as a UTF-8 string.
pub fn current_dir() -> Result<String, String> {
    __runtime_abi_env_current_dir()
}

pub fn has_flag(flag: String) -> bool {
    let values = args()
    let mut i = 0
    while i < len(values) {
        if get_unchecked(values, i) == flag {
            return true
        }
        i = i + 1
    }
    false
}
