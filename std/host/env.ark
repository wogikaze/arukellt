//! Host environment helpers.
//!
//! Arguments and environment lookups use the direct WASI intrinsics.
//!
//! `Env` is the namespace for the host environment reads (ADR-046):
//! `Env::var`, `Env::arg_count`, `Env::arg_at`, and `Env::var_or_default`.
//! `Env::args` stays blocked on wasm32-gc because a direct `__intrinsic_args`
//! call inside a namespace method leaves the MIR result scalar and emits an
//! invalid i64/ref frame (#917); the module-level `args` free function remains
//! the argument-vector spelling until that lowering is fixed.

use std::prelude::{values}

/// Namespace for the host environment reads.
pub struct Env {}

impl Env {
    /// Looks up an environment variable by name.
    ///
    /// Returns `None` when the variable is unset or the target does not
    /// support environment variable access.
    fn var(name: String) -> Option<String> {
        // The typed binding pins the Option<String> GC layout; without it the
        // direct intrinsic call leaves the MIR temp scalar and emits an
        // invalid i64/ref frame on wasm32-gc (#917).
        let value: Option<String> = __runtime_abi_env_var(name)
        value
    }

    /// Returns the number of process arguments (excluding argv[0]).
    fn arg_count() -> i32 {
        __intrinsic_arg_count()
    }

    /// Returns the argument at `index`, or `None` when out of range.
    fn arg_at(index: i32) -> Option<String> {
        // Same GC-layout constraint as `Env::var` above (#917).
        let value: Option<String> = __intrinsic_arg_at(index)
        value
    }

    /// Returns the value of environment variable `name`, or `default` when absent.
    fn var_or_default(name: String, default: String) -> String {
        match Env::var(name) {
            Option::Some(value) => value,
            Option::None => default,
        }
    }
}

pub fn args() -> Vec<String> {
    __intrinsic_args()
}

pub fn arg_count() -> i32 {
    __intrinsic_arg_count()
}

pub fn arg_at(index: i32) -> Option<String> {
    let v = args()
    if index < 0 || index >= len(v) {
        return None
    }
    Some(get_unchecked(v, index))
}

pub fn var(name: String) -> Option<String> {
    __runtime_abi_env_var(name)
}

pub fn var_or_default(name: String, default: String) -> String {
    match __runtime_abi_env_var(name) {
        Option::Some(v) => v,
        Option::None => default,
    }
}

pub fn has_flag(flag: String) -> bool {
    let values = args()
    let mut i = 0
    while i < len(values) {
        if get_unchecked(values, i) == flag {
            return true
        }
        i = i + 1
    }
    false
}
