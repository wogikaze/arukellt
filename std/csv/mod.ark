//! CSV parser/serializer for std::csv.
//!
//! Supports RFC 4180 quoted fields and basic multi-row documents. The public
//! surface is the `Csv` namespace (`split_line`, `parse_row`, `stringify_row`,
//! `count_rows`, `get_row_raw`, `parse_row_at`, `parse`, `stringify`,
//! `parse_with_header`); the former `csv_*` frees are private implementation
//! details (#917, ADR-046).
// ─── Legacy helper ───────────────────────────────────────────────────────────
use std::text

/// Namespace for RFC 4180 CSV row and document helpers.
pub struct Csv {}

impl Csv {
    /// Split a line on commas without quote handling.
    fn split_line(line: String) -> Vec<String> {
        csv_impl_split_line(line)
    }

    /// Parse a single CSV line into fields, honoring quoted fields.
    fn parse_row(line: String) -> Vec<String> {
        csv_impl_parse_row(line)
    }

    /// Serialize one row of fields to a CSV line.
    fn stringify_row(fields: Vec<String>) -> String {
        csv_impl_stringify_row(fields)
    }

    /// Count non-empty lines in a CSV document.
    fn count_rows(s: String) -> i32 {
        csv_impl_count_rows(s)
    }

    /// Return the raw text of the row at `row_index`.
    fn get_row_raw(s: String, row_index: i32) -> String {
        csv_impl_get_row_raw(s, row_index)
    }

    /// Parse the row at `row_index` from a multi-row CSV string.
    fn parse_row_at(s: String, row_index: i32) -> Vec<String> {
        csv_impl_parse_row_at(s, row_index)
    }

    /// Parse a CSV document into rows.
    fn parse(s: String) -> Result<Vec<Vec<String>>, String> {
        csv_impl_parse(s)
    }

    /// Serialize rows to a CSV document.
    fn stringify(rows: Vec<Vec<String>>) -> String {
        csv_impl_stringify(rows)
    }

    /// Parse a CSV document and return its header row.
    fn parse_with_header(s: String) -> Result<Vec<String>, String> {
        csv_impl_parse_with_header(s)
    }
}
/// Split a single CSV line on commas (no quote handling).
fn csv_impl_split_line(line: String) -> Vec<String> {
    line.split(String_from(","))
}

// ─── RFC 4180 row parser ─────────────────────────────────────────────────────
/// Parse a single CSV line into fields, handling RFC 4180 quoted fields.
///
/// Quoted fields may contain embedded commas, double-quotes (escaped as `""`),
/// and newlines.
fn csv_impl_parse_row(line: String) -> Vec<String> {
    let mut result = Vec::new<String>()
    let n = line.len()
    let mut i = 0
    while i <= n {
        let mut field = ""
        if i < n && line.byte_at(i) == 34 {
            i = i + 1
            while i < n {
                let c = line.byte_at(i)
                if c == 34 {
                    if i + 1 < n && line.byte_at(i + 1) == 34 {
                        field = field.concat("\"")
                        i = i + 2
                    } else {
                        i = i + 1
                        break
                    }
                } else {
                    field = field.concat(line.slice(i, i + 1))
                    i = i + 1
                }
            }
            if i < n && line.byte_at(i) == 44 {
                i = i + 1
            }
        } else {
            let start = i
            while i < n && line.byte_at(i) != 44 {
                i = i + 1
            }
            field = line.slice(start, i)
            if i < n {
                i = i + 1
            }
        }
        result.push(field)
        if i == n && n > 0 && line.byte_at(n - 1) == 44 {
            result.push("")
        }
        if i >= n {
            break
        }
    }
    result
}

/// Serialize a row of fields back to a CSV line.
///
/// Fields that contain commas, double-quotes, or newlines are quoted.
fn csv_impl_stringify_row(fields: Vec<String>) -> String {
    let n = fields.len()
    let mut result = ""
    let mut i = 0
    while i < n {
        if i > 0 {
            result = result.concat(",")
        }
        let field = fields.get_unchecked(i)
        let needs_quote = field.contains(",") || field.contains("\"") || field.contains("\n")
        if needs_quote {
            let escaped = field.replace("\"", "\"\"")
            result = result.concat("\"".concat(escaped.concat("\"")))
        } else {
            result = result.concat(field)
        }
        i = i + 1
    }
    result
}

// ─── Multi-row accessors ─────────────────────────────────────────────────────
/// Count the number of non-empty lines in a CSV string.
fn csv_impl_count_rows(s: String) -> i32 {
    let lines = s.split("\n")
    let n = lines.len()
    let mut count = 0
    let mut i = 0
    while i < n {
        let line = lines.get_unchecked(i)
        if line.len() > 0 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

/// Return the raw text of row `row_index` (0-based, skipping empty lines).
fn csv_impl_get_row_raw(s: String, row_index: i32) -> String {
    let lines = s.split("\n")
    let n = lines.len()
    let mut current = 0
    let mut i = 0
    while i < n {
        let line = lines.get_unchecked(i)
        if line.len() > 0 {
            if current == row_index {
                return line
            }
            current = current + 1
        }
        i = i + 1
    }
    ""
}

/// Parse row `row_index` from a multi-row CSV string.
fn csv_impl_parse_row_at(s: String, row_index: i32) -> Vec<String> {
    csv_impl_parse_row(csv_impl_get_row_raw(s, row_index))
}

/// Parse a full CSV document into rows.
fn csv_impl_parse(s: String) -> Result<Vec<Vec<String>>, String> {
    let lines = s.split("\n")
    let n = lines.len()
    if n == 0 {
        return Err("empty document")
    }
    let mut rows = Vec::new<Vec<String>>()
    let mut i = 0
    while i < n {
        let line = lines.get_unchecked(i)
        if line.len() > 0 {
            rows.push(csv_impl_parse_row(line))
        }
        i = i + 1
    }
    Ok(rows)
}

/// Serialize rows to a CSV document.
fn csv_impl_stringify(rows: Vec<Vec<String>>) -> String {
    let n = rows.len()
    let mut out = ""
    let mut i = 0
    while i < n {
        if i > 0 {
            out = out.concat("\n")
        }
        out = out.concat(csv_impl_stringify_row(rows.get_unchecked(i)))
        i = i + 1
    }
    out
}

/// Parse a CSV document with a header row.
///
/// Returns `(header_fields, rows)` — the first row becomes the header and
/// the remaining rows are returned as separate Vec<String> rows packed into
/// a flat Vec<String> with field_count-wide strides.
///
/// NOTE: the simple flat encoding means row `i` starts at
/// `header.len() * i` in the body vector.
fn csv_impl_parse_with_header(s: String) -> Result<Vec<String>, String> {
    let lines = s.split("\n")
    let n = lines.len()
    if n == 0 {
        return Err("empty document")
    }
    let first_line = lines.get_unchecked(0)
    if first_line.len() == 0 {
        return Err("empty header")
    }
    Ok(csv_impl_parse_row(first_line))
}
// Parse one field
// Quoted field
// Escaped quote ""
// End of quoted field
// Skip comma after closing quote
// Unquoted field — read until comma or end
// Trailing comma — add empty field
// Escape embedded double-quotes
// Return just the header fields for simplicity; callers can re-parse rows
