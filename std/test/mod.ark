//! Testing utilities for fixture and example code.
//!
//! The current module provides typed assertions and expectation helpers for
//! `Result` and `Option`.
use std::core::cmp
use std::core::convert

// === Typed assertions ===
use std::prelude::{contains}
use std::text
pub fn assert_true(cond: bool) {
    if !cond {
        panic("assertion failed: expected true, got false")
    }
}

pub fn assert_false(cond: bool) {
    if cond {
        panic("assertion failed: expected false, got true")
    }
}

/// Generic equality assertion. On failure, both values are rendered with
/// `Debug` (`fmt_debug`), matching Rust `assert_eq!` diagnostic style.
///
/// Named `assert_eq_debug` (not `assert_eq`) because bare `assert_eq` is a
/// CoreOp-bound prelude symbol; a same-named stdlib generic currently
/// mis-lowers scalar monomorphizations (`structref` vs `i32`).
pub fn assert_eq_debug<T: Eq + Debug>(actual: T, expected: T) {
    if !actual.eq(expected) {
        let msg = text::concat("assert_eq failed: expected ", text::concat(expected.fmt_debug(), text::concat(", got ", actual.fmt_debug())))
        panic(msg)
    }
}

pub fn assert_eq_i32(actual: i32, expected: i32) {
    if actual != expected {
        let msg = text::concat("assert_eq_i32 failed: expected ", text::concat((expected).fmt_debug(), text::concat(", got ", (actual).fmt_debug())))
        panic(msg)
    }
}

pub fn assert_eq_i64(actual: i64, expected: i64) {
    if actual != expected {
        let msg = text::concat("assert_eq_i64 failed: expected ", text::concat((expected).fmt_debug(), text::concat(", got ", (actual).fmt_debug())))
        panic(msg)
    }
}

pub fn assert_eq_f64(actual: f64, expected: f64) {
    if actual != expected {
        let msg = text::concat("assert_eq_f64 failed: expected ", text::concat((expected).fmt_debug(), text::concat(", got ", (actual).fmt_debug())))
        panic(msg)
    }
}

pub fn assert_eq_string(actual: String, expected: String) {
    if !__intrinsic_string_eq(actual, expected) {
        let msg = text::concat("assert_eq_string failed: expected ", text::concat((expected).fmt_debug(), text::concat(", got ", (actual).fmt_debug())))
        panic(msg)
    }
}

pub fn assert_eq_bool(actual: bool, expected: bool) {
    if actual != expected {
        let msg = text::concat("assert_eq_bool failed: expected ", text::concat((expected).fmt_debug(), text::concat(", got ", (actual).fmt_debug())))
        panic(msg)
    }
}

pub fn assert_ne_i32(actual: i32, unexpected: i32) {
    if actual == unexpected {
        let msg = text::concat("assert_ne_i32 failed: values should differ, both are ", (actual).to_string())
        panic(msg)
    }
}

pub fn assert_ne_string(actual: String, unexpected: String) {
    if actual == unexpected {
        let msg = text::concat("assert_ne_string failed: values should differ, both are \"", text::concat(actual, "\""))
        panic(msg)
    }
}

// === Result/Option expectations ===
pub fn expect_ok_i32(r: Result<i32, String>) -> i32 {
    match r {
        Result::Ok(v) => v,
        Result::Err(e) => {
            let msg = text::concat("expect_ok_i32: got Err(\"", text::concat(e, "\")"))
            panic(msg)
            0
        },
    }
}

pub fn expect_err_string(r: Result<i32, String>) -> String {
    match r {
        Result::Ok(v) => {
            let msg = text::concat("expect_err_string: got Ok(", text::concat((v).to_string(), ")"))
            panic(msg)
            String_new()
        },
        Result::Err(e) => e,
    }
}

pub fn expect_some_i32(o: Option<i32>) -> i32 {
    match o {
        Option::Some(v) => v,
        None => {
            panic("expect_some_i32: got None")
            0
        },
    }
}

pub fn expect_none_i32(o: Option<i32>) {
    match o {
        Option::Some(v) => {
            let msg = text::concat("expect_none_i32: got Some(", text::concat((v).to_string(), ")"))
            panic(msg)
        },
        None => {
        },
    }
}

// === Snapshot / comparison helpers ===
/// Assert that a string contains a given substring.
pub fn assert_contains(haystack: String, needle: String) {
    if !contains(haystack, needle) {
        let msg = text::concat("assert_contains failed: \"", text::concat(haystack, text::concat("\" does not contain \"", text::concat(needle, "\""))))
        panic(msg)
    }
}

/// Assert that two strings are equal, showing expected and actual blocks on failure.
pub fn assert_eq_snapshot(actual: String, expected: String) {
    if actual != expected {
        let msg = text::concat("snapshot mismatch:\n--- expected ---\n", text::concat(expected, text::concat("\n--- actual ---\n", actual)))
        panic(msg)
    }
}

/// Assert that a boolean condition holds, with a custom failure message.
pub fn assert_msg(cond: bool, message: String) {
    if !cond {
        panic(text::concat("assertion failed: ", message))
    }
}

// === bench-lite ===
/// Run `f` exactly `iterations` times and write a timing summary to stderr.
///
/// Outputs a line of the form:
/// bench: <name>: total=<ns>ns iters=<n>
///
/// Timing uses the monotonic clock intrinsic. Output goes to stderr so that
/// fixture stdout remains deterministic.
pub fn bench(name: String, iterations: i32, f: fn() -> ()) {
    let start: i64 = __intrinsic_clock_now()
    let mut i: i32 = 0
    while i < iterations {
        f()
        i = i + 1
    }
    let elapsed: i64 = __intrinsic_clock_now() - start
    let msg = text::concat("bench: ", text::concat(name, text::concat(": total=", text::concat((elapsed).to_string(), text::concat("ns iters=", (iterations).to_string())))))
    __intrinsic_eprintln(msg)
}
