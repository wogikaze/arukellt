// ---------------------------------------------------------------------------
// IntoIterator identity conversions for concrete lazy adapters
// ---------------------------------------------------------------------------

// An iterator is already an iterable source. These identity conversions keep
// `for` on the same trait boundary as collection sources without allocating or
// changing the adapter state.
impl IntoIterator for MapIter<T, U> {
    type Item = U
    type IntoIter = MapIter<T, U>

    fn into_iter(self: MapIter<T, U>) -> MapIter<T, U> {
        self
    }
}

impl IntoIterator for MapFilterIter<T, U> {
    type Item = U
    type IntoIter = MapFilterIter<T, U>

    fn into_iter(self: MapFilterIter<T, U>) -> MapFilterIter<T, U> {
        self
    }
}

impl IntoIterator for FilterIter<T> {
    type Item = T
    type IntoIter = FilterIter<T>

    fn into_iter(self: FilterIter<T>) -> FilterIter<T> {
        self
    }
}

impl IntoIterator for FilterMapIter<T> {
    type Item = T
    type IntoIter = FilterMapIter<T>

    fn into_iter(self: FilterMapIter<T>) -> FilterMapIter<T> {
        self
    }
}

impl IntoIterator for TakeIter<I> {
    type Item = I::Item
    type IntoIter = TakeIter<I>

    fn into_iter(self: TakeIter<I>) -> TakeIter<I> {
        self
    }
}

impl IntoIterator for SkipIter<I> {
    type Item = I::Item
    type IntoIter = SkipIter<I>

    fn into_iter(self: SkipIter<I>) -> SkipIter<I> {
        self
    }
}

impl IntoIterator for SkipMapIter<VecIter> {
    type Item = i32
    type IntoIter = SkipMapIter<VecIter>

    fn into_iter(self: SkipMapIter<VecIter>) -> SkipMapIter<VecIter> {
        self
    }
}

impl IntoIterator for SkipFilterIter<VecIter> {
    type Item = i32
    type IntoIter = SkipFilterIter<VecIter>

    fn into_iter(self: SkipFilterIter<VecIter>) -> SkipFilterIter<VecIter> {
        self
    }
}

impl IntoIterator for ChainIter<I> {
    type Item = I::Item
    type IntoIter = ChainIter<I>

    fn into_iter(self: ChainIter<I>) -> ChainIter<I> {
        self
    }
}

impl IntoIterator for EnumerateIter<I> {
    type Item = Pair<i32, I::Item>
    type IntoIter = EnumerateIter<I>

    fn into_iter(self: EnumerateIter<I>) -> EnumerateIter<I> {
        self
    }
}

impl IntoIterator for ZipIter<A, B> {
    type Item = Pair<A::Item, B::Item>
    type IntoIter = ZipIter<A, B>

    fn into_iter(self: ZipIter<A, B>) -> ZipIter<A, B> {
        self
    }
}

impl IntoIterator for UniqueIter {
    type Item = i32
    type IntoIter = UniqueIter

    fn into_iter(self: UniqueIter) -> UniqueIter {
        self
    }
}

impl IntoIterator for RevIter {
    type Item = i32
    type IntoIter = RevIter

    fn into_iter(self: RevIter) -> RevIter {
        self
    }
}

// ---------------------------------------------------------------------------
// collect — drain an iterator into a Vec<i32>
// ---------------------------------------------------------------------------

/// Drain a `VecIter` into a new `Vec<i32>`.
pub fn collect_vec_iter(it: VecIter) -> Vec<i32> {
    it.collect()
}

/// Drain a `MapIter` into a new `Vec<i32>`.
pub fn collect_map_iter(it: MapIter<i32, i32>) -> Vec<i32> {
    it.collect()
}

/// Drain a `FilterIter` into a new `Vec<i32>`.
pub fn collect_filter_iter(it: FilterIter<i32>) -> Vec<i32> {
    it.collect()
}

/// Drain a `TakeIter` into a new `Vec<i32>`.
pub fn collect_take_iter(it: TakeIter<VecIter>) -> Vec<i32> {
    it.collect()
}

/// Drain a `SkipIter` into a new `Vec<i32>`.
pub fn collect_skip_iter(it: SkipIter<VecIter>) -> Vec<i32> {
    it.collect()
}

/// Drain a `ChainIter` into a new `Vec<i32>`.
pub fn collect_chain_iter(it: ChainIter<VecIter>) -> Vec<i32> {
    it.collect()
}

/// Drain a `RangeIter` into a new `Vec<i32>`.
pub fn collect_range_iter(it: RangeIter) -> Vec<i32> {
    it.collect()
}

// ---------------------------------------------------------------------------
// FromIterator impl for Vec<i32>
// ---------------------------------------------------------------------------

/// `FromIterator<i32>` impl for `Vec<i32>` — drains a `VecIter`.
impl FromIterator<VecIter> for Vec<i32> {
    fn from_iter(it: VecIter) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<i32>` impl for `Vec<i32>` — drains a half-open range.
impl FromIterator<RangeIter> for Vec<i32> {
    fn from_iter(it: RangeIter) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<i32>` impl for `Vec<i32>` — drains a closed range.
impl FromIterator<RangeInclusiveIter> for Vec<i32> {
    fn from_iter(it: RangeInclusiveIter) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<SkipMapIter>` impl for `Vec<i32>` — maps after skip.
impl FromIterator<SkipMapIter<VecIter>> for Vec<i32> {
    fn from_iter(it: SkipMapIter<VecIter>) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<SkipFilterIter>` impl for `Vec<i32>` — filters after skip.
impl FromIterator<SkipFilterIter<VecIter>> for Vec<i32> {
    fn from_iter(it: SkipFilterIter<VecIter>) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<StringIter>` impl for `Vec<String>` — preserves each item.
impl FromIterator<StringIter> for Vec<String> {
    fn from_iter(it: StringIter) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<MapIter<String, String>>` impl for `Vec<String>` — preserves mapped items.
impl FromIterator<MapIter<String, String>> for Vec<String> {
    fn from_iter(it: MapIter<String, String>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<FilterIter<String>>` impl for `Vec<String>` — preserves accepted items.
impl FromIterator<FilterIter<String>> for Vec<String> {
    fn from_iter(it: FilterIter<String>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<TakeIter<MapIter<String, String>>>` impl for `Vec<String>` — keeps the bound.
impl FromIterator<TakeIter<MapIter<String, String>>> for Vec<String> {
    fn from_iter(it: TakeIter<MapIter<String, String>>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<TakeIter<FilterIter<String>>>` impl for `Vec<String>` — keeps accepted items.
impl FromIterator<TakeIter<FilterIter<String>>> for Vec<String> {
    fn from_iter(it: TakeIter<FilterIter<String>>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<MapFilterIter<String, String>>` impl for `Vec<String>` — preserves filtered mapped items.
impl FromIterator<MapFilterIter<String, String>> for Vec<String> {
    fn from_iter(it: MapFilterIter<String, String>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<FilterMapIter<String>>` impl for `Vec<String>` — maps accepted items.
impl FromIterator<FilterMapIter<String>> for Vec<String> {
    fn from_iter(it: FilterMapIter<String>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<TakeIter<MapFilterIter<String, String>>>` impl for `Vec<String>` — bounds accepted mapped items.
impl FromIterator<TakeIter<MapFilterIter<String, String>>> for Vec<String> {
    fn from_iter(it: TakeIter<MapFilterIter<String, String>>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<TakeIter<FilterMapIter<String>>>` impl for `Vec<String>` — bounds mapped accepted items.
impl FromIterator<TakeIter<FilterMapIter<String>>> for Vec<String> {
    fn from_iter(it: TakeIter<FilterMapIter<String>>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<StringSkipMapIter>` impl for `Vec<String>` — maps after skip.
impl FromIterator<StringSkipMapIter> for Vec<String> {
    fn from_iter(it: StringSkipMapIter) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<StringSkipFilterIter>` impl for `Vec<String>` — filters after skip.
impl FromIterator<StringSkipFilterIter> for Vec<String> {
    fn from_iter(it: StringSkipFilterIter) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<UniqueIter>` impl for `Vec<i32>` — drains first occurrences.
impl FromIterator<UniqueIter> for Vec<i32> {
    fn from_iter(it: UniqueIter) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<RevIter>` impl for `Vec<i32>` — drains in reverse order.
impl FromIterator<RevIter> for Vec<i32> {
    fn from_iter(it: RevIter) -> Vec<i32> {
        it.collect()
    }
}

// ---------------------------------------------------------------------------
// Convenience pipeline functions (single-pass, no intermediate allocation)
// ---------------------------------------------------------------------------

/// Map `f` over `v` and collect into a new `Vec<i32>`.
///
/// This is the lazy-pipeline replacement for `std::seq::map_i32_i32`.
pub fn collect_map_i32(v: Vec<i32>, f: fn(i32) -> i32) -> Vec<i32> {
    v.iter().map(f).collect()
}

/// Filter `v` with `f` and collect into a new `Vec<i32>`.
///
/// This is the lazy-pipeline replacement for `std::seq::filter_i32`.
pub fn collect_filter_i32(v: Vec<i32>, f: fn(i32) -> bool) -> Vec<i32> {
    v.iter().filter(f).collect()
}

/// Take the first `n` elements of `v` and collect into a new `Vec<i32>`.
///
/// This is the lazy-pipeline replacement for `std::seq::take_i32`.
pub fn collect_take_i32(v: Vec<i32>, n: i32) -> Vec<i32> {
    v.iter().take(n).collect()
}

/// Skip the first `n` elements of `v` and collect the rest into a new `Vec<i32>`.
///
/// This is the lazy-pipeline replacement for `std::seq::skip_i32`.
pub fn collect_skip_i32(v: Vec<i32>, n: i32) -> Vec<i32> {
    v.iter().skip(n).collect()
}

/// Chain two vectors and collect into a new `Vec<i32>`.
pub fn collect_chain_i32(first: Vec<i32>, second: Vec<i32>) -> Vec<i32> {
    collect_chain_iter(chain_iter(first, second))
}

/// Collect a `Range` into a `Vec<i32>`.
pub fn collect_range_i32(r: Range) -> Vec<i32> {
    collect_range_iter(range_iter(r))
}

/// Map then filter in a single pass — no intermediate `Vec` allocation.
///
/// This replaces the eager `std::seq::map_i32_i32` + `std::seq::filter_i32`
/// chain with a single lazy traversal.
pub fn collect_map_filter_i32(v: Vec<i32>, map_f: fn(i32) -> i32, filter_f: fn(i32) -> bool) -> Vec<i32> {
    v.iter().map(map_f).filter(filter_f).collect()
}

/// Map, filter, then take in a single pass — no intermediate `Vec` allocation.
///
/// This is the canonical lazy pipeline fixture:
/// `v.iter().map(f).filter(g).take(n).collect()`.
pub fn collect_map_filter_take_i32(v: Vec<i32>, map_f: fn(i32) -> i32, filter_f: fn(i32) -> bool, n: i32) -> Vec<i32> {
    v.iter().map(map_f).filter(filter_f).take(n).collect()
}

/// Reduce `v` to a single value using `f`, starting from `init`.
///
/// This is the lazy-pipeline replacement for `std::seq::fold_i32_i32`.
pub fn iter_fold_i32(v: Vec<i32>, init: i32, f: fn(i32, i32) -> i32) -> i32 {
    vec_iter(v).fold(init, f)
}

/// Count the number of elements yielded by the iterator.
pub fn iter_count_i32(v: Vec<i32>) -> i32 {
    len(v)
}

fn add_i32_i32(a: i32, b: i32) -> i32 {
    a + b
}

/// Sum all elements of `v`.
pub fn iter_sum_i32(v: Vec<i32>) -> i32 {
    // Named callback: anonymous `fn(...)` closures currently emit an empty-stack
    // stub on GC targets (nop/drop/unreachable), which fails wasm validation.
    iter_fold_i32(v, 0, add_i32_i32)
}

/// Returns true if any element of `v` satisfies `f`.
///
/// Lazy traversal via vec_iter(v) — short-circuits on the first hit.
pub fn iter_any_i32(v: Vec<i32>, f: fn(i32) -> bool) -> bool {
    any_iterator_i32(vec_iter(v), f)
}

/// Returns true if all elements of `v` satisfy `f`.
///
/// Lazy traversal via vec_iter(v) — short-circuits on the first miss.
pub fn iter_all_i32(v: Vec<i32>, f: fn(i32) -> bool) -> bool {
    all_iterator_i32(vec_iter(v), f)
}

/// Returns true if any element of `v` equals `target`.
///
/// This is the lazy-traversal replacement for `std::seq::seq_contains`.
pub fn iter_contains_i32(v: Vec<i32>, target: i32) -> bool {
    vec_iter(v).contains(target)
}

/// Count how many elements of `v` equal `target`.
///
/// This is the lazy-traversal replacement for `std::seq::count_eq`.
pub fn iter_count_eq_i32(v: Vec<i32>, target: i32) -> i32 {
    vec_iter(v).count_eq(target)
}

/// Yield each element of `v` only the first time it appears.
///
/// This is the lazy-pipeline replacement for `std::seq::unique`.
pub fn iter_unique_i32(v: Vec<i32>) -> Vec<i32> {
    v.iter().unique().collect()
}

/// Yield the elements of `v` in reverse order.
///
/// This is the lazy-pipeline replacement for `std::seq::seq_reverse`.
pub fn iter_reverse_i32(v: Vec<i32>) -> Vec<i32> {
    v.iter().rev().collect()
}
