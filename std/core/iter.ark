// ---------------------------------------------------------------------------
// IntoIterator identity conversions for concrete lazy adapters
// ---------------------------------------------------------------------------

// An iterator is already an iterable source. These identity conversions keep
// `for` on the same trait boundary as collection sources without allocating or
// changing the adapter state.
impl<T, U> IntoIterator for MapIter<T, U> {
    type Item = U
    type IntoIter = MapIter<T, U>

    fn into_iter(self: MapIter<T, U>) -> MapIter<T, U> {
        self
    }
}

impl<T, U> IntoIterator for MapFilterIter<T, U> {
    type Item = U
    type IntoIter = MapFilterIter<T, U>

    fn into_iter(self: MapFilterIter<T, U>) -> MapFilterIter<T, U> {
        self
    }
}

impl<T> IntoIterator for FilterIter<T> {
    type Item = T
    type IntoIter = FilterIter<T>

    fn into_iter(self: FilterIter<T>) -> FilterIter<T> {
        self
    }
}

impl<T, U> IntoIterator for FilterMapIter<T, U> {
    type Item = U
    type IntoIter = FilterMapIter<T, U>

    fn into_iter(self: FilterMapIter<T, U>) -> FilterMapIter<T, U> {
        self
    }
}

impl<I> IntoIterator for TakeIter<I> {
    type Item = I::Item
    type IntoIter = TakeIter<I>

    fn into_iter(self: TakeIter<I>) -> TakeIter<I> {
        self
    }
}

impl<I> IntoIterator for SkipIter<I> {
    type Item = I::Item
    type IntoIter = SkipIter<I>

    fn into_iter(self: SkipIter<I>) -> SkipIter<I> {
        self
    }
}

impl<I> IntoIterator for SkipMapIter<I> {
    type Item = I::Item
    type IntoIter = SkipMapIter<I>

    fn into_iter(self: SkipMapIter<I>) -> SkipMapIter<I> {
        self
    }
}

impl<I> IntoIterator for SkipFilterIter<I> {
    type Item = I::Item
    type IntoIter = SkipFilterIter<I>

    fn into_iter(self: SkipFilterIter<I>) -> SkipFilterIter<I> {
        self
    }
}

impl<I> IntoIterator for ChainIter<I> {
    type Item = I::Item
    type IntoIter = ChainIter<I>

    fn into_iter(self: ChainIter<I>) -> ChainIter<I> {
        self
    }
}

impl<I> IntoIterator for EnumerateIter<I> {
    type Item = Pair<i32, I::Item>
    type IntoIter = EnumerateIter<I>

    fn into_iter(self: EnumerateIter<I>) -> EnumerateIter<I> {
        self
    }
}

impl<A, B> IntoIterator for ZipIter<A, B> {
    type Item = Pair<A::Item, B::Item>
    type IntoIter = ZipIter<A, B>

    fn into_iter(self: ZipIter<A, B>) -> ZipIter<A, B> {
        self
    }
}

impl IntoIterator for UniqueIter {
    type Item = i32
    type IntoIter = UniqueIter

    fn into_iter(self: UniqueIter) -> UniqueIter {
        self
    }
}

impl IntoIterator for RevIter {
    type Item = i32
    type IntoIter = RevIter

    fn into_iter(self: RevIter) -> RevIter {
        self
    }
}

// ---------------------------------------------------------------------------
// FromIterator impl for Vec<i32>
// ---------------------------------------------------------------------------

/// `FromIterator<i32>` impl for `Vec<i32>` — drains a `VecIter<i32>`.
impl FromIterator<VecIter<i32>> for Vec<i32> {
    fn from_iter(mut it: VecIter<i32>) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<i32>` impl for `Vec<i32>` — drains a half-open range.
impl FromIterator<RangeIter> for Vec<i32> {
    fn from_iter(mut it: RangeIter) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<i32>` impl for `Vec<i32>` — drains a closed range.
impl FromIterator<RangeInclusiveIter> for Vec<i32> {
    fn from_iter(mut it: RangeInclusiveIter) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<SkipMapIter>` impl for `Vec<i32>` — maps after skip.
impl FromIterator<SkipMapIter<VecIter<i32>>> for Vec<i32> {
    fn from_iter(mut it: SkipMapIter<VecIter<i32>>) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<SkipFilterIter>` impl for `Vec<i32>` — filters after skip.
impl FromIterator<SkipFilterIter<VecIter<i32>>> for Vec<i32> {
    fn from_iter(mut it: SkipFilterIter<VecIter<i32>>) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<VecIter<String>>` impl for `Vec<String>` — preserves each item.
impl FromIterator<VecIter<String>> for Vec<String> {
    fn from_iter(mut it: VecIter<String>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<MapIter<String, String>>` impl for `Vec<String>` — preserves mapped items.
impl FromIterator<MapIter<String, String>> for Vec<String> {
    fn from_iter(mut it: MapIter<String, String>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<FilterIter<String>>` impl for `Vec<String>` — preserves accepted items.
impl FromIterator<FilterIter<String>> for Vec<String> {
    fn from_iter(mut it: FilterIter<String>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<TakeIter<MapIter<String, String>>>` impl for `Vec<String>` — keeps the bound.
impl FromIterator<TakeIter<MapIter<String, String>>> for Vec<String> {
    fn from_iter(mut it: TakeIter<MapIter<String, String>>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<TakeIter<FilterIter<String>>>` impl for `Vec<String>` — keeps accepted items.
impl FromIterator<TakeIter<FilterIter<String>>> for Vec<String> {
    fn from_iter(mut it: TakeIter<FilterIter<String>>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<MapFilterIter<String, String>>` impl for `Vec<String>` — preserves filtered mapped items.
impl FromIterator<MapFilterIter<String, String>> for Vec<String> {
    fn from_iter(mut it: MapFilterIter<String, String>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<FilterMapIter<String, String>>` impl for `Vec<String>` — maps accepted items.
impl FromIterator<FilterMapIter<String, String>> for Vec<String> {
    fn from_iter(mut it: FilterMapIter<String, String>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<TakeIter<MapFilterIter<String, String>>>` impl for `Vec<String>` — bounds accepted mapped items.
impl FromIterator<TakeIter<MapFilterIter<String, String>>> for Vec<String> {
    fn from_iter(mut it: TakeIter<MapFilterIter<String, String>>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<TakeIter<FilterMapIter<String, String>>>` impl for `Vec<String>` — bounds mapped accepted items.
impl FromIterator<TakeIter<FilterMapIter<String, String>>> for Vec<String> {
    fn from_iter(mut it: TakeIter<FilterMapIter<String, String>>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<SkipMapIter<VecIter<String>>>` impl for `Vec<String>` — maps after skip.
impl FromIterator<SkipMapIter<VecIter<String>>> for Vec<String> {
    fn from_iter(mut it: SkipMapIter<VecIter<String>>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<SkipFilterIter<VecIter<String>>>` impl for `Vec<String>` — filters after skip.
impl FromIterator<SkipFilterIter<VecIter<String>>> for Vec<String> {
    fn from_iter(mut it: SkipFilterIter<VecIter<String>>) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<UniqueIter>` impl for `Vec<i32>` — drains first occurrences.
impl FromIterator<UniqueIter> for Vec<i32> {
    fn from_iter(mut it: UniqueIter) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<RevIter>` impl for `Vec<i32>` — drains in reverse order.
impl FromIterator<RevIter> for Vec<i32> {
    fn from_iter(mut it: RevIter) -> Vec<i32> {
        it.collect()
    }
}
