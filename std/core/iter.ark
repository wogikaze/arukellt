    }
}

impl IteratorI32 for TakeIter<MapFilterIter<i32, i32>> {
    fn next_i32(mut self: TakeIter<MapFilterIter<i32, i32>>) -> Option<i32> {
        self.next()
    }
}

impl IteratorI32 for TakeIter<FilterIter<i32>> {
    fn next_i32(mut self: TakeIter<FilterIter<i32>>) -> Option<i32> {
        self.next()
    }
}

impl IteratorI32 for TakeIter<VecIter<i32>> {
    fn next_i32(mut self: TakeIter<VecIter<i32>>) -> Option<i32> {
        self.next()
    }
}

impl IteratorI32 for SkipIter<VecIter<i32>> {
    fn next_i32(mut self: SkipIter<VecIter<i32>>) -> Option<i32> {
        self.next()
    }
}

impl IteratorI32 for TakeIter<SkipIter<VecIter<i32>>> {
    fn next_i32(mut self: TakeIter<SkipIter<VecIter<i32>>>) -> Option<i32> {
        self.next()
    }
}

impl IteratorI32 for SkipMapIter<VecIter<i32>> {
    fn next_i32(mut self: SkipMapIter<VecIter<i32>>) -> Option<i32> {
        self.next()
    }
}

impl IteratorI32 for SkipFilterIter<VecIter<i32>> {
    fn next_i32(mut self: SkipFilterIter<VecIter<i32>>) -> Option<i32> {
        self.next()
    }
}

impl IteratorI32 for ChainIter<VecIter<i32>> {
    fn next_i32(mut self: ChainIter<VecIter<i32>>) -> Option<i32> {
        self.next()
    }
}

impl IteratorI32 for UniqueIter {
    fn next_i32(mut self: UniqueIter) -> Option<i32> {
        self.next()
    }
}

impl IteratorI32 for RevIter {
    fn next_i32(mut self: RevIter) -> Option<i32> {
        self.next()
