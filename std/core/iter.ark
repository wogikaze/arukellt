//! std::core::iter — `Iterator`, `IntoIterator`, `FromIterator` traits and
//! lazy adapter types.
//!
//! This module formalises the iteration protocol that the `for x in v` syntax
//! uses structurally (a `next() -> Option<T>` method). It defines the three
//! core traits from Rust's `std::iter` and provides lazy adapter structs that
//! hold an upstream source plus a closure, pulling elements on demand.
//!
//! Because Arukellt's monomorphisation model does not yet support trait-object
//! dynamic dispatch, the existing adapter structs are monomorphic over `i32`
//! (matching the existing `std::seq` helpers). Item-preserving iteration is
//! kept separate from numeric consumers so another item representation can
//! implement `Iterator` without inventing a numeric meaning. Generic trait
//! definitions are included to formalise the protocol and enable future
//! generalisation.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

// ---------------------------------------------------------------------------
// Trait definitions
// ---------------------------------------------------------------------------

/// Trait for lazy, pull-based iteration over a sequence of `T` values.
///
/// `next` returns `Option::Some(item)` for each successive element or
/// `Option::None` when the iterator is exhausted. `collect` drains and
/// `count` counts through the same item-preserving trait dispatch path.
/// This mirrors the structural protocol that `for x in v` already uses — any
/// type with a `next() -> Option<T>` method is iterable.
///
/// ## Protocol catalog: `Iterator`
///
/// | Type        | Status | Notes                                  |
/// |-------------|--------|----------------------------------------|
/// | VecIter     | impl   | Adapter over `Vec<i32>`                |
/// | RangeIter   | impl   | Adapter over `Range`                   |
/// | RangeInclusiveIter | impl | Adapter over `RangeInclusive`      |
/// | MapIter     | impl   | Lazy map adapter                       |
/// | FilterIter  | impl   | Lazy filter adapter                    |
/// | TakeIter    | impl   | Lazy take adapter                      |
/// | SkipIter    | impl   | Lazy skip adapter                      |
/// | ChainIter   | impl   | Lazy chain of two `Vec<i32>`           |
/// | EnumerateIter | impl | Lazy enumerate adapter                 |
/// | ZipIter     | impl   | Lazy zip of two `Vec<i32>`             |
/// | MapFilterTakeIter | impl | Composed map/filter/take pipeline   |
/// | FilterTakeIter | impl | Composed filter/take pipeline       |
/// | SkipTakeIter | impl | Composed skip/take pipeline          |
pub trait Iterator {
    type Item
    fn next(self: Self) -> Option<Self::Item>
    fn collect(self: Self) -> Vec<Self::Item>
    fn count(self: Self) -> i32
}

/// Numeric sum capability for a concrete iterator item/output pair.
pub trait IteratorSum<Item, Output> {
    fn sum(self: Self) -> Output
}

/// Numeric fold capability for a concrete iterator item/accumulator pair.
pub trait IteratorFold<Item, Accumulator> {
    fn fold(self: Self, init: Accumulator, f: fn(Accumulator, Item) -> Accumulator) -> Accumulator
}

/// Trait for types that can be converted into an iterator.
///
/// `into_iter` consumes `self` and returns an `Iterator<T>`.
pub trait IntoIterator {
    type Item
    type IntoIter
    fn into_iter(self: Self) -> Self::IntoIter
}

/// Trait for collections that can be built from an iterator.
///
/// `from_iter` drains an iterator and constructs the collection.
pub trait FromIterator<T> {
    fn from_iter(it: T) -> Self
}

// Keep collection traversal in one generic implementation so every adapter
// uses the same associated-item result type.
fn collect_iterator<T: Iterator>(it: T) -> Vec<T::Item> {
    let result: Vec<T::Item> = Vec::new<T::Item>()
    while true {
        match it.next() {
            Some(v) => push(result, v),
            None => { break },
        }
    }
    result
}

fn count_iterator<T: Iterator>(it: T) -> i32 {
    let mut count: i32 = 0
    while true {
        match it.next() {
            Some(_) => count = count + 1,
            None => { break },
        }
    }
    count
}

fn sum_iterator_i32<T: Iterator>(it: T) -> i32 {
    let mut total: i32 = 0
    while true {
        match it.next() {
            Some(v) => total = total + v,
            None => { break },
        }
    }
    total
}

fn fold_iterator_i32<T: Iterator>(it: T, init: i32, f: fn(i32, i32) -> i32) -> i32 {
    let mut total: i32 = init
    while true {
        match it.next() {
            Some(v) => total = f(total, v),
            None => { break },
        }
    }
    total
}

// ---------------------------------------------------------------------------
// VecIter — lazy adapter over Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator over the elements of a `Vec<i32>`.
///
/// Holds a reference to the source vector and a current index. Each `next`
/// call advances the index and returns the next element, or `None` when the
/// end is reached.
pub struct VecIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
}

/// Construct a `VecIter` over `v`. The iterator borrows `v` by handle.
pub fn vec_iter(v: Vec<i32>) -> VecIter {
    v.iter()
}

/// Return the canonical lazy iterator for a `Vec<i32>`.
impl Vec<i32> {
    fn iter(self: Vec<i32>) -> VecIter {
        VecIter { vec: self, index: 0, length: len(self) }
    }
}

impl VecIter {
    /// Returns true when no more elements remain.
    fn is_empty(self: VecIter) -> bool {
        self.index >= self.length
    }

    /// Lazily transform the remaining elements with `f`.
    fn map(self: VecIter, f: fn(i32) -> i32) -> MapIter {
        MapIter { vec: self.vec, index: self.index, length: self.length, f: f }
    }

    /// Lazily keep the remaining elements accepted by `f`.
    fn filter(self: VecIter, f: fn(i32) -> bool) -> FilterIter {
        FilterIter { vec: self.vec, index: self.index, length: self.length, f: f }
    }

    /// Lazily limit the remaining elements to `n` values.
    fn take(self: VecIter, n: i32) -> TakeIter {
        TakeIter { vec: self.vec, index: self.index, length: self.length, remaining: n }
    }

    /// Lazily skip `n` values from the remaining elements.
    fn skip(self: VecIter, n: i32) -> SkipIter {
        SkipIter { vec: self.vec, index: self.index, length: self.length, to_skip: n }
    }
}

impl Iterator for VecIter {
    type Item = i32

    fn next(self: VecIter) -> Option<i32> {
        if self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(self: VecIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: VecIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for VecIter {
    type Item = i32
    type IntoIter = VecIter

    fn into_iter(self: VecIter) -> VecIter {
        self
    }
}

/// Convert a `Vec<i32>` into the canonical lazy iterator over its elements.
impl IntoIterator for Vec<i32> {
    type Item = i32
    type IntoIter = VecIter

    fn into_iter(self: Vec<i32>) -> VecIter {
        vec_iter(self)
    }
}

// ---------------------------------------------------------------------------
// StringIter — item-preserving iterator over Vec<String>
// ---------------------------------------------------------------------------

/// Lazy iterator over the elements of a `Vec<String>`.
pub struct StringIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
}

/// Construct a `StringIter` over `v` for the `Vec<String>` conversion impl.
fn string_iter(v: Vec<String>) -> StringIter {
    StringIter { vec: v, index: 0, length: len(v) }
}

impl Vec<String> {
    fn iter(self: Vec<String>) -> StringIter {
        string_iter(self)
    }
}

/// Lazy bounded adapter that preserves String items from `StringIter`.
pub struct StringTakeIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    remaining: i32,
}

/// Lazy adapter that skips String items before yielding the remainder.
pub struct StringSkipIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    to_skip: i32,
}

/// Lazy composition that skips String items and then applies a bound.
pub struct StringSkipTakeIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    to_skip: i32,
    remaining: i32,
}

/// Lazy adapter that transforms each remaining String item with `f`.
pub struct StringMapIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    f: fn(String) -> String,
}

/// Lazy adapter that keeps String items accepted by `f`.
pub struct StringFilterIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    f: fn(String) -> bool,
}

/// Lazy composition that maps String items and keeps at most `n` results.
pub struct StringMapTakeIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    map_f: fn(String) -> String,
    remaining: i32,
}

/// Lazy composition that keeps at most `n` accepted String items.
pub struct StringFilterTakeIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    filter_f: fn(String) -> bool,
    remaining: i32,
}

/// Lazy composition that maps each String and filters the mapped result.
pub struct StringMapFilterIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    map_f: fn(String) -> String,
    filter_f: fn(String) -> bool,
}

/// Lazy composition that filters source Strings and maps accepted items.
pub struct StringFilterMapIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    filter_f: fn(String) -> bool,
    map_f: fn(String) -> String,
}

impl StringIter {
    fn map(self: StringIter, f: fn(String) -> String) -> StringMapIter {
        StringMapIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            f: f,
        }
    }

    fn filter(self: StringIter, f: fn(String) -> bool) -> StringFilterIter {
        StringFilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            f: f,
        }
    }

    fn take(self: StringIter, n: i32) -> StringTakeIter {
        StringTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            remaining: n,
        }
    }

    fn skip(self: StringIter, n: i32) -> StringSkipIter {
        StringSkipIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            to_skip: n,
        }
    }
}

impl StringMapIter {
    fn take(self: StringMapIter, n: i32) -> StringMapTakeIter {
        StringMapTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.f,
            remaining: n,
        }
    }

    fn filter(self: StringMapIter, f: fn(String) -> bool) -> StringMapFilterIter {
        StringMapFilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.f,
            filter_f: f,
        }
    }
}

impl StringFilterIter {
    fn take(self: StringFilterIter, n: i32) -> StringFilterTakeIter {
        StringFilterTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            filter_f: self.f,
            remaining: n,
        }
    }

    fn map(self: StringFilterIter, f: fn(String) -> String) -> StringFilterMapIter {
        StringFilterMapIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            filter_f: self.f,
            map_f: f,
        }
    }
}

impl StringSkipIter {
    fn take(self: StringSkipIter, n: i32) -> StringSkipTakeIter {
        StringSkipTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            to_skip: self.to_skip,
            remaining: n,
        }
    }
}

impl Iterator for StringIter {
    type Item = String

    fn next(self: StringIter) -> Option<String> {
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: StringIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringTakeIter {
    type Item = String

    fn next(self: StringTakeIter) -> Option<String> {
        if self.remaining <= 0 {
            return None
        }
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            self.remaining = self.remaining - 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: StringTakeIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringTakeIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringSkipIter {
    type Item = String

    fn next(self: StringSkipIter) -> Option<String> {
        while self.to_skip > 0 && self.index < self.length {
            self.index = self.index + 1
            self.to_skip = self.to_skip - 1
        }
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: StringSkipIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringSkipIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringSkipTakeIter {
    type Item = String

    fn next(self: StringSkipTakeIter) -> Option<String> {
        if self.remaining <= 0 {
            return None
        }
        while self.to_skip > 0 && self.index < self.length {
            self.index = self.index + 1
            self.to_skip = self.to_skip - 1
        }
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            self.remaining = self.remaining - 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: StringSkipTakeIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringSkipTakeIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringMapIter {
    type Item = String

    fn next(self: StringMapIter) -> Option<String> {
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some((self.f)(value))
        } else {
            None
        }
    }

    fn collect(self: StringMapIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringMapIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringFilterIter {
    type Item = String

    fn next(self: StringFilterIter) -> Option<String> {
        while self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            // The predicate takes ownership of its callback argument. Keep the
            // source item for the yielded path by passing a cloned handle.
            let predicate_value = clone(value)
            if (self.f)(predicate_value) {
                return Some(value)
            }
        }
        None
    }

    fn collect(self: StringFilterIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringFilterIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringMapTakeIter {
    type Item = String

    fn next(self: StringMapTakeIter) -> Option<String> {
        if self.remaining <= 0 {
            return None
        }
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            self.remaining = self.remaining - 1
            Some((self.map_f)(value))
        } else {
            None
        }
    }

    fn collect(self: StringMapTakeIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringMapTakeIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringFilterTakeIter {
    type Item = String

    fn next(self: StringFilterTakeIter) -> Option<String> {
        if self.remaining <= 0 {
            return None
        }
        while self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            let predicate_value = clone(value)
            if (self.filter_f)(predicate_value) {
                self.remaining = self.remaining - 1
                return Some(value)
            }
        }
        None
    }

    fn collect(self: StringFilterTakeIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringFilterTakeIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringMapFilterIter {
    type Item = String

    fn next(self: StringMapFilterIter) -> Option<String> {
        while self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            let mapped = (self.map_f)(value)
            let predicate_value = clone(mapped)
            if (self.filter_f)(predicate_value) {
                return Some(mapped)
            }
        }
        None
    }

    fn collect(self: StringMapFilterIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringMapFilterIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringFilterMapIter {
    type Item = String

    fn next(self: StringFilterMapIter) -> Option<String> {
        while self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            let predicate_value = clone(value)
            if (self.filter_f)(predicate_value) {
                return Some((self.map_f)(value))
            }
        }
        None
    }

    fn collect(self: StringFilterMapIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringFilterMapIter) -> i32 {
        count_iterator(self)
    }
}

impl IntoIterator for StringIter {
    type Item = String
    type IntoIter = StringIter

    fn into_iter(self: StringIter) -> StringIter {
        self
    }
}

impl IntoIterator for StringTakeIter {
    type Item = String
    type IntoIter = StringTakeIter

    fn into_iter(self: StringTakeIter) -> StringTakeIter {
        self
    }
}

impl IntoIterator for StringSkipIter {
    type Item = String
    type IntoIter = StringSkipIter

    fn into_iter(self: StringSkipIter) -> StringSkipIter {
        self
    }
}

impl IntoIterator for StringSkipTakeIter {
    type Item = String
    type IntoIter = StringSkipTakeIter

    fn into_iter(self: StringSkipTakeIter) -> StringSkipTakeIter {
        self
    }
}

impl IntoIterator for StringMapIter {
    type Item = String
    type IntoIter = StringMapIter

    fn into_iter(self: StringMapIter) -> StringMapIter {
        self
    }
}

impl IntoIterator for StringFilterIter {
    type Item = String
    type IntoIter = StringFilterIter

    fn into_iter(self: StringFilterIter) -> StringFilterIter {
        self
    }
}

impl IntoIterator for StringMapTakeIter {
    type Item = String
    type IntoIter = StringMapTakeIter

    fn into_iter(self: StringMapTakeIter) -> StringMapTakeIter {
        self
    }
}

impl IntoIterator for StringFilterTakeIter {
    type Item = String
    type IntoIter = StringFilterTakeIter

    fn into_iter(self: StringFilterTakeIter) -> StringFilterTakeIter {
        self
    }
}

impl IntoIterator for StringMapFilterIter {
    type Item = String
    type IntoIter = StringMapFilterIter

    fn into_iter(self: StringMapFilterIter) -> StringMapFilterIter {
        self
    }
}

impl IntoIterator for StringFilterMapIter {
    type Item = String
    type IntoIter = StringFilterMapIter

    fn into_iter(self: StringFilterMapIter) -> StringFilterMapIter {
        self
    }
}

impl IntoIterator for Vec<String> {
    type Item = String
    type IntoIter = StringIter

    fn into_iter(self: Vec<String>) -> StringIter {
        string_iter(self)
    }
}

// ---------------------------------------------------------------------------
// RangeIter — lazy adapter over Range
// ---------------------------------------------------------------------------

/// Lazy iterator over a half-open integer range `[start, end)`.
pub struct RangeIter {
    current: i32,
    end: i32,
}

/// Construct a `RangeIter` from a `Range`.
pub fn range_iter(r: Range) -> RangeIter {
    RangeIter { current: r.start, end: r.end }
}

impl Iterator for RangeIter {
    type Item = i32

    fn next(self: RangeIter) -> Option<i32> {
        if self.current < self.end {
            let val: i32 = self.current
            self.current = self.current + 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(self: RangeIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: RangeIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for Range {
    type Item = i32
    type IntoIter = RangeIter

    fn into_iter(self: Range) -> RangeIter {
        range_iter(self)
    }
}

// ---------------------------------------------------------------------------
// RangeInclusiveIter — lazy adapter over RangeInclusive
// ---------------------------------------------------------------------------

/// Lazy iterator over a closed integer range `[start, end]`.
pub struct RangeInclusiveIter {
    current: i32,
    end: i32,
}

/// Construct a `RangeInclusiveIter` from a `RangeInclusive`.
pub fn range_inclusive_iter(r: RangeInclusive) -> RangeInclusiveIter {
    RangeInclusiveIter { current: r.start, end: r.end }
}

impl Iterator for RangeInclusiveIter {
    type Item = i32

    fn next(self: RangeInclusiveIter) -> Option<i32> {
        if self.current <= self.end {
            let value: i32 = self.current
            self.current = self.current + 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: RangeInclusiveIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: RangeInclusiveIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for RangeInclusive {
    type Item = i32
    type IntoIter = RangeInclusiveIter

    fn into_iter(self: RangeInclusive) -> RangeInclusiveIter {
        range_inclusive_iter(self)
    }
}

// ---------------------------------------------------------------------------
// MapIter — lazy map adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that applies `f` to each element of the source vector.
pub struct MapIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    f: fn(i32) -> i32,
}

/// Construct a `MapIter` over `v` with transform `f`.
pub fn map_iter(v: Vec<i32>, f: fn(i32) -> i32) -> MapIter {
    vec_iter(v).map(f)
}

impl MapIter {
    /// Lazily limit mapped elements to `n` values.
    fn take(self: MapIter, n: i32) -> MapTakeIter {
        MapTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.f,
            remaining: n,
        }
    }

    /// Lazily keep mapped elements accepted by `f`.
    fn filter(self: MapIter, f: fn(i32) -> bool) -> MapFilterIter {
        MapFilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.f,
            filter_f: f,
        }
    }
}

impl Iterator for MapIter {
    type Item = i32

    fn next(self: MapIter) -> Option<i32> {
        if self.index < self.length {
            let raw: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some((self.f)(raw))
        } else {
            None
        }
    }

    fn collect(self: MapIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: MapIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// MapTakeIter — composed lazy map/take adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that maps source values and yields at most `n` results.
pub struct MapTakeIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    map_f: fn(i32) -> i32,
    remaining: i32,
}

impl Iterator for MapTakeIter {
    type Item = i32

    fn next(self: MapTakeIter) -> Option<i32> {
        if self.remaining <= 0 {
            return None
        }
        if self.index < self.length {
            let raw: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            self.remaining = self.remaining - 1
            Some((self.map_f)(raw))
        } else {
            None
        }
    }

    fn collect(self: MapTakeIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: MapTakeIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// MapFilterIter — composed lazy map/filter adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that maps each source value and then filters the mapped value.
pub struct MapFilterIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    map_f: fn(i32) -> i32,
    filter_f: fn(i32) -> bool,
}

impl MapFilterIter {
    /// Lazily limit the accepted mapped values to `n` elements.
    fn take(self: MapFilterIter, n: i32) -> MapFilterTakeIter {
        MapFilterTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.map_f,
            filter_f: self.filter_f,
            remaining: n,
        }
    }
}

impl Iterator for MapFilterIter {
    type Item = i32

    fn next(self: MapFilterIter) -> Option<i32> {
        while self.index < self.length {
            let raw: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            let mapped: i32 = (self.map_f)(raw)
            if (self.filter_f)(mapped) {
                return Some(mapped)
            }
        }
        None
    }

    fn collect(self: MapFilterIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: MapFilterIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// MapFilterTakeIter — composed lazy map/filter/take adapter
// ---------------------------------------------------------------------------

/// Lazy iterator for `map(...).filter(...).take(...)` without intermediate Vecs.
pub struct MapFilterTakeIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    map_f: fn(i32) -> i32,
    filter_f: fn(i32) -> bool,
    remaining: i32,
}

impl Iterator for MapFilterTakeIter {
    type Item = i32

    fn next(self: MapFilterTakeIter) -> Option<i32> {
        if self.remaining <= 0 {
            return None
        }
        while self.index < self.length {
            let raw: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            let mapped: i32 = (self.map_f)(raw)
            if (self.filter_f)(mapped) {
                self.remaining = self.remaining - 1
                return Some(mapped)
            }
        }
        None
    }

    fn collect(self: MapFilterTakeIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: MapFilterTakeIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// FilterIter — lazy filter adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields only elements for which `f` returns `true`.
pub struct FilterIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    f: fn(i32) -> bool,
}

/// Construct a `FilterIter` over `v` with predicate `f`.
pub fn filter_iter(v: Vec<i32>, f: fn(i32) -> bool) -> FilterIter {
    vec_iter(v).filter(f)
}

impl FilterIter {
    /// Lazily limit accepted values to `n` elements.
    fn take(self: FilterIter, n: i32) -> FilterTakeIter {
        FilterTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            filter_f: self.f,
            remaining: n,
        }
    }
}

impl Iterator for FilterIter {
    type Item = i32

    fn next(self: FilterIter) -> Option<i32> {
        while self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            if (self.f)(val) {
                return Some(val)
            }
        }
        None
    }

    fn collect(self: FilterIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: FilterIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// FilterTakeIter — composed lazy filter/take adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that filters source values and yields at most `n` matches.
pub struct FilterTakeIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    filter_f: fn(i32) -> bool,
    remaining: i32,
}

impl Iterator for FilterTakeIter {
    type Item = i32

    fn next(self: FilterTakeIter) -> Option<i32> {
        if self.remaining <= 0 {
            return None
        }
        while self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            if (self.filter_f)(val) {
                self.remaining = self.remaining - 1
                return Some(val)
            }
        }
        None
    }

    fn collect(self: FilterTakeIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: FilterTakeIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// TakeIter — lazy take adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields at most `n` elements from the source.
pub struct TakeIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    remaining: i32,
}

/// Construct a `TakeIter` over `v` limited to `n` elements.
pub fn take_iter(v: Vec<i32>, n: i32) -> TakeIter {
    vec_iter(v).take(n)
}

impl Iterator for TakeIter {
    type Item = i32

    fn next(self: TakeIter) -> Option<i32> {
        if self.remaining <= 0 {
            return None
        }
        if self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            self.remaining = self.remaining - 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(self: TakeIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: TakeIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// SkipIter — lazy skip adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that skips the first `n` elements of the source.
pub struct SkipIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    to_skip: i32,
}

/// Construct a `SkipIter` over `v` that drops the first `n` elements.
pub fn skip_iter(v: Vec<i32>, n: i32) -> SkipIter {
    vec_iter(v).skip(n)
}

impl SkipIter {
    /// Lazily skip source values, then yield at most `n` remaining values.
    fn take(self: SkipIter, n: i32) -> SkipTakeIter {
        SkipTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            to_skip: self.to_skip,
            remaining: n,
        }
    }
}

impl Iterator for SkipIter {
    type Item = i32

    fn next(self: SkipIter) -> Option<i32> {
        while self.to_skip > 0 && self.index < self.length {
            self.index = self.index + 1
            self.to_skip = self.to_skip - 1
        }
        if self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(self: SkipIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: SkipIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// SkipTakeIter — composed lazy skip/take adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that skips source values and yields at most `n` values.
pub struct SkipTakeIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    to_skip: i32,
    remaining: i32,
}

impl Iterator for SkipTakeIter {
    type Item = i32

    fn next(self: SkipTakeIter) -> Option<i32> {
        if self.remaining <= 0 {
            return None
        }
        while self.to_skip > 0 && self.index < self.length {
            self.index = self.index + 1
            self.to_skip = self.to_skip - 1
        }
        if self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            self.remaining = self.remaining - 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(self: SkipTakeIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: SkipTakeIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// ChainIter — lazy chain of two Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator that yields all elements of `first` then all of `second`.
pub struct ChainIter {
    first: Vec<i32>,
    second: Vec<i32>,
    index: i32,
    first_len: i32,
    second_len: i32,
}

/// Construct a `ChainIter` over two vectors.
pub fn chain_iter(first: Vec<i32>, second: Vec<i32>) -> ChainIter {
    ChainIter {
        first: first,
        second: second,
        index: 0,
        first_len: len(first),
        second_len: len(second),
    }
}

impl Iterator for ChainIter {
    type Item = i32

    fn next(self: ChainIter) -> Option<i32> {
        if self.index < self.first_len {
            let val: i32 = get_unchecked(self.first, self.index)
            self.index = self.index + 1
            Some(val)
        } else {
            let second_index: i32 = self.index - self.first_len
            if second_index < self.second_len {
                let val: i32 = get_unchecked(self.second, second_index)
                self.index = self.index + 1
                Some(val)
            } else {
                None
            }
        }
    }

    fn collect(self: ChainIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: ChainIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// EnumerateIter — lazy enumerate adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields `(index, value)` pairs as a packed i32.
///
/// The index is stored in the high 16 bits and the value in the low 16 bits
/// so the result fits in a single `i32`. This keeps the adapter monomorphic
/// while still carrying both pieces of information.
pub struct EnumerateIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
}

/// Construct an `EnumerateIter` over `v`.
pub fn enumerate_iter(v: Vec<i32>) -> EnumerateIter {
    EnumerateIter { vec: v, index: 0, length: len(v) }
}

impl Iterator for EnumerateIter {
    type Item = i32

    fn next(self: EnumerateIter) -> Option<i32> {
        if self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            let packed: i32 = self.index * 65536 + val
            self.index = self.index + 1
            Some(packed)
        } else {
            None
        }
    }

    fn collect(self: EnumerateIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: EnumerateIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// ZipIter — lazy zip of two Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator that yields paired elements from two vectors as a packed i32.
///
/// The first vector's element occupies the high 16 bits and the second's the
/// low 16 bits.
pub struct ZipIter {
    first: Vec<i32>,
    second: Vec<i32>,
    index: i32,
    length: i32,
}

/// Construct a `ZipIter` over two vectors. Iteration stops at the shorter length.
pub fn zip_iter(first: Vec<i32>, second: Vec<i32>) -> ZipIter {
    let len_a: i32 = len(first)
    let len_b: i32 = len(second)
    let min_len: i32 = if len_a < len_b { len_a } else { len_b }
    ZipIter { first: first, second: second, index: 0, length: min_len }
}

impl Iterator for ZipIter {
    type Item = i32

    fn next(self: ZipIter) -> Option<i32> {
        if self.index < self.length {
            let a: i32 = get_unchecked(self.first, self.index)
            let b: i32 = get_unchecked(self.second, self.index)
            self.index = self.index + 1
            Some(a * 65536 + b)
        } else {
            None
        }
    }

    fn collect(self: ZipIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: ZipIter) -> i32 {
        count_iterator(self)
    }

}

