// ---------------------------------------------------------------------------
// Membership and equality-counting capabilities for the i32 lane
// ---------------------------------------------------------------------------

// Like the numeric consumers, equality over items is a capability of the
// concrete item type rather than part of the producer contract.
impl IteratorContains<i32> for VecIter<i32> {
    fn contains(mut self: VecIter<i32>, target: i32) -> bool {
        contains_iterator_i32(self, target)
    }
}

impl IteratorContains<String> for VecIter<String> {
    fn contains(self: VecIter<String>, target: String) -> bool {
        let mut index = self.index
        while index < self.length {
            if __intrinsic_string_eq(self.vec.get_unchecked(index), target.clone()) {
                return true
            }
            index = index + 1
        }
        false
    }
}

impl IteratorCountEq<i32> for VecIter<i32> {
    fn count_eq(mut self: VecIter<i32>, target: i32) -> i32 {
        count_eq_iterator_i32(self, target)
    }
}

impl IteratorContains<i32> for RangeIter {
    fn contains(mut self: RangeIter, target: i32) -> bool {
        contains_iterator_i32(self, target)
    }
}

impl IteratorCountEq<i32> for RangeIter {
    fn count_eq(mut self: RangeIter, target: i32) -> i32 {
        count_eq_iterator_i32(self, target)
    }
}

