//! std::core::iter — `Iterator`, `IntoIterator`, `FromIterator` traits and
//! lazy adapter types.
//!
//! This module formalises the iteration protocol that the `for x in v` syntax
//! uses structurally (a `next() -> Option<T>` method). It defines the three
//! core traits from Rust's `std::iter` and provides lazy adapter structs that
//! hold an upstream source plus a closure, pulling elements on demand.
//!
//! Because Arukellt's monomorphisation model does not yet support trait-object
//! dynamic dispatch, adapters are monomorphised per concrete instantiation.
//! The map/filter adapter family is item-generic (`MapIter<T, U>` holds
//! `f: fn(T) -> U`), so the same adapter code serves `Vec<i32>` and
//! `Vec<String>` pipelines; the skip-first family keeps concrete String
//! adapters until skip compositions can spell `fn(I::Item) -> U` (#691).
//! Item-preserving iteration is kept separate from numeric consumers so
//! another item representation can
//! implement `Iterator` without inventing a numeric meaning. Generic trait
//! definitions are included to formalise the protocol and enable future
//! generalisation.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

// ---------------------------------------------------------------------------
// Trait definitions
// ---------------------------------------------------------------------------

/// Trait for lazy, pull-based iteration over a sequence of `T` values.
///
/// `next` returns `Option::Some(item)` for each successive element or
/// `Option::None` when the iterator is exhausted. `collect` drains and
/// `count` counts through the same item-preserving trait dispatch path.
/// This mirrors the structural protocol that `for x in v` already uses — any
/// type with a `next() -> Option<T>` method is iterable.
///
/// ## Protocol catalog: `Iterator`
///
/// | Type        | Status | Notes                                  |
/// |-------------|--------|----------------------------------------|
/// | VecIter     | impl   | Adapter over `Vec<i32>`                |
/// | RangeIter   | impl   | Adapter over `Range`                   |
/// | RangeInclusiveIter | impl | Adapter over `RangeInclusive`      |
/// | MapIter<T,U> | impl | Lazy map adapter over `Vec<T>`           |
/// | FilterIter<T> | impl | Lazy filter adapter over `Vec<T>`       |
/// | MapFilterIter<T,U> | impl | Composed map/filter pipeline      |
/// | FilterMapIter<T> | impl | Composed filter/map pipeline        |
/// | TakeIter<I> | impl   | Lazy take adapter over any source      |
/// | SkipIter<I> | impl   | Lazy skip adapter over any source      |
/// | ChainIter<I> | impl  | Lazy chain of two `I: Iterator` sources |
/// | EnumerateIter<I> | impl | Lazy enumerate yielding `Pair` items |
/// | ZipIter<A,B> | impl | Lazy zip yielding `Pair` items           |
/// | SkipMapIter<I> | impl | Composed skip/map pipeline           |
/// | SkipFilterIter<I> | impl | Composed skip/filter pipeline       |
pub trait Iterator {
    type Item
    fn next(self: Self) -> Option<Self::Item>
    fn collect(self: Self) -> Vec<Self::Item>
    fn count(self: Self) -> i32
}

/// Numeric sum capability for a concrete iterator item/output pair.
pub trait IteratorSum<Item, Output> {
    fn sum(self: Self) -> Output
}

/// Numeric fold capability for a concrete iterator item/accumulator pair.
pub trait IteratorFold<Item, Accumulator> {
    fn fold(self: Self, init: Accumulator, f: fn(Accumulator, Item) -> Accumulator) -> Accumulator
}

/// Membership-test capability for a concrete iterator item type.
pub trait IteratorContains<Item> {
    fn contains(self: Self, target: Item) -> bool
}

/// Equality-counting capability for a concrete iterator item type.
pub trait IteratorCountEq<Item> {
    fn count_eq(self: Self, target: Item) -> i32
}

/// Trait for types that can be converted into an iterator.
///
/// `into_iter` consumes `self` and returns an `Iterator<T>`.
pub trait IntoIterator {
    type Item
    type IntoIter
    fn into_iter(self: Self) -> Self::IntoIter
}

/// Trait for collections that can be built from an iterator.
///
/// `from_iter` drains an iterator and constructs the collection.
pub trait FromIterator<T> {
    fn from_iter(it: T) -> Self
}

// Keep collection traversal in one generic implementation so every adapter
// uses the same associated-item result type.
fn collect_iterator<T: Iterator>(it: T) -> Vec<T::Item> {
    let result: Vec<T::Item> = Vec::new<T::Item>()
    while true {
        match it.next() {
            Some(v) => push(result, v),
            None => { break },
        }
    }
    result
}

fn count_iterator<T: Iterator>(it: T) -> i32 {
    let mut count: i32 = 0
    while true {
        match it.next() {
            Some(_) => count = count + 1,
            None => { break },
        }
    }
    count
}

fn sum_iterator_i32<T: Iterator>(it: T) -> i32 {
    let mut total: i32 = 0
    while true {
        match it.next() {
            Some(v) => total = total + v,
            None => { break },
        }
    }
    total
}

fn fold_iterator_i32<T: Iterator>(it: T, init: i32, f: fn(i32, i32) -> i32) -> i32 {
    let mut total: i32 = init
    while true {
        match it.next() {
            Some(v) => total = f(total, v),
            None => { break },
        }
    }
    total
}

fn contains_iterator_i32<T: Iterator>(it: T, target: i32) -> bool {
    let mut found: bool = false
    while true {
        match it.next() {
            Some(v) => {
                if v == target {
                    found = true
                    break
                }
            },
            None => { break },
        }
    }
    found
}

fn count_eq_iterator_i32<T: Iterator>(it: T, target: i32) -> i32 {
    let mut hits: i32 = 0
    while true {
        match it.next() {
            Some(v) => {
                if v == target {
                    hits = hits + 1
                }
            },
            None => { break },
        }
    }
    hits
}

fn any_iterator_i32<T: Iterator>(it: T, f: fn(i32) -> bool) -> bool {
    let mut found: bool = false
    while true {
        match it.next() {
            Some(v) => {
                if f(v) {
                    found = true
                    break
                }
            },
            None => { break },
        }
    }
    found
}

fn all_iterator_i32<T: Iterator>(it: T, f: fn(i32) -> bool) -> bool {
    let mut all: bool = true
    while true {
        match it.next() {
            Some(v) => {
                if f(v) == false {
                    all = false
                    break
                }
            },
            None => { break },
        }
    }
    all
}
// ---------------------------------------------------------------------------
// VecIter — lazy adapter over Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator over the elements of a `Vec<i32>`.
///
/// Holds a reference to the source vector and a current index. Each `next`
/// call advances the index and returns the next element, or `None` when the
/// end is reached.
pub struct VecIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
}

/// Construct a `VecIter` over `v`. The iterator borrows `v` by handle.
pub fn vec_iter(v: Vec<i32>) -> VecIter {
    v.iter()
}

/// Return the canonical lazy iterator for a `Vec<i32>`.
impl Vec<i32> {
    fn iter(self: Vec<i32>) -> VecIter {
        VecIter { vec: self, index: 0, length: len(self) }
    }
}

impl VecIter {
    /// Returns true when no more elements remain.
    fn is_empty(self: VecIter) -> bool {
        self.index >= self.length
    }

    /// Lazily transform the remaining elements with `f`.
    fn map(self: VecIter, f: fn(i32) -> i32) -> MapIter<i32, i32> {
        MapIter { vec: self.vec, index: self.index, length: self.length, f: f }
    }

    /// Lazily keep the remaining elements accepted by `f`.
    fn filter(self: VecIter, f: fn(i32) -> bool) -> FilterIter<i32> {
        FilterIter { vec: self.vec, index: self.index, length: self.length, f: f }
    }

    /// Lazily limit the remaining elements to `n` values.
    fn take(self: VecIter, n: i32) -> TakeIter<VecIter> {
        TakeIter { iter: self, remaining: n }
    }

    /// Lazily skip `n` values from the remaining elements.
    fn skip(self: VecIter, n: i32) -> SkipIter<VecIter> {
        SkipIter { iter: self, to_skip: n }
    }

    /// Lazily yield each remaining element the first time it appears.
    fn unique(self: VecIter) -> UniqueIter {
        UniqueIter { vec: self.vec, index: self.index, length: self.length, seen: Vec::new<i32>() }
    }

    /// Lazily yield the remaining elements in reverse order.
    fn rev(self: VecIter) -> RevIter {
        RevIter { vec: self.vec, index: self.index, length: self.length }
    }
}

impl Iterator for VecIter {
    type Item = i32

    fn next(self: VecIter) -> Option<i32> {
        if self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(self: VecIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: VecIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for VecIter {
    type Item = i32
    type IntoIter = VecIter

    fn into_iter(self: VecIter) -> VecIter {
        self
    }
}

/// Convert a `Vec<i32>` into the canonical lazy iterator over its elements.
impl IntoIterator for Vec<i32> {
    type Item = i32
    type IntoIter = VecIter

    fn into_iter(self: Vec<i32>) -> VecIter {
        vec_iter(self)
    }
}

// ---------------------------------------------------------------------------
// StringIter — item-preserving iterator over Vec<String>
// ---------------------------------------------------------------------------

/// Lazy iterator over the elements of a `Vec<String>`.
pub struct StringIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
}

/// Construct a `StringIter` over `v` for the `Vec<String>` conversion impl.
fn string_iter(v: Vec<String>) -> StringIter {
    StringIter { vec: v, index: 0, length: len(v) }
}

impl Vec<String> {
    fn iter(self: Vec<String>) -> StringIter {
        string_iter(self)
    }
}

/// Lazy adapter that skips String items before yielding the remainder.
pub struct StringSkipIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    to_skip: i32,
}

/// Lazy composition that skips source Strings before mapping the remainder.
pub struct StringSkipMapIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    to_skip: i32,
    map_f: fn(String) -> String,
}

/// Lazy composition that skips source Strings before filtering the remainder.
pub struct StringSkipFilterIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    to_skip: i32,
    filter_f: fn(String) -> bool,
}

impl StringIter {
    fn map(self: StringIter, f: fn(String) -> String) -> MapIter<String, String> {
        MapIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            f: f,
        }
    }

    fn filter(self: StringIter, f: fn(String) -> bool) -> FilterIter<String> {
        FilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            f: f,
        }
    }

    fn take(self: StringIter, n: i32) -> TakeIter<StringIter> {
        TakeIter {
            iter: self,
            remaining: n,
        }
    }

    fn skip(self: StringIter, n: i32) -> StringSkipIter {
        StringSkipIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            to_skip: n,
        }
    }
}

impl StringSkipIter {
    fn map(self: StringSkipIter, f: fn(String) -> String) -> StringSkipMapIter {
        StringSkipMapIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            to_skip: self.to_skip,
            map_f: f,
        }
    }

    fn filter(self: StringSkipIter, f: fn(String) -> bool) -> StringSkipFilterIter {
        StringSkipFilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            to_skip: self.to_skip,
            filter_f: f,
        }
    }

    fn take(self: StringSkipIter, n: i32) -> TakeIter<StringSkipIter> {
        TakeIter {
            iter: self,
            remaining: n,
        }
    }
}

impl Iterator for StringIter {
    type Item = String

    fn next(self: StringIter) -> Option<String> {
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: StringIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringSkipIter {
    type Item = String

    fn next(self: StringSkipIter) -> Option<String> {
        while self.to_skip > 0 && self.index < self.length {
            self.index = self.index + 1
            self.to_skip = self.to_skip - 1
        }
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: StringSkipIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringSkipIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringSkipMapIter {
    type Item = String

    fn next(self: StringSkipMapIter) -> Option<String> {
        while self.to_skip > 0 && self.index < self.length {
            self.index = self.index + 1
            self.to_skip = self.to_skip - 1
        }
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some((self.map_f)(value))
        } else {
            None
        }
    }

    fn collect(self: StringSkipMapIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringSkipMapIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringSkipFilterIter {
    type Item = String

    fn next(self: StringSkipFilterIter) -> Option<String> {
        while self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            if self.to_skip > 0 {
                self.to_skip = self.to_skip - 1
                continue
            }
            let predicate_value = clone(value)
            if (self.filter_f)(predicate_value) {
                return Some(value)
            }
        }
        None
    }

    fn collect(self: StringSkipFilterIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringSkipFilterIter) -> i32 {
        count_iterator(self)
    }
}

impl IntoIterator for StringIter {
    type Item = String
    type IntoIter = StringIter

    fn into_iter(self: StringIter) -> StringIter {
        self
    }
}

impl IntoIterator for StringSkipIter {
    type Item = String
    type IntoIter = StringSkipIter

    fn into_iter(self: StringSkipIter) -> StringSkipIter {
        self
    }
}

impl IntoIterator for StringSkipMapIter {
    type Item = String
    type IntoIter = StringSkipMapIter

    fn into_iter(self: StringSkipMapIter) -> StringSkipMapIter {
        self
    }
}

impl IntoIterator for StringSkipFilterIter {
    type Item = String
    type IntoIter = StringSkipFilterIter

    fn into_iter(self: StringSkipFilterIter) -> StringSkipFilterIter {
        self
    }
}

impl IntoIterator for Vec<String> {
    type Item = String
    type IntoIter = StringIter

    fn into_iter(self: Vec<String>) -> StringIter {
        string_iter(self)
    }
}

// ---------------------------------------------------------------------------
// RangeIter — lazy adapter over Range
// ---------------------------------------------------------------------------

/// Lazy iterator over a half-open integer range `[start, end)`.
pub struct RangeIter {
    current: i32,
    end: i32,
}

/// Construct a `RangeIter` from a `Range`.
pub fn range_iter(r: Range) -> RangeIter {
    RangeIter { current: r.start, end: r.end }
}

impl Iterator for RangeIter {
    type Item = i32

    fn next(self: RangeIter) -> Option<i32> {
        if self.current < self.end {
            let val: i32 = self.current
            self.current = self.current + 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(self: RangeIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: RangeIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for Range {
    type Item = i32
    type IntoIter = RangeIter

    fn into_iter(self: Range) -> RangeIter {
        range_iter(self)
    }
}

// ---------------------------------------------------------------------------
// RangeInclusiveIter — lazy adapter over RangeInclusive
// ---------------------------------------------------------------------------

/// Lazy iterator over a closed integer range `[start, end]`.
pub struct RangeInclusiveIter {
    current: i32,
    end: i32,
}

/// Construct a `RangeInclusiveIter` from a `RangeInclusive`.
pub fn range_inclusive_iter(r: RangeInclusive) -> RangeInclusiveIter {
    RangeInclusiveIter { current: r.start, end: r.end }
}

impl Iterator for RangeInclusiveIter {
    type Item = i32

    fn next(self: RangeInclusiveIter) -> Option<i32> {
        if self.current <= self.end {
            let value: i32 = self.current
            self.current = self.current + 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: RangeInclusiveIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: RangeInclusiveIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for RangeInclusive {
    type Item = i32
    type IntoIter = RangeInclusiveIter

    fn into_iter(self: RangeInclusive) -> RangeInclusiveIter {
        range_inclusive_iter(self)
    }
}

// ---------------------------------------------------------------------------
// MapIter — lazy map adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that applies `f` to each element of the source vector.
/// The adapter is item-generic: `f: fn(T) -> U` keeps the concrete
/// per-instance callback signature on both backends (#860/#691).
pub struct MapIter<T, U> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    f: fn(T) -> U,
}

/// Construct a `MapIter` over `v` with transform `f`.
pub fn map_iter(v: Vec<i32>, f: fn(i32) -> i32) -> MapIter<i32, i32> {
    vec_iter(v).map(f)
}

impl MapIter<T, U> {
    /// Lazily limit mapped elements to `n` values.
    fn take(self: MapIter<T, U>, n: i32) -> TakeIter<MapIter<T, U>> {
        TakeIter { iter: self, remaining: n }
    }

    /// Lazily keep mapped elements accepted by `f`.
    fn filter(self: MapIter<T, U>, f: fn(U) -> bool) -> MapFilterIter<T, U> {
        MapFilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.f,
            filter_f: f,
        }
    }
}

impl Iterator for MapIter<T, U> {
    type Item = U

    fn next(self: MapIter<T, U>) -> Option<U> {
        if self.index < self.length {
            let raw: T = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some((self.f)(raw))
        } else {
            None
        }
    }

    fn collect(self: MapIter<T, U>) -> Vec<U> {
        collect_iterator(self)
    }

    fn count(self: MapIter<T, U>) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// MapFilterIter — composed lazy map/filter adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that maps each source value and then filters the mapped value.
/// Item-generic: `map_f: fn(T) -> U` and `filter_f: fn(U) -> bool` keep the
/// concrete per-instance callback signatures on both backends (#860/#691).
pub struct MapFilterIter<T, U> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    map_f: fn(T) -> U,
    filter_f: fn(U) -> bool,
}

impl MapFilterIter<T, U> {
    /// Lazily limit the accepted mapped values to `n` elements.
    fn take(self: MapFilterIter<T, U>, n: i32) -> TakeIter<MapFilterIter<T, U>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl Iterator for MapFilterIter<T, U> {
    type Item = U

    fn next(self: MapFilterIter<T, U>) -> Option<U> {
        while self.index < self.length {
            let raw: T = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            let mapped: U = (self.map_f)(raw)
            // The predicate takes ownership of its callback argument. Keep
            // the mapped item for the yielded path by passing a clone.
            let predicate_value = clone(mapped)
            if (self.filter_f)(predicate_value) {
                return Some(mapped)
            }
        }
        None
    }

    fn collect(self: MapFilterIter<T, U>) -> Vec<U> {
        collect_iterator(self)
    }

    fn count(self: MapFilterIter<T, U>) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// FilterIter — lazy filter adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields only elements for which `f` returns `true`.
/// The adapter is item-generic: `f: fn(T) -> bool` keeps the concrete
/// per-instance callback signature on both backends (#860/#691).
pub struct FilterIter<T> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    f: fn(T) -> bool,
}

/// Construct a `FilterIter` over `v` with predicate `f`.
pub fn filter_iter(v: Vec<i32>, f: fn(i32) -> bool) -> FilterIter<i32> {
    vec_iter(v).filter(f)
}

impl FilterIter<T> {
    /// Lazily limit accepted values to `n` elements.
    fn take(self: FilterIter<T>, n: i32) -> TakeIter<FilterIter<T>> {
        TakeIter { iter: self, remaining: n }
    }

    /// Lazily transform accepted items with `f`. Method-level generics are
    /// not supported yet, so the mapped item keeps the source type `T`
    /// (filter-then-map is T -> T only; map-then-filter stays fully
    /// generic through `MapIter<T, U>::filter`) (#691 residual).
    fn map(self: FilterIter<T>, f: fn(T) -> T) -> FilterMapIter<T> {
        FilterMapIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            filter_f: self.f,
            map_f: f,
        }
    }
}

impl Iterator for FilterIter<T> {
    type Item = T

    fn next(self: FilterIter<T>) -> Option<T> {
        while self.index < self.length {
            let val: T = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            // The predicate takes ownership of its callback argument. Keep
            // the source item for the yielded path by passing a clone.
            let predicate_value = clone(val)
            if (self.f)(predicate_value) {
                return Some(val)
            }
        }
        None
    }

    fn collect(self: FilterIter<T>) -> Vec<T> {
        collect_iterator(self)
    }

    fn count(self: FilterIter<T>) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// FilterMapIter — composed lazy filter/map adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that keeps source items accepted by `filter_f` and then
/// transforms each accepted item with `map_f`. Item-generic over `T`; the
/// T -> T map bound mirrors `FilterIter<T>::map` (#860/#691).
pub struct FilterMapIter<T> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    filter_f: fn(T) -> bool,
    map_f: fn(T) -> T,
}

impl FilterMapIter<T> {
    /// Lazily limit the accepted mapped values to `n` elements.
    fn take(self: FilterMapIter<T>, n: i32) -> TakeIter<FilterMapIter<T>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl Iterator for FilterMapIter<T> {
    type Item = T

    fn next(self: FilterMapIter<T>) -> Option<T> {
        while self.index < self.length {
            let val: T = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            let predicate_value = clone(val)
            if (self.filter_f)(predicate_value) {
                return Some((self.map_f)(val))
            }
        }
        None
    }

    fn collect(self: FilterMapIter<T>) -> Vec<T> {
        collect_iterator(self)
    }

    fn count(self: FilterMapIter<T>) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// TakeIter — lazy take adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields at most `n` elements from the source.
/// The adapter wraps the source iterator instead of copying its
/// state, so any `I: Iterator` source can be bounded (ADR-078).
pub struct TakeIter<I> {
    iter: I,
    remaining: i32,
}

/// Construct a `TakeIter` over `v` limited to `n` elements.
pub fn take_iter(v: Vec<i32>, n: i32) -> TakeIter<VecIter> {
    vec_iter(v).take(n)
}

impl Iterator for TakeIter<I> {
    type Item = I::Item

    fn next(self: TakeIter<I>) -> Option<I::Item> {
        if self.remaining <= 0 {
            return None
        }
        let nxt = self.iter.next()
        match nxt {
            Some(val) => {
                self.remaining = self.remaining - 1
                Some(val)
            }
            None => None
        }
    }

    fn collect(self: TakeIter<I>) -> Vec<I::Item> {
        let out: Vec<I::Item> = Vec::new<I::Item>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: TakeIter<I>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// SkipIter — lazy skip adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that skips the first `n` elements of the source.
/// The adapter wraps the source iterator instead of copying its
/// state, so any `I: Iterator` source can be skipped (ADR-078).
pub struct SkipIter<I> {
    iter: I,
    to_skip: i32,
}

/// Construct a `SkipIter` over `v` that drops the first `n` elements.
pub fn skip_iter(v: Vec<i32>, n: i32) -> SkipIter<VecIter> {
    vec_iter(v).skip(n)
}

impl SkipIter<I> {
    /// Lazily map the source values after consuming the skip prefix.
    fn map(self: SkipIter<I>, f: fn(i32) -> i32) -> SkipMapIter<I> {
        SkipMapIter {
            iter: self.iter,
            to_skip: self.to_skip,
            map_f: f,
        }
    }

    /// Lazily filter the source values after consuming the skip prefix.
    fn filter(self: SkipIter<I>, f: fn(i32) -> bool) -> SkipFilterIter<I> {
        SkipFilterIter {
            iter: self.iter,
            to_skip: self.to_skip,
            filter_f: f,
        }
    }

    /// Lazily skip source values, then yield at most `n` remaining values.
    fn take(self: SkipIter<I>, n: i32) -> TakeIter<SkipIter<I>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl Iterator for SkipIter<I> {
    type Item = I::Item

    fn next(self: SkipIter<I>) -> Option<I::Item> {
        while self.to_skip > 0 {
            let nxt = self.iter.next()
            match nxt {
                Some(_) => self.to_skip = self.to_skip - 1
                None => return None
            }
        }
        self.iter.next()
    }

    fn collect(self: SkipIter<I>) -> Vec<I::Item> {
        let out: Vec<I::Item> = Vec::new<I::Item>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: SkipIter<I>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// SkipMapIter / SkipFilterIter — composed lazy skip/map, skip/filter adapters
// ---------------------------------------------------------------------------

/// Lazy iterator that skips source values before mapping the remainder.
/// The callback stays on the concrete i32 lane; the Iterator impl is
/// registered per instantiation (`SkipMapIter<VecIter>`).
pub struct SkipMapIter<I> {
    iter: I,
    to_skip: i32,
    map_f: fn(i32) -> i32,
}

/// Lazy iterator that skips source values before filtering the remainder.
pub struct SkipFilterIter<I> {
    iter: I,
    to_skip: i32,
    filter_f: fn(i32) -> bool,
}

impl Iterator for SkipMapIter<VecIter> {
    type Item = i32

    fn next(self: SkipMapIter<VecIter>) -> Option<i32> {
        while self.to_skip > 0 {
            let nxt = self.iter.next()
            match nxt {
                Some(_) => self.to_skip = self.to_skip - 1
                None => return None
            }
        }
        let nxt = self.iter.next()
        match nxt {
            Some(value) => Some((self.map_f)(value))
            None => None
        }
    }

    fn collect(self: SkipMapIter<VecIter>) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: SkipMapIter<VecIter>) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for SkipFilterIter<VecIter> {
    type Item = i32

    fn next(self: SkipFilterIter<VecIter>) -> Option<i32> {
        while self.to_skip > 0 {
            let nxt = self.iter.next()
            match nxt {
                Some(_) => self.to_skip = self.to_skip - 1
                None => return None
            }
        }
        let mut found = false
        let mut out: Option<i32> = None
        while !found {
            let nxt = self.iter.next()
            match nxt {
                Some(value) => {
                    if (self.filter_f)(value) {
                        out = Some(value)
                        found = true
                    }
                }
                None => found = true
            }
        }
        out
    }

    fn collect(self: SkipFilterIter<VecIter>) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: SkipFilterIter<VecIter>) -> i32 {
        count_iterator(self)
    }
}

// ---------------------------------------------------------------------------
// Pair — item type for enumerate/zip adapters
// ---------------------------------------------------------------------------

/// A two-element item produced by enumerate and zip adapters.
/// Keeping the pair as a real generic struct replaces the packed-i32
/// encoding that silently truncated items (ADR-076).
pub struct Pair<A, B> {
    first: A,
    second: B,
}

// ---------------------------------------------------------------------------
// ChainIter — lazy chain of two I: Iterator sources
// ---------------------------------------------------------------------------

/// Lazy iterator that yields all elements of `first` then all of `second`.
/// The adapter wraps the two source iterators instead of indexing the
/// vectors, so any `I: Iterator` pair can be chained (ADR-078).
pub struct ChainIter<I> {
    first: I,
    second: I,
    on_first: bool,
}

/// Construct a `ChainIter` over two vectors.
pub fn chain_iter(first: Vec<i32>, second: Vec<i32>) -> ChainIter<VecIter> {
    ChainIter {
        first: vec_iter(first),
        second: vec_iter(second),
        on_first: true,
    }
}

impl Iterator for ChainIter<I> {
    type Item = I::Item

    fn next(self: ChainIter<I>) -> Option<I::Item> {
        if !self.on_first {
            return self.second.next()
        }
        match self.first.next() {
            Some(v) => Some(v),
            None => {
                self.on_first = false
                self.second.next()
            }
        }
    }

    fn collect(self: ChainIter<I>) -> Vec<I::Item> {
        let out: Vec<I::Item> = Vec::new<I::Item>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: ChainIter<I>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// EnumerateIter — lazy enumerate adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields (index, value) items as `Pair<i32, I::Item>`.
/// The adapter wraps the source iterator, so any `I: Iterator` source can
/// be enumerated (ADR-078); items are real pairs rather than a packed
/// i32 encoding (ADR-076).
pub struct EnumerateIter<I> {
    iter: I,
    index: i32,
}

/// Construct an `EnumerateIter` over `v`.
pub fn enumerate_iter(v: Vec<i32>) -> EnumerateIter<VecIter> {
    EnumerateIter { iter: vec_iter(v), index: 0 }
}

impl Iterator for EnumerateIter<I> {
    type Item = Pair<i32, I::Item>

    fn next(self: EnumerateIter<I>) -> Option<Pair<i32, I::Item>> {
        let nxt = self.iter.next()
        match nxt {
            Some(v) => {
                let p: Pair<i32, I::Item> = Pair { first: self.index, second: v }
                self.index = self.index + 1
                Some(p)
            }
            None => None,
        }
    }

    fn collect(self: EnumerateIter<I>) -> Vec<Pair<i32, I::Item>> {
        let out: Vec<Pair<i32, I::Item>> = Vec::new<Pair<i32, I::Item>>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: EnumerateIter<I>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// ZipIter — lazy zip of two iterator sources
// ---------------------------------------------------------------------------

/// Lazy iterator that yields paired elements from two sources as
/// `Pair<A::Item, B::Item>` items. Iteration stops at the first
/// exhausted source.
pub struct ZipIter<A, B> {
    first: A,
    second: B,
}

/// Construct a `ZipIter` over two vectors. Iteration stops at the shorter length.
pub fn zip_iter(first: Vec<i32>, second: Vec<i32>) -> ZipIter<VecIter, VecIter> {
    ZipIter { first: vec_iter(first), second: vec_iter(second) }
}

impl Iterator for ZipIter<A, B> {
    type Item = Pair<A::Item, B::Item>

    fn next(self: ZipIter<A, B>) -> Option<Pair<A::Item, B::Item>> {
        let av = self.first.next()
        match av {
            Some(a) => {
                let bv = self.second.next()
                match bv {
                    Some(b) => Some(Pair { first: a, second: b }),
                    None => None,
                }
            }
            None => None,
        }
    }

    fn collect(self: ZipIter<A, B>) -> Vec<Pair<A::Item, B::Item>> {
        let out: Vec<Pair<A::Item, B::Item>> = Vec::new<Pair<A::Item, B::Item>>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: ZipIter<A, B>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// UniqueIter — lazy first-occurrence adapter over Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator that yields each source element only the first time it
/// appears. The seen buffer holds already-yielded values, so memory use is
/// proportional to the number of distinct items rather than the source
/// length; no intermediate result vector is allocated.
pub struct UniqueIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    seen: Vec<i32>,
}

/// Construct a UniqueIter over v.
pub fn unique_iter(v: Vec<i32>) -> UniqueIter {
    vec_iter(v).unique()
}

fn unique_seen_contains(seen: Vec<i32>, value: i32) -> bool {
    let n: i32 = len(seen)
    let mut i: i32 = 0
    let mut found: bool = false
    while i < n {
        if get_unchecked(seen, i) == value {
            found = true
        }
        i = i + 1
    }
    found
}

impl Iterator for UniqueIter {
    type Item = i32

    fn next(self: UniqueIter) -> Option<i32> {
        while self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            if !unique_seen_contains(self.seen, val) {
                push(self.seen, val)
                return Some(val)
            }
        }
        None
    }

    fn collect(self: UniqueIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: UniqueIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// RevIter — lazy reverse adapter over Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator that yields the remaining source elements in reverse order.
/// The index field tracks the first unconsumed slot and length the last, so
/// next steps length down without copying the source.
pub struct RevIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
}

/// Construct a RevIter over v.
pub fn rev_iter(v: Vec<i32>) -> RevIter {
    vec_iter(v).rev()
}

impl Iterator for RevIter {
    type Item = i32

    fn next(self: RevIter) -> Option<i32> {
        if self.length > self.index {
            self.length = self.length - 1
            Some(get_unchecked(self.vec, self.length))
        } else {
            None
        }
    }

    fn collect(self: RevIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: RevIter) -> i32 {
        count_iterator(self)
    }

}

