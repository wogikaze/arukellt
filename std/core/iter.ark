// ---------------------------------------------------------------------------
// IntoIterator identity conversions for concrete lazy adapters
// ---------------------------------------------------------------------------

// An iterator is already an iterable source. These identity conversions keep
// `for` on the same trait boundary as collection sources without allocating or
// changing the adapter state.
impl IntoIterator for MapIter {
    type Item = i32
    type IntoIter = MapIter

    fn into_iter(self: MapIter) -> MapIter {
        self
    }
}

impl IntoIterator for MapTakeIter {
    type Item = i32
    type IntoIter = MapTakeIter

    fn into_iter(self: MapTakeIter) -> MapTakeIter {
        self
    }
}

impl IntoIterator for MapFilterIter {
    type Item = i32
    type IntoIter = MapFilterIter

    fn into_iter(self: MapFilterIter) -> MapFilterIter {
        self
    }
}

impl IntoIterator for MapFilterTakeIter {
    type Item = i32
    type IntoIter = MapFilterTakeIter

    fn into_iter(self: MapFilterTakeIter) -> MapFilterTakeIter {
        self
    }
}

impl IntoIterator for FilterIter {
    type Item = i32
    type IntoIter = FilterIter

    fn into_iter(self: FilterIter) -> FilterIter {
        self
    }
}

impl IntoIterator for FilterTakeIter {
    type Item = i32
    type IntoIter = FilterTakeIter

    fn into_iter(self: FilterTakeIter) -> FilterTakeIter {
        self
    }
}

impl IntoIterator for TakeIter {
    type Item = i32
    type IntoIter = TakeIter

    fn into_iter(self: TakeIter) -> TakeIter {
        self
    }
}

impl IntoIterator for SkipIter {
    type Item = i32
    type IntoIter = SkipIter

    fn into_iter(self: SkipIter) -> SkipIter {
        self
    }
}

impl IntoIterator for SkipTakeIter {
    type Item = i32
    type IntoIter = SkipTakeIter

    fn into_iter(self: SkipTakeIter) -> SkipTakeIter {
        self
    }
}

impl IntoIterator for ChainIter {
    type Item = i32
    type IntoIter = ChainIter

    fn into_iter(self: ChainIter) -> ChainIter {
        self
    }
}

impl IntoIterator for EnumerateIter {
    type Item = i32
    type IntoIter = EnumerateIter

    fn into_iter(self: EnumerateIter) -> EnumerateIter {
        self
    }
}

impl IntoIterator for ZipIter {
    type Item = i32
    type IntoIter = ZipIter

    fn into_iter(self: ZipIter) -> ZipIter {
        self
    }
}

// ---------------------------------------------------------------------------
// collect — drain an iterator into a Vec<i32>
// ---------------------------------------------------------------------------

/// Drain a `VecIter` into a new `Vec<i32>`.
pub fn collect_vec_iter(it: VecIter) -> Vec<i32> {
    it.collect()
}

/// Drain a `MapIter` into a new `Vec<i32>`.
pub fn collect_map_iter(it: MapIter) -> Vec<i32> {
    it.collect()
}

/// Drain a `FilterIter` into a new `Vec<i32>`.
pub fn collect_filter_iter(it: FilterIter) -> Vec<i32> {
    it.collect()
}

/// Drain a `TakeIter` into a new `Vec<i32>`.
pub fn collect_take_iter(it: TakeIter) -> Vec<i32> {
    it.collect()
}

/// Drain a `SkipIter` into a new `Vec<i32>`.
pub fn collect_skip_iter(it: SkipIter) -> Vec<i32> {
    it.collect()
}

/// Drain a `ChainIter` into a new `Vec<i32>`.
pub fn collect_chain_iter(it: ChainIter) -> Vec<i32> {
    it.collect()
}

/// Drain a `RangeIter` into a new `Vec<i32>`.
pub fn collect_range_iter(it: RangeIter) -> Vec<i32> {
    it.collect()
}

// ---------------------------------------------------------------------------
// FromIterator impl for Vec<i32>
// ---------------------------------------------------------------------------

/// `FromIterator<i32>` impl for `Vec<i32>` — drains a `VecIter`.
impl FromIterator<VecIter> for Vec<i32> {
    fn from_iter(it: VecIter) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<i32>` impl for `Vec<i32>` — drains a half-open range.
impl FromIterator<RangeIter> for Vec<i32> {
    fn from_iter(it: RangeIter) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<i32>` impl for `Vec<i32>` — drains a closed range.
impl FromIterator<RangeInclusiveIter> for Vec<i32> {
    fn from_iter(it: RangeInclusiveIter) -> Vec<i32> {
        it.collect()
    }
}

/// `FromIterator<StringIter>` impl for `Vec<String>` — preserves each item.
impl FromIterator<StringIter> for Vec<String> {
    fn from_iter(it: StringIter) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<StringMapIter>` impl for `Vec<String>` — preserves mapped items.
impl FromIterator<StringMapIter> for Vec<String> {
    fn from_iter(it: StringMapIter) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<StringFilterIter>` impl for `Vec<String>` — preserves accepted items.
impl FromIterator<StringFilterIter> for Vec<String> {
    fn from_iter(it: StringFilterIter) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<StringMapTakeIter>` impl for `Vec<String>` — keeps the bound.
impl FromIterator<StringMapTakeIter> for Vec<String> {
    fn from_iter(it: StringMapTakeIter) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<StringFilterTakeIter>` impl for `Vec<String>` — keeps accepted items.
impl FromIterator<StringFilterTakeIter> for Vec<String> {
    fn from_iter(it: StringFilterTakeIter) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<StringMapFilterIter>` impl for `Vec<String>` — preserves filtered mapped items.
impl FromIterator<StringMapFilterIter> for Vec<String> {
    fn from_iter(it: StringMapFilterIter) -> Vec<String> {
        it.collect()
    }
}

/// `FromIterator<StringFilterMapIter>` impl for `Vec<String>` — maps accepted items.
impl FromIterator<StringFilterMapIter> for Vec<String> {
    fn from_iter(it: StringFilterMapIter) -> Vec<String> {
        it.collect()
    }
}

// ---------------------------------------------------------------------------
// Convenience pipeline functions (single-pass, no intermediate allocation)
// ---------------------------------------------------------------------------

/// Map `f` over `v` and collect into a new `Vec<i32>`.
///
/// This is the lazy-pipeline replacement for `std::seq::map_i32_i32`.
pub fn collect_map_i32(v: Vec<i32>, f: fn(i32) -> i32) -> Vec<i32> {
    v.iter().map(f).collect()
}

/// Filter `v` with `f` and collect into a new `Vec<i32>`.
///
/// This is the lazy-pipeline replacement for `std::seq::filter_i32`.
pub fn collect_filter_i32(v: Vec<i32>, f: fn(i32) -> bool) -> Vec<i32> {
    v.iter().filter(f).collect()
}

/// Take the first `n` elements of `v` and collect into a new `Vec<i32>`.
///
/// This is the lazy-pipeline replacement for `std::seq::take_i32`.
pub fn collect_take_i32(v: Vec<i32>, n: i32) -> Vec<i32> {
    v.iter().take(n).collect()
}

/// Skip the first `n` elements of `v` and collect the rest into a new `Vec<i32>`.
///
/// This is the lazy-pipeline replacement for `std::seq::skip_i32`.
pub fn collect_skip_i32(v: Vec<i32>, n: i32) -> Vec<i32> {
    v.iter().skip(n).collect()
}

/// Chain two vectors and collect into a new `Vec<i32>`.
pub fn collect_chain_i32(first: Vec<i32>, second: Vec<i32>) -> Vec<i32> {
    collect_chain_iter(chain_iter(first, second))
}

/// Collect a `Range` into a `Vec<i32>`.
pub fn collect_range_i32(r: Range) -> Vec<i32> {
    collect_range_iter(range_iter(r))
}

/// Map then filter in a single pass — no intermediate `Vec` allocation.
///
/// This replaces the eager `std::seq::map_i32_i32` + `std::seq::filter_i32`
/// chain with a single lazy traversal.
pub fn collect_map_filter_i32(v: Vec<i32>, map_f: fn(i32) -> i32, filter_f: fn(i32) -> bool) -> Vec<i32> {
    v.iter().map(map_f).filter(filter_f).collect()
}

/// Map, filter, then take in a single pass — no intermediate `Vec` allocation.
///
/// This is the canonical lazy pipeline fixture:
/// `v.iter().map(f).filter(g).take(n).collect()`.
pub fn collect_map_filter_take_i32(v: Vec<i32>, map_f: fn(i32) -> i32, filter_f: fn(i32) -> bool, n: i32) -> Vec<i32> {
    v.iter().map(map_f).filter(filter_f).take(n).collect()
}

/// Reduce `v` to a single value using `f`, starting from `init`.
///
/// This is the lazy-pipeline replacement for `std::seq::fold_i32_i32`.
pub fn iter_fold_i32(v: Vec<i32>, init: i32, f: fn(i32, i32) -> i32) -> i32 {
    vec_iter(v).fold(init, f)
}

/// Count the number of elements yielded by the iterator.
pub fn iter_count_i32(v: Vec<i32>) -> i32 {
    len(v)
}

fn add_i32_i32(a: i32, b: i32) -> i32 {
    a + b
}

/// Sum all elements of `v`.
pub fn iter_sum_i32(v: Vec<i32>) -> i32 {
    // Named callback: anonymous `fn(...)` closures currently emit an empty-stack
    // stub on GC targets (nop/drop/unreachable), which fails wasm validation.
    iter_fold_i32(v, 0, add_i32_i32)
}

/// Returns true if any element of `v` satisfies `f`.
pub fn iter_any_i32(v: Vec<i32>, f: fn(i32) -> bool) -> bool {
    let n: i32 = len(v)
    let mut i: i32 = 0
    let mut found: bool = false
    while i < n {
        if f(get_unchecked(v, i)) {
            found = true
        }
        i = i + 1
    }
    found
}

/// Returns true if all elements of `v` satisfy `f`.
pub fn iter_all_i32(v: Vec<i32>, f: fn(i32) -> bool) -> bool {
    let n: i32 = len(v)
    let mut i: i32 = 0
    let mut all: bool = true
    while i < n {
        if f(get_unchecked(v, i)) == false {
            all = false
        }
        i = i + 1
    }
    all
}
