// ---------------------------------------------------------------------------
// RangeIter — lazy adapter over Range
// ---------------------------------------------------------------------------

/// Lazy iterator over a half-open integer range `[start, end)`.
pub struct RangeIter {
    current: i32,
    end: i32,
}

/// Construct a `RangeIter` from a `Range`.
pub fn range_iter(r: Range) -> RangeIter {
    RangeIter { current: r.start, end: r.end }
}

impl Iterator for RangeIter {
    type Item = i32

    fn next(self: RangeIter) -> Option<i32> {
        if self.current < self.end {
            let val: i32 = self.current
            self.current = self.current + 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(self: RangeIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: RangeIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for Range {
    type Item = i32
    type IntoIter = RangeIter

    fn into_iter(self: Range) -> RangeIter {
        range_iter(self)
    }
}

// ---------------------------------------------------------------------------
// RangeInclusiveIter — lazy adapter over RangeInclusive
// ---------------------------------------------------------------------------

/// Lazy iterator over a closed integer range `[start, end]`.
pub struct RangeInclusiveIter {
    current: i32,
    end: i32,
}

/// Construct a `RangeInclusiveIter` from a `RangeInclusive`.
pub fn range_inclusive_iter(r: RangeInclusive) -> RangeInclusiveIter {
    RangeInclusiveIter { current: r.start, end: r.end }
}

impl Iterator for RangeInclusiveIter {
    type Item = i32

    fn next(self: RangeInclusiveIter) -> Option<i32> {
        if self.current <= self.end {
            let value: i32 = self.current
            self.current = self.current + 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: RangeInclusiveIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: RangeInclusiveIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for RangeInclusive {
    type Item = i32
    type IntoIter = RangeInclusiveIter

    fn into_iter(self: RangeInclusive) -> RangeInclusiveIter {
        range_inclusive_iter(self)
    }
}

// ---------------------------------------------------------------------------
// MapIter — lazy map adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that applies `f` to each element of the source vector.
pub struct MapIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    f: fn(i32) -> i32,
}

/// Construct a `MapIter` over `v` with transform `f`.
pub fn map_iter(v: Vec<i32>, f: fn(i32) -> i32) -> MapIter {
    vec_iter(v).map(f)
}

impl MapIter {
    /// Lazily limit mapped elements to `n` values.
    fn take(self: MapIter, n: i32) -> TakeIter<MapIter> {
        TakeIter { iter: self, remaining: n }
    }

    /// Lazily keep mapped elements accepted by `f`.
    fn filter(self: MapIter, f: fn(i32) -> bool) -> MapFilterIter {
        MapFilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.f,
            filter_f: f,
        }
    }
}

impl Iterator for MapIter {
    type Item = i32

    fn next(self: MapIter) -> Option<i32> {
        if self.index < self.length {
            let raw: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some((self.f)(raw))
        } else {
            None
        }
    }

    fn collect(self: MapIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: MapIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// MapFilterIter — composed lazy map/filter adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that maps each source value and then filters the mapped value.
pub struct MapFilterIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    map_f: fn(i32) -> i32,
    filter_f: fn(i32) -> bool,
}

impl MapFilterIter {
    /// Lazily limit the accepted mapped values to `n` elements.
    fn take(self: MapFilterIter, n: i32) -> TakeIter<MapFilterIter> {
        TakeIter { iter: self, remaining: n }
    }
}

impl Iterator for MapFilterIter {
    type Item = i32

    fn next(self: MapFilterIter) -> Option<i32> {
        while self.index < self.length {
            let raw: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            let mapped: i32 = (self.map_f)(raw)
            if (self.filter_f)(mapped) {
                return Some(mapped)
            }
        }
        None
    }

    fn collect(self: MapFilterIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: MapFilterIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// FilterIter — lazy filter adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields only elements for which `f` returns `true`.
pub struct FilterIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    f: fn(i32) -> bool,
}

/// Construct a `FilterIter` over `v` with predicate `f`.
pub fn filter_iter(v: Vec<i32>, f: fn(i32) -> bool) -> FilterIter {
    vec_iter(v).filter(f)
}

impl FilterIter {
    /// Lazily limit accepted values to `n` elements.
    fn take(self: FilterIter, n: i32) -> TakeIter<FilterIter> {
        TakeIter { iter: self, remaining: n }
    }
}

impl Iterator for FilterIter {
    type Item = i32

    fn next(self: FilterIter) -> Option<i32> {
        while self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            if (self.f)(val) {
                return Some(val)
            }
        }
        None
    }

    fn collect(self: FilterIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: FilterIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// TakeIter — lazy take adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields at most `n` elements from the source.
/// The adapter wraps the source iterator instead of copying its
/// state, so any `I: Iterator` source can be bounded (ADR-078).
pub struct TakeIter<I> {
    iter: I,
    remaining: i32,
}

/// Construct a `TakeIter` over `v` limited to `n` elements.
pub fn take_iter(v: Vec<i32>, n: i32) -> TakeIter<VecIter> {
    vec_iter(v).take(n)
}

impl Iterator for TakeIter<I> {
    type Item = I::Item

    fn next(self: TakeIter<I>) -> Option<I::Item> {
        if self.remaining <= 0 {
            return None
        }
        let nxt = self.iter.next()
        match nxt {
            Some(val) => {
                self.remaining = self.remaining - 1
                Some(val)
            }
            None => None
        }
    }

    fn collect(self: TakeIter<I>) -> Vec<I::Item> {
        let out: Vec<I::Item> = Vec::new<I::Item>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: TakeIter<I>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// SkipIter — lazy skip adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that skips the first `n` elements of the source.
/// The adapter wraps the source iterator instead of copying its
/// state, so any `I: Iterator` source can be skipped (ADR-078).
pub struct SkipIter<I> {
    iter: I,
    to_skip: i32,
}

/// Construct a `SkipIter` over `v` that drops the first `n` elements.
pub fn skip_iter(v: Vec<i32>, n: i32) -> SkipIter<VecIter> {
    vec_iter(v).skip(n)
}

impl SkipIter<I> {
    /// Lazily map the source values after consuming the skip prefix.
    fn map(self: SkipIter<I>, f: fn(i32) -> i32) -> SkipMapIter<I> {
        SkipMapIter {
            iter: self.iter,
            to_skip: self.to_skip,
            map_f: f,
        }
    }

    /// Lazily filter the source values after consuming the skip prefix.
    fn filter(self: SkipIter<I>, f: fn(i32) -> bool) -> SkipFilterIter<I> {
        SkipFilterIter {
            iter: self.iter,
            to_skip: self.to_skip,
            filter_f: f,
        }
    }

    /// Lazily skip source values, then yield at most `n` remaining values.
    fn take(self: SkipIter<I>, n: i32) -> TakeIter<SkipIter<I>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl Iterator for SkipIter<I> {
    type Item = I::Item

    fn next(self: SkipIter<I>) -> Option<I::Item> {
        while self.to_skip > 0 {
            let nxt = self.iter.next()
            match nxt {
                Some(_) => self.to_skip = self.to_skip - 1
                None => return None
            }
        }
        self.iter.next()
    }

    fn collect(self: SkipIter<I>) -> Vec<I::Item> {
        let out: Vec<I::Item> = Vec::new<I::Item>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: SkipIter<I>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// SkipMapIter / SkipFilterIter — composed lazy skip/map, skip/filter adapters
// ---------------------------------------------------------------------------

/// Lazy iterator that skips source values before mapping the remainder.
/// The callback stays on the concrete i32 lane; the Iterator impl is
/// registered per instantiation (`SkipMapIter<VecIter>`).
pub struct SkipMapIter<I> {
    iter: I,
    to_skip: i32,
    map_f: fn(i32) -> i32,
}

/// Lazy iterator that skips source values before filtering the remainder.
pub struct SkipFilterIter<I> {
    iter: I,
    to_skip: i32,
    filter_f: fn(i32) -> bool,
}

impl Iterator for SkipMapIter<VecIter> {
    type Item = i32

    fn next(self: SkipMapIter<VecIter>) -> Option<i32> {
        while self.to_skip > 0 {
            let nxt = self.iter.next()
            match nxt {
                Some(_) => self.to_skip = self.to_skip - 1
                None => return None
            }
        }
        let nxt = self.iter.next()
        match nxt {
            Some(value) => Some((self.map_f)(value))
            None => None
        }
    }

    fn collect(self: SkipMapIter<VecIter>) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: SkipMapIter<VecIter>) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for SkipFilterIter<VecIter> {
    type Item = i32

    fn next(self: SkipFilterIter<VecIter>) -> Option<i32> {
        while self.to_skip > 0 {
            let nxt = self.iter.next()
            match nxt {
                Some(_) => self.to_skip = self.to_skip - 1
                None => return None
            }
        }
        let mut found = false
        let mut out: Option<i32> = None
        while !found {
            let nxt = self.iter.next()
            match nxt {
                Some(value) => {
                    if (self.filter_f)(value) {
                        out = Some(value)
                        found = true
                    }
                }
                None => found = true
            }
        }
        out
    }

    fn collect(self: SkipFilterIter<VecIter>) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: SkipFilterIter<VecIter>) -> i32 {
        count_iterator(self)
    }
}

// ---------------------------------------------------------------------------
// ChainIter — lazy chain of two Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator that yields all elements of `first` then all of `second`.
pub struct ChainIter {
    first: Vec<i32>,
    second: Vec<i32>,
    index: i32,
    first_len: i32,
    second_len: i32,
}

/// Construct a `ChainIter` over two vectors.
pub fn chain_iter(first: Vec<i32>, second: Vec<i32>) -> ChainIter {
    ChainIter {
        first: first,
        second: second,
        index: 0,
        first_len: len(first),
        second_len: len(second),
    }
}

impl Iterator for ChainIter {
    type Item = i32

    fn next(self: ChainIter) -> Option<i32> {
        if self.index < self.first_len {
            let val: i32 = get_unchecked(self.first, self.index)
            self.index = self.index + 1
            Some(val)
        } else {
            let second_index: i32 = self.index - self.first_len
            if second_index < self.second_len {
                let val: i32 = get_unchecked(self.second, second_index)
                self.index = self.index + 1
                Some(val)
            } else {
                None
            }
        }
    }

    fn collect(self: ChainIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: ChainIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// EnumerateIter — lazy enumerate adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields `(index, value)` pairs as a packed i32.
///
/// The index is stored in the high 16 bits and the value in the low 16 bits
/// so the result fits in a single `i32`. This keeps the adapter monomorphic
/// while still carrying both pieces of information.
pub struct EnumerateIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
}

/// Construct an `EnumerateIter` over `v`.
pub fn enumerate_iter(v: Vec<i32>) -> EnumerateIter {
    EnumerateIter { vec: v, index: 0, length: len(v) }
}

impl Iterator for EnumerateIter {
    type Item = i32

    fn next(self: EnumerateIter) -> Option<i32> {
        if self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            let packed: i32 = self.index * 65536 + val
            self.index = self.index + 1
            Some(packed)
        } else {
            None
        }
    }

    fn collect(self: EnumerateIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: EnumerateIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// ZipIter — lazy zip of two Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator that yields paired elements from two vectors as a packed i32.
///
/// The first vector's element occupies the high 16 bits and the second's the
/// low 16 bits.
pub struct ZipIter {
    first: Vec<i32>,
    second: Vec<i32>,
    index: i32,
    length: i32,
}

/// Construct a `ZipIter` over two vectors. Iteration stops at the shorter length.
pub fn zip_iter(first: Vec<i32>, second: Vec<i32>) -> ZipIter {
    let len_a: i32 = len(first)
    let len_b: i32 = len(second)
    let min_len: i32 = if len_a < len_b { len_a } else { len_b }
    ZipIter { first: first, second: second, index: 0, length: min_len }
}

impl Iterator for ZipIter {
    type Item = i32

    fn next(self: ZipIter) -> Option<i32> {
        if self.index < self.length {
            let a: i32 = get_unchecked(self.first, self.index)
            let b: i32 = get_unchecked(self.second, self.index)
            self.index = self.index + 1
            Some(a * 65536 + b)
        } else {
            None
        }
    }

    fn collect(self: ZipIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: ZipIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// UniqueIter — lazy first-occurrence adapter over Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator that yields each source element only the first time it
/// appears. The seen buffer holds already-yielded values, so memory use is
/// proportional to the number of distinct items rather than the source
/// length; no intermediate result vector is allocated.
pub struct UniqueIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    seen: Vec<i32>,
}

/// Construct a UniqueIter over v.
pub fn unique_iter(v: Vec<i32>) -> UniqueIter {
    vec_iter(v).unique()
}

fn unique_seen_contains(seen: Vec<i32>, value: i32) -> bool {
    let n: i32 = len(seen)
    let mut i: i32 = 0
    let mut found: bool = false
    while i < n {
        if get_unchecked(seen, i) == value {
            found = true
        }
        i = i + 1
    }
    found
}

impl Iterator for UniqueIter {
    type Item = i32

    fn next(self: UniqueIter) -> Option<i32> {
        while self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            if !unique_seen_contains(self.seen, val) {
                push(self.seen, val)
                return Some(val)
            }
        }
        None
    }

    fn collect(self: UniqueIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: UniqueIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// RevIter — lazy reverse adapter over Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator that yields the remaining source elements in reverse order.
/// The index field tracks the first unconsumed slot and length the last, so
/// next steps length down without copying the source.
pub struct RevIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
}

/// Construct a RevIter over v.
pub fn rev_iter(v: Vec<i32>) -> RevIter {
    vec_iter(v).rev()
}

impl Iterator for RevIter {
    type Item = i32

    fn next(self: RevIter) -> Option<i32> {
        if self.length > self.index {
            self.length = self.length - 1
            Some(get_unchecked(self.vec, self.length))
        } else {
            None
        }
    }

    fn collect(self: RevIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: RevIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// Numeric consumer capabilities for the concrete i32 iterator lane
// ---------------------------------------------------------------------------

// These capabilities are intentionally separate from `Iterator`: a
// non-numeric item type must not acquire an invented sum or fold meaning just
// to satisfy the producer protocol.
impl IteratorSum<i32, i32> for VecIter {
    fn sum(self: VecIter) -> i32 {
        sum_iterator_i32(self)
    }
}

impl IteratorFold<i32, i32> for VecIter {
    fn fold(self: VecIter, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        fold_iterator_i32(self, init, f)
    }
}

impl IteratorSum<i32, i32> for RangeIter {
    fn sum(self: RangeIter) -> i32 {
        sum_iterator_i32(self)
    }
}

impl IteratorFold<i32, i32> for RangeIter {
    fn fold(self: RangeIter, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        fold_iterator_i32(self, init, f)
    }
}

impl IteratorSum<i32, i32> for RangeInclusiveIter {
    fn sum(self: RangeInclusiveIter) -> i32 {
        sum_iterator_i32(self)
    }
}

impl IteratorFold<i32, i32> for RangeInclusiveIter {
    fn fold(self: RangeInclusiveIter, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        fold_iterator_i32(self, init, f)
    }
}

impl IteratorSum<i32, i32> for MapIter {
    fn sum(self: MapIter) -> i32 {
        sum_iterator_i32(self)
    }
}

impl IteratorFold<i32, i32> for MapIter {
    fn fold(self: MapIter, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        fold_iterator_i32(self, init, f)
    }
}

impl IteratorSum<i32, i32> for TakeIter<MapIter> {
    fn sum(self: TakeIter<MapIter>) -> i32 {
        sum_iterator_i32(self)
    }
}

impl IteratorFold<i32, i32> for TakeIter<MapIter> {
    fn fold(self: TakeIter<MapIter>, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        fold_iterator_i32(self, init, f)
    }
}

impl IteratorSum<i32, i32> for MapFilterIter {
    fn sum(self: MapFilterIter) -> i32 {
        sum_iterator_i32(self)
    }
}

impl IteratorFold<i32, i32> for MapFilterIter {
    fn fold(self: MapFilterIter, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        fold_iterator_i32(self, init, f)
    }
}

impl IteratorSum<i32, i32> for TakeIter<MapFilterIter> {
    fn sum(self: TakeIter<MapFilterIter>) -> i32 {
        sum_iterator_i32(self)
    }
}

impl IteratorFold<i32, i32> for TakeIter<MapFilterIter> {
    fn fold(self: TakeIter<MapFilterIter>, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        fold_iterator_i32(self, init, f)
    }
}

impl IteratorSum<i32, i32> for FilterIter {
    fn sum(self: FilterIter) -> i32 {
        sum_iterator_i32(self)
    }
}

impl IteratorFold<i32, i32> for FilterIter {
    fn fold(self: FilterIter, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        fold_iterator_i32(self, init, f)
    }
}

impl IteratorSum<i32, i32> for TakeIter<FilterIter> {
    fn sum(self: TakeIter<FilterIter>) -> i32 {
        sum_iterator_i32(self)
    }
}

impl IteratorFold<i32, i32> for TakeIter<FilterIter> {
    fn fold(self: TakeIter<FilterIter>, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        fold_iterator_i32(self, init, f)
    }
}

// Capability traits stay per-instantiation: a parametric impl would
// claim numeric aggregation for non-numeric sources such as
// TakeIter<StringIter>, which ADR-076 reserves to i32 lanes.
impl IteratorSum<i32, i32> for TakeIter<VecIter> {
    fn sum(self: TakeIter<VecIter>) -> i32 {
        sum_iterator_i32(self)
    }
}

impl IteratorFold<i32, i32> for TakeIter<VecIter> {
    fn fold(self: TakeIter<VecIter>, init: i32, f: fn(i32, i32) -> i32) -> i32 {
        fold_iterator_i32(self, init, f)
    }
}

