//! std::core::iter — `Iterator`, `IntoIterator`, `FromIterator` traits and
//! lazy adapter types.
//!
//! This module formalises the iteration protocol that the `for x in v` syntax
//! uses structurally (a `next() -> Option<T>` method). It defines the three
//! core traits from Rust's `std::iter` and provides lazy adapter structs that
//! hold an upstream source plus a closure, pulling elements on demand.
//!
//! Because Arukellt's monomorphisation model does not yet support trait-object
//! dynamic dispatch, adapters are monomorphised per concrete instantiation.
//! The map/filter adapter family is item-generic (`MapIter<T, U>` holds
//! `f: fn(T) -> U`), so the same adapter code serves `Vec<i32>` and
//! `Vec<String>` pipelines; the skip-first family keeps concrete String
//! adapters until skip compositions can spell `fn(I::Item) -> U` (#691).
//! Item-preserving iteration is kept separate from numeric consumers so
//! another item representation can
//! implement `Iterator` without inventing a numeric meaning. Generic trait
//! definitions are included to formalise the protocol and enable future
//! generalisation.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

// ---------------------------------------------------------------------------
// Trait definitions
// ---------------------------------------------------------------------------

/// Trait for lazy, pull-based iteration over a sequence of `T` values.
///
/// `next` returns `Option::Some(item)` for each successive element or
/// `Option::None` when the iterator is exhausted. `collect` drains and
/// `count` counts through the same item-preserving trait dispatch path.
/// This mirrors the structural protocol that `for x in v` already uses — any
/// type with a `next() -> Option<T>` method is iterable.
///
/// ## Protocol catalog: `Iterator`
///
/// | Type        | Status | Notes                                  |
/// |-------------|--------|----------------------------------------|
/// | VecIter<T>  | impl   | Item-generic adapter over `Vec<T>`      |
/// | RangeIter   | impl   | Adapter over `Range`                   |
/// | RangeInclusiveIter | impl | Adapter over `RangeInclusive`      |
/// | MapIter<T,U> | impl | Lazy map adapter over `Vec<T>`           |
/// | FilterIter<T> | impl | Lazy filter adapter over `Vec<T>`       |
/// | MapFilterIter<T,U> | impl | Composed map/filter pipeline      |
/// | FilterMapIter<T,U> | impl | Composed filter/map pipeline      |
/// | TakeIter<I> | impl   | Lazy take adapter over any source      |
/// | SkipIter<I> | impl   | Lazy skip adapter over any source      |
/// | ChainIter<I> | impl  | Lazy chain of two `I: Iterator` sources |
/// | EnumerateIter<I> | impl | Lazy enumerate yielding `Pair` items |
/// | ZipIter<A,B> | impl | Lazy zip yielding `Pair` items           |
/// | SkipMapIter<I> | impl | Composed skip/map pipeline           |
/// | SkipFilterIter<I> | impl | Composed skip/filter pipeline       |
pub trait Iterator {
    type Item
    fn next(self: Self) -> Option<Self::Item>
    fn collect(self: Self) -> Vec<Self::Item>
    fn count(self: Self) -> i32
}

/// Concrete-item producer capability for the numeric i32 consumers.
///
/// `Iterator`'s `Item` is an associated type, so a helper bounded only by
/// `Iterator` sees `T::Item` as a symbolic projection and cannot prove the
/// match payload is i32. This capability states that proof for each adapter
/// that participates in the i32 lane, keeping the numeric helpers free of an
/// unchecked payload read.
trait IteratorI32 {
    fn next_i32(mut self: Self) -> Option<i32>
}

/// Numeric sum capability for a concrete iterator item/output pair.
pub trait IteratorSum<Item, Output> {
    fn sum(self: Self) -> Output
}

/// Numeric fold capability for a concrete iterator item/accumulator pair.
pub trait IteratorFold<Item, Accumulator> {
    fn fold(self: Self, init: Accumulator, f: fn(Accumulator, Item) -> Accumulator) -> Accumulator
}

/// Membership-test capability for a concrete iterator item type.
pub trait IteratorContains<Item> {
    fn contains(self: Self, target: Item) -> bool
}

/// Equality-counting capability for a concrete iterator item type.
pub trait IteratorCountEq<Item> {
    fn count_eq(self: Self, target: Item) -> i32
}

/// Trait for types that can be converted into an iterator.
///
/// `into_iter` consumes `self` and returns an `Iterator<T>`.
pub trait IntoIterator {
    type Item
    type IntoIter
    fn into_iter(self: Self) -> Self::IntoIter
}

/// Trait for collections that can be built from an iterator.
///
/// `from_iter` drains an iterator and constructs the collection.
pub trait FromIterator<T> {
    fn from_iter(it: T) -> Self
}

// Keep collection traversal in one generic implementation so every adapter
// uses the same associated-item result type.
fn collect_iterator<T: Iterator>(mut it: T) -> Vec<T::Item> {
    let mut result: Vec<T::Item> = Vec::new<T::Item>()
    while true {
        match it.next() {
            Some(v) => push(result, v),
            None => { break },
        }
    }
    result
}

fn count_iterator<T: Iterator>(mut it: T) -> i32 {
    let mut count: i32 = 0
    while true {
        match it.next() {
            Some(_) => count = count + 1,
            None => { break },
        }
    }
    count
}

fn sum_iterator_i32<T: IteratorI32>(mut it: T) -> i32 {
    let mut total: i32 = 0
    while true {
        match it.next_i32() {
            Some(v) => total = total + v,
            None => { break },
        }
    }
    total
}

fn fold_iterator_i32<T: IteratorI32>(mut it: T, init: i32, f: fn(i32, i32) -> i32) -> i32 {
    let mut total: i32 = init
    while true {
        match it.next_i32() {
            Some(v) => total = f(total, v),
            None => { break },
        }
    }
    total
}

fn contains_iterator_i32<T: IteratorI32>(mut it: T, target: i32) -> bool {
    let mut found: bool = false
    while true {
        match it.next_i32() {
            Some(v) => {
                if v == target {
                    found = true
                    break
                }
            },
            None => { break },
        }
    }
    found
}

fn count_eq_iterator_i32<T: IteratorI32>(mut it: T, target: i32) -> i32 {
    let mut hits: i32 = 0
    while true {
        match it.next_i32() {
            Some(v) => {
                if v == target {
                    hits = hits + 1
                }
            },
            None => { break },
        }
    }
    hits
}

fn any_iterator_i32<T: IteratorI32>(mut it: T, f: fn(i32) -> bool) -> bool {
    let mut found: bool = false
    while true {
        match it.next_i32() {
            Some(v) => {
                if f(v) {
                    found = true
                    break
                }
            },
            None => { break },
        }
    }
    found
}

fn all_iterator_i32<T: IteratorI32>(mut it: T, f: fn(i32) -> bool) -> bool {
    let mut all: bool = true
    while true {
        match it.next_i32() {
            Some(v) => {
                if f(v) == false {
                    all = false
                    break
                }
            },
            None => { break },
        }
    }
    all
}
// ---------------------------------------------------------------------------
// VecIter<i32> — item-generic lazy adapter over Vec<T>
// ---------------------------------------------------------------------------

/// Lazy iterator over the elements of a `Vec<T>`.
///
/// Holds a reference to the source vector and a current index. Each `next`
/// call advances the index and returns the next element, or `None` when the
/// end is reached. Item-generic so the i32 and String lanes share one
/// adapter (#860/#691).
pub struct VecIter<T> {
    vec: Vec<T>,
    index: i32,
    length: i32,
}

/// Return the canonical lazy iterator for a `Vec<T>`.
///
/// One generic impl covers every element type. Per-instantiation inherent
/// impls for `Vec` all register the bare `Vec::iter` owner, so an
/// `impl Vec<i64>` beside `impl Vec<i32>` would be shadowed rather than
/// selected; the element type must stay a parameter here.
impl<T> Vec<T> {
    fn iter(self: Vec<T>) -> VecIter<T> {
        VecIter { vec: self, index: 0, length: self.len() }
    }
}

impl<T> VecIter<T> {
    /// Returns true when no more elements remain.
    fn is_empty(self: VecIter<T>) -> bool {
        self.index >= self.length
    }

    /// Lazily transform the remaining elements with `f`. The method has
    /// its own item type parameter `U`, so the callback may change the
    /// element type and the result stays lazy as `MapIter<T, U>` (#887).
    fn map<U>(self: VecIter<T>, f: fn(T) -> U) -> MapIter<T, U> {
        MapIter { vec: self.vec, index: self.index, length: self.length, f: f }
    }

    /// Lazily keep the remaining elements accepted by `f`.
    fn filter(self: VecIter<T>, f: fn(T) -> bool) -> FilterIter<T> {
        FilterIter { vec: self.vec, index: self.index, length: self.length, f: f }
    }

    /// Lazily limit the remaining elements to `n` values.
    fn take(self: VecIter<T>, n: i32) -> TakeIter<VecIter<T>> {
        TakeIter { iter: self, remaining: n }
    }

    /// Lazily skip `n` values from the remaining elements.
    fn skip(self: VecIter<T>, n: i32) -> SkipIter<VecIter<T>> {
        SkipIter { iter: self, to_skip: n }
    }

    /// Lazily yield the remaining elements of `self`, then those of `other`.
    /// Both sources must share the concrete `VecIter<T>` state type because
    /// `ChainIter<I>` stores one source type for each half.
    fn chain(self: VecIter<T>, other: VecIter<T>) -> ChainIter<VecIter<T>> {
        ChainIter { first: self, second: other, on_first: true }
    }

    /// Pair each remaining element with its zero-based position.
    fn enumerate(self: VecIter<T>) -> EnumerateIter<VecIter<T>> {
        EnumerateIter { iter: self, index: 0 }
    }

    /// Lazily pair `self` with `other`, stopping when either side is
    /// exhausted. The item type parameter keeps the two lanes independent.
    fn zip<U>(self: VecIter<T>, other: VecIter<U>) -> ZipIter<VecIter<T>, VecIter<U>> {
        ZipIter { first: self, second: other }
    }

    /// Lazily expand each remaining element through `f` into a `Vec<T>`
    /// and yield the produced items in order. The callback keeps the
    /// same item type on both sides; `map` covers the type-changing case.
    fn flat_map(self: VecIter<T>, f: fn(T) -> Vec<T>) -> FlatMapIter<T> {
        FlatMapIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            inner: Vec::new<T>(),
            inner_index: 0,
            f: f,
        }
    }

    /// Wrap the remaining elements so the next item can be inspected with
    /// `peek` before it is consumed.
    fn peekable(self: VecIter<T>) -> PeekIter<T> {
        PeekIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            peeked: Vec::new<T>(),
        }
    }

    /// Lazily yield every `n`-th remaining element. A non-positive step
    /// is clamped to 1 so the adapter cannot stall the stream.
    fn step_by(self: VecIter<T>, n: i32) -> StepByIter<T> {
        let s = if n <= 0 { 1 } else { n }
        StepByIter { vec: self.vec, index: self.index, length: self.length, step: s }
    }

    /// Lazily thread a state through `f`, yielding each intermediate
    /// result. Stops and stays exhausted once `f` returns `None`
    /// (Rust `scan` semantics).
    fn scan(self: VecIter<T>, init: T, f: fn(T, T) -> Option<T>) -> ScanIter<T> {
        ScanIter { vec: self.vec, index: self.index, length: self.length, state: init, f: f }
    }

    /// Returns true when `f` accepts at least one remaining element.
    fn any(self: VecIter<T>, f: fn(T) -> bool) -> bool {
        let mut index = self.index
        while index < self.length {
            if f(self.vec.get_unchecked(index)) {
                return true
            }
            index = index + 1
        }
        false
    }

    /// Returns true when `f` accepts every remaining element. An empty
    /// range is vacuously true, matching the `Iterator::all` contract.
    fn all(self: VecIter<T>, f: fn(T) -> bool) -> bool {
        let mut index = self.index
        while index < self.length {
            if f(self.vec.get_unchecked(index)) == false {
                return false
            }
            index = index + 1
        }
        true
    }

    /// Returns the first remaining element accepted by `f`.
    fn find(self: VecIter<T>, f: fn(T) -> bool) -> Option<T> {
        let mut index = self.index
        while index < self.length {
            let value = self.vec.get_unchecked(index)
            if f(value) {
                return Some(value)
            }
            index = index + 1
        }
        None
    }
}

/// i32-only adapters whose item type is fixed by the concrete `UniqueIter`
/// and `RevIter` state types.
impl VecIter<i32> {
    /// Lazily yield each remaining element the first time it appears.
    fn unique(self: VecIter<i32>) -> UniqueIter {
        UniqueIter { vec: self.vec, index: self.index, length: self.length, seen: Vec::new<i32>() }
    }

    /// Lazily yield the remaining elements in reverse order.
    fn rev(self: VecIter<i32>) -> RevIter {
        RevIter { vec: self.vec, index: self.index, length: self.length }
    }
}

impl<T> Iterator for VecIter<T> {
    type Item = T

    fn next(mut self: VecIter<T>) -> Option<T> {
        if self.index < self.length {
            let val: T = self.vec.get_unchecked(self.index)
            self.index = self.index + 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(mut self: VecIter<T>) -> Vec<T> {
        collect_iterator(self)
    }

    fn count(mut self: VecIter<T>) -> i32 {
        count_iterator(self)
    }

}

impl<T> IntoIterator for VecIter<T> {
    type Item = T
    type IntoIter = VecIter<T>

    fn into_iter(self: VecIter<T>) -> VecIter<T> {
        self
    }
}

/// Convert a `Vec<i32>` into the canonical lazy iterator over its elements.
impl IntoIterator for Vec<i32> {
    type Item = i32
    type IntoIter = VecIter<i32>

    fn into_iter(self: Vec<i32>) -> VecIter<i32> {
        self.iter()
    }
}

// ---------------------------------------------------------------------------
// Vec<String> iteration — the same item-generic VecIter<T> adapter
// ---------------------------------------------------------------------------

impl Vec<String> {
    /// Return the canonical lazy iterator for a `Vec<String>`.
    fn iter(self: Vec<String>) -> VecIter<String> {
        VecIter { vec: self, index: 0, length: self.len() }
    }
}

impl IntoIterator for Vec<String> {
    type Item = String
    type IntoIter = VecIter<String>

    fn into_iter(self: Vec<String>) -> VecIter<String> {
        self.iter()
    }
}

// ---------------------------------------------------------------------------
// RangeIter — lazy adapter over Range
// ---------------------------------------------------------------------------

/// Lazy iterator over a half-open integer range `[start, end)`.
pub struct RangeIter {
    current: i32,
    end: i32,
}

impl Iterator for RangeIter {
    type Item = i32

    fn next(mut self: RangeIter) -> Option<i32> {
        if self.current < self.end {
            let val: i32 = self.current
            self.current = self.current + 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(mut self: RangeIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(mut self: RangeIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for Range {
    type Item = i32
    type IntoIter = RangeIter

    fn into_iter(self: Range) -> RangeIter {
        RangeIter { current: self.start, end: self.end }
    }
}

// ---------------------------------------------------------------------------
// RangeInclusiveIter — lazy adapter over RangeInclusive
// ---------------------------------------------------------------------------

/// Lazy iterator over a closed integer range `[start, end]`.
pub struct RangeInclusiveIter {
    current: i32,
    end: i32,
}

impl Iterator for RangeInclusiveIter {
    type Item = i32

    fn next(mut self: RangeInclusiveIter) -> Option<i32> {
        if self.current <= self.end {
            let value: i32 = self.current
            self.current = self.current + 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(mut self: RangeInclusiveIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(mut self: RangeInclusiveIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for RangeInclusive {
    type Item = i32
    type IntoIter = RangeInclusiveIter

    fn into_iter(self: RangeInclusive) -> RangeInclusiveIter {
        RangeInclusiveIter { current: self.start, end: self.end }
    }
}

// ---------------------------------------------------------------------------
// MapIter — lazy map adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that applies `f` to each element of the source vector.
/// The adapter is item-generic: `f: fn(T) -> U` keeps the concrete
/// per-instance callback signature on both backends (#860/#691).
pub struct MapIter<T, U> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    f: fn(T) -> U,
}

impl<T, U> MapIter<T, U> {
    /// Lazily limit mapped elements to `n` values.
    fn take(self: MapIter<T, U>, n: i32) -> TakeIter<MapIter<T, U>> {
        TakeIter { iter: self, remaining: n }
    }

    /// Lazily keep mapped elements accepted by `f`.
    fn filter(self: MapIter<T, U>, f: fn(U) -> bool) -> MapFilterIter<T, U> {
        MapFilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.f,
            filter_f: f,
        }
    }
}

impl<T, U> Iterator for MapIter<T, U> {
    type Item = U

    fn next(mut self: MapIter<T, U>) -> Option<U> {
        if self.index < self.length {
            let raw: T = self.vec.get_unchecked(self.index)
            self.index = self.index + 1
            Some((self.f)(raw))
        } else {
            None
        }
    }

    fn collect(mut self: MapIter<T, U>) -> Vec<U> {
        collect_iterator(self)
    }

    fn count(mut self: MapIter<T, U>) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// MapFilterIter — composed lazy map/filter adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that maps each source value and then filters the mapped value.
/// Item-generic: `map_f: fn(T) -> U` and `filter_f: fn(U) -> bool` keep the
/// concrete per-instance callback signatures on both backends (#860/#691).
pub struct MapFilterIter<T, U> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    map_f: fn(T) -> U,
    filter_f: fn(U) -> bool,
}

impl<T, U> MapFilterIter<T, U> {
    /// Lazily limit the accepted mapped values to `n` elements.
    fn take(self: MapFilterIter<T, U>, n: i32) -> TakeIter<MapFilterIter<T, U>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl<T, U> Iterator for MapFilterIter<T, U> {
    type Item = U

    fn next(mut self: MapFilterIter<T, U>) -> Option<U> {
        while self.index < self.length {
            let raw: T = self.vec.get_unchecked(self.index)
            self.index = self.index + 1
            let mapped: U = (self.map_f)(raw)
            // The predicate takes ownership of its callback argument. Keep
            // the mapped item for the yielded path by passing a clone.
            let predicate_value = mapped.clone()
            if (self.filter_f)(predicate_value) {
                return Some(mapped)
            }
        }
        None
    }

    fn collect(mut self: MapFilterIter<T, U>) -> Vec<U> {
        collect_iterator(self)
    }

    fn count(mut self: MapFilterIter<T, U>) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// FilterIter — lazy filter adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields only elements for which `f` returns `true`.
/// The adapter is item-generic: `f: fn(T) -> bool` keeps the concrete
/// per-instance callback signature on both backends (#860/#691).
pub struct FilterIter<T> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    f: fn(T) -> bool,
}

impl<T> FilterIter<T> {
    /// Lazily limit accepted values to `n` elements.
    fn take(self: FilterIter<T>, n: i32) -> TakeIter<FilterIter<T>> {
        TakeIter { iter: self, remaining: n }
    }

    /// Lazily transform accepted items with `f`. The method has its own
    /// item type parameter `U`, so filter-then-map may change the element
    /// type just like `VecIter<T>::map` (#887).
    fn map<U>(self: FilterIter<T>, f: fn(T) -> U) -> FilterMapIter<T, U> {
        FilterMapIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            filter_f: self.f,
            map_f: f,
        }
    }
}

impl<T> Iterator for FilterIter<T> {
    type Item = T

    fn next(mut self: FilterIter<T>) -> Option<T> {
        while self.index < self.length {
            let val: T = self.vec.get_unchecked(self.index)
            self.index = self.index + 1
            // The predicate takes ownership of its callback argument. Keep
            // the source item for the yielded path by passing a clone.
            let predicate_value = val.clone()
            if (self.f)(predicate_value) {
                return Some(val)
            }
        }
        None
    }

    fn collect(mut self: FilterIter<T>) -> Vec<T> {
        collect_iterator(self)
    }

    fn count(mut self: FilterIter<T>) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// FilterMapIter — composed lazy filter/map adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that keeps source items accepted by `filter_f` and then
/// transforms each accepted item with `map_f`. The mapped item has its own
/// type parameter `U` so the adapter can change the element type (#887).
pub struct FilterMapIter<T, U> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    filter_f: fn(T) -> bool,
    map_f: fn(T) -> U,
}

impl<T, U> FilterMapIter<T, U> {
    /// Lazily limit the accepted mapped values to `n` elements.
    fn take(self: FilterMapIter<T, U>, n: i32) -> TakeIter<FilterMapIter<T, U>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl<T, U> Iterator for FilterMapIter<T, U> {
    type Item = U

    fn next(mut self: FilterMapIter<T, U>) -> Option<U> {
        while self.index < self.length {
            let val: T = self.vec.get_unchecked(self.index)
            self.index = self.index + 1
            let predicate_value = val.clone()
            if (self.filter_f)(predicate_value) {
                return Some((self.map_f)(val))
            }
        }
        None
    }

    fn collect(mut self: FilterMapIter<T, U>) -> Vec<U> {
        collect_iterator(self)
    }

    fn count(mut self: FilterMapIter<T, U>) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// TakeIter — lazy take adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields at most `n` elements from the source.
/// The adapter wraps the source iterator instead of copying its
/// state, so any `I: Iterator` source can be bounded (ADR-078).
pub struct TakeIter<I> {
    iter: I,
    remaining: i32,
}

impl<I> Iterator for TakeIter<I> {
    type Item = I::Item

    fn next(mut self: TakeIter<I>) -> Option<I::Item> {
        if self.remaining <= 0 {
            return None
        }
        let nxt = self.iter.next()
        match nxt {
            Some(val) => {
                self.remaining = self.remaining - 1
                Some(val)
            }
            None => None
        }
    }

    fn collect(mut self: TakeIter<I>) -> Vec<I::Item> {
        let mut out: Vec<I::Item> = Vec::new<I::Item>()
        while true {
            match self.next() {
                Some(value) => push(out, value),
                None => { break },
            }
        }
        out
    }

    fn count(self: TakeIter<I>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// SkipIter — lazy skip adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that skips the first `n` elements of the source.
/// The adapter wraps the source iterator instead of copying its
/// state, so any `I: Iterator` source can be skipped (ADR-078).
pub struct SkipIter<I> {
    iter: I,
    to_skip: i32,
}

impl<I> SkipIter<I> {
    /// Lazily map the source values after consuming the skip prefix.
    fn map(self: SkipIter<I>, f: fn(I::Item) -> I::Item) -> SkipMapIter<I> {
        SkipMapIter {
            iter: self.iter,
            to_skip: self.to_skip,
            map_f: f,
        }
    }

    /// Lazily filter the source values after consuming the skip prefix.
    fn filter(self: SkipIter<I>, f: fn(I::Item) -> bool) -> SkipFilterIter<I> {
        SkipFilterIter {
            iter: self.iter,
            to_skip: self.to_skip,
            filter_f: f,
        }
    }

    /// Lazily skip source values, then yield at most `n` remaining values.
    fn take(self: SkipIter<I>, n: i32) -> TakeIter<SkipIter<I>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl<I> Iterator for SkipIter<I> {
    type Item = I::Item

    fn next(mut self: SkipIter<I>) -> Option<I::Item> {
        while self.to_skip > 0 {
            let nxt = self.iter.next()
            match nxt {
                Some(_) => self.to_skip = self.to_skip - 1
                None => return None
            }
        }
        self.iter.next()
    }

    fn collect(mut self: SkipIter<I>) -> Vec<I::Item> {
        let mut out: Vec<I::Item> = Vec::new<I::Item>()
        while true {
            match self.next() {
                Some(value) => push(out, value),
                None => { break },
            }
        }
        out
    }

    fn count(self: SkipIter<I>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// SkipMapIter / SkipFilterIter — composed lazy skip/map, skip/filter adapters
// ---------------------------------------------------------------------------

/// Lazy iterator that skips source values before mapping the remainder.
/// The callback is item-generic: it consumes and yields the source item,
/// so the same adapter serves the i32 and String lanes (#860/#691).
pub struct SkipMapIter<I> {
    iter: I,
    to_skip: i32,
    map_f: fn(I::Item) -> I::Item,
}

/// Lazy iterator that skips source values before filtering the remainder.
pub struct SkipFilterIter<I> {
    iter: I,
    to_skip: i32,
    filter_f: fn(I::Item) -> bool,
}

impl<I> Iterator for SkipMapIter<I> {
    type Item = I::Item

    fn next(mut self: SkipMapIter<I>) -> Option<I::Item> {
        while self.to_skip > 0 {
            let nxt = self.iter.next()
            match nxt {
                Some(_) => self.to_skip = self.to_skip - 1
                None => return None
            }
        }
        let nxt = self.iter.next()
        match nxt {
            Some(value) => Some((self.map_f)(value))
            None => None
        }
    }

    fn collect(mut self: SkipMapIter<I>) -> Vec<I::Item> {
        collect_iterator(self)
    }

    fn count(mut self: SkipMapIter<I>) -> i32 {
        count_iterator(self)
    }
}

impl<I> Iterator for SkipFilterIter<I> {
    type Item = I::Item

    fn next(mut self: SkipFilterIter<I>) -> Option<I::Item> {
        while self.to_skip > 0 {
            let nxt = self.iter.next()
            match nxt {
                Some(_) => self.to_skip = self.to_skip - 1
                None => return None
            }
        }
        let mut found = false
        let mut out: Option<I::Item> = None
        while !found {
            let nxt = self.iter.next()
            match nxt {
                Some(value) => {
                    // The predicate owns its argument; pass a clone so the
                    // accepted original can still be yielded.
                    let predicate_value = value.clone()
                    if (self.filter_f)(predicate_value) {
                        out = Some(value)
                        found = true
                    }
                }
                None => found = true
            }
        }
        out
    }

    fn collect(mut self: SkipFilterIter<I>) -> Vec<I::Item> {
        collect_iterator(self)
    }

    fn count(mut self: SkipFilterIter<I>) -> i32 {
        count_iterator(self)
    }
}

// ---------------------------------------------------------------------------
// Pair — item type for enumerate/zip adapters
// ---------------------------------------------------------------------------

/// A two-element item produced by enumerate and zip adapters.
/// Keeping the pair as a real generic struct replaces the packed-i32
/// encoding that silently truncated items (ADR-076).
pub struct Pair<A, B> {
    first: A,
    second: B,
}

// ---------------------------------------------------------------------------
// ChainIter — lazy chain of two I: Iterator sources
// ---------------------------------------------------------------------------

/// Lazy iterator that yields all elements of `first` then all of `second`.
/// The adapter wraps the two source iterators instead of indexing the
/// vectors, so any `I: Iterator` pair can be chained (ADR-078).
pub struct ChainIter<I> {
    first: I,
    second: I,
    on_first: bool,
}

impl<I> Iterator for ChainIter<I> {
    type Item = I::Item

    fn next(mut self: ChainIter<I>) -> Option<I::Item> {
        if !self.on_first {
            return self.second.next()
        }
        match self.first.next() {
            Some(v) => Some(v),
            None => {
                self.on_first = false
                self.second.next()
            }
        }
    }

    fn collect(self: ChainIter<I>) -> Vec<I::Item> {
        let mut out: Vec<I::Item> = Vec::new<I::Item>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: ChainIter<I>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// EnumerateIter — lazy enumerate adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields (index, value) items as `Pair<i32, I::Item>`.
/// The adapter wraps the source iterator, so any `I: Iterator` source can
/// be enumerated (ADR-078); items are real pairs rather than a packed
/// i32 encoding (ADR-076).
pub struct EnumerateIter<I> {
    iter: I,
    index: i32,
}

impl<I> Iterator for EnumerateIter<I> {
    type Item = Pair<i32, I::Item>

    fn next(mut self: EnumerateIter<I>) -> Option<Pair<i32, I::Item>> {
        let nxt = self.iter.next()
        match nxt {
            Some(v) => {
                let p: Pair<i32, I::Item> = Pair { first: self.index, second: v }
                self.index = self.index + 1
                Some(p)
            }
            None => None,
        }
    }

    fn collect(self: EnumerateIter<I>) -> Vec<Pair<i32, I::Item>> {
        let mut out: Vec<Pair<i32, I::Item>> = Vec::new<Pair<i32, I::Item>>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: EnumerateIter<I>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// ZipIter — lazy zip of two iterator sources
// ---------------------------------------------------------------------------

/// Lazy iterator that yields paired elements from two sources as
/// `Pair<A::Item, B::Item>` items. Iteration stops at the first
/// exhausted source.
pub struct ZipIter<A, B> {
    first: A,
    second: B,
}

impl<A, B> Iterator for ZipIter<A, B> {
    type Item = Pair<A::Item, B::Item>

    fn next(mut self: ZipIter<A, B>) -> Option<Pair<A::Item, B::Item>> {
        let av = self.first.next()
        match av {
            Some(a) => {
                let bv = self.second.next()
                match bv {
                    Some(b) => Some(Pair { first: a, second: b }),
                    None => None,
                }
            }
            None => None,
        }
    }

    fn collect(self: ZipIter<A, B>) -> Vec<Pair<A::Item, B::Item>> {
        let mut out: Vec<Pair<A::Item, B::Item>> = Vec::new<Pair<A::Item, B::Item>>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: ZipIter<A, B>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// FlatMapIter — lazy flat_map adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that expands each source element through `f` into a
/// `Vec<T>` and yields the produced items in order. The inner buffer is
/// appended to as each element expands and `inner_index` walks it, so the
/// stream stays lazy even though produced items accumulate behind the
/// cursor. Like `MapIter`/`FilterIter`, the upstream state is a concrete
/// Vec snapshot; generic-upstream composition goes through `TakeIter` and
/// the other `I`-parameterized adapters (#691).
pub struct FlatMapIter<T> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    inner: Vec<T>,
    inner_index: i32,
    f: fn(T) -> Vec<T>,
}

impl<T> FlatMapIter<T> {
    /// Lazily limit the flattened stream to `n` items.
    fn take(self: FlatMapIter<T>, n: i32) -> TakeIter<FlatMapIter<T>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl<T> Iterator for FlatMapIter<T> {
    type Item = T

    fn next(mut self: FlatMapIter<T>) -> Option<T> {
        let mut out: Option<T> = None
        let mut done: bool = false
        while !done {
            if self.inner_index < self.inner.len() {
                let v: T = self.inner.get_unchecked(self.inner_index)
                self.inner_index = self.inner_index + 1
                out = Some(v)
                done = true
            } else if self.index < self.length {
                let outer: T = self.vec.get_unchecked(self.index)
                self.index = self.index + 1
                let produced: Vec<T> = (self.f)(outer)
                for item in produced {
                    push(self.inner, item)
                }
            } else {
                done = true
            }
        }
        out
    }

    fn collect(self: FlatMapIter<T>) -> Vec<T> {
        let mut out: Vec<T> = Vec::new<T>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: FlatMapIter<T>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// PeekIter — lazy peekable adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that allows inspecting the next item without consuming it.
/// `peek` caches the upcoming element in a single-slot Vec; `next`
/// drains the cache first, so the upstream Vec snapshot advances at most
/// once per yielded item. The cache is a Vec rather than `Option<T>`
/// because an `Option<T>` record field materializes under a different
/// type index than the `None` literal at the init site on wasm32-gc,
/// which fails validation (#691).
pub struct PeekIter<T> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    peeked: Vec<T>,
}

impl<T> PeekIter<T> {
    /// Return the next item without consuming it, caching it for `next`.
    /// Repeated `peek` calls return the same cached item until `next`
    /// drains it.
    fn peek(mut self: PeekIter<T>) -> Option<T> {
        if self.peeked.len() == 0 && self.index < self.length {
            push(self.peeked, self.vec.get_unchecked(self.index))
            self.index = self.index + 1
        }
        if self.peeked.len() > 0 {
            Some(self.peeked.get_unchecked(0))
        } else {
            None
        }
    }

    /// Lazily limit the peekable stream to `n` items.
    fn take(self: PeekIter<T>, n: i32) -> TakeIter<PeekIter<T>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl<T> Iterator for PeekIter<T> {
    type Item = T

    fn next(mut self: PeekIter<T>) -> Option<T> {
        if self.peeked.len() > 0 {
            let v: T = self.peeked.get_unchecked(0)
            self.peeked = Vec::new<T>()
            Some(v)
        } else if self.index < self.length {
            let v: T = self.vec.get_unchecked(self.index)
            self.index = self.index + 1
            Some(v)
        } else {
            None
        }
    }

    fn collect(self: PeekIter<T>) -> Vec<T> {
        let mut out: Vec<T> = Vec::new<T>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: PeekIter<T>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// StepByIter — lazy step_by adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that yields every `step`-th element of the source. The
/// constructor clamps non-positive steps to 1, so the index always advances
/// and the adapter cannot loop forever.
pub struct StepByIter<T> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    step: i32,
}

impl<T> StepByIter<T> {
    /// Lazily limit the stepped stream to `n` items.
    fn take(self: StepByIter<T>, n: i32) -> TakeIter<StepByIter<T>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl<T> Iterator for StepByIter<T> {
    type Item = T

    fn next(mut self: StepByIter<T>) -> Option<T> {
        if self.index < self.length {
            let v: T = self.vec.get_unchecked(self.index)
            self.index = self.index + self.step
            Some(v)
        } else {
            None
        }
    }

    fn collect(self: StepByIter<T>) -> Vec<T> {
        let mut out: Vec<T> = Vec::new<T>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: StepByIter<T>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// ScanIter — lazy scan adapter
// ---------------------------------------------------------------------------

/// Lazy iterator that threads a state through `f` and yields each
/// intermediate result. Iteration ends when the source is exhausted or
/// `f` returns `None`; once ended the adapter stays at the end, matching
/// Rust's fused `scan` behavior.
pub struct ScanIter<T> {
    vec: Vec<T>,
    index: i32,
    length: i32,
    state: T,
    f: fn(T, T) -> Option<T>,
}

impl<T> ScanIter<T> {
    /// Lazily limit the scanned stream to `n` items.
    fn take(self: ScanIter<T>, n: i32) -> TakeIter<ScanIter<T>> {
        TakeIter { iter: self, remaining: n }
    }
}

impl<T> Iterator for ScanIter<T> {
    type Item = T

    fn next(mut self: ScanIter<T>) -> Option<T> {
        let mut out: Option<T> = None
        if self.index < self.length {
            let item: T = self.vec.get_unchecked(self.index)
            let stepped: Option<T> = (self.f)(self.state, item)
            match stepped {
                Some(v) => {
                    self.state = v
                    self.index = self.index + 1
                    out = Some(v)
                }
                None => {
                    self.index = self.length
                }
            }
        }
        out
    }

    fn collect(self: ScanIter<T>) -> Vec<T> {
        let mut out: Vec<T> = Vec::new<T>()
        for item in self {
            push(out, item)
        }
        out
    }

    fn count(self: ScanIter<T>) -> i32 {
        let mut n = 0
        for item in self {
            n = n + 1
        }
        n
    }

}

// ---------------------------------------------------------------------------
// UniqueIter — lazy first-occurrence adapter over Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator that yields each source element only the first time it
/// appears. The seen buffer holds already-yielded values, so memory use is
/// proportional to the number of distinct items rather than the source
/// length; no intermediate result vector is allocated.
pub struct UniqueIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
    seen: Vec<i32>,
}

fn unique_seen_contains(seen: Vec<i32>, value: i32) -> bool {
    let n: i32 = seen.len()
    let mut i: i32 = 0
    let mut found: bool = false
    while i < n {
        if seen.get_unchecked(i) == value {
            found = true
        }
        i = i + 1
    }
    found
}

impl Iterator for UniqueIter {
    type Item = i32

    fn next(mut self: UniqueIter) -> Option<i32> {
        while self.index < self.length {
            let val: i32 = self.vec.get_unchecked(self.index)
            self.index = self.index + 1
            if !unique_seen_contains(self.seen, val) {
                push(self.seen, val)
                return Some(val)
            }
        }
        None
    }

    fn collect(mut self: UniqueIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(mut self: UniqueIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// RevIter — lazy reverse adapter over Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator that yields the remaining source elements in reverse order.
/// The index field tracks the first unconsumed slot and length the last, so
/// next steps length down without copying the source.
pub struct RevIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
}

impl Iterator for RevIter {
    type Item = i32

    fn next(mut self: RevIter) -> Option<i32> {
        if self.length > self.index {
            self.length = self.length - 1
            Some(self.vec.get_unchecked(self.length))
        } else {
            None
        }
    }

    fn collect(mut self: RevIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(mut self: RevIter) -> i32 {
        count_iterator(self)
    }

}

// ---------------------------------------------------------------------------
// i32 producer capability for the numeric consumer lane
// ---------------------------------------------------------------------------

// Each implementation delegates to the adapter's Iterator::next, whose return
// type is concrete here, so `IteratorI32` is the only place the i32 item type
// is proven. The consumer helpers above stay generic without inspecting a
// symbolic `T::Item`.
impl IteratorI32 for VecIter<i32> {
    fn next_i32(mut self: VecIter<i32>) -> Option<i32> {
        self.next()
    }
}

