//! std::core::iter — `Iterator`, `IntoIterator`, `FromIterator` traits and
//! lazy adapter types.
//!
//! This module formalises the iteration protocol that the `for x in v` syntax
//! uses structurally (a `next() -> Option<T>` method). It defines the three
//! core traits from Rust's `std::iter` and provides lazy adapter structs that
//! hold an upstream source plus a closure, pulling elements on demand.
//!
//! Because Arukellt's monomorphisation model does not yet support trait-object
//! dynamic dispatch, the existing adapter structs are monomorphic over `i32`
//! (matching the existing `std::seq` helpers). Item-preserving iteration is
//! kept separate from numeric consumers so another item representation can
//! implement `Iterator` without inventing a numeric meaning. Generic trait
//! definitions are included to formalise the protocol and enable future
//! generalisation.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

// ---------------------------------------------------------------------------
// Trait definitions
// ---------------------------------------------------------------------------

/// Trait for lazy, pull-based iteration over a sequence of `T` values.
///
/// `next` returns `Option::Some(item)` for each successive element or
/// `Option::None` when the iterator is exhausted. `collect` drains and
/// `count` counts through the same item-preserving trait dispatch path.
/// This mirrors the structural protocol that `for x in v` already uses — any
/// type with a `next() -> Option<T>` method is iterable.
///
/// ## Protocol catalog: `Iterator`
///
/// | Type        | Status | Notes                                  |
/// |-------------|--------|----------------------------------------|
/// | VecIter     | impl   | Adapter over `Vec<i32>`                |
/// | RangeIter   | impl   | Adapter over `Range`                   |
/// | RangeInclusiveIter | impl | Adapter over `RangeInclusive`      |
/// | MapIter     | impl   | Lazy map adapter                       |
/// | FilterIter  | impl   | Lazy filter adapter                    |
/// | TakeIter<I> | impl   | Lazy take adapter over any source      |
/// | SkipIter<I> | impl   | Lazy skip adapter over any source      |
/// | ChainIter   | impl   | Lazy chain of two `Vec<i32>`           |
/// | EnumerateIter | impl | Lazy enumerate adapter                 |
/// | ZipIter     | impl   | Lazy zip of two `Vec<i32>`             |
/// | SkipMapIter | impl | Composed skip/map pipeline           |
/// | SkipFilterIter | impl | Composed skip/filter pipeline       |
pub trait Iterator {
    type Item
    fn next(self: Self) -> Option<Self::Item>
    fn collect(self: Self) -> Vec<Self::Item>
    fn count(self: Self) -> i32
}

/// Numeric sum capability for a concrete iterator item/output pair.
pub trait IteratorSum<Item, Output> {
    fn sum(self: Self) -> Output
}

/// Numeric fold capability for a concrete iterator item/accumulator pair.
pub trait IteratorFold<Item, Accumulator> {
    fn fold(self: Self, init: Accumulator, f: fn(Accumulator, Item) -> Accumulator) -> Accumulator
}

/// Membership-test capability for a concrete iterator item type.
pub trait IteratorContains<Item> {
    fn contains(self: Self, target: Item) -> bool
}

/// Equality-counting capability for a concrete iterator item type.
pub trait IteratorCountEq<Item> {
    fn count_eq(self: Self, target: Item) -> i32
}

/// Trait for types that can be converted into an iterator.
///
/// `into_iter` consumes `self` and returns an `Iterator<T>`.
pub trait IntoIterator {
    type Item
    type IntoIter
    fn into_iter(self: Self) -> Self::IntoIter
}

/// Trait for collections that can be built from an iterator.
///
/// `from_iter` drains an iterator and constructs the collection.
pub trait FromIterator<T> {
    fn from_iter(it: T) -> Self
}

// Keep collection traversal in one generic implementation so every adapter
// uses the same associated-item result type.
fn collect_iterator<T: Iterator>(it: T) -> Vec<T::Item> {
    let result: Vec<T::Item> = Vec::new<T::Item>()
    while true {
        match it.next() {
            Some(v) => push(result, v),
            None => { break },
        }
    }
    result
}

fn count_iterator<T: Iterator>(it: T) -> i32 {
    let mut count: i32 = 0
    while true {
        match it.next() {
            Some(_) => count = count + 1,
            None => { break },
        }
    }
    count
}

fn sum_iterator_i32<T: Iterator>(it: T) -> i32 {
    let mut total: i32 = 0
    while true {
        match it.next() {
            Some(v) => total = total + v,
            None => { break },
        }
    }
    total
}

fn fold_iterator_i32<T: Iterator>(it: T, init: i32, f: fn(i32, i32) -> i32) -> i32 {
    let mut total: i32 = init
    while true {
        match it.next() {
            Some(v) => total = f(total, v),
            None => { break },
        }
    }
    total
}

fn contains_iterator_i32<T: Iterator>(it: T, target: i32) -> bool {
    let mut found: bool = false
    while true {
        match it.next() {
            Some(v) => {
                if v == target {
                    found = true
                    break
                }
            },
            None => { break },
        }
    }
    found
}

fn count_eq_iterator_i32<T: Iterator>(it: T, target: i32) -> i32 {
    let mut hits: i32 = 0
    while true {
        match it.next() {
            Some(v) => {
                if v == target {
                    hits = hits + 1
                }
            },
            None => { break },
        }
    }
    hits
}
// ---------------------------------------------------------------------------
// VecIter — lazy adapter over Vec<i32>
// ---------------------------------------------------------------------------

/// Lazy iterator over the elements of a `Vec<i32>`.
///
/// Holds a reference to the source vector and a current index. Each `next`
/// call advances the index and returns the next element, or `None` when the
/// end is reached.
pub struct VecIter {
    vec: Vec<i32>,
    index: i32,
    length: i32,
}

/// Construct a `VecIter` over `v`. The iterator borrows `v` by handle.
pub fn vec_iter(v: Vec<i32>) -> VecIter {
    v.iter()
}

/// Return the canonical lazy iterator for a `Vec<i32>`.
impl Vec<i32> {
    fn iter(self: Vec<i32>) -> VecIter {
        VecIter { vec: self, index: 0, length: len(self) }
    }
}

impl VecIter {
    /// Returns true when no more elements remain.
    fn is_empty(self: VecIter) -> bool {
        self.index >= self.length
    }

    /// Lazily transform the remaining elements with `f`.
    fn map(self: VecIter, f: fn(i32) -> i32) -> MapIter {
        MapIter { vec: self.vec, index: self.index, length: self.length, f: f }
    }

    /// Lazily keep the remaining elements accepted by `f`.
    fn filter(self: VecIter, f: fn(i32) -> bool) -> FilterIter {
        FilterIter { vec: self.vec, index: self.index, length: self.length, f: f }
    }

    /// Lazily limit the remaining elements to `n` values.
    fn take(self: VecIter, n: i32) -> TakeIter<VecIter> {
        TakeIter { iter: self, remaining: n }
    }

    /// Lazily skip `n` values from the remaining elements.
    fn skip(self: VecIter, n: i32) -> SkipIter<VecIter> {
        SkipIter { iter: self, to_skip: n }
    }

    /// Lazily yield each remaining element the first time it appears.
    fn unique(self: VecIter) -> UniqueIter {
        UniqueIter { vec: self.vec, index: self.index, length: self.length, seen: Vec::new<i32>() }
    }

    /// Lazily yield the remaining elements in reverse order.
    fn rev(self: VecIter) -> RevIter {
        RevIter { vec: self.vec, index: self.index, length: self.length }
    }
}

impl Iterator for VecIter {
    type Item = i32

    fn next(self: VecIter) -> Option<i32> {
        if self.index < self.length {
            let val: i32 = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some(val)
        } else {
            None
        }
    }

    fn collect(self: VecIter) -> Vec<i32> {
        collect_iterator(self)
    }

    fn count(self: VecIter) -> i32 {
        count_iterator(self)
    }

}

impl IntoIterator for VecIter {
    type Item = i32
    type IntoIter = VecIter

    fn into_iter(self: VecIter) -> VecIter {
        self
    }
}

/// Convert a `Vec<i32>` into the canonical lazy iterator over its elements.
impl IntoIterator for Vec<i32> {
    type Item = i32
    type IntoIter = VecIter

    fn into_iter(self: Vec<i32>) -> VecIter {
        vec_iter(self)
    }
}

// ---------------------------------------------------------------------------
// StringIter — item-preserving iterator over Vec<String>
// ---------------------------------------------------------------------------

/// Lazy iterator over the elements of a `Vec<String>`.
pub struct StringIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
}

/// Construct a `StringIter` over `v` for the `Vec<String>` conversion impl.
fn string_iter(v: Vec<String>) -> StringIter {
    StringIter { vec: v, index: 0, length: len(v) }
}

impl Vec<String> {
    fn iter(self: Vec<String>) -> StringIter {
        string_iter(self)
    }
}

/// Lazy bounded adapter that preserves String items from `StringIter`.
pub struct StringTakeIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    remaining: i32,
}

/// Lazy adapter that skips String items before yielding the remainder.
pub struct StringSkipIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    to_skip: i32,
}

/// Lazy composition that skips String items and then applies a bound.
pub struct StringSkipTakeIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    to_skip: i32,
    remaining: i32,
}

/// Lazy composition that skips source Strings before mapping the remainder.
pub struct StringSkipMapIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    to_skip: i32,
    map_f: fn(String) -> String,
}

/// Lazy composition that skips source Strings before filtering the remainder.
pub struct StringSkipFilterIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    to_skip: i32,
    filter_f: fn(String) -> bool,
}

/// Lazy adapter that transforms each remaining String item with `f`.
pub struct StringMapIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    f: fn(String) -> String,
}

/// Lazy adapter that keeps String items accepted by `f`.
pub struct StringFilterIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    f: fn(String) -> bool,
}

/// Lazy composition that maps String items and keeps at most `n` results.
pub struct StringMapTakeIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    map_f: fn(String) -> String,
    remaining: i32,
}

/// Lazy composition that keeps at most `n` accepted String items.
pub struct StringFilterTakeIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    filter_f: fn(String) -> bool,
    remaining: i32,
}

/// Lazy composition that maps each String and filters the mapped result.
pub struct StringMapFilterIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    map_f: fn(String) -> String,
    filter_f: fn(String) -> bool,
}

/// Lazy composition that filters source Strings and maps accepted items.
pub struct StringFilterMapIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    filter_f: fn(String) -> bool,
    map_f: fn(String) -> String,
}

/// Lazy composition that maps, filters, and bounds String items.
pub struct StringMapFilterTakeIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    map_f: fn(String) -> String,
    filter_f: fn(String) -> bool,
    remaining: i32,
}

/// Lazy composition that filters, maps, and bounds String items.
pub struct StringFilterMapTakeIter {
    vec: Vec<String>,
    index: i32,
    length: i32,
    filter_f: fn(String) -> bool,
    map_f: fn(String) -> String,
    remaining: i32,
}

impl StringIter {
    fn map(self: StringIter, f: fn(String) -> String) -> StringMapIter {
        StringMapIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            f: f,
        }
    }

    fn filter(self: StringIter, f: fn(String) -> bool) -> StringFilterIter {
        StringFilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            f: f,
        }
    }

    fn take(self: StringIter, n: i32) -> StringTakeIter {
        StringTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            remaining: n,
        }
    }

    fn skip(self: StringIter, n: i32) -> StringSkipIter {
        StringSkipIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            to_skip: n,
        }
    }
}

impl StringMapIter {
    fn take(self: StringMapIter, n: i32) -> StringMapTakeIter {
        StringMapTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.f,
            remaining: n,
        }
    }

    fn filter(self: StringMapIter, f: fn(String) -> bool) -> StringMapFilterIter {
        StringMapFilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.f,
            filter_f: f,
        }
    }
}

impl StringFilterIter {
    fn take(self: StringFilterIter, n: i32) -> StringFilterTakeIter {
        StringFilterTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            filter_f: self.f,
            remaining: n,
        }
    }

    fn map(self: StringFilterIter, f: fn(String) -> String) -> StringFilterMapIter {
        StringFilterMapIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            filter_f: self.f,
            map_f: f,
        }
    }
}

impl StringMapFilterIter {
    fn take(self: StringMapFilterIter, n: i32) -> StringMapFilterTakeIter {
        StringMapFilterTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            map_f: self.map_f,
            filter_f: self.filter_f,
            remaining: n,
        }
    }
}

impl StringFilterMapIter {
    fn take(self: StringFilterMapIter, n: i32) -> StringFilterMapTakeIter {
        StringFilterMapTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            filter_f: self.filter_f,
            map_f: self.map_f,
            remaining: n,
        }
    }
}

impl StringSkipIter {
    fn map(self: StringSkipIter, f: fn(String) -> String) -> StringSkipMapIter {
        StringSkipMapIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            to_skip: self.to_skip,
            map_f: f,
        }
    }

    fn filter(self: StringSkipIter, f: fn(String) -> bool) -> StringSkipFilterIter {
        StringSkipFilterIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            to_skip: self.to_skip,
            filter_f: f,
        }
    }

    fn take(self: StringSkipIter, n: i32) -> StringSkipTakeIter {
        StringSkipTakeIter {
            vec: self.vec,
            index: self.index,
            length: self.length,
            to_skip: self.to_skip,
            remaining: n,
        }
    }
}

impl Iterator for StringIter {
    type Item = String

    fn next(self: StringIter) -> Option<String> {
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: StringIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringTakeIter {
    type Item = String

    fn next(self: StringTakeIter) -> Option<String> {
        if self.remaining <= 0 {
            return None
        }
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            self.remaining = self.remaining - 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: StringTakeIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringTakeIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringSkipIter {
    type Item = String

    fn next(self: StringSkipIter) -> Option<String> {
        while self.to_skip > 0 && self.index < self.length {
            self.index = self.index + 1
            self.to_skip = self.to_skip - 1
        }
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: StringSkipIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringSkipIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringSkipTakeIter {
    type Item = String

    fn next(self: StringSkipTakeIter) -> Option<String> {
        if self.remaining <= 0 {
            return None
        }
        while self.to_skip > 0 && self.index < self.length {
            self.index = self.index + 1
            self.to_skip = self.to_skip - 1
        }
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            self.remaining = self.remaining - 1
            Some(value)
        } else {
            None
        }
    }

    fn collect(self: StringSkipTakeIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringSkipTakeIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringSkipMapIter {
    type Item = String

    fn next(self: StringSkipMapIter) -> Option<String> {
        while self.to_skip > 0 && self.index < self.length {
            self.index = self.index + 1
            self.to_skip = self.to_skip - 1
        }
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some((self.map_f)(value))
        } else {
            None
        }
    }

    fn collect(self: StringSkipMapIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringSkipMapIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringSkipFilterIter {
    type Item = String

    fn next(self: StringSkipFilterIter) -> Option<String> {
        while self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            if self.to_skip > 0 {
                self.to_skip = self.to_skip - 1
                continue
            }
            let predicate_value = clone(value)
            if (self.filter_f)(predicate_value) {
                return Some(value)
            }
        }
        None
    }

    fn collect(self: StringSkipFilterIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringSkipFilterIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringMapIter {
    type Item = String

    fn next(self: StringMapIter) -> Option<String> {
        if self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            Some((self.f)(value))
        } else {
            None
        }
    }

    fn collect(self: StringMapIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringMapIter) -> i32 {
        count_iterator(self)
    }
}

impl Iterator for StringFilterIter {
    type Item = String

    fn next(self: StringFilterIter) -> Option<String> {
        while self.index < self.length {
            let value: String = get_unchecked(self.vec, self.index)
            self.index = self.index + 1
            // The predicate takes ownership of its callback argument. Keep the
            // source item for the yielded path by passing a cloned handle.
            let predicate_value = clone(value)
            if (self.f)(predicate_value) {
                return Some(value)
            }
        }
        None
    }

    fn collect(self: StringFilterIter) -> Vec<String> {
        collect_iterator(self)
    }

    fn count(self: StringFilterIter) -> i32 {
        count_iterator(self)
    }
}

