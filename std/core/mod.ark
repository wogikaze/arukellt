//! Fundamental types and helpers shared across the standard library.
//!
//! This module exposes foundational types (`Ordering`, `Range`) and helpers
//! that other stdlib modules build upon.
/// Ordering relationship between two values.
pub enum Ordering {
    Less,
    Equal,
    Greater,
}

/// Half-open integer range `[start, end)`.
pub struct Range {
    start: i32,
    end: i32,
}

/// Closed integer range `[start, end]`.
pub struct RangeInclusive {
    start: i32,
    end: i32,
}

/// Builds a half-open range `[start, end)`.
fn __core_range_new_impl(start: i32, end: i32) -> Range {
    Range { start: start, end: end }
}

/// Returns true when `value` lies inside the half-open range.
fn __core_range_contains_impl(r: Range, value: i32) -> bool {
    value >= r.start && value < r.end
}

/// Returns the non-negative length of the half-open range.
fn __core_range_len_impl(r: Range) -> i32 {
    if r.end > r.start {
        r.end - r.start
    } else {
        0
    }
}

fn __core_range_inclusive_new_impl(start: i32, end: i32) -> RangeInclusive {
    RangeInclusive { start: start, end: end }
}

fn __core_range_inclusive_contains_impl(r: RangeInclusive, value: i32) -> bool {
    value >= r.start && value <= r.end
}

impl Range {
    /// Builds a half-open range `[start, end)`.
    fn new(start: i32, end: i32) -> Range {
        __core_range_new_impl(start, end)
    }

    /// Returns true when `value` lies inside the half-open range.
    fn contains(self: Range, value: i32) -> bool {
        __core_range_contains_impl(self, value)
    }

    /// Returns the non-negative length of the half-open range.
    fn len(self: Range) -> i32 {
        __core_range_len_impl(self)
    }
}

impl RangeInclusive {
    /// Builds a closed range `[start, end]`.
    fn new(start: i32, end: i32) -> RangeInclusive {
        __core_range_inclusive_new_impl(start, end)
    }

    /// Returns true when `value` lies inside the closed range.
    fn contains(self: RangeInclusive, value: i32) -> bool {
        __core_range_inclusive_contains_impl(self, value)
    }
}

impl Ordering {
    fn is_less(self: Ordering) -> bool {
        match self {
            Ordering::Less => true,
            Ordering::Equal => false,
            Ordering::Greater => false,
        }
    }

    fn is_less_or_equal(self: Ordering) -> bool {
        match self {
            Ordering::Less => true,
            Ordering::Equal => true,
            Ordering::Greater => false,
        }
    }

    fn is_greater(self: Ordering) -> bool {
        match self {
            Ordering::Less => false,
            Ordering::Equal => false,
            Ordering::Greater => true,
        }
    }

    fn is_greater_or_equal(self: Ordering) -> bool {
        match self {
            Ordering::Less => false,
            Ordering::Equal => true,
            Ordering::Greater => true,
        }
    }
}
