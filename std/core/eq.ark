//! Equality protocol for core scalar values.
//!
//! Split out of `std::core::cmp` so importing `Eq` does not also register the
//! `Ord` impls: a globally visible `Ord` rewrites every relational operator
//! through `Ord::cmp`, which the current lowering is not stable under
//! (docs/research/prelude-final-residuals.md §1). `std::core::cmp` re-exports
//! this module so `use std::core::cmp` keeps providing `Eq`.

/// Trait for types that support equality comparison.
///
/// Implementors must provide `eq`, which returns `true` when two values are
/// equal. `String` compares UTF-8 contents, not references.
///
/// ## Protocol catalog: `Eq`
///
/// | Type    | Status | Notes                            |
/// |---------|--------|----------------------------------|
/// | i32     | impl   | Built-in `==` operator           |
/// | i64     | impl   | Built-in `==` operator           |
/// | bool    | impl   | Built-in `==` operator           |
/// | String  | impl   | `__intrinsic_string_eq` contents |
/// | f64     | impl   | Built-in `==` operator           |
/// | char    | impl   | Built-in `==` operator           |
/// | Vec<T>  | future | Requires generic Eq bound        |
/// | HashMap | future | Requires key Eq bound            |
trait Eq {
    fn eq(self: Eq, other: Eq) -> bool
}

/// Built-in `i32` equality via the `==` operator.
impl Eq for i32 {
    fn eq(self: i32, other: i32) -> bool {
        self == other
    }
}

/// Built-in `i64` equality via the `==` operator.
impl Eq for i64 {
    fn eq(self: i64, other: i64) -> bool {
        self == other
    }
}

/// Built-in `String` equality via the string eq intrinsic.
///
/// Must not call `String::eq` — the call rewrite maps it back here and
/// recurses (#807). Same pattern as `Clone for String` + `__intrinsic_clone`.
impl Eq for String {
    fn eq(self: String, other: String) -> bool {
        __intrinsic_string_eq(self, other)
    }
}

/// Built-in `bool` equality via the `==` operator.
impl Eq for bool {
    fn eq(self: bool, other: bool) -> bool {
        self == other
    }
}

/// Built-in `char` equality via the `==` operator.
impl Eq for char {
    fn eq(self: char, other: char) -> bool {
        self == other
    }
}

/// Built-in `f64` equality via the `==` operator.
impl Eq for f64 {
    fn eq(self: f64, other: f64) -> bool {
        self == other
    }
}
