//! std::core::clone — Clone trait and built-in impls.
//!
//! Provides the `Clone` trait for duplicating values. Scalar types (i32,
//! i64, f64, bool, char) are trivially clonable (copy semantics). `String`
//! delegates to the string copy intrinsic, and `Vec<T>` allocates independent
//! element storage and clones each element.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

use std::prelude::{eq}
/// Marker trait for values that may be copied implicitly at an ownership boundary.
///
/// Scalar types are Copy by language rule. User-defined structs and enums must
/// opt in explicitly with `impl Copy for T {}`.
trait Copy {}

/// Trait for types that can be duplicated.
///
/// ## Protocol catalog: `Clone`
///
/// | Type    | Status | Notes                              |
/// |---------|--------|------------------------------------|
/// | i32     | impl   | Copy semantics (returns self)      |
/// | i64     | impl   | Copy semantics (returns self)      |
/// | f64     | impl   | Copy semantics (returns self)      |
/// | bool    | impl   | Copy semantics (returns self)      |
/// | char    | impl   | Copy semantics (returns self)      |
/// | String  | impl   | Via the string copy intrinsic      |
/// | Vec<T>  | impl   | Deep copy when `T: Clone`          |
trait Clone {
    fn clone(self: Self) -> Self
}

/// `Clone` impl for `i32` — copy semantics.
impl Clone for i32 {
    fn clone(self: i32) -> i32 {
        self
    }
}

/// `Clone` impl for `i64` — copy semantics.
impl Clone for i64 {
    fn clone(self: i64) -> i64 {
        self
    }
}

/// `Clone` impl for `f64` — copy semantics.
impl Clone for f64 {
    fn clone(self: f64) -> f64 {
        self
    }
}

/// `Clone` impl for `bool` — copy semantics.
impl Clone for bool {
    fn clone(self: bool) -> bool {
        self
    }
}

/// `Clone` impl for `char` — copy semantics.
impl Clone for char {
    fn clone(self: char) -> char {
        self
    }
}

/// Internal helper to clone a String without triggering trait dispatch
/// recursion.  `__intrinsic_clone` is normalised to `clone` by the WASM
/// emitter's callee-name normaliser, so it is emitted as the string-clone
/// intrinsic rather than a self-dispatching trait method call.
fn __clone_string_helper(s: String) -> String {
    __intrinsic_clone(s)
}

/// `Clone` impl for `String` — delegates to the helper to avoid recursion.
impl Clone for String {
    fn clone(self: String) -> String {
        __clone_string_helper(self)
    }
}

/// `Clone` impl for `Vec<T>` — allocates a fresh element array and clones
/// each element, so the copy shares no storage with the source.
///
/// Import `std::core::clone` to select this impl. Without the import, MIR
/// lowers `.clone()` on a concrete Vec to an identity local copy, so the
/// header is copied without a deep element copy. The bootstrap overlay keeps a
/// shallow inherent method for the pinned compiler, whose cache mis-resolves
/// the bare callee (#928); that bridge is not part of user-facing semantics.
impl<T: Clone> Clone for Vec<T> {
    fn clone(self: Vec<T>) -> Vec<T> {
        let mut copy: Vec<T> = Vec::new<T>()
        let mut i: i32 = 0
        while i < len(self) {
            copy.push(get_unchecked(self, i).clone())
            i = i + 1
        }
        copy
    }
}
test mod "clone" {
    test "i32" { let x: i32 = 7; assert(x.clone() == 7) }
    test "bool" { assert(true.clone() == true) }
    test "str" { assert(eq("ok".clone(), "ok")) }
    test "vec" {
        let mut values: Vec<String> = Vec::new<String>()
        values.push(String_from("source"))
        let mut copy = values.clone()
        copy.set(0, String_from("copy"))
        assert(eq(get_unchecked(values, 0), "source"))
        assert(eq(get_unchecked(copy, 0), "copy"))
    }
}
