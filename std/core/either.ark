//! `Either<L, R>` — a sum type with two alternatives.
//!
//! `Either` is a general-purpose container that can hold a value of one of two
//! types. By convention, `Left` is used for the "error" or "first" case and
//! `Right` for the "success" or "second" case, but unlike `Result` there is no
//! built-in error semantics — both sides are plain values.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

/// A value of one of two types.
///
/// - `Left(L)` — holds a value of type `L`
/// - `Right(R)` — holds a value of type `R`
pub enum Either {
    Left(i32),
    Right(i32),
}

// Inherent methods for Either (ADR-044/ADR-046). The former free helpers
// (`left`, `is_left`, `from_left`, `map_left`, …, `either_fold`) were retired
// by the #917 core-helper wave; this block is the canonical surface.
impl Either {
    // ── queries ─────────────────────────────────────────────────────────────

    /// Returns true if the `Either` is a `Left` value.
    fn is_left(self: Either) -> bool {
        match self {
            Either::Left(_) => true,
            Either::Right(_) => false,
        }
    }

    /// Returns true if the `Either` is a `Right` value.
    fn is_right(self: Either) -> bool {
        match self {
            Either::Left(_) => false,
            Either::Right(_) => true,
        }
    }

    // ── extraction ──────────────────────────────────────────────────────────

    /// Extract the `Left` value, or return `fallback` if this is a `Right`.
    fn from_left(self: Either, fallback: i32) -> i32 {
        match self {
            Either::Left(v) => v,
            Either::Right(_) => fallback,
        }
    }

    /// Extract the `Right` value, or return `fallback` if this is a `Left`.
    fn from_right(self: Either, fallback: i32) -> i32 {
        match self {
            Either::Left(_) => fallback,
            Either::Right(v) => v,
        }
    }

    /// Convert `Either<i32, i32>` to `Option<i32>` — `Left` becomes `Some`, `Right` becomes `None`.
    fn left_to_option(self: Either) -> Option<i32> {
        match self {
            Either::Left(v) => Option::Some(v),
            Either::Right(_) => Option::None,
        }
    }

    /// Convert `Either<i32, i32>` to `Option<i32>` — `Right` becomes `Some`, `Left` becomes `None`.
    fn right_to_option(self: Either) -> Option<i32> {
        match self {
            Either::Left(_) => Option::None,
            Either::Right(v) => Option::Some(v),
        }
    }

    // ── transforms ──────────────────────────────────────────────────────────

    /// Swap `Left` and `Right`.
    fn swap(self: Either) -> Either {
        match self {
            Either::Left(v) => Either::Right(v),
            Either::Right(v) => Either::Left(v),
        }
    }

    /// Apply `f` to a `Left` value, pass `Right` through unchanged.
    fn map_left(self: Either, f: fn(i32) -> i32) -> Either {
        match self {
            Either::Left(v) => Either::Left(f(v)),
            Either::Right(_) => self,
        }
    }

    /// Apply `f` to a `Right` value, pass `Left` through unchanged.
    fn map_right(self: Either, f: fn(i32) -> i32) -> Either {
        match self {
            Either::Left(_) => self,
            Either::Right(v) => Either::Right(f(v)),
        }
    }

    /// Fold both branches into a single value.
    fn fold(self: Either, on_left: fn(i32) -> i32, on_right: fn(i32) -> i32) -> i32 {
        match self {
            Either::Left(v) => on_left(v),
            Either::Right(v) => on_right(v),
        }
    }
}

fn either_test_double(x: i32) -> i32 {
    x * 2
}

fn either_test_negate(x: i32) -> i32 {
    0 - x
}

test mod "either" {
    test "left_is_left" { assert(Either::Left(7).is_left()) }
    test "right_is_right" { assert(Either::Right(9).is_right()) }
    test "left_is_not_right" { assert(Either::Left(3).is_right() == false) }
    test "right_is_not_left" { assert(Either::Right(3).is_left() == false) }
    test "from_left_hit" { assert(Either::Left(7).from_left(0) == 7) }
    test "from_left_fallback" { assert(Either::Right(9).from_left(5) == 5) }
    test "from_right_hit" { assert(Either::Right(9).from_right(0) == 9) }
    test "from_right_fallback" { assert(Either::Left(9).from_right(5) == 5) }
    test "swap_left_to_right" { assert(Either::Left(4).swap().is_right()) }
    test "swap_right_to_left" { assert(Either::Right(4).swap().is_left()) }
    test "swap_preserves_value" { assert(Either::Left(4).swap().from_right(0) == 4) }
    test "map_left_applies" {
        assert(Either::Left(3).map_left(either_test_double).from_left(0) == 6)
    }
    test "map_left_passes_right" {
        assert(Either::Right(3).map_left(either_test_double).from_right(0) == 3)
    }
    test "map_right_applies" {
        assert(Either::Right(3).map_right(either_test_double).from_right(0) == 6)
    }
    test "map_right_passes_left" {
        assert(Either::Left(3).map_right(either_test_double).from_left(0) == 3)
    }
    test "fold_left" {
        assert(Either::Left(4).fold(either_test_double, either_test_negate) == 8)
    }
    test "fold_right" {
        assert(Either::Right(4).fold(either_test_double, either_test_negate) == 0 - 4)
    }
    test "left_to_option_some" {
        let r = match Either::Left(6).left_to_option() {
            Some(v) => v,
            None => 99,
        }
        assert(r == 6)
    }
    test "left_to_option_none" {
        let r = match Either::Right(6).left_to_option() {
            Some(v) => v,
            None => 99,
        }
        assert(r == 99)
    }
    test "right_to_option_some" {
        let r = match Either::Right(6).right_to_option() {
            Some(v) => v,
            None => 99,
        }
        assert(r == 6)
    }
}
