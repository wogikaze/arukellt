// std::core::convert — type conversion functions
//
// Unified namespace for type conversions (wraps existing intrinsics).

use std::text

/// Trait for types that can be converted to a human-readable string
/// representation.
///
/// ## Protocol catalog: `Display`
///
/// | Type    | Status | Notes                           |
/// |---------|--------|---------------------------------|
/// | i32     | impl   | Via `__intrinsic_i32_to_string` |
/// | i64     | impl   | Via `__intrinsic_i64_to_string` |
/// | f64     | impl   | Via `__intrinsic_f64_to_string` |
/// | bool    | impl   | Via `__intrinsic_bool_to_string`|
/// | String  | impl   | Identity passthrough            |
/// | char    | impl   | Via `__intrinsic_char_to_string`|
/// | structs | user   | Custom `impl Display for T`     |
///
/// ## Migration order
///
/// 1. Define `Display` trait and provide impls for all built-in types (this module).
/// 2. Replace ad-hoc `to_string(...)` calls with trait-based dispatch where possible.
/// 3. Add Display-bound generic formatting helpers in `std::text::fmt`.
trait Display {
    fn to_string(self: Display) -> String
}

/// Display impl for `i32`.
impl Display for i32 {
    fn to_string(self: i32) -> String {
        __intrinsic_i32_to_string(self)
    }
}

/// Display impl for `i64`.
impl Display for i64 {
    fn to_string(self: i64) -> String {
        __intrinsic_i64_to_string(self)
    }
}

/// Display impl for `f64`.
impl Display for f64 {
    fn to_string(self: f64) -> String {
        __intrinsic_f64_to_string(self)
    }
}

/// Display impl for `bool`.
impl Display for bool {
    fn to_string(self: bool) -> String {
        __intrinsic_bool_to_string(self)
    }
}

/// Display impl for `char`.
impl Display for char {
    fn to_string(self: char) -> String {
        __intrinsic_char_to_string(self)
    }
}

/// Display impl for `String` — identity passthrough.
impl Display for String {
    fn to_string(self: String) -> String {
        self
    }
}

// ---------------------------------------------------------------------------
// `Debug` trait (issue #696).
//
// `Debug` is the diagnostic formatting trait. Unlike `Display` (human-readable),
// `Debug` produces a developer-facing representation suitable for `assert_eq!`
// failure messages and structured inspection.
//
// For scalars the output mirrors `Display`, except for `String` which is
// wrapped in double quotes (Rust `{:?}` parity).
//
// Container types (`Vec<T>`, `Option<T>`, `Result<T, E>`) cannot yet receive
// generic trait impls (see `cmp.ark` — `Vec<T>` Eq is "future"), so
// `Debug` formatting for containers is provided as monomorphic helper
// functions in `std::text::fmt` (`debug_format_vec_i32`, etc.).
//
// ## Protocol catalog: `Debug`
//
// | Type    | Status | Notes                                    |
// |---------|--------|------------------------------------------|
// | i32     | impl   | Same as `Display`                        |
// | i64     | impl   | Same as `Display`                        |
// | f64     | impl   | Same as `Display`                        |
// | bool    | impl   | Same as `Display`                        |
// | char    | impl   | Same as `Display`                        |
// | String  | impl   | Quoted: `"hello"`                        |
// | structs | user   | Custom `impl Debug for T` (manual derive)|
// ---------------------------------------------------------------------------

/// Trait for types that can be formatted as a developer-facing diagnostic
/// string representation (Rust `Debug` / `{:?}` equivalent).
///
/// Implementations should produce output that can be re-parsed where practical.
/// For user-defined structs the conventional manual derive pattern is:
///
/// ```ignore
/// impl Debug for Point {
///     fn fmt_debug(self: Point) -> String {
///         concat(concat(concat(concat(
///             "Point { x: "), to_string(self.x)),
///             ", y: "), concat(to_string(self.y), " }"))
///     }
/// }
/// ```
trait Debug {
    fn fmt_debug(self: Debug) -> String
}

/// `Debug` impl for `i32` — mirrors `Display`.
impl Debug for i32 {
    fn fmt_debug(self: i32) -> String {
        __intrinsic_i32_to_string(self)
    }
}

/// `Debug` impl for `i64` — mirrors `Display`.
impl Debug for i64 {
    fn fmt_debug(self: i64) -> String {
        __intrinsic_i64_to_string(self)
    }
}

/// `Debug` impl for `f64` — mirrors `Display`.
impl Debug for f64 {
    fn fmt_debug(self: f64) -> String {
        __intrinsic_f64_to_string(self)
    }
}

/// `Debug` impl for `bool` — mirrors `Display`.
impl Debug for bool {
    fn fmt_debug(self: bool) -> String {
        __intrinsic_bool_to_string(self)
    }
}

/// `Debug` impl for `char` — mirrors `Display`.
impl Debug for char {
    fn fmt_debug(self: char) -> String {
        __intrinsic_char_to_string(self)
    }
}

/// `Debug` impl for `String` — quoted with double quotes (Rust `{:?}` parity).
///
/// NOTE: Inner quotes / control characters are not escaped; this is a
/// best-effort scalar impl (see #604 — issues/done/604-stdlib-baseline-contract-honesty.md).
impl Debug for String {
    fn fmt_debug(self: String) -> String {
        "\"".concat(self.concat("\""))
    }
}

// Deprecated free functions (i32_to_string, i64_to_string, f64_to_string,
// bool_to_string) have been removed per ADR-036. Use inherent method
// `x.to_string()` instead.
//
// The Option-returning `parse_i32` / `parse_i64` / `parse_f64` adapters were
// removed by the #917 core-helper wave. Use the `TryFrom<String>` associated
// functions (`i32::try_from(s)`), which return `Result<T, String>`.

// ---------------------------------------------------------------------------
// Integer trait — shared bit / power-of-two ops (ADR-046 trait-first / #718).
// Prefer `n.is_power_of_two()` over the removed free math helpers.
// ---------------------------------------------------------------------------

/// Trait for integer bit / power-of-two operations (ADR-046 trait-first).
///
/// Call sites: `n.is_power_of_two()`, `n.popcount()`, etc.
/// The former free `math::is_power_of_two(n)` wrapper was retired by #917.
trait Integer {
    fn is_power_of_two(self: Self) -> bool
    fn next_power_of_two(self: Self) -> Self
    fn leading_zeros(self: Self) -> i32
    fn trailing_zeros(self: Self) -> i32
    fn popcount(self: Self) -> i32
}

impl Integer for i32 {
    fn is_power_of_two(self: i32) -> bool {
        self > 0 && (self & (self - 1)) == 0
    }

    fn next_power_of_two(self: i32) -> i32 {
        if self <= 1 {
            return 1
        }
        let mut x = self - 1
        x = x | (x >> 1)
        x = x | (x >> 2)
        x = x | (x >> 4)
        x = x | (x >> 8)
        x = x | (x >> 16)
        let result = x + 1
        if result <= 0 {
            1073741824
        } else {
            result
        }
    }

    fn leading_zeros(self: i32) -> i32 {
        if self == 0 {
            return 32
        }
        if self < 0 {
            return 0
        }
        let mut count = 0
        let mut x = self
        if (x & 0xFFFF0000) == 0 {
            count = count + 16
            x = x << 16
        }
        if (x & 0xFF000000) == 0 {
            count = count + 8
            x = x << 8
        }
        if (x & 0xF0000000) == 0 {
            count = count + 4
            x = x << 4
        }
        if (x & 0xC0000000) == 0 {
            count = count + 2
            x = x << 2
        }
        if (x & 0x80000000) == 0 {
            count = count + 1
        }
        count
    }

    fn trailing_zeros(self: i32) -> i32 {
        if self == 0 {
            return 32
        }
        let mut count = 0
        let mut x = self
        while (x & 1) == 0 {
            count = count + 1
            x = x >> 1
        }
        count
    }

    fn popcount(self: i32) -> i32 {
        let mut count = 0
        let mut x = self
        while x != 0 {
            x = x & (x - 1)
            count = count + 1
        }
        count
    }
}

impl Integer for i64 {
    fn is_power_of_two(self: i64) -> bool {
        self > 0i64 && (self & (self - 1i64)) == 0i64
    }

    fn next_power_of_two(self: i64) -> i64 {
        if self <= 1i64 {
            return 1i64
        }
        let mut x = self - 1i64
        x = x | (x >> 1i64)
        x = x | (x >> 2i64)
        x = x | (x >> 4i64)
        x = x | (x >> 8i64)
        x = x | (x >> 16i64)
        x = x | (x >> 32i64)
        let result = x + 1i64
        if result <= 0i64 {
            4611686018427387904i64
        } else {
            result
        }
    }

    fn leading_zeros(self: i64) -> i32 {
        if self == 0i64 {
            return 64
        }
        if self < 0i64 {
            return 0
        }
        let mut count = 0
        let mut x = self
        if (x & 0xFFFFFFFF00000000i64) == 0i64 {
            count = count + 32
            x = x << 32i64
        }
        if (x & 0xFFFF000000000000i64) == 0i64 {
            count = count + 16
            x = x << 16i64
        }
        if (x & 0xFF00000000000000i64) == 0i64 {
            count = count + 8
            x = x << 8i64
        }
        if (x & 0xF000000000000000i64) == 0i64 {
            count = count + 4
            x = x << 4i64
        }
        if (x & 0xC000000000000000i64) == 0i64 {
            count = count + 2
            x = x << 2i64
        }
        if (x & 0x8000000000000000i64) == 0i64 {
            count = count + 1
        }
        count
    }

    fn trailing_zeros(self: i64) -> i32 {
        if self == 0i64 {
            return 64
        }
        let mut count = 0
        let mut x = self
        while (x & 1i64) == 0i64 {
            count = count + 1
            x = x >> 1i64
        }
        count
    }

    fn popcount(self: i64) -> i32 {
        let mut count = 0
        let mut x = self
        while x != 0i64 {
            x = x & (x - 1i64)
            count = count + 1
        }
        count
    }
}

// ---------------------------------------------------------------------------
// Inherent impl blocks for scalar types — method syntax (approach (a) #700).
//
// These provide method-syntax wrappers (`42.to_string()`, `(-5).abs()`, etc.)
// that delegate to the existing intrinsics / prelude free functions.
// ---------------------------------------------------------------------------

/// Inherent methods on `i32`.
impl i32 {
    /// Returns the string representation of this integer.
    fn to_string(self: i32) -> String {
        __intrinsic_i32_to_string(self)
    }

    /// Returns the absolute value.
    fn abs(self: i32) -> i32 {
        if self < 0 {
            0 - self
        } else {
            self
        }
    }

    /// Returns the smaller of `self` and `other`.
    fn min(self: i32, other: i32) -> i32 {
        __core_math_min_impl(self, other)
    }

    /// Returns the larger of `self` and `other`.
    fn max(self: i32, other: i32) -> i32 {
        __core_math_max_impl(self, other)
    }

    /// Clamps `self` to the range `[lo, hi]`.
    fn clamp(self: i32, lo: i32, hi: i32) -> i32 {
        __core_math_clamp_impl(self, lo, hi)
    }

    /// Returns `self` raised to the power `exp`.
    fn pow(self: i32, exp: i32) -> i32 {
        __core_math_pow_i32_impl(self, exp)
    }

    /// Returns the greatest common divisor of `self` and `other`.
    fn gcd(self: i32, other: i32) -> i32 {
        __core_math_gcd_impl(self, other)
    }

    /// Returns the least common multiple of `self` and `other`, or 0 when
    /// either operand is zero.
    fn lcm(self: i32, other: i32) -> i32 {
        if self == 0 || other == 0 {
            return 0
        }
        let divisor: i32 = __core_math_gcd_impl(self, other)
        let left: i32 = if self < 0 { 0 - self } else { self }
        let right: i32 = if other < 0 { 0 - other } else { other }
        left / divisor * right
    }

    /// Converts to `u8` by masking with `0xFF` (wrapping at the target width).
    fn to_u8_wrapping(self: i32) -> u8 {
        __intrinsic_i32_to_u8(self)
    }

    /// Converts to `u16` by masking with `0xFFFF` (wrapping at the target width).
    fn to_u16_wrapping(self: i32) -> u16 {
        __intrinsic_i32_to_u16(self)
    }

    /// Converts to `i8` by truncating to the low 8 bits.
    fn to_i8_wrapping(self: i32) -> i8 {
        __intrinsic_i32_to_i8(self)
    }

    /// Converts to `i16` by truncating to the low 16 bits.
    fn to_i16_wrapping(self: i32) -> i16 {
        __intrinsic_i32_to_i16(self)
    }

    /// Reinterprets the i32 bit pattern as `u32` (no numeric conversion).
    fn to_u32_bits(self: i32) -> u32 {
        __intrinsic_i32_to_u32(self)
    }
}

/// Inherent methods on `i64`.
impl i64 {
    /// Returns the string representation of this integer.
    fn to_string(self: i64) -> String {
        __intrinsic_i64_to_string(self)
    }

    /// Converts to i32, returning None when the value is outside i32's range.
    fn to_i32_checked(self: i64) -> Option<i32> {
        if self < -2147483648i64 || self > 2147483647i64 {
            None
        } else {
            Some(__intrinsic_i64_to_i32(self))
        }
    }

    /// Converts to i32 with two's-complement wrapping at the target width.
    fn to_i32_wrapping(self: i64) -> i32 {
        __intrinsic_i64_to_i32(self)
    }

    /// Converts to i32 by clamping values outside i32's range.
    fn to_i32_saturating(self: i64) -> i32 {
        if self < -2147483648i64 {
            -2147483648i32
        } else {
            if self > 2147483647i64 {
                2147483647i32
            } else {
                __intrinsic_i64_to_i32(self)
            }
        }
    }

    /// Returns the absolute value.
    fn abs(self: i64) -> i64 {
        if self < 0i64 {
            0i64 - self
        } else {
            self
        }
    }

    /// Returns the smaller of `self` and `other`.
    fn min(self: i64, other: i64) -> i64 {
        if self < other {
            self
        } else {
            other
        }
    }

    /// Returns the larger of `self` and `other`.
    fn max(self: i64, other: i64) -> i64 {
        if self > other {
            self
        } else {
            other
        }
    }

    /// Clamps `self` to the range `[lo, hi]`.
    fn clamp(self: i64, lo: i64, hi: i64) -> i64 {
        if self < lo {
            lo
        } else {
            if self > hi {
                hi
            } else {
                self
            }
        }
    }
}

/// Inherent methods on `f64`.
impl f64 {
    /// Returns the string representation of this float.
    fn to_string(self: f64) -> String {
        __intrinsic_f64_to_string(self)
    }

    /// Returns the square root of `self`.
    fn sqrt(self: f64) -> f64 {
        __intrinsic_sqrt(self)
    }

    /// Clamps `self` to the range `[lo, hi]`.
    fn clamp(self: f64, lo: f64, hi: f64) -> f64 {
        if self < lo {
            lo
        } else {
            if self > hi {
                hi
            } else {
                self
            }
        }
    }

    /// Returns the absolute value.
    fn abs(self: f64) -> f64 {
        if self < 0.0 {
            0.0 - self
        } else {
            self
        }
    }

    /// Rounds to `f32` with the WebAssembly / IEEE binary32 rounding mode.
    fn to_f32(self: f64) -> f32 {
        __intrinsic_f64_to_f32(self)
    }

    /// Returns the low 32 bits of the IEEE 754 binary64 bit pattern.
    fn to_bits_lo(self: f64) -> i32 {
        __intrinsic_scalar_f64_bits_lo(self)
    }

    /// Returns the high 32 bits of the IEEE 754 binary64 bit pattern.
    fn to_bits_hi(self: f64) -> i32 {
        __intrinsic_scalar_f64_bits_hi(self)
    }
}

/// Inherent methods on `bool`.
impl bool {
    /// Returns the string representation (`"true"` or `"false"`).
    fn to_string(self: bool) -> String {
        __intrinsic_bool_to_string(self)
    }
}

/// Inherent methods on `char`.
impl char {
    /// Returns the string representation of this character.
    fn to_string(self: char) -> String {
        __intrinsic_char_to_string(self)
    }
}

// ---------------------------------------------------------------------------
// From / Into conversion traits (issue #692).
//
// `From<T>` is implemented only for lossless conversions between types.
// `Into<T>` is the dual — in Rust it has a blanket impl, but Arukellt's
// static dispatch model requires explicit impls. Narrowing conversions use
// named checked, wrapping, or saturating methods instead.
// ---------------------------------------------------------------------------

/// Trait for lossless conversion from `T` to `Self`.
///
/// ## Protocol catalog: `From`
///
/// | From    | To      | Status | Notes                        |
/// |---------|---------|--------|------------------------------|
/// | i32     | i64     | impl   | Widening via intrinsic       |
/// | i64     | i32     | —      | Use an explicit conversion method |
trait From<T> {
    fn from(v: T) -> From
}

/// `From<i32>` impl for `i64` — widening conversion.
impl From<i32> for i64 {
    fn from(v: i32) -> i64 {
        __intrinsic_i32_to_i64(v)
    }
}

/// `From<String>` impl for `String` — identity passthrough.
///
/// This is the most common `?`-operator error conversion: when both the
/// fallible call and the enclosing function use `String` as the error type,
/// `From::from(e)` is a no-op. Required by the `?` operator desugaring
/// (issue #690): `expr?` becomes
/// `match expr { Ok(v) => v, Err(e) => return Err(From::from(e)) }`.
impl From<String> for String {
    fn from(v: String) -> String {
        v
    }
}

/// Trait for conversion into `T` (the dual of `From`).
trait Into<T> {
    fn into(self: Into) -> T
}

/// `Into<i64>` impl for `i32` — delegates to `From<i32> for i64`.
impl Into<i64> for i32 {
    fn into(self: i32) -> i64 {
        __intrinsic_i32_to_i64(self)
    }
}

/// Fallible conversion (experimental, ADR-084).
///
/// The canonical call surface is the associated function
/// (`i32::try_from("42")`). The error type is `String` until associated
/// error types are designed; `?` does not fall back to `TryFrom`.
trait TryFrom<T> {
    fn try_from(value: T) -> Result<TryFrom, String>
}

/// `TryFrom<String>` impl for `i32`.
impl TryFrom<String> for i32 {
    fn try_from(value: String) -> Result<i32, String> {
        __core_parse_i32_impl(value)
    }
}

/// `TryFrom<String>` impl for `i64`.
impl TryFrom<String> for i64 {
    fn try_from(value: String) -> Result<i64, String> {
        __core_parse_i64_impl(value)
    }
}

/// `TryFrom<String>` impl for `f64`.
impl TryFrom<String> for f64 {
    fn try_from(value: String) -> Result<f64, String> {
        __core_parse_f64_impl(value)
    }
}

/// `TryFrom<i64>` impl for `i32` — range-checked narrowing.
impl TryFrom<i64> for i32 {
    fn try_from(value: i64) -> Result<i32, String> {
        if value > 2147483647i64 || value < -2147483648i64 {
            Err(String_from("i64 value out of i32 range"))
        } else {
            Ok(__intrinsic_i64_to_i32(value))
        }
    }
}

// ---------------------------------------------------------------------------
// Narrow-integer alias widening (#917 / ADR-067 §5).
//
// `u8`, `i8`, `u16`, `i16`, `u32`, and `u64` share the i32/i64 runtime
// representation, but ADR-067 keeps them nominally distinct at the source
// level. These methods are the canonical explicit conversion surface for the
// deprecated `*_to_*` prelude wrappers.
// ---------------------------------------------------------------------------

/// Inherent methods on `u8`.
impl u8 {
    /// Zero-extends the low 8 bits to `i32`.
    fn to_i32(self: u8) -> i32 {
        __intrinsic_u8_to_i32(self)
    }
}

/// Inherent methods on `i8`.
impl i8 {
    /// Sign-extends the low 8 bits to `i32`.
    fn to_i32(self: i8) -> i32 {
        __intrinsic_i8_to_i32(self)
    }
}

/// Inherent methods on `u16`.
impl u16 {
    /// Zero-extends the low 16 bits to `i32`.
    fn to_i32(self: u16) -> i32 {
        __intrinsic_u16_to_i32(self)
    }
}

/// Inherent methods on `i16`.
impl i16 {
    /// Sign-extends the low 16 bits to `i32`.
    fn to_i32(self: i16) -> i32 {
        __intrinsic_i16_to_i32(self)
    }
}

/// Inherent methods on `u32`.
impl u32 {
    /// Zero-extends to `u64`.
    fn to_u64(self: u32) -> u64 {
        __intrinsic_u32_to_u64(self)
    }
}

/// Inherent methods on `u64`.
impl u64 {
    /// Truncates to the low 32 bits (wrapping at the target width).
    fn to_u32_wrapping(self: u64) -> u32 {
        __intrinsic_u64_to_u32(self)
    }
}

/// Inherent methods on `f32`.
impl f32 {
    /// Widens to `f64` exactly (all `f32` values are representable).
    fn to_f64(self: f32) -> f64 {
        __intrinsic_f32_to_f64(self)
    }
}
