// std::core::math — checked / saturating arithmetic traits
//
// ADR-046 / #917: the former numeric free helpers (gcd, lcm,
// is_power_of_two, next_power_of_two, leading_zeros, trailing_zeros,
// popcount) were retired by the core-helper wave. `gcd` / `lcm` are inherent
// i32 methods and the bit ops are `Integer` trait methods, both in
// std::core::convert. This module keeps the checked / saturating arithmetic
// trait impls that were outside that conversion.

// ── checked arithmetic traits ───────────────────────────────────────────────

/// Trait for types that support checked addition (detecting overflow).
trait CheckedAdd {
    fn checked_add(self: Self, rhs: Self) -> Option<Self>
}

/// Trait for types that support checked subtraction (detecting overflow).
trait CheckedSub {
    fn checked_sub(self: Self, rhs: Self) -> Option<Self>
}

/// Trait for types that support checked multiplication (detecting overflow).
trait CheckedMul {
    fn checked_mul(self: Self, rhs: Self) -> Option<Self>
}

impl CheckedAdd for i32 {
    fn checked_add(self: i32, rhs: i32) -> Option<i32> {
        let result = self + rhs
        if (self >= 0 && rhs >= 0 && result < 0) || (self < 0 && rhs < 0 && result >= 0) {
            Option::None
        } else {
            Option::Some(result)
        }
    }
}

impl CheckedSub for i32 {
    fn checked_sub(self: i32, rhs: i32) -> Option<i32> {
        let result = self - rhs
        if (self >= 0 && rhs < 0 && result < 0) || (self < 0 && rhs >= 0 && result >= 0) {
            Option::None
        } else {
            Option::Some(result)
        }
    }
}

impl CheckedMul for i32 {
    fn checked_mul(self: i32, rhs: i32) -> Option<i32> {
        let result = self * rhs
        if rhs != 0 && result / rhs != self {
            Option::None
        } else {
            Option::Some(result)
        }
    }
}

impl CheckedAdd for i64 {
    fn checked_add(self: i64, rhs: i64) -> Option<i64> {
        let result = self + rhs
        if (self >= 0 && rhs >= 0 && result < 0) || (self < 0 && rhs < 0 && result >= 0) {
            Option::None
        } else {
            Option::Some(result)
        }
    }
}

impl CheckedSub for i64 {
    fn checked_sub(self: i64, rhs: i64) -> Option<i64> {
        let result = self - rhs
        if (self >= 0 && rhs < 0 && result < 0) || (self < 0 && rhs >= 0 && result >= 0) {
            Option::None
        } else {
            Option::Some(result)
        }
    }
}

impl CheckedMul for i64 {
    fn checked_mul(self: i64, rhs: i64) -> Option<i64> {
        let result = self * rhs
        if rhs != 0 && result / rhs != self {
            Option::None
        } else {
            Option::Some(result)
        }
    }
}

// ── saturating arithmetic traits ────────────────────────────────────────────

/// Trait for types that support saturating addition (clamping on overflow).
trait SaturatingAdd {
    fn saturating_add(self: Self, rhs: Self) -> Self
}

/// Trait for types that support saturating subtraction (clamping on overflow).
trait SaturatingSub {
    fn saturating_sub(self: Self, rhs: Self) -> Self
}

/// Trait for types that support saturating multiplication (clamping on overflow).
trait SaturatingMul {
    fn saturating_mul(self: Self, rhs: Self) -> Self
}

impl SaturatingAdd for i32 {
    fn saturating_add(self: i32, rhs: i32) -> i32 {
        let result = self + rhs
        if self >= 0 && rhs >= 0 && result < 0 {
            0x7FFFFFFF
        } else {
            if self < 0 && rhs < 0 && result >= 0 {
                0 - 0x80000000
            } else {
                result
            }
        }
    }
}

impl SaturatingSub for i32 {
    fn saturating_sub(self: i32, rhs: i32) -> i32 {
        let result = self - rhs
        if self >= 0 && rhs < 0 && result < 0 {
            0x7FFFFFFF
        } else {
            if self < 0 && rhs >= 0 && result >= 0 {
                0 - 0x80000000
            } else {
                result
            }
        }
    }
}

impl SaturatingMul for i32 {
    fn saturating_mul(self: i32, rhs: i32) -> i32 {
        let result = self * rhs
        if rhs != 0 && result / rhs != self {
            if (self >= 0 && rhs >= 0) || (self < 0 && rhs < 0) {
                0x7FFFFFFF
            } else {
                0 - 0x80000000
            }
        } else {
            result
        }
    }
}

impl SaturatingAdd for i64 {
    fn saturating_add(self: i64, rhs: i64) -> i64 {
        let result = self + rhs
        if self >= 0 && rhs >= 0 && result < 0 {
            0x7FFFFFFFFFFFFFFFi64
        } else {
            if self < 0 && rhs < 0 && result >= 0 {
                0i64 - 0x8000000000000000i64
            } else {
                result
            }
        }
    }
}

impl SaturatingSub for i64 {
    fn saturating_sub(self: i64, rhs: i64) -> i64 {
        let result = self - rhs
        if self >= 0 && rhs < 0 && result < 0 {
            0x7FFFFFFFFFFFFFFFi64
        } else {
            if self < 0 && rhs >= 0 && result >= 0 {
                0i64 - 0x8000000000000000i64
            } else {
                result
            }
        }
    }
}

impl SaturatingMul for i64 {
    fn saturating_mul(self: i64, rhs: i64) -> i64 {
        let result = self * rhs
        if rhs != 0 && result / rhs != self {
            if (self >= 0 && rhs >= 0) || (self < 0 && rhs < 0) {
                0x7FFFFFFFFFFFFFFFi64
            } else {
                0i64 - 0x8000000000000000i64
            }
        } else {
            result
        }
    }
}

test mod "math" {
    test "gcd_positive" { assert(12.gcd(18) == 6) }
    test "gcd_zero_left" { assert(0.gcd(5) == 5) }
    test "gcd_zero_right" { assert(7.gcd(0) == 7) }
    test "gcd_negative_input" { assert((0 - 6).gcd(9) == 3) }
    test "gcd_coprime" { assert(7.gcd(13) == 1) }
    test "gcd_commutative" { assert(18.gcd(12) == 12.gcd(18)) }
    test "lcm_basic" { assert(4.lcm(6) == 12) }
    test "lcm_zero_left" { assert(0.lcm(5) == 0) }
    test "lcm_zero_right" { assert(5.lcm(0) == 0) }
    test "lcm_negative_input" { assert((0 - 3).lcm(4) == 12) }
    test "lcm_product_identity" { assert(6.gcd(10) * 6.lcm(10) == 60) }
    test "is_power_of_two_one" { assert(1.is_power_of_two()) }
    test "is_power_of_two_16" { assert(16.is_power_of_two()) }
    test "is_power_of_two_zero" { assert(0.is_power_of_two() == false) }
    test "is_power_of_two_six" { assert(6.is_power_of_two() == false) }
    test "is_power_of_two_negative" { assert((0 - 2).is_power_of_two() == false) }
    test "next_power_of_two_one" { assert(1.next_power_of_two() == 1) }
    test "next_power_of_two_five" { assert(5.next_power_of_two() == 8) }
    test "next_power_of_two_exact" { assert(16.next_power_of_two() == 16) }
    test "next_power_of_two_seventeen" { assert(17.next_power_of_two() == 32) }
    test "leading_zeros_zero" { assert(0.leading_zeros() == 32) }
    test "leading_zeros_one" { assert(1.leading_zeros() == 31) }
    test "leading_zeros_high_bit" { assert((0 - 2147483648).leading_zeros() == 0) }
    test "leading_zeros_byte_boundary" { assert(255.leading_zeros() == 24) }
    test "trailing_zeros_zero" { assert(0.trailing_zeros() == 32) }
    test "trailing_zeros_one" { assert(1.trailing_zeros() == 0) }
    test "trailing_zeros_eight" { assert(8.trailing_zeros() == 3) }
    test "trailing_zeros_min_i32" { assert((0 - 2147483648).trailing_zeros() == 31) }
    test "popcount_zero" { assert(0.popcount() == 0) }
    test "popcount_one" { assert(1.popcount() == 1) }
    test "popcount_255" { assert(255.popcount() == 8) }
    test "popcount_all_bits" { assert((0 - 1).popcount() == 32) }
}
