//! JSON parser/serializer for `std::json`.
//!
//! **Status: experimental — recursive `JsonValue` enum DOM (#045) plus
//! streaming scanner utilities (#704).**
//!
//! ## Honesty caveats (see #604 — issues/done/604-stdlib-baseline-contract-honesty.md)
//!
//! - The `JsonValue` DOM surface is the associated `JsonValue::parse(text)` /
//!   receiver `to_text()`, type predicates, and accessors. Constructors and
//!   primitive helpers are associated functions: `JsonValue::null/bool/int/
//!   string/raw/array/object`, `JsonValue::stringify_i32`,
//!   `JsonValue::parse_i32`, `JsonValue::encode_string`, and
//!   `JsonValue::pretty_text`. `JsonField::new` builds object fields
//!   (#917, ADR-046).
//! - Streaming scanner utilities live on the `JsonText` namespace in
//!   `std/json.ark`; they provide low-level field extraction without building
//!   a DOM.  `\uXXXX` surrogate pairs and invalid string escapes are checked.
//! - The primitive stringify/parse helpers are not a complete typed
//!   serializer; they are compatibility shims for the JSON text grammar.
//! - The DOM parser enforces the RFC 8259 string and number grammar used by
//!   the supported fixtures.  Full external JSONTestSuite coverage is tracked
//!   under #704.

use std::json
use std::core::convert
use std::text

// ─── Legacy primitive helpers ────────────────────────────────────────────────
/// Stringify an i32 as a JSON number.
fn json_value_stringify_i32(val: i32) -> String {
    val.to_string()
}

/// Stringify a bool as a JSON boolean literal.
fn json_value_stringify_bool(val: bool) -> String {
    if val {
        "true"
    } else {
        "false"
    }
}

/// Stringify a string by wrapping it in double quotes.
/// NOTE: does not escape special characters — use `JsonValue::encode_string` instead.
fn json_value_stringify_string(val: String) -> String {
    "\"".concat(val.concat("\""))
}

/// Return the JSON null literal.
fn json_value_null_text() -> String {
    "null"
}

/// Parse a decimal integer from a JSON number string.
fn json_value_parse_i32(s: String) -> i32 {
    let n: i32 = s.len()
    let mut result: i32 = 0
    let mut i: i32 = 0
    let mut neg: bool = false
    if n > 0 {
        let first: String = s.slice(0, 1)
        if first.eq("-") {
            neg = true
            i = 1
        }
    }
    while i < n {
        let ch: String = s.slice(i, i + 1)
        let d: i32 = if ch.eq("0") {
            0
        } else {
            if ch.eq("1") {
                1
            } else {
                if ch.eq("2") {
                    2
                } else {
                    if ch.eq("3") {
                        3
                    } else {
                        if ch.eq("4") {
                            4
                        } else {
                            if ch.eq("5") {
                                5
                            } else {
                                if ch.eq("6") {
                                    6
                                } else {
                                    if ch.eq("7") {
                                        7
                                    } else {
                                        if ch.eq("8") {
                                            8
                                        } else {
                                            9
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        result = result * 10 + d
        i = i + 1
    }
    if neg {
        0 - result
    } else {
        result
    }
}

/// Parse "true"/"false" into a bool.
fn json_value_parse_bool(s: String) -> bool {
    s.eq("true")
}

// ─── JsonValue type ──────────────────────────────────────────────────────────
pub enum JsonValue {
    Null,
    Bool(bool),
    Number(String),
    Str(String),
    Raw(String),
    Array(Vec<JsonValue>),
    Object(Vec<JsonField>),
}

impl JsonValue {
    fn is_null(self: JsonValue) -> bool {
        match self {
            JsonValue::Null => true,
            JsonValue::Bool(_) => false,
            JsonValue::Number(_) => false,
            JsonValue::Str(_) => false,
            JsonValue::Raw(_) => false,
            JsonValue::Array(_) => false,
            JsonValue::Object(_) => false,
        }
    }

    fn is_bool(self: JsonValue) -> bool {
        match self {
            JsonValue::Null => false,
            JsonValue::Bool(_) => true,
            JsonValue::Number(_) => false,
            JsonValue::Str(_) => false,
            JsonValue::Raw(_) => false,
            JsonValue::Array(_) => false,
            JsonValue::Object(_) => false,
        }
    }

    fn is_number(self: JsonValue) -> bool {
        match self {
            JsonValue::Null => false,
            JsonValue::Bool(_) => false,
            JsonValue::Number(_) => true,
            JsonValue::Str(_) => false,
            JsonValue::Raw(_) => false,
            JsonValue::Array(_) => false,
            JsonValue::Object(_) => false,
        }
    }

    fn is_string(self: JsonValue) -> bool {
        match self {
            JsonValue::Null => false,
            JsonValue::Bool(_) => false,
            JsonValue::Number(_) => false,
            JsonValue::Str(_) => true,
            JsonValue::Raw(_) => false,
            JsonValue::Array(_) => false,
            JsonValue::Object(_) => false,
        }
    }

    fn is_array(self: JsonValue) -> bool {
        match self {
            JsonValue::Null => false,
            JsonValue::Bool(_) => false,
            JsonValue::Number(_) => false,
            JsonValue::Str(_) => false,
            JsonValue::Raw(_) => false,
            JsonValue::Array(_) => true,
            JsonValue::Object(_) => false,
        }
    }

    fn is_object(self: JsonValue) -> bool {
        match self {
            JsonValue::Null => false,
            JsonValue::Bool(_) => false,
            JsonValue::Number(_) => false,
            JsonValue::Str(_) => false,
            JsonValue::Raw(_) => false,
            JsonValue::Array(_) => false,
            JsonValue::Object(_) => true,
        }
    }

    fn as_bool(self: JsonValue) -> Option<bool> {
        match self {
            JsonValue::Bool(b) => Some(b),
            JsonValue::Null => None,
            JsonValue::Number(_) => None,
            JsonValue::Str(_) => None,
            JsonValue::Raw(_) => None,
            JsonValue::Array(_) => None,
            JsonValue::Object(_) => None,
        }
    }

    fn as_string(self: JsonValue) -> Option<String> {
        match self {
            JsonValue::Str(s) => Some(s),
            JsonValue::Null => None,
            JsonValue::Bool(_) => None,
            JsonValue::Number(_) => None,
            JsonValue::Raw(_) => None,
            JsonValue::Array(_) => None,
            JsonValue::Object(_) => None,
        }
    }

    fn as_i32(self: JsonValue) -> Option<i32> {
        match self {
            JsonValue::Number(n) => {
                match i32::try_from(n) {
                    Result::Ok(i) => Some(i),
                    Result::Err(_) => None,
                }
            },
            JsonValue::Null => None,
            JsonValue::Bool(_) => None,
            JsonValue::Str(_) => None,
            JsonValue::Raw(_) => None,
            JsonValue::Array(_) => None,
            JsonValue::Object(_) => None,
        }
    }

    fn as_f64(self: JsonValue) -> Option<f64> {
        match self {
            JsonValue::Number(n) => {
                match f64::try_from(n) {
                    Result::Ok(f) => Some(f),
                    Result::Err(_) => None,
                }
            },
            JsonValue::Null => None,
            JsonValue::Bool(_) => None,
            JsonValue::Str(_) => None,
            JsonValue::Raw(_) => None,
            JsonValue::Array(_) => None,
            JsonValue::Object(_) => None,
        }
    }

    /// Rebuild the array element by element; returning the payload Vec
    /// directly traps on wasm32-gc (#807), so the loop copies via get_index.
    fn as_array(self: JsonValue) -> Option<Vec<JsonValue>> {
        if !self.is_array() {
            return None
        }
        let mut array_items = Vec::new<JsonValue>()
        let mut index = 0
        let mut finished = false
        while !finished {
            match self.get_index(index) {
                Option::Some(elem) => {
                    push(array_items, elem)
                    index = index + 1
                },
                None => {
                    finished = true
                },
            }
        }
        Some(array_items)
    }

    fn get_field(self: JsonValue, key: String) -> Option<JsonValue> {
        match self {
            JsonValue::Object(fields) => {
                let n = fields.len()
                let mut i = 0
                while i < n {
                    let f = get_unchecked(fields, i)
                    if f.key.eq(key) {
                        return Some(f.value)
                    }
                    i = i + 1
                }
                None
            },
            JsonValue::Null => None,
            JsonValue::Bool(_) => None,
            JsonValue::Number(_) => None,
            JsonValue::Str(_) => None,
            JsonValue::Raw(_) => None,
            JsonValue::Array(_) => None,
        }
    }

    fn get_index(self: JsonValue, index: i32) -> Option<JsonValue> {
        match self {
            JsonValue::Array(items) => {
                if index < 0 || index >= items.len() {
                    return None
                }
                Some(get_unchecked(items, index))
            },
            JsonValue::Null => None,
            JsonValue::Bool(_) => None,
            JsonValue::Number(_) => None,
            JsonValue::Str(_) => None,
            JsonValue::Raw(_) => None,
            JsonValue::Object(_) => None,
        }
    }

    /// Serialize this value back to its JSON text.
    fn to_text(self: JsonValue) -> String {
        json_stringify_value(self)
    }

    /// Parse a full JSON document into a `JsonValue`.
    fn parse(s: String) -> Result<JsonValue, JsonParseError> {
        json_parse_document(s)
    }

    /// Construct the JSON `null` value.
    fn null() -> JsonValue {
        json_value_null()
    }

    /// Construct a JSON boolean value.
    fn bool(value: bool) -> JsonValue {
        json_value_bool(value)
    }

    /// Construct a JSON number from an integer.
    fn int(value: i32) -> JsonValue {
        json_value_int(value)
    }

    /// Construct a JSON string value.
    fn string(value: String) -> JsonValue {
        json_value_string(value)
    }

    /// Construct a raw JSON value from already-serialized text.
    fn raw(value: String) -> JsonValue {
        json_value_raw(value)
    }

    /// Construct a JSON array from its elements.
    fn array(items: Vec<JsonValue>) -> JsonValue {
        JsonValue::Array(items)
    }

    /// Construct a JSON object from its fields.
    fn object(fields: Vec<JsonField>) -> JsonValue {
        JsonValue::Object(fields)
    }

    /// Serialize an integer as JSON number text.
    fn stringify_i32(value: i32) -> String {
        json_value_stringify_i32(value)
    }

    /// Serialize a boolean as JSON literal text.
    fn stringify_bool(value: bool) -> String {
        json_value_stringify_bool(value)
    }

    /// Serialize a string as a quoted JSON string literal.
    fn stringify_string(value: String) -> String {
        json_value_stringify_string(value)
    }

    /// Text of the JSON `null` literal.
    fn null_text() -> String {
        json_value_null_text()
    }

    /// Parse an integer from JSON text.
    fn parse_i32(s: String) -> i32 {
        json_value_parse_i32(s)
    }

    /// Parse a JSON boolean literal.
    fn parse_bool(s: String) -> bool {
        json_value_parse_bool(s)
    }

    /// Encode a plain string as a quoted JSON string literal.
    fn encode_string(s: String) -> String {
        json_value_encode_string(s)
    }

    /// Serialize with newlines and per-level indentation.
    fn pretty_text(v: JsonValue, indent: i32) -> String {
        json_value_pretty_text(v, indent)
    }
}

impl JsonParseError {
    fn message(self: JsonParseError) -> String {
        match self {
            JsonParseError::EmptyInput => "empty input",
            JsonParseError::InvalidLiteral(kind) => "invalid ".concat(kind),
            JsonParseError::TrailingCharacters => "trailing characters",
            JsonParseError::UnexpectedCharacter(_) => "unexpected character",
        }
    }
}

pub struct JsonField {
    key: String,
    value: JsonValue,
}

impl JsonField {
    fn new(key: String, value: JsonValue) -> JsonField {
        json_value_field(key, value)
    }
}

fn find_closing(s: String, pos: i32, open_ch: i32, close_ch: i32) -> i32 {
    let n = s.len()
    let mut i = pos
    let mut depth = 1
    let mut in_str = false
    let mut esc = false
    while i < n {
        let c = s.byte_at(i)
        if esc {
            esc = false
        } else {
            if in_str {
                if c == 92 {
                    esc = true
                } else {
                    if c == 34 {
                        in_str = false
                    }
                }
            } else {
                if c == 34 {
                    in_str = true
                } else {
                    if c == open_ch {
                        depth = depth + 1
                    } else {
                        if c == close_ch {
                            depth = depth - 1
                            if depth == 0 {
                                return i + 1
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    n
}

/// Returns the index after the closing quote, or `-1` when the string is
/// unterminated (no unescaped `"` before EOF).
fn find_string_end(s: String, pos: i32) -> i32 {
    let n = s.len()
    let mut i = pos
    let mut esc = false
    while i < n {
        let c = s.byte_at(i)
        if esc {
            esc = false
        } else {
            if c == 92 {
                esc = true
            } else {
                if c == 34 {
                    return i + 1
                }
            }
        }
        i = i + 1
    }
    0 - 1
}

fn find_number_end(s: String, pos: i32) -> i32 {
    let n = s.len()
    let mut i = pos
    while i < n {
        let c = s.byte_at(i)
        if c >= 48 && c <= 57 || c == 46 || c == 43 || c == 45 || c == 101 || c == 69 {
            i = i + 1
        } else {
            return i
        }
    }
    i
}

fn is_json_digit(c: i32) -> bool {
    c >= 48 && c <= 57
}

/// Validate the JSON number grammar without converting the value.
///
/// `JsonValue::Number` keeps the original spelling, so using `parse_f64`
/// here would both lose that spelling and reject valid exponent forms on
/// runtimes whose float parser has a narrower input grammar.
fn json_number_is_valid(s: String, start: i32, end: i32) -> bool {
    let mut i = start
    if i < end && s.byte_at(i) == 45 {
        i = i + 1
    }
    if i >= end {
        return false
    }
    if s.byte_at(i) == 48 {
        i = i + 1
        if i < end && is_json_digit(s.byte_at(i)) {
            return false
        }
    } else {
        if s.byte_at(i) < 49 || s.byte_at(i) > 57 {
            return false
        }
        while i < end && is_json_digit(s.byte_at(i)) {
            i = i + 1
        }
    }
    if i < end && s.byte_at(i) == 46 {
        i = i + 1
        let fraction_start = i
        while i < end && is_json_digit(s.byte_at(i)) {
            i = i + 1
        }
        if i == fraction_start {
            return false
        }
    }
    if i < end && (s.byte_at(i) == 101 || s.byte_at(i) == 69) {
        i = i + 1
        if i < end && (s.byte_at(i) == 43 || s.byte_at(i) == 45) {
            i = i + 1
        }
        let exponent_start = i
        while i < end && is_json_digit(s.byte_at(i)) {
            i = i + 1
        }
        if i == exponent_start {
            return false
        }
    }
    i == end
}

fn find_value_end(s: String, pos: i32) -> i32 {
    let n = s.len()
    if pos >= n {
        return n
    }
    let c = s.byte_at(pos)
    if c == 34 {
        let end = find_string_end(s, pos + 1)
        if end < 0 {
            n
        } else {
            end
        }
    } else {
        if c == 91 {
            find_closing(s, pos + 1, 91, 93)
        } else {
            if c == 123 {
                find_closing(s, pos + 1, 123, 125)
            } else {
                let mut i = pos
                while i < n {
                    let ch = s.byte_at(i)
                    if ch == 32 || ch == 9 || ch == 10 || ch == 13 || ch == 44 || ch == 93 || ch == 125 {
                        return i
                    }
                    i = i + 1
                }
                i
            }
        }
    }
}

pub enum JsonParseError {
    EmptyInput,
    InvalidLiteral(String),
    TrailingCharacters,
    UnexpectedCharacter(i32),
}

/// Result of parsing a single JSON value at a position: the parsed value
/// (or error) and the position after the value.  Used as a struct return
/// type because the s2 bootstrap compiler does not support tuple
/// destructuring (`let (a, b) = ...`).
pub struct JsonParseStep {
    value: Result<JsonValue, JsonParseError>,
    next: i32,
}

impl JsonParseStep {
    fn ok(v: JsonValue, next: i32) -> JsonParseStep {
        JsonParseStep { value: Ok(v), next: next }
    }

    fn err(e: JsonParseError, next: i32) -> JsonParseStep {
        JsonParseStep { value: Err(e), next: next }
    }

    fn value(self: JsonParseStep) -> Result<JsonValue, JsonParseError> {
        self.value
    }

    fn next(self: JsonParseStep) -> i32 {
        self.next
    }
}

// ─── Document parse / stringify ──────────────────────────────────────────────
/// Parse a full JSON document from `s` and reject trailing non-whitespace after
/// the first top-level value.
///
/// Leading and trailing whitespace is ignored, but any non-whitespace
/// characters after the first top-level value cause an error.
fn parse_value_at(s: String, pos: i32) -> JsonParseStep {
    let pos = json::JsonText::skip_ws(s, pos)
    let n = s.len()
    if pos >= n {
        return JsonParseStep::err(JsonParseError::EmptyInput, pos)
    }
    let c = s.byte_at(pos)
    if c == 110 {
        if n >= pos + 4 && (s.slice(pos, pos + 4)).eq("null") {
            return JsonParseStep::ok(JsonValue::Null, pos + 4)
        }
        return JsonParseStep::err(JsonParseError::InvalidLiteral(String_from("null")), pos)
    }
    if c == 116 {
        if n >= pos + 4 && (s.slice(pos, pos + 4)).eq("true") {
            return JsonParseStep::ok(JsonValue::Bool(true), pos + 4)
        }
        return JsonParseStep::err(JsonParseError::InvalidLiteral(String_from("true")), pos)
    }
    if c == 102 {
        if n >= pos + 5 && (s.slice(pos, pos + 5)).eq("false") {
            return JsonParseStep::ok(JsonValue::Bool(false), pos + 5)
        }
        return JsonParseStep::err(JsonParseError::InvalidLiteral(String_from("false")), pos)
    }
    if c == 34 {
        let mut parsed = json::JsonText::parse_string_at(s, pos)
        if !parsed.is_ok() {
            return JsonParseStep::err(JsonParseError::InvalidLiteral(String_from("string")), pos)
        }
        return JsonParseStep::ok(
            JsonValue::Str(parsed.value()),
            parsed.next()
        )
    }
    if c == 91 {
        let mut arr = Vec::new<JsonValue>()
        let mut i = json::JsonText::skip_ws(s, pos + 1)
        let mut has_value = false
        let mut expect_value = true
        while i < n {
            i = json::JsonText::skip_ws(s, i)
            if i < n && s.byte_at(i) == 93 {
                if !has_value || !expect_value {
                    return JsonParseStep::ok(JsonValue::Array(arr), i + 1)
                }
                return JsonParseStep::err(JsonParseError::UnexpectedCharacter(93), i)
            }
            if !expect_value {
                if i >= n || s.byte_at(i) != 44 {
                    return JsonParseStep::err(JsonParseError::UnexpectedCharacter(s.byte_at(i)), i)
                }
                i = json::JsonText::skip_ws(s, i + 1)
                if i >= n || s.byte_at(i) == 93 {
                    return JsonParseStep::err(JsonParseError::UnexpectedCharacter(93), i)
                }
                expect_value = true
            }
            let step = parse_value_at(s, i)
            match step.value {
                Result::Ok(v) => push(arr, v),
                Result::Err(e) => return JsonParseStep::err(e, i),
            }
            i = json::JsonText::skip_ws(s, step.next)
            has_value = true
            expect_value = false
        }
        return JsonParseStep::err(JsonParseError::UnexpectedCharacter(c), pos)
    }
    if c == 123 {
        let mut fields = Vec::new<JsonField>()
        let mut i = json::JsonText::skip_ws(s, pos + 1)
        let mut has_field = false
        let mut expect_field = true
        while i < n {
            i = json::JsonText::skip_ws(s, i)
            if i < n && s.byte_at(i) == 125 {
                if !has_field || !expect_field {
                    return JsonParseStep::ok(JsonValue::Object(fields), i + 1)
                }
                return JsonParseStep::err(JsonParseError::UnexpectedCharacter(125), i)
            }
            if !expect_field {
                if i >= n || s.byte_at(i) != 44 {
                    return JsonParseStep::err(JsonParseError::UnexpectedCharacter(s.byte_at(i)), i)
                }
                i = json::JsonText::skip_ws(s, i + 1)
                if i >= n || s.byte_at(i) == 125 {
                    return JsonParseStep::err(JsonParseError::UnexpectedCharacter(125), i)
                }
                expect_field = true
            }
            if s.byte_at(i) != 34 {
                return JsonParseStep::err(JsonParseError::UnexpectedCharacter(s.byte_at(i)), i)
            }
            let mut parsed_key = json::JsonText::parse_string_at(s, i)
            if !parsed_key.is_ok() {
                return JsonParseStep::err(JsonParseError::InvalidLiteral(String_from("string")), i)
            }
            let key = parsed_key.value()
            i = json::JsonText::skip_ws(s, parsed_key.next())
            if i >= n || s.byte_at(i) != 58 {
                return JsonParseStep::err(JsonParseError::UnexpectedCharacter(58), i)
            }
            let step = parse_value_at(s, json::JsonText::skip_ws(s, i + 1))
            match step.value {
                Result::Ok(v) => push(fields, JsonField { key: key, value: v }),
                Result::Err(e) => return JsonParseStep::err(e, i),
            }
            i = json::JsonText::skip_ws(s, step.next)
            has_field = true
            expect_field = false
        }
        return JsonParseStep::err(JsonParseError::UnexpectedCharacter(c), pos)
    }
    if c >= 48 && c <= 57 || c == 45 {
        let end = find_number_end(s, pos)
        let raw = s.slice(pos, end)
        if json_number_is_valid(s, pos, end) {
            return JsonParseStep::ok(JsonValue::Number(raw), end)
        }
        return JsonParseStep::err(JsonParseError::InvalidLiteral(String_from("number")), pos)
    }
    JsonParseStep::err(JsonParseError::UnexpectedCharacter(c), pos)
}

fn json_parse_document(s: String) -> Result<JsonValue, JsonParseError> {
    let pos = json::JsonText::skip_ws(s, 0)
    let n = s.len()
    if pos >= n {
        return Err(JsonParseError::EmptyInput)
    }
    let step = parse_value_at(s, pos)
    match step.value {
        Result::Ok(v) => {
            let after = json::JsonText::skip_ws(s, step.next)
            if after == n {
                Ok(v)
            } else {
                Err(JsonParseError::TrailingCharacters)
            }
        },
        Result::Err(e) => Err(e),
    }
}

/// Serialize a `JsonValue` back to its JSON text.
fn json_stringify_value(v: JsonValue) -> String {
    match v {
        JsonValue::Null => "null",
        // Bind payload then branch — Bool(true)/Bool(false) arms do not
        // discriminate the bool field on wasm32-gc (#807).
        JsonValue::Bool(b) => {
            if b {
                "true"
            } else {
                "false"
            }
        },
        JsonValue::Number(n) => n,
        JsonValue::Str(s) => json_value_encode_string(s),
        JsonValue::Raw(s) => s,
        JsonValue::Array(items) => json_stringify_array(items),
        JsonValue::Object(fields) => stringify_object(fields),
    }
}

fn json_stringify_array(items: Vec<JsonValue>) -> String {
    let n = items.len()
    let mut out = "["
    let mut i = 0
    while i < n {
        if i > 0 {
            out = out.concat(",")
        }
        out = out.concat(json_stringify_value(get_unchecked(items, i)))
        i = i + 1
    }
    out.concat("]")
}

fn stringify_object(fields: Vec<JsonField>) -> String {
    let n = fields.len()
    let mut out = "{"
    let mut i = 0
    while i < n {
        if i > 0 {
            out = out.concat(",")
        }
        let f = get_unchecked(fields, i)
        out = out.concat(json_value_encode_string(f.key).concat(":".concat(json_stringify_value(f.value))))
        i = i + 1
    }
    out.concat("}")
}

fn repeat_spaces(count: i32) -> String {
    let mut n = count
    if n < 0 {
        n = 0
    }
    let mut s = ""
    let mut i = 0
    while i < n {
        s = s.concat(" ")
        i = i + 1
    }
    s
}

fn stringify_pretty_at(v: JsonValue, indent: i32, depth: i32) -> String {
    match v {
        JsonValue::Null => "null",
        JsonValue::Bool(b) => {
            if b {
                "true"
            } else {
                "false"
            }
        },
        JsonValue::Number(n) => n,
        JsonValue::Str(s) => json_value_encode_string(s),
        JsonValue::Raw(s) => s,
        JsonValue::Array(items) => stringify_array_pretty(items, indent, depth),
        JsonValue::Object(fields) => stringify_object_pretty(fields, indent, depth),
    }
}

fn stringify_array_pretty(items: Vec<JsonValue>, indent: i32, depth: i32) -> String {
    if items.len() == 0 {
        return "[]"
    }
    let child_pad = repeat_spaces(indent * (depth + 1))
    let close_pad = repeat_spaces(indent * depth)
    let mut result = "[\n"
    let n = items.len()
    let mut i = 0
    while i < n {
        if i > 0 {
            result = result.concat(",\n")
        }
        result = result.concat(child_pad)
        result = result.concat(stringify_pretty_at(get_unchecked(items, i), indent, depth + 1))
        i = i + 1
    }
    result.concat("\n").concat(close_pad).concat("]")
}

fn stringify_object_pretty(fields: Vec<JsonField>, indent: i32, depth: i32) -> String {
    if fields.len() == 0 {
        return "{}"
    }
    let child_pad = repeat_spaces(indent * (depth + 1))
    let close_pad = repeat_spaces(indent * depth)
    let mut result = "{\n"
    let n = fields.len()
    let mut i = 0
    while i < n {
        if i > 0 {
            result = result.concat(",\n")
        }
        let f = get_unchecked(fields, i)
        result = result.concat(child_pad)
        result = result.concat(json_value_encode_string(f.key))
        result = result.concat(": ")
        result = result.concat(stringify_pretty_at(f.value, indent, depth + 1))
        i = i + 1
    }
    result.concat("\n").concat(close_pad).concat("}")
}

fn format_array_pretty(raw: String, indent: i32, depth: i32) -> String {
    let n = raw.len()
    let i0 = json::JsonText::skip_ws(raw, 1)
    if i0 < n && raw.byte_at(i0) == 93 {
        return "[]"
    }
    let child_pad = repeat_spaces(indent * (depth + 1))
    let close_pad = repeat_spaces(indent * depth)
    let mut result = "[\n"
    let mut i = json::JsonText::skip_ws(raw, 1)
    let mut first = true
    while i < n - 1 {
        i = json::JsonText::skip_ws(raw, i)
        if i >= n {
            break
        }
        if raw.byte_at(i) == 93 {
            break
        }
        let elem_end = find_value_end(raw, i)
        match parse(raw.slice(i, elem_end)) {
            Result::Ok(elem) => {
                if !first {
                    result = result.concat(",\n")
                }
                first = false
                result = result.concat(child_pad)
                result = result.concat(stringify_pretty_at(elem, indent, depth + 1))
                i = json::JsonText::skip_ws(raw, elem_end)
                if i < n && raw.byte_at(i) == 44 {
                    i = i + 1
                }
            },
            Result::Err(_) => {
                return raw
            },
        }
    }
    result.concat("\n").concat(close_pad).concat("]")
}

fn format_object_pretty(raw: String, indent: i32, depth: i32) -> String {
    let n = raw.len()
    let i0 = json::JsonText::skip_ws(raw, 1)
    if i0 < n && raw.byte_at(i0) == 125 {
        return "{}"
    }
    let child_pad = repeat_spaces(indent * (depth + 1))
    let close_pad = repeat_spaces(indent * depth)
    let mut result = "{\n"
    let mut i = json::JsonText::skip_ws(raw, 1)
    let mut first = true
    while i < n - 1 {
        i = json::JsonText::skip_ws(raw, i)
        if i >= n {
            break
        }
        if raw.byte_at(i) == 125 {
            break
        }
        if raw.byte_at(i) != 34 {
            return raw
        }
        let key_end = find_string_end(raw, i + 1)
        if key_end < 0 {
            return raw
        }
        let key_raw = raw.slice(i, key_end)
        i = json::JsonText::skip_ws(raw, key_end)
        if i >= n || raw.byte_at(i) != 58 {
            return raw
        }
        i = json::JsonText::skip_ws(raw, i + 1)
        let val_start = i
        let val_end = find_value_end(raw, val_start)
        match parse(raw.slice(val_start, val_end)) {
            Result::Ok(v) => {
                if !first {
                    result = result.concat(",\n")
                }
                first = false
                result = result.concat(child_pad)
                result = result.concat(key_raw)
                result = result.concat(": ")
                result = result.concat(stringify_pretty_at(v, indent, depth + 1))
                i = json::JsonText::skip_ws(raw, val_end)
                if i < n && raw.byte_at(i) == 44 {
                    i = i + 1
                }
            },
            Result::Err(_) => {
                return raw
            },
        }
    }
    result.concat("\n").concat(close_pad).concat("}")
}

/// Serialize a `JsonValue` with newlines and indentation for arrays and objects.
/// Scalar values use the stored raw text unchanged. `indent` is spaces per
/// nesting level; negative values are treated as 0.
fn json_value_pretty_text(v: JsonValue, indent: i32) -> String {
    let ind = if indent < 0 {
        0
    } else {
        indent
    }
    stringify_pretty_at(v, ind, 0)
}

// ─── Type predicates ─────────────────────────────────────────────────────────

// ─── Construction helpers ────────────────────────────────────────────────────
/// Create a JsonField from a key and value.
fn json_value_field(key: String, value: JsonValue) -> JsonField {
    JsonField { key: key, value: value }
}

/// Create a JSON string value.
fn json_value_string(s: String) -> JsonValue {
    JsonValue::Str(s)
}

/// Create a JSON integer value (emitted as-is, no `.0` suffix).
fn json_value_int(n: i32) -> JsonValue {
    JsonValue::Raw(n.to_string())
}

/// Create a JSON boolean value.
fn json_value_bool(b: bool) -> JsonValue {
    JsonValue::Bool(b)
}

/// Create a JSON null value.
fn json_value_null() -> JsonValue {
    JsonValue::Null
}

/// Create a JSON raw literal value (emitted as-is).
fn json_value_raw(s: String) -> JsonValue {
    JsonValue::Raw(s)
}

/// Create an empty JsonField vector.
fn json_value_obj_new() -> Vec<JsonField> {
    Vec::new<JsonField>()
}

/// Create an empty JsonValue array vector.
fn json_value_arr_new() -> Vec<JsonValue> {
    Vec::new<JsonValue>()
}

/// Build a JSON object string from a Vec<JsonField>.
fn json_value_obj_string(fields: Vec<JsonField>) -> String {
    json_stringify_value(JsonValue::Object(fields))
}

/// Build a JSON array string from a Vec<JsonValue>.
fn json_value_arr_string(items: Vec<JsonValue>) -> String {
    json_stringify_value(JsonValue::Array(items))
}

// ─── String encoding ─────────────────────────────────────────────────────────
fn json_decode_string(s: String) -> String {
    let n = s.len()
    let mut result = ""
    let mut i = 0
    while i < n {
        let c = s.byte_at(i)
        if c == 92 && i + 1 < n {
            let nxt = s.byte_at(i + 1)
            if nxt == 34 {
                result = result.concat("\"")
                i = i + 2
            } else {
                if nxt == 92 {
                    result = result.concat("\\")
                    i = i + 2
                } else {
                    if nxt == 110 {
                        result = result.concat("\n")
                        i = i + 2
                    } else {
                        if nxt == 116 {
                            result = result.concat("\t")
                            i = i + 2
                        } else {
                            if nxt == 114 {
                                result = result.concat("\r")
                                i = i + 2
                            } else {
                                if nxt == 98 {
                                    result = result.concat(char_to_string(8))
                                    i = i + 2
                                } else {
                                    if nxt == 102 {
                                        result = result.concat(char_to_string(12))
                                        i = i + 2
                                    } else {
                                        if nxt == 47 {
                                            result = result.concat("/")
                                            i = i + 2
                                        } else {
                                            if nxt == 117 && i + 5 < n {
                                                result = result.concat(json::JsonText::decode_unicode_ascii(s, i + 1))
                                                i = i + 6
                                            } else {
                                                result = result.concat(s.slice(i + 1, i + 2))
                                                i = i + 2
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } else {
            result = result.concat(s.slice(i, i + 1))
            i = i + 1
        }
    }
    result
}

/// Encode a plain string as a JSON string literal with surrounding quotes
/// and escape sequences for `"`, `\`, `\n`, `\r`, `\t`, `\b` (\u0008),
/// `\f` (\u000C), and all other control characters below U+0020 via
/// `\u00XX`.  This matches RFC 8259 §7 "All Unicode characters may be
/// placed within the quotation marks except for the characters that must
/// be escaped".
fn json_value_encode_string(s: String) -> String {
    let n = s.len()
    let mut result = "\""
    let mut i = 0
    while i < n {
        let c = s.byte_at(i)
        if c == 34 {
            result = result.concat("\\\"")
        } else {
            if c == 92 {
                result = result.concat("\\\\")
            } else {
                if c == 10 {
                    result = result.concat("\\n")
                } else {
                    if c == 13 {
                        result = result.concat("\\r")
                    } else {
                        if c == 9 {
                            result = result.concat("\\t")
                        } else {
                            if c == 8 {
                                result = result.concat("\\b")
                            } else {
                                if c == 12 {
                                    result = result.concat("\\f")
                                } else {
                                    if c < 32 {
                                        result = result.concat("\\u00")
                                        result = result.concat(json::JsonText::hex_byte(c))
                                    } else {
                                        result = result.concat(s.slice(i, i + 1))
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    result.concat("\"")
}

// ─── Streaming parser utilities ──────────────────────────────────────────────
//
// The functions below provide a low-level streaming JSON scanner that DAP,
// LSP, and diagnostics previously each duplicated.  They operate on raw
// byte offsets within a `String` and never build a full DOM, making them
// suitable for framed message parsing where only a handful of fields are
// needed.
