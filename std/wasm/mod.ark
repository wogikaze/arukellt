//! Experimental WebAssembly helpers.
//!
//! Exposes the Wasm module header, section IDs, value-type constants, opcode
//! constants, FuncType / Limits values, a minimal Wasm module builder, LEB128
//! encoding, and raw v128 linear-memory access. Every entry is an associated
//! function or method on its owning type (ADR-046); the raw v128 bitwise
//! operations live on `std::simd::v128::V128`.
//!
//! All APIs are Experimental and may change in v4+.

/// Section IDs for the standard Wasm sections.
pub struct Section {}

impl Section {
    /// Type section ID (`1`).
    fn type_id() -> i32 {
        1
    }

    /// Import section ID (`2`).
    fn import_id() -> i32 {
        2
    }

    /// Function section ID (`3`).
    fn function_id() -> i32 {
        3
    }

    /// Table section ID (`4`).
    fn table_id() -> i32 {
        4
    }

    /// Memory section ID (`5`).
    fn memory_id() -> i32 {
        5
    }

    /// Global section ID (`6`).
    fn global_id() -> i32 {
        6
    }

    /// Export section ID (`7`).
    fn export_id() -> i32 {
        7
    }

    /// Start section ID (`8`).
    fn start_id() -> i32 {
        8
    }

    /// Element section ID (`9`).
    fn element_id() -> i32 {
        9
    }

    /// Code section ID (`10`).
    fn code_id() -> i32 {
        10
    }

    /// Data section ID (`11`).
    fn data_id() -> i32 {
        11
    }
}

/// Value-type constants matching the Wasm binary encoding.
///
/// The reference types (`funcref` / `externref`) and the numeric types share
/// one namespace; the retired `numtype_*` aliases used the same bytes.
pub struct ValType {}

impl ValType {
    /// `i32` value type (`0x7f`).
    fn i32() -> i32 {
        127
    }

    /// `i64` value type (`0x7e`).
    fn i64() -> i32 {
        126
    }

    /// `f32` value type (`0x7d`).
    fn f32() -> i32 {
        125
    }

    /// `f64` value type (`0x7c`).
    fn f64() -> i32 {
        124
    }

    /// `v128` value type (`0x7b`).
    fn v128() -> i32 {
        123
    }

    /// `funcref` value type (`0x70`).
    fn funcref() -> i32 {
        112
    }

    /// `externref` value type (`0x6f`).
    fn externref() -> i32 {
        111
    }
}

