/// A Wasm function signature: parameter types followed by result types.
///
/// Both lists hold `ValType` constants. The layout is private; use the
/// associated constructor and the receiver methods.
pub struct FuncType {
    params: Vec<i32>,
    results: Vec<i32>,
}

impl FuncType {
    /// Build a signature from parameter and result type lists.
    fn new(params: Vec<i32>, results: Vec<i32>) -> FuncType {
        FuncType {
            params: params,
            results: results,
        }
    }

    /// Number of parameter types.
    fn param_count(self: FuncType) -> i32 {
        self.params.len()
    }

    /// Number of result types.
    fn result_count(self: FuncType) -> i32 {
        self.results.len()
    }

    /// Parameter type at `idx` (0-based, unchecked).
    fn get_param(self: FuncType, idx: i32) -> i32 {
        self.params.get_unchecked(idx)
    }

    /// Result type at `idx` (0-based, unchecked).
    fn get_result(self: FuncType, idx: i32) -> i32 {
        self.results.get_unchecked(idx)
    }
}

/// Memory limits: a minimum page count plus an optional maximum.
pub struct Limits {
    min: i32,
    has_max: bool,
    max: i32,
}

impl Limits {
    /// Unbounded limits with only a minimum.
    fn unbounded(min: i32) -> Limits {
        Limits {
            min: min,
            has_max: false,
            max: 0,
        }
    }

    /// Bounded limits with a minimum and a maximum.
    fn bounded(min: i32, max: i32) -> Limits {
        Limits {
            min: min,
            has_max: true,
            max: max,
        }
    }

    /// Minimum page count.
    fn min(self: Limits) -> i32 {
        self.min
    }

    /// True when a maximum is present.
    fn has_max(self: Limits) -> bool {
        self.has_max
    }

    /// Maximum page count; `0` when `has_max()` is false.
    fn max(self: Limits) -> i32 {
        self.max
    }
}

/// Minimal Wasm module builder.
///
/// Counts function signatures, functions, memories, and exports. Section
/// encoding is still a stub: the counts are observable, but only the module
/// header is encoded. `magic()`, `version()`, and `encode_header()` are
/// associated functions because they do not read builder state.
pub struct WasmModuleBuilder {
    type_count: i32,
    func_count: i32,
    mem_count: i32,
    export_count: i32,
}

impl WasmModuleBuilder {
    /// Create an empty builder with zero entries.
    fn new() -> WasmModuleBuilder {
        WasmModuleBuilder {
            type_count: 0,
            func_count: 0,
            mem_count: 0,
            export_count: 0,
        }
    }

    /// Register a function signature and return its type index.
    fn add_type(mut self: WasmModuleBuilder, ft: FuncType) -> i32 {
        let idx: i32 = self.type_count
        self.type_count = idx + 1
        idx
    }

    /// Register a function of `type_idx` and return its function index.
    fn add_func(mut self: WasmModuleBuilder, type_idx: i32) -> i32 {
        let idx: i32 = self.func_count
        self.func_count = idx + 1
        idx
    }

    /// Register a memory and return its memory index.
    fn add_memory(mut self: WasmModuleBuilder, limits: Limits) -> i32 {
        let idx: i32 = self.mem_count
        self.mem_count = idx + 1
        idx
    }

    /// Record a function export.
    ///
    /// The name and index are part of the encoding contract but the stub only
    /// counts the export until section encoding lands.
    fn add_export_func(mut self: WasmModuleBuilder, name: String, func_idx: i32) {
        self.export_count = self.export_count + 1
    }

    /// Number of registered function signatures.
    fn type_count(self: WasmModuleBuilder) -> i32 {
        self.type_count
    }

    /// Number of registered functions.
    fn func_count(self: WasmModuleBuilder) -> i32 {
        self.func_count
    }

    /// Number of registered memories.
    fn mem_count(self: WasmModuleBuilder) -> i32 {
        self.mem_count
    }

    /// Number of recorded exports.
    fn export_count(self: WasmModuleBuilder) -> i32 {
        self.export_count
    }

    /// The 4-byte Wasm magic number (`\0asm`).
    fn magic() -> Vec<i32> {
        let mut header: Vec<i32> = Vec::new<i32>()
        header.push(0)
        header.push(97)
        header.push(115)
        header.push(109)
        header
    }

    /// The 4-byte Wasm version (`1.0.0.0`).
    fn version() -> Vec<i32> {
        let mut header: Vec<i32> = Vec::new<i32>()
        header.push(1)
        header.push(0)
        header.push(0)
        header.push(0)
        header
    }

    /// Encode the 8-byte Wasm binary header (magic + version).
    ///
    /// Full section encoding is a v4 task; this returns the valid prefix.
    fn encode_header() -> Vec<i32> {
        let mut out: Vec<i32> = Vec::new<i32>()
        out.push(0)
        out.push(97)
        out.push(115)
        out.push(109)
        out.push(1)
        out.push(0)
        out.push(0)
        out.push(0)
        out
    }
}

/// Unsigned LEB128 encoding utilities.
pub struct Leb128 {}

impl Leb128 {
    /// Encode a u32 as unsigned LEB128 and return its bytes.
    fn encode_u32(x: i32) -> Vec<i32> {
        let mut out: Vec<i32> = Vec::new<i32>()
        let mut val: i32 = x
        let mut done: bool = false
        while done == false {
            let byte: i32 = val & 127
            val = val / 128
            if val == 0 {
                out.push(byte)
                done = true
            } else {
                out.push(byte | 128)
            }
        }
        out
    }

    /// Number of bytes needed to encode `x` as unsigned LEB128.
    fn size_u32(x: i32) -> i32 {
        if x < 128 {
            1
        } else {
            if x < 16384 {
                2
            } else {
                if x < 2097152 {
                    3
                } else {
                    if x < 268435456 {
                        4
                    } else {
                        5
                    }
                }
            }
        }
    }
}

// --- v128 linear memory (ADR-037 §11, ADR-042 D7) ---
//
// The raw v128 bitwise operations are owned by `std::simd::v128::V128`. The
// six retired `v128_reinterpret_*` helpers were identity functions: v128 is
// one type, so no conversion is needed.
//
// Linear-memory access is Wasm-specific, so it stays in `std::wasm`. Every
// function takes a byte address and a byte offset; the address operand of the
// emitted `v128.load*` / `v128.store*` instruction is the sum.

/// Raw v128 linear-memory access.
///
/// `load_lane` / `store_lane` move one 32-bit lane, so `lane` is `0..3`.
/// `load_splat` loads one byte and splats it across all 16 lanes.
pub struct V128Memory {}

impl V128Memory {
    /// Load 16 bytes as a v128.
    fn load(address: i32, offset: i32) -> v128 {
        __wasm_v128_load(address, offset)
    }

    /// Store a v128 as 16 bytes.
    fn store(address: i32, offset: i32, value: v128) {
        __wasm_v128_store(address, offset, value)
    }

    /// Load one byte and splat it across all 16 lanes.
    fn load_splat(address: i32, offset: i32) -> v128 {
        __wasm_v128_load_splat(address, offset)
    }

    /// Load the 32-bit lane at `address + offset` into lane `lane` (`0..3`).
    fn load_lane(address: i32, offset: i32, value: v128, lane: i32) -> v128 {
        if lane == 0 { return __wasm_v128_load_lane(address, offset, value, 0) }
        if lane == 1 { return __wasm_v128_load_lane(address, offset, value, 1) }
        if lane == 2 { return __wasm_v128_load_lane(address, offset, value, 2) }
        if lane == 3 { return __wasm_v128_load_lane(address, offset, value, 3) }
        panic("V128Memory::load_lane: lane out of range")
        value
    }

    /// Store lane `lane` (`0..3`) as 4 bytes at `address + offset`.
    fn store_lane(address: i32, offset: i32, value: v128, lane: i32) {
        if lane == 0 {
            __wasm_v128_store_lane(address, offset, value, 0)
            return
        }
        if lane == 1 {
            __wasm_v128_store_lane(address, offset, value, 1)
            return
        }
        if lane == 2 {
            __wasm_v128_store_lane(address, offset, value, 2)
            return
        }
        if lane == 3 {
            __wasm_v128_store_lane(address, offset, value, 3)
            return
        }
        panic("V128Memory::store_lane: lane out of range")
    }

    /// Load 8 bytes and sign-extend each i8 to an i16 lane.
    fn load8x8_s(address: i32, offset: i32) -> v128 {
        __wasm_v128_load8x8_s(address, offset)
    }

    /// Load 8 bytes and zero-extend each i8 to an i16 lane.
    fn load8x8_u(address: i32, offset: i32) -> v128 {
        __wasm_v128_load8x8_u(address, offset)
    }

    /// Load 8 bytes and sign-extend each i16 pair to an i32 lane.
    fn load16x4_s(address: i32, offset: i32) -> v128 {
        __wasm_v128_load16x4_s(address, offset)
    }

    /// Load 8 bytes and zero-extend each i16 pair to an i32 lane.
    fn load16x4_u(address: i32, offset: i32) -> v128 {
        __wasm_v128_load16x4_u(address, offset)
    }

    /// Load 8 bytes and sign-extend each i32 pair to an i64 lane.
    fn load32x2_s(address: i32, offset: i32) -> v128 {
        __wasm_v128_load32x2_s(address, offset)
    }

    /// Load 8 bytes and zero-extend each i32 pair to an i64 lane.
    fn load32x2_u(address: i32, offset: i32) -> v128 {
        __wasm_v128_load32x2_u(address, offset)
    }
}
