//! std::io — target-independent I/O abstraction (ADR-085 Phase A).
//!
//! Defines the public `Read` / `Write` / `BufRead` / `Seek` traits, the
//! `SeekFrom` origin, and the in-memory `Reader` / `Writer` newtypes. `Reader`
//! implements `Read`, `BufRead`, and `Seek`; `Writer` implements `Write`.
//!
//! # Contract notes
//!
//! - Bytes are `Vec<i32>` values masked to 0–255.
//! - Handles are not `Copy`. A method call does not move the receiver: the
//! cursor belongs to the handle, so successive calls share it (ADR-059 and
//! ADR-085 D2). Moving a handle into an adapter transfers ownership.
//! - `Read::read` returns an empty `Vec` at EOF; a negative `max_bytes` is
//! `IoError::Other`. `Seek` rejects negative effective positions. Seeking past
//! the end is allowed and reads report EOF.
//! - `BufRead::read_line` returns `None` at EOF, so an empty line and EOF stay
//! distinguishable.
//!
//! # Representation
//!
//! `Reader` stores an owned byte image plus an i32 cursor, and `Writer` stores
//! an owned byte image. Neither layout is a public contract (ADR-085 D3).
//!
//! # Compatibility surface
//!
//! The `reader_*` / `writer_*` / `buf_*` / `copy*` free functions predate the
//! traits and keep their legacy `Vec<i32>` layout contracts while #693 moves
//! callers to the newtypes. `stdin` / `stdout` / `stderr` remain host-backed
//! compatibility functions; their trait handles belong to the `std::host`
//! stdio work. WASI stdin reading is unavailable, so `stdin()` is empty and
//! `read_stdin_line()` returns `Ok("")`.

// ─── Error type ───────────────────────────────────────────────────────────────
use std::prelude::{byte_at, i32_to_i64, i64_to_i32}
use std::text

const NEWLINE_BYTE: i32 = 10
const BYTE_MASK: i32 = 255
const COPY_CHUNK_BYTES: i32 = 256
// The Reader cursor is an i32, so a Seek coordinate above this cannot be
// represented without silent truncation (ADR-067). Keep the bound explicit.
// The bound stays i32: a module-level i64 const is lowered as an accessor
// call on wasm32 and breaks i64 locals in Result<i64> functions.
const MAX_CURSOR_POSITION: i32 = 2147483647
/// Typed error for I/O operations.
pub enum IoError {
    /// Not enough data was available to fulfill a read request.
    UnexpectedEof(String),
    /// Catch-all for other I/O errors.
    Other(String),
}

/// Convert an `IoError` to a human-readable message.
pub fn io_error_message(err: IoError) -> String {
    match err {
        IoError::UnexpectedEof(msg) => msg,
        IoError::Other(msg) => msg,
    }
}

/// Display implementation for the typed I/O error surface.
impl Display for IoError {
    fn to_string(self: IoError) -> String {
        text::concat("IoError: ", io_error_message(self))
    }
}

/// I/O errors have no nested source in the current in-memory runtime.
impl Error for IoError {
    fn source(self: IoError) -> Option<String> {
        None
    }
}

/// `From<IoError>` impl for `String` — flattens an `IoError` into its
/// message string. Used by the `?` operator (issue #690) to convert
/// `Result<_, IoError>` failures into `Result<_, String>` return types:
/// `expr?` desugars to
/// `match expr { Ok(v) => v, Err(e) => return Err(From::from(e)) }`.
impl From<IoError> for String {
    fn from(err: IoError) -> String {
        io_error_message(err)
    }
}

// ─── Seek origin and traits (ADR-085) ────────────────────────────────────────
/// Offset origin for `Seek::seek`.
pub enum SeekFrom {
    /// Offset from the start of the stream.
    Start(i64),
    /// Offset from the current position.
    Current(i64),
    /// Offset from the end of the stream.
    End(i64),
}

/// Pull-based byte source (ADR-085).
///
/// `read` returns at most `max_bytes` bytes and advances the handle's cursor.
/// An empty `Vec` means EOF; a negative `max_bytes` is `IoError::Other`. The
/// receiver is written by value, but a method call does not move the handle:
/// successive reads share the same cursor.
///
/// ## Protocol catalog: `Read`
///
/// | Type     | Status | Notes                                   |
/// |----------|--------|-----------------------------------------|
/// | Reader   | impl   | In-memory byte image (`[cursor, ...]`)  |
/// | File     | Phase D| `std::host::fs` whole-file handle (#693) |
pub trait Read {
    fn read(self: Self, max_bytes: i32) -> Result<Vec<i32>, IoError>
}

/// Byte sink (ADR-085).
///
/// `write` appends `data` and returns the accepted byte count. `flush` is the
/// sink's commitment boundary; the memory `Writer` has nothing to flush.
///
/// ## Protocol catalog: `Write`
///
/// | Type     | Status | Notes                                   |
/// |----------|--------|-----------------------------------------|
/// | Writer   | impl   | In-memory byte image (`[fd_tag=0, ...]`) |
/// | File     | Phase D| `std::host::fs` whole-file handle (#693) |
pub trait Write {
    fn write(self: Self, data: Vec<i32>) -> Result<i32, IoError>
    fn flush(self: Self) -> Result<(), IoError>
}

/// Buffered byte source layered over `Read` (ADR-085).
///
/// `fill_buf` returns an owned snapshot of the unconsumed bytes because the
/// language has no lifetime-carrying borrow view. `consume` advances past at
/// most that snapshot. `read_line` excludes the newline and returns `None`
/// only at EOF, so an empty line stays distinguishable from EOF.
pub trait BufRead: Read {
    fn fill_buf(self: Self) -> Result<Vec<i32>, IoError>
    fn consume(self: Self, amount: i32) -> Result<(), IoError>
    fn read_line(self: Self) -> Result<Option<String>, IoError>
}

/// Random access over a byte stream (ADR-085).
///
/// `seek` takes a `SeekFrom` origin and returns the new absolute position.
/// A negative effective position, or one above the i32 cursor range, is
/// `IoError::Other`. `position` reports the current cursor.
pub trait Seek {
    fn seek(self: Self, from: SeekFrom) -> Result<i64, IoError>
    fn position(self: Self) -> Result<i64, IoError>
}

// ─── Memory Reader / Writer newtypes (ADR-085 Phase A) ──────────────────────
/// In-memory read handle over an owned byte image.
///
/// The byte image and cursor are private. Use `Reader::from_bytes` to wrap a
/// raw `Vec<i32>` and `into_bytes` to recover the image. Handles are not
/// `Copy`, so moving one into an adapter transfers ownership.
pub struct Reader {
    bytes: Vec<i32>,
    cursor: i32,
}

impl Reader {
    /// Creates a reader positioned at the start of `data`.
    fn from_bytes(data: Vec<i32>) -> Reader {
        Reader {
            bytes: data,
            cursor: 0,
        }
    }

    /// Creates an empty reader positioned at EOF.
    fn new() -> Reader {
        Reader {
            bytes: Vec::new<i32>(),
            cursor: 0,
        }
    }

    /// Returns the total byte count, independent of the cursor.
    fn len(self: Reader) -> i32 {
        len(self.bytes)
    }

    /// Returns true when the cursor is at or past the end of the image.
    fn is_eof(self: Reader) -> bool {
        self.cursor >= len(self.bytes)
    }

    /// Returns the full byte image, independent of the cursor.
    fn into_bytes(self: Reader) -> Vec<i32> {
        self.bytes
    }
}

impl Read for Reader {
    fn read(self: Reader, max_bytes: i32) -> Result<Vec<i32>, IoError> {
        if max_bytes < 0 {
            return Err(IoError::Other("read: max_bytes must be non-negative"))
        }
        let total: i32 = len(self.bytes)
        let available: i32 = if self.cursor < total { total - self.cursor } else { 0 }
        let count: i32 = if max_bytes < available { max_bytes } else { available }
        let out: Vec<i32> = Vec::new<i32>()
        let mut i: i32 = 0
        while i < count {
            push(out, get_unchecked(self.bytes, self.cursor + i))
            i = i + 1
        }
        self.cursor = self.cursor + count
        Ok(out)
    }
}

impl BufRead for Reader {
    fn fill_buf(self: Reader) -> Result<Vec<i32>, IoError> {
        let total: i32 = len(self.bytes)
        let out: Vec<i32> = Vec::new<i32>()
        let mut i: i32 = self.cursor
        while i < total {
            push(out, get_unchecked(self.bytes, i))
            i = i + 1
        }
        Ok(out)
    }

    fn consume(self: Reader, amount: i32) -> Result<(), IoError> {
        if amount < 0 {
            return Err(IoError::Other("consume: amount must be non-negative"))
        }
        let total: i32 = len(self.bytes)
        let available: i32 = if self.cursor < total { total - self.cursor } else { 0 }
        if amount > available {
            return Err(IoError::Other("consume: amount exceeds buffered bytes"))
        }
        self.cursor = self.cursor + amount
        Ok(())
    }

    fn read_line(self: Reader) -> Result<Option<String>, IoError> {
        if self.cursor >= len(self.bytes) {
            return Ok(Option::None)
        }
        let total: i32 = len(self.bytes)
        let mut line: String = ""
        let mut pos: i32 = self.cursor
        let mut found_newline: bool = false
        while pos < total && !found_newline {
            let byte: i32 = get_unchecked(self.bytes, pos)
            pos = pos + 1
            if byte == NEWLINE_BYTE {
                found_newline = true
            } else {
                line = __intrinsic_concat(line, char_to_string(byte))
            }
        }
        self.cursor = pos
        Ok(Option::Some(line))
    }
}

impl Seek for Reader {
    fn seek(self: Reader, from: SeekFrom) -> Result<i64, IoError> {
        let target: i64 = match from {
            SeekFrom::Start(offset) => offset,
            SeekFrom::Current(offset) => i32_to_i64(self.cursor) + offset,
            SeekFrom::End(offset) => i32_to_i64(len(self.bytes)) + offset,
        }
        if target < 0i64 {
            return Err(IoError::Other("seek: negative position"))
        }
        if target > i32_to_i64(MAX_CURSOR_POSITION) {
            return Err(IoError::Other("seek: position exceeds i32 range"))
        }
        self.cursor = i64_to_i32(target)
        Ok(target)
    }

    fn position(self: Reader) -> Result<i64, IoError> {
        Ok(i32_to_i64(self.cursor))
    }
}

/// In-memory write handle over an owned byte image.
///
/// The image is private; `into_bytes` recovers it and `into_reader` reopens it
/// as a cursor-0 `Reader`. Handles are not `Copy`.
pub struct Writer {
    bytes: Vec<i32>,
}

impl Writer {
    /// Creates an empty writer.
    fn new() -> Writer {
        Writer {
            bytes: Vec::new<i32>(),
        }
    }

    /// Returns the buffered byte image.
    fn into_bytes(self: Writer) -> Vec<i32> {
        self.bytes
    }

    /// Converts the buffered bytes into a cursor-0 reader.
    fn into_reader(self: Writer) -> Reader {
        Reader::from_bytes(self.bytes)
    }
}

impl Write for Writer {
    fn write(self: Writer, data: Vec<i32>) -> Result<i32, IoError> {
        let count: i32 = len(data)
        let mut i: i32 = 0
        while i < count {
            push(self.bytes, get_unchecked(data, i) & BYTE_MASK)
            i = i + 1
        }
        Ok(count)
    }

    fn flush(self: Writer) -> Result<(), IoError> {
        Ok(())
    }
}

// ─── Reader ──────────────────────────────────────────────────────────────────
/// Creates a Reader over the given byte buffer.
///
/// Reader layout: `[cursor=0, b0, b1, …, bn]`
pub fn reader_from_bytes(data: Vec<i32>) -> Vec<i32> {
    let r: Vec<i32> = Vec::new<i32>()
    push(r, 0)
    let n: i32 = len(data)
    let mut i: i32 = 0
    while i < n {
        push(r, get_unchecked(data, i))
        i = i + 1
    }
    r
}

/// Returns true when the Reader cursor is at or past the end of available data.
pub fn reader_eof(r: Vec<i32>) -> bool {
    let cursor: i32 = get_unchecked(r, 0)
    let total: i32 = len(r) - 1
    cursor >= total
}

/// Reads up to `n` bytes from the Reader, advancing its cursor.
///
/// Returns the bytes actually read (fewer than `n` when near EOF).
pub fn reader_read(r: Vec<i32>, n: i32) -> Result<Vec<i32>, IoError> {
    let cursor: i32 = get_unchecked(r, 0)
    let total: i32 = len(r) - 1
    let available: i32 = total - cursor
    let count: i32 = if n < available {
        n
    } else {
        available
    }
    let out: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < count {
        push(out, get_unchecked(r, 1 + cursor + i))
        i = i + 1
    }
    set(r, 0, cursor + count)
    Ok(out)
}

/// Reads exactly `n` bytes; returns `Err` if fewer than `n` bytes remain.
pub fn reader_read_exact(r: Vec<i32>, n: i32) -> Result<Vec<i32>, IoError> {
    let cursor: i32 = get_unchecked(r, 0)
    let total: i32 = len(r) - 1
    let available: i32 = total - cursor
    if available < n {
        let msg: String = __intrinsic_concat("UnexpectedEof: need ", __intrinsic_i32_to_string(n))
        let msg2: String = __intrinsic_concat(msg, " have ")
        Err(IoError::UnexpectedEof(__intrinsic_concat(msg2, __intrinsic_i32_to_string(available))))
    } else {
        let out: Vec<i32> = Vec::new<i32>()
        let mut i: i32 = 0
        while i < n {
            push(out, get_unchecked(r, 1 + cursor + i))
            i = i + 1
        }
        set(r, 0, cursor + n)
        Ok(out)
    }
}

/// Reads all remaining bytes from the Reader.
pub fn reader_read_all(r: Vec<i32>) -> Result<Vec<i32>, IoError> {
    let cursor: i32 = get_unchecked(r, 0)
    let total: i32 = len(r) - 1
    let remaining: i32 = total - cursor
    reader_read(r, remaining)
}

/// Reads bytes until a newline (`0x0A`) or EOF, returning the line as a String.
///
/// The newline character is consumed but not included in the returned string.
pub fn reader_read_line(r: Vec<i32>) -> Result<String, IoError> {
    let cursor: i32 = get_unchecked(r, 0)
    let total: i32 = len(r) - 1
    let mut line: String = ""
    let mut pos: i32 = cursor
    let mut stop: bool = false
    // Consume through newline (excluded from line) or EOF; leave cursor for the next line.
    while pos < total && !stop {
        let b: i32 = get_unchecked(r, 1 + pos)
        pos = pos + 1
        if b == 10 {
            stop = true
        } else {
            line = __intrinsic_concat(line, char_to_string(b))
        }
    }
    set(r, 0, pos)
    Ok(line)
}

// ─── Standard I/O (stdin / stdout / stderr) ──────────────────────────────────
/// Returns a Reader representing stdin.
///
/// NOTE: WASI stdin reading is not available in the current runtime.
/// The returned Reader is always empty. Use `read_stdin_line()` for a
/// future-compatible placeholder.
pub fn stdin() -> Vec<i32> {
    let r: Vec<i32> = Vec::new<i32>()
    push(r, 0)
    r
}

/// Returns a Writer that emits to stdout.
pub fn stdout() -> Vec<i32> {
    let w: Vec<i32> = Vec::new<i32>()
    push(w, 1)
    w
}

/// Returns a Writer that emits to stderr.
pub fn stderr() -> Vec<i32> {
    let w: Vec<i32> = Vec::new<i32>()
    push(w, 2)
    w
}

/// Reads a line from stdin.
///
/// NOTE: WASI stdin reading is not available in the current runtime.
/// Always returns `Ok("")`.
pub fn read_stdin_line() -> Result<String, IoError> {
    Ok("")
}

/// Prints a byte buffer directly to stdout (no trailing newline).
pub fn print_bytes(data: Vec<i32>) {
    let n: i32 = len(data)
    let mut s: String = ""
    let mut i: i32 = 0
    while i < n {
        s = __intrinsic_concat(s, char_to_string(get_unchecked(data, i) & 255))
        i = i + 1
    }
    __intrinsic_print(s)
}

// ─── Writer ──────────────────────────────────────────────────────────────────
/// Creates an in-memory Writer.
pub fn writer_new() -> Vec<i32> {
    let w: Vec<i32> = Vec::new<i32>()
    push(w, 0)
    w
}

/// Writes `data` bytes to the Writer. Returns the number of bytes written.
///
/// - Memory writers buffer the bytes.
/// - stdout/stderr writers emit synchronously via print intrinsics.
pub fn writer_write(w: Vec<i32>, data: Vec<i32>) -> Result<i32, IoError> {
    let tag: i32 = get_unchecked(w, 0)
    let n: i32 = len(data)
    if tag == 0 {
        let mut i: i32 = 0
        while i < n {
            push(w, get_unchecked(data, i) & 255)
            i = i + 1
        }
        Ok(n)
    } else {
        let mut s: String = ""
        let mut i: i32 = 0
        while i < n {
            s = __intrinsic_concat(s, char_to_string(get_unchecked(data, i) & 255))
            i = i + 1
        }
        if tag == 1 {
            __intrinsic_print(s)
        } else {
            __intrinsic_eprintln(s)
        }
        Ok(n)
    }
}

/// Writes a string to the Writer. Returns the number of bytes written.
pub fn writer_write_str(w: Vec<i32>, s: String) -> Result<i32, IoError> {
    let tag: i32 = get_unchecked(w, 0)
    let n: i32 = len(s)
    if tag == 0 {
        let mut i: i32 = 0
        while i < n {
            push(w, byte_at(s, i) & 255)
            i = i + 1
        }
        Ok(n)
    } else {
        if tag == 1 {
            __intrinsic_print(s)
            Ok(n)
        } else {
            __intrinsic_eprintln(s)
            Ok(n)
        }
    }
}

/// Writes all bytes in `data`; returns `()` on success.
pub fn write_all(w: Vec<i32>, data: Vec<i32>) -> Result<(), IoError> {
    match writer_write(w, data) {
        Result::Ok(_) => Ok(()),
        Result::Err(e) => Err(e),
    }
}

/// Writes a string; returns `()` on success.
pub fn write_string(w: Vec<i32>, s: String) -> Result<(), IoError> {
    match writer_write_str(w, s) {
        Result::Ok(_) => Ok(()),
        Result::Err(e) => Err(e),
    }
}

/// Flushes the Writer.
///
/// stdout/stderr Writers already emit synchronously, so this is always a no-op.
/// Memory Writers buffer locally; no underlying fd to flush.
pub fn writer_flush(w: Vec<i32>) -> Result<(), IoError> {
    Ok(())
}

/// Returns the buffered bytes of a memory Writer.
///
/// For stdout/stderr Writers, returns an empty Vec (bytes were already emitted).
pub fn writer_to_bytes(w: Vec<i32>) -> Vec<i32> {
    let out: Vec<i32> = Vec::new<i32>()
    let tag: i32 = get_unchecked(w, 0)
    if tag == 0 {
        let total: i32 = len(w)
        let mut i: i32 = 1
        while i < total {
            push(out, get_unchecked(w, i))
            i = i + 1
        }
    }
    out
}

// ─── Buffered I/O ─────────────────────────────────────────────────────────────
/// Creates a BufReader wrapping a Reader, with a read-ahead hint of `cap` bytes.
///
/// BufReader layout: `[cursor=0, buf_cap, b0, b1, …, bn]`
/// (The cap hint is stored but does not change in-memory behavior.)
pub fn buf_reader_new(r: Vec<i32>, cap: i32) -> Vec<i32> {
    let br: Vec<i32> = Vec::new<i32>()
    push(br, 0)
    push(br, cap)
    let r_total: i32 = len(r) - 1
    let mut i: i32 = 0
    while i < r_total {
        push(br, get_unchecked(r, 1 + i))
        i = i + 1
    }
    br
}

/// Alias for `buf_reader_new` (issue API name).
pub fn buffered_reader(r: Vec<i32>, buf_size: i32) -> Vec<i32> {
    buf_reader_new(r, buf_size)
}

/// Reads a line from a BufReader.
///
/// BufReader bytes start at index 2. Newline is consumed but not included.
pub fn buf_reader_read_line(br: Vec<i32>) -> Result<String, IoError> {
    let cursor: i32 = get_unchecked(br, 0)
    let total: i32 = len(br) - 2
    let mut line: String = ""
    let mut pos: i32 = cursor
    let mut stop: bool = false
    // Stop after newline; do not jump to EOF (that skipped later lines).
    while pos < total && !stop {
        let b: i32 = get_unchecked(br, 2 + pos)
        pos = pos + 1
        if b == 10 {
            stop = true
        } else {
            line = __intrinsic_concat(line, char_to_string(b))
        }
    }
    set(br, 0, pos)
    Ok(line)
}

/// Creates a BufWriter wrapping a Writer, with a flush threshold of `cap` bytes.
///
/// BufWriter layout: `[fd_tag, buf_cap, b0, b1, …, bn]`
/// Auto-flushes when the buffer reaches `cap`.
pub fn buf_writer_new(w: Vec<i32>, cap: i32) -> Vec<i32> {
    let bw: Vec<i32> = Vec::new<i32>()
    let tag: i32 = get_unchecked(w, 0)
    push(bw, tag)
    push(bw, cap)
    bw
}

/// Alias for `buf_writer_new` (issue API name).
pub fn buffered_writer(w: Vec<i32>, buf_size: i32) -> Vec<i32> {
    buf_writer_new(w, buf_size)
}

/// Writes a string to a BufWriter.
///
/// Auto-flushes to the underlying output when the buffer reaches buf_cap.
pub fn buf_writer_write_str(bw: Vec<i32>, s: String) -> Result<i32, IoError> {
    let cap: i32 = get_unchecked(bw, 1)
    let n: i32 = len(s)
    let mut i: i32 = 0
    while i < n {
        push(bw, byte_at(s, i) & 255)
        i = i + 1
    }
    let buf_size: i32 = len(bw) - 2
    if buf_size >= cap {
        let _: Result<(), IoError> = buf_writer_flush(bw)
    }
    Ok(n)
}

/// Flushes the BufWriter: emits all buffered bytes to the underlying output.
///
/// - stdout/stderr: prints buffered content, then clears the buffer.
/// - memory: clears the buffer (bytes are considered consumed by the caller).
pub fn buf_writer_flush(bw: Vec<i32>) -> Result<(), IoError> {
    let tag: i32 = get_unchecked(bw, 0)
    let cap: i32 = get_unchecked(bw, 1)
    let buf_size: i32 = len(bw) - 2
    if buf_size > 0 {
        if tag == 1 {
            let mut s: String = ""
            let mut i: i32 = 0
            while i < buf_size {
                s = __intrinsic_concat(s, char_to_string(get_unchecked(bw, 2 + i) & 255))
                i = i + 1
            }
            __intrinsic_print(s)
        } else {
            if tag == 2 {
                let mut s: String = ""
                let mut i: i32 = 0
                while i < buf_size {
                    s = __intrinsic_concat(s, char_to_string(get_unchecked(bw, 2 + i) & 255))
                    i = i + 1
                }
                __intrinsic_eprintln(s)
            }
        }
        // `clear` has no emitter; pop payload then restore tag/cap (#807).
        while len(bw) > 0 {
            let _: Option<i32> = pop(bw)
        }
        push(bw, tag)
        push(bw, cap)
    }
    Ok(())
}

// ─── Copy utility ─────────────────────────────────────────────────────────────
/// Copies all remaining bytes from a Reader to a Writer.
///
/// Returns the total number of bytes transferred.
pub fn copy_bytes(from: Vec<i32>, to: Vec<i32>) -> Result<i32, IoError> {
    let cursor: i32 = get_unchecked(from, 0)
    let total: i32 = len(from) - 1
    let remaining: i32 = total - cursor
    let r: Result<Vec<i32>, IoError> = reader_read(from, remaining)
    match r {
        Result::Ok(data) => writer_write(to, data),
        Result::Err(e) => Err(e),
    }
}

/// Alias for `copy_bytes` (issue API name).
pub fn copy(r: Vec<i32>, w: Vec<i32>) -> Result<i32, IoError> {
    copy_bytes(r, w)
}

// ─── Legacy memory-buffer helpers (compatibility) ──────────────────────────
//
// These free functions keep the `Vec<i32>` layout contracts that predate the
// newtypes. They are independent of the trait impls above: Phase E converts
// them into wrappers and deprecates them under #693 / ADR-014.

/// Creates a new memory buffer for the legacy trait helpers.
///
/// The buffer uses Reader layout `[cursor=0]` so it can be used as both a
/// legacy Read source (after writing bytes) and a Write destination.
pub fn new_memory_buffer() -> Vec<i32> {
    let buf: Vec<i32> = Vec::new<i32>()
    push(buf, 0)
    buf
}

/// Appends byte values to a legacy memory buffer and returns the count.
///
/// `buf` must come from `new_memory_buffer()`.
pub fn write_bytes(buf: Vec<i32>, data: Vec<i32>) -> i32 {
    let count: i32 = len(data)
    let mut i: i32 = 0
    while i < count {
        push(buf, get_unchecked(data, i) & BYTE_MASK)
        i = i + 1
    }
    count
}

/// Reads up to `n` bytes from a legacy memory buffer.
///
/// A negative `n` reads nothing and leaves the cursor unchanged, matching the
/// pre-newtype helper.
pub fn read_bytes(buf: Vec<i32>, n: i32) -> Vec<i32> {
    let cursor: i32 = get_unchecked(buf, 0)
    let total: i32 = len(buf) - 1
    let available: i32 = total - cursor
    let wanted: i32 = if n < available { n } else { available }
    let count: i32 = if wanted < 0 { 0 } else { wanted }
    let out: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < count {
        push(out, get_unchecked(buf, 1 + cursor + i))
        i = i + 1
    }
    set(buf, 0, cursor + count)
    out
}

/// Seeks to the absolute position `pos`, clamped to `[0, len]`.
///
/// The clamp is the legacy `seek_to` contract; `Seek::seek` does not clamp.
pub fn seek_to(buf: Vec<i32>, pos: i64) -> i64 {
    let total: i32 = len(buf) - 1
    let requested: i32 = i64_to_i32(pos)
    let clamped: i32 = if requested < 0 {
        0
    } else if requested > total {
        total
    } else {
        requested
    }
    set(buf, 0, clamped)
    i32_to_i64(clamped)
}

/// Returns the current cursor position of a legacy memory buffer.
///
/// `position` was renamed because the ADR-085 `Seek::position` method occupies
/// the `std::io` function namespace. The compatibility helper keeps the legacy
/// `Vec<i32>` contract; callers move to `Reader::position()` when they adopt
/// the newtype API.
pub fn buffer_position(buf: Vec<i32>) -> i64 {
    i32_to_i64(get_unchecked(buf, 0))
}

/// Returns the total number of bytes available in a legacy memory buffer.
pub fn buffer_len(buf: Vec<i32>) -> i64 {
    let total: i32 = len(buf) - 1
    i32_to_i64(total)
}

/// Returns the unread bytes of a legacy buffered source without advancing it.
pub fn fill_buffer(buf: Vec<i32>) -> Vec<i32> {
    let cursor: i32 = get_unchecked(buf, 0)
    let total: i32 = len(buf) - 1
    let out: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = cursor
    while i < total {
        push(out, get_unchecked(buf, 1 + i))
        i = i + 1
    }
    out
}

/// Copies all remaining bytes between legacy layout buffers.
///
/// The monomorphic form predates #693 Phase B; `Io::copy` will own the generic
/// algorithm once two-bound monomorphisation is confirmed.
pub fn copy_trait(from: Vec<i32>, to: Vec<i32>) -> i32 {
    let mut total: i32 = 0
    let mut done: bool = false
    while !done {
        match reader_read(from, COPY_CHUNK_BYTES) {
            Result::Ok(chunk) => {
                if len(chunk) == 0 {
                    done = true
                } else {
                    total = total + write_bytes(to, chunk)
                }
            },
            Result::Err(_) => done = true,
        }
    }
    total
}

// ─── Legacy FileHandle compatibility (#693) ────────────────────────────────
//
// `FileHandle` is the experimental fd wrapper from the partial #693 work. It
// keeps the legacy Vec layout until Phase D's `std::host::fs::File` replaces
// it. The fd must come from the `std::host::fs` fd helpers.

/// Creates a legacy FileHandle from a raw file descriptor.
pub fn file_from_fd(fd: i32) -> Vec<i32> {
    let handle: Vec<i32> = Vec::new<i32>()
    push(handle, fd)
    push(handle, 0)
    handle
}

/// Reads up to `len(buf)` bytes from a legacy FileHandle into `buf`.
///
/// Returns the number of bytes read (0 at EOF).
pub fn file_read(handle: Vec<i32>, buf: Vec<i32>) -> i32 {
    match reader_read(handle, len(buf)) {
        Result::Ok(chunk) => {
            let count: i32 = len(chunk)
            let mut i: i32 = 0
            while i < count {
                set(buf, i, get_unchecked(chunk, i))
                i = i + 1
            }
            count
        },
        Result::Err(_) => 0,
    }
}

/// Writes `buf` bytes to a legacy FileHandle and returns the accepted count.
pub fn file_write(handle: Vec<i32>, buf: Vec<i32>) -> i32 {
    match writer_write(handle, buf) {
        Result::Ok(count) => count,
        Result::Err(_) => 0,
    }
}
