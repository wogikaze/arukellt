//! std::io — target-independent I/O abstraction (ADR-085 Phases A–F).
//!
//! Defines the public `Read` / `Write` / `BufRead` / `Seek` traits, the
//! `SeekFrom` origin, the in-memory `Reader` / `Writer` newtypes, the
//! receiver-less generic algorithms on `Io`, and the generic `BufReader<R>` /
//! `BufWriter<W>` adapters. `Reader` implements `Read`, `BufRead`, and `Seek`;
//! `Writer` implements `Write`. `std::host::fs::File` implements `Read`,
//! `Write`, and `Seek`: `File::open` loads a read-only image, `File::create`
//! starts a write image, and `flush` / `close` commit that image (ADR-085 D6).
//! The host-backed `Stdout` / `Stderr` typed handles also implement `Write`
//! and are the byte-faithful standard-stream sinks.
//!
//! # Contract notes
//!
//! - Bytes are `Vec<i32>` values masked to 0–255.
//! - Handles are not `Copy`. A method call does not move the receiver: the
//! cursor belongs to the handle, so successive calls share it (ADR-059 and
//! ADR-085 D2). Moving a handle into an adapter transfers ownership.
//! - `Read::read` returns an empty `Vec` at EOF; a negative `max_bytes` is
//! `IoError::Other`. `Seek` rejects negative effective positions. Seeking past
//! the end is allowed and reads report EOF.
//! - `BufRead::read_line` returns `None` at EOF, so an empty line and EOF stay
//! distinguishable.
//!
//! # Representation
//!
//! `Reader` stores an owned byte image plus an i32 cursor, and `Writer` stores
//! an owned byte image. Neither layout is a public contract (ADR-085 D3).
//!
//! # Compatibility surface
//!
//! ADR-085 Phase E/F moved the canonical surface to the traits and deleted the
//! legacy free functions that the newtypes and `Io` fully replace. The
//! `reader_*` read methods, `copy*`, `new_memory_buffer` / `write_bytes` /
//! `read_bytes` / `seek_to` / `buffer_position` / `buffer_len` /
//! `fill_buffer`, the `reader_from_bytes` / `buf_*` / `writer_new` /
//! `write_all` / `write_string` / `writer_flush` / `writer_to_bytes` wrappers,
//! the tagged `writer_write` / `writer_write_str` pair, and the experimental
//! `file_*` fd lane surface as E0100 with a replacement hint from
//! `resolver::removed_names`.
//!
//! Output sinks are the typed `Stdout` / `Stderr` handles, which implement
//! `Write` byte-faithfully. The tagged `writer_write` / `writer_write_str`
//! pair is retired with E0100 hints.
//!
//! `stdin` / `stdout` / `stderr` / `read_stdin_line` / `print_bytes` remain
//! host-backed compatibility functions. The tagged `stdout()` / `stderr()`
//! vectors have no byte-faithful writer of their own; use the typed
//! `Stdout` / `Stderr` handles. WASI stdin reading is unavailable, so
//! `stdin()` is empty and `read_stdin_line()` returns `Ok("")`.

// ─── Error type ───────────────────────────────────────────────────────────────
use std::core::convert
use std::text

const NEWLINE_BYTE: i32 = 10
const BYTE_MASK: i32 = 255
const COPY_CHUNK_BYTES: i32 = 256
// The Reader cursor is an i32, so a Seek coordinate above this cannot be
// represented without silent truncation (ADR-067). Keep the bound explicit.
// The bound stays i32: a module-level i64 const is lowered as an accessor
// call on wasm32 and breaks i64 locals in Result<i64> functions.
const MAX_CURSOR_POSITION: i32 = 2147483647
/// Typed error for I/O operations.
pub enum IoError {
    /// Not enough data was available to fulfill a read request.
    UnexpectedEof(String),
    /// Catch-all for other I/O errors.
    Other(String),
}

impl IoError {
    /// Return the human-readable payload without the `IoError:` display
    /// prefix.
    fn message(self: IoError) -> String {
        match self {
            IoError::UnexpectedEof(msg) => msg,
            IoError::Other(msg) => msg,
        }
    }
}

/// Display implementation for the typed I/O error surface.
impl Display for IoError {
    fn to_string(self: IoError) -> String {
        "IoError: ".concat(self.message())
    }
}

/// I/O errors have no nested source in the current in-memory runtime.
impl Error for IoError {
    fn source(self: IoError) -> Option<String> {
        None
    }
}

/// `From<IoError>` impl for `String` — flattens an `IoError` into its
/// message string. Used by the `?` operator (issue #690) to convert
/// `Result<_, IoError>` failures into `Result<_, String>` return types:
/// `expr?` desugars to
/// `match expr { Ok(v) => v, Err(e) => return Err(From::from(e)) }`.
impl From<IoError> for String {
    fn from(err: IoError) -> String {
        err.message()
    }
}

// ─── Seek origin and traits (ADR-085) ────────────────────────────────────────
/// Offset origin for `Seek::seek`.
pub enum SeekFrom {
    /// Offset from the start of the stream.
    Start(i64),
    /// Offset from the current position.
    Current(i64),
    /// Offset from the end of the stream.
    End(i64),
}

/// Pull-based byte source (ADR-085).
///
/// `read` returns at most `max_bytes` bytes and advances the handle's cursor.
/// An empty `Vec` means EOF; a negative `max_bytes` is `IoError::Other`. The
/// receiver is written by value, but a method call does not move the handle:
/// successive reads share the same cursor.
///
/// ## Protocol catalog: `Read`
///
/// | Type     | Status | Notes                                   |
/// |----------|--------|-----------------------------------------|
/// | Reader   | impl   | In-memory byte image (`[cursor, ...]`)  |
/// | File     | impl   | `std::host::fs` read-only whole-file image |
pub trait Read {
    fn read(self: Self, max_bytes: i32) -> Result<Vec<i32>, IoError>
}

/// Byte sink (ADR-085).
///
/// `write` appends `data` and returns the accepted byte count. `flush` is the
/// sink's commitment boundary; the memory `Writer` has nothing to flush.
///
/// ## Protocol catalog: `Write`
///
/// | Type     | Status | Notes                                   |
/// |----------|--------|-----------------------------------------|
/// | Writer   | impl   | In-memory byte image (`[fd_tag=0, ...]`) |
/// | File     | impl   | `std::host::fs` whole-file write image; `flush` commits to the path |
pub trait Write {
    fn write(self: Self, data: Vec<i32>) -> Result<i32, IoError>
    fn flush(self: Self) -> Result<(), IoError>
}

/// Buffered byte source layered over `Read` (ADR-085).
///
/// `fill_buf` returns an owned snapshot of the unconsumed bytes because the
/// language has no lifetime-carrying borrow view. `consume` advances past at
/// most that snapshot. `read_line` excludes the newline and returns `None`
/// only at EOF, so an empty line stays distinguishable from EOF.
pub trait BufRead: Read {
    fn fill_buf(self: Self) -> Result<Vec<i32>, IoError>
    fn consume(self: Self, amount: i32) -> Result<(), IoError>
    fn read_line(self: Self) -> Result<Option<String>, IoError>
}

/// Random access over a byte stream (ADR-085).
///
/// `seek` takes a `SeekFrom` origin and returns the new absolute position.
/// A negative effective position, or one above the i32 cursor range, is
/// `IoError::Other`. `position` reports the current cursor.
pub trait Seek {
    fn seek(self: Self, from: SeekFrom) -> Result<i64, IoError>
    fn position(self: Self) -> Result<i64, IoError>
}

// ─── Memory Reader / Writer newtypes (ADR-085 Phase A) ──────────────────────
/// In-memory read handle over an owned byte image.
///
/// The byte image and cursor are private. Use `Reader::from_bytes` to wrap a
/// raw `Vec<i32>` and `into_bytes` to recover the image. Handles are not
/// `Copy`, so moving one into an adapter transfers ownership.
pub struct Reader {
    bytes: Vec<i32>,
    cursor: i32,
}

impl Reader {
    /// Creates a reader positioned at the start of `data`.
    fn from_bytes(data: Vec<i32>) -> Reader {
        Reader {
            bytes: data,
            cursor: 0,
        }
    }

    /// Creates an empty reader positioned at EOF.
    fn new() -> Reader {
        Reader {
            bytes: Vec::new<i32>(),
            cursor: 0,
        }
    }

    /// Returns the total byte count, independent of the cursor.
    fn len(self: Reader) -> i32 {
        len(self.bytes)
    }

    /// Returns true when the cursor is at or past the end of the image.
    fn is_eof(self: Reader) -> bool {
        self.cursor >= len(self.bytes)
    }

    /// Returns the full byte image, independent of the cursor.
    fn into_bytes(self: Reader) -> Vec<i32> {
        self.bytes
    }
}

impl Read for Reader {
    fn read(mut self: Reader, max_bytes: i32) -> Result<Vec<i32>, IoError> {
        if max_bytes < 0 {
            return Err(IoError::Other("read: max_bytes must be non-negative"))
        }
        let total: i32 = len(self.bytes)
        let available: i32 = if self.cursor < total { total - self.cursor } else { 0 }
        let count: i32 = if max_bytes < available { max_bytes } else { available }
        let mut out: Vec<i32> = Vec::new<i32>()
        let mut i: i32 = 0
        while i < count {
            push(out, get_unchecked(self.bytes, self.cursor + i))
            i = i + 1
        }
        self.cursor = self.cursor + count
        Ok(out)
    }
}

impl BufRead for Reader {
    fn fill_buf(self: Reader) -> Result<Vec<i32>, IoError> {
        let total: i32 = len(self.bytes)
        let mut out: Vec<i32> = Vec::new<i32>()
        let mut i: i32 = self.cursor
        while i < total {
            push(out, get_unchecked(self.bytes, i))
            i = i + 1
        }
        Ok(out)
    }

    fn consume(mut self: Reader, amount: i32) -> Result<(), IoError> {
        if amount < 0 {
            return Err(IoError::Other("consume: amount must be non-negative"))
        }
        let total: i32 = len(self.bytes)
        let available: i32 = if self.cursor < total { total - self.cursor } else { 0 }
        if amount > available {
            return Err(IoError::Other("consume: amount exceeds buffered bytes"))
        }
        self.cursor = self.cursor + amount
        Ok(())
    }

    fn read_line(mut self: Reader) -> Result<Option<String>, IoError> {
        if self.cursor >= len(self.bytes) {
            return Ok(Option::None)
        }
        let total: i32 = len(self.bytes)
        let mut line: String = ""
        let mut pos: i32 = self.cursor
        let mut found_newline: bool = false
        while pos < total && !found_newline {
            let byte: i32 = get_unchecked(self.bytes, pos)
            pos = pos + 1
            if byte == NEWLINE_BYTE {
                found_newline = true
            } else {
                line = __intrinsic_concat(line, char_to_string(byte))
            }
        }
        self.cursor = pos
        Ok(Option::Some(line))
    }
}

impl Seek for Reader {
    fn seek(mut self: Reader, from: SeekFrom) -> Result<i64, IoError> {
        let target: i64 = match from {
            SeekFrom::Start(offset) => offset,
            SeekFrom::Current(offset) => (self.cursor).into() + offset,
            SeekFrom::End(offset) => (len(self.bytes)).into() + offset,
        }
        if target < 0i64 {
            return Err(IoError::Other("seek: negative position"))
        }
        if target > (MAX_CURSOR_POSITION).into() {
            return Err(IoError::Other("seek: position exceeds i32 range"))
        }
        self.cursor = (target).to_i32_wrapping()
        Ok(target)
    }

    fn position(self: Reader) -> Result<i64, IoError> {
        Ok((self.cursor).into())
    }
}

/// In-memory write handle over an owned byte image.
///
/// The image is private; `into_bytes` recovers it and `into_reader` reopens it
/// as a cursor-0 `Reader`. Handles are not `Copy`.
pub struct Writer {
    bytes: Vec<i32>,
}

impl Writer {
    /// Creates an empty writer.
    fn new() -> Writer {
        Writer {
            bytes: Vec::new<i32>(),
        }
    }

    /// Returns the buffered byte image.
    fn into_bytes(self: Writer) -> Vec<i32> {
        self.bytes
    }

    /// Converts the buffered bytes into a cursor-0 reader.
    fn into_reader(self: Writer) -> Reader {
        Reader::from_bytes(self.bytes)
    }

    /// Writes `text` as UTF-8 bytes and returns the accepted byte count.
    fn write_string(mut self: Writer, text: String) -> Result<i32, IoError> {
        self.write(text.to_utf8_bytes())
    }
}

impl Write for Writer {
    fn write(mut self: Writer, data: Vec<i32>) -> Result<i32, IoError> {
        let count: i32 = len(data)
        let mut i: i32 = 0
        while i < count {
            push(self.bytes, get_unchecked(data, i) & BYTE_MASK)
            i = i + 1
        }
        Ok(count)
    }

    fn flush(self: Writer) -> Result<(), IoError> {
        Ok(())
    }
}

// ─── Typed stdio handles (ADR-085 D9) ────────────────────────────────────────
/// Typed standard-output handle.
///
/// `write(Vec<i32>)` emits the byte image unchanged and returns its exact
/// length; `write_string(text)` emits UTF-8 bytes. Writes reach the host
/// synchronously, so `flush` is a no-op. This is the byte-faithful replacement
/// for the tagged `stdout()` compatibility vector.
pub struct Stdout {}

impl Stdout {
    /// Creates a standard-output handle.
    fn new() -> Stdout {
        Stdout {}
    }

    /// Writes `text` as UTF-8 bytes and returns the byte count.
    fn write_string(self: Stdout, text: String) -> Result<i32, IoError> {
        let count: i32 = len(text)
        __intrinsic_print(text)
        Ok(count)
    }
}

impl Write for Stdout {
    fn write(self: Stdout, data: Vec<i32>) -> Result<i32, IoError> {
        let count: i32 = len(data)
        __intrinsic_print(__intrinsic_string_from_bytes(data))
        Ok(count)
    }

    fn flush(self: Stdout) -> Result<(), IoError> {
        Ok(())
    }
}

/// Typed standard-error handle.
///
/// `write(Vec<i32>)` emits the byte image unchanged and never appends a
/// newline; `write_string(text)` emits UTF-8 bytes. Writes reach the host
/// synchronously, so `flush` is a no-op. This is the byte-faithful replacement
/// for the tagged `stderr()` compatibility vector.
pub struct Stderr {}

impl Stderr {
    /// Creates a standard-error handle.
    fn new() -> Stderr {
        Stderr {}
    }

    /// Writes `text` as UTF-8 bytes and returns the byte count.
    fn write_string(self: Stderr, text: String) -> Result<i32, IoError> {
        let count: i32 = len(text)
        __intrinsic_eprint(text)
        Ok(count)
    }
}

impl Write for Stderr {
    fn write(self: Stderr, data: Vec<i32>) -> Result<i32, IoError> {
        let count: i32 = len(data)
        __intrinsic_eprint(__intrinsic_string_from_bytes(data))
        Ok(count)
    }

    fn flush(self: Stderr) -> Result<(), IoError> {
        Ok(())
    }
}

// ─── Generic algorithms (ADR-085 Phase B) ────────────────────────────────────
/// Namespace for receiver-less generic algorithms over `Read` and `Write`.
///
/// ADR-046 forbids user-reachable free functions, and the language cannot put
/// associated functions in a module namespace, so the algorithms live on this
/// empty type and are called as `Io::copy(reader, writer)`.
pub struct Io {}

impl Io {
    /// Copies every remaining byte from `from` to `to` in bounded chunks.
    ///
    /// Returns the transferred byte count. A read error, a write error, or a
    /// writer that accepts zero bytes aborts the copy and returns the error;
    /// the partial count is never reported as success.
    fn copy<R: Read, W: Write>(mut from: R, mut to: W) -> Result<i64, IoError> {
        let mut total: i64 = 0i64
        let mut done: bool = false
        while !done {
            let read_result: Result<Vec<i32>, IoError> = from.read(COPY_CHUNK_BYTES)
            let chunk: Vec<i32> = match read_result {
                Result::Ok(bytes) => bytes,
                Result::Err(err) => return Err(err),
            }
            if len(chunk) == 0 {
                done = true
            } else {
                let write_result: Result<(), IoError> = Io::write_all(to, chunk)
                match write_result {
                    Result::Ok(_) => total = total + (len(chunk)).into(),
                    Result::Err(err) => return Err(err),
                }
            }
        }
        Ok(total)
    }

    /// Reads exactly `amount` bytes or fails with `UnexpectedEof`.
    ///
    /// A negative `amount` is `IoError::Other`. The source is asked for at
    /// most the number of bytes still missing, so the handle is not advanced
    /// past the requested range.
    fn read_exact<R: Read>(mut from: R, amount: i32) -> Result<Vec<i32>, IoError> {
        if amount < 0 {
            return Err(IoError::Other("read_exact: amount must be non-negative"))
        }
        let mut out: Vec<i32> = Vec::new<i32>()
        let mut remaining: i32 = amount
        while remaining > 0 {
            let read_result: Result<Vec<i32>, IoError> = from.read(remaining)
            let chunk: Vec<i32> = match read_result {
                Result::Ok(bytes) => bytes,
                Result::Err(err) => return Err(err),
            }
            if len(chunk) == 0 {
                let needed: String = amount.to_string()
                let have: String = len(out).to_string()
                let message: String = "need ".concat(needed.concat(" have ".concat(have)))
                return Err(IoError::UnexpectedEof(message))
            }
            if len(chunk) > remaining {
                return Err(IoError::Other("read_exact: source returned more than requested"))
            }
            let mut i: i32 = 0
            while i < len(chunk) {
                push(out, get_unchecked(chunk, i))
                i = i + 1
            }
            remaining = remaining - len(chunk)
        }
        Ok(out)
    }

    /// Reads every byte from `from` until EOF and returns them.
    fn read_to_end<R: Read>(mut from: R) -> Result<Vec<i32>, IoError> {
        let mut out: Vec<i32> = Vec::new<i32>()
        let mut done: bool = false
        while !done {
            let read_result: Result<Vec<i32>, IoError> = from.read(COPY_CHUNK_BYTES)
            let chunk: Vec<i32> = match read_result {
                Result::Ok(bytes) => bytes,
                Result::Err(err) => return Err(err),
            }
            if len(chunk) == 0 {
                done = true
            } else {
                let mut i: i32 = 0
                while i < len(chunk) {
                    push(out, get_unchecked(chunk, i))
                    i = i + 1
                }
            }
        }
        Ok(out)
    }

    /// Writes all of `data`, retrying when the sink accepts only a prefix.
    ///
    /// A sink that accepts zero bytes for a non-empty chunk would loop forever,
    /// so that case is reported as `IoError::Other`.
    fn write_all<W: Write>(mut to: W, data: Vec<i32>) -> Result<(), IoError> {
        let total: i32 = len(data)
        let mut offset: i32 = 0
        while offset < total {
            let mut rest: Vec<i32> = Vec::new<i32>()
            let mut i: i32 = offset
            while i < total {
                push(rest, get_unchecked(data, i))
                i = i + 1
            }
            let write_result: Result<i32, IoError> = to.write(rest)
            let accepted: i32 = match write_result {
                Result::Ok(count) => count,
                Result::Err(err) => return Err(err),
            }
            if accepted <= 0 {
                return Err(IoError::Other("write_all: writer accepted no bytes"))
            }
            if accepted > total - offset {
                return Err(IoError::Other("write_all: writer accepted more bytes than supplied"))
            }
            offset = offset + accepted
        }
        Ok(())
    }

    /// Reads until EOF and decodes the bytes as UTF-8.
    ///
    /// Invalid UTF-8 is `IoError::Other`; unlike `text::from_utf8`, this
    /// convenience does not replace invalid sequences silently.
    fn read_to_string<R: Read>(mut from: R) -> Result<String, IoError> {
        let read_result: Result<Vec<i32>, IoError> = Io::read_to_end(from)
        let bytes: Vec<i32> = match read_result {
            Result::Ok(data) => data,
            Result::Err(err) => return Err(err),
        }
        match String::try_from_utf8(bytes) {
            Option::Some(decoded) => Ok(decoded),
            Option::None => Err(IoError::Other("read_to_string: input is not valid UTF-8")),
        }
    }
}

// ─── Generic buffered adapters (ADR-085 Phase C) ────────────────────────────
// A non-positive capacity is normalised to one byte rather than rejecting the
// constructor: an adapter with a zero-length fill would never make progress.
const MIN_BUFFER_CAPACITY: i32 = 1

/// Buffered byte source layered over a `Read` handle.
///
/// The adapter owns `inner` (handles are not `Copy`) and an owned buffer. Reads
/// are served from the buffer; `fill_buf` returns an owned snapshot because the
/// language has no lifetime-carrying borrow view. `Seek` is implemented only
/// when the inner handle is `Seek`.
pub struct BufReader<R> {
    inner: R,
    buffer: Vec<i32>,
    start: i32,
    end: i32,
    capacity: i32,
}

impl<R: Read> BufReader<R> {
    /// Wraps `inner` with a buffer of `capacity` bytes (at least one).
    fn new(inner: R, capacity: i32) -> BufReader<R> {
        let cap: i32 = if capacity > 0 { capacity } else { MIN_BUFFER_CAPACITY }
        BufReader {
            inner: inner,
            buffer: Vec::new<i32>(),
            start: 0,
            end: 0,
            capacity: cap,
        }
    }

    fn buffered(self: BufReader<R>) -> i32 {
        self.end - self.start
    }

    // Refill only when the buffer has no unread bytes; keeping a partially
    // consumed buffer preserves the bytes that a following read must see.
    fn refill(mut self: BufReader<R>) -> Result<(), IoError> {
        if self.buffered() > 0 {
            return Ok(())
        }
        self.start = 0
        self.end = 0
        let read_result: Result<Vec<i32>, IoError> = self.inner.read(self.capacity)
        let chunk: Vec<i32> = match read_result {
            Result::Ok(bytes) => bytes,
            Result::Err(err) => return Err(err),
        }
        self.buffer = chunk
        self.end = len(self.buffer)
        Ok(())
    }
}

impl<R: Read> Read for BufReader<R> {
    fn read(mut self: BufReader<R>, max_bytes: i32) -> Result<Vec<i32>, IoError> {
        if max_bytes < 0 {
            return Err(IoError::Other("read: max_bytes must be non-negative"))
        }
        let mut out: Vec<i32> = Vec::new<i32>()
        while len(out) < max_bytes {
            if self.buffered() == 0 {
                match self.refill() {
                    Result::Ok(_) => {
                    },
                    Result::Err(err) => return Err(err),
                }
                if self.buffered() == 0 {
                    break
                }
            }
            let available: i32 = self.buffered()
            let wanted: i32 = max_bytes - len(out)
            let take: i32 = if wanted < available { wanted } else { available }
            let mut i: i32 = 0
            while i < take {
                push(out, get_unchecked(self.buffer, self.start + i))
                i = i + 1
            }
            self.start = self.start + take
        }
        Ok(out)
    }
}

impl<R: Read> BufRead for BufReader<R> {
    fn fill_buf(mut self: BufReader<R>) -> Result<Vec<i32>, IoError> {
        if self.buffered() == 0 {
            match self.refill() {
                Result::Ok(_) => {
                },
                Result::Err(err) => return Err(err),
            }
        }
        let mut out: Vec<i32> = Vec::new<i32>()
        let mut i: i32 = self.start
        while i < self.end {
            push(out, get_unchecked(self.buffer, i))
            i = i + 1
        }
        Ok(out)
    }

    fn consume(mut self: BufReader<R>, amount: i32) -> Result<(), IoError> {
        if amount < 0 {
            return Err(IoError::Other("consume: amount must be non-negative"))
        }
        if amount > self.buffered() {
            return Err(IoError::Other("consume: amount exceeds buffered bytes"))
        }
        self.start = self.start + amount
        Ok(())
    }

    fn read_line(mut self: BufReader<R>) -> Result<Option<String>, IoError> {
        let line: String = ""
        let mut consumed_any: bool = false
        let mut found_newline: bool = false
        while !found_newline {
            if self.buffered() == 0 {
                match self.refill() {
                    Result::Ok(_) => {
                    },
                    Result::Err(err) => return Err(err),
                }
                if self.buffered() == 0 {
                    break
                }
            }
            let mut pos: i32 = self.start
            while pos < self.end && !found_newline {
                let byte: i32 = get_unchecked(self.buffer, pos)
                pos = pos + 1
                if byte == NEWLINE_BYTE {
                    found_newline = true
                } else {
                    line = line.concat(char_to_string(byte))
                }
            }
            if pos > self.start {
                consumed_any = true
            }
            self.start = pos
        }
        if !consumed_any {
            return Ok(Option::None)
        }
        Ok(Option::Some(line))
    }
}

impl<R: Seek> Seek for BufReader<R> {
    fn seek(mut self: BufReader<R>, from: SeekFrom) -> Result<i64, IoError> {
        let unread: i32 = self.end - self.start
        let result: Result<i64, IoError> = match from {
            SeekFrom::Start(offset) => self.inner.seek(SeekFrom::Start(offset)),
            SeekFrom::End(offset) => self.inner.seek(SeekFrom::End(offset)),
            SeekFrom::Current(offset) => {
                let position_result: Result<i64, IoError> = self.inner.position()
                match position_result {
                    Result::Ok(pos) => self.inner.seek(SeekFrom::Start(pos - (unread).into() + offset)),
                    Result::Err(err) => Err(err),
                }
            },
        }
        let position: i64 = match result {
            Result::Ok(pos) => pos,
            Result::Err(err) => return Err(err),
        }
        self.buffer = Vec::new<i32>()
        self.start = 0
        self.end = 0
        Ok(position)
    }

    fn position(self: BufReader<R>) -> Result<i64, IoError> {
        let unread: i32 = self.end - self.start
        let position_result: Result<i64, IoError> = self.inner.position()
        match position_result {
            Result::Ok(pos) => Ok(pos - (unread).into()),
            Result::Err(err) => Err(err),
        }
    }
}

/// Buffered byte sink layered over a `Write` handle.
///
/// Writes are appended to an owned buffer and flushed when the buffer reaches
/// the configured capacity (or after every write when the capacity is
/// non-positive). `into_inner` flushes before returning the owned handle.
pub struct BufWriter<W> {
    inner: W,
    buffer: Vec<i32>,
    capacity: i32,
}

impl<W: Write> BufWriter<W> {
    /// Wraps `inner` with a buffer that flushes at `capacity` bytes.
    fn new(inner: W, capacity: i32) -> BufWriter<W> {
        let cap: i32 = if capacity > 0 { capacity } else { 0 }
        BufWriter {
            inner: inner,
            buffer: Vec::new<i32>(),
            capacity: cap,
        }
    }

    /// Writes `text` as UTF-8 bytes through the buffer.
    fn write_string(mut self: BufWriter<W>, text: String) -> Result<i32, IoError> {
        self.append(text.to_utf8_bytes())
    }

    /// Flushes the buffer and returns the owned inner handle.
    fn into_inner(mut self: BufWriter<W>) -> Result<W, IoError> {
        match self.flush_buffer() {
            Result::Ok(_) => Ok(self.inner),
            Result::Err(err) => Err(err),
        }
    }

    // Appends first and then applies the capacity policy. `write_string` and
    // the trait `write` share this so the accepted count and the auto-flush
    // threshold cannot drift apart.
    fn append(mut self: BufWriter<W>, data: Vec<i32>) -> Result<i32, IoError> {
        let count: i32 = len(data)
        let mut i: i32 = 0
        while i < count {
            push(self.buffer, get_unchecked(data, i) & BYTE_MASK)
            i = i + 1
        }
        if self.capacity <= 0 || len(self.buffer) >= self.capacity {
            match self.flush_buffer() {
                Result::Ok(_) => {
                },
                Result::Err(err) => return Err(err),
            }
        }
        Ok(count)
    }

    // Shared by the trait flush, the capacity-triggered flush in `append`, and
    // `into_inner`; keeping one copy makes the "clear only on success" rule
    // hold at every call site.
    fn flush_buffer(mut self: BufWriter<W>) -> Result<(), IoError> {
        if len(self.buffer) == 0 {
            return Ok(())
        }
        let write_result: Result<(), IoError> = Io::write_all(self.inner, self.buffer)
        match write_result {
            Result::Ok(_) => {
                self.buffer = Vec::new<i32>()
                Ok(())
            },
            Result::Err(err) => Err(err),
        }
    }
}

impl<W: Write> Write for BufWriter<W> {
    fn write(mut self: BufWriter<W>, data: Vec<i32>) -> Result<i32, IoError> {
        self.append(data)
    }

    fn flush(mut self: BufWriter<W>) -> Result<(), IoError> {
        self.flush_buffer()
    }
}

// ─── Standard I/O (stdin / stdout / stderr) ──────────────────────────────────
/// Returns a Reader representing stdin.
///
/// NOTE: WASI stdin reading is not available in the current runtime.
/// The returned Reader is always empty. Use `read_stdin_line()` for a
/// future-compatible placeholder.
pub fn stdin() -> Vec<i32> {
    let mut r: Vec<i32> = Vec::new<i32>()
    push(r, 0)
    r
}

/// Returns the tagged stdout compatibility handle.
///
/// The vector carries the tag only; it has no byte-faithful write path of its
/// own. Use `Stdout::new()` when the bytes must reach the host unchanged.
pub fn stdout() -> Vec<i32> {
    let mut w: Vec<i32> = Vec::new<i32>()
    push(w, 1)
    w
}

/// Returns the tagged stderr compatibility handle.
///
/// The vector carries the tag only; it has no byte-faithful write path of its
/// own. Use `Stderr::new()` when the bytes must reach the host unchanged and
/// without an appended newline.
pub fn stderr() -> Vec<i32> {
    let mut w: Vec<i32> = Vec::new<i32>()
    push(w, 2)
    w
}

/// Reads a line from stdin.
///
/// NOTE: WASI stdin reading is not available in the current runtime.
/// Always returns `Ok("")`.
pub fn read_stdin_line() -> Result<String, IoError> {
    Ok("")
}

/// Prints a byte buffer directly to stdout (no trailing newline).
pub fn print_bytes(data: Vec<i32>) {
    let n: i32 = len(data)
    let mut s: String = ""
    let mut i: i32 = 0
    while i < n {
        s = __intrinsic_concat(s, char_to_string(get_unchecked(data, i) & 255))
        i = i + 1
    }
    __intrinsic_print(s)
}
