//! Pure string-based path manipulation helpers.
//!
//! Paths are represented as `String` values and always use `/` as the
//! separator to match POSIX and WASI conventions.
//!
//! The canonical surface is the `Path` receiver type: wrap a path string with
//! `Path::new`, then call `join`, `normalize`, `parent`, `stem`, `extension`,
//! `with_extension`, `file_name`, `is_absolute`, or `components`. These
//! operations work on plain strings without host I/O.
//!
//! **Availability:** All targets (`wasm32` + `wasm32-gc`). No host capability required.

use std::text

/// Joins two path segments with a single `/` separator.
fn path_join(base: String, child: String) -> String {
    if base.is_empty() {
        "".concat(child)
    } else {
        if child.is_empty() {
            "".concat(base)
        } else {
            let base_len = len(base)
            let last_char = base.slice(base_len - 1, base_len)
            if last_char.eq("/") {
                base.concat(child)
            } else {
                base.concat("/").concat(child)
            }
        }
    }
}

/// Returns the final path segment after the last `/`.
fn path_file_name(p: String) -> String {
    let idx = last_index_of(p, "/")
    if idx < 0 {
        "".concat(p)
    } else {
        p.slice(idx + 1, len(p))
    }
}

/// Returns the extension without the leading `.`.
fn path_extension(p: String) -> String {
    let name = path_file_name(p)
    let idx = last_index_of(name, ".")
    if idx <= 0 {
        ""
    } else {
        name.slice(idx + 1, len(name))
    }
}

/// Replaces the current extension, or appends one when missing.
fn path_with_extension(p: String, ext: String) -> String {
    let dot_idx = last_index_of(p, ".")
    let slash_idx = last_index_of(p, "/")
    if dot_idx > slash_idx {
        let base = p.slice(0, dot_idx)
        if ext.is_empty() {
            base
        } else {
            base.concat(".").concat(ext)
        }
    } else {
        if ext.is_empty() {
            "".concat(p)
        } else {
            p.concat(".").concat(ext)
        }
    }
}

/// Returns true when the path starts with `/`.
fn path_is_absolute(p: String) -> bool {
    if p.is_empty() {
        false
    } else {
        p.slice(0, 1).eq("/")
    }
}

/// Returns the parent directory path, or an empty string at the root.
fn path_parent(p: String) -> String {
    let idx = last_index_of(p, "/")
    if idx <= 0 {
        ""
    } else {
        p.slice(0, idx)
    }
}

/// Returns the file stem (the file name without the final extension).
///
/// Examples:
/// stem("hello.txt")    -> "hello"
/// stem("foo.tar.gz")   -> "foo.tar"
/// stem("noext")        -> "noext"
/// stem(".hidden")      -> ".hidden"   (leading dot is not an extension)
fn path_stem(p: String) -> String {
    let name = path_file_name(p)
    let dot_idx = last_index_of(name, ".")
    if dot_idx <= 0 {
        name
    } else {
        name.slice(0, dot_idx)
    }
}

/// Resolves `.` and `..` components and collapses redundant `/` separators.
///
/// Examples:
/// normalize("/foo/./bar/../baz")  -> "/foo/baz"
/// normalize("a/b/../c")          -> "a/c"
/// normalize("/foo//bar")         -> "/foo/bar"
fn path_normalize(p: String) -> String {
    let parts: Vec<String> = __intrinsic_split(p, "/")
    let mut out: Vec<String> = Vec::new<String>()
    let n = len(parts)
    let mut i = 0
    while i < n {
        let part = get_unchecked(parts, i)
        if part.eq(".") || part.is_empty() {
        } else {
            if part.eq("..") {
                if len(out) > 0 {
                    let _ = pop(out)
                }
            } else {
                push(out, part)
            }
        }
        i = i + 1
    }
    let joined = __intrinsic_join(out, "/")
    if path_is_absolute(p) {
        "/".concat(joined)
    } else {
        joined
    }
}

/// Returns the non-empty path segments split by `/`.
///
/// Examples:
/// components("/usr/local/bin")  -> ["usr", "local", "bin"]
/// components("a/b/c")          -> ["a", "b", "c"]
/// components("")               -> []
fn path_components(p: String) -> Vec<String> {
    let raw: Vec<String> = __intrinsic_split(p, "/")
    let mut out: Vec<String> = Vec::new<String>()
    let n = len(raw)
    let mut i = 0
    while i < n {
        let part = get_unchecked(raw, i)
        if !part.is_empty() {
            push(out, part)
        }
        i = i + 1
    }
    out
}

/// A path string with the path-manipulation methods attached.
///
/// The wrapper keeps the receiver form explicit without changing the
/// underlying representation: paths remain plain `String` values and use `/`
/// as the separator.
pub struct Path {
    value: String,
}

impl Path {
    /// Wraps a path string.
    fn new(value: String) -> Path {
        Path { value: value }
    }

    /// Returns the wrapped path string.
    fn into_string(self: Path) -> String {
        self.value
    }

    /// Joins this path with `child` using a single `/` separator.
    fn join(self: Path, child: String) -> String {
        path_join(self.value, child)
    }

    /// Returns the final path segment after the last `/`.
    fn file_name(self: Path) -> String {
        path_file_name(self.value)
    }

    /// Returns the extension without the leading `.`.
    fn extension(self: Path) -> String {
        path_extension(self.value)
    }

    /// Replaces the current extension, or appends one when missing.
    fn with_extension(self: Path, ext: String) -> String {
        path_with_extension(self.value, ext)
    }

    /// Returns true when the path starts with `/`.
    fn is_absolute(self: Path) -> bool {
        path_is_absolute(self.value)
    }

    /// Returns the parent directory path, or an empty string at the root.
    fn parent(self: Path) -> String {
        path_parent(self.value)
    }

    /// Returns the file stem (the file name without the final extension).
    fn stem(self: Path) -> String {
        path_stem(self.value)
    }

    /// Resolves `.` and `..` components and collapses redundant `/` separators.
    fn normalize(self: Path) -> String {
        path_normalize(self.value)
    }

    /// Returns the non-empty path segments split by `/`.
    fn components(self: Path) -> Vec<String> {
        path_components(self.value)
    }
}

fn last_index_of(s: String, needle: String) -> i32 {
    let n = len(s)
    let nlen = len(needle)
    if nlen > n {
        0 - 1
    } else {
        if nlen == 0 {
            n
        } else {
            let nc = needle.byte_at(0)
            let mut result = 0 - 1
            let mut i = n - 1
            while i >= 0 {
                if s.byte_at(i) == nc {
                    if nlen == 1 {
                        result = i
                        i = 0 - 1
                    } else {
                        let sub = s.slice(i, i + nlen)
                        if sub.eq(needle) {
                            result = i
                            i = 0 - 1
                        } else {
                            i = i - 1
                        }
                    }
                } else {
                    i = i - 1
                }
            }
            result
        }
    }
}
