// =============================================================================
// Arukellt Standard Prelude
// =============================================================================
//
// v2 policy (ADR-072): the resolver auto-imports only the tiny stable set
// recorded in std/manifest.toml [prelude_policy]. This file declares that
// stable set and the remaining explicit-import prelude entries. ADR-091
// retired the 27 method-replaceable prelude frees (`trim`, `split`, `abs`,
// `values`, ...); their bare calls fail with E0100 and a receiver
// hint, and `assert` / `String_from` / `String_new` / `char_to_string` are the
// only retained stable-free exception. The resolver keeps the stable-name list
// in src/compiler/resolver/prelude_stable.ark, which
// scripts/check/check-compat-orphans.py holds in sync with the manifest.
//
// Compilation: RFC-005 / #816 restores prelude decls to the backend combine
// path. CoreOp-bound symbols and intrinsic shims defer MIR body lowering until
// #821/#822 (see mir/lower/stdlib_body_defer.ark). Pure Ark helpers such as
// `assert` are lowered now.
//
// ## Tiny Prelude (the v2 stable set — the only auto-imported declarations)
//
//   Types / compiler builtins (handled by ark-typecheck, not listed here):
//     Option, Result, String, Vec
//     Some, None, Ok, Err
//     (true / false are lexical literals, not prelude values)
//
//   Functions provided by THIS file:
//     assert
//     Std::panic  (associated control operation)
//     String_from, String_new
//     char_to_string  (essential conversion)
//
// Vec / String collection operations are receiver methods only. Private
// generic declarations below stay as signature anchors for the checker; they
// are not auto-imported and bare calls fail with E0100 hints.
//
// ## Legacy / explicit-import section
//
// Declarations outside the tiny set (Box, Slice, …) are callable only with an
// explicit `use std::prelude::{name}`.
//
// The stable monomorphic seq/combinator frees (`map_i32_i32`, `sort_i32`, …)
// were deleted in the ADR-087 Wave 2 (#703 / #917). Bare calls now fail with
// E0100 plus a `resolver::removed_names` migration hint. The replacements are
// the Vec / iterator methods: `v.sort_by(cmp)`, `v.iter().map(f).collect()`,
// `v.iter().filter(f).collect()`, `v.iter().fold(init, f)`, `v.iter().sum()`,
// `v.iter().any(f)`, `v.iter().find(f)`, `v.iter().contains(x)`,
// `v.iter().rev().collect()`, and `v.drain(i, i + 1)`; Option::map lives in
// `std::core::container`. The provisional `filter_i32` retired on 2026-10-30
// (`v.iter().filter(f).collect()`); bare calls fail E0100. Vec constructors
// (`Vec_new_*`) were removed in #845; use `Vec::new<T>()`.
//
// Design ADR:    docs/adr/ADR-036-trait-stdlib-redesign.md
// Prelude design: docs/stdlib/prelude.md
//
// =============================================================================
use std::collections::string
use std::core::clone
use std::core::eq
use std::core::scalar_format

// String construction
pub enum Box<T> {
    Owned(T),
}

impl<T> Box<T> {
    fn new(value: T) -> Box<T> {
        Box::Owned(value)
    }

    fn take(self: Box<T>) -> T {
        match self {
            Box::Owned(value) => value,
        }
    }
}

pub enum Slice<T> {
    View(Vec<T>, i32, i32),
}

pub fn String_from(s: String) -> String {
    return s
}

pub fn String_new() -> String {
    Std::panic(String_new()); return String_new()
}

// String operations
//
// `.clone()` is the canonical surface (ADR-091). The declaration stays private
// and non-importable: the typechecker and MIR use its signature as the
// polymorphic identity fallback for receivers without a `Clone` impl, while a
// bare `clone(x)` call is retired and diagnosed as E0100.
//
// The body must stay `value`. Monomorphising this shim is what keeps the
// bootstrap and stage-2/3 lowering of `.clone()` on structs, enums, and
// `Option` identical while the committed pin predates polymorphic method
// resolution.
fn clone<T>(value: T) -> T {
    value
}

// The deep `impl<T> Clone for Vec<T>` lives in `std::core::clone`, imported
// above, so `.clone()` on a Vec allocates independent element storage without a
// per-module import. Element types without a `Clone` impl still take the
// compiler's identity copy (only the Vec storage is independent). The flat
// bootstrap overlay adds a shallow inherent method for the pin, whose cache
// mis-resolves the bare callee (#928); that bridge is not part of user-facing
// semantics. See `_patch_bootstrap_prelude_vector_clone_shallow_text`.

// `slice` / `substring` were retired under ADR-091; use `s.slice(start, end)`.
// Conversion: to string
// Deprecated prelude free functions (i32_to_string, i64_to_string,
// f64_to_string, bool_to_string) have been removed per ADR-036.
// Use inherent method `x.to_string()` instead.

pub fn char_to_string(c: char) -> String {
    __core_char_to_string_impl(c)
}

// Numeric conversion frees (`u8_to_i32`, `f64_bits_lo`, ...) were retired
// under ADR-046 / ADR-067. The receiver methods in `std::core::convert`
// (`u8::to_i32`, `i32::to_u8_wrapping`, `f64::to_bits_lo`, ...) are the
// canonical surface and lower through the `__intrinsic_*` bridges directly.
// Parsing uses `TryFrom<String>` (`i32::try_from(s)`) from that module.
fn __core_math_abs_impl(x: i32) -> i32 {
    if x < 0 {
        0 - x
    } else {
        x
    }
}

fn __core_math_min_impl(a: i32, b: i32) -> i32 {
    if a < b {
        a
    } else {
        b
    }
}

fn __core_math_max_impl(a: i32, b: i32) -> i32 {
    if a > b {
        a
    } else {
        b
    }
}

// Math: clamp (i32)
fn __core_math_clamp_impl(x: i32, lo: i32, hi: i32) -> i32 {
    if x < lo {
        lo
    } else if x > hi {
        hi
    } else {
        x
    }
}

// Control
/// Namespace for unrecoverable process control.
///
/// `Std` is never constructed; it exists so control operations have an
/// associated-function spelling instead of a user-reachable free function
/// (ADR-046). The private field keeps the generated component type non-empty.
pub struct Std {
    reserved: i32,
}

impl Std {
    /// Aborts the program after writing `message` to stderr.
    ///
    /// Lowered by the `panic` CoreOp; the body is a typechecking shell.
    fn panic(message: String) {
        __intrinsic_panic(message)
    }
}

// Sealed declarations for the intrinsic bridges that std and the compiler call
// by name. Each name is registered as a resolver builtin and bound to a CoreOp
// alias, so MIR lowering defers the placeholder body and emits the intrinsic
// handler. The declaration is the call contract the typechecker unifies
// against; without it the call was typed by a name-keyed return table and its
// arguments were never checked (#936).
fn __intrinsic_string_from_bytes(_bytes: Vec<i32>) -> String {
    Std::panic(String_new())
    String_new()
}

fn __intrinsic_stdin_read_to_string() -> String {
    Std::panic(String_new())
    String_new()
}

fn __runtime_abi_fs_read_file(_path: String) -> Result<String, String> {
    Std::panic(String_new())
    Err(String_new())
}

fn __runtime_abi_fs_write_file(_path: String, _contents: String) -> Result<(), String> {
    Std::panic(String_new())
    Err(String_new())
}

fn __runtime_abi_fs_write_bytes(_path: String, _bytes: Vec<i32>) -> Result<(), String> {
    Std::panic(String_new())
    Err(String_new())
}

// Non-public HashMap storage bridge (`__hm_<key><value>_*`).
//
// These declarations are the call contract for the 5 key/value families × 12
// storage operations. The wasm HashMap handlers still select the storage
// operation from the callee spelling, so the self-call body lowers to that same
// bridge instead of recursing; the declaration exists so the checker unifies
// arguments against a real signature. The spelling set mirrors
// `src/compiler/resolver/builtins_hash.ark`, which stays the resolver
// authority: a name without a declaration here would fall back to the retired
// name-keyed return table (#936).

