// =============================================================================
// Legacy compatibility bodies. The remaining private `__core_*` functions are
// core-op fallbacks; their public prelude wrappers were deleted in the
// ADR-087 Wave 2. The vec intrinsic-compat frees and `filter_i32` retired on
// 2026-10-30; no public compatibility free remains.
// =============================================================================
// Core-op fallback for seq.sort_i32 (public wrapper deleted in ADR-087 Wave 2).
fn __core_seq_sort_i32_impl(mut v: Vec<i32>) {
    let mut index = 1
    while index < v.len() {
        let value = v.get_unchecked(index)
        let mut insertion = index
        while insertion > 0 && v.get_unchecked(insertion - 1) > value {
            v.set(insertion, v.get_unchecked(insertion - 1))
            insertion = insertion - 1
        }
        v.set(insertion, value)
        index = index + 1
    }
}
// Core-op fallback for seq.sort_i64 (public wrapper deleted in ADR-087 Wave 2).
fn __core_seq_sort_i64_impl(mut v: Vec<i64>) {
    let mut index = 1
    while index < v.len() {
        let value = v.get_unchecked(index)
        let mut insertion = index
        while insertion > 0 && v.get_unchecked(insertion - 1) > value {
            v.set(insertion, v.get_unchecked(insertion - 1))
            insertion = insertion - 1
        }
        v.set(insertion, value)
        index = index + 1
    }
}
// Core-op fallback for seq.sort_f64 (public wrapper deleted in ADR-087 Wave 2).
fn __core_seq_sort_f64_impl(mut v: Vec<f64>) {
    let mut index = 1
    while index < v.len() {
        let value = v.get_unchecked(index)
        let mut insertion = index
        while insertion > 0 && v.get_unchecked(insertion - 1) > value {
            v.set(insertion, v.get_unchecked(insertion - 1))
            insertion = insertion - 1
        }
        v.set(insertion, value)
        index = index + 1
    }
}
// Assertions
pub fn assert(cond: bool) {
    if !cond {
        Std::panic(String_from("assertion failed"))
    }
}

// Sealed-raw CoreOp aliases (no `use std::core::raw`) so bootstrap overlays
// that strip collections modules still resolve these fallback symbols (#822).
fn __core_vec_len_impl<T>(values: Vec<T>) -> i32 {
    raw_array_len(values)
}

fn __core_vec_is_empty_impl<T>(values: Vec<T>) -> bool {
    raw_array_len(values) == 0
}

fn __core_vec_get_unchecked_impl<T>(values: Vec<T>, index: i32) -> T {
    raw_array_get_unchecked(values, index)
}

fn __core_vec_set_impl<T>(mut values: Vec<T>, index: i32, value: T) {
    raw_array_set_unchecked(values, index, value)
}

fn __core_vec_get_unchecked_i64_impl(values: Vec<i64>, index: i32) -> i64 {
    raw_array_get_unchecked(values, index)
}

fn __core_vec_get_unchecked_f64_impl(values: Vec<f64>, index: i32) -> f64 {
    raw_array_get_unchecked(values, index)
}

// Generic `Vec<T>` push shells lower to `unreachable` on LM; keep concrete
// i32/i64/f64 bodies and rewrite String/stdlib sites to sealed grow+set (#822).
fn __core_vec_push_i32_impl(values: Vec<i32>, value: i32) {
    let n: i32 = raw_array_len(values)
    let mut grown: Vec<i32> = raw_array_grow(values, n + 1)
    raw_array_set_unchecked(grown, n, value)
}

fn __core_vec_push_i64_impl(values: Vec<i64>, value: i64) {
    let n: i32 = raw_array_len(values)
    let mut grown: Vec<i64> = raw_array_grow(values, n + 1)
    raw_array_set_unchecked(grown, n, value)
}

fn __core_vec_push_f64_impl(values: Vec<f64>, value: f64) {
    let n: i32 = raw_array_len(values)
    let mut grown: Vec<f64> = raw_array_grow(values, n + 1)
    raw_array_set_unchecked(grown, n, value)
}

fn __core_vec_get_impl(values: Vec<i32>, index: i32) -> Option<i32> {
    if index < 0 || index >= raw_array_len(values) {
        return None
    }
    Some(raw_array_get_unchecked(values, index))
}

fn __core_vec_pop_impl(values: Vec<i32>) -> Option<i32> {
    let n: i32 = raw_array_len(values)
    if n == 0 {
        return None
    }
    let idx: i32 = n - 1
    let value: i32 = raw_array_get_unchecked(values, idx)
    // Shrink logical length through grow (set_len dispatch still incomplete).
    let _shrunk: Vec<i32> = raw_array_grow(values, idx)
    Some(value)
}

fn __core_vec_new_fallback_impl(cap: i32) -> Vec<i32> {
    raw_array_new(cap)
}

fn __core_vec_new_f64_impl(cap: i32) -> Vec<f64> {
    raw_array_new(cap)
}

// Core-op fallbacks for vec.contains / vec.reverse / vec.remove. The public
// prelude wrappers were deleted in the ADR-087 Wave 2.
fn __core_vec_contains_i32_impl(v: Vec<i32>, x: i32) -> bool {
    let mut i: i32 = 0
    while i < raw_array_len(v) {
        if raw_array_get_unchecked(v, i) == x {
            return true
        }
        i = i + 1
    }
    false
}
fn __core_vec_reverse_i32_impl(mut v: Vec<i32>) {
    let n: i32 = raw_array_len(v)
    let mut lo: i32 = 0
    let mut hi: i32 = n - 1
    while lo < hi {
        let tmp: i32 = raw_array_get_unchecked(v, lo)
        raw_array_set_unchecked(v, lo, raw_array_get_unchecked(v, hi))
        raw_array_set_unchecked(v, hi, tmp)
        lo = lo + 1
        hi = hi - 1
    }
}
fn __core_vec_reverse_string_impl(mut v: Vec<String>) {
    let n: i32 = v.len()
    let mut lo: i32 = 0
    let mut hi: i32 = n - 1
    while lo < hi {
        let tmp: String = v.get_unchecked(lo)
        v.set(lo, v.get_unchecked(hi))
        v.set(hi, tmp)
        lo = lo + 1
        hi = hi - 1
    }
}
fn __core_vec_remove_i32_impl(mut v: Vec<i32>, index: i32) {
    let n: i32 = raw_array_len(v)
    let mut i: i32 = index
    while i < n - 1 {
        raw_array_set_unchecked(v, i, raw_array_get_unchecked(v, i + 1))
        i = i + 1
    }
    v.pop()
}
// Core-op fallbacks for seq.sum_i32 / seq.product_i32 (public wrappers deleted
// in the ADR-087 Wave 2).
fn __core_seq_sum_i32_impl(v: Vec<i32>) -> i32 {
    let mut total: i32 = 0
    let mut i: i32 = 0
    while i < v.len() {
        total = total + v.get_unchecked(i)
        i = i + 1
    }
    total
}
fn __core_seq_product_i32_impl(v: Vec<i32>) -> i32 {
    let mut total: i32 = 1
    let mut i: i32 = 0
    while i < v.len() {
        total = total * v.get_unchecked(i)
        i = i + 1
    }
    total
}
// =============================================================================
// Extended prelude compatibility functions.
// CoreOp-bound and transitional intrinsic bodies are typechecked but deferred
// during MIR lowering under RFC-005 D3. Pure Ark helpers above lower normally.
// =============================================================================

// Scalar formatting: the retired `to_string(x)` free is now `x.to_string()`
// (Display impls for i32 / i64 / f64 / bool / char / String).
// Vec operations. These declarations are the call contract: the checker
// unifies the argument types with these generic signatures instead of
// skipping the arguments because the emitter happens to lower the name
// (#936). Each body is the operation's sealed fallback on the raw API
// (ADR-042 D2); MIR lowering still defers it under RFC-005 D3, so call sites
// bind the owner-qualified CoreOp instead of this declaration.
//
// `push` / `pop` / `set` are retired from the public surface. The private
// generic declarations stay as receiver-method signature anchors: the
// typechecker binds `v.push(x)` / `v.pop()` / `v.set(i, x)` from the
// `Vec<T>` receiver here, which the concrete `__core_vec_*_i32_impl` shells
// cannot do for String / struct / nested element types. Bare calls fail
// E0100 and the declarations are not importable (ADR-091, ADR-046).
fn push<T>(mut v: Vec<T>, val: T) {
    let count: i32 = raw_array_len(v)
    let mut grown: Vec<T> = raw_array_grow(v, count + 1)
    raw_array_set_unchecked(grown, count, val)
}

// Receiver-method signature anchors (#936): the typechecker binds
// `v.get(idx)` / `v.get_unchecked(idx)` from these generic declarations for
// String / struct / nested element types. They stay private so the retired
// free names cannot be called or imported; E0100 points at the methods.
fn get<T>(v: Vec<T>, idx: i32) -> Option<T> {
    if idx < 0 || idx >= raw_array_len(v) {
        return None
    }
    Some(raw_array_get_unchecked(v, idx))
}

fn get_unchecked<T>(v: Vec<T>, idx: i32) -> T {
    return v[idx]
}

fn pop<T>(mut v: Vec<T>) -> Option<T> {
    let count: i32 = raw_array_len(v)
    if count == 0 {
        return None
    }
    let last: i32 = count - 1
    let value: T = raw_array_get_unchecked(v, last)
    // Shrink the logical length through grow until set_len dispatch replaces it.
    raw_array_grow(v, last)
    Some(value)
}

fn set<T>(mut v: Vec<T>, idx: i32, val: T) {
    raw_array_set_unchecked(v, idx, val)
}

// Option / Result
//
// These are concrete per-type impls: a generic `impl<T> Option<T>` compiles
// and validates but lowers to the unresolved-call trap stub, so the payload
// and error types the retired prelude frees covered stay explicit (ADR-091).
impl Option<i32> {
    /// Returns the contained value; panics when the receiver is `None`.
    fn unwrap(self: Option<i32>) -> i32 {
        match self {
            Some(value) => value,
            None => __prelude_unwrap_panic("called `Option::unwrap` on a `None` value"),
        }
    }

    /// Returns the contained value, or `default` for `None`.
    fn unwrap_or(self: Option<i32>, default: i32) -> i32 {
        match self {
            Some(value) => value,
            None => default,
        }
    }

    /// Returns true when the receiver is `Some`.
    fn is_some(self: Option<i32>) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    /// Returns true when the receiver is `None`.
    fn is_none(self: Option<i32>) -> bool {
        match self {
            Some(_) => false,
            None => true,
        }
    }
}

impl Result<i32, i32> {
    /// Returns the `Ok` value; panics when the receiver is `Err`.
    fn unwrap(self: Result<i32, i32>) -> i32 {
        match self {
            Ok(value) => value,
            Err(_) => __prelude_unwrap_panic("called `Result::unwrap` on an `Err` value"),
        }
    }

    /// Returns the `Ok` value, or `default` for `Err`.
    fn unwrap_or(self: Result<i32, i32>, default: i32) -> i32 {
        match self {
            Ok(value) => value,
            Err(_) => default,
        }
    }

    /// Returns true when the receiver is `Ok`.
    fn is_ok(self: Result<i32, i32>) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    /// Returns true when the receiver is `Err`.
    fn is_err(self: Result<i32, i32>) -> bool {
        match self {
            Ok(_) => false,
            Err(_) => true,
        }
    }
}

fn __prelude_unwrap_panic(message: String) -> i32 {
    Std::panic(message)
    0
}

// A slice retains the source collection and a bounded range. The collection
// reference is shared by the backend representation; the source binding is
// not consumed at this language boundary.
//
// `Vec::as_slice` and the `Slice` receiver methods are the only public
// spelling: the former frees were retired with E0100 hints.
impl<T> Slice<T> {
    /// Returns the number of elements covered by this view.
    fn len(self: Slice<T>) -> i32 {
        match self {
            Slice::View(_, start, end) => end - start,
        }
    }

    /// Returns the element at `index` within this view.
    fn get(self: Slice<T>, index: i32) -> T {
        match self {
            Slice::View(source, start, _) => source.get_unchecked(start + index),
        }
    }
}
// String collection helpers (`contains` / `starts_with` / `ends_with` /
// `index_of`) were retired under ADR-091; use the receiver methods on String.
// Mutating String append. `s.push_char(c)` is the only spelling; the free was
// retired under ADR-091 once the receiver-method lowering started writing the
// grown array back to the receiver (including field receivers).

// Math
// Deprecated prelude free function pow_i32 has been removed per ADR-036.
// Use inherent method `base.pow(exp)` instead.

fn __core_math_gcd_impl(a: i32, b: i32) -> i32 {
    let mut x = a
    let mut y = b
    if x < 0 {
        x = 0 - x
    }
    if y < 0 {
        y = 0 - y
    }
    while y != 0 {
        let next = y
        y = x - x / y * y
        x = next
    }
    x
}

fn __core_math_pow_i32_impl(base: i32, exponent: i32) -> i32 {
    let mut result = 1
    let mut index = 0
    while index < exponent {
        result = result * base
        index = index + 1
    }
    result
}

// `byte_at(s, i)` was retired under ADR-091; use `s.byte_at(i)`.

impl f32 {
    /// Shortest round-trip decimal formatting for an `f32`.
    fn to_string(self: f32) -> String {
        __core_f32_to_string_impl(self)
    }
}

// Portable scalar fallback bodies for the three simd CoreOps whose lowering is
// normal_call (ADR-042). The wasm simd128 specialisation in data/core-ops.toml
// records the native fast path; these bodies define the portable semantics.

fn __core_simd_i32x4_add_impl(a: v128, b: v128) -> v128 {
    let mut v = __simd_i32x4_splat(0)
    v = __simd_i32x4_replace_lane(v, 0, __simd_i32x4_extract_lane(a, 0) + __simd_i32x4_extract_lane(b, 0))
    v = __simd_i32x4_replace_lane(v, 1, __simd_i32x4_extract_lane(a, 1) + __simd_i32x4_extract_lane(b, 1))
    v = __simd_i32x4_replace_lane(v, 2, __simd_i32x4_extract_lane(a, 2) + __simd_i32x4_extract_lane(b, 2))
    v = __simd_i32x4_replace_lane(v, 3, __simd_i32x4_extract_lane(a, 3) + __simd_i32x4_extract_lane(b, 3))
    v
}

fn __core_simd_i32x4_sub_impl(a: v128, b: v128) -> v128 {
    let mut v = __simd_i32x4_splat(0)
    v = __simd_i32x4_replace_lane(v, 0, __simd_i32x4_extract_lane(a, 0) - __simd_i32x4_extract_lane(b, 0))
    v = __simd_i32x4_replace_lane(v, 1, __simd_i32x4_extract_lane(a, 1) - __simd_i32x4_extract_lane(b, 1))
    v = __simd_i32x4_replace_lane(v, 2, __simd_i32x4_extract_lane(a, 2) - __simd_i32x4_extract_lane(b, 2))
    v = __simd_i32x4_replace_lane(v, 3, __simd_i32x4_extract_lane(a, 3) - __simd_i32x4_extract_lane(b, 3))
    v
}

fn __core_simd_f32x4_add_impl(a: v128, b: v128) -> v128 {
    let mut v = __simd_f32x4_splat(0.0f32)
    v = __simd_f32x4_replace_lane(v, 0, __simd_f32x4_extract_lane(a, 0) + __simd_f32x4_extract_lane(b, 0))
    v = __simd_f32x4_replace_lane(v, 1, __simd_f32x4_extract_lane(a, 1) + __simd_f32x4_extract_lane(b, 1))
    v = __simd_f32x4_replace_lane(v, 2, __simd_f32x4_extract_lane(a, 2) + __simd_f32x4_extract_lane(b, 2))
    v = __simd_f32x4_replace_lane(v, 3, __simd_f32x4_extract_lane(a, 3) + __simd_f32x4_extract_lane(b, 3))
    v
}
