// =============================================================================
// Legacy compatibility bodies. The remaining private `__core_*` functions are
// core-op fallbacks; their public prelude wrappers were deleted in the
// ADR-087 Wave 2. `filter_i32` is the one still-public provisional entry.
// =============================================================================
// Core-op fallback for seq.sort_i32 (public wrapper deleted in ADR-087 Wave 2).
fn __core_seq_sort_i32_impl(mut v: Vec<i32>) {
    let mut index = 1
    while index < len(v) {
        let value = get_unchecked(v, index)
        let mut insertion = index
        while insertion > 0 && get_unchecked(v, insertion - 1) > value {
            set(v, insertion, get_unchecked(v, insertion - 1))
            insertion = insertion - 1
        }
        set(v, insertion, value)
        index = index + 1
    }
}
// Provisional individual deferral (#703): the eager i32 filter stays callable.
pub fn filter_i32(v: Vec<i32>, f: fn(i32) -> bool) -> Vec<i32> {
    __intrinsic_filter_i32(v, f)
}
