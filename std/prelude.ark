// Box is an owned heap wrapper. Its representation is selected by the target
// backend, while the source-level value remains a unique owner.
pub fn Box_new<T>(value: T) -> Box<T> {
    Box::Owned(value)
}

pub fn unbox<T>(boxed: Box<T>) -> T {
    match boxed {
        Box::Owned(value) => value,
    }
}

// A slice retains the source collection and a bounded range. The collection
// reference is shared by the backend representation; the source binding is
// not consumed at this language boundary.
pub fn as_slice<T>(source: Vec<T>, start: i32, end: i32) -> Slice<T> {
    Slice::View(source, start, end)
}

pub fn slice_len<T>(view: Slice<T>) -> i32 {
    match view {
        Slice::View(_, start, end) => end - start,
    }
}

pub fn slice_get<T>(view: Slice<T>, index: i32) -> T {
    match view {
        Slice::View(source, start, _) => get_unchecked(source, start + index),
    }
}

// Receiver methods for the slice view. The free helpers above remain the
// deprecated compatibility spelling until the slice family is retired.
impl<T> Slice<T> {
    /// Returns the number of elements covered by this view.
    fn len(self: Slice<T>) -> i32 {
        match self {
            Slice::View(_, start, end) => end - start,
        }
    }

    /// Returns the element at `index` within this view.
    fn get(self: Slice<T>, index: i32) -> T {
        match self {
            Slice::View(source, start, _) => get_unchecked(source, start + index),
        }
    }
}
