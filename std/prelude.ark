// =============================================================================
// Arukellt Standard Prelude
// =============================================================================
//
// v2 policy (ADR-072): the resolver auto-imports only the tiny stable set
// recorded in std/manifest.toml [prelude_policy]. This file declares that
// stable set and the remaining explicit-import prelude entries. ADR-091
// retired the 27 method-replaceable prelude frees (`trim`, `split`, `abs`,
// `values`, ...); their bare calls fail with E0100 and a receiver
// hint, and `assert` / `String_from` / `String_new` / `char_to_string` are the
// only retained stable-free exception. The resolver keeps the stable-name list
// in src/compiler/resolver/prelude_stable.ark, which
// scripts/check/check-compat-orphans.py holds in sync with the manifest.
//
// Compilation: RFC-005 / #816 restores prelude decls to the backend combine
// path. CoreOp-bound symbols and intrinsic shims defer MIR body lowering until
// #821/#822 (see mir/lower/stdlib_body_defer.ark). Pure Ark helpers such as
// `assert` are lowered now.
//
// ## Tiny Prelude (the v2 stable set — the only auto-imported declarations)
//
//   Types / compiler builtins (handled by ark-typecheck, not listed here):
//     Option, Result, String, Vec
//     Some, None, Ok, Err
//     (true / false are lexical literals, not prelude values)
//
//   Functions provided by THIS file:
//     assert
//     Std::panic  (associated control operation)
//     String_from, String_new
//     char_to_string  (essential conversion)
//     plus len, push, pop, get, set, get_unchecked
//
// ## Legacy / explicit-import section
//
// Declarations outside the tiny set (Box, Slice, …) are callable only with an
// explicit `use std::prelude::{name}`.
//
// The stable monomorphic seq/combinator frees (`map_i32_i32`, `sort_i32`, …)
// were deleted in the ADR-087 Wave 2 (#703 / #917). Bare calls now fail with
// E0100 plus a `resolver::removed_names` migration hint. The replacements are
// the Vec / iterator methods: `v.sort_by(cmp)`, `v.iter().map(f).collect()`,
// `v.iter().filter(f).collect()`, `v.iter().fold(init, f)`, `v.iter().sum()`,
// `v.iter().any(f)`, `v.iter().find(f)`, `v.iter().contains(x)`,
// `v.iter().rev().collect()`, and `v.drain(i, i + 1)`; Option::map lives in
// `std::core::container`. `filter_i32` remains provisional (individual
// deferral). Vec constructors (`Vec_new_*`) were removed in #845; use
// `Vec::new<T>()`.
//
// Design ADR:    docs/adr/ADR-036-trait-stdlib-redesign.md
// Prelude design: docs/stdlib/prelude.md
//
// =============================================================================
use std::collections::string
use std::core::scalar_format

// String construction
pub enum Box<T> {
    Owned(T),
}

pub enum Slice<T> {
    View(Vec<T>, i32, i32),
}

pub fn String_from(s: String) -> String {
    return s
}

pub fn String_new() -> String {
    Std::panic(String_new()); return String_new()
}

// String comparison
pub fn eq(a: String, b: String) -> bool {
    string::eq(a, b)
}

// String operations
// Free `clone` is the explicit-import signature shim for the
// compiler-polymorphic `text.clone` CoreOp. The canonical surface is the
// receiver method `s.clone()`, which the compiler prefers for concrete
// receivers (#702).
pub fn clone(s: String) -> String {
    s.clone()
}

// `slice` / `substring` were retired under ADR-091; use `s.slice(start, end)`.
// Conversion: to string
// Deprecated prelude free functions (i32_to_string, i64_to_string,
// f64_to_string, bool_to_string) have been removed per ADR-036.
// Use inherent method `x.to_string()` instead.

pub fn char_to_string(c: char) -> String {
    __core_char_to_string_impl(c)
}

// Conversion: from string. The canonical surface is the `TryFrom<String>`
// associated function (`i32::try_from(s)` / `i64::try_from(s)` /
// `f64::try_from(s)`) from `use std::core::convert`; the prelude frees were
// retired under ADR-091.
pub fn f64_bits_lo(x: f64) -> i32 {
    __core_scalar_f64_bits_lo_impl(x)
}

pub fn f64_bits_hi(x: f64) -> i32 {
    __core_scalar_f64_bits_hi_impl(x)
}

// --- Scalar type conversion functions (issue #040) ---
// Widening narrow integer types → i32 (no-op in Wasm; all stored as i32)
pub fn u8_to_i32(x: u8) -> i32 {
    Std::panic(String_new()); return 0
}

pub fn u16_to_i32(x: u16) -> i32 {
    Std::panic(String_new()); return 0
}

pub fn i8_to_i32(x: i8) -> i32 {
    Std::panic(String_new()); return 0
}

pub fn i16_to_i32(x: i16) -> i32 {
    Std::panic(String_new()); return 0
}

// Narrowing i32 → narrow types (masking for unsigned, sign-extension for signed)
pub fn i32_to_u8(x: i32) -> u8 {
    Std::panic(String_new()); return 0
}

pub fn i32_to_u16(x: i32) -> u16 {
    Std::panic(String_new()); return 0
}

pub fn i32_to_i8(x: i32) -> i8 {
    Std::panic(String_new()); return 0
}

pub fn i32_to_i16(x: i32) -> i16 {
    Std::panic(String_new()); return 0
}

// i32/u32 ↔ i64/u64 widening and truncation
pub fn u32_to_u64(x: u32) -> u64 {
    Std::panic(String_new()); return 0_u64
}

pub fn u64_to_u32(x: u64) -> u32 {
    Std::panic(String_new()); return 0
}

pub fn i32_to_i64(x: i32) -> i64 {
    Std::panic(String_new()); return 0_i64
}

pub fn i64_to_i32(x: i64) -> i32 {
    Std::panic(String_new()); return 0
}

// f32 ↔ f64 conversion
pub fn f32_to_f64(x: f32) -> f64 {
    Std::panic(String_new()); return 0.0
}

pub fn f64_to_f32(x: f64) -> f32 {
    Std::panic(String_new()); return f64_to_f32(0.0)
}

fn __core_math_abs_impl(x: i32) -> i32 {
    if x < 0 {
        0 - x
    } else {
        x
    }
}

fn __core_math_min_impl(a: i32, b: i32) -> i32 {
    if a < b {
        a
    } else {
        b
    }
}

fn __core_math_max_impl(a: i32, b: i32) -> i32 {
    if a > b {
        a
    } else {
        b
    }
}

// Math: clamp (i32)
fn __core_math_clamp_impl(x: i32, lo: i32, hi: i32) -> i32 {
    if x < lo {
        lo
    } else if x > hi {
        hi
    } else {
        x
    }
}

// Control
/// Namespace for unrecoverable process control.
///
/// `Std` is never constructed; it exists so control operations have an
/// associated-function spelling instead of a user-reachable free function
/// (ADR-046). The private field keeps the generated component type non-empty.
pub struct Std {
    reserved: i32,
}

impl Std {
    /// Aborts the program after writing `message` to stderr.
    ///
    /// Lowered by the `panic` CoreOp; the body is a typechecking shell.
    fn panic(message: String) {
        __intrinsic_panic(message)
    }
}

// =============================================================================
// Legacy compatibility bodies. The remaining private `__core_*` functions are
// core-op fallbacks; their public prelude wrappers were deleted in the
// ADR-087 Wave 2. `filter_i32` is the one still-public provisional entry.
// =============================================================================
// Core-op fallback for seq.sort_i32 (public wrapper deleted in ADR-087 Wave 2).
fn __core_seq_sort_i32_impl(mut v: Vec<i32>) {
    let mut index = 1
    while index < len(v) {
        let value = get_unchecked(v, index)
        let mut insertion = index
        while insertion > 0 && get_unchecked(v, insertion - 1) > value {
            set(v, insertion, get_unchecked(v, insertion - 1))
            insertion = insertion - 1
        }
        set(v, insertion, value)
        index = index + 1
    }
}
// Provisional individual deferral (#703): the eager i32 filter stays callable.
pub fn filter_i32(v: Vec<i32>, f: fn(i32) -> bool) -> Vec<i32> {
    __intrinsic_filter_i32(v, f)
}
// Core-op fallback for seq.sort_i64 (public wrapper deleted in ADR-087 Wave 2).
fn __core_seq_sort_i64_impl(mut v: Vec<i64>) {
    let mut index = 1
    while index < len(v) {
        let value = get_unchecked(v, index)
        let mut insertion = index
        while insertion > 0 && get_unchecked(v, insertion - 1) > value {
            set(v, insertion, get_unchecked(v, insertion - 1))
            insertion = insertion - 1
        }
        set(v, insertion, value)
        index = index + 1
    }
}
// Core-op fallback for seq.sort_f64 (public wrapper deleted in ADR-087 Wave 2).
fn __core_seq_sort_f64_impl(mut v: Vec<f64>) {
    let mut index = 1
    while index < len(v) {
        let value = get_unchecked(v, index)
        let mut insertion = index
        while insertion > 0 && get_unchecked(v, insertion - 1) > value {
            set(v, insertion, get_unchecked(v, insertion - 1))
            insertion = insertion - 1
        }
        set(v, insertion, value)
        index = index + 1
    }
}
// Assertions
pub fn assert(cond: bool) {
    if !cond {
        Std::panic(String_from("assertion failed"))
    }
}

/// Legacy i32 equality assertion compat. Prefer `test::assert_eq_i32` or
/// generic `test::assert_eq_debug` (#696) for Debug-backed diagnostics.
///
/// Residual: bare `assert_eq` call sites are still CoreOp-inlined today, so
/// this Ark body is not what most call sites execute. A generic named exactly
/// `assert_eq` also mis-lowers scalar monomorphizations — use
/// `test::assert_eq_debug` instead. Do not `use std::core::convert` here:
/// pulling Convert/Debug into the auto-prelude regresses W0011 on clean fixtures.
pub fn assert_eq(a: i32, b: i32) {
    if a != b {
        let expected = b.to_string().concat(", got ".concat(a.to_string()))
        let msg = "assert_eq failed: expected ".concat(expected)
        Std::panic(msg)
    }
}

pub fn assert_ne(a: i32, b: i32) {
    if a == b {
        Std::panic(String_from("assertion failed"))
    }
}

/// Legacy i64 equality assertion compat. Prefer `test::assert_eq_i64`.
pub fn assert_eq_i64(a: i64, b: i64) {
    if a != b {
        let expected = b.to_string().concat(", got ".concat(a.to_string()))
        let msg = "assert_eq_i64 failed: expected ".concat(expected)
        Std::panic(msg)
    }
}

/// Legacy String equality assertion compat. Prefer `test::assert_eq_string`.
pub fn assert_eq_str(a: String, b: String) {
    if a != b {
        let expected = b.concat("\", got \"".concat(a.concat("\"")))
        let msg = "assert_eq_str failed: expected \"".concat(expected)
        Std::panic(msg)
    }
}

// Sealed-raw CoreOp aliases (no `use std::core::raw`) so bootstrap overlays
// that strip collections modules still resolve these fallback symbols (#822).
fn __core_vec_len_impl<T>(values: Vec<T>) -> i32 {
    raw_array_len(values)
}

fn __core_vec_is_empty_impl<T>(values: Vec<T>) -> bool {
    raw_array_len(values) == 0
}

fn __core_vec_get_unchecked_impl<T>(values: Vec<T>, index: i32) -> T {
    raw_array_get_unchecked(values, index)
}

fn __core_vec_set_impl<T>(mut values: Vec<T>, index: i32, value: T) {
    raw_array_set_unchecked(values, index, value)
}

fn __core_vec_get_unchecked_i64_impl(values: Vec<i64>, index: i32) -> i64 {
    raw_array_get_unchecked(values, index)
}

fn __core_vec_get_unchecked_f64_impl(values: Vec<f64>, index: i32) -> f64 {
    raw_array_get_unchecked(values, index)
}

// Generic `Vec<T>` push shells lower to `unreachable` on LM; keep concrete
// i32/i64/f64 bodies and rewrite String/stdlib sites to sealed grow+set (#822).
fn __core_vec_push_i32_impl(values: Vec<i32>, value: i32) {
    let n: i32 = raw_array_len(values)
    let mut grown: Vec<i32> = raw_array_grow(values, n + 1)
    raw_array_set_unchecked(grown, n, value)
}

fn __core_vec_push_i64_impl(values: Vec<i64>, value: i64) {
    let n: i32 = raw_array_len(values)
    let mut grown: Vec<i64> = raw_array_grow(values, n + 1)
    raw_array_set_unchecked(grown, n, value)
}

fn __core_vec_push_f64_impl(values: Vec<f64>, value: f64) {
    let n: i32 = raw_array_len(values)
    let mut grown: Vec<f64> = raw_array_grow(values, n + 1)
    raw_array_set_unchecked(grown, n, value)
}

fn __core_vec_get_impl(values: Vec<i32>, index: i32) -> Option<i32> {
    if index < 0 || index >= raw_array_len(values) {
        return None
    }
    Some(raw_array_get_unchecked(values, index))
}

fn __core_vec_pop_impl(values: Vec<i32>) -> Option<i32> {
    let n: i32 = raw_array_len(values)
    if n == 0 {
        return None
    }
    let idx: i32 = n - 1
    let value: i32 = raw_array_get_unchecked(values, idx)
    // Shrink logical length through grow (set_len dispatch still incomplete).
    let _shrunk: Vec<i32> = raw_array_grow(values, idx)
    Some(value)
}

fn __core_vec_new_fallback_impl(cap: i32) -> Vec<i32> {
    raw_array_new(cap)
}

fn __core_vec_new_f64_impl(cap: i32) -> Vec<f64> {
    raw_array_new(cap)
}

// Core-op fallbacks for vec.contains / vec.reverse / vec.remove. The public
// prelude wrappers were deleted in the ADR-087 Wave 2.
fn __core_vec_contains_i32_impl(v: Vec<i32>, x: i32) -> bool {
    let mut i: i32 = 0
    while i < raw_array_len(v) {
        if raw_array_get_unchecked(v, i) == x {
            return true
        }
        i = i + 1
    }
    false
}
fn __core_vec_reverse_i32_impl(mut v: Vec<i32>) {
    let n: i32 = raw_array_len(v)
    let mut lo: i32 = 0
    let mut hi: i32 = n - 1
    while lo < hi {
        let tmp: i32 = raw_array_get_unchecked(v, lo)
        raw_array_set_unchecked(v, lo, raw_array_get_unchecked(v, hi))
        raw_array_set_unchecked(v, hi, tmp)
        lo = lo + 1
        hi = hi - 1
    }
}
fn __core_vec_reverse_string_impl(mut v: Vec<String>) {
    let n: i32 = len(v)
    let mut lo: i32 = 0
    let mut hi: i32 = n - 1
    while lo < hi {
        let tmp: String = get_unchecked(v, lo)
        set(v, lo, get_unchecked(v, hi))
        set(v, hi, tmp)
        lo = lo + 1
        hi = hi - 1
    }
}
fn __core_vec_remove_i32_impl(mut v: Vec<i32>, index: i32) {
    let n: i32 = raw_array_len(v)
    let mut i: i32 = index
    while i < n - 1 {
        raw_array_set_unchecked(v, i, raw_array_get_unchecked(v, i + 1))
        i = i + 1
    }
    pop(v)
}
// Core-op fallbacks for seq.sum_i32 / seq.product_i32 (public wrappers deleted
// in the ADR-087 Wave 2).
fn __core_seq_sum_i32_impl(v: Vec<i32>) -> i32 {
    let mut total: i32 = 0
    let mut i: i32 = 0
    while i < len(v) {
        total = total + get_unchecked(v, i)
        i = i + 1
    }
    total
}
fn __core_seq_product_i32_impl(v: Vec<i32>) -> i32 {
    let mut total: i32 = 1
    let mut i: i32 = 0
    while i < len(v) {
        total = total * get_unchecked(v, i)
        i = i + 1
    }
    total
}
// =============================================================================
// Extended prelude compatibility functions.
// CoreOp-bound and transitional intrinsic bodies are typechecked but deferred
// during MIR lowering under RFC-005 D3. Pure Ark helpers above lower normally.
// =============================================================================

// Scalar formatting: the retired `to_string(x)` free is now `x.to_string()`
// (Display impls for i32 / i64 / f64 / bool / char / String).
// Vec operations (polymorphic in practice; emitter dispatches by name)
pub fn len(s: String) -> i32 {
    Std::panic(String_new()); return 0
}

pub fn push(mut v: Vec<i32>, val: i32) {
    Std::panic(String_new())
}

pub fn get(v: Vec<i32>, idx: i32) -> Option<i32> {
    Std::panic(String_new()); return None
}

pub fn get_unchecked<T>(v: Vec<T>, idx: i32) -> T {
    return v[idx]
}

pub fn pop(mut v: Vec<i32>) -> Option<i32> {
    // Rewrite to vec_pop intrinsic (prelude panic stub had no emitter) (#807).
    vec_pop(v)
}

pub fn set<T>(mut v: Vec<T>, idx: i32, val: T) {
    Std::panic(String_new())
}

// Option / Result
//
// These are concrete per-type impls: a generic `impl<T> Option<T>` compiles
// and validates but lowers to the unresolved-call trap stub, so the payload
// and error types the retired prelude frees covered stay explicit (ADR-091).
impl Option<i32> {
    /// Returns the contained value; panics when the receiver is `None`.
    fn unwrap(self: Option<i32>) -> i32 {
        match self {
            Some(value) => value,
            None => __prelude_unwrap_panic("called `Option::unwrap` on a `None` value"),
        }
    }

    /// Returns the contained value, or `default` for `None`.
    fn unwrap_or(self: Option<i32>, default: i32) -> i32 {
        match self {
            Some(value) => value,
            None => default,
        }
    }

    /// Returns true when the receiver is `Some`.
    fn is_some(self: Option<i32>) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    /// Returns true when the receiver is `None`.
    fn is_none(self: Option<i32>) -> bool {
        match self {
            Some(_) => false,
            None => true,
        }
    }
}

impl Result<i32, i32> {
    /// Returns the `Ok` value; panics when the receiver is `Err`.
    fn unwrap(self: Result<i32, i32>) -> i32 {
        match self {
            Ok(value) => value,
            Err(_) => __prelude_unwrap_panic("called `Result::unwrap` on an `Err` value"),
        }
    }

    /// Returns the `Ok` value, or `default` for `Err`.
    fn unwrap_or(self: Result<i32, i32>, default: i32) -> i32 {
        match self {
            Ok(value) => value,
            Err(_) => default,
        }
    }

    /// Returns true when the receiver is `Ok`.
    fn is_ok(self: Result<i32, i32>) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    /// Returns true when the receiver is `Err`.
    fn is_err(self: Result<i32, i32>) -> bool {
        match self {
            Ok(_) => false,
            Err(_) => true,
        }
    }
}

fn __prelude_unwrap_panic(message: String) -> i32 {
    Std::panic(message)
    0
}

// Box is an owned heap wrapper. Its representation is selected by the target
// backend, while the source-level value remains a unique owner.
pub fn Box_new<T>(value: T) -> Box<T> {
    Box::Owned(value)
}

pub fn unbox<T>(boxed: Box<T>) -> T {
    match boxed {
        Box::Owned(value) => value,
    }
}

// A slice retains the source collection and a bounded range. The collection
// reference is shared by the backend representation; the source binding is
// not consumed at this language boundary.
pub fn as_slice<T>(source: Vec<T>, start: i32, end: i32) -> Slice<T> {
    Slice::View(source, start, end)
}

pub fn slice_len<T>(view: Slice<T>) -> i32 {
    match view {
        Slice::View(_, start, end) => end - start,
    }
}

pub fn slice_get<T>(view: Slice<T>, index: i32) -> T {
    match view {
        Slice::View(source, start, _) => get_unchecked(source, start + index),
    }
}

// Receiver methods for the slice view. The free helpers above remain the
// deprecated compatibility spelling until the slice family is retired.
impl<T> Slice<T> {
    /// Returns the number of elements covered by this view.
    fn len(self: Slice<T>) -> i32 {
        match self {
            Slice::View(_, start, end) => end - start,
        }
    }

    /// Returns the element at `index` within this view.
    fn get(self: Slice<T>, index: i32) -> T {
        match self {
            Slice::View(source, start, _) => get_unchecked(source, start + index),
        }
    }
}
// String collection helpers (`contains` / `starts_with` / `ends_with` /
// `index_of`) were retired under ADR-091; use the receiver methods on String.
// Mutating String append. `s.push_char(c)` is the only spelling; the free was
// retired under ADR-091 once the receiver-method lowering started writing the
// grown array back to the receiver (including field receivers).

// Math
// Deprecated prelude free function pow_i32 has been removed per ADR-036.
// Use inherent method `base.pow(exp)` instead.

fn __core_math_gcd_impl(a: i32, b: i32) -> i32 {
    let mut x = a
    let mut y = b
    if x < 0 {
        x = 0 - x
    }
    if y < 0 {
        y = 0 - y
    }
    while y != 0 {
        let next = y
        y = x - x / y * y
        x = next
    }
    x
}

fn __core_math_pow_i32_impl(base: i32, exponent: i32) -> i32 {
    let mut result = 1
    let mut index = 0
    while index < exponent {
        result = result * base
        index = index + 1
    }
    result
}

// `byte_at(s, i)` was retired under ADR-091; use `s.byte_at(i)`.
// Conversions extended
pub fn i32_to_u32(n: i32) -> u32 {
    Std::panic(String_new()); return 0
}

impl f32 {
    /// Shortest round-trip decimal formatting for an `f32`.
    fn to_string(self: f32) -> String {
        __core_f32_to_string_impl(self)
    }
}

// Portable scalar fallback bodies for the three simd CoreOps whose lowering is
// normal_call (ADR-042). The wasm simd128 specialisation in data/core-ops.toml
// records the native fast path; these bodies define the portable semantics.

fn __core_simd_i32x4_add_impl(a: v128, b: v128) -> v128 {
    let mut v = __simd_i32x4_splat(0)
    v = __simd_i32x4_replace_lane(v, 0, __simd_i32x4_extract_lane(a, 0) + __simd_i32x4_extract_lane(b, 0))
    v = __simd_i32x4_replace_lane(v, 1, __simd_i32x4_extract_lane(a, 1) + __simd_i32x4_extract_lane(b, 1))
    v = __simd_i32x4_replace_lane(v, 2, __simd_i32x4_extract_lane(a, 2) + __simd_i32x4_extract_lane(b, 2))
    v = __simd_i32x4_replace_lane(v, 3, __simd_i32x4_extract_lane(a, 3) + __simd_i32x4_extract_lane(b, 3))
    v
}

fn __core_simd_i32x4_sub_impl(a: v128, b: v128) -> v128 {
    let mut v = __simd_i32x4_splat(0)
    v = __simd_i32x4_replace_lane(v, 0, __simd_i32x4_extract_lane(a, 0) - __simd_i32x4_extract_lane(b, 0))
    v = __simd_i32x4_replace_lane(v, 1, __simd_i32x4_extract_lane(a, 1) - __simd_i32x4_extract_lane(b, 1))
    v = __simd_i32x4_replace_lane(v, 2, __simd_i32x4_extract_lane(a, 2) - __simd_i32x4_extract_lane(b, 2))
    v = __simd_i32x4_replace_lane(v, 3, __simd_i32x4_extract_lane(a, 3) - __simd_i32x4_extract_lane(b, 3))
    v
}

fn __core_simd_f32x4_add_impl(a: v128, b: v128) -> v128 {
    let mut v = __simd_f32x4_splat(0.0f32)
    v = __simd_f32x4_replace_lane(v, 0, __simd_f32x4_extract_lane(a, 0) + __simd_f32x4_extract_lane(b, 0))
    v = __simd_f32x4_replace_lane(v, 1, __simd_f32x4_extract_lane(a, 1) + __simd_f32x4_extract_lane(b, 1))
    v = __simd_f32x4_replace_lane(v, 2, __simd_f32x4_extract_lane(a, 2) + __simd_f32x4_extract_lane(b, 2))
    v = __simd_f32x4_replace_lane(v, 3, __simd_f32x4_extract_lane(a, 3) + __simd_f32x4_extract_lane(b, 3))
    v
}
