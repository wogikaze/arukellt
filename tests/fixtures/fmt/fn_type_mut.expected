use std::host::stdio

struct Point {
    x: i32,
}

fn read(p: Point) -> i32 {
    p.x
}

fn apply(f: fn(mut Point) -> i32, mut p: Point) -> i32 {
    f(p)
}

fn main() {
    let read_fn: fn(mut Point) -> i32 = read
    let mut point = Point { x: 1 }
    stdio::println(apply(read_fn, point).to_string())
}
