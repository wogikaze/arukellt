use std::host::stdio
use std::path::Path

fn main() {
    stdio::println(Path::new("/foo/./bar/../baz").normalize())
    stdio::println(Path::new("a/b/../c").normalize())
    stdio::println(Path::new("/foo//bar").normalize())
    stdio::println(Path::new("/a/b/c").normalize())
    let c1: Vec<String> = Path::new("/usr/local/bin").components()
    stdio::println((len(c1)).to_string())
    stdio::println(get_unchecked(c1, 0))
    stdio::println(get_unchecked(c1, 1))
    stdio::println(get_unchecked(c1, 2))
    let c2: Vec<String> = Path::new("a/b").components()
    stdio::println((len(c2)).to_string())
    let c3: Vec<String> = Path::new("").components()
    stdio::println((len(c3)).to_string())
}
// normalize: dot and double-dot
