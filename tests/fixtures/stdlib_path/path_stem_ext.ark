use std::host::stdio::Stdio
use std::path::Path

fn main() {
    Stdio::println(Path::new("hello.txt").stem())
    Stdio::println(Path::new("foo.tar.gz").stem())
    Stdio::println(Path::new("noext").stem())
    Stdio::println(Path::new("hello.txt").with_extension("rs"))
    Stdio::println(Path::new("hello.txt").with_extension(""))
    Stdio::println(Path::new("noext").with_extension("txt"))
    Stdio::println(Path::new("/a/b/foo.md").with_extension("html"))
}
// stem
// with_extension
