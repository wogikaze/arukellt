use std::host::stdio::Stdio
use std::path::Path

fn main() {
    Stdio::println(Path::new("/home/user").join("data.txt"))
    Stdio::println(Path::new("/foo/").join("bar"))
    Stdio::println(Path::new("").join("baz"))
    Stdio::println(Path::new("/a").join(""))
    Stdio::println(Path::new("/home/user/file.txt").parent())
    Stdio::println(Path::new("/a/b/c").parent())
    Stdio::println((Path::new("/foo/bar").is_absolute()).to_string())
    Stdio::println((Path::new("relative").is_absolute()).to_string())
    Stdio::println((Path::new("").is_absolute()).to_string())
    Stdio::println(Path::new("/home/user/readme.md").file_name())
    Stdio::println(Path::new("alone.txt").file_name())
    Stdio::println(Path::new("hello.txt").extension())
    Stdio::println(Path::new("archive.tar.gz").extension())
    Stdio::println(Path::new("noext").extension())
}
// join: basic
// parent
// is_absolute
// file_name
// extension
