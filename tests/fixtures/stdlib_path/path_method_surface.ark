// Path receiver surface (ADR-046); wasm32-gc lane.
use std::host::stdio::Stdio
use std::path::Path
use std::prelude::{assert_eq_i64, assert_eq_str}

fn main() {
    assert_eq_str(Path::new("/usr").join("bin"), "/usr/bin")
    assert_eq_str(Path::new("/usr/").join("bin"), "/usr/bin")
    assert_eq_str(Path::new("/usr/bin/ls").parent(), "/usr/bin")
    assert_eq_str(Path::new("/usr/bin/ls").file_name(), "ls")
    assert_eq_str(Path::new("main.ark").extension(), "ark")
    assert_eq_str(Path::new("main.rs").with_extension("ark"), "main.ark")
    assert_eq_str(Path::new("a/../b").normalize(), "b")
    assert(Path::new("/usr").is_absolute())
    let parts: Vec<String> = Path::new("/usr/local/bin").components()
    assert_eq_i64(parts.len(), 3i64)
    assert_eq_str(Path::new("/usr").into_string(), "/usr")
    Stdio::println("path methods ok")
}
