use std::host::stdio
use std::path::Path

fn main() {
    stdio::println(Path::new("").join("child"))
    stdio::println(Path::new("base").join(""))
    stdio::println(Path::new("").join(""))
    stdio::println(Path::new("dir/").join("file"))
    stdio::println(Path::new("a/b").join("c/d"))
    stdio::println(Path::new("dir/file.txt").parent())
    stdio::println(Path::new("a/b/c").parent())
    stdio::println(Path::new("/").parent())
    stdio::println(Path::new("file.txt").parent())
    stdio::println(Path::new("dir/").file_name())
    stdio::println(Path::new("a/b/c.txt").file_name())
    stdio::println(Path::new("standalone").file_name())
    stdio::println(Path::new("file.tar.gz").extension())
    stdio::println(Path::new(".gitignore").extension())
    stdio::println(Path::new("Makefile").extension())
    stdio::println(Path::new("dir/file.rs").extension())
    stdio::println(Path::new("main.rs").with_extension("ark"))
    stdio::println(Path::new("Makefile").with_extension("bak"))
    stdio::println(Path::new("file.txt").with_extension(""))
    stdio::println((Path::new("/").is_absolute()).to_string())
    stdio::println((Path::new("/usr/bin").is_absolute()).to_string())
    stdio::println((Path::new("relative/path").is_absolute()).to_string())
    stdio::println((Path::new("").is_absolute()).to_string())
}
// === join edge cases ===
// join with empty base
// join with empty child
// join both empty
// join with trailing slash on base
// nested path
// === parent edge cases ===
// parent of simple file
// parent of nested
// parent of root
// parent of single component
// === file_name edge cases ===
// trailing slash
// nested with extension
// no directory
// === extension edge cases ===
// multiple dots
// hidden file
// no extension
// path with extension
// === with_extension edge cases ===
// replace existing
// add to no extension
// empty extension (remove)
// === is_absolute edge cases ===
