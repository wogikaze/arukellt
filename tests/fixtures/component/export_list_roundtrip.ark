// Export with list<s32> parameter and result maps to WIT list<s32> -> list<s32>.

export fn append_marker(v: Vec<i32>) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new<i32>()
    let mut i = 0
    while i < v.len() {
        push(out, v.get_unchecked(i))
        i = i + 1
    }
    push(out, 99)
    out
}

fn main() {
}
