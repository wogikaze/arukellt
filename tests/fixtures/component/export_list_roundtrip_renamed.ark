// Export with WIT list parameter/result canonical ABI using a non-fixture name.
export fn copy_with_tail(v: Vec<i32>) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new<i32>()
    let mut i = 0
    while i < v.len() {
        out.push(v.get_unchecked(i))
        i = i + 1
    }
    out.push(77)
    out
}

