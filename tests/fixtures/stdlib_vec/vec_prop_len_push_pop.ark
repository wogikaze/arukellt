use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    Test::assert_eq_i32(v.len(), 0)
    v.push(1)
    Test::assert_eq_i32(v.len(), 1)
    v.push(2)
    Test::assert_eq_i32(v.len(), 2)
    match v.pop() {
        Option::Some(_) => {
        },
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_eq_i32(v.len(), 1)
    match v.pop() {
        Option::Some(_) => {
        },
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_eq_i32(v.len(), 0)
}
