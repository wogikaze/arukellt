use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)
    match get(v, 1000) {
        Option::Some(val) => Std::panic("expected None, got Some"),
        None => {
        },
    }
    match get(v, 99999) {
        Option::Some(val) => Std::panic("expected None, got Some"),
        None => {
        },
    }
}
