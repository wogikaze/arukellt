use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)
    match v.get(1000) {
        Option::Some(val) => Std::panic("expected None, got Some"),
        None => {
        },
    }
    match v.get(99999) {
        Option::Some(val) => Std::panic("expected None, got Some"),
        None => {
        },
    }
}
