use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < 100 {
        push(v, 0)
        i = i + 1
    }
    let mut j: i32 = 0
    while j < 100 {
        set(v, j, j * 3)
        j = j + 1
    }
    Test::assert_eq_i32(v.len(), 100)
    Test::assert_eq_i32(v.get_unchecked(0), 0)
    Test::assert_eq_i32(v.get_unchecked(50), 150)
    Test::assert_eq_i32(v.get_unchecked(99), 297)
}
