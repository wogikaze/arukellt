use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    match v.pop() {
        Option::Some(val) => Test::assert_eq_i32(val, 3),
        None => Std::panic("expected Some, got None"),
    }
    match v.pop() {
        Option::Some(val) => Test::assert_eq_i32(val, 2),
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_eq_i32(get_unchecked(v, 0), 1)
}
