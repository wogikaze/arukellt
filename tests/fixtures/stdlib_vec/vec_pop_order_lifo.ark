use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    match pop(v) {
        Option::Some(val) => Test::assert_eq_i32(val, 3),
        None => Std::panic("expected Some, got None"),
    }
    match pop(v) {
        Option::Some(val) => Test::assert_eq_i32(val, 2),
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_eq_i32(v.get_unchecked(0), 1)
}
