use std::test
use std::collections::vec
use std::core
use std::core::cmp

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 42)
    v.sort_by(ascending)
    test::assert_eq_i32(len(v), 1)
    test::assert_eq_i32(get_unchecked(v, 0), 42)
}
