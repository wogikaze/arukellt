use std::test::Test
use std::collections::vec
use std::core
use std::core::cmp

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 42)
    v.sort_by(ascending)
    Test::assert_eq_i32(v.len(), 1)
    Test::assert_eq_i32(v.get_unchecked(0), 42)
}
