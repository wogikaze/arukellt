use std::collections::vec
use std::test::Test

fn main() {
    let mut v: Vec<String> = Vec::new<String>()
    v.push(String_from("a"))
    v.push(String_from("b"))
    v.push(String_from("c"))
    let mut reverse_lo = 0
    let mut reverse_hi = v.len() - 1
    while reverse_lo < reverse_hi {
        let reverse_tmp = v.get_unchecked(reverse_lo)
        v.set(reverse_lo, v.get_unchecked(reverse_hi))
        v.set(reverse_hi, reverse_tmp)
        reverse_lo = reverse_lo + 1
        reverse_hi = reverse_hi - 1
    }
    Test::assert_eq_string(get_unchecked(v, 0), String_from("c"))
    Test::assert_eq_string(get_unchecked(v, 1), String_from("b"))
    Test::assert_eq_string(get_unchecked(v, 2), String_from("a"))
}
