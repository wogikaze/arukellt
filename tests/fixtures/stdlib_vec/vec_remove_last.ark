use std::test::Test
use std::collections::vec

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)
    v.drain(2, 2 + 1)
    Test::assert_eq_i32(v.len(), 2)
    Test::assert_eq_i32(v.get_unchecked(0), 10)
    Test::assert_eq_i32(v.get_unchecked(1), 20)
}
