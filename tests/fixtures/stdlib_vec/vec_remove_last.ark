use std::test::Test
use std::collections::vec

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)
    v.drain(2, 2 + 1)
    Test::assert_eq_i32(len(v), 2)
    Test::assert_eq_i32(get_unchecked(v, 0), 10)
    Test::assert_eq_i32(get_unchecked(v, 1), 20)
}
