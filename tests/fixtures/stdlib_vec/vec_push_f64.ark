use std::test::Test

fn main() {
    let mut v: Vec<f64> = Vec::new<f64>()
    v.push(1.5)
    v.push(2.5)
    v.push(3.5)
    Test::assert_eq_i32(v.len(), 3)
    Test::assert_eq_f64(v.get_unchecked(0), 1.5)
    Test::assert_eq_f64(v.get_unchecked(1), 2.5)
    Test::assert_eq_f64(v.get_unchecked(2), 3.5)
}
