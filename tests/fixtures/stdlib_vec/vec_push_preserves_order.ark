use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)
    push(v, 40)
    push(v, 50)
    Test::assert_eq_i32(v.get_unchecked(0), 10)
    Test::assert_eq_i32(v.get_unchecked(1), 20)
    Test::assert_eq_i32(v.get_unchecked(2), 30)
    Test::assert_eq_i32(v.get_unchecked(3), 40)
    Test::assert_eq_i32(v.get_unchecked(4), 50)
}
