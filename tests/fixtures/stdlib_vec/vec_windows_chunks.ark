// Vec<T> window and chunk materialization: widths and partial tails.
use std::collections::vec
use std::host::stdio::Stdio

fn print_window(window: Vec<i32>) {
    Stdio::print("[")
    let mut i: i32 = 0
    while i < window.len() {
        if i > 0 {
            Stdio::print(",")
        }
        Stdio::print((get_unchecked(window, i)).to_string())
        i = i + 1
    }
    Stdio::println("]")
}

fn main() {
    let mut values: Vec<i32> = Vec::new<i32>()
    push(values, 1)
    push(values, 2)
    push(values, 3)
    push(values, 4)
    push(values, 5)

    let windows: Vec<Vec<i32>> = values.windows(3)
    Stdio::println((windows.len()).to_string())
    print_window(get_unchecked(windows, 0))
    print_window(get_unchecked(windows, 2))

    let too_wide: Vec<Vec<i32>> = values.windows(6)
    Stdio::println((too_wide.len()).to_string())
    let zero_width: Vec<Vec<i32>> = values.windows(0)
    Stdio::println((zero_width.len()).to_string())

    let chunks: Vec<Vec<i32>> = values.chunks(2)
    Stdio::println((chunks.len()).to_string())
    print_window(get_unchecked(chunks, 0))
    print_window(get_unchecked(chunks, 2))

    let exact: Vec<Vec<i32>> = values.chunks_exact(2)
    Stdio::println((exact.len()).to_string())
    let exact_partial: Vec<Vec<i32>> = values.chunks_exact(4)
    Stdio::println((exact_partial.len()).to_string())
    let zero_chunks: Vec<Vec<i32>> = values.chunks(0)
    Stdio::println((zero_chunks.len()).to_string())
}
