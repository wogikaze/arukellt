use std::test::Test
use std::collections::vec
use std::core
use std::core::cmp

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(-10)
    v.push(30)
    v.push(-5)
    v.push(20)
    v.push(0)
    v.sort_by(ascending)
    Test::assert_eq_i32(get_unchecked(v, 0), -10)
    Test::assert_eq_i32(get_unchecked(v, 1), -5)
    Test::assert_eq_i32(get_unchecked(v, 2), 0)
    Test::assert_eq_i32(get_unchecked(v, 3), 20)
    Test::assert_eq_i32(get_unchecked(v, 4), 30)
}
