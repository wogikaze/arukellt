// `Vec::as_slice` plus the `Slice` receiver methods are the only public
// spelling after the intrinsic-compat frees retired. The bounded view must
// read through the source vector without copying.
use std::test::Test
use std::collections::vec

fn main() {
    let mut values: Vec<i32> = Vec::new<i32>()
    values.push(7)
    values.push(8)
    values.push(9)

    let head = values.as_slice(0, 1)
    Test::assert_eq_i32(head.len(), 1)
    Test::assert_eq_i32(head.get(0), 7)

    let tail = values.as_slice(1, 3)
    Test::assert_eq_i32(tail.len(), 2)
    Test::assert_eq_i32(tail.get(0), 8)
    Test::assert_eq_i32(tail.get(1), 9)

    let empty = values.as_slice(2, 2)
    Test::assert_eq_i32(empty.len(), 0)
}
