use std::test
use std::collections::vec

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)
    v.drain(0, 0 + 1)
    test::assert_eq_i32(len(v), 2)
    test::assert_eq_i32(get_unchecked(v, 0), 20)
    test::assert_eq_i32(get_unchecked(v, 1), 30)
}
