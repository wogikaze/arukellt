use std::test::Test

fn square(x: f64) -> f64 {
    x * x
}

fn main() {
    let mut v: Vec<f64> = Vec::new<f64>()
    v.push(2.0)
    v.push(3.0)
    v.push(4.0)
    let mut result: Vec<f64> = Vec::new<f64>()
    let mut map_index: i32 = 0
    while map_index < v.len() {
        result.push(square(v.get_unchecked(map_index)))
        map_index = map_index + 1
    }
    Test::assert_eq_f64(result.get_unchecked(0), 4.0)
    Test::assert_eq_f64(result.get_unchecked(1), 9.0)
    Test::assert_eq_f64(result.get_unchecked(2), 16.0)
}
