use std::test::Test
use std::core::iter

fn is_large(x: i32) -> bool {
    x > 100
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    let result = v.iter().find(is_large)
    match result {
        Option::Some(val) => Std::panic("expected None, got Some"),
        None => {
        },
    }
}
