use std::test::Test
use std::collections::vec
use std::core
use std::core::cmp

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < 100 {
        v.push(100 - i)
        i = i + 1
    }
    v.sort_by(ascending)
    Test::assert_eq_i32(v.len(), 100)
    Test::assert_eq_i32(get_unchecked(v, 0), 1)
    Test::assert_eq_i32(get_unchecked(v, 99), 100)
    let mut k: i32 = 0
    while k < 99 {
        Test::assert_true(get_unchecked(v, k) <= get_unchecked(v, k + 1))
        k = k + 1
    }
}
