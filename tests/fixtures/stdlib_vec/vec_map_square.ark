use std::test::Test
use std::core::iter

fn square(x: i32) -> i32 {
    x * x
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    let result: Vec<i32> = v.iter().map(square).collect()
    Test::assert_eq_i32(result.get_unchecked(0), 1)
    Test::assert_eq_i32(result.get_unchecked(1), 4)
    Test::assert_eq_i32(result.get_unchecked(2), 9)
    Test::assert_eq_i32(result.get_unchecked(3), 16)
}
