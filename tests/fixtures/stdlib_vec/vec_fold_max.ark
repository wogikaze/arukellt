use std::test::Test
use std::core::iter

fn max_of(acc: i32, x: i32) -> i32 {
    if x > acc {
        x
    } else {
        acc
    }
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(30)
    v.push(10)
    v.push(50)
    v.push(20)
    v.push(40)
    let result: i32 = v.iter().fold(0, max_of)
    Test::assert_eq_i32(result, 50)
}
