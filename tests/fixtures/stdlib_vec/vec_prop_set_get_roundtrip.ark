use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)
    v.set(0, 100)
    match v.get(0) {
        Option::Some(val) => Test::assert_eq_i32(val, 100),
        None => Std::panic("expected Some, got None"),
    }
    v.set(2, 300)
    match v.get(2) {
        Option::Some(val) => Test::assert_eq_i32(val, 300),
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_eq_i32(v.get_unchecked(1), 20)
}
