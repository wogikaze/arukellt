use std::test
use std::prelude::{map_i64_i64}
fn double(x: i64) -> i64 {
    x * 2i64
}

fn main() {
    let mut v: Vec<i64> = Vec::new<i64>()
    let a: i64 = 10i64
    let b: i64 = 20i64
    push(v, a)
    push(v, b)
    let result: Vec<i64> = map_i64_i64(v, double)
    test::assert_eq_i32(len(result), 2)
    test::assert_eq_i64(get_unchecked(result, 0), 20i64)
    test::assert_eq_i64(get_unchecked(result, 1), 40i64)
}
