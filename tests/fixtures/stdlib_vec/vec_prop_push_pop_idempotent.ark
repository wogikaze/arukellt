use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)
    let len_before: i32 = v.len()
    match pop(v) {
        Option::Some(_) => {
        },
        None => Std::panic("expected Some, got None"),
    }
    push(v, 30)
    Test::assert_eq_i32(v.len(), len_before)
    Test::assert_eq_i32(get_unchecked(v, 0), 10)
    Test::assert_eq_i32(get_unchecked(v, 1), 20)
    Test::assert_eq_i32(get_unchecked(v, 2), 30)
}
