use std::test::Test
use std::core::iter

fn double(x: i32) -> i32 {
    x * 2
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 42)
    let result: Vec<i32> = v.iter().map(double).collect()
    Test::assert_eq_i32(len(result), 1)
    Test::assert_eq_i32(get_unchecked(result, 0), 84)
}
