use std::test::Test
use std::core::iter
fn is_positive(x: i32) -> bool {
    x > 0
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    let result: Vec<i32> = v.iter().filter(is_positive).collect()
    Test::assert_eq_i32(result.len(), 3)
    Test::assert_eq_i32(result.get_unchecked(0), 1)
    Test::assert_eq_i32(result.get_unchecked(1), 2)
    Test::assert_eq_i32(result.get_unchecked(2), 3)
}
