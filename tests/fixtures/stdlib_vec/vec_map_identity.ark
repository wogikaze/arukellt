use std::test::Test
use std::core::iter

fn identity(x: i32) -> i32 {
    x
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)
    let result: Vec<i32> = v.iter().map(identity).collect()
    Test::assert_eq_i32(result.len(), 3)
    Test::assert_eq_i32(result.get_unchecked(0), 10)
    Test::assert_eq_i32(result.get_unchecked(1), 20)
    Test::assert_eq_i32(result.get_unchecked(2), 30)
}
