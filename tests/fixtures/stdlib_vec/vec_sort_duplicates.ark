use std::test::Test
use std::collections::vec
use std::core
use std::core::cmp

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(30)
    v.push(10)
    v.push(30)
    v.push(10)
    v.push(20)
    v.sort_by(ascending)
    Test::assert_eq_i32(v.get_unchecked(0), 10)
    Test::assert_eq_i32(v.get_unchecked(1), 10)
    Test::assert_eq_i32(v.get_unchecked(2), 20)
    Test::assert_eq_i32(v.get_unchecked(3), 30)
    Test::assert_eq_i32(v.get_unchecked(4), 30)
}
