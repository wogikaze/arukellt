use std::test
use std::collections::vec
use std::core
use std::core::cmp

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 30)
    push(v, 10)
    push(v, 30)
    push(v, 10)
    push(v, 20)
    v.sort_by(ascending)
    test::assert_eq_i32(get_unchecked(v, 0), 10)
    test::assert_eq_i32(get_unchecked(v, 1), 10)
    test::assert_eq_i32(get_unchecked(v, 2), 20)
    test::assert_eq_i32(get_unchecked(v, 3), 30)
    test::assert_eq_i32(get_unchecked(v, 4), 30)
}
