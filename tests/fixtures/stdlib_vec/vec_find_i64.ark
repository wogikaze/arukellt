use std::test

fn is_hundred(x: i64) -> bool {
    x == 100
}

fn find_hundred(v: Vec<i64>) -> Option<i64> {
    // Inline find: prelude find_i64 still produces invalid GC wasm (#807).
    let n = len(v)
    let mut i = 0
    while i < n {
        let x = get_unchecked(v, i)
        if is_hundred(x) {
            return Some(x)
        }
        i = i + 1
    }
    None
}

fn main() {
    let mut v: Vec<i64> = Vec_new_i64()
    let a: i64 = 50
    let b: i64 = 100
    let c: i64 = 150
    push(v, a)
    push(v, b)
    push(v, c)
    let result = find_hundred(v)
    match result {
        Option::Some(val) => test::assert_eq_i64(val, 100),
        None => panic("expected Some, got None"),
    }
}
