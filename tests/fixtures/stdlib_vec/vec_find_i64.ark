use std::test::Test

fn is_hundred(x: i64) -> bool {
    x == 100i64
}

fn find_hundred(v: Vec<i64>) -> Option<i64> {
    // Inline find: prelude find_i64 still produces invalid GC wasm (#807).
    let n = v.len()
    let mut i = 0
    while i < n {
        let x = get_unchecked(v, i)
        if is_hundred(x) {
            return Some(x)
        }
        i = i + 1
    }
    None
}

fn main() {
    let mut v: Vec<i64> = Vec::new<i64>()
    let a: i64 = 50i64
    let b: i64 = 100i64
    let c: i64 = 150i64
    v.push(a)
    v.push(b)
    v.push(c)
    let result = find_hundred(v)
    match result {
        Option::Some(val) => Test::assert_eq_i64(val, 100i64),
        None => Std::panic("expected Some, got None"),
    }
}
