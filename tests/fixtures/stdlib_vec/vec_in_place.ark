// Vec<T> in-place operations: retain, truncate, resize, append, extend,
// drain, and splice.
use std::collections::vec
use std::host::stdio

fn is_even(value: i32) -> bool {
    value % 2 == 0
}

fn print_values(values: Vec<i32>) {
    let mut i: i32 = 0
    while i < len(values) {
        stdio::println((get_unchecked(values, i)).to_string())
        i = i + 1
    }
}

fn main() {
    let mut retained: Vec<i32> = Vec::new<i32>()
    push(retained, 1)
    push(retained, 2)
    push(retained, 3)
    push(retained, 4)
    retained.retain(is_even)
    stdio::println((len(retained)).to_string())
    print_values(retained)

    let mut truncated: Vec<i32> = Vec::new<i32>()
    push(truncated, 1)
    push(truncated, 2)
    push(truncated, 3)
    truncated.truncate(2)
    stdio::println((len(truncated)).to_string())
    print_values(truncated)
    truncated.truncate(0 - 1)
    stdio::println((len(truncated)).to_string())
    truncated.truncate(5)
    stdio::println((len(truncated)).to_string())

    let mut resized: Vec<i32> = Vec::new<i32>()
    push(resized, 1)
    push(resized, 2)
    resized.resize(4, 9)
    stdio::println((len(resized)).to_string())
    print_values(resized)
    resized.resize(1, 0)
    stdio::println((len(resized)).to_string())
    print_values(resized)

    let mut appended: Vec<i32> = Vec::new<i32>()
    push(appended, 1)
    push(appended, 2)
    let mut append_source: Vec<i32> = Vec::new<i32>()
    push(append_source, 3)
    push(append_source, 4)
    appended.append(append_source)
    stdio::println((len(appended)).to_string())
    stdio::println((len(append_source)).to_string())
    print_values(appended)

    let mut extended: Vec<i32> = Vec::new<i32>()
    push(extended, 1)
    push(extended, 2)
    let mut extend_source: Vec<i32> = Vec::new<i32>()
    push(extend_source, 3)
    push(extend_source, 4)
    extended.extend(extend_source)
    stdio::println((len(extended)).to_string())
    stdio::println((len(extend_source)).to_string())
    print_values(extended)

    let mut drained: Vec<i32> = Vec::new<i32>()
    push(drained, 10)
    push(drained, 20)
    push(drained, 30)
    push(drained, 40)
    push(drained, 50)
    let removed: Vec<i32> = drained.drain(1, 3)
    stdio::println((len(removed)).to_string())
    print_values(removed)
    print_values(drained)
    let empty_range: Vec<i32> = drained.drain(2, 1)
    stdio::println((len(empty_range)).to_string())
    print_values(drained)

    let mut spliced: Vec<i32> = Vec::new<i32>()
    push(spliced, 1)
    push(spliced, 2)
    push(spliced, 3)
    push(spliced, 4)
    push(spliced, 5)
    let mut replacement: Vec<i32> = Vec::new<i32>()
    push(replacement, 8)
    push(replacement, 9)
    let replaced: Vec<i32> = spliced.splice(1, 3, replacement)
    stdio::println((len(replaced)).to_string())
    print_values(replaced)
    print_values(spliced)

    let empty_replacement: Vec<i32> = Vec::new<i32>()
    let no_change: Vec<i32> = spliced.splice(2, 2, empty_replacement)
    stdio::println((len(no_change)).to_string())

    let mut tail: Vec<i32> = Vec::new<i32>()
    push(tail, 7)
    let removed_tail: Vec<i32> = spliced.splice(5, 5, tail)
    stdio::println((len(removed_tail)).to_string())
    print_values(spliced)

    let mut head: Vec<i32> = Vec::new<i32>()
    push(head, 0)
    let removed_head: Vec<i32> = spliced.splice(0 - 3, 0, head)
    stdio::println((len(removed_head)).to_string())
    print_values(spliced)
}
