use std::test::Test

fn add(acc: f64, x: f64) -> f64 {
    acc + x
}

fn main() {
    let mut v: Vec<f64> = Vec::new<f64>()
    push(v, 1.5)
    push(v, 2.5)
    push(v, 3.0)
    let mut result: f64 = 0.0
    let mut fold_index: i32 = 0
    while fold_index < v.len() {
        result = add(result, get_unchecked(v, fold_index))
        fold_index = fold_index + 1
    }
    Test::assert_eq_f64(result, 7.0)
}
