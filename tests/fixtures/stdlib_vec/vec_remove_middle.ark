use std::test::Test
use std::collections::vec

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)
    v.push(50)
    v.drain(2, 2 + 1)
    Test::assert_eq_i32(v.len(), 4)
    Test::assert_eq_i32(get_unchecked(v, 0), 10)
    Test::assert_eq_i32(get_unchecked(v, 1), 20)
    Test::assert_eq_i32(get_unchecked(v, 2), 40)
    Test::assert_eq_i32(get_unchecked(v, 3), 50)
}
