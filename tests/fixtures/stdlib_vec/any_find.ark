use std::test::Test
use std::core::iter

fn is_even(x: i32) -> bool {
    x % 2 == 0
}

fn is_negative(x: i32) -> bool {
    x < 0
}

fn main() {
    let mut v = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    let has_even: bool = v.iter().any(is_even)
    Test::assert_true(has_even)

    let found = v.iter().find(is_even)
    match found {
        Option::Some(x) => Test::assert_eq_i32(x, 2),
        None => Std::panic("expected Some, got None"),
    }

    let empty = Vec::new<i32>()
    let any_empty: bool = empty.iter().any(is_even)
    Test::assert_false(any_empty)

    let find_neg = v.iter().find(is_negative)
    match find_neg {
        Option::Some(x) => Std::panic("expected None, got Some"),
        None => {
        },
    }
}
