use std::test::Test

fn is_large(x: f64) -> bool {
    x > 2.5
}

fn main() {
    let mut v: Vec<f64> = Vec::new<f64>()
    push(v, 1.0)
    push(v, 2.0)
    push(v, 3.0)
    push(v, 4.0)
    let mut result: Vec<f64> = Vec::new<f64>()
    let mut filter_index: i32 = 0
    while filter_index < v.len() {
        let filter_value = v.get_unchecked(filter_index)
        if is_large(filter_value) {
            push(result, filter_value)
        }
        filter_index = filter_index + 1
    }
    Test::assert_eq_i32(result.len(), 2)
    Test::assert_eq_f64(result.get_unchecked(0), 3.0)
    Test::assert_eq_f64(result.get_unchecked(1), 4.0)
}
