use std::test::Test
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 99)
    match pop(v) {
        Option::Some(val) => Test::assert_eq_i32(val, 99),
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_eq_i32(len(v), 0)
    Test::assert_true(v.is_empty())
}
