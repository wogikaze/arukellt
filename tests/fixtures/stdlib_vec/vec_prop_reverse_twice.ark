use std::test::Test
use std::core::iter

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5)
    v = v.iter().rev().collect()
    v = v.iter().rev().collect()
    Test::assert_eq_i32(v.get_unchecked(0), 1)
    Test::assert_eq_i32(v.get_unchecked(1), 2)
    Test::assert_eq_i32(v.get_unchecked(2), 3)
    Test::assert_eq_i32(v.get_unchecked(3), 4)
    Test::assert_eq_i32(v.get_unchecked(4), 5)
}
