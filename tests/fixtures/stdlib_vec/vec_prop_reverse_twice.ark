use std::test
use std::core::iter

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5)
    v = v.iter().rev().collect()
    v = v.iter().rev().collect()
    test::assert_eq_i32(get_unchecked(v, 0), 1)
    test::assert_eq_i32(get_unchecked(v, 1), 2)
    test::assert_eq_i32(get_unchecked(v, 2), 3)
    test::assert_eq_i32(get_unchecked(v, 3), 4)
    test::assert_eq_i32(get_unchecked(v, 4), 5)
}
