use std::test::Test
use std::collections::vec
use std::test

fn main() {
    let mut v: Vec<i64> = Vec::new<i64>()
    let a: i64 = 30i64
    let b: i64 = 10i64
    let c: i64 = 20i64
    push(v, a)
    push(v, b)
    push(v, c)
    v.sort()
    Test::assert_eq_i64(v.get_unchecked(0), 10i64)
    Test::assert_eq_i64(v.get_unchecked(1), 20i64)
    Test::assert_eq_i64(v.get_unchecked(2), 30i64)
}
