use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < 100 {
        v.push(i)
        i = i + 1
    }
    let mut j: i32 = 0
    while j < 50 {
        match v.pop() {
            Option::Some(val) => Test::assert_eq_i32(val, 99 - j),
            None => Std::panic("expected Some, got None"),
        }
        j = j + 1
    }
    Test::assert_eq_i32(v.len(), 50)
    Test::assert_eq_i32(get_unchecked(v, 0), 0)
    Test::assert_eq_i32(get_unchecked(v, 49), 49)
}
