use std::test::Test
use std::core::iter

fn double(x: i32) -> i32 {
    x * 2
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    let doubled: Vec<i32> = v.iter().map(double).collect()
    Test::assert_eq_i32(doubled.len(), 3)
    Test::assert_eq_i32(doubled.get_unchecked(0), 2)
    Test::assert_eq_i32(doubled.get_unchecked(1), 4)
    Test::assert_eq_i32(doubled.get_unchecked(2), 6)
}
