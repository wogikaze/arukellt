use std::test::Test
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(42)
    Test::assert_eq_i32(v.len(), 1)
    Test::assert_false(v.is_empty())
    Test::assert_eq_i32(v.get_unchecked(0), 42)
    match v.get(0) {
        Option::Some(val) => Test::assert_eq_i32(val, 42),
        None => Std::panic("expected Some, got None"),
    }
    match v.pop() {
        Option::Some(val) => Test::assert_eq_i32(val, 42),
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_eq_i32(v.len(), 0)
    Test::assert_true(v.is_empty())
}
