use std::test::Test
use std::collections::vec
use std::core
use std::core::cmp

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 30)
    push(v, 10)
    push(v, 50)
    push(v, 20)
    push(v, 40)
    v.sort_by(ascending)
    Test::assert_eq_i32(v.len(), 5)
    Test::assert_eq_i32(get_unchecked(v, 0), 10)
    Test::assert_eq_i32(get_unchecked(v, 1), 20)
    Test::assert_eq_i32(get_unchecked(v, 2), 30)
    Test::assert_eq_i32(get_unchecked(v, 3), 40)
    Test::assert_eq_i32(get_unchecked(v, 4), 50)
}
