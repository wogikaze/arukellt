use std::test::Test

fn add(acc: i64, x: i64) -> i64 {
    acc + x
}

fn main() {
    let mut v: Vec<i64> = Vec::new<i64>()
    let a: i64 = 10i64
    let b: i64 = 20i64
    let c: i64 = 30i64
    push(v, a)
    push(v, b)
    push(v, c)
    let mut result: i64 = 0i64
    let mut fold_index: i32 = 0
    while fold_index < v.len() {
        result = add(result, get_unchecked(v, fold_index))
        fold_index = fold_index + 1
    }
    Test::assert_eq_i64(result, 60i64)
}
