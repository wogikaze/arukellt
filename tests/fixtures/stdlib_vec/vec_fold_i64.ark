use std::test
use std::prelude::{fold_i64_i64}
fn add(acc: i64, x: i64) -> i64 {
    acc + x
}

fn main() {
    let mut v: Vec<i64> = Vec::new<i64>()
    let a: i64 = 10i64
    let b: i64 = 20i64
    let c: i64 = 30i64
    push(v, a)
    push(v, b)
    push(v, c)
    let result: i64 = fold_i64_i64(v, 0i64, add)
    test::assert_eq_i64(result, 60i64)
}
