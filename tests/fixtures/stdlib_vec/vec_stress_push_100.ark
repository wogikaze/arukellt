use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < 100 {
        v.push(i * 2)
        i = i + 1
    }
    Test::assert_eq_i32(v.len(), 100)
    Test::assert_eq_i32(get_unchecked(v, 0), 0)
    Test::assert_eq_i32(get_unchecked(v, 50), 100)
    Test::assert_eq_i32(get_unchecked(v, 99), 198)
}
