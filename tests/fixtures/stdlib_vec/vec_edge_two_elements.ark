use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    Test::assert_eq_i32(v.len(), 2)
    Test::assert_eq_i32(v.get_unchecked(0), 10)
    Test::assert_eq_i32(v.get_unchecked(1), 20)
    set(v, 0, 100)
    set(v, 1, 200)
    Test::assert_eq_i32(v.get_unchecked(0), 100)
    Test::assert_eq_i32(v.get_unchecked(1), 200)
}
