use std::prelude::{get, len, pop, push}
use std::test::Test

fn items_len<T>(items: Vec<T>) -> i32 {
    len(items)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    Test::assert_eq_i32(len(v), 2)
    match get(v, 0) {
        Option::Some(value) => Test::assert_eq_i32(value, 10),
        None => Std::panic("expected Some, got None"),
    }
    match pop(v) {
        Option::Some(value) => Test::assert_eq_i32(value, 20),
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_eq_i32(len(v), 1)
    Test::assert_eq_i32(items_len(v), 1)
    let empty_words: Vec<String> = Vec::new<String>()
    Test::assert_eq_i32(items_len(empty_words), 0)
    let s: String = String_from("hello")
    Test::assert_eq_i32(len(s), 5)
}
