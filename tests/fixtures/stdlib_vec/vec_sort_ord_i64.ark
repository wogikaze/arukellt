// Vec<T: Ord> algorithms with an i64 element type. The generic merge-sort
// scratch buffer, the Ord::cmp dispatch, and quickselect must all keep the
// i64 GC array layout instead of falling back to the i32 vec (#965).
use std::collections::vec
use std::host::stdio::Stdio

fn show(values: Vec<i64>) {
    let mut index: i32 = 0
    while index < values.len() {
        Stdio::println(values.get_unchecked(index).to_string())
        index = index + 1
    }
}

fn main() {
    let mut values: Vec<i64> = Vec::new<i64>()
    values.push(50i64)
    values.push(30i64)
    values.push(10i64)
    values.push(20i64)
    values.push(10i64)
    Stdio::println(values.is_sorted().to_string())
    values.sort()
    Stdio::println(values.is_sorted().to_string())
    show(values)

    let mut unstable: Vec<i64> = Vec::new<i64>()
    unstable.push(9i64)
    unstable.push(7i64)
    unstable.push(8i64)
    unstable.push(6i64)
    unstable.push(5i64)
    unstable.sort_unstable()
    show(unstable)

    let mut selection: Vec<i64> = Vec::new<i64>()
    selection.push(40i64)
    selection.push(10i64)
    selection.push(30i64)
    selection.push(20i64)
    selection.push(50i64)
    selection.select_nth(2)
    Stdio::println(selection.get_unchecked(2).to_string())
    let mut before_ok: bool = true
    let mut before: i32 = 0
    while before < 2 {
        if selection.get_unchecked(before) > selection.get_unchecked(2) {
            before_ok = false
        }
        before = before + 1
    }
    let mut after_ok: bool = true
    let mut after: i32 = 3
    while after < selection.len() {
        if selection.get_unchecked(after) < selection.get_unchecked(2) {
            after_ok = false
        }
        after = after + 1
    }
    Stdio::println(before_ok.to_string())
    Stdio::println(after_ok.to_string())

    let mut empty: Vec<i64> = Vec::new<i64>()
    empty.sort()
    empty.select_nth(0)
    Stdio::println(empty.is_sorted().to_string())

    let mut single: Vec<i64> = Vec::new<i64>()
    single.push(42i64)
    single.sort_unstable()
    Stdio::println(single.get_unchecked(0).to_string())
}
