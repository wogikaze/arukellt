use std::test::Test
use std::prelude::{filter_i32}
fn is_even(x: i32) -> bool {
    x % 2 == 0
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)
    let evens: Vec<i32> = filter_i32(v, is_even)
    Test::assert_eq_i32(evens.len(), 2)
    Test::assert_eq_i32(get_unchecked(evens, 0), 2)
    Test::assert_eq_i32(get_unchecked(evens, 1), 4)
}
