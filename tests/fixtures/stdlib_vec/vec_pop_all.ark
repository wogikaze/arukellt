use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)
    match pop(v) {
        Option::Some(val) => Test::assert_eq_i32(val, 30),
        None => Std::panic("expected Some, got None"),
    }
    match pop(v) {
        Option::Some(val) => Test::assert_eq_i32(val, 20),
        None => Std::panic("expected Some, got None"),
    }
    match pop(v) {
        Option::Some(val) => Test::assert_eq_i32(val, 10),
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_eq_i32(v.len(), 0)
}
