use std::test::Test
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    match v.pop() {
        Option::Some(_) => {
        },
        None => Std::panic("expected Some, got None"),
    }
    match v.pop() {
        Option::Some(_) => {
        },
        None => Std::panic("expected Some, got None"),
    }
    match v.pop() {
        Option::Some(_) => {
        },
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_true(v.is_empty())
}
