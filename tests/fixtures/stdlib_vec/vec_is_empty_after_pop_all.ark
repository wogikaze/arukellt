use std::test::Test
use std::prelude::{is_empty}
fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    match pop(v) {
        Option::Some(_) => {
        },
        None => Std::panic("expected Some, got None"),
    }
    match pop(v) {
        Option::Some(_) => {
        },
        None => Std::panic("expected Some, got None"),
    }
    match pop(v) {
        Option::Some(_) => {
        },
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_true(is_empty(v))
}
