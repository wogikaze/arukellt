use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    set(v, 0, 10)
    set(v, 1, 20)
    set(v, 2, 30)
    Test::assert_eq_i32(v.get_unchecked(0), 10)
    Test::assert_eq_i32(v.get_unchecked(1), 20)
    Test::assert_eq_i32(v.get_unchecked(2), 30)
}
