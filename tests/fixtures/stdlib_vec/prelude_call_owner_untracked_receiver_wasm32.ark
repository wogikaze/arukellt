// The if-expression result below is a Vec<i32> the checker resolves, but its
// MIR local keeps no element type on the linear target. `len` and `pop` must
// bind the owner-qualified CoreOps from the checker's per-call resolution,
// not from the receiver's local type spelling (#933 / #936).
use std::host::stdio::Stdio
use std::prelude::{get, pop, push}
use std::test::Test

fn main() {
    let mut first: Vec<i32> = Vec::new<i32>()
    push(first, 1)
    let mut second: Vec<i32> = Vec::new<i32>()
    push(second, 2)
    push(second, 3)
    push(second, 4)
    let mut values = if first.len() > 0 { second } else { first }
    Test::assert_eq_i32(values.len(), 3)
    push(values, 9)
    Test::assert_eq_i32(values.len(), 4)
    match get(values, 0) {
        Option::Some(value) => Test::assert_eq_i32(value, 2),
        None => Std::panic("expected Some, got None"),
    }
    match pop(values) {
        Option::Some(value) => Test::assert_eq_i32(value, 9),
        None => Std::panic("expected Some, got None"),
    }
    Test::assert_eq_i32(values.len(), 3)
    Stdio::println("prelude call owner untracked receiver ok")
}
