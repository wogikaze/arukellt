use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    match v.pop() {
        Option::Some(val) => Test::assert_eq_i32(val, 20),
        None => Std::panic("expected Some, got None"),
    }
    v.push(30)
    Test::assert_eq_i32(v.len(), 2)
    Test::assert_eq_i32(v.get_unchecked(0), 10)
    Test::assert_eq_i32(v.get_unchecked(1), 30)
}
