use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("[parent]\nname = \"p\"\n[parent.child]\nname = \"c\"")
    match t {
        Result::Ok(table) => match table.get_field("parent") {
            Option::Some(p) => {
                match p.get_field("name") {
                    Option::Some(v) => match v.as_string() {
                        Option::Some(s) => test::assert_eq_string(s, "p"),
                        None => assert(false),
                    },
                    None => assert(false),
                }
                match p.get_field("child") {
                    Option::Some(c) => match c.get_field("name") {
                        Option::Some(v) => match v.as_string() {
                            Option::Some(s) => test::assert_eq_string(s, "c"),
                            None => assert(false),
                        },
                        None => assert(false),
                    },
                    None => assert(false),
                }
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// [parent] then [parent.child] preserves parent fields
