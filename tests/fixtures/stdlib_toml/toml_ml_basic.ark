use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::toml_parse("val = \"\"\"line1\nline2\"\"\"")
    match t {
        Result::Ok(table) => match table.get_field("val") {
            Option::Some(v) => match v.as_string() {
                Option::Some(s) => test::assert_eq_string(s, "line1\nline2"),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// multiline basic string preserves embedded newlines
