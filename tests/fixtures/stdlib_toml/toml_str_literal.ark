use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("path = 'C:\\Users\\dev'")
    match t {
        Result::Ok(table) => match table.get_field("path") {
            Option::Some(v) => match v.as_string() {
                Option::Some(s) => Test::assert_eq_string(s, "C:\\Users\\dev"),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// literal single-quoted string preserves backslashes verbatim
