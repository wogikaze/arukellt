use std::host::stdio
use std::toml
use std::text
fn main() {
    let doc = "name = \"arukellt\"\nversion = \"0.1.0\"\nenabled = true\ncount = 42"
    match toml::toml_parse(doc) {
        Result::Ok(table) => {
            match table.get_field("name") {
                Option::Some(v) => {
                    match v.as_string() {
                        Option::Some(s) => stdio::println(s),
                        None => stdio::println("not string"),
                    }
                },
                None => stdio::println("key not found"),
            }
            match table.get_field("enabled") {
                Option::Some(v) => {
                    match v.as_bool() {
                        Option::Some(b) => stdio::println((b).to_string()),
                        None => stdio::println("not bool"),
                    }
                },
                None => stdio::println("key not found"),
            }
            match table.get_field("count") {
                Option::Some(v) => {
                    match v.as_int() {
                        Option::Some(n) => stdio::println((n).to_string()),
                        None => stdio::println("not int"),
                    }
                },
                None => stdio::println("key not found"),
            }
            let keys = table.table_keys()
            stdio::println((len(keys)).to_string())
        },
        Result::Err(e) => stdio::println("error:".concat(e)),
    }
}
// toml_parse recognises a valid key=value document
// toml_get extracts individual fields
// toml_table_keys returns the key list
