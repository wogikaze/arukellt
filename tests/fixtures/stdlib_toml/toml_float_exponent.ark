use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("val = 5e3")
    match t {
        Result::Ok(table) => match table.get_field("val") {
            Option::Some(v) => match v.as_float() {
                Option::Some(f) => Test::assert_eq_f64(f, 5000.0),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// float with exponent parses to Float
