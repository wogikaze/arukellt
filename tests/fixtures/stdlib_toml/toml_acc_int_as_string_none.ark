use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("n = 5")
    match t {
        Result::Ok(table) => match table.get_field("n") {
            Option::Some(v) => match v.as_string() {
                Option::Some(_) => assert(false),
                None => {},
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// toml_as_string on an Integer returns None
