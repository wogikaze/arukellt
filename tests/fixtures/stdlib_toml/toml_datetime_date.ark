use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("d = 1979-05-27")
    match t {
        Result::Ok(table) => match table.get_field("d") {
            Option::Some(v) => match v.as_string() {
                Option::Some(s) => Test::assert_eq_string(s, "1979-05-27"),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// date literal YYYY-MM-DD stored as String
