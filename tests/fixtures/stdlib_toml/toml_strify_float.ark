use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("f = 1.5")
    match t {
        Result::Ok(table) => match table.get_field("f") {
            Option::Some(v) => Test::assert_eq_string(v.to_text(), "1.5"),
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// toml_stringify on Float produces decimal text
