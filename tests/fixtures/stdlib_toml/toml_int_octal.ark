use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("val = 0o17")
    match t {
        Result::Ok(table) => match table.get_field("val") {
            Option::Some(v) => match v.as_int() {
                Option::Some(n) => Test::assert_eq_i32(n, 15),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// octal integer 0o17 parses to 15
