use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("cfg = {}")
    match t {
        Result::Ok(table) => match table.get_field("cfg") {
            Option::Some(cfg) => {
                let keys = cfg.table_keys()
                Test::assert_eq_i32(len(keys), 0)
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// empty inline table {} parses to empty table
