use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("m = [[1, 2], [3, 4]]")
    match t {
        Result::Ok(table) => match table.get_field("m") {
            Option::Some(v) => match v.as_array() {
                Option::Some(arr) => {
                    test::assert_eq_i32(len(arr), 2)
                    let first: toml::TomlValue = get_unchecked(arr, 0)
                    let nested: Option<Vec<toml::TomlValue>> = first.as_array()
                    match nested {
                        Option::Some(inner) => test::assert_eq_i32(len(inner), 2),
                        None => assert(false),
                    }
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// nested array of arrays parses
