use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("m = [[1, 2], [3, 4]]")
    match t {
        Result::Ok(table) => match table.get_field("m") {
            Option::Some(v) => match v {
                toml::TomlValue::Array(rows) => {
                    Test::assert_eq_i32(rows.len(), 2)
                    match rows.get(0) {
                        Option::Some(first) => match first {
                            toml::TomlValue::Array(inner) => Test::assert_eq_i32(inner.len(), 2),
                            _ => assert(false),
                        },
                        Option::None => assert(false),
                    }
                },
                _ => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// nested array of arrays parses
