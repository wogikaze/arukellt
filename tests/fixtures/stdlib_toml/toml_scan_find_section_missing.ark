use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let content = "[server]\nhost = \"x\""
    let body = toml::TomlText::find_section(content, "missing")
    Test::assert_eq_string(body, "")
    stdio::println("OK")
}
// find_toml_section returns empty string for missing section
