use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("[[servers]]\nname = \"a\"\n[servers.ports]\nhttp = 80")
    match t {
        Result::Ok(table) => match table.get_field("servers") {
            Option::Some(v) => match v.as_array() {
                Option::Some(arr) => {
                    Test::assert_eq_i32(len(arr), 1)
                    let first = get_unchecked(arr, 0)
                    let ports_opt: Option<toml::TomlValue> = first.get_field("ports")
                    match ports_opt {
                        Option::Some(ports) => {
                            let http_opt: Option<toml::TomlValue> = ports.get_field("http")
                            match http_opt {
                                Option::Some(h) => match h.as_int() {
                                    Option::Some(n) => Test::assert_eq_i32(n, 80),
                                    None => assert(false),
                                },
                                None => assert(false),
                            }
                        },
                        None => assert(false),
                    }
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// [servers.ports] sub-table attaches to last array-of-tables entry
