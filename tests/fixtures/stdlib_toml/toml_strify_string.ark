use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("name = \"hi\"")
    match t {
        Result::Ok(table) => match table.get_field("name") {
            Option::Some(v) => Test::assert_eq_string(v.to_text(), "\"hi\""),
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// toml_stringify on String re-adds surrounding double quotes
