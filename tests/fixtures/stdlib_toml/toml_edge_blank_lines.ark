use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("\n\nname = \"x\"\n\n")
    match t {
        Result::Ok(table) => match table.get_field("name") {
            Option::Some(v) => match v.as_string() {
                Option::Some(s) => test::assert_eq_string(s, "x"),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// blank lines before/after key-value are skipped
