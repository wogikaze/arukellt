use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::toml_parse("[section]\na.b = 5")
    match t {
        Result::Ok(table) => match table.get_field("section") {
            Option::Some(s) => match s.get_field("a") {
                Option::Some(a) => match a.get_field("b") {
                    Option::Some(v) => match v.as_int() {
                        Option::Some(n) => test::assert_eq_i32(n, 5),
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// dotted key inside [section] nests within the section table
