use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("val = -2.5")
    match t {
        Result::Ok(table) => match table.get_field("val") {
            Option::Some(v) => match v.as_float() {
                Option::Some(f) => Test::assert_eq_f64(f, -2.5),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// negative float parses to Float
