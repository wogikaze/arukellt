// Issue #705: Full TOML 1.0 inline tables and dotted keys.
use std::host::stdio::Stdio
use std::toml

fn main() {
    // Inline table
    let input1 = String_from("point = { x = 1, y = 2 }")
    match toml::TomlValue::parse(input1) {
        Result::Ok(table) => {
            match table.get_field(String_from("point")) {
                Option::Some(pt) => {
                    match pt.get_field(String_from("x")) {
                        Option::Some(x) => {
                            match x.as_int() {
                                Option::Some(n) => assert(n == 1),
                                None => assert(false),
                            }
                        },
                        None => assert(false),
                    }
                    match pt.get_field(String_from("y")) {
                        Option::Some(y) => {
                            match y.as_int() {
                                Option::Some(n) => assert(n == 2),
                                None => assert(false),
                            }
                        },
                        None => assert(false),
                    }
                },
                None => assert(false),
            }
        },
        Result::Err(_) => assert(false),
    }

    // Dotted keys
    let input2 = String_from("a.b.c = 42")
    match toml::TomlValue::parse(input2) {
        Result::Ok(table) => {
            match table.get_field(String_from("a")) {
                Option::Some(a) => {
                    match a.get_field(String_from("b")) {
                        Option::Some(b) => {
                            match b.get_field(String_from("c")) {
                                Option::Some(c) => {
                                    match c.as_int() {
                                        Option::Some(n) => assert(n == 42),
                                        None => assert(false),
                                    }
                                },
                                None => assert(false),
                            }
                        },
                        None => assert(false),
                    }
                },
                None => assert(false),
            }
        },
        Result::Err(_) => assert(false),
    }

    // Array of tables
    let input3 = String_from("[[items]]\nname = \"first\"\n[[items]]\nname = \"second\"")
    match toml::TomlValue::parse(input3) {
        Result::Ok(table) => {
            match table.get_field(String_from("items")) {
                Option::Some(arr) => {
                    match arr.as_array() {
                        Option::Some(items) => {
                            assert(items.len() == 2)
                        },
                        None => assert(false),
                    }
                },
                None => assert(false),
            }
        },
        Result::Err(_) => assert(false),
    }

    Stdio::println(String_from("OK"))
}
