use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::toml_parse("val = 1.5e2")
    match t {
        Result::Ok(table) => match table.get_field("val") {
            Option::Some(v) => match v.as_float() {
                Option::Some(f) => test::assert_eq_f64(f, 150.0),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// float with dot and exponent parses (1.5e2 -> 150.0)
