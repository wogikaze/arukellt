use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("meta = { name = \"tom\", role = \"admin\" }")
    match t {
        Result::Ok(table) => match table.get_field("meta") {
            Option::Some(m) => match m.get_field("name") {
                Option::Some(v) => match v.as_string() {
                    Option::Some(s) => test::assert_eq_string(s, "tom"),
                    None => assert(false),
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// inline table with string values parses
