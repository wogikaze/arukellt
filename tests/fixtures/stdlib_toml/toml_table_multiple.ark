use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("[a]\nx = 1\n[b]\ny = 2")
    match t {
        Result::Ok(table) => {
            let keys = table.table_keys()
            test::assert_eq_i32(len(keys), 2)
            match table.get_field("a") {
                Option::Some(a) => match a.get_field("x") {
                    Option::Some(v) => match v.as_int() {
                        Option::Some(n) => test::assert_eq_i32(n, 1),
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            }
            match table.get_field("b") {
                Option::Some(b) => match b.get_field("y") {
                    Option::Some(v) => match v.as_int() {
                        Option::Some(n) => test::assert_eq_i32(n, 2),
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            }
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// multiple [table] headers produce separate top-level keys
