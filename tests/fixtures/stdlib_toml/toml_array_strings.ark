use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("names = [\"a\", \"b\"]")
    match t {
        Result::Ok(table) => match table.get_field("names") {
            Option::Some(v) => match v.as_array() {
                Option::Some(arr) => {
                    Test::assert_eq_i32(arr.len(), 2)
                    let first: toml::TomlValue = get_unchecked(arr, 0)
                    let first_text: Option<String> = first.as_string()
                    match first_text {
                        Option::Some(s) => Test::assert_eq_string(s, "a"),
                        None => assert(false),
                    }
                    let second: toml::TomlValue = get_unchecked(arr, 1)
                    let second_text: Option<String> = second.as_string()
                    match second_text {
                        Option::Some(s) => Test::assert_eq_string(s, "b"),
                        None => assert(false),
                    }
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// array of strings parses with correct element values
