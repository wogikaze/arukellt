use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::toml_parse("[a.b.c]\nval = 7")
    match t {
        Result::Ok(table) => match table.get_field("a") {
            Option::Some(a) => match a.get_field("b") {
                Option::Some(b) => match b.get_field("c") {
                    Option::Some(c) => match c.get_field("val") {
                        Option::Some(v) => match v.as_int() {
                            Option::Some(n) => test::assert_eq_i32(n, 7),
                            None => assert(false),
                        },
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// dotted table header [a.b.c] creates nested tables
