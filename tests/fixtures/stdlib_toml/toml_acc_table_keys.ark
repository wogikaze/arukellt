use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("a = 1\nb = 2\nc = 3")
    match t {
        Result::Ok(table) => {
            let keys = table.table_keys()
            Test::assert_eq_i32(keys.len(), 3)
            Test::assert_eq_string(keys.get_unchecked(0), "a")
            Test::assert_eq_string(keys.get_unchecked(1), "b")
            Test::assert_eq_string(keys.get_unchecked(2), "c")
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// toml_table_keys returns all keys in order
