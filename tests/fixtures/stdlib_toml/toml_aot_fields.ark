use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("[[items]]\nname = \"first\"\nid = 1\n[[items]]\nname = \"second\"\nid = 2")
    match t {
        Result::Ok(table) => match table.get_field("items") {
            Option::Some(v) => match v.as_array() {
                Option::Some(arr) => {
                    Test::assert_eq_i32(arr.len(), 2)
                    let first = get_unchecked(arr, 0)
                    let id_opt: Option<toml::TomlValue> = first.get_field("id")
                    match id_opt {
                        Option::Some(id) => match id.as_int() {
                            Option::Some(n) => Test::assert_eq_i32(n, 1),
                            None => assert(false),
                        },
                        None => assert(false),
                    }
                    let second = get_unchecked(arr, 1)
                    let name_opt: Option<toml::TomlValue> = second.get_field("name")
                    match name_opt {
                        Option::Some(nm) => match nm.as_string() {
                            Option::Some(s) => Test::assert_eq_string(s, "second"),
                            None => assert(false),
                        },
                        None => assert(false),
                    }
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// array-of-tables entries preserve their individual fields
