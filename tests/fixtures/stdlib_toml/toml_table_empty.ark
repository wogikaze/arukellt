use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("[empty]")
    match t {
        Result::Ok(table) => match table.get_field("empty") {
            Option::Some(e) => {
                let keys = e.table_keys()
                Test::assert_eq_i32(keys.len(), 0)
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// empty [table] header creates a table with no fields
