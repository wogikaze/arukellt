use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::toml_parse("my-key = 1")
    match t {
        Result::Ok(table) => match table.get_field("my-key") {
            Option::Some(v) => match v.as_int() {
                Option::Some(n) => test::assert_eq_i32(n, 1),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// bare key with hyphen parses
