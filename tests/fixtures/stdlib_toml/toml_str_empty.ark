use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("name = \"\"")
    match t {
        Result::Ok(table) => match table.get_field("name") {
            Option::Some(v) => match v.as_string() {
                Option::Some(s) => Test::assert_eq_string(s, ""),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// empty basic string parses to empty String
