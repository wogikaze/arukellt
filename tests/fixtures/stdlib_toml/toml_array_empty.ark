use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("vals = []")
    match t {
        Result::Ok(table) => match table.get_field("vals") {
            Option::Some(v) => match v.as_array() {
                Option::Some(arr) => Test::assert_eq_i32(len(arr), 0),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// empty array [] parses to zero-length array
