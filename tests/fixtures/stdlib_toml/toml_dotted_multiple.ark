use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("a.x = 1\na.y = 2")
    match t {
        Result::Ok(table) => match table.get_field("a") {
            Option::Some(a) => {
                match a.get_field("x") {
                    Option::Some(v) => match v.as_int() {
                        Option::Some(n) => test::assert_eq_i32(n, 1),
                        None => assert(false),
                    },
                    None => assert(false),
                }
                match a.get_field("y") {
                    Option::Some(v) => match v.as_int() {
                        Option::Some(n) => test::assert_eq_i32(n, 2),
                        None => assert(false),
                    },
                    None => assert(false),
                }
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// multiple dotted keys sharing prefix create one table
