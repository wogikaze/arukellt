use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("val = '''a\\b'''")
    match t {
        Result::Ok(table) => match table.get_field("val") {
            Option::Some(v) => match v.as_string() {
                Option::Some(s) => test::assert_eq_string(s, "a\\b"),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// multiline literal string preserves backslashes verbatim (no escapes)
