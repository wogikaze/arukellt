use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("val = \"\\u0041\"")
    match t {
        Result::Ok(table) => match table.get_field("val") {
            Option::Some(v) => match v.as_string() {
                Option::Some(s) => test::assert_eq_string(s, "A"),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// \\u0041 unicode escape decodes to ASCII 'A'
