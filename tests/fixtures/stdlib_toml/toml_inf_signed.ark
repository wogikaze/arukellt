use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("a = +inf\nb = -inf")
    match t {
        Result::Ok(table) => {
            match table.get_field("a") {
                Option::Some(v) => match v.as_string() {
                    Option::Some(s) => Test::assert_eq_string(s, "+inf"),
                    None => assert(false),
                },
                None => assert(false),
            }
            match table.get_field("b") {
                Option::Some(v) => match v.as_string() {
                    Option::Some(s) => Test::assert_eq_string(s, "-inf"),
                    None => assert(false),
                },
                None => assert(false),
            }
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// signed inf variants stored as String
