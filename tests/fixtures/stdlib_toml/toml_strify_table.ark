use std::host::stdio
use std::toml
use std::test::Test
fn main() {
    let t = toml::TomlValue::parse("name = \"x\"\nport = 80")
    match t {
        Result::Ok(table) => {
            let s = table.to_text()
            Test::assert_true(s.contains("name = \"x\""))
            Test::assert_true(s.contains("port = 80"))
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// toml_stringify on Table produces key = value lines
