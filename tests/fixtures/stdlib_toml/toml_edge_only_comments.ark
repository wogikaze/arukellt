use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("# first\n# second\n# third")
    match t {
        Result::Ok(table) => {
            let keys = table.table_keys()
            Test::assert_eq_i32(keys.len(), 0)
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// document with only comments parses to empty table
