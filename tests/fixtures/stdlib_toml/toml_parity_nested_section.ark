use std::host::stdio
use std::toml
use std::test

/// Nested table sections and array-of-tables are accepted by full TOML 1.0.
fn main() {
    let multi = "[database]\nhost = \"localhost\"\nport = 5432\n\n[server]\nhost = \"example.com\""
    match toml::toml_parse(multi) {
        Result::Ok(table) => {
            match toml::toml_get(table, "database") {
                Option::Some(db) => match toml::toml_get(db, "port") {
                    Option::Some(p) => match toml::toml_as_int(p) {
                        Option::Some(n) => test::assert_eq_i32(n, 5432),
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            }
            match toml::toml_get(table, "server") {
                Option::Some(srv) => match toml::toml_get(srv, "host") {
                    Option::Some(h) => match toml::toml_as_string(h) {
                        Option::Some(s) => test::assert_eq_string(s, "example.com"),
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            }
        },
        Result::Err(_) => assert(false),
    }

    let single_section = "[package]\nname = \"arukellt\""
    match toml::toml_parse(single_section) {
        Result::Ok(table) => match toml::toml_get(table, "package") {
            Option::Some(pkg) => match toml::toml_get(pkg, "name") {
                Option::Some(v) => match toml::toml_as_string(v) {
                    Option::Some(s) => test::assert_eq_string(s, "arukellt"),
                    None => assert(false),
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }

    let flat = "host = \"localhost\"\nport = 5432"
    match toml::toml_parse(flat) {
        Result::Ok(_) => stdio::println("OK"),
        Result::Err(_) => assert(false),
    }
}
