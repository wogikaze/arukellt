use std::host::stdio::Stdio
use std::toml
use std::test::Test

/// Nested table sections and array-of-tables are accepted by full TOML 1.0.
fn main() {
    let multi = "[database]\nhost = \"localhost\"\nport = 5432\n\n[server]\nhost = \"example.com\""
    match toml::TomlValue::parse(multi) {
        Result::Ok(table) => {
            match table.get_field("database") {
                Option::Some(db) => match db.get_field("port") {
                    Option::Some(p) => match p.as_int() {
                        Option::Some(n) => Test::assert_eq_i32(n, 5432),
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            }
            match table.get_field("server") {
                Option::Some(srv) => match srv.get_field("host") {
                    Option::Some(h) => match h.as_string() {
                        Option::Some(s) => Test::assert_eq_string(s, "example.com"),
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            }
        },
        Result::Err(_) => assert(false),
    }

    let single_section = "[package]\nname = \"arukellt\""
    match toml::TomlValue::parse(single_section) {
        Result::Ok(table) => match table.get_field("package") {
            Option::Some(pkg) => match pkg.get_field("name") {
                Option::Some(v) => match v.as_string() {
                    Option::Some(s) => Test::assert_eq_string(s, "arukellt"),
                    None => assert(false),
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }

    let flat = "host = \"localhost\"\nport = 5432"
    match toml::TomlValue::parse(flat) {
        Result::Ok(_) => Stdio::println("OK"),
        Result::Err(_) => assert(false),
    }
}
