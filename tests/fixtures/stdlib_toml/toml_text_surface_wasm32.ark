// #917 / ADR-046: TOML text scanning moved onto the TomlText namespace.
use std::test
use std::toml

fn main() {
    test::assert_eq_string(toml::TomlText::parse_line("# c"), "")
    test::assert_true(len(toml::TomlText::parse_line("a = 1")) > 0)
    test::assert_eq_string(toml::TomlText::find_value("a = \"x\"\n", "a"), "x")
    test::assert_eq_string(toml::TomlText::find_section("[s]\na = 1\n", "s"), "a = 1\n")
    test::assert_eq_string(toml::TomlText::find_raw_value("a = [1, 2]\n", "a"), "[1, 2]")
    let arr = toml::TomlText::parse_string_array("[\"x\", \"y\"]")
    test::assert_eq_i32(len(arr), 2)
    test::assert_eq_string(get_unchecked(arr, 0), "x")
    test::assert_eq_string(get_unchecked(arr, 1), "y")
}
