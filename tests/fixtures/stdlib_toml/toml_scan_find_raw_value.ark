use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let content = "allow = [\"W0006\", \"unused-import\"]\ndeny = [\"W0004\"]"
    let allow_raw = toml::TomlText::find_raw_value(content, "allow")
    Test::assert_eq_string(allow_raw, "[\"W0006\", \"unused-import\"]")
    let items = toml::TomlText::parse_string_array(allow_raw)
    Test::assert_eq_i32(items.len(), 2)
    Test::assert_eq_string(items.get_unchecked(0), "W0006")
    Test::assert_eq_string(items.get_unchecked(1), "unused-import")
    Stdio::println("OK")
}
// toml_find_raw_value + toml_parse_string_array handle lint allow arrays
