use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("b = true")
    match t {
        Result::Ok(table) => match table.get_field("b") {
            Option::Some(v) => test::assert_eq_string(v.to_text(), "true"),
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// toml_stringify on Boolean true produces "true"
