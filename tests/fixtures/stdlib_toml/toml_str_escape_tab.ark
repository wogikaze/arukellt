use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("val = \"a\\tb\"")
    match t {
        Result::Ok(table) => match table.get_field("val") {
            Option::Some(v) => match v.as_string() {
                Option::Some(s) => Test::assert_eq_string(s, "a\tb"),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// \\t escape decodes to tab in basic string
