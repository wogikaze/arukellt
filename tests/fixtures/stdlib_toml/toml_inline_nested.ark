use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("outer = { inner = { val = 9 } }")
    match t {
        Result::Ok(table) => match table.get_field("outer") {
            Option::Some(o) => match o.get_field("inner") {
                Option::Some(i) => match i.get_field("val") {
                    Option::Some(v) => match v.as_int() {
                        Option::Some(n) => Test::assert_eq_i32(n, 9),
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// nested inline table parses recursively
