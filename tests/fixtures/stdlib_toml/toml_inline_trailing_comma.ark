use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("p = { x = 1, y = 2, }")
    match t {
        Result::Ok(table) => match table.get_field("p") {
            Option::Some(p) => {
                let keys = p.table_keys()
                test::assert_eq_i32(len(keys), 2)
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// trailing comma in inline table is accepted
