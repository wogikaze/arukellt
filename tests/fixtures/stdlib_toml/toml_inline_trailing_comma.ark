use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("p = { x = 1, y = 2, }")
    match t {
        Result::Ok(table) => match table.get_field("p") {
            Option::Some(p) => {
                let keys = p.table_keys()
                Test::assert_eq_i32(keys.len(), 2)
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// trailing comma in inline table is accepted
