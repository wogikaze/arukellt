use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("n = 42")
    match t {
        Result::Ok(table) => match table.get_field("n") {
            Option::Some(v) => test::assert_eq_string(v.to_text(), "42"),
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// toml_stringify on Integer produces decimal text
