use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("[[items]]\nname = \"only\"")
    match t {
        Result::Ok(table) => match table.get_field("items") {
            Option::Some(v) => match v.as_array() {
                Option::Some(arr) => Test::assert_eq_i32(arr.len(), 1),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// single [[items]] creates array of one table
