use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("t = 07:32:00")
    match t {
        Result::Ok(table) => match table.get_field("t") {
            Option::Some(v) => match v.as_string() {
                Option::Some(s) => Test::assert_eq_string(s, "07:32:00"),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// time literal HH:MM:SS stored as String
