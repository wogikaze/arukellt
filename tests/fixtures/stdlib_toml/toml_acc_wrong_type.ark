use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("s = \"text\"")
    match t {
        Result::Ok(table) => match table.get_field("s") {
            Option::Some(v) => match v.as_int() {
                Option::Some(_) => assert(false),
                None => {},
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// toml_as_int on a String value returns None
