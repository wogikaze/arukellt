use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("[server] # comment\nhost = \"x\"")
    match t {
        Result::Ok(table) => match table.get_field("server") {
            Option::Some(s) => match s.get_field("host") {
                Option::Some(v) => match v.as_string() {
                    Option::Some(str) => Test::assert_eq_string(str, "x"),
                    None => assert(false),
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// trailing comment after table header is ignored
