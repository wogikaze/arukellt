use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("flag = true")
    match t {
        Result::Ok(table) => match table.get_field("flag") {
            Option::Some(v) => match v.as_bool() {
                Option::Some(b) => Test::assert_true(b),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// boolean true parses to Boolean
