use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("a = 1")
    match t {
        Result::Ok(table) => match table.get_field("missing") {
            Option::Some(_) => assert(false),
            None => {},
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// toml_get on missing key returns None
