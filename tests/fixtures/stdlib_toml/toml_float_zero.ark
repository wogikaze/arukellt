use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("val = 0.0")
    match t {
        Result::Ok(table) => match table.get_field("val") {
            Option::Some(v) => match v.as_float() {
                Option::Some(f) => test::assert_eq_f64(f, 0.0),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// float 0.0 parses to Float
