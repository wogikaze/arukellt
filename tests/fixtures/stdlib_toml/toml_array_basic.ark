use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("vals = [1, 2, 3]")
    match t {
        Result::Ok(table) => match table.get_field("vals") {
            Option::Some(v) => match v.as_array() {
                Option::Some(arr) => Test::assert_eq_i32(arr.len(), 3),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// basic array of integers parses
