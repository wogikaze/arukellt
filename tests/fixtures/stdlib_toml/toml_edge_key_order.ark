use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("zebra = 1\napple = 2\nmango = 3")
    match t {
        Result::Ok(table) => {
            let keys = table.table_keys()
            Test::assert_eq_i32(keys.len(), 3)
            Test::assert_eq_string(get_unchecked(keys, 0), "zebra")
            Test::assert_eq_string(get_unchecked(keys, 2), "mango")
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// table_keys preserves source insertion order
