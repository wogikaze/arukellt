use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::toml_parse("a.b.c = 42")
    match t {
        Result::Ok(table) => match table.get_field("a") {
            Option::Some(a) => match a.get_field("b") {
                Option::Some(b) => match b.get_field("c") {
                    Option::Some(v) => match v.as_int() {
                        Option::Some(n) => test::assert_eq_i32(n, 42),
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// dotted key a.b.c = v creates nested tables
