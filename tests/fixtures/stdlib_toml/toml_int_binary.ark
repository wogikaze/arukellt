use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("val = 0b1010")
    match t {
        Result::Ok(table) => match table.get_field("val") {
            Option::Some(v) => match v.as_int() {
                Option::Some(n) => Test::assert_eq_i32(n, 10),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// binary integer 0b1010 parses to 10
