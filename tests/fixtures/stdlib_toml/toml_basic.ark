use std::host::stdio::Stdio
use std::toml

fn main() {
    Stdio::println(toml::TomlText::parse_line("name = \"arukellt\""))
    Stdio::println(toml::TomlText::parse_line("version = \"0.1.0\""))
    Stdio::println(toml::TomlText::parse_line("# this is a comment"))
    Stdio::println(toml::TomlText::parse_line(""))
    Stdio::println(toml::TomlText::parse_line("enabled = true"))
}
// Basic key-value lines pass through
// Comment lines return empty
// Empty lines return empty
// Normal lines pass through
