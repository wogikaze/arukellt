use std::host::stdio
use std::toml
use std::test

fn main() {
    let doc = "[a.b.c.d.e]\nval = 1"
    match toml::toml_parse(doc) {
        Result::Ok(table) => match table.get_field("a") {
            Option::Some(a) => match a.get_field("b") {
                Option::Some(b) => match b.get_field("c") {
                    Option::Some(c) => match c.get_field("d") {
                        Option::Some(d) => match d.get_field("e") {
                            Option::Some(e) => match e.get_field("val") {
                                Option::Some(v) => match v.as_int() {
                                    Option::Some(n) => test::assert_eq_i32(n, 1),
                                    None => assert(false),
                                },
                                None => assert(false),
                            },
                            None => assert(false),
                        },
                        None => assert(false),
                    },
                    None => assert(false),
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// deeply nested table header [a.b.c.d.e] parses
