use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("[\"my table\"]\nval = 1")
    match t {
        Result::Ok(table) => match table.get_field("my table") {
            Option::Some(s) => match s.get_field("val") {
                Option::Some(v) => match v.as_int() {
                    Option::Some(n) => Test::assert_eq_i32(n, 1),
                    None => assert(false),
                },
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// quoted key in table header supports spaces
