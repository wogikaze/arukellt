use std::host::stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("")
    match t {
        Result::Ok(table) => {
            let keys = table.table_keys()
            Test::assert_eq_i32(len(keys), 0)
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// empty document parses to empty table
