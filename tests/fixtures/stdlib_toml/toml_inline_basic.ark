use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("point = { x = 1, y = 2 }")
    match t {
        Result::Ok(table) => match table.get_field("point") {
            Option::Some(pt) => {
                match pt.get_field("x") {
                    Option::Some(v) => match v.as_int() {
                        Option::Some(n) => Test::assert_eq_i32(n, 1),
                        None => assert(false),
                    },
                    None => assert(false),
                }
                match pt.get_field("y") {
                    Option::Some(v) => match v.as_int() {
                        Option::Some(n) => Test::assert_eq_i32(n, 2),
                        None => assert(false),
                    },
                    None => assert(false),
                }
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// inline table { x = 1, y = 2 } parses to nested table
