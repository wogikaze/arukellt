use std::host::stdio
use std::toml
use std::test

fn main() {
    let t = toml::TomlValue::parse("flag = false")
    match t {
        Result::Ok(table) => match table.get_field("flag") {
            Option::Some(v) => match v.as_bool() {
                Option::Some(b) => test::assert_false(b),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    stdio::println("OK")
}
// boolean false parses to Boolean
