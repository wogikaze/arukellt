// Issue #705: Full TOML 1.0 table header parsing.
use std::host::stdio
use std::toml
use std::prelude::{eq}
use std::text
fn main() {
    // Table header + key=value entries
    let input = String_from("[server]\nhost = \"localhost\"\nport = 8080")
    match toml::TomlValue::parse(input) {
        Result::Ok(table) => {
            // toml_get on nested table
            match table.get_field(String_from("server")) {
                Option::Some(server) => {
                    match server.get_field(String_from("host")) {
                        Option::Some(host) => {
                            match host.as_string() {
                                Option::Some(s) => assert(eq(s, String_from("localhost"))),
                                None => assert(false),
                            }
                        },
                        None => assert(false),
                    }
                    match server.get_field(String_from("port")) {
                        Option::Some(port) => {
                            match port.as_int() {
                                Option::Some(n) => assert(n == 8080),
                                None => assert(false),
                            }
                        },
                        None => assert(false),
                    }
                },
                None => assert(false),
            }
        },
        Result::Err(e) => {
            stdio::println(String_from("parse error: ").concat(e))
            assert(false)
        },
    }

    // find_toml_section public API
    let section = toml::TomlText::find_section(input, String_from("server"))
    assert(eq(section, String_from("host = \"localhost\"\nport = 8080")))

    // find_toml_value extracts quoted string values from raw text
    let val = toml::TomlText::find_value(input, String_from("host"))
    assert(eq(val, String_from("localhost")))

    stdio::println(String_from("OK"))
}
