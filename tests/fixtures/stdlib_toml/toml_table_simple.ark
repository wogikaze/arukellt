use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("[server]\nhost = \"localhost\"\nport = 8080")
    match t {
        Result::Ok(table) => match table.get_field("server") {
            Option::Some(server) => {
                match server.get_field("host") {
                    Option::Some(v) => match v.as_string() {
                        Option::Some(s) => Test::assert_eq_string(s, "localhost"),
                        None => assert(false),
                    },
                    None => assert(false),
                }
                match server.get_field("port") {
                    Option::Some(v) => match v.as_int() {
                        Option::Some(n) => Test::assert_eq_i32(n, 8080),
                        None => assert(false),
                    },
                    None => assert(false),
                }
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// [table] header creates a nested table with key=value entries
