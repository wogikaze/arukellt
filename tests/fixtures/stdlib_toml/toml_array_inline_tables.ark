use std::host::stdio::Stdio
use std::toml
use std::test::Test

fn main() {
    let t = toml::TomlValue::parse("pts = [{ x = 1 }, { x = 2 }]")
    match t {
        Result::Ok(table) => match table.get_field("pts") {
            Option::Some(v) => match v.as_array() {
                Option::Some(arr) => Test::assert_eq_i32(len(arr), 2),
                None => assert(false),
            },
            None => assert(false),
        },
        Result::Err(_) => assert(false),
    }
    Stdio::println("OK")
}
// array of inline tables parses
