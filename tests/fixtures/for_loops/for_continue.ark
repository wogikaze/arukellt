use std::host::stdio
use std::core::iter

fn main() {
    let mut sum: i32 = 0
    for i in 0..10 {
        if i % 2 == 0 {
            continue
        }
        sum = sum + i
    }
    stdio::println((sum).to_string())
    let v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    let mut odds: i32 = 0
    for x in v {
        if x % 2 == 0 {
            continue
        }
        odds = odds + x
    }
    stdio::println((odds).to_string())
}
