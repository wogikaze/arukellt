use std::host::stdio::Stdio
use std::core::iter

fn main() {
    let mut sum: i32 = 0
    for i in 0..10 {
        if i % 2 == 0 {
            continue
        }
        sum = sum + i
    }
    Stdio::println((sum).to_string())
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    let mut odds: i32 = 0
    for x in v {
        if x % 2 == 0 {
            continue
        }
        odds = odds + x
    }
    Stdio::println((odds).to_string())
}
