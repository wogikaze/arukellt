use std::host::stdio::Stdio
use helper

fn main() {
    Stdio::println(helper::json_text("a\"b"))
    Stdio::println(helper::json_object("z"))
    Stdio::println(helper::json_pretty())
    Stdio::println(helper::toml_value("a = \"x\"\n"))
    Stdio::println(helper::json_document("{\"k\":\"z\"}"))
    Stdio::println(helper::toml_document("n = 42\ns = \"hi\""))
    Stdio::println(helper::csv_row("\"Smith, John\",30"))
}
