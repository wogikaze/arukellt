//! Regression guard for #934 item 1: declaration identity, not declaration
//! order, decides a bare call.
//!
//! `import shapes` loads a same-named `measure` with a String contract before
//! the entry module's `measure(i32)`. The bare `measure(41)` below must bind
//! the entry declaration; binding the imported one is E0200 at the argument.
//!
//! The call is reachable from `main` and executed: the checker records the
//! entry declaration per call, and lowering binds that declaration's
//! FunctionId and signature instead of the first registry entry sharing the
//! bare name (#934 / #933). Binding the imported declaration would either
//! reject the call at the argument or emit invalid core Wasm.

use std::host::stdio::Stdio
import shapes

fn measure(value: i32) -> i32 {
    value + 1
}

fn shadow_probe() -> i32 {
    measure(41)
}

fn main() {
    Stdio::println(shadow_probe().to_string())
    let label: String = shapes::measure(String_from("x"))
    Stdio::println(label)
}
