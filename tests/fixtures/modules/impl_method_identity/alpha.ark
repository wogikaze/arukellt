//! Same-named owner type and method as `beta`. The signature index and the
//! MIR function index must keep the two impl declarations apart: the flat
//! `Counter::bump` spelling is claimed by whichever module is collected first.

pub struct Counter {
    value: i32,
}

impl Counter {
    fn bump(self) -> i32 {
        self.value + 1
    }
}

pub fn probe() -> i32 {
    let counter = Counter { value: 10 }
    counter.bump()
}
