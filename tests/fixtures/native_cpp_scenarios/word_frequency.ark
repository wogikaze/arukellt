use std::host::stdio
use std::prelude::{to_string}
use std::text
fn main() {
    let m = HashMap::new<String, i32>()
    let _ = m.insert("the", 1)
    let _ = m.insert("cat", 1)
    let _ = m.insert("sat", 1)
    let _ = m.insert("the", 2)
    match m.get("the") {
        Option::Some(n) => stdio::println(String_from("the=").concat(to_string(n))),
        None => stdio::println(String_from("the=0")),
    }
    match m.get("cat") {
        Option::Some(n) => stdio::println(String_from("cat=").concat(to_string(n))),
        None => stdio::println(String_from("cat=0")),
    }
    stdio::println(String_from("size=").concat(to_string(m.len())))
}
