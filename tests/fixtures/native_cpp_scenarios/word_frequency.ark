use std::host::stdio
use std::text
fn main() {
    let mut m = HashMap::new<String, i32>()
    let _ = m.insert("the", 1)
    let _ = m.insert("cat", 1)
    let _ = m.insert("sat", 1)
    let _ = m.insert("the", 2)
    match m.get("the") {
        Option::Some(n) => stdio::println(String_from("the=").concat(n.to_string())),
        None => stdio::println(String_from("the=0")),
    }
    match m.get("cat") {
        Option::Some(n) => stdio::println(String_from("cat=").concat(n.to_string())),
        None => stdio::println(String_from("cat=0")),
    }
    stdio::println(String_from("size=").concat(m.len().to_string()))
}
