use std::host::stdio
use std::prelude::{filter_i32, to_string}
use std::core::iter
fn double(x: i32) -> i32 {
    x * 2
}

fn is_positive(x: i32) -> bool {
    x > 0
}

fn main() {
    let mut xs = Vec::new<i32>()
    push(xs, 0 - 1)
    push(xs, 2)
    push(xs, 3)
    push(xs, 0)
    let mapped: Vec<i32> = xs.iter().map(double).collect()
    let filtered = filter_i32(mapped, is_positive)
    let mut i = 0
    let n = len(filtered)
    while i < n {
        stdio::println(to_string(get_unchecked(filtered, i)))
        i = i + 1
    }
}
