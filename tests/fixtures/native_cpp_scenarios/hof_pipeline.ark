use std::host::stdio::Stdio
use std::core::iter
fn double(x: i32) -> i32 {
    x * 2
}

fn is_positive(x: i32) -> bool {
    x > 0
}

fn main() {
    let mut xs = Vec::new<i32>()
    xs.push(0 - 1)
    xs.push(2)
    xs.push(3)
    xs.push(0)
    let mapped: Vec<i32> = xs.iter().map(double).collect()
    let filtered: Vec<i32> = mapped.iter().filter(is_positive).collect()
    let mut i = 0
    let n = filtered.len()
    while i < n {
        Stdio::println(filtered.get_unchecked(i).to_string())
        i = i + 1
    }
}
