use std::host::fs::Fs
use std::host::process::Process
use std::host::stdio
use std::prelude::{clone}
use std::text
fn transform_line(line: String) -> Result<String, String> {
    if len(line) == 0 {
        Err(String_from("empty-line"))
    } else {
        Ok(String_from("OK:").concat(line))
    }
}

fn main() {
    let mut path = String_from("native_cpp_scenario_transform.txt")
    match Fs::write_string(clone(path), String_from("payload")) {
        Result::Ok(_) => {
        },
        Result::Err(err) => {
            stdio::eprintln(err)
            Process::exit(2)
        },
    }
    match Fs::read_to_string(path) {
        Result::Ok(text) => match transform_line(text) {
            Result::Ok(out) => stdio::println(out),
            Result::Err(err) => {
                stdio::eprintln(err)
                Process::exit(4)
            },
        },
        Result::Err(err) => {
            stdio::eprintln(err)
            Process::exit(3)
        },
    }
}
