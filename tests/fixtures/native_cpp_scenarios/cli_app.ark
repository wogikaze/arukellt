use std::host::env::Env
use std::host::process::Process
use std::host::stdio::Stdio
use std::text

fn main() {
    let values = Env::args()
    let n = values.len()
    if n >= 2 {
        Stdio::println(String_from("hello=").concat(get_unchecked(values, 1)))
        Process::exit(0)
    }
    Stdio::println(String_from("hello=default"))
}
