use std::host::env
use std::host::process
use std::host::stdio
use std::prelude::{values}
use std::text
fn main() {
    let values = env::args()
    let n = len(values)
    if n >= 2 {
        stdio::println(String_from("hello=").concat(get_unchecked(values, 1)))
        process::exit(0)
    }
    stdio::println(String_from("hello=default"))
}
