// Regression: matching a generic enum at concrete arguments must bind the
// payload at the substituted type. The checker instantiated the declared
// payload (`T`), but MIR still chose the open GC reference representation and
// the emitted module failed validation (`expected i32, found (ref null ...)`).
use std::host::stdio
use std::prelude::Box

enum Wrap<T> {
    Some(T),
    None,
}

fn peek_wrap(w: Wrap<i32>) -> i32 {
    match w {
        Wrap::Some(value) => value,
        Wrap::None => 0,
    }
}

fn make_box() -> Box<i32> {
    Box::Owned(41)
}

fn main() {
    let wrapped: Wrap<i32> = Wrap::Some(41)
    stdio::println((peek_wrap(wrapped) + 1).to_string())
    stdio::println((make_box().take() + 1).to_string())
    stdio::println((Box::new(41).take() + 1).to_string())
}
