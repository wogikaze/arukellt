use std::test::Test
use std::text

// #922: mark_candidate used to treat record ranges as half-open, so a
// candidate equal to a record's hi never marked it — minimal {len@-4}
// payloads (empty String: a 4-byte record whose handle is lo+4 == hi)
// were swept while still referenced. Closing the interval then let a
// boundary word cand == prev.hi == next.lo match the earlier chain node
// and return before reaching the real owner. Boundary matches now mark
// and keep walking; only strict interior hits return early, and both
// registration paths cover the hi page so boundary candidates find the
// record at all.
// and return before reaching the real owner. Boundary matches now mark
// and keep walking — with cand == hi only claimed by minimal span-4
// records, the one layout where hi is a valid handle — and only strict
// interior hits return early. Both registration paths cover the hi
// page so boundary candidates find the record at all.
//
// Phase 1 builds adjacent [string header][external Vec<i32> backing]
// record pairs so each backing's lo collides with the previous record's
// hi on the shared page chain — the shadow shape the sweep miss needed.
// Phase 2 holds empty strings across churn; their slots are only reused
// by same-size payloads so a silent sweep stays invisible, but the
// pattern keeps the hi-handle path exercised. Phase 3 replays the
// module-loader shape (name Vec + slot-index rehash + churn) that first
// surfaced the miss at selfhost scale.

pub struct LoadState {
    loaded_names: Vec<String>,
    loaded_slots: Vec<i32>,
    loading_stack: Vec<String>,
    canary: String,
}

fn load_state_string_hash(name: String) -> i32 {
    let mut hash = 216613626
    let mut i = 0
    while i < name.len() {
        hash = hash * 16777619 ^ name.byte_at(i)
        if hash < 0 {
            hash = 0 - hash
        }
        i = i + 1
    }
    if hash < 0 {
        return 0
    }
    hash
}

fn load_state_probe(keys: Vec<String>, slots: Vec<i32>, name: String) -> i32 {
    let capacity = slots.len()
    if capacity <= 0 {
        return 0 - 1
    }
    let mut slot = load_state_string_hash(name) % capacity
    let mut probes = 0
    while probes < capacity {
        let bucket = slots.get_unchecked(slot)
        if bucket == 0 {
            return slot
        }
        if keys.get_unchecked(bucket - 1).eq(name.clone()) {
            return slot
        }
        slot = (slot + 1) % capacity
        probes = probes + 1
    }
    0 - 1
}

fn load_state_zero_slots(size: i32) -> Vec<i32> {
    let mut slots = Vec::new<i32>()
    let mut i = 0
    while i < size {
        push(slots, 0)
        i = i + 1
    }
    slots
}

// Element-wise clones keep the module-loader shape (a fresh keys/slots
// vec per probe) without going through the generic `clone(Vec<T>)`
// intrinsic: under wasm32-gc the bare `clone` callee lookup still
// resolves to `String::clone`, which emits a call whose argument type
// does not match the callee signature and fails wasm validation (#928).
fn load_state_clone_names(src: Vec<String>) -> Vec<String> {
    let mut out: Vec<String> = Vec::new<String>()
    let mut i = 0
    while i < src.len() {
        push(out, src.get_unchecked(i).clone())
        i = i + 1
    }
    out
}

fn load_state_clone_slots(src: Vec<i32>) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new<i32>()
    let mut i = 0
    while i < src.len() {
        push(out, src.get_unchecked(i))
        i = i + 1
    }
    out
}

fn load_state_rehash(keys: Vec<String>, capacity: i32) -> Vec<i32> {
    let mut slots = load_state_zero_slots(capacity)
    let mut i = 0
    while i < keys.len() {
        let slot = load_state_probe(load_state_clone_names(keys), slots, keys.get_unchecked(i).clone())
        set(slots, slot, i + 1)
        i = i + 1
    }
    slots
}

fn LoadState_ensure_loaded_index(mut state: LoadState) {
    let mut capacity = state.loaded_slots.len()
    if capacity > 0 && state.loaded_names.len() * 2 < capacity {
        return
    }
    if capacity == 0 {
        capacity = 64
    }
    while capacity <= state.loaded_names.len() * 2 {
        capacity = capacity * 2
    }
    state.loaded_slots = load_state_rehash(load_state_clone_names(state.loaded_names), capacity)
}

fn LoadState_has_loaded(state: LoadState, name: String) -> bool {
    if state.loaded_slots.len() <= 0 {
        return false
    }
    let slot = load_state_probe(load_state_clone_names(state.loaded_names), load_state_clone_slots(state.loaded_slots), name.clone())
    if slot < 0 {
        return false
    }
    state.loaded_slots.get_unchecked(slot) > 0
}

fn LoadState_push_loaded(mut state: LoadState, name: String) {
    push(state.loaded_names, name)
    LoadState_ensure_loaded_index(state)
    let slot = load_state_probe(load_state_clone_names(state.loaded_names), load_state_clone_slots(state.loaded_slots), name.clone())
    if slot < 0 {
        return
    }
    set(state.loaded_slots, slot, state.loaded_names.len())
}

fn stack_scan(state: LoadState, site: i32) -> i32 {
    let v = state.loading_stack
    let n = v.len()
    let mut i = 0
    if state.canary.len() != 45 {
        return site * 10000 + 9999
    }
    while i < n {
        let l = v.get_unchecked(i).len()
        if l < 0 || l > 4096 {
            return site * 10000 + i
        }
        i = i + 1
    }
    0 - 1
}

fn churn_big(slots: i32) -> i32 {
    let mut junk: Vec<i32> = Vec::with_capacity<i32>(slots)
    push(junk, slots)
    junk.len()
}

fn churn_small(iters: i32) {
    let mut j = 0
    while j < iters {
        let mut v: Vec<i32> = Vec::new<i32>()
        push(v, j * 26544357 + 1)
        j = j + 1
    }
}

fn main() {
    let mut keep: Vec<Vec<i32>> = Vec::new<Vec<i32>>()
    let mut i = 0
    while i < 64 {
        let _pad = String_from("pad").concat(i.to_string())
        let mut v: Vec<i32> = Vec::with_capacity<i32>(16)
        push(v, i * 7 + 3)
        push(v, i * 13 + 5)
        push(keep, v)
        i = i + 1
    }
    churn_small(2000000)
    i = 0
    while i < keep.len() {
        let mut v = keep.get_unchecked(i)
        Test::assert_eq_i32(v.len(), 2)
        Test::assert_eq_i32(v.get_unchecked(0), i * 7 + 3)
        Test::assert_eq_i32(v.get_unchecked(1), i * 13 + 5)
        i = i + 1
    }

    let mut keep_empty: Vec<String> = Vec::new<String>()
    i = 0
    while i < 512 {
        push(keep_empty, String_from("").concat(String_from("")))
        i = i + 1
    }
    churn_small(1500000)
    Test::assert_eq_i32(keep_empty.len(), 512)
    i = 0
    while i < keep_empty.len() {
        Test::assert_true(keep_empty.get_unchecked(i).eq(String_from("")))
        i = i + 1
    }

    let mut state = LoadState {
        loaded_names: Vec::new<String>(),
        loaded_slots: Vec::new<i32>(),
        loading_stack: Vec::new<String>(),
        canary: String_from("CANARY0123456789abcdef_padding_for_heap_alloc")
    }
    i = 0
    while i < 96 {
        let stem = String_from("mod").concat(i.to_string())
        let path = String_from("mod/dir/").concat(stem.clone().concat(String_from(".ark")))
        if LoadState_has_loaded(state, path.clone()) == false {
            LoadState_push_loaded(state, path.clone())
        }
        push(state.loading_stack, path.clone())
        Test::assert_eq_i32(stack_scan(state, 1), 0 - 1)
        pop(state.loading_stack)
        let _n = churn_big(524288)
        i = i + 1
    }
    i = 0
    while i < 96 {
        let stem = String_from("mod").concat(i.to_string())
        let path = String_from("mod/dir/").concat(stem.clone().concat(String_from(".ark")))
        Test::assert_true(LoadState_has_loaded(state, path))
        i = i + 1
    }
}
