use std::test

// #874 / ADR-075: a linear HashMap<String,String> keeps its flat slot
// array inside the managed Vec<i32> backing, so keys and values are
// tracked records reachable through conservative transitive marking.
// Entries inserted before (and during) the churn loop must still resolve
// after the watermark-gated collections that fire inside churn's entry.

use std::text
fn churn(slots: i32) -> i32 {
    let mut junk: Vec<i32> = Vec::with_capacity<i32>(slots)
    push(junk, slots)
    len(junk)
}

fn main() {
    let mut m = HashMap::new<String, String>()
    let _ = m.insert("gree".concat("ting"), "hel".concat("lo"))
    let _ = m.insert("farewell", "goodbye")
    let _ = m.insert("color", "red")
    let _ = m.insert("color", "blue")

    let mut i = 0
    while i < 160 {
        let _n = churn(262144)
        if i == 80 {
            let _ = m.insert("late", "va".concat("lue"))
        }
        i = i + 1
    }

    test::assert_eq_i32(m.len(), 4)
    match m.get("gree".concat("ting")) {
        Option::Some(v) => test::assert_eq_string(v, "hello"),
        None => panic("expected Some(hello)"),
    }
    match m.get("color") {
        Option::Some(v) => test::assert_eq_string(v, "blue"),
        None => panic("expected Some(blue)"),
    }
    match m.get("late") {
        Option::Some(v) => test::assert_eq_string(v, "value"),
        None => panic("expected Some(value)"),
    }
    test::assert_true(m.contains_key("farewell"))
}
