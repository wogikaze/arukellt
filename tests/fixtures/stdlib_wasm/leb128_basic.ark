use std::host::stdio::Stdio
use std::wasm

fn main() {
    let b0: Vec<i32> = wasm::Leb128::encode_u32(0)
    Stdio::println((b0.len()).to_string())
    Stdio::println((b0.get_unchecked(0)).to_string())
    let b1: Vec<i32> = wasm::Leb128::encode_u32(1)
    Stdio::println((b1.get_unchecked(0)).to_string())
    let b127: Vec<i32> = wasm::Leb128::encode_u32(127)
    Stdio::println((b127.len()).to_string())
    Stdio::println((b127.get_unchecked(0)).to_string())
    let b128: Vec<i32> = wasm::Leb128::encode_u32(128)
    Stdio::println((b128.len()).to_string())
    Stdio::println((b128.get_unchecked(0)).to_string())
    Stdio::println((b128.get_unchecked(1)).to_string())
    Stdio::println((wasm::Leb128::size_u32(0)).to_string())
    Stdio::println((wasm::Leb128::size_u32(127)).to_string())
    Stdio::println((wasm::Leb128::size_u32(128)).to_string())
    Stdio::println((wasm::Leb128::size_u32(16383)).to_string())
    Stdio::println((wasm::Leb128::size_u32(16384)).to_string())
}
// LEB128 encode small values (single byte)
// LEB128 encode 128 (two bytes: 0x80 0x01)
// size_u32
