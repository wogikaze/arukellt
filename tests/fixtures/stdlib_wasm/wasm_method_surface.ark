// std::wasm builder namespace surface (ADR-046): section IDs, value types,
// opcodes, FuncType / Limits values, WasmModuleBuilder setters, and LEB128.
// Every symbol is an associated function or receiver method; the free
// spellings are retired (#917). The v128 bitwise replacement lives on
// std::simd::v128::V128 and is asserted here through the same fixture.
use std::simd::v128::V128
use std::test
use std::wasm

fn section_cases() {
    test::assert_eq_i32(wasm::Section::type_id(), 1)
    test::assert_eq_i32(wasm::Section::import_id(), 2)
    test::assert_eq_i32(wasm::Section::function_id(), 3)
    test::assert_eq_i32(wasm::Section::table_id(), 4)
    test::assert_eq_i32(wasm::Section::memory_id(), 5)
    test::assert_eq_i32(wasm::Section::global_id(), 6)
    test::assert_eq_i32(wasm::Section::export_id(), 7)
    test::assert_eq_i32(wasm::Section::start_id(), 8)
    test::assert_eq_i32(wasm::Section::element_id(), 9)
    test::assert_eq_i32(wasm::Section::code_id(), 10)
    test::assert_eq_i32(wasm::Section::data_id(), 11)
}

fn valtype_cases() {
    test::assert_eq_i32(wasm::ValType::i32(), 127)
    test::assert_eq_i32(wasm::ValType::i64(), 126)
    test::assert_eq_i32(wasm::ValType::f32(), 125)
    test::assert_eq_i32(wasm::ValType::f64(), 124)
    test::assert_eq_i32(wasm::ValType::v128(), 123)
    test::assert_eq_i32(wasm::ValType::funcref(), 112)
    test::assert_eq_i32(wasm::ValType::externref(), 111)
}

fn opcode_cases() {
    test::assert_eq_i32(wasm::Opcode::unreachable(), 0)
    test::assert_eq_i32(wasm::Opcode::nop(), 1)
    test::assert_eq_i32(wasm::Opcode::block(), 2)
    test::assert_eq_i32(wasm::Opcode::loop_(), 3)
    test::assert_eq_i32(wasm::Opcode::if_(), 4)
    test::assert_eq_i32(wasm::Opcode::else_(), 5)
    test::assert_eq_i32(wasm::Opcode::end(), 11)
    test::assert_eq_i32(wasm::Opcode::br(), 12)
    test::assert_eq_i32(wasm::Opcode::br_if(), 13)
    test::assert_eq_i32(wasm::Opcode::return_(), 15)
    test::assert_eq_i32(wasm::Opcode::call(), 16)
    test::assert_eq_i32(wasm::Opcode::drop(), 26)
    test::assert_eq_i32(wasm::Opcode::select(), 27)
    test::assert_eq_i32(wasm::Opcode::local_get(), 32)
    test::assert_eq_i32(wasm::Opcode::local_set(), 33)
    test::assert_eq_i32(wasm::Opcode::local_tee(), 34)
    test::assert_eq_i32(wasm::Opcode::global_get(), 35)
    test::assert_eq_i32(wasm::Opcode::global_set(), 36)
    test::assert_eq_i32(wasm::Opcode::i32_load(), 40)
    test::assert_eq_i32(wasm::Opcode::i32_store(), 54)
    test::assert_eq_i32(wasm::Opcode::memory_size(), 63)
    test::assert_eq_i32(wasm::Opcode::memory_grow(), 64)
    test::assert_eq_i32(wasm::Opcode::i32_const(), 65)
    test::assert_eq_i32(wasm::Opcode::i64_const(), 66)
    test::assert_eq_i32(wasm::Opcode::f32_const(), 67)
    test::assert_eq_i32(wasm::Opcode::f64_const(), 68)
    test::assert_eq_i32(wasm::Opcode::i32_eqz(), 69)
    test::assert_eq_i32(wasm::Opcode::i32_eq(), 70)
    test::assert_eq_i32(wasm::Opcode::i32_ne(), 71)
    test::assert_eq_i32(wasm::Opcode::i32_lt_s(), 72)
    test::assert_eq_i32(wasm::Opcode::i32_gt_s(), 74)
    test::assert_eq_i32(wasm::Opcode::i32_le_s(), 76)
    test::assert_eq_i32(wasm::Opcode::i32_ge_s(), 78)
    test::assert_eq_i32(wasm::Opcode::i32_add(), 106)
    test::assert_eq_i32(wasm::Opcode::i32_sub(), 107)
    test::assert_eq_i32(wasm::Opcode::i32_mul(), 108)
    test::assert_eq_i32(wasm::Opcode::i32_div_s(), 109)
    test::assert_eq_i32(wasm::Opcode::i32_and(), 113)
    test::assert_eq_i32(wasm::Opcode::i32_or(), 114)
    test::assert_eq_i32(wasm::Opcode::i32_xor(), 115)
    test::assert_eq_i32(wasm::Opcode::i32_shl(), 116)
    test::assert_eq_i32(wasm::Opcode::i32_shr_s(), 117)
    test::assert_eq_i32(wasm::Opcode::i64_add(), 124)
    test::assert_eq_i32(wasm::Opcode::i64_sub(), 125)
    test::assert_eq_i32(wasm::Opcode::i64_mul(), 126)
}

fn functype_cases() {
    let params: Vec<i32> = Vec::new<i32>()
    params.push(wasm::ValType::i32())
    params.push(wasm::ValType::i64())
    let results: Vec<i32> = Vec::new<i32>()
    results.push(wasm::ValType::f64())
    let ft: wasm::FuncType = wasm::FuncType::new(params, results)
    test::assert_eq_i32(ft.param_count(), 2)
    test::assert_eq_i32(ft.result_count(), 1)
    test::assert_eq_i32(ft.get_param(0), 127)
    test::assert_eq_i32(ft.get_param(1), 126)
    test::assert_eq_i32(ft.get_result(0), 124)
}

fn limits_cases() {
    let bounded: wasm::Limits = wasm::Limits::bounded(1, 4)
    test::assert_eq_i32(bounded.min(), 1)
    test::assert_eq_i32(bounded.max(), 4)
    test::assert_true(bounded.has_max())
    let unbounded: wasm::Limits = wasm::Limits::unbounded(2)
    test::assert_eq_i32(unbounded.min(), 2)
    test::assert_eq_i32(unbounded.max(), 0)
    test::assert_false(unbounded.has_max())
}

fn builder_cases() {
    let m: wasm::WasmModuleBuilder = wasm::WasmModuleBuilder::new()
    test::assert_eq_i32(m.type_count(), 0)
    test::assert_eq_i32(m.func_count(), 0)
    test::assert_eq_i32(m.mem_count(), 0)
    test::assert_eq_i32(m.export_count(), 0)
    let params: Vec<i32> = Vec::new<i32>()
    let results: Vec<i32> = Vec::new<i32>()
    results.push(wasm::ValType::i32())
    let ft: wasm::FuncType = wasm::FuncType::new(params, results)
    test::assert_eq_i32(m.add_type(ft), 0)
    test::assert_eq_i32(m.type_count(), 1)
    test::assert_eq_i32(m.add_func(0), 0)
    test::assert_eq_i32(m.func_count(), 1)
    test::assert_eq_i32(m.add_memory(wasm::Limits::bounded(1, 4)), 0)
    test::assert_eq_i32(m.mem_count(), 1)
    m.add_export_func("run", 0)
    test::assert_eq_i32(m.export_count(), 1)
    let header: Vec<i32> = wasm::WasmModuleBuilder::encode_header()
    test::assert_eq_i32(header.len(), 8)
    test::assert_eq_i32(header.get_unchecked(0), 0)
    test::assert_eq_i32(header.get_unchecked(1), 97)
    test::assert_eq_i32(header.get_unchecked(4), 1)
    test::assert_eq_i32(wasm::WasmModuleBuilder::magic().len(), 4)
    test::assert_eq_i32(wasm::WasmModuleBuilder::version().len(), 4)
}

fn leb128_cases() {
    let two: Vec<i32> = wasm::Leb128::encode_u32(128)
    test::assert_eq_i32(two.len(), 2)
    test::assert_eq_i32(two.get_unchecked(0), 128)
    test::assert_eq_i32(two.get_unchecked(1), 1)
    test::assert_eq_i32(wasm::Leb128::size_u32(0), 1)
    test::assert_eq_i32(wasm::Leb128::size_u32(127), 1)
    test::assert_eq_i32(wasm::Leb128::size_u32(128), 2)
    test::assert_eq_i32(wasm::Leb128::size_u32(16383), 2)
    test::assert_eq_i32(wasm::Leb128::size_u32(16384), 3)
}

fn v128_bitwise_cases() {
    let zero: v128 = V128::zero()
    test::assert_eq_i32(V128::any_true(zero), 0)
    test::assert_eq_i32(V128::any_true(V128::and(zero, zero)), 0)
}

fn main() {
    section_cases()
    valtype_cases()
    opcode_cases()
    functype_cases()
    limits_cases()
    builder_cases()
    leb128_cases()
    v128_bitwise_cases()
}
