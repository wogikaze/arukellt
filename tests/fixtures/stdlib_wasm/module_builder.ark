use std::host::stdio::Stdio
use std::wasm

fn main() {
    let mut m: wasm::WasmModuleBuilder = wasm::WasmModuleBuilder::new()
    Stdio::println((m.type_count()).to_string())
    Stdio::println((m.func_count()).to_string())
    let params: Vec<i32> = Vec::new<i32>()
    let mut results: Vec<i32> = Vec::new<i32>()
    push(results, wasm::ValType::i32())
    let ft: wasm::FuncType = wasm::FuncType::new(params, results)
    Stdio::println((ft.param_count()).to_string())
    Stdio::println((ft.result_count()).to_string())
    Stdio::println((ft.get_result(0)).to_string())
    let ti: i32 = m.add_type(ft)
    let fi: i32 = m.add_func(ti)
    Stdio::println((ti).to_string())
    Stdio::println((fi).to_string())
    Stdio::println((m.type_count()).to_string())
    Stdio::println((m.func_count()).to_string())
    let hdr: Vec<i32> = wasm::WasmModuleBuilder::encode_header()
    Stdio::println((hdr.get_unchecked(0)).to_string())
    Stdio::println((hdr.get_unchecked(1)).to_string())
    Stdio::println((hdr.get_unchecked(4)).to_string())
}
// WasmModuleBuilder::new returns a builder with zero entries
// Build a FuncType: () -> i32
// add_type and add_func stubs
// encode_header returns magic+version (8 bytes)
