use std::host::stdio

// #836: outer get on Vec<Vec<String>> → Option<Vec<String>>.
fn main() {
    let mut outer: Vec<Vec<String>> = Vec_new_i32()
    let mut inner: Vec<String> = Vec_new_i32()
    push(inner, String_from("ok"))
    push(outer, inner)
    match get(outer, 0) {
        Some(row) => stdio::println(get_unchecked(row, 0)),
        None => stdio::println("none"),
    }
}
