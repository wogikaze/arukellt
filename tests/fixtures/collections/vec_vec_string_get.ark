use std::host::stdio::Stdio

// #836: outer get on Vec<Vec<String>> → Option<Vec<String>>.
fn main() {
    let mut outer: Vec<Vec<String>> = Vec::new<i32>()
    let mut inner: Vec<String> = Vec::new<i32>()
    inner.push(String_from("ok"))
    outer.push(inner)
    match outer.get(0) {
        Some(row) => Stdio::println(row.get_unchecked(0)),
        None => Stdio::println("none"),
    }
}
