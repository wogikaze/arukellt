use std::host::stdio

fn double(n: i32) -> i32 {
    n * 2
}

fn main() {
    let fs: Vec<fn(i32) -> i32> = Vec::new<fn(i32) -> i32>()
    push(fs, double)
    let r: Result<Vec<fn(i32) -> i32>, String> = Ok(fs)
    match r {
        Ok(v) => {
            let f = get_unchecked(v, 0)
            stdio::println((f(5)).to_string())
        }
        Err(e) => stdio::println(e),
    }
}
