use std::host::stdio

struct FnHolder {
    f: fn() -> i32,
}

fn answer() -> i32 {
    42
}

fn apply0(f: fn() -> i32) -> i32 {
    f()
}

fn main() {
    let m = HashMap::new<i32, fn(i32) -> i32>()
    let _ = m.insert(1, answer)
    match m.get(1) {
        Some(f) => stdio::println((f()).to_string()),
        None => stdio::println("missing"),
    }
    stdio::println(apply0(answer).to_string())
    let h = FnHolder { f: answer }
    stdio::println((h.f)().to_string())
}
