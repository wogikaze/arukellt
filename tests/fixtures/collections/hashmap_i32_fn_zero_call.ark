use std::host::stdio::Stdio

struct FnHolder {
    f: fn() -> i32,
}

fn answer() -> i32 {
    42
}

fn answer_arg(_ignored: i32) -> i32 {
    42
}

fn apply0(f: fn() -> i32) -> i32 {
    f()
}

fn main() {
    // The supported HashMap fn family stores fn(i32) -> i32 values, so this
    // lane uses a matching callee. Zero-argument function values are covered
    // by the Option payload, apply0, and FnHolder below.
    let mut m = HashMap::new<i32, fn(i32) -> i32>()
    let _ = m.insert(1, answer_arg)
    match m.get(1) {
        Some(f) => Stdio::println((f(0)).to_string()),
        None => Stdio::println("missing"),
    }
    let opt: Option<fn() -> i32> = Option::Some(answer)
    match opt {
        Some(g) => Stdio::println((g()).to_string()),
        None => Stdio::println("missing"),
    }
    Stdio::println(apply0(answer).to_string())
    let h = FnHolder { f: answer }
    Stdio::println((h.f)().to_string())
}
