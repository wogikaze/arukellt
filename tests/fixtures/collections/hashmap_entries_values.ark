// HashMap::values() / HashMap::entries() eager snapshots (#888).
// Bucket order is implementation-defined, so all assertions reduce to
// order-independent aggregates that must match on wasm32-gc and wasm32.

use std::host::stdio

fn add1(x: i32) -> i32 { x + 1 }
fn add2(x: i32) -> i32 { x + 2 }

fn main() {
    // i32 -> i32
    let mut m_ii = HashMap::new<i32, i32>()
    m_ii.insert(1, 10)
    m_ii.insert(2, 20)
    let ii_vals = m_ii.values()
    let mut acc = 0
    let mut i = 0
    while i < ii_vals.len() {
        acc = acc + ii_vals.get_unchecked(i)
        i = i + 1
    }
    stdio::println(acc.to_string())
    let ii_ents = m_ii.entries()
    acc = 0
    i = 0
    while i < ii_ents.len() {
        let (k, v) = ii_ents.get_unchecked(i)
        acc = acc + k * 100 + v
        i = i + 1
    }
    stdio::println(acc.to_string())

    // String -> i32
    let mut m_si = HashMap::new<String, i32>()
    m_si.insert("a", 3)
    m_si.insert("bb", 4)
    let si_vals = m_si.values()
    acc = 0
    i = 0
    while i < si_vals.len() {
        acc = acc + si_vals.get_unchecked(i)
        i = i + 1
    }
    stdio::println(acc.to_string())
    let si_ents = m_si.entries()
    acc = 0
    i = 0
    while i < si_ents.len() {
        let (k, v) = si_ents.get_unchecked(i)
        acc = acc + k.len() * 10 + v
        i = i + 1
    }
    stdio::println(acc.to_string())

    // i32 -> String
    let mut m_is = HashMap::new<i32, String>()
    m_is.insert(1, "aa")
    m_is.insert(2, "bbb")
    let is_vals = m_is.values()
    acc = 0
    i = 0
    while i < is_vals.len() {
        acc = acc + is_vals.get_unchecked(i).len()
        i = i + 1
    }
    stdio::println(acc.to_string())
    let is_ents = m_is.entries()
    acc = 0
    i = 0
    while i < is_ents.len() {
        let (k, s) = is_ents.get_unchecked(i)
        acc = acc + k + s.len()
        i = i + 1
    }
    stdio::println(acc.to_string())

    // String -> String
    let mut m_ss = HashMap::new<String, String>()
    m_ss.insert("x", "yy")
    m_ss.insert("ww", "z")
    let ss_vals = m_ss.values()
    acc = 0
    i = 0
    while i < ss_vals.len() {
        acc = acc + ss_vals.get_unchecked(i).len()
        i = i + 1
    }
    stdio::println(acc.to_string())
    let ss_ents = m_ss.entries()
    acc = 0
    i = 0
    while i < ss_ents.len() {
        let (k, s) = ss_ents.get_unchecked(i)
        acc = acc + k.len() + s.len()
        i = i + 1
    }
    stdio::println(acc.to_string())

    // i32 -> fn
    let mut m_if = HashMap::new<i32, fn(i32) -> i32>()
    m_if.insert(1, add1)
    m_if.insert(2, add2)
    let if_vals = m_if.values()
    acc = 0
    i = 0
    while i < if_vals.len() {
        let f = if_vals.get_unchecked(i)
        acc = acc + f(10)
        i = i + 1
    }
    stdio::println(acc.to_string())
    let if_ents = m_if.entries()
    acc = 0
    i = 0
    while i < if_ents.len() {
        let (k, f) = if_ents.get_unchecked(i)
        acc = acc + f(k)
        i = i + 1
    }
    stdio::println(acc.to_string())

    // String -> fn
    let mut m_sf = HashMap::new<String, fn(i32) -> i32>()
    m_sf.insert("a", add1)
    m_sf.insert("bb", add2)
    let sf_vals = m_sf.values()
    acc = 0
    i = 0
    while i < sf_vals.len() {
        let f = sf_vals.get_unchecked(i)
        acc = acc + f(10)
        i = i + 1
    }
    stdio::println(acc.to_string())
    let sf_ents = m_sf.entries()
    acc = 0
    i = 0
    while i < sf_ents.len() {
        let (k, f) = sf_ents.get_unchecked(i)
        acc = acc + f(k.len())
        i = i + 1
    }
    stdio::println(acc.to_string())

    // Snapshots are eager: entries()/values() materialize the current
    // pairs, so later inserts do not appear in already returned vecs.
    let mut m_snap = HashMap::new<i32, i32>()
    m_snap.insert(1, 1)
    let snap_vals = m_snap.values()
    let snap_ents = m_snap.entries()
    m_snap.insert(2, 2)
    stdio::println(snap_vals.len().to_string())
    stdio::println(snap_ents.len().to_string())
    stdio::println(m_snap.len().to_string())
}
