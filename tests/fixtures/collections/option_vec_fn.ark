use std::host::stdio

fn double(n: i32) -> i32 {
    n * 2
}

fn main() {
    let fs: Vec<fn(i32) -> i32> = Vec::new<fn(i32) -> i32>()
    push(fs, double)
    let o: Option<Vec<fn(i32) -> i32>> = Some(fs)
    match o {
        Some(v) => {
            let f = get_unchecked(v, 0)
            stdio::println((f(5)).to_string())
        }
        None => stdio::println(String_from("none")),
    }
}
