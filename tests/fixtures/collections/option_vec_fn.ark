use std::host::stdio::Stdio

fn double(n: i32) -> i32 {
    n * 2
}

fn main() {
    let mut fs: Vec<fn(i32) -> i32> = Vec::new<fn(i32) -> i32>()
    push(fs, double)
    let o: Option<Vec<fn(i32) -> i32>> = Some(fs)
    match o {
        Some(v) => {
            let f = v.get_unchecked(0)
            Stdio::println((f(5)).to_string())
        }
        None => Stdio::println(String_from("none")),
    }
}
