// Vec<T> / Slice<T> method replacements for the deprecated vec
// intrinsic-compat frees (#917 / ADR-087).
use std::collections::vec
use std::core::cmp
use std::host::process

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut values: Vec<i32> = Vec::new<i32>()
    values.push(10)
    values.push(20)
    values.push(30)
    if values.len() != 3 {
        process::exit(1)
    }
    if values.get(1).unwrap_or(0) != 20 {
        process::exit(1)
    }
    values.set(1, 21)
    if values.get_unchecked(1) != 21 {
        process::exit(1)
    }

    // A Slice view is consumed by its receiver methods, matching the free
    // helper value semantics; take a fresh view per call.
    let view_len = values.as_slice(0, 2)
    if view_len.len() != 2 {
        process::exit(1)
    }
    let view_get = values.as_slice(0, 2)
    let got = view_get.get(1)
    if got != 21 {
        process::exit(1)
    }

    let removed = values.pop()
    if removed.unwrap_or(0) != 30 {
        process::exit(1)
    }
    values.clear()
    if values.len() != 0 {
        process::exit(1)
    }

    values.push(3)
    values.push(1)
    values.push(2)
    values.sort_by(ascending)
    if values.get(0).unwrap_or(0) != 1 {
        process::exit(1)
    }
    values.drain(1, 2)
    if values.len() != 2 {
        process::exit(1)
    }
}
