use std::collections::hash_str_fn
use std::host::stdio

fn double(n: i32) -> i32 {
    n * 2
}

fn main() {
    let m = hash_str_fn::hashmap_str_fn_new()
    let _ = hash_str_fn::hashmap_str_fn_set(m, "x", double)
    match hash_str_fn::hashmap_str_fn_get(m, "x") {
        Some(f) => stdio::println((f(5)).to_string()),
        None => stdio::println("missing"),
    }
}
