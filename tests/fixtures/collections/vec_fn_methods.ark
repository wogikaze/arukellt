use std::host::stdio::Stdio

fn double(x: i32) -> i32 {
    x * 2
}

fn triple(x: i32) -> i32 {
    x * 3
}

fn main() {
    let mut v: Vec<fn(i32) -> i32> = Vec::new<fn(i32) -> i32>()
    v.push(double)
    v.push(triple)
    Stdio::println(v.len().to_string())
    Stdio::println(v.is_empty().to_string())
    v.set(0, triple)
    match v.get(0) {
        Option::Some(f) => Stdio::println((f(5)).to_string()),
        Option::None => Stdio::println("none"),
    }
    match v.get(1) {
        Option::Some(f) => Stdio::println((f(4)).to_string()),
        Option::None => Stdio::println("none"),
    }
    let g: fn(i32) -> i32 = double
    v.push(g)
    Stdio::println(v.len().to_string())
}
