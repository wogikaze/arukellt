use std::host::stdio::Stdio

fn double(x: i32) -> i32 {
    x * 2
}

struct Pair {
    a: i32,
    b: i32,
}

fn main() {
    let mut vi: Vec<i32> = Vec::new<i32>()
    vi.push(41)
    match vi.pop() {
        Option::Some(x) => Stdio::println(x.to_string()),
        Option::None => Stdio::println("none"),
    }
    match vi.pop() {
        Option::Some(x) => Stdio::println(x.to_string()),
        Option::None => Stdio::println("none"),
    }
    let mut vl: Vec<i64> = Vec::new<i64>()
    vl.push(42_i64)
    match vl.pop() {
        Option::Some(x) => Stdio::println(x.to_string()),
        Option::None => Stdio::println("none"),
    }
    let mut vf: Vec<f64> = Vec::new<f64>()
    vf.push(2.5)
    match vf.pop() {
        Option::Some(x) => Stdio::println(x.to_string()),
        Option::None => Stdio::println("none"),
    }
    let mut vs: Vec<String> = Vec::new<String>()
    vs.push("hello")
    match vs.pop() {
        Option::Some(s) => Stdio::println(s),
        Option::None => Stdio::println("none"),
    }
    let mut vfn: Vec<fn(i32) -> i32> = Vec::new<fn(i32) -> i32>()
    vfn.push(double)
    match vfn.pop() {
        Option::Some(f) => Stdio::println((f(6)).to_string()),
        Option::None => Stdio::println("none"),
    }
    let mut vr: Vec<Pair> = Vec::new<Pair>()
    vr.push(Pair { a: 3, b: 4 })
    match vr.pop() {
        Option::Some(p) => Stdio::println((p.a + p.b).to_string()),
        Option::None => Stdio::println("none"),
    }
}
