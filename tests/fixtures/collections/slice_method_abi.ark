// The imported Vec<T> impl and a view returned across a function boundary
// must both hand Slice<T>::len/get the same representation.
use std::collections::vec
use std::host::process::Process
use std::host::stdio::Stdio

fn first_two(values: Vec<i32>) -> Slice<i32> {
    values.as_slice(0, 2)
}

fn main() {
    let mut values: Vec<i32> = Vec::new<i32>()
    values.push(10)
    values.push(20)
    values.push(30)

    let local = values.as_slice(1, 3)
    if local.len() != 2 || local.get(0) != 20 || local.get(1) != 30 {
        Process::exit(1)
    }

    let returned = first_two(values)
    if returned.len() != 2 || returned.get(0) != 10 || returned.get(1) != 20 {
        Process::exit(1)
    }
    Stdio::println("ok")
}
