use std::host::stdio::Stdio

fn double(n: i32) -> i32 {
    n * 2
}

fn fetch(v: Vec<fn(i32) -> i32>, i: i32) -> Option<fn(i32) -> i32> {
    v.get(i)
}

fn fetch_generic<T>(v: Vec<T>, i: i32) -> Option<T> {
    v.get(i)
}

fn main() {
    let mut v: Vec<fn(i32) -> i32> = Vec::new()
    push(v, double)
    match fetch(v, 0) {
        Option::Some(f) => Stdio::println((f(5)).to_string()),
        Option::None => Stdio::println("none"),
    }
    match fetch_generic(v, 0) {
        Option::Some(f) => Stdio::println((f(6)).to_string()),
        Option::None => Stdio::println("none"),
    }
    let mut w = Vec::new<fn(i32) -> i32>()
    push(w, double)
    let g = get_unchecked(w, 0)
    Stdio::println((g(7)).to_string())
}
