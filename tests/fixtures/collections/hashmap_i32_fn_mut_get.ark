use std::collections::hash_fn
use std::host::stdio

fn double(n: i32) -> i32 {
    n * 2
}

fn main() {
    // hash_fn::hashmap_i32_fn_get uses mut Option<fn> assign (#835).
    let m = hash_fn::hashmap_i32_fn_new()
    let _ = hash_fn::hashmap_i32_fn_set(m, 1, double)
    match hash_fn::hashmap_i32_fn_get(m, 1) {
        Some(f) => stdio::println((f(5)).to_string()),
        None => stdio::println("missing"),
    }
}
