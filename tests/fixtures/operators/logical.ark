use std::host::stdio::Stdio

fn main() {
    Stdio::println((true && true).to_string())
    Stdio::println((true && false).to_string())
    Stdio::println((false || true).to_string())
    Stdio::println((false || false).to_string())
    Stdio::println((!true).to_string())
    Stdio::println((!false).to_string())
}
