use std::host::stdio::Stdio

fn greeting() -> String {
    "hello"
}

fn fallback() -> String {
    "fallback"
}

fn producer() -> fn() -> String {
    greeting
}

fn apply0(f: fn() -> String) -> String {
    f()
}

fn main() {
    let f: fn() -> String = greeting
    Stdio::println(f())
    let p = producer()
    Stdio::println(p())
    Stdio::println(apply0(greeting))
    let mut g: fn() -> String = fallback
    g = greeting
    Stdio::println(g())
    let c = || {
        "fromclosure"
    }
    Stdio::println(apply0(c))
}
