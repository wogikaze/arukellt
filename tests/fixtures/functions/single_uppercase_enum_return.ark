// A declared one-uppercase enum keeps the open-enum type in return
// positions, for a free function and an impl method alike (ADR-089).
use std::host::stdio

enum E {
    Value(i32),
    Empty,
}

fn make_free() -> E {
    E::Value(5)
}

struct Holder {
    seed: i32,
}

impl Holder {
    fn make_method(self: Holder) -> E {
        E::Value(self.seed)
    }
}

fn take(e: E) -> i32 {
    match e {
        E::Value(x) => x,
        E::Empty => 0,
    }
}

fn main() {
    let a = make_free()
    let b = Holder { seed: 2 }.make_method()
    stdio::println((take(a) + take(b)).to_string())
}
