use std::host::stdio::Stdio

fn answer() -> i32 {
    42
}

fn zero() -> i32 {
    0
}

fn producer() -> fn() -> i32 {
    answer
}

fn producer_return() -> fn() -> i32 {
    return answer
}

fn main() {
    let f: fn() -> i32 = answer
    Stdio::println((f()).to_string())
    let p = producer()
    Stdio::println((p()).to_string())
    let q = producer_return()
    Stdio::println((q()).to_string())
    let mut g: fn() -> i32 = zero
    g = answer
    Stdio::println((g()).to_string())
    let o: Option<fn() -> i32> = Some(answer)
    match o {
        Some(h) => Stdio::println((h()).to_string()),
        None => Stdio::println("none"),
    }
    let mut v: Vec<fn() -> i32> = Vec::new<fn() -> i32>()
    v.push(answer)
    let w = get_unchecked(v, 0)
    Stdio::println((w()).to_string())
}
