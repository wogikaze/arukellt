// Grouping a receiver in parentheses must not change how a method call
// lowers, including on the statement right after an `if` without `else`:
// a line-start `(` begins a new statement instead of becoming postfix
// arguments on the `if`.
use std::host::stdio
use std::test::Test

fn prefix_matches(path: String) -> bool {
    if len(path) < 5 {
        return false
    }
    (path.slice(0, 5)).eq("std::")
}

fn prefix_matches_ungrouped(path: String) -> bool {
    if len(path) < 5 {
        return false
    }
    path.slice(0, 5).eq("std::")
}

fn grouped_len_after_if(s: String) -> i32 {
    if s.len() < 2 {
        return 0
    }
    (s.slice(0, 2)).len()
}

fn grouped_clone_after_if(s: String) -> i32 {
    if s.len() == 0 {
        return 0
    }
    (s.clone()).len()
}

fn grouped_option_after_if(values: Vec<i32>) -> i32 {
    if values.len() == 0 {
        return 0
    }
    (values.get(0)).unwrap()
}

fn grouped_before_any_if(s: String) -> i32 {
    (s.slice(0, 2)).len()
}

fn grouped_after_if_else(flag: bool) -> i32 {
    let mut base = 0
    if flag {
        base = 1
    } else {
        base = 2
    }
    (String_from("abcd").slice(0, 2)).len() + base
}

fn grouped_after_else_if_chain(n: i32) -> i32 {
    if n < 0 {
        return 0
    } else if n == 0 {
        return 1
    }
    (String_from("abcd").slice(0, 2)).len()
}

test "grouped receiver after if lowers like the ungrouped form" {
    Test::assert_true(prefix_matches(String_from("std::abc")))
    Test::assert_false(prefix_matches(String_from("other")))
    Test::assert_false(prefix_matches(String_from("ab")))
    Test::assert_true(prefix_matches_ungrouped(String_from("std::abc")))
    Test::assert_false(prefix_matches_ungrouped(String_from("other")))
}

test "grouped receiver after if supports non-eq methods" {
    Test::assert_eq_i32(grouped_len_after_if(String_from("abcd")), 2)
    Test::assert_eq_i32(grouped_len_after_if(String_from("a")), 0)
    Test::assert_eq_i32(grouped_clone_after_if(String_from("abc")), 3)
    Test::assert_eq_i32(grouped_clone_after_if(String_new()), 0)
    let mut values: Vec<i32> = Vec::new<i32>()
    values.push(42)
    Test::assert_eq_i32(grouped_option_after_if(values.clone()), 42)
    Test::assert_eq_i32(grouped_option_after_if(Vec::new<i32>()), 0)
}

test "grouped receiver works outside the if boundary" {
    Test::assert_eq_i32(grouped_before_any_if(String_from("abcd")), 2)
    Test::assert_eq_i32(grouped_after_if_else(true), 3)
    Test::assert_eq_i32(grouped_after_if_else(false), 4)
    Test::assert_eq_i32(grouped_after_else_if_chain(5), 2)
    Test::assert_eq_i32(grouped_after_else_if_chain(0), 1)
    Test::assert_eq_i32(grouped_after_else_if_chain(0 - 1), 0)
}

fn main() {
    let mut values: Vec<i32> = Vec::new<i32>()
    values.push(42)
    stdio::println(prefix_matches(String_from("std::abc")).to_string())
    stdio::println(prefix_matches(String_from("other")).to_string())
    stdio::println(prefix_matches(String_from("ab")).to_string())
    stdio::println(prefix_matches_ungrouped(String_from("std::abc")).to_string())
    stdio::println(prefix_matches_ungrouped(String_from("other")).to_string())
    stdio::println(grouped_len_after_if(String_from("abcd")).to_string())
    stdio::println(grouped_len_after_if(String_from("a")).to_string())
    stdio::println(grouped_clone_after_if(String_from("abc")).to_string())
    stdio::println(grouped_clone_after_if(String_new()).to_string())
    stdio::println(grouped_option_after_if(values.clone()).to_string())
    stdio::println(grouped_option_after_if(Vec::new<i32>()).to_string())
    stdio::println(grouped_before_any_if(String_from("abcd")).to_string())
    stdio::println(grouped_after_if_else(true).to_string())
    stdio::println(grouped_after_if_else(false).to_string())
    stdio::println(grouped_after_else_if_chain(5).to_string())
    stdio::println(grouped_after_else_if_chain(0).to_string())
    stdio::println(grouped_after_else_if_chain(0 - 1).to_string())
}
