// #917 / ADR-046: CSV row/document helpers moved onto the Csv namespace.
use std::csv
use std::test

fn main() {
    let fields = csv::Csv::split_line("a,b,c")
    test::assert_eq_i32(len(fields), 3)
    test::assert_eq_string(get_unchecked(fields, 1), "b")

    let row = csv::Csv::parse_row("\"Smith, John\",30")
    test::assert_eq_i32(len(row), 2)
    test::assert_eq_string(get_unchecked(row, 0), "Smith, John")
    test::assert_eq_string(csv::Csv::stringify_row(row), "\"Smith, John\",30")

    test::assert_eq_i32(csv::Csv::count_rows("a\n\nb\n"), 2)
    test::assert_eq_string(csv::Csv::get_row_raw("a\nb\n", 1), "b")
    let row_at = csv::Csv::parse_row_at("a,b\nc,d\n", 1)
    test::assert_eq_string(get_unchecked(row_at, 0), "c")
    test::assert_eq_string(csv::Csv::stringify(Vec::new<Vec<String>>()), "")

    let parsed: Result<Vec<Vec<String>>, String> = csv::Csv::parse("a,b\n1,2")
    match parsed {
        Result::Ok(rows) => test::assert_eq_i32(len(rows), 2),
        Result::Err(_) => test::assert_true(false),
    }
    let header: Result<Vec<String>, String> = csv::Csv::parse_with_header("h1,h2\n1,2")
    match header {
        Result::Ok(names) => test::assert_eq_i32(len(names), 2),
        Result::Err(_) => test::assert_true(false),
    }
}
