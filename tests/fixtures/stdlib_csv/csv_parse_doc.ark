use std::csv
use std::host::stdio::Stdio

fn main() {
    match csv::Csv::parse("a,b\n1,2") {
        Result::Ok(rows) => Stdio::println((rows.len()).to_string()),
        Result::Err(e) => Stdio::println(e),
    }
    let mut rows = Vec::new<Vec<String>>()
    rows.push(csv::Csv::parse_row("x,y"))
    rows.push(csv::Csv::parse_row("1,2"))
    Stdio::println(csv::Csv::stringify(rows))
}
// csv_parse row count
// csv_stringify round-trip shape
