use std::csv
use std::host::stdio::Stdio

fn main() {
    let row1 = csv::Csv::parse_row("name,age,city")
    let mut i = 0
    while i < row1.len() {
        Stdio::println(get_unchecked(row1, i))
        i = i + 1
    }
    Stdio::println("---")
    let row2 = csv::Csv::parse_row("\"Smith, John\",30,\"New York\"")
    let mut j = 0
    while j < row2.len() {
        Stdio::println(get_unchecked(row2, j))
        j = j + 1
    }
    Stdio::println("---")
    let mut fields = Vec::new<String>()
    push(fields, "Alice")
    push(fields, "25")
    push(fields, "London")
    Stdio::println(csv::Csv::stringify_row(fields))
    let mut fields2 = Vec::new<String>()
    push(fields2, "Bob, Jr.")
    push(fields2, "40")
    Stdio::println(csv::Csv::stringify_row(fields2))
    let doc = "a,b,c\n1,2,3\n4,5,6"
    Stdio::println((csv::Csv::count_rows(doc)).to_string())
}
// csv_parse_row: unquoted fields
// csv_parse_row: quoted field with embedded comma
// csv_stringify_row round-trip
// csv_stringify_row with field needing quoting
// csv_count_rows
