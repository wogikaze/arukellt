use std::csv
use std::host::stdio::Stdio

fn main() {
    let fields = csv::Csv::split_line("name,age,city")
    let mut i: i32 = 0
    while i < fields.len() {
        Stdio::println(fields.get_unchecked(i))
        i = i + 1
    }
    Stdio::println("---")
    let fields2 = csv::Csv::split_line("hello, world, test")
    let mut j: i32 = 0
    while j < fields2.len() {
        Stdio::println(fields2.get_unchecked(j))
        j = j + 1
    }
    Stdio::println("---")
    let fields3 = csv::Csv::split_line("solo")
    Stdio::println(fields3.get_unchecked(0))
}
// Split a basic CSV line
// Split a line with spaces
// Single field (no comma)
