use std::host::stdio::Stdio
use std::csv

fn main() {
    // Test csv_count_rows with one-pass scan
    let data = "a,b,c\nd,e,f\ng,h,i\n"
    Stdio::println((csv::Csv::count_rows(data)).to_string())
    // Empty lines should be skipped
    let data2 = "a,b\n\nc,d\n\ne,f\n"
    Stdio::println((csv::Csv::count_rows(data2)).to_string())
    // Test csv_get_row_raw
    let data3 = "h1,h2,h3\nv1,v2,v3\nv4,v5,v6\n"
    Stdio::println(csv::Csv::get_row_raw(data3, 0))
    Stdio::println(csv::Csv::get_row_raw(data3, 1))
    Stdio::println(csv::Csv::get_row_raw(data3, 2))
}
