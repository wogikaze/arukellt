// `shrink_to_fit` maintains the i32 load-factor invariant; the String store
// has no buckets, so the call must not reach the i32 helper (#917).
use std::collections::hash_set::HashSet

fn main() {
    let s: HashSet<String> = HashSet::new<String>()
    let _ = s.insert("red")
    s.shrink_to_fit()
}
