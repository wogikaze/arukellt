use std::host::stdio::Stdio

// ADR-088 §1: a method receiver is a place use like an argument.
struct Parser {
    rest: String,
}

impl Parser {
    fn size(self: Parser) -> i32 {
        self.rest.len()
    }
}

fn main() {
    let parser = Parser { rest: String_from("text") }
    let owned = parser
    Stdio::println(parser.size().to_string())
    Stdio::println(owned.size().to_string())
}
