use std::host::stdio::Stdio

// ADR-059 §4: the trailing expression of a body is a return value even
// without a `return` node, so reading a moved binding there is E0212.
fn take() -> String {
    let first = String_from("tail")
    let second = first
    Stdio::println(second)
    first
}

fn main() {
    Stdio::println(take())
}
