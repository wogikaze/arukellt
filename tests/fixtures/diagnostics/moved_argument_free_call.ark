use std::host::stdio

// ADR-088 §1: a call borrows a live argument, but a binding moved into another
// binding earlier is a use of a moved value (E0212) even in argument position.
struct Point {
    s: String,
}

fn show(p: Point) {
    stdio::println(p.s)
}

fn main() {
    let a = Point { s: String_from("a") }
    let b = a
    show(a)
    show(b)
}
