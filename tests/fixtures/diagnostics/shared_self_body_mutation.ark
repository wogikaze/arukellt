// ADR-088 §3: a shared receiver is a call-scoped borrow; the method may read
// `self` but not assign through it.

struct Counter {
    n: i32,
}

impl Counter {
    fn bump(self) {
        self.n = self.n + 1
    }

    fn value(self) -> i32 {
        self.n
    }
}

fn main() {
    let mut counter = Counter { n: 1 }
    counter.bump()
}
