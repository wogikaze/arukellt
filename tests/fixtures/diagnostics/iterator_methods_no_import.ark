// Iterator method calls require the iterator module; the compiler must reject
// the call instead of lowering it to a runtime trap (#917 next1054 residual).
fn double(x: i32) -> i32 { x * 2 }

fn main() {
    let mut values: Vec<i32> = Vec::new<i32>()
    push(values, 1)
    push(values, 2)
    let mapped = values.iter().map(double).collect()
    assert(len(mapped) == 2)
}
