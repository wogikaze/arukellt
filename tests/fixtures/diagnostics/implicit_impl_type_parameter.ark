// ADR-089: the binder is the migration target, but ADR-014 keeps the retired
// binder-less spelling compiling during the 0.x window. `T` is still inferred
// as an impl type parameter here, with W0222 and the binder hint.

struct Wrap<T> {
    item: T,
}

impl Iterator for Wrap<T> {
    fn next(self: Wrap<T>) -> Option<T> {
        Option::Some(self.item)
    }
}

fn main() {}
