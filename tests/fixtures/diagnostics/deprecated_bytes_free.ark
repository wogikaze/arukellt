// W0009: the std::bytes free functions stay callable during the ADR-087
// deprecation window; the method / associated surface is the replacement.
use std::bytes
use std::test

fn main() {
    let b: Vec<i32> = bytes::bytes_new()
    bytes::bytes_push(b, 1)
    test::assert_eq_i32(bytes::bytes_len(b), 1)
    test::assert_eq_string(bytes::hex_encode(b), "01")
}
