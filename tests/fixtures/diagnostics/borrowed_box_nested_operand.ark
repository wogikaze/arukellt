use std::prelude::Box

// ADR-088 §6: `take` moves the borrowed Box even when the call is an operand
// of a larger expression. The value-shape walk must recurse through read
// positions instead of stopping at the binary node.
fn offset(b: Box<i32>) -> i32 {
    return b.take() + 1
}

fn main() {
    let boxed: Box<i32> = Box::new(2)
    let _n = offset(boxed)
}
