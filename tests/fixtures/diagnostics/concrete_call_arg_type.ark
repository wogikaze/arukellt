// A non-generic call checks each argument against the resolved declaration's
// parameter type. Anything else used to reach lowering and fault at runtime or
// produce invalid Wasm (#935).
use std::host::stdio::Stdio

struct P {
    s: String,
    n: i32,
}

fn add_one(x: i32) -> i32 {
    x + 1
}

fn name_of(p: P) -> String {
    p.s
}

fn main() {
    Stdio::println(add_one(true).to_string())
    Stdio::println(name_of(42))
}
