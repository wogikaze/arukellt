// The family boundary is target-independent: the linear wasm32 store also
// rejects `capacity` on HashSet<String> (#917).
use std::collections::hash_set::HashSet
use std::test

fn main() {
    let mut s: HashSet<String> = HashSet::new<String>()
    let _ = s.insert("red")
    test::assert_true(s.capacity() >= 1)
}
