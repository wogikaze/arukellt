use std::host::stdio::Stdio

fn strs() -> Vec<String> {
    let mut v = Vec::new<i32>()
    push(v, 7)
    v
}

fn main() {
    // The body returns Vec<i32>; the declared Vec<String> differs only in
    // its type argument, which the return check must compare (#938).
    let v = strs()
    Stdio::println(get_unchecked(v, 0))
}
