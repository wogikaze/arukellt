// A standalone BufReader::read_line call must instantiate its own mono
// instance. Its body reaches self.buffered() only from if conditions, so the
// mono demand edge depends on inferring conditions; the helper parameter also
// keeps the nested Result<Option<String>, IoError> payload type.
use std::host::stdio::Stdio
use std::io
use std::io::{BufReader, Reader}
use std::text

fn show(value: Result<Option<String>, io::IoError>) {
    match value {
        Result::Ok(found) => match found {
            Option::Some(line) => Stdio::println(line),
            Option::None => Stdio::println("<eof>"),
        },
        Result::Err(err) => Stdio::println(err.message()),
    }
}

fn main() {
    let mut br: BufReader<Reader> = BufReader::new<Reader>(
        Reader::from_bytes("A\nB".to_utf8_bytes()),
        3
    )
    show(br.read_line())
    show(br.read_line())
    show(br.read_line())
}
