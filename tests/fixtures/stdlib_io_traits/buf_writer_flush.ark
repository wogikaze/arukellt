// ADR-085 Phase C: BufWriter<W> capacity, auto-flush, and into_inner.
//
// `write` / `flush` go through generic bounds so the adapter is exercised as
// a Write implementation; write_string and into_inner are inherent methods.
use std::host::stdio::Stdio
use std::io
use std::io::{BufWriter, Writer}
use std::text

struct RejectingWriter {
    calls: i32,
}

impl io::Write for RejectingWriter {
    fn write(mut self: RejectingWriter, _data: Vec<i32>) -> Result<i32, io::IoError> {
        self.calls = self.calls + 1
        Ok(0)
    }

    fn flush(self: RejectingWriter) -> Result<(), io::IoError> {
        Ok(())
    }
}

struct OneByteWriter {
    bytes: Vec<i32>,
}

impl io::Write for OneByteWriter {
    fn write(mut self: OneByteWriter, data: Vec<i32>) -> Result<i32, io::IoError> {
        if len(data) == 0 {
            return Ok(0)
        }
        push(self.bytes, get_unchecked(data, 0))
        Ok(1)
    }

    fn flush(self: OneByteWriter) -> Result<(), io::IoError> {
        Ok(())
    }
}

fn write_bytes_to<T: io::Write>(mut sink: T, data: Vec<i32>) -> Result<i32, io::IoError> {
    sink.write(data)
}

fn flush_sink<T: io::Write>(mut sink: T) -> Result<(), io::IoError> {
    sink.flush()
}

fn main() {
    let writer: Writer = Writer::new()
    let mut buffered: BufWriter<Writer> = BufWriter::new<Writer>(writer, 4)
    let write_result: Result<i32, io::IoError> = write_bytes_to(buffered, "AB".to_utf8_bytes())
    match write_result {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }
    let flush_result: Result<(), io::IoError> = flush_sink(buffered)
    match flush_result {
        Result::Ok(_) => Stdio::println("flush ok"),
        Result::Err(err) => Stdio::println(err.message()),
    }
    let text_result: Result<i32, io::IoError> = buffered.write_string("cd")
    match text_result {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }
    let write_result: Result<i32, io::IoError> = write_bytes_to(buffered, "EFG".to_utf8_bytes())
    match write_result {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }
    let inner_result: Result<Writer, io::IoError> = buffered.into_inner()
    match inner_result {
        Result::Ok(inner) => {
            let bytes: Vec<i32> = inner.into_bytes()
            Stdio::println((len(bytes)).to_string())
            Stdio::println((get_unchecked(bytes, 0)).to_string())
            Stdio::println((get_unchecked(bytes, 6)).to_string())
        },
        Result::Err(err) => Stdio::println(err.message()),
    }

    let mut zero: BufWriter<Writer> = BufWriter::new<Writer>(Writer::new(), 0)
    let write_result: Result<i32, io::IoError> = write_bytes_to(zero, "HI".to_utf8_bytes())
    match write_result {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }
    let write_result: Result<i32, io::IoError> = write_bytes_to(zero, "J".to_utf8_bytes())
    match write_result {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }
    let zero_result: Result<Writer, io::IoError> = zero.into_inner()
    match zero_result {
        Result::Ok(inner) => Stdio::println((len(inner.into_bytes())).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }

    let mut pending: BufWriter<Writer> = BufWriter::new<Writer>(Writer::new(), 100)
    let write_result: Result<i32, io::IoError> = write_bytes_to(pending, "K".to_utf8_bytes())
    match write_result {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }
    let pending_result: Result<Writer, io::IoError> = pending.into_inner()
    match pending_result {
        Result::Ok(inner) => Stdio::println((len(inner.into_bytes())).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }

    let mut text_writer: Writer = Writer::new()
    let writer_text_result: Result<i32, io::IoError> = text_writer.write_string("hé")
    match writer_text_result {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }
    Stdio::println((len(text_writer.into_bytes())).to_string())

    let mut empty: BufWriter<Writer> = BufWriter::new<Writer>(Writer::new(), 8)
    let flush_result: Result<(), io::IoError> = flush_sink(empty)
    match flush_result {
        Result::Ok(_) => Stdio::println("empty flush ok"),
        Result::Err(err) => Stdio::println(err.message()),
    }

    let mut rejected: BufWriter<RejectingWriter> =
    BufWriter::new<RejectingWriter>(RejectingWriter { calls: 0 }, 1)
    let write_result: Result<i32, io::IoError> = write_bytes_to(rejected, "A".to_utf8_bytes())
    match write_result {
        Result::Ok(_) => Stdio::println("unexpected buffered write"),
        Result::Err(err) => Stdio::println(err.message()),
    }

    let mut partial: BufWriter<OneByteWriter> =
    BufWriter::new<OneByteWriter>(OneByteWriter { bytes: Vec::new<i32>() }, 4)
    let write_result: Result<i32, io::IoError> = write_bytes_to(partial, "ABC".to_utf8_bytes())
    match write_result {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }
    let flush_result: Result<(), io::IoError> = flush_sink(partial)
    match flush_result {
        Result::Ok(_) => Stdio::println("partial flush ok"),
        Result::Err(err) => Stdio::println(err.message()),
    }
    let partial_result: Result<OneByteWriter, io::IoError> = partial.into_inner()
    match partial_result {
        Result::Ok(inner) => Stdio::println((len(inner.bytes)).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }
}
