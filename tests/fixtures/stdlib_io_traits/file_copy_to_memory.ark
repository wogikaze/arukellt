// ADR-085 Phase D: Io::copy moves a File's remaining bytes into an in-memory
// Writer through the Read / Write traits, so the generic algorithm sees a
// host-backed source rather than the memory Reader.
use std::host::fs
use std::host::stdio::Stdio
use std::io
use std::io::{Io, Seek, SeekFrom, Writer}

fn print_byte_values(bytes: Vec<i32>) {
    Stdio::println((bytes.len()).to_string())
    let mut i: i32 = 0
    while i < bytes.len() {
        Stdio::println((bytes.get_unchecked(i)).to_string())
        i = i + 1
    }
}

fn print_copy_count<T: io::Read, U: io::Write>(mut from: T, mut to: U) {
    match Io::copy(from, to) {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(err) => Stdio::println(err.message()),
    }
}

fn print_seek<T: io::Seek>(mut source: T, from: SeekFrom) {
    match source.seek(from) {
        Result::Ok(_) => {
        },
        Result::Err(err) => Stdio::println(err.message()),
    }
}

fn main() {
    match fs::File::open("tests/fixtures/stdlib_io_traits/file_image.bin") {
        Result::Ok(file) => {
            // Explicit handle type keeps Io::copy on the File/Writer mono
            // instance; the match payload alone stays a type variable.
            let mut file: fs::File = file
            let mut writer: Writer = Writer::new()
            print_copy_count(file, writer)
            print_byte_values(writer.into_bytes())
        },
        Result::Err(err) => Stdio::println(err.message()),
    }

    match fs::File::open("tests/fixtures/stdlib_io_traits/file_image.bin") {
        Result::Ok(file) => {
            let mut file: fs::File = file
            print_seek(file, SeekFrom::Start(3i64))
            let mut writer: Writer = Writer::new()
            print_copy_count(file, writer)
            print_byte_values(writer.into_bytes())
        },
        Result::Err(err) => Stdio::println(err.message()),
    }

    match fs::File::open("tests/fixtures/stdlib_io_traits/file_image.bin") {
        Result::Ok(file) => {
            let mut file: fs::File = file
            print_seek(file, SeekFrom::End(0i64))
            let mut writer: Writer = Writer::new()
            print_copy_count(file, writer)
        },
        Result::Err(err) => Stdio::println(err.message()),
    }

    match fs::File::open("tests/fixtures/stdlib_io_traits/missing_image.bin") {
        Result::Ok(_) => Stdio::println("unexpected open"),
        Result::Err(err) => Stdio::println(err.message()),
    }
}
