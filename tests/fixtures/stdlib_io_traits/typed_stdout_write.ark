// Typed Stdout implements std::io::Write. write() emits the byte image
// unchanged (including interior newlines) and returns its exact length;
// write_string() emits a string's UTF-8 bytes; an empty write reports 0.
use std::host::stdio::Stdio
use std::io::{Stdout, Write}

fn main() {
    let out: Stdout = Stdout::new()
    let mut bytes: Vec<i32> = Vec::new<i32>()
    bytes.push(65)
    bytes.push(10)
    bytes.push(66)
    bytes.push(10)
    match out.write(bytes) {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(_) => Stdio::println("stdout write failed"),
    }
    match out.write_string("text\n") {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(_) => Stdio::println("stdout write_string failed"),
    }
    match out.write(Vec::new<i32>()) {
        Result::Ok(count) => Stdio::println((count).to_string()),
        Result::Err(_) => Stdio::println("stdout empty write failed"),
    }
    Stdio::println("stdout done")
}
