// ADR-085 Phase D: the whole-file write contract. Existing bytes stay visible
// until a successful flush, read-only handles reject write, write-only handles
// reject read, close commits an untouched image as a truncate, and writing
// past the end extends the image with zero bytes.
use std::host::fs
use std::host::fs::Fs
use std::host::stdio
use std::io
use std::io::{Io, Read, Seek, SeekFrom, Write}

fn print_image(path: String) {
    match Fs::read_bytes(path) {
        Result::Ok(image) => {
            let image: Vec<i32> = image
            stdio::println((len(image)).to_string())
            let mut i: i32 = 0
            while i < len(image) {
                stdio::println((get_unchecked(image, i)).to_string())
                i = i + 1
            }
        },
        Result::Err(err) => stdio::println(err),
    }
}

fn main() {
    match Fs::write_bytes(".build/file_write_contract.bin", "OLD".to_utf8_bytes()) {
        Result::Ok(_) => stdio::println("seeded"),
        Result::Err(err) => stdio::println(err),
    }
    match fs::File::create(".build/file_write_contract.bin") {
        Result::Ok(file) => {
            let mut file: fs::File = file
            match file.write("new".to_utf8_bytes()) {
                Result::Ok(count) => stdio::println((count).to_string()),
                Result::Err(err) => stdio::println(err.message()),
            }
            match Fs::read_bytes(".build/file_write_contract.bin") {
                Result::Ok(image) => stdio::println(String::from_utf8_lossy(image)),
                Result::Err(err) => stdio::println(err),
            }
            match file.flush() {
                Result::Ok(_) => stdio::println("flushed"),
                Result::Err(err) => stdio::println(err.message()),
            }
            match Fs::read_bytes(".build/file_write_contract.bin") {
                Result::Ok(image) => stdio::println(String::from_utf8_lossy(image)),
                Result::Err(err) => stdio::println(err),
            }
            let payload: Vec<i32> = "XYZ".to_utf8_bytes()
            match Io::write_all(file, payload) {
                Result::Ok(_) => stdio::println("write_all ok"),
                Result::Err(err) => stdio::println(err.message()),
            }
            match file.flush() {
                Result::Ok(_) => stdio::println("flushed2"),
                Result::Err(err) => stdio::println(err.message()),
            }
            match Fs::read_bytes(".build/file_write_contract.bin") {
                Result::Ok(image) => stdio::println(String::from_utf8_lossy(image)),
                Result::Err(err) => stdio::println(err),
            }
            match file.close() {
                Result::Ok(_) => stdio::println("closed"),
                Result::Err(err) => stdio::println(err.message()),
            }
            match file.write("z".to_utf8_bytes()) {
                Result::Ok(_) => stdio::println("write after close unexpectedly ok"),
                Result::Err(err) => stdio::println(err.message()),
            }
        },
        Result::Err(err) => stdio::println(err.message()),
    }

    match fs::File::open(".build/file_write_contract.bin") {
        Result::Ok(file) => {
            let mut file: fs::File = file
            match file.write("x".to_utf8_bytes()) {
                Result::Ok(_) => stdio::println("read-only write unexpectedly ok"),
                Result::Err(err) => stdio::println(err.message()),
            }
            match file.flush() {
                Result::Ok(_) => stdio::println("read-only flush ok"),
                Result::Err(err) => stdio::println(err.message()),
            }
        },
        Result::Err(err) => stdio::println(err.message()),
    }

    match fs::File::create(".build/file_write_contract.bin") {
        Result::Ok(file) => {
            let mut file: fs::File = file
            match file.read(1) {
                Result::Ok(_) => stdio::println("write-only read unexpectedly ok"),
                Result::Err(err) => stdio::println(err.message()),
            }
            match file.close() {
                Result::Ok(_) => stdio::println("truncated"),
                Result::Err(err) => stdio::println(err.message()),
            }
        },
        Result::Err(err) => stdio::println(err.message()),
    }
    print_image(".build/file_write_contract.bin")

    match fs::File::create(".build/file_write_gap.bin") {
        Result::Ok(file) => {
            let mut file: fs::File = file
            match file.seek(SeekFrom::Start(2i64)) {
                Result::Ok(position) => stdio::println((position).to_string()),
                Result::Err(err) => stdio::println(err.message()),
            }
            match file.write("A".to_utf8_bytes()) {
                Result::Ok(count) => stdio::println((count).to_string()),
                Result::Err(err) => stdio::println(err.message()),
            }
            match file.flush() {
                Result::Ok(_) => stdio::println("gap flushed"),
                Result::Err(err) => stdio::println(err.message()),
            }
            match file.close() {
                Result::Ok(_) => stdio::println("gap closed"),
                Result::Err(err) => stdio::println(err.message()),
            }
        },
        Result::Err(err) => stdio::println(err.message()),
    }
    print_image(".build/file_write_gap.bin")
}
