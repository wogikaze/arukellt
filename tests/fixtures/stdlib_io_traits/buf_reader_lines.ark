// ADR-085 Phase C: BufReader<R> line, buffer, and seek semantics.
//
// Trait calls go through generic bounds: direct Result-returning method
// dispatch is a separate compiler lane, while the adapter itself dispatches
// `self.inner.read(...)` in its own impl.
use std::host::stdio
use std::io
use std::io::{BufReader, Reader}
use std::text

fn read_some<T: io::Read>(source: T, max_bytes: i32) -> Result<Vec<i32>, io::IoError> {
    source.read(max_bytes)
}

fn read_line_of<T: io::BufRead>(source: T) -> Result<Option<String>, io::IoError> {
    source.read_line()
}

fn fill_of<T: io::BufRead>(source: T) -> Result<Vec<i32>, io::IoError> {
    source.fill_buf()
}

fn consume_of<T: io::BufRead>(source: T, amount: i32) -> Result<(), io::IoError> {
    source.consume(amount)
}

fn seek_of<T: io::Seek>(source: T, from: io::SeekFrom) -> Result<i64, io::IoError> {
    source.seek(from)
}

fn position_of<T: io::Seek>(source: T) -> Result<i64, io::IoError> {
    source.position()
}

fn main() {
    let lines: BufReader<Reader> = BufReader::new<Reader>(
        Reader::from_bytes("alpha\nbeta\n\ngamma".to_utf8_bytes()),
        3
    )
    let mut line_index: i32 = 0
    while line_index < 5 {
        match read_line_of(lines) {
            Result::Ok(found) => match found {
                Option::Some(line) => stdio::println(line),
                Option::None => stdio::println("<eof>"),
            },
            Result::Err(err) => stdio::println(io::io_error_message(err)),
        }
        line_index = line_index + 1
    }

    let buffered: BufReader<Reader> = BufReader::new<Reader>(
        Reader::from_bytes("abcdef".to_utf8_bytes()),
        4
    )
    match fill_of(buffered) {
        Result::Ok(bytes) => stdio::println((len(bytes)).to_string()),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match consume_of(buffered, 2) {
        Result::Ok(_) => stdio::println("consume ok"),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match fill_of(buffered) {
        Result::Ok(bytes) => stdio::println((len(bytes)).to_string()),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match consume_of(buffered, 3) {
        Result::Ok(_) => stdio::println("unexpected consume success"),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match read_some(buffered, 4) {
        Result::Ok(bytes) => {
            stdio::println((len(bytes)).to_string())
            stdio::println((get_unchecked(bytes, 0)).to_string())
            stdio::println((get_unchecked(bytes, 3)).to_string())
        },
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }

    let seekable: BufReader<Reader> = BufReader::new<Reader>(
        Reader::from_bytes("abcdef".to_utf8_bytes()),
        4
    )
    match read_some(seekable, 2) {
        Result::Ok(_) => {
        },
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match position_of(seekable) {
        Result::Ok(pos) => stdio::println((pos).to_string()),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match seek_of(seekable, io::SeekFrom::Start(0i64)) {
        Result::Ok(pos) => stdio::println((pos).to_string()),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match read_line_of(seekable) {
        Result::Ok(found) => match found {
            Option::Some(line) => stdio::println(line),
            Option::None => stdio::println("<eof>"),
        },
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match position_of(seekable) {
        Result::Ok(pos) => stdio::println((pos).to_string()),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match seek_of(seekable, io::SeekFrom::Start(0i64)) {
        Result::Ok(_) => {
        },
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match read_some(seekable, 2) {
        Result::Ok(bytes) => stdio::println((len(bytes)).to_string()),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match seek_of(seekable, io::SeekFrom::Current(1i64)) {
        Result::Ok(pos) => stdio::println((pos).to_string()),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match read_some(seekable, 1) {
        Result::Ok(bytes) => stdio::println((get_unchecked(bytes, 0)).to_string()),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match seek_of(seekable, io::SeekFrom::End(0i64 - 1i64)) {
        Result::Ok(pos) => stdio::println((pos).to_string()),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match read_some(seekable, 1) {
        Result::Ok(bytes) => stdio::println((get_unchecked(bytes, 0)).to_string()),
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }

    let tiny: BufReader<Reader> = BufReader::new<Reader>(
        Reader::from_bytes("AB".to_utf8_bytes()),
        0
    )
    match read_some(tiny, 4) {
        Result::Ok(bytes) => {
            stdio::println((len(bytes)).to_string())
            stdio::println((get_unchecked(bytes, 0)).to_string())
        },
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }

    let unterminated: BufReader<Reader> = BufReader::new<Reader>(
        Reader::from_bytes("hello".to_utf8_bytes()),
        2
    )
    match read_line_of(unterminated) {
        Result::Ok(found) => match found {
            Option::Some(line) => stdio::println(line),
            Option::None => stdio::println("<eof>"),
        },
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
    match read_line_of(unterminated) {
        Result::Ok(found) => match found {
            Option::Some(line) => stdio::println(line),
            Option::None => stdio::println("<eof>"),
        },
        Result::Err(err) => stdio::println(io::io_error_message(err)),
    }
}
