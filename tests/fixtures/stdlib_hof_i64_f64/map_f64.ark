use std::host::stdio::Stdio

fn square(x: f64) -> f64 {
    x * x
}

fn main() {
    let mut v: Vec<f64> = Vec::new<f64>()
    v.push(2.0)
    v.push(3.0)
    v.push(4.0)
    let mut squared: Vec<f64> = Vec::new<f64>()
    let mut map_index: i32 = 0
    while map_index < v.len() {
        squared.push(square(get_unchecked(v, map_index)))
        map_index = map_index + 1
    }
    let mut i: i32 = 0
    while i < squared.len() {
        Stdio::println((get_unchecked(squared, i)).to_string())
        i = i + 1
    }
}
