use std::host::stdio::Stdio

fn double(x: i64) -> i64 {
    x * 2i64
}

fn main() {
    let mut v: Vec<i64> = Vec::new<i64>()
    push(v, 10i64)
    push(v, 20i64)
    push(v, 30i64)
    let mut doubled: Vec<i64> = Vec::new<i64>()
    let mut map_index: i32 = 0
    while map_index < v.len() {
        push(doubled, double(v.get_unchecked(map_index)))
        map_index = map_index + 1
    }
    let mut i: i32 = 0
    while i < doubled.len() {
        Stdio::println((doubled.get_unchecked(i)).to_string())
        i = i + 1
    }
}
