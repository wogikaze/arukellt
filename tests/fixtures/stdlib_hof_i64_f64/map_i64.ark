use std::host::stdio
use std::prelude::{map_i64_i64}
fn double(x: i64) -> i64 {
    x * 2i64
}

fn main() {
    let mut v: Vec<i64> = Vec::new<i64>()
    push(v, 10i64)
    push(v, 20i64)
    push(v, 30i64)
    let doubled: Vec<i64> = map_i64_i64(v, double)
    let mut i: i32 = 0
    while i < len(doubled) {
        stdio::println((get_unchecked(doubled, i)).to_string())
        i = i + 1
    }
}
