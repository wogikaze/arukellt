use std::host::stdio::Stdio

fn add(acc: i64, x: i64) -> i64 {
    acc + x
}

fn main() {
    let mut v: Vec<i64> = Vec::new<i64>()
    push(v, 10i64)
    push(v, 20i64)
    push(v, 30i64)
    let mut total: i64 = 0i64
    let mut fold_index: i32 = 0
    while fold_index < len(v) {
        total = add(total, get_unchecked(v, fold_index))
        fold_index = fold_index + 1
    }
    Stdio::println((total).to_string())
}
