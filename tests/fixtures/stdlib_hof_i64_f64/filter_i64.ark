use std::host::stdio
use std::prelude::{filter_i64}
fn is_positive(x: i64) -> bool {
    x > 0i64
}

fn main() {
    let mut v: Vec<i64> = Vec::new<i64>()
    push(v, -5i64)
    push(v, 10i64)
    push(v, -3i64)
    push(v, 20i64)
    let pos: Vec<i64> = filter_i64(v, is_positive)
    let mut i: i32 = 0
    while i < len(pos) {
        stdio::println((get_unchecked(pos, i)).to_string())
        i = i + 1
    }
}
