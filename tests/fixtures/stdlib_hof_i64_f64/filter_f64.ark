use std::host::stdio::Stdio

fn is_large(x: f64) -> bool {
    x > 5.0
}

fn main() {
    let mut v: Vec<f64> = Vec::new<f64>()
    v.push(1.5)
    v.push(7.0)
    v.push(3.0)
    v.push(10.5)
    let mut large: Vec<f64> = Vec::new<f64>()
    let mut filter_index: i32 = 0
    while filter_index < v.len() {
        let filter_value = get_unchecked(v, filter_index)
        if is_large(filter_value) {
            large.push(filter_value)
        }
        filter_index = filter_index + 1
    }
    let mut i: i32 = 0
    while i < large.len() {
        Stdio::println((get_unchecked(large, i)).to_string())
        i = i + 1
    }
}
