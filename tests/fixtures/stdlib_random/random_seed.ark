use std::test::Test
use std::host::stdio::Stdio
use std::random::Rng
use std::test::Test
fn main() {
    let a = Rng::new(12345).next()
    let b = Rng::new(12345).next()
    Test::assert_eq_i32(a, -958040966)
    Test::assert_eq_i32(a, b)

    let c = Rng::new(99999).next()
    Test::assert_eq_i32(c, 714973238)
    assert(a != c)

    let s1 = Rng::new(42).next()
    let s2 = Rng::new(s1).next()
    let s3 = Rng::new(s2).next()
    let r1 = Rng::new(42).next()
    let r2 = Rng::new(r1).next()
    let r3 = Rng::new(r2).next()
    Test::assert_eq_i32(s1, 11355432)
    Test::assert_eq_i32(s1, r1)
    Test::assert_eq_i32(s2, r2)
    Test::assert_eq_i32(s3, r3)
    Stdio::println("random_seed ok")
}
// Test seeded_random determinism.
// Exact outputs pin the xorshift32 implementation.
// Chained calls are reproducible when the derived value is reused as input.
