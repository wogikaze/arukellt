use std::host::stdio::Stdio
use std::random::Rng
use std::prelude::{assert_eq}
fn main() {
    assert_eq(Rng::new(99).range(10, 20), 19)
    assert_eq(Rng::new(99).range(10, 10), 10)
    assert_eq(Rng::new(99).range(12, 8), 12)
    assert_eq(Rng::new(99).range(-4, 3), 0)
    Stdio::println("random_range ok")
}
