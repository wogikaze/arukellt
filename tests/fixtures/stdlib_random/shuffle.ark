use std::test::Test
use std::host::stdio::Stdio
use std::random::Rng
use std::test::Test
fn main() {
    let mut v = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)
    push(v, 40)
    push(v, 50)
    let shuffled = Rng::new(42).shuffle(v)
    Test::assert_eq_i32(shuffled.len(), 5)
    Test::assert_eq_i32(shuffled.get_unchecked(0), 30)
    Test::assert_eq_i32(shuffled.get_unchecked(1), 40)
    Test::assert_eq_i32(shuffled.get_unchecked(2), 20)
    Test::assert_eq_i32(shuffled.get_unchecked(3), 50)
    Test::assert_eq_i32(shuffled.get_unchecked(4), 10)
    Stdio::println("shuffle ok")
}
// Same length
// Exact permutation is reproducible for a fixed seed
