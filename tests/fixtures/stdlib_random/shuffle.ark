use std::test::Test
use std::host::stdio::Stdio
use std::random::Rng
use std::test::Test
fn main() {
    let mut v = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)
    v.push(50)
    let shuffled = Rng::new(42).shuffle(v)
    Test::assert_eq_i32(shuffled.len(), 5)
    Test::assert_eq_i32(get_unchecked(shuffled, 0), 30)
    Test::assert_eq_i32(get_unchecked(shuffled, 1), 40)
    Test::assert_eq_i32(get_unchecked(shuffled, 2), 20)
    Test::assert_eq_i32(get_unchecked(shuffled, 3), 50)
    Test::assert_eq_i32(get_unchecked(shuffled, 4), 10)
    Stdio::println("shuffle ok")
}
// Same length
// Exact permutation is reproducible for a fixed seed
