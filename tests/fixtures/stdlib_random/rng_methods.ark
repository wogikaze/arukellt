use std::test::Test
// Rng receiver surface (ADR-046); wasm32-gc lane.
use std::host::stdio::Stdio
use std::random::Rng
use std::test::Test

fn main() {
    Test::assert_eq_i32(Rng::new(1).next(), 270369)
    Test::assert_eq_i32(Rng::new(42).range(0, 10), 2)
    let mut v = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)
    push(v, 40)
    push(v, 50)
    let shuffled = Rng::new(42).shuffle(v)
    Test::assert_eq_i32(shuffled.len(), 5)
    Test::assert_eq_i32(get_unchecked(shuffled, 0), 30)
    Test::assert_eq_i32(get_unchecked(shuffled, 4), 10)
    Stdio::println("rng methods ok")
}
