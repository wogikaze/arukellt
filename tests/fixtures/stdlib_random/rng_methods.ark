// Rng receiver surface (ADR-046); wasm32-gc lane.
use std::host::stdio
use std::random::Rng
use std::prelude::{assert_eq}

fn main() {
    assert_eq(Rng::new(1).next(), 270369)
    assert_eq(Rng::new(42).range(0, 10), 2)
    let v = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)
    push(v, 40)
    push(v, 50)
    let shuffled = Rng::new(42).shuffle(v)
    assert_eq(len(shuffled), 5)
    assert_eq(get_unchecked(shuffled, 0), 30)
    assert_eq(get_unchecked(shuffled, 4), 10)
    stdio::println("rng methods ok")
}
