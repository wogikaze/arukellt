use std::host::stdio::Stdio
use std::core::iter

fn is_long(s: String) -> bool {
    s.len() > 3
}

fn main() {
    let mut v: Vec<String> = Vec::new<String>()
    push(v, String_from("hi"))
    push(v, String_from("hello"))
    push(v, String_from("ok"))
    push(v, String_from("world"))
    push(v, String_from("no"))
    let result: Vec<String> = v.iter().filter(is_long).collect()
    let mut i: i32 = 0
    while i < result.len() {
        Stdio::println(get_unchecked(result, i))
        i = i + 1
    }
}
