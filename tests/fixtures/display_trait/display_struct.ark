use std::host::stdio::Stdio
use std::text
struct Point {
    x: i32,
    y: i32,
}

trait Display {
    fn to_string(self: Display) -> String
}

impl Display for Point {
    fn to_string(self: Point) -> String {
        ("(".concat(self.x.to_string())).concat(", ").concat(self.y.to_string()).concat(")")
    }
}

fn main() {
    let p = Point { x: 3, y: 4 }
    Stdio::println(p.to_string())
    let msg = "Point is ".concat(p.to_string())
    Stdio::println(msg)
}
