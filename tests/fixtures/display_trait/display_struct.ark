use std::host::stdio
use std::text
struct Point {
    x: i32,
    y: i32,
}

trait Display {
    fn to_string(self: Display) -> String
}

impl Display for Point {
    fn to_string(self: Point) -> String {
        ("(".concat(to_string(self.x))).concat(", ").concat(to_string(self.y)).concat(")")
    }
}

fn main() {
    let p = Point { x: 3, y: 4 }
    stdio::println(to_string(p))
    let msg = "Point is ".concat(to_string(p))
    stdio::println(msg)
}
