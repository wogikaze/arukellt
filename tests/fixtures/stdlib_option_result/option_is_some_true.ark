use std::host::stdio
use std::test::Test

fn main() {
    let one: Option<i32> = Some(1)
    let zero: Option<i32> = Some(0)
    let negative: Option<i32> = Some(-1)
    Test::assert_true(one.is_some())
    Test::assert_true(zero.is_some())
    Test::assert_true(negative.is_some())
    stdio::println("ok")
}
