use std::host::stdio
use std::test::Test

fn inner(s: String) -> Result<i32, String> {
    if s.eq("ok") { Ok(1) } else { Err(String_from("inner fail")) }
}
fn outer(s: String) -> Result<i32, String> {
    let v: i32 = inner(s)?
    Ok(v + 10)
}
fn main() {
    let ok_r = outer(String_from("ok"))
    match ok_r { Result::Ok(v) => Test::assert_eq_i32(v, 11), Result::Err(e) => Std::panic(e) }
    let err_r = outer(String_from("bad"))
    Test::assert_true(err_r.is_err())
    stdio::println("ok")
}
