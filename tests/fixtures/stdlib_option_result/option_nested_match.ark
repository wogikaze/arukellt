use std::host::stdio::Stdio
use std::test::Test
fn main() {
    let a: Option<Option<i32>> = Some(Some(42))
    match a {
        Option::Some(inner) => match inner {
            Option::Some(v) => Test::assert_eq_i32(v, 42),
            None => Std::panic("inner none"),
        },
        None => Std::panic("outer none"),
    }
    Stdio::println("ok")
}
