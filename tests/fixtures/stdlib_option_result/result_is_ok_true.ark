use std::host::stdio::Stdio
use std::test::Test

fn main() {
    let one: Result<i32, i32> = Ok(1)
    let zero: Result<i32, i32> = Ok(0)
    let negative: Result<i32, i32> = Ok(-1)
    Test::assert_true(one.is_ok())
    Test::assert_true(zero.is_ok())
    Test::assert_true(negative.is_ok())
    Stdio::println("ok")
}
