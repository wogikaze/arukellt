use std::host::stdio::Stdio
use std::test::Test
fn main() {
    let a: Option<i32> = Some(100)
    let b: Option<i32> = None
    match a { Option::Some(v) => Test::assert_eq_i32(v, 100), None => Std::panic("none") }
    match b { Option::Some(v) => Std::panic("some"), None => {} }
    Stdio::println("ok")
}
