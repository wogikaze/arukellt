use std::host::stdio
use std::test::Test

fn main() {
    for i in 0..20 {
        let a: Option<i32> = Some(i)
        let b: Option<i32> = None
        Test::assert_true(a.is_some())
        Test::assert_true(b.is_none())
        Test::assert_true(a.is_some() != b.is_some())
    }
    stdio::println("ok")
}
