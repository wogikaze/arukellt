use std::host::stdio::Stdio
use std::test::Test

fn main() {
    let mut ok_count: i32 = 0
    for i in 0..50 {
        let r: Result<i32, i32> = if i % 3 == 0 { Ok(i) } else { Err(i) }
        if r.is_ok() { ok_count = ok_count + 1 }
    }
    Test::assert_eq_i32(ok_count, 17)
    Stdio::println("ok")
}
