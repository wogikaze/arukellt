use std::host::stdio
use std::test::Test
use std::prelude::{is_ok}
fn make_ok(v: i32) -> Result<i32, i32> {
    Ok(v)
}
fn main() {
    let r = make_ok(42)
    Test::assert_true(is_ok(r))
    match r { Result::Ok(v) => Test::assert_eq_i32(v, 42), Result::Err(e) => Std::panic("err") }
    stdio::println("ok")
}
