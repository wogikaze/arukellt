use std::core::convert
use std::host::stdio
use std::test::Test

fn parse_and_double(s: String) -> Result<i32, String> {
    let val: i32 =i32::try_from(s)?
    Ok(val * 2)
}
fn main() {
    let r = parse_and_double(String_from("abc"))
    match r { Result::Ok(v) => Std::panic("ok"), Result::Err(e) => {} }
    Test::assert_true(r.is_err())
    stdio::println("ok")
}
