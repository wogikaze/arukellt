use std::host::stdio::Stdio

// Regression: Option<Vec<i32>> Some(xs) must type xs as vec:i32 so
// get_unchecked resolves (local ann Option_Vec previously left bare Vec →
// drop/unreachable). Use get_unchecked because free get returns Option<T>.

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    let o: Option<Vec<i32>> = Some(v)
    let sum = match o {
        Some(xs) => xs.get_unchecked(0) + xs.get_unchecked(1),
        None => 0,
    }
    Stdio::println(sum.to_string())
}
