use std::host::stdio::Stdio
use std::test::Test
fn main() {
    let ok_r: Result<i32, i32> = Ok(100)
    let err_r: Result<i32, i32> = Err(200)
    match ok_r { Result::Ok(v) => Test::assert_eq_i32(v, 100), Result::Err(e) => Std::panic("err") }
    match err_r { Result::Ok(v) => Std::panic("ok"), Result::Err(e) => Test::assert_eq_i32(e, 200) }
    Stdio::println("ok")
}
