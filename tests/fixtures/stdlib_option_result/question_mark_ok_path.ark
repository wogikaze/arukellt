use std::core::convert
use std::host::stdio
use std::test::Test

fn parse_and_double(s: String) -> Result<i32, String> {
    let val: i32 =i32::try_from(s)?
    Ok(val * 2)
}
fn main() {
    let r = parse_and_double(String_from("21"))
    match r { Result::Ok(v) => Test::assert_eq_i32(v, 42), Result::Err(e) => Std::panic(e) }
    stdio::println("ok")
}
