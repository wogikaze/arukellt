use std::host::stdio::Stdio
use std::test::Test

fn main() {
    let n: i32 = 10
    let opt: Option<i32> = if n > 5 { Some(n) } else { None }
    Test::assert_true(opt.is_some())
    let opt2: Option<i32> = if n > 100 { Some(n) } else { None }
    Test::assert_true(opt2.is_none())
    Stdio::println("ok")
}
