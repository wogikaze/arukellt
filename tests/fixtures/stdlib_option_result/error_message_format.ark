use std::host::stdio
use std::test
use std::text
fn make_error(msg: String, ctx: String) -> Result<i32, String> {
    Err(msg.concat(String_from(" in ")).concat(ctx))
}
fn main() {
    let r = make_error(String_from("fail"), String_from("ctx"))
    match r { Result::Ok(v) => Std::panic("ok"), Result::Err(e) => test::assert_eq_string(e, String_from("fail in ctx")) }
    stdio::println("ok")
}
