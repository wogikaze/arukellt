use std::host::stdio::Stdio
use std::test::Test

fn main() {
    let r1: Result<i32, i32> = Ok(1)
    let r2: Result<i32, i32> = Ok(0)
    let r3: Result<i32, i32> = Ok(-1)
    Test::assert_true(r1.is_ok())
    Test::assert_true(r2.is_ok())
    Test::assert_true(r3.is_ok())
    Stdio::println("ok")
}
