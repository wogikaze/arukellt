use std::host::stdio
use std::test::Test
use std::prelude::{is_err, is_ok, unwrap_or}
fn main() {
    let r: Result<i32, i32> = Err(99)
    Test::assert_true(is_err(r))
    Test::assert_false(is_ok(r))
    match r { Result::Ok(v) => Std::panic("ok"), Result::Err(e) => Test::assert_eq_i32(e, 99) }
    Test::assert_eq_i32(unwrap_or(r, 0), 0)
    stdio::println("ok")
}
