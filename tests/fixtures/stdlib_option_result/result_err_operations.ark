use std::host::stdio::Stdio
use std::test::Test

fn main() {
    let r: Result<i32, i32> = Err(99)
    Test::assert_true(r.is_err())
    Test::assert_false(r.is_ok())
    match r { Result::Ok(v) => Std::panic("ok"), Result::Err(e) => Test::assert_eq_i32(e, 99) }
    Test::assert_eq_i32(r.unwrap_or(0), 0)
    Stdio::println("ok")
}
