use std::host::stdio::Stdio
use std::test::Test
fn double(x: i32) -> i32 { x * 2 }
fn main() {
    let r: Result<i32, i32> = Err(5)
    let m: Result<i32, i32> = match r { Result::Ok(v) => Ok(double(v)), Result::Err(e) => Err(e) }
    match m { Result::Ok(v) => Std::panic("ok"), Result::Err(e) => Test::assert_eq_i32(e, 5) }
    Stdio::println("ok")
}
