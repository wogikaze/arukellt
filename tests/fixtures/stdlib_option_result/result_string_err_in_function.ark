use std::host::stdio::Stdio
use std::test::Test

fn validate(n: i32) -> Result<i32, String> {
    if n > 0 { Ok(n) } else { Err(String_from("must be positive")) }
}
fn main() {
    Test::assert_true(validate(5).is_ok())
    let r = validate(-1)
    match r { Result::Ok(v) => Std::panic("ok"), Result::Err(e) => Test::assert_eq_string(e, String_from("must be positive")) }
    Stdio::println("ok")
}
