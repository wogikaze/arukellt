use std::host::stdio::Stdio
use std::test::Test
use std::text

fn try_parse(s: String) -> Result<i32, String> {
    if s.eq("42") { Ok(42) } else { Err(String_from("parse error: ").concat(s)) }
}
fn main() {
    let r = try_parse(String_from("bad"))
    Test::assert_true(r.is_err())
    match r { Result::Ok(v) => Std::panic("ok"), Result::Err(e) => Test::assert_eq_string(e, String_from("parse error: bad")) }
    Stdio::println("ok")
}
