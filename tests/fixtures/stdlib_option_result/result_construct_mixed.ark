use std::host::stdio::Stdio
use std::test::Test

fn main() {
    let ok_r: Result<i32, i32> = Ok(10)
    let err_r: Result<i32, i32> = Err(20)
    Test::assert_true(ok_r.is_ok())
    Test::assert_true(err_r.is_err())
    Test::assert_false(ok_r.is_err())
    Test::assert_false(err_r.is_ok())
    Stdio::println("ok")
}
