use std::host::stdio
use std::test::Test

fn main() {
    let v1: Option<i32> = Some(1)
    let v2: Option<i32> = Some(0)
    let v3: Option<i32> = Some(-1)
    let v4: Option<i32> = Some(2147483647)
    Test::assert_true(v1.is_some())
    Test::assert_true(v2.is_some())
    Test::assert_true(v3.is_some())
    Test::assert_true(v4.is_some())
    stdio::println("ok")
}
