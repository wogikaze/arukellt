use std::host::stdio
use std::test::Test
use std::prelude::{is_err}
fn main() {
    let r: Result<i32, String> = Err(String_from("fail"))
    Test::assert_true(is_err(r))
    match r { Result::Ok(v) => Std::panic("ok"), Result::Err(e) => Test::assert_eq_string(e, String_from("fail")) }
    stdio::println("ok")
}
