use std::host::stdio
use std::test::Test
use std::prelude::{is_err}
fn make_err(e: i32) -> Result<i32, i32> {
    Err(e)
}
fn main() {
    let r = make_err(7)
    Test::assert_true(is_err(r))
    match r { Result::Ok(v) => Std::panic("ok"), Result::Err(e) => Test::assert_eq_i32(e, 7) }
    stdio::println("ok")
}
