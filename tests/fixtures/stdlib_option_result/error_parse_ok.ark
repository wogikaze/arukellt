use std::host::stdio::Stdio
use std::test::Test
use std::text

fn try_parse(s: String) -> Result<i32, String> {
    if s.eq("42") { Ok(42) } else { Err(String_from("parse error: ").concat(s)) }
}
fn main() {
    let r = try_parse(String_from("42"))
    Test::assert_true(r.is_ok())
    match r { Result::Ok(v) => Test::assert_eq_i32(v, 42), Result::Err(e) => Std::panic(e) }
    Stdio::println("ok")
}
