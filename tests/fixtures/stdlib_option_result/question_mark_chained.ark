use std::core::convert
use std::host::stdio
use std::test::Test

fn step1(s: String) -> Result<i32, String> {
    let v: i32 =i32::try_from(s)?
    Ok(v + 1)
}
fn step2(s: String) -> Result<i32, String> {
    let v: i32 = step1(s)?
    Ok(v * 2)
}
fn main() {
    let r = step2(String_from("20"))
    match r { Result::Ok(v) => Test::assert_eq_i32(v, 42), Result::Err(e) => Std::panic(e) }
    stdio::println("ok")
}
