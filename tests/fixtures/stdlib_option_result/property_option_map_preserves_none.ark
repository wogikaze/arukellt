use std::host::stdio::Stdio
use std::test::Test
use std::core::container

fn double(x: i32) -> i32 { x * 2 }
fn main() {
    for i in 0..20 {
        let opt: Option<i32> = if i % 3 == 0 { None } else { Some(i) }
        let m = opt.map(double)
        if i % 3 == 0 {
            match m { Option::Some(v) => Std::panic("some"), None => {} }
        } else {
            match m { Option::Some(v) => Test::assert_eq_i32(v, i * 2), None => Std::panic("none") }
        }
    }
    Stdio::println("ok")
}
