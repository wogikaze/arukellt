use std::host::stdio::Stdio
use std::text
fn describe(opt: Option<i32>) -> String {
    match opt {
        Option::Some(val) => String_from("got ").concat((val).to_string()),
        None => String_from("nothing"),
    }
}

fn main() {
    Stdio::println(describe(Some(42)))
    Stdio::println(describe(None))
}
