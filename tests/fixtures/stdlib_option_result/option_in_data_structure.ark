use std::host::stdio
use std::test::Test
fn main() {
    let a: Option<Option<i32>> = Some(Some(1))
    match a {
        Option::Some(inner) => match inner {
            Option::Some(v) => Test::assert_eq_i32(v, 1),
            None => Std::panic("inner none"),
        },
        None => Std::panic("outer none"),
    }
    stdio::println("ok")
}
