use std::host::stdio
fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)

    let first: Option<i32> = get(v, 0)
    match first {
        Some(x) => stdio::println(x.to_string()),
        None => stdio::println(String_from("empty")),
    }

    stdio::println(len(v).to_string())
}
