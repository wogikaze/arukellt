// Deque<T> / Queue<T> / Stack<T> built from a Vec cursor, and logical Eq.
use std::collections::deque::Deque
use std::collections::deque::Queue
use std::collections::deque::Stack
use std::host::stdio::Stdio

fn show(value: Option<i32>) {
    match value {
        Option::Some(item) => Stdio::println(item.to_string()),
        Option::None => Stdio::println(String_from("none")),
    }
}

fn main() {
    let mut source: Vec<i32> = Vec::new<i32>()
    source.push(1)
    source.push(2)
    source.push(3)

    let deque: Deque<i32> = Deque::from_iter(source.iter())
    assert(deque.len() == 3)
    assert(deque.capacity() == 3)
    Stdio::println(deque.fmt_debug())

    // Same logical order through a different stack split: push_front fills
    // the front stack, so comparing storage slots would report a difference.
    let mut mirrored: Deque<i32> = Deque::new<i32>()
    mirrored.push_front(3)
    mirrored.push_front(2)
    mirrored.push_front(1)
    assert(deque.eq(mirrored))
    assert(mirrored.eq(deque))
    Stdio::println(String_from("mirrored equal"))

    // Capacity is storage state, not collection state.
    let mut reserved: Deque<i32> = Deque::with_capacity<i32>(9)
    reserved.push_back(1)
    reserved.push_back(2)
    reserved.push_back(3)
    assert(deque.eq(reserved))
    Stdio::println(String_from("capacity ignored"))

    let mut different: Deque<i32> = Deque::new<i32>()
    different.push_back(1)
    different.push_back(2)
    different.push_back(4)
    assert(!deque.eq(different))
    Stdio::println(String_from("unequal detected"))

    let empty_source: Vec<i32> = Vec::new<i32>()
    let empty: Deque<i32> = Deque::from_iter(empty_source.iter())
    assert(empty.is_empty())
    assert(empty.eq(Deque::new<i32>()))
    Stdio::println(empty.fmt_debug())

    let mut words: Vec<String> = Vec::new<String>()
    words.push("alpha")
    words.push("beta")
    let letters: Deque<String> = Deque::from_iter(words.iter())
    Stdio::println(letters.fmt_debug())
    let letters_again: Deque<String> = Deque::from_iter(words.iter())
    assert(letters.eq(letters_again))

    let mut queue: Queue<i32> = Queue::from_iter(source.iter())
    Stdio::println(queue.fmt_debug())
    assert(queue.eq(Queue::from_iter(source.iter())))
    show(queue.pop())
    show(queue.front())

    let mut stack: Stack<i32> = Stack::from_iter(source.iter())
    Stdio::println(stack.fmt_debug())
    assert(stack.eq(Stack::from_iter(source.iter())))
    show(stack.peek())
    show(stack.pop())
}
