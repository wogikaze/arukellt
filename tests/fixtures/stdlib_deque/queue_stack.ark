// Queue<T> FIFO and Stack<T> LIFO adapters over Deque<T>.
use std::collections::deque::Queue
use std::collections::deque::Stack
use std::host::stdio::Stdio

fn show(value: Option<i32>) {
    match value {
        Option::Some(item) => Stdio::println(item.to_string()),
        Option::None => Stdio::println(String_from("none")),
    }
}

fn main() {
    let mut queue: Queue<i32> = Queue::with_capacity<i32>(4)
    assert(queue.is_empty())
    assert(queue.capacity() == 4)
    queue.push(1)
    queue.push(2)
    queue.push(3)
    assert(queue.len() == 3)
    show(queue.front())
    show(queue.back())
    show(queue.pop())
    show(queue.pop())
    Stdio::println((queue.iter().count()).to_string())
    let queued: Vec<i32> = queue.iter().collect()
    Stdio::println((queued.get_unchecked(0)).to_string())
    show(queue.pop())
    show(queue.pop())
    queue.clear()
    assert(queue.is_empty())
    assert(queue.capacity() == 4)
    Stdio::println((queue.capacity()).to_string())

    let mut copied: Queue<i32> = Queue::new<i32>()
    copied.push(7)
    let queue_clone: Queue<i32> = copied.clone()
    copied.push(8)
    Stdio::println(copied.fmt_debug())
    Stdio::println(queue_clone.fmt_debug())

    let mut total: i32 = 0
    for value in copied {
        total = total + value
    }
    Stdio::println((total).to_string())

    let mut stack: Stack<i32> = Stack::new<i32>()
    assert(stack.is_empty())
    stack.push(10)
    stack.push(20)
    stack.push(30)
    assert(stack.len() == 3)
    show(stack.peek())
    let stacked: Vec<i32> = stack.iter().collect()
    Stdio::println((stacked.get_unchecked(0)).to_string())
    Stdio::println((stacked.get_unchecked(2)).to_string())
    show(stack.pop())
    show(stack.pop())
    show(stack.pop())
    show(stack.pop())
    stack.push(40)
    stack.clear()
    assert(stack.is_empty())

    let mut stack_copy: Stack<i32> = Stack::new<i32>()
    stack_copy.push(1)
    stack_copy.push(2)
    let stack_clone: Stack<i32> = stack_copy.clone()
    stack_copy.push(3)
    Stdio::println(stack_copy.fmt_debug())
    Stdio::println(stack_clone.fmt_debug())

    let mut text_queue: Queue<String> = Queue::new<String>()
    text_queue.push("a")
    text_queue.push("b")
    Stdio::println(text_queue.fmt_debug())
    let text_copy: Queue<String> = text_queue.clone()
    text_queue.clear()
    assert(text_queue.is_empty())
    assert(text_copy.len() == 2)
    Stdio::println(text_copy.fmt_debug())

    let mut text_stack: Stack<String> = Stack::new<String>()
    text_stack.push("x")
    text_stack.push("y")
    Stdio::println(text_stack.fmt_debug())
    match text_stack.peek() {
        Option::Some(value) => Stdio::println(value),
        Option::None => Stdio::println(String_from("none")),
    }
}
