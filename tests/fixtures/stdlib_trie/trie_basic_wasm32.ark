// Trie type surface (#917, ADR-046).
use std::collections::trie::Trie
use std::test::Test

fn main() {
    let mut t = Trie::new()
    t.insert("car", 1)
    t.insert("cart", 2)
    t.insert("carton", 3)
    t.insert("dog", 4)

    Test::assert_true(t.contains("car"))
    Test::assert_true(t.contains("carton"))
    Test::assert_false(t.contains("ca"))
    Test::assert_true(t.has_prefix("car"))
    Test::assert_true(t.has_prefix(""))
    Test::assert_false(t.has_prefix("cat"))
    Test::assert_eq_i32(t.count_with_prefix(""), 4)
    Test::assert_eq_i32(t.count_with_prefix("car"), 3)
    Test::assert_eq_i32(t.count_with_prefix("do"), 1)
    Test::assert_eq_i32(t.count_with_prefix("x"), 0)

    match t.get("cart") {
        Option::Some(v) => Test::assert_eq_i32(v, 2),
        None => Std::panic("expected Some(2)"),
    }
    match t.get("ca") {
        Option::Some(v) => Std::panic("expected None"),
        None => {
        },
    }

    // A stored key update keeps the shared prefix path intact.
    t.insert("car", 9)
    match t.get("car") {
        Option::Some(v) => Test::assert_eq_i32(v, 9),
        None => Std::panic("expected Some(9)"),
    }

    Test::assert_true(t.remove("cart"))
    Test::assert_false(t.contains("cart"))
    Test::assert_eq_i32(t.count_with_prefix("car"), 2)
    Test::assert_false(t.remove("cart"))
    Test::assert_true(t.contains("car"))
    Test::assert_true(t.contains("carton"))
}
