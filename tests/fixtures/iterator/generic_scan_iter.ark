use std::core::iter
use std::host::stdio

fn join_state(state: String, x: String) -> Option<String> {
    if len(state) > 2 {
        return None
    }
    Some(concat(state, x))
}

fn main() {
    let v: Vec<String> = Vec::new<String>()
    push(v, String_from("a"))
    push(v, String_from("b"))
    push(v, String_from("cc"))
    let sc = v.iter().scan(String_from(""), join_state)
    match sc.next() {
        Some(x) => stdio::println(x),
        None => stdio::println("none1"),
    }
    match sc.next() {
        Some(x) => stdio::println(x),
        None => stdio::println("none2"),
    }
    match sc.next() {
        Some(x) => stdio::println(x),
        None => stdio::println("none3"),
    }
    match sc.next() {
        Some(x) => stdio::println(x),
        None => stdio::println("none4"),
    }
}
