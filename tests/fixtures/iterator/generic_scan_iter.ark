use std::core::iter
use std::host::stdio::Stdio
use std::text
fn join_state(state: String, x: String) -> Option<String> {
    if state.len() > 2 {
        return None
    }
    Some(state.concat(x))
}

fn main() {
    let mut v: Vec<String> = Vec::new<String>()
    v.push(String_from("a"))
    v.push(String_from("b"))
    v.push(String_from("cc"))
    let mut sc = v.iter().scan(String_from(""), join_state)
    match sc.next() {
        Some(x) => Stdio::println(x),
        None => Stdio::println("none1"),
    }
    match sc.next() {
        Some(x) => Stdio::println(x),
        None => Stdio::println("none2"),
    }
    match sc.next() {
        Some(x) => Stdio::println(x),
        None => Stdio::println("none3"),
    }
    match sc.next() {
        Some(x) => Stdio::println(x),
        None => Stdio::println("none4"),
    }
}
