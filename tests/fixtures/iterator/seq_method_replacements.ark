// Iterator / Vec method replacements for the deprecated stable seq/combinator
// frees (#917 / #703 Wave 1). The i32 producer lane is the verified one.
//
// Collected `Vec` results are observed through the legacy free len /
// get_unchecked builtins: receiver methods on a Vec returned by collect()
// currently hit a GC codegen gap (the fixture gate validates the emitted
// module, so the probe keeps the collect chain and the consumer separate).
// The source Vec also uses the legacy free push and this fixture deliberately
// avoids `use std::collections::vec`: registering the Vec extension impl
// together with a method-push source currently makes the GC emitter produce an
// invalid module. The Vec-extension method replacements (sort_by / drain /
// get / len) are covered by collections/vec_method_replacements.ark.
use std::core::container
use std::core::iter
use std::test

fn double(value: i32) -> i32 {
    value * 2
}

fn add(acc: i32, value: i32) -> i32 {
    acc + value
}

fn mul(acc: i32, value: i32) -> i32 {
    acc * value
}

fn is_even(value: i32) -> bool {
    value % 2 == 0
}

fn is_two(value: i32) -> bool {
    value == 2
}

fn increment(value: i32) -> i32 {
    value + 1
}

fn main() {
    // The source Vec is built with the legacy free push so the iterator
    // producer and the collect consumer stay on the path exercised by the
    // existing iterator-lane fixtures; the tested replacements below are the
    // iterator / Vec receiver methods.
    let values: Vec<i32> = Vec::new<i32>()
    push(values, 3)
    push(values, 1)
    push(values, 2)

    let mapped: Vec<i32> = values.iter().map(double).collect()
    test::assert_eq_i32(len(mapped), 3)
    test::assert_eq_i32(get_unchecked(mapped, 2), 4)
    let filtered: Vec<i32> = values.iter().filter(is_even).collect()
    test::assert_eq_i32(len(filtered), 1)

    test::assert_eq_i32(values.iter().fold(0, add), 6)
    test::assert_eq_i32(values.iter().sum(), 6)
    test::assert_eq_i32(values.iter().fold(1, mul), 6)
    test::assert_true(values.iter().any(is_even))
    test::assert_eq_i32(values.iter().find(is_two).unwrap_or(0), 2)
    test::assert_true(values.iter().contains(2))
    test::assert_eq_i32(values.iter().rev().count(), 3)
    test::assert_eq_i32(values.iter().rev().sum(), 6)

    let some: Option<i32> = Some(2)
    test::assert_eq_i32(some.map(double).unwrap_or(0), 4)
    let text = String_from("hello")
    test::assert_true(text.contains(String_from("ell")))
    let result: Result<i32, i32> = Ok(1)
    test::assert_eq_i32(result.map(increment).unwrap_or(0), 2)
}
