// Fs namespace for the whole-path host filesystem helpers (ADR-046, #917).
use std::host::fs::Fs
use std::host::stdio
use std::test

fn main() {
    let path = String_from("fs_namespace_surface_wasm32.out.txt")
    let write: Result<(), String> = Fs::write_string(path, String_from("namespace"))
    match write {
        Result::Ok(_) => test::assert_true(true),
        Result::Err(_) => test::assert_true(false),
    }
    match Fs::read_to_string(String_from("fs_namespace_surface_wasm32.out.txt")) {
        Result::Ok(text) => test::assert_eq_string(text, "namespace"),
        Result::Err(_) => test::assert_true(false),
    }

    let bytes: Vec<i32> = Vec::new<i32>()
    push(bytes, 110)
    push(bytes, 115)
    let write_bytes: Result<(), String> = Fs::write_bytes(String_from("fs_namespace_surface_wasm32.out.bin"), bytes)
    match write_bytes {
        Result::Ok(_) => test::assert_true(true),
        Result::Err(_) => test::assert_true(false),
    }
    let read_bytes: Result<Vec<i32>, String> = Fs::read_bytes(String_from("fs_namespace_surface_wasm32.out.bin"))
    match read_bytes {
        Result::Ok(values) => test::assert_eq_i32(len(values), 2),
        Result::Err(_) => test::assert_true(false),
    }

    test::assert_true(Fs::is_readable_file(String_from("tests/fixtures/stdlib_fs/present.txt")))
    test::assert_false(Fs::is_readable_file(String_from("tests/fixtures/stdlib_fs/missing.txt")))
    test::assert_true(Fs::is_file(String_from("tests/fixtures/stdlib_fs/present.txt")))
    test::assert_false(Fs::is_dir(String_from("tests/fixtures/stdlib_fs")))
    stdio::println("fs-namespace-ok")
}
