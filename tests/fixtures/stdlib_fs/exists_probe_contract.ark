use std::host::fs::Fs
use std::host::stdio

fn main() {
    if Fs::is_readable_file("tests/fixtures/stdlib_fs/present.txt") {
        stdio::println("true")
    } else {
        stdio::println("false")
    }
    if Fs::is_readable_file("tests/fixtures/stdlib_fs/missing.txt") {
        stdio::println("true")
    } else {
        stdio::println("false")
    }
    if Fs::is_readable_file("tests/fixtures/stdlib_fs/broken_link") {
        stdio::println("true")
    } else {
        stdio::println("false")
    }
}
