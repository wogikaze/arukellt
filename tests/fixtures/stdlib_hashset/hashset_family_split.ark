// Both HashSet element families expose the capacity group over their own
// stores: HashSet<i32> uses the flat vec:i32 buckets, while HashSet<String>
// shares the String-keyed HashMap bucket arrays (#917).
use std::collections::hash_set::HashSet
use std::test::Test

fn main() {
    let mut ints: HashSet<i32> = HashSet::new<i32>()
    Test::assert_true(ints.insert(7))
    let capacity_before: i32 = ints.capacity()
    ints.reserve(16)
    Test::assert_true(ints.capacity() >= capacity_before)
    Test::assert_true(ints.try_reserve(1))
    Test::assert_eq_i32(ints.len(), 1)
    ints.shrink_to_fit()
    Test::assert_eq_i32(ints.len(), 1)
    Test::assert_true(ints.contains(7))

    let mut words: HashSet<String> = HashSet::new<String>()
    Test::assert_true(words.insert("red"))
    Test::assert_true(words.contains("red"))
    Test::assert_false(words.contains("blue"))
    Test::assert_eq_i32(words.len(), 1)
    Test::assert_false(words.is_empty())
    let snapshot: Vec<String> = words.to_vec()
    Test::assert_eq_i32(snapshot.len(), 1)

    let word_capacity: i32 = words.capacity()
    words.reserve(20)
    Test::assert_true(words.capacity() > word_capacity)
    Test::assert_true(words.try_reserve(1))
    Test::assert_eq_i32(words.len(), 1)
    words.shrink_to_fit()
    Test::assert_eq_i32(words.len(), 1)
    Test::assert_true(words.contains("red"))

    let mut more: HashSet<String> = HashSet::new<String>()
    Test::assert_true(more.insert("blue"))
    let mut combined: HashSet<String> = words.union(more)
    Test::assert_eq_i32(combined.len(), 2)
    Test::assert_eq_i32(words.intersection(more).len(), 0)
    Test::assert_eq_i32(words.difference(more).len(), 1)
    Test::assert_false(words.remove("blue"))

    let copy: HashSet<String> = combined.clone()
    Test::assert_true(copy.eq(combined))
    combined.clear()
    Test::assert_true(combined.is_empty())
}
