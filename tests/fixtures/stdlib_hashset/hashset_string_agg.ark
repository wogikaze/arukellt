// HashSet<String> aggregate set algebra over the Vec<String> store (#917).
use std::collections::hash_set::HashSet
use std::test::Test

fn main() {
    let mut a: HashSet<String> = HashSet::new<String>()
    let _ = a.insert("red")
    let _ = a.insert("blue")
    let mut b: HashSet<String> = HashSet::new<String>()
    let _ = b.insert("blue")
    let _ = b.insert("green")

    let combined: HashSet<String> = a.union(b)
    Test::assert_eq_i32(combined.len(), 3)
    Test::assert_true(combined.contains("red"))
    Test::assert_true(combined.contains("green"))
    Test::assert_false(combined.contains("black"))
    // Neither operand is consumed by the aggregate.
    Test::assert_eq_i32(a.len(), 2)
    Test::assert_eq_i32(b.len(), 2)

    let common: HashSet<String> = a.intersection(b)
    Test::assert_eq_i32(common.len(), 1)
    Test::assert_true(common.contains("blue"))

    let only_a: HashSet<String> = a.difference(b)
    Test::assert_eq_i32(only_a.len(), 1)
    Test::assert_true(only_a.contains("red"))
    Test::assert_false(only_a.contains("blue"))

    // Empty operands: union keeps `a`, intersection and difference are empty.
    let empty: HashSet<String> = HashSet::new<String>()
    Test::assert_eq_i32(a.union(empty).len(), 2)
    Test::assert_eq_i32(a.intersection(empty).len(), 0)
    Test::assert_eq_i32(a.difference(empty).len(), 2)
    Test::assert_eq_i32(empty.difference(a).len(), 0)

    // A chained aggregate result must keep the set marker.
    let trimmed: HashSet<String> = a.union(b).difference(common)
    Test::assert_eq_i32(trimmed.len(), 2)
    Test::assert_true(trimmed.contains("red"))
    Test::assert_false(trimmed.contains("blue"))

    // Clone / Eq work on an aggregate result.
    let copy: HashSet<String> = combined.clone()
    Test::assert_true(copy.eq(combined))

    // clear and extend over the String store.
    let mut grown: HashSet<String> = HashSet::new<String>()
    let _ = grown.insert("cyan")
    grown.extend(a)
    Test::assert_eq_i32(grown.len(), 3)
    Test::assert_true(grown.contains("cyan"))
    Test::assert_true(grown.contains("red"))
    // Self-extend goes through a clone: ADR-088 §5 rejects passing the same
    // place to a `mut self` receiver and another parameter.
    grown.extend(grown.clone())
    Test::assert_eq_i32(grown.len(), 3)
    grown.clear()
    Test::assert_eq_i32(grown.len(), 0)
    Test::assert_true(grown.is_empty())
}
