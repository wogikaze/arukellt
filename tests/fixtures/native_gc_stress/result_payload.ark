use std::text
fn wrap(label: String) -> String {
    String_from("ok:").concat(label)
}

fn main() -> i32 {
    let value = wrap(String_from("payload"))
    let mut i = 0
    while i < 64 {
        let _junk = wrap(String_from("tmp"))
        i = i + 1
    }
    if value.eq(String_from("ok:payload")) { 0 } else { 1 }
}
