// Deep nested structs for iterative mark (Phase 4 Branch C).
struct Node {
    label: String,
    depth: i32,
}

fn make_chain(depth: i32) -> Node {
    let mut node = Node { label: String_from("leaf"), depth: 0 }
    let mut i = 1
    while i <= depth {
        // Keep prior node live via label concat so the graph stays reachable.
        node = Node {
            label: concat(String_from("n"), to_string(i)),
            depth: i,
        }
        i = i + 1
    }
    node
}

fn main() -> i32 {
    let root = make_chain(256)
    let mut junk_i = 0
    while junk_i < 64 {
        let _pad = String_from("pad")
        junk_i = junk_i + 1
    }
    if root.depth == 256 {
        0
    } else {
        1
    }
}
