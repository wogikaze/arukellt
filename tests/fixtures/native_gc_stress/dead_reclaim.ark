use std::prelude::{eq}
use std::text
fn main() -> i32 {
    let keep = String_from("keep")
    let mut i = 0
    while i < 4000 {
        let junk = String_from("dead-payload-0123456789").concat(String_from("x"))
        let _n = len(junk)
        i = i + 1
    }
    if eq(keep, String_from("keep")) { 0 } else { 1 }
}
