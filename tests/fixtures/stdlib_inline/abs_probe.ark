use std::core::convert
use std::prelude::{f64_bits_hi, f64_bits_lo}
use std::collections::vec
use std::core::{Range}
use std::core::cmp
use std::core::iter
use std::seq
use std::text

pub fn probe_abs(x: i32) -> i32 {
    x.abs()
}

pub fn probe_min(a: i32, b: i32) -> i32 {
    a.min(b)
}

pub fn probe_max(a: i32, b: i32) -> i32 {
    a.max(b)
}

pub fn probe_clamp(x: i32, lo: i32, hi: i32) -> i32 {
    x.clamp(lo, hi)
}

pub fn probe_gcd(a: i32, b: i32) -> i32 {
    a.gcd(b)
}

pub fn probe_pow(base: i32, exponent: i32) -> i32 {
    base.pow(exponent)
}

pub fn probe_range_contains(value: i32) -> bool {
    let range: Range = Range::new(3, 8)
    range.contains(value)
}

pub fn probe_range_len() -> i32 {
    let range: Range = Range::new(3, 8)
    range.len()
}

pub fn probe_string_starts_with() -> bool {
    "semantic-spine".starts_with("semantic")
}

pub fn probe_string_ends_with() -> bool {
    "semantic-spine".ends_with("spine")
}

pub fn probe_string_contains() -> bool {
    "semantic-spine".contains("tic-sp")
}

pub fn probe_string_index_of() -> i32 {
    "semantic-spine".index_of("spine")
}

pub fn probe_string_len() -> i32 {
    "semantic-spine".len()
}

pub fn probe_string_char_at() -> i32 {
    "semantic-spine".char_at(9)
}

pub fn probe_string_slice() -> bool {
    let result = "semantic-spine".slice(9, 14)
    result.len() == 5 && result.char_at(0) == 115 && result.char_at(4) == 101
}

pub fn probe_string_to_lower() -> bool {
    let result = "SeMaNtIc".to_lower()
    result.len() == 8 && result.char_at(0) == 115 && result.char_at(7) == 99
}

pub fn probe_string_to_upper() -> bool {
    let result = "SeMaNtIc".to_upper()
    result.len() == 8 && result.char_at(0) == 83 && result.char_at(7) == 67
}

pub fn probe_string_trim() -> bool {
    let result = " \tsemantic\r\n".trim()
    result.len() == 8 && result.char_at(0) == 115 && result.char_at(7) == 99
}

pub fn probe_string_trim_start() -> bool {
    let result = (" \tsemantic ").trim_start()
    result.len() == 9 && result.char_at(0) == 115 && result.char_at(8) == 32
}

pub fn probe_string_trim_end() -> bool {
    let result = (" semantic\r\n").trim_end()
    result.len() == 9 && result.char_at(0) == 32 && result.char_at(8) == 99
}

pub fn probe_string_repeat() -> bool {
    let result = "ab".repeat(3)
    result.len() == 6 && result.char_at(0) == 97 && result.char_at(5) == 98
}

pub fn probe_string_padding() -> bool {
    let left = "x".pad_left(3)
    let right = "x".pad_right(3)
    let left_fill = "x".pad_left_with(4, "ab")
    let right_fill = "x".pad_right_with(4, "ab")
    left.len() == 3 &&
    left.char_at(0) == 32 &&
    left.char_at(2) == 120 &&
    right.char_at(0) == 120 &&
    right.char_at(2) == 32 &&
    left_fill.char_at(0) == 98 &&
    left_fill.char_at(3) == 120 &&
    right_fill.char_at(0) == 120 &&
    right_fill.char_at(3) == 97
}

pub fn probe_string_replace() -> bool {
    let result = "ab-ab-ab".replace("ab", "xyz")
    result.len() == 11 && result.char_at(0) == 120 && result.char_at(10) == 122
}

pub fn probe_string_split() -> bool {
    let parts = "a--b--".split("--")
    len(parts) == 3 && len(get_unchecked(parts, 0)) == 1 && len(get_unchecked(parts, 2)) == 0
}

pub fn probe_string_lines() -> bool {
    let parts = "a\r\nb\n".lines()
    len(parts) == 3 &&
    get_unchecked(parts, 0).len() == 1 &&
    get_unchecked(parts, 1).char_at(0) == 98 &&
    get_unchecked(parts, 2).len() == 0
}

pub fn probe_string_storage_ops() -> bool {
    let mut bytes = Vec::new<i32>()
    push(bytes, 79)
    push(bytes, 75)
    let text = __intrinsic_string_from_bytes(bytes)
    let copied = text.clone()
    let chars = copied.chars()
    String_new().is_empty() &&
    copied.len_bytes() == 2 &&
    text.eq(copied) &&
    len(chars) == 2 &&
    get_unchecked(chars, 0).char_at(0) == 79 &&
    get_unchecked(chars, 1).char_at(0) == 75
}

pub fn probe_scalar_format_ops() -> bool {
    let i32_text = (0 - 2147483647 - 1).to_string()
    let i64_text = (0_i64 - 9223372036854775807_i64 - 1_i64).to_string()
    i32_text.len() == 11 &&
    i32_text.char_at(0) == 45 &&
    i32_text.char_at(10) == 56 &&
    i64_text.len() == 20 &&
    i64_text.char_at(0) == 45 &&
    i64_text.char_at(19) == 56
}

pub fn probe_string_join() -> bool {
    let result = ("a--b--".split("--")).join(".")
    result.len() == 4 && result.char_at(0) == 97 && result.char_at(3) == 46
}

pub fn probe_string_concat() -> bool {
    let result = "semantic".concat("-spine")
    result.len() == 14 && result.char_at(8) == 45 && result.char_at(13) == 101
}

pub fn probe_vec_read_ops() -> bool {
    let mut values = Vec::new<i32>()
    push(values, 4)
    push(values, 7)
    set(values, 0, 9)
    values = values.iter().rev().collect()
    len(values) == 2 && !values.is_empty() && get_unchecked(values, 0) == 7 && get_unchecked(values, 1) == 9
}

pub fn probe_vec_string_mutation() -> bool {
    let mut values = "left,right".split(",")
    let mut reverse_lo = 0
    let mut reverse_hi = len(values) - 1
    while reverse_lo < reverse_hi {
        let reverse_tmp = values.get_unchecked(reverse_lo)
        values.set(reverse_lo, values.get_unchecked(reverse_hi))
        values.set(reverse_hi, reverse_tmp)
        reverse_lo = reverse_lo + 1
        reverse_hi = reverse_hi - 1
    }
    let first = get_unchecked(values, 0)
    let second = get_unchecked(values, 1)
    first.len() == 5 &&
    first.char_at(0) == 114 &&
    second.len() == 4 &&
    second.char_at(0) == 108
}

pub fn probe_seq_read_ops() -> bool {
    let mut values = Vec::new<i32>()
    push(values, 2)
    push(values, 3)
    push(values, 3)
    push(values, 7)
    values.iter().sum() == 15 && values.iter().fold(1, mul_i32) == 126
}

pub fn probe_seq_allocation_ops() -> bool {
    let mut values = Vec::new<i32>()
    push(values, 2)
    push(values, 3)
    push(values, 3)
    push(values, 7)
    let taken = seq::take_i32(values, 3)
    let skipped = seq::skip_i32(values, 2)
    let unique_values = seq::unique(values)
    len(taken) == 3 &&
    get_unchecked(taken, 2) == 3 &&
    len(skipped) == 2 &&
    get_unchecked(skipped, 0) == 3 &&
    len(unique_values) == 3 &&
    get_unchecked(unique_values, 2) == 7
}

pub fn probe_seq_sort_i32() -> bool {
    let mut i32_values = Vec::new<i32>()
    push(i32_values, 7)
    push(i32_values, 2)
    push(i32_values, 4)
    i32_values.sort_by(ascending)
    get_unchecked(i32_values, 0) == 2 && get_unchecked(i32_values, 2) == 7
}

pub fn probe_format_bool_ops() -> bool {
    let true_text = true.to_string()
    let false_text = false.to_string()
    true_text.len() == 4 &&
    true_text.char_at(0) == 116 &&
    false_text.len() == 5 &&
    false_text.char_at(0) == 102
}

pub fn probe_char_to_string_ops() -> bool {
    let text = char_to_string('A')
    text.len() == 1 && text.char_at(0) == 65
}

pub fn probe_range_new_ops() -> bool {
    // Avoid `range.len() == N` in the same expression as contains: O1 inlining
    // of range_len currently drops the left operand of `==` (#822 follow-up).
    let range: Range = Range::new(3, 8)
    let length = range.len()
    range.contains(5) && length == 5 && !range.contains(8)
}

pub fn probe_sqrt_ops() -> bool {
    let root = (4.0).sqrt()
    let lo = f64_bits_lo(root)
    let hi = f64_bits_hi(root)
    lo == f64_bits_lo(2.0) && hi == f64_bits_hi(2.0)
}

pub fn probe_f64_bits_ops() -> bool {
    // 1.0 = 0x3FF0000000000000 → lo=0, hi=0x3FF00000
    f64_bits_lo(1.0) == 0 && f64_bits_hi(1.0) == 1072693248
}

pub fn probe_format_f64_ops() -> bool {
    let text = (0.5).to_string()
    text.len() == 3 && text.char_at(0) == 48 && text.char_at(1) == 46 && text.char_at(2) == 53
}

pub fn probe_f32_to_string_ops() -> bool {
    let value: f32 = 0.5f32
    let text = value.to_string()
    text.len() == 3 && text.char_at(0) == 48 && text.char_at(2) == 53
}

pub fn probe_push_char_ops() -> bool {
    let mut text = String_new()
    text.push_char('A')
    text.len() == 1 && text.char_at(0) == 65
}

pub fn probe_sort_i64_ops() -> bool {
    let mut values: Vec<i64> = Vec::new<i64>()
    push(values, 30_i64)
    push(values, 10_i64)
    push(values, 20_i64)
    values.sort()
    len(values) == 3 && get_unchecked(values, 0) == 10_i64 && get_unchecked(values, 1) == 20_i64 && get_unchecked(values, 2) == 30_i64
}

pub fn probe_sort_f64_ops() -> bool {
    let mut values: Vec<f64> = Vec::new<f64>()
    push(values, 3.0)
    push(values, 1.0)
    push(values, 2.0)
    let mut sort_index = 1
    while sort_index < len(values) {
        let sort_value = get_unchecked(values, sort_index)
        let mut sort_slot = sort_index
        while sort_slot > 0 && get_unchecked(values, sort_slot - 1) > sort_value {
            set(values, sort_slot, get_unchecked(values, sort_slot - 1))
            sort_slot = sort_slot - 1
        }
        set(values, sort_slot, sort_value)
        sort_index = sort_index + 1
    }
    len(values) == 3 && get_unchecked(values, 0) == 1.0 && get_unchecked(values, 1) == 2.0 && get_unchecked(values, 2) == 3.0
}

pub fn probe_remove_i32_ops() -> bool {
    let mut values = Vec::new<i32>()
    push(values, 1)
    push(values, 2)
    push(values, 3)
    values.drain(1, 2)
    len(values) == 2 && get_unchecked(values, 0) == 1 && get_unchecked(values, 1) == 3
}

pub fn probe_vec_generic_mutation_ops() -> bool {
    let mut values = Vec::new<i32>()
    push(values, 4)
    push(values, 5)
    set(values, 0, 9)
    let n = len(values)
    !values.is_empty() &&
    n == 2 &&
    get_unchecked(values, 0) == 9 &&
    get_unchecked(values, 1) == 5
}

pub fn probe_vec_typed_push_get_ops() -> bool {
    let mut i64s: Vec<i64> = Vec::new<i64>()
    push(i64s, 7_i64)
    push(i64s, 8_i64)
    let mut f64s: Vec<f64> = Vec::new<f64>()
    push(f64s, 1.5)
    push(f64s, 2.5)
    len(i64s) == 2 &&
    get_unchecked(i64s, 0) == 7_i64 &&
    get_unchecked(i64s, 1) == 8_i64 &&
    len(f64s) == 2 &&
    get_unchecked(f64s, 0) == 1.5 &&
    get_unchecked(f64s, 1) == 2.5
}

pub fn probe_vec_push_pop_get_ops() -> bool {
    let mut values = Vec::new<i32>()
    push(values, 1)
    push(values, 2)
    push(values, 3)
    let mid = match get(values, 1) {
        Some(n) => n == 2,
        None => false,
    }
    let missing = match get(values, 9) {
        Some(_) => false,
        None => true,
    }
    let popped = match pop(values) {
        Some(n) => n == 3,
        None => false,
    }
    mid && missing && popped && len(values) == 2 && get_unchecked(values, 0) == 1 && get_unchecked(values, 1) == 2
}

pub fn probe_vec_new_capacity_ops() -> bool {
    let mut a = Vec::new<i32>()
    let mut b = Vec::with_capacity<i32>(4)
    let mut c = Vec::new<i64>()
    push(a, 10)
    push(b, 20)
    push(c, 30_i64)
    len(a) == 1 && get_unchecked(a, 0) == 10 &&
    len(b) == 1 && get_unchecked(b, 0) == 20 &&
    len(c) == 1 && get_unchecked(c, 0) == 30_i64
}

pub fn probe_parse_ops() -> bool {
    let ok_i32 = match i32::try_from("42") {
        Ok(n) => n == 42,
        Err(_) => false,
    }
    let bad_i32 = match i32::try_from("abc") {
        Ok(_) => false,
        Err(_) => true,
    }
    let ok_i64 = match i64::try_from("-7") {
        Ok(n) => n == 0_i64 - 7_i64,
        Err(_) => false,
    }
    let ok_f64 = match f64::try_from("0.5") {
        Ok(n) => n > 0.49 && n < 0.51,
        Err(_) => false,
    }
    let parsed_ok: Result<i32, String> = i32::try_from("9")
    let opt_ok = match parsed_ok {
        Ok(n) => n == 9,
        Err(_) => false,
    }
    let parsed_bad: Result<f64, String> = f64::try_from("nope")
    let opt_bad = match parsed_bad {
        Ok(_) => false,
        Err(_) => true,
    }
    ok_i32 && bad_i32 && ok_i64 && ok_f64 && opt_ok && opt_bad
}

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn mul_i32(a: i32, b: i32) -> i32 {
    a * b
}

fn main() {}
