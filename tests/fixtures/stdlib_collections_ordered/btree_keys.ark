use std::collections::ordered::BTreeMap
use std::host::stdio

fn main() {
    let mut m = BTreeMap::new()
    m.insert(30, 300)
    m.insert(10, 100)
    m.insert(50, 500)
    m.insert(20, 200)
    m.insert(40, 400)
    let keys = m.keys()
    let mut i: i32 = 0
    while i < len(keys) {
        stdio::println((get_unchecked(keys, i)).to_string())
        i = i + 1
    }
    let range = m.range(20, 45)
    stdio::println((len(range)).to_string())
    let mut j: i32 = 0
    while j < len(range) {
        stdio::println((get_unchecked(range, j)).to_string())
        j = j + 1
    }
}
