use std::collections::ordered::BTreeMap
use std::host::stdio::Stdio

fn main() {
    let mut m = BTreeMap::new()
    m.insert(30, 300)
    m.insert(10, 100)
    m.insert(50, 500)
    m.insert(20, 200)
    m.insert(40, 400)
    let keys = m.keys()
    let mut i: i32 = 0
    while i < keys.len() {
        Stdio::println((get_unchecked(keys, i)).to_string())
        i = i + 1
    }
    let range = m.range(20, 45)
    Stdio::println((range.len()).to_string())
    let mut j: i32 = 0
    while j < range.len() {
        Stdio::println((get_unchecked(range, j)).to_string())
        j = j + 1
    }
}
