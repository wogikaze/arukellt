use std::collections::ordered::BTreeSet
use std::host::stdio

fn main() {
    let mut s = BTreeSet::new()
    stdio::println((s.insert(30)).to_string())
    stdio::println((s.insert(10)).to_string())
    stdio::println((s.insert(20)).to_string())
    stdio::println((s.insert(10)).to_string())
    stdio::println((s.len()).to_string())
    stdio::println((s.contains(10)).to_string())
    stdio::println((s.contains(20)).to_string())
    stdio::println((s.contains(99)).to_string())
}
