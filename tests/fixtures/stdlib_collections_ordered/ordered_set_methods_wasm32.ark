// Ordered set type surface (#917, ADR-046).
use std::collections::ordered::{BTreeSet, BitSet, IndexSet}
use std::test

fn main() {
    let empty = BitSet::new()
    test::assert_eq_i32(empty.count(), 0)
    test::assert_false(empty.test(0))

    let mut sorted = BTreeSet::new()
    test::assert_true(sorted.insert(30))
    test::assert_true(sorted.insert(10))
    test::assert_false(sorted.insert(30))
    test::assert_eq_i32(sorted.len(), 2)
    test::assert_true(sorted.contains(10))
    test::assert_false(sorted.contains(99))

    let mut index = IndexSet::new()
    test::assert_true(index.insert(30))
    test::assert_true(index.insert(10))
    test::assert_false(index.insert(30))
    test::assert_eq_i32(index.len(), 2)
    test::assert_true(index.contains(30))
    test::assert_false(index.contains(99))

    let mut bits = BitSet::with_capacity(64)
    bits.mark(1)
    bits.set(2)
    bits.set(3)
    test::assert_true(bits.test(2))
    bits.unmark(1)
    bits.clear(3)
    test::assert_false(bits.test(1))
    test::assert_false(bits.test(3))
    test::assert_eq_i32(bits.count(), 1)

    let mut other = BitSet::with_capacity(64)
    other.mark(2)
    other.mark(5)
    let united = bits.union(other)
    test::assert_eq_i32(united.count(), 2)
    test::assert_true(united.test(5))
    let shared = bits.intersection(other)
    test::assert_eq_i32(shared.count(), 1)
    test::assert_true(shared.test(2))
}
