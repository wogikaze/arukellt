use std::host::stdio::Stdio
use std::core::iter

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)
    Stdio::println((v.iter().sum()).to_string())
    let empty: Vec<i32> = Vec::new<i32>()
    Stdio::println((empty.iter().sum()).to_string())
    let mut single: Vec<i32> = Vec::new<i32>()
    single.push(42)
    Stdio::println((single.iter().sum()).to_string())
}
