use std::host::stdio
use std::core::iter

fn main() {
    let v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5)
    stdio::println((v.iter().sum()).to_string())
    let empty: Vec<i32> = Vec::new<i32>()
    stdio::println((empty.iter().sum()).to_string())
    let single: Vec<i32> = Vec::new<i32>()
    push(single, 42)
    stdio::println((single.iter().sum()).to_string())
}
