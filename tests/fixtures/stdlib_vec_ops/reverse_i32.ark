use std::host::stdio
use std::core::iter

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    v = v.iter().rev().collect()
    let mut i: i32 = 0
    while i < len(v) {
        stdio::println(get_unchecked(v, i))
        i = i + 1
    }
}
