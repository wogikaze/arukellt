use std::host::stdio::Stdio
use std::core::iter

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v = v.iter().rev().collect()
    let mut i: i32 = 0
    while i < v.len() {
        Stdio::println(v.get_unchecked(i))
        i = i + 1
    }
}
