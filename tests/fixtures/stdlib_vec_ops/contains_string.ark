use std::host::stdio

fn vec_contains_string(values: Vec<String>, needle: String) -> bool {
    let mut index = 0
    while index < len(values) {
        if values.get_unchecked(index) == needle {
            return true
        }
        index = index + 1
    }
    false
}

fn main() {
    let mut v: Vec<String> = Vec::new<String>()
    push(v, String_from("hello"))
    push(v, String_from("world"))
    let a: bool = vec_contains_string(v, String_from("world"))
    stdio::println(a)
    let b: bool = vec_contains_string(v, String_from("foo"))
    stdio::println(b)
}
