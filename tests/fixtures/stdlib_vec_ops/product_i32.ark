use std::host::stdio::Stdio
use std::core::iter

fn mul_i32(a: i32, b: i32) -> i32 {
    a * b
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)
    Stdio::println((v.iter().fold(1, mul_i32)).to_string())
    let mut single: Vec<i32> = Vec::new<i32>()
    single.push(7)
    Stdio::println((single.iter().fold(1, mul_i32)).to_string())
    let mut mixed: Vec<i32> = Vec::new<i32>()
    mixed.push(2)
    mixed.push(3)
    mixed.push(4)
    Stdio::println((mixed.iter().fold(1, mul_i32)).to_string())
}
