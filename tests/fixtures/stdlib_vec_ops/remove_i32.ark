use std::host::stdio::Stdio
use std::collections::vec

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)
    push(v, 40)
    v.drain(1, 1 + 1)
    Stdio::println(v.len())
    let mut i: i32 = 0
    while i < v.len() {
        Stdio::println(v.get_unchecked(i))
        i = i + 1
    }
}
