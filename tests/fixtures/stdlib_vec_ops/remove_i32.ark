use std::host::stdio::Stdio
use std::collections::vec

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)
    v.drain(1, 1 + 1)
    Stdio::println(v.len())
    let mut i: i32 = 0
    while i < v.len() {
        Stdio::println(get_unchecked(v, i))
        i = i + 1
    }
}
