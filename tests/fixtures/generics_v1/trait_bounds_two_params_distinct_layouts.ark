// Two independently bounded generic parameters with non-conventional names
// (R/W) and distinct struct layouts. Each parameter must bind to its own
// declared type argument; a name-based fallback gives W the first layout.
use std::host::stdio

trait Left {
    fn left(self: Left, n: i32) -> i32
}

trait Right {
    fn right(self: Right, n: i32) -> i32
}

struct Alpha {
    v: i32,
}

struct Beta {
    v: i32,
    w: i32,
}

impl Left for Alpha {
    fn left(self: Alpha, n: i32) -> i32 {
        self.v + n
    }
}

impl Right for Beta {
    fn right(self: Beta, n: i32) -> i32 {
        self.v + self.w + n
    }
}

fn combine<R: Left, W: Right>(t: R, u: W) -> i32 {
    let a: i32 = t.left(2)
    let b: i32 = u.right(3)
    a + b
}

fn main() {
    let mut a = Alpha { v: 10 }
    let b = Beta { v: 20, w: 5 }
    stdio::println((combine(a, b)).to_string())
}
