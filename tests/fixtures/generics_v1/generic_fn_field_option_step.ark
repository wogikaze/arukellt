// A generic struct may carry a callback whose signature mentions the
// type parameter, including Option<T> in the result. Invoking the field
// inside a monomorphized impl binds the Some(v) payload at the concrete
// type, so the match, the field store, and the Option<T> construction
// select the same payload layout on wasm32 and wasm32-gc.
use std::host::stdio

struct AccBox<T> {
    state: T,
    f: fn(T, T) -> Option<T>,
}

impl<T> AccBox<T> {
    fn step(self: AccBox<T>, x: T) -> Option<T> {
        let mut out: Option<T> = None
        let stepped: Option<T> = (self.f)(self.state, x)
        match stepped {
            Some(v) => {
                self.state = v
                out = Some(v)
            }
            None => {}
        }
        out
    }
}

fn sum2(a: i32, b: i32) -> Option<i32> {
    Some(a + b)
}

fn main() {
    let acc = AccBox { state: 10, f: sum2 }
    match acc.step(5) {
        Some(v) => stdio::println(v.to_string()),
        None => stdio::println("none"),
    }
}
