// Field access on a generic struct returns the substituted field type, so
// a method call on outer.iter (or on a variable bound from it) records
// and lowers the per-instantiation impl method Take::next with [VecIter].
use std::core::iter
use std::host::stdio

struct Take<I> {
    iter: I,
    remaining: i32,
}

impl Iterator for Take<I> {
    type Item = I::Item
    fn next(self: Take<I>) -> Option<I::Item> {
        if self.remaining <= 0 {
            return Option::None
        }
        let nxt = self.iter.next()
        match nxt {
            Option::Some(v) => {
                self.remaining = self.remaining - 1
                Option::Some(v)
            }
            Option::None => Option::None
        }
    }
}

impl IntoIterator for Take<I> {
    type Item = I::Item
    type IntoIter = Take<I>
    fn into_iter(self: Take<I>) -> Take<I> {
        self
    }
}

fn main() -> i32 {
    let v: Vec<i32> = Vec::new<i32>()
    v.push(4)
    v.push(5)
    v.push(6)
    let inner: Take<VecIter> = Take { iter: v.into_iter(), remaining: 3 }
    stdio::println((inner.remaining).to_string())
    let outer: Take<Take<VecIter>> = Take { iter: inner, remaining: 2 }
    stdio::println((outer.remaining).to_string())
    let it2 = outer.iter
    stdio::println((it2.remaining).to_string())
    let a = it2.next()
    match a {
        Option::Some(x) => stdio::println((x).to_string())
        Option::None => stdio::println("none_a")
    }
    let inner2: Take<VecIter> = Take { iter: Vec::new<i32>().into_iter(), remaining: 1 }
    let outer2: Take<Take<VecIter>> = Take { iter: inner2, remaining: 1 }
    let b = outer2.iter.next()
    match b {
        Option::Some(x) => stdio::println((x).to_string())
        Option::None => stdio::println("none_b")
    }
    0
}
