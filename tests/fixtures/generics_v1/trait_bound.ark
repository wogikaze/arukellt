use std::host::stdio
use std::text
trait Printable {
    fn show(self: Printable) -> String
}

struct Point {
    x: i32,
    y: i32,
}

impl Printable for Point {
    fn show(self: Point) -> String {
        text::concat("Point(", text::concat((self.x).to_string(), text::concat(", ", text::concat((self.y).to_string(), ")"))))
    }
}

fn print_it<T: Printable>(item: T) {
    stdio::println("printing...")
}

fn main() {
    let p = Point { x: 1, y: 2 }
    print_it(p)
}
