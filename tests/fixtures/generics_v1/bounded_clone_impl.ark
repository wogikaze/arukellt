// ADR-078: an impl binder declares the generic parameters and their bounds.
// The bound must be available while checking the impl method body and must be
// enforced again when a concrete receiver selects this parametric impl.
use std::core::clone
use std::host::stdio::Stdio

struct Deque<T> {
    front: T,
    back: T,
}

impl<T: Clone> Clone for Deque<T> {
    fn clone(self: Deque<T>) -> Deque<T> {
        Deque {
            front: self.front.clone(),
            back: self.back.clone(),
        }
    }
}

fn main() {
    let deque = Deque { front: 20, back: 22 }
    let copy = deque.clone()
    Stdio::println((copy.front + copy.back).to_string())
}
