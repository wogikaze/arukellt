// An unannotated literal on a generic struct infers its type arguments
// from the field values, so a method call on the value binds the type
// parameter and emits a monomorphized body. Covers a single parameter
// (ScanBox<T>), a String instantiation, a two-parameter struct where the
// literal only mentions one parameter per field (Pair<A, B>), and a
// method that delegates to a sibling method on the same impl.
use std::host::stdio

struct ScanBox<T> {
    state: T,
}

impl<T> ScanBox<T> {
    fn get(self: ScanBox<T>) -> T {
        self.state
    }

    fn get_twice(self: ScanBox<T>) -> T {
        self.get()
    }
}

struct Pair<A, B> {
    first: A,
    second: B,
}

impl<A, B> Pair<A, B> {
    fn get_second(self: Pair<A, B>) -> B {
        self.second
    }
}

fn main() {
    let it = ScanBox { state: 7 }
    stdio::println(it.get().to_string())
    let s = ScanBox { state: "hi" }
    stdio::println(s.get())
    let p = Pair { first: 1, second: "two" }
    stdio::println(p.get_second())
    let t = ScanBox { state: 9 }
    stdio::println(t.get_twice().to_string())
}
