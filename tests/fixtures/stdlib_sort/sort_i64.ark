use std::test::Test
use std::collections::vec
use std::test

test "sorts_i64_values_ascending" {
    let mut v: Vec<i64> = Vec::new<i64>()
    let a: i64 = 30i64
    let b: i64 = 10i64
    let c: i64 = 50i64
    let d: i64 = 20i64
    let e: i64 = 40i64
    push(v, a)
    push(v, b)
    push(v, c)
    push(v, d)
    push(v, e)
    v.sort()
    Test::assert_eq_i32(v.len(), 5)
    Test::assert_eq_i64(get_unchecked(v, 0), 10i64)
    Test::assert_eq_i64(get_unchecked(v, 1), 20i64)
    Test::assert_eq_i64(get_unchecked(v, 2), 30i64)
    Test::assert_eq_i64(get_unchecked(v, 3), 40i64)
    Test::assert_eq_i64(get_unchecked(v, 4), 50i64)
}
