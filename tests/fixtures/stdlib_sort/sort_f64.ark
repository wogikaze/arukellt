use std::test::Test

test "sorts_f64_values_ascending" {
    let mut v: Vec<f64> = Vec::new<f64>()
    let a: f64 = 3.5
    let b: f64 = 1.2
    let c: f64 = 5.0
    let d: f64 = 2.8
    let e: f64 = 4.1
    v.push(a)
    v.push(b)
    v.push(c)
    v.push(d)
    v.push(e)
    let mut sort_index = 1
    while sort_index < v.len() {
        let sort_value = get_unchecked(v, sort_index)
        let mut sort_slot = sort_index
        while sort_slot > 0 && get_unchecked(v, sort_slot - 1) > sort_value {
            v.set(sort_slot, get_unchecked(v, sort_slot - 1))
            sort_slot = sort_slot - 1
        }
        v.set(sort_slot, sort_value)
        sort_index = sort_index + 1
    }
    Test::assert_eq_i32(v.len(), 5)
    Test::assert_eq_f64(get_unchecked(v, 0), 1.2)
    Test::assert_eq_f64(get_unchecked(v, 1), 2.8)
    Test::assert_eq_f64(get_unchecked(v, 2), 3.5)
    Test::assert_eq_f64(get_unchecked(v, 3), 4.1)
    Test::assert_eq_f64(get_unchecked(v, 4), 5.0)
}
