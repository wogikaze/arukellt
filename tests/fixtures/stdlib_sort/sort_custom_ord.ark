use std::test::Test
use std::collections::vec
use std::core::cmp
use std::test

struct Rev<T> {
    inner: T,
}

impl<T> Ord for Rev<T> {
    fn cmp(self: Rev<T>, other: Rev<T>) -> Ordering {
        match self.inner.cmp(other.inner) {
            Ordering::Less => Ordering::Greater,
            Ordering::Equal => Ordering::Equal,
            Ordering::Greater => Ordering::Less,
        }
    }
}

test "sorts_reverse_wrapper_descending" {
    let mut v: Vec<cmp::Reverse<i32>> = Vec::new<cmp::Reverse<i32>>()
    v.push(cmp::Reverse { inner: 1 })
    v.push(cmp::Reverse { inner: 5 })
    v.push(cmp::Reverse { inner: 3 })
    v.push(cmp::Reverse { inner: 2 })
    v.push(cmp::Reverse { inner: 4 })
    v.sort()
    Test::assert_eq_i32(v.get_unchecked(0).inner, 5)
    Test::assert_eq_i32(v.get_unchecked(1).inner, 4)
    Test::assert_eq_i32(v.get_unchecked(2).inner, 3)
    Test::assert_eq_i32(v.get_unchecked(3).inner, 2)
    Test::assert_eq_i32(v.get_unchecked(4).inner, 1)
}

test "sorts_user_parametric_impl_descending" {
    let mut v: Vec<Rev<i32>> = Vec::new<Rev<i32>>()
    v.push(Rev { inner: 2 })
    v.push(Rev { inner: 5 })
    v.push(Rev { inner: 1 })
    v.push(Rev { inner: 4 })
    v.push(Rev { inner: 3 })
    v.sort()
    Test::assert_eq_i32(v.get_unchecked(0).inner, 5)
    Test::assert_eq_i32(v.get_unchecked(1).inner, 4)
    Test::assert_eq_i32(v.get_unchecked(2).inner, 3)
    Test::assert_eq_i32(v.get_unchecked(3).inner, 2)
    Test::assert_eq_i32(v.get_unchecked(4).inner, 1)
}
