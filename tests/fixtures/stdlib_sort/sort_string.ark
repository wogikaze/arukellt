use std::test::Test
use std::collections::vec
use std::test

test "sorts_string_values_lexicographically" {
    let mut v: Vec<String> = Vec::new<String>()
    v.push(String_from("pear"))
    v.push(String_from("apple"))
    v.push(String_from("fig"))
    v.push(String_from("kiwi"))
    v.push(String_from("apple"))
    v.sort()
    Test::assert_eq_i32(v.len(), 5)
    Test::assert_true(v.get_unchecked(0).eq(String_from("apple")))
    Test::assert_true(v.get_unchecked(1).eq(String_from("apple")))
    Test::assert_true(v.get_unchecked(2).eq(String_from("fig")))
    Test::assert_true(v.get_unchecked(3).eq(String_from("kiwi")))
    Test::assert_true(v.get_unchecked(4).eq(String_from("pear")))
}
