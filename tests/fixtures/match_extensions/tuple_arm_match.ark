// Tuple patterns in match arms (#893): each arm-head tuple element is a
// sub-pattern — wildcard, ident bind, literal, string literal, or, and
// variant (with payload binds). Element conditions AND-fold on both the
// wasm32-gc primary path and the wasm32 linear fallback.
// ADR-082: tuple scrutinee is non-finite, so matches that are not
// provably total carry an explicit catchall arm.

use std::host::stdio::Stdio
use std::text

enum Opt {
    Some(i32),
    None,
}

fn main() {
    let s = Opt::Some(42)
    let t1 = (s, 7)
    match t1 {
        (Opt::Some(v), _) => Stdio::println("some:".concat((v).to_string())),
        (Opt::None, _) => Stdio::println("none"),
        _ => Stdio::println("miss"),
    }
    let n = Opt::None
    let t2 = (n, 1)
    match t2 {
        (Opt::Some(v), _) => Stdio::println("some"),
        (Opt::None, _) => Stdio::println("none"),
        _ => Stdio::println("miss"),
    }

    // ident binds + literal elements
    let t3 = (3, 4)
    match t3 {
        (a, b) => Stdio::println((a * b).to_string()),
    }
    match t3 {
        (1, _) => Stdio::println("one"),
        (3, x) => Stdio::println((x + 100).to_string()),
        _ => Stdio::println("other"),
    }

    // guarded tuple arm falls through to the next arm when the guard fails
    match t3 {
        (a, b) if a > 10 => Stdio::println("big"),
        (a, b) => Stdio::println((a - b).to_string()),
    }

    // or-pattern in element position
    match t3 {
        (1 | 3, b) => Stdio::println((b + 200).to_string()),
        _ => Stdio::println("miss"),
    }

    // Option/Result element payload binds
    let opt: Option<i32> = Option::Some(5)
    let t4 = (opt, "k")
    match t4 {
        (Option::Some(v), k) => Stdio::println(k.concat((v).to_string())),
        (Option::None, _) => Stdio::println("none-elem"),
        _ => Stdio::println("other"),
    }

    // string literal element + tuple arm in last position
    let t5 = ("hello", 2)
    match t5 {
        ("bye", _) => Stdio::println("bye"),
        ("hello", m) => Stdio::println((m + 1).to_string()),
        _ => Stdio::println("miss"),
    }
}
