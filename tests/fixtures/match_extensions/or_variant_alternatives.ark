// Or-pattern arms over enum-variant alternatives: the GC emit path used
// to compare the scrutinee ref against tag constants because the
// variant-oracle scan skipped or-alternatives, producing invalid core
// Wasm; the folded compares now read the extracted tag local (#901).
// Verified identical on wasm32-gc component and wasm32 linear core.

use std::host::stdio::Stdio

enum Shape { Circle(i32), Square, Triangle }

fn classify(s: Shape) -> String {
    match s {
        Shape::Circle(_) | Shape::Square => "flat",
        Shape::Triangle => "pointy",
    }
}

fn option_side(o: Option<i32>) -> String {
    match o {
        Option::Some(_) | Option::None => "handled",
    }
}

fn main() {
    Stdio::println(classify(Shape::Square))
    Stdio::println(classify(Shape::Circle(9)))
    Stdio::println(classify(Shape::Triangle))
    Stdio::println(option_side(Option::Some(3)))
    Stdio::println(option_side(Option::None))
}
