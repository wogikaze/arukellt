use std::text
enum Opt {
    Some(i32),
    None,
}

fn describe(Opt::Some(v): Opt) -> String | v > 10 = "big"
fn describe(Opt::Some(_): Opt) -> String = "small"
fn describe(Opt::None: Opt) -> String = "none"

fn main() {
    __intrinsic_print(describe(Opt::Some(42)).concat("\n"))
    __intrinsic_print(describe(Opt::Some(5)).concat("\n"))
    __intrinsic_print(describe(Opt::None).concat("\n"))
}
