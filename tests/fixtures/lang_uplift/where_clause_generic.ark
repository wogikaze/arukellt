use std::text
fn classify_len<T>(items: Vec<T>) -> String | m == 0 = "empty"
fn classify_len<T>(items: Vec<T>) -> String | m == 1 = "single"
fn classify_len<T>(_) -> String = "many"
where
m = items.len()

fn main() {
    let empty: Vec<i32> = Vec::new<i32>()
    let mut single: Vec<i32> = Vec::new<i32>()
    push(single, 42)
    let mut many: Vec<i32> = Vec::new<i32>()
    push(many, 1)
    push(many, 2)
    push(many, 3)

    __intrinsic_print(classify_len(empty).concat("\n"))
    __intrinsic_print(classify_len(single).concat("\n"))
    __intrinsic_print(classify_len(many).concat("\n"))
}
