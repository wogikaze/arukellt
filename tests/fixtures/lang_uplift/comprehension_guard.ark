use std::core::iter
use std::text

fn main() {
    let mut xs: Vec<i32> = Vec::new<i32>()
    push(xs, 1)
    push(xs, 2)
    push(xs, 3)
    push(xs, 4)
    push(xs, 5)
    let filtered = [x for x in xs if x >= 3]
    let mut sum = 0
    for v in (filtered) {
        sum = sum + v
    }
    __intrinsic_print(sum.to_string().concat("\n"))
}
