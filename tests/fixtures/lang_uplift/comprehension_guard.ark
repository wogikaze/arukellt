use std::core::iter
use std::text

fn main() {
    let mut xs: Vec<i32> = Vec::new<i32>()
    xs.push(1)
    xs.push(2)
    xs.push(3)
    xs.push(4)
    xs.push(5)
    let filtered = [x for x in xs if x >= 3]
    let mut sum = 0
    for v in (filtered) {
        sum = sum + v
    }
    __intrinsic_print(sum.to_string().concat("\n"))
}
