// Insert: overwrite existing key preserves size, updates value
use std::test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(1, 10)
    let _ = m.insert(1, 20)
    let _ = m.insert(1, 30)
    test::assert_eq_i32(m.len(), 1)
    test::assert_eq_i32(m.get(1).unwrap_or(0), 30)
    test::assert_true(m.contains_key(1))
}
