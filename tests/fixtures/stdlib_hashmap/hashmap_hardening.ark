use std::test::Test

test "zero_values_are_retained_and_queried" {
    let mut m: HashMap<i32, i32> = HashMap::with_capacity<i32, i32>(2)
    let _ = m.insert(1, 0)
    let _ = m.insert(3, 30)

    match m.get(1) {
        Option::Some(v) => Test::assert_eq_i32(v, 0),
        None => Std::panic("expected Some(0)"),
    }

    match m.get(2) {
        Option::Some(v) => Std::panic("expected None for key 2"),
        None => {
        },
    }

    let _ = m.insert(5, 50)
    Test::assert_eq_i32(m.len(), 3)
    Test::assert_true(m.contains_key(5))
}
