use std::collections::hash_set::HashSet
use std::host::stdio::Stdio
use std::prelude::{assert_eq}
fn main() {
    let mut s = HashSet::new<i32>()
    assert(s.is_empty())
    assert_eq(s.len(), 0)
    assert(s.capacity() >= 1)

    // insert / contains / len
    assert(s.insert(1))
    assert(s.insert(2))
    assert(s.insert(3))
    assert(!s.insert(2)) // duplicate returns false
    assert_eq(s.len(), 3)
    assert(s.contains(1))
    assert(s.contains(2))
    assert(s.contains(3))
    assert(!s.contains(99))

    // reserve / capacity grow
    let cap_before = s.capacity()
    s.reserve(20)
    assert(s.capacity() > cap_before)
    // entries preserved after reserve
    assert_eq(s.len(), 3)
    assert(s.contains(2))

    // extend adds elements from another set
    let mut other = HashSet::new<i32>()
    assert(other.insert(3)) // duplicate of existing
    assert(other.insert(4))
    assert(other.insert(5))
    s.extend(other)
    assert_eq(s.len(), 5)
    assert(s.contains(4))
    assert(s.contains(5))

    // shrink_to_fit reduces capacity, entries preserved
    let big_cap = s.capacity()
    s.shrink_to_fit()
    assert(s.capacity() <= big_cap)
    assert_eq(s.len(), 5)

    // remove
    assert(s.remove(3))
    assert(!s.contains(3))
    assert(!s.remove(3)) // removing absent returns false
    assert_eq(s.len(), 4)

    // clear resets the set
    s.clear()
    assert(s.is_empty())
    assert_eq(s.len(), 0)
    assert(!s.contains(1))

    Stdio::println("OK")
}
