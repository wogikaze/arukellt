// gc-target runtime coverage for the HashMap stores: the capacity/bulk group
// is implemented only for the flat HashMap<i32, i32> store, while the
// compiler-managed String/fn stores keep the per-key surface.
use std::host::stdio::Stdio
use std::test::Test

fn inc(n: i32) -> i32 {
    n + 1
}

fn main() {
    let mut flat = HashMap::with_capacity<i32, i32>(4)
    Test::assert_eq_i32(flat.capacity(), 4)
    flat.reserve(8)
    Test::assert_true(flat.try_reserve(4))
    let _ = flat.insert(1, 10)
    let _ = flat.insert(2, 20)
    match flat.remove_entry(1) {
        Option::Some((key, value)) => {
            Test::assert_eq_i32(key, 1)
            Test::assert_eq_i32(value, 10)
        }
        Option::None => Std::panic("missing flat remove_entry"),
    }
    let mut more = HashMap::new<i32, i32>()
    let _ = more.insert(3, 30)
    flat.extend(more)
    Test::assert_eq_i32(flat.len(), 2)
    let drained_flat: Vec<(i32, i32)> = flat.drain()
    Test::assert_eq_i32(drained_flat.len(), 2)
    Test::assert_true(flat.is_empty())

    // The capacity/bulk group is limited to the flat HashMap<i32, i32> store;
    // String/fn pairs keep the per-key surface.
    let mut strings = HashMap::new<String, i32>()
    let _ = strings.insert("a", 1)
    Test::assert_eq_i32(strings.len(), 1)
    Test::assert_true(strings.contains_key("a"))
    match strings.get("a") {
        Option::Some(value) => Test::assert_eq_i32(value, 1),
        Option::None => Std::panic("missing String get"),
    }
    match strings.remove("a") {
        Option::Some(value) => Test::assert_eq_i32(value, 1),
        Option::None => Std::panic("missing String remove"),
    }
    Test::assert_true(strings.is_empty())

    let mut functions = HashMap::new<String, fn(i32) -> i32>()
    let _ = functions.insert("inc", inc)
    match functions.get("inc") {
        Option::Some(f) => Test::assert_eq_i32(f(4), 5),
        Option::None => Std::panic("missing String->fn get"),
    }

    Stdio::println("capacity-surface-ok")
}
