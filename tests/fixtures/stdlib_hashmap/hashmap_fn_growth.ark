use std::test
use std::text
use std::host::stdio

fn double(n: i32) -> i32 {
    n * 2
}

fn triple(n: i32) -> i32 {
    n * 3
}

// fn-valued HashMap families share the same capacity-growth path as the
// scalar/String families (#895).
fn main() {
    let m = HashMap::new<i32, fn(i32) -> i32>()
    let mut i: i32 = 0
    while i < 40 {
        // Select the fn value before the call: branch-local method calls on
        // a HashMap receiver are a separate edge-inference gap.
        let f: fn(i32) -> i32 = if i % 2 == 0 { double } else { triple }
        let _p = m.insert(i, f)
        i = i + 1
    }
    test::assert_eq_i32(m.len(), 40)
    match m.get(10) {
        Some(f) => test::assert_eq_i32(f(5), 10),
        None => panic("missing grown fn entry"),
    }
    match m.get(39) {
        Some(f) => test::assert_eq_i32(f(5), 15),
        None => panic("missing grown fn entry"),
    }

    let s = HashMap::new<String, fn(i32) -> i32>()
    i = 0
    while i < 40 {
        let _ps = s.insert(text::concat("f_", (i).to_string()), double)
        i = i + 1
    }
    test::assert_eq_i32(s.len(), 40)
    match s.get("f_39") {
        Some(f) => test::assert_eq_i32(f(7), 14),
        None => panic("missing grown String->fn entry"),
    }

    stdio::println("fn-growth-ok")
}
