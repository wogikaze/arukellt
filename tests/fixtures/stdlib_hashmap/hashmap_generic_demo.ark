use std::collections::hash
use std::collections::hash_set::HashSet
use std::test

test "generic_key_value_collections_expose_expected_operations" {
    // --- HashMap<String, i32> via the method surface ---
    let mut m = HashMap::new<String, i32>()
    let _ = m.insert("alpha", 1)
    let _ = m.insert("beta", 2)
    let _ = m.insert("alpha", 10)
    test::assert_eq_i32(m.len(), 2)
    match m.get("alpha") {
        Option::Some(v) => test::assert_eq_i32(v, 10),
        None => panic("expected Some(10)"),
    }
    match m.get("gamma") {
        Option::Some(_) => panic("expected None for gamma"),
        None => {
        },
    }
    test::assert_true(m.contains_key("beta"))
    test::assert_false(m.contains_key("unknown"))

    // --- HashMap<i32, String> via the method surface ---
    let mut m2 = HashMap::new<i32, String>()
    let _ = m2.insert(1, "one")
    let _ = m2.insert(2, "two")
    let _ = m2.insert(1, "ONE")
    test::assert_eq_i32(m2.len(), 2)
    match m2.get(1) {
        Option::Some(v) => test::assert_eq_string(v, "ONE"),
        None => panic("expected Some(\"ONE\")"),
    }

    // --- HashMap<String, String> via the method surface ---
    let mut m3 = HashMap::new<String, String>()
    let _ = m3.insert("greeting", "hello")
    let _ = m3.insert("farewell", "goodbye")
    test::assert_eq_i32(m3.len(), 2)
    match m3.get("greeting") {
        Option::Some(v) => test::assert_eq_string(v, "hello"),
        None => panic("expected Some(\"hello\")"),
    }
    test::assert_true(m3.contains_key("farewell"))

    // --- HashSet<String> method surface ---
    let mut s: HashSet<String> = HashSet::new<String>()
    test::assert_true(s.insert("red"))
    test::assert_true(s.insert("green"))
    test::assert_false(s.insert("red"))
    test::assert_eq_i32(s.len(), 2)
    test::assert_true(s.contains("green"))
    test::assert_false(s.contains("blue"))
    test::assert_true(s.remove("green"))
    test::assert_eq_i32(s.len(), 1)

    // --- HashSet<i32> operations via direct hash module ---
    let mut s2 = hash::hashset_new()
    let _ = hash::hashset_insert(s2, 10)
    let _ = hash::hashset_insert(s2, 20)
    let _ = hash::hashset_insert(s2, 30)
    let mut s3 = hash::hashset_new()
    let _ = hash::hashset_insert(s3, 20)
    let _ = hash::hashset_insert(s3, 30)
    let _ = hash::hashset_insert(s3, 40)
    let u = hash::hashset_union(s2, s3)
    test::assert_eq_i32(hash::hashset_len(u), 4)
    let i = hash::hashset_intersection(s2, s3)
    test::assert_eq_i32(hash::hashset_len(i), 2)
    let d = hash::hashset_difference(s2, s3)
    test::assert_eq_i32(hash::hashset_len(d), 1)
}
