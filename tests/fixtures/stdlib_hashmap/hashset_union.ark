// HashSet: union contains all elements from both sets
use std::collections::hash_set::HashSet
use std::test

fn main() {
    let mut a = HashSet::new<i32>()
    a.insert(1)
    a.insert(2)
    a.insert(3)

    let mut b = HashSet::new<i32>()
    b.insert(3)
    b.insert(4)
    b.insert(5)

    let u = a.union(b)
    test::assert_eq_i32(u.len(), 5)
    test::assert_true(u.contains(1))
    test::assert_true(u.contains(2))
    test::assert_true(u.contains(3))
    test::assert_true(u.contains(4))
    test::assert_true(u.contains(5))
}
