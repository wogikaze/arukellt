// HashSet: extend adds all elements from other set
use std::collections::hash_set::HashSet
use std::test::Test

fn main() {
    let mut a = HashSet::new<i32>()
    a.insert(1)
    a.insert(2)

    let mut b = HashSet::new<i32>()
    b.insert(2)
    b.insert(3)
    b.insert(4)

    a.extend(b)
    Test::assert_eq_i32(a.len(), 4)
    Test::assert_true(a.contains(1))
    Test::assert_true(a.contains(2))
    Test::assert_true(a.contains(3))
    Test::assert_true(a.contains(4))
}
