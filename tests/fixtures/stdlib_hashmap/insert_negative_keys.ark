// Insert: negative keys are handled correctly
use std::test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(0 - 1, 100)
    let _ = m.insert(0 - 100, 200)
    let _ = m.insert(0 - 2147483648, 300)
    test::assert_eq_i32(m.len(), 3)
    test::assert_eq_i32(m.get(0 - 1).unwrap_or(0), 100)
    test::assert_eq_i32(m.get(0 - 100).unwrap_or(0), 200)
    test::assert_eq_i32(m.get(0 - 2147483648).unwrap_or(0), 300)
    test::assert_true(m.contains_key(0 - 1))
    test::assert_true(m.contains_key(0 - 100))
    test::assert_true(m.contains_key(0 - 2147483648))
}
