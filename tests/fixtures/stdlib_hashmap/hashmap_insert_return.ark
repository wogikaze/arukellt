use std::test

fn assert_none(v: Option<i32>) {
    match v {
        Option::Some(_) => Std::panic("expected None"),
        None => {
        },
    }
}

fn assert_some(v: Option<i32>, expected: i32) {
    match v {
        Option::Some(n) => test::assert_eq_i32(n, expected),
        None => Std::panic("expected Some"),
    }
}

test "insert_returns_previous_value_when_present" {
    let mut raw = HashMap::new<i32, i32>()
    assert_none(raw.insert(7, 70))
    assert_some(raw.insert(7, 700), 70)
    assert_some(raw.get(7), 700)

    let mut m = HashMap::new<i32, i32>()
    assert_none(m.insert(1, 10))
    assert_some(m.insert(1, 11), 10)
    assert_some(m.get(1), 11)
}
