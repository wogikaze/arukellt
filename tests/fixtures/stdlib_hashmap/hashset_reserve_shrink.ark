// HashSet: reserve and shrink_to_fit
use std::collections::hash_set::HashSet
use std::test::Test

fn main() {
    let mut s = HashSet::new<i32>()
    s.insert(1)
    s.insert(2)

    let cap_before = s.capacity()
    s.reserve(20)
    // reserve grows bucket capacity for load-factor headroom, not raw +additional.
    Test::assert_true(s.capacity() > cap_before)
    Test::assert_eq_i32(s.len(), 2)
    Test::assert_true(s.contains(1))
    Test::assert_true(s.contains(2))

    s.shrink_to_fit()
    Test::assert_true(s.capacity() <= cap_before + 20)
    Test::assert_eq_i32(s.len(), 2)
    Test::assert_true(s.contains(1))
    Test::assert_true(s.contains(2))
}
