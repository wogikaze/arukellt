use std::test::Test

test "string_keys_overwrite_and_lookup_integer_values" {
    let mut m = HashMap::new<String, i32>()
    let _ = m.insert("apple", 3)
    let _ = m.insert("banana", 7)
    let _ = m.insert("cherry", 1)
    let _ = m.insert("banana", 42)
    Test::assert_eq_i32(m.len(), 3)
    match m.get("apple") {
        Option::Some(v) => Test::assert_eq_i32(v, 3),
        None => Std::panic("expected Some(3)"),
    }
    match m.get("banana") {
        Option::Some(v) => Test::assert_eq_i32(v, 42),
        None => Std::panic("expected Some(42)"),
    }
    match m.get("durian") {
        Option::Some(v) => Std::panic("expected None"),
        None => {
        },
    }
    Test::assert_true(m.contains_key("cherry"))
    Test::assert_false(m.contains_key("mango"))
}
