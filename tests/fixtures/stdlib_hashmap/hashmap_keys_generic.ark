// Issue #691: HashMap::keys() and for-in over every supported pair.
//
// `keys()` is a source-level generic method that monomorphizes to the
// per-combo `hashmap_<family>_keys` adapter, including inside generic
// bodies with deferred K/V type variables. `for pair in map` iterates the
// same pair snapshot as `iter()` through IntoIterator.
use std::host::stdio::Stdio
fn double(n: i32) -> i32 {
    n * 2
}

fn key_count<K, V>(m: HashMap<K, V>) -> i32 {
    m.keys().len()
}

fn main() {
    let mut ii = HashMap::new<i32, i32>()
    let _ = ii.insert(1, 10)
    let _ = ii.insert(2, 20)
    let ii_keys = ii.keys()
    assert(ii_keys.len() == 2)

    let mut si = HashMap::new<String, i32>()
    let _ = si.insert(String_from("a"), 1)
    let si_keys = si.keys()
    assert(si_keys.len() == 1)
    assert(si_keys.get_unchecked(0).eq(String_from("a")))

    let mut i_fn = HashMap::new<i32, fn(i32) -> i32>()
    let _ = i_fn.insert(7, double)
    let i_fn_keys = i_fn.keys()
    assert(i_fn_keys.len() == 1)
    assert(i_fn_keys.get_unchecked(0) == 7)

    let mut s_fn = HashMap::new<String, fn(i32) -> i32>()
    let _ = s_fn.insert(String_from("k"), double)
    let s_fn_keys = s_fn.keys()
    assert(s_fn_keys.len() == 1)

    // Deferred K/V inside a generic body resolves to the same per-combo
    // adapters at monomorphization.
    assert(key_count(i_fn) == 1)
    assert(key_count(s_fn) == 1)
    assert(key_count(ii) == 2)

    // for-in over fn-valued maps yields (K, V) pairs through IntoIterator.
    let mut total = 0
    for pair in i_fn {
        let (k, f) = pair
        total = total + f(k)
    }
    assert(total == 14)
    let mut seen = 0
    for pair in s_fn {
        let (k, f) = pair
        seen = seen + k.len() + f(0)
    }
    assert(seen == 1)

    let mut flat_total = 0
    for pair in ii {
        let (k, v) = pair
        flat_total = flat_total + k * 10 + v
    }
    assert(flat_total == 60)
    Stdio::println("OK")
}
