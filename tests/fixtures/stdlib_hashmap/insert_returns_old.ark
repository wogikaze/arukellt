// Insert: hashmap_insert returns Some(old) on overwrite
use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(1, 100)
    match m.insert(1, 200) {
        Option::Some(v) => Test::assert_eq_i32(v, 100),
        None => Std::panic("expected Some(100) on overwrite"),
    }
    match m.insert(1, 300) {
        Option::Some(v) => Test::assert_eq_i32(v, 200),
        None => Std::panic("expected Some(200) on overwrite"),
    }
    Test::assert_eq_i32(m.get(1).unwrap_or(0), 300)
    Test::assert_eq_i32(m.len(), 1)
}
