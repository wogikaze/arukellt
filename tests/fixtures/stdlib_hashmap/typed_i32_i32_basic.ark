// Typed map: i32->i32 basic operations
use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    Test::assert_true(m.is_empty())

    let _ = m.insert(1, 100)
    let _ = m.insert(2, 200)
    Test::assert_eq_i32(m.len(), 2)

    match m.get(1) {
        Option::Some(v) => Test::assert_eq_i32(v, 100),
        None => Std::panic("expected Some(100)"),
    }
    Test::assert_true(m.contains_key(1))
    Test::assert_false(m.contains_key(99))
}
