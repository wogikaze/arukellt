// Reserve: existing data is preserved after capacity growth
use std::test

fn main() {
    let mut m = HashMap::with_capacity<i32, i32>(2)
    let _ = m.insert(1, 10)
    let _ = m.insert(2, 20)

    m.reserve(100)

    test::assert_eq_i32(m.len(), 2)
    test::assert_eq_i32(m.get(1).unwrap_or(0), 10)
    test::assert_eq_i32(m.get(2).unwrap_or(0), 20)
    test::assert_true(m.contains_key(1))
    test::assert_true(m.contains_key(2))

    // Can still insert after reserve
    let _ = m.insert(3, 30)
    test::assert_eq_i32(m.get(3).unwrap_or(0), 30)
    test::assert_eq_i32(m.len(), 3)
}
