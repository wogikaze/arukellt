// Insert: a stored zero value is Some(0); a missing key is None
use std::test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(5, 0)
    test::assert_true(m.contains_key(5))
    match m.get(5) {
        Option::Some(v) => test::assert_eq_i32(v, 0),
        None => Std::panic("expected Some(0) for stored zero"),
    }
    test::assert_eq_i32(m.len(), 1)

    test::assert_false(m.contains_key(6))
    match m.get(6) {
        Option::Some(_) => Std::panic("expected None for missing key"),
        None => {
        },
    }
}
