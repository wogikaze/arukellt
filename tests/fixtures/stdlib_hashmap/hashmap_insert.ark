use std::host::stdio::Stdio
use std::prelude::{assert_eq}
fn expect_some(v: Option<i32>, expected: i32) {
    match v {
        Option::Some(x) => assert_eq(x, expected),
        None => assert(false),
    }
}

fn expect_none(v: Option<i32>) {
    match v {
        Option::Some(_) => assert(false),
        None => {}
    }
}

fn main() {
    let mut m = HashMap::new<i32, i32>()
    assert(m.is_empty())
    assert_eq(m.len(), 0)

    // Insert new keys returns None (no previous value).
    expect_none(m.insert(1, 100))
    expect_none(m.insert(2, 200))
    expect_none(m.insert(3, 300))
    assert(!m.is_empty())
    assert_eq(m.len(), 3)

    // contains / get
    assert(m.contains_key(1))
    assert(m.contains_key(2))
    assert(m.contains_key(3))
    assert(!m.contains_key(999))
    expect_some(m.get(1), 100)
    expect_some(m.get(2), 200)
    expect_some(m.get(3), 300)
    expect_none(m.get(999))

    // Update existing key returns previous value.
    expect_some(m.insert(1, 111), 100)
    expect_some(m.get(1), 111)
    assert_eq(m.len(), 3)

    // Zero-value lookup must distinguish missing from stored zero.
    expect_none(m.insert(5, 0))
    assert(m.contains_key(5))
    expect_some(m.get(5), 0)

    // keys / values snapshots
    assert_eq(len(m.keys()), 4)
    assert_eq(len(m.values()), 4)

    Stdio::println("OK")
}
