// Stress: repeated insert/overwrite cycle
use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let mut round = 0
    while round < 5 {
        let mut i = 0
        while i < 20 {
            let _ = m.insert(i, round * 100 + i)
            i = i + 1
        }
        round = round + 1
    }
    // After 5 rounds of overwriting, size is 20, values are from last round
    Test::assert_eq_i32(m.len(), 20)
    let mut i = 0
    while i < 20 {
        Test::assert_eq_i32(m.get(i).unwrap_or(0), 400 + i)
        i = i + 1
    }
}
