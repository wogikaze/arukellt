// Stress: insert 100 keys, verify all present
use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let mut i = 0
    while i < 100 {
        let _ = m.insert(i, i * 2)
        i = i + 1
    }
    Test::assert_eq_i32(m.len(), 100)

    i = 0
    while i < 100 {
        Test::assert_true(m.contains_key(i))
        Test::assert_eq_i32(m.get(i).unwrap_or(0), i * 2)
        i = i + 1
    }
}
