// Property: after resize, all keys remain accessible
use std::test::Test

fn main() {
    let mut m = HashMap::with_capacity<i32, i32>(2)
    let mut i = 0
    while i < 100 {
        let _ = m.insert(i * 7, i)
        i = i + 1
    }
    Test::assert_eq_i32(m.len(), 100)

    // All keys accessible
    i = 0
    while i < 100 {
        Test::assert_eq_i32(m.get(i * 7).unwrap_or(0), i)
        i = i + 1
    }
}
