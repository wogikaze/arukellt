use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    Test::assert_eq_i32(m.len(), 0)
    Test::assert_false(m.contains_key(1))

    let _ = m.insert(1, 100)
    let _ = m.insert(2, 200)
    let _ = m.insert(0 - 7, 70)
    let _ = m.insert(1, 111)
    Test::assert_eq_i32(m.len(), 3)
    Test::assert_true(m.contains_key(1))
    Test::assert_true(m.contains_key(0 - 7))
    Test::assert_false(m.contains_key(99))

    match m.get(1) {
        Option::Some(v) => Test::assert_eq_i32(v, 111),
        None => Std::panic("expected Some(111)"),
    }
    match m.get(99) {
        Option::Some(_) => Std::panic("expected None for missing key"),
        None => {
        },
    }

    match m.remove(2) {
        Option::Some(v) => Test::assert_eq_i32(v, 200),
        None => Std::panic("expected Some(200)"),
    }
    Test::assert_eq_i32(m.len(), 2)
    Test::assert_false(m.contains_key(2))
    let _ = m.insert(2, 222)
    match m.get(2) {
        Option::Some(v) => Test::assert_eq_i32(v, 222),
        None => Std::panic("expected Some(222) after reinsert"),
    }
    Test::assert_eq_i32(m.len(), 3)
}
