// Get: a missing key is None; contains_key stays the presence check
use std::test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(1, 10)

    // Missing key
    match m.get(2) {
        Option::Some(_) => Std::panic("expected None for missing key"),
        None => {
        },
    }
    test::assert_false(m.contains_key(2))

    // Missing key after remove
    let _ = m.insert(3, 30)
    let _ = m.remove(3)
    match m.get(3) {
        Option::Some(_) => Std::panic("expected None for removed key"),
        None => {
        },
    }
    test::assert_false(m.contains_key(3))
}
