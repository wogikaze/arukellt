// Insert: single key-value pair
use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(42, 100)
    Test::assert_eq_i32(m.len(), 1)
    Test::assert_false(m.is_empty())
    Test::assert_true(m.contains_key(42))
    Test::assert_eq_i32(m.get(42).unwrap_or(0), 100)
}
