// Extend: merges other map into self, overwriting duplicates
use std::test::Test

fn main() {
    let mut m1 = HashMap::new<i32, i32>()
    let _ = m1.insert(1, 10)
    let _ = m1.insert(2, 20)

    let mut m2 = HashMap::new<i32, i32>()
    m2.insert(2, 200)  // overwrite
    m2.insert(3, 300)  // new

    m1.extend(m2)

    Test::assert_eq_i32(m1.len(), 3)
    Test::assert_eq_i32(m1.get(1).unwrap_or(0), 10)   // original
    Test::assert_eq_i32(m1.get(2).unwrap_or(0), 200)  // overwritten
    Test::assert_eq_i32(m1.get(3).unwrap_or(0), 300)  // new from m2
}
