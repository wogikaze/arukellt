// Property: insert N keys, size == N (no duplicates)
use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let mut i = 0
    while i < 30 {
        let _ = m.insert(i, i)
        i = i + 1
    }
    Test::assert_eq_i32(m.len(), 30)

    // Re-insert same keys, size unchanged
    i = 0
    while i < 30 {
        let _ = m.insert(i, i + 1000)
        i = i + 1
    }
    Test::assert_eq_i32(m.len(), 30)

    // Values updated
    i = 0
    while i < 30 {
        Test::assert_eq_i32(m.get(i).unwrap_or(0), i + 1000)
        i = i + 1
    }
}
