// Remove_entry: absent key returns None and leaves the map unchanged
use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(1, 10)

    match m.remove_entry(999) {
        Option::Some(_) => Std::panic("expected None for absent key"),
        None => {
        },
    }
    Test::assert_eq_i32(m.len(), 1)
    Test::assert_true(m.contains_key(1))

    let mut m2 = HashMap::new<i32, i32>()
    match m2.remove_entry(1) {
        Option::Some(_) => Std::panic("expected None for empty map"),
        None => {
        },
    }
}
