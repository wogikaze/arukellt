use std::test::Test
use std::text
use std::host::stdio::Stdio

// HashMap backing tables start at capacity 16 and must keep every entry
// once inserts exceed that capacity (#895).
fn main() {
    let mut m = HashMap::new<String, i32>()
    let mut i: i32 = 0
    while i < 100 {
        let _prev = m.insert("key_".concat((i).to_string()), i * 7)
        i = i + 1
    }
    Test::assert_eq_i32(m.len(), 100)
    let mut sum: i32 = 0
    i = 0
    while i < 100 {
        match m.get("key_".concat((i).to_string())) {
            Option::Some(v) => sum = sum + v,
            None => sum = sum - 100000,
        }
        i = i + 1
    }
    Test::assert_eq_i32(sum, 34650)

    // Remove + reinsert after growth keeps len and lookups consistent.
    i = 0
    while i < 30 {
        match m.remove("key_".concat((i).to_string())) {
            Option::Some(_) => sum = sum + 1,
            None => sum = sum - 100000,
        }
        i = i + 1
    }
    Test::assert_eq_i32(m.len(), 70)
    Test::assert_false(m.contains_key("key_5"))
    Test::assert_true(m.contains_key("key_50"))
    let _prev2 = m.insert("key_".concat((200).to_string()), 1)
    Test::assert_eq_i32(m.len(), 71)

    // The remaining intrinsic families grow through the same Ark path.
    let mut mi = HashMap::new<i32, String>()
    i = 0
    while i < 60 {
        let _previ = mi.insert(i, "v".concat((i).to_string()))
        i = i + 1
    }
    Test::assert_eq_i32(mi.len(), 60)
    match mi.get(42) {
        Option::Some(v) => Test::assert_eq_string(v, "v42"),
        None => Std::panic("missing grown i32->String entry"),
    }

    let mut ms = HashMap::new<String, String>()
    i = 0
    while i < 60 {
        let _prevs = ms.insert("s_".concat((i).to_string()), "w_".concat((i).to_string()))
        i = i + 1
    }
    Test::assert_eq_i32(ms.len(), 60)
    match ms.get("s_59") {
        Option::Some(v) => Test::assert_eq_string(v, "w_59"),
        None => Std::panic("missing grown String->String entry"),
    }

    Stdio::println("growth-ok")
}
