use std::collections::hash_set::HashSet
use std::test::Test

fn assert_some(v: Option<i32>, expected: i32) {
    match v {
        Option::Some(x) => Test::assert_eq_i32(x, expected),
        None => Std::panic("expected Some"),
    }
}

fn assert_none(v: Option<i32>) {
    match v {
        Option::Some(_) => Std::panic("expected None"),
        None => {
        },
    }
}

test "zero_and_boundary_values_round_trip" {
    let mut m: HashMap<i32, i32> = HashMap::with_capacity<i32, i32>(2)
    let _ = m.insert(1, 0)
    let _ = m.insert(3, 30)
    assert_some(m.get(1), 0)
    assert_some(m.insert(3, 33), 30)
    assert_some(m.get(3), 33)

    let removed_one: Option<i32> = m.remove(1)
    assert_some(removed_one, 0)
    assert_some(m.get(3), 33)

    let _ = m.insert(5, 50)
    Test::assert_eq_i32(m.len(), 2)
    Test::assert_true(m.contains_key(5))

    let entry_pairs: Vec<(i32, i32)> = m.entries()
    Test::assert_eq_i32(entry_pairs.len(), 2)
    match m.remove_entry(3) {
        Option::Some((k, v)) => {
            Test::assert_eq_i32(k, 3)
            Test::assert_eq_i32(v, 33)
        },
        None => Std::panic("expected Some(3, 33)"),
    }
    assert_none(m.get(3))

    let drained: Vec<(i32, i32)> = m.drain()
    Test::assert_eq_i32(drained.len(), 1)
    Test::assert_true(m.is_empty())

    let mut s: HashSet<String> = HashSet::new<String>()
    Test::assert_true(s.insert("alpha"))
    Test::assert_false(s.insert("alpha"))
    Test::assert_true(s.contains("alpha"))
    Test::assert_true(s.remove("alpha"))
    Test::assert_false(s.contains("alpha"))
}
