// Extend empty map with non-empty map
use std::test

fn main() {
    let mut m1 = HashMap::new<i32, i32>()
    let mut m2 = HashMap::new<i32, i32>()
    let _ = m2.insert(1, 10)
    let _ = m2.insert(2, 20)

    m1.extend(m2)

    test::assert_eq_i32(m1.len(), 2)
    test::assert_eq_i32(m1.get(1).unwrap_or(0), 10)
    test::assert_eq_i32(m1.get(2).unwrap_or(0), 20)
}
