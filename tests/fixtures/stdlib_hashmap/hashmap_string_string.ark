use std::test::Test

test "string_keys_map_to_overwritten_string_values" {
    let mut m = HashMap::new<String, String>()
    let _ = m.insert("greeting", "hello")
    let _ = m.insert("farewell", "goodbye")
    let _ = m.insert("color", "red")
    let _ = m.insert("color", "blue")
    Test::assert_eq_i32(m.len(), 3)
    match m.get("greeting") {
        Option::Some(v) => Test::assert_eq_string(v, "hello"),
        None => Std::panic("expected Some(hello)"),
    }
    match m.get("color") {
        Option::Some(v) => Test::assert_eq_string(v, "blue"),
        None => Std::panic("expected Some(blue)"),
    }
    match m.get("missing") {
        Option::Some(v) => Std::panic("expected None"),
        None => {
        },
    }
    Test::assert_true(m.contains_key("farewell"))
    Test::assert_false(m.contains_key("unknown"))
}
