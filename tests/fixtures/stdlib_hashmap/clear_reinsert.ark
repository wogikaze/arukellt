// Clear + reinsert: map is usable after clear
use std::test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(1, 10)
    let _ = m.insert(2, 20)
    m.clear()

    // Reinsert same and new keys
    let _ = m.insert(1, 100)
    let _ = m.insert(3, 300)
    test::assert_eq_i32(m.len(), 2)
    test::assert_eq_i32(m.get(1).unwrap_or(0), 100)
    test::assert_eq_i32(m.get(3).unwrap_or(0), 300)
    test::assert_false(m.contains_key(2))
}
