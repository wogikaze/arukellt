// Property fixture for issue #528 — deterministic snapshot comparison.
//
// Invariant: a snapshot of a HashMap is independent of the hash map's
// iteration order when the snapshot is produced under an explicit
// normalization rule.
use std::test::Test

// Inline ascending insertion sort on a `Vec<i32>`.
fn sort_asc(mut v: Vec<i32>) {
    let n: i32 = v.len()
    for i in 1..n {
        let key: i32 = v.get_unchecked(i)
        let mut k: i32 = i
        let mut placed: bool = false
        while k > 0 {
            let prev: i32 = v.get_unchecked(k - 1)
            if prev > key {
                v.set(k, prev)
                k = k - 1
            } else {
                v.set(k, key)
                k = 0
                placed = true
            }
        }
        if !placed {
            v.set(0, key)
        }
    }
}

fn assert_snapshot(m: HashMap<i32, i32>) {
    let mut keys: Vec<i32> = m.keys()
    sort_asc(keys)
    let n: i32 = keys.len()
    Test::assert_eq_i32(n, 5)
    // Sorted keys must be 1, 3, 5, 7, 11
    Test::assert_eq_i32(keys.get_unchecked(0), 1)
    Test::assert_eq_i32(keys.get_unchecked(1), 3)
    Test::assert_eq_i32(keys.get_unchecked(2), 5)
    Test::assert_eq_i32(keys.get_unchecked(3), 7)
    Test::assert_eq_i32(keys.get_unchecked(4), 11)
    // Each key must map to key * 10
    for i in 0..n {
        let k: i32 = keys.get_unchecked(i)
        match m.get(k) {
            Option::Some(v) => Test::assert_eq_i32(v, k * 10),
            None => Std::panic("expected Some"),
        }
    }
}

test "sorted_snapshot_is_independent_of_insertion_order" {
    // Build X in one order.
    let mut x: HashMap<i32, i32> = HashMap::new<i32, i32>()
    let _ = x.insert(7, 70)
    let _ = x.insert(3, 30)
    let _ = x.insert(11, 110)
    let _ = x.insert(5, 50)
    let _ = x.insert(1, 10)

    // Build Y with the SAME logical entries in a DIFFERENT insertion order.
    let mut y: HashMap<i32, i32> = HashMap::new<i32, i32>()
    let _ = y.insert(1, 10)
    let _ = y.insert(11, 110)
    let _ = y.insert(3, 30)
    let _ = y.insert(5, 50)
    let _ = y.insert(7, 70)

    assert_snapshot(x)
    assert_snapshot(y)
}
