// Stress: insert beyond initial capacity triggers resize, data preserved
use std::test::Test

fn main() {
    let mut m = HashMap::with_capacity<i32, i32>(4)
    let mut i = 0
    while i < 50 {
        let _ = m.insert(i, i * 10)
        i = i + 1
    }
    Test::assert_eq_i32(m.len(), 50)
    Test::assert_true(m.capacity() >= 50)

    // All data accessible after resize
    i = 0
    while i < 50 {
        Test::assert_eq_i32(m.get(i).unwrap_or(0), i * 10)
        i = i + 1
    }
}
