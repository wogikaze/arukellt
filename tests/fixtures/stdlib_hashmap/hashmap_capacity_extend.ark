use std::host::stdio::Stdio
use std::prelude::{assert_eq}
fn expect_some(v: Option<i32>, expected: i32) {
    match v {
        Option::Some(x) => assert_eq(x, expected),
        None => assert(false),
    }
}

fn main() {
    let mut m = HashMap::with_capacity<i32, i32>(2)
    assert(m.capacity() >= 2)

    // reserve grows capacity to satisfy the load-factor invariant.
    let cap_before = m.capacity()
    m.reserve(5)
    assert(m.capacity() > cap_before)
    assert(m.try_reserve(3))

    // Insertions beyond the original capacity trigger automatic growth.
    let mut i: i32 = 0
    while i < 20 {
        let _ = m.insert(i, i * 10)
        i = i + 1
    }
    assert_eq(m.len(), 20)
    let mut j: i32 = 0
    while j < 20 {
        expect_some(m.get(j), j * 10)
        j = j + 1
    }

    // shrink_to_fit reduces capacity while preserving entries.
    let big_cap = m.capacity()
    m.shrink_to_fit()
    assert(m.capacity() <= big_cap)
    assert_eq(m.len(), 20)
    expect_some(m.get(7), 70)

    // extend copies entries from another map, overwriting existing keys.
    let mut other = HashMap::new<i32, i32>()
    let _ = other.insert(0, 999)
    let _ = other.insert(100, 1000)
    m.extend(other)
    expect_some(m.get(0), 999)
    expect_some(m.get(100), 1000)
    assert_eq(m.len(), 21)

    Stdio::println("OK")
}
