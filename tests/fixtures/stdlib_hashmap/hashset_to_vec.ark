// HashSet: to_vec returns all elements
use std::collections::hash_set::HashSet
use std::test::Test

fn main() {
    let mut s = HashSet::new<i32>()
    s.insert(1)
    s.insert(2)
    s.insert(3)

    let v = s.to_vec()
    Test::assert_eq_i32(v.len(), 3)

    // Every element should be in the set
    let mut found_1 = false
    let mut found_2 = false
    let mut found_3 = false
    let mut i = 0
    while i < v.len() {
        let x = get_unchecked(v, i)
        if x == 1 { found_1 = true }
        if x == 2 { found_2 = true }
        if x == 3 { found_3 = true }
        i = i + 1
    }
    Test::assert_true(found_1)
    Test::assert_true(found_2)
    Test::assert_true(found_3)
}
