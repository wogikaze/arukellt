// HashMap<String, String> method surface: insert/get/contains_key/len.
use std::test::Test

fn main() {
    let mut m = HashMap::new<String, String>()
    let _ = m.insert("en", "hello")
    let _ = m.insert("fr", "bonjour")

    Test::assert_eq_i32(m.len(), 2)
    Test::assert_true(m.contains_key("en"))
    Test::assert_false(m.contains_key("de"))

    match m.get("en") {
        Option::Some(v) => Test::assert_eq_string(v, "hello"),
        None => Std::panic("expected Some(hello)"),
    }
    match m.get("fr") {
        Option::Some(v) => Test::assert_eq_string(v, "bonjour"),
        None => Std::panic("expected Some(bonjour)"),
    }
}
