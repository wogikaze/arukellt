// Drain: returns every entry as a typed pair and empties the map
use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(1, 10)
    let _ = m.insert(2, 20)

    let drained = m.drain()
    Test::assert_eq_i32(drained.len(), 2)
    let mut found_1_10 = false
    let mut found_2_20 = false
    let mut i = 0
    while i < drained.len() {
        let (k, v) = get_unchecked(drained, i)
        if k == 1 && v == 10 {
            found_1_10 = true
        }
        if k == 2 && v == 20 {
            found_2_20 = true
        }
        i = i + 1
    }
    Test::assert_true(found_1_10)
    Test::assert_true(found_2_20)
    Test::assert_true(m.is_empty())
    Test::assert_eq_i32(m.len(), 0)
    Test::assert_false(m.contains_key(1))
    Test::assert_false(m.contains_key(2))
}
