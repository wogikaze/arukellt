// HashMap<i32, String> method surface: insert/get/contains_key/len.
use std::test

fn main() {
    let mut m = HashMap::new<i32, String>()
    let _ = m.insert(1, "one")
    let _ = m.insert(2, "two")

    test::assert_eq_i32(m.len(), 2)
    test::assert_true(m.contains_key(1))
    test::assert_false(m.contains_key(99))

    match m.get(1) {
        Option::Some(v) => test::assert_eq_string(v, "one"),
        None => panic("expected Some(one)"),
    }
    match m.get(2) {
        Option::Some(v) => test::assert_eq_string(v, "two"),
        None => panic("expected Some(two)"),
    }
}
