// Remove: key with zero value returns Some(0), not None
use std::test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(5, 0)
    test::assert_true(m.contains_key(5))

    match m.remove(5) {
        Option::Some(v) => test::assert_eq_i32(v, 0),
        None => Std::panic("expected Some(0) for stored-zero value"),
    }
    test::assert_false(m.contains_key(5))
    test::assert_eq_i32(m.len(), 0)
}
