// Shrink_to_fit: reduces capacity, preserves data
use std::test::Test

fn main() {
    let mut m = HashMap::with_capacity<i32, i32>(100)
    let _ = m.insert(1, 10)
    let _ = m.insert(2, 20)

    let cap_before = m.capacity()
    m.shrink_to_fit()
    let cap_after = m.capacity()
    Test::assert_true(cap_after <= cap_before)

    // Data preserved
    Test::assert_eq_i32(m.len(), 2)
    Test::assert_eq_i32(m.get(1).unwrap_or(0), 10)
    Test::assert_eq_i32(m.get(2).unwrap_or(0), 20)

    // Can still insert after shrink
    let _ = m.insert(3, 30)
    Test::assert_eq_i32(m.get(3).unwrap_or(0), 30)
}
