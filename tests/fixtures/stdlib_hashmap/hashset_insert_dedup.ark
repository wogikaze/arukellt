// HashSet: insert returns true for new, false for duplicate
use std::collections::hash_set::HashSet
use std::test

fn main() {
    let mut s = HashSet::new<i32>()
    test::assert_true(s.insert(1))
    test::assert_true(s.insert(2))
    test::assert_true(s.insert(3))
    test::assert_false(s.insert(1))  // duplicate
    test::assert_false(s.insert(2))  // duplicate
    test::assert_eq_i32(s.len(), 3)
}
