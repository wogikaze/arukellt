// Typed map: i32->i32 remove
use std::test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(1, 10)
    let _ = m.insert(2, 20)

    match m.remove(1) {
        Option::Some(v) => test::assert_eq_i32(v, 10),
        None => Std::panic("expected Some(10)"),
    }
    test::assert_eq_i32(m.len(), 1)
    test::assert_false(m.contains_key(1))
    test::assert_true(m.contains_key(2))
}
