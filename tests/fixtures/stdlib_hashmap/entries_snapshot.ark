// Entries: returns the typed (key, value) snapshot
use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    let _ = m.insert(1, 10)
    let _ = m.insert(2, 20)

    let entries = m.entries()
    Test::assert_eq_i32(entries.len(), 2)

    let mut found_1_10 = false
    let mut found_2_20 = false
    let mut i = 0
    while i < entries.len() {
        let (k, v) = entries.get_unchecked(i)
        if k == 1 && v == 10 {
            found_1_10 = true
        }
        if k == 2 && v == 20 {
            found_2_20 = true
        }
        i = i + 1
    }
    Test::assert_true(found_1_10)
    Test::assert_true(found_2_20)
}
