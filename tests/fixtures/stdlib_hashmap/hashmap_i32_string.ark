use std::test::Test

test "integer_keys_overwrite_and_lookup_string_values" {
    let mut m = HashMap::new<i32, String>()
    let _ = m.insert(1, "one")
    let _ = m.insert(2, "two")
    let _ = m.insert(3, "three")
    let _ = m.insert(2, "TWO")
    Test::assert_eq_i32(m.len(), 3)
    match m.get(1) {
        Option::Some(v) => Test::assert_eq_string(v, "one"),
        None => Std::panic("expected Some(one)"),
    }
    match m.get(2) {
        Option::Some(v) => Test::assert_eq_string(v, "TWO"),
        None => Std::panic("expected Some(TWO)"),
    }
    match m.get(99) {
        Option::Some(v) => Std::panic("expected None"),
        None => {
        },
    }
    Test::assert_true(m.contains_key(3))
    Test::assert_false(m.contains_key(42))
}
