// HashSet: difference a - b contains elements in a not in b
use std::collections::hash_set::HashSet
use std::test::Test

fn main() {
    let mut a = HashSet::new<i32>()
    a.insert(1)
    a.insert(2)
    a.insert(3)
    a.insert(4)

    let mut b = HashSet::new<i32>()
    b.insert(2)
    b.insert(4)

    let diff = a.difference(b)
    Test::assert_eq_i32(diff.len(), 2)
    Test::assert_true(diff.contains(1))
    Test::assert_true(diff.contains(3))
    Test::assert_false(diff.contains(2))
    Test::assert_false(diff.contains(4))
}
