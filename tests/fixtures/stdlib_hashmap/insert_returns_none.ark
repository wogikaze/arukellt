// Insert: hashmap_insert returns None for new key
use std::test::Test

fn main() {
    let mut m = HashMap::new<i32, i32>()
    match m.insert(1, 100) {
        Option::Some(_) => Std::panic("expected None for new key"),
        None => {}
    }
    match m.insert(2, 200) {
        Option::Some(_) => Std::panic("expected None for new key"),
        None => {}
    }
    Test::assert_eq_i32(m.len(), 2)
}
