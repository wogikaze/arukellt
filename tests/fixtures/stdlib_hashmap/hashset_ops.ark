use std::collections::hash_set::HashSet
use std::test

test "union_intersection_and_difference_sets" {
    let mut a: HashSet<i32> = HashSet::new<i32>()
    let _ = a.insert(1)
    let _ = a.insert(2)
    let _ = a.insert(3)
    let mut b: HashSet<i32> = HashSet::new<i32>()
    let _ = b.insert(2)
    let _ = b.insert(3)
    let _ = b.insert(4)
    let u: HashSet<i32> = a.union(b)
    test::assert_eq_i32(u.len(), 4)
    test::assert_true(u.contains(1))
    test::assert_true(u.contains(4))
    test::assert_false(u.contains(99))
    let i: HashSet<i32> = a.intersection(b)
    test::assert_eq_i32(i.len(), 2)
    test::assert_true(i.contains(2))
    test::assert_false(i.contains(1))
    let d: HashSet<i32> = a.difference(b)
    test::assert_eq_i32(d.len(), 1)
    test::assert_true(d.contains(1))
    test::assert_false(d.contains(2))
}
