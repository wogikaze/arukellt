use std::host::stdio
use std::text
fn maybe_value(flag: bool) -> Option<i32> {
    if flag {
        Some(7)
    } else {
        None
    }
}

fn main() {
    match maybe_value(true) {
        Some(n) => {
            stdio::println(String_from("some=").concat(n.to_string()))
        },
        None => {
            stdio::println(String_from("none"))
        },
    }
    let ok: Result<i32, String> = Ok(9)
    match ok {
        Ok(n) => {
            stdio::println(String_from("ok=").concat(n.to_string()))
        },
        Err(err) => {
            stdio::eprintln(err)
        },
    }
}
