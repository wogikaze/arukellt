use std::host::stdio
use std::host::env
use std::prelude::{to_string, values}
use std::text
fn main() {
    let values = env::args()
    let n = len(values)
    stdio::println(String_from("count=").concat(to_string(n)))
    let mut i = 0
    while i < n {
        stdio::println(String_from("arg=").concat(get_unchecked(values, i)))
        i = i + 1
    }
}
