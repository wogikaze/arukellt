use std::host::stdio
use std::host::env::Env
use std::text

fn main() {
    let values = Env::args()
    let n = len(values)
    stdio::println(String_from("count=").concat(n.to_string()))
    let mut i = 0
    while i < n {
        stdio::println(String_from("arg=").concat(get_unchecked(values, i)))
        i = i + 1
    }
}
