use std::host::fs::Fs
use std::host::process::Process
use std::host::stdio
fn main() {
    let mut path = String_from("native_cpp_public_fs_roundtrip.txt")
    match Fs::write_string(path.clone(), String_from("fs-ok")) {
        Result::Ok(_) => {
        },
        Result::Err(err) => {
            stdio::eprintln(err)
            Process::exit(2)
        },
    }
    match Fs::read_to_string(path) {
        Result::Ok(text) => {
            stdio::println(text)
        },
        Result::Err(err) => {
            stdio::eprintln(err)
            Process::exit(3)
        },
    }
}
