use std::host::stdio
use std::text
struct Point {
    x: i32,
    y: i32,
}

fn main() {
    let text = String_from("ab").concat(String_from("c"))
    let mut numbers = Vec::new<i32>()
    push(numbers, 1)
    push(numbers, 2)
    let point = Point { x: 3, y: 4 }
    stdio::println(
        text.concat(String_from("|").concat(len(numbers).to_string().concat(String_from("|").concat(point.x.to_string().concat(String_from(",").concat(point.y.to_string()))))))
    )
}
