// Phase1 B: one push into field, store into new Holder, then get.
use std::host::stdio::Stdio

struct Holder {
    name: String,
    items: Vec<String>,
}

fn main() {
    let mut h = Holder { name: String_from("test"), items: Vec::new<String>() }
    h = Holder { name: h.name, items: h.items.push(String_from("alpha")) }
    Stdio::println(h.name)
    Stdio::println(h.items.get_unchecked(0))
}
