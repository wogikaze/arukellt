// A zero-field struct is a first-class GC value. Construction, return, a
// by-value parameter, and an inherent method must all keep the named
// `(ref null $EmptyHandle)` type instead of a byte-size struct shell.
use std::host::stdio

struct EmptyHandle {}

impl EmptyHandle {
    fn make() -> EmptyHandle {
        EmptyHandle {}
    }

    fn tag(self: EmptyHandle) -> i32 {
        7
    }
}

fn tag_of(handle: EmptyHandle) -> i32 {
    handle.tag()
}

fn main() {
    let handle: EmptyHandle = EmptyHandle::make()
    stdio::println((tag_of(handle)).to_string())
}
