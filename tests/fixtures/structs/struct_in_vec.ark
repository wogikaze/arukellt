use std::host::stdio
use std::text
struct Point {
    x: i32,
    y: i32,
}

fn main() {
    let mut points: Vec<Point> = Vec::new<Point>()
    push(points, Point { x: 1, y: 2 })
    push(points, Point { x: 3, y: 4 })
    let mut i: i32 = 0
    while i < len(points) {
        let p: Point = get_unchecked(points, i)
        stdio::println((p.x).to_string().concat(String_from(",")).concat((p.y).to_string()))
        i = i + 1
    }
}
