// Phase1 D: alias Vec field, get via alias; Holder not used after alias.
use std::host::stdio::Stdio

struct Holder {
    name: String,
    items: Vec<String>,
}

fn main() {
    let mut h = Holder { name: String_from("test"), items: Vec::new<String>() }
    h = Holder { name: h.name, items: h.items.push(String_from("alpha")) }
    let local_ref = h.items
    Stdio::println(get_unchecked(local_ref, 0))
}
