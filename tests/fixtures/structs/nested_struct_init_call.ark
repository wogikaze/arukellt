// Regression test: struct init with function call as field value
// The function call returns a struct, which previously corrupted the outer
// struct init's scratch memory area.
use std::host::stdio::Stdio

struct Inner {
    name: String,
    items: Vec<i32>,
    count: i32,
}

struct Outer {
    inner: Inner,
    label: String,
}

fn make_inner(n: String) -> Inner {
    Inner { name: n, items: Vec::new<i32>(), count: 0 }
}

fn main() {
    let mut o = Outer { inner: make_inner(String_from("test")), label: String_from("outer") }
    Stdio::println(o.inner.name)
    Stdio::println(o.label)
    Stdio::println((o.inner.count).to_string())
    Stdio::println((o.inner.items.len()).to_string())
    o.inner.items.push(42)
    Stdio::println((o.inner.items.len()).to_string())
    Stdio::println((o.inner.items.get_unchecked(0)).to_string())
}
// Inline function call in struct init field — this triggered the bug
// Also test push after nested init
