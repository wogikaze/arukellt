// Phase1 E: named enum Vec field with push/get/match.
use std::host::stdio::Stdio

enum Cell {
    Num(i32),
    Text(String),
}

struct Holder {
    items: Vec<Cell>,
}

fn main() {
    let mut h = Holder { items: Vec::new<Cell>() }
    h = Holder { items: h.items.push(Cell::Num(7)) }
    h = Holder { items: h.items.push(Cell::Text(String_from("ok"))) }
    let a = h.items.get_unchecked(0)
    let b = h.items.get_unchecked(1)
    match a {
        Cell::Num(n) => { Stdio::println(n.to_string()) }
        Cell::Text(s) => { Stdio::println(s) }
    }
    match b {
        Cell::Num(n) => { Stdio::println(n.to_string()) }
        Cell::Text(s) => { Stdio::println(s) }
    }
}
