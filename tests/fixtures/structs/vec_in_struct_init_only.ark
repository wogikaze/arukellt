// Phase1 A: Struct init + field read, no push / no reconstruction.
use std::host::stdio::Stdio

struct Holder {
    name: String,
    items: Vec<String>,
}

fn main() {
    let h = Holder { name: String_from("test"), items: Vec::new<String>() }
    Stdio::println(h.name)
    Stdio::println((h.items.len()).to_string())
}
