use std::io
use std::test::Test

fn main() {
    let mut w: io::Writer = io::Writer::new()
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 65)
    push(data, 66)
    push(data, 67)

    match w.write(data) {
        Result::Ok(n) => Test::assert_eq_i32(n, 3),
        Result::Err(_e) => Std::panic("expected Ok"),
    }

    let out: Vec<i32> = w.into_bytes()
    Test::assert_eq_i32(out.len(), 3)
    Test::assert_eq_i32(out.get_unchecked(0), 65)
    Test::assert_eq_i32(out.get_unchecked(1), 66)
    Test::assert_eq_i32(out.get_unchecked(2), 67)
}
