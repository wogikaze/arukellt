use std::test::Test
use std::collections::vec
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(-3)
    v.push(5)
    v.push(-1)
    v.push(0)
    v.push(-5)

    v.sort()
    let s = v
    Test::assert_eq_i32(s.len(), 5)
    Test::assert_eq_i32(s.get_unchecked(0), -5)
    Test::assert_eq_i32(s.get_unchecked(1), -3)
    Test::assert_eq_i32(s.get_unchecked(2), -1)
    Test::assert_eq_i32(s.get_unchecked(3), 0)
    Test::assert_eq_i32(s.get_unchecked(4), 5)
}
