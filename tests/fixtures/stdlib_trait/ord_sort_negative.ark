use std::test::Test
use std::collections::vec
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, -3)
    push(v, 5)
    push(v, -1)
    push(v, 0)
    push(v, -5)

    v.sort()
    let s = v
    Test::assert_eq_i32(s.len(), 5)
    Test::assert_eq_i32(get_unchecked(s, 0), -5)
    Test::assert_eq_i32(get_unchecked(s, 1), -3)
    Test::assert_eq_i32(get_unchecked(s, 2), -1)
    Test::assert_eq_i32(get_unchecked(s, 3), 0)
    Test::assert_eq_i32(get_unchecked(s, 4), 5)
}
