use std::core::iter
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)

    let taken = v.iter().take(10).collect()
    Test::assert_eq_i32(taken.len(), 2)
    Test::assert_eq_i32(taken.get_unchecked(0), 1)
    Test::assert_eq_i32(taken.get_unchecked(1), 2)
}
