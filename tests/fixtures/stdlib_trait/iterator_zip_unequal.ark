use std::core::iter
use std::test::Test

fn main() {
    let mut a: Vec<i32> = Vec::new<i32>()
    push(a, 1)
    push(a, 2)
    push(a, 3)
    let mut b: Vec<i32> = Vec::new<i32>()
    push(b, 10)

    let mut it = a.iter().zip(b.iter())
    match it.next() {
        Some(p) => {
            Test::assert_eq_i32(p.first, 1)
            Test::assert_eq_i32(p.second, 10)
        },
        None => Std::panic("expected Some"),
    }
    match it.next() {
        Some(_) => Std::panic("expected None — zip stops at shorter"),
        None => {}
    }
}
