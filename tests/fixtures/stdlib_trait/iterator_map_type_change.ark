//! Method-level generics (#887): `VecIter<T>::map<U>` and
//! `FilterIter<T>::map<U>` accept `fn(T) -> U` callbacks, so a lazy
//! pipeline can change the item type on both backends.

use std::core::iter
use std::test::Test
use std::host::stdio::Stdio
use std::text
fn itos(value: i32) -> String {
    "n".concat(value.to_string())
}

fn slen(value: String) -> i32 {
    value.len()
}

fn non_empty(value: String) -> bool {
    value.len() > 0
}

fn same(value: String) -> String {
    value.clone()
}

fn main() {
    // i32 -> String
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(7)
    v.push(42)
    let strings = v.iter().map(itos).collect()
    Test::assert_eq_i32(strings.len(), 2)
    Test::assert_eq_string(strings.get_unchecked(0), "n7")
    Test::assert_eq_string(strings.get_unchecked(1), "n42")

    // String -> i32
    let mut w: Vec<String> = Vec::new<String>()
    w.push(String_from("ab"))
    w.push(String_from("cdef"))
    let lengths = w.iter().map(slen).collect()
    Test::assert_eq_i32(lengths.len(), 2)
    Test::assert_eq_i32(lengths.get_unchecked(0), 2)
    Test::assert_eq_i32(lengths.get_unchecked(1), 4)

    // filter-then-map also carries a method-level item type parameter.
    let filtered = w.iter().filter(non_empty).map(slen).collect()
    Test::assert_eq_i32(filtered.len(), 2)
    Test::assert_eq_i32(filtered.get_unchecked(1), 4)

    // T -> T still works through the renamed FilterMapIter<T, U> impl,
    // including the Vec<String> from_iter path.
    let copied: Vec<String> = Vec::from_iter(w.iter().filter(non_empty).map(same))
    Test::assert_eq_i32(copied.len(), 2)
    Test::assert_eq_string(copied.get_unchecked(1), "cdef")

    Stdio::println(strings.get_unchecked(0))
    Stdio::println(strings.get_unchecked(1))
    Stdio::println(lengths.get_unchecked(0).to_string())
    Stdio::println(lengths.get_unchecked(1).to_string())
    Stdio::println(filtered.get_unchecked(1).to_string())
    Stdio::println(copied.get_unchecked(1))
}
