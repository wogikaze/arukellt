// Issue #693 Phase E/F: Reader / Writer newtypes and Io algorithms are the
// canonical memory-stream surface; the legacy Vec<i32> free functions are gone.
//
// Verifies Writer::into_reader hands the written image to a cursor-0 Reader.
use std::host::stdio::Stdio
use std::io

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push(88)
    data.push(89)
    data.push(90)
    let mut writer: io::Writer = io::Writer::new()
    match writer.write(data) {
        Result::Ok(n) => assert(n == 3),
        Result::Err(_e) => assert(false),
    }
    let mut reader: io::Reader = writer.into_reader()
    assert(reader.len() == 3)
    match reader.position() {
        Result::Ok(pos) => assert(pos == 0i64),
        Result::Err(_e) => assert(false),
    }
    match reader.read(2) {
        Result::Ok(chunk) => {
            assert(chunk.len() == 2)
            assert(chunk.get_unchecked(0) == 88)
            assert(chunk.get_unchecked(1) == 89)
        },
        Result::Err(_e) => assert(false),
    }
    Stdio::println("OK")
}
