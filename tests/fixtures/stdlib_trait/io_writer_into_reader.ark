// Issue #693 Phase E/F: Reader / Writer newtypes and Io algorithms are the
// canonical memory-stream surface; the legacy Vec<i32> free functions are gone.
//
// Verifies Writer::into_reader hands the written image to a cursor-0 Reader.
use std::host::stdio
use std::io

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    push(data, 88)
    push(data, 89)
    push(data, 90)
    let writer: io::Writer = io::Writer::new()
    match writer.write(data) {
        Result::Ok(n) => assert(n == 3),
        Result::Err(_e) => assert(false),
    }
    let reader: io::Reader = writer.into_reader()
    assert(reader.len() == 3)
    match reader.position() {
        Result::Ok(pos) => assert(pos == 0i64),
        Result::Err(_e) => assert(false),
    }
    match reader.read(2) {
        Result::Ok(chunk) => {
            assert(len(chunk) == 2)
            assert(get_unchecked(chunk, 0) == 88)
            assert(get_unchecked(chunk, 1) == 89)
        },
        Result::Err(_e) => assert(false),
    }
    stdio::println("OK")
}
