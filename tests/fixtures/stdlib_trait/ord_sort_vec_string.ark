// Generic Ord-based sort on non-i32 collections (#695):
// Vec<String> lexicographic order via seq::sort_by, and descending
// order via the cmp::Reverse<T> wrapper's Ord impl. Uses the v2 method
// surface for Vec mutation and element access.
use std::core::cmp
use std::seq
use std::test::Test

fn main() {
    let mut v: Vec<String> = Vec::new<String>()
    v.push(String_from("banana"))
    v.push(String_from("apple"))
    v.push(String_from("cherry"))
    let s = seq::sort_by(v)
    Test::assert_true(s.get_unchecked(0).eq(String_from("apple")))
    Test::assert_true(s.get_unchecked(1).eq(String_from("banana")))
    Test::assert_true(s.get_unchecked(2).eq(String_from("cherry")))

    let mut r: Vec<cmp::Reverse<i32>> = Vec::new<cmp::Reverse<i32>>()
    r.push(cmp::Reverse { inner: 1 })
    r.push(cmp::Reverse { inner: 3 })
    r.push(cmp::Reverse { inner: 2 })
    let sr = seq::sort_by(r)
    Test::assert_eq_i32(sr.get_unchecked(0).inner, 3)
    Test::assert_eq_i32(sr.get_unchecked(1).inner, 2)
    Test::assert_eq_i32(sr.get_unchecked(2).inner, 1)
}
