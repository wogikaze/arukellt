use std::core::iter
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)

    let skipped = v.iter().skip(2).collect()
    Test::assert_eq_i32(skipped.len(), 3)
    Test::assert_eq_i32(skipped.get_unchecked(0), 3)
    Test::assert_eq_i32(skipped.get_unchecked(1), 4)
    Test::assert_eq_i32(skipped.get_unchecked(2), 5)
}
