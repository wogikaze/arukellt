use std::io
use std::test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 65)
    let mut w: io::Writer = io::Writer::new()
    match w.write(data) {
        Result::Ok(written) => test::assert_eq_i32(written, 1),
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }

    let mut r: io::Reader = w.into_reader()
    test::assert_eq_i32(r.len(), 1)

    match r.read(1) {
        Result::Ok(read) => {
            test::assert_eq_i32(len(read), 1)
            test::assert_eq_i32(get_unchecked(read, 0), 65)
        },
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
}
