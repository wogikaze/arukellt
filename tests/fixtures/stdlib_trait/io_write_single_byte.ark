use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push(65)
    let mut w: io::Writer = io::Writer::new()
    match w.write(data) {
        Result::Ok(written) => Test::assert_eq_i32(written, 1),
        Result::Err(e) => Std::panic(e.message()),
    }

    let mut r: io::Reader = w.into_reader()
    Test::assert_eq_i32(r.len(), 1)

    match r.read(1) {
        Result::Ok(read) => {
            Test::assert_eq_i32(read.len(), 1)
            Test::assert_eq_i32(read.get_unchecked(0), 65)
        },
        Result::Err(e) => Std::panic(e.message()),
    }
}
