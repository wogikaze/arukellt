use std::core::iter
use std::test

fn first<T: iter::Iterator>(iterator: T) -> Option<T::Item> {
    iterator.next()
}

fn collect_values<T: iter::Iterator>(iterator: T) -> Vec<i32> {
    iterator.collect()
}

fn count_values<T: iter::Iterator>(iterator: T) -> i32 {
    iterator.count()
}

fn sum_values<T: iter::Iterator>(iterator: T) -> i32 {
    iterator.sum()
}

fn main() {
    let v: Vec<i32> = Vec::new<i32>()
    push(v, 100)
    push(v, 200)

    let first_it = iter::vec_iter(v)
    match first(first_it) {
        Some(x) => test::assert_eq_i32(x, 100),
        None => panic("expected Some(100)"),
    }
    let it = iter::vec_iter(v)
    match it.next() {
        Some(x) => test::assert_eq_i32(x, 100),
        None => panic("expected Some(100)"),
    }
    let it2 = iter::vec_iter(v)
    match it2.next() {
        Some(x) => test::assert_eq_i32(x, 100),
        None => panic("expected Some(100)"),
    }
    match it2.next() {
        Some(x) => test::assert_eq_i32(x, 200),
        None => panic("expected Some(200)"),
    }
    match it2.next() {
        Some(_) => panic("expected None"),
        None => {}
    }

    let collected_source: Vec<i32> = Vec::new<i32>()
    push(collected_source, 300)
    push(collected_source, 400)
    let collected = Vec::from_iter(iter::vec_iter(collected_source))
    test::assert_eq_i32(len(collected), 2)
    test::assert_eq_i32(get_unchecked(collected, 1), 400)

    let canonical_source: Vec<i32> = Vec::new<i32>()
    push(canonical_source, 600)
    push(canonical_source, 700)
    let canonical = collect_values(iter::vec_iter(canonical_source))
    test::assert_eq_i32(len(canonical), 2)
    test::assert_eq_i32(get_unchecked(canonical, 1), 700)

    let count_source: Vec<i32> = Vec::new<i32>()
    push(count_source, 8)
    push(count_source, 9)
    push(count_source, 10)
    test::assert_eq_i32(count_values(iter::vec_iter(count_source)), 3)
    test::assert_eq_i32(sum_values(iter::vec_iter(count_source)), 27)

    let into_source: Vec<i32> = Vec::new<i32>()
    push(into_source, 500)
    let into_iter = iter::vec_iter(into_source).into_iter()
    match into_iter.next() {
        Some(x) => test::assert_eq_i32(x, 500),
        None => panic("expected Some(500)"),
    }

    let vector_into_source: Vec<i32> = Vec::new<i32>()
    push(vector_into_source, 800)
    let vector_into_iter = vector_into_source.into_iter()
    match vector_into_iter.next() {
        Some(x) => test::assert_eq_i32(x, 800),
        None => panic("expected Some(800)"),
    }
}
