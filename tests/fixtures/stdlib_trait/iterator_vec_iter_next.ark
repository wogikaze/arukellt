use std::core::iter
use std::test::Test

fn first<T: iter::Iterator>(mut iterator: T) -> Option<T::Item> {
    iterator.next()
}

fn collect_values<T: iter::Iterator>(mut iterator: T) -> Vec<T::Item> {
    iterator.collect()
}

fn count_values<T: iter::Iterator>(mut iterator: T) -> i32 {
    iterator.count()
}

fn sum_values<T: iter::Iterator + iter::IteratorSum<i32, i32>>(mut iterator: T) -> i32 {
    iterator.sum()
}

fn fold_values<T: iter::Iterator + iter::IteratorFold<i32, i32>>(mut iterator: T, init: i32, f: fn(i32, i32) -> i32) -> i32 {
    iterator.fold(init, f)
}

fn add_i32(a: i32, b: i32) -> i32 {
    a + b
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 100)
    push(v, 200)

    let mut first_it = v.iter()
    match first(first_it) {
        Some(x) => Test::assert_eq_i32(x, 100),
        None => Std::panic("expected Some(100)"),
    }
    let mut it = v.iter()
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 100),
        None => Std::panic("expected Some(100)"),
    }
    let mut it2 = v.iter()
    match it2.next() {
        Some(x) => Test::assert_eq_i32(x, 100),
        None => Std::panic("expected Some(100)"),
    }
    match it2.next() {
        Some(x) => Test::assert_eq_i32(x, 200),
        None => Std::panic("expected Some(200)"),
    }
    match it2.next() {
        Some(_) => Std::panic("expected None"),
        None => {}
    }

    let mut collected_source: Vec<i32> = Vec::new<i32>()
    push(collected_source, 300)
    push(collected_source, 400)
    let collected = Vec::from_iter(collected_source.iter())
    Test::assert_eq_i32(collected.len(), 2)
    Test::assert_eq_i32(collected.get_unchecked(1), 400)

    let mut canonical_source: Vec<i32> = Vec::new<i32>()
    push(canonical_source, 600)
    push(canonical_source, 700)
    let canonical = collect_values(canonical_source.iter())
    Test::assert_eq_i32(canonical.len(), 2)
    Test::assert_eq_i32(canonical.get_unchecked(1), 700)

    let mut count_source: Vec<i32> = Vec::new<i32>()
    push(count_source, 8)
    push(count_source, 9)
    push(count_source, 10)
    Test::assert_eq_i32(count_values(count_source.iter()), 3)
    Test::assert_eq_i32(sum_values(count_source.iter()), 27)
    Test::assert_eq_i32(fold_values(count_source.iter(), 1, add_i32), 28)

    let mut direct_sum_source: Vec<i32> = Vec::new<i32>()
    push(direct_sum_source, 4)
    push(direct_sum_source, 7)
    Test::assert_eq_i32(direct_sum_source.iter().sum(), 11)

    let mut into_source: Vec<i32> = Vec::new<i32>()
    push(into_source, 500)
    let mut into_iter = into_source.iter().into_iter()
    match into_iter.next() {
        Some(x) => Test::assert_eq_i32(x, 500),
        None => Std::panic("expected Some(500)"),
    }

    let mut vector_into_source: Vec<i32> = Vec::new<i32>()
    push(vector_into_source, 800)
    let mut vector_into_iter = vector_into_source.into_iter()
    match vector_into_iter.next() {
        Some(x) => Test::assert_eq_i32(x, 800),
        None => Std::panic("expected Some(800)"),
    }
}
