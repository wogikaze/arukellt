use std::io
use std::io::SeekFrom
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 65)
    push(data, 66)
    push(data, 67)
    let mut r: io::Reader = io::Reader::from_bytes(data)

    match r.read(2) {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(e.message()),
    }
    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 2),
        Result::Err(e) => Std::panic(e.message()),
    }

    match r.seek(SeekFrom::Start(0i64)) {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 0),
        Result::Err(e) => Std::panic(e.message()),
    }

    match r.read(1) {
        Result::Ok(one) => Test::assert_eq_i32(get_unchecked(one, 0), 65),
        Result::Err(e) => Std::panic(e.message()),
    }
}
