use std::text::fmt
use std::test::Test

fn main() {
    Test::assert_eq_string(true.fmt_debug(), "true")
    Test::assert_eq_string(false.fmt_debug(), "false")
    Test::assert_eq_string("b=".concat(true.fmt_debug()), "b=true")
    Test::assert_eq_string("b=".concat(false.fmt_debug()), "b=false")
}
