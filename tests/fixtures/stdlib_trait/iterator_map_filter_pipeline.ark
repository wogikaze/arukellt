use std::core::iter
use std::test::Test

fn double(x: i32) -> i32 { x * 2 }
fn is_even(x: i32) -> bool { x / 2 * 2 == x }

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)

    // map(double) then filter(is_even): [2,4,6,8,10]
    let result = v.iter().map(double).filter(is_even).collect()
    Test::assert_eq_i32(result.len(), 5)
    Test::assert_eq_i32(result.get_unchecked(0), 2)
    Test::assert_eq_i32(result.get_unchecked(1), 4)
    Test::assert_eq_i32(result.get_unchecked(4), 10)
}
