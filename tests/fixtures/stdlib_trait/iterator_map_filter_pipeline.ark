use std::core::iter
use std::test

fn double(x: i32) -> i32 { x * 2 }
fn is_even(x: i32) -> bool { x / 2 * 2 == x }

fn main() {
    let v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5)

    // map(double) then filter(is_even): [2,4,6,8,10]
    let result = iter::collect_map_filter_i32(v, double, is_even)
    test::assert_eq_i32(len(result), 5)
    test::assert_eq_i32(get_unchecked(result, 0), 2)
    test::assert_eq_i32(get_unchecked(result, 1), 4)
    test::assert_eq_i32(get_unchecked(result, 4), 10)
}
