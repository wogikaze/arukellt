use std::core::iter
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)

    let mut it = v.iter().peekable()

    // Repeated peeks return the same cached item without consuming it.
    match it.peek() {
        Some(x) => Test::assert_eq_i32(x, 1),
        None => Std::panic("expected Some"),
    }
    match it.peek() {
        Some(x) => Test::assert_eq_i32(x, 1),
        None => Std::panic("expected Some"),
    }

    // next drains the cached item first.
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 1),
        None => Std::panic("expected Some"),
    }
    match it.peek() {
        Some(x) => Test::assert_eq_i32(x, 2),
        None => Std::panic("expected Some"),
    }
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 2),
        None => Std::panic("expected Some"),
    }

    // Uncached items flow through next directly.
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 3),
        None => Std::panic("expected Some"),
    }
    match it.peek() {
        Some(_) => Std::panic("expected None"),
        None => {}
    }
    match it.next() {
        Some(_) => Std::panic("expected None"),
        None => {}
    }

    // Drained collect preserves order over a fresh peekable.
    let mut w: Vec<i32> = Vec::new<i32>()
    w.push(7)
    w.push(8)
    let drained = w.iter().peekable().collect()
    Test::assert_eq_i32(drained.len(), 2)
    Test::assert_eq_i32(drained.get_unchecked(0), 7)
    Test::assert_eq_i32(drained.get_unchecked(1), 8)
}
