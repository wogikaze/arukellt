use std::io
use std::io::SeekFrom
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 1)
    push(data, 2)
    push(data, 3)
    let mut r: io::Reader = io::Reader::from_bytes(data)

    Test::assert_eq_i32(r.len(), 3)
    match r.seek(SeekFrom::Start(3i64)) {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 3),
        Result::Err(e) => Std::panic(e.message()),
    }

    match r.read(1) {
        Result::Ok(one) => Test::assert_eq_i32(len(one), 0),
        Result::Err(e) => Std::panic(e.message()),
    }
}
