use std::test::Test
use std::collections::vec
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 3)
    push(v, 1)
    push(v, 3)
    push(v, 1)
    push(v, 2)

    v.sort()
    let s = v
    Test::assert_eq_i32(len(s), 5)
    Test::assert_eq_i32(get_unchecked(s, 0), 1)
    Test::assert_eq_i32(get_unchecked(s, 1), 1)
    Test::assert_eq_i32(get_unchecked(s, 2), 2)
    Test::assert_eq_i32(get_unchecked(s, 3), 3)
    Test::assert_eq_i32(get_unchecked(s, 4), 3)
}
