use std::test::Test
use std::collections::vec
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 5)
    push(v, 4)
    push(v, 3)
    push(v, 2)
    push(v, 1)

    v.sort()
    let s = v
    Test::assert_eq_i32(s.len(), 5)
    Test::assert_eq_i32(s.get_unchecked(0), 1)
    Test::assert_eq_i32(s.get_unchecked(1), 2)
    Test::assert_eq_i32(s.get_unchecked(2), 3)
    Test::assert_eq_i32(s.get_unchecked(3), 4)
    Test::assert_eq_i32(s.get_unchecked(4), 5)
}
