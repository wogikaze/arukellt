use std::core::iter
use std::test
use std::text
fn concat_str(a: String, b: String) -> Option<String> {
    Some(a.concat(b))
}

fn main() {
    let mut v: Vec<String> = Vec::new<String>()
    push(v, String_from("a"))
    push(v, String_from("b"))
    let it = v.iter()
    let mut scanned = it.scan(String_from(""), concat_str)
    let out = scanned.collect()
    test::assert_eq_i32(len(out), 2)
    test::assert_eq_string(get_unchecked(out, 0), "a")
    test::assert_eq_string(get_unchecked(out, 1), "ab")
}
