use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push(1)
    data.push(2)
    data.push(3)
    data.push(4)
    let mut reader: io::Reader = io::Reader::from_bytes(data)

    match io::Io::read_to_end(reader) {
        Result::Ok(bytes) => {
            Test::assert_eq_i32(bytes.len(), 4)
            Test::assert_eq_i32(bytes.get_unchecked(0), 1)
            Test::assert_eq_i32(bytes.get_unchecked(3), 4)
        },
        Result::Err(_e) => Std::panic("expected Ok"),
    }
}
