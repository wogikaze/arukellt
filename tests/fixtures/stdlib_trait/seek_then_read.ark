use std::io
use std::io::SeekFrom
use std::test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 10)
    push(data, 20)
    push(data, 30)
    push(data, 40)
    push(data, 50)
    let mut r: io::Reader = io::Reader::from_bytes(data)

    match r.seek(SeekFrom::Start(3i64)) {
        Result::Ok(pos) => test::assert_eq_i64(pos, 3),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    match r.read(1) {
        Result::Ok(one) => {
            test::assert_eq_i32(len(one), 1)
            test::assert_eq_i32(get_unchecked(one, 0), 40)
        },
        Result::Err(e) => panic(io::io_error_message(e)),
    }

    match r.seek(SeekFrom::Start(1i64)) {
        Result::Ok(pos) => test::assert_eq_i64(pos, 1),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    match r.read(1) {
        Result::Ok(one) => test::assert_eq_i32(get_unchecked(one, 0), 20),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
