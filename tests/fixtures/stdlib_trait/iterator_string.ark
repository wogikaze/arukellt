use std::core::iter
use std::test::Test

fn first<T: iter::Iterator>(mut iterator: T) -> Option<T::Item> {
    iterator.next()
}

fn first_from_source<T: iter::IntoIterator>(source: T) -> Option<T::Item> {
    source.into_iter().next()
}

fn collect_values<T: iter::Iterator>(mut iterator: T) -> Vec<T::Item> {
    iterator.collect()
}

fn count_values<T: iter::Iterator>(mut iterator: T) -> i32 {
    iterator.count()
}

fn main() {
    let mut source: Vec<String> = Vec::new<String>()
    source.push(String_from("alpha"))
    let mut iterator = source.into_iter()
    match iterator.next() {
        Some(value) => Test::assert_eq_string(value, "alpha"),
        None => Std::panic("expected first string"),
    }

    let mut generic_source: Vec<String> = Vec::new<String>()
    generic_source.push(String_from("beta"))
    match first(generic_source.into_iter()) {
        Some(value) => Test::assert_eq_string(value, "beta"),
        None => Std::panic("expected generic first string"),
    }

    let mut converted_source: Vec<String> = Vec::new<String>()
    converted_source.push(String_from("theta"))
    match first_from_source(converted_source) {
        Some(value) => Test::assert_eq_string(value, "theta"),
        None => Std::panic("expected converted first string"),
    }

    let mut collect_source: Vec<String> = Vec::new<String>()
    collect_source.push(String_from("gamma"))
    let collected = collect_values(collect_source.into_iter())
    Test::assert_eq_i32(collected.len(), 1)
    Test::assert_eq_string(get_unchecked(collected, 0), "gamma")

    let mut count_source: Vec<String> = Vec::new<String>()
    count_source.push(String_from("delta"))
    count_source.push(String_from("epsilon"))
    Test::assert_eq_i32(count_values(count_source.into_iter()), 2)

    let mut from_source: Vec<String> = Vec::new<String>()
    from_source.push(String_from("zeta"))
    let rebuilt: Vec<String> = Vec::from_iter(from_source.into_iter())
    Test::assert_eq_string(get_unchecked(rebuilt, 0), "zeta")

    let mut method_source: Vec<String> = Vec::new<String>()
    method_source.push(String_from("eta"))
    let method_collected = method_source.iter().collect()
    Test::assert_eq_string(get_unchecked(method_collected, 0), "eta")

    let mut take_source: Vec<String> = Vec::new<String>()
    take_source.push(String_from("kappa"))
    take_source.push(String_from("lambda"))
    let take_collected = take_source.iter().take(1).collect()
    Test::assert_eq_i32(take_collected.len(), 1)
    Test::assert_eq_string(get_unchecked(take_collected, 0), "kappa")

    let mut skip_take_source: Vec<String> = Vec::new<String>()
    skip_take_source.push(String_from("mu"))
    skip_take_source.push(String_from("nu"))
    skip_take_source.push(String_from("xi"))
    let skip_take_collected = skip_take_source.iter().skip(1).take(1).collect()
    Test::assert_eq_i32(skip_take_collected.len(), 1)
    Test::assert_eq_string(get_unchecked(skip_take_collected, 0), "nu")

    let mut for_source: Vec<String> = Vec::new<String>()
    for_source.push(String_from("iota"))
    let mut seen = 0
    for value in for_source {
        Test::assert_eq_string(value, "iota")
        seen = seen + 1
    }
    Test::assert_eq_i32(seen, 1)
}
