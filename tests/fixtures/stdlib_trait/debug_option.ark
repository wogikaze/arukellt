use std::text::fmt
use std::test::Test

fn main() {
    Test::assert_eq_string(fmt::DebugFormat::option_i32(Some(42)), "Some(42)")
    Test::assert_eq_string(fmt::DebugFormat::option_i32(None), "None")
    Test::assert_eq_string(fmt::DebugFormat::option_string(Some(String_from("hi"))), "Some(\"hi\")")
    Test::assert_eq_string(fmt::DebugFormat::option_string(None), "None")
}
