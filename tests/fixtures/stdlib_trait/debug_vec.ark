// Issue #696: Debug rendering for Vec<T> container types.
//
// Container types cannot yet receive generic `impl Debug for Vec<T>` blocks,
// so monomorphic helpers in std::text::fmt provide Rust {:?} parity:
//   Vec<i32>   -> [1, 2, 3]
//   Vec<String>-> ["a", "b"]
use std::host::stdio::Stdio
use std::text::fmt
use std::text
fn main() {
    // Empty Vec<i32> -> "[]"
    let empty: Vec<i32> = Vec::new<i32>()
    assert(fmt::DebugFormat::vec_i32(empty).eq(String_from("[]")))

    // Vec<i32> -> "[1, 2, 3]"
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    assert(fmt::DebugFormat::vec_i32(v).eq(String_from("[1, 2, 3]")))

    // Vec<i64> -> "[10, 20]"
    let mut vl: Vec<i64> = Vec::new<i64>()
    push(vl, 10i64)
    push(vl, 20i64)
    assert(fmt::DebugFormat::vec_i64(vl).eq(String_from("[10, 20]")))

    // Vec<f64> -> "[1.5, 2.5]" (compare against same intrinsic formatting)
    let mut vf: Vec<f64> = Vec::new<f64>()
    push(vf, 1.5)
    push(vf, 2.5)
    let expected_f = "[".concat((1.5).to_string().concat(", ".concat((2.5).to_string().concat("]"))))
    assert(fmt::DebugFormat::vec_f64(vf).eq(expected_f))

    // Vec<String> -> ["a", "b"] (elements quoted via Debug for String)
    let mut vs: Vec<String> = Vec::new<String>()
    push(vs, String_from("a"))
    push(vs, String_from("b"))
    assert(fmt::DebugFormat::vec_string(vs).eq(String_from("[\"a\", \"b\"]")))

    // Single element Vec<i32> -> "[42]"
    let mut one: Vec<i32> = Vec::new<i32>()
    push(one, 42)
    assert(fmt::DebugFormat::vec_i32(one).eq(String_from("[42]")))

    Stdio::println(String_from("OK"))
}
