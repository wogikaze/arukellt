// `Vec<T>::clone` deep-copies element storage when `T: Clone`. Mutating the
// clone's array slot or an element's String must leave the source untouched.
use std::core::clone
use std::test::Test

struct Point {
    label: String,
    x: i32,
}

impl Clone for Point {
    fn clone(self: Point) -> Point {
        Point {
            label: self.label.clone(),
            x: self.x,
        }
    }
}

fn main() {
    let mut strings: Vec<String> = Vec::new<String>()
    strings.push(String_from("alpha"))
    strings.push(String_from("beta"))
    let mut strings_copy = strings.clone()
    strings_copy.set(0, String_from("changed"))
    Test::assert_eq_i32(strings.len(), 2)
    Test::assert_eq_string(strings.get_unchecked(0), "alpha")
    Test::assert_eq_string(strings_copy.get_unchecked(0), "changed")

    let mut points: Vec<Point> = Vec::new<Point>()
    points.push(Point { label: String_from("p0"), x: 1 })
    let mut points_copy = points.clone()
    Test::assert_eq_string(points_copy.get_unchecked(0).label, "p0")
    points_copy.set(0, Point { label: String_from("p1"), x: 2 })
    Test::assert_eq_string(points.get_unchecked(0).label, "p0")
    Test::assert_eq_i32(points.get_unchecked(0).x, 1)
    Test::assert_eq_string(points_copy.get_unchecked(0).label, "p1")
    Test::assert_eq_i32(points_copy.get_unchecked(0).x, 2)

    let mut numbers: Vec<i32> = Vec::new<i32>()
    numbers.push(7)
    let mut numbers_copy = numbers.clone()
    numbers_copy.set(0, 9)
    Test::assert_eq_i32(numbers.get_unchecked(0), 7)
    Test::assert_eq_i32(numbers_copy.get_unchecked(0), 9)
}
