use std::core::iter
use std::test::Test

fn is_even(x: i32) -> bool { x / 2 * 2 == x }

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)
    v.push(6)

    let evens = v.iter().filter(is_even).collect()
    Test::assert_eq_i32(evens.len(), 3)
    Test::assert_eq_i32(get_unchecked(evens, 0), 2)
    Test::assert_eq_i32(get_unchecked(evens, 1), 4)
    Test::assert_eq_i32(get_unchecked(evens, 2), 6)
}
