// Issue #693 Phase E/F: Read / Write trait methods on the memory newtypes.
//
// - Write bytes into a Writer via Write dispatch
// - Read them back through Writer::into_reader + Read dispatch
use std::host::stdio::Stdio
use std::io

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 72)   // 'H'
    push(data, 101)  // 'e'
    push(data, 108)  // 'l'
    push(data, 108)  // 'l'
    push(data, 111)  // 'o'
    let mut w: io::Writer = io::Writer::new()
    match w.write(data) {
        Result::Ok(written) => assert(written == 5),
        Result::Err(_e) => assert(false),
    }

    let mut r: io::Reader = w.into_reader()
    assert(r.len() == 5)

    match r.read(5) {
        Result::Ok(read) => {
            assert(len(read) == 5)
            assert(get_unchecked(read, 0) == 72)   // 'H'
            assert(get_unchecked(read, 1) == 101)  // 'e'
            assert(get_unchecked(read, 2) == 108)  // 'l'
            assert(get_unchecked(read, 3) == 108)  // 'l'
            assert(get_unchecked(read, 4) == 111)  // 'o'
        },
        Result::Err(_e) => assert(false),
    }

    match r.position() {
        Result::Ok(pos) => assert(pos == 5i64),
        Result::Err(_e) => assert(false),
    }

    match r.read(5) {
        Result::Ok(read2) => assert(len(read2) == 0),
        Result::Err(_e) => assert(false),
    }

    Stdio::println("OK")
}
