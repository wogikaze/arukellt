use std::io
use std::test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    push(data, 1)
    push(data, 2)
    push(data, 3)
    push(data, 4)
    push(data, 5)
    let r: io::Reader = io::Reader::from_bytes(data)

    match r.fill_buf() {
        Result::Ok(filled) => {
            test::assert_eq_i32(len(filled), 5)
            test::assert_eq_i32(get_unchecked(filled, 0), 1)
            test::assert_eq_i32(get_unchecked(filled, 4), 5)
        },
        Result::Err(e) => panic(io::io_error_message(e)),
    }

    // fill_buf does not consume
    match r.position() {
        Result::Ok(pos) => test::assert_eq_i64(pos, 0),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
