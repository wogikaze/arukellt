use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push(1)
    data.push(2)
    data.push(3)
    data.push(4)
    data.push(5)
    let mut r: io::Reader = io::Reader::from_bytes(data)

    match r.fill_buf() {
        Result::Ok(filled) => {
            Test::assert_eq_i32(filled.len(), 5)
            Test::assert_eq_i32(get_unchecked(filled, 0), 1)
            Test::assert_eq_i32(get_unchecked(filled, 4), 5)
        },
        Result::Err(e) => Std::panic(e.message()),
    }

    // fill_buf does not consume
    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 0),
        Result::Err(e) => Std::panic(e.message()),
    }
}
