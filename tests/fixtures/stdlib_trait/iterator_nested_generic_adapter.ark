use std::core::iter
use std::host::stdio::Stdio

struct Inner<I> {
    iter: I,
}

impl<I> Iterator for Inner<I> {
    type Item = I::Item
    fn next(mut self: Inner<I>) -> Option<I::Item> {
        self.iter.next()
    }
}

// Field-access form: the forwarded receiver lives in a generic field.
struct Forward<I> {
    inner: Inner<I>,
}

impl<I> Iterator for Forward<I> {
    type Item = I::Item
    fn next(mut self: Forward<I>) -> Option<I::Item> {
        self.inner.next()
    }
}

// Local-binding form: the wrapped iterator is built inside next() from
// the enclosing impl's own type parameter.
struct Local<I> {
    iter: I,
}

impl<I> Iterator for Local<I> {
    type Item = I::Item
    fn next(self: Local<I>) -> Option<I::Item> {
        let mut inner: Inner<I> = Inner { iter: self.iter }
        inner.next()
    }
}

fn main() -> i32 {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(7)
    let mut w: Vec<i32> = Vec::new<i32>()
    w.push(9)
    let mut it: Forward<VecIter<i32>> = Forward { inner: Inner { iter: v.into_iter() } }
    match it.next() {
        Some(x) => Stdio::println(x.to_string()),
        None => Stdio::println("none"),
    }
    let it2: Local<VecIter<i32>> = Local { iter: w.into_iter() }
    match it2.next() {
        Some(x) => Stdio::println(x.to_string()),
        None => Stdio::println("none"),
    }
    0
}
