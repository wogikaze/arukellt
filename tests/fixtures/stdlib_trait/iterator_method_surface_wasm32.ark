// Same lazy iterator method surface as iterator_method_surface.ark on the
// linear wasm32 target; the .flags sidecar selects the target.
use std::core::{Range, RangeInclusive}
use std::core::iter
use std::test::Test

fn is_pos(x: i32) -> bool { x > 0 }
fn is_even(x: i32) -> bool { x / 2 * 2 == x }
fn double(x: i32) -> i32 { x * 2 }
fn add(a: i32, b: i32) -> i32 { a + b }
fn running_sum(acc: i32, x: i32) -> Option<i32> { Some(acc + x) }
fn dup(x: i32) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new<i32>()
    push(out, x)
    push(out, x)
    out
}

fn main() {
    let mut a: Vec<i32> = Vec::new<i32>()
    push(a, 1)
    push(a, 2)
    push(a, 3)
    push(a, 4)
    let mut b: Vec<i32> = Vec::new<i32>()
    push(b, 10)
    push(b, 20)
    push(b, 30)
    let empty: Vec<i32> = Vec::new<i32>()

    Test::assert_eq_i32(a.iter().count(), 4)
    Test::assert_eq_i32(a.iter().sum(), 10)
    Test::assert_eq_i32(a.iter().fold(0, add), 10)
    Test::assert_true(a.iter().any(is_even))
    Test::assert_true(a.iter().contains(3))
    Test::assert_eq_i32(a.iter().count_eq(2), 1)
    Test::assert_true(a.iter().all(is_pos))
    Test::assert_false(a.iter().all(is_even))
    Test::assert_true(empty.iter().all(is_pos))

    let chained = a.iter().chain(b.iter()).collect()
    Test::assert_eq_i32(len(chained), 7)
    Test::assert_eq_i32(get_unchecked(chained, 4), 10)
    let mut chained_total: i32 = 0
    for value in a.iter().chain(b.iter()) {
        chained_total = chained_total + value
    }
    Test::assert_eq_i32(chained_total, 70)

    let enumerated = a.iter().enumerate().collect()
    Test::assert_eq_i32(len(enumerated), 4)
    Test::assert_eq_i32(get_unchecked(enumerated, 3).first, 3)
    Test::assert_eq_i32(get_unchecked(enumerated, 3).second, 4)

    let zipped = a.iter().zip(b.iter()).collect()
    Test::assert_eq_i32(len(zipped), 3)
    Test::assert_eq_i32(get_unchecked(zipped, 2).first, 3)
    Test::assert_eq_i32(get_unchecked(zipped, 2).second, 30)
    let mut short: Vec<i32> = Vec::new<i32>()
    push(short, 99)
    let narrow = a.iter().zip(short.iter()).collect()
    Test::assert_eq_i32(len(narrow), 1)
    Test::assert_eq_i32(get_unchecked(narrow, 0).second, 99)

    let mapped = a.iter().map(double).collect()
    Test::assert_eq_i32(get_unchecked(mapped, 3), 8)
    let filtered = a.iter().filter(is_even).collect()
    Test::assert_eq_i32(len(filtered), 2)
    let pipeline = a.iter().map(double).filter(is_even).take(2).collect()
    Test::assert_eq_i32(len(pipeline), 2)
    Test::assert_eq_i32(get_unchecked(pipeline, 1), 4)
    let skipped = a.iter().skip(2).collect()
    Test::assert_eq_i32(get_unchecked(skipped, 0), 3)
    let flattened = a.iter().flat_map(dup).collect()
    Test::assert_eq_i32(len(flattened), 8)
    let peeked = a.iter().peekable().collect()
    Test::assert_eq_i32(len(peeked), 4)
    let stepped = a.iter().step_by(2).collect()
    Test::assert_eq_i32(len(stepped), 2)
    let scanned = a.iter().scan(0, running_sum).collect()
    Test::assert_eq_i32(get_unchecked(scanned, 3), 10)
    // Unique / rev collectors share collect_iterator<T>; collect pins the
    // first-occurrence and reverse-order results, not only next / count.
    let unique = a.iter().unique().collect()
    Test::assert_eq_i32(len(unique), 4)
    Test::assert_eq_i32(get_unchecked(unique, 0), 1)
    Test::assert_eq_i32(get_unchecked(unique, 3), 4)
    Test::assert_eq_i32(a.iter().unique().count(), 4)
    let reversed = a.iter().rev().collect()
    Test::assert_eq_i32(len(reversed), 4)
    Test::assert_eq_i32(get_unchecked(reversed, 0), 4)
    Test::assert_eq_i32(get_unchecked(reversed, 3), 1)
    Test::assert_eq_i32(a.iter().rev().count(), 4)

    let ranged = Range::new(0, 3).into_iter().collect()
    Test::assert_eq_i32(len(ranged), 3)
    let inclusive = RangeInclusive::new(0, 2).into_iter().collect()
    Test::assert_eq_i32(len(inclusive), 3)
}
