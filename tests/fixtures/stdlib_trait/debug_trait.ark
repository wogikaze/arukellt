// Issue #696: Debug trait scalar impls + format_debug / write_debug_to.
//
// Verifies that every built-in scalar type implements `Debug` (defined in
// std::core::convert) and that the `format!` equivalent `fmt::format_debug`
// dispatches to the correct impl via trait dispatch. Also exercises the
// `write!` equivalent `fmt::write_debug_to`.
use std::host::stdio
use std::core::convert
use std::text::fmt
fn main() {
    // Debug for i32 — mirrors Display.
    assert((42).fmt_debug().eq(String_from("42")))
    assert((-7).fmt_debug().eq(String_from("-7")))
    assert((0).fmt_debug().eq(String_from("0")))

    // Debug for i64 — mirrors Display.
    let big: i64 = 1000000000000i64
    assert(big.fmt_debug().eq((big).to_string()))

    // Debug for f64 — mirrors Display (compare against the same intrinsic).
    assert((3.14).fmt_debug().eq((3.14).to_string()))
    assert((0.0).fmt_debug().eq((0.0).to_string()))

    // Debug for bool.
    assert(true.fmt_debug().eq(String_from("true")))
    assert(false.fmt_debug().eq(String_from("false")))

    // Debug for char.
    assert(('A').fmt_debug().eq(String_from("A")))
    assert(('z').fmt_debug().eq(String_from("z")))

    // Debug for String — quoted with double quotes (Rust {:?} parity).
    assert(String_from("hello").fmt_debug().eq(String_from("\"hello\"")))
    assert(String_from("").fmt_debug().eq(String_from("\"\"")))

    // write_debug_to appends the Debug rendering onto a buffer.
    let buf = String_from("value=").concat((42).fmt_debug())
    assert(buf.eq(String_from("value=42")))

    // write_debug_to on a String quotes it.
    let buf2 = String_from("s=").concat(String_from("hi").fmt_debug())
    assert(buf2.eq(String_from("s=\"hi\"")))

    stdio::println(String_from("OK"))
}
