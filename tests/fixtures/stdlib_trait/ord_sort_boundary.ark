use std::test::Test
use std::collections::vec
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(2147483647)
    v.push(-2147483647)
    v.push(0)

    v.sort()
    let s = v
    Test::assert_eq_i32(s.len(), 3)
    Test::assert_eq_i32(get_unchecked(s, 0), -2147483647)
    Test::assert_eq_i32(get_unchecked(s, 1), 0)
    Test::assert_eq_i32(get_unchecked(s, 2), 2147483647)
}
