use std::io
use std::test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 1)
    push(data, 2)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    match r.read(0) {
        Result::Ok(read) => test::assert_eq_i32(len(read), 0),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    match r.position() {
        Result::Ok(pos) => test::assert_eq_i64(pos, 0),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
