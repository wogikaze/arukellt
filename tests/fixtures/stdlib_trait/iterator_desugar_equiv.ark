use std::core::iter
use std::host::stdio::Stdio

// A hand-written Iterator: desugared `for` must behave identically to
// driving `next()` manually.
struct Countdown {
    left: i32,
}

impl Iterator for Countdown {
    type Item = i32
    fn next(mut self: Countdown) -> Option<i32> {
        if self.left <= 0 {
            return Option::None
        }
        self.left = self.left - 1
        Option::Some(self.left)
    }
}

fn main() -> i32 {
    let mut manual: Vec<i32> = Vec::new<i32>()
    let mut it: Countdown = Countdown { left: 4 }
    while true {
        match it.next() {
            Some(x) => manual.push(x),
            None => { break },
        }
    }
    let mut desugared: Vec<i32> = Vec::new<i32>()
    let it2: Countdown = Countdown { left: 4 }
    for x in it2 {
        desugared.push(x)
    }
    Stdio::println(manual.len().to_string())
    Stdio::println(desugared.len().to_string())
    let mut i: i32 = 0
    while i < manual.len() {
        Stdio::println(get_unchecked(manual, i).to_string())
        Stdio::println(get_unchecked(desugared, i).to_string())
        i = i + 1
    }
    0
}
