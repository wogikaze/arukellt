use std::core::iter
use std::test::Test

fn add(a: i32, b: i32) -> i32 { a + b }

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(-10)
    v.push(-20)
    v.push(-30)
    v.push(-40)
    v.push(-50)

    let sum = v.iter().sum()
    Test::assert_eq_i32(sum, -150)

    let folded = v.iter().fold(0, add)
    Test::assert_eq_i32(folded, -150)
}
