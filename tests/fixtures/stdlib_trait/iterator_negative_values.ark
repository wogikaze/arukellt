use std::core::iter
use std::test

fn add(a: i32, b: i32) -> i32 { a + b }

fn main() {
    let v: Vec<i32> = Vec::new<i32>()
    push(v, -10)
    push(v, -20)
    push(v, -30)
    push(v, -40)
    push(v, -50)

    let sum = v.iter().sum()
    test::assert_eq_i32(sum, -150)

    let folded = v.iter().fold(0, add)
    test::assert_eq_i32(folded, -150)
}
