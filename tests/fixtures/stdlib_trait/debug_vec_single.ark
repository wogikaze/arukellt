use std::text::fmt
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(42)
    Test::assert_eq_string(fmt::DebugFormat::vec_i32(v), "[42]")

    let mut vs: Vec<String> = Vec::new<String>()
    vs.push(String_from("a"))
    Test::assert_eq_string(fmt::DebugFormat::vec_string(vs), "[\"a\"]")
}
