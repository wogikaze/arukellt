use std::core::iter
use std::test::Test

fn dup(n: i32) -> Vec<i32> {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(n)
    v.push(n * 10)
    v
}

fn empty(_n: i32) -> Vec<i32> {
    Vec::new<i32>()
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)

    let mut it = v.iter().flat_map(dup)
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 1),
        None => Std::panic("expected Some"),
    }
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 10),
        None => Std::panic("expected Some"),
    }
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 2),
        None => Std::panic("expected Some"),
    }

    // Empty inner vectors are skipped without ending the stream.
    let mut it2 = v.iter().flat_map(empty)
    match it2.next() {
        Some(_) => Std::panic("expected None"),
        None => {}
    }

    let mut ev: Vec<i32> = Vec::new<i32>()
    ev.push(0)
    ev.push(2)
    let mut it3 = ev.iter().flat_map(dup)
    match it3.next() {
        Some(x) => Test::assert_eq_i32(x, 0),
        None => Std::panic("expected Some"),
    }
    match it3.next() {
        Some(x) => Test::assert_eq_i32(x, 0),
        None => Std::panic("expected Some"),
    }
    match it3.next() {
        Some(x) => Test::assert_eq_i32(x, 2),
        None => Std::panic("expected Some"),
    }
    match it3.next() {
        Some(x) => Test::assert_eq_i32(x, 20),
        None => Std::panic("expected Some"),
    }
    match it3.next() {
        Some(_) => Std::panic("expected None"),
        None => {}
    }

    // Drained collect preserves expansion order.
    let mut w: Vec<i32> = Vec::new<i32>()
    w.push(3)
    let drained = w.iter().flat_map(dup).collect()
    Test::assert_eq_i32(drained.len(), 2)
    Test::assert_eq_i32(drained.get_unchecked(0), 3)
    Test::assert_eq_i32(drained.get_unchecked(1), 30)

    // Receiver pipeline composes with take.
    let mut z: Vec<i32> = Vec::new<i32>()
    z.push(1)
    z.push(2)
    let taken = z.iter().flat_map(dup).take(3).collect()
    Test::assert_eq_i32(taken.len(), 3)
    Test::assert_eq_i32(taken.get_unchecked(0), 1)
    Test::assert_eq_i32(taken.get_unchecked(1), 10)
    Test::assert_eq_i32(taken.get_unchecked(2), 2)
}
