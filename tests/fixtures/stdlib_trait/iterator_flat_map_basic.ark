use std::core::iter
use std::test

fn dup(n: i32) -> Vec<i32> {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, n)
    push(v, n * 10)
    v
}

fn empty(_n: i32) -> Vec<i32> {
    Vec::new<i32>()
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)

    let mut it = v.iter().flat_map(dup)
    match it.next() {
        Some(x) => test::assert_eq_i32(x, 1),
        None => panic("expected Some"),
    }
    match it.next() {
        Some(x) => test::assert_eq_i32(x, 10),
        None => panic("expected Some"),
    }
    match it.next() {
        Some(x) => test::assert_eq_i32(x, 2),
        None => panic("expected Some"),
    }

    // Empty inner vectors are skipped without ending the stream.
    let mut it2 = v.iter().flat_map(empty)
    match it2.next() {
        Some(_) => panic("expected None"),
        None => {}
    }

    let mut ev: Vec<i32> = Vec::new<i32>()
    push(ev, 0)
    push(ev, 2)
    let mut it3 = ev.iter().flat_map(dup)
    match it3.next() {
        Some(x) => test::assert_eq_i32(x, 0),
        None => panic("expected Some"),
    }
    match it3.next() {
        Some(x) => test::assert_eq_i32(x, 0),
        None => panic("expected Some"),
    }
    match it3.next() {
        Some(x) => test::assert_eq_i32(x, 2),
        None => panic("expected Some"),
    }
    match it3.next() {
        Some(x) => test::assert_eq_i32(x, 20),
        None => panic("expected Some"),
    }
    match it3.next() {
        Some(_) => panic("expected None"),
        None => {}
    }

    // Drained collect preserves expansion order.
    let mut w: Vec<i32> = Vec::new<i32>()
    push(w, 3)
    let drained = w.iter().flat_map(dup).collect()
    test::assert_eq_i32(len(drained), 2)
    test::assert_eq_i32(get_unchecked(drained, 0), 3)
    test::assert_eq_i32(get_unchecked(drained, 1), 30)

    // Receiver pipeline composes with take.
    let mut z: Vec<i32> = Vec::new<i32>()
    push(z, 1)
    push(z, 2)
    let taken = z.iter().flat_map(dup).take(3).collect()
    test::assert_eq_i32(len(taken), 3)
    test::assert_eq_i32(get_unchecked(taken, 0), 1)
    test::assert_eq_i32(get_unchecked(taken, 1), 10)
    test::assert_eq_i32(get_unchecked(taken, 2), 2)
}
