// Property: map preserves the length of the source vector.
use std::core::iter
use std::test::Test

fn double(x: i32) -> i32 { x * 2 }

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    for i in 0..50 {
        v.push(i)
    }
    let mapped = v.iter().map(double).collect()
    Test::assert_eq_i32(mapped.len(), v.len())
}
