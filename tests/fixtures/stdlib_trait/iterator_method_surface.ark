// The eager std::core::iter constructor/collector frees were retired (#917);
// this fixture pins the lazy method surface that replaced them.
use std::core::{Range, RangeInclusive}
use std::core::iter
use std::test::Test

fn is_pos(x: i32) -> bool { x > 0 }
fn is_even(x: i32) -> bool { x / 2 * 2 == x }
fn double(x: i32) -> i32 { x * 2 }
fn add(a: i32, b: i32) -> i32 { a + b }
fn running_sum(acc: i32, x: i32) -> Option<i32> { Some(acc + x) }
fn dup(x: i32) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new<i32>()
    out.push(x)
    out.push(x)
    out
}

fn main() {
    let mut a: Vec<i32> = Vec::new<i32>()
    a.push(1)
    a.push(2)
    a.push(3)
    a.push(4)
    let mut b: Vec<i32> = Vec::new<i32>()
    b.push(10)
    b.push(20)
    b.push(30)
    let empty: Vec<i32> = Vec::new<i32>()

    // Numeric consumers keep the capability-based method spelling.
    Test::assert_eq_i32(a.iter().count(), 4)
    Test::assert_eq_i32(a.iter().sum(), 10)
    Test::assert_eq_i32(a.iter().fold(0, add), 10)
    Test::assert_true(a.iter().any(is_even))
    Test::assert_true(a.iter().contains(3))
    Test::assert_eq_i32(a.iter().count_eq(2), 1)

    // all: true, false, and vacuously true on an empty range.
    Test::assert_true(a.iter().all(is_pos))
    Test::assert_false(a.iter().all(is_even))
    Test::assert_true(empty.iter().all(is_pos))

    // chain: both sources in order, plus the generic IntoIterator path.
    let chained = a.iter().chain(b.iter()).collect()
    Test::assert_eq_i32(chained.len(), 7)
    Test::assert_eq_i32(chained.get_unchecked(4), 10)
    let mut chained_total: i32 = 0
    for value in a.iter().chain(b.iter()) {
        chained_total = chained_total + value
    }
    Test::assert_eq_i32(chained_total, 70)

    // enumerate: zero-based Pair positions.
    let enumerated = a.iter().enumerate().collect()
    Test::assert_eq_i32(enumerated.len(), 4)
    Test::assert_eq_i32(enumerated.get_unchecked(3).first, 3)
    Test::assert_eq_i32(enumerated.get_unchecked(3).second, 4)

    // zip: stops at the shorter source and keeps both payloads.
    let zipped = a.iter().zip(b.iter()).collect()
    Test::assert_eq_i32(zipped.len(), 3)
    Test::assert_eq_i32(zipped.get_unchecked(2).first, 3)
    Test::assert_eq_i32(zipped.get_unchecked(2).second, 30)
    let mut short: Vec<i32> = Vec::new<i32>()
    short.push(99)
    let narrow = a.iter().zip(short.iter()).collect()
    Test::assert_eq_i32(narrow.len(), 1)
    Test::assert_eq_i32(narrow.get_unchecked(0).second, 99)

    // Collector chains: map, filter, take, skip, flat_map, step_by, scan.
    let mapped = a.iter().map(double).collect()
    Test::assert_eq_i32(mapped.get_unchecked(3), 8)
    let filtered = a.iter().filter(is_even).collect()
    Test::assert_eq_i32(filtered.len(), 2)
    let pipeline = a.iter().map(double).filter(is_even).take(2).collect()
    Test::assert_eq_i32(pipeline.len(), 2)
    Test::assert_eq_i32(pipeline.get_unchecked(1), 4)
    let skipped = a.iter().skip(2).collect()
    Test::assert_eq_i32(skipped.get_unchecked(0), 3)
    let flattened = a.iter().flat_map(dup).collect()
    Test::assert_eq_i32(flattened.len(), 8)
    let peeked = a.iter().peekable().collect()
    Test::assert_eq_i32(peeked.len(), 4)
    let stepped = a.iter().step_by(2).collect()
    Test::assert_eq_i32(stepped.len(), 2)
    let scanned = a.iter().scan(0, running_sum).collect()
    Test::assert_eq_i32(scanned.get_unchecked(3), 10)
    // Unique / rev collectors share collect_iterator<T>; collect pins the
    // first-occurrence and reverse-order results, not only next / count.
    let unique = a.iter().unique().collect()
    Test::assert_eq_i32(unique.len(), 4)
    Test::assert_eq_i32(unique.get_unchecked(0), 1)
    Test::assert_eq_i32(unique.get_unchecked(3), 4)
    Test::assert_eq_i32(a.iter().unique().count(), 4)
    let reversed = a.iter().rev().collect()
    Test::assert_eq_i32(reversed.len(), 4)
    Test::assert_eq_i32(reversed.get_unchecked(0), 4)
    Test::assert_eq_i32(reversed.get_unchecked(3), 1)
    Test::assert_eq_i32(a.iter().rev().count(), 4)

    // Range constructors expose the same into_iter entry point.
    let ranged = Range::new(0, 3).into_iter().collect()
    Test::assert_eq_i32(ranged.len(), 3)
    let inclusive = RangeInclusive::new(0, 2).into_iter().collect()
    Test::assert_eq_i32(inclusive.len(), 3)
}
