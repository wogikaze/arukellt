use std::core::iter
use std::test::Test

fn main() {
    let mut a: Vec<i32> = Vec::new<i32>()
    push(a, 1)
    push(a, 2)
    let mut b: Vec<i32> = Vec::new<i32>()
    push(b, 3)
    push(b, 4)
    push(b, 5)

    let chained = a.iter().chain(b.iter()).collect()
    Test::assert_eq_i32(chained.len(), 5)
    Test::assert_eq_i32(chained.get_unchecked(0), 1)
    Test::assert_eq_i32(chained.get_unchecked(1), 2)
    Test::assert_eq_i32(chained.get_unchecked(2), 3)
    Test::assert_eq_i32(chained.get_unchecked(3), 4)
    Test::assert_eq_i32(chained.get_unchecked(4), 5)
}
