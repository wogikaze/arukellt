use std::core::iter
use std::host::stdio

fn double(x: i32) -> i32 { x * 2 }
fn is_even(x: i32) -> bool { x / 2 * 2 == x }
fn add_i32(a: i32, b: i32) -> i32 { a + b }

fn sum_into_for<T: iter::IntoIterator>(source: T) -> i32 {
    let mut total: i32 = 0
    for value in source {
        total = total + value
    }
    total
}

fn main() {
    let v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5)
    // map + collect
    let doubled = iter::collect_map_i32(v, double)
    assert(len(doubled) == 5)
    assert(get_unchecked(doubled, 0) == 2)
    assert(get_unchecked(doubled, 4) == 10)
    // filter + collect
    let evens = iter::collect_filter_i32(v, is_even)
    assert(len(evens) == 2)
    assert(get_unchecked(evens, 0) == 2)
    // take + collect
    let taken = iter::collect_take_i32(v, 3)
    assert(len(taken) == 3)
    assert(get_unchecked(taken, 2) == 3)
    // skip + collect
    let skipped = iter::collect_skip_i32(v, 2)
    assert(len(skipped) == 3)
    assert(get_unchecked(skipped, 0) == 3)
    // map+filter+take pipeline (single pass, no intermediate Vec)
    let pipe = iter::collect_map_filter_take_i32(v, double, is_even, 2)
    assert(len(pipe) == 2)
    assert(get_unchecked(pipe, 0) == 2)
    assert(get_unchecked(pipe, 1) == 4)
    let map_filter = iter::collect_map_filter_i32(v, double, is_even)
    assert(len(map_filter) == 5)
    assert(get_unchecked(map_filter, 0) == 2)
    assert(get_unchecked(map_filter, 4) == 10)
    // Method-shaped entry points preserve the same lazy adapter state.
    let method_map = v.iter().map(double).collect()
    assert(len(method_map) == 5)
    assert(get_unchecked(method_map, 4) == 10)
    let method_map_take = v.iter().map(double).take(2).collect()
    assert(len(method_map_take) == 2)
    assert(get_unchecked(method_map_take, 0) == 2)
    assert(get_unchecked(method_map_take, 1) == 4)
    let method_filter = v.iter().filter(is_even).collect()
    assert(len(method_filter) == 2)
    assert(get_unchecked(method_filter, 0) == 2)
    let method_filter_take = v.iter().filter(is_even).take(1).collect()
    assert(len(method_filter_take) == 1)
    assert(get_unchecked(method_filter_take, 0) == 2)
    let method_take = v.iter().take(3).collect()
    assert(len(method_take) == 3)
    assert(get_unchecked(method_take, 2) == 3)
    let method_skip = v.iter().skip(2).collect()
    assert(len(method_skip) == 3)
    assert(get_unchecked(method_skip, 0) == 3)
    let method_skip_take = v.iter().skip(2).take(2).collect()
    assert(len(method_skip_take) == 2)
    assert(get_unchecked(method_skip_take, 0) == 3)
    assert(get_unchecked(method_skip_take, 1) == 4)
    let method_pipeline = v.iter().map(double).filter(is_even).take(2).collect()
    assert(len(method_pipeline) == 2)
    assert(get_unchecked(method_pipeline, 0) == 2)
    assert(get_unchecked(method_pipeline, 1) == 4)
    let mut method_for_total: i32 = 0
    for value in v.iter().map(double).filter(is_even).take(2) {
        method_for_total = method_for_total + value
    }
    assert(method_for_total == 6)
    let generic_method_for_total = sum_into_for(v.iter().map(double).filter(is_even).take(2))
    assert(generic_method_for_total == 6)
    let generic_filter_take_total = sum_into_for(v.iter().filter(is_even).take(1))
    assert(generic_filter_take_total == 2)
    let generic_skip_take_total = sum_into_for(v.iter().skip(2).take(2))
    assert(generic_skip_take_total == 7)
    // fold (named callback — anonymous closures emit GC stubs that fail validate)
    let sum = iter::iter_fold_i32(v, 0, add_i32)
    assert(sum == 15)
    // chain
    let a: Vec<i32> = Vec::new<i32>()
    push(a, 10)
    push(a, 20)
    let chained = iter::collect_chain_i32(v, a)
    assert(len(chained) == 7)
    assert(get_unchecked(chained, 5) == 10)
    // range / VecIter / for-loop remain covered by sibling fixtures;
    // they hit independent GC local-typing bugs outside call_indirect typing.
    stdio::println("OK")
}
