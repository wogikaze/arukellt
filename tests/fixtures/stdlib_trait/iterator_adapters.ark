use std::core::iter
use std::host::stdio::Stdio

fn double(x: i32) -> i32 { x * 2 }
fn is_even(x: i32) -> bool { x / 2 * 2 == x }
fn add_i32(a: i32, b: i32) -> i32 { a + b }

fn sum_into_for<T: iter::IntoIterator>(source: T) -> i32 {
    let mut total: i32 = 0
    for value in source {
        total = total + value
    }
    total
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)
    // map + collect
    let doubled = v.iter().map(double).collect()
    assert(doubled.len() == 5)
    assert(doubled.get_unchecked(0) == 2)
    assert(doubled.get_unchecked(4) == 10)
    // filter + collect
    let evens = v.iter().filter(is_even).collect()
    assert(evens.len() == 2)
    assert(evens.get_unchecked(0) == 2)
    // take + collect
    let taken = v.iter().take(3).collect()
    assert(taken.len() == 3)
    assert(taken.get_unchecked(2) == 3)
    // skip + collect
    let skipped = v.iter().skip(2).collect()
    assert(skipped.len() == 3)
    assert(skipped.get_unchecked(0) == 3)
    // map+filter+take pipeline (single pass, no intermediate Vec)
    let pipe = v.iter().map(double).filter(is_even).take(2).collect()
    assert(pipe.len() == 2)
    assert(pipe.get_unchecked(0) == 2)
    assert(pipe.get_unchecked(1) == 4)
    let map_filter = v.iter().map(double).filter(is_even).collect()
    assert(map_filter.len() == 5)
    assert(map_filter.get_unchecked(0) == 2)
    assert(map_filter.get_unchecked(4) == 10)
    // Method-shaped entry points preserve the same lazy adapter state.
    let method_map = v.iter().map(double).collect()
    assert(method_map.len() == 5)
    assert(method_map.get_unchecked(4) == 10)
    let method_map_take = v.iter().map(double).take(2).collect()
    assert(method_map_take.len() == 2)
    assert(method_map_take.get_unchecked(0) == 2)
    assert(method_map_take.get_unchecked(1) == 4)
    let method_filter = v.iter().filter(is_even).collect()
    assert(method_filter.len() == 2)
    assert(method_filter.get_unchecked(0) == 2)
    let method_filter_take = v.iter().filter(is_even).take(1).collect()
    assert(method_filter_take.len() == 1)
    assert(method_filter_take.get_unchecked(0) == 2)
    let method_take = v.iter().take(3).collect()
    assert(method_take.len() == 3)
    assert(method_take.get_unchecked(2) == 3)
    let method_skip = v.iter().skip(2).collect()
    assert(method_skip.len() == 3)
    assert(method_skip.get_unchecked(0) == 3)
    let method_skip_take = v.iter().skip(2).take(2).collect()
    assert(method_skip_take.len() == 2)
    assert(method_skip_take.get_unchecked(0) == 3)
    assert(method_skip_take.get_unchecked(1) == 4)
    let method_pipeline = v.iter().map(double).filter(is_even).take(2).collect()
    assert(method_pipeline.len() == 2)
    assert(method_pipeline.get_unchecked(0) == 2)
    assert(method_pipeline.get_unchecked(1) == 4)
    let mut method_for_total: i32 = 0
    for value in v.iter().map(double).filter(is_even).take(2) {
        method_for_total = method_for_total + value
    }
    assert(method_for_total == 6)
    let generic_method_for_total = sum_into_for(v.iter().map(double).filter(is_even).take(2))
    assert(generic_method_for_total == 6)
    let generic_filter_take_total = sum_into_for(v.iter().filter(is_even).take(1))
    assert(generic_filter_take_total == 2)
    let generic_skip_take_total = sum_into_for(v.iter().skip(2).take(2))
    assert(generic_skip_take_total == 7)
    let method_skip_map = v.iter().skip(2).map(double).collect()
    assert(method_skip_map.len() == 3)
    assert(method_skip_map.get_unchecked(0) == 6)
    assert(method_skip_map.get_unchecked(2) == 10)
    let method_skip_map_from_iter: Vec<i32> = Vec::from_iter(v.iter().skip(2).map(double))
    assert(method_skip_map_from_iter.len() == 3)
    assert(method_skip_map_from_iter.get_unchecked(1) == 8)
    let generic_skip_map_total = sum_into_for(v.iter().skip(2).map(double))
    assert(generic_skip_map_total == 24)
    let method_skip_filter = v.iter().skip(2).filter(is_even).collect()
    assert(method_skip_filter.len() == 1)
    assert(method_skip_filter.get_unchecked(0) == 4)
    let method_skip_filter_from_iter: Vec<i32> = Vec::from_iter(v.iter().skip(2).filter(is_even))
    assert(method_skip_filter_from_iter.len() == 1)
    assert(method_skip_filter_from_iter.get_unchecked(0) == 4)
    let generic_skip_filter_total = sum_into_for(v.iter().skip(2).filter(is_even))
    assert(generic_skip_filter_total == 4)
    // fold (named callback — anonymous closures emit GC stubs that fail validate)
    let sum = v.iter().fold(0, add_i32)
    assert(sum == 15)
    // chain
    let mut a: Vec<i32> = Vec::new<i32>()
    a.push(10)
    a.push(20)
    let chained = v.iter().chain(a.iter()).collect()
    assert(chained.len() == 7)
    assert(chained.get_unchecked(5) == 10)
    // range / VecIter<i32> / for-loop remain covered by sibling fixtures;
    // they hit independent GC local-typing bugs outside call_indirect typing.
    Stdio::println("OK")
}
