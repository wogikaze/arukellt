use std::core::cmp
use std::test::Test
fn main() {
    Test::assert_true(String_from("hello").eq(String_from("hello")))
    Test::assert_false(String_from("hello").eq(String_from("world")))
    Test::assert_true(String_from("").eq(String_from("")))
    Test::assert_false(String_from("a").eq(String_from("ab")))
}
