use std::core::iter
use std::test

fn sum_iter<T: iter::Iterator + iter::IteratorSum<i32, i32>>(iterator: T) -> i32 {
    iterator.sum()
}

fn sum_for<T: iter::Iterator>(iterator: T) -> i32 {
    let mut total: i32 = 0
    for value in iterator {
        total = total + value
    }
    total
}

fn sum_into_for<T: iter::IntoIterator>(source: T) -> i32 {
    let mut total: i32 = 0
    for value in source {
        total = total + value
    }
    total
}

fn main() {
    let v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)

    let it = iter::vec_iter(v)
    let mut total: i32 = 0
    for x in it {
        total = total + x
    }
    test::assert_eq_i32(total, 60)

    let manual_total = sum_iter(iter::vec_iter(v))
    test::assert_eq_i32(manual_total, total)

    let generic_for_total = sum_for(iter::vec_iter(v))
    test::assert_eq_i32(generic_for_total, total)

    let generic_into_source: Vec<i32> = Vec::new<i32>()
    push(generic_into_source, 6)
    push(generic_into_source, 7)
    let generic_into_total = sum_into_for(generic_into_source)
    test::assert_eq_i32(generic_into_total, 13)

    let direct_source: Vec<i32> = Vec::new<i32>()
    push(direct_source, 4)
    push(direct_source, 5)
    let mut direct_total: i32 = 0
    for x in direct_source {
        direct_total = direct_total + x
    }
    test::assert_eq_i32(direct_total, 9)
}
