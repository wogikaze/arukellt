use std::core::iter
use std::test::Test

fn sum_iter<T: iter::Iterator + iter::IteratorSum<i32, i32>>(mut iterator: T) -> i32 {
    iterator.sum()
}

fn sum_for<T: iter::Iterator>(iterator: T) -> i32 {
    let mut total: i32 = 0
    for value in iterator {
        total = total + value
    }
    total
}

fn sum_into_for<T: iter::IntoIterator>(source: T) -> i32 {
    let mut total: i32 = 0
    for value in source {
        total = total + value
    }
    total
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)

    let it = v.iter()
    let mut total: i32 = 0
    for x in it {
        total = total + x
    }
    Test::assert_eq_i32(total, 60)

    let manual_total = sum_iter(v.iter())
    Test::assert_eq_i32(manual_total, total)

    let generic_for_total = sum_for(v.iter())
    Test::assert_eq_i32(generic_for_total, total)

    let mut generic_into_source: Vec<i32> = Vec::new<i32>()
    generic_into_source.push(6)
    generic_into_source.push(7)
    let generic_into_total = sum_into_for(generic_into_source)
    Test::assert_eq_i32(generic_into_total, 13)

    let mut direct_source: Vec<i32> = Vec::new<i32>()
    direct_source.push(4)
    direct_source.push(5)
    let mut direct_total: i32 = 0
    for x in direct_source {
        direct_total = direct_total + x
    }
    Test::assert_eq_i32(direct_total, 9)
}
