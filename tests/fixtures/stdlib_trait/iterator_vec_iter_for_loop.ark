use std::core::iter
use std::test

fn sum_iter<T: iter::Iterator>(iterator: T) -> i32 {
    iterator.sum()
}

fn main() {
    let v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)

    let it = iter::vec_iter(v)
    let mut total: i32 = 0
    for x in it {
        total = total + x
    }
    test::assert_eq_i32(total, 60)

    let manual_total = sum_iter(iter::vec_iter(v))
    test::assert_eq_i32(manual_total, total)
}
