use std::core::iter
use std::test::Test

fn main() {
    let mut a: Vec<i32> = Vec::new<i32>()
    a.push(10)
    a.push(20)
    let b: Vec<i32> = Vec::new<i32>()

    let chained = a.iter().chain(b.iter()).collect()
    Test::assert_eq_i32(chained.len(), 2)
    Test::assert_eq_i32(chained.get_unchecked(0), 10)
    Test::assert_eq_i32(chained.get_unchecked(1), 20)
}
