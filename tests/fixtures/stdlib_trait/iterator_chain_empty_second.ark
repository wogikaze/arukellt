use std::core::iter
use std::test::Test

fn main() {
    let mut a: Vec<i32> = Vec::new<i32>()
    push(a, 10)
    push(a, 20)
    let b: Vec<i32> = Vec::new<i32>()

    let chained = a.iter().chain(b.iter()).collect()
    Test::assert_eq_i32(chained.len(), 2)
    Test::assert_eq_i32(get_unchecked(chained, 0), 10)
    Test::assert_eq_i32(get_unchecked(chained, 1), 20)
}
