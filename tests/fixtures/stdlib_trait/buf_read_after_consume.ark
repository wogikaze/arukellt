use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 10)
    push(data, 20)
    push(data, 30)
    push(data, 40)
    let mut r: io::Reader = io::Reader::from_bytes(data)

    // Consume 2 bytes
    match r.read(2) {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(e.message()),
    }

    // fill_buf returns the remaining 2 bytes
    match r.fill_buf() {
        Result::Ok(filled) => {
            Test::assert_eq_i32(filled.len(), 2)
            Test::assert_eq_i32(filled.get_unchecked(0), 30)
            Test::assert_eq_i32(filled.get_unchecked(1), 40)
        },
        Result::Err(e) => Std::panic(e.message()),
    }

    // Cursor is still at 2
    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 2),
        Result::Err(e) => Std::panic(e.message()),
    }
}
