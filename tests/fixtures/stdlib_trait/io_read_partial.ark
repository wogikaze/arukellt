use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 10)
    push(data, 20)
    push(data, 30)
    let mut r: io::Reader = io::Reader::from_bytes(data)

    // Request 10 bytes but only 3 available
    match r.read(10) {
        Result::Ok(read) => {
            Test::assert_eq_i32(read.len(), 3)
            Test::assert_eq_i32(read.get_unchecked(0), 10)
            Test::assert_eq_i32(read.get_unchecked(1), 20)
            Test::assert_eq_i32(read.get_unchecked(2), 30)
        },
        Result::Err(e) => Std::panic(e.message()),
    }
}
