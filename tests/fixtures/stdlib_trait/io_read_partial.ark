use std::io
use std::test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    push(data, 10)
    push(data, 20)
    push(data, 30)
    let r: io::Reader = io::Reader::from_bytes(data)

    // Request 10 bytes but only 3 available
    match r.read(10) {
        Result::Ok(read) => {
            test::assert_eq_i32(len(read), 3)
            test::assert_eq_i32(get_unchecked(read, 0), 10)
            test::assert_eq_i32(get_unchecked(read, 1), 20)
            test::assert_eq_i32(get_unchecked(read, 2), 30)
        },
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
