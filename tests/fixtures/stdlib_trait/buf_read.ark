// Issue #693: Reader implements BufRead.
//
// fill_buf returns the unconsumed bytes without advancing the cursor, and
// repeated calls stay consistent; read advances the shared cursor.
use std::host::stdio::Stdio
use std::io

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 65)  // 'A'
    push(data, 66)  // 'B'
    push(data, 67)  // 'C'
    let mut r: io::Reader = io::Reader::from_bytes(data)

    match r.fill_buf() {
        Result::Ok(filled) => {
            assert(len(filled) == 3)
            assert(get_unchecked(filled, 0) == 65)
            assert(get_unchecked(filled, 1) == 66)
            assert(get_unchecked(filled, 2) == 67)
        },
        Result::Err(_e) => assert(false),
    }

    match r.position() {
        Result::Ok(pos) => assert(pos == 0i64),
        Result::Err(_e) => assert(false),
    }

    match r.read(1) {
        Result::Ok(one) => {
            assert(len(one) == 1)
            assert(get_unchecked(one, 0) == 65)
        },
        Result::Err(_e) => assert(false),
    }

    match r.fill_buf() {
        Result::Ok(filled2) => {
            assert(len(filled2) == 2)
            assert(get_unchecked(filled2, 0) == 66)
            assert(get_unchecked(filled2, 1) == 67)
        },
        Result::Err(_e) => assert(false),
    }

    match r.position() {
        Result::Ok(pos) => assert(pos == 1i64),
        Result::Err(_e) => assert(false),
    }

    Stdio::println("OK")
}
