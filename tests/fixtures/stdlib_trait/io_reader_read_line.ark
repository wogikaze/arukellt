use std::io
use std::test

fn main() {
    // "AB\nCD" - read_line returns "AB" and consumes the newline
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 65)
    push(data, 66)
    push(data, 10)
    push(data, 67)
    push(data, 68)
    let mut reader: io::Reader = io::Reader::from_bytes(data)

    match reader.read_line() {
        Result::Ok(found) => match found {
            Option::Some(line) => test::assert_eq_string(line, "AB"),
            Option::None => Std::panic("expected Ok"),
        },
        Result::Err(_e) => Std::panic("expected Ok"),
    }

    // Second read should get "CD" (no trailing newline)
    match reader.read_line() {
        Result::Ok(found) => match found {
            Option::Some(line) => test::assert_eq_string(line, "CD"),
            Option::None => Std::panic("expected Ok"),
        },
        Result::Err(_e) => Std::panic("expected Ok"),
    }
}
