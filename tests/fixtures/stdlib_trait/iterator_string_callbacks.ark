use std::core::iter
use std::test::Test
fn map_identity(value: String) -> String {
    value.clone()
}

fn keep_long_string(value: String) -> bool {
    value.len() > 3
}

fn collect_from_iterator<T: iter::Iterator>(mut iterator: T) -> Vec<T::Item> {
    Vec::from_iter(iterator)
}

fn total_string_lengths<T: iter::IntoIterator>(source: T) -> i32 {
    let mut total: i32 = 0
    for value in source {
        total = total + value.len()
    }
    total
}

fn main() {
    let mut map_source: Vec<String> = Vec::new<String>()
    map_source.push(String_from("alpha"))
    map_source.push(String_from("go"))
    let mapped = map_source.iter().map(map_identity).collect()
    Test::assert_eq_i32(mapped.len(), 2)
    Test::assert_eq_string(get_unchecked(mapped, 0), "alpha")
    Test::assert_eq_string(get_unchecked(mapped, 1), "go")

    let mut map_from_iter_source: Vec<String> = Vec::new<String>()
    map_from_iter_source.push(String_from("first"))
    map_from_iter_source.push(String_from("second"))
    let mut map_from_iter = map_from_iter_source.iter().map(map_identity)
    let mapped_from_iter: Vec<String> = Vec::from_iter(map_from_iter)
    Test::assert_eq_i32(mapped_from_iter.len(), 2)
    Test::assert_eq_string(get_unchecked(mapped_from_iter, 0), "first")
    Test::assert_eq_string(get_unchecked(mapped_from_iter, 1), "second")

    let mut filter_source: Vec<String> = Vec::new<String>()
    filter_source.push(String_from("alpha"))
    filter_source.push(String_from("go"))
    filter_source.push(String_from("bravo"))
    let filtered = filter_source.iter().filter(keep_long_string).collect()
    Test::assert_eq_i32(filtered.len(), 2)
    Test::assert_eq_string(get_unchecked(filtered, 0), "alpha")
    Test::assert_eq_string(get_unchecked(filtered, 1), "bravo")

    let mut filter_from_iter_source: Vec<String> = Vec::new<String>()
    filter_from_iter_source.push(String_from("alpha"))
    filter_from_iter_source.push(String_from("go"))
    filter_from_iter_source.push(String_from("bravo"))
    let mut filter_from_iter = filter_from_iter_source.iter().filter(keep_long_string)
    let filtered_from_iter: Vec<String> = Vec::from_iter(filter_from_iter)
    Test::assert_eq_i32(filtered_from_iter.len(), 2)
    Test::assert_eq_string(get_unchecked(filtered_from_iter, 0), "alpha")
    Test::assert_eq_string(get_unchecked(filtered_from_iter, 1), "bravo")

    let mut generic_from_iter_source: Vec<String> = Vec::new<String>()
    generic_from_iter_source.push(String_from("generic"))
    let generic_from_iter: Vec<String> = collect_from_iterator(generic_from_iter_source.iter().map(map_identity))
    Test::assert_eq_i32(generic_from_iter.len(), 1)
    Test::assert_eq_string(get_unchecked(generic_from_iter, 0), "generic")

    let mut composed_source: Vec<String> = Vec::new<String>()
    composed_source.push(String_from("alpha"))
    composed_source.push(String_from("go"))
    composed_source.push(String_from("bravo"))
    let composed = composed_source.iter().map(map_identity).filter(keep_long_string).collect()
    Test::assert_eq_i32(composed.len(), 2)
    Test::assert_eq_string(get_unchecked(composed, 0), "alpha")
    Test::assert_eq_string(get_unchecked(composed, 1), "bravo")

    let mut composed_from_iter_source: Vec<String> = Vec::new<String>()
    composed_from_iter_source.push(String_from("alpha"))
    composed_from_iter_source.push(String_from("go"))
    composed_from_iter_source.push(String_from("bravo"))
    let mut composed_from_iter_source_adapter = composed_from_iter_source.iter().map(map_identity).filter(keep_long_string)
    let composed_from_iter: Vec<String> = Vec::from_iter(composed_from_iter_source_adapter)
    Test::assert_eq_i32(composed_from_iter.len(), 2)
    Test::assert_eq_string(get_unchecked(composed_from_iter, 0), "alpha")
    Test::assert_eq_string(get_unchecked(composed_from_iter, 1), "bravo")

    let mut reverse_composed_source: Vec<String> = Vec::new<String>()
    reverse_composed_source.push(String_from("alpha"))
    reverse_composed_source.push(String_from("go"))
    reverse_composed_source.push(String_from("bravo"))
    let reverse_composed = reverse_composed_source.iter().filter(keep_long_string).map(map_identity).collect()
    Test::assert_eq_i32(reverse_composed.len(), 2)
    Test::assert_eq_string(get_unchecked(reverse_composed, 0), "alpha")
    Test::assert_eq_string(get_unchecked(reverse_composed, 1), "bravo")

    let mut reverse_from_iter_source: Vec<String> = Vec::new<String>()
    reverse_from_iter_source.push(String_from("alpha"))
    reverse_from_iter_source.push(String_from("go"))
    reverse_from_iter_source.push(String_from("bravo"))
    let mut reverse_from_iter_adapter = reverse_from_iter_source.iter().filter(keep_long_string).map(map_identity)
    let reverse_from_iter: Vec<String> = Vec::from_iter(reverse_from_iter_adapter)
    Test::assert_eq_i32(reverse_from_iter.len(), 2)
    Test::assert_eq_string(get_unchecked(reverse_from_iter, 0), "alpha")
    Test::assert_eq_string(get_unchecked(reverse_from_iter, 1), "bravo")

    let mut generic_for_source: Vec<String> = Vec::new<String>()
    generic_for_source.push(String_from("alpha"))
    generic_for_source.push(String_from("go"))
    generic_for_source.push(String_from("bravo"))
    let generic_for_total = total_string_lengths(generic_for_source.iter().filter(keep_long_string).map(map_identity))
    Test::assert_eq_i32(generic_for_total, 10)

    let mut map_take_source: Vec<String> = Vec::new<String>()
    map_take_source.push(String_from("alpha"))
    map_take_source.push(String_from("go"))
    map_take_source.push(String_from("bravo"))
    let map_take = map_take_source.iter().map(map_identity).take(2).collect()
    Test::assert_eq_i32(map_take.len(), 2)
    Test::assert_eq_string(get_unchecked(map_take, 0), "alpha")
    Test::assert_eq_string(get_unchecked(map_take, 1), "go")

    let mut map_take_from_iter_source: Vec<String> = Vec::new<String>()
    map_take_from_iter_source.push(String_from("alpha"))
    map_take_from_iter_source.push(String_from("go"))
    map_take_from_iter_source.push(String_from("bravo"))
    let mut map_take_from_iter_adapter = map_take_from_iter_source.iter().map(map_identity).take(2)
    let map_take_from_iter: Vec<String> = Vec::from_iter(map_take_from_iter_adapter)
    Test::assert_eq_i32(map_take_from_iter.len(), 2)
    Test::assert_eq_string(get_unchecked(map_take_from_iter, 0), "alpha")
    Test::assert_eq_string(get_unchecked(map_take_from_iter, 1), "go")

    let mut map_take_for_source: Vec<String> = Vec::new<String>()
    map_take_for_source.push(String_from("alpha"))
    map_take_for_source.push(String_from("go"))
    map_take_for_source.push(String_from("bravo"))
    let map_take_total = total_string_lengths(map_take_for_source.iter().map(map_identity).take(2))
    Test::assert_eq_i32(map_take_total, 7)

    let mut filter_take_source: Vec<String> = Vec::new<String>()
    filter_take_source.push(String_from("alpha"))
    filter_take_source.push(String_from("go"))
    filter_take_source.push(String_from("bravo"))
    let filter_take = filter_take_source.iter().filter(keep_long_string).take(1).collect()
    Test::assert_eq_i32(filter_take.len(), 1)
    Test::assert_eq_string(get_unchecked(filter_take, 0), "alpha")

    let mut filter_take_from_iter_source: Vec<String> = Vec::new<String>()
    filter_take_from_iter_source.push(String_from("alpha"))
    filter_take_from_iter_source.push(String_from("go"))
    filter_take_from_iter_source.push(String_from("bravo"))
    let mut filter_take_from_iter_adapter = filter_take_from_iter_source.iter().filter(keep_long_string).take(1)
    let filter_take_from_iter: Vec<String> = Vec::from_iter(filter_take_from_iter_adapter)
    Test::assert_eq_i32(filter_take_from_iter.len(), 1)
    Test::assert_eq_string(get_unchecked(filter_take_from_iter, 0), "alpha")

    let mut filter_take_for_source: Vec<String> = Vec::new<String>()
    filter_take_for_source.push(String_from("alpha"))
    filter_take_for_source.push(String_from("go"))
    filter_take_for_source.push(String_from("bravo"))
    let filter_take_total = total_string_lengths(filter_take_for_source.iter().filter(keep_long_string).take(1))
    Test::assert_eq_i32(filter_take_total, 5)

    let mut map_filter_take_source: Vec<String> = Vec::new<String>()
    map_filter_take_source.push(String_from("alpha"))
    map_filter_take_source.push(String_from("go"))
    map_filter_take_source.push(String_from("bravo"))
    let map_filter_take = map_filter_take_source.iter().map(map_identity).filter(keep_long_string).take(1).collect()
    Test::assert_eq_i32(map_filter_take.len(), 1)
    Test::assert_eq_string(get_unchecked(map_filter_take, 0), "alpha")

    let mut map_filter_take_from_iter_source: Vec<String> = Vec::new<String>()
    map_filter_take_from_iter_source.push(String_from("alpha"))
    map_filter_take_from_iter_source.push(String_from("go"))
    map_filter_take_from_iter_source.push(String_from("bravo"))
    let mut map_filter_take_adapter = map_filter_take_from_iter_source.iter().map(map_identity).filter(keep_long_string).take(1)
    let map_filter_take_from_iter: Vec<String> = Vec::from_iter(map_filter_take_adapter)
    Test::assert_eq_i32(map_filter_take_from_iter.len(), 1)
    Test::assert_eq_string(get_unchecked(map_filter_take_from_iter, 0), "alpha")

    let mut map_filter_take_for_source: Vec<String> = Vec::new<String>()
    map_filter_take_for_source.push(String_from("alpha"))
    map_filter_take_for_source.push(String_from("go"))
    map_filter_take_for_source.push(String_from("bravo"))
    let map_filter_take_total = total_string_lengths(map_filter_take_for_source.iter().map(map_identity).filter(keep_long_string).take(1))
    Test::assert_eq_i32(map_filter_take_total, 5)

    let mut filter_map_take_source: Vec<String> = Vec::new<String>()
    filter_map_take_source.push(String_from("alpha"))
    filter_map_take_source.push(String_from("go"))
    filter_map_take_source.push(String_from("bravo"))
    let filter_map_take = filter_map_take_source.iter().filter(keep_long_string).map(map_identity).take(1).collect()
    Test::assert_eq_i32(filter_map_take.len(), 1)
    Test::assert_eq_string(get_unchecked(filter_map_take, 0), "alpha")

    let mut filter_map_take_from_iter_source: Vec<String> = Vec::new<String>()
    filter_map_take_from_iter_source.push(String_from("alpha"))
    filter_map_take_from_iter_source.push(String_from("go"))
    filter_map_take_from_iter_source.push(String_from("bravo"))
    let mut filter_map_take_adapter = filter_map_take_from_iter_source.iter().filter(keep_long_string).map(map_identity).take(1)
    let filter_map_take_from_iter: Vec<String> = Vec::from_iter(filter_map_take_adapter)
    Test::assert_eq_i32(filter_map_take_from_iter.len(), 1)
    Test::assert_eq_string(get_unchecked(filter_map_take_from_iter, 0), "alpha")

    let mut filter_map_take_for_source: Vec<String> = Vec::new<String>()
    filter_map_take_for_source.push(String_from("alpha"))
    filter_map_take_for_source.push(String_from("go"))
    filter_map_take_for_source.push(String_from("bravo"))
    let filter_map_take_total = total_string_lengths(filter_map_take_for_source.iter().filter(keep_long_string).map(map_identity).take(1))
    Test::assert_eq_i32(filter_map_take_total, 5)

    let mut skip_map_source: Vec<String> = Vec::new<String>()
    skip_map_source.push(String_from("alpha"))
    skip_map_source.push(String_from("go"))
    skip_map_source.push(String_from("bravo"))
    let skip_map = skip_map_source.iter().skip(1).map(map_identity).collect()
    Test::assert_eq_i32(skip_map.len(), 2)
    Test::assert_eq_string(get_unchecked(skip_map, 0), "go")
    Test::assert_eq_string(get_unchecked(skip_map, 1), "bravo")

    let mut skip_map_from_iter_source: Vec<String> = Vec::new<String>()
    skip_map_from_iter_source.push(String_from("alpha"))
    skip_map_from_iter_source.push(String_from("go"))
    skip_map_from_iter_source.push(String_from("bravo"))
    let mut skip_map_adapter = skip_map_from_iter_source.iter().skip(1).map(map_identity)
    let skip_map_from_iter: Vec<String> = Vec::from_iter(skip_map_adapter)
    Test::assert_eq_i32(skip_map_from_iter.len(), 2)
    Test::assert_eq_string(get_unchecked(skip_map_from_iter, 0), "go")
    Test::assert_eq_string(get_unchecked(skip_map_from_iter, 1), "bravo")

    let mut skip_map_for_source: Vec<String> = Vec::new<String>()
    skip_map_for_source.push(String_from("alpha"))
    skip_map_for_source.push(String_from("go"))
    skip_map_for_source.push(String_from("bravo"))
    let skip_map_total = total_string_lengths(skip_map_for_source.iter().skip(1).map(map_identity))
    Test::assert_eq_i32(skip_map_total, 7)

    let mut skip_filter_source: Vec<String> = Vec::new<String>()
    skip_filter_source.push(String_from("alpha"))
    skip_filter_source.push(String_from("go"))
    skip_filter_source.push(String_from("bravo"))
    let skip_filter = skip_filter_source.iter().skip(1).filter(keep_long_string).collect()
    Test::assert_eq_i32(skip_filter.len(), 1)
    Test::assert_eq_string(get_unchecked(skip_filter, 0), "bravo")

    let mut skip_filter_from_iter_source: Vec<String> = Vec::new<String>()
    skip_filter_from_iter_source.push(String_from("alpha"))
    skip_filter_from_iter_source.push(String_from("go"))
    skip_filter_from_iter_source.push(String_from("bravo"))
    let mut skip_filter_adapter = skip_filter_from_iter_source.iter().skip(1).filter(keep_long_string)
    let skip_filter_from_iter: Vec<String> = Vec::from_iter(skip_filter_adapter)
    Test::assert_eq_i32(skip_filter_from_iter.len(), 1)
    Test::assert_eq_string(get_unchecked(skip_filter_from_iter, 0), "bravo")

    let mut skip_filter_for_source: Vec<String> = Vec::new<String>()
    skip_filter_for_source.push(String_from("alpha"))
    skip_filter_for_source.push(String_from("go"))
    skip_filter_for_source.push(String_from("bravo"))
    let skip_filter_total = total_string_lengths(skip_filter_for_source.iter().skip(1).filter(keep_long_string))
    Test::assert_eq_i32(skip_filter_total, 5)

}
