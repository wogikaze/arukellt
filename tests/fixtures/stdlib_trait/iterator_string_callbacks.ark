use std::core::iter
use std::test

fn map_identity(value: String) -> String {
    clone(value)
}

fn keep_long_string(value: String) -> bool {
    len(value) > 3
}

fn collect_from_iterator<T: iter::Iterator>(iterator: T) -> Vec<T::Item> {
    Vec::from_iter(iterator)
}

fn total_string_lengths<T: iter::IntoIterator>(source: T) -> i32 {
    let mut total: i32 = 0
    for value in source {
        total = total + len(value)
    }
    total
}

fn main() {
    let map_source: Vec<String> = Vec::new<String>()
    push(map_source, String_from("alpha"))
    push(map_source, String_from("go"))
    let mapped = map_source.iter().map(map_identity).collect()
    test::assert_eq_i32(len(mapped), 2)
    test::assert_eq_string(get_unchecked(mapped, 0), "alpha")
    test::assert_eq_string(get_unchecked(mapped, 1), "go")

    let map_from_iter_source: Vec<String> = Vec::new<String>()
    push(map_from_iter_source, String_from("first"))
    push(map_from_iter_source, String_from("second"))
    let map_from_iter = map_from_iter_source.iter().map(map_identity)
    let mapped_from_iter: Vec<String> = Vec::from_iter(map_from_iter)
    test::assert_eq_i32(len(mapped_from_iter), 2)
    test::assert_eq_string(get_unchecked(mapped_from_iter, 0), "first")
    test::assert_eq_string(get_unchecked(mapped_from_iter, 1), "second")

    let filter_source: Vec<String> = Vec::new<String>()
    push(filter_source, String_from("alpha"))
    push(filter_source, String_from("go"))
    push(filter_source, String_from("bravo"))
    let filtered = filter_source.iter().filter(keep_long_string).collect()
    test::assert_eq_i32(len(filtered), 2)
    test::assert_eq_string(get_unchecked(filtered, 0), "alpha")
    test::assert_eq_string(get_unchecked(filtered, 1), "bravo")

    let filter_from_iter_source: Vec<String> = Vec::new<String>()
    push(filter_from_iter_source, String_from("alpha"))
    push(filter_from_iter_source, String_from("go"))
    push(filter_from_iter_source, String_from("bravo"))
    let filter_from_iter = filter_from_iter_source.iter().filter(keep_long_string)
    let filtered_from_iter: Vec<String> = Vec::from_iter(filter_from_iter)
    test::assert_eq_i32(len(filtered_from_iter), 2)
    test::assert_eq_string(get_unchecked(filtered_from_iter, 0), "alpha")
    test::assert_eq_string(get_unchecked(filtered_from_iter, 1), "bravo")

    let generic_from_iter_source: Vec<String> = Vec::new<String>()
    push(generic_from_iter_source, String_from("generic"))
    let generic_from_iter: Vec<String> = collect_from_iterator(generic_from_iter_source.iter().map(map_identity))
    test::assert_eq_i32(len(generic_from_iter), 1)
    test::assert_eq_string(get_unchecked(generic_from_iter, 0), "generic")

    let composed_source: Vec<String> = Vec::new<String>()
    push(composed_source, String_from("alpha"))
    push(composed_source, String_from("go"))
    push(composed_source, String_from("bravo"))
    let composed = composed_source.iter().map(map_identity).filter(keep_long_string).collect()
    test::assert_eq_i32(len(composed), 2)
    test::assert_eq_string(get_unchecked(composed, 0), "alpha")
    test::assert_eq_string(get_unchecked(composed, 1), "bravo")

    let composed_from_iter_source: Vec<String> = Vec::new<String>()
    push(composed_from_iter_source, String_from("alpha"))
    push(composed_from_iter_source, String_from("go"))
    push(composed_from_iter_source, String_from("bravo"))
    let composed_from_iter_source_adapter = composed_from_iter_source.iter().map(map_identity).filter(keep_long_string)
    let composed_from_iter: Vec<String> = Vec::from_iter(composed_from_iter_source_adapter)
    test::assert_eq_i32(len(composed_from_iter), 2)
    test::assert_eq_string(get_unchecked(composed_from_iter, 0), "alpha")
    test::assert_eq_string(get_unchecked(composed_from_iter, 1), "bravo")

    let reverse_composed_source: Vec<String> = Vec::new<String>()
    push(reverse_composed_source, String_from("alpha"))
    push(reverse_composed_source, String_from("go"))
    push(reverse_composed_source, String_from("bravo"))
    let reverse_composed = reverse_composed_source.iter().filter(keep_long_string).map(map_identity).collect()
    test::assert_eq_i32(len(reverse_composed), 2)
    test::assert_eq_string(get_unchecked(reverse_composed, 0), "alpha")
    test::assert_eq_string(get_unchecked(reverse_composed, 1), "bravo")

    let reverse_from_iter_source: Vec<String> = Vec::new<String>()
    push(reverse_from_iter_source, String_from("alpha"))
    push(reverse_from_iter_source, String_from("go"))
    push(reverse_from_iter_source, String_from("bravo"))
    let reverse_from_iter_adapter = reverse_from_iter_source.iter().filter(keep_long_string).map(map_identity)
    let reverse_from_iter: Vec<String> = Vec::from_iter(reverse_from_iter_adapter)
    test::assert_eq_i32(len(reverse_from_iter), 2)
    test::assert_eq_string(get_unchecked(reverse_from_iter, 0), "alpha")
    test::assert_eq_string(get_unchecked(reverse_from_iter, 1), "bravo")

    let generic_for_source: Vec<String> = Vec::new<String>()
    push(generic_for_source, String_from("alpha"))
    push(generic_for_source, String_from("go"))
    push(generic_for_source, String_from("bravo"))
    let generic_for_total = total_string_lengths(generic_for_source.iter().filter(keep_long_string).map(map_identity))
    test::assert_eq_i32(generic_for_total, 10)

}
