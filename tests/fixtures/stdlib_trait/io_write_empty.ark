use std::io
use std::test::Test

fn main() {
    let mut w: io::Writer = io::Writer::new()
    let data: Vec<i32> = Vec::new<i32>()

    match w.write(data) {
        Result::Ok(written) => Test::assert_eq_i32(written, 0),
        Result::Err(e) => Std::panic(e.message()),
    }

    Test::assert_eq_i32(w.into_bytes().len(), 0)
}
