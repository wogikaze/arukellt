// For-in iteration over HashMap<K, V> through IntoIterator.
// Items are owned (K, V) snapshots; bucket order is implementation-defined,
// so every assertion is order-agnostic.
use std::test::Test

fn main() {
    // HashMap<i32, i32> — flat-map alias path shared by both backends.
    let mut numbers = HashMap::new<i32, i32>()
    let _ = numbers.insert(10, 100)
    let _ = numbers.insert(20, 200)
    let _ = numbers.insert(30, 300)
    let mut count: i32 = 0
    let mut key_sum: i32 = 0
    let mut value_sum: i32 = 0
    for pair in numbers {
        let (key, value) = pair
        count = count + 1
        key_sum = key_sum + key
        value_sum = value_sum + value
    }
    Test::assert_eq_i32(count, 3)
    Test::assert_eq_i32(key_sum, 60)
    Test::assert_eq_i32(value_sum, 600)

    // HashMap<String, i32> — String keys over the __hm_si_* slot layout.
    let mut words = HashMap::new<String, i32>()
    let _ = words.insert("alpha", 1)
    let _ = words.insert("beta", 22)
    let mut word_count: i32 = 0
    let mut key_len_total: i32 = 0
    let mut word_value_total: i32 = 0
    for pair in words {
        let (key, value) = pair
        word_count = word_count + 1
        key_len_total = key_len_total + key.len()
        word_value_total = word_value_total + value
    }
    Test::assert_eq_i32(word_count, 2)
    Test::assert_eq_i32(key_len_total, 9)
    Test::assert_eq_i32(word_value_total, 23)

    // HashMap<i32, String> — i32 keys over the __hm_is_* slot layout.
    let mut labels = HashMap::new<i32, String>()
    let _ = labels.insert(7, "seven")
    let _ = labels.insert(9, "nine")
    let mut label_sum: i32 = 0
    let mut label_len: i32 = 0
    for pair in labels {
        let (key, value) = pair
        label_sum = label_sum + key
        label_len = label_len + value.len()
    }
    Test::assert_eq_i32(label_sum, 16)
    Test::assert_eq_i32(label_len, 9)

    // HashMap<String, String> — String keys over the __hm_ss_* slot layout.
    let mut pairs = HashMap::new<String, String>()
    let _ = pairs.insert("k1", "v1")
    let _ = pairs.insert("k2", "v2")
    let _ = pairs.insert("k3", "v3")
    let mut pair_key_len: i32 = 0
    let mut pair_value_len: i32 = 0
    for pair in pairs {
        let (key, value) = pair
        pair_key_len = pair_key_len + key.len()
        pair_value_len = pair_value_len + value.len()
    }
    Test::assert_eq_i32(pair_key_len, 6)
    Test::assert_eq_i32(pair_value_len, 6)

    // Empty maps iterate zero times.
    let empty = HashMap::new<i32, i32>()
    let mut empty_count: i32 = 0
    for pair in empty {
        let (_key, _value) = pair
        empty_count = empty_count + 1
    }
    Test::assert_eq_i32(empty_count, 0)
}
