use std::core::iter
use std::test::Test

fn running_sum(state: i32, x: i32) -> Option<i32> {
    let s: i32 = state + x
    if s > 6 {
        return None
    }
    Some(s)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5)

    // step_by yields every n-th element.
    let stepped = v.iter().step_by(2).collect()
    Test::assert_eq_i32(len(stepped), 3)
    Test::assert_eq_i32(get_unchecked(stepped, 0), 1)
    Test::assert_eq_i32(get_unchecked(stepped, 1), 3)
    Test::assert_eq_i32(get_unchecked(stepped, 2), 5)

    // A non-positive step is clamped to 1 instead of stalling.
    let clamped = v.iter().step_by(0).take(2).collect()
    Test::assert_eq_i32(len(clamped), 2)
    Test::assert_eq_i32(get_unchecked(clamped, 0), 1)
    Test::assert_eq_i32(get_unchecked(clamped, 1), 2)

    // scan threads state through f and stops when f returns None.
    let mut it = v.iter().scan(0, running_sum)
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 1),
        None => Std::panic("expected Some"),
    }
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 3),
        None => Std::panic("expected Some"),
    }
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 6),
        None => Std::panic("expected Some"),
    }
    // 6 + 4 = 10 > 6, so f returned None and the adapter stays exhausted.
    match it.next() {
        Some(_) => Std::panic("expected None"),
        None => {}
    }
    match it.next() {
        Some(_) => Std::panic("expected None"),
        None => {}
    }
}
