use std::core::iter
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(2147483647)
    v.push(0)
    v.push(-2147483647)

    Test::assert_eq_i32(v.get_unchecked(0), 2147483647)
    Test::assert_eq_i32(v.get_unchecked(1), 0)
    Test::assert_eq_i32(v.get_unchecked(2), -2147483647)

    let collected = v.iter().take(1).collect()
    Test::assert_eq_i32(collected.get_unchecked(0), 2147483647)
}
