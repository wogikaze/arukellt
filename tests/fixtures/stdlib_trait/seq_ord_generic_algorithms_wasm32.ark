// The Vec<T: Ord> receiver algorithms that replaced the generic std::seq
// frees: binary_search, lower_bound, upper_bound, min/max,
// binary_search_by_key, and min_by_key/max_by_key on the concrete i32
// instantiation. sort is covered by the ord_sort_* fixtures instead.
use std::collections::vec
use std::test

fn key_identity(x: i32) -> i32 {
    x
}

fn key_negate(x: i32) -> i32 {
    0 - x
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 3)
    push(v, 5)
    push(v, 7)

    test::assert_eq_i32(v.lower_bound(5), 2)
    test::assert_eq_i32(v.lower_bound(4), 2)
    test::assert_eq_i32(v.lower_bound(9), 4)
    test::assert_eq_i32(v.upper_bound(5), 3)
    test::assert_eq_i32(v.upper_bound(4), 2)
    test::assert_eq_i32(v.upper_bound(7), 4)

    test::assert_eq_i32(v.binary_search(5), 2)
    test::assert_eq_i32(v.binary_search(4), 0 - 1)

    test::assert_eq_i32(v.min(), 1)
    test::assert_eq_i32(v.max(), 7)

    test::assert_eq_i32(v.binary_search_by_key(5, key_identity), 2)
    test::assert_eq_i32(v.binary_search_by_key(4, key_identity), 0 - 1)

    test::assert_eq_i32(v.min_by_key(key_identity), 1)
    test::assert_eq_i32(v.max_by_key(key_identity), 7)
    test::assert_eq_i32(v.min_by_key(key_negate), 7)
    test::assert_eq_i32(v.max_by_key(key_negate), 1)
}
