// Property: filter result length is always <= source length.
use std::core::iter
use std::test::Test

fn is_even(x: i32) -> bool { x / 2 * 2 == x }

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    for i in 0..50 {
        push(v, i)
    }
    let filtered = v.iter().filter(is_even).collect()
    Test::assert_true(filtered.len() <= v.len())
    Test::assert_eq_i32(filtered.len(), 25)
}
