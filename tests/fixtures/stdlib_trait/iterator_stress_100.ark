use std::core::iter
use std::test::Test

fn double(x: i32) -> i32 { x * 2 }
fn add(a: i32, b: i32) -> i32 { a + b }

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    for i in 0..100 {
        push(v, i)
    }
    Test::assert_eq_i32(v.len(), 100)

    let doubled = v.iter().map(double).collect()
    Test::assert_eq_i32(doubled.len(), 100)
    Test::assert_eq_i32(doubled.get_unchecked(0), 0)
    Test::assert_eq_i32(doubled.get_unchecked(50), 100)
    Test::assert_eq_i32(doubled.get_unchecked(99), 198)

    let sum = v.iter().fold(0, add)
    Test::assert_eq_i32(sum, 4950)
}
