// Generic Ord-based std::seq algorithms behind the deprecated i32
// wrappers: lower_bound, upper_bound, binary_search_by_key,
// min_by_key, and max_by_key on the concrete i32 instantiation.
// sort_by is covered by the ord_sort_* fixtures instead.
use std::seq
use std::test

fn key_identity(x: i32) -> i32 {
    x
}

fn key_negate(x: i32) -> i32 {
    0 - x
}

fn main() {
    let v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 3)
    push(v, 5)
    push(v, 7)

    test::assert_eq_i32(seq::lower_bound(v, 5), 2)
    test::assert_eq_i32(seq::lower_bound(v, 4), 2)
    test::assert_eq_i32(seq::lower_bound(v, 9), 4)
    test::assert_eq_i32(seq::upper_bound(v, 5), 3)
    test::assert_eq_i32(seq::upper_bound(v, 4), 2)
    test::assert_eq_i32(seq::upper_bound(v, 7), 4)

    test::assert_eq_i32(seq::binary_search_by_key(v, 5, key_identity), 2)
    test::assert_eq_i32(seq::binary_search_by_key(v, 4, key_identity), 0 - 1)

    test::assert_eq_i32(seq::min_by_key(v, key_identity), 1)
    test::assert_eq_i32(seq::max_by_key(v, key_identity), 7)
    test::assert_eq_i32(seq::min_by_key(v, key_negate), 7)
    test::assert_eq_i32(seq::max_by_key(v, key_negate), 1)
}
