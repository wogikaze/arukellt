use std::core::iter
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 100)
    push(v, 200)
    push(v, 300)

    let mut it = v.iter().enumerate()
    match it.next() {
        Some(p) => {
            test::assert_eq_i32(p.first, 0)
            test::assert_eq_i32(p.second, 100)
        },
        None => Std::panic("expected Some"),
    }
    let mut it2 = v.iter().enumerate()
    match it2.next() {
        Some(p) => {
            test::assert_eq_i32(p.first, 0)
            test::assert_eq_i32(p.second, 100)
        },
        None => Std::panic("expected Some"),
    }
    match it2.next() {
        Some(p) => {
            test::assert_eq_i32(p.first, 1)
            test::assert_eq_i32(p.second, 200)
        },
        None => Std::panic("expected Some"),
    }
    match it2.next() {
        Some(p) => {
            test::assert_eq_i32(p.first, 2)
            test::assert_eq_i32(p.second, 300)
        },
        None => Std::panic("expected Some"),
    }
    match it2.next() {
        Some(_) => Std::panic("expected None"),
        None => {}
    }
}
