use std::core::iter
use std::test

fn main() {
    let v: Vec<i32> = Vec::new<i32>()
    push(v, 100)
    push(v, 200)
    push(v, 300)

    let it = iter::enumerate_iter(v)
    match it.next() {
        Some(p) => {
            test::assert_eq_i32(p.first, 0)
            test::assert_eq_i32(p.second, 100)
        },
        None => panic("expected Some"),
    }
    let it2 = iter::enumerate_iter(v)
    match it2.next() {
        Some(p) => {
            test::assert_eq_i32(p.first, 0)
            test::assert_eq_i32(p.second, 100)
        },
        None => panic("expected Some"),
    }
    match it2.next() {
        Some(p) => {
            test::assert_eq_i32(p.first, 1)
            test::assert_eq_i32(p.second, 200)
        },
        None => panic("expected Some"),
    }
    match it2.next() {
        Some(p) => {
            test::assert_eq_i32(p.first, 2)
            test::assert_eq_i32(p.second, 300)
        },
        None => panic("expected Some"),
    }
    match it2.next() {
        Some(_) => panic("expected None"),
        None => {}
    }
}
