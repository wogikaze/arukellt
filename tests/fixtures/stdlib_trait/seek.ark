// Issue #693: Seek moves the Reader cursor with SeekFrom origins.
//
// The legacy `seek_to` clamp is gone: seeking past the end is allowed and
// reads report EOF, while a negative effective position is an error.
use std::host::stdio::Stdio
use std::io
use std::io::SeekFrom

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push(65)  // 'A'
    data.push(66)  // 'B'
    data.push(67)  // 'C'
    data.push(68)  // 'D'
    data.push(69)  // 'E'
    let mut r: io::Reader = io::Reader::from_bytes(data)
    assert(r.len() == 5)

    match r.seek(SeekFrom::Start(2i64)) {
        Result::Ok(pos) => assert(pos == 2i64),
        Result::Err(_e) => assert(false),
    }
    match r.read(1) {
        Result::Ok(one) => {
            assert(one.len() == 1)
            assert(one.get_unchecked(0) == 67)
        },
        Result::Err(_e) => assert(false),
    }

    match r.seek(SeekFrom::Start(0i64)) {
        Result::Ok(pos) => assert(pos == 0i64),
        Result::Err(_e) => assert(false),
    }
    match r.read(1) {
        Result::Ok(one) => assert(one.get_unchecked(0) == 65),
        Result::Err(_e) => assert(false),
    }

    match r.seek(SeekFrom::End(0i64)) {
        Result::Ok(pos) => assert(pos == 5i64),
        Result::Err(_e) => assert(false),
    }
    match r.read(1) {
        Result::Ok(one) => assert(one.len() == 0),
        Result::Err(_e) => assert(false),
    }

    match r.seek(SeekFrom::Start(0i64 - 1i64)) {
        Result::Ok(_) => assert(false),
        Result::Err(_) => assert(true),
    }

    Stdio::println("OK")
}
