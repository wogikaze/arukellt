use std::test::Test
use std::collections::vec
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    // Insert in reverse order
    for i in 0..50 {
        push(v, 49 - i)
    }

    v.sort()
    let s = v
    Test::assert_eq_i32(s.len(), 50)
    for i in 0..50 {
        Test::assert_eq_i32(s.get_unchecked(i), i)
    }
}
