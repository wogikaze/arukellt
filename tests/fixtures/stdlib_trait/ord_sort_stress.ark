use std::seq
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    // Insert in reverse order
    for i in 0..50 {
        push(v, 49 - i)
    }

    let s = seq::sort_by(v)
    Test::assert_eq_i32(len(s), 50)
    for i in 0..50 {
        Test::assert_eq_i32(get_unchecked(s, i), i)
    }
}
