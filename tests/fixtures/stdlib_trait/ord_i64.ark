use std::core::cmp
use std::test

fn main() {
    let a: i64 = 100i64
    let b: i64 = 200i64
    match a.cmp(b) {
        Ordering::Less => {}
        _ => Std::panic("expected Less"),
    }

    let c: i64 = 200i64
    match b.cmp(c) {
        Ordering::Equal => {}
        _ => Std::panic("expected Equal"),
    }

    let d: i64 = 50i64
    match b.cmp(d) {
        Ordering::Greater => {}
        _ => Std::panic("expected Greater"),
    }
}
