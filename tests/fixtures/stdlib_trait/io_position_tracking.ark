use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push(1)
    data.push(2)
    data.push(3)
    data.push(4)
    data.push(5)
    let mut r: io::Reader = io::Reader::from_bytes(data)

    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 0),
        Result::Err(e) => Std::panic(e.message()),
    }
    match r.read(2) {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(e.message()),
    }
    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 2),
        Result::Err(e) => Std::panic(e.message()),
    }
    match r.read(2) {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(e.message()),
    }
    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 4),
        Result::Err(e) => Std::panic(e.message()),
    }
    match r.read(2) {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(e.message()),
    }
    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 5),
        Result::Err(e) => Std::panic(e.message()),
    }
}
