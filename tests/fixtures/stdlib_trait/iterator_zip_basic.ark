use std::core::iter
use std::test::Test

fn main() {
    let mut a: Vec<i32> = Vec::new<i32>()
    a.push(1)
    a.push(2)
    a.push(3)
    let mut b: Vec<i32> = Vec::new<i32>()
    b.push(10)
    b.push(20)
    b.push(30)

    let mut it = a.iter().zip(b.iter())
    match it.next() {
        Some(p) => {
            Test::assert_eq_i32(p.first, 1)
            Test::assert_eq_i32(p.second, 10)
        },
        None => Std::panic("expected Some"),
    }
    match it.next() {
        Some(p) => {
            Test::assert_eq_i32(p.first, 2)
            Test::assert_eq_i32(p.second, 20)
        },
        None => Std::panic("expected Some"),
    }
    match it.next() {
        Some(p) => {
            Test::assert_eq_i32(p.first, 3)
            Test::assert_eq_i32(p.second, 30)
        },
        None => Std::panic("expected Some"),
    }
    match it.next() {
        Some(_) => Std::panic("expected None"),
        None => {}
    }
}
