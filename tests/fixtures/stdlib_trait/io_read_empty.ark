use std::io
use std::test::Test

fn main() {
    let mut r: io::Reader = io::Reader::new()
    match r.read(10) {
        Result::Ok(read) => Test::assert_eq_i32(len(read), 0),
        Result::Err(e) => Std::panic(e.message()),
    }
    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 0),
        Result::Err(e) => Std::panic(e.message()),
    }
}
