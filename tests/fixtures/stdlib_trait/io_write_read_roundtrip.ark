use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 72)
    push(data, 101)
    push(data, 108)
    push(data, 108)
    push(data, 111)
    let mut w: io::Writer = io::Writer::new()
    match w.write(data) {
        Result::Ok(written) => Test::assert_eq_i32(written, 5),
        Result::Err(e) => Std::panic(e.message()),
    }

    let mut r: io::Reader = w.into_reader()
    match r.read(5) {
        Result::Ok(read) => {
            Test::assert_eq_i32(len(read), 5)
            Test::assert_eq_i32(get_unchecked(read, 0), 72)
            Test::assert_eq_i32(get_unchecked(read, 1), 101)
            Test::assert_eq_i32(get_unchecked(read, 2), 108)
            Test::assert_eq_i32(get_unchecked(read, 3), 108)
            Test::assert_eq_i32(get_unchecked(read, 4), 111)
        },
        Result::Err(e) => Std::panic(e.message()),
    }

    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 5),
        Result::Err(e) => Std::panic(e.message()),
    }
}
