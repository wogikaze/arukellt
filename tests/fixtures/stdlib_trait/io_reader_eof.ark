use std::io
use std::test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    push(data, 1)
    push(data, 2)
    let reader: io::Reader = io::Reader::from_bytes(data)

    test::assert_false(reader.is_eof())

    match reader.read(2) {
        Result::Ok(_) => (),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    test::assert_true(reader.is_eof())
}
