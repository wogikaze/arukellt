use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 1)
    push(data, 2)
    let mut reader: io::Reader = io::Reader::from_bytes(data)

    Test::assert_false(reader.is_eof())

    match reader.read(2) {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(e.message()),
    }
    Test::assert_true(reader.is_eof())
}
