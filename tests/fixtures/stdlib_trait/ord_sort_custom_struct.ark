use std::test::Test
// Vec<T: Ord> method surface with a custom-struct element. The comparator
// must dispatch to the parametric `impl<T> Ord for Reverse<T>` instance for
// sort, is_sorted, min and max instead of lowering an unresolved
// `Reverse_<arg>::cmp` stub (#965).
use std::collections::vec
use std::core::cmp
use std::host::stdio::Stdio

fn show(values: Vec<cmp::Reverse<i32>>) {
    let mut index: i32 = 0
    while index < values.len() {
        Stdio::println(values.get_unchecked(index).inner.to_string())
        index = index + 1
    }
}

fn main() {
    let mut values: Vec<cmp::Reverse<i32>> = Vec::new<cmp::Reverse<i32>>()
    values.push(cmp::Reverse { inner: 1 })
    values.push(cmp::Reverse { inner: 5 })
    values.push(cmp::Reverse { inner: 3 })
    values.push(cmp::Reverse { inner: 2 })
    values.push(cmp::Reverse { inner: 4 })
    values.sort()
    show(values)
    Stdio::println(values.is_sorted().to_string())
    Stdio::println(values.min().inner.to_string())
    Stdio::println(values.max().inner.to_string())
}
