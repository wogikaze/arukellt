use std::core::hash
use std::test::Test

fn main() {
    let h1: i32 = hash(1)
    let h2: i32 = hash(2)
    let combined: i32 = h1.combine_hash(h2)

    // combine is deterministic
    Test::assert_eq_i32(combined, h1.combine_hash(h2))

    // combine is non-negative
    Test::assert_true(combined >= 0)

    // hash_combine is an alias for combine
    Test::assert_eq_i32(combined, h1.combine_hash(h2))
}
