use std::core::iter
use std::test::Test

fn double(x: i32) -> i32 { x * 2 }
fn is_even(x: i32) -> bool { x / 2 * 2 == x }

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5)
    push(v, 6)

    // map then filter then take(2): [2,4] from [2,4,6,8,10,12]
    let result = v.iter().map(double).filter(is_even).take(2).collect()
    Test::assert_eq_i32(result.len(), 2)
    Test::assert_eq_i32(result.get_unchecked(0), 2)
    Test::assert_eq_i32(result.get_unchecked(1), 4)
}
