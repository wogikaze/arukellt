use std::core::iter
use std::test::Test

fn double(x: i32) -> i32 { x * 2 }
fn is_even(x: i32) -> bool { x / 2 * 2 == x }

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)
    v.push(6)

    // map then filter then take(2): [2,4] from [2,4,6,8,10,12]
    let result = v.iter().map(double).filter(is_even).take(2).collect()
    Test::assert_eq_i32(result.len(), 2)
    Test::assert_eq_i32(get_unchecked(result, 0), 2)
    Test::assert_eq_i32(get_unchecked(result, 1), 4)
}
