use std::core::iter
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)

    let skipped = v.iter().skip(0).collect()
    Test::assert_eq_i32(len(skipped), 3)
    Test::assert_eq_i32(get_unchecked(skipped, 0), 1)
    Test::assert_eq_i32(get_unchecked(skipped, 1), 2)
    Test::assert_eq_i32(get_unchecked(skipped, 2), 3)
}
