use std::core::iter
use std::test::Test

fn always_true(x: i32) -> bool { true }

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)

    let filtered = v.iter().filter(always_true).collect()
    Test::assert_eq_i32(filtered.len(), 3)
    Test::assert_eq_i32(filtered.get_unchecked(0), 10)
    Test::assert_eq_i32(filtered.get_unchecked(1), 20)
    Test::assert_eq_i32(filtered.get_unchecked(2), 30)
}
