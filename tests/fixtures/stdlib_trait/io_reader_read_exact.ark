use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push(10)
    data.push(20)
    data.push(30)
    let mut reader: io::Reader = io::Reader::from_bytes(data)

    match io::Io::read_exact(reader, 2) {
        Result::Ok(bytes) => {
            Test::assert_eq_i32(bytes.len(), 2)
            Test::assert_eq_i32(get_unchecked(bytes, 0), 10)
            Test::assert_eq_i32(get_unchecked(bytes, 1), 20)
        },
        Result::Err(_e) => Std::panic("expected Ok"),
    }

    // Only 1 byte left, requesting 5 should fail
    match io::Io::read_exact(reader, 5) {
        Result::Ok(_) => Std::panic("expected Err"),
        Result::Err(_e) => {}
    }
}
