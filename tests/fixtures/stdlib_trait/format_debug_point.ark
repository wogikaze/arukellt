use std::core::cmp
use std::core::convert
use std::test::Test
use std::text::fmt
use std::text
struct Point {
    x: i32,
    y: i32,
}

impl Eq for Point {
    fn eq(self: Point, other: Point) -> bool {
        self.x == other.x && self.y == other.y
    }
}

impl Debug for Point {
    fn fmt_debug(self: Point) -> String {
        "Point { x: ".concat((self.x).to_string().concat(", y: ".concat((self.y).to_string().concat(" }"))))
    }
}

fn main() {
    let p = Point { x: 1, y: 2 }
    Test::assert_eq_string(p.fmt_debug(), "Point { x: 1, y: 2 }")
    Test::assert_eq_string("p=".concat(p.fmt_debug()), "p=Point { x: 1, y: 2 }")
}
