// Query consumers and lazy adapters on the concrete i32 iterator lane:
// contains / count_eq capabilities, unique / rev adapters, and the Vec
// receiver queries that replaced the removed std::seq helpers.
use std::core::iter
use std::test::Test

fn is_even(x: i32) -> bool {
    x / 2 * 2 == x
}

fn double(x: i32) -> i32 {
    x * 2
}

fn add_acc(a: i32, b: i32) -> i32 {
    a + b
}

fn sum_into_for<T: IntoIterator>(source: T) -> i32 {
    let mut total: i32 = 0
    for item in source {
        total = total + item
    }
    total
}

fn sum_via_iter<T: Iterator>(it: T) -> i32 {
    let mut total: i32 = 0
    for item in it {
        total = total + item
    }
    total
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 3)
    push(v, 1)
    push(v, 4)
    push(v, 1)
    push(v, 5)
    push(v, 4)

    // Membership and equality counting through the capability traits.
    Test::assert_true(v.iter().contains(4))
    Test::assert_true(!v.iter().contains(2))
    Test::assert_eq_i32(v.iter().count_eq(1), 2)
    Test::assert_eq_i32(v.iter().count_eq(4), 2)
    Test::assert_eq_i32(v.iter().count_eq(9), 0)

    // The same capabilities resolve on composed lazy adapters.
    Test::assert_true(v.iter().filter(is_even).contains(4))
    Test::assert_true(!v.iter().filter(is_even).contains(1))
    Test::assert_eq_i32(v.iter().map(double).count_eq(8), 2)

    // The collapsed TakeIter<Src> instantiations keep the same
    // capability surface the fused *TakeIter types carried.
    Test::assert_eq_i32(v.iter().map(double).take(2).sum(), 8)
    Test::assert_true(v.iter().filter(is_even).take(1).contains(4))
    Test::assert_eq_i32(v.iter().skip(1).take(2).count_eq(1), 1)

    // fold threads an accumulator through the canonical IteratorFold
    // path; the fn item is passed as a callback argument.
    Test::assert_eq_i32(v.iter().fold(0, add_acc), 18)
    Test::assert_eq_i32(v.iter().map(double).fold(0, add_acc), 36)
    Test::assert_eq_i32(v.iter().take(3).fold(0, add_acc), 8)

    // unique yields first occurrences in source order.
    let uniq: Vec<i32> = v.iter().unique().collect()
    Test::assert_eq_i32(uniq.len(), 4)
    Test::assert_eq_i32(get_unchecked(uniq, 0), 3)
    Test::assert_eq_i32(get_unchecked(uniq, 1), 1)
    Test::assert_eq_i32(get_unchecked(uniq, 2), 4)
    Test::assert_eq_i32(get_unchecked(uniq, 3), 5)

    // rev yields the remaining elements in reverse order.
    let rev: Vec<i32> = v.iter().rev().collect()
    Test::assert_eq_i32(rev.len(), 6)
    Test::assert_eq_i32(get_unchecked(rev, 0), 4)
    Test::assert_eq_i32(get_unchecked(rev, 1), 5)
    Test::assert_eq_i32(get_unchecked(rev, 5), 3)

    // Both adapters keep the IntoIterator and FromIterator boundaries. A
    // `T: Iterator` source is consumed by `for` without a conversion step.
    Test::assert_eq_i32(sum_into_for(v.iter().unique()), 13)
    Test::assert_eq_i32(sum_into_for(v.iter().rev()), 18)
    Test::assert_eq_i32(sum_via_iter(v.iter().rev()), 18)
    let via_from: Vec<i32> = Vec::from_iter(v.iter().unique())
    Test::assert_eq_i32(via_from.len(), 4)
    let via_from_rev: Vec<i32> = Vec::from_iter(v.iter().rev())
    Test::assert_eq_i32(get_unchecked(via_from_rev, 0), 4)

    // The removed std::seq helpers map onto the same lazy paths.
    Test::assert_true(v.iter().contains(5))
    Test::assert_true(!v.iter().contains(2))
    Test::assert_eq_i32(v.iter().count_eq(4), 2)
    let seq_uniq: Vec<i32> = v.iter().unique().collect()
    Test::assert_eq_i32(seq_uniq.len(), 4)
    let seq_rev: Vec<i32> = v.iter().rev().collect()
    Test::assert_eq_i32(get_unchecked(seq_rev, 0), 4)
}
