use std::io
use std::test

fn main() {
    let mut r: io::Reader = io::Reader::new()
    match r.fill_buf() {
        Result::Ok(filled) => test::assert_eq_i32(len(filled), 0),
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }

    match r.position() {
        Result::Ok(pos) => test::assert_eq_i64(pos, 0),
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
}
