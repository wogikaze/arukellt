use std::core::iter
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5)

    let taken = v.iter().take(3).collect()
    Test::assert_eq_i32(taken.len(), 3)
    Test::assert_eq_i32(taken.get_unchecked(0), 1)
    Test::assert_eq_i32(taken.get_unchecked(1), 2)
    Test::assert_eq_i32(taken.get_unchecked(2), 3)
}
