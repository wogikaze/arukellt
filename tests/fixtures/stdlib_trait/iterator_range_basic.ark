use std::core::{Range, RangeInclusive}
use std::core::iter
use std::test::Test

fn first_from_source<T: iter::IntoIterator>(source: T) -> Option<T::Item> {
    source.into_iter().next()
}

fn fold_values<T: iter::Iterator + iter::IteratorFold<i32, i32>>(mut iterator: T, init: i32, f: fn(i32, i32) -> i32) -> i32 {
    iterator.fold(init, f)
}

fn sum_into_for<T: iter::IntoIterator>(source: T) -> i32 {
    let mut total: i32 = 0
    for value in source {
        total = total + value
    }
    total
}

fn add_i32(a: i32, b: i32) -> i32 { a + b }

fn main() {
    let r = Range::new(0, 5)
    let collected = r.into_iter().collect()
    Test::assert_eq_i32(collected.len(), 5)
    Test::assert_eq_i32(collected.get_unchecked(0), 0)
    Test::assert_eq_i32(collected.get_unchecked(1), 1)
    Test::assert_eq_i32(collected.get_unchecked(2), 2)
    Test::assert_eq_i32(collected.get_unchecked(3), 3)
    Test::assert_eq_i32(collected.get_unchecked(4), 4)

    let source = Range::new(2, 5)
    let mut iterator = source.into_iter()
    match iterator.next() {
        Some(value) => Test::assert_eq_i32(value, 2),
        None => Std::panic("expected first range item"),
    }

    let generic_source = Range::new(7, 9)
    match first_from_source(generic_source) {
        Some(value) => Test::assert_eq_i32(value, 7),
        None => Std::panic("expected generic range item"),
    }

    let inclusive_source = RangeInclusive::new(3, 5)
    let mut inclusive_iterator = inclusive_source.into_iter()
    match inclusive_iterator.next() {
        Some(value) => Test::assert_eq_i32(value, 3),
        None => Std::panic("expected inclusive range item"),
    }
    Test::assert_eq_i32(inclusive_iterator.count(), 2)

    let collected_inclusive: Vec<i32> = RangeInclusive::new(4, 6).into_iter().collect()
    Test::assert_eq_i32(collected_inclusive.len(), 3)
    Test::assert_eq_i32(collected_inclusive.get_unchecked(2), 6)

    let from_iter_range: Vec<i32> = Vec::from_iter(Range::new(8, 11).into_iter())
    Test::assert_eq_i32(from_iter_range.len(), 3)
    Test::assert_eq_i32(from_iter_range.get_unchecked(2), 10)

    let from_iter_inclusive: Vec<i32> = Vec::from_iter(RangeInclusive::new(9, 11).into_iter())
    Test::assert_eq_i32(from_iter_inclusive.len(), 3)
    Test::assert_eq_i32(from_iter_inclusive.get_unchecked(2), 11)

    Test::assert_eq_i32(fold_values(Range::new(2, 5).into_iter(), 10, add_i32), 19)
    Test::assert_eq_i32(fold_values(RangeInclusive::new(1, 3).into_iter(), 0, add_i32), 6)

    let direct_range = Range::new(2, 5)
    let mut direct_range_total: i32 = 0
    for value in direct_range {
        direct_range_total = direct_range_total + value
    }
    Test::assert_eq_i32(direct_range_total, 9)

    let direct_inclusive = RangeInclusive::new(3, 5)
    let mut direct_inclusive_total: i32 = 0
    for value in direct_inclusive {
        direct_inclusive_total = direct_inclusive_total + value
    }
    Test::assert_eq_i32(direct_inclusive_total, 12)

    let mut direct_expression_total: i32 = 0
    for value in Range::new(2, 5) {
        direct_expression_total = direct_expression_total + value
    }
    Test::assert_eq_i32(direct_expression_total, 9)

    let mut direct_method_total: i32 = 0
    for value in RangeInclusive::new(3, 5).into_iter() {
        direct_method_total = direct_method_total + value
    }
    Test::assert_eq_i32(direct_method_total, 12)

    Test::assert_eq_i32(sum_into_for(Range::new(2, 5)), 9)
    Test::assert_eq_i32(sum_into_for(RangeInclusive::new(3, 5)), 12)
}
