use std::core
use std::core::iter
use std::test

fn first_from_source<T: iter::IntoIterator>(source: T) -> Option<T::Item> {
    source.into_iter().next()
}

fn main() {
    let r = core::range_new(0, 5)
    let collected = iter::collect_range_i32(r)
    test::assert_eq_i32(len(collected), 5)
    test::assert_eq_i32(get_unchecked(collected, 0), 0)
    test::assert_eq_i32(get_unchecked(collected, 1), 1)
    test::assert_eq_i32(get_unchecked(collected, 2), 2)
    test::assert_eq_i32(get_unchecked(collected, 3), 3)
    test::assert_eq_i32(get_unchecked(collected, 4), 4)

    let source = core::range_new(2, 5)
    let iterator = source.into_iter()
    match iterator.next() {
        Some(value) => test::assert_eq_i32(value, 2),
        None => panic("expected first range item"),
    }

    let generic_source = core::range_new(7, 9)
    match first_from_source(generic_source) {
        Some(value) => test::assert_eq_i32(value, 7),
        None => panic("expected generic range item"),
    }

    let inclusive_source = core::range_inclusive_new(3, 5)
    let inclusive_iterator = inclusive_source.into_iter()
    match inclusive_iterator.next() {
        Some(value) => test::assert_eq_i32(value, 3),
        None => panic("expected inclusive range item"),
    }
    test::assert_eq_i32(inclusive_iterator.count(), 2)
}
