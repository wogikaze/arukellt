// Issue #693: Io::copy moves bytes between concrete Reader and Writer handles
// through the Read / Write traits.
use std::host::stdio::Stdio
use std::io

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    push(data, 72)   // 'H'
    push(data, 101)  // 'e'
    push(data, 108)  // 'l'
    push(data, 108)  // 'l'
    push(data, 111)  // 'o'
    push(data, 32)   // ' '
    push(data, 87)   // 'W'
    push(data, 111)  // 'o'
    push(data, 114)  // 'r'
    push(data, 108)  // 'l'
    push(data, 100)  // 'd'
    let mut src: io::Reader = io::Reader::from_bytes(data)
    let mut dst: io::Writer = io::Writer::new()
    match io::Io::copy(src, dst) {
        Result::Ok(copied) => assert(copied == 11i64),
        Result::Err(_e) => assert(false),
    }
    let image: Vec<i32> = dst.into_bytes()
    assert(image.len() == 11)
    assert(get_unchecked(image, 0) == 72)
    assert(get_unchecked(image, 5) == 32)
    assert(get_unchecked(image, 10) == 100)
    Stdio::println("OK")
}
