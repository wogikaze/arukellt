// Free `clone(x)` and the receiver method `x.clone()` must reach one
// dispatch target: the registered Clone impl for the receiver type. Scalars
// use their copy impls, String uses `String::clone`, and a user-defined impl
// must win over the compiler's identity fallback.
use std::core::clone
use std::host::stdio
use std::prelude::{clone}
use std::test

struct Pair {
    a: i32,
    b: i32,
}

impl Clone for Pair {
    fn clone(self: Pair) -> Pair {
        Pair { a: self.a + 1, b: self.b + 1 }
    }
}

fn main() {
    let s = String_from("hello")
    test::assert_eq_string(clone(s), s.clone())
    test::assert_eq_string(s.clone(), "hello")

    let n: i32 = 42
    test::assert_eq_i32(clone(n), n.clone())

    let p = Pair { a: 1, b: 2 }
    let free_clone = clone(p)
    let method_clone = p.clone()
    test::assert_eq_i32(free_clone.a, 2)
    test::assert_eq_i32(free_clone.b, 3)
    test::assert_eq_i32(method_clone.a, 2)
    test::assert_eq_i32(method_clone.b, 3)

    stdio::println("OK")
}
