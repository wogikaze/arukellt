use std::test::Test
use std::collections::vec
use std::core::cmp
use std::host::stdio::Stdio

fn descending(a: i32, b: i32) -> Ordering {
    match a.cmp(b) {
        Ordering::Less => Ordering::Greater,
        Ordering::Equal => Ordering::Equal,
        Ordering::Greater => Ordering::Less,
    }
}

fn main() {
    let mut v = Vec::new<i32>()
    v.push(3)
    v.push(1)
    v.push(2)
    v.sort_by(descending)
    assert(v.get_unchecked(0) == 3)
    assert(v.get_unchecked(1) == 2)
    assert(v.get_unchecked(2) == 1)
    Stdio::println("OK")
}
