use std::collections::pq::PriorityQueue
use std::host::stdio::Stdio

fn show_i32(value: Option<i32>) {
    match value {
        Option::Some(item) => Stdio::println(item.to_string()),
        Option::None => Stdio::println(String_from("none")),
    }
}

fn main() {
    let mut queue: PriorityQueue<i32> = PriorityQueue::new<i32>()
    queue.clear()
    Stdio::println(queue.is_empty().to_string())
    queue.push(50)
    queue.push(10)
    queue.push(30)
    queue.push(5)
    Stdio::println(queue.len().to_string())
    show_i32(queue.peek())
    show_i32(queue.pop())
    show_i32(queue.pop())
    show_i32(queue.pop())
    Stdio::println(queue.len().to_string())
    queue.push(99)
    queue.clear()
    Stdio::println(queue.is_empty().to_string())
}
// pq_clear on empty
// push and peek
// pop in order (min-heap: smallest first)
// pq_clear
