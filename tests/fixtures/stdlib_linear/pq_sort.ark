use std::collections::pq::PriorityQueue
use std::host::stdio

fn pop_i32(mut queue: PriorityQueue<i32>) -> i32 {
    match queue.pop() {
        Option::Some(value) => value,
        Option::None => {
            assert(false)
            0
        },
    }
}

fn main() {
    let mut queue: PriorityQueue<i32> = PriorityQueue::new<i32>()

    // Push in arbitrary order
    queue.push(50)
    queue.push(10)
    queue.push(90)
    queue.push(30)
    queue.push(70)
    queue.push(20)
    queue.push(80)
    queue.push(40)
    queue.push(60)

    stdio::println(queue.len().to_string())  // 9

    // Pop all: should come out sorted ascending (min-heap)
    stdio::println(pop_i32(queue).to_string())  // 10
    stdio::println(pop_i32(queue).to_string())  // 20
    stdio::println(pop_i32(queue).to_string())  // 30
    stdio::println(pop_i32(queue).to_string())  // 40
    stdio::println(pop_i32(queue).to_string())  // 50
    stdio::println(pop_i32(queue).to_string())  // 60
    stdio::println(pop_i32(queue).to_string())  // 70
    stdio::println(pop_i32(queue).to_string())  // 80
    stdio::println(pop_i32(queue).to_string())  // 90

    stdio::println(queue.is_empty().to_string())  // true
    stdio::println(queue.len().to_string())  // 0
}
// pq_len after 9 pushes
// pq_pop returns sorted ascending (min-heap property)
// pq_is_empty after draining all
// pq_len after draining all
