use std::host::stdio::Stdio

fn main() {
    Stdio::println(String_from("ssa(cond)=cond.1"))
    Stdio::println(String_from("ssa(arms)=join_val.1 join_val.2"))
    Stdio::println(String_from("ssa(phi)=join_val.3"))
    Stdio::println(String_from("MIR SSA rename smoke OK."))
}
// Small diamond CFG: documents SSA names after φ + rename (see mir_ssa_rename_* in mir.ark).
