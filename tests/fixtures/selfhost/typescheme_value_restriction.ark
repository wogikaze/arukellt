// Test: immutable non-expansive values generalize, while environment types stay monomorphic.
use std::host::stdio::Stdio
fn main() {
    let id = |x| x
    let number: i32 = id(42)
    let flag: bool = id(true)
    let text: String = id(String_from("value restriction"))
    Stdio::println(number.to_string())
    if flag {
        Stdio::println(text)
    }
}
