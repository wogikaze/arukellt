// Test: array comprehension — field access on loop variable in element expr
use std::host::stdio::Stdio
use std::core::iter

struct Point {
    x: i32,
    y: i32,
}

fn main() {
    let mut pts: Vec<Point> = Vec::new<Point>()
    pts.push(Point { x: 1, y: 10 })
    pts.push(Point { x: 2, y: 20 })
    pts.push(Point { x: 3, y: 30 })
    let x_coords = [p.x for p in pts]
    let mut sum = 0
    for v in (x_coords) {
        sum = sum + v
    }
    Stdio::println(sum.to_string())
}
