// Test: array comprehension — [expr for x in iter] (map-only)
use std::host::stdio::Stdio
use std::core::iter

fn main() {
    let mut xs: Vec<i32> = Vec::new<i32>()
    push(xs, 10)
    push(xs, 20)
    push(xs, 30)
    let doubled = [x * 2 for x in xs]
    let mut sum = 0
    for v in (doubled) {
        sum = sum + v
    }
    Stdio::println(sum.to_string())
}
