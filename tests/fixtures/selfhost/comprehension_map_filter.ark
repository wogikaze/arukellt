// Test: array comprehension — [expr for x in iter if filter] (map + filter)
use std::host::stdio::Stdio
use std::core::iter

fn main() {
    let mut xs: Vec<i32> = Vec::new<i32>()
    xs.push(1)
    xs.push(2)
    xs.push(3)
    xs.push(4)
    xs.push(5)
    let evens_doubled = [x * 2 for x in xs if x % 2 == 0]
    let mut sum = 0
    for v in (evens_doubled) {
        sum = sum + v
    }
    Stdio::println(sum.to_string())
}
