// Positive fixture: single-clause function with = expr body
// Tests that a single expression-bodied fn works (degenerate clause case)
use std::host::stdio
use std::text
fn greet(name: String) -> String = String_from("Hello, ").concat(name.clone().concat(String_from("!")))

fn main() {
    stdio::println(greet(String_from("World")))
}
