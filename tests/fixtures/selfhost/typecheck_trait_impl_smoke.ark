use std::host::stdio::Stdio
struct MyStruct {
    value: i32,
}

trait Foo {
    fn id(x: MyStruct) -> i32
}

impl Foo for MyStruct {
    fn id(x: MyStruct) -> i32 {
        x.value
    }
}

fn take_foo<T: Foo>(x: T) -> T {
    x
}

fn main() {
    let item = take_foo(MyStruct { value: 7 })
    Stdio::println(item.value.to_string())
    let item2 = MyStruct { value: 42 }
    Stdio::println(item2.id().to_string())
    Stdio::println(String_from("issue504 trait impl ok"))
}
