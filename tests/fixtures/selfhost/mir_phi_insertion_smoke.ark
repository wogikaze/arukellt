use std::host::process::Process
use std::host::stdio::Stdio
use std::text
struct PhiArg {
    pred_block: i32,
    version: i32,
}

struct Phi {
    ssa_name: String,
    dest_version: i32,
    val_type: i32,
    args: Vec<PhiArg>,
}

struct Block {
    id: i32,
    preds: Vec<i32>,
    dom_frontier: Vec<i32>,
    last_value: i32,
}

fn Phi_new(ssa_name: String, dest_version: i32, val_type: i32) -> Phi {
    Phi { ssa_name: ssa_name, dest_version: dest_version, val_type: val_type, args: Vec::new<PhiArg>() }
}

fn phi_add_arg(mut phi: Phi, pred_block: i32, version: i32) {
    phi.args.push(PhiArg { pred_block: pred_block, version: version })
}

fn block_ids_contains(ids: Vec<i32>, block_id: i32) -> bool {
    let count = ids.len()
    let mut i = 0
    while i < count {
        if ids.get_unchecked(i) == block_id {
            return true
        }
        i = i + 1
    }
    false
}

fn format_ssa_value(ssa_name: String, version: i32) -> String {
    let mut out = String_from("%")
    out = out.concat(ssa_name)
    out = out.concat(String_from("."))
    out.concat(version.to_string())
}

fn try_insert_simple_join_phi(join_block: Block, pred0: Block, pred1: Block, ssa_name: String, dest_vt: i32) -> Phi {
    if join_block.preds.len() != 2 {
        Stdio::eprintln(String_from("join predecessor count mismatch"))
        Process::exit(1)
    }
    if !block_ids_contains(pred0.dom_frontier, join_block.id) {
        Stdio::eprintln(String_from("pred0 frontier missing join"))
        Process::exit(1)
    }
    if !block_ids_contains(pred1.dom_frontier, join_block.id) {
        Stdio::eprintln(String_from("pred1 frontier missing join"))
        Process::exit(1)
    }
    let mut phi = Phi_new(ssa_name, 3, dest_vt)
    phi_add_arg(phi, pred0.id, 1)
    phi_add_arg(phi, pred1.id, 2)
    phi
}

fn format_phi(phi: Phi) -> String {
    let arg0 = phi.args.get_unchecked(0)
    let arg1 = phi.args.get_unchecked(1)
    let mut out = String_from("phi ")
    out = out.concat(format_ssa_value(phi.ssa_name.clone(), phi.dest_version))
    out = out.concat(String_from(" = [bb"))
    out = out.concat(arg0.pred_block.to_string())
    out = out.concat(String_from(" -> "))
    out = out.concat(format_ssa_value(phi.ssa_name.clone(), arg0.version))
    out = out.concat(String_from(", bb"))
    out = out.concat(arg1.pred_block.to_string())
    out = out.concat(String_from(" -> "))
    out = out.concat(format_ssa_value(phi.ssa_name.clone(), arg1.version))
    out = out.concat(String_from("] : i32"))
    out
}

fn main() {
    let mut then_block = Block { id: 1, preds: Vec::new<i32>(), dom_frontier: Vec::new<i32>(), last_value: 1 }
    let mut else_block = Block { id: 2, preds: Vec::new<i32>(), dom_frontier: Vec::new<i32>(), last_value: 2 }
    let mut join_block = Block { id: 3, preds: Vec::new<i32>(), dom_frontier: Vec::new<i32>(), last_value: 0 - 1 }
    join_block.preds.push(then_block.id)
    join_block.preds.push(else_block.id)
    then_block.dom_frontier.push(join_block.id)
    else_block.dom_frontier.push(join_block.id)
    let phi = try_insert_simple_join_phi(join_block, then_block, else_block, String_from("join_val"), 1)
    Stdio::println(String_from("diamond join bb3"))
    Stdio::println(String_from("const.i32 -> ").concat(format_ssa_value(String_from("join_val"), 1)))
    Stdio::println(String_from("const.i32 -> ").concat(format_ssa_value(String_from("join_val"), 2)))
    Stdio::println(format_phi(phi))
    Stdio::println(String_from("MIR phi insertion smoke OK."))
}
