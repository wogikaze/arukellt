// Test: array comprehension used inline as a function argument
use std::host::stdio
use std::core::iter

fn sum_vec(v: Vec<i32>) -> i32 {
    let mut s = 0
    for x in (v) {
        s = s + x
    }
    s
}

fn main() {
    let mut xs: Vec<i32> = Vec::new<i32>()
    push(xs, 1)
    push(xs, 2)
    push(xs, 3)
    let result = sum_vec([x * 10 for x in xs])
    stdio::println(result.to_string())
}
