// Test: selfhost MIR expression lowering & control flow
// Exercises: int literals, binary ops, variable access, function calls,
//            let bindings, return, while loops, if expressions,
//            break, continue, nested control flow
use std::host::stdio::Stdio
fn add(a: i32, b: i32) -> i32 {
    a + b
}

fn mul_sub(x: i32, y: i32, z: i32) -> i32 {
    x * y - z
}

fn fib(n: i32) -> i32 {
    let mut a = 0
    let mut b = 1
    let mut i = 0
    while i < n {
        let tmp = b
        b = a + b
        a = tmp
        i = i + 1
    }
    a
}

fn max_val(a: i32, b: i32) -> i32 {
    if a > b {
        a
    } else {
        b
    }
}

fn find_first_ge(limit: i32) -> i32 {
    let mut i = 0
    while i < 100 {
        if i >= limit {
            break
        }
        i = i + 1
    }
    i
}

fn sum_skip_five(n: i32) -> i32 {
    let mut total = 0
    let mut i = 0
    while i < n {
        i = i + 1
        if i == 5 {
            continue
        }
        total = total + i
    }
    total
}

fn nested_loops() -> i32 {
    let mut count = 0
    let mut i = 0
    while i < 3 {
        let mut j = 0
        while j < 4 {
            count = count + 1
            j = j + 1
        }
        i = i + 1
    }
    count
}

fn main() {
    let sum = add(3, 4)
    Stdio::println(sum.to_string())
    let result = mul_sub(5, 6, 10)
    Stdio::println(result.to_string())
    let f = fib(10)
    Stdio::println(f.to_string())
    let m = max_val(42, 17)
    Stdio::println(m.to_string())
    let found = find_first_ge(7)
    Stdio::println(found.to_string())
    let s = sum_skip_five(10)
    Stdio::println(s.to_string())
    let n = nested_loops()
    Stdio::println(n.to_string())
}
