// Test: selfhost MIR match expression lowering
// Exercises: integer literal arms, wildcard pattern, match as expression,
//            nested if/else chain lowering for multiple arms.
use std::host::stdio::Stdio
fn grade(score: i32) -> i32 {
    match score {
        90 => 4,
        80 => 3,
        70 => 2,
        60 => 1,
        _ => 0,
    }
}

fn classify(n: i32) -> i32 {
    match n {
        0 => 10,
        1 => 20,
        _ => 99,
    }
}

fn main() {
    Stdio::println(grade(90).to_string())
    Stdio::println(grade(80).to_string())
    Stdio::println(grade(70).to_string())
    Stdio::println(grade(55).to_string())
    let x = 2
    let result = match x {
        1 => 100,
        2 => 200,
        _ => 0,
    }
    Stdio::println(result.to_string())
    Stdio::println(classify(0).to_string())
    Stdio::println(classify(1).to_string())
    Stdio::println(classify(7).to_string())
}
// Literal match arms — each branch
// Match as expression assigned to a variable
// Classify: wildcard arm covers unlisted values
