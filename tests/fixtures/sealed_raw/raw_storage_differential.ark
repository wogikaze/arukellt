use std::host::stdio
use std::prelude::{clone}
fn main() {
    let mut bytes = Vec::with_capacity<i32>(2)
    push(bytes, 79)
    push(bytes, 75)
    let text = __intrinsic_string_from_bytes(bytes)
    stdio::print(clone(text).byte_at(0))
    stdio::print(len(clone(text)))
    stdio::print(len(String_new()))
}
