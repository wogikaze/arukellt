use std::component::Component
use std::host::stdio::Stdio
use std::core::error
fn main() {
    let mut scratch = Component::scratch_new()
    let mut vals = Vec::new<i32>()
    push(vals, 1)
    push(vals, 2)
    push(vals, 3)
    match Component::lower_list_i32(scratch, vals) {
        Result::Ok(slice) => {
            Stdio::println((slice.len).to_string())
            match Component::lift_list_i32(scratch, slice) {
                Result::Ok(out) => {
                    Stdio::println((len(out)).to_string())
                    Stdio::println((get_unchecked(out, 0)).to_string())
                },
                Result::Err(e) => Stdio::println(e.message()),
            }
            match Component::lift_list_i32_at(scratch, slice.ptr, slice.len) {
                Result::Ok(out) => {
                    Stdio::println((len(out)).to_string())
                    Stdio::println((get_unchecked(out, 0)).to_string())
                },
                Result::Err(e) => Stdio::println(e.message()),
            }
        },
        Result::Err(e) => Stdio::println(e.message()),
    }
}
// canonical i32 list lower/lift round-trip (Component associated functions)
