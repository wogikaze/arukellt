use std::component::canonical
use std::host::stdio
use std::core::error
fn main() {
    let scratch = canonical::canonical_scratch_new()
    let vals = Vec::new<i32>()
    push(vals, 1)
    push(vals, 2)
    push(vals, 3)
    match canonical::canonical_lower_list_i32(scratch, vals) {
        Result::Ok(slice) => {
            stdio::println((slice.len).to_string())
            match canonical::canonical_lift_list_i32(scratch, slice) {
                Result::Ok(out) => stdio::println((len(out)).to_string()),
                Result::Err(e) => stdio::println(error::error_message(e)),
            }
        },
        Result::Err(e) => stdio::println(error::error_message(e)),
    }
}
// canonical i32 list lower/lift
