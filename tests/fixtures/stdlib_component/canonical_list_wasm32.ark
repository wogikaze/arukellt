use std::component::Component
use std::host::stdio
use std::core::error
fn main() {
    let scratch = Component::scratch_new()
    let vals = Vec::new<i32>()
    push(vals, 1)
    push(vals, 2)
    push(vals, 3)
    match Component::lower_list_i32(scratch, vals) {
        Result::Ok(slice) => {
            stdio::println((slice.len).to_string())
            match Component::lift_list_i32(scratch, slice) {
                Result::Ok(out) => {
                    stdio::println((len(out)).to_string())
                    stdio::println((get_unchecked(out, 0)).to_string())
                },
                Result::Err(e) => stdio::println(error::error_message(e)),
            }
            match Component::lift_list_i32_at(scratch, slice.ptr, slice.len) {
                Result::Ok(out) => {
                    stdio::println((len(out)).to_string())
                    stdio::println((get_unchecked(out, 0)).to_string())
                },
                Result::Err(e) => stdio::println(error::error_message(e)),
            }
        },
        Result::Err(e) => stdio::println(error::error_message(e)),
    }
}
// canonical i32 list lower/lift round-trip on wasm32 linear
