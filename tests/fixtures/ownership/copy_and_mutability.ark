use std::host::stdio::Stdio

struct Point {
    x: i32
}

enum Color {
    Red,
    Blue
}

impl Copy for Point {}
impl Copy for Color {}

fn main() {
    let immutable: i32 = 1
    let mut mutable = immutable
    mutable = 2
    let immutable_copy = immutable

    Stdio::println((immutable).to_string())
    Stdio::println((mutable).to_string())
    Stdio::println((immutable_copy).to_string())

    let point = Point { x: 7 }
    let point_copy = point
    let point_again = point
    Stdio::println((point.x).to_string())
    Stdio::println((point_copy.x).to_string())
    Stdio::println((point_again.x).to_string())

    let color: Color = Color::Red
    let color_copy = color
    let color_again = color

    let pair = (3, 4)
    let (first, second) = pair
    Stdio::println((first).to_string())
    Stdio::println((second).to_string())

    let array = [5, 6]
    let array_copy = array
    Stdio::println(array_copy[0])
}
