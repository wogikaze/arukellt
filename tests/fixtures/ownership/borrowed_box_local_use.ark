use std::host::stdio
use std::prelude::Box_new

// ADR-088 §6: a borrowed `Box<T>` parameter may be read locally. Matching the
// prelude enum copies the payload and never moves the Box, so the caller
// keeps its unique owner and can pass the same value again. The generic shape
// mirrors the prelude `unbox` signature; a concrete `Box<i32>` parameter
// currently hits a pre-existing match-binding limitation.
fn peek<T>(b: Box<T>) -> T {
    match b {
        Box::Owned(value) => value,
    }
}

fn main() {
    let boxed = Box_new(41)
    stdio::println(peek(boxed).to_string())
    stdio::println(peek(boxed).to_string())
}
