use std::host::stdio::Stdio

struct Holder {
    name: String,
    count: i32
}

fn describe(p: Holder) -> i32 {
    p.count + p.name.len()
}

fn main() {
    let h = Holder { name: String_from("keep"), count: 7 }
    let first = describe(h)
    let second = describe(h)
    // A plain field read in a let initializer is a read, not a move: the call
    // borrow leaves `h` live and the field is still readable here.
    let label = h.name
    Stdio::println(label)
    Stdio::println(first.to_string())
    Stdio::println(second.to_string())
    Stdio::println(h.count.to_string())
}
