use std::host::stdio::Stdio
use std::prelude::{Box}
use std::collections::vec

fn main() {
    let boxed: Box<i32> = Box::new(42)
    let moved = boxed
    let value = moved.take()
    Stdio::println(value.to_string())

    let mut values: Vec<i32> = Vec::new<i32>()
    values.push(7)
    let view = values.as_slice(0, 1)
    Stdio::println((view.len()).to_string())
    Stdio::println((values.len()).to_string())

    let mut values_again: Vec<i32> = Vec::new<i32>()
    values_again.push(8)
    let view_again = values_again.as_slice(0, 1)
    let viewed = view_again.get(0)
    Stdio::println(viewed.to_string())
}
