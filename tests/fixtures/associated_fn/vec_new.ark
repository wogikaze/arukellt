// Issue #701 / #845: Associated function syntax for Vec — Vec::new<T>().
use std::host::stdio

fn main() {
    // Explicit Vec<i32> keeps MIR local type vec:i32 when associated ctor
    // bodies are wasm-name fallbacks without a MIR mono shell (#845).
    let v: Vec<i32> = Vec::new<i32>()
    assert(len(v) == 0)
    push(v, 1)
    push(v, 2)
    assert(len(v) == 2)
    assert(get_unchecked(v, 0) == 1)
    assert(get_unchecked(v, 1) == 2)
    stdio::println(String_from("OK"))
}
