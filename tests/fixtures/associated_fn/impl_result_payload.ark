// Regression: an inherent impl method returning Result must expose its Ok/Err
// payload types at the call site. Before the method return-name fix, MIR
// lowering rejected this match as an untyped Result scrutinee.
use std::host::stdio

struct Parsed {
    value: i32,
}

impl Parsed {
    fn make(value: i32) -> Result<Parsed, String> {
        if value < 0 {
            return Result::Err("negative")
        }
        Result::Ok(Parsed { value: value })
    }
}

fn main() {
    match Parsed::make(7) {
        Result::Ok(parsed) => stdio::println((parsed.value).to_string()),
        Result::Err(err) => stdio::println(err),
    }
    match Parsed::make(0 - 1) {
        Result::Ok(_) => stdio::println("unexpected ok"),
        Result::Err(err) => stdio::println(err),
    }
}
