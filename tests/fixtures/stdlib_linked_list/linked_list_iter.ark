// LinkedList<T> cursors: iter/collect/count and iter_mut set_current.
use std::collections::linked_list::LinkedList
use std::collections::linked_list::LinkedListIter
use std::collections::linked_list::LinkedListIterMut
use std::host::stdio::Stdio

fn show(value: Option<i32>) {
    match value {
        Option::Some(item) => Stdio::println(item.to_string()),
        Option::None => Stdio::println(String_from("none")),
    }
}

fn main() {
    let mut list: LinkedList<i32> = LinkedList::new<i32>()
    list.push_back(10)
    list.push_back(20)
    list.push_front(5)

    let mut cursor: LinkedListIter<i32> = list.iter()
    show(cursor.next())
    show(cursor.next())
    Stdio::println((cursor.count()).to_string())
    Stdio::println((list.iter().count()).to_string())

    let mut before: LinkedListIterMut<i32> = list.iter_mut()
    show(before.set_current(99))

    let mut writable: LinkedListIterMut<i32> = list.iter_mut()
    match writable.next() {
        Option::Some(value) => show(writable.set_current(value + 1)),
        Option::None => show(Option::None),
    }
    match writable.next() {
        Option::Some(value) => show(writable.set_current(value + 1)),
        Option::None => show(Option::None),
    }
    show(writable.next())
    show(writable.next())
    show(writable.set_current(0))
    Stdio::println(list.fmt_debug())

    let values: Vec<i32> = list.iter().collect()
    assert(values.len() == 3)
    Stdio::println((values.get_unchecked(0)).to_string())
    Stdio::println((values.get_unchecked(1)).to_string())
    Stdio::println((values.get_unchecked(2)).to_string())
}
