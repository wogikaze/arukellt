// LinkedList<T> bounded Clone/Debug with String elements and set_current.
use std::collections::linked_list::LinkedList
use std::collections::linked_list::LinkedListIterMut
use std::core::clone
use std::core::convert
use std::host::stdio::Stdio

fn main() {
    let mut letters: LinkedList<String> = LinkedList::new<String>()
    letters.push_back("beta")
    letters.push_front("alpha")
    let mut copy: LinkedList<String> = letters.clone()
    letters.push_back("gamma")
    assert(copy.len() == 2)
    assert(letters.len() == 3)
    Stdio::println(copy.fmt_debug())
    Stdio::println(letters.fmt_debug())

    let empty: LinkedList<i32> = LinkedList::new<i32>()
    Stdio::println(empty.fmt_debug())

    let mut cursor: LinkedListIterMut<String> = copy.iter_mut()
    match cursor.next() {
        Option::Some(value) => {
            Stdio::println(value)
            match cursor.set_current(String_from("changed")) {
                Option::Some(old) => Stdio::println(old),
                Option::None => Stdio::println(String_from("none")),
            }
        },
        Option::None => Stdio::println(String_from("empty")),
    }
    Stdio::println(copy.fmt_debug())

    copy.clear()
    assert(copy.is_empty())
    Stdio::println(copy.fmt_debug())
}
