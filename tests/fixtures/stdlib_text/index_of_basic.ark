use std::test
use std::text

fn main() {
    test::assert_eq_i32("hello world".index_of("world"), 6)
    test::assert_eq_i32("hello world".index_of("hello"), 0)
    test::assert_eq_i32("hello world".index_of(" "), 5)
    test::assert_eq_i32("abc".index_of("b"), 1)
    test::assert_eq_i32("abc".index_of("abc"), 0)
}
