use std::test
use std::text

fn main() {
    // Convert ASCII string to bytes
    let bytes = "Hi".to_utf8_bytes()
    test::assert_eq_i32(len(bytes), 2)
    test::assert_eq_i32(get_unchecked(bytes, 0), 72)
    test::assert_eq_i32(get_unchecked(bytes, 1), 105)

    // Empty string
    let bytes2 = "".to_utf8_bytes()
    test::assert_eq_i32(len(bytes2), 0)

    // Single char
    let bytes3 = "A".to_utf8_bytes()
    test::assert_eq_i32(len(bytes3), 1)
    test::assert_eq_i32(get_unchecked(bytes3, 0), 65)
}
