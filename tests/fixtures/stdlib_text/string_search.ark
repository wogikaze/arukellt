use std::host::stdio
use std::text
use std::prelude::{ends_with, starts_with}
fn main() {
    let s = "hello world"
    stdio::println((s.contains("world")).to_string())
    stdio::println((s.contains("xyz")).to_string())
    stdio::println((s.contains("")).to_string())
    stdio::println(("".contains("")).to_string())
    stdio::println(("".contains("a")).to_string())
    stdio::println((s.index_of("hello")).to_string())
    stdio::println((s.index_of("world")).to_string())
    stdio::println((s.index_of(" ")).to_string())
    stdio::println((s.index_of("xyz")).to_string())
    stdio::println((s.index_of("")).to_string())
    stdio::println((starts_with(s, "hello")).to_string())
    stdio::println((starts_with(s, "world")).to_string())
    stdio::println((starts_with(s, "")).to_string())
    stdio::println((ends_with(s, "world")).to_string())
    stdio::println((ends_with(s, "hello")).to_string())
    stdio::println((ends_with(s, "")).to_string())
    stdio::println(("a".index_of("a")).to_string())
    stdio::println(("a".index_of("b")).to_string())
}
// String search operations: contains, index_of, starts_with, ends_with
// contains
// index_of
// starts_with / ends_with (prelude)
// Edge: single char search
