use std::test::Test
use std::text::fmt

fn main() {
    // Debug for i32 mirrors Display (no quoting)
    Test::assert_eq_string((42).fmt_debug(), "42")
    Test::assert_eq_string((-7).fmt_debug(), "-7")
    Test::assert_eq_string((0).fmt_debug(), "0")

    // Debug for bool
    Test::assert_eq_string(true.fmt_debug(), "true")
    Test::assert_eq_string(false.fmt_debug(), "false")

    // Debug for String — quoted with double quotes
    Test::assert_eq_string("hello".fmt_debug(), "\"hello\"")
    Test::assert_eq_string("".fmt_debug(), "\"\"")

    // write_debug_to appends to buffer
    Test::assert_eq_string("value=".concat((42).fmt_debug()), "value=42")
    Test::assert_eq_string("s=".concat("hi".fmt_debug()), "s=\"hi\"")
}
