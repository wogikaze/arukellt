use std::test::Test
use std::text

fn main() {
    let l = "line1\nline2\nline3".lines()
    Test::assert_eq_i32(l.len(), 3)
    // Single line (no newline)
    let l2 = "single".lines()
    Test::assert_eq_i32(l2.len(), 1)
    // Empty string
    let l3 = "".lines()
    Test::assert_eq_i32(l3.len(), 1)
}
