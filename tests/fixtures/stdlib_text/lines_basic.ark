use std::test::Test
use std::text

fn main() {
    let l = "line1\nline2\nline3".lines()
    Test::assert_eq_i32(len(l), 3)
    // Single line (no newline)
    let l2 = "single".lines()
    Test::assert_eq_i32(len(l2), 1)
    // Empty string
    let l3 = "".lines()
    Test::assert_eq_i32(len(l3), 1)
}
