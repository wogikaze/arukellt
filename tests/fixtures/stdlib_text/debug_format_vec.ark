use std::test::Test
use std::text::fmt

fn main() {
    // Empty Vec<i32> -> "[]"
    let empty: Vec<i32> = Vec::new<i32>()
    Test::assert_eq_string(fmt::DebugFormat::vec_i32(empty), "[]")

    // Vec<i32> -> "[1, 2, 3]"
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    Test::assert_eq_string(fmt::DebugFormat::vec_i32(v), "[1, 2, 3]")

    // Single element
    let mut one: Vec<i32> = Vec::new<i32>()
    one.push(42)
    Test::assert_eq_string(fmt::DebugFormat::vec_i32(one), "[42]")

    // Vec<String> -> ["a", "b"] (elements quoted via Debug for String)
    let mut vs: Vec<String> = Vec::new<String>()
    vs.push("a")
    vs.push("b")
    Test::assert_eq_string(fmt::DebugFormat::vec_string(vs), "[\"a\", \"b\"]")
}
