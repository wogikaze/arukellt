use std::test
use std::text

fn main() {
    test::assert_true("hello".ends_with("llo"))
    test::assert_true("hello".ends_with("hello"))
    test::assert_true("hello".ends_with(""))
    test::assert_false("hello".ends_with("hel"))
    test::assert_false("hello".ends_with("xhello"))
    test::assert_true("abc".ends_with("c"))
}
