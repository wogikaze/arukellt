use std::test
use std::text

fn main() {
    test::assert_eq_string("ab".repeat(3), "ababab")
    test::assert_eq_string("x".repeat(5), "xxxxx")
    test::assert_eq_string("hello".repeat(2), "hellohello")
    test::assert_eq_string(" ".repeat(4), "    ")
    test::assert_eq_string("123".repeat(3), "123123123")
}
