use std::test
use std::text

fn main() {
    // Multiple occurrences all replaced
    test::assert_eq_string("aaa".replace("a", "bb"), "bbbbbb")
    test::assert_eq_string("a-b-c-d".replace("-", "+"), "a+b+c+d")
    test::assert_eq_string("xxx".replace("x", "yy"), "yyyyyy")
    // Overlapping pattern — non-overlapping matches
    test::assert_eq_string("aaaa".replace("aa", "b"), "bb")
}
