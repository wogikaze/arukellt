use std::test
use std::text

fn main() {
    test::assert_eq_string("  hello  ".trim(), "hello")
    test::assert_eq_string("hello".trim(), "hello")
    test::assert_eq_string("  hello".trim(), "hello")
    test::assert_eq_string("hello  ".trim(), "hello")
    test::assert_eq_string("   ".trim(), "")
    test::assert_eq_string("".trim(), "")
}
