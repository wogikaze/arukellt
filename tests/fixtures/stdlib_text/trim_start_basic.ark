use std::test::Test
use std::text

fn main() {
    Test::assert_eq_string("  hello  ".trim_start(), "hello  ")
    Test::assert_eq_string("hello".trim_start(), "hello")
    Test::assert_eq_string("   hello".trim_start(), "hello")
    Test::assert_eq_string("   ".trim_start(), "")
    Test::assert_eq_string("".trim_start(), "")
}
