use std::test::Test
use std::text

fn main() {
    Test::assert_eq_string("foo".concat("bar"), "foobar")
    Test::assert_eq_string("hello".concat(" "), "hello ")
    Test::assert_eq_string("".concat("abc"), "abc")
    Test::assert_eq_string("abc".concat(""), "abc")
    Test::assert_eq_string("a".concat("b"), "ab")
}
