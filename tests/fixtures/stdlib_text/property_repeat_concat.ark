use std::test::Test
use std::text

fn main() {
    // repeat(concat(a, b), n) is NOT equal to concat(repeat(a, n), repeat(b, n)).
    let a = "ab"
    let b = "cd"
    let n = 3
    let left = a.concat(b).repeat(n)
    Test::assert_eq_string(left, "abcdabcdabcd")

    // repeat(a, m+n) == concat(repeat(a, m), repeat(a, n))
    let m = 2
    let nn = 3
    let left2 = "x".repeat(m + nn)
    let right2 = "x".repeat(m).concat("x".repeat(nn))
    Test::assert_eq_string(left2, right2)
}
