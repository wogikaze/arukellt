use std::test
use std::text

fn main() {
    // CRLF is normalized to LF before splitting
    let l = "line1\r\nline2\r\nline3".lines()
    test::assert_eq_i32(len(l), 3)
    // Mixed LF and CRLF
    let l2 = "a\nb\r\nc".lines()
    test::assert_eq_i32(len(l2), 3)
    // Single CRLF
    let l3 = "a\r\nb".lines()
    test::assert_eq_i32(len(l3), 2)
}
