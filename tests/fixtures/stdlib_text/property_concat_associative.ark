use std::test::Test
use std::text

fn main() {
    // concat(a, concat(b, c)) == concat(concat(a, b), c)
    let a = "hello"
    let b = " "
    let c = "world"
    let left = a.concat(b.concat(c))
    let right = a.concat(b).concat(c)
    Test::assert_eq_string(left, right)
    Test::assert_eq_string(left, "hello world")

    // concat with empty is identity
    Test::assert_eq_string("abc".concat(""), "abc")
    Test::assert_eq_string("".concat("abc"), "abc")
    Test::assert_eq_string("".concat(""), "")
}
