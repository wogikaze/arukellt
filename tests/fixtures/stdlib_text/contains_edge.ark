use std::test
use std::text

fn main() {
    // Empty needle is always found
    test::assert_true("hello".contains(""))
    test::assert_true("".contains(""))
    // Non-empty needle in empty haystack is not found
    test::assert_false("".contains("a"))
    // Single char haystack
    test::assert_true("a".contains("a"))
    test::assert_false("a".contains("b"))
}
