use std::test::Test
use std::text

fn main() {
    Test::assert_eq_string("HELLO".to_lower(), "hello")
    Test::assert_eq_string("Hello World".to_lower(), "hello world")
    Test::assert_eq_string("ABCDEF".to_lower(), "abcdef")
    Test::assert_eq_string("already lower".to_lower(), "already lower")
    Test::assert_eq_string("MixedCaseString".to_lower(), "mixedcasestring")
    Test::assert_eq_string("A".to_lower(), "a")
    Test::assert_eq_string("Z".to_lower(), "z")
}
