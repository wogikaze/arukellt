use std::test::Test
use std::text::fmt

fn main() {
    // Some(i32) -> "Some(42)"
    Test::assert_eq_string(fmt::DebugFormat::option_i32(Option::Some(42)), "Some(42)")
    // None -> "None"
    Test::assert_eq_string(fmt::DebugFormat::option_i32(None), "None")
    // Some with negative
    Test::assert_eq_string(fmt::DebugFormat::option_i32(Option::Some(-1)), "Some(-1)")
    // Some with zero
    Test::assert_eq_string(fmt::DebugFormat::option_i32(Option::Some(0)), "Some(0)")

    // Option<String>
    Test::assert_eq_string(fmt::DebugFormat::option_string(Option::Some("hi")), "Some(\"hi\")")
    Test::assert_eq_string(fmt::DebugFormat::option_string(None), "None")
}
