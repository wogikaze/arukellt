use std::test::Test
use std::text

fn main() {
    Test::assert_true("hello world".contains("world"))
    Test::assert_true("hello world".contains("hello"))
    Test::assert_true("abc".contains("b"))
    Test::assert_true("abc".contains("abc"))
    Test::assert_false("hello".contains("xyz"))
    Test::assert_false("abc".contains("abcd"))
}
