use std::test::Test
use std::text

fn main() {
    Test::assert_eq_string((-1.5).to_string(), "-1.5")
    Test::assert_eq_string((-0.25).to_string(), "-0.25")
    Test::assert_eq_string((-100.0).to_string(), "-100")
    Test::assert_eq_string((0.0).to_string(), "0")
    Test::assert_eq_string((-0.0).to_string(), "0")
}
