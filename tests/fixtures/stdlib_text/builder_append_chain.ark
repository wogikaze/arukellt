use std::test::Test
use std::text

fn main() {
    let sb = ""
    let sb = sb.concat("Hello")
    let sb = sb.concat(", ")
    let sb = sb.concat("world")
    let sb = sb.concat("!")
    Test::assert_eq_string(sb, "Hello, world!")
    Test::assert_eq_i32(sb.len(), 13)

    // Append char
    let sb2 = ""
    let sb2 = sb2.concat("Hi")
    let sb2 = sb2.concat(('!').to_string())
    Test::assert_eq_string(sb2, "Hi!")
    Test::assert_eq_i32(sb2.len(), 3)
}
