use std::test::Test
use std::text

fn main() {
    Test::assert_true("hello".starts_with("hel"))
    Test::assert_true("hello".starts_with("hello"))
    Test::assert_true("hello".starts_with(""))
    Test::assert_false("hello".starts_with("world"))
    Test::assert_false("hello".starts_with("helloo"))
    Test::assert_true("abc".starts_with("a"))
}
