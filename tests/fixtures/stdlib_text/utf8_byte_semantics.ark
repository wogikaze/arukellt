use std::host::stdio::Stdio
use std::text
fn main() {
    let ascii = "hello"
    Stdio::println((ascii.len()).to_string())
    Stdio::println(("".len()).to_string())
    Stdio::println((" ".len()).to_string())
    Stdio::println(("\n".len()).to_string())
    Stdio::println(("\t".len()).to_string())
    let world = ascii.slice(0, 3)
    Stdio::println(world)
    let mid = ascii.slice(1, 4)
    Stdio::println(mid)
    let full = ascii.slice(0, 5)
    Stdio::println(full)
    let empty = ascii.slice(2, 2)
    Stdio::println((empty.len()).to_string())
    Stdio::println(("abc".len_bytes()).to_string())
    Stdio::println(("".is_empty()).to_string())
    Stdio::println(("a".is_empty()).to_string())
}
// UTF-8 byte length vs perceived character count
// Arukellt len() measures BYTES, not Unicode scalars.
// ASCII: 1 byte per char
// Empty string: 0 bytes
// Single space: 1 byte
// Newline: 1 byte
// Tab: 1 byte
// Byte-level slice of ASCII works as expected
// Slice from middle
// Slice entire string
// Slice empty range
// text::len_bytes matches len
