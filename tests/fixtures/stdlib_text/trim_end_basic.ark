use std::test::Test
use std::text

fn main() {
    Test::assert_eq_string("  hello  ".trim_end(), "  hello")
    Test::assert_eq_string("hello".trim_end(), "hello")
    Test::assert_eq_string("hello   ".trim_end(), "hello")
    Test::assert_eq_string("   ".trim_end(), "")
    Test::assert_eq_string("".trim_end(), "")
}
