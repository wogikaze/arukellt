use std::test::Test
use std::text

fn main() {
    let source = "Aé😀é"
    Test::assert_eq_i32(source.len_bytes(), 10)
    Test::assert_eq_i32(source.len_chars(), 5)
    Test::assert_eq_i32(source.byte_at(1), 195)
    Test::assert_eq_i32(source.byte_at(2), 169)

    match source.codepoint_at(0) {
        Option::Some(value) => Test::assert_eq_string(char_to_string(value), "A"),
        Option::None => assert(false),
    }
    match source.codepoint_at(2) {
        Option::Some(value) => Test::assert_eq_string(char_to_string(value), "😀"),
        Option::None => assert(false),
    }
    match source.codepoint_at(5) {
        Option::Some(_) => assert(false),
        Option::None => {},
    }

    let scalars = source.chars()
    Test::assert_eq_i32(scalars.len(), 5)
    Test::assert_eq_i32(get_unchecked(scalars, 0).len_bytes(), 1)
    Test::assert_eq_i32(get_unchecked(scalars, 1).len_bytes(), 2)
    Test::assert_eq_i32(get_unchecked(scalars, 2).len_bytes(), 4)
    Test::assert_eq_i32(get_unchecked(scalars, 4).len_bytes(), 2)

    Test::assert_eq_string(source.slice_bytes(1, 3), "é")
    Test::assert_eq_string(source.slice_bytes(2, 3), "")
    Test::assert_eq_string(source.slice_chars(1, 3), "é😀")
    Test::assert_eq_string(source.slice_chars(3, 5), "é")
    Test::assert_eq_string(source.slice_chars(4, 6), "")
    match source.try_slice_bytes(2, 3) {
        Option::Some(_) => assert(false),
        Option::None => {},
    }
    match source.try_slice_chars(4, 6) {
        Option::Some(_) => assert(false),
        Option::None => {},
    }

    let mut valid_bytes = Vec::new<i32>()
    valid_bytes.push(195)
    valid_bytes.push(169)
    match String::try_from_utf8(valid_bytes) {
        Option::Some(value) => Test::assert_eq_string(value, "é"),
        Option::None => assert(false),
    }

    let mut invalid_bytes = Vec::new<i32>()
    invalid_bytes.push(65)
    invalid_bytes.push(195)
    invalid_bytes.push(40)
    let mut lossy_input = Vec::new<i32>()
    lossy_input.push(65)
    lossy_input.push(195)
    lossy_input.push(40)
    match String::try_from_utf8(invalid_bytes) {
        Option::Some(_) => assert(false),
        Option::None => {},
    }
    let lossy = String::from_utf8_lossy(lossy_input)
    let lossy_bytes = lossy.to_utf8_bytes()
    Test::assert_eq_i32(get_unchecked(lossy_bytes, 0), 65)
    Test::assert_eq_i32(get_unchecked(lossy_bytes, 1), 239)
    Test::assert_eq_i32(get_unchecked(lossy_bytes, 2), 191)
    Test::assert_eq_i32(get_unchecked(lossy_bytes, 3), 189)
    Test::assert_eq_i32(get_unchecked(lossy_bytes, 4), 40)

    let mut built = String_new()
    match source.codepoint_at(1) {
        Option::Some(value) => built.push_char(value),
        Option::None => assert(false),
    }
    match source.codepoint_at(2) {
        Option::Some(value) => built.push_char(value),
        Option::None => assert(false),
    }
    Test::assert_eq_string(built, "é😀")
}
