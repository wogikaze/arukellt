use std::test::Test
use std::text

fn main() {
    Test::assert_eq_string((0.0).to_string(), "0")
    Test::assert_eq_string((1.0).to_string(), "1")
    Test::assert_eq_string((3.14).to_string(), "3.14")
    Test::assert_eq_string((100.0).to_string(), "100")
    Test::assert_eq_string((0.5).to_string(), "0.5")
}
