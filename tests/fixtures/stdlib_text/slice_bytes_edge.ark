use std::test
use std::text

fn main() {
    // Empty range — start == end
    test::assert_eq_string("hello".slice_bytes(2, 2), "")
    // Full string
    test::assert_eq_string("hello".slice_bytes(0, 5), "hello")
    // Empty string
    test::assert_eq_string("".slice_bytes(0, 0), "")
    // Single char slice
    test::assert_eq_string("abc".slice_bytes(1, 2), "b")
}
