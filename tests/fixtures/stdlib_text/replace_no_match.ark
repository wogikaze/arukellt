use std::test::Test
use std::text

fn main() {
    // No match — string unchanged
    Test::assert_eq_string("hello".replace("xyz", "!"), "hello")
    // Empty string with no match
    Test::assert_eq_string("".replace("a", "b"), "")
    // Replace with same string
    Test::assert_eq_string("abc".replace("b", "b"), "abc")
}
