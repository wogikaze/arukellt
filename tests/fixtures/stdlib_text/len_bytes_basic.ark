use std::test::Test
use std::text

fn main() {
    Test::assert_eq_i32("hello".len_bytes(), 5)
    Test::assert_eq_i32("".len_bytes(), 0)
    Test::assert_eq_i32(" ".len_bytes(), 1)
    Test::assert_eq_i32("hello world".len_bytes(), 11)
    Test::assert_eq_i32("a".len_bytes(), 1)
    // is_empty consistency
    Test::assert_true("".is_empty())
    Test::assert_false("a".is_empty())
    Test::assert_false(" ".is_empty())
}
