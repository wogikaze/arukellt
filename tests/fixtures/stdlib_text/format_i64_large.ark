use std::test
use std::text

fn main() {
    test::assert_eq_string((9223372036854775807).to_string(), "9223372036854775807")
    test::assert_eq_string((-9223372036854775808).to_string(), "-9223372036854775808")
    test::assert_eq_string((1000000000000).to_string(), "1000000000000")
    test::assert_eq_string((-1000000000000).to_string(), "-1000000000000")
    test::assert_eq_i32(len((9223372036854775807).to_string()), 19)
}
