use std::test
use std::text

fn main() {
    test::assert_eq_string((0).to_string(), "0")
    test::assert_eq_string((1).to_string(), "1")
    test::assert_eq_string((42).to_string(), "42")
    test::assert_eq_string((100).to_string(), "100")
    test::assert_eq_string((123456).to_string(), "123456")
    test::assert_eq_string((7).to_string(), "7")
    test::assert_eq_string((999999).to_string(), "999999")
}
