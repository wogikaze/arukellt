use std::test::Test
use std::text

fn main() {
    // trim(trim(s)) == trim(s) — idempotency
    let s = "  hello world  "
    Test::assert_eq_string(s.trim().trim(), s.trim())
    Test::assert_eq_string(s.trim().trim(), "hello world")

    // trim_start(trim_start(s)) == trim_start(s)
    Test::assert_eq_string(s.trim_start().trim_start(), s.trim_start())

    // trim_end(trim_end(s)) == trim_end(s)
    Test::assert_eq_string(s.trim_end().trim_end(), s.trim_end())

    // trim of already-trimmed string is no-op
    let t = s.trim()
    Test::assert_eq_string(t.trim(), t)
}
