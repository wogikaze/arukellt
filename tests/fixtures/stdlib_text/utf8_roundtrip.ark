use std::test::Test
use std::text

fn main() {
    // Roundtrip: string -> bytes -> string
    let original = "hello"
    let bytes = original.to_utf8_bytes()
    let restored = String::from_utf8_lossy(bytes)
    Test::assert_eq_string(restored, original)

    // Roundtrip with empty string
    let bytes2 = "".to_utf8_bytes()
    let restored2 = String::from_utf8_lossy(bytes2)
    Test::assert_eq_string(restored2, "")

    // Roundtrip with special chars
    let original3 = "a b\nc"
    let bytes3 = original3.to_utf8_bytes()
    let restored3 = String::from_utf8_lossy(bytes3)
    Test::assert_eq_string(restored3, original3)

    // Byte count matches len_bytes
    let s = "hello world"
    Test::assert_eq_i32(s.to_utf8_bytes().len(), s.len_bytes())
}
