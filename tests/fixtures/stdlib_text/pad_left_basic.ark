use std::test::Test
use std::text

fn main() {
    Test::assert_eq_string("42".pad_left_with(5, "0"), "00042")
    Test::assert_eq_string("abc".pad_left_with(6, " "), "   abc")
    Test::assert_eq_string("x".pad_left_with(4, "-"), "---x")
    Test::assert_eq_string("hi".pad_left_with(4, "0"), "00hi")
    // repeat("ab", 4) ++ "test", then take last 8 bytes → "ababtest"
    // (end-aligned multi-char fill per std::text::pad_left / string pad_left_fill).
    Test::assert_eq_string("test".pad_left_with(8, "ab"), "ababtest")
}
