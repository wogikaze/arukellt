use std::host::stdio::Stdio
use std::text

fn main() {
    Stdio::println("hello world".slice_bytes(0, 5))
    Stdio::println("hello world".slice_bytes(6, 11))
    Stdio::println("hello world".slice_bytes(0, 0))
    Stdio::println(("".is_empty()).to_string())
    Stdio::println(("a".is_empty()).to_string())
    Stdio::println(("hello".len_bytes()).to_string())
    Stdio::println(("".len_bytes()).to_string())
    let parts = "a,b,c".split(",")
    Stdio::println((parts.len()).to_string())
    Stdio::println(parts.join("-"))
    Stdio::println("foo".concat("bar"))
    Stdio::println(("hello".starts_with("hel")).to_string())
    Stdio::println(("hello".ends_with("llo")).to_string())
    Stdio::println("ABC".to_lower())
    Stdio::println("abc".to_upper())
    Stdio::println("ab".repeat(3))
    Stdio::println("hello world".replace("world", "arukellt"))
}
// slice_bytes: extract substring by byte range
// is_empty
// len_bytes
// relocated: split, join, concat
// relocated: starts_with, ends_with
// relocated: to_lower, to_upper
// repeat
// replace
