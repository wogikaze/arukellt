use std::test::Test
use std::text::fmt

fn main() {
    // Ok(i32) -> "Ok(42)"
    Test::assert_eq_string(fmt::DebugFormat::result_i32_string(Result::Ok(42)), "Ok(42)")
    // Err(String) -> "Err(\"msg\")"
    Test::assert_eq_string(fmt::DebugFormat::result_i32_string(Result::Err("fail")), "Err(\"fail\")")
    // Ok with zero
    Test::assert_eq_string(fmt::DebugFormat::result_i32_string(Result::Ok(0)), "Ok(0)")
    // Ok with negative
    Test::assert_eq_string(fmt::DebugFormat::result_i32_string(Result::Ok(-5)), "Ok(-5)")

    // Result<String, String>
    Test::assert_eq_string(fmt::DebugFormat::result_string_string(Result::Ok("ok")), "Ok(\"ok\")")
    Test::assert_eq_string(fmt::DebugFormat::result_string_string(Result::Err("err")), "Err(\"err\")")
}
