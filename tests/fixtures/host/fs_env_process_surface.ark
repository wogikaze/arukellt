use std::host::env::Env
use std::host::fs::Fs
use std::host::process
use std::prelude::{trim}
use std::host::stdio
fn main() {
    match Fs::read_to_string("tests/fixtures/stdlib_fs/present.txt") {
        Result::Err(_) => Std::panic("read failed"),
        Result::Ok(contents) => {
            if trim(contents) != "present" {
                Std::panic("read returned unexpected contents")
            }
        },
    }
    match Env::var("PATH") {
        Option::None => {
        },
        Option::Some(_) => {
        },
    }
    match process::id() {
        Result::Ok(_) => Std::panic("WASI process id must not be fabricated"),
        Result::Err(_) => {
        },
    }
    stdio::println("host surface ok")
}
