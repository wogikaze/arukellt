use std::host::env
use std::host::fs
use std::host::process

fn main() {
    match fs::read_to_string("tests/fixtures/stdlib_fs/present.txt") {
        Result::Err(_) => panic("read failed"),
        Result::Ok(contents) => {
            if contents != "present" {
                panic("read returned unexpected contents")
            }
        },
    }
    match env::var("PATH") {
        Option::None => panic("environment lookup failed"),
        Option::Some(_) => {
        },
    }
    match process::id() {
        Result::Ok(_) => panic("WASI process id must not be fabricated"),
        Result::Err(_) => {
        },
    }
    println("host surface ok")
}
