use std::host::stdio::Stdio
struct Point { x: i32, y: i32 }
fn classify(n) -> String | n > 0 = "pos"
fn classify(n) -> String | n < 0 = "neg"
fn classify(_) -> String = "zero"
fn describe(pt) -> String | pt.x > 0 = "right"
fn describe(pt) -> String | pt.x < 0 = "left"
fn describe(_) -> String = "center"
fn main() {
    Stdio::println(classify(3))
    Stdio::println(classify(-2))
    Stdio::println(classify(0))
    Stdio::println(describe(Point { x: 5, y: 0 }))
    Stdio::println(describe(Point { x: -1, y: 0 }))
    Stdio::println(describe(Point { x: 0, y: 7 }))
}
