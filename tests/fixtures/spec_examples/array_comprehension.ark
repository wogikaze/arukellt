use std::host::stdio::Stdio
use std::core::iter
fn main() {
    let mut xs: Vec<i32> = Vec::new<i32>()
    xs.push(1)
    xs.push(2)
    xs.push(3)
    let doubled = [x * 2 for x in xs]
    let evens = [x * 2 for x in xs if x % 2 == 0]
    Stdio::println(doubled.len().to_string())
    Stdio::println(evens.len().to_string())
}
