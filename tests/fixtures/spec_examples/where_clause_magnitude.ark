use std::host::stdio
struct Point { x: i32, y: i32 }
fn magnitude_label(p: Point) -> String | m == 0 = "origin"
fn magnitude_label(p: Point) -> String | m < 10 = "near"
fn magnitude_label(_) -> String = "far"
where
m = p.x * p.x + p.y * p.y
fn main() {
    stdio::println(magnitude_label(Point { x: 0, y: 0 }))
    stdio::println(magnitude_label(Point { x: 3, y: 0 }))
    stdio::println(magnitude_label(Point { x: 4, y: 4 }))
}
