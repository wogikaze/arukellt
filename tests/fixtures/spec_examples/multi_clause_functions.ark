use std::host::stdio::Stdio
fn classify(0) -> String = "zero"
fn classify(1) -> String = "one"
fn classify(_) -> String = "other"
fn negate(true) -> bool = false
fn negate(false) -> bool = true
fn unwrap_or_zero(Option::Some(v)) -> i32 = v
fn unwrap_or_zero(None) -> i32 = 0
fn greet("hello") -> String = "hi"
fn greet("bye") -> String = "goodbye"
fn greet(_) -> String = "huh?"
fn echo("ping") -> String = "pong"
fn echo(s) -> String = s
fn answer(42) -> String = "life"
fn answer(n) -> String = "unknown"
fn main() {
    Stdio::println(classify(0))
    Stdio::println(classify(2))
    Stdio::println((negate(true)).to_string())
    Stdio::println((unwrap_or_zero(Option::Some(7))).to_string())
    Stdio::println((unwrap_or_zero(None)).to_string())
    Stdio::println(greet("bye"))
    Stdio::println(echo("ping"))
    Stdio::println(echo("zzz"))
    Stdio::println(answer(42))
    Stdio::println(answer(1))
}
