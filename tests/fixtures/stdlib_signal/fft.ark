use std::host::stdio::Stdio
use std::signal::Signal
use std::text
fn assert_close(actual: f64, expected: f64) {
    if !Signal::approx_eq(actual, expected, 0.001) {
        Std::panic("expected ".concat((expected).to_string().concat(", got ".concat((actual).to_string()))))
    }
}

fn assert_vec_close(actual: Vec<f64>, expected: Vec<f64>) {
    if len(actual) != len(expected) {
        Std::panic("vector length mismatch")
    }
    let mut i = 0
    while i < len(actual) {
        assert_close(get_unchecked(actual, i), get_unchecked(expected, i))
        i = i + 1
    }
}

fn main() {
    let mut impulse = Vec::new<f64>()
    push(impulse, 1.0)
    push(impulse, 0.0)
    push(impulse, 0.0)
    push(impulse, 0.0)
    let mut impulse_r = Signal::clone_f64(impulse)
    let mut impulse_i = Signal::zeros(len(impulse))
    Signal::fft(impulse_r, impulse_i)
    let mut ones = Vec::new<f64>()
    push(ones, 1.0)
    push(ones, 1.0)
    push(ones, 1.0)
    push(ones, 1.0)
    let zeros = Signal::zeros(4)
    assert_vec_close(impulse_r, ones)
    assert_vec_close(impulse_i, zeros)
    let mut shifted = Vec::new<f64>()
    push(shifted, 0.0)
    push(shifted, 1.0)
    push(shifted, 0.0)
    push(shifted, 0.0)
    let mut shift_r = Signal::clone_f64(shifted)
    let mut shift_i = Signal::zeros(len(shifted))
    Signal::fft(shift_r, shift_i)
    let mut expected_shift_r = Vec::new<f64>()
    push(expected_shift_r, 1.0)
    push(expected_shift_r, 0.0)
    push(expected_shift_r, 0.0 - 1.0)
    push(expected_shift_r, 0.0)
    let mut expected_shift_i = Vec::new<f64>()
    push(expected_shift_i, 0.0)
    push(expected_shift_i, 0.0 - 1.0)
    push(expected_shift_i, 0.0)
    push(expected_shift_i, 1.0)
    assert_vec_close(shift_r, expected_shift_r)
    assert_vec_close(shift_i, expected_shift_i)
    let mut seq = Vec::new<f64>()
    push(seq, 1.0)
    push(seq, 2.0)
    push(seq, 3.0)
    push(seq, 4.0)
    let mut roundtrip_r = Signal::clone_f64(seq)
    let mut roundtrip_i = Signal::zeros(len(seq))
    Signal::fft(roundtrip_r, roundtrip_i)
    Signal::ifft(roundtrip_r, roundtrip_i)
    let mut expected_seq = Vec::new<f64>()
    push(expected_seq, 1.0)
    push(expected_seq, 2.0)
    push(expected_seq, 3.0)
    push(expected_seq, 4.0)
    assert_vec_close(roundtrip_r, expected_seq)
    assert_vec_close(roundtrip_i, zeros)
    Stdio::println("fft ok")
}
