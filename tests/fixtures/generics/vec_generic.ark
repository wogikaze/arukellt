use std::host::stdio::Stdio

fn first<T>(v: Vec<T>) -> Option<T> {
    if len(v) > 0 {
        Some(get_unchecked(v, 0))
    } else {
        None
    }
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 99)
    match first(v) {
        Option::Some(val) => Stdio::println((val).to_string()),
        None => Stdio::println("empty"),
    }
}
