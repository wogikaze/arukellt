use std::host::stdio::Stdio

struct Opts {
    target: String,
    wit_paths: Vec<String>,
}

fn default_opts() -> Opts {
    Opts {
        target: String_from("wasm32-gc"),
        wit_paths: Vec::new<String>(),
    }
}

fn main() {
    let mut options = default_opts()
    options.wit_paths.push(String_from("x"))
    Stdio::println((options.wit_paths.len()).to_string())
}
