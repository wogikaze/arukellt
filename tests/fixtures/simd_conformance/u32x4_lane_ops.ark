// u32x4 lane surface: construction, arithmetic, comparisons, min/max, and
// shifts all lower to 0xfd SIMD instructions.
use std::simd::u32x4::U32x4
use std::test

fn lane(v: v128, index: i32) -> i32 {
    U32x4::extract_lane(v, index)
}

fn construct_cases() {
    let a = U32x4::splat(3)
    let b = U32x4::replace_lane(a, 2, 5)
    test::assert_eq_i32(lane(b, 2), 5)
    test::assert_eq_i32(lane(U32x4::zero(), 3), 0)
    let n = U32x4::new(1, 2, 3, 4)
    test::assert_eq_i32(lane(n, 0), 1)
    test::assert_eq_i32(lane(n, 3), 4)
}

fn arithmetic_cases() {
    let a = U32x4::splat(3)
    let b = U32x4::replace_lane(a, 2, 5)
    test::assert_eq_i32(lane(U32x4::add(a, b), 2), 8)
    test::assert_eq_i32(lane(U32x4::sub(b, a), 2), 2)
    test::assert_eq_i32(lane(U32x4::mul(a, b), 2), 15)
    test::assert_eq_i32(lane(U32x4::neg(a), 0), -3)
    test::assert_eq_i32(lane(U32x4::abs(U32x4::splat(-3)), 0), 3)
}

fn comparison_cases() {
    let a = U32x4::splat(3)
    test::assert_eq_i32(lane(U32x4::eq(a, a), 0), -1)
    test::assert_eq_i32(lane(U32x4::ne(a, a), 0), 0)
    test::assert_eq_i32(lane(U32x4::lt_u(U32x4::splat(1), U32x4::splat(2)), 0), -1)
    test::assert_eq_i32(lane(U32x4::le_u(U32x4::splat(2), U32x4::splat(2)), 0), -1)
    test::assert_eq_i32(lane(U32x4::gt_u(U32x4::splat(3), U32x4::splat(2)), 0), -1)
    test::assert_eq_i32(lane(U32x4::ge_u(U32x4::splat(1), U32x4::splat(2)), 0), 0)
    // 0xFFFF_FFFF is the largest unsigned lane: it must not compare as -1 < 1.
    test::assert_eq_i32(lane(U32x4::lt_u(U32x4::splat(-1), U32x4::splat(1)), 0), 0)
    test::assert_eq_i32(lane(U32x4::gt_u(U32x4::splat(-1), U32x4::splat(1)), 0), -1)
    test::assert_eq_i32(lane(U32x4::min_u(U32x4::splat(3), U32x4::splat(5)), 0), 3)
    test::assert_eq_i32(lane(U32x4::max_u(U32x4::splat(3), U32x4::splat(5)), 0), 5)
}

fn shift_cases() {
    test::assert_eq_i32(lane(U32x4::shl(U32x4::splat(1), 3), 0), 8)
    test::assert_eq_i32(lane(U32x4::shr_u(U32x4::splat(8), 3), 0), 1)
}

test "u32x4_lanes_support_arithmetic_comparison_and_shift" {
    construct_cases()
    arithmetic_cases()
    comparison_cases()
    shift_cases()
}
