use std::bytes
use std::host::stdio::Stdio
use std::io

fn main() {
    let mut out: io::Stdout = io::Stdout::new()
    let r: Result<i32, io::IoError> = out.write_string("stdout line\n")
    match r {
        Result::Ok(_) => (),
        Result::Err(e) => Stdio::println(e.message()),
    }
    let mut w2: io::Writer = io::Writer::new()
    let r2: Result<i32, io::IoError> = w2.write_string("buffered")
    match r2 {
        Result::Ok(_) => Stdio::println("write ok"),
        Result::Err(e) => Stdio::println(e.message()),
    }
    Stdio::println(String::from_utf8_lossy(w2.into_bytes()))
}
