use std::bytes
use std::host::stdio
use std::io

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(104)
    data.push_byte(101)
    data.push_byte(108)
    data.push_byte(108)
    data.push_byte(111)
    data.push_byte(32)
    data.push_byte(119)
    data.push_byte(111)
    data.push_byte(114)
    data.push_byte(108)
    data.push_byte(100)
    let mut src: io::Reader = io::Reader::from_bytes(data)
    let mut dst: io::Writer = io::Writer::new()
    let res: Result<i64, io::IoError> = io::Io::copy(src, dst)
    match res {
        Result::Ok(n) => stdio::println((n).to_string()),
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    let out: Vec<i32> = dst.into_bytes()
    stdio::println(String::from_utf8_lossy(out))
    stdio::println((src.is_eof()).to_string())
}
