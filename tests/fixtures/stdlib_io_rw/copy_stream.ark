use std::bytes
use std::host::stdio
use std::io

fn main() {
    let data: Vec<i32> = bytes::bytes_new()
    bytes::bytes_push(data, 104)
    bytes::bytes_push(data, 101)
    bytes::bytes_push(data, 108)
    bytes::bytes_push(data, 108)
    bytes::bytes_push(data, 111)
    bytes::bytes_push(data, 32)
    bytes::bytes_push(data, 119)
    bytes::bytes_push(data, 111)
    bytes::bytes_push(data, 114)
    bytes::bytes_push(data, 108)
    bytes::bytes_push(data, 100)
    let src: io::Reader = io::Reader::from_bytes(data)
    let dst: io::Writer = io::Writer::new()
    let res: Result<i64, io::IoError> = io::Io::copy(src, dst)
    match res {
        Result::Ok(n) => stdio::println((n).to_string()),
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    let out: Vec<i32> = dst.into_bytes()
    stdio::println(bytes::string_from_bytes(out))
    stdio::println((src.is_eof()).to_string())
}
