use std::bytes
use std::host::stdio
use std::io

fn main() {
    let w: io::Writer = io::Writer::new()
    let r1: Result<i32, io::IoError> = w.write_string("hello")
    match r1 {
        Result::Ok(n) => stdio::println((n).to_string()),
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    let r2: Result<i32, io::IoError> = w.write_string(" world")
    match r2 {
        Result::Ok(n) => stdio::println((n).to_string()),
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    let b: Vec<i32> = w.into_bytes()
    stdio::println(bytes::string_from_bytes(b))
    let rf: Result<(), io::IoError> = w.flush()
    match rf {
        Result::Ok(_) => stdio::println("flush ok"),
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
}
