use std::bytes
use std::host::stdio::Stdio
use std::io
use std::text

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(72)
    data.push_byte(105)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    // Try to read_exact 5 bytes from a 2-byte reader -> IoError::UnexpectedEof
    match io::Io::read_exact(r, 5) {
        Result::Ok(_) => Stdio::println("unexpected-ok"),
        Result::Err(err) => match err {
            io::IoError::UnexpectedEof(msg) => Stdio::println(msg),
            io::IoError::Other(msg) => Stdio::println("other:".concat(msg)),
        },
    }
}
