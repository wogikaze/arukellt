use std::bytes
use std::host::stdio
use std::io
use std::io::{BufReader, BufWriter, Reader, Writer}

fn main() {
    let data: Vec<i32> = bytes::bytes_new()
    bytes::bytes_push(data, 76)
    bytes::bytes_push(data, 105)
    bytes::bytes_push(data, 110)
    bytes::bytes_push(data, 101)
    bytes::bytes_push(data, 49)
    bytes::bytes_push(data, 10)
    bytes::bytes_push(data, 76)
    bytes::bytes_push(data, 105)
    bytes::bytes_push(data, 110)
    bytes::bytes_push(data, 101)
    bytes::bytes_push(data, 50)
    bytes::bytes_push(data, 10)
    bytes::bytes_push(data, 76)
    bytes::bytes_push(data, 105)
    bytes::bytes_push(data, 110)
    bytes::bytes_push(data, 101)
    bytes::bytes_push(data, 51)
    let br: BufReader<Reader> = BufReader::new<Reader>(Reader::from_bytes(data), 64)
    let l1: Result<Option<String>, io::IoError> = br.read_line()
    match l1 {
        Result::Ok(found) => match found {
            Option::Some(line) => stdio::println(line),
            Option::None => stdio::println("<eof>"),
        },
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    let l2: Result<Option<String>, io::IoError> = br.read_line()
    match l2 {
        Result::Ok(found) => match found {
            Option::Some(line) => stdio::println(line),
            Option::None => stdio::println("<eof>"),
        },
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    let l3: Result<Option<String>, io::IoError> = br.read_line()
    match l3 {
        Result::Ok(found) => match found {
            Option::Some(line) => stdio::println(line),
            Option::None => stdio::println("<eof>"),
        },
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    // The tagged stdout handle cannot be a generic Write sink yet, so the
    // adapter writes into a memory Writer and the fixture prints the flushed
    // image itself. Output stays identical to the legacy tagged path.
    let bw: BufWriter<Writer> = BufWriter::new<Writer>(Writer::new(), 8)
    let _: Result<i32, io::IoError> = bw.write_string("buffered")
    let _: Result<(), io::IoError> = bw.flush()
    match bw.into_inner() {
        Result::Ok(inner) => stdio::println(bytes::string_from_bytes(inner.into_bytes())),
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    stdio::println("done")
}
