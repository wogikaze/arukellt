use std::bytes
use std::host::stdio::Stdio
use std::io
use std::io::{BufReader, BufWriter, Reader, Writer}

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(76)
    data.push_byte(105)
    data.push_byte(110)
    data.push_byte(101)
    data.push_byte(49)
    data.push_byte(10)
    data.push_byte(76)
    data.push_byte(105)
    data.push_byte(110)
    data.push_byte(101)
    data.push_byte(50)
    data.push_byte(10)
    data.push_byte(76)
    data.push_byte(105)
    data.push_byte(110)
    data.push_byte(101)
    data.push_byte(51)
    let mut br: BufReader<Reader> = BufReader::new<Reader>(Reader::from_bytes(data), 64)
    let l1: Result<Option<String>, io::IoError> = br.read_line()
    match l1 {
        Result::Ok(found) => match found {
            Option::Some(line) => Stdio::println(line),
            Option::None => Stdio::println("<eof>"),
        },
        Result::Err(e) => Stdio::println(e.message()),
    }
    let l2: Result<Option<String>, io::IoError> = br.read_line()
    match l2 {
        Result::Ok(found) => match found {
            Option::Some(line) => Stdio::println(line),
            Option::None => Stdio::println("<eof>"),
        },
        Result::Err(e) => Stdio::println(e.message()),
    }
    let l3: Result<Option<String>, io::IoError> = br.read_line()
    match l3 {
        Result::Ok(found) => match found {
            Option::Some(line) => Stdio::println(line),
            Option::None => Stdio::println("<eof>"),
        },
        Result::Err(e) => Stdio::println(e.message()),
    }
    // The tagged stdout handle cannot be a generic Write sink yet, so the
    // adapter writes into a memory Writer and the fixture prints the flushed
    // image itself. Output stays identical to the legacy tagged path.
    let mut bw: BufWriter<Writer> = BufWriter::new<Writer>(Writer::new(), 8)
    let _: Result<i32, io::IoError> = bw.write_string("buffered")
    let _: Result<(), io::IoError> = bw.flush()
    match bw.into_inner() {
        Result::Ok(inner) => Stdio::println(String::from_utf8_lossy(inner.into_bytes())),
        Result::Err(e) => Stdio::println(e.message()),
    }
    Stdio::println("done")
}
