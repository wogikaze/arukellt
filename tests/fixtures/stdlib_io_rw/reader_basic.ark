use std::bytes
use std::host::stdio::Stdio
use std::io

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(72)
    data.push_byte(101)
    data.push_byte(108)
    data.push_byte(108)
    data.push_byte(111)
    data.push_byte(10)
    data.push_byte(87)
    data.push_byte(111)
    data.push_byte(114)
    data.push_byte(108)
    data.push_byte(100)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    Stdio::println((r.is_eof()).to_string())
    let res: Result<Vec<i32>, io::IoError> = r.read(5)
    match res {
        Result::Ok(chunk) => Stdio::println(String::from_utf8_lossy(chunk)),
        Result::Err(e) => Stdio::println(e.message()),
    }
    // After reading "Hello", cursor sits on the newline. The first read_line
    // consumes it (empty line); the second returns the remainder "World".
    match r.read_line() {
        Result::Ok(found) => match found {
            Option::Some(line) => Stdio::println(line),
            Option::None => Stdio::println("<eof>"),
        },
        Result::Err(e) => Stdio::println(e.message()),
    }
    match r.read_line() {
        Result::Ok(found) => match found {
            Option::Some(line) => Stdio::println(line),
            Option::None => Stdio::println("<eof>"),
        },
        Result::Err(e) => Stdio::println(e.message()),
    }
    Stdio::println((r.is_eof()).to_string())
}
