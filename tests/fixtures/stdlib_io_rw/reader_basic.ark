use std::bytes
use std::host::stdio
use std::io

fn main() {
    let data: Vec<i32> = bytes::bytes_new()
    bytes::bytes_push(data, 72)
    bytes::bytes_push(data, 101)
    bytes::bytes_push(data, 108)
    bytes::bytes_push(data, 108)
    bytes::bytes_push(data, 111)
    bytes::bytes_push(data, 10)
    bytes::bytes_push(data, 87)
    bytes::bytes_push(data, 111)
    bytes::bytes_push(data, 114)
    bytes::bytes_push(data, 108)
    bytes::bytes_push(data, 100)
    let r: io::Reader = io::Reader::from_bytes(data)
    stdio::println((r.is_eof()).to_string())
    let res: Result<Vec<i32>, io::IoError> = r.read(5)
    match res {
        Result::Ok(chunk) => stdio::println(bytes::string_from_bytes(chunk)),
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    // After reading "Hello", cursor sits on the newline. The first read_line
    // consumes it (empty line); the second returns the remainder "World".
    match r.read_line() {
        Result::Ok(found) => match found {
            Option::Some(line) => stdio::println(line),
            Option::None => stdio::println("<eof>"),
        },
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    match r.read_line() {
        Result::Ok(found) => match found {
            Option::Some(line) => stdio::println(line),
            Option::None => stdio::println("<eof>"),
        },
        Result::Err(e) => stdio::println(io::io_error_message(e)),
    }
    stdio::println((r.is_eof()).to_string())
}
