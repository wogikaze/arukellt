use std::core::convert
use std::test::Test

fn main() {
    let r: Result<i32, String> = i32::try_from(String_from("123"))
    match r {
        Result::Ok(v) => Test::assert_eq_i32(v, 123),
        Result::Err(e) => Std::panic("expected Ok"),
    }
    let z: Result<i32, String> = i32::try_from(String_from("0"))
    match z {
        Result::Ok(v) => Test::assert_eq_i32(v, 0),
        Result::Err(e) => Std::panic("expected Ok"),
    }
}
