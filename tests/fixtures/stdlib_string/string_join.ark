use std::test::Test
use std::test

fn main() {
    let mut parts: Vec<String> = Vec::new<String>()
    push(parts, String_from("one"))
    push(parts, String_from("two"))
    push(parts, String_from("three"))
    let result: String = parts.join(String_from("-"))
    Test::assert_eq_string(result, "one-two-three")
}
