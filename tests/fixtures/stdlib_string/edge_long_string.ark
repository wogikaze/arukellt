use std::test::Test
use std::prelude::{ends_with, repeat, starts_with}
fn main() {
    let s = repeat(String_from("abcdefghij"), 10)
    Test::assert_eq_i32(len(s), 100)
    Test::assert_true(starts_with(s, String_from("abcdefghij")))
    Test::assert_true(ends_with(s, String_from("abcdefghij")))
}
