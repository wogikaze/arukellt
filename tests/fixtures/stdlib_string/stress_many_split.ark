use std::test::Test
use std::test
use std::text

fn main() {
    let mut s = String_from("")
    let mut i = 0
    while i < 10 {
        s = s.concat(i.to_string())
        s = s.concat(String_from(","))
        i = i + 1
    }
    let parts = s.split(String_from(","))
    Test::assert_eq_i32(parts.len(), 11)
}
