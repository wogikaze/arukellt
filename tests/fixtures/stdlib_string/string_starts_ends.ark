use std::test::Test
fn main() {
    let s: String = String_from("hello world")
    Test::assert_true(s.starts_with(String_from("hello")))
    Test::assert_false(s.starts_with(String_from("world")))
    Test::assert_true(s.ends_with(String_from("world")))
    Test::assert_false(s.ends_with(String_from("hello")))
}
