use std::test::Test
use std::test

fn main() {
    let s: String = String_from("a,b,c")
    let parts: Vec<String> = s.split(String_from(","))
    Test::assert_eq_i32(parts.len(), 3)
    Test::assert_eq_string(parts.get_unchecked(0), "a")
    Test::assert_eq_string(parts.get_unchecked(1), "b")
    Test::assert_eq_string(parts.get_unchecked(2), "c")
}
