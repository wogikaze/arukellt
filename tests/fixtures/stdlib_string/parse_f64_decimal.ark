use std::core::convert
use std::test::Test
use std::test

fn main() {
    let r: Result<f64, String> = f64::try_from(String_from("3.14159"))
    match r {
        // Compare via to_string: source f64 lit 3.14159 is not bit-identical to parse.
        Result::Ok(v) => Test::assert_eq_string(v.to_string(), "3.14159"),
        Result::Err(e) => Std::panic("expected Ok"),
    }
}
