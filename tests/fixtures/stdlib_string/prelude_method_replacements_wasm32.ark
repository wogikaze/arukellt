use std::test::Test
// Receiver-method replacements for the 27 prelude frees retired by ADR-091
// (the parse_* frees remain deferred).
use std::test

fn main() {
    let s: String = String_from("Ab")
    Test::assert_eq_string(s.clone(), "Ab")
    Test::assert_eq_i32(s.len_bytes(), 2)
    Test::assert_false(s.is_empty())

    let empty: String = String_new()
    Test::assert_true(empty.is_empty())
    let mut values: Vec<i32> = Vec::new<i32>()
    Test::assert_true(values.is_empty())
    push(values, 1)

    Test::assert_eq_string(String_from(" AbC ").trim().to_lower(), "abc")
    Test::assert_eq_string(String_from("abc").to_upper(), "ABC")
    Test::assert_eq_string(String_from("a,b,c").split(",").join("-"), "a-b-c")
    Test::assert_eq_string(String_from("ab").repeat(2), "abab")
    Test::assert_eq_string(String_from("x").pad_left(3), "  x")
    Test::assert_eq_string(String_from("x").pad_right(3), "x  ")
    Test::assert_eq_string(String_from("aXbX").replace("X", "-"), "a-b-")
    Test::assert_eq_i32(String_from("a\nb").lines().len(), 2)

    Test::assert_eq_i32((0 - 5).abs(), 5)
    Test::assert_eq_i32((3).min(7), 3)
    Test::assert_eq_i32((3).max(7), 7)
    Test::assert_eq_i32((15).clamp(0, 10), 10)
    Test::assert_eq_i32((12).gcd(18), 6)
    Test::assert_eq_i32((9.0).sqrt().to_string().len(), 1)

    Test::assert_eq_string((true).to_string(), "true")
    Test::assert_eq_string((42).to_string(), "42")
}
