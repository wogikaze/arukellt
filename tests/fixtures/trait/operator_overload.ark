use std::host::stdio::Stdio
use std::core::ops
use std::core::cmp

struct Vec2 {
    x: i32,
    y: i32,
}

impl Copy for Vec2 {}

impl Add for Vec2 {
    fn add(self: Vec2, other: Vec2) -> Vec2 {
        Vec2 { x: self.x + other.x, y: self.y + other.y }
    }
}

impl Sub for Vec2 {
    fn sub(self: Vec2, other: Vec2) -> Vec2 {
        Vec2 { x: self.x - other.x, y: self.y - other.y }
    }
}

impl Eq for Vec2 {
    fn eq(self: Vec2, other: Vec2) -> bool {
        self.x == other.x && self.y == other.y
    }
}

impl Ord for Vec2 {
    fn cmp(self: Vec2, other: Vec2) -> Ordering {
        if self.x < other.x {
            return Ordering::Less
        }
        if self.x > other.x {
            return Ordering::Greater
        }
        if self.y < other.y {
            return Ordering::Less
        }
        if self.y > other.y {
            return Ordering::Greater
        }
        Ordering::Equal
    }
}

fn main() {
    let a = Vec2 { x: 1, y: 2 }
    let b = Vec2 { x: 3, y: 4 }
    let c = a + b
    Stdio::println(c.x)
    Stdio::println(c.y)
    let d = b - a
    Stdio::println(d.x)
    Stdio::println(d.y)
    let e = Vec2 { x: 1, y: 2 }
    if a == e {
        Stdio::println(1)
    } else {
        Stdio::println(0)
    }
    if a != b {
        Stdio::println(1)
    } else {
        Stdio::println(0)
    }
    if a < b {
        Stdio::println(1)
    } else {
        Stdio::println(0)
    }
}
