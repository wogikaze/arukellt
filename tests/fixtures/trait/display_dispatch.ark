use std::host::stdio::Stdio
use std::test::Test

// #702: the free-function and method forms of `to_string` must agree for
// every builtin Display impl, including the String identity case. This
// guards the dual-dispatch path until the builtin rewrite is retired.
fn main() {
    Test::assert_eq_string(42.to_string(), 42.to_string())
    Test::assert_eq_string((9001i64).to_string(), 9001i64.to_string())
    Test::assert_eq_string((1.5).to_string(), 1.5.to_string())
    Test::assert_eq_string(true.to_string(), true.to_string())
    Test::assert_eq_string(('a').to_string(), ('a').to_string())
    Test::assert_eq_string(
        String_from("hello").to_string(),
        String_from("hello").to_string()
    )
    Stdio::println("OK")
}
