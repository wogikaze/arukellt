use std::host::stdio::Stdio
use std::text
trait Greet {}

struct Dog {
    name: String,
}

impl Greet for Dog {
    fn greet(self: Dog) -> String {
        String_from("Woof! I'm ").concat(self.name)
    }
}

fn main() {
    let d: Dog = Dog { name: String_from("Rex") }
    Stdio::println(d.greet())
}
