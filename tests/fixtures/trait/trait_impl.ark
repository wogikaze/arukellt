use std::host::stdio
use std::text
trait Greet {}

struct Dog {
    name: String,
}

impl Greet for Dog {
    fn greet(self: Dog) -> String {
        text::concat(String_from("Woof! I'm "), self.name)
    }
}

fn main() {
    let d: Dog = Dog { name: String_from("Rex") }
    stdio::println(d.greet())
}
