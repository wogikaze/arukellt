use std::host::stdio

enum Shape {
    Circle {
        radius: i32,
    },
    Rect {
        width: i32,
        height: i32,
    },
}

fn area(s: Shape) -> i32 {
    match s {
        Shape::Circle { radius } => radius * radius * 3,
        Shape::Rect { width, height } => width * height,
    }
}

fn choose_shape(is_rect: bool) -> Shape {
    if is_rect {
        Shape::Rect { width: 4, height: 6 }
    } else {
        Shape::Circle { radius: 5 }
    }
}

fn main() {
    let c = choose_shape(false)
    let r = choose_shape(true)
    stdio::println((area(c)).to_string())
    stdio::println((area(r)).to_string())
}
