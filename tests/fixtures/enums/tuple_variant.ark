use std::host::stdio
use std::text
enum Shape {
    Circle(f64),
    Rectangle(f64, f64),
}

fn describe(s: Shape) -> String {
    match s {
        Shape::Circle(r) => String_from("circle r=").concat((r).to_string()),
        Shape::Rectangle(w, h) => String_from("rect ").concat((w).to_string()).concat(String_from("x").concat((h).to_string())),
    }
}

fn main() {
    stdio::println(describe(Shape::Circle(5.0)))
    stdio::println(describe(Shape::Rectangle(3.0, 4.0)))
}
