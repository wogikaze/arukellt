use std::host::stdio::Stdio

struct Box {
    s: String,
}

// `Box<args>` still names the prelude enum when a non-generic user struct
// shadows the bare name (#905). The explicit return annotation also lets the
// older pin infer `take` without a method turbofish.
fn make_prelude_box() -> Box<i32> {
    Box::Owned(41)
}

fn main() {
    let b = Box { s: "shadow" }
    Stdio::println(b.s)
    Stdio::println((make_prelude_box().take() + 1).to_string())
}
