use std::collections::vec
use std::core::iter

pub fn user_add_seven(x: i32) -> i32 {
    x + 7
}

pub fn user_search() -> i32 {
    let mut values = Vec::new<i32>()
    values.push(2)
    values.push(5)
    values.push(9)
    values.binary_search(5)
}

pub fn user_sequence_checks() -> bool {
    let mut values = Vec::new<i32>()
    values.push(4)
    values.push(2)
    values.push(4)
    values.iter().count_eq(4) == 2 &&
    values.min() == 2 &&
    values.max() == 4
}

fn main() -> i32 {
    if user_sequence_checks() {
        user_add_seven(user_search())
    } else {
        0
    }
}
