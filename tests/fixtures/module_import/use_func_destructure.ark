// Fixture: use_func_destructure.ark
// Issue #717: `use std::collections::string::{index_of}` imports the function
// `index_of` directly into scope. Bare call `index_of(s, sep)` resolves to
// `string::index_of(s, sep)` via the use-alias mechanism.
//
// Expected output: 1
use std::collections::string::{index_of}

fn main() {
    let s: String = "a,b"
    let sep: String = ","
    let index = index_of(s, sep)
    __intrinsic_println(__intrinsic_i32_to_string(index))
}
