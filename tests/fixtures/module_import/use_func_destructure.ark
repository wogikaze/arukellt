// Fixture: use_func_destructure.ark
// Issue #717: `use std::collections::linear::{deque_new, deque_push_back}`
// imports the functions directly into scope, so the bare `deque_new(...)` /
// `deque_push_back(...)` calls resolve through the use-alias mechanism.
//
// Expected output: true
use std::collections::linear::{deque_new, deque_push_back, deque_len}

fn main() {
    let mut d: Vec<i32> = deque_new()
    deque_push_back(d, 7)
    __intrinsic_println((deque_len(d) == 1).to_string())
}
