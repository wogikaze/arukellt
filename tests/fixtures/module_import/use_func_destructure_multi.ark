// Fixture: use_func_destructure_multi.ark
// Issue #717: `use std::collections::string::{clone, eq}` imports both
// functions directly into scope. Bare calls `clone(...)` and `eq(...)`
// resolve to `string::clone(...)` / `string::eq(...)` via the use-alias
// mechanism.
//
// Expected output: true
use std::collections::string::{clone, eq}

fn main() {
    let s: String = "a,b,c"
    let copy = clone(s)
    let begins = eq(copy, "a,b,c")
    __intrinsic_println(begins.to_string())
}
