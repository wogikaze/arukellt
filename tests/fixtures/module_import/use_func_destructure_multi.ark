// Fixture: use_func_destructure_multi.ark
// Issue #717: `use std::text::{concat, is_empty}` imports both functions
// directly into scope. Bare calls `concat(...)` and `is_empty(...)` resolve to
// `text::concat(...)` / `text::is_empty(...)` via the use-alias mechanism.
//
// Expected output: true
use std::text::{concat, is_empty}
use std::prelude::{eq}

fn main() {
    let s: String = "a,b,c"
    let joined = concat(s, "!")
    let empty = is_empty("")
    __intrinsic_println((eq(joined, "a,b,c!") && !empty).to_string())
}
