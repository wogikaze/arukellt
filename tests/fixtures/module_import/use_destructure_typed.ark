// Fixture: use_destructure_typed.ark
// Slice 3 continuation of issue #039: verify that destructure import
// `use std::host::{stdio}` type-checks qualified calls. The typechecker must
// resolve `io::read_stdin_line` via the qualified fn_sigs key, and the
// `Result<String, IoError>` match pins its return type.
//
// Expected output: yes
use std::host::{stdio}
use std::io

fn main() {
    let s: String = "hello world"
    let line = match io::read_stdin_line() {
        Ok(text) => text,
        Err(_) => "error",
    }
    let equal: bool = line.is_empty() && s.eq("hello world")
    if equal {
        stdio::println("yes")
    } else {
        stdio::println("no")
    }
}
