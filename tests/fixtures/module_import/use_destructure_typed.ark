use std::host::{stdio}

fn main() {
    let s: String = "hello world"
    let line: String = stdio::Stdio::read_stdin()
    let equal: bool = line.is_empty() && s.eq("hello world")
    if equal {
        stdio::Stdio::println("yes")
    } else {
        stdio::Stdio::println("no")
    }
}
