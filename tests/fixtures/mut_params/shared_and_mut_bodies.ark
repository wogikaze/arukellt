use std::host::stdio::Stdio

// ADR-088 §2/§3: a `mut` parameter or `mut self` may be assigned in the
// body; a shared parameter or shared receiver stays readable but immutable.

struct Counter {
    n: i32,
}

impl Counter {
    fn bump(mut self) {
        self.n = self.n + 1
    }

    fn value(self) -> i32 {
        self.n
    }
}

fn bump_param(mut p: Counter) {
    p.n = p.n + 1
}

fn read_param(p: Counter) -> i32 {
    p.n
}

fn main() {
    let mut counter = Counter { n: 1 }
    counter.bump()
    bump_param(counter)
    Stdio::println(read_param(counter).to_string())
    Stdio::println(counter.value().to_string())

    let shared = Counter { n: 7 }
    Stdio::println(read_param(shared).to_string())
}
