use std::host::stdio::Stdio
use std::prelude as prelude

// ADR-088 §7: the shared-to-`mut` direction is accepted at every function
// type boundary. A read-only function is safe behind a mutable borrow, so it
// may be passed as an argument, returned, and bound through a qualified path.
struct Point {
    x: i32,
}

fn read(p: Point) -> i32 {
    p.x
}

fn apply(f: fn(mut Point) -> i32, mut p: Point) -> i32 {
    f(p)
}

fn pick_reader() -> fn(mut Point) -> i32 {
    read
}

fn main() {
    let mut point = Point { x: 4 }
    Stdio::println(apply(read, point).to_string())

    let reader = pick_reader()
    Stdio::println(reader(point).to_string())

    // The qualified path is recovered for the same direction check. Calling a
    // function value that points at a std prelude function is a separate
    // emitter limitation, so this fixture only pins the annotation boundary.
    let _push_fn: fn(mut Vec<i32>, i32) = prelude::push
}
