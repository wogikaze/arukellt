use std::host::stdio::Stdio

struct Counter {
    n: i32,
}

struct Wrapper {
    counter: Counter,
}

impl Counter {
    fn bump(mut self) {
        self.n = self.n + 1
    }

    fn value(self) -> i32 {
        self.n
    }
}

fn bump_param(mut p: Counter) {
    p.n = p.n + 1
}

fn add_to(mut p: Counter, amount: i32) {
    p.n = p.n + amount
}

fn main() {
    let mut counter = Counter { n: 1 }
    counter.bump()
    bump_param(counter)
    add_to(counter, 2)
    Stdio::println(counter.value().to_string())

    let mut wrapper = Wrapper { counter: Counter { n: 10 } }
    bump_param(wrapper.counter)
    Stdio::println(wrapper.counter.value().to_string())

    let mut base = 5
    let increment = |mut v: i32| {
        v = v + 1
        v
    }
    Stdio::println(increment(base).to_string())
    Stdio::println(base.to_string())
}
