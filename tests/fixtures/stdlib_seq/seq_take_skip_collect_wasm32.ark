// The lazy TakeIter / SkipIter collectors keep their boundary conditions
// on linear wasm32 after the deprecated std::seq wrappers were removed.
use std::core::iter
use std::test::Test

fn main() {
    let mut values: Vec<i32> = Vec::new<i32>()
    push(values, 1)
    push(values, 2)
    push(values, 3)
    push(values, 4)
    push(values, 5)

    let first_two = values.iter().take(2).collect()
    Test::assert_eq_i32(first_two.len(), 2)
    Test::assert_eq_i32(first_two.get_unchecked(0), 1)
    Test::assert_eq_i32(first_two.get_unchecked(1), 2)

    let none = values.iter().take(0).collect()
    Test::assert_eq_i32(none.len(), 0)
    let all = values.iter().take(99).collect()
    Test::assert_eq_i32(all.len(), 5)
    Test::assert_eq_i32(all.get_unchecked(4), 5)

    let after_two = values.iter().skip(2).collect()
    Test::assert_eq_i32(after_two.len(), 3)
    Test::assert_eq_i32(after_two.get_unchecked(0), 3)
    Test::assert_eq_i32(after_two.get_unchecked(2), 5)

    let unchanged = values.iter().skip(0).collect()
    Test::assert_eq_i32(unchanged.len(), 5)
    let skipped_all = values.iter().skip(99).collect()
    Test::assert_eq_i32(skipped_all.len(), 0)
}
