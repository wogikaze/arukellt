// Vec<String> through the Vec<T: Ord> receiver surface that replaced the
// generic std::seq algorithms (binary_search, lower_bound, upper_bound,
// min/max, min_by_key/max_by_key, binary_search_by_key). The user calls at
// String must emit and bind a dedicated __String instance: the
// first-registered __i32 body was not a valid fallback (gc: invalid wasm;
// linear: i32 body on struct pointers). Regression coverage for the
// dual-instantiation mis-bind.
use std::collections::vec
use std::test

fn key_self(x: String) -> String {
    x
}

fn main() {
    let mut s: Vec<String> = Vec::new<String>()
    push(s, String_from("alpha"))
    push(s, String_from("beta"))
    push(s, String_from("gamma"))

    test::assert_eq_i32(s.binary_search(String_from("beta")), 1)
    test::assert_eq_i32(s.binary_search(String_from("zed")), 0 - 1)
    test::assert_eq_i32(s.lower_bound(String_from("beta")), 1)
    test::assert_eq_i32(s.lower_bound(String_from("aaa")), 0)
    test::assert_eq_i32(s.upper_bound(String_from("beta")), 2)
    test::assert_eq_i32(s.upper_bound(String_from("zzz")), 3)
    test::assert_eq_i32(
        s.binary_search_by_key(String_from("gamma"), key_self),
        2
    )

    test::assert_eq_string(s.min(), String_from("alpha"))
    test::assert_eq_string(s.max(), String_from("gamma"))
    test::assert_eq_string(s.min_by_key(key_self), String_from("alpha"))
    test::assert_eq_string(s.max_by_key(key_self), String_from("gamma"))
}
