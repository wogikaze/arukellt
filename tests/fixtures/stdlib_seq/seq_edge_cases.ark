use std::host::stdio::Stdio
use std::collections::vec
use std::core::iter

fn main() {
    let mut sorted: Vec<i32> = Vec::new<i32>()
    push(sorted, 1)
    push(sorted, 3)
    push(sorted, 5)
    push(sorted, 7)
    push(sorted, 9)
    Stdio::println((sorted.binary_search(5)).to_string())
    Stdio::println((sorted.binary_search(1)).to_string())
    Stdio::println((sorted.binary_search(9)).to_string())
    Stdio::println((sorted.binary_search(4)).to_string())
    let mut nums: Vec<i32> = Vec::new<i32>()
    push(nums, 4)
    push(nums, 2)
    push(nums, 7)
    push(nums, 1)
    push(nums, 9)
    push(nums, 3)
    Stdio::println((nums.min()).to_string())
    Stdio::println((nums.max()).to_string())
    Stdio::println((nums.iter().sum()).to_string())
    let mut single: Vec<i32> = Vec::new<i32>()
    push(single, 42)
    Stdio::println((single.min()).to_string())
    Stdio::println((single.max()).to_string())
    Stdio::println((single.iter().sum()).to_string())
    let mut haystack: Vec<i32> = Vec::new<i32>()
    push(haystack, 10)
    push(haystack, 20)
    push(haystack, 30)
    push(haystack, 40)
    Stdio::println((haystack.iter().contains(30)).to_string())
    Stdio::println((haystack.iter().contains(25)).to_string())
    let mut dupes: Vec<i32> = Vec::new<i32>()
    push(dupes, 1)
    push(dupes, 2)
    push(dupes, 2)
    push(dupes, 3)
    push(dupes, 3)
    push(dupes, 3)
    push(dupes, 1)
    let mut unique_count: i32 = 0
    for value in dupes.iter().unique() {
        unique_count = unique_count + 1
    }
    Stdio::println((unique_count).to_string())
    let mut counted: Vec<i32> = Vec::new<i32>()
    push(counted, 1)
    push(counted, 2)
    push(counted, 2)
    push(counted, 3)
    push(counted, 2)
    push(counted, 1)
    Stdio::println((counted.iter().count_eq(2)).to_string())
    Stdio::println((counted.iter().count_eq(5)).to_string())
}
// === binary_search edge cases ===
// find middle
// find first
// find last
// not found
// === min/max/sum edge cases ===
// single element
// === contains edge cases ===
// === unique with duplicates ===
// === count_eq ===
