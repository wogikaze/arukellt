use std::host::stdio::Stdio
use std::core::iter

fn double(x: i32) -> i32 {
    x * 2
}

fn is_even(x: i32) -> bool {
    x / 2 * 2 == x
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(1)
    v.push(2)
    v.push(3)
    v.push(4)
    v.push(5)
    let doubled: Vec<i32> = v.iter().map(double).collect()
    Stdio::println((doubled.len()).to_string())
    Stdio::println((get_unchecked(doubled, 0)).to_string())
    Stdio::println((get_unchecked(doubled, 4)).to_string())
    let evens: Vec<i32> = v.iter().filter(is_even).collect()
    Stdio::println((evens.len()).to_string())
    Stdio::println((get_unchecked(evens, 0)).to_string())
    Stdio::println((get_unchecked(evens, 1)).to_string())
}
// map: double each element
// filter: keep even numbers
