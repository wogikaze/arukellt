use std::host::stdio::Stdio
use std::core::iter

fn double(x: i32) -> i32 {
    x * 2
}

fn is_even(x: i32) -> bool {
    x / 2 * 2 == x
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5)
    let doubled: Vec<i32> = v.iter().map(double).collect()
    Stdio::println((doubled.len()).to_string())
    Stdio::println((doubled.get_unchecked(0)).to_string())
    Stdio::println((doubled.get_unchecked(4)).to_string())
    let evens: Vec<i32> = v.iter().filter(is_even).collect()
    Stdio::println((evens.len()).to_string())
    Stdio::println((evens.get_unchecked(0)).to_string())
    Stdio::println((evens.get_unchecked(1)).to_string())
}
// map: double each element
// filter: keep even numbers
