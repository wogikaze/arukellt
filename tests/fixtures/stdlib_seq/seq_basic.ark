use std::host::stdio::Stdio
use std::collections::vec
use std::core::iter
fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 3)
    push(v, 1)
    push(v, 4)
    push(v, 1)
    push(v, 5)
    Stdio::println((v.iter().sum()).to_string())
    Stdio::println((v.min()).to_string())
    Stdio::println((v.max()).to_string())
    Stdio::println((v.iter().contains(4)).to_string())
    Stdio::println((v.iter().contains(9)).to_string())
    Stdio::println((v.iter().count_eq(1)).to_string())
    v.sort()
    let idx: i32 = v.binary_search(4)
    Stdio::println((idx).to_string())
    let mut unique_count: i32 = 0
    for value in v.iter().unique() {
        unique_count = unique_count + 1
    }
    Stdio::println((unique_count).to_string())
}
// binary search on sorted vec
// unique
