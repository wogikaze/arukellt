use std::host::stdio::Stdio
use std::wit::printer
use std::wit::types
use std::wit::world

fn main() {
    let mut iface = world::Interface::new(String_from("math"))
    let mut params = Vec::new<WitParam>()
    params.push(types::WitParam::new(String_from("a"), types::WitType::U32))
    params.push(types::WitParam::new(String_from("b"), types::WitType::U32))
    let func = world::WitFunc::new(String_from("add"), params, Some(types::WitType::U32))
    iface.add_func(func)
    let mut w = world::World::new(String_from("demo"))
    w.add_export(iface)
    let text = w.to_wit()
    Stdio::println(text)
}
// World::to_wit renders the world block
