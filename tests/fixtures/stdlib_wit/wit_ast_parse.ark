// Issue #706: WIT AST parser — parse world/interface/record/enum/flags.
// Accessors are `WitNode` methods (#917).
use std::host::stdio
use std::wit::ast
use std::wit::types
fn main() {
    // Parse a simple world declaration
    let src = String_from("world hello { }")
    let node = ast::WitNode::parse(src)
    assert(node.kind().eq(String_from("world")))
    assert(node.name().eq(String_from("hello")))
    assert(node.child_count() == 0)

    // Parse an interface declaration
    let src2 = String_from("interface my-iface { }")
    let node2 = ast::WitNode::parse(src2)
    assert(node2.kind().eq(String_from("interface")))
    assert(node2.name().eq(String_from("my-iface")))

    // Parse a record declaration
    let src3 = String_from("record point { x: u32, y: u32 }")
    let node3 = ast::WitNode::parse(src3)
    assert(node3.kind().eq(String_from("record")))
    assert(node3.name().eq(String_from("point")))
    assert(node3.child_count() == 2)
    assert(node3.field_name_at(0).eq(String_from("x")))
    assert(node3.field_name_at(1).eq(String_from("y")))
    assert((node3.field_type_at(0)).wit_text().eq(String_from("u32")))
    assert(node3.field_name_at(9).eq(String_new()))
    assert((node3.field_type_at(9)).id() == 0)

    // Parse an enum declaration
    let src4 = String_from("enum color { red, green, blue }")
    let node4 = ast::WitNode::parse(src4)
    assert(node4.kind().eq(String_from("enum")))
    assert(node4.name().eq(String_from("color")))
    assert(node4.child_count() == 3)
    assert(node4.enum_variant_at(1).eq(String_from("green")))
    assert(node4.enum_variant_at(9).eq(String_new()))

    // Parse flags declaration
    let src5 = String_from("flags perms { read, write, exec }")
    let node5 = ast::WitNode::parse(src5)
    assert(node5.kind().eq(String_from("flags")))
    assert(node5.name().eq(String_from("perms")))
    assert(node5.child_count() == 3)
    assert(node5.flags_member_at(2).eq(String_from("exec")))

    // Parse a variant declaration
    let src6 = String_from("variant shape { circle(u32), empty }")
    let node6 = ast::WitNode::parse(src6)
    assert(node6.kind().eq(String_from("variant")))
    assert(node6.child_count() == 2)
    assert(node6.variant_case_name_at(0).eq(String_from("circle")))
    assert(node6.variant_case_has_payload(0))
    assert(!node6.variant_case_has_payload(1))
    assert((node6.variant_case_type_at(0)).wit_text().eq(String_from("u32")))
    assert((node6.variant_case_type_at(1)).id() == 0)

    // Parse a func declaration
    let src7 = String_from("f: func(a: u32, b: string) -> bool;")
    let node7 = ast::WitNode::parse(src7)
    assert(node7.kind().eq(String_from("func")))
    assert(node7.func_param_count() == 2)
    assert(node7.func_param_name_at(1).eq(String_from("b")))
    assert((node7.func_param_type_at(0)).wit_text().eq(String_from("u32")))
    assert(node7.func_has_result())
    assert((node7.func_result()).wit_text().eq(String_from("bool")))

    // Parse a type alias and a use declaration
    let node8 = ast::WitNode::parse(String_from("type meters = u32;"))
    assert(node8.kind().eq(String_from("type")))
    assert((node8.type_alias_target()).wit_text().eq(String_from("u32")))
    let node9 = ast::WitNode::parse(String_from("use pkg:dep/iface as alias;"))
    assert(node9.kind().eq(String_from("use")))
    assert(node9.use_path().eq(String_from("pkg:dep/iface")))
    assert(node9.use_alias().eq(String_from("alias")))

    // first_interface_name walks package/world containers
    let pkg_src = String_from("package test:host@0.1.0; interface math { }")
    let pkg = ast::WitNode::parse(pkg_src)
    assert(pkg.kind().eq(String_from("package")))
    assert(pkg.first_interface_name().eq(String_from("math")))
    let world_src = String_from("world demo { interface inner { } }")
    let world = ast::WitNode::parse(world_src)
    assert(world.first_interface_name().eq(String_from("inner")))

    // out-of-range child access reports an Error node instead of trapping
    assert(world.child_at(5).kind().eq(String_from("error")))
    assert(node3.child_at(0).kind().eq(String_from("error")))

    // wit_text: render WitType as WIT text
    assert((types::WitType::Bool).wit_text().eq(String_from("bool")))
    assert((types::WitType::String).wit_text().eq(String_from("string")))
    assert((types::WitType::U32).wit_text().eq(String_from("u32")))

    // import_metadata seals the recursive AST as scalar metadata before it
    // crosses the std::wit/compiler boundary.
    let src_meta = String_from("package test:host@0.1.0; interface math { add: func(a: s32, b: s32) -> s32; }")
    let metadata = ast::WitNode::import_metadata(src_meta)
    assert(metadata.contains("header|test:host|0.1.0|math"))
    assert(metadata.contains("func|add|s32~s32|s32"))

    stdio::println(String_from("OK"))
}
