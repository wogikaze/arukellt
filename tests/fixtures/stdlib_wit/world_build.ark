use std::host::stdio::Stdio
use std::wit::types
use std::wit::world

fn main() {
    let mut iface = world::Interface::new(String_from("math"))
    let mut params = Vec::new<WitParam>()
    push(params, types::WitParam::new(String_from("a"), types::WitType::U32))
    push(params, types::WitParam::new(String_from("b"), types::WitType::U32))
    let func = world::WitFunc::new(String_from("add"), params, Some(types::WitType::U32))
    iface.add_func(func)
    let mut w = world::World::new(String_from("example"))
    w.add_export(iface)
    Stdio::println(w.name())
    Stdio::println((w.exports_len()).to_string())
}
// World build with export interface
