// WIT world builder methods on the linear wasm32 target (ADR-044/ADR-046).
use std::host::stdio
use std::wit::types
use std::wit::world

fn main() {
    let math = world::Interface::new(String_from("math"))
    let params = Vec::new<WitParam>()
    push(params, types::WitParam::new(String_from("a"), types::wit_type_u32()))
    let add = world::WitFunc::new(String_from("add"), params, Some(types::wit_type_u32()))
    math.add_func(add)

    let w = world::World::new(String_from("demo"))
    w.add_import(math)
    w.add_export(world::Interface::new(String_from("api")))
    stdio::println(w.name())
    stdio::println((w.exports_len()).to_string())
}
