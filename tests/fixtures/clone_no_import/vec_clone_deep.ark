// No `use std::core::clone`: the prelude imports the unbounded
// `impl<T> Clone for Vec<T>`, so `.clone()` must allocate independent element
// storage on the default target. Option clones keep the compiler identity path.
fn main() {
    let mut strings: Vec<String> = Vec::new<String>()
    strings.push(String_from("source"))
    let mut strings_copy = strings.clone()
    strings_copy.set(0, String_from("copy"))
    assert(get_unchecked(strings, 0).eq("source"))
    assert(get_unchecked(strings_copy, 0).eq("copy"))

    let mut numbers: Vec<i32> = Vec::new<i32>()
    numbers.push(7)
    let mut numbers_copy = numbers.clone()
    numbers_copy.set(0, 9)
    assert(get_unchecked(numbers, 0) == 7)
    assert(get_unchecked(numbers_copy, 0) == 9)

    let option: Option<String> = Option::Some(String_from("payload"))
    let option_copy = option.clone()
    match option_copy {
        Option::Some(text) => { assert(text.eq("payload")) },
        Option::None => { assert(false) },
    }
}
