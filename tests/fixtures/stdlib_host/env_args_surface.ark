// Env argument/environment surface on wasm32-gc (P2 component) (#917).
//
// Covers Env::args, Env::var, Env::arg_count, and Env::has_flag. The fixture
// runner passes no program arguments and no probe environment variable, so
// the argument vector is empty and the probe variable is unset.
use std::host::env::Env
use std::host::stdio

fn main() {
    let values = Env::args()
    stdio::println((len(values)).to_string())
    stdio::println((Env::arg_count()).to_string())
    match Env::var("ARUKELLT_ENV_ARGS_PROBE_917") {
        Option::Some(value) => stdio::println(value),
        Option::None => stdio::println("env-var-unset"),
    }
    assert(Env::var_or_default("ARUKELLT_ENV_ARGS_PROBE_917", "fallback") == "fallback")
    assert(!Env::has_flag("--arukellt-probe-flag"))
    stdio::println("env-args-surface-ok")
}
