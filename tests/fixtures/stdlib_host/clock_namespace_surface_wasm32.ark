// Clock namespace for the host clock reads (ADR-046, #917), linear target.
use std::host::clock::Clock
use std::host::stdio
use std::test

fn main() {
    let first = Clock::monotonic_now()
    let second = Clock::monotonic_now()
    test::assert_true(second >= first)
    let wall = Clock::now_ms()
    test::assert_true(wall > 0i64)
    stdio::println("clock-namespace-ok")
}
