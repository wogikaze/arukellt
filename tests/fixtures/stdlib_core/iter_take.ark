use std::core::iter
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)
    v.push(50)

    let taken = v.iter().take(3).collect()
    Test::assert_eq_i32(taken.len(), 3)
    Test::assert_eq_i32(get_unchecked(taken, 0), 10)
    Test::assert_eq_i32(get_unchecked(taken, 2), 30)

    // Take more than available
    let taken_all = v.iter().take(100).collect()
    Test::assert_eq_i32(taken_all.len(), 5)
}
