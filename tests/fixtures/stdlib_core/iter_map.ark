use std::core::iter
use std::test::Test

fn double(x: i32) -> i32 { x * 2 }

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)

    let doubled = v.iter().map(double).collect()
    Test::assert_eq_i32(doubled.len(), 3)
    Test::assert_eq_i32(get_unchecked(doubled, 0), 2)
    Test::assert_eq_i32(get_unchecked(doubled, 1), 4)
    Test::assert_eq_i32(get_unchecked(doubled, 2), 6)
}
