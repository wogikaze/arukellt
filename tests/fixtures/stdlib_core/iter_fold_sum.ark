use std::core::iter
use std::test

fn add(a: i32, b: i32) -> i32 { a + b }

fn is_pos(x: i32) -> bool { x > 0 }

fn main() {
    let v: Vec<i32> = Vec::new<i32>()
    push(v, 1)
    push(v, 2)
    push(v, 3)
    push(v, 4)
    push(v, 5)

    let sum = v.iter().fold(0, add)
    test::assert_eq_i32(sum, 15)

    let sum2 = v.iter().sum()
    test::assert_eq_i32(sum2, 15)

    // any / all
    test::assert_true(v.iter().any(is_pos))
    test::assert_true(v.iter().all(is_pos))
}
