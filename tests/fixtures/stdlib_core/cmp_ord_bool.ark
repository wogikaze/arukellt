use std::core::cmp
use std::test::Test

fn main() {
    // Ord trait dispatch for bool — false < true
    match false.cmp(true) {
        Ordering::Less => Test::assert_true(true),
        _ => Std::panic("expected Less"),
    }
    match true.cmp(false) {
        Ordering::Greater => Test::assert_true(true),
        _ => Std::panic("expected Greater"),
    }
    match false.cmp(false) {
        Ordering::Equal => Test::assert_true(true),
        _ => Std::panic("expected Equal"),
    }
}
