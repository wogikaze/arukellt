use std::core::either::{Either}
use std::test

fn double(x: i32) -> i32 { x * 2 }

fn main() {
    let l = Either::Left(21)
    let mapped = l.map_left(double)
    test::assert_true(mapped.is_left())
    test::assert_eq_i32(mapped.from_left(-1), 42)

    // map_left on Right is a no-op
    let r = Either::Right(99)
    let mapped2 = r.map_left(double)
    test::assert_true(mapped2.is_right())
    test::assert_eq_i32(mapped2.from_right(-1), 99)
}
