use std::core::iter
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)
    v.push(50)

    let skipped = v.iter().skip(2).collect()
    Test::assert_eq_i32(skipped.len(), 3)
    Test::assert_eq_i32(get_unchecked(skipped, 0), 30)
    Test::assert_eq_i32(get_unchecked(skipped, 2), 50)

    // Skip more than available
    let skipped_all = v.iter().skip(100).collect()
    Test::assert_eq_i32(skipped_all.len(), 0)
}
