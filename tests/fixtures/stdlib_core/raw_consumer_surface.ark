// Raw representation consumers (ADR-046 / #917) on wasm32-gc: the sealed
// RawArray / RawString / RawFloat bridges lower through the public Vec / String
// / scalar method surface.
use std::collections::string
use std::collections::vec
use std::core::convert
use std::host::stdio
use std::prelude::push_char
use std::test::Test

fn main() {
    let mut values: Vec<i32> = Vec::with_capacity<i32>(2)
    values.push(11)
    Test::assert_eq_i32(values.len(), 1)
    Test::assert_eq_i32(values.get_unchecked(0), 11)
    values.set(0, 17)
    Test::assert_eq_i32(values.get_unchecked(0), 17)

    let mut text = String_new()
    push_char(text, 79)
    push_char(text, 75)
    Test::assert_eq_i32(text.len_bytes(), 2)
    Test::assert_eq_i32(text.byte_at(0), 79)
    Test::assert_eq_string(text.clone(), "OK")

    let parsed: Result<i32, String> = i32::try_from("42")
    match parsed {
        Ok(value) => Test::assert_eq_i32(value, 42),
        Err(_) => Test::assert_true(false),
    }
    let wide: Result<i64, String> = i64::try_from("9001")
    match wide {
        Ok(value) => Test::assert_eq_i64(value, 9001i64),
        Err(_) => Test::assert_true(false),
    }
    let real: Result<f64, String> = f64::try_from("1.5")
    match real {
        Ok(value) => Test::assert_true(value == 1.5f64),
        Err(_) => Test::assert_true(false),
    }

    let root = 9.0f64.sqrt()
    Test::assert_true(root == 3.0f64)
    let widened: f64 = 1.5f32.to_f64()
    Test::assert_true(widened == 1.5f64)
    Test::assert_eq_i32(1.5f64.to_bits_lo(), 0)
    Test::assert_true(1.5f64.to_bits_hi() != 0)
    Test::assert_eq_string(1.5f64.to_string(), "1.5")
    stdio::println("raw consumers ok")
}
