use std::core::{Range}
use std::host::stdio::Stdio

fn main() {
    let r = Range::new(0, 5)
    let inside = r.contains(3)
    let outside = r.contains(5)
    let length = r.len()
    Stdio::println((inside).to_string())
    Stdio::println((outside).to_string())
    Stdio::println((length).to_string())
}
