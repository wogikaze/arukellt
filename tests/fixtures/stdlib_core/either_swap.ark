use std::core::either::{Either}
use std::test::Test

fn main() {
    let mut l = Either::Left(42)
    let swapped = l.swap()
    Test::assert_true(swapped.is_right())
    Test::assert_eq_i32(swapped.from_right(-1), 42)

    let mut r = Either::Right(99)
    let swapped2 = r.swap()
    Test::assert_true(swapped2.is_left())
    Test::assert_eq_i32(swapped2.from_left(-1), 99)
}
