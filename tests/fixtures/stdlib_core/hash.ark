use std::core::hash
use std::host::stdio::Stdio

fn main() {
    let h1 = 42.hash()
    let h2 = 42.hash()
    let h3 = 0.hash()
    let hs1 = "hello".hash()
    let hs2 = "hello".hash()
    Stdio::println((h1 == h2).to_string())
    Stdio::println((h1 != h3).to_string())
    Stdio::println((hs1 == hs2).to_string())
    let combined = h1.combine_hash(hs1)
    Stdio::println((combined != 0).to_string())
}
