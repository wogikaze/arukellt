use std::core::iter
use std::test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 10)
    push(v, 20)
    push(v, 30)

    let mut it = v.iter()
    match it.next() {
        Some(x) => test::assert_eq_i32(x, 10),
        None => panic("expected Some(10)"),
    }
    test::assert_eq_i32(v.iter().count(), 3)
}
