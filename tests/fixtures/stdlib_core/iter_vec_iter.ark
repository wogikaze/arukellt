use std::core::iter
use std::test::Test

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(10)
    v.push(20)
    v.push(30)

    let mut it = v.iter()
    match it.next() {
        Some(x) => Test::assert_eq_i32(x, 10),
        None => Std::panic("expected Some(10)"),
    }
    Test::assert_eq_i32(v.iter().count(), 3)
}
