use std::core::convert
use std::host::stdio::Stdio

fn main() {
    Stdio::println(42.to_string())
    Stdio::println(3.14.to_string())
    Stdio::println(true.to_string())
    let parsed: Result<i32, String> = i32::try_from("123")
    match parsed {
        Ok(v) => Stdio::println(v.to_string()),
        Err(_) => Stdio::println("parse failed"),
    }
}
