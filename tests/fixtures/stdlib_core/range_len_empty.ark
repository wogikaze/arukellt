use std::core::{Range}
use std::test::Test

fn main() {
    let r = Range::new(0, 5)
    Test::assert_eq_i32(r.len(), 5)

    // Empty range (end <= start) has length 0
    let empty = Range::new(5, 5)
    Test::assert_eq_i32(empty.len(), 0)

    let inverted = Range::new(10, 3)
    Test::assert_eq_i32(inverted.len(), 0)
}
