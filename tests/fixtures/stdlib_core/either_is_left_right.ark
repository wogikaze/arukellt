use std::core::either::{Either}
use std::test

fn main() {
    let l = Either::Left(0)
    let r = Either::Right(0)
    // is_left / is_right are complementary
    test::assert_true(l.is_left())
    test::assert_false(l.is_right())
    test::assert_false(r.is_left())
    test::assert_true(r.is_right())
}
