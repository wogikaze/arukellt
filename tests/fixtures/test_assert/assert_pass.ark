use std::host::stdio
use std::prelude::{assert_eq, assert_eq_i64, assert_eq_str, assert_ne}
fn main() {
    assert(true)
    assert_eq(1 + 1, 2)
    assert_ne(1, 2)
    assert_eq_str(String_from("hello"), String_from("hello"))
    let a: i64 = 42i64
    let b: i64 = 42i64
    assert_eq_i64(a, b)
    stdio::println(String_from("all assertions passed"))
}
