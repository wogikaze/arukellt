use std::host::stdio
use std::test::Test
fn main() {
    assert(true)
    Test::assert_eq_i32(1 + 1, 2)
    Test::assert_ne_i32(1, 2)
    Test::assert_eq_string(String_from("hello"), String_from("hello"))
    let a: i64 = 42i64
    let b: i64 = 42i64
    Test::assert_eq_i64(a, b)
    stdio::println(String_from("all assertions passed"))
}
