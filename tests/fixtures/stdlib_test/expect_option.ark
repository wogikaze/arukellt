use std::host::stdio
use std::test::Test
use std::prelude::{assert_eq}
fn main() {
    let some_val: Option<i32> = Some(99)
    let v = Test::expect_some_i32(some_val)
    assert_eq(v, 99)
    let none_val: Option<i32> = None
    Test::expect_none_i32(none_val)
    stdio::println("expect_option ok")
}
