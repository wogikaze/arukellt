use std::bytes
use std::io
use std::test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(65)
    data.push_byte(66)
    let mut w: io::Writer = io::Writer::new()
    let n: Result<i32, io::IoError> = w.write(data)
    match n {
        Result::Ok(count) => test::assert_eq_i32(count, 2),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let image: Vec<i32> = w.into_bytes()
    test::assert_eq_i32(image.len(), 2)
    let mut r: io::Reader = io::Reader::from_bytes(image)
    test::assert_eq_i32(r.len(), 2)
    match r.position() {
        Result::Ok(pos) => test::assert_eq_i64(pos, 0),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let read: Result<Vec<i32>, io::IoError> = r.read(2)
    match read {
        Result::Ok(chunk) => {
            test::assert_eq_i32(chunk.len(), 2)
            test::assert_eq_i32(chunk.get_unchecked(0), 65)
        },
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    match r.position() {
        Result::Ok(pos) => test::assert_eq_i64(pos, 2),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
