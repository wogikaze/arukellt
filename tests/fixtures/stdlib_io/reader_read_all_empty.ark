use std::bytes
use std::io
use std::test::Test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let res: Result<Vec<i32>, io::IoError> = io::Io::read_to_end(r)
    match res {
        Result::Ok(chunk) => Test::assert_eq_i32(chunk.len(), 0),
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
    Test::assert_true(r.is_eof())
}
