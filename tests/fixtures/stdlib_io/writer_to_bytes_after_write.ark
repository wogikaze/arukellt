use std::bytes
use std::io
use std::test

fn main() {
    let w: io::Writer = io::Writer::new()
    let _: Result<i32, io::IoError> = w.write_string("abc")
    let b: Vec<i32> = w.into_bytes()
    test::assert_eq_i32(bytes::bytes_len(b), 3)
    test::assert_eq_string(bytes::string_from_bytes(b), "abc")
}
