use std::bytes
use std::io
use std::test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < 50 {
        data.push_byte(i & 255)
        i = i + 1
    }
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let mut total: i32 = 0
    while !r.is_eof() {
        let res: Result<Vec<i32>, io::IoError> = r.read(3)
        match res {
            Result::Ok(chunk) => total = total + chunk.len(),
            Result::Err(e) => panic(io::io_error_message(e)),
        }
    }
    test::assert_eq_i32(total, 50)
}
