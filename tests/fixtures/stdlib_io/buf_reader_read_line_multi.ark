use std::bytes
use std::io
use std::io::{BufReader, Reader}
use std::test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    data.push_byte(65)
    data.push_byte(10)
    data.push_byte(66)
    data.push_byte(10)
    data.push_byte(67)
    let br: BufReader<Reader> = BufReader::new<Reader>(Reader::from_bytes(data), 32)
    let l1: Result<Option<String>, io::IoError> = br.read_line()
    match l1 {
        Result::Ok(found) => match found {
            Option::Some(line) => test::assert_eq_string(line, "A"),
            Option::None => panic("expected line A"),
        },
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let l2: Result<Option<String>, io::IoError> = br.read_line()
    match l2 {
        Result::Ok(found) => match found {
            Option::Some(line) => test::assert_eq_string(line, "B"),
            Option::None => panic("expected line B"),
        },
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let l3: Result<Option<String>, io::IoError> = br.read_line()
    match l3 {
        Result::Ok(found) => match found {
            Option::Some(line) => test::assert_eq_string(line, "C"),
            Option::None => panic("expected line C"),
        },
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
