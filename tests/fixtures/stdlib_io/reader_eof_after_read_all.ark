use std::bytes
use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(1)
    data.push_byte(2)
    data.push_byte(3)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let _: Result<Vec<i32>, io::IoError> = io::Io::read_to_end(r)
    Test::assert_true(r.is_eof())
}
