use std::bytes
use std::io
use std::test

fn main() {
    let data: Vec<i32> = bytes::bytes_new()
    bytes::bytes_push(data, 1)
    bytes::bytes_push(data, 2)
    bytes::bytes_push(data, 3)
    let r: io::Reader = io::Reader::from_bytes(data)
    let _: Result<Vec<i32>, io::IoError> = io::Io::read_to_end(r)
    test::assert_true(r.is_eof())
}
