use std::bytes
use std::io
use std::test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    data.push_byte(1)
    data.push_byte(2)
    data.push_byte(3)
    let r: io::Reader = io::Reader::from_bytes(data)
    let _: Result<Vec<i32>, io::IoError> = io::Io::read_to_end(r)
    test::assert_true(r.is_eof())
}
