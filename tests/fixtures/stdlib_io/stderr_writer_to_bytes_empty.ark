// Typed stderr keeps the empty-write count contract: zero bytes accepted and
// no newline emitted.
use std::io::{io_error_message, IoError, Stderr, Write}
use std::test

fn main() {
    let err: Stderr = Stderr::new()
    let res: Result<i32, IoError> = err.write(Vec::new<i32>())
    match res {
        Result::Ok(count) => test::assert_eq_i32(count, 0),
        Result::Err(e) => Std::panic(io_error_message(e)),
    }
}
