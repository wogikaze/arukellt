use std::bytes
use std::io
use std::test

fn main() {
    let w: io::Writer = io::Writer::new()
    let res: Result<i32, io::IoError> = w.write_string("test")
    match res {
        Result::Ok(n) => test::assert_eq_i32(n, 4),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let b: Vec<i32> = w.into_bytes()
    test::assert_eq_string(bytes::string_from_bytes(b), "test")
}
