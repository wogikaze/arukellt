use std::bytes
use std::io
use std::test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(10)
    data.push_byte(20)
    data.push_byte(30)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let res: Result<Vec<i32>, io::IoError> = io::Io::read_exact(r, 3)
    match res {
        Result::Ok(_) => (),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    test::assert_true(r.is_eof())
}
