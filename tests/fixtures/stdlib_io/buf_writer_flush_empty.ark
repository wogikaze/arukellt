use std::io
use std::io::{BufWriter, Writer}
use std::test

fn main() {
    let mut bw: BufWriter<Writer> = BufWriter::new<Writer>(Writer::new(), 64)
    let res: Result<(), io::IoError> = bw.flush()
    match res {
        Result::Ok(_) => (),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
