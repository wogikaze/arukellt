use std::bytes
use std::io
use std::io::{BufWriter, Writer}
use std::test::Test

fn main() {
    // Capacity 4 makes the 5-byte write cross the flush threshold before the
    // explicit flush; into_inner proves the bytes reached the inner Writer.
    let mut bw: BufWriter<Writer> = BufWriter::new<Writer>(Writer::new(), 4)
    let res: Result<i32, io::IoError> = bw.write_string("hello")
    match res {
        Result::Ok(n) => Test::assert_eq_i32(n, 5),
        Result::Err(e) => Std::panic(e.message()),
    }
    let res2: Result<(), io::IoError> = bw.flush()
    match res2 {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(e.message()),
    }
    let inner_result: Result<Writer, io::IoError> = bw.into_inner()
    match inner_result {
        Result::Ok(inner) => {
            let b: Vec<i32> = inner.into_bytes()
            Test::assert_eq_i32(b.len(), 5)
            Test::assert_eq_string(String::from_utf8_lossy(b), "hello")
        },
        Result::Err(e) => Std::panic(e.message()),
    }
}
