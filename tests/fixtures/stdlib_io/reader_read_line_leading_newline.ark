use std::bytes
use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(10)
    data.push_byte(88)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let res: Result<Option<String>, io::IoError> = r.read_line()
    match res {
        Result::Ok(found) => match found {
            Option::Some(line) => Test::assert_eq_string(line, ""),
            Option::None => Std::panic("expected an empty line"),
        },
        Result::Err(e) => Std::panic(e.message()),
    }
    let res2: Result<Option<String>, io::IoError> = r.read_line()
    match res2 {
        Result::Ok(found) => match found {
            Option::Some(line) => Test::assert_eq_string(line, "X"),
            Option::None => Std::panic("expected the trailing line"),
        },
        Result::Err(e) => Std::panic(e.message()),
    }
}
