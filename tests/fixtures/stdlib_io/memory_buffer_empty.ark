use std::io
use std::test::Test

fn main() {
    let w: io::Writer = io::Writer::new()
    let r: io::Reader = w.into_reader()
    Test::assert_eq_i32(r.len(), 0)
    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 0),
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
}
