use std::bytes
use std::io
use std::test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(104)
    data.push_byte(105)
    data.push_byte(106)
    let mut src: io::Reader = io::Reader::from_bytes(data)
    let mut dst: io::Writer = io::Writer::new()
    let res: Result<i64, io::IoError> = io::Io::copy(src, dst)
    match res {
        Result::Ok(n) => test::assert_eq_i64(n, 3),
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
    let b: Vec<i32> = dst.into_bytes()
    test::assert_eq_string(String::from_utf8_lossy(b), "hij")
}
