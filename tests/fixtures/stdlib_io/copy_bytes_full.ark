use std::bytes
use std::io
use std::test

fn main() {
    let data: Vec<i32> = bytes::bytes_new()
    bytes::bytes_push(data, 104)
    bytes::bytes_push(data, 105)
    bytes::bytes_push(data, 106)
    let src: io::Reader = io::Reader::from_bytes(data)
    let dst: io::Writer = io::Writer::new()
    let res: Result<i64, io::IoError> = io::Io::copy(src, dst)
    match res {
        Result::Ok(n) => test::assert_eq_i64(n, 3),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let b: Vec<i32> = dst.into_bytes()
    test::assert_eq_string(bytes::string_from_bytes(b), "hij")
}
