use std::bytes
use std::io
use std::test

fn main() {
    let w: io::Writer = io::Writer::new()
    let mut i: i32 = 0
    while i < 50 {
        let _: Result<i32, io::IoError> = w.write_string("ab")
        i = i + 1
    }
    let b: Vec<i32> = w.into_bytes()
    test::assert_eq_i32(b.len(), 100)
}
