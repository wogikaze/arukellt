use std::bytes
use std::io
use std::io::SeekFrom
use std::test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    data.push_byte(1)
    data.push_byte(2)
    let r: io::Reader = io::Reader::from_bytes(data)
    match r.seek(SeekFrom::Start(1i64)) {
        Result::Ok(_) => (),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    match r.seek(SeekFrom::Start(0i64)) {
        Result::Ok(pos) => test::assert_eq_i64(pos, 0),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    match r.position() {
        Result::Ok(pos) => test::assert_eq_i64(pos, 0),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
