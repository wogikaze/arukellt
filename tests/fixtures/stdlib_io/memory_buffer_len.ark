use std::bytes
use std::io
use std::test::Test

fn main() {
    let w: io::Writer = io::Writer::new()
    let r: io::Reader = w.into_reader()
    Test::assert_eq_i32(r.len(), 0)
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(1)
    data.push_byte(2)
    data.push_byte(3)
    let mut w2: io::Writer = io::Writer::new()
    match w2.write(data) {
        Result::Ok(count) => Test::assert_eq_i32(count, 3),
        Result::Err(e) => Std::panic(e.message()),
    }
    let r2: io::Reader = w2.into_reader()
    Test::assert_eq_i32(r2.len(), 3)
}
