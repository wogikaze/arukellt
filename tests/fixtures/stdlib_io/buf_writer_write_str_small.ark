use std::bytes
use std::io
use std::io::{BufWriter, Writer}
use std::test::Test

fn main() {
    let mut bw: BufWriter<Writer> = BufWriter::new<Writer>(Writer::new(), 100)
    let res: Result<i32, io::IoError> = bw.write_string("short")
    match res {
        Result::Ok(n) => Test::assert_eq_i32(n, 5),
        Result::Err(e) => Std::panic(e.message()),
    }
    let res2: Result<(), io::IoError> = bw.flush()
    match res2 {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(e.message()),
    }
    let inner_result: Result<Writer, io::IoError> = bw.into_inner()
    match inner_result {
        Result::Ok(inner) => Test::assert_eq_string(String::from_utf8_lossy(inner.into_bytes()), "short"),
        Result::Err(e) => Std::panic(e.message()),
    }
}
