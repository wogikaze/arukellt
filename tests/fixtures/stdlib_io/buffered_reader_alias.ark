// `buf_reader_new` / `buffered_reader` were the two legacy constructor
// spellings; both are retired, so both capacity variants now go through
// `BufReader::new`.
use std::bytes
use std::io
use std::io::{BufReader, Reader}
use std::test

fn line_data() -> Vec<i32> {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(65)
    data.push_byte(10)
    data
}

fn main() {
    let mut br1: BufReader<Reader> = BufReader::new<Reader>(Reader::from_bytes(line_data()), 64)
    let mut br2: BufReader<Reader> = BufReader::new<Reader>(Reader::from_bytes(line_data()), 1)
    let l1: Result<Option<String>, io::IoError> = br1.read_line()
    let l2: Result<Option<String>, io::IoError> = br2.read_line()
    match l1 {
        Result::Ok(found) => match found {
            Option::Some(line) => test::assert_eq_string(line, "A"),
            Option::None => Std::panic("expected line A from capacity 64"),
        },
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
    match l2 {
        Result::Ok(found) => match found {
            Option::Some(line) => test::assert_eq_string(line, "A"),
            Option::None => Std::panic("expected line A from capacity 1"),
        },
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
}
