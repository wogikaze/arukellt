use std::bytes
use std::io
use std::io::{BufReader, Reader}
use std::test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(88)
    data.push_byte(89)
    data.push_byte(90)
    let mut br: BufReader<Reader> = BufReader::new<Reader>(Reader::from_bytes(data), 16)
    let res: Result<Option<String>, io::IoError> = br.read_line()
    match res {
        Result::Ok(found) => match found {
            Option::Some(line) => test::assert_eq_string(line, "XYZ"),
            Option::None => Std::panic("expected line XYZ"),
        },
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
}
