use std::bytes
use std::io
use std::test::Test

fn main() {
    let mut w: io::Writer = io::Writer::new()
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(88)
    data.push_byte(89)
    let res: Result<(), io::IoError> = io::Io::write_all(w, data)
    match res {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
    let b: Vec<i32> = w.into_bytes()
    Test::assert_eq_i32(b.len(), 2)
}
