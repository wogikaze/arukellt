use std::bytes
use std::io
use std::test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    data.push_byte(65)
    data.push_byte(66)
    data.push_byte(67)
    data.push_byte(68)
    let src: io::Reader = io::Reader::from_bytes(data)
    let dst: io::Writer = io::Writer::new()
    let res: Result<i64, io::IoError> = io::Io::copy(src, dst)
    match res {
        Result::Ok(n) => test::assert_eq_i64(n, 4),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let original: Vec<i32> = dst.into_bytes()
    test::assert_eq_i32(original.get_unchecked(0), 65)
    test::assert_eq_i32(original.get_unchecked(1), 66)
    test::assert_eq_i32(original.get_unchecked(2), 67)
    test::assert_eq_i32(original.get_unchecked(3), 68)
}
