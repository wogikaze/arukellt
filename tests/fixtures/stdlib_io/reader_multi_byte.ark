use std::bytes
use std::io
use std::test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    data.push_byte(72)
    data.push_byte(73)
    data.push_byte(74)
    let r: io::Reader = io::Reader::from_bytes(data)
    test::assert_false(r.is_eof())
    let res: Result<Vec<i32>, io::IoError> = r.read(2)
    match res {
        Result::Ok(chunk) => test::assert_eq_i32(chunk.len(), 2),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    test::assert_false(r.is_eof())
}
