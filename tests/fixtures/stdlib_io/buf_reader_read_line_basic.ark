use std::bytes
use std::io
use std::io::{BufReader, Reader}
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(76)
    data.push_byte(10)
    let mut br: BufReader<Reader> = BufReader::new<Reader>(Reader::from_bytes(data), 64)
    let res: Result<Option<String>, io::IoError> = br.read_line()
    match res {
        Result::Ok(found) => match found {
            Option::Some(line) => Test::assert_eq_string(line, "L"),
            Option::None => Std::panic("expected line L"),
        },
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
}
