use std::bytes
use std::io
use std::io::{BufReader, Reader}
use std::test

fn main() {
    let data: Vec<i32> = bytes::bytes_new()
    bytes::bytes_push(data, 76)
    bytes::bytes_push(data, 10)
    let br: BufReader<Reader> = BufReader::new<Reader>(Reader::from_bytes(data), 64)
    let res: Result<Option<String>, io::IoError> = br.read_line()
    match res {
        Result::Ok(found) => match found {
            Option::Some(line) => test::assert_eq_string(line, "L"),
            Option::None => panic("expected line L"),
        },
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
