use std::bytes
use std::io
use std::test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(65)
    data.push_byte(66)
    data.push_byte(67)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let res: Result<Option<String>, io::IoError> = r.read_line()
    match res {
        Result::Ok(found) => match found {
            Option::Some(line) => test::assert_eq_string(line, "ABC"),
            Option::None => panic("expected the unterminated line"),
        },
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    test::assert_true(r.is_eof())
}
