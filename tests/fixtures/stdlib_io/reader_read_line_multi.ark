use std::bytes
use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(65)
    data.push_byte(10)
    data.push_byte(66)
    data.push_byte(10)
    data.push_byte(67)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let l1: Result<Option<String>, io::IoError> = r.read_line()
    match l1 {
        Result::Ok(found) => match found {
            Option::Some(line) => Test::assert_eq_string(line, "A"),
            Option::None => Std::panic("expected line A"),
        },
        Result::Err(e) => Std::panic(e.message()),
    }
    let l2: Result<Option<String>, io::IoError> = r.read_line()
    match l2 {
        Result::Ok(found) => match found {
            Option::Some(line) => Test::assert_eq_string(line, "B"),
            Option::None => Std::panic("expected line B"),
        },
        Result::Err(e) => Std::panic(e.message()),
    }
    let l3: Result<Option<String>, io::IoError> = r.read_line()
    match l3 {
        Result::Ok(found) => match found {
            Option::Some(line) => Test::assert_eq_string(line, "C"),
            Option::None => Std::panic("expected line C"),
        },
        Result::Err(e) => Std::panic(e.message()),
    }
}
