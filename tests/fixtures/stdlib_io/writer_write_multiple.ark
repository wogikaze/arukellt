use std::bytes
use std::io
use std::test

fn main() {
    let w: io::Writer = io::Writer::new()
    let _: Result<i32, io::IoError> = w.write_string("hello")
    let _: Result<i32, io::IoError> = w.write_string(" world")
    let b: Vec<i32> = w.into_bytes()
    test::assert_eq_string(bytes::string_from_bytes(b), "hello world")
}
