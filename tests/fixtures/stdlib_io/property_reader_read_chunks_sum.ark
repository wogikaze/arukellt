use std::bytes
use std::io
use std::test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(1)
    data.push_byte(2)
    data.push_byte(3)
    data.push_byte(4)
    data.push_byte(5)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let mut total: i32 = 0
    let mut i: i32 = 0
    while i < 5 {
        let res: Result<Vec<i32>, io::IoError> = r.read(1)
        match res {
            Result::Ok(chunk) => total = total + chunk.len(),
            Result::Err(e) => panic(io::io_error_message(e)),
        }
        i = i + 1
    }
    test::assert_eq_i32(total, 5)
    test::assert_true(r.is_eof())
}
