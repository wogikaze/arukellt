use std::bytes
use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(1)
    data.push_byte(2)
    data.push_byte(3)
    data.push_byte(4)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let res: Result<Vec<i32>, io::IoError> = io::Io::read_exact(r, 4)
    match res {
        Result::Ok(chunk) => {
            Test::assert_eq_i32(chunk.len(), 4)
            Test::assert_eq_i32(chunk.get_unchecked(0), 1)
            Test::assert_eq_i32(chunk.get_unchecked(3), 4)
        },
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
    Test::assert_true(r.is_eof())
}
