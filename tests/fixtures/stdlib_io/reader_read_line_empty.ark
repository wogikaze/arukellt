use std::bytes
use std::io
use std::test::Test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let res: Result<Option<String>, io::IoError> = r.read_line()
    match res {
        Result::Ok(found) => match found {
            Option::Some(_) => Std::panic("expected EOF"),
            Option::None => (),
        },
        Result::Err(e) => Std::panic(io::io_error_message(e)),
    }
    Test::assert_true(r.is_eof())
}
