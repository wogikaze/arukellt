use std::bytes
use std::io
use std::test::Test

fn main() {
    // 300 bytes span more than one COPY_CHUNK_BYTES (256) read, so the copy
    // loop must continue past the first chunk instead of reporting a partial
    // transfer as success.
    let mut data: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < 300 {
        data.push_byte(i % 251)
        i = i + 1
    }
    let mut src: io::Reader = io::Reader::from_bytes(data)
    let mut dst: io::Writer = io::Writer::new()
    let res: Result<i64, io::IoError> = io::Io::copy(src, dst)
    match res {
        Result::Ok(n) => Test::assert_eq_i64(n, 300),
        Result::Err(e) => Std::panic(e.message()),
    }
    let b: Vec<i32> = dst.into_bytes()
    Test::assert_eq_i32(b.len(), 300)
    Test::assert_eq_i32(b.get_unchecked(0), 0)
    Test::assert_eq_i32(b.get_unchecked(256), 5)
    Test::assert_eq_i32(b.get_unchecked(299), 48)
}
