// `buf_writer_new` / `buffered_writer` were the two legacy constructor
// spellings; both are retired, so both writer instances now go through
// `BufWriter::new`.
use std::bytes
use std::io
use std::io::{BufWriter, Writer}
use std::test

fn main() {
    let bw1: BufWriter<Writer> = BufWriter::new<Writer>(Writer::new(), 32)
    let bw2: BufWriter<Writer> = BufWriter::new<Writer>(Writer::new(), 32)
    let r1: Result<i32, io::IoError> = bw1.write_string("x")
    let r2: Result<i32, io::IoError> = bw2.write_string("x")
    match r1 {
        Result::Ok(n) => test::assert_eq_i32(n, 1),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    match r2 {
        Result::Ok(n) => test::assert_eq_i32(n, 1),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let first_result: Result<(), io::IoError> = bw1.flush()
    match first_result {
        Result::Ok(_) => (),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let second_result: Result<(), io::IoError> = bw2.flush()
    match second_result {
        Result::Ok(_) => (),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let first_inner: Result<Writer, io::IoError> = bw1.into_inner()
    match first_inner {
        Result::Ok(inner) => test::assert_eq_string(bytes::string_from_bytes(inner.into_bytes()), "x"),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let second_inner: Result<Writer, io::IoError> = bw2.into_inner()
    match second_inner {
        Result::Ok(inner) => test::assert_eq_string(bytes::string_from_bytes(inner.into_bytes()), "x"),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
