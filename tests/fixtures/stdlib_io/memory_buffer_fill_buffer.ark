use std::bytes
use std::io
use std::io::SeekFrom
use std::test

fn main() {
    let data: Vec<i32> = bytes::bytes_new()
    bytes::bytes_push(data, 65)
    bytes::bytes_push(data, 66)
    bytes::bytes_push(data, 67)
    let r: io::Reader = io::Reader::from_bytes(data)
    match r.seek(SeekFrom::Start(1i64)) {
        Result::Ok(pos) => test::assert_eq_i64(pos, 1),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let remaining: Result<Vec<i32>, io::IoError> = r.fill_buf()
    match remaining {
        Result::Ok(buf) => {
            test::assert_eq_i32(bytes::bytes_len(buf), 2)
            test::assert_eq_i32(bytes::bytes_get(buf, 0), 66)
        },
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    match r.position() {
        Result::Ok(pos) => test::assert_eq_i64(pos, 1),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
