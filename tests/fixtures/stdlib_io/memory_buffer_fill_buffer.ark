use std::bytes
use std::io
use std::io::SeekFrom
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(65)
    data.push_byte(66)
    data.push_byte(67)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    match r.seek(SeekFrom::Start(1i64)) {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 1),
        Result::Err(e) => Std::panic(e.message()),
    }
    let remaining: Result<Vec<i32>, io::IoError> = r.fill_buf()
    match remaining {
        Result::Ok(buf) => {
            Test::assert_eq_i32(buf.len(), 2)
            Test::assert_eq_i32(buf.get_unchecked(0), 66)
        },
        Result::Err(e) => Std::panic(e.message()),
    }
    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 1),
        Result::Err(e) => Std::panic(e.message()),
    }
}
