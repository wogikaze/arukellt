use std::bytes
use std::io
use std::io::SeekFrom
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(1)
    data.push_byte(2)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    // Seek rejects negative positions but allows passing the end; the legacy
    // clamp belonged to the removed `seek_to` wrapper (ADR-085 D9).
    match r.seek(SeekFrom::Start(100i64)) {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 100),
        Result::Err(e) => Std::panic(e.message()),
    }
    Test::assert_true(r.is_eof())
    match r.seek(SeekFrom::Start(0i64 - 1i64)) {
        Result::Ok(_) => Std::panic("expected a negative-position error"),
        Result::Err(_) => (),
    }
}
