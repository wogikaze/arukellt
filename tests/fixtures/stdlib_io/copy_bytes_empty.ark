use std::bytes
use std::io
use std::test

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    let mut src: io::Reader = io::Reader::from_bytes(data)
    let mut dst: io::Writer = io::Writer::new()
    let res: Result<i64, io::IoError> = io::Io::copy(src, dst)
    match res {
        Result::Ok(n) => test::assert_eq_i64(n, 0),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
