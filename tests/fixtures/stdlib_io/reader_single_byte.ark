use std::bytes
use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(65)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    Test::assert_false(r.is_eof())
    let res: Result<Vec<i32>, io::IoError> = r.read(1)
    match res {
        Result::Ok(chunk) => Test::assert_eq_i32(chunk.len(), 1),
        Result::Err(e) => Std::panic(e.message()),
    }
    Test::assert_true(r.is_eof())
}
