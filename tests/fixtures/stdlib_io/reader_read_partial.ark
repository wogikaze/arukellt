use std::bytes
use std::io
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(10)
    data.push_byte(20)
    data.push_byte(30)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    let res: Result<Vec<i32>, io::IoError> = r.read(10)
    match res {
        Result::Ok(chunk) => Test::assert_eq_i32(chunk.len(), 3),
        Result::Err(e) => Std::panic(e.message()),
    }
    Test::assert_true(r.is_eof())
}
