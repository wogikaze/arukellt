use std::bytes
use std::io
use std::io::SeekFrom
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(10)
    data.push_byte(20)
    data.push_byte(30)
    let mut r: io::Reader = io::Reader::from_bytes(data)
    match r.seek(SeekFrom::Start(1i64)) {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 1),
        Result::Err(e) => Std::panic(e.message()),
    }
    match r.position() {
        Result::Ok(pos) => Test::assert_eq_i64(pos, 1),
        Result::Err(e) => Std::panic(e.message()),
    }
    let read: Result<Vec<i32>, io::IoError> = r.read(2)
    match read {
        Result::Ok(chunk) => {
            Test::assert_eq_i32(chunk.get_unchecked(0), 20)
            Test::assert_eq_i32(chunk.get_unchecked(1), 30)
        },
        Result::Err(e) => Std::panic(e.message()),
    }
}
