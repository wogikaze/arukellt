use std::io
use std::test::Test

fn main() {
    let mut w: io::Writer = io::Writer::new()
    let res: Result<(), io::IoError> = w.flush()
    match res {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(e.message()),
    }
    let res2: Result<(), io::IoError> = w.flush()
    match res2 {
        Result::Ok(_) => (),
        Result::Err(e) => Std::panic(e.message()),
    }
}
