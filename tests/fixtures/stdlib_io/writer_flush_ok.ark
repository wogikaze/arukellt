use std::io
use std::test

fn main() {
    let w: io::Writer = io::Writer::new()
    let res: Result<(), io::IoError> = w.flush()
    match res {
        Result::Ok(_) => (),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
    let res2: Result<(), io::IoError> = w.flush()
    match res2 {
        Result::Ok(_) => (),
        Result::Err(e) => panic(io::io_error_message(e)),
    }
}
