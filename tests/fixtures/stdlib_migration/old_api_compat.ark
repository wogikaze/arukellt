// Verifies the migrated surface after the ADR-087 Wave 2 deletion of the
// stable seq/combinator frees. The old bare names now fail with E0100; this
// fixture keeps the same observable behavior through the method replacements.
use std::collections::vec
use std::core
use std::core::cmp
use std::core::iter
use std::host::stdio
use std::text

fn double_i32(x: i32) -> i32 {
    x * 2
}

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 3)
    push(v, 1)
    push(v, 2)
    v.sort_by(ascending)
    stdio::println((get_unchecked(v, 0)).to_string())
    stdio::println((get_unchecked(v, 1)).to_string())
    stdio::println((get_unchecked(v, 2)).to_string())
    // Named fn instead of a closure: GC call_ref for map closures still traps (#807).
    let total: i32 = v.iter().map(double_i32).sum()
    stdio::println((total).to_string())
    let s: String = String_from("hello").concat(String_from(" world"))
    stdio::println(s)
}
