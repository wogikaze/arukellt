use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("{\"a\":1,\"b\":2}") {
        Result::Ok(v) => Test::assert_eq_string(json::JsonValue::pretty_text(v, 2), "{\n  \"a\": 1,\n  \"b\": 2\n}"),
        Result::Err(e) => Std::panic("parse object failed: ".concat(e.message())),
    }
}
