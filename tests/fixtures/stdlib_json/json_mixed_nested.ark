use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("{\"data\":[{\"name\":\"alice\",\"scores\":[90,85,95]}]}") {
        Result::Ok(v) => {
            match v.get_field("data") {
                Option::Some(data) => match data.get_index(0) {
                    Option::Some(person) => {
                        match person.get_field("name") {
                            Option::Some(nv) => match nv.as_string() {
                                Option::Some(s) => test::assert_eq_string(s, "alice"),
                                None => Std::panic("expected string"),
                            },
                            None => Std::panic("expected key name"),
                        }
                        match person.get_field("scores") {
                            Option::Some(scores) => match scores.get_index(1) {
                                Option::Some(sv) => match sv.as_i32() {
                                    Option::Some(n) => test::assert_eq_i32(n, 85),
                                    None => Std::panic("expected number"),
                                },
                                None => Std::panic("expected score at 1"),
                            },
                            None => Std::panic("expected key scores"),
                        }
                    },
                    None => Std::panic("expected element 0"),
                },
                None => Std::panic("expected key data"),
            }
        },
        Result::Err(e) => Std::panic("parse mixed nested failed: ".concat(e.message())),
    }
}
