use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("[1,2]") {
        Result::Ok(v) => test::assert_eq_string(json::JsonValue::pretty_text(v, 0), "[\n1,\n2\n]"),
        Result::Err(e) => panic("parse failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("{\"a\":1}") {
        Result::Ok(v) => test::assert_eq_string(json::JsonValue::pretty_text(v, 0), "{\n\"a\": 1\n}"),
        Result::Err(e) => panic("parse object failed: ".concat(e.message())),
    }
}
