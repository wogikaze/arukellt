use std::host::stdio
use std::json
use std::text
fn main() {
    // Stress-test json_decode_string via json_as_string with escape sequences
    match json::JsonValue::parse("\"hello\\nworld\\ttabbed\"") {
        Result::Ok(v) => {
            match v.as_string() {
                Option::Some(s) => {
                    stdio::println((len(s)).to_string())
                    stdio::println(s)
                },
                None => stdio::println("not string"),
            }
        },
        Result::Err(e) => stdio::println("error:".concat(e.message())),
    }
    // Long string with no escapes (tests plain-text batching)
    let long = "\"abcdefghijklmnopqrstuvwxyz0123456789\""
    match json::JsonValue::parse(long) {
        Result::Ok(v) => {
            match v.as_string() {
                Option::Some(s) => stdio::println((len(s)).to_string()),
                None => stdio::println("not string"),
            }
        },
        Result::Err(e) => stdio::println("error:".concat(e.message())),
    }
}
