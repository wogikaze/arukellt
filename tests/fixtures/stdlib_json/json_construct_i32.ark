use std::json
use std::test::Test

fn main() {
    let v = json::JsonValue::int(42)
    Test::assert_eq_string(v.to_text(), "42")
    let neg = json::JsonValue::int(-7)
    Test::assert_eq_string(neg.to_text(), "-7")
    let zero = json::JsonValue::int(0)
    Test::assert_eq_string(zero.to_text(), "0")
}
