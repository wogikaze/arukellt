use std::json
use std::test::Test

fn main() {
    match json::JsonValue::parse("{\"a\"1}") {
        Result::Ok(_) => Std::panic("expected error for missing colon"),
        Result::Err(_) => {},
    }
    match json::JsonValue::parse("{\"a\" 1}") {
        Result::Ok(_) => Std::panic("expected error for missing colon with space"),
        Result::Err(_) => {},
    }
}
