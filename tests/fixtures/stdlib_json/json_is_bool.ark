use std::json
use std::test
use std::text
fn main() {
    match json::parse("true") {
        Result::Ok(v) => {
            test::assert_true(v.is_bool())
            test::assert_false(v.is_null())
            test::assert_false(v.is_number())
            test::assert_false(v.is_string())
            test::assert_false(v.is_array())
            test::assert_false(v.is_object())
        },
        Result::Err(e) => panic("parse failed: ".concat(e.message())),
    }
    match json::parse("false") {
        Result::Ok(v) => test::assert_true(v.is_bool()),
        Result::Err(e) => panic("parse false failed: ".concat(e.message())),
    }
}
