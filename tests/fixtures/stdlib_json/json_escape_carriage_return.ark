use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("\"x\\ry\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => Test::assert_eq_string(s, "x\ry"),
            None => Std::panic("expected string"),
        },
        Result::Err(e) => Std::panic("parse CR failed: ".concat(e.message())),
    }
}
