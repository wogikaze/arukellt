use std::json
use std::test
use std::text
fn main() {
    match json::parse("\"x\\ry\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => test::assert_eq_string(s, "x\ry"),
            None => panic("expected string"),
        },
        Result::Err(e) => panic("parse CR failed: ".concat(e.message())),
    }
}
