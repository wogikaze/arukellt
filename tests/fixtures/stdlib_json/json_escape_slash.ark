use std::json
use std::test
use std::text
fn main() {
    match json::parse("\"a\\/b\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => test::assert_eq_string(s, "a/b"),
            None => panic("expected string"),
        },
        Result::Err(e) => panic("parse slash failed: ".concat(e.message())),
    }
}
