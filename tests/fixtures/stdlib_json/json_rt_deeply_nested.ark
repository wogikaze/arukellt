use std::json
use std::test
use std::text
fn main() {
    let raw = "{\"a\":{\"b\":{\"c\":[1,2,{\"d\":true}]}}}"
    match json::JsonValue::parse(raw) {
        Result::Ok(v) => {
            let s = v.to_text()
            test::assert_eq_string(s, raw)
            match json::JsonValue::parse(s) {
                Result::Ok(v2) => {
                    match v2.get_field("a") {
                        Option::Some(a) => match a.get_field("b") {
                            Option::Some(b) => match b.get_field("c") {
                                Option::Some(c) => match c.get_index(2) {
                                    Option::Some(obj) => match obj.get_field("d") {
                                        Option::Some(dv) => match dv.as_bool() {
                                            Option::Some(b2) => test::assert_eq_bool(b2, true),
                                            None => panic("expected bool"),
                                        },
                                        None => panic("expected key d"),
                                    },
                                    None => panic("expected element 2"),
                                },
                                None => panic("expected key c"),
                            },
                            None => panic("expected key b"),
                        },
                        None => panic("expected key a"),
                    }
                },
                Result::Err(e) => panic("re-parse failed: ".concat(e.message())),
            }
        },
        Result::Err(e) => panic("parse failed: ".concat(e.message())),
    }
}
