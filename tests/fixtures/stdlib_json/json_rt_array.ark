use std::host::stdio
use std::json
use std::text
fn main() {
    // Round-trip: parse an array, stringify, re-parse, and access elements
    let raw = "[1,2,3,99]"
    match json::parse(raw) {
        Result::Ok(arr) => {
            match arr.get_index(0) {
                Option::Some(v) => {
                    match v.as_i32() {
                        Option::Some(n) => stdio::println((n).to_string()),
                        None => stdio::println("not number"),
                    }
                },
                None => stdio::println("index not found"),
            }
            match arr.get_index(3) {
                Option::Some(v) => {
                    match v.as_i32() {
                        Option::Some(n) => stdio::println((n).to_string()),
                        None => stdio::println("not number"),
                    }
                },
                None => stdio::println("index not found"),
            }
            // Stringify and re-parse
            let s = arr.to_text()
            match json::parse(s) {
                Result::Ok(arr2) => {
                    match arr2.get_index(2) {
                        Option::Some(v2) => {
                            match v2.as_i32() {
                                Option::Some(n2) => stdio::println((n2).to_string()),
                                None => stdio::println("not number"),
                            }
                        },
                        None => stdio::println("index not found"),
                    }
                },
                Result::Err(e) => stdio::println("re-parse error:".concat(e.message())),
            }
        },
        Result::Err(e) => stdio::println("error:".concat(e.message())),
    }
}
// array round-trip: parse → index → stringify → re-parse → index
