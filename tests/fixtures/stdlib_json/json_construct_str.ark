use std::json
use std::test::Test

fn main() {
    let v = json::JsonValue::string("hello")
    Test::assert_true(v.is_string())
    match v.as_string() {
        Option::Some(s) => Test::assert_eq_string(s, "hello"),
        None => Std::panic("expected string"),
    }
    Test::assert_eq_string(v.to_text(), "\"hello\"")
}
