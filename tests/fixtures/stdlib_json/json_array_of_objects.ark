use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("[{\"id\":1},{\"id\":2}]") {
        Result::Ok(v) => {
            match v.get_index(0) {
                Option::Some(obj) => match obj.get_field("id") {
                    Option::Some(fv) => match fv.as_i32() {
                        Option::Some(n) => test::assert_eq_i32(n, 1),
                        None => panic("expected number"),
                    },
                    None => panic("expected key id"),
                },
                None => panic("expected element 0"),
            }
            match v.get_index(1) {
                Option::Some(obj) => match obj.get_field("id") {
                    Option::Some(fv) => match fv.as_i32() {
                        Option::Some(n) => test::assert_eq_i32(n, 2),
                        None => panic("expected number"),
                    },
                    None => panic("expected key id"),
                },
                None => panic("expected element 1"),
            }
        },
        Result::Err(e) => panic("parse failed: ".concat(e.message())),
    }
}
