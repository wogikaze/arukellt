use std::json
use std::test::Test

fn main() {
    // EmptyInput
    match json::JsonValue::parse("") {
        Result::Ok(_) => Std::panic("expected EmptyInput"),
        Result::Err(json::JsonParseError::EmptyInput) => {},
        Result::Err(_) => Std::panic("wrong error variant"),
    }
    // TrailingCharacters
    match json::JsonValue::parse("1 2") {
        Result::Ok(_) => Std::panic("expected TrailingCharacters"),
        Result::Err(json::JsonParseError::TrailingCharacters) => {},
        Result::Err(_) => Std::panic("wrong error variant"),
    }
    // UnexpectedCharacter
    match json::JsonValue::parse("?") {
        Result::Ok(_) => Std::panic("expected UnexpectedCharacter"),
        Result::Err(json::JsonParseError::UnexpectedCharacter(_)) => {},
        Result::Err(_) => Std::panic("wrong error variant"),
    }
    // parse_error_message produces non-empty string for each variant
    Test::assert_eq_string((json::JsonParseError::EmptyInput).message(), "empty input")
    Test::assert_eq_string((json::JsonParseError::TrailingCharacters).message(), "trailing characters")
}
