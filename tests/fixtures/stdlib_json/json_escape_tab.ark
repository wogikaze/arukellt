use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("\"a\\tb\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => Test::assert_eq_string(s, "a\tb"),
            None => Std::panic("expected string"),
        },
        Result::Err(e) => Std::panic("parse tab failed: ".concat(e.message())),
    }
}
