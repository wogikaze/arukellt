use std::host::stdio::Stdio
use std::json
use std::text
fn main() {
    // String with escape sequences: encode and verify output matches golden value
    let tab    = json::JsonValue::encode_string("a\tb")
    let nl     = json::JsonValue::encode_string("line1\nline2")
    let cr     = json::JsonValue::encode_string("x\ry")
    let bs     = json::JsonValue::encode_string("a\\b")
    let quotes = json::JsonValue::encode_string("say \"hi\"")
    Stdio::println(tab)
    Stdio::println(nl)
    Stdio::println(cr)
    Stdio::println(bs)
    Stdio::println(quotes)
    // Round-trip: parse escaped JSON string → check decoded length and content
    match json::JsonValue::parse("\"hello\\nworld\"") {
        Result::Ok(v) => {
            match v.as_string() {
                Option::Some(s) => {
                    // decoded string has 11 chars (hello + \n + world)
                    Stdio::println((len(s)).to_string())
                },
                None => Stdio::println("not string"),
            }
        },
        Result::Err(e) => Stdio::println("error:".concat(e.message())),
    }
    // Differential golden: encode then verify exact JSON token
    let golden = "\"a\\tb\""
    Stdio::println((tab.eq(golden)).to_string())
}
// string escape round-trip and differential golden check
