use std::json
use std::test
use std::text
fn main() {
    match json::parse("42") {
        Result::Ok(v) => {
            match v.get_field("key") {
                Option::Some(_) => panic("expected None: json_get on non-object"),
                None => {},
            }
        },
        Result::Err(e) => panic("parse failed: ".concat(e.message())),
    }
    match json::parse("[1,2]") {
        Result::Ok(v) => {
            match v.get_field("key") {
                Option::Some(_) => panic("expected None: json_get on array"),
                None => {},
            }
        },
        Result::Err(e) => panic("parse array failed: ".concat(e.message())),
    }
}
