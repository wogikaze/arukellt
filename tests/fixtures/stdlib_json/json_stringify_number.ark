use std::json
use std::test
use std::text
fn main() {
    match json::parse("42") {
        Result::Ok(v) => test::assert_eq_string(v.to_text(), "42"),
        Result::Err(e) => panic("parse 42 failed: ".concat(e.message())),
    }
    match json::parse("0") {
        Result::Ok(v) => test::assert_eq_string(v.to_text(), "0"),
        Result::Err(e) => panic("parse 0 failed: ".concat(e.message())),
    }
}
