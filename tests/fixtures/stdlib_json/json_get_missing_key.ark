use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("{\"a\":1}") {
        Result::Ok(v) => {
            match v.get_field("missing") {
                Option::Some(_) => panic("expected None for missing key"),
                None => {},
            }
            match v.get_field("a") {
                Option::Some(_) => {},
                None => panic("expected Some for existing key a"),
            }
        },
        Result::Err(e) => panic("parse failed: ".concat(e.message())),
    }
}
