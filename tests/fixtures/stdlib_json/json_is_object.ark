use std::json
use std::test
use std::text
fn main() {
    match json::parse("{\"a\":1}") {
        Result::Ok(v) => {
            test::assert_true(json::is_object(v))
            test::assert_false(json::is_null(v))
            test::assert_false(json::is_bool(v))
            test::assert_false(json::is_number(v))
            test::assert_false(json::is_string(v))
            test::assert_false(json::is_array(v))
        },
        Result::Err(e) => panic("parse failed: ".concat(json::parse_error_message(e))),
    }
    match json::parse("{}") {
        Result::Ok(v) => test::assert_true(json::is_object(v)),
        Result::Err(e) => panic("parse empty object failed: ".concat(json::parse_error_message(e))),
    }
}
