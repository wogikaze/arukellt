use std::json
use std::test
use std::text
fn main() {
    match json::parse("{\"a\":1}") {
        Result::Ok(v) => {
            test::assert_true(v.is_object())
            test::assert_false(v.is_null())
            test::assert_false(v.is_bool())
            test::assert_false(v.is_number())
            test::assert_false(v.is_string())
            test::assert_false(v.is_array())
        },
        Result::Err(e) => panic("parse failed: ".concat(e.message())),
    }
    match json::parse("{}") {
        Result::Ok(v) => test::assert_true(v.is_object()),
        Result::Err(e) => panic("parse empty object failed: ".concat(e.message())),
    }
}
