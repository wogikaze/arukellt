use std::json
use std::test::Test
fn main() {
    let parsed = json::JsonText::parse_string_at("\"\\uD83D\\uDE00\"", 0)
    Test::assert_eq_bool(parsed.is_ok(), true)
    let s = parsed.value()
    Test::assert_eq_i32(len(s), 4)
    Test::assert_eq_i32(s.byte_at(0), 240)
    Test::assert_eq_i32(s.byte_at(1), 159)
    Test::assert_eq_i32(s.byte_at(2), 152)
    Test::assert_eq_i32(s.byte_at(3), 128)
}
