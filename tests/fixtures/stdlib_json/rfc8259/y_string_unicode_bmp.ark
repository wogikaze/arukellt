use std::json
use std::test::Test
use std::text
fn main() {
    // U+00E9 LATIN SMALL LETTER E WITH ACUTE
    match json::JsonValue::parse("\"\\u00E9\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => {
                Test::assert_eq_i32(s.len(), 2)
                Test::assert_eq_i32(s.byte_at(0), 195)
                Test::assert_eq_i32(s.byte_at(1), 169)
            },
            None => Std::panic("expected string"),
        },
        Result::Err(e) => Std::panic("parse bmp unicode failed: ".concat(e.message())),
    }
}
