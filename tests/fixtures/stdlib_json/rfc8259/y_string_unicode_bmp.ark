use std::json
use std::test

fn main() {
    // U+00E9 LATIN SMALL LETTER E WITH ACUTE
    match json::parse("\"\\u00E9\"") {
        Result::Ok(v) => match json::json_as_string(v) {
            Option::Some(s) => {
                test::assert_eq_i32(len(s), 2)
                test::assert_eq_i32(char_at(s, 0), 195)
                test::assert_eq_i32(char_at(s, 1), 169)
            },
            None => panic("expected string"),
        },
        Result::Err(e) => panic(concat("parse bmp unicode failed: ", json::parse_error_message(e))),
    }
}
