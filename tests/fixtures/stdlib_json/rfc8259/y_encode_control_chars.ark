use std::json
use std::test::Test
use std::text
fn main() {
    // U+0001 must be escaped as \u0001 inside a JSON string literal.
    let encoded = json::JsonValue::encode_string(char_to_string(1))
    Test::assert_eq_string(encoded, "\"\\u0001\"")
    let with_nullish = json::JsonValue::encode_string(char_to_string(0).concat("a"))
    Test::assert_eq_string(with_nullish, "\"\\u0000a\"")
}
