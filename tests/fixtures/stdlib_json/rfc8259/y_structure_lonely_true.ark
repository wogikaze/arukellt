use std::json
use std::test
use std::text
fn main() {
    match json::parse("true") {
        Result::Ok(v) => match v.as_bool() {
            Option::Some(b) => test::assert_eq_bool(b, true),
            None => panic("expected bool"),
        },
        Result::Err(e) => panic("parse true failed: ".concat(e.message())),
    }
}
