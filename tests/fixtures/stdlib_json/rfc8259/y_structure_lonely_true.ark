use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("true") {
        Result::Ok(v) => match v.as_bool() {
            Option::Some(b) => Test::assert_eq_bool(b, true),
            None => Std::panic("expected bool"),
        },
        Result::Err(e) => Std::panic("parse true failed: ".concat(e.message())),
    }
}
