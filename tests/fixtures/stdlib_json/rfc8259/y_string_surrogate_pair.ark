use std::json
use std::test::Test
use std::prelude::{byte_at}
use std::text
fn main() {
    // U+1F600 GRINNING FACE as UTF-16 surrogate pair \uD83D\uDE00
    match json::JsonValue::parse("\"\\uD83D\\uDE00\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => {
                // UTF-8 encoding is 4 bytes: F0 9F 98 80
                Test::assert_eq_i32(len(s), 4)
                Test::assert_eq_i32(byte_at(s, 0), 240)
                Test::assert_eq_i32(byte_at(s, 1), 159)
                Test::assert_eq_i32(byte_at(s, 2), 152)
                Test::assert_eq_i32(byte_at(s, 3), 128)
            },
            None => Std::panic("expected string"),
        },
        Result::Err(e) => Std::panic("parse surrogate failed: ".concat(e.message())),
    }
}
