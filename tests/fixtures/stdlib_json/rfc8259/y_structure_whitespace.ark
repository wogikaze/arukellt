use std::json
use std::test
use std::text
fn main() {
    match json::parse("\n\t true \r\n") {
        Result::Ok(v) => match json::json_as_bool(v) {
            Option::Some(b) => test::assert_eq_bool(b, true),
            None => panic("expected bool"),
        },
        Result::Err(e) => panic("parse whitespace failed: ".concat(json::parse_error_message(e))),
    }
}
