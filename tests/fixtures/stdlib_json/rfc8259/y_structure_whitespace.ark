use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("\n\t true \r\n") {
        Result::Ok(v) => match v.as_bool() {
            Option::Some(b) => test::assert_eq_bool(b, true),
            None => Std::panic("expected bool"),
        },
        Result::Err(e) => Std::panic("parse whitespace failed: ".concat(e.message())),
    }
}
