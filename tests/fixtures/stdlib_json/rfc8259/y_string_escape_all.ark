use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => {
                Test::assert_eq_i32(len(s), 8)
                Test::assert_eq_i32(s.byte_at(0), 34)
                Test::assert_eq_i32(s.byte_at(1), 92)
                Test::assert_eq_i32(s.byte_at(2), 47)
                Test::assert_eq_i32(s.byte_at(3), 8)
                Test::assert_eq_i32(s.byte_at(4), 12)
                Test::assert_eq_i32(s.byte_at(5), 10)
                Test::assert_eq_i32(s.byte_at(6), 13)
                Test::assert_eq_i32(s.byte_at(7), 9)
            },
            None => Std::panic("expected string"),
        },
        Result::Err(e) => Std::panic("parse escapes failed: ".concat(e.message())),
    }
}
