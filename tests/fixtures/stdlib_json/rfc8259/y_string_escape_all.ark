use std::json
use std::test::Test
use std::prelude::{byte_at}
use std::text
fn main() {
    match json::JsonValue::parse("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => {
                Test::assert_eq_i32(len(s), 8)
                Test::assert_eq_i32(byte_at(s, 0), 34)
                Test::assert_eq_i32(byte_at(s, 1), 92)
                Test::assert_eq_i32(byte_at(s, 2), 47)
                Test::assert_eq_i32(byte_at(s, 3), 8)
                Test::assert_eq_i32(byte_at(s, 4), 12)
                Test::assert_eq_i32(byte_at(s, 5), 10)
                Test::assert_eq_i32(byte_at(s, 6), 13)
                Test::assert_eq_i32(byte_at(s, 7), 9)
            },
            None => Std::panic("expected string"),
        },
        Result::Err(e) => Std::panic("parse escapes failed: ".concat(e.message())),
    }
}
