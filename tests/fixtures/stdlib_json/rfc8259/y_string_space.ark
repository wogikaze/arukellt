use std::json
use std::test
use std::text
fn main() {
    match json::parse("\" \"") {
        Result::Ok(v) => match json::json_as_string(v) {
            Option::Some(s) => test::assert_eq_string(s, " "),
            None => panic("expected string"),
        },
        Result::Err(e) => panic("parse space failed: ".concat(json::parse_error_message(e))),
    }
}
