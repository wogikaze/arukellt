use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("\" \"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => test::assert_eq_string(s, " "),
            None => panic("expected string"),
        },
        Result::Err(e) => panic("parse space failed: ".concat(e.message())),
    }
}
