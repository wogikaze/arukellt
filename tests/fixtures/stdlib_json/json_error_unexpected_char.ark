use std::json
use std::test

fn main() {
    match json::JsonValue::parse("xyz") {
        Result::Ok(_) => Std::panic("expected error for xyz"),
        Result::Err(e) => test::assert_eq_string(e.message(), "unexpected character"),
    }
    match json::JsonValue::parse("@") {
        Result::Ok(_) => Std::panic("expected error for @"),
        Result::Err(e) => test::assert_eq_string(e.message(), "unexpected character"),
    }
}
