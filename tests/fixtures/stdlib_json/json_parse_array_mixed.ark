use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("[1,\"two\",true,null]") {
        Result::Ok(v) => {
            match v.get_index(0) {
                Option::Some(e) => match e.as_i32() {
                    Option::Some(n) => Test::assert_eq_i32(n, 1),
                    None => Std::panic("expected number at 0"),
                },
                None => Std::panic("expected element at 0"),
            }
            match v.get_index(1) {
                Option::Some(e) => match e.as_string() {
                    Option::Some(s) => Test::assert_eq_string(s, "two"),
                    None => Std::panic("expected string at 1"),
                },
                None => Std::panic("expected element at 1"),
            }
            match v.get_index(2) {
                Option::Some(e) => match e.as_bool() {
                    Option::Some(b) => Test::assert_eq_bool(b, true),
                    None => Std::panic("expected bool at 2"),
                },
                None => Std::panic("expected element at 2"),
            }
            match v.get_index(3) {
                Option::Some(e) => Test::assert_true(e.is_null()),
                None => Std::panic("expected element at 3"),
            }
        },
        Result::Err(e) => Std::panic("parse mixed array failed: ".concat(e.message())),
    }
}
