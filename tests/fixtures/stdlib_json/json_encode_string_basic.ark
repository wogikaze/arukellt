use std::json
use std::test::Test

fn main() {
    Test::assert_eq_string(json::JsonValue::encode_string("hello"), "\"hello\"")
    Test::assert_eq_string(json::JsonValue::encode_string(""), "\"\"")
    Test::assert_eq_string(json::JsonValue::encode_string("a\"b"), "\"a\\\"b\"")
    Test::assert_eq_string(json::JsonValue::encode_string("a\\b"), "\"a\\\\b\"")
    Test::assert_eq_string(json::JsonValue::encode_string("a\tb"), "\"a\\tb\"")
    Test::assert_eq_string(json::JsonValue::encode_string("a\nb"), "\"a\\nb\"")
}
