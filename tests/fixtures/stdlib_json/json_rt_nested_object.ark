use std::host::stdio
use std::json
use std::text
fn main() {
    // Round-trip: parse a nested object, then stringify it and re-parse to verify values
    let raw = "{\"person\":{\"name\":\"bob\",\"age\":25},\"active\":true}"
    match json::parse(raw) {
        Result::Ok(top) => {
            match top.get_field("person") {
                Option::Some(person) => {
                    match person.get_field("name") {
                        Option::Some(nv) => {
                            match nv.as_string() {
                                Option::Some(s) => stdio::println(s),
                                None => stdio::println("not string"),
                            }
                        },
                        None => stdio::println("key not found"),
                    }
                    match person.get_field("age") {
                        Option::Some(av) => {
                            match av.as_i32() {
                                Option::Some(n) => stdio::println((n).to_string()),
                                None => stdio::println("not number"),
                            }
                        },
                        None => stdio::println("key not found"),
                    }
                },
                None => stdio::println("person not found"),
            }
            match top.get_field("active") {
                Option::Some(bv) => {
                    match bv.as_bool() {
                        Option::Some(b) => stdio::println((b).to_string()),
                        None => stdio::println("not bool"),
                    }
                },
                None => stdio::println("active not found"),
            }
            // Stringify and re-parse to confirm round-trip
            let s = top.to_text()
            match json::parse(s) {
                Result::Ok(top2) => {
                    match top2.get_field("person") {
                        Option::Some(p2) => {
                            match p2.get_field("age") {
                                Option::Some(av2) => {
                                    match av2.as_i32() {
                                        Option::Some(n2) => stdio::println((n2).to_string()),
                                        None => stdio::println("not number"),
                                    }
                                },
                                None => stdio::println("key not found"),
                            }
                        },
                        None => stdio::println("person not found"),
                    }
                },
                Result::Err(e) => stdio::println("re-parse error:".concat(e.message())),
            }
        },
        Result::Err(e) => stdio::println("error:".concat(e.message())),
    }
}
// nested object round-trip: parse → access → stringify → re-parse → access
