use std::json
use std::test::Test

fn main() {
    match json::JsonValue::parse("{") {
        Result::Ok(_) => Std::panic("expected error for incomplete object"),
        Result::Err(_) => {},
    }
    match json::JsonValue::parse("{\"a\"") {
        Result::Ok(_) => Std::panic("expected error for unclosed key"),
        Result::Err(_) => {},
    }
    match json::JsonValue::parse("{\"a\":") {
        Result::Ok(_) => Std::panic("expected error for missing value"),
        Result::Err(_) => {},
    }
    match json::JsonValue::parse("{\"a\":1") {
        Result::Ok(_) => Std::panic("expected error for unclosed object"),
        Result::Err(_) => {},
    }
}
