use std::host::stdio::Stdio
use std::json
use std::text
fn main() {
    let tab_str = json::JsonValue::encode_string("a\tb")
    Stdio::println(tab_str)
    let newline_str = json::JsonValue::encode_string("line1\nline2")
    Stdio::println(newline_str)
    let quote_str = json::JsonValue::encode_string("say \"hi\"")
    Stdio::println(quote_str)
    let backslash_str = json::JsonValue::encode_string("a\\b")
    Stdio::println(backslash_str)
    match json::JsonValue::parse("\"hello\\nworld\"") {
        Result::Ok(v) => {
            match v.as_string() {
                Option::Some(s) => Stdio::println((len(s)).to_string()),
                None => Stdio::println("not string"),
            }
        },
        Result::Err(e) => Stdio::println("error:".concat(e.message())),
    }
}
// json_encode_string handles special characters
// Parse and decode an escaped JSON string
