use std::json
use std::test

fn main() {
    match json::parse("tru") {
        Result::Ok(_) => panic("expected error for tru"),
        Result::Err(e) => test::assert_eq_string(json::parse_error_message(e), "invalid true"),
    }
    match json::parse("fals") {
        Result::Ok(_) => panic("expected error for fals"),
        Result::Err(e) => test::assert_eq_string(json::parse_error_message(e), "invalid false"),
    }
    match json::parse("nul") {
        Result::Ok(_) => panic("expected error for nul"),
        Result::Err(e) => test::assert_eq_string(json::parse_error_message(e), "invalid null"),
    }
}
