use std::json
use std::test::Test
use std::text
fn main() {
    let mut fields = Vec::new<json::JsonField>()
    fields.push(json::JsonField::new("name", json::JsonValue::string("alice")))
    fields.push(json::JsonField::new("age", json::JsonValue::int(30)))
    let s = json::JsonValue::object(fields).to_text()
    Test::assert_eq_string(s, "{\"name\":\"alice\",\"age\":30}")
    // Verify the constructed object parses back correctly
    match json::JsonValue::parse(s) {
        Result::Ok(v) => match v.get_field("name") {
            Option::Some(nv) => match nv.as_string() {
                Option::Some(name) => Test::assert_eq_string(name, "alice"),
                None => Std::panic("expected string"),
            },
            None => Std::panic("expected key name"),
        },
        Result::Err(e) => Std::panic("re-parse failed: ".concat(e.message())),
    }
}
