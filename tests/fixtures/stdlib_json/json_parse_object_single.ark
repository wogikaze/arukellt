use std::json
use std::test
use std::text
fn main() {
    match json::parse("{\"key\":\"value\"}") {
        Result::Ok(v) => {
            test::assert_true(v.is_object())
            match v.get_field("key") {
                Option::Some(fv) => match fv.as_string() {
                    Option::Some(s) => test::assert_eq_string(s, "value"),
                    None => panic("expected string value"),
                },
                None => panic("expected key \"key\""),
            }
        },
        Result::Err(e) => panic("parse object failed: ".concat(e.message())),
    }
}
