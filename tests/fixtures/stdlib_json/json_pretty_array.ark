use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("[1,2,3]") {
        Result::Ok(v) => Test::assert_eq_string(json::JsonValue::pretty_text(v, 2), "[\n  1,\n  2,\n  3\n]"),
        Result::Err(e) => Std::panic("parse array failed: ".concat(e.message())),
    }
}
