use std::json
use std::test
use std::text
fn main() {
    match json::parse("[]") {
        Result::Ok(v) => {
            test::assert_true(v.is_array())
            test::assert_false(v.is_object())
            match v.get_index(0) {
                Option::Some(_) => panic("expected None for empty array"),
                None => {},
            }
        },
        Result::Err(e) => panic("parse [] failed: ".concat(e.message())),
    }
}
