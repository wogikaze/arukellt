use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("[]") {
        Result::Ok(v) => {
            Test::assert_true(v.is_array())
            Test::assert_false(v.is_object())
            match v.get_index(0) {
                Option::Some(_) => Std::panic("expected None for empty array"),
                None => {},
            }
        },
        Result::Err(e) => Std::panic("parse [] failed: ".concat(e.message())),
    }
}
