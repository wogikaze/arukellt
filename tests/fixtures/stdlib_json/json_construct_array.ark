use std::json
use std::test::Test
use std::text
fn main() {
    let mut items = Vec::new<json::JsonValue>()
    push(items, json::JsonValue::int(1))
    push(items, json::JsonValue::int(2))
    push(items, json::JsonValue::int(3))
    let s = json::JsonValue::array(items).to_text()
    Test::assert_eq_string(s, "[1,2,3]")
    // Verify the constructed array parses back correctly
    match json::JsonValue::parse(s) {
        Result::Ok(v) => match v.get_index(1) {
            Option::Some(e) => match e.as_i32() {
                Option::Some(n) => Test::assert_eq_i32(n, 2),
                None => Std::panic("expected number"),
            },
            None => Std::panic("expected element at 1"),
        },
        Result::Err(e) => Std::panic("re-parse failed: ".concat(e.message())),
    }
}
