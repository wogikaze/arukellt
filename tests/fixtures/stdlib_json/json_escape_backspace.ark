use std::json
use std::test
use std::text
fn main() {
    match json::parse("\"a\\bb\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => test::assert_eq_i32(len(s), 3),
            None => panic("expected string"),
        },
        Result::Err(e) => panic("parse backspace failed: ".concat(e.message())),
    }
}
