use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("\"a\\bb\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => Test::assert_eq_i32(s.len(), 3),
            None => Std::panic("expected string"),
        },
        Result::Err(e) => Std::panic("parse backspace failed: ".concat(e.message())),
    }
}
