use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("\"hello\"") {
        Result::Ok(v) => {
            Test::assert_true(v.is_string())
            match v.as_string() {
                Option::Some(s) => Test::assert_eq_string(s, "hello"),
                None => Std::panic("expected Some(\"hello\")"),
            }
        },
        Result::Err(e) => Std::panic("parse string failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("\"\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => Test::assert_eq_string(s, ""),
            None => Std::panic("expected Some(\"\")"),
        },
        Result::Err(e) => Std::panic("parse empty string failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("\"hello world\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => Test::assert_eq_string(s, "hello world"),
            None => Std::panic("expected Some(\"hello world\")"),
        },
        Result::Err(e) => Std::panic("parse spaced string failed: ".concat(e.message())),
    }
}
