use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("true") {
        Result::Ok(v) => {
            Test::assert_true(v.is_bool())
            match v.as_bool() {
                Option::Some(b) => Test::assert_eq_bool(b, true),
                None => Std::panic("expected Some(true)"),
            }
        },
        Result::Err(e) => Std::panic("parse true failed: ".concat(e.message())),
    }
}
