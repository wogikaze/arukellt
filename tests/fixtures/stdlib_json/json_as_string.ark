use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("\"hello\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => Test::assert_eq_string(s, "hello"),
            None => Std::panic("expected Some(hello)"),
        },
        Result::Err(e) => Std::panic("parse failed: ".concat(e.message())),
    }
    // Type mismatch: json_as_string on non-string returns None
    match json::JsonValue::parse("42") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(_) => Std::panic("expected None for non-string"),
            None => {},
        },
        Result::Err(e) => Std::panic("parse 42 failed: ".concat(e.message())),
    }
}
