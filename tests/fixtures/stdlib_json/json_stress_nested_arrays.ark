use std::json
use std::test
use std::text
fn main() {
    match json::parse("[[[[1]]]]") {
        Result::Ok(v) => {
            match v.get_index(0) {
                Option::Some(l1) => match l1.get_index(0) {
                    Option::Some(l2) => match l2.get_index(0) {
                        Option::Some(l3) => match l3.get_index(0) {
                            Option::Some(l4) => match l4.as_i32() {
                                Option::Some(n) => test::assert_eq_i32(n, 1),
                                None => panic("expected number"),
                            },
                            None => panic("expected element"),
                        },
                        None => panic("expected element"),
                    },
                    None => panic("expected element"),
                },
                None => panic("expected element"),
            }
        },
        Result::Err(e) => panic("parse deeply nested arrays failed: ".concat(e.message())),
    }
}
