use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("[[1,2],[3,4]]") {
        Result::Ok(v) => {
            match v.get_index(0) {
                Option::Some(inner) => {
                    test::assert_true(inner.is_array())
                    match inner.get_index(0) {
                        Option::Some(e) => match e.as_i32() {
                            Option::Some(n) => test::assert_eq_i32(n, 1),
                            None => Std::panic("expected 1"),
                        },
                        None => Std::panic("expected inner element 0"),
                    }
                },
                None => Std::panic("expected outer element 0"),
            }
            match v.get_index(1) {
                Option::Some(inner) => match inner.get_index(1) {
                    Option::Some(e) => match e.as_i32() {
                        Option::Some(n) => test::assert_eq_i32(n, 4),
                        None => Std::panic("expected 4"),
                    },
                    None => Std::panic("expected inner element 1"),
                },
                None => Std::panic("expected outer element 1"),
            }
        },
        Result::Err(e) => Std::panic("parse nested array failed: ".concat(e.message())),
    }
}
