use std::json
use std::test
use std::text
fn main() {
    match json::parse("{\"a\":[1,2],\"b\":{\"c\":3}}") {
        Result::Ok(v) => test::assert_eq_string(json::stringify(v), "{\"a\":[1,2],\"b\":{\"c\":3}}"),
        Result::Err(e) => panic("parse nested failed: ".concat(json::parse_error_message(e))),
    }
    match json::parse("[[1],[2,3]]") {
        Result::Ok(v) => test::assert_eq_string(json::stringify(v), "[[1],[2,3]]"),
        Result::Err(e) => panic("parse nested array failed: ".concat(json::parse_error_message(e))),
    }
}
