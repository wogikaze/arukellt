use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("{\"a\":[1,2],\"b\":{\"c\":3}}") {
        Result::Ok(v) => test::assert_eq_string(v.to_text(), "{\"a\":[1,2],\"b\":{\"c\":3}}"),
        Result::Err(e) => Std::panic("parse nested failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("[[1],[2,3]]") {
        Result::Ok(v) => test::assert_eq_string(v.to_text(), "[[1],[2,3]]"),
        Result::Err(e) => Std::panic("parse nested array failed: ".concat(e.message())),
    }
}
