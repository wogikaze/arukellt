use std::json
use std::test
use std::text
fn main() {
    match json::parse("[]") {
        Result::Ok(v) => test::assert_eq_string(json::stringify_pretty(v, 2), "[]"),
        Result::Err(e) => panic("parse [] failed: ".concat(e.message())),
    }
    match json::parse("{}") {
        Result::Ok(v) => test::assert_eq_string(json::stringify_pretty(v, 2), "{}"),
        Result::Err(e) => panic("parse {} failed: ".concat(e.message())),
    }
}
