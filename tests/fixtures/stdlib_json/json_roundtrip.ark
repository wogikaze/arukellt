use std::host::stdio::Stdio
use std::json

fn main() {
    let n = 42
    let s = json::JsonValue::stringify_i32(n)
    let back = json::JsonValue::parse_i32(s)
    Stdio::println((back).to_string())
    let b = true
    let bs = json::JsonValue::stringify_bool(b)
    let bb = json::JsonValue::parse_bool(bs)
    Stdio::println((bb).to_string())
    let neg = -7
    let ns = json::JsonValue::stringify_i32(neg)
    let nb = json::JsonValue::parse_i32(ns)
    Stdio::println((nb).to_string())
    let z = 0
    let zs = json::JsonValue::stringify_i32(z)
    let zb = json::JsonValue::parse_i32(zs)
    Stdio::println((zb).to_string())
    let f = false
    let fs = json::JsonValue::stringify_bool(f)
    let fb = json::JsonValue::parse_bool(fs)
    Stdio::println((fb).to_string())
    let st = json::JsonValue::stringify_string("hello world")
    Stdio::println(st)
    Stdio::println(json::JsonValue::null_text())
}
// i32 roundtrip: stringify then parse
// bool roundtrip: stringify then parse
// negative number roundtrip
// zero roundtrip
// false roundtrip
// string roundtrip
// null
