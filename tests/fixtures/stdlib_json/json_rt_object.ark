use std::json
use std::test
use std::text
fn main() {
    let raw = "{\"x\":1,\"y\":true,\"z\":null}"
    match json::JsonValue::parse(raw) {
        Result::Ok(v) => {
            let s = v.to_text()
            test::assert_eq_string(s, raw)
            // Re-parse and verify
            match json::JsonValue::parse(s) {
                Result::Ok(v2) => {
                    match v2.get_field("x") {
                        Option::Some(fv) => match fv.as_i32() {
                            Option::Some(n) => test::assert_eq_i32(n, 1),
                            None => panic("expected number"),
                        },
                        None => panic("expected key x"),
                    }
                    match v2.get_field("y") {
                        Option::Some(fv) => match fv.as_bool() {
                            Option::Some(b) => test::assert_eq_bool(b, true),
                            None => panic("expected bool"),
                        },
                        None => panic("expected key y"),
                    }
                    match v2.get_field("z") {
                        Option::Some(fv) => test::assert_true(fv.is_null()),
                        None => panic("expected key z"),
                    }
                },
                Result::Err(e) => panic("re-parse failed: ".concat(e.message())),
            }
        },
        Result::Err(e) => panic("parse failed: ".concat(e.message())),
    }
}
