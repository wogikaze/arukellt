use std::json
use std::test

fn main() {
    match json::JsonValue::parse("42 extra") {
        Result::Ok(_) => Std::panic("expected error for trailing after number"),
        Result::Err(e) => test::assert_eq_string(e.message(), "trailing characters"),
    }
    match json::JsonValue::parse("true false") {
        Result::Ok(_) => Std::panic("expected error for trailing after bool"),
        Result::Err(e) => test::assert_eq_string(e.message(), "trailing characters"),
    }
}
