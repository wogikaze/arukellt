use std::json
use std::test::Test

fn main() {
    Test::assert_eq_i32(json::JsonValue::parse_i32("0"), 0)
    Test::assert_eq_i32(json::JsonValue::parse_i32("42"), 42)
    Test::assert_eq_i32(json::JsonValue::parse_i32("-1"), -1)
    Test::assert_eq_i32(json::JsonValue::parse_i32("999999"), 999999)
    Test::assert_eq_i32(json::JsonValue::parse_i32("-999999"), -999999)
}
