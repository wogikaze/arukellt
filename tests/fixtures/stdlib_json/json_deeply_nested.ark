use std::json
use std::test
use std::text
fn main() {
    match json::parse("{\"a\":{\"b\":{\"c\":{\"d\":42}}}}") {
        Result::Ok(v) => {
            match v.get_field("a") {
                Option::Some(a) => match a.get_field("b") {
                    Option::Some(b) => match b.get_field("c") {
                        Option::Some(c) => match c.get_field("d") {
                            Option::Some(d) => match d.as_i32() {
                                Option::Some(n) => test::assert_eq_i32(n, 42),
                                None => panic("expected number"),
                            },
                            None => panic("expected key d"),
                        },
                        None => panic("expected key c"),
                    },
                    None => panic("expected key b"),
                },
                None => panic("expected key a"),
            }
        },
        Result::Err(e) => panic("parse deeply nested failed: ".concat(e.message())),
    }
}
