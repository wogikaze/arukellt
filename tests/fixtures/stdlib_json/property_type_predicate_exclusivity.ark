// Property fixture: exactly one type predicate is true for any JsonValue.
//
// Invariant: for any parsed JSON value, exactly one of is_null, is_bool,
// is_number, is_string, is_array, is_object returns true.
use std::json
use std::test
use std::text
fn check_exactly_one(v: json::JsonValue) {
    let mut count: i32 = 0
    if v.is_null() { count = count + 1 }
    if v.is_bool() { count = count + 1 }
    if v.is_number() { count = count + 1 }
    if v.is_string() { count = count + 1 }
    if v.is_array() { count = count + 1 }
    if v.is_object() { count = count + 1 }
    test::assert_eq_i32(count, 1)
}

fn main() {
    match json::JsonValue::parse("null") {
        Result::Ok(v) => check_exactly_one(v),
        Result::Err(e) => panic("parse null failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("true") {
        Result::Ok(v) => check_exactly_one(v),
        Result::Err(e) => panic("parse true failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("42") {
        Result::Ok(v) => check_exactly_one(v),
        Result::Err(e) => panic("parse 42 failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("\"str\"") {
        Result::Ok(v) => check_exactly_one(v),
        Result::Err(e) => panic("parse str failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("[1]") {
        Result::Ok(v) => check_exactly_one(v),
        Result::Err(e) => panic("parse array failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("{\"a\":1}") {
        Result::Ok(v) => check_exactly_one(v),
        Result::Err(e) => panic("parse object failed: ".concat(e.message())),
    }
}
