use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("\"a\\\\b\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => test::assert_eq_string(s, "a\\b"),
            None => Std::panic("expected string"),
        },
        Result::Err(e) => Std::panic("parse backslash failed: ".concat(e.message())),
    }
}
