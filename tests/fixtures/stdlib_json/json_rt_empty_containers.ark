use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("[]") {
        Result::Ok(v) => {
            test::assert_eq_string(v.to_text(), "[]")
            match json::JsonValue::parse(v.to_text()) {
                Result::Ok(v2) => test::assert_true(v2.is_array()),
                Result::Err(e) => Std::panic("re-parse [] failed: ".concat(e.message())),
            }
        },
        Result::Err(e) => Std::panic("parse [] failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("{}") {
        Result::Ok(v) => {
            test::assert_eq_string(v.to_text(), "{}")
            match json::JsonValue::parse(v.to_text()) {
                Result::Ok(v2) => test::assert_true(v2.is_object()),
                Result::Err(e) => Std::panic("re-parse {} failed: ".concat(e.message())),
            }
        },
        Result::Err(e) => Std::panic("parse {} failed: ".concat(e.message())),
    }
}
