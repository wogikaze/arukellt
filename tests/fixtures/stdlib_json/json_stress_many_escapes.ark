use std::json
use std::test::Test
use std::text
fn main() {
    let raw = "\"\\n\\t\\r\\\\\\\"\\b\\f\""
    match json::JsonValue::parse(raw) {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => Test::assert_eq_i32(s.len(), 7),
            None => Std::panic("expected string"),
        },
        Result::Err(e) => Std::panic("parse many escapes failed: ".concat(e.message())),
    }
    // Round-trip the escaped string
    match json::JsonValue::parse(raw) {
        Result::Ok(v) => Test::assert_eq_string(v.to_text(), raw),
        Result::Err(e) => Std::panic("re-parse failed: ".concat(e.message())),
    }
}
