use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("1e5") {
        Result::Ok(v) => {
            Test::assert_true(v.is_number())
        },
        Result::Err(e) => Std::panic("parse 1e5 failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("1.5e3") {
        Result::Ok(v) => Test::assert_true(v.is_number()),
        Result::Err(e) => Std::panic("parse 1.5e3 failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("2E10") {
        Result::Ok(v) => Test::assert_true(v.is_number()),
        Result::Err(e) => Std::panic("parse 2E10 failed: ".concat(e.message())),
    }
}
