use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("42") {
        Result::Ok(v) => {
            Test::assert_true(v.is_number())
            Test::assert_false(v.is_null())
            Test::assert_false(v.is_bool())
            Test::assert_false(v.is_string())
            Test::assert_false(v.is_array())
            Test::assert_false(v.is_object())
        },
        Result::Err(e) => Std::panic("parse failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("3.14") {
        Result::Ok(v) => Test::assert_true(v.is_number()),
        Result::Err(e) => Std::panic("parse float failed: ".concat(e.message())),
    }
}
