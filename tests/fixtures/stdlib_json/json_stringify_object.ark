use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("{\"a\":1}") {
        Result::Ok(v) => Test::assert_eq_string(v.to_text(), "{\"a\":1}"),
        Result::Err(e) => Std::panic("parse object failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("{}") {
        Result::Ok(v) => Test::assert_eq_string(v.to_text(), "{}"),
        Result::Err(e) => Std::panic("parse empty object failed: ".concat(e.message())),
    }
    match json::JsonValue::parse("{\"a\":1,\"b\":true}") {
        Result::Ok(v) => Test::assert_eq_string(v.to_text(), "{\"a\":1,\"b\":true}"),
        Result::Err(e) => Std::panic("parse multi object failed: ".concat(e.message())),
    }
}
