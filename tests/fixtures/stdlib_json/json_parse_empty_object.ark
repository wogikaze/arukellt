use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("{}") {
        Result::Ok(v) => {
            Test::assert_true(v.is_object())
            Test::assert_false(v.is_array())
            match v.get_field("x") {
                Option::Some(_) => Std::panic("expected None for empty object"),
                None => {},
            }
        },
        Result::Err(e) => Std::panic("parse {} failed: ".concat(e.message())),
    }
}
