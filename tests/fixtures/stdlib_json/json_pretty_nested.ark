use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("{\"a\":[1,2]}") {
        Result::Ok(v) => Test::assert_eq_string(json::JsonValue::pretty_text(v, 2), "{\n  \"a\": [\n    1,\n    2\n  ]\n}"),
        Result::Err(e) => Std::panic("parse nested failed: ".concat(e.message())),
    }
}
