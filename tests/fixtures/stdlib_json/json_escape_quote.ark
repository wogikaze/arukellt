use std::json
use std::test::Test
use std::text
fn main() {
    match json::JsonValue::parse("\"say \\\"hi\\\"\"") {
        Result::Ok(v) => match v.as_string() {
            Option::Some(s) => Test::assert_eq_string(s, "say \"hi\""),
            None => Std::panic("expected string"),
        },
        Result::Err(e) => Std::panic("parse quote failed: ".concat(e.message())),
    }
}
