use std::host::stdio::Stdio
use std::json
use std::text
fn main() {
    // Differential test: parse then stringify, compare against known-correct golden output
    // Golden: {"a":1,"b":false,"c":null}
    let raw = "{\"a\":1,\"b\":false,\"c\":null}"
    match json::JsonValue::parse(raw) {
        Result::Ok(v) => {
            let out = v.to_text()
            // Verify individual fields match golden values
            match v.get_field("a") {
                Option::Some(av) => {
                    match av.as_i32() {
                        Option::Some(n) => Stdio::println((n).to_string()),
                        None => Stdio::println("not number"),
                    }
                },
                None => Stdio::println("not found"),
            }
            match v.get_field("b") {
                Option::Some(bv) => {
                    match bv.as_bool() {
                        Option::Some(b) => Stdio::println((b).to_string()),
                        None => Stdio::println("not bool"),
                    }
                },
                None => Stdio::println("not found"),
            }
            match v.get_field("c") {
                Option::Some(cv) => Stdio::println((cv.is_null()).to_string()),
                None => Stdio::println("not found"),
            }
            // Re-parse the stringified output and verify it still has same structure
            match json::JsonValue::parse(out) {
                Result::Ok(v2) => {
                    Stdio::println((v2.is_object()).to_string())
                },
                Result::Err(e) => Stdio::println("differential re-parse error:".concat(e.message())),
            }
        },
        Result::Err(e) => Stdio::println("error:".concat(e.message())),
    }
}
// differential test: mixed-type object stringify output re-parses correctly
