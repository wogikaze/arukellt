use std::json
use std::test
use std::text
fn main() {
    let raw = "[1,\"two\",true,null,42]"
    match json::parse(raw) {
        Result::Ok(v) => {
            let s = v.to_text()
            test::assert_eq_string(s, raw)
            match json::parse(s) {
                Result::Ok(v2) => {
                    match v2.get_index(0) {
                        Option::Some(e) => match e.as_i32() {
                            Option::Some(n) => test::assert_eq_i32(n, 1),
                            None => panic("expected number"),
                        },
                        None => panic("expected element 0"),
                    }
                    match v2.get_index(4) {
                        Option::Some(e) => match e.as_i32() {
                            Option::Some(n) => test::assert_eq_i32(n, 42),
                            None => panic("expected number"),
                        },
                        None => panic("expected element 4"),
                    }
                },
                Result::Err(e) => panic("re-parse failed: ".concat(e.message())),
            }
        },
        Result::Err(e) => panic("parse failed: ".concat(e.message())),
    }
}
