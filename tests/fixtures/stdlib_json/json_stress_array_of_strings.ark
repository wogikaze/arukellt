use std::json
use std::test
use std::text
fn main() {
    match json::JsonValue::parse("[\"a\",\"bb\",\"ccc\"]") {
        Result::Ok(v) => {
            match v.get_index(0) {
                Option::Some(e) => match e.as_string() {
                    Option::Some(s) => test::assert_eq_string(s, "a"),
                    None => panic("expected string"),
                },
                None => panic("expected element 0"),
            }
            match v.get_index(2) {
                Option::Some(e) => match e.as_string() {
                    Option::Some(s) => test::assert_eq_string(s, "ccc"),
                    None => panic("expected string"),
                },
                None => panic("expected element 2"),
            }
        },
        Result::Err(e) => panic("parse string array failed: ".concat(e.message())),
    }
}
