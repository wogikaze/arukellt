use std::core::convert
use std::host::stdio::Stdio
use std::test::Test

fn main() {
    let n: i32 = 42
    let s: String = String_from("hi")
    Test::assert_eq_string(f"{n:?}", "42")
    Test::assert_eq_string(f"{s:?}", "\"hi\"")
    Test::assert_eq_string(f"n={n:?} s={s:?}", "n=42 s=\"hi\"")
    Stdio::println("fstring_debug_specifier ok")
}
