use std::host::stdio::Stdio

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn translate(mut self: Point, dx: i32, dy: i32) {
        self.x = self.x + dx
        self.y = self.y + dy
    }
}

fn main() -> i32 {
    let mut p = Point { x: 10, y: 20 }
    Stdio::println(p.x)
    Stdio::println(p.y)
    p.translate(5, 3)
    Stdio::println(p.x)
    Stdio::println(p.y)
    p.x = 100
    Stdio::println(p.x)
    0
}
