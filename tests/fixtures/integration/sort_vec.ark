use std::host::stdio::Stdio
use std::collections::vec
use std::core
use std::core::cmp

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    push(v, 5)
    push(v, 3)
    push(v, 8)
    push(v, 1)
    push(v, 9)
    push(v, 2)
    push(v, 7)
    push(v, 4)
    push(v, 6)
    push(v, 10)
    v.sort_by(ascending)
    let mut parts: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < len(v) {
        push(parts, (get_unchecked(v, i)).to_string())
        i = i + 1
    }
    Stdio::println(parts.join(String_from(" ")))
}
