use std::host::stdio::Stdio
use std::collections::vec
use std::core
use std::core::cmp

fn ascending(a: i32, b: i32) -> Ordering {
    a.cmp(b)
}

fn main() {
    let mut v: Vec<i32> = Vec::new<i32>()
    v.push(5)
    v.push(3)
    v.push(8)
    v.push(1)
    v.push(9)
    v.push(2)
    v.push(7)
    v.push(4)
    v.push(6)
    v.push(10)
    v.sort_by(ascending)
    let mut parts: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < v.len() {
        parts.push((v.get_unchecked(i)).to_string())
        i = i + 1
    }
    Stdio::println(parts.join(String_from(" ")))
}
