use std::host::stdio::Stdio
use std::text
fn main() {
    // Functional digraph: node -> successor. 2 -> 3 -> 4 -> 2 is a cycle.
    let mut next: HashMap<i32, i32> = HashMap::new<i32, i32>()
    let _ = next.insert(0, 1)
    let _ = next.insert(1, 2)
    let _ = next.insert(2, 3)
    let _ = next.insert(3, 4)
    let _ = next.insert(4, 2)
    let _ = next.insert(5, 6)

    // Walk from 0 until a node repeats: shared heap state across two maps.
    let mut visited: HashMap<i32, i32> = HashMap::new<i32, i32>()
    let mut node = 0
    let mut out = String_from("")
    let mut steps = 0
    while !visited.contains_key(node) && steps < 10 {
        let _ = visited.insert(node, 1)
        out = out.concat((node).to_string().concat(String_from(" ")))
        match next.get(node) {
            Option::Some(successor) => node = successor,
            None => steps = 10,
        }
        steps = steps + 1
    }
    Stdio::println(out)
    Stdio::println(String_from("cycle at ").concat((node).to_string()))
}
