use std::bytes
use std::bytes::Bytes
use std::test::Test

fn main() {
    let mut vals: Vec<i32> = Vec::new<i32>()
    vals.push(0)
    vals.push(63)
    vals.push(64)
    vals.push(0 - 1)
    vals.push(0 - 624485)
    let n = vals.len()
    let mut i = 0
    while i < n {
        let v = vals.get_unchecked(i)
        let enc: Vec<i32> = Bytes::from_leb128_i32(v)
        let mut c: Vec<i32> = enc.byte_cursor()
        let dec: i32 = c.read_leb128_i32()
        Test::assert_eq_i32(dec, v)
        i = i + 1
    }
}
