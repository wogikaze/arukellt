use std::bytes
use std::bytes::Bytes
use std::test::Test

fn main() {
    let mut vals: Vec<i32> = Vec::new<i32>()
    push(vals, 0)
    push(vals, 1)
    push(vals, 255)
    push(vals, 256)
    push(vals, 65535)
    push(vals, 305419896)
    let n = vals.len()
    let mut i = 0
    while i < n {
        let v = get_unchecked(vals, i)
        let le: Vec<i32> = Bytes::from_u32_le(v)
        Test::assert_eq_i32(le.to_u32_le(), v)
        let be: Vec<i32> = Bytes::from_u32_be(v)
        Test::assert_eq_i32(be.to_u32_be(), v)
        i = i + 1
    }
}
