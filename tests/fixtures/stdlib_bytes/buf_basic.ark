use std::bytes
use std::bytes::Bytes
use std::host::stdio

fn main() {
    let buf: Vec<i32> = Vec::new<i32>()
    stdio::println((buf.len()).to_string())
    buf.push_byte(65)
    buf.push_byte(66)
    buf.push_byte(67)
    stdio::println((buf.len()).to_string())
    stdio::println((buf.get_unchecked(0)).to_string())
    stdio::println((buf.get_unchecked(2)).to_string())
    let buf2: Vec<i32> = Vec::new<i32>()
    buf2.push_u16_le(258)
    stdio::println((buf2.get_unchecked(0)).to_string())
    stdio::println((buf2.get_unchecked(1)).to_string())
    let buf3: Vec<i32> = Vec::new<i32>()
    buf3.push_u32_le(305419896)
    stdio::println((buf3.len()).to_string())
    stdio::println((buf3.get_unchecked(0)).to_string())
    stdio::println((buf3.get_unchecked(3)).to_string())
    let src: Vec<i32> = Vec::new<i32>()
    src.push_byte(10)
    src.push_byte(20)
    buf.extend_bytes(src)
    stdio::println((buf.len()).to_string())
    let frozen: Vec<i32> = buf.freeze()
    stdio::println((frozen.len()).to_string())
    let arr: Vec<i32> = Vec::new<i32>()
    push(arr, 1)
    push(arr, 2)
    push(arr, 3)
    let from_arr: Vec<i32> = Bytes::from_array(arr)
    stdio::println((from_arr.len()).to_string())
    stdio::println((from_arr.get_unchecked(0)).to_string())
    stdio::println((from_arr.get_unchecked(2)).to_string())
}
// buf_new
// buf_push_u8
// buf_push_u16_le
// buf_push_u32_le
// buf_extend
// buf_freeze (identity in current runtime)
// bytes_from_array
