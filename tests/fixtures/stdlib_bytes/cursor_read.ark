use std::bytes
use std::host::stdio

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(10)
    data.push_byte(20)
    data.push_byte(30)
    data.push_byte(40)
    data.push_byte(50)
    data.push_byte(60)
    data.push_byte(70)
    data.push_byte(80)
    let mut c: Vec<i32> = data.byte_cursor()
    stdio::println((c.cursor_pos()).to_string())
    stdio::println((c.cursor_remaining()).to_string())
    let b0: i32 = c.read_u8()
    stdio::println((b0).to_string())
    stdio::println((c.cursor_pos()).to_string())
    stdio::println((c.cursor_remaining()).to_string())
    let u16v: i32 = c.read_u16_le()
    stdio::println((u16v).to_string())
    stdio::println((c.cursor_remaining()).to_string())
    let u32be: i32 = c.read_u32_be()
    stdio::println((u32be).to_string())
    let mut data2: Vec<i32> = Vec::new<i32>()
    data2.push_byte(4)
    data2.push_byte(3)
    data2.push_byte(2)
    data2.push_byte(1)
    let mut c2: Vec<i32> = data2.byte_cursor()
    let u32v: i32 = c2.read_u32_le()
    stdio::println((u32v).to_string())
    let mut data3: Vec<i32> = Vec::new<i32>()
    data3.push_byte(1)
    data3.push_byte(2)
    data3.push_byte(3)
    data3.push_byte(4)
    let mut c3: Vec<i32> = data3.byte_cursor()
    let chunk: Vec<i32> = c3.read_bytes(2)
    stdio::println((chunk.len()).to_string())
    stdio::println((chunk.get_unchecked(0)).to_string())
    stdio::println((chunk.get_unchecked(1)).to_string())
    stdio::println((c3.cursor_remaining()).to_string())
}
// Build a Bytes value and wrap in cursor
// read_u8
// read_u16_le: reads bytes [20, 30] -> 20 + 30*256 = 7700
// read_u32_be: reads bytes [40, 50, 60, 70] -> big-endian
// New cursor for u32 LE test: bytes [4,3,2,1] -> 16909060
// read_bytes
