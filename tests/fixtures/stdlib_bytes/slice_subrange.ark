use std::bytes
use std::test

fn main() {
    let b: Vec<i32> = Vec::new<i32>()
    b.push_byte(10)
    b.push_byte(20)
    b.push_byte(30)
    b.push_byte(40)
    b.push_byte(50)
    let s: Vec<i32> = b.slice_bytes(1, 4)
    test::assert_eq_i32(s.len(), 3)
    test::assert_eq_i32(s.get_unchecked(0), 20)
    test::assert_eq_i32(s.get_unchecked(1), 30)
    test::assert_eq_i32(s.get_unchecked(2), 40)
}
