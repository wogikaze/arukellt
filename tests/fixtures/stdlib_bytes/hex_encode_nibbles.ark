use std::bytes
use std::bytes::Bytes
use std::test

fn main() {
    let mut xs: Vec<i32> = Vec::new<i32>()
    push(xs, 0)
    push(xs, 9)
    push(xs, 10)
    push(xs, 15)
    push(xs, 16)
    push(xs, 255)
    let b: Vec<i32> = Bytes::from_array(xs)
    test::assert_eq_string(b.to_hex(), "00090a0f10ff")
}
