use std::bytes
use std::test::Test

fn main() {
    let mut buf: Vec<i32> = Vec::new<i32>()
    buf.push_byte(1)
    let mut src: Vec<i32> = Vec::new<i32>()
    src.push_byte(2)
    src.push_byte(3)
    buf.extend_bytes(src)
    Test::assert_eq_i32(buf.len(), 3)
    Test::assert_eq_i32(buf.get_unchecked(0), 1)
    Test::assert_eq_i32(buf.get_unchecked(1), 2)
    Test::assert_eq_i32(buf.get_unchecked(2), 3)
}
