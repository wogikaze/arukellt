use std::bytes
use std::bytes::Bytes
use std::host::stdio::Stdio
fn main() {
    let mut b: Vec<i32> = Vec::new<i32>()
    b.push_byte(77)
    b.push_byte(97)
    b.push_byte(110)
    let enc: String = b.to_base64()
    Stdio::println(enc)
    let dec: Vec<i32> = Bytes::from_base64(enc)
    Stdio::println((dec.len()).to_string())
    Stdio::println((b.equals_bytes(dec)).to_string())
    let mut one: Vec<i32> = Vec::new<i32>()
    one.push_byte(77)
    let enc1: String = one.to_base64()
    Stdio::println(enc1)
    let mut two: Vec<i32> = Vec::new<i32>()
    two.push_byte(77)
    two.push_byte(97)
    let enc2: String = two.to_base64()
    Stdio::println(enc2)
    let empty_enc: String = Vec::new<i32>().to_base64()
    Stdio::println((empty_enc.eq("")).to_string())
    let back: Vec<i32> = Bytes::from_base64("TQ==")
    Stdio::println((back.len()).to_string())
    Stdio::println((back.get_unchecked(0)).to_string())
}
// base64_encode
// base64_decode roundtrip
// padding: 1 byte -> 2 chars + ==
// padding: 2 bytes -> 3 chars + =
// empty
// decode "TQ==" -> [77]
