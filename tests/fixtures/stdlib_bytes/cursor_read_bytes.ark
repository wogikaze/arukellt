use std::bytes
use std::test::Test

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(7)
    data.push_byte(8)
    data.push_byte(9)
    data.push_byte(10)
    let mut c: Vec<i32> = data.byte_cursor()
    let chunk: Vec<i32> = c.read_bytes(3)
    Test::assert_eq_i32(chunk.len(), 3)
    Test::assert_eq_i32(chunk.get_unchecked(0), 7)
    Test::assert_eq_i32(chunk.get_unchecked(1), 8)
    Test::assert_eq_i32(chunk.get_unchecked(2), 9)
    Test::assert_eq_i32(c.cursor_remaining(), 1)
}
