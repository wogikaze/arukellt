use std::bytes
use std::test

fn assert_some_len(v: Option<Vec<i32>>, expected: i32) {
    match v {
        Option::Some(chunk) => test::assert_eq_i32(chunk.len(), expected),
        None => panic("expected Some"),
    }
}

fn assert_none_vec(v: Option<Vec<i32>>) {
    match v {
        Option::Some(_) => panic("expected None"),
        None => {
        },
    }
}

fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte( 7)
    data.push_byte( 8)
    data.push_byte( 9)
    data.push_byte( 10)
    let mut c: Vec<i32> = data.byte_cursor()
    assert_some_len(c.try_read_bytes( 2), 2)
    assert_none_vec(c.try_read_bytes( 5))
}
