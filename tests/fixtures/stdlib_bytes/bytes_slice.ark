use std::bytes
use std::host::stdio::Stdio

fn main() {
    let mut b: Vec<i32> = Vec::new<i32>()
    b.push_byte(10)
    b.push_byte(20)
    b.push_byte(30)
    b.push_byte(40)
    b.push_byte(50)
    let sub: Vec<i32> = b.slice_bytes(1, 4)
    Stdio::println((sub.len()).to_string())
    Stdio::println((sub.get_unchecked(0)).to_string())
    Stdio::println((sub.get_unchecked(1)).to_string())
    Stdio::println((sub.get_unchecked(2)).to_string())
    let empty: Vec<i32> = b.slice_bytes(2, 2)
    Stdio::println((empty.len()).to_string())
    let full: Vec<i32> = b.slice_bytes(0, 5)
    Stdio::println((full.len()).to_string())
    Stdio::println((b.equals_bytes(full)).to_string())
}
// bytes_slice: extract sub-range
// Empty slice
// Full slice (copy)
