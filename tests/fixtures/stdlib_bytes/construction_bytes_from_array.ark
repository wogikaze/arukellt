use std::bytes
use std::bytes::Bytes
use std::test::Test

fn main() {
    let mut xs: Vec<i32> = Vec::new<i32>()
    xs.push(1)
    xs.push(2)
    xs.push(3)
    let b: Vec<i32> = Bytes::from_array(xs)
    Test::assert_eq_i32(b.len(), 3)
    Test::assert_eq_i32(b.get_unchecked(0), 1)
    Test::assert_eq_i32(b.get_unchecked(1), 2)
    Test::assert_eq_i32(b.get_unchecked(2), 3)
}
