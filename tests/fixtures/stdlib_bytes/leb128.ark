use std::bytes
use std::bytes::Bytes
use std::host::stdio

fn main() {
    let leb: Vec<i32> = Bytes::from_leb128_u32(624485)
    stdio::println((leb.len()).to_string())
    stdio::println((leb.get_unchecked(0)).to_string())
    stdio::println((leb.get_unchecked(1)).to_string())
    stdio::println((leb.get_unchecked(2)).to_string())
    let c1: Vec<i32> = leb.byte_cursor()
    let dec1: i32 = c1.read_leb128_u32()
    stdio::println((dec1).to_string())
    let neg: Vec<i32> = Bytes::from_leb128_i32(0 - 1)
    stdio::println((neg.len()).to_string())
    stdio::println((neg.get_unchecked(0)).to_string())
    let c2: Vec<i32> = neg.byte_cursor()
    let dec2: i32 = c2.read_leb128_i32()
    stdio::println((dec2).to_string())
    let zero: Vec<i32> = Bytes::from_leb128_u32(0)
    stdio::println((zero.len()).to_string())
    stdio::println((zero.get_unchecked(0)).to_string())
    let one_enc: Vec<i32> = Bytes::from_leb128_u32(1)
    stdio::println((one_enc.len()).to_string())
    stdio::println((one_enc.get_unchecked(0)).to_string())
    let pos: Vec<i32> = Bytes::from_leb128_i32(63)
    let c3: Vec<i32> = pos.byte_cursor()
    let dec3: i32 = c3.read_leb128_i32()
    stdio::println((dec3).to_string())
}
// LEB128 u32 encode: 624485 -> [0xe5, 0x8e, 0x26]
// LEB128 u32 decode roundtrip
// LEB128 i32 encode: -1 -> [0x7f]
// LEB128 i32 decode: 0x7f -> -1
// LEB128 u32 encode: single byte value 0 -> [0]
// LEB128 u32 encode: value 1 -> [1]
// LEB128 i32 decode: 63 = 0x3f
