use std::bytes
use std::bytes::Bytes
use std::host::stdio::Stdio
fn main() {
    let mut b: Vec<i32> = Vec::new<i32>()
    b.push_byte(0)
    b.push_byte(255)
    b.push_byte(16)
    b.push_byte(171)
    let hex: String = b.to_hex()
    Stdio::println(hex)
    let decoded: Vec<i32> = Bytes::from_hex(hex)
    Stdio::println((decoded.len()).to_string())
    Stdio::println((b.equals_bytes(decoded)).to_string())
    let upper: Vec<i32> = Bytes::from_hex("DEADBEEF")
    Stdio::println((upper.len()).to_string())
    Stdio::println((upper.get_unchecked(0)).to_string())
    Stdio::println((upper.get_unchecked(3)).to_string())
    let empty: Vec<i32> = Bytes::from_hex("")
    Stdio::println((empty.len()).to_string())
    let empty_enc: String = Vec::new<i32>().to_hex()
    Stdio::println((empty_enc.eq("")).to_string())
}
// hex_encode
// hex_decode roundtrip
// hex_decode: uppercase
// empty
