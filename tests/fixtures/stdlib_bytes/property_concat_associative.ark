use std::bytes
use std::test

fn main() {
    let mut a: Vec<i32> = Vec::new<i32>()
    a.push_byte(1)
    let mut b: Vec<i32> = Vec::new<i32>()
    b.push_byte(2)
    let mut c: Vec<i32> = Vec::new<i32>()
    c.push_byte(3)
    let left: Vec<i32> = a.concat_bytes(b).concat_bytes(c)
    let right: Vec<i32> = a.concat_bytes(b.concat_bytes(c))
    test::assert_true(left.equals_bytes(right))
    test::assert_eq_i32(left.len(), 3)
}
