use std::bytes
use std::test

fn assert_some(v: Option<i32>, expected: i32) {
    match v {
        Option::Some(n) => test::assert_eq_i32(n, expected),
        None => panic("expected Some"),
    }
}

fn assert_none(v: Option<i32>) {
    match v {
        Option::Some(_) => panic("expected None"),
        None => {
        },
    }
}

fn main() {
    let data: Vec<i32> = Vec::new<i32>()
    data.push_byte( 4)
    data.push_byte( 3)
    data.push_byte( 2)
    data.push_byte( 1)
    let c: Vec<i32> = data.byte_cursor()
    assert_some(c.try_read_u32_le(), 16909060)
    assert_none(c.try_read_u32_le())
}
