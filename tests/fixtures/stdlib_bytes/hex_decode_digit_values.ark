use std::bytes
use std::bytes::Bytes
use std::test::Test

fn main() {
    let b: Vec<i32> = Bytes::from_hex("0123456789abcdef")
    Test::assert_eq_i32(b.len(), 8)
    Test::assert_eq_i32(b.get_unchecked(0), 1)
    Test::assert_eq_i32(b.get_unchecked(1), 35)
    Test::assert_eq_i32(b.get_unchecked(2), 69)
    Test::assert_eq_i32(b.get_unchecked(3), 103)
    Test::assert_eq_i32(b.get_unchecked(4), 137)
    Test::assert_eq_i32(b.get_unchecked(5), 171)
    Test::assert_eq_i32(b.get_unchecked(6), 205)
    Test::assert_eq_i32(b.get_unchecked(7), 239)
}
