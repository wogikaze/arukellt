use std::bytes
use std::test::Test

fn main() {
    let mut a: Vec<i32> = Vec::new<i32>()
    a.push_byte(42)
    let mut b: Vec<i32> = Vec::new<i32>()
    b.push_byte(42)
    let mut c: Vec<i32> = Vec::new<i32>()
    c.push_byte(43)
    Test::assert_true(a.equals_bytes(b))
    Test::assert_false(a.equals_bytes(c))
}
