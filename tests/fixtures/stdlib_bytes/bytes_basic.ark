use std::bytes
use std::bytes::Bytes
use std::host::stdio::Stdio

fn main() {
    let mut b: Vec<i32> = Vec::new<i32>()
    b.push_byte(72)
    b.push_byte(101)
    b.push_byte(108)
    Stdio::println((b.len()).to_string())
    Stdio::println((b.get_unchecked(0)).to_string())
    let h: String = b.to_hex()
    Stdio::println(h)
    let decoded: Vec<i32> = Bytes::from_hex("48656c")
    Stdio::println((decoded.len()).to_string())
    Stdio::println((decoded.get_unchecked(0)).to_string())
    let leb: Vec<i32> = Bytes::from_leb128_u32(624485)
    Stdio::println((leb.len()).to_string())
    Stdio::println((leb.get_unchecked(0)).to_string())
    Stdio::println((leb.get_unchecked(1)).to_string())
    Stdio::println((leb.get_unchecked(2)).to_string())
    let le: Vec<i32> = Bytes::from_u32_le(305419896)
    Stdio::println((le.get_unchecked(0)).to_string())
    Stdio::println((le.get_unchecked(1)).to_string())
    let rt: i32 = le.to_u32_le()
    Stdio::println((rt).to_string())
}
// bytes_new and push
// hex encode
// hex decode roundtrip
// leb128 encode u32
// endian u32 LE
