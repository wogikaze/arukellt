use std::bytes
use std::bytes::Bytes
use std::test::Test

fn main() {
    let leb: Vec<i32> = Bytes::from_leb128_u32(624485)
    Test::assert_eq_i32(leb.len(), 3)
    Test::assert_eq_i32(leb.get_unchecked(0), 229)
    Test::assert_eq_i32(leb.get_unchecked(1), 142)
    Test::assert_eq_i32(leb.get_unchecked(2), 38)
}
