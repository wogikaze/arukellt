use std::bytes
use std::bytes::Bytes
use std::test

fn main() {
    let xs: Vec<i32> = Vec::new<i32>()
    push(xs, 256)
    push(xs, 257)
    push(xs, 255)
    let b: Vec<i32> = Bytes::from_array(xs)
    test::assert_eq_i32(b.get_unchecked(0), 0)
    test::assert_eq_i32(b.get_unchecked(1), 1)
    test::assert_eq_i32(b.get_unchecked(2), 255)
}
