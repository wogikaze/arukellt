use std::bytes
use std::bytes::Bytes
use std::host::stdio::Stdio

fn main() {
    let le16: Vec<i32> = Bytes::from_u16_le(513)
    Stdio::println((le16.get_unchecked(0)).to_string())
    Stdio::println((le16.get_unchecked(1)).to_string())
    let rt16: i32 = le16.to_u16_le()
    Stdio::println((rt16).to_string())
    let le32: Vec<i32> = Bytes::from_u32_le(305419896)
    Stdio::println((le32.len()).to_string())
    Stdio::println((le32.get_unchecked(0)).to_string())
    let rt32: i32 = le32.to_u32_le()
    Stdio::println((rt32).to_string())
    let be32: Vec<i32> = Bytes::from_u32_be(16909060)
    Stdio::println((be32.get_unchecked(0)).to_string())
    Stdio::println((be32.get_unchecked(1)).to_string())
    Stdio::println((be32.get_unchecked(2)).to_string())
    Stdio::println((be32.get_unchecked(3)).to_string())
    let rt32be: i32 = be32.to_u32_be()
    Stdio::println((rt32be).to_string())
}
// u16 little-endian roundtrip
// u32 little-endian roundtrip
// u32 big-endian roundtrip
