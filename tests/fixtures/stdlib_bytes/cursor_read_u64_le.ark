use std::bytes
use std::test::Test
use std::prelude::{i32_to_i64}
fn main() {
    let mut data: Vec<i32> = Vec::new<i32>()
    data.push_byte(1)
    data.push_byte(0)
    data.push_byte(0)
    data.push_byte(0)
    data.push_byte(0)
    data.push_byte(0)
    data.push_byte(0)
    data.push_byte(0)
    let mut c: Vec<i32> = data.byte_cursor()
    Test::assert_eq_i64(c.read_u64_le(), i32_to_i64(1))
}
