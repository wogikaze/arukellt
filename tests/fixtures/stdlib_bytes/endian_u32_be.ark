use std::bytes
use std::bytes::Bytes
use std::test::Test

fn main() {
    let be: Vec<i32> = Bytes::from_u32_be(16909060)
    Test::assert_eq_i32(be.len(), 4)
    Test::assert_eq_i32(be.get_unchecked(0), 1)
    Test::assert_eq_i32(be.get_unchecked(1), 2)
    Test::assert_eq_i32(be.get_unchecked(2), 3)
    Test::assert_eq_i32(be.get_unchecked(3), 4)
}
