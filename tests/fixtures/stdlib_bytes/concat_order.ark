use std::bytes
use std::test

fn main() {
    let mut a: Vec<i32> = Vec::new<i32>()
    a.push_byte(10)
    a.push_byte(20)
    let mut b: Vec<i32> = Vec::new<i32>()
    b.push_byte(30)
    b.push_byte(40)
    let r: Vec<i32> = a.concat_bytes(b)
    test::assert_eq_i32(r.len(), 4)
    test::assert_eq_i32(r.get_unchecked(0), 10)
    test::assert_eq_i32(r.get_unchecked(1), 20)
    test::assert_eq_i32(r.get_unchecked(2), 30)
    test::assert_eq_i32(r.get_unchecked(3), 40)
}
