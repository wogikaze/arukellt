use std::bytes
use std::bytes::Bytes
use std::test::Test

fn main() {
    let mut vals: Vec<i32> = Vec::new<i32>()
    vals.push(0)
    vals.push(1)
    vals.push(127)
    vals.push(128)
    vals.push(16383)
    vals.push(16384)
    let n = vals.len()
    let mut i = 0
    while i < n {
        let v = vals.get_unchecked(i)
        let enc: Vec<i32> = Bytes::from_leb128_u32(v)
        let mut c: Vec<i32> = enc.byte_cursor()
        Test::assert_eq_i32(c.read_leb128_u32(), v)
        i = i + 1
    }
}
