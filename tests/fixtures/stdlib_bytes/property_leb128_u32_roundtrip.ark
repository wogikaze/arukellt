use std::bytes
use std::bytes::Bytes
use std::test

fn main() {
    let vals: Vec<i32> = Vec::new<i32>()
    push(vals, 0)
    push(vals, 1)
    push(vals, 127)
    push(vals, 128)
    push(vals, 16383)
    push(vals, 16384)
    let n = len(vals)
    let mut i = 0
    while i < n {
        let v = get_unchecked(vals, i)
        let enc: Vec<i32> = Bytes::from_leb128_u32(v)
        let c: Vec<i32> = enc.byte_cursor()
        test::assert_eq_i32(c.read_leb128_u32(), v)
        i = i + 1
    }
}
