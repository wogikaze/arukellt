// Receiver-method replacements for the deprecated numeric conversion frees
// (#917 / ADR-087). Every call below uses the canonical ADR-067 method form.
// Results are stored before comparison: chained conversion calls / method
// results used directly in a condition currently hit a GC MIR temp gap.
// Narrow-integer receivers are explicitly annotated: an unannotated narrow
// literal binding carries no local type name yet. The trailing free-wrapper
// calls pin the prelude shims that now lower through the same CoreOps.
use std::core::convert
use std::host::process::Process
use std::prelude::{i32_to_i16, i32_to_u16, u64_to_u32}

fn main() {
    let a: u8 = 255u8
    let c: u16 = 1000u16
    let d: i16 = -2i16
    let a_i32 = (a).to_i32()
    let c_i32 = (c).to_i32()
    let d_i32 = (d).to_i32()
    if a_i32 != 255 {
        Process::exit(1)
    }
    if c_i32 != 1000 {
        Process::exit(1)
    }
    if d_i32 != -2 {
        Process::exit(1)
    }

    let d8: i8 = -5i8
    let d8_min: i8 = -128i8
    let d8_max: i8 = 127i8
    let d8_i32 = (d8).to_i32()
    let d8_min_i32 = (d8_min).to_i32()
    let d8_max_i32 = (d8_max).to_i32()
    if d8_i32 != -5 {
        Process::exit(1)
    }
    if d8_min_i32 != -128 {
        Process::exit(1)
    }
    if d8_max_i32 != 127 {
        Process::exit(1)
    }

    let e: i32 = 300
    let e_u8 = (e).to_u8_wrapping()
    let e_i8 = (e).to_i8_wrapping()
    let _e_u32 = (e).to_u32_bits()
    if e_u8 != 44u8 {
        Process::exit(1)
    }
    if e_i8 != 44i8 {
        Process::exit(1)
    }

    let e_u16 = (e).to_u16_wrapping()
    let e_i16 = (e).to_i16_wrapping()
    let minus_one: i32 = -1
    let minus_one_u16 = (minus_one).to_u16_wrapping()
    let minus_one_i16 = (minus_one).to_i16_wrapping()
    let wide: i32 = 40000
    let wide_i16 = (wide).to_i16_wrapping()
    if e_u16 != 300u16 {
        Process::exit(1)
    }
    if e_i16 != 300i16 {
        Process::exit(1)
    }
    if minus_one_u16 != 65535u16 {
        Process::exit(1)
    }
    if minus_one_i16 != -1i16 {
        Process::exit(1)
    }
    if wide_i16 != -25536i16 {
        Process::exit(1)
    }

    let f: u32 = 1000u32
    let f_u64 = (f).to_u64()
    if f_u64 != 1000u64 {
        Process::exit(1)
    }

    let w: u64 = 4294967301u64
    let w_u32 = (w).to_u32_wrapping()
    let w_zero: u64 = 4294967296u64
    let w_zero_u32 = (w_zero).to_u32_wrapping()
    if w_u32 != 5u32 {
        Process::exit(1)
    }
    if w_zero_u32 != 0u32 {
        Process::exit(1)
    }

    let h: i32 = 42
    let h_wide: i64 = (h).into()
    if h_wide != 42i64 {
        Process::exit(1)
    }
    let i: i64 = 42i64
    let i_narrow = (i).to_i32_checked().unwrap_or(0)
    if i_narrow != 42 {
        Process::exit(1)
    }

    let j: f32 = 1.5f32
    let j_wide = (j).to_f64()
    if j_wide != 1.5f64 {
        Process::exit(1)
    }
    let k: f64 = 1.5f64
    let k_narrow = (k).to_f32()
    if k_narrow != 1.5f32 {
        Process::exit(1)
    }
    let k_lo = (k).to_bits_lo()
    let k_hi = (k).to_bits_hi()
    if k_lo != 0 {
        Process::exit(1)
    }
    if k_hi == 0 {
        Process::exit(1)
    }

    let free_u16: u16 = i32_to_u16(-1)
    let free_i16: i16 = i32_to_i16(40000)
    let free_u32: u32 = u64_to_u32(4294967301u64)
    if free_u16 != 65535u16 {
        Process::exit(1)
    }
    if free_i16 != -25536i16 {
        Process::exit(1)
    }
    if free_u32 != 5u32 {
        Process::exit(1)
    }
}
