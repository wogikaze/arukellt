use std::core::convert
use std::host::stdio::Stdio
fn main() {
    let a: u8 = 255u8
    let a_i32: i32 = (a).to_i32()
    Stdio::println(a_i32)
    let b: i32 = 300
    let b_u8: u8 = (b).to_u8_wrapping()
    Stdio::println(b_u8)
    let c: u16 = 1000u16
    let c_i32: i32 = (c).to_i32()
    Stdio::println(c_i32)
    let d: i8 = 42i8
    let d_i32: i32 = (d).to_i32()
    Stdio::println(d_i32)
    let e: u32 = 1000000u32
    let e_u64: u64 = (e).to_u64()
    Stdio::println(e_u64)
    let f: i64 = (1).into()
    Stdio::println(f)
    let g: i32 = (f).to_i32_wrapping()
    Stdio::println(g)
    let h: u32 = (7).to_u32_bits()
    Stdio::println(h)
}
// u8 → i32 (widening, no-op in Wasm: u8 is stored as i32)
// i32 → u8 (masking with 0xFF: 300 & 0xFF = 44)
// u16 → i32 (widening)
// i8 → i32 (widening, sign-extended)
// u32 → u64 (zero-extend)
