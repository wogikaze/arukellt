use std::host::stdio::Stdio

fn main() {
    let r = ""
    Stdio::println((r.len()).to_string())
    let r2 = "hello".clone()
    Stdio::println((r2.len()).to_string())
    Stdio::println(r2.clone())
    let r3 = r2.insert_text(5, " world")
    Stdio::println(r3.clone())
    let r4 = r3.delete_range(5, 11)
    Stdio::println(r4.clone())
    let r5 = r3.slice(6, 11)
    Stdio::println(r5)
    let r6 = "line1\nline2\nline3".clone()
    Stdio::println((r6.line_count()).to_string())
}
