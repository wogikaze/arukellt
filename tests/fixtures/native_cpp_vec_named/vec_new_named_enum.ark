// Named-enum Vec constructor via CoreOp family binding.
use std::host::stdio::Stdio

enum Cell {
    Num(i32),
    Text(String),
}

fn main() {
    let mut items = Vec::new<Cell>()
    items = push(items, Cell::Num(7))
    items = push(items, Cell::Text(String_from("ok")))
    let a = get_unchecked(items, 0)
    let b = get_unchecked(items, 1)
    match a {
        Cell::Num(n) => { Stdio::println(n.to_string()) }
        Cell::Text(s) => { Stdio::println(s) }
    }
    match b {
        Cell::Num(n) => { Stdio::println(n.to_string()) }
        Cell::Text(s) => { Stdio::println(s) }
    }
}
