use std::host::stdio::Stdio

fn make_counter() -> fn() -> i32 {
    let mut count = 0
    move || {
        count = count + 1
        count
    }
}

fn main() {
    let c = make_counter()
    Stdio::println((c()).to_string())
    Stdio::println((c()).to_string())
    Stdio::println((c()).to_string())
    let d = make_counter()
    Stdio::println((d()).to_string())
    Stdio::println((c()).to_string())
}
