use std::host::stdio::Stdio

fn apply(f: fn(i32) -> i32, x: i32) -> i32 {
    f(x)
}

fn main() {
    let base = 100
    let add = move |n: i32| -> i32 {
        n + base
    }
    // A move closure passed as a fn argument escapes its scope (#872).
    Stdio::println((apply(add, 21)).to_string())
}
