use std::host::stdio
use std::prelude::{to_upper}
use std::core::iter
fn to_upper_wrapper(s: String) -> String {
    to_upper(s)
}

fn main() {
    let mut v: Vec<String> = Vec::new<String>()
    push(v, String_from("hello"))
    push(v, String_from("world"))
    push(v, String_from("foo"))
    let result: Vec<String> = v.iter().map(to_upper_wrapper).collect()
    let mut i: i32 = 0
    while i < len(result) {
        stdio::println(get_unchecked(result, i))
        i = i + 1
    }
}
