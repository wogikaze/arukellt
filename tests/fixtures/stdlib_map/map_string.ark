use std::host::stdio::Stdio
use std::core::iter

fn to_upper_wrapper(s: String) -> String {
    s.to_upper()
}

fn main() {
    let mut v: Vec<String> = Vec::new<String>()
    v.push(String_from("hello"))
    v.push(String_from("world"))
    v.push(String_from("foo"))
    let result: Vec<String> = v.iter().map(to_upper_wrapper).collect()
    let mut i: i32 = 0
    while i < result.len() {
        Stdio::println(result.get_unchecked(i))
        i = i + 1
    }
}
