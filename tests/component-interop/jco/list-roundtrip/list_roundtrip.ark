// Component interop smoke test: list<s32> parameter and result canonical ABI.

export fn append_marker(v: Vec<i32>) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new<i32>()
    let mut i = 0
    while i < v.len() {
        out.push(v.get_unchecked(i))
        i = i + 1
    }
    out.push(99)
    out
}

