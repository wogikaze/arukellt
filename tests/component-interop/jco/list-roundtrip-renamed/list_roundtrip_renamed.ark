// Component interop smoke test: list<s32> parameter/result canonical ABI is name-independent.

export fn copy_with_tail(v: Vec<i32>) -> Vec<i32> {
    let mut out: Vec<i32> = Vec::new<i32>()
    let mut i = 0
    while i < v.len() {
        out.push(get_unchecked(v, i))
        i = i + 1
    }
    out.push(77)
    out
}

