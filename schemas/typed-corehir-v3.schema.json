{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arukellt.dev/schema/typed-corehir-v3.schema.json",
  "title": "Arukellt TypedCoreHIR v3 proof profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "module", "target_profile", "types", "functions", "proof_memory"],
  "properties": {
    "schema": {"const": "arukellt-typed-corehir"},
    "schema_version": {"const": 3},
    "generator": {"type": "string", "minLength": 1},
    "capability_profile": {"const": "proof-phases-0-7"},
    "module": {"type": "string", "minLength": 1},
    "target_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integer_model", "overflow", "floating_point", "pointer_width"],
      "properties": {
        "integer_model": {"const": "machine"},
        "overflow": {"const": "checked"},
        "floating_point": {"const": "unsupported"},
        "pointer_width": {"enum": [32, 64]}
      }
    },
    "types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/type"}},
    "proof_memory": {"$ref": "#/$defs/proof_memory"},
    "functions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/function"}}
  },
  "$defs": {
    "wasm_type": {"enum": ["i32", "i64", "f32", "f64", "v128", "funcref", "externref", "gc-ref"]},
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wasm", "nullable", "size_bytes", "align_bytes"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "wasm": {"type": "array", "items": {"$ref": "#/$defs/wasm_type"}},
        "nullable": {"type": "boolean"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "align_bytes": {"type": "integer", "minimum": 1},
        "layout_id": {"type": "integer", "minimum": 0}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type_id"],
      "properties": {"name": {"type": "string", "minLength": 1}, "type_id": {"type": "integer", "minimum": 0}}
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "discriminant", "payload_type_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "discriminant": {"type": "integer", "minimum": 0},
        "payload_type_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "type": {
      "type": "object",
      "required": ["id", "kind", "name", "representation"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["unit", "bool", "integer", "tuple", "struct", "enum", "reference"]},
        "name": {"type": "string", "minLength": 1},
        "bits": {"enum": [32, 64]},
        "signed": {"const": true},
        "elements": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}},
        "pointee_type_id": {"type": "integer", "minimum": 0},
        "representation": {"$ref": "#/$defs/representation"}
      },
      "additionalProperties": false
    },
    "reference_descriptor": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type_id", "kind", "pointee_type_id"],
          "properties": {
            "type_id": {"type": "integer", "minimum": 0},
            "kind": {"const": "object"},
            "pointee_type_id": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type_id", "kind", "element_type_id", "length_type_id"],
          "properties": {
            "type_id": {"type": "integer", "minimum": 0},
            "kind": {"enum": ["array", "slice"]},
            "element_type_id": {"type": "integer", "minimum": 0},
            "length_type_id": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "proof_memory": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "references"],
      "properties": {
        "model": {"const": "arukellt-readonly-heap-v1"},
        "references": {"type": "array", "items": {"$ref": "#/$defs/reference_descriptor"}}
      }
    },
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type_id"],
      "properties": {"name": {"type": "string", "minLength": 1}, "type_id": {"type": "integer", "minimum": 0}}
    },
    "abi_item": {
      "type": "object", "additionalProperties": false,
      "required": ["type_id", "passing", "wasm"],
      "properties": {
        "type_id": {"type": "integer", "minimum": 0},
        "passing": {"enum": ["value", "reference"]},
        "wasm": {"type": "array", "items": {"$ref": "#/$defs/wasm_type"}}
      }
    },
    "local": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "type_id", "storage"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "type_id": {"type": "integer", "minimum": 0},
        "storage": {"enum": ["parameter", "local", "temporary"]}
      }
    },
    "expression": {
      "type": "object",
      "required": ["id", "kind", "type_id", "children"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "kind": {"type": "string", "minLength": 1},
        "type_id": {"type": "integer", "minimum": 0},
        "children": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "local_id": {"type": "integer", "minimum": 0},
        "value": {},
        "index": {"type": "integer", "minimum": 0},
        "variant_index": {"type": "integer", "minimum": 0},
        "payload_index": {"type": "integer", "minimum": 0},
        "field_index": {"type": "integer", "minimum": 0},
        "conversion": {"enum": ["signed-widen", "checked-narrow"]}
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "expression_id"],
      "properties": {
        "kind": {"enum": ["requires", "ensures", "invariant", "assert", "decreases"]},
        "expression_id": {"type": "integer", "minimum": 0},
        "result_name": {"type": "string", "minLength": 1}
      }
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "signature", "abi", "locals", "contracts", "body"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "signature": {
          "type": "object", "additionalProperties": false,
          "required": ["parameters", "return_type_id"],
          "properties": {
            "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
            "return_type_id": {"type": "integer", "minimum": 0}
          }
        },
        "abi": {
          "type": "object", "additionalProperties": false,
          "required": ["calling_convention", "parameters", "results"],
          "properties": {
            "calling_convention": {"type": "string", "minLength": 1},
            "parameters": {"type": "array", "items": {"$ref": "#/$defs/abi_item"}},
            "results": {"type": "array", "items": {"$ref": "#/$defs/abi_item"}}
          }
        },
        "locals": {"type": "array", "items": {"$ref": "#/$defs/local"}},
        "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}},
        "body": {
          "type": "object", "additionalProperties": false,
          "required": ["root_expression_id", "expressions"],
          "properties": {
            "root_expression_id": {"type": "integer", "minimum": 0},
            "expressions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}
          }
        }
      }
    }
  }
}
