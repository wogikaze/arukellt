{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arukellt.dev/schema/translation-validation-v1.schema.json",
  "title": "Arukellt TranslationValidation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "pass", "source", "target", "validator", "trust_manifest_sha256", "status", "obligations"],
  "properties": {
    "schema": {"const": "arukellt-translation-validation"},
    "schema_version": {"const": 1},
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configuration_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {"$ref": "#/$defs/artifact_ref"},
    "target": {"$ref": "#/$defs/artifact_ref"},
    "validator": {"$ref": "#/$defs/tool"},
    "trust_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["validated", "failed", "unknown", "error"]},
    "obligations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "validated", "failed", "unknown", "errors"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "validated": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "sha256"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "build_id": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
