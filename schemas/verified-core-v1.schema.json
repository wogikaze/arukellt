{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arukellt.dev/schema/verified-core-v1.schema.json",
  "title": "Arukellt VerifiedCore v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "module", "target_profile", "types", "functions"],
  "properties": {
    "schema": {"const": "arukellt-verified-core"},
    "schema_version": {"const": 1},
    "generator": {"type": "string", "minLength": 1},
    "module": {"type": "string", "minLength": 1},
    "target_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integer_model", "overflow", "floating_point", "pointer_width"],
      "properties": {
        "integer_model": {"type": "string", "minLength": 1},
        "overflow": {"type": "string", "minLength": 1},
        "floating_point": {"type": "string", "minLength": 1},
        "pointer_width": {"enum": [32, 64]}
      }
    },
    "types": {"type": "array", "items": {"$ref": "#/$defs/type"}},
    "functions": {"type": "array", "items": {"$ref": "#/$defs/function"}}
  },
  "$defs": {
    "wasm_value_type": {
      "enum": ["i32", "i64", "f32", "f64", "v128", "funcref", "externref", "gc-ref"]
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "wasm", "nullable", "size_bytes", "align_bytes"],
      "properties": {
        "kind": {"enum": ["unit", "scalar", "linear-ptr", "gc-ref", "funcref"]},
        "wasm": {"type": "array", "items": {"$ref": "#/$defs/wasm_value_type"}},
        "nullable": {"type": "boolean"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "align_bytes": {"type": "integer", "minimum": 1},
        "layout_id": {"type": "integer", "minimum": 0}
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "value_type", "representation"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["unit", "bool", "integer", "float", "string", "reference", "function", "vector"]},
        "name": {"type": "string", "minLength": 1, "pattern": "^(?!unknown$)(?!\\?).+"},
        "value_type": {"enum": ["void", "i32", "i64", "f32", "f64", "v128", "ref", "gc-ref", "funcref"]},
        "representation": {"$ref": "#/$defs/representation"}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type_id": {"type": "integer", "minimum": 0}
      }
    },
    "abi_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_id", "passing", "wasm"],
      "properties": {
        "type_id": {"type": "integer", "minimum": 0},
        "passing": {"enum": ["value", "reference"]},
        "wasm": {"type": "array", "items": {"$ref": "#/$defs/wasm_value_type"}}
      }
    },
    "local": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type_id", "storage"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "type_id": {"type": "integer", "minimum": 0},
        "storage": {"enum": ["parameter", "local", "temporary"]}
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "kind_id", "type_id", "value_type", "text", "int_value", "float_value", "span_start", "children"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "kind": {"type": "string", "minLength": 1},
        "kind_id": {"type": "integer", "minimum": 0},
        "type_id": {"type": "integer", "minimum": 0},
        "value_type": {"enum": ["void", "i32", "i64", "f32", "f64", "v128", "ref", "gc-ref", "funcref"]},
        "text": {"type": "string"},
        "int_value": {"type": "integer"},
        "float_value": {"type": "number"},
        "span_start": {"type": "integer", "minimum": 0},
        "children": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_expr_id", "expressions"],
      "properties": {
        "root_expr_id": {"type": "integer", "minimum": 0},
        "expressions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expression_id"],
      "properties": {
        "kind": {"enum": ["requires", "ensures", "invariant", "assert", "decreases"]},
        "expression_id": {"type": "integer", "minimum": 0},
        "result_name": {"type": "string", "minLength": 1}
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "signature", "abi", "locals", "contracts", "body"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1, "not": {"const": "<unknown>"}},
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameters", "return_type_id"],
          "properties": {
            "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
            "return_type_id": {"type": "integer", "minimum": 0}
          }
        },
        "abi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calling_convention", "parameters", "results"],
          "properties": {
            "calling_convention": {"type": "string", "minLength": 1},
            "parameters": {"type": "array", "items": {"$ref": "#/$defs/abi_item"}},
            "results": {"type": "array", "items": {"$ref": "#/$defs/abi_item"}}
          }
        },
        "locals": {"type": "array", "items": {"$ref": "#/$defs/local"}},
        "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}},
        "body": {"$ref": "#/$defs/body"}
      }
    }
  }
}
