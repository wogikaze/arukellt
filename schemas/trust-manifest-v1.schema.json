{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arukellt.dev/schema/trust-manifest-v1.schema.json",
  "title": "Arukellt TrustManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "subject", "producer", "translator", "solver", "semantic_profile", "assumptions", "trusted_components", "limits"],
  "properties": {
    "schema": {"const": "arukellt-trust-manifest"},
    "schema_version": {"const": 1},
    "subject": {"$ref": "#/$defs/artifact_ref"},
    "producer": {"$ref": "#/$defs/tool"},
    "translator": {"$ref": "#/$defs/tool"},
    "solver": {"$ref": "#/$defs/tool"},
    "semantic_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integer_model", "overflow", "floating_point", "memory"],
      "properties": {
        "integer_model": {"type": "string", "minLength": 1},
        "overflow": {"type": "string", "minLength": 1},
        "floating_point": {"type": "string", "minLength": 1},
        "memory": {"type": "string", "minLength": 1}
      }
    },
    "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "trusted_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "artifact_sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "artifact_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "memory_bytes"],
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "sha256"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "build_id": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
