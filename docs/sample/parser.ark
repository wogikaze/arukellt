// Gloss markup parser — generates an Event stream from Gloss Markdown.
//
// Gloss extends standard Markdown with five named features:
// - Ruby   ([base/reading])  — phonetic annotation above text
// - Anno   ({base/note1/note2/...}) — semantic annotation below text
// - Nest   (--- / ;;;) — explicit section-close markers
// - Math   ($…$ / $$…$$) — KaTeX math
// - Lint   — parser warnings collected in warnings as Warning values
//
// NOTE: This is a v0 Ark parser example.
// It demonstrates the language's expressiveness and limitations.
use std::host::stdio::Stdio
use std::test::Test
fn str_find(s: String, needle: String) -> Option<i32> {
    let n = needle.len()
    let m = s.len()
    let mut i = 0
    while i + n <= m {
        if s.slice(i, i + n).eq(needle) {
            return Some(i)
        }
        i = i + 1
    }
    None
}

fn str_char_count(s: String) -> i32 {
    s.len()
}

// Split on newline bytes without `String::split`. On wasm32 the current
// string-split intrinsic returns a corrupt first segment for longer inputs;
// this scan uses only `byte_at` and `slice`, which the sample already relies
// on. Replace it with `s.split("\n")` once the intrinsic is fixed.
fn split_lines(s: String) -> Vec<String> {
    let mut parts: Vec<String> = Vec::new<String>()
    let mut start = 0
    let mut i = 0
    while i < s.len() {
        if s.byte_at(i) == 10 {
            parts.push(s.slice(start, i))
            start = i + 1
        }
        i = i + 1
    }
    parts.push(s.slice(start, s.len()))
    parts
}

fn parser_trim_start(s: String) -> String {
    let mut i = 0
    while i < s.len() && (s.byte_at(i) == 32 || s.byte_at(i) == 9 || s.byte_at(i) == 13) {
        i = i + 1
    }
    s.slice(i, s.len())
}

fn char_byte_len(c: i32) -> i32 {
    if c < 128 {
        1
    } else {
        if c < 224 {
            2
        } else {
            if c < 240 {
                3
            } else {
                4
            }
        }
    }
}

fn char_at_char_index(s: String, i: i32) -> i32 {
    s.byte_at(i)
}

