// ── Runnable sample ──────────────────────────────────────────────────────────
//
// Run with `scripts/run/arukellt-selfhost.sh run docs/sample/parser.ark`
// (wasm32) or compile with `--target wasm32-gc --emit component` and run the
// component under Wasmtime.
fn main() {
    let document = "---\ntitle: Gloss\nauthor: sample\n---\n# Heading\n\nHello [漢字/かんじ] and $x^2$.\n\n- one\n- two\n\n| A | B |\n|---|---|\n| 1 | 2 |\n\n```ark\nfn main() {}\n```\n\nFootnote[^note] and {漢字/かんじ}.\n\n[^note]: note body\n"
    let result = parse_with_source(document, "sample.ark")
    Test::assert_eq_i32(result.warnings.len(), 0)
    Test::assert_eq_i32(result.events.len(), 70)

    let lint_result = parse_with_source("$unclosed", "lint.ark")
    Test::assert_eq_i32(lint_result.warnings.len(), 1)
    Test::assert_eq_string(lint_result.warnings.get_unchecked(0).code, MATH_UNCLOSED_INLINE())

    let summary = "parser sample ok: events=" + result.events.len().to_string()
    Stdio::println(summary)
}
