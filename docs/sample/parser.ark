// ── Front matter ─────────────────────────────────────────────────────────────
struct FrontMatterField {
    key: String,
    raw: String,
}

struct FmBounds {
    fm_end: i32,
    content_start: i32,
}

struct FmResult {
    fields: Vec<FrontMatterField>,
    remainder: String,
}

fn FrontMatterField_new(key: String, raw: String) -> FrontMatterField {
    FrontMatterField { key: key, raw: raw }
}

// Extract a front matter block from the very start of text.
// Returns Option<FmResult> where remainder is the content after front matter.
fn extract_front_matter(text: String) -> Option<FmResult> {
    if !text.starts_with("---\n") {
        if !text.starts_with("---\r\n") {
            return None
        }
    }
    let after_open = str_find(text, "\n").unwrap() + 1
    let rest = text.slice(after_open, text.len())
    let close_pos: Option<i32> = str_find(rest, "\n---\n")
    let close: Option<FmBounds> = match close_pos {
        Option::Some(p) => Some(FmBounds { fm_end: p, content_start: p + 5 }),
        Option::None => {
            let close2: Option<i32> = str_find(rest, "\n---\r\n")
            match close2 {
                Option::Some(p) => Some(FmBounds { fm_end: p, content_start: p + 6 }),
                Option::None => {
                    if rest.ends_with("\n---") {
                        Some(FmBounds { fm_end: rest.len() - 4, content_start: rest.len() })
                    } else {
                        None
                    }
                },
            }
        },
    }
    match close {
        Option::None => None,
        Option::Some(b) => {
            let fm_str = rest.slice(0, b.fm_end)
            let remainder = if b.content_start < rest.len() {
                rest.slice(b.content_start, rest.len())
            } else {
                ""
            }
            let mut fields: Vec<FrontMatterField> = Vec::new<FrontMatterField>()
            let lines = split_lines(fm_str)
            let mut i = 0
            while i < lines.len() {
                let line = lines.get_unchecked(i).trim()
                if line.len() > 0 {
                    if !line.starts_with("#") {
                        let colon: Option<i32> = str_find(line, ":")
                        match colon {
                            Option::Some(idx) => {
                                let key = line.slice(0, idx).trim()
                                let raw = line.slice(idx + 1, line.len()).trim()
                                if key.len() > 0 {
                                    fields.push(FrontMatterField_new(key, raw))
                                }
                            },
                            Option::None => {
                            },
                        }
                    }
                }
                i = i + 1
            }
            Some(FmResult { fields: fields, remainder: remainder })
        },
    }
}

// ── Warning struct ────────────────────────────────────────────────────────────
struct Warning {
    code: String,
    message: String,
    source: String,
    line: i32,
    col: i32,
}

fn Warning_new(code: String, message: String, source: String, line: i32, col: i32) -> Warning {
    Warning { code: code, message: message, source: source, line: line, col: col }
}

// ── Position context ─────────────────────────────────────────────────────────
struct ParseCtx {
    input: String,
    source: String,
    line_starts: Vec<i32>,
}

fn ParseCtx_new(input: String, source: String) -> ParseCtx {
    let mut starts = Vec::new<i32>()
    starts.push(0)
    let mut i = 0
    while i < input.len() {
        if input.byte_at(i) == 10 {
            starts.push(i + 1)
        }
        i = i + 1
    }
    ParseCtx { input: input, source: source, line_starts: starts }
}

// Convert a byte offset to (1-based line, 1-based col).
struct Pos {
    line: i32,
    col: i32,
}

fn ctx_pos(ctx: ParseCtx, offset: i32) -> Pos {
    if offset < 0 {
        return Pos { line: 1, col: 1 }
    }
    if offset > ctx.input.len() {
        return Pos { line: 1, col: 1 }
    }
    let mut lo = 0
    let mut hi = ctx.line_starts.len() - 1
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if ctx.line_starts.get_unchecked(mid) <= offset {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    let line = lo + 1
    let line_start = ctx.line_starts.get_unchecked(lo)
    let col = str_char_count(ctx.input.slice(line_start, offset)) + 1
    Pos { line: line, col: col }
}

fn ctx_warn(ctx: ParseCtx, mut warnings: Vec<Warning>, code: String, msg: String, at_offset: i32) {
    let pos = ctx_pos(ctx, at_offset)
    let line = pos.line
    let col = pos.col
    warnings.push(Warning_new(code, msg, ctx.source, line, col))
}

// ── AST types ────────────────────────────────────────────────────────────────
enum Alignment {
    AlignNone,
    Left,
    Center,
    Right,
}

enum Tag {
    Paragraph,
    Heading(i32),
    Section(i32),
    Ruby(String),
    Anno(Vec<String>),
    AnnoNote,
    List(bool),
    Item,
    Code,
    CodeBlock(String, String),
    FootnoteSection,
    FootnoteItem(i32),
    Blockquote,
    Table(Vec<Alignment>),
    TableHead,
    TableRow,
    TableCell(Alignment),
    Strong,
    Emphasis,
    Strikethrough,
    Link(String),
    Image(String, String),
}

enum Event {
    Start(Tag),
    End(Tag),
    Text(String),
    MathDisplay(String),
    MathInline(String),
    SoftBreak,
    HardBreak,
    Rule,
    CardLink(String),
    FootnoteRef(i32),
    BlockId(i32),
    FrontMatter(Vec<FrontMatterField>),
}

// ── Public parser ─────────────────────────────────────────────────────────────
struct ParserResult {
    events: Vec<Event>,
    warnings: Vec<Warning>,
}

fn parse(text: String) -> ParserResult {
    parse_with_source(text, "")
}

fn parse_with_source(text: String, source: String) -> ParserResult {
    let ctx = ParseCtx_new(text, source)
    let mut events: Vec<Event> = Vec::new<Event>()
    let mut warnings: Vec<Warning> = Vec::new<Warning>()
    let content = match extract_front_matter(text) {
        Option::Some(r) => {
            events.push(Event::FrontMatter(r.fields))
            r.remainder
        },
        Option::None => text,
    }
    let lines = split_lines(content)
    let fn_defs = collect_fn_defs(lines)
    let mut fn_refs: Vec<String> = Vec::new<String>()
    parse_blocks(lines, events, warnings, ctx, true, fn_defs, fn_refs)
    emit_fn_section(fn_defs, fn_refs, events, warnings, ctx)
    ParserResult { events: events, warnings: warnings }
}

// ── FNV-1a hash ──────────────────────────────────────────────────────────────
fn fnv1a(s: String) -> i32 {
    let mut h: i32 = -2128831035
    let mut i = 0
    while i < s.len() {
        let b = s.byte_at(i)
        h = h ^ b
        h = h * 16777619
        i = i + 1
    }
    h
}

// ── Source block splitting ────────────────────────────────────────────────────
fn split_source_blocks(input: String) -> Vec<String> {
    let mut result: Vec<String> = Vec::new<String>()
    let mut block_start: Option<i32> = None
    let mut block_end: i32 = 0
    let mut in_fence: bool = false
    let mut pos: i32 = 0
    let lines = input.split("\n")
    let mut i = 0
    while i < lines.len() {
        let line = lines.get_unchecked(i)
        let line_end = pos + line.len()
        let trimmed = parser_trim_start(line)
        if trimmed.starts_with("```") {
            in_fence = !in_fence
        }
        if !in_fence && trimmed.len() == 0 {
            match block_start {
                Option::Some(start) => {
                    result.push(input.slice(start, block_end))
                    block_start = None
                },
                Option::None => {
                },
            }
        } else {
            match block_start {
                Option::None => {
                    block_start = Some(pos)
                },
                Option::Some(_) => {
                },
            }
            block_end = line_end
        }
        pos = line_end + 1
        i = i + 1
    }
    match block_start {
        Option::Some(start) => {
            result.push(input.slice(start, block_end))
        },
        Option::None => {
        },
    }
    result
}

// ── Unicode helpers ───────────────────────────────────────────────────────────
fn is_kanji(c: i32) -> bool {
    c >= 19968 && c <= 40959 || c >= 13312 && c <= 19903 || c >= 131072 && c <= 173791 || c >= 173824 && c <= 177983 || c >= 177984 && c <= 178207 || c >= 178208 && c <= 183983 || c >= 183984 && c <= 191471 || c >= 196608 && c <= 201551 || c >= 63744 && c <= 64255 || c >= 194560 && c <= 195103 || c == 12293
}

fn contains_kanji(s: String) -> bool {
    let mut i = 0
    while i < str_char_count(s) {
        if is_kanji(char_at_char_index(s, i)) {
            return true
        }
        i = i + 1
    }
    false
}

fn is_katakana(c: i32) -> bool {
    c >= 12448 && c <= 12543 || c >= 12784 && c <= 12799 || c >= 65381 && c <= 65439
}

fn is_hiragana(c: i32) -> bool {
    c >= 12352 && c <= 12447 || c == 12540
}

fn is_purely_katakana(s: String) -> bool {
    if str_char_count(s) == 0 {
        return false
    }
    let mut i = 0
    while i < str_char_count(s) {
        if !is_katakana(char_at_char_index(s, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn is_purely_hiragana(s: String) -> bool {
    if str_char_count(s) == 0 {
        return false
    }
    let mut i = 0
    while i < str_char_count(s) {
        if !is_hiragana(char_at_char_index(s, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn is_kana(c: i32) -> bool {
    c >= 12352 && c <= 12447 || c >= 12448 && c <= 12543 || c >= 12784 && c <= 12799 || c >= 65381 && c <= 65439
}

fn has_kana(s: String) -> bool {
    let mut i = 0
    while i < str_char_count(s) {
        if is_kana(char_at_char_index(s, i)) {
            return true
        }
        i = i + 1
    }
    false
}

fn has_kanji(s: String) -> bool {
    let mut i = 0
    while i < str_char_count(s) {
        if is_kanji(char_at_char_index(s, i)) {
            return true
        }
        i = i + 1
    }
    false
}

fn is_kana_or_punct(c: i32) -> bool {
    c >= 12352 && c <= 12447 || c >= 12448 && c <= 12543 || c >= 12784 && c <= 12799 || c >= 65381 && c <= 65439 || c >= 12288 && c <= 12351 || c >= 65072 && c <= 65103 || c >= 65280 && c <= 65376 || c >= 65504 && c <= 65510 || c == 714 || c == 711 || c == 715 || c == 729 || c >= 12704 && c <= 12735 || c >= 12544 && c <= 12591 || c >= 44032 && c <= 55215 || c >= 4352 && c <= 4607 || c >= 12592 && c <= 12687 || c >= 256 && c <= 591 || c >= 7680 && c <= 7935 || c == 32
}

fn is_purely_kana_or_punct(s: String) -> bool {
    if str_char_count(s) == 0 {
        return false
    }
    let mut i = 0
    while i < str_char_count(s) {
        if !is_kana_or_punct(char_at_char_index(s, i)) {
            return false
        }
        i = i + 1
    }
    true
}

// ── Footnote helpers ──────────────────────────────────────────────────────────
struct FnDef {
    id: String,
    content: String,
}

fn collect_fn_defs(lines: Vec<String>) -> Vec<FnDef> {
    let mut defs: Vec<FnDef> = Vec::new<FnDef>()
    let mut i = 0
    while i < lines.len() {
        let t = parser_trim_start(lines.get_unchecked(i))
        if t.starts_with("[^") {
            let rest = t.slice(2, t.len())
            let colon_idx = str_find(rest, "]: ")
            match colon_idx {
                Option::Some(ci) => {
                    let id = rest.slice(0, ci)
                    if id.len() > 0 && str_find(id, " ").is_none() {
                        let mut already = false
                        let mut j = 0
                        while j < defs.len() {
                            if defs.get_unchecked(j).id.eq(id) {
                                already = true
                            }
                            j = j + 1
                        }
                        if !already {
                            defs.push(FnDef { id: id, content: rest.slice(ci + 3, rest.len()) })
                        }
                    }
                },
                Option::None => {
                },
            }
        }
        i = i + 1
    }
    defs
}

fn fn_defs_find(defs: Vec<FnDef>, id: String) -> Option<String> {
    let mut i = 0
    while i < defs.len() {
        if defs.get_unchecked(i).id.eq(id) {
            return Some(defs.get_unchecked(i).content)
        }
        i = i + 1
    }
    None
}

fn fn_refs_contains(refs: Vec<String>, id: String) -> bool {
    let mut i = 0
    while i < refs.len() {
        if refs.get_unchecked(i).eq(id) {
            return true
        }
        i = i + 1
    }
    false
}

fn fn_refs_position(refs: Vec<String>, id: String) -> Option<i32> {
    let mut i = 0
    while i < refs.len() {
        if refs.get_unchecked(i).eq(id) {
            return Some(i)
        }
        i = i + 1
    }
    None
}

fn emit_fn_section(fn_defs: Vec<FnDef>, fn_refs: Vec<String>, mut events: Vec<Event>, mut warnings: Vec<Warning>, ctx: ParseCtx) {
    let mut i = 0
    while i < fn_defs.len() {
        let def = fn_defs.get_unchecked(i)
        if !fn_refs_contains(fn_refs, def.id) {
            ctx_warn(ctx, warnings, FOOTNOTE_UNUSED_DEF(), "Footnote '[^".concat((def.id).concat("' is defined but never referenced.".concat(""))), 0)
        }
        i = i + 1
    }
    if fn_refs.len() == 0 {
        return
    }
    events.push(Event::Start(Tag::FootnoteSection))
    let mut idx = 0
    while idx < fn_refs.len() {
        let id = fn_refs.get_unchecked(idx)
        let num = idx + 1
        let content = fn_defs_find(fn_defs, id)
        match content {
            Option::Some(c) => {
                events.push(Event::Start(Tag::FootnoteItem(num)))
                let mut nested_refs: Vec<String> = Vec::new<String>()
                parse_inline(c, events, warnings, ctx, false, fn_defs, nested_refs)
                events.push(Event::End(Tag::FootnoteItem(num)))
            },
            Option::None => {
            },
        }
        idx = idx + 1
    }
    events.push(Event::End(Tag::FootnoteSection))
}

// ── Block parser ──────────────────────────────────────────────────────────────
fn parse_blocks(lines: Vec<String>, mut events: Vec<Event>, mut warnings: Vec<Warning>, ctx: ParseCtx, root: bool, fn_defs: Vec<FnDef>, mut fn_refs: Vec<String>) {
    let mut i = 0
    let mut section_stack: Vec<i32> = Vec::new<i32>()
    while i < lines.len() {
        let line = lines.get_unchecked(i)
        let tline = parser_trim_start(line)
        if tline.len() == 0 {
            i = i + 1
        } else {
            if tline.starts_with("[^") && str_find(tline, "]: ").is_some() {
                i = i + 1
            } else {
                if tline.starts_with("@[") {
                    let bracket_end = str_find(tline.slice(2, tline.len()), "]")
                    match bracket_end {
                        Option::Some(be) => {
                            let type_name = tline.slice(2, 2 + be)
                            let after = tline.slice(2 + be + 1, tline.len())
                            if type_name.eq("card") {
                                if after.starts_with("(") && after.ends_with(")") {
                                    let url = after.slice(1, after.len() - 1)
                                    if !url.starts_with("http://") && !url.starts_with("https://") {
                                        ctx_warn(ctx, warnings, CARD_NON_HTTP(), "Card link URL '".concat(url.concat("' should start with http:// or https://")), 0)
                                    }
                                    events.push(Event::CardLink(url))
                                } else {
                                    ctx_warn(ctx, warnings, CARD_MALFORMED(), "Malformed @[card] syntax near '".concat(tline.slice(0, min_i32(tline.len(), 40)).concat("'.")), 0)
                                }
                            } else {
                                ctx_warn(ctx, warnings, CARD_UNKNOWN_TYPE(), "Unknown embed type '".concat(type_name.concat("': only 'card' is supported.")), 0)
                            }
                        },
                        Option::None => {
                        },
                    }
                    i = i + 1
                } else {
                    if tline.starts_with("```") {
                        let info = tline.slice(3, tline.len()).trim()
                        let colon = str_find(info, ":")
                        let lang = match colon {
                            Option::Some(c) => info.slice(0, c),
                            Option::None => info,
                        }
                        let filename = match colon {
                            Option::Some(c) => info.slice(c + 1, info.len()),
                            Option::None => "",
                        }
                        events.push(Event::BlockId(fnv1a(tline)))
                        events.push(Event::Start(Tag::CodeBlock(lang, filename)))
                        i = i + 1
                        while i < lines.len() && !parser_trim_start(lines.get_unchecked(i)).starts_with("```") {
                            events.push(Event::Text(lines.get_unchecked(i)))
                            events.push(Event::Text("\n"))
                            i = i + 1
                        }
                        if i < lines.len() {
                            i = i + 1
                        }
                        events.push(Event::End(Tag::CodeBlock(lang, filename)))
                    } else {
                        if tline.starts_with("#") {
                            let mut level = 0
                            while level < tline.len() && tline.byte_at(level) == 35 {
                                level = level + 1
                            }
                            if level > 0 && level <= 6 {
                                let valid = level == tline.len() || tline.byte_at(level) == 32
                                if valid {
                                    if root {
                                        close_sections_until(events, section_stack, level)
                                        events.push(Event::Start(Tag::Section(level)))
                                        section_stack.push(level)
                                    }
                                    events.push(Event::BlockId(fnv1a(tline)))
                                    events.push(Event::Start(Tag::Heading(level)))
                                    parse_inline(tline.slice(level, tline.len()).trim(), events, warnings, ctx, false, fn_defs, fn_refs)
                                    events.push(Event::End(Tag::Heading(level)))
                                    i = i + 1
                                } else {
                                    i = parse_paragraph(lines, i, events, warnings, ctx, fn_defs, fn_refs)
                                }
                            } else {
                                i = parse_paragraph(lines, i, events, warnings, ctx, fn_defs, fn_refs)
                            }
                        } else {
                            if line.starts_with("---") && all_chars_eq(line, 45) {
                                if root && line.len() == 3 {
                                    pop_section(events, section_stack)
                                }
                                events.push(Event::Rule)
                                i = i + 1
                            } else {
                                if line.starts_with(";;;") {
                                    if root {
                                        let count = count_occurrences(line, ";;;")
                                        let mut k = 0
                                        while k < count {
                                            pop_section(events, section_stack)
                                            k = k + 1
                                        }
                                    }
                                    i = i + 1
                                } else {
                                    if line.starts_with(">") {
                                        let mut bq_lines: Vec<String> = Vec::new<String>()
                                        let mut j = i
                                        while j < lines.len() {
                                            let ln = lines.get_unchecked(j)
                                            if ln.starts_with(">") {
                                                let mut content = ln.slice(1, ln.len())
                                                if content.starts_with(" ") {
                                                    content = content.slice(1, content.len())
                                                }
                                                bq_lines.push(content)
                                                j = j + 1
                                            } else {
                                                if ln.trim().len() == 0 && j > i && j + 1 < lines.len() && lines.get_unchecked(j + 1).starts_with(">") {
                                                    bq_lines.push("")
                                                    j = j + 1
                                                } else {
                                                    break
                                                }
                                            }
                                        }
                                        let src_hash = fnv1a_lines(bq_lines)
                                        events.push(Event::BlockId(src_hash))
                                        events.push(Event::Start(Tag::Blockquote))
                                        parse_blocks(bq_lines, events, warnings, ctx, false, fn_defs, fn_refs)
                                        events.push(Event::End(Tag::Blockquote))
                                        i = j
                                    } else {
                                        if is_table_line(line) && i + 1 < lines.len() && is_table_line(lines.get_unchecked(i + 1)) {
                                            let sep_line = lines.get_unchecked(i + 1).trim()
                                            if str_find(sep_line, "-|").is_some() || str_find(sep_line, "|-").is_some() {
                                                let head = parse_table_cells(line)
                                                let sep = parse_table_cells(lines.get_unchecked(i + 1))
                                                let aligns = parse_alignments(sep)
                                                events.push(Event::BlockId(fnv1a(line)))
                                                events.push(Event::Start(Tag::Table(aligns.clone())))
                                                events.push(Event::Start(Tag::TableHead))
                                                events.push(Event::Start(Tag::TableRow))
                                                let mut ci = 0
                                                while ci < head.len() {
                                                    events.push(Event::Start(Tag::TableCell(alignment_at(aligns, ci))))
                                                    parse_inline(head.get_unchecked(ci), events, warnings, ctx, false, fn_defs, fn_refs)
                                                    events.push(Event::End(Tag::TableCell(alignment_at(aligns, ci))))
                                                    ci = ci + 1
                                                }
                                                events.push(Event::End(Tag::TableRow))
                                                events.push(Event::End(Tag::TableHead))
                                                let mut j = i + 2
                                                while j < lines.len() && is_table_line(lines.get_unchecked(j)) {
                                                    events.push(Event::Start(Tag::TableRow))
                                                    let row = parse_table_cells(lines.get_unchecked(j))
                                                    let mut ci2 = 0
                                                    while ci2 < row.len() {
                                                        events.push(Event::Start(Tag::TableCell(alignment_at(aligns, ci2))))
                                                        parse_inline(row.get_unchecked(ci2), events, warnings, ctx, false, fn_defs, fn_refs)
                                                        events.push(Event::End(Tag::TableCell(alignment_at(aligns, ci2))))
                                                        ci2 = ci2 + 1
                                                    }
                                                    events.push(Event::End(Tag::TableRow))
                                                    j = j + 1
                                                }
                                                events.push(Event::End(Tag::Table(aligns)))
                                                i = j
                                            } else {
                                                i = parse_paragraph(lines, i, events, warnings, ctx, fn_defs, fn_refs)
                                            }
                                        } else {
                                            if is_ul_line(tline) || is_ol_line(tline) {
                                                let is_ol = is_ol_line(tline)
                                                events.push(Event::BlockId(fnv1a(tline)))
                                                events.push(Event::Start(Tag::List(is_ol)))
                                                let mut j = i
                                                while j < lines.len() {
                                                    let l2 = parser_trim_start(lines.get_unchecked(j))
                                                    let matches_type = if is_ol {
                                                        is_ol_line(l2)
                                                    } else {
                                                        is_ul_line(l2)
                                                    }
                                                    if matches_type {
                                                        let content = if is_ul_line(l2) {
                                                            l2.slice(2, l2.len())
                                                        } else {
                                                            let digs = count_leading_digits(l2)
                                                            l2.slice(digs + 2, l2.len())
                                                        }
                                                        events.push(Event::Start(Tag::Item))
                                                        parse_inline(content, events, warnings, ctx, false, fn_defs, fn_refs)
                                                        events.push(Event::End(Tag::Item))
                                                        j = j + 1
                                                    } else {
                                                        break
                                                    }
                                                }
                                                events.push(Event::End(Tag::List(is_ol)))
                                                i = j
                                            } else {
                                                i = parse_paragraph(lines, i, events, warnings, ctx, fn_defs, fn_refs)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root {
        while section_stack.len() > 0 {
            pop_section(events, section_stack)
        }
    }
}

// ── Block parser helpers ─────────────────────────────────────────────────────
fn pop_section(mut events: Vec<Event>, mut stack: Vec<i32>) {
    if stack.len() > 0 {
        let level = stack.get_unchecked(stack.len() - 1)
        let _ = stack.pop()
        events.push(Event::End(Tag::Section(level)))
    }
}

fn close_sections_until(mut events: Vec<Event>, mut stack: Vec<i32>, level: i32) {
    while stack.len() > 0 {
        let top = stack.get_unchecked(stack.len() - 1)
        if top >= level {
            pop_section(events, stack)
        } else {
            return
        }
    }
}

fn is_table_line(line: String) -> bool {
    parser_trim_start(line).starts_with("|")
}

fn is_ul_line(tline: String) -> bool {
    tline.starts_with("- ") || tline.starts_with("* ")
}

fn is_ol_line(tline: String) -> bool {
    let digs = count_leading_digits(tline)
    digs > 0 && tline.slice(digs, tline.len()).starts_with(". ")
}

fn count_leading_digits(s: String) -> i32 {
    let mut count = 0
    while count < s.len() && is_ascii_digit(s.byte_at(count)) {
        count = count + 1
    }
    count
}

fn all_chars_eq(s: String, c: i32) -> bool {
    let mut i = 0
    while i < str_char_count(s) {
        if char_at_char_index(s, i) != c {
            return false
        }
        i = i + 1
    }
    str_char_count(s) > 0
}

fn count_occurrences(s: String, needle: String) -> i32 {
    let mut count = 0
    let mut pos = 0
    while pos + needle.len() <= s.len() {
        if s.slice(pos, pos + needle.len()).eq(needle) {
            count = count + 1
            pos = pos + needle.len()
        } else {
            pos = pos + 1
        }
    }
    count
}

fn fnv1a_lines(lines: Vec<String>) -> i32 {
    let mut h: i32 = -2128831035
    let mut i = 0
    while i < lines.len() {
        let line = lines.get_unchecked(i)
        let mut j = 0
        while j < line.len() {
            h = h ^ line.byte_at(j)
            h = h * 16777619
            j = j + 1
        }
        i = i + 1
    }
    h
}

fn parse_table_cells(line: String) -> Vec<String> {
    let t = line.trim()
    let t2 = if t.starts_with("|") {
        t.slice(1, t.len())
    } else {
        t
    }
    let t3 = if t2.ends_with("|") {
        t2.slice(0, t2.len() - 1)
    } else {
        t2
    }
    let parts = t3.split("|")
    let mut result: Vec<String> = Vec::new<String>()
    let mut i = 0
    while i < parts.len() {
        result.push(parts.get_unchecked(i).trim())
        i = i + 1
    }
    result
}

fn parse_alignments(sep_cells: Vec<String>) -> Vec<Alignment> {
    let mut aligns: Vec<Alignment> = Vec::new<Alignment>()
    let mut i = 0
    while i < sep_cells.len() {
        let s = sep_cells.get_unchecked(i).trim()
        let left = s.starts_with(":")
        let right = s.ends_with(":")
        if left && right {
            aligns.push(Alignment::Center)
        } else {
            if left {
                aligns.push(Alignment::Left)
            } else {
                if right {
                    aligns.push(Alignment::Right)
                } else {
                    aligns.push(Alignment::AlignNone)
                }
            }
        }
        i = i + 1
    }
    aligns
}

// `Alignment` has no `Clone` impl, and cloning a unit enum read from a
// `Vec<Alignment>` traps on wasm32-gc. Re-read the element at each use site
// instead; the fallback keeps short rows aligned with the separator.
fn alignment_at(aligns: Vec<Alignment>, index: i32) -> Alignment {
    if index < aligns.len() {
        aligns.get_unchecked(index)
    } else {
        Alignment::AlignNone
    }
}

fn is_block_start(line: String, tline: String) -> bool {
    tline.len() == 0 || tline.starts_with("```") || tline.starts_with("#") || line.starts_with("---") && all_chars_eq(line, 45) || line.starts_with(";;;") || line.starts_with(">") || is_table_line(line) || tline.starts_with("- ") || tline.starts_with("* ") || is_ol_line(tline) || tline.starts_with("@[") || tline.starts_with("[^") && str_find(tline, "]: ").is_some()
}

fn parse_paragraph(lines: Vec<String>, start: i32, mut events: Vec<Event>, mut warnings: Vec<Warning>, ctx: ParseCtx, fn_defs: Vec<FnDef>, mut fn_refs: Vec<String>) -> i32 {
    let mut para: Vec<String> = Vec::new<String>()
    let mut j = start
    while j < lines.len() {
        let ln = lines.get_unchecked(j)
        let t = parser_trim_start(ln)
        if is_block_start(ln, t) {
            break
        } else {
            para.push(ln)
            j = j + 1
        }
    }
    if para.len() > 0 {
        let para_hash = fnv1a_lines(para)
        events.push(Event::BlockId(para_hash))
        events.push(Event::Start(Tag::Paragraph))
        let mut pidx = 0
        while pidx < para.len() {
            parse_inline(para.get_unchecked(pidx), events, warnings, ctx, false, fn_defs, fn_refs)
            if pidx < para.len() - 1 {
                events.push(Event::HardBreak)
            }
            pidx = pidx + 1
        }
        events.push(Event::End(Tag::Paragraph))
    }
    j
}

// ── Inline parser ─────────────────────────────────────────────────────────────
fn parse_inline(text: String, mut events: Vec<Event>, mut warnings: Vec<Warning>, ctx: ParseCtx, in_annotation: bool, fn_defs: Vec<FnDef>, mut fn_refs: Vec<String>) {
    let mut pos = 0
    while pos < text.len() {
        let remaining = text.slice(pos, text.len())
        if remaining.starts_with("$$") {
            let end = str_find(remaining.slice(2, remaining.len()), "$$")
            match end {
                Option::Some(e) => {
                    events.push(Event::MathDisplay(remaining.slice(2, 2 + e)))
                    pos = pos + 2 + e + 2
                },
                Option::None => {
                    ctx_warn(ctx, warnings, MATH_UNCLOSED_DISPLAY(), "Unclosed '$$' math block: no matching '$$' found.", pos)
                    pos = pos + 1
                },
            }
        } else {
            if remaining.starts_with("$") && !remaining.starts_with("$$") {
                let end = str_find(remaining.slice(1, remaining.len()), "$")
                match end {
                    Option::Some(e) => {
                        events.push(Event::MathInline(remaining.slice(1, 1 + e)))
                        pos = pos + 1 + e + 1
                    },
                    Option::None => {
                        ctx_warn(ctx, warnings, MATH_UNCLOSED_INLINE(), "Unclosed '$' math expression: no matching '$' found.", pos)
                        pos = pos + 1
                    },
                }
            } else {
                if remaining.starts_with("`") {
                    let end = str_find(remaining.slice(1, remaining.len()), "`")
                    match end {
                        Option::Some(e) => {
                            events.push(Event::Start(Tag::Code))
                            events.push(Event::Text(remaining.slice(1, 1 + e)))
                            events.push(Event::End(Tag::Code))
                            pos = pos + 1 + e + 1
                        },
                        Option::None => {
                            events.push(Event::Text(remaining.slice(0, 1)))
                            pos = pos + 1
                        },
                    }
                } else {
                    if remaining.starts_with("~~") {
                        let end = str_find(remaining.slice(2, remaining.len()), "~~")
                        match end {
                            Option::Some(e) => {
                                events.push(Event::Start(Tag::Strikethrough))
                                parse_inline(remaining.slice(2, 2 + e), events, warnings, ctx, in_annotation, fn_defs, fn_refs)
                                events.push(Event::End(Tag::Strikethrough))
                                pos = pos + 2 + e + 2
                            },
                            Option::None => {
                                events.push(Event::Text(remaining.slice(0, 2)))
                                pos = pos + 2
                            },
                        }
                    } else {
                        if remaining.starts_with("**") {
                            let end = str_find(remaining.slice(2, remaining.len()), "**")
                            match end {
                                Option::Some(e) => {
                                    events.push(Event::Start(Tag::Strong))
                                    parse_inline(remaining.slice(2, 2 + e), events, warnings, ctx, in_annotation, fn_defs, fn_refs)
                                    events.push(Event::End(Tag::Strong))
                                    pos = pos + 2 + e + 2
                                },
                                Option::None => {
                                    events.push(Event::Text(remaining.slice(0, 2)))
                                    pos = pos + 2
                                },
                            }
                        } else {
                            if remaining.starts_with("*") && !remaining.starts_with("**") {
                                let end = str_find(remaining.slice(1, remaining.len()), "*")
                                match end {
                                    Option::Some(e) => {
                                        events.push(Event::Start(Tag::Emphasis))
                                        parse_inline(remaining.slice(1, 1 + e), events, warnings, ctx, in_annotation, fn_defs, fn_refs)
                                        events.push(Event::End(Tag::Emphasis))
                                        pos = pos + 1 + e + 1
                                    },
                                    Option::None => {
                                        events.push(Event::Text(remaining.slice(0, 1)))
                                        pos = pos + 1
                                    },
                                }
                            } else {
                                if remaining.starts_with("\\n") {
                                    events.push(Event::HardBreak)
                                    pos = pos + 2
                                } else {
                                    if remaining.starts_with("\\") && remaining.len() >= 2 {
                                        let ch = remaining.byte_at(1)
                                        let ch_len = char_byte_len(ch)
                                        events.push(Event::Text(remaining.slice(1, 1 + ch_len)))
                                        pos = pos + 1 + ch_len
                                    } else {
                                        if remaining.starts_with("![") {
                                            let close_alt = find_matching_bracket(remaining, 1)
                                            match close_alt {
                                                Option::Some(ca) => {
                                                    if ca + 1 < remaining.len() && remaining.byte_at(ca + 1) == 40 {
                                                        let cp = str_find(remaining.slice(ca + 2, remaining.len()), ")")
                                                        match cp {
                                                            Option::Some(p) => {
                                                                let close_src = ca + 2 + p
                                                                let alt = remaining.slice(2, ca)
                                                                let src = remaining.slice(ca + 2, close_src)
                                                                events.push(Event::Start(Tag::Image(src, alt)))
                                                                events.push(Event::End(Tag::Image(src, alt)))
                                                                pos = pos + close_src + 1
                                                            },
                                                            Option::None => {
                                                                events.push(Event::Text(remaining.slice(0, 1)))
                                                                pos = pos + 1
                                                            },
                                                        }
                                                    } else {
                                                        events.push(Event::Text(remaining.slice(0, 1)))
                                                        pos = pos + 1
                                                    }
                                                },
                                                Option::None => {
                                                    events.push(Event::Text(remaining.slice(0, 1)))
                                                    pos = pos + 1
                                                },
                                            }
                                        } else {
                                            if remaining.starts_with("[^") {
                                                let bracket_end = str_find(remaining.slice(2, remaining.len()), "]")
                                                match bracket_end {
                                                    Option::Some(be) => {
                                                        let id = remaining.slice(2, 2 + be)
                                                        if id.len() > 0 && str_find(id, " ").is_none() {
                                                            let total_len = 2 + be + 1
                                                            let has_def = match fn_defs_find(fn_defs, id) {
                                                                Option::Some(_) => true,
                                                                Option::None => false,
                                                            }
                                                            if has_def {
                                                                let existing = fn_refs_position(fn_refs, id)
                                                                let num = match existing {
                                                                    Option::Some(p) => p + 1,
                                                                    Option::None => {
                                                                        fn_refs.push(id)
                                                                        fn_refs.len()
                                                                    },
                                                                }
                                                                events.push(Event::FootnoteRef(num))
                                                            } else {
                                                                ctx_warn(ctx, warnings, FOOTNOTE_UNDEFINED_REF(), "Footnote reference '[^".concat(id.concat("]' has no matching definition.")), pos)
                                                                events.push(Event::Text(remaining.slice(0, total_len)))
                                                            }
                                                            pos = pos + total_len
                                                        } else {
                                                            events.push(Event::Text(remaining.slice(0, 1)))
                                                            pos = pos + 1
                                                        }
                                                    },
                                                    Option::None => {
                                                        events.push(Event::Text(remaining.slice(0, 1)))
                                                        pos = pos + 1
                                                    },
                                                }
                                            } else {
                                                if remaining.starts_with("[") {
                                                    let close_bracket = find_matching_bracket(remaining, 0)
                                                    match close_bracket {
                                                        Option::Some(cb) => {
                                                            let content = remaining.slice(1, cb)
                                                            if cb + 1 < remaining.len() && remaining.byte_at(cb + 1) == 40 {
                                                                let cp = str_find(remaining.slice(cb + 2, remaining.len()), ")")
                                                                match cp {
                                                                    Option::Some(p) => {
                                                                        let close_paren = cb + 2 + p
                                                                        let href = remaining.slice(cb + 2, close_paren)
                                                                        events.push(Event::Start(Tag::Link(href)))
                                                                        parse_inline(content, events, warnings, ctx, in_annotation, fn_defs, fn_refs)
                                                                        events.push(Event::End(Tag::Link(href)))
                                                                        pos = pos + close_paren + 1
                                                                    },
                                                                    Option::None => {
                                                                        events.push(Event::Text(remaining.slice(0, 1)))
                                                                        pos = pos + 1
                                                                    },
                                                                }
                                                            } else {
                                                                let slash = find_slash_at_depth_zero(content)
                                                                match slash {
                                                                    Option::Some(si) => {
                                                                        let base = content.slice(0, si)
                                                                        let ruby = content.slice(si + 1, content.len())
                                                                        let token = remaining.slice(0, cb + 1)
                                                                        if base.len() == 0 {
                                                                            ctx_warn(ctx, warnings, RUBY_EMPTY_BASE(), "Ruby '[".concat(content.concat("': base text is empty.")), pos)
                                                                        }
                                                                        if ruby.len() == 0 {
                                                                            ctx_warn(ctx, warnings, RUBY_EMPTY_READING(), "Ruby '[".concat(content.concat("': reading is empty.")), pos)
                                                                        }
                                                                        if base.len() > 0 && ruby.len() > 0 && base.eq(ruby) {
                                                                            ctx_warn(ctx, warnings, RUBY_SELF_REFERENTIAL(), "Ruby '[".concat(base.concat("/".concat(ruby.concat("': base and reading are identical.")))), pos)
                                                                        }
                                                                        if is_purely_katakana(base) && is_purely_hiragana(ruby) {
                                                                            ctx_warn(ctx, warnings, RUBY_KATAKANA_HIRAGANA(), "Ruby '[".concat(base.concat("/".concat(ruby.concat("': katakana base with hiragana reading.")))), pos)
                                                                        } else {
                                                                            if base.len() > 0 && has_kana(base) {
                                                                                ctx_warn(ctx, warnings, RUBY_KANA_BASE(), "Ruby '[".concat(base.concat("/".concat(ruby.concat("': base text contains kana.")))), pos)
                                                                            }
                                                                        }
                                                                        if ruby.len() > 0 && has_kanji(ruby) {
                                                                            ctx_warn(ctx, warnings, RUBY_KANJI_READING(), "Ruby '[".concat(base.concat("/".concat(ruby.concat("': reading contains kanji.")))), pos)
                                                                        }
                                                                        events.push(Event::Start(Tag::Ruby(ruby)))
                                                                        parse_inline(base, events, warnings, ctx, true, fn_defs, fn_refs)
                                                                        events.push(Event::End(Tag::Ruby(ruby)))
                                                                        pos = pos + cb + 1
                                                                    },
                                                                    Option::None => {
                                                                        if str_find(content, "/").is_some() {
                                                                            ctx_warn(ctx, warnings, RUBY_MALFORMED(), "Possibly malformed ruby syntax '[".concat(content.slice(0, min_i32(content.len(), 30)).concat("'].")), pos)
                                                                        }
                                                                        events.push(Event::Text(remaining.slice(0, 1)))
                                                                        pos = pos + 1
                                                                    },
                                                                }
                                                            }
                                                        },
                                                        Option::None => {
                                                            if str_find(remaining.slice(1, remaining.len()), "/").is_some() || str_find(remaining.slice(1, remaining.len()), "]").is_some() {
                                                                ctx_warn(ctx, warnings, RUBY_MALFORMED(), "Possibly malformed ruby syntax near '".concat(remaining.slice(0, min_i32(remaining.len(), 30)).concat("'.")), pos)
                                                            }
                                                            events.push(Event::Text(remaining.slice(0, 1)))
                                                            pos = pos + 1
                                                        },
                                                    }
                                                } else {
                                                    if remaining.starts_with("{") {
                                                        let close_brace = find_matching_brace(remaining)
                                                        match close_brace {
                                                            Option::Some(end) => {
                                                                let content = remaining.slice(1, end)
                                                                let parts = split_at_depth_zero(content, 47)
                                                                if parts.len() >= 2 {
                                                                    let base = parts.get_unchecked(0)
                                                                    let mut notes: Vec<String> = Vec::new<String>()
                                                                    let mut ni = 1
                                                                    while ni < parts.len() {
                                                                        notes.push(parts.get_unchecked(ni))
                                                                        ni = ni + 1
                                                                    }
                                                                    if base.len() == 0 {
                                                                        ctx_warn(ctx, warnings, ANNO_EMPTY_BASE(), "Anno '".concat(content.concat("': base text is empty.")), pos)
                                                                    }
                                                                    if notes.len() == 1 && contains_kanji(base) && is_purely_kana_or_punct(notes.get_unchecked(0)) {
                                                                        ctx_warn(ctx, warnings, ANNO_LOOKS_LIKE_RUBY(), "Anno '{".concat(base.concat("/".concat(notes.get_unchecked(0).concat("}' looks like a Ruby reading.")))), pos)
                                                                    }
                                                                    events.push(Event::Start(Tag::Anno(notes.clone())))
                                                                    parse_inline(base, events, warnings, ctx, true, fn_defs, fn_refs)
                                                                    let mut nidx = 0
                                                                    while nidx < notes.len() {
                                                                        events.push(Event::Start(Tag::AnnoNote))
                                                                        parse_inline(notes.get_unchecked(nidx), events, warnings, ctx, true, fn_defs, fn_refs)
                                                                        events.push(Event::End(Tag::AnnoNote))
                                                                        nidx = nidx + 1
                                                                    }
                                                                    events.push(Event::End(Tag::Anno(notes)))
                                                                    pos = pos + end + 1
                                                                } else {
                                                                    events.push(Event::Text(remaining.slice(0, 1)))
                                                                    pos = pos + 1
                                                                }
                                                            },
                                                            Option::None => {
                                                                ctx_warn(ctx, warnings, ANNO_MALFORMED(), "Possibly malformed anno syntax near '".concat(remaining.slice(0, min_i32(remaining.len(), 30)).concat("'.")), pos)
                                                                events.push(Event::Text(remaining.slice(0, 1)))
                                                                pos = pos + 1
                                                            },
                                                        }
                                                    } else {
                                                        let next_special = find_next_special(remaining)
                                                        if next_special == 0 {
                                                            let ch = remaining.byte_at(0)
                                                            let ch_len = char_byte_len(ch)
                                                            let t = remaining.slice(0, ch_len)
                                                            if !in_annotation && contains_kanji(t) {
                                                                ctx_warn(ctx, warnings, KANJI_NO_RUBY(), "Kanji without ruby: '".concat(t.trim().concat("'")), pos)
                                                            }
                                                            events.push(Event::Text(t))
                                                            pos = pos + ch_len
                                                        } else {
                                                            let t = remaining.slice(0, next_special)
                                                            if !in_annotation && contains_kanji(t) {
                                                                ctx_warn(ctx, warnings, KANJI_NO_RUBY(), "Kanji without ruby: '".concat(t.trim().concat("'")), pos)
                                                            }
                                                            events.push(Event::Text(t))
                                                            pos = pos + next_special
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── Inline parser helpers ────────────────────────────────────────────────────
fn find_matching_bracket(text: String, start: i32) -> Option<i32> {
    let mut bracket = 0
    let mut i = start
    while i < text.len() {
        let c = text.byte_at(i)
        if c == 91 {
            bracket = bracket + 1
        }
        if c == 93 {
            bracket = bracket - 1
            if bracket == 0 {
                return Some(i)
            }
        }
        i = i + 1
    }
    None
}

fn find_matching_brace(text: String) -> Option<i32> {
    let mut depth = 0
    let mut i = 0
    while i < text.len() {
        let c = text.byte_at(i)
        if c == 123 {
            depth = depth + 1
        }
        if c == 125 {
            depth = depth - 1
            if depth == 0 {
                return Some(i)
            }
        }
        i = i + 1
    }
    None
}

fn find_slash_at_depth_zero(content: String) -> Option<i32> {
    let mut blk = 0
    let mut i = 0
    while i < content.len() {
        let c = content.byte_at(i)
        if c == 91 {
            blk = blk + 1
        }
        if c == 93 {
            blk = blk - 1
        }
        if c == 47 && blk == 0 {
            return Some(i)
        }
        i = i + 1
    }
    None
}

fn split_at_depth_zero(content: String, sep: i32) -> Vec<String> {
    let mut parts: Vec<String> = Vec::new<String>()
    let mut last = 0
    let mut blk = 0
    let mut i = 0
    while i < content.len() {
        let c = content.byte_at(i)
        if c == 91 {
            blk = blk + 1
        }
        if c == 93 {
            blk = blk - 1
        }
        if c == sep && blk == 0 {
            parts.push(content.slice(last, i))
            last = i + 1
        }
        i = i + 1
    }
    parts.push(content.slice(last, content.len()))
    parts
}

fn find_next_special(text: String) -> i32 {
    let mut i = 0
    while i < text.len() {
        let c = text.byte_at(i)
        if c == 36 || c == 91 || c == 123 || c == 96 || c == 92 || c == 42 || c == 126 || c == 33 {
            return i
        }
        i = i + 1
    }
    text.len()
}

fn is_ascii_digit(c: i32) -> bool {
    c >= 48 && c <= 57
}

fn min_i32(a: i32, b: i32) -> i32 {
    if a < b {
        a
    } else {
        b
    }
}
