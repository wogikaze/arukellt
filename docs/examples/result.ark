use std::host::stdio::Stdio

fn divide(a: i32, b: i32) -> Result<i32, String> {
    if b == 0 {
        Err(String_from("division by zero"))
    } else {
        Ok(a / b)
    }
}

fn main() {
    match divide(10, 2) {
        Result::Ok(v) => Stdio::println((v).to_string()),
        Result::Err(e) => Stdio::println(e),
    }
    match divide(10, 0) {
        Result::Ok(v) => Stdio::println((v).to_string()),
        Result::Err(e) => Stdio::println(e),
    }
}
