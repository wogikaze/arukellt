pub struct NameIndex {
    capacity: i32,
    buckets: Vec<i32>,
    keys: Vec<String>,
    values: Vec<i32>,
}

fn name_index_capacity(expected_entries: i32) -> i32 {
    let mut capacity = 16
    let required = expected_entries * 2
    while capacity < required {
        capacity = capacity * 2
    }
    capacity
}

pub fn NameIndex_new(expected_entries: i32) -> NameIndex {
    let capacity = name_index_capacity(expected_entries)
    let buckets = Vec::new<i32>()
    let keys = Vec::new<String>()
    let values = Vec::new<i32>()
    let mut i = 0
    while i < capacity {
        push(buckets, 0)
        i = i + 1
    }
    NameIndex {
        capacity: capacity,
        buckets: buckets,
        keys: keys,
        values: values,
    }
}

// A zero-capacity index that allocates its bucket array on the first insert.
// Records that usually stay tiny can carry one without paying for buckets.
pub fn NameIndex_empty() -> NameIndex {
    NameIndex {
        capacity: 0,
        buckets: Vec::new<i32>(),
        keys: Vec::new<String>(),
        values: Vec::new<i32>(),
    }
}

fn name_index_find_slot(index: NameIndex, name: String) -> i32 {
    if index.capacity == 0 {
        return 0 - 1
    }
    // Sample the name for the probe hash. Equality below still checks every
    // character, so collisions remain correct while short-circuiting the
    // repeated full-string FNV walk on hot lowerer lookups.
    let name_len = len(name)
    let mut hash = name_len * 31
    if name_len > 0 {
        hash = hash * 16777619 ^ char_at(name, 0)
    }
    if name_len > 2 {
        hash = hash * 16777619 ^ char_at(name, name_len / 2)
    }
    if name_len > 1 {
        hash = hash * 16777619 ^ char_at(name, name_len - 1)
    }
    if hash < 0 {
        hash = 0 - hash
    }
    let mut slot = hash % index.capacity
    let mut probes = 0
    while probes < index.capacity {
        let bucket = get_unchecked(index.buckets, slot)
        if bucket == 0 {
            return slot
        }
        let key = get_unchecked(index.keys, bucket - 1)
        let mut same = len(key) == name_len
        if same {
            let mut i = 0
            while i < name_len {
                if char_at(key, i) != char_at(name, i) {
                    same = false
                    i = name_len
                } else {
                    i = i + 1
                }
            }
        }
        if same {
            return slot
        }
        slot = (slot + 1) % index.capacity
        probes = probes + 1
    }
    0 - 1
}

pub fn name_index_get(index: NameIndex, name: String) -> i32 {
    let slot = name_index_find_slot(index, name)
    if slot < 0 {
        return 0 - 1
    }
    let bucket = get_unchecked(index.buckets, slot)
    if bucket == 0 {
        return 0 - 1
    }
    get_unchecked(index.values, bucket - 1)
}

// Keep the load factor under 1/2 so probe chains stay short and inserts never
// fail on a full table. Keys are unique, so re-probing each one lands on an
// empty slot of the doubled bucket array.
fn name_index_grow_if_needed(index: NameIndex) {
    if (len(index.keys) + 1) * 2 < index.capacity {
        return
    }
    let capacity = if index.capacity == 0 { 16 } else { index.capacity * 2 }
    let buckets = Vec::new<i32>()
    let mut i = 0
    while i < capacity {
        push(buckets, 0)
        i = i + 1
    }
    index.capacity = capacity
    index.buckets = buckets
    let key_count = len(index.keys)
    let mut ki = 0
    while ki < key_count {
        let slot = name_index_find_slot(index, clone(get_unchecked(index.keys, ki)))
        set(index.buckets, slot, ki + 1)
        ki = ki + 1
    }
}

fn name_index_push_entry(index: NameIndex, slot: i32, name: String, value: i32) {
    push(index.keys, name)
    push(index.values, value)
    set(index.buckets, slot, len(index.keys))
}

pub fn name_index_insert_first(index: NameIndex, name: String, value: i32) {
    name_index_grow_if_needed(index)
    let slot = name_index_find_slot(index, clone(name))
    if slot < 0 || get_unchecked(index.buckets, slot) != 0 {
        return
    }
    name_index_push_entry(index, slot, name, value)
}

pub fn name_index_set(index: NameIndex, name: String, value: i32) {
    name_index_grow_if_needed(index)
    let slot = name_index_find_slot(index, clone(name))
    if slot < 0 {
        return
    }
    let bucket = get_unchecked(index.buckets, slot)
    if bucket == 0 {
        name_index_push_entry(index, slot, name, value)
        return
    }
    set(index.values, bucket - 1, value)
}

pub fn name_index_increment(index: NameIndex, name: String) {
    name_index_grow_if_needed(index)
    let slot = name_index_find_slot(index, clone(name))
    if slot < 0 {
        return
    }
    let bucket = get_unchecked(index.buckets, slot)
    if bucket == 0 {
        name_index_push_entry(index, slot, name, 1)
        return
    }
    let current = get_unchecked(index.values, bucket - 1)
    set(index.values, bucket - 1, current + 1)
}
