//
// Replaces manual `while i < len(src) { push(dst, get_unchecked(src, i)); i = i + 1 }`
// boilerplate with a single call. Monomorphized per element type because

use diagnostics::record
use mir::inst_record
use parser::ast_node_record
use typechecker::contract_enum_info
use typechecker::contract_fn_sig
use typechecker::contract_mono

// ── Primitive element types (no clone needed) ──────────────────────────

pub fn Vec_extend_i32(mut dst: Vec<i32>, src: Vec<i32>) {
    let n = src.len()
    let mut i = 0
    while i < n {
        dst.push(get_unchecked(src, i))
        i = i + 1
    }
}

pub fn Vec_extend_String(mut dst: Vec<String>, src: Vec<String>) {
    let n = src.len()
    let mut i = 0
    while i < n {
        dst.push(get_unchecked(src, i))
        i = i + 1
    }
}

// ── String variant with clone (for ownership transfer) ─────────────────

pub fn Vec_extend_String_clone(mut dst: Vec<String>, src: Vec<String>) {
    let n = src.len()
    let mut i = 0
    while i < n {
        dst.push(get_unchecked(src, i).clone())
        i = i + 1
    }
}

