pub fn is_contextual_keyword(word: String) -> bool {
    word.clone().eq("test") ||
    word.clone().eq("move") ||
    word.clone().eq("dyn") ||
    word.clone().eq("type") ||
    word.clone().eq("mod")
}

pub fn is_future_reserved_keyword(word: String) -> bool {
    word.clone().eq("await") ||
    word.clone().eq("unsafe") ||
    word.clone().eq("extern") ||
    word.clone().eq("super")
}

test mod "keyword_policy" {
    test "contextual keywords remain identifiers outside their grammar positions" {
        assert(is_contextual_keyword("test"))
        assert(is_contextual_keyword("move"))
        assert(is_contextual_keyword("dyn"))
        assert(is_contextual_keyword("type"))
        assert(is_contextual_keyword("mod"))
    }

    test "future reserved keywords stay unavailable before implementation" {
        assert(is_future_reserved_keyword("await"))
        assert(is_future_reserved_keyword("unsafe"))
        assert(is_future_reserved_keyword("extern"))
        assert(is_future_reserved_keyword("super"))
    }
}
