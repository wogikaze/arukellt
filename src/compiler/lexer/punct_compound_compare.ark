use lexer::tokens
use lexer::cursor
use lexer::punct_compound_peek

fn lex_compare_or_shift_punct(lex: Lexer, start: i32, c: i32) -> Token {
    if c == 60 {
        if punct_compound_peek::punct_peek(lex) == 61 {
            cursor::advance_by(lex, 1)
            return Token_new(tokens::TK_LTEQ(), "<=", start, cursor::lexer_position(lex))
        }
        if punct_compound_peek::punct_peek(lex) == 60 {
            cursor::advance_by(lex, 1)
            return Token_new(tokens::TK_SHL(), "<<", start, cursor::lexer_position(lex))
        }
        return Token_new(tokens::TK_LT(), "<", start, cursor::lexer_position(lex))
    }
    if punct_compound_peek::punct_peek(lex) == 61 {
        cursor::advance_by(lex, 1)
        return Token_new(tokens::TK_GTEQ(), ">=", start, cursor::lexer_position(lex))
    }
    if punct_compound_peek::punct_peek(lex) == 62 {
        cursor::advance_by(lex, 1)
        return Token_new(tokens::TK_SHR(), ">>", start, cursor::lexer_position(lex))
    }
    Token_new(tokens::TK_GT(), ">", start, cursor::lexer_position(lex))
}
