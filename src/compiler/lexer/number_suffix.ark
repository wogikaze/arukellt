use lexer::char_class

// Integer type suffixes: i8/u8 (2 chars), i16/i32/i64/u16/u32/u64 (3 chars).
// Float suffixes: f32/f64 (3 chars).
// The match must validate every suffix byte: an earlier version treated
// any 3-char run starting with "i"/"u" as a suffix, so "255u8" followed
// by a newline (or "+", ")", ",") silently ate the next byte into the
// token — destroying statement boundaries and operators.

fn is_int_suffix_3(c0: i32, c1: i32, c2: i32) -> bool {
    (c0 == 105 || c0 == 117) &&
    (c1 == 49 && c2 == 54 || c1 == 51 && c2 == 50 || c1 == 54 && c2 == 52)
}

fn is_float_suffix_3(c0: i32, c1: i32, c2: i32) -> bool {
    c0 == 102 && (c1 == 51 && c2 == 50 || c1 == 54 && c2 == 52)
}

fn is_int_suffix_2(c0: i32, c1: i32) -> bool {
    (c0 == 105 || c0 == 117) && c1 == 56
}

fn suffix_end_ok(lex: Lexer, end: i32) -> bool {
    if end >= lex.src_len {
        return true
    }
    let cn = lex.src.byte_at(end)
    !char_class::is_alnum(cn) && cn != 95
}

fn try_eat_type_suffix(mut lex: Lexer) -> i32 {
    if lex.pos + 3 <= lex.src_len {
        let c0 = lex.src.byte_at(lex.pos)
        let c1 = lex.src.byte_at(lex.pos + 1)
        let c2 = lex.src.byte_at(lex.pos + 2)
        if (is_int_suffix_3(c0, c1, c2) || is_float_suffix_3(c0, c1, c2)) &&
        suffix_end_ok(lex, lex.pos + 3) {
            lex.pos = lex.pos + 3
            return 3
        }
    }
    if lex.pos + 2 <= lex.src_len {
        let c0 = lex.src.byte_at(lex.pos)
        let c1 = lex.src.byte_at(lex.pos + 1)
        if is_int_suffix_2(c0, c1) && suffix_end_ok(lex, lex.pos + 2) {
            lex.pos = lex.pos + 2
            return 2
        }
    }
    0
}
