use lexer::tokens
pub fn keyword_kind_decl(word: String) -> i32 {
    if word.eq("fn") {
        return tokens::TK_FN()
    }
    if word.eq("struct") {
        return tokens::TK_STRUCT()
    }
    if word.eq("enum") {
        return tokens::TK_ENUM()
    }
    if word.eq("let") {
        return tokens::TK_LET()
    }
    if word.eq("mut") {
        return tokens::TK_MUT()
    }
    if word.eq("trait") {
        return tokens::TK_TRAIT()
    }
    if word.eq("impl") {
        return tokens::TK_IMPL()
    }
    if word.eq("const") {
        return tokens::TK_CONST()
    }
    if word.eq("proof") {
        return tokens::TK_PROOF()
    }
    if word.eq("export") {
        return tokens::TK_EXPORT()
    }
    if word.eq("resource") {
        return tokens::TK_RESOURCE()
    }
    if word.eq("async") {
        return tokens::TK_ASYNC()
    }
    if word.eq("Self") {
        return tokens::TK_SELF()
    }
    0 - 1
}
