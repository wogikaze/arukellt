use lexer::tokens
use lexer::cursor

fn lex_single_punct_or_error(lex: Lexer, start: i32, c: i32) -> Token {
    let end = cursor::lexer_position(lex)
    if c == 43 {
        return Token_new(tokens::TK_PLUS(), "+", start, end)
    }
    if c == 42 {
        return Token_new(tokens::TK_STAR(), "*", start, end)
    }
    if c == 47 {
        return Token_new(tokens::TK_SLASH(), "/", start, end)
    }
    if c == 37 {
        return Token_new(tokens::TK_PERCENT(), "%", start, end)
    }
    if c == 94 {
        return Token_new(tokens::TK_CARET(), "^", start, end)
    }
    if c == 126 {
        return Token_new(tokens::TK_TILDE(), "~", start, end)
    }
    if c == 40 {
        return Token_new(tokens::TK_LPAREN(), "(", start, end)
    }
    if c == 41 {
        return Token_new(tokens::TK_RPAREN(), ")", start, end)
    }
    if c == 123 {
        return Token_new(tokens::TK_LBRACE(), "{", start, end)
    }
    if c == 125 {
        return Token_new(tokens::TK_RBRACE(), "}", start, end)
    }
    if c == 91 {
        return Token_new(tokens::TK_LBRACKET(), "[", start, end)
    }
    if c == 93 {
        return Token_new(tokens::TK_RBRACKET(), "]", start, end)
    }
    if c == 44 {
        return Token_new(tokens::TK_COMMA(), ",", start, end)
    }
    if c == 59 {
        return Token_new(tokens::TK_SEMI(), ";", start, end)
    }
    if c == 63 {
        return Token_new(tokens::TK_QUESTION(), "?", start, end)
    }
    Token_new(tokens::TK_ERROR(), cursor::lexer_slice(lex, start, end), start, end)
}
