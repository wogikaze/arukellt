use std::host::stdio
use std::text
use lexer::tokens
use lexer::names
use lexer::scan
use lexer::token_state
fn print_token_fields(kind: i32, text: String, int_val: i32, float_val: f64) {
    let kind_str = names::token_kind_name(kind)
    if kind == tokens::TK_IDENT() || kind == tokens::TK_STRING() || kind == tokens::TK_ERROR() || kind == tokens::TK_RESERVED() {
        stdio::println((kind_str.concat("(")).concat(text).concat(")"))
        return
    }
    if kind == tokens::TK_INT() {
        stdio::println((kind_str.concat("(")).concat((int_val).to_string()).concat(")"))
        return
    }
    if kind == tokens::TK_FLOAT() {
        stdio::println((kind_str.concat("(")).concat((float_val).to_string()).concat(")"))
        return
    }
    if kind == tokens::TK_BOOL() {
        stdio::println((kind_str.concat("(")).concat(text).concat(")"))
        return
    }
    if kind == tokens::TK_NEWLINE() {
        return
    }
    stdio::println(kind_str)
}

fn main() {
    let source = "fn main() {\n    let x: i32 = 42\n    stdio::println(i32_to_string(x))\n}\n"
    let tokens = scan::tokenize(source)
    let mut i = 0
    let mut done = false
    while !done {
        let tok = get_unchecked(tokens, i)
        let kind = token_state::Token_kind(tok)
        print_token_fields(kind, token_state::Token_text(tok), token_state::Token_int_val(tok), token_state::Token_float_val(tok))
        if kind == tokens::TK_EOF() {
            done = true
        }
        i = i + 1
    }
    stdio::println("Done.")
}
