use mir::types
use mir_opt::licm_predicates
use mir_opt::loop_regions
use mir_opt::translation_validation

fn licm_translation_valid(before: Vec<MirInst>, after: Vec<MirInst>, region: LoopRegion, claimed_hoisted: i32) -> bool {
    if len(before) != len(after) || claimed_hoisted < 0 {
        return false
    }
    if claimed_hoisted == 0 {
        return translation_validation::mir_translation_vector_equal(before, after)
    }
    let start = loop_regions::LoopRegion_loop_start(region)
    let end = loop_regions::LoopRegion_loop_end(region)
    if start < 0 || end <= start || end >= len(before) {
        return false
    }
    let marker_after = start + claimed_hoisted
    if marker_after >= len(after) {
        return false
    }
    let mut i = 0
    while i < start {
        if !translation_validation::mir_translation_inst_equal(get_unchecked(before, i), get_unchecked(after, i)) {
            return false
        }
        i = i + 1
    }
    if !translation_validation::mir_translation_inst_equal(get_unchecked(before, start), get_unchecked(after, marker_after)) {
        return false
    }
    let modified = licm_predicates::licm_collect_loop_modified(before, start, end)
    let selected = Vec::new<i32>()
    let mut search_from = start + 1
    let mut hi = 0
    while hi < claimed_hoisted {
        let candidate = get_unchecked(after, start + hi)
        let mut found = 0 - 1
        let mut source_i = search_from
        while source_i < end {
            let original = get_unchecked(before, source_i)
            if translation_validation::mir_translation_inst_equal(original, candidate) &&
            licm_predicates::licm_is_hoistable_inst(original) &&
            !licm_predicates::licm_inst_depends_on_any(original, modified) {
                found = source_i
                source_i = end
                continue
            }
            source_i = source_i + 1
        }
        if found < 0 {
            return false
        }
        push(selected, found)
        search_from = found + 1
        hi = hi + 1
    }
    let mut before_i = start
    let mut after_i = marker_after
    let mut selected_i = 0
    while before_i < len(before) {
        if selected_i < len(selected) && before_i == get_unchecked(selected, selected_i) {
            selected_i = selected_i + 1
            before_i = before_i + 1
            continue
        }
        if after_i >= len(after) ||
        !translation_validation::mir_translation_inst_equal(get_unchecked(before, before_i), get_unchecked(after, after_i)) {
            return false
        }
        before_i = before_i + 1
        after_i = after_i + 1
    }
    selected_i == len(selected) && after_i == len(after)
}
