//
// Every enabled optimizer transformation is guarded by an independent
// fail-closed translation validator. stdlib call expansion remains disabled;
// normal-call target resolution is separately validated before adoption.
//
// The wasm32-gc path gates loop_unroll and licm until they are independently
// verified GC-safe. gc_hint is enabled on all targets.

use std::prelude::{clone}
use mir::emit_artifacts
use mir::module_emit_artifacts
use mir::module_functions
use mir::types
use mir_opt::async_lower
use mir_opt::gc_hint
use mir_opt::licm
use mir_opt::loop_unroll
use mir_opt::stdlib_resolve_validated
use mir_opt::target_gate
fn mir_opt_optimize_module(m: MirModule, opt_level: i32, target: String) -> MirModule {
    // #851 Phase 3: with fused in-loop emit the per-fn passes already ran in
    // the lowering drain and the emitted bytes are stored on the module's
    // artifacts — re-running opt here would mutate MIR after its emit.
    if emit_artifacts::MirEmitArtifacts_opt_done(module_emit_artifacts::MirModule_emit_artifacts(m)) {
        return m
    }
    let m = async_lower::async_lower_optimize_module(m)
    // stdlib call expansion is intentionally disabled until an independent
    // expansion validator exists. Call-target normalization is enabled only
    // through the validated wrapper.
    stdlib_resolve_validated::stdlib_resolve_normal_calls_validated(m)
    if opt_level < 2 {
        return m
    }
    let t3 = target_gate::mir_opt_is_t3_target(clone(target))
    let fn_count = module_functions::MirModule_function_count(m)
    let updated = Vec::new<MirFunction>()
    let mut fi = 0
    while fi < fn_count {
        let f = module_functions::MirModule_function_at(m, fi)
        if !t3 {
            loop_unroll::run_loop_unroll(f)
            licm::run_licm(f)
        }
        gc_hint::run_gc_hint(f)
        push(updated, f)
        fi = fi + 1
    }
    module_functions::MirModule_set_functions(m, updated)
    m
}

// Per-fn composition for the fused in-loop emit drain (#851 Phase 3):
// same pass order as mir_opt_optimize_module (async lower -> validated
// stdlib resolve -> O2 loop/gc passes) applied to one function. All passes
// are function-local, so composing them per-fn is equivalent.
fn mir_opt_optimize_fn(m: MirModule, f: MirFunction, opt_level: i32, target: String) -> MirFunction {
    let f = async_lower::async_lower_fn(f)
    stdlib_resolve_validated::stdlib_resolve_fn_validated(m, f)
    if opt_level >= 2 {
        if !target_gate::mir_opt_is_t3_target(clone(target)) {
            loop_unroll::run_loop_unroll(f)
            licm::run_licm(f)
        }
        gc_hint::run_gc_hint(f)
    }
    f
}
