pub struct OptimizationSummary {
    licm_hoisted: i32,
    gc_hinted: i32,
    loop_unrolled: i32,
    translation_validation_failures: i32,
}

fn OptimizationSummary_new() -> OptimizationSummary {
    OptimizationSummary {
        licm_hoisted: 0,
        gc_hinted: 0,
        loop_unrolled: 0,
        translation_validation_failures: 0,
    }
}

fn OptimizationSummary_licm_hoisted(s: OptimizationSummary) -> i32 {
    s.licm_hoisted
}

fn OptimizationSummary_gc_hinted(s: OptimizationSummary) -> i32 {
    s.gc_hinted
}

fn OptimizationSummary_translation_validation_failures(s: OptimizationSummary) -> i32 {
    s.translation_validation_failures
}

fn OptimizationSummary_add_licm(s: OptimizationSummary, n: i32) -> OptimizationSummary {
    OptimizationSummary {
        licm_hoisted: s.licm_hoisted + n,
        gc_hinted: s.gc_hinted,
        loop_unrolled: s.loop_unrolled,
        translation_validation_failures: s.translation_validation_failures,
    }
}

fn OptimizationSummary_add_gc_hint(s: OptimizationSummary, n: i32) -> OptimizationSummary {
    OptimizationSummary {
        licm_hoisted: s.licm_hoisted,
        gc_hinted: s.gc_hinted + n,
        loop_unrolled: s.loop_unrolled,
        translation_validation_failures: s.translation_validation_failures,
    }
}

fn OptimizationSummary_add_loop_unroll(s: OptimizationSummary, n: i32) -> OptimizationSummary {
    OptimizationSummary {
        licm_hoisted: s.licm_hoisted,
        gc_hinted: s.gc_hinted,
        loop_unrolled: s.loop_unrolled + n,
        translation_validation_failures: s.translation_validation_failures,
    }
}

fn OptimizationSummary_add_translation_validation_failure(s: OptimizationSummary, n: i32) -> OptimizationSummary {
    OptimizationSummary {
        licm_hoisted: s.licm_hoisted,
        gc_hinted: s.gc_hinted,
        loop_unrolled: s.loop_unrolled,
        translation_validation_failures: s.translation_validation_failures + n,
    }
}

fn OptimizationSummary_merge(a: OptimizationSummary, b: OptimizationSummary) -> OptimizationSummary {
    OptimizationSummary {
        licm_hoisted: a.licm_hoisted + b.licm_hoisted,
        gc_hinted: a.gc_hinted + b.gc_hinted,
        loop_unrolled: a.loop_unrolled + b.loop_unrolled,
        translation_validation_failures: a.translation_validation_failures + b.translation_validation_failures,
    }
}
