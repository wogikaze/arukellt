use mir::inst_accessors_operands
use mir::inst_accessors_shape
use mir::inst_factory
use mir::opcodes
use mir::types
use mir::value_types
use mir_opt::translation_validation

fn async_lower_expected_instruction(inst: MirInst) -> MirInst {
    let op = inst_accessors_shape::MirInst_op(inst)
    if op == opcodes::MIR_AWAIT() || op == opcodes::MIR_FUTURE_NEW() {
        return inst_factory::MirInst_full(
            opcodes::MIR_LOCAL_SET(),
            0 - 1,
            inst_accessors_operands::MirInst_dest(inst),
            inst_accessors_operands::MirInst_arg0(inst),
            0,
            0.0,
            String_new(),
            value_types::VT_VOID()
        )
    }
    inst
}

fn async_lower_translation_valid(before: Vec<MirInst>, after: Vec<MirInst>) -> bool {
    if len(before) != len(after) {
        return false
    }
    let mut i = 0
    while i < len(before) {
        let expected = async_lower_expected_instruction(get_unchecked(before, i))
        if !translation_validation::mir_translation_inst_equal(
            expected,
            get_unchecked(after, i)
        ) {
            return false
        }
        i = i + 1
    }
    true
}
