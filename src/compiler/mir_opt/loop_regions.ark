use mir::inst_accessors_shape
use mir::inst_draft
use mir::opcodes
use mir::types

pub struct LoopRegion {
    loop_start: i32,
    loop_end: i32,
    depth: i32,
}

fn LoopRegion_new(loop_start: i32, loop_end: i32, depth: i32) -> LoopRegion {
    LoopRegion { loop_start: loop_start, loop_end: loop_end, depth: depth }
}

fn LoopRegion_loop_start(r: LoopRegion) -> i32 {
    r.loop_start
}

fn LoopRegion_loop_end(r: LoopRegion) -> i32 {
    r.loop_end
}

fn LoopRegion_depth(r: LoopRegion) -> i32 {
    r.depth
}

fn mir_opt_collect_loop_regions(insts: Vec<MirInst>) -> Vec<LoopRegion> {
    let mut regions = Vec::new<LoopRegion>()
    let mut stack = Vec::new<i32>()
    let mut depths = Vec::new<i32>()
    let count = insts.len()
    let mut i = 0
    while i < count {
        let inst = insts.get_unchecked(i)
        let op = inst_accessors_shape::MirInst_op(inst)
        if op == opcodes::MIR_LOOP() {
            push(stack, i)
            push(depths, stack.len())
        }
        if op == opcodes::MIR_END() {
            if stack.len() > 0 {
                let start = match pop(stack) {
                    Some(value) => value,
                    None => return regions,
                }
                let depth = match pop(depths) {
                    Some(value) => value,
                    None => return regions,
                }
                push(regions, LoopRegion_new(start, i, depth))
            }
        }
        i = i + 1
    }
    regions
}

fn mir_opt_collect_loop_regions_draft(insts: Vec<MirInstDraft>) -> Vec<LoopRegion> {
    let mut regions = Vec::new<LoopRegion>()
    let mut stack = Vec::new<i32>()
    let mut depths = Vec::new<i32>()
    let count = insts.len()
    let mut i = 0
    while i < count {
        let inst = insts.get_unchecked(i)
        let op = inst_draft::MirInstDraft_op(inst)
        if op == opcodes::MIR_LOOP() {
            push(stack, i)
            push(depths, stack.len())
        }
        if op == opcodes::MIR_END() {
            if stack.len() > 0 {
                let start = match pop(stack) {
                    Some(value) => value,
                    None => return regions,
                }
                let depth = match pop(depths) {
                    Some(value) => value,
                    None => return regions,
                }
                push(regions, LoopRegion_new(start, i, depth))
            }
        }
        i = i + 1
    }
    regions
}

fn mir_opt_pick_innermost(regions: Vec<LoopRegion>) -> Vec<LoopRegion> {
    let mut max_depth = 0
    for ri in 0..regions.len() {
        let d = LoopRegion_depth(regions.get_unchecked(ri))
        if d > max_depth {
            max_depth = d
        }
    }
    let mut out = Vec::new<LoopRegion>()
    for ri in 0..regions.len() {
        let r = regions.get_unchecked(ri)
        if LoopRegion_depth(r) == max_depth {
            push(out, r)
        }
    }
    out
}

fn mir_opt_regions_by_depth_desc(regions: Vec<LoopRegion>) -> Vec<LoopRegion> {
    let mut out = Vec::new<LoopRegion>()
    let mut max_depth = 0
    for ri in 0..regions.len() {
        let d = LoopRegion_depth(regions.get_unchecked(ri))
        if d > max_depth {
            max_depth = d
        }
    }
    while max_depth > 0 {
        for ri in 0..regions.len() {
            let r = regions.get_unchecked(ri)
            if LoopRegion_depth(r) == max_depth {
                push(out, r)
            }
        }
        max_depth = max_depth - 1
    }
    out
}
