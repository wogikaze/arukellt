use std::host::stdio::Stdio
use std::text
use main::args_parse_flags
use main::args_parse_opts
use main::args_parse_opts_cache
use main::args_parse_opts_lint
use main::args_record
use main::commands
use main::kinds
use main::target_contract_generated
fn parse_args(argv: Vec<String>) -> CliOptions {
    let mut opts = args_record::CliOptions_default()
    let argc = len(argv)
    if argc <= 1 {
        args_record::cli_set_show_help(opts, true)
        return opts
    }
    parse_initial_command(argv, opts)
    if args_record::cli_show_help(opts) || args_record::cli_show_version(opts) {
        return opts
    }
    parse_component_subcommand(argv, argc, opts)
    if args_record::cli_command(opts) == kinds::CMD_COMPOSE() {
        parse_compose_args(argv, argc, opts)
        return opts
    }
    parse_option_args(argv, argc, opts, component_option_start(argv, argc, opts))
    canonicalize_target_input(opts)
    validate_target_configuration(opts)
    opts
}

fn canonicalize_target_input(mut opts: CliOptions) {
    let input = args_record::cli_target(opts)
    let policy = target_contract_generated::target_alias_policy(input.clone())
    if policy.clone().eq("error") {
        args_record::cli_set_error(opts, target_contract_generated::target_alias_message(input))
        return
    }
    if policy.clone().eq("warning") {
        Stdio::eprintln(target_contract_generated::target_alias_message(input.clone()))
        args_record::cli_set_target(opts, target_contract_generated::target_alias_canonical_target(input.clone()))
        if !args_record::cli_has_wasi_version(opts) {
            args_record::cli_set_wasi_version(opts, target_contract_generated::target_alias_host_profile(input))
        }
        return
    }
    if !target_contract_generated::target_is_canonical(input.clone()) {
        args_record::cli_set_error(opts, "unknown target: ".concat(input))
        return
    }
    if !args_record::cli_has_wasi_version(opts) {
        args_record::cli_set_wasi_version(opts, target_contract_generated::target_default_host_profile(input))
    }
}

fn validate_target_configuration(mut opts: CliOptions) {
    if args_record::cli_has_error(opts) {
        return
    }
    let is_component_build = args_record::cli_command(opts) == kinds::CMD_COMPONENT() &&
    args_record::cli_component_action(opts) == kinds::COMP_ACTION_BUILD()
    let target = if is_component_build { String_from("wasm32-gc") } else { args_record::cli_target(opts) }
    let host = if is_component_build { String_from("wasi-p2") } else { args_record::cli_wasi_version(opts) }
    if len(host.clone()) > 0 && !target_contract_generated::target_allows_host_profile(target.clone(), host.clone()) {
        args_record::cli_set_error(
            opts,
            "target `".concat(target.clone().concat("` does not support host profile `".concat(host.clone().concat("`"))))
        )
        return
    }
    let emit_mode = if is_component_build { String_from("component") } else { args_record::cli_emit_mode(opts) }
    if !target_contract_generated::target_allows_emit_kind(target.clone(), emit_mode.clone()) {
        args_record::cli_set_error(
            opts,
            "target `".concat(
                target.clone().concat("` does not support emit `".concat(emit_mode.clone().concat("`; allowed: ".concat(target_contract_generated::target_allowed_emit_kinds_message(target.clone())))))
            )
        )
        return
    }
    let requested_width = args_record::cli_memory_width(opts)
    if !requested_width.clone().eq(String_from("auto")) &&
    !target_contract_generated::target_allows_memory_width(target.clone(), requested_width.clone()) {
        args_record::cli_set_error(
            opts,
            "target `".concat(
                target.clone().concat(
                    "` does not support memory width `".concat(requested_width.clone().concat("`; allowed: ".concat(target_contract_generated::target_allowed_memory_widths_message(target.clone()))))
                )
            )
        )
        return
    }
    if (emit_mode.clone().eq(String_from("component")) || emit_mode.clone().eq(String_from("all"))) &&
    requested_width.clone().eq(String_from("memory64")) {
        args_record::cli_set_error(opts, String_from("component emission requires memory32; use --memory-width memory32 or auto"))
        return
    }
    if emit_mode.clone().eq(String_from("wat")) && requested_width.clone().eq(String_from("memory64")) {
        args_record::cli_set_error(opts, String_from("wat emission requires memory32; use --memory-width memory32 or auto"))
    }
}

fn parse_initial_command(argv: Vec<String>, mut opts: CliOptions) {
    let cmd_str = get_unchecked(argv, 1)
    let cmd_is_check = arg_is_check_command(cmd_str.clone())
    let cmd_is_compile = arg_is_compile_command(cmd_str.clone())
    if arg_is_help(cmd_str.clone()) {
        args_record::cli_set_show_help(opts, true)
        return
    }
    if arg_is_version(cmd_str.clone()) {
        args_record::cli_set_show_version(opts, true)
        return
    }
    args_record::cli_set_command(opts, commands::parse_command(cmd_str.clone()))
    if cmd_is_check {
        args_record::cli_set_command(opts, kinds::CMD_CHECK())
    }
    if cmd_is_compile {
        args_record::cli_set_command(opts, kinds::CMD_COMPILE())
    }
    if args_record::cli_command(opts) == kinds::CMD_HELP() {
        args_record::cli_set_show_help(opts, true)
        return
    }
    if args_record::cli_command(opts) == kinds::CMD_VERSION() {
        args_record::cli_set_show_version(opts, true)
        return
    }
    if args_record::cli_command(opts) == kinds::CMD_UNKNOWN() {
        args_record::cli_set_command(opts, kinds::CMD_COMPILE())
        args_record::cli_set_input_file(opts, cmd_str.clone())
    }
}

fn arg_is_check_command(arg: String) -> bool {
    if len(arg.clone()) != 5 {
        return false
    }
    arg.clone().byte_at(0) == 99 && arg.clone().byte_at(1) == 104 && arg.clone().byte_at(2) == 101 && arg.clone().byte_at(3) == 99 && arg.clone().byte_at(4) == 107
}

fn arg_is_compile_command(arg: String) -> bool {
    if len(arg.clone()) != 7 {
        return false
    }
    arg.clone().byte_at(0) == 99 &&
    arg.clone().byte_at(1) == 111 &&
    arg.clone().byte_at(2) == 109 &&
    arg.clone().byte_at(3) == 112 &&
    arg.clone().byte_at(4) == 105 &&
    arg.clone().byte_at(5) == 108 &&
    arg.clone().byte_at(6) == 101
}

fn arg_is_help(arg: String) -> bool {
    if len(arg.clone()) == 6 &&
    arg.clone().byte_at(0) == 45 &&
    arg.clone().byte_at(1) == 45 &&
    arg.clone().byte_at(2) == 104 &&
    arg.clone().byte_at(3) == 101 &&
    arg.clone().byte_at(4) == 108 &&
    arg.clone().byte_at(5) == 112 {
        return true
    }
    len(arg.clone()) == 2 && arg.clone().byte_at(0) == 45 && arg.clone().byte_at(1) == 104
}

fn parse_component_subcommand(argv: Vec<String>, argc: i32, mut opts: CliOptions) {
    if args_record::cli_command(opts) != kinds::CMD_COMPONENT() {
        return
    }
    if argc <= 2 {
        return
    }
    let sub = get_unchecked(argv, 2)
    if commands::cli_str_eq(sub.clone(), "inspect") {
        args_record::cli_set_component_action(opts, kinds::COMP_ACTION_INSPECT())
        return
    }
    if commands::cli_str_eq(sub.clone(), "validate") {
        args_record::cli_set_component_action(opts, kinds::COMP_ACTION_VALIDATE())
    }
}

fn component_option_start(argv: Vec<String>, argc: i32, opts: CliOptions) -> i32 {
    if args_record::cli_command(opts) != kinds::CMD_COMPONENT() || argc <= 2 {
        return 2
    }
    let sub = get_unchecked(argv, 2)
    if commands::cli_str_eq(sub.clone(), "build") || args_record::cli_component_action(opts) != kinds::COMP_ACTION_BUILD() {
        return 3
    }
    2
}

fn parse_compose_args(argv: Vec<String>, argc: i32, mut opts: CliOptions) {
    let mut i = 2
    while i < argc {
        let arg = get_unchecked(argv, i)
        if commands::cli_str_eq(arg.clone(), "--validate") {
            args_record::cli_set_compose_validate_only(opts, true)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--plug") {
            if i + 2 >= argc {
                args_record::cli_set_error(opts, "--plug requires <provider> and <socket> paths")
                return
            }
            args_record::cli_set_compose_plug(opts, get_unchecked(argv, i + 1))
            args_record::cli_set_compose_socket(opts, get_unchecked(argv, i + 2))
            i = i + 3
            continue
        }
        if commands::cli_str_eq(arg.clone(), "-o") || commands::cli_str_eq(arg.clone(), "--output") {
            if i + 1 >= argc {
                args_record::cli_set_error(opts, "-o requires an output path")
                return
            }
            args_record::cli_set_output_file(opts, get_unchecked(argv, i + 1))
            i = i + 2
            continue
        }
        args_record::cli_set_error(opts, "unknown compose option: ".concat(arg))
        return
    }
}

fn arg_is_version(arg: String) -> bool {
    if len(arg.clone()) == 9 &&
    arg.clone().byte_at(0) == 45 &&
    arg.clone().byte_at(1) == 45 &&
    arg.clone().byte_at(2) == 118 &&
    arg.clone().byte_at(3) == 101 &&
    arg.clone().byte_at(4) == 114 &&
    arg.clone().byte_at(5) == 115 &&
    arg.clone().byte_at(6) == 105 &&
    arg.clone().byte_at(7) == 111 &&
    arg.clone().byte_at(8) == 110 {
        return true
    }
    len(arg.clone()) == 2 && arg.clone().byte_at(0) == 45 && arg.clone().byte_at(1) == 86
}

fn parse_option_args(argv: Vec<String>, argc: i32, mut opts: CliOptions, start_index: i32) {
    let mut i = start_index
    while i < argc {
        let arg = get_unchecked(argv, i)
        if commands::cli_str_eq(arg.clone(), "--target") {
            i = args_parse_opts::parse_target_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--memory-width") {
            i = args_parse_opts::parse_memory_width_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--wasi-version") {
            i = args_parse_opts::parse_wasi_version_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--opt-level") {
            i = args_parse_opts::parse_opt_level_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--world") {
            i = parse_world_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--emit") {
            i = args_parse_opts::parse_emit_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--wit") {
            i = args_parse_opts::parse_wit_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "-o") || commands::cli_str_eq(arg.clone(), "--output") {
            i = args_parse_opts::parse_output_option(argv, argc, opts, arg, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--dump-phases") {
            i = args_parse_opts::parse_dump_phases_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--template") {
            i = args_parse_opts::parse_template_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--cache-dir") {
            i = args_parse_opts_cache::parse_cache_dir_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--allow") {
            i = args_parse_opts_lint::parse_lint_allow_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if commands::cli_str_eq(arg.clone(), "--deny") {
            i = args_parse_opts_lint::parse_lint_deny_option(argv, argc, opts, i)
            i = i + 1
            continue
        }
        if !args_parse_flags::parse_flag_option(opts, arg) {
            parse_input_or_error(opts, arg)
        }
        i = i + 1
    }
}

fn parse_world_option(argv: Vec<String>, argc: i32, mut opts: CliOptions, i: i32) -> i32 {
    let next = i + 1
    if next < argc {
        args_record::cli_set_world(opts, get_unchecked(argv, next).clone())
    } else {
        args_record::cli_set_error(opts, "--world requires a world name")
    }
    next
}

fn parse_input_or_error(mut opts: CliOptions, arg: String) {
    let command = args_record::cli_command(opts)
    if command == kinds::CMD_FMT() {
        args_record::cli_add_fmt_input(opts, arg)
        return
    }
    if command == kinds::CMD_LINT() {
        args_record::cli_add_lint_input(opts, arg.clone())
        if args_record::cli_input_file_len(opts) == 0 {
            args_record::cli_set_input_file(opts, arg)
        }
        return
    }
    if args_record::cli_input_file_len(opts) == 0 {
        args_record::cli_set_input_file(opts, arg.clone())
    } else {
        args_record::cli_set_error(opts, "unexpected argument: ".concat(arg.clone()))
    }
}
