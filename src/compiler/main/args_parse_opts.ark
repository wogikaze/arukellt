use main::args_record
use main::args_record_opt
use main::commands
pub fn parse_target_option(argv: Vec<String>, argc: i32, mut opts: CliOptions, i: i32) -> i32 {
    let next = i + 1
    if next < argc {
        args_record::cli_set_target(opts, argv.get_unchecked(next).clone())
    }
    next
}

pub fn parse_memory_width_option(argv: Vec<String>, argc: i32, mut opts: CliOptions, i: i32) -> i32 {
    let next = i + 1
    if next >= argc {
        args_record::cli_set_error(opts, String_from("--memory-width requires auto, memory32, or memory64"))
        return next
    }
    let width = argv.get_unchecked(next).clone()
    if width.clone().eq(String_from("auto")) ||
    width.clone().eq(String_from("memory32")) ||
    width.clone().eq(String_from("memory64")) {
        args_record::cli_set_memory_width(opts, width)
        return next
    }
    args_record::cli_set_error(opts, String_from("--memory-width requires auto, memory32, or memory64"))
    next
}

pub fn parse_wasi_version_option(argv: Vec<String>, argc: i32, mut opts: CliOptions, i: i32) -> i32 {
    let next = i + 1
    if next < argc {
        let input = argv.get_unchecked(next).clone()
        if input.clone().eq(String_from("p1")) {
            args_record::cli_set_wasi_version(opts, String_from("wasi-p1"))
            args_record::cli_set_wasi_version_explicit(opts, true)
        } else if input.clone().eq(String_from("p2")) {
            args_record::cli_set_wasi_version(opts, String_from("wasi-p2"))
            args_record::cli_set_wasi_version_explicit(opts, true)
        } else if input.clone().eq(String_from("p3")) {
            args_record::cli_set_wasi_version(opts, String_from("wasi-p3"))
            args_record::cli_set_wasi_version_explicit(opts, true)
        } else if input.clone().eq(String_from("wasi-p1")) || input.clone().eq(String_from("wasi-p2")) || input.clone().eq(String_from("wasi-p3")) {
            args_record::cli_set_wasi_version(opts, input)
            args_record::cli_set_wasi_version_explicit(opts, true)
        } else {
            args_record::cli_set_error(opts, String_from("--wasi-version requires wasi-p1, wasi-p2, or wasi-p3"))
        }
    } else {
        args_record::cli_set_error(opts, String_from("--wasi-version requires wasi-p1, wasi-p2, or wasi-p3"))
    }
    next
}

pub fn parse_emit_option(argv: Vec<String>, argc: i32, mut opts: CliOptions, i: i32) -> i32 {
    let next = i + 1
    if next < argc {
        args_record::cli_set_emit_mode(opts, argv.get_unchecked(next).clone())
    }
    next
}

pub fn parse_dump_phases_option(argv: Vec<String>, argc: i32, mut opts: CliOptions, i: i32) -> i32 {
    let next = i + 1
    if next < argc {
        args_record::cli_set_dump_phases(opts, argv.get_unchecked(next).clone())
    }
    next
}

pub fn parse_opt_level_option(argv: Vec<String>, argc: i32, mut opts: CliOptions, i: i32) -> i32 {
    let next = i + 1
    if next < argc {
        let val = argv.get_unchecked(next)
        args_record::cli_set_opt_level(opts, args_record_opt::parse_opt_level_value(val.clone(), args_record::cli_opt_level(opts)))
    }
    next
}

pub fn parse_wit_option(argv: Vec<String>, argc: i32, mut opts: CliOptions, i: i32) -> i32 {
    let next = i + 1
    if next < argc {
        args_record::cli_add_wit_path(opts, argv.get_unchecked(next).clone())
    } else {
        args_record::cli_set_error(opts, String_from("--wit requires a path"))
    }
    next
}

pub fn parse_output_option(argv: Vec<String>, argc: i32, mut opts: CliOptions, arg: String, i: i32) -> i32 {
    let next = i + 1
    if next < argc {
        let out_arg = argv.get_unchecked(next).clone()
        if commands::cli_str_eq(arg.clone(), String_from("--output")) && commands::cli_str_eq(out_arg.clone(), String_from("json")) {
            args_record::cli_set_json_output(opts, true)
        } else {
            args_record::cli_set_output_file(opts, out_arg.clone())
        }
    }
    next
}

pub fn parse_template_option(argv: Vec<String>, argc: i32, mut opts: CliOptions, i: i32) -> i32 {
    let next = i + 1
    if next < argc {
        args_record::cli_set_init_template(opts, argv.get_unchecked(next).clone())
    } else {
        args_record::cli_set_error(opts, String_from("--template requires a template name"))
    }
    next
}
