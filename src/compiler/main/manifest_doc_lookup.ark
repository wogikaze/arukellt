use main::manifest_doc_record
fn doc_last_segment(path: String) -> String {
    let n = path.len()
    let mut i = n - 1
    while i >= 0 {
        if i + 1 < n && path.byte_at(i) == 58 && path.byte_at(i + 1) == 58 {
            return path.slice(i + 2, n)
        }
        i = i - 1
    }
    path.clone()
}

fn doc_fn_matches_name(e: DocFnEntry, name: String) -> bool {
    manifest_doc_record::DocFnEntry_name(e).eq(name.clone())
}

fn doc_fn_matches_module_name(e: DocFnEntry, module: String, name: String) -> bool {
    manifest_doc_record::DocFnEntry_name(e).eq(name.clone()) && manifest_doc_record::DocFnEntry_module(e).eq(module.clone())
}

fn doc_find_by_name(table: DocManifestTable, name: String) -> Vec<i32> {
    let mut out = Vec::new<i32>()
    let n = manifest_doc_record::DocManifestTable_function_count(table)
    let mut i = 0
    while i < n {
        let e = manifest_doc_record::DocManifestTable_function_at(table, i)
        if doc_fn_matches_name(e, name.clone()) {
            push(out, i)
        }
        i = i + 1
    }
    out
}

fn doc_find_by_module_name(table: DocManifestTable, module: String, name: String) -> Vec<i32> {
    let mut out = Vec::new<i32>()
    let n = manifest_doc_record::DocManifestTable_function_count(table)
    let mut i = 0
    while i < n {
        let e = manifest_doc_record::DocManifestTable_function_at(table, i)
        if doc_fn_matches_module_name(e, module.clone(), name.clone()) {
            push(out, i)
        }
        i = i + 1
    }
    out
}

fn doc_module_has_functions(table: DocManifestTable, module: String) -> bool {
    let n = manifest_doc_record::DocManifestTable_function_count(table)
    let mut i = 0
    while i < n {
        let e = manifest_doc_record::DocManifestTable_function_at(table, i)
        if manifest_doc_record::DocFnEntry_module(e).eq(module.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

pub fn doc_find_module(table: DocManifestTable, module: String) -> i32 {
    let n = manifest_doc_record::DocManifestTable_module_count(table)
    let mut i = 0
    while i < n {
        let m = manifest_doc_record::DocManifestTable_module_at(table, i)
        if manifest_doc_record::DocModuleEntry_name(m).eq(module.clone()) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn doc_symbol_is_module_query(symbol: String) -> bool {
    if !symbol.clone().contains("::") {
        return false
    }
    let last = doc_last_segment(symbol.clone())
    let ch = last.byte_at(0)
    ch >= 65 && ch <= 90
}

pub fn doc_resolve_query(table: DocManifestTable, symbol: String) -> DocQuery {
    let mut hits = Vec::new<i32>()
    let mut show_module = 0
    if symbol.clone().contains("::") {
        let parts = manifest_doc_record::doc_split_module_and_name(symbol.clone())
        hits = doc_find_by_module_name(table, manifest_doc_record::DocModuleNameParts_module(parts), manifest_doc_record::DocModuleNameParts_name(parts))
        if hits.len() == 0 && (doc_find_module(table, symbol.clone()) >= 0 || doc_module_has_functions(table, symbol.clone())) {
            show_module = 1
        }
    } else {
        hits = doc_find_by_name(table, symbol.clone())
        if hits.len() == 0 && (doc_find_module(table, symbol.clone()) >= 0 || doc_module_has_functions(table, symbol.clone())) {
            show_module = 1
        }
    }
    if doc_symbol_is_module_query(symbol.clone()) && hits.len() == 0 {
        show_module = 1
    }
    manifest_doc_record::DocQuery_new(hits, show_module)
}
