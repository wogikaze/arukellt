use std::text
use diagnostics::mod
use diagnostics::record
pub fn format_error_json(file: String, phase: i32, diagnostics_vec: Vec<Diagnostic>) -> String {
    let mut out = "{\"file\":\""
    out = out.concat(file.clone().concat("\",\"phase\":"))
    out = out.concat(phase.to_string().concat(",\"diagnostics\":["))
    let count = diagnostics_vec.len()
    let mut i = 0
    while i < count {
        if i > 0 {
            out = out.concat(",")
        }
        let d = diagnostics_vec.get_unchecked(i)
        out = out.concat(mod::diagnostic_to_json(d))
        i = i + 1
    }
    out = out.concat("]}")
    out
}

pub fn format_success_json(file: String, phase: i32, size: i32) -> String {
    let mut out = "{\"file\":\""
    out = out.concat(file.clone().concat("\",\"phase\":"))
    out = out.concat(phase.to_string().concat(",\"success\":true,\"output_size\":"))
    out = out.concat(size.to_string().concat("}"))
    out
}
