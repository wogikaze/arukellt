use std::text
use std::prelude::{clone, to_string}
use diagnostics::mod
use diagnostics::record
pub fn format_error_json(file: String, phase: i32, diagnostics_vec: Vec<Diagnostic>) -> String {
    let mut out = "{\"file\":\""
    out = out.concat(clone(file).concat("\",\"phase\":"))
    out = out.concat(to_string(phase).concat(",\"diagnostics\":["))
    let count = len(diagnostics_vec)
    let mut i = 0
    while i < count {
        if i > 0 {
            out = out.concat(",")
        }
        let d = get_unchecked(diagnostics_vec, i)
        out = out.concat(mod::diagnostic_to_json(d))
        i = i + 1
    }
    out = out.concat("]}")
    out
}

pub fn format_success_json(file: String, phase: i32, size: i32) -> String {
    let mut out = "{\"file\":\""
    out = out.concat(clone(file).concat("\",\"phase\":"))
    out = out.concat(to_string(phase).concat(",\"success\":true,\"output_size\":"))
    out = out.concat(to_string(size).concat("}"))
    out
}
