use std::host::fs::Fs
use std::host::process::Process
use std::host::stdio
use std::prelude::{eq}
use std::text
use compiler::session_parse
use driver::config_record
use driver::file
use driver::result_record
use main::args_record
use main::compile_core
use main::output
use parser::ast
use parser::kinds as parser_kinds
fn build_run_driver_config(opts: CliOptions) -> DriverConfig {
    let mut config = config_record::DriverConfig_default()
    compile_core::configure_target_axes(opts, config, "wasm")
    config_record::config_set_opt_level(config, args_record::cli_opt_level(opts))
    config_record::config_set_emit_mode(config, "wasm")
    config
}

fn print_run_compile_errors(input_file: String, result: CompileResult) {
    let err_count = result_record::compile_result_error_count(result)
    let mut i = 0
    while i < err_count {
        let msg = result_record::compile_result_error_message_at(result, i)
        stdio::eprintln(output::format_error(input_file.clone(), msg.clone()))
        i = i + 1
    }
}

fn exit_run_compile_error(input_file: String, result: CompileResult) {
    print_run_compile_errors(input_file, result)
    Process::exit(1)
}

fn run_output_path(opts: CliOptions, input_file: String) -> String {
    if args_record::cli_has_output_file(opts) {
        return args_record::cli_output_file(opts)
    }
    let base = input_file.clone()
    let base_len = len(base)
    if base_len > 4 {
        let ext = base.slice(base_len - 4, base_len)
        if eq(ext, ".ark") {
            return base.slice(0, base_len - 4).concat(".wasm")
        }
    }
    base.clone().concat(".wasm")
}

fn write_run_output(input_file: String, out_path: String, bytes: Vec<i32>) {
    let write_result: Result<(), String> = Fs::write_bytes(out_path.clone(), bytes)
    match write_result {
        Result::Ok(_) => {
            stdio::eprintln("compiled ".concat(input_file.clone().concat(" -> ".concat(out_path.clone()))))
            stdio::eprintln("run: execute with `wasmtime <output.wasm>`")
        },
        Result::Err(e) => {
            stdio::eprintln("error writing output: ".concat(e))
            Process::exit(1)
        },
    }
}

pub fn cmd_run(opts: CliOptions) {
    let input_file = args_record::cli_input_file(opts)
    let mut config = build_run_driver_config(opts)
    let result = file::compile_file(input_file.clone(), config)
    if !result_record::compile_result_success(result) {
        exit_run_compile_error(input_file.clone(), result)
        return
    }
    let out_path = run_output_path(opts, input_file.clone())
    write_run_output(input_file, out_path, result_record::compile_result_output_bytes(result))
}

fn build_test_driver_config(opts: CliOptions) -> DriverConfig {
    let mut config = config_record::DriverConfig_default()
    compile_core::configure_target_axes(opts, config, args_record::cli_emit_mode(opts))
    config_record::config_set_opt_level(config, args_record::cli_opt_level(opts))
    config_record::config_set_emit_mode(config, args_record::cli_emit_mode(opts))
    config_record::config_set_wit_paths(config, args_record::cli_wit_paths(opts))
    // ADR-041 Phase 2 (#719): test mode desugars `test` decls into
    // synthesized fns and emits a runnable module instead of only
    // type-checking. The wrapper executes the emitted module; a trap
    // is a failing test (fail-fast runner).
    config_record::config_set_test_mode(config, true)
    let mut allows = args_record::cli_lint_allow(opts)
    push(allows, "W0003")
    push(allows, "W0005")
    push(allows, "W0006")
    push(allows, "W0007")
    config_record::config_set_lint_allow(config, allows)
    config_record::config_set_lint_deny(config, args_record::cli_lint_deny(opts))
    config
}

fn exit_missing_test_input() {
    stdio::eprintln("test: specify .ark file(s) to test")
    stdio::eprintln("  usage: arukellt-s1 test <file.ark>")
    Process::exit(2)
}

fn exit_test_failure() {
    Process::exit(1)
}

fn print_test_start(input_file: String) {
    stdio::eprintln("testing ".concat(input_file))
}

fn print_test_fail(input_file: String, result: CompileResult) {
    stdio::println("  FAIL  ".concat(input_file.clone()))
    let err_count = result_record::compile_result_error_count(result)
    let mut i = 0
    while i < err_count {
        let msg = result_record::compile_result_error_message_at(result, i)
        stdio::eprintln("    ".concat(msg.clone()))
        i = i + 1
    }
}

pub fn cmd_test(opts: CliOptions) {
    if !args_record::cli_has_input_file(opts) {
        exit_missing_test_input()
    }
    let input_file = args_record::cli_input_file(opts)
    print_test_start(input_file.clone())
    let test_count = discover_and_print_tests(input_file.clone())
    let mut config = build_test_driver_config(opts)
    let result = file::compile_file(input_file.clone(), config)
    if !result_record::compile_result_success(result) {
        print_test_fail(input_file, result)
        exit_test_failure()
        return
    }
    if test_count == 0 {
        stdio::eprintln("test: no test declarations found")
        Process::exit(2)
    }
    let out_path = run_output_path(opts, input_file.clone())
    write_run_output(input_file, out_path, result_record::compile_result_output_bytes(result))
}

// Parses the source file and prints discovered `test` declarations.
// Returns the number of discovered tests.
fn discover_and_print_tests(input_file: String) -> i32 {
    let read_result = Fs::read_to_string(input_file.clone())
    let mut count = 0
    match read_result {
        Result::Ok(source) => {
            let decls = session_parse::session_parse_decls(source)
            count = collect_test_names(decls, String_new())
        },
        Result::Err(_) => {
        },
    }
    count
}

fn collect_test_names(decls: Vec<AstNode>, prefix: String) -> i32 {
    let n = len(decls)
    let mut count = 0
    let mut i = 0
    while i < n {
        let d = get_unchecked(decls, i)
        count = count + collect_test_name_node(d, prefix.clone())
        i = i + 1
    }
    count
}

fn collect_test_name_node(node: AstNode, prefix: String) -> i32 {
    let kind = ast::ast_node_kind(node)
    if kind == parser_kinds::NK_TEST_DECL() {
        print_test_entry(prefix, ast::ast_node_text(node))
        return 1
    }
    if kind == parser_kinds::NK_TEST_MOD() {
        let mod_name = ast::ast_node_text(node)
        let new_prefix = make_test_prefix(prefix.clone(), mod_name.clone())
        let cc = ast::ast_node_child_count(node)
        let mut count = 0
        let mut i = 0
        while i < cc {
            let inner = ast::ast_node_child_at(node, i)
            let child_count = collect_test_name_node(inner, new_prefix.clone())
            count = count + child_count
            i = i + 1
        }
        return count
    }
    0
}

fn make_test_prefix(prefix: String, name: String) -> String {
    if len(prefix.clone()) == 0 {
        return name
    }
    prefix.concat("::".concat(name))
}

fn print_test_entry(prefix: String, name: String) {
    if len(prefix.clone()) == 0 {
        stdio::eprintln("  test  ".concat(name))
        return
    }
    stdio::eprintln("  test  ".concat(prefix.concat("::".concat(name))))
}

// ADR-041 Phase 1: in-file test adoption should not fail on pre-existing stdlib lint.
