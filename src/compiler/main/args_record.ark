use std::prelude::{clone}
use main::kinds
struct CliOptions {
    command: i32,
    component_action: i32,
    input_file: String,
    output_file: String,
    target: String,
    wasi_version: String,
    // True only when the user passed `--wasi-version` (not target-inferred default).
    wasi_version_explicit: bool,
    memory_width: String,
    wit_paths: Vec<String>,
    opt_level: i32,
    dump_phases: String,
    emit_mode: String,
    json_output: bool,
    show_help: bool,
    show_version: bool,
    has_error: bool,
    error_msg: String,
    show_timing: bool,
    init_template: String,
    list_templates: bool,
    fmt_check: bool,
    fmt_fix: bool,
    fmt_inputs: Vec<String>,
    world: String,
    compose_plug: String,
    compose_socket: String,
    compose_validate_only: bool,
    lint_list: bool,
    lint_local: bool,
    lint_inputs: Vec<String>,
    lint_allow: Vec<String>,
    lint_deny: Vec<String>,
    cache_dir: String,
    strip_debug: bool,
    deny_clock: bool,
    deny_random: bool,
    deny_process: bool,
    bootstrap_shared_param_mutation: bool,
    strict_impl_binders: bool,
}

fn CliOptions_default() -> CliOptions {
    CliOptions {
        command: kinds::CMD_UNKNOWN(),
        component_action: kinds::COMP_ACTION_BUILD(),
        input_file: String_new(),
        output_file: String_new(),
        target: "wasm32-gc",
        wasi_version: String_new(),
        wasi_version_explicit: false,
        memory_width: "auto",
        wit_paths: Vec::new<String>(),
        opt_level: 0,
        dump_phases: String_new(),
        emit_mode: "wasm",
        json_output: false,
        show_help: false,
        show_version: false,
        has_error: false,
        error_msg: String_new(),
        show_timing: false,
        init_template: "minimal",
        list_templates: false,
        fmt_check: false,
        fmt_fix: false,
        fmt_inputs: Vec::new<String>(),
        world: String_new(),
        compose_plug: String_new(),
        compose_socket: String_new(),
        compose_validate_only: false,
        lint_list: false,
        lint_local: false,
        lint_inputs: Vec::new<String>(),
        lint_allow: Vec::new<String>(),
        lint_deny: Vec::new<String>(),
        cache_dir: String_new(),
        strip_debug: false,
        deny_clock: false,
        deny_random: false,
        deny_process: false,
        bootstrap_shared_param_mutation: false,
        strict_impl_binders: false,
    }
}

fn cli_command(opts: CliOptions) -> i32 { opts.command }
fn cli_component_action(opts: CliOptions) -> i32 { opts.component_action }
fn cli_show_help(opts: CliOptions) -> bool { opts.show_help }
fn cli_show_version(opts: CliOptions) -> bool { opts.show_version }
fn cli_has_error(opts: CliOptions) -> bool { opts.has_error }
fn cli_error_msg(opts: CliOptions) -> String { clone(opts.error_msg) }
fn cli_target(opts: CliOptions) -> String { clone(opts.target) }
fn cli_wasi_version(opts: CliOptions) -> String { clone(opts.wasi_version) }
fn cli_has_wasi_version(opts: CliOptions) -> bool { opts.wasi_version.len() > 0 }
fn cli_wasi_version_explicit(opts: CliOptions) -> bool { opts.wasi_version_explicit }
fn cli_memory_width(opts: CliOptions) -> String { clone(opts.memory_width) }
fn cli_wit_paths(opts: CliOptions) -> Vec<String> { opts.wit_paths }
fn cli_wit_path_count(opts: CliOptions) -> i32 { opts.wit_paths.len() }
fn cli_wit_path_at(opts: CliOptions, index: i32) -> String { clone(opts.wit_paths.get_unchecked(index)) }
fn cli_opt_level(opts: CliOptions) -> i32 { opts.opt_level }
fn cli_dump_phases(opts: CliOptions) -> String { clone(opts.dump_phases) }
fn cli_emit_mode(opts: CliOptions) -> String { clone(opts.emit_mode) }
fn cli_json_output(opts: CliOptions) -> bool { opts.json_output }
fn cli_show_timing(opts: CliOptions) -> bool { opts.show_timing }
fn cli_input_file(opts: CliOptions) -> String { clone(opts.input_file) }
fn cli_input_file_len(opts: CliOptions) -> i32 { opts.input_file.len() }
fn cli_output_file(opts: CliOptions) -> String { clone(opts.output_file) }
fn cli_output_file_len(opts: CliOptions) -> i32 { opts.output_file.len() }
fn cli_has_input_file(opts: CliOptions) -> bool { cli_input_file_len(opts) > 0 }
fn cli_has_output_file(opts: CliOptions) -> bool { cli_output_file_len(opts) > 0 }

fn cli_set_command(mut opts: CliOptions, command: i32) { opts.command = command }
fn cli_set_component_action(mut opts: CliOptions, component_action: i32) { opts.component_action = component_action }
fn cli_set_input_file(mut opts: CliOptions, input_file: String) { opts.input_file = input_file }
fn cli_set_output_file(mut opts: CliOptions, output_file: String) { opts.output_file = output_file }
fn cli_set_target(mut opts: CliOptions, target: String) { opts.target = target }
fn cli_set_wasi_version(mut opts: CliOptions, wasi_version: String) { opts.wasi_version = wasi_version }
fn cli_set_wasi_version_explicit(mut opts: CliOptions, wasi_version_explicit: bool) { opts.wasi_version_explicit = wasi_version_explicit }
fn cli_set_memory_width(mut opts: CliOptions, memory_width: String) { opts.memory_width = memory_width }
fn cli_add_wit_path(mut opts: CliOptions, wit_path: String) { opts.wit_paths.push(wit_path) }
fn cli_set_opt_level(mut opts: CliOptions, opt_level: i32) { opts.opt_level = opt_level }
fn cli_set_dump_phases(mut opts: CliOptions, dump_phases: String) { opts.dump_phases = dump_phases }
fn cli_set_emit_mode(mut opts: CliOptions, emit_mode: String) { opts.emit_mode = emit_mode }
fn cli_set_json_output(mut opts: CliOptions, json_output: bool) { opts.json_output = json_output }
fn cli_set_show_help(mut opts: CliOptions, show_help: bool) { opts.show_help = show_help }
fn cli_set_show_version(mut opts: CliOptions, show_version: bool) { opts.show_version = show_version }
fn cli_set_error(mut opts: CliOptions, error_msg: String) {
    opts.has_error = true
    opts.error_msg = error_msg
}
fn cli_set_show_timing(mut opts: CliOptions, show_timing: bool) { opts.show_timing = show_timing }
fn cli_init_template(opts: CliOptions) -> String { clone(opts.init_template) }
fn cli_list_templates(opts: CliOptions) -> bool { opts.list_templates }
fn cli_set_init_template(mut opts: CliOptions, init_template: String) { opts.init_template = init_template }
fn cli_set_list_templates(mut opts: CliOptions, list_templates: bool) { opts.list_templates = list_templates }
fn cli_fmt_check(opts: CliOptions) -> bool { opts.fmt_check }
fn cli_set_fmt_check(mut opts: CliOptions, fmt_check: bool) { opts.fmt_check = fmt_check }
fn cli_fmt_fix(opts: CliOptions) -> bool { opts.fmt_fix }
fn cli_set_fmt_fix(mut opts: CliOptions, fmt_fix: bool) { opts.fmt_fix = fmt_fix }
fn cli_fmt_input_count(opts: CliOptions) -> i32 { opts.fmt_inputs.len() }
fn cli_fmt_input_at(opts: CliOptions, index: i32) -> String { clone(opts.fmt_inputs.get_unchecked(index)) }
fn cli_add_fmt_input(mut opts: CliOptions, path: String) { opts.fmt_inputs.push(clone(path)) }
fn cli_world(opts: CliOptions) -> String { clone(opts.world) }
fn cli_has_world(opts: CliOptions) -> bool { opts.world.len() > 0 }
fn cli_set_world(mut opts: CliOptions, world: String) { opts.world = world }
fn cli_compose_plug(opts: CliOptions) -> String { clone(opts.compose_plug) }
fn cli_compose_socket(opts: CliOptions) -> String { clone(opts.compose_socket) }
fn cli_compose_validate_only(opts: CliOptions) -> bool { opts.compose_validate_only }
fn cli_set_compose_plug(mut opts: CliOptions, compose_plug: String) { opts.compose_plug = compose_plug }
fn cli_set_compose_socket(mut opts: CliOptions, compose_socket: String) { opts.compose_socket = compose_socket }
fn cli_set_compose_validate_only(mut opts: CliOptions, compose_validate_only: bool) { opts.compose_validate_only = compose_validate_only }
fn cli_lint_list(opts: CliOptions) -> bool { opts.lint_list }
fn cli_set_lint_list(mut opts: CliOptions, lint_list: bool) { opts.lint_list = lint_list }
fn cli_lint_local(opts: CliOptions) -> bool { opts.lint_local }
fn cli_lint_input_count(opts: CliOptions) -> i32 { opts.lint_inputs.len() }
fn cli_lint_input_at(opts: CliOptions, index: i32) -> String { clone(opts.lint_inputs.get_unchecked(index)) }
fn cli_add_lint_input(mut opts: CliOptions, path: String) { opts.lint_inputs.push(clone(path)) }
fn cli_set_lint_local(mut opts: CliOptions, lint_local: bool) { opts.lint_local = lint_local }
fn cli_lint_allow(opts: CliOptions) -> Vec<String> { opts.lint_allow }
fn cli_lint_allow_count(opts: CliOptions) -> i32 { opts.lint_allow.len() }
fn cli_lint_deny(opts: CliOptions) -> Vec<String> { opts.lint_deny }
fn cli_lint_deny_count(opts: CliOptions) -> i32 { opts.lint_deny.len() }
fn cli_add_lint_allow(mut opts: CliOptions, rule: String) { opts.lint_allow.push(rule) }
fn cli_add_lint_deny(mut opts: CliOptions, rule: String) { opts.lint_deny.push(rule) }
fn cli_set_lint_allow(mut opts: CliOptions, rules: Vec<String>) { opts.lint_allow = rules }
fn cli_set_lint_deny(mut opts: CliOptions, rules: Vec<String>) { opts.lint_deny = rules }
fn cli_cache_dir(opts: CliOptions) -> String { clone(opts.cache_dir) }
fn cli_has_cache_dir(opts: CliOptions) -> bool { opts.cache_dir.len() > 0 }
fn cli_set_cache_dir(mut opts: CliOptions, cache_dir: String) { opts.cache_dir = cache_dir }
fn cli_strip_debug(opts: CliOptions) -> bool { opts.strip_debug }
fn cli_set_strip_debug(mut opts: CliOptions, strip_debug: bool) { opts.strip_debug = strip_debug }
fn cli_deny_clock(opts: CliOptions) -> bool { opts.deny_clock }
fn cli_set_deny_clock(mut opts: CliOptions, deny_clock: bool) { opts.deny_clock = deny_clock }
fn cli_deny_random(opts: CliOptions) -> bool { opts.deny_random }
fn cli_set_deny_random(mut opts: CliOptions, deny_random: bool) { opts.deny_random = deny_random }
fn cli_deny_process(opts: CliOptions) -> bool { opts.deny_process }
fn cli_set_deny_process(mut opts: CliOptions, deny_process: bool) { opts.deny_process = deny_process }

fn cli_bootstrap_shared_param_mutation(opts: CliOptions) -> bool { opts.bootstrap_shared_param_mutation }
fn cli_set_bootstrap_shared_param_mutation(mut opts: CliOptions, enabled: bool) {
    opts.bootstrap_shared_param_mutation = enabled
}
fn cli_strict_impl_binders(opts: CliOptions) -> bool { opts.strict_impl_binders }
fn cli_set_strict_impl_binders(mut opts: CliOptions, enabled: bool) {
    opts.strict_impl_binders = enabled
}
