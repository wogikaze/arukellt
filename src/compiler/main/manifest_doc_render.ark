use std::host::stdio
use std::text
use std::json
use std::prelude::{eq}
use main::manifest_doc_lookup
use main::manifest_doc_record
fn doc_target_is_p1(target: String) -> bool {
    eq(target.clone(), String_from("wasm32"))
}

fn doc_target_is_p2(target: String) -> bool {
    eq(target.clone(), String_from("wasm32-gc"))
}

fn doc_target_warning(e: manifest_doc_record::DocFnEntry, filter_target: String) -> String {
    if len(filter_target) == 0 {
        return String_new()
    }
    if doc_target_is_p1(filter_target.clone()) && manifest_doc_record::DocFnEntry_avail_t1(e) == 0 {
        return String_from("Not available on ").concat(filter_target.clone())
    }
    if doc_target_is_p2(filter_target.clone()) && manifest_doc_record::DocFnEntry_avail_t3(e) == 0 {
        return String_from("Not available on ").concat(filter_target.clone())
    }
    String_new()
}

fn doc_format_signature(e: manifest_doc_record::DocFnEntry) -> String {
    let mut sig = String_from("fn ").concat(manifest_doc_record::DocFnEntry_name(e))
    sig = sig.concat(String_from("("))
    let params = manifest_doc_record::DocFnEntry_params(e)
    if len(params) > 0 {
        sig = sig.concat(params)
    }
    sig = sig.concat(String_from(") -> "))
    let ret = manifest_doc_record::DocFnEntry_returns(e)
    if len(ret) > 0 {
        sig = sig.concat(ret)
    } else {
        sig = sig.concat(String_from("()"))
    }
    sig
}

pub fn doc_print_function(e: manifest_doc_record::DocFnEntry, filter_target: String) {
    let warn = doc_target_warning(e, filter_target.clone())
    if len(warn) > 0 {
        stdio::println(String_from("warning: ").concat(warn))
    }
    stdio::println(doc_format_signature(e))
    stdio::println(String_from("  Module: ").concat(manifest_doc_record::DocFnEntry_module(e)))
    let stab = manifest_doc_record::DocFnEntry_stability(e)
    if len(stab) > 0 {
        stdio::println(String_from("  Stability: ").concat(stab))
    }
    let tgt = manifest_doc_record::DocFnEntry_target(e)
    if len(tgt) > 0 {
        stdio::println(String_from("  Supported on: ").concat(tgt))
    } else {
        if manifest_doc_record::DocFnEntry_avail_t1(e) == 1 && manifest_doc_record::DocFnEntry_avail_t3(e) == 1 {
            stdio::println(String_from("  Supported on: wasm32, wasm32-gc"))
        } else {
            if manifest_doc_record::DocFnEntry_avail_t3(e) == 1 {
                stdio::println(String_from("  Supported on: wasm32-gc"))
            }
        }
    }
    let doc = manifest_doc_record::DocFnEntry_doc(e)
    if len(doc) > 0 {
        stdio::println(String_from(""))
        stdio::println(String_from("  ").concat(doc))
    }
    let err = manifest_doc_record::DocFnEntry_errors(e)
    if len(err) > 0 {
        stdio::println(String_from(""))
        stdio::println(String_from("  Errors: ").concat(err))
    }
}

fn doc_json_string_field(out: String, key: String, value: String, comma: bool) -> String {
    let mut r = out
    if comma { r = r.concat(String_from(",")) }
    r = r.concat(String_from("\"").concat(key.clone()).concat(String_from("\":\"")).concat(json::JsonText::escape(value).concat(String_from("\""))))
    r
}

fn doc_json_bool_field(out: String, key: String, value: bool, comma: bool) -> String {
    let mut r = out
    if comma { r = r.concat(String_from(",")) }
    if value {
        r = r.concat(String_from("\"").concat(key.clone()).concat(String_from("\":")).concat(String_from("true")))
    } else {
        r = r.concat(String_from("\"").concat(key.clone()).concat(String_from("\":")).concat(String_from("false")))
    }
    r
}

pub fn doc_emit_function_json(e: manifest_doc_record::DocFnEntry, filter_target: String) {
    let mut out = String_from("{")
    out = doc_json_string_field(out, String_from("kind"), String_from("function"), false)
    out = doc_json_string_field(out, String_from("name"), manifest_doc_record::DocFnEntry_name(e), true)
    out = doc_json_string_field(out, String_from("module"), manifest_doc_record::DocFnEntry_module(e), true)
    out = doc_json_string_field(out, String_from("params"), manifest_doc_record::DocFnEntry_params(e), true)
    out = doc_json_string_field(out, String_from("returns"), manifest_doc_record::DocFnEntry_returns(e), true)
    out = doc_json_string_field(out, String_from("stability"), manifest_doc_record::DocFnEntry_stability(e), true)
    out = doc_json_bool_field(out, String_from("avail_t1"), manifest_doc_record::DocFnEntry_avail_t1(e) == 1, true)
    out = doc_json_bool_field(out, String_from("avail_t3"), manifest_doc_record::DocFnEntry_avail_t3(e) == 1, true)
    let doc = manifest_doc_record::DocFnEntry_doc(e)
    if len(doc) > 0 {
        out = doc_json_string_field(out, String_from("doc"), doc, true)
    }
    let warn = doc_target_warning(e, filter_target.clone())
    if len(warn) > 0 {
        out = doc_json_string_field(out, String_from("target_warning"), warn, true)
    }
    out = out.concat(String_from("}"))
    stdio::println(out)
}

pub fn doc_print_module(table: manifest_doc_record::DocManifestTable, module: String, filter_target: String) {
    let mid = manifest_doc_lookup::doc_find_module(table, module.clone())
    stdio::println(String_from("module ").concat(module.clone()))
    if mid >= 0 {
        let m = manifest_doc_record::DocManifestTable_module_at(table, mid)
        let stab = manifest_doc_record::DocModuleEntry_stability(m)
        if len(stab) > 0 {
            stdio::println(String_from("  Stability: ").concat(stab))
        }
        let tgt = manifest_doc_record::DocModuleEntry_target(m)
        if len(tgt) > 0 {
            stdio::println(String_from("  Supported on: ").concat(tgt))
        }
        let doc = manifest_doc_record::DocModuleEntry_doc(m)
        if len(doc) > 0 {
            stdio::println(String_from(""))
            stdio::println(String_from("  ").concat(doc))
        }
    }
    stdio::println(String_from(""))
    stdio::println(String_from("  Functions:"))
    let n = manifest_doc_record::DocManifestTable_function_count(table)
    let mut i = 0
    while i < n {
        let e = manifest_doc_record::DocManifestTable_function_at(table, i)
        if eq(manifest_doc_record::DocFnEntry_module(e), module.clone()) {
            let warn = doc_target_warning(e, filter_target.clone())
            let mut line = String_from("    ").concat(doc_format_signature(e))
            if len(warn) > 0 {
                line = line.concat((String_from("  [")).concat(warn.concat(String_from("]"))))
            }
            stdio::println(line)
        }
        i = i + 1
    }
}
