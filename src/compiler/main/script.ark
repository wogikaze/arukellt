use std::host::fs::Fs
use std::host::process::Process
use std::host::stdio
use std::toml
use std::text
use main::args_record
use main::script_list
pub fn cmd_script(opts: CliOptions) {
    let manifest_result = Fs::read_to_string(String_from("ark.toml"))
    match manifest_result {
        Result::Ok(content) => {
            let script_name = args_record::cli_input_file(opts)
            let scripts_content = toml::TomlText::find_section(content.clone(), String_from("scripts"))
            if len(script_name) == 0 {
                script_list::print_script_list(scripts_content)
                return
            }
            let found = toml::TomlText::find_value(scripts_content.clone(), script_name.clone())
            if len(found) > 0 {
                stdio::println(found.clone())
                return
            }
            stdio::eprintln(String_from("error: script '").concat(script_name.clone().concat(String_from("' not found in ark.toml [scripts]"))))
            Process::exit(1)
        },
        Result::Err(e) => {
            stdio::eprintln(String_from("error: cannot read ark.toml: ").concat(e))
            Process::exit(1)
        },
    }
}
