use std::toml
use lsp::symbol_index_paths
use lsp::symbol_index_stdlib
use main::manifest_doc_record
struct DocParseFnState {
    name: String,
    module: String,
    params: String,
    returns: String,
    stability: String,
    doc: String,
    errors: String,
    target: String,
    avail_t1: i32,
    avail_t3: i32,
    avail_note: String,
    kind: String,
}

fn DocParseFnState_new() -> DocParseFnState {
    DocParseFnState {
        name: String_new(),
        module: String_new(),
        params: String_new(),
        returns: String_new(),
        stability: String_new(),
        doc: String_new(),
        errors: String_new(),
        target: String_new(),
        avail_t1: 1,
        avail_t3: 1,
        avail_note: String_new(),
        kind: String_new()
    }
}

struct DocParseModState {
    name: String,
    stability: String,
    target: String,
    doc: String,
}

fn DocParseModState_new() -> DocParseModState {
    DocParseModState { name: String_new(), stability: String_new(), target: String_new(), doc: String_new() }
}

fn doc_parse_availability_line(line: String, mut state: DocParseFnState) -> DocParseFnState {
    if line.clone().contains(String_from("t1 = false")) {
        state.avail_t1 = 0
    }
    if line.clone().contains(String_from("t3 = false")) {
        state.avail_t3 = 0
    }
    let note_key = toml::TomlText::find_value(line.clone(), String_from("note"))
    if len(note_key) > 0 {
        state.avail_note = note_key
    }
    state
}

fn doc_apply_fn_fields(mut state: DocParseFnState, line: String) -> DocParseFnState {
    let key_doc = toml::TomlText::find_value(line.clone(), String_from("doc"))
    if len(key_doc) > 0 { state.doc = key_doc }
    let key_err = toml::TomlText::find_value(line.clone(), String_from("errors"))
    if len(key_err) > 0 { state.errors = key_err }
    let key_stab = toml::TomlText::find_value(line.clone(), String_from("stability"))
    if len(key_stab) > 0 { state.stability = key_stab }
    let key_ret = toml::TomlText::find_value(line.clone(), String_from("returns"))
    if len(key_ret) > 0 { state.returns = key_ret }
    let key_mod = toml::TomlText::find_value(line.clone(), String_from("module"))
    if len(key_mod) > 0 { state.module = key_mod }
    let key_kind = toml::TomlText::find_value(line.clone(), String_from("kind"))
    if len(key_kind) > 0 { state.kind = key_kind }
    if line.clone().contains(String_from("params =")) {
        let eq_pos = line.clone().index_of(String_from("="))
        if eq_pos >= 0 {
            state.params = symbol_index_stdlib::trim_brackets(line.slice(eq_pos + 1, len(line)))
        }
    }
    if line.clone().contains(String_from("target =")) {
        let eq_pos = line.clone().index_of(String_from("="))
        if eq_pos >= 0 {
            state.target = symbol_index_stdlib::trim_brackets(line.slice(eq_pos + 1, len(line)))
        }
    }
    if line.clone().contains(String_from("availability =")) {
        state = doc_parse_availability_line(line, state)
    }
    state
}

fn doc_flush_fn(mut out: Vec<manifest_doc_record::DocFnEntry>, state: DocParseFnState) {
    if len(state.name) == 0 || len(state.module) == 0 {
        return
    }
    if state.kind.clone().eq(String_from("intrinsic")) {
        return
    }
    push(
        out,
        manifest_doc_record::DocFnEntry_new(
            state.name,
            state.module,
            state.params,
            state.returns,
            state.stability,
            state.doc,
            state.errors,
            state.target,
            state.avail_t1,
            state.avail_t3,
            state.avail_note
        )
    )
}

fn doc_apply_mod_fields(mut state: DocParseModState, line: String) -> DocParseModState {
    let key_doc = toml::TomlText::find_value(line.clone(), String_from("doc"))
    if len(key_doc) > 0 { state.doc = key_doc }
    let key_stab = toml::TomlText::find_value(line.clone(), String_from("stability"))
    if len(key_stab) > 0 { state.stability = key_stab }
    if line.clone().contains(String_from("target =")) {
        let eq_pos = line.clone().index_of(String_from("="))
        if eq_pos >= 0 {
            state.target = symbol_index_stdlib::trim_brackets(line.slice(eq_pos + 1, len(line)))
        }
    }
    state
}

fn doc_flush_mod(mut out: Vec<manifest_doc_record::DocModuleEntry>, state: DocParseModState) {
    if len(state.name) == 0 {
        return
    }
    push(out, manifest_doc_record::DocModuleEntry_new(state.name, state.stability, state.target, state.doc))
}

pub fn doc_parse_manifest(content: String) -> DocManifestTable {
    let mut fns = Vec::new<DocFnEntry>()
    let mut mods = Vec::new<DocModuleEntry>()
    let mut fn_state = DocParseFnState_new()
    let mut mod_state = DocParseModState_new()
    let mut section = 0
    let n = len(content)
    let mut line_start = 0
    let mut i = 0
    while i < n {
        if content.byte_at(i) == 10 || i == n - 1 {
            let line_end = if content.byte_at(i) == 10 { i } else { i + 1 }
            let line = content.slice(line_start, line_end)
            if line.clone().starts_with(String_from("[[functions]]")) {
                doc_flush_fn(fns, fn_state)
                fn_state = DocParseFnState_new()
                section = 1
            } else {
                if line.clone().starts_with(String_from("[[modules]]")) {
                    doc_flush_mod(mods, mod_state)
                    mod_state = DocParseModState_new()
                    section = 2
                } else {
                    let key_name = toml::TomlText::find_value(line.clone(), String_from("name"))
                    if len(key_name) > 0 && section == 1 {
                        doc_flush_fn(fns, fn_state)
                        fn_state = DocParseFnState_new()
                        fn_state.name = key_name
                        fn_state = doc_apply_fn_fields(fn_state, line)
                    } else {
                        if len(key_name) > 0 && section == 2 {
                            doc_flush_mod(mods, mod_state)
                            mod_state = DocParseModState_new()
                            mod_state.name = key_name
                            mod_state = doc_apply_mod_fields(mod_state, line)
                        } else {
                            if section == 1 {
                                fn_state = doc_apply_fn_fields(fn_state, line)
                            } else {
                                if section == 2 {
                                    mod_state = doc_apply_mod_fields(mod_state, line)
                                }
                            }
                        }
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    doc_flush_fn(fns, fn_state)
    doc_flush_mod(mods, mod_state)
    manifest_doc_record::DocManifestTable_new(fns, mods)
}
