use std::host::stdio
use std::text
pub fn init_list_templates() {
    stdio::println("minimal    - Minimal Hello World project (default)")
    stdio::println("cli        - CLI tool with argument parsing")
    stdio::println("with-tests - Project with test functions")
    stdio::println("wasi-host  - WASI host API usage example (wasm32-gc)")
}

pub fn init_template_is_valid(name: String) -> bool {
    if name.clone().eq("minimal") {
        return true
    }
    if name.clone().eq("cli") {
        return true
    }
    if name.clone().eq("with-tests") {
        return true
    }
    if name.clone().eq("wasi-host") {
        return true
    }
    false
}

pub fn init_template_normalize(name: String) -> String {
    if len(name) == 0 {
        return "minimal"
    }
    name.clone()
}

pub fn init_template_main_ark(template: String) -> String {
    if template.clone().eq("cli") {
        let mut source = "use std::host::stdio\nuse std::host::process::Process\n\n"
        source = source.concat("pub fn greet(name: String) -> String {\n")
        source = source.concat("    concat(concat(String_from(\"Hello, \"), name), String_from(\"!\"))\n}\n\n")
        source = source.concat("fn main() {\n    stdio::println(greet(String_from(\"World\")))\n")
        source = source.concat("    Process::exit(0)\n}\n")
        return source
    }
    if template.clone().eq("with-tests") {
        let mut source = "use std::host::stdio\n\npub fn add(a: i32, b: i32) -> i32 {\n    a + b\n}\n\n"
        source = source.concat("pub fn subtract(a: i32, b: i32) -> i32 {\n    a - b\n}\n\n")
        source = source.concat("pub fn test_add() {\n    let result = add(2, 3)\n    assert(result == 5)\n}\n\n")
        source = source.concat("pub fn test_subtract() {\n    let result = subtract(10, 4)\n    assert(result == 6)\n}\n\n")
        source = source.concat("fn main() {\n    let result = add(1, 2)\n")
        source = source.concat("    stdio::println(concat(String_from(\"1 + 2 = \"), result.to_string()))\n}\n")
        return source
    }
    if template.clone().eq("wasi-host") {
        let mut source = "// Build with: arukellt run --target wasm32-gc main.ark\n"
        source = source.concat("use std::host::stdio\n\nfn main() {\n")
        source = source.concat("    stdio::println(String_from(\"Use an explicit official WASI WIT import for network access.\"))\n}\n")
        return source
    }
    "use std::host::stdio\n\nfn main() {\n    stdio::println(String_from(\"Hello, Arukellt!\"))\n}\n"
}

pub fn init_template_ark_toml(project_name: String, template: String) -> String {
    let mut out = "[package]\nname = \""
    out = out.concat(project_name.clone())
    out = out.concat("\"\nversion = \"0.1.0\"\n\n[bin]\nname = \"")
    out = out.concat(project_name.clone())
    out = out.concat("\"\npath = \"main.ark\"\n")
    if template.clone().eq("wasi-host") {
        out = out.concat("target = \"wasm32-gc\"\n")
    }
    out
}

pub fn init_template_print_next_steps(project_name: String, template: String) {
    stdio::eprintln("Initialized Arukellt project in ".concat(project_name.clone().concat(" (template: ".concat(template.clone().concat(")")))))
    stdio::eprintln("")
    stdio::eprintln("Next steps:")
    stdio::eprintln("  cd ".concat(project_name.clone()))
    stdio::eprintln("  arukellt check main.ark        # type-check")
    stdio::eprintln("  arukellt run main.ark          # run the program")
    if template.clone().eq("with-tests") {
        stdio::eprintln("  arukellt test main.ark         # run tests")
    }
    if template.clone().eq("wasi-host") {
        stdio::eprintln("  arukellt check --target wasm32-gc main.ark")
    }
}
