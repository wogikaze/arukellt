fn target_is_canonical(input: String) -> bool {
    if input.clone().eq("wasm32") {
        return true
    }
    if input.clone().eq("wasm32-gc") {
        return true
    }
    if input.clone().eq("native-cpp") {
        return true
    }
    if input.clone().eq("native-llvm") {
        return true
    }
    false
}

