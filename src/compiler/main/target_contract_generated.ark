fn target_is_canonical(input: String) -> bool {
    if eq(clone(input), "wasm32") {
        return true
    }
    if eq(clone(input), "wasm32-gc") {
        return true
    }
    if eq(clone(input), "native-cpp") {
        return true
    }
    if eq(clone(input), "native-llvm") {
        return true
    }
    false
}

