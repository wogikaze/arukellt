fn target_alias_message(input: String) -> String {
    if eq(clone(input), "wasm32-wasi-p1") {
        return "W0002: target `wasm32-wasi-p1` is deprecated; use `--target wasm32 --wasi-version wasi-p1`"
    }
    if eq(clone(input), "wasm32-wasi") {
        return "W0002: target `wasm32-wasi` is deprecated; use `--target wasm32 --wasi-version wasi-p1`"
    }
    if eq(clone(input), "wasm32-wasi-p2") {
        return "W0002: target `wasm32-wasi-p2` is deprecated; use `--target wasm32-gc --wasi-version wasi-p2`"
    }
    if eq(clone(input), "wasm-gc") {
        return "W0002: target `wasm-gc` is deprecated; use `--target wasm32-gc --wasi-version wasi-p2`"
    }
    if eq(clone(input), "wasm-gc-wasi-p2") {
        return "W0002: target `wasm-gc-wasi-p2` is deprecated; use `--target wasm32-gc --wasi-version wasi-p2`"
    }
    if eq(clone(input), "wasm32-wasi-p3") {
        return "W0002: target `wasm32-wasi-p3` is deprecated; use `--target wasm32-gc --wasi-version wasi-p3`"
    }
    if eq(clone(input), "native") {
        return "target `native` is not accepted; use --target native-cpp or --target native-llvm"
