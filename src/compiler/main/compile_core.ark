use std::host::stdio::Stdio
use std::host::fs::Fs
use std::host::process::Process
use std::text
use main::args_record
use main::commands
use main::kinds
use main::target_contract_generated
use driver::types
use driver::config_record
use driver::result_record
use main::output
use driver::file
use diagnostics::mod as diag_mod
pub fn build_emit_config(opts: CliOptions, emit_mode: String, include_dumps: bool) -> DriverConfig {
    let mut config = config_record::DriverConfig_default()
    configure_target_axes(opts, config, emit_mode.clone())
    config_record::config_set_opt_level(config, args_record::cli_opt_level(opts))
    config_record::config_set_emit_mode(config, emit_mode)
    config_record::config_set_wit_paths(config, args_record::cli_wit_paths(opts))
    if args_record::cli_has_world(opts) {
        config_record::config_set_world(config, args_record::cli_world(opts))
    }
    config_record::config_set_show_timing(config, args_record::cli_show_timing(opts))
    config_record::config_set_lint_allow(config, args_record::cli_lint_allow(opts))
    config_record::config_set_lint_deny(config, args_record::cli_lint_deny(opts))
    if args_record::cli_has_cache_dir(opts) {
        config_record::config_set_cache_dir(config, args_record::cli_cache_dir(opts))
    }
    config_record::config_set_strip_debug(config, args_record::cli_strip_debug(opts))
    config_record::config_set_bootstrap_shared_param_mutation(
        config,
        args_record::cli_bootstrap_shared_param_mutation(opts)
    )
    config_record::config_set_strict_impl_binders(
        config,
        args_record::cli_strict_impl_binders(opts)
    )
    if include_dumps {
        config_record::config_set_dump_tokens(config, should_dump(opts, "tokens"))
        config_record::config_set_dump_ast(config, should_dump(opts, "ast"))
        config_record::config_set_dump_hir(config, should_dump(opts, "hir"))
        config_record::config_set_dump_mir(config, should_dump(opts, "mir"))
        config_record::config_set_dump_backend_plan(config, should_dump(opts, "backend-plan"))
        config_record::config_set_dump_wit_bindings(config, should_dump(opts, "wit-bindings"))
        config_record::config_set_dump_wasm(config, should_dump(opts, "wasm"))
    }
    config
}

pub fn configure_target_axes(opts: CliOptions, mut config: DriverConfig, emit_mode: String) {
    let target = args_record::cli_target(opts)
    config_record::config_set_target(config, target.clone())
    if args_record::cli_has_wasi_version(opts) {
        config_record::config_set_wasi_version(config, args_record::cli_wasi_version(opts))
    }
    config_record::config_set_wasi_version_explicit(config, args_record::cli_wasi_version_explicit(opts))
    config_record::config_set_memory_width(
        config,
        resolve_memory_width(
            target.clone(),
            emit_mode.clone(),
            args_record::cli_memory_width(opts)
        )
    )
}

fn resolve_memory_width(target: String, emit_mode: String, requested: String) -> String {
    if !requested.clone().eq(String_from("auto")) {
        return requested
    }
    if emit_mode.clone().eq(String_from("component")) || emit_mode.clone().eq(String_from("all")) {
        return String_from("memory32")
    }
    if emit_mode.clone().eq(String_from("wat")) {
        return String_from("memory32")
    }
    target_contract_generated::target_default_memory_width(target)
}

pub fn build_command_config(opts: CliOptions) -> DriverConfig {
    let command = args_record::cli_command(opts)
    let mut config = build_emit_config(opts, args_record::cli_emit_mode(opts), true)
    config_record::config_set_parse_only(config, command == kinds::CMD_PARSE())
    config_record::config_set_check_only(config, command == kinds::CMD_CHECK() || command == kinds::CMD_LINT())
    config_record::config_set_lint_local_only(config, command == kinds::CMD_LINT() && args_record::cli_lint_local(opts))
    config
}

fn should_dump(opts: CliOptions, phase: String) -> bool {
    if args_record::cli_dump_phases(opts).len() == 0 {
        return false
    }
    let phases = args_record::cli_dump_phases(opts)
    let phase_len = phase.len()
    let phases_len = phases.len()
    let mut i = 0
    while i <= phases_len - phase_len {
        let sub = phases.clone().slice(i, i + phase_len)
        if sub.eq(phase.clone()) {
            let at_start = i == 0
            let after_comma = i > 0 && phases.byte_at(i - 1) == 44
            let at_end = i + phase_len == phases_len
            let before_comma = i + phase_len < phases_len && phases.byte_at(i + phase_len) == 44
            if at_start || after_comma && at_end || before_comma {
                return true
            }
        }
        i = i + 1
    }
    false
}

fn print_compile_diagnostics(input_file: String, result: CompileResult, json_mode: bool) {
    if json_mode {
        Stdio::println(output::format_error_json(input_file.clone(), result_record::compile_result_phase_reached(result), result_record::compile_result_diagnostics(result)))
        return
    }
    let err_count = result_record::compile_result_error_message_count(result)
    if err_count > 0 {
        let mut i = 0
        while i < err_count {
            Stdio::eprintln(result_record::compile_result_error_message_at(result, i))
            i = i + 1
        }
        return
    }
    let diags = result_record::compile_result_diagnostics(result)
    let diag_count = diags.len()
    let mut j = 0
    while j < diag_count {
        Stdio::eprintln(diag_mod::format_diagnostic_text(String_new(), input_file.clone(), diags.get_unchecked(j)))
        j = j + 1
    }
}

fn write_compile_output(path: String, bytes: Vec<i32>, json_mode: bool) -> bool {
    let write_result: Result<(), String> = Fs::write_bytes(path.clone(), bytes)
    match write_result {
        Result::Ok(_) => {
            if !json_mode {
                Stdio::eprintln("wrote ".concat(bytes.len().to_string().concat(" bytes to ".concat(path.clone()))))
            }
            true
        },
        Result::Err(e) => {
            Stdio::eprintln("error writing output: ".concat(e))
            false
        },
    }
}

fn stem_from_input(path: String) -> String {
    let n = path.clone().len()
    if n > 4 {
        let ext = path.clone().slice(n - 4, n)
        if ext.eq(".ark") {
            return path.slice(0, n - 4)
        }
    }
    path
}

fn wasm_path_for_all(opts: CliOptions) -> String {
    if args_record::cli_has_output_file(opts) {
        return args_record::cli_output_file(opts)
    }
    stem_from_input(args_record::cli_input_file(opts)).concat(".wasm")
}

fn component_path_for_all(opts: CliOptions) -> String {
    if args_record::cli_has_output_file(opts) {
        let out = args_record::cli_output_file(opts)
        let n = out.clone().len()
        if n > 5 {
            let ext = out.clone().slice(n - 5, n)
            if ext.eq(".wasm") {
                return out.slice(0, n - 5).concat(".component.wasm")
            }
        }
        return out.concat(".component.wasm")
    }
    stem_from_input(args_record::cli_input_file(opts)).concat(".component.wasm")
}

pub fn cmd_compile_single(opts: CliOptions) {
    let status = cmd_compile_single_status(opts)
    if status != 0 {
        Process::exit(status)
    }
}

pub fn cmd_compile_single_status(opts: CliOptions) -> i32 {
    if !validate_wit_paths(opts) {
        return 1
    }
    let input_file = args_record::cli_input_file(opts)
    if !enforce_capability_denies(opts, input_file.clone()) {
        return 1
    }
    let mut config = build_command_config(opts)
    let json_mode = args_record::cli_json_output(opts)
    let result = file::compile_file(input_file.clone(), config)
    let has_messages = result_record::compile_result_error_message_count(result) > 0 || result_record::compile_result_diagnostics(result).len() > 0
    if has_messages {
        print_compile_diagnostics(input_file.clone(), result, json_mode)
    }
    if !result_record::compile_result_success(result) {
        return 1
    }
    // check/lint stop after typecheck; warnings already printed above.
    let command = args_record::cli_command(opts)
    if command == kinds::CMD_CHECK() || command == kinds::CMD_LINT() {
        return 0
    }
    handle_single_compile_success(opts, input_file.clone(), result, json_mode)
}

fn print_compile_success(input_file: String, result: CompileResult, json_mode: bool) {
    if json_mode {
        Stdio::println(output::format_success_json(input_file.clone(), result_record::compile_result_phase_reached(result), result_record::compile_result_output_byte_count(result)))
        return
    }
    Stdio::eprintln("compilation succeeded (phase ".concat(result_record::compile_result_phase_reached(result).to_string().concat(")")))
}

fn handle_single_compile_success(opts: CliOptions, input_file: String, result: CompileResult, json_mode: bool) -> i32 {
    print_compile_success(input_file.clone(), result, json_mode)
    if args_record::cli_has_output_file(opts) {
        if !write_compile_output(args_record::cli_output_file(opts), result_record::compile_result_output_bytes(result), json_mode) {
            return 1
        }
        return 0
    }
    if !json_mode {
        Stdio::println("ok: ".concat(result_record::compile_result_output_byte_count(result).to_string().concat(" bytes")))
    }
    0
}

fn validate_wit_paths(opts: CliOptions) -> bool {
    let mut i = 0
    while i < args_record::cli_wit_path_count(opts) {
        let path = args_record::cli_wit_path_at(opts, i)
        let read_result = Fs::read_to_string(path.clone())
        match read_result {
            Result::Ok(_) => {
            },
            Result::Err(e) => {
                Stdio::eprintln("error: unable to read WIT file ".concat(path.clone().concat(": ".concat(e))))
                return false
            },
        }
        i = i + 1
    }
    true
}

fn source_uses_clock_intrinsics(source: String) -> bool {
    source.clone().contains(String_from("clock::")) ||
    source.clone().contains(String_from("monotonic_now")) ||
    source.contains(String_from("std::host::clock"))
}

fn source_uses_random_intrinsics(source: String) -> bool {
    source.clone().contains(String_from("random::")) ||
    source.clone().contains(String_from("random_i32")) ||
    source.clone().contains(String_from("Random::")) ||
    source.contains(String_from("std::host::random"))
}

fn source_uses_process_intrinsics(source: String) -> bool {
    source.clone().contains(String_from("process::exit")) ||
    source.clone().contains(String_from("process::abort")) ||
    source.clone().contains(String_from("Process::exit")) ||
    source.clone().contains(String_from("Process::abort")) ||
    source.clone().contains(String_from("Process::id")) ||
    source.clone().contains(String_from("std::host::process")) ||
    source.clone().contains(String_from("__runtime_abi_process_exit")) ||
    source.contains(String_from("__runtime_abi_process_abort"))
}

fn enforce_capability_denies(opts: CliOptions, input_file: String) -> bool {
    if !args_record::cli_deny_clock(opts) && !args_record::cli_deny_random(opts) && !args_record::cli_deny_process(opts) {
        return true
    }
    let read_result = Fs::read_to_string(input_file.clone())
    match read_result {
        Result::Ok(source) => {
            if args_record::cli_deny_clock(opts) && source_uses_clock_intrinsics(source.clone()) {
                Stdio::eprintln(String_from("--deny-clock: this program uses clock intrinsics"))
                return false
            }
            if args_record::cli_deny_random(opts) && source_uses_random_intrinsics(source.clone()) {
                Stdio::eprintln(String_from("--deny-random: this program uses random intrinsics"))
                return false
            }
            if args_record::cli_deny_process(opts) && source_uses_process_intrinsics(source) {
                Stdio::eprintln(String_from("--deny-process: this program uses process-control intrinsics"))
                return false
            }
            true
        },
        Result::Err(e) => {
            Stdio::eprintln(String_from("error: unable to read input file ").concat(input_file.clone().concat(String_from(": ").concat(e))))
            false
        },
    }
}
