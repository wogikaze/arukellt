use std::host::stdio
use std::host::fs
use std::host::process
use main::args_record
use main::commands
use main::kinds
use driver::types
use driver::config_record
use driver::result_record
use main::output
use driver::file
use diagnostics::mod as diag_mod

pub fn build_emit_config(opts: CliOptions, emit_mode: String, include_dumps: bool) -> DriverConfig {
    let config = config_record::DriverConfig_default()
    config_record::config_set_target(config, args_record::cli_target(opts))
    if args_record::cli_has_wasi_version(opts) {
        config_record::config_set_wasi_version(config, args_record::cli_wasi_version(opts))
    }
    config_record::config_set_wasi_version_explicit(config, args_record::cli_wasi_version_explicit(opts))
    config_record::config_set_opt_level(config, args_record::cli_opt_level(opts))
    config_record::config_set_emit_mode(config, emit_mode)
    config_record::config_set_wit_paths(config, args_record::cli_wit_paths(opts))
    if args_record::cli_has_world(opts) {
        config_record::config_set_world(config, args_record::cli_world(opts))
    }
    config_record::config_set_show_timing(config, args_record::cli_show_timing(opts))
    config_record::config_set_lint_allow(config, args_record::cli_lint_allow(opts))
    config_record::config_set_lint_deny(config, args_record::cli_lint_deny(opts))
    if args_record::cli_has_cache_dir(opts) {
        config_record::config_set_cache_dir(config, args_record::cli_cache_dir(opts))
    }
    config_record::config_set_strip_debug(config, args_record::cli_strip_debug(opts))
    if include_dumps {
        config_record::config_set_dump_tokens(config, should_dump(opts, "tokens"))
        config_record::config_set_dump_ast(config, should_dump(opts, "ast"))
        config_record::config_set_dump_hir(config, should_dump(opts, "hir"))
        config_record::config_set_dump_mir(config, should_dump(opts, "mir"))
        config_record::config_set_dump_backend_plan(config, should_dump(opts, "backend-plan"))
        config_record::config_set_dump_wit_bindings(config, should_dump(opts, "wit-bindings"))
        config_record::config_set_dump_wasm(config, should_dump(opts, "wasm"))
    }
    config
}

pub fn build_command_config(opts: CliOptions) -> DriverConfig {
    let command = args_record::cli_command(opts)
    let config = build_emit_config(opts, args_record::cli_emit_mode(opts), true)
    config_record::config_set_parse_only(config, command == kinds::CMD_PARSE())
    config_record::config_set_check_only(config, command == kinds::CMD_CHECK() || command == kinds::CMD_LINT())
    config_record::config_set_lint_local_only(config, command == kinds::CMD_LINT() && args_record::cli_lint_local(opts))
    config
}

fn should_dump(opts: CliOptions, phase: String) -> bool {
    if len(args_record::cli_dump_phases(opts)) == 0 {
        return false
    }
    let phases = args_record::cli_dump_phases(opts)
    let phase_len = len(phase)
    let phases_len = len(phases)
    let mut i = 0
    while i <= phases_len - phase_len {
        let sub = substring(clone(phases), i, i + phase_len)
        if eq(sub, clone(phase)) {
            let at_start = i == 0
            let after_comma = i > 0 && char_at(phases, i - 1) == 44
            let at_end = i + phase_len == phases_len
            let before_comma = i + phase_len < phases_len && char_at(phases, i + phase_len) == 44
            if at_start || after_comma && at_end || before_comma {
                return true
            }
        }
        i = i + 1
    }
    false
}

fn print_compile_diagnostics(input_file: String, result: CompileResult, json_mode: bool) {
    if json_mode {
        stdio::println(output::format_error_json(clone(input_file), result_record::compile_result_phase_reached(result), result_record::compile_result_diagnostics(result)))
        return
    }
    let err_count = result_record::compile_result_error_message_count(result)
    if err_count > 0 {
        let mut i = 0
        while i < err_count {
            stdio::eprintln(result_record::compile_result_error_message_at(result, i))
            i = i + 1
        }
        return
    }
    let diags = result_record::compile_result_diagnostics(result)
    let diag_count = len(diags)
    let mut j = 0
    while j < diag_count {
        stdio::eprintln(diag_mod::format_diagnostic_text(String_new(), clone(input_file), get_unchecked(diags, j)))
        j = j + 1
    }
}

fn write_compile_output(path: String, bytes: Vec<i32>, json_mode: bool) -> bool {
    let write_result = fs::write_bytes(clone(path), bytes)
    match write_result {
        Result::Ok(_) => {
            if !json_mode {
                stdio::eprintln(concat("wrote ", concat(to_string(len(bytes)), concat(" bytes to ", clone(path)))))
            }
            true
        },
        Result::Err(e) => {
            stdio::eprintln(concat("error writing output: ", e))
            false
        },
    }
}

fn stem_from_input(path: String) -> String {
    let n = len(clone(path))
    if n > 4 {
        let ext = substring(clone(path), n - 4, n)
        if eq(ext, ".ark") {
            return substring(path, 0, n - 4)
        }
    }
    path
}

fn wasm_path_for_all(opts: CliOptions) -> String {
    if args_record::cli_has_output_file(opts) {
        return args_record::cli_output_file(opts)
    }
    concat(stem_from_input(args_record::cli_input_file(opts)), ".wasm")
}

fn component_path_for_all(opts: CliOptions) -> String {
    if args_record::cli_has_output_file(opts) {
        let out = args_record::cli_output_file(opts)
        let n = len(clone(out))
        if n > 5 {
            let ext = substring(clone(out), n - 5, n)
            if eq(ext, ".wasm") {
                return concat(substring(out, 0, n - 5), ".component.wasm")
            }
        }
        return concat(out, ".component.wasm")
    }
    concat(stem_from_input(args_record::cli_input_file(opts)), ".component.wasm")
}

pub fn cmd_compile_single(opts: CliOptions) {
    if !validate_wit_paths(opts) {
        process::exit(1)
        return
    }
    let input_file = args_record::cli_input_file(opts)
    if !enforce_capability_denies(opts, clone(input_file)) {
        process::exit(1)
        return
    }
    let config = build_command_config(opts)
    let json_mode = args_record::cli_json_output(opts)
    let result = file::compile_file(clone(input_file), config)
    let has_messages = result_record::compile_result_error_message_count(result) > 0 || len(result_record::compile_result_diagnostics(result)) > 0
    if has_messages {
        print_compile_diagnostics(clone(input_file), result, json_mode)
    }
    if !result_record::compile_result_success(result) {
        process::exit(1)
    }
    // check/lint stop after typecheck; warnings already printed above.
    let command = args_record::cli_command(opts)
    if command == kinds::CMD_CHECK() || command == kinds::CMD_LINT() {
        return
    }
    handle_single_compile_success(opts, clone(input_file), result, json_mode)
}

fn print_compile_success(input_file: String, result: CompileResult, json_mode: bool) {
    if json_mode {
        stdio::println(output::format_success_json(clone(input_file), result_record::compile_result_phase_reached(result), result_record::compile_result_output_byte_count(result)))
        return
    }
    stdio::eprintln(concat("compilation succeeded (phase ", concat(to_string(result_record::compile_result_phase_reached(result)), ")")))
}

fn handle_single_compile_success(opts: CliOptions, input_file: String, result: CompileResult, json_mode: bool) {
    print_compile_success(clone(input_file), result, json_mode)
    if args_record::cli_has_output_file(opts) {
        if !write_compile_output(args_record::cli_output_file(opts), result_record::compile_result_output_bytes(result), json_mode) {
            process::exit(1)
        }
        return
    }
    if !json_mode {
        stdio::println(concat("ok: ", concat(to_string(result_record::compile_result_output_byte_count(result)), " bytes")))
    }
}

fn validate_wit_paths(opts: CliOptions) -> bool {
    let mut i = 0
    while i < args_record::cli_wit_path_count(opts) {
        let path = args_record::cli_wit_path_at(opts, i)
        let read_result = fs::read_to_string(clone(path))
        match read_result {
            Result::Ok(_) => {
            },
            Result::Err(e) => {
                stdio::eprintln(concat("error: unable to read WIT file ", concat(clone(path), concat(": ", e))))
                return false
            },
        }
        i = i + 1
    }
    true
}

fn source_uses_clock_intrinsics(source: String) -> bool {
    contains(clone(source), String_from("clock::")) ||
    contains(clone(source), String_from("monotonic_now")) ||
    contains(source, String_from("std::host::clock"))
}

fn source_uses_random_intrinsics(source: String) -> bool {
    contains(clone(source), String_from("random::")) ||
    contains(clone(source), String_from("random_i32")) ||
    contains(source, String_from("std::host::random"))
}

fn source_uses_process_intrinsics(source: String) -> bool {
    contains(clone(source), String_from("process::exit")) ||
    contains(clone(source), String_from("process::abort")) ||
    contains(clone(source), String_from("std::host::process")) ||
    contains(clone(source), String_from("__runtime_abi_process_exit")) ||
    contains(source, String_from("__runtime_abi_process_abort"))
}

fn enforce_capability_denies(opts: CliOptions, input_file: String) -> bool {
    if !args_record::cli_deny_clock(opts) && !args_record::cli_deny_random(opts) && !args_record::cli_deny_process(opts) {
        return true
    }
    let read_result = fs::read_to_string(clone(input_file))
    match read_result {
        Result::Ok(source) => {
            if args_record::cli_deny_clock(opts) && source_uses_clock_intrinsics(clone(source)) {
                stdio::eprintln(String_from("--deny-clock: this program uses clock intrinsics"))
                return false
            }
            if args_record::cli_deny_random(opts) && source_uses_random_intrinsics(clone(source)) {
                stdio::eprintln(String_from("--deny-random: this program uses random intrinsics"))
                return false
            }
            if args_record::cli_deny_process(opts) && source_uses_process_intrinsics(source) {
                stdio::eprintln(String_from("--deny-process: this program uses process-control intrinsics"))
                return false
            }
            true
        },
        Result::Err(e) => {
            stdio::eprintln(concat(String_from("error: unable to read input file "), concat(clone(input_file), concat(String_from(": "), e))))
            false
        },
    }
}
