use std::host::fs
use std::host::process
use std::host::stdio
use component::compose_wit_validate
use main::args_record
use main::commands

fn compose_print_usage() {
    stdio::eprintln("usage: arukellt compose --plug <provider.component.wasm> <socket.component.wasm> -o <output.component.wasm>")
    stdio::eprintln("       arukellt compose --validate --plug <provider> <socket> -o <output>")
    stdio::eprintln("")
    stdio::eprintln("Validates a two-component plug plan and prints the dependency graph.")
    stdio::eprintln("When <component>.wit sidecars exist, import/export names and func signatures are checked.")
    stdio::eprintln("Binary composition currently delegates to `wac plug` (see docs/adr/ADR-034-component-composition-linking.md).")
}

fn compose_paths_conflict(provider: String, socket: String, output: String) -> bool {
    if commands::cli_str_eq(clone(provider), clone(socket)) {
        return true
    }
    if commands::cli_str_eq(clone(provider), clone(output)) {
        return true
    }
    commands::cli_str_eq(clone(socket), clone(output))
}

fn compose_print_graph(provider: String, socket: String, output: String) {
    stdio::println("compose dependency graph:")
    stdio::println(concat("  [provider] ", clone(provider)))
    stdio::println(concat("  [socket]   ", clone(socket)))
    stdio::println("  edge: provider --plug--> socket")
    stdio::println(concat("  output: ", clone(output)))
}

fn compose_validate_paths(provider: String, socket: String, output: String) -> bool {
    if compose_paths_conflict(clone(provider), clone(socket), clone(output)) {
        stdio::eprintln("error: compose conflict — provider, socket, and output paths must differ")
        return false
    }
    match fs::read_to_string(clone(provider)) {
        Result::Ok(_) => {},
        Result::Err(_) => {
            stdio::eprintln(concat("error: provider component not found: ", clone(provider)))
            return false
        },
    }
    match fs::read_to_string(clone(socket)) {
        Result::Ok(_) => {},
        Result::Err(_) => {
            stdio::eprintln(concat("error: socket component not found: ", clone(socket)))
            return false
        },
    }
    true
}

fn compose_validate_wit_surfaces(provider: String, socket: String) -> bool {
    let err = compose_wit_validate::validate_plug_surfaces(clone(provider), clone(socket))
    if len(err) > 0 {
        stdio::eprintln(err)
        return false
    }
    true
}

fn compose_wac_plug_command(provider: String, socket: String, output: String) -> String {
    concat(
        "wac plug --plug ",
        concat(
            clone(provider),
            concat(
                " ",
                concat(
                    clone(socket),
                    concat(" -o ", clone(output))
                )
            )
        )
    )
}

fn compose_print_delegate_hint(provider: String, socket: String, output: String) {
    stdio::eprintln("error: wac not found in PATH")
    stdio::println("")
    stdio::println("note: binary composition delegates to `wac plug` (ADR-034 Phase 3).")
    stdio::println("Install wac or run the validated plan manually:")
    stdio::println(concat("  ", compose_wac_plug_command(clone(provider), clone(socket), clone(output))))
}

fn compose_request_wac_plug(provider: String, socket: String, output: String) {
    stdio::println("compose: wac-plug")
    stdio::println(concat("compose: provider ", clone(provider)))
    stdio::println(concat("compose: socket ", clone(socket)))
    stdio::println(concat("compose: output ", clone(output)))
    stdio::println(concat(
            "compose: command ",
            compose_wac_plug_command(clone(provider), clone(socket), clone(output))
        ))
}

pub fn cmd_compose(opts: CliOptions) {
    let plug_provider = args_record::cli_compose_plug(opts)
    let socket = args_record::cli_compose_socket(opts)
    let output = args_record::cli_output_file(opts)
    let validate_only = args_record::cli_compose_validate_only(opts)
    if len(plug_provider) == 0 || len(socket) == 0 || len(output) == 0 {
        compose_print_usage()
        process::exit(2)
        return
    }
    if !compose_validate_paths(clone(plug_provider), clone(socket), clone(output)) {
        process::exit(1)
        return
    }
    if !compose_validate_wit_surfaces(clone(plug_provider), clone(socket)) {
        process::exit(1)
        return
    }
    compose_print_graph(clone(plug_provider), clone(socket), clone(output))
    if validate_only {
        stdio::println("compose: validation ok")
        return
    }
    compose_request_wac_plug(clone(plug_provider), clone(socket), clone(output))
}
