use std::host::fs::Fs
use std::host::process::Process
use std::host::stdio::Stdio
use std::text
use component::compose_wit_validate
use main::args_record
use main::commands
fn compose_print_usage() {
    Stdio::eprintln("usage: arukellt compose --plug <provider.component.wasm> <socket.component.wasm> -o <output.component.wasm>")
    Stdio::eprintln("       arukellt compose --validate --plug <provider> <socket> -o <output>")
    Stdio::eprintln("")
    Stdio::eprintln("Validates a two-component plug plan and prints the dependency graph.")
    Stdio::eprintln("When <component>.wit sidecars exist, import/export names and func signatures are checked.")
    Stdio::eprintln("Binary composition currently delegates to `wac plug` (see docs/adr/ADR-034-component-composition-linking.md).")
}

fn compose_paths_conflict(provider: String, socket: String, output: String) -> bool {
    if commands::cli_str_eq(provider.clone(), socket.clone()) {
        return true
    }
    if commands::cli_str_eq(provider.clone(), output.clone()) {
        return true
    }
    commands::cli_str_eq(socket.clone(), output.clone())
}

fn compose_print_graph(provider: String, socket: String, output: String) {
    Stdio::println("compose dependency graph:")
    Stdio::println("  [provider] ".concat(provider.clone()))
    Stdio::println("  [socket]   ".concat(socket.clone()))
    Stdio::println("  edge: provider --plug--> socket")
    Stdio::println("  output: ".concat(output.clone()))
}

fn compose_validate_paths(provider: String, socket: String, output: String) -> bool {
    if compose_paths_conflict(provider.clone(), socket.clone(), output.clone()) {
        Stdio::eprintln("error: compose conflict — provider, socket, and output paths must differ")
        return false
    }
    match Fs::read_to_string(provider.clone()) {
        Result::Ok(_) => {},
        Result::Err(_) => {
            Stdio::eprintln("error: provider component not found: ".concat(provider.clone()))
            return false
        },
    }
    match Fs::read_to_string(socket.clone()) {
        Result::Ok(_) => {},
        Result::Err(_) => {
            Stdio::eprintln("error: socket component not found: ".concat(socket.clone()))
            return false
        },
    }
    true
}

fn compose_validate_wit_surfaces(provider: String, socket: String) -> bool {
    let err = compose_wit_validate::validate_plug_surfaces(provider.clone(), socket.clone())
    if err.len() > 0 {
        Stdio::eprintln(err)
        return false
    }
    true
}

fn compose_wac_plug_command(provider: String, socket: String, output: String) -> String {
    "wac plug --plug ".concat(provider.clone().concat(" ".concat(socket.clone().concat(" -o ".concat(output.clone())))))
}

fn compose_print_delegate_hint(provider: String, socket: String, output: String) {
    Stdio::eprintln("error: wac not found in PATH")
    Stdio::println("")
    Stdio::println("note: binary composition delegates to `wac plug` (ADR-034 Phase 3).")
    Stdio::println("Install wac or run the validated plan manually:")
    Stdio::println("  ".concat(compose_wac_plug_command(provider.clone(), socket.clone(), output.clone())))
}

fn compose_request_wac_plug(provider: String, socket: String, output: String) {
    Stdio::println("compose: wac-plug")
    Stdio::println("compose: provider ".concat(provider.clone()))
    Stdio::println("compose: socket ".concat(socket.clone()))
    Stdio::println("compose: output ".concat(output.clone()))
    Stdio::println("compose: command ".concat(compose_wac_plug_command(provider.clone(), socket.clone(), output.clone())))
}

pub fn cmd_compose(opts: CliOptions) {
    let plug_provider = args_record::cli_compose_plug(opts)
    let socket = args_record::cli_compose_socket(opts)
    let output = args_record::cli_output_file(opts)
    let validate_only = args_record::cli_compose_validate_only(opts)
    if plug_provider.len() == 0 || socket.len() == 0 || output.len() == 0 {
        compose_print_usage()
        Process::exit(2)
        return
    }
    if !compose_validate_paths(plug_provider.clone(), socket.clone(), output.clone()) {
        Process::exit(1)
        return
    }
    if !compose_validate_wit_surfaces(plug_provider.clone(), socket.clone()) {
        Process::exit(1)
        return
    }
    compose_print_graph(plug_provider.clone(), socket.clone(), output.clone())
    if validate_only {
        Stdio::println("compose: validation ok")
        return
    }
    compose_request_wac_plug(plug_provider.clone(), socket.clone(), output.clone())
}
