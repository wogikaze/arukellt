use std::host::fs::Fs
use std::host::process::Process
use std::host::stdio::Stdio
use std::text
use main::manifest_doc_fuzzy
use main::manifest_doc_lookup
use main::manifest_doc_parse
use main::manifest_doc_record
use main::manifest_doc_render
fn doc_load_manifest() -> DocManifestTable {
    // The ARUKELLT_MANIFEST env override is disabled; the default manifest
    // path is the only source.
    let path = "std/manifest.toml"
    let read_result = Fs::read_to_string(path.clone())
    match read_result {
        Result::Ok(content) => {
            manifest_doc_parse::doc_parse_manifest(content)
        },
        Result::Err(e) => {
            Stdio::eprintln("error: could not load stdlib manifest: ".concat(e))
            Process::exit(1)
            manifest_doc_record::DocManifestTable_new(Vec::new<DocFnEntry>(), Vec::new<DocModuleEntry>())
        },
    }
}

pub fn cmd_manifest_doc(symbol: String, json_out: bool, filter_target: String) {
    if symbol.len() == 0 {
        return
    }
    let table = doc_load_manifest()
    let query = manifest_doc_lookup::doc_resolve_query(table, symbol.clone())
    let hits = manifest_doc_record::DocQuery_hits(query)
    if manifest_doc_record::DocQuery_show_module(query) == 1 {
        manifest_doc_render::doc_print_module(table, symbol.clone(), filter_target.clone())
        return
    }
    if hits.len() == 0 {
        Stdio::eprintln("error: symbol '".concat(symbol.clone().concat("' not found")))
        let candidates = manifest_doc_fuzzy::doc_find_closest(table, symbol.clone(), 3)
        if candidates.len() > 0 {
            Stdio::eprintln("")
            Stdio::eprintln("Did you mean?")
            let mut ci = 0
            while ci < candidates.len() {
                Stdio::eprintln("  ".concat(get_unchecked(candidates, ci)))
                ci = ci + 1
            }
        }
        Process::exit(1)
    }
    let e = manifest_doc_record::DocManifestTable_function_at(table, get_unchecked(hits, 0))
    if json_out {
        manifest_doc_render::doc_emit_function_json(e, filter_target.clone())
    } else {
        manifest_doc_render::doc_print_function(e, filter_target.clone())
    }
}
