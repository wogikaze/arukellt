use main::args_record
use main::commands

pub fn parse_flag_option(opts: CliOptions, arg: String) -> bool {
    if commands::cli_str_eq(clone(arg), "--help") {
        args_record::cli_set_show_help(opts, true)
        return true
    }
    if commands::cli_str_eq(clone(arg), "--json") {
        args_record::cli_set_json_output(opts, true)
        return true
    }
    if commands::cli_str_eq(clone(arg), "--time") {
        args_record::cli_set_show_timing(opts, true)
        return true
    }
    if commands::cli_str_eq(clone(arg), "--version") {
        args_record::cli_set_show_version(opts, true)
        return true
    }
    if commands::cli_str_eq(clone(arg), "--list-templates") {
        args_record::cli_set_list_templates(opts, true)
        return true
    }
    if commands::cli_str_eq(clone(arg), "--check") {
        args_record::cli_set_fmt_check(opts, true)
        return true
    }
    if commands::cli_str_eq(clone(arg), "--fix") {
        args_record::cli_set_fmt_fix(opts, true)
        return true
    }
    if commands::cli_str_eq(clone(arg), "--list") {
        args_record::cli_set_lint_list(opts, true)
        return true
    }
    if commands::cli_str_eq(clone(arg), "--local") {
        args_record::cli_set_lint_local(opts, true)
        return true
    }
    if commands::cli_str_eq(clone(arg), "--strip-debug") {
        args_record::cli_set_strip_debug(opts, true)
        return true
    }
    false
}
