use std::host::fs
use std::host::process
use std::host::stdio
use main::args_record
use main::init_templates

pub fn cmd_init(opts: CliOptions) {
    if args_record::cli_list_templates(opts) {
        init_templates::init_list_templates()
        return
    }
    let project_name = args_record::cli_input_file(opts)
    if len(project_name) == 0 {
        stdio::eprintln("usage: arukellt init <project-name> [--template minimal|cli|with-tests|wasi-host]")
        stdio::eprintln("       arukellt init --list-templates")
        process::exit(2)
    }
    let template = init_templates::init_template_normalize(args_record::cli_init_template(opts))
    if !init_templates::init_template_is_valid(clone(template)) {
        stdio::eprintln(concat("error: unknown template '", concat(clone(template), "' (use --list-templates)")))
        process::exit(2)
    }
    let src_main = concat(clone(project_name), "/main.ark")
    let ark_toml = concat(clone(project_name), "/ark.toml")
    match fs::read_to_string(clone(ark_toml)) {
        Result::Ok(_) => {
            stdio::eprintln(concat("error: ark.toml already exists in ", clone(project_name)))
            process::exit(1)
        },
        Result::Err(_) => {},
    }
    let main_content = init_templates::init_template_main_ark(clone(template))
    let toml_content = init_templates::init_template_ark_toml(clone(project_name), clone(template))
    let write_main = fs::write_string(src_main, main_content)
    match write_main {
        Result::Ok(_) => {
            let write_toml = fs::write_string(ark_toml, toml_content)
            match write_toml {
                Result::Ok(_) => {
                    init_templates::init_template_print_next_steps(clone(project_name), clone(template))
                },
                Result::Err(e) => {
                    stdio::eprintln(concat("error creating ark.toml: ", fs::fs_error_message(e)))
                    process::exit(1)
                },
            }
        },
        Result::Err(e) => {
            stdio::eprintln(concat("error creating project: ", fs::fs_error_message(e)))
            process::exit(1)
        },
    }
}
