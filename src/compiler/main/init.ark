use std::host::fs::Fs
use std::host::process::Process
use std::host::stdio
use std::text
use main::args_record
use main::init_templates
pub fn cmd_init(opts: CliOptions) {
    if args_record::cli_list_templates(opts) {
        init_templates::init_list_templates()
        return
    }
    let project_name = args_record::cli_input_file(opts)
    if len(project_name) == 0 {
        stdio::eprintln(String_from("usage: arukellt init <project-name> [--template minimal|cli|with-tests|wasi-host]"))
        stdio::eprintln(String_from("       arukellt init --list-templates"))
        Process::exit(2)
    }
    let template = init_templates::init_template_normalize(args_record::cli_init_template(opts))
    if !init_templates::init_template_is_valid(template.clone()) {
        stdio::eprintln(String_from("error: unknown template '").concat(template.clone().concat(String_from("' (use --list-templates)"))))
        Process::exit(2)
    }
    let src_main = project_name.clone().concat(String_from("/main.ark"))
    let ark_toml = project_name.clone().concat(String_from("/ark.toml"))
    match Fs::read_to_string(ark_toml.clone()) {
        Result::Ok(_) => {
            stdio::eprintln(String_from("error: ark.toml already exists in ").concat(project_name.clone()))
            Process::exit(1)
        },
        Result::Err(_) => {},
    }
    let main_content = init_templates::init_template_main_ark(template.clone())
    let toml_content = init_templates::init_template_ark_toml(project_name.clone(), template.clone())
    let write_main: Result<(), String> = Fs::write_string(src_main, main_content)
    match write_main {
        Result::Ok(_) => {
            let write_toml: Result<(), String> = Fs::write_string(ark_toml, toml_content)
            match write_toml {
                Result::Ok(_) => {
                    init_templates::init_template_print_next_steps(project_name.clone(), template.clone())
                },
                Result::Err(e) => {
                    // write_string returns Result<(), String> — e is already a message.
                    stdio::eprintln(String_from("error creating ark.toml: ").concat(e))
                    Process::exit(1)
                },
            }
        },
        Result::Err(e) => {
            stdio::eprintln(String_from("error creating project: ").concat(e))
            Process::exit(1)
        },
    }
}
