use std::host::fs::Fs
use std::host::process::Process
use std::host::stdio::Stdio
use std::text
use diagnostics::record
use fmt
use main::args_record
fn fmt_write_or_check(input_file: String, output: String, original: String, check: bool, ok_label: String) -> i32 {
    if check {
        if !output.clone().eq(original.clone()) {
            Stdio::eprintln("fmt check failed: ".concat(input_file.clone()))
            return 1
        }
        Stdio::eprintln("ok: ".concat(input_file.clone()))
        return 0
    }
    let write_result: Result<(), String> = Fs::write_string(input_file.clone(), output.clone())
    match write_result {
        Result::Ok(_) => {
            Stdio::eprintln(ok_label.concat(input_file.clone()))
            return 0
        },
        Result::Err(e) => {
            Stdio::eprintln("error writing formatted file: ".concat(input_file.clone().concat(": ".concat(e))))
            return 1
        },
    }
}

fn cmd_fmt_one(opts: CliOptions, input_file: String) -> i32 {
    let read_result = Fs::read_to_string(input_file.clone())
    match read_result {
        Result::Err(e) => {
            Stdio::eprintln("error reading input: ".concat(input_file.clone().concat(": ".concat(e))))
            return 1
        },
        Result::Ok(text) => {
            let original = text.clone()
            if args_record::cli_fmt_fix(opts) {
                let fixed_opt = fmt::fix_source(text)
                match fixed_opt {
                    Option::None => {
                        Stdio::eprintln("fmt parse error: ".concat(input_file.clone()))
                        fmt_emit_parse_errors(original)
                        return 1
                    },
                    Option::Some(fixed) => {
                        return fmt_write_or_check(input_file.clone(), fixed, original, args_record::cli_fmt_check(opts), "fixed ")
                    },
                }
            }
            let formatted_opt = fmt::format_source(text)
            match formatted_opt {
                Option::None => {
                    Stdio::eprintln("fmt parse error: ".concat(input_file.clone()))
                    fmt_emit_parse_errors(original)
                    return 1
                },
                Option::Some(formatted) => {
                    return fmt_write_or_check(input_file.clone(), formatted, original, args_record::cli_fmt_check(opts), "formatted ")
                },
            }
        },
    }
}

pub fn cmd_fmt(opts: CliOptions) {
    let count = args_record::cli_fmt_input_count(opts)
    if count == 0 {
        let single = args_record::cli_input_file(opts)
        if single.len() == 0 {
            Stdio::eprintln("usage: arukellt fmt <file.ark>... [--check] [--fix]")
            Process::exit(2)
            return
        }
        let rc = cmd_fmt_one(opts, single)
        if rc != 0 {
            Process::exit(1)
        }
        return
    }
    let mut checked = 0
    let mut failed = 0
    let mut i = 0
    while i < count {
        let path = args_record::cli_fmt_input_at(opts, i)
        let rc = cmd_fmt_one(opts, path.clone())
        checked = checked + 1
        if rc != 0 {
            failed = failed + 1
        }
        i = i + 1
    }
    Stdio::eprintln("fmt: checked=".concat((checked).to_string().concat(" failed=".concat((failed).to_string()))))
    if failed > 0 {
        Process::exit(1)
    }
}

fn fmt_emit_parse_errors(text: String) {
    let count = fmt::format_parse_error_count(text.clone())
    let mut i = 0
    while i < count {
        let diag = fmt::format_parse_error_at(text.clone(), i)
        Stdio::eprintln(record::diagnostic_code(diag).concat(": ".concat(record::diagnostic_message(diag))))
        i = i + 1
    }
}
