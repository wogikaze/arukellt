use std::host::stdio

fn print_usage() {
    stdio::println("The Arukellt compiler")
    stdio::println("")
    stdio::println("Usage: arukellt <COMMAND>")
    stdio::println("")
    stdio::println("Commands:")
    stdio::println("  compile        Compile an .ark file to Wasm")
    stdio::println("  init           Initialize a new Arukellt project in the specified directory")
    stdio::println("  build          Build the project in the current directory (requires ark.toml)")
    stdio::println("  fmt            Format .ark source files")
    stdio::println("  run            Compile and run an .ark file")
    stdio::println("  check          Type-check an .ark file without compiling")
    stdio::println("  test           Discover and run tests")
    stdio::println("  targets        List available compile targets")
    stdio::println("  script         Manage and run project scripts")
    stdio::println("  component      Build, inspect and validate WebAssembly components")
    stdio::println("  lsp            Start the LSP server (stdio transport)")
    stdio::println("  debug-adapter  Start the DAP debug adapter (stdio transport)")
    stdio::println("  lint           Run lint rules on .ark source files")
    stdio::println("  analyze        Analyze a compiled Wasm binary")
    stdio::println("  doc            Look up standard library documentation for a symbol or module")
    stdio::println("  compose        Link multiple Wasm components into a single composed component")
    stdio::println("  help           Print this message or the help of the given subcommand(s)")
    stdio::println("")
    stdio::println("Options:")
    stdio::println("  -h, --help     Print help")
    stdio::println("  -V, --version  Print version")
    stdio::println("  --json         Emit machine-readable JSON diagnostics")
    stdio::println("  --output json  Alias for --json on diagnostic/check output")
    stdio::println("  --wit <path>   Add a WIT import file for component compilation")
    stdio::println("  --list         List available lint rules (with `lint` command)")
    stdio::println("  --local        Lint local (parse-only) rules; no module resolve")
    stdio::println("  --allow <rule> Allow (suppress) a lint rule by W-code or name")
    stdio::println("  --deny <rule>  Deny (escalate to error) a lint rule by W-code or name")
    stdio::println("  --strip-debug  Strip debug sections (name, source map) from output")
}

fn print_version() {
    stdio::println("arukellt 0.1.0")
}
// ── Usage / Version ──────────────────────────────────────────────────────────
