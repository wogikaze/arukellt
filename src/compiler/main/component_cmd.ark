use std::host::process
use std::host::stdio
use main::args_record

pub fn cmd_component_inspect(opts: CliOptions) {
    stdio::eprintln("error: component inspect is not yet implemented in the selfhost compiler")
    stdio::eprintln("")
    stdio::eprintln("Use wasm-tools instead:")
    stdio::eprintln(concat("  wasm-tools component wit ", args_record::cli_input_file(opts)))
    process::exit(1)
}

pub fn cmd_component_validate(opts: CliOptions) {
    stdio::eprintln("error: component validate is not yet implemented in the selfhost compiler")
    stdio::eprintln("")
    stdio::eprintln("Use wasm-tools instead:")
    stdio::eprintln(concat("  wasm-tools validate ", args_record::cli_input_file(opts)))
    process::exit(1)
}

pub fn cmd_component_build(opts: CliOptions) {
    args_record::cli_set_emit_mode(opts, "component")
    args_record::cli_set_target(opts, "wasm32-gc")
    args_record::cli_set_wasi_version(opts, "wasi-p2")
}
