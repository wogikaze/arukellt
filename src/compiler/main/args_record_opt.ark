pub fn parse_opt_level_value(value: String, current: i32) -> i32 {
    if len(value.clone()) != 1 {
        return current
    }
    let ch = value.clone().byte_at(0)
    if ch == 48 {
        return 0
    }
    if ch == 49 {
        return 1
    }
    if ch == 50 {
        return 2
    }
    current
}
