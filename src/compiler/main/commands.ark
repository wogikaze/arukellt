use std::prelude::{clone}
use main::kinds
fn parse_command(name: String) -> i32 {
    let ascii_cmd = parse_ascii_core_command(name)
    if ascii_cmd != kinds::CMD_UNKNOWN() {
        return ascii_cmd
    }
    parse_named_command(name)
}

fn parse_ascii_core_command(name: String) -> i32 {
    let name_len = len(clone(name))
    if name_len == 5 && clone(name).byte_at(0) == 99 && clone(name).byte_at(1) == 104 && clone(name).byte_at(2) == 101 && clone(name).byte_at(3) == 99 && clone(name).byte_at(4) == 107 {
        return kinds::CMD_CHECK()
    }
    if name_len == 7 &&
    clone(name).byte_at(0) == 99 &&
    clone(name).byte_at(1) == 111 &&
    clone(name).byte_at(2) == 109 &&
    clone(name).byte_at(3) == 112 &&
    clone(name).byte_at(4) == 105 &&
    clone(name).byte_at(5) == 108 &&
    clone(name).byte_at(6) == 101 {
        return kinds::CMD_COMPILE()
    }
    if name_len == 5 && clone(name).byte_at(0) == 112 && clone(name).byte_at(1) == 97 && clone(name).byte_at(2) == 114 && clone(name).byte_at(3) == 115 && clone(name).byte_at(4) == 101 {
        return kinds::CMD_PARSE()
    }
    if name_len == 4 && clone(name).byte_at(0) == 104 && clone(name).byte_at(1) == 101 && clone(name).byte_at(2) == 108 && clone(name).byte_at(3) == 112 {
        return kinds::CMD_HELP()
    }
    if name_len == 7 &&
    clone(name).byte_at(0) == 118 &&
    clone(name).byte_at(1) == 101 &&
    clone(name).byte_at(2) == 114 &&
    clone(name).byte_at(3) == 115 &&
    clone(name).byte_at(4) == 105 &&
    clone(name).byte_at(5) == 111 &&
    clone(name).byte_at(6) == 110 {
        return kinds::CMD_VERSION()
    }
    kinds::CMD_UNKNOWN()
}

fn parse_named_command(name: String) -> i32 {
    let implemented = parse_implemented_command(clone(name))
    if implemented != kinds::CMD_UNKNOWN() {
        return implemented
    }
    let service = parse_service_command(clone(name))
    if service != kinds::CMD_UNKNOWN() {
        return service
    }
    parse_reserved_command(name)
}

fn parse_implemented_command(name: String) -> i32 {
    if cli_str_eq(clone(name), "parse") {
        return kinds::CMD_PARSE()
    }
    if cli_str_eq(clone(name), "compile") {
        return kinds::CMD_COMPILE()
    }
    if cli_str_eq(clone(name), "check") {
        return kinds::CMD_CHECK()
    }
    if cli_str_eq(clone(name), "run") {
        return kinds::CMD_RUN()
    }
    if cli_str_eq(clone(name), "build") {
        return kinds::CMD_BUILD()
    }
    if cli_str_eq(clone(name), "test") {
        return kinds::CMD_TEST()
    }
    if cli_str_eq(clone(name), "help") {
        return kinds::CMD_HELP()
    }
    if cli_str_eq(clone(name), "version") {
        return kinds::CMD_VERSION()
    }
    if cli_str_eq(clone(name), "init") {
        return kinds::CMD_INIT()
    }
    if cli_str_eq(clone(name), "fmt") {
        return kinds::CMD_FMT()
    }
    if cli_str_eq(clone(name), "targets") {
        return kinds::CMD_TARGETS()
    }
    if cli_str_eq(clone(name), "script") {
        return kinds::CMD_SCRIPT()
    }
    if cli_str_eq(clone(name), "component") {
        return kinds::CMD_COMPONENT()
    }
    if cli_str_eq(clone(name), "lint") {
        return kinds::CMD_LINT()
    }
    if cli_str_eq(clone(name), "analyze") {
        return kinds::CMD_ANALYZE()
    }
    if cli_str_eq(clone(name), "doc") {
        return kinds::CMD_DOC()
    }
    if cli_str_eq(clone(name), "compose") {
        return kinds::CMD_COMPOSE()
    }
    kinds::CMD_UNKNOWN()
}

fn parse_service_command(name: String) -> i32 {
    if cli_str_eq(clone(name), "lsp") {
        return kinds::CMD_LSP()
    }
    if cli_str_eq(clone(name), "debug-adapter") {
        return kinds::CMD_DAP()
    }
    if cli_str_eq(clone(name), "ide-analyze") {
        return kinds::CMD_IDE_ANALYZE()
    }
    kinds::CMD_UNKNOWN()
}

fn parse_reserved_command(name: String) -> i32 {
    kinds::CMD_UNKNOWN()
}

fn cli_str_eq(a: String, b: String) -> bool {
    let n = len(clone(a))
    if n != len(clone(b)) {
        return false
    }
    let mut i = 0
    while i < n {
        if clone(a).byte_at(i) != clone(b).byte_at(i) {
            return false
        }
        i = i + 1
    }
    true
}
