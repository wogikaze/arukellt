fn native_c_core_capability_status_row_off_at(index: i32) -> i32 {
    if index < 0 || index >= 296 {
        return 0
    }
    let chunk = index / 16
    let local = index - chunk * 16
    return table_blob::table_blob_i32_from_hex8(native_c_core_capability_status_row_off_hex_chunk(chunk), local * 8)
}

