use corehir::callee_spelling
use mir::lower::ctx_fn_index
fn ctx_fn_return_type_name(ctx: LowerCtx, name: String) -> String {
    let found = ctx_fn_index::ctx_fn_index_find(ctx, name.clone())
    if found >= 0 {
        return ctx_fn_index::ctx_fn_index_return_type_name_at(ctx, found)
    }
    let qualified = ctx_fn_index::ctx_qualified_fn_index_find(ctx, name.clone())
    if qualified >= 0 {
        return ctx_fn_index::ctx_qualified_fn_return_type_name_at(ctx, qualified)
    }
    // Loaded-module calls keep `module::Type::method`; the fn index holds the
    // impl method under `Type::method`. Resolve that spelling before the
    // last-segment fallback so call destinations get the constructed type.
    let variants = callee_spelling::callee_spelling_variants(name.clone())
    let mut vi = 0
    while vi < len(variants) {
        let variant = get_unchecked(variants, vi).clone()
        let variant_found = ctx_fn_index::ctx_fn_index_find(ctx, variant.clone())
        if variant_found >= 0 {
            return ctx_fn_index::ctx_fn_index_return_type_name_at(ctx, variant_found)
        }
        vi = vi + 1
    }
    let base_name = mono_strip_suffix_for_lookup(name.clone())
    if !base_name.clone().eq(name.clone()) {
        let base_found = ctx_fn_index::ctx_fn_index_find(ctx, base_name.clone())
        if base_found >= 0 {
            return ctx_fn_index::ctx_fn_index_return_type_name_at(ctx, base_found)
        }
    }
    let nlen = len(name)
    let mut colon_pos = 0 - 1
    let mut ci = nlen - 1
    while ci >= 0 {
        if name.byte_at(ci) == 58 {
            colon_pos = ci
            ci = 0 - 1
        }
        ci = ci - 1
    }
    if colon_pos >= 0 {
        let short = name.slice(colon_pos + 1, nlen)
        let short_found = ctx_fn_index::ctx_fn_index_find(ctx, short)
        if short_found >= 0 {
            return ctx_fn_index::ctx_fn_index_return_type_name_at(ctx, short_found)
        }
    }
    // Export-style mangling: module_path__FnName (not a mono suffix).
    let dunder_short = short_name_after_last_dunder(name.clone())
    if len(dunder_short) > 0 {
        let dunder_found = ctx_fn_index::ctx_fn_index_find(ctx, dunder_short.clone())
        if dunder_found >= 0 {
            return ctx_fn_index::ctx_fn_index_return_type_name_at(ctx, dunder_found)
        }
    }
    ""
}

// Bare name after the last "__" (parser_token_state__Token_float_val → Token_float_val).
fn short_name_after_last_dunder(name: String) -> String {
    let name_len = len(name)
    let mut i = name_len - 2
    while i >= 0 {
        if name.byte_at(i) == 95 && name.byte_at(i + 1) == 95 {
            return name.slice(i + 2, name_len)
        }
        i = i - 1
    }
    String_new()
}

// Strip mono type suffix from a mangled function name for fn_index lookup.
fn mono_strip_suffix_for_lookup(name: String) -> String {
    let name_len = len(name)
    let mut sep_positions = Vec::new<i32>()
    let mut i = 0
    while i < name_len - 1 {
        if name.byte_at(i) == 95 && name.byte_at(i + 1) == 95 {
            push(sep_positions, i)
        }
        i = i + 1
    }
    let sep_count = len(sep_positions)
    if sep_count == 0 {
        return name
    }
    let mut si = 0
    while si < sep_count {
        let sep_pos = get_unchecked(sep_positions, si)
        let suffix = name.slice(sep_pos + 2, name_len)
        if mono_suffix_looks_like_type_keys(suffix) {
            return name.slice(0, sep_pos)
        }
        si = si + 1
    }
    // Module-qualified exports (parser_token_state__Token_float_val) are not
    // mono suffixes — leave the name unchanged so callers can resolve the
    // bare FnName via short_name_after_last_dunder.
    name
}

fn mono_suffix_looks_like_type_keys(suffix: String) -> bool {
    let slen = len(suffix)
    if slen == 0 {
        return false
    }
    let mut start = 0
    let mut i = 0
    while i < slen {
        if i < slen - 1 && suffix.byte_at(i) == 95 && suffix.byte_at(i + 1) == 95 {
            let key = suffix.slice(start, i)
            if !mono_type_key_looks_valid(key) {
                return false
            }
            start = i + 2
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if start <= slen {
        return mono_type_key_looks_valid(suffix.slice(start, slen))
    }
    false
}

fn mono_type_key_looks_valid(key: String) -> bool {
    if key.clone().eq("i32") ||
    key.clone().eq("i64") ||
    key.clone().eq("f64") ||
    key.clone().eq("f32") ||
    key.clone().eq("bool") ||
    key.clone().eq("char") ||
    key.clone().eq("String") ||
    key.clone().eq("string") {
        return true
    }
    // Nominal mono keys are PascalCase type names (Point), not snake_case
    // function tails (Token_float_val).
    if len(key) > 0 {
        let first = key.byte_at(0)
        if first >= 65 && first <= 90 {
            let mut ki = 1
            while ki < len(key) {
                if key.byte_at(ki) == 95 {
                    return false
                }
                ki = ki + 1
            }
            return true
        }
    }
    false
}
