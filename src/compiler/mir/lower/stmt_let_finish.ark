use std::prelude::{eq}
use std::text
use mir::lower::ast_node
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_lookup
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_mono
use mir::lower::ctx_types
use mir::lower::ann_types
use mir::lower::stmt_let_closure
use mir::lower::stmt_let_store
use mir::lower_kinds
use mir::value_types
fn mir_finish_let_stmt(mut ctx: LowerCtx, node: AstNode, vt: i32, pre_val_idx: i32, pre_init_kind: i32) {
    let ta_count = ast_node::node_type_ann_count(node)
    let child_count = ast_node::node_child_count(node)
    let local_idx = ctx_api_local_alloc::ctx_alloc_local(ctx, ast_node::node_text(node), vt)
    apply_let_annotation_type(ctx, node, local_idx, ta_count)
    if child_count >= 1 {
        stmt_let_store::emit_let_initializer_store(ctx, node, vt, local_idx, pre_val_idx, pre_init_kind, ta_count)
        stmt_let_closure::flush_let_closure_binding(ctx, node, pre_init_kind)
        apply_vec_ctor_fn_turbofish_name(ctx, node, local_idx, pre_val_idx, ta_count)
    }
}

// `let v = Vec::new<fn(A) -> R>()` / `Vec::new<(A, B)>()` records no mono
// instance for fn/tuple elements (fn/tuple turbofish skips recording per
// #845), so the unused-specialization fallback can rename the callee to
// Vec__new__i32 and mark both temps vec:i32. The turbofish type argument is
// the authoritative element spelling; restore vec:fnref / vec:tuple:* on the
// binding and the constructor temp so emit picks the ref-element array
// layout on wasm32-gc (#874, #888).
fn apply_vec_ctor_fn_turbofish_name(mut ctx: LowerCtx, node: AstNode, local_idx: i32, val_idx: i32, ta_count: i32) {
    if ta_count > 0 {
        return
    }
    let init = ast_node::node_child_at(node, 0)
    if ast_node::node_child_count(init) < 1 {
        return
    }
    let callee = ast_node::node_child_at(init, 0)
    let callee_name = ast_node::node_text(callee)
    if !eq(callee_name.clone(), "Vec::new") &&
    !eq(callee_name.clone(), "Vec::with_capacity") &&
    !eq(callee_name.clone(), "Vec__new") &&
    !eq(callee_name.clone(), "Vec__with_capacity") {
        return
    }
    if ast_node::node_child_count(callee) < 2 {
        return
    }
    let elem = ast_node::node_child_at(callee, 1)
    if ast_node::node_kind_is(elem, lower_kinds::NK_TYPE_TUPLE()) {
        let tuple_name = ann_types::mir_local_type_name_from_ann(elem, 0)
        if len(tuple_name) == 0 {
            return
        }
        let vec_ty = String_from("vec:").concat(tuple_name)
        ctx_api_local_types::ctx_set_local_type(ctx, local_idx, vec_ty.clone())
        ctx_api_local_types::ctx_set_local_vt(ctx, local_idx, value_types::VT_GC_REF())
        if val_idx >= 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, val_idx, vec_ty.clone())
            ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_GC_REF())
        }
        return
    }
    if !ast_node::node_kind_is(elem, lower_kinds::NK_TYPE_FN()) {
        return
    }
    ctx_api_local_types::ctx_set_local_type(ctx, local_idx, String_from("vec:fnref"))
    // Mirror the annotated `let v: Vec<fn>` path: fn-element vecs are
    // managed heaps on both backends, so the binding and the constructor
    // temp take VT_GC_REF rather than the legacy i32/ref vec slots (#874).
    ctx_api_local_types::ctx_set_local_vt(ctx, local_idx, value_types::VT_GC_REF())
    if val_idx >= 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, val_idx, String_from("vec:fnref"))
        ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_GC_REF())
    }
}

fn apply_let_annotation_type(mut ctx: LowerCtx, node: AstNode, local_idx: i32, ta_count: i32) {
    if ta_count >= 1 {
        let ta = ast_node::node_type_ann_at(node, 0)
        let ta_name = ast_node::node_text(ta)
        let local_type_name = ctx_mono_type_params::ctx_resolve_mono_type_name(
            ctx,
            ann_types::mir_local_type_name_from_ann(ta, ctx_struct_lookup::ctx_struct_field_count(ctx, ta_name.clone()))
        )
        let local_type_name = ctx_struct_mono::ctx_derive_generic_struct_type_name(ctx, local_type_name)
        if len(local_type_name) > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, local_idx, local_type_name)
            // Struct/enum annotations name GC aggregates too; keeping VT_I32
            // on a struct local makes enum payload construction register a
            // scalar variant and emit i32.wrap on a ref. Mirrors the
            // unannotated literal path (GC_REF either way).
            if let_annotation_is_gc_ref_type(ctx, local_type_name) {
                ctx_api_local_types::ctx_set_local_vt(ctx, local_idx, value_types::VT_GC_REF())
            }
        }
    }
}

fn let_annotation_is_gc_ref_type(ctx: LowerCtx, local_type_name: String) -> bool {
    if local_type_name.clone().starts_with("enum:") {
        return true
    }
    if local_type_name.clone().starts_with("vec:") || local_type_name.clone().starts_with("hashmap:") {
        return true
    }
    if local_type_name.clone().starts_with("Option_") ||
    local_type_name.clone().starts_with("option:") ||
    local_type_name.clone().starts_with("Option:") ||
    local_type_name.clone().starts_with("Result_") ||
    local_type_name.clone().starts_with("result:") ||
    local_type_name.clone().starts_with("Result:") {
        return true
    }
    ctx_struct_layout::ctx_is_registered_struct_type(ctx, local_type_name.clone()) ||
    ctx_struct_layout::ctx_is_registered_enum_type(ctx, local_type_name.clone())
}
