use mir::lower::ast_node
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_lookup
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_mono
use mir::lower::ctx_types
use mir::lower::ann_types
use mir::lower::stmt_let_closure
use mir::lower::stmt_let_store
use mir::value_types

fn mir_finish_let_stmt(ctx: LowerCtx, node: AstNode, vt: i32, pre_val_idx: i32, pre_init_kind: i32) {
    let ta_count = ast_node::node_type_ann_count(node)
    let child_count = ast_node::node_child_count(node)
    let local_idx = ctx_api_local_alloc::ctx_alloc_local(ctx, ast_node::node_text(node), vt)
    apply_let_annotation_type(ctx, node, local_idx, ta_count)
    if child_count >= 1 {
        stmt_let_store::emit_let_initializer_store(ctx, node, vt, local_idx, pre_val_idx, pre_init_kind, ta_count)
        stmt_let_closure::flush_let_closure_binding(ctx, node, pre_init_kind)
    }
}

fn apply_let_annotation_type(ctx: LowerCtx, node: AstNode, local_idx: i32, ta_count: i32) {
    if ta_count >= 1 {
        let ta = ast_node::node_type_ann_at(node, 0)
        let ta_name = ast_node::node_text(ta)
        let local_type_name = ctx_mono_type_params::ctx_resolve_mono_type_name(
            ctx,
            ann_types::mir_local_type_name_from_ann(ta, ctx_struct_lookup::ctx_struct_field_count(ctx, clone(ta_name)))
        )
        let local_type_name = ctx_struct_mono::ctx_derive_generic_struct_type_name(ctx, local_type_name)
        if len(local_type_name) > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, local_idx, local_type_name)
            // Struct/enum annotations name GC aggregates too; keeping VT_I32
            // on a struct local makes enum payload construction register a
            // scalar variant and emit i32.wrap on a ref. Mirrors the
            // unannotated literal path (GC_REF either way).
            if let_annotation_is_gc_ref_type(ctx, local_type_name) {
                ctx_api_local_types::ctx_set_local_vt(ctx, local_idx, value_types::VT_GC_REF())
            }
        }
    }
}

fn let_annotation_is_gc_ref_type(ctx: LowerCtx, local_type_name: String) -> bool {
    if starts_with(clone(local_type_name), "enum:") {
        return true
    }
    if starts_with(clone(local_type_name), "vec:") || starts_with(clone(local_type_name), "hashmap:") {
        return true
    }
    if starts_with(clone(local_type_name), "Option_") ||
    starts_with(clone(local_type_name), "option:") ||
    starts_with(clone(local_type_name), "Option:") ||
    starts_with(clone(local_type_name), "Result_") ||
    starts_with(clone(local_type_name), "result:") ||
    starts_with(clone(local_type_name), "Result:") {
        return true
    }
    ctx_struct_layout::ctx_is_registered_struct_type(ctx, clone(local_type_name)) ||
    ctx_struct_layout::ctx_is_registered_enum_type(ctx, clone(local_type_name))
}
