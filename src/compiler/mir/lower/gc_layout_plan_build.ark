use std::host::process::Process
use std::host::stdio
use std::text
use corehir::kinds
use corehir::type_id
use corehir::type_table
use mir::gc_layout_plan
use mir::gc_layout_slot_bind
use mir::lower::ctx_struct_layout
use mir::gc_layout_plan_validator
use mir::module_gc_enum
use mir::module_gc_layout_plan
use mir::module_gc_struct
use mir::module_spine
use wasm::emit_target
fn gc_layout_plan_name_is_fn(name: String) -> bool {
    name.clone().eq("fn") ||
    name.clone().eq("fnref") ||
    name.clone().starts_with("fnsig:") ||
    name.starts_with("fn(")
}

fn gc_layout_plan_name_is_i32(name: String) -> bool {
    name.clone().eq("i32") || name.clone().eq("I32") ||
    name.clone().eq("bool") || name.clone().eq("char") ||
    name.clone().eq("u8") || name.clone().eq("i8") ||
    name.clone().eq("u16") || name.clone().eq("u32") ||
    name.clone().eq("i16")
}

fn gc_layout_plan_vec_offset_from_elem(table: TypeTable, elem_id: TypeId) -> i32 {
    if !type_id::type_id_is_valid(elem_id) {
        return 0 - 1
    }
    let elem = type_table::TypeTable_lookup(table, elem_id)
    let kind = type_table::type_entry_kind(elem)
    let name = type_table::type_entry_name(elem)
    if kind == kinds::TYPE_KIND_STRING() {
        return 19
    }
    if kind == kinds::TYPE_KIND_OPTION() ||
    kind == kinds::TYPE_KIND_RESULT() ||
    kind == kinds::TYPE_KIND_ENUM() {
        return 30
    }
    if kind == kinds::TYPE_KIND_PRIMITIVE() {
        if name.clone().eq("v128") || name.clone().eq("V128") { return 21 }
        if name.clone().eq("i64") || name.clone().eq("I64") { return 22 }
        if name.clone().eq("f64") || name.clone().eq("F64") { return 23 }
        if gc_layout_plan_name_is_fn(name.clone()) { return 28 }
        if gc_layout_plan_name_is_i32(name) { return 10 }
    }
    // Nested containers and user aggregates use the structref-array Vec layout.
    25
}

// The element name of a vec: / Vec< / Vec_ spelling, empty when the
// container has no single element segment.
fn gc_layout_plan_vec_elem_name(name: String) -> String {
    if name.clone().starts_with(String_from("vec:")) {
        return name.clone().slice(4, len(name))
    }
    if name.clone().starts_with(String_from("Vec<")) && name.clone().ends_with(String_from(">")) {
        return name.clone().slice(4, len(name) - 1)
    }
    String_new()
}

// The element name resolves to a declared aggregate entry in the type
// table. Single-letter struct names (vec:P) collide with the
// unsubstituted-type-param spelling, so a registered struct/enum name
// must win over the dead-shell i32 fallback.
fn gc_layout_plan_elem_is_declared_aggregate(table: TypeTable, elem: String) -> bool {
    if len(elem) == 0 {
        return false
    }
    let count = type_table::TypeTable_entry_count(table)
    let mut i = 0
    while i < count {
        let e = type_table::TypeTable_entry_at(table, i)
        let k = type_table::type_entry_kind(e)
        if k == kinds::TYPE_KIND_STRUCT() || k == kinds::TYPE_KIND_ENUM() {
            let en = type_table::type_entry_name(e)
            if en.clone().eq(elem.clone()) {
                return true
            }
            if en.clone().starts_with(String_from("struct:")) &&
            ctx_struct_layout::strip_struct_type_prefix(en).eq(elem.clone()) {
                return true
            }
        }
        i = i + 1
    }
    false
}

fn gc_layout_plan_vec_offset_from_name(table: TypeTable, name: String) -> i32 {
    if name.clone().starts_with("vec:String") ||
    name.clone().starts_with("vec:string") ||
    name.clone().starts_with("Vec<String>") ||
    name.clone().starts_with("Vec<string>") {
        return 19
    }
    if name.clone().starts_with("vec:v128") || name.clone().starts_with("vec:V128") {
        return 21
    }
    if name.clone().starts_with("vec:i64") || name.clone().starts_with("vec:I64") {
        return 22
    }
    if name.clone().starts_with("vec:f64") || name.clone().starts_with("vec:F64") {
        return 23
    }
    if name.clone().starts_with("vec:fn") || name.clone().starts_with("Vec<fn") {
        return 28
    }
    if name.clone().starts_with("vec:Option") ||
    name.clone().starts_with("vec:Result") ||
    name.clone().starts_with("vec:option:") ||
    name.clone().starts_with("vec:result:") ||
    name.clone().starts_with("vec:enum:") ||
    name.clone().starts_with("Vec<Option") ||
    name.clone().starts_with("Vec<Result") {
        return 30
    }
    if name.clone().starts_with("vec:Vec") ||
    name.clone().starts_with("vec:vec:") {
        return 25
    }
    if name.clone().starts_with("Vec<") &&
    !(name.clone().contains("i32") || name.clone().contains("I32") ||
        name.clone().contains("bool") || name.clone().contains("char")) {
        return 25
    }
    if gc_layout_plan_elem_is_declared_aggregate(
        table,
        gc_layout_plan_vec_elem_name(name.clone())
    ) {
        return 25
    }
    10
}

fn gc_layout_plan_hashmap_offset_from_types(
    table: TypeTable,
    key_id: TypeId,
    value_id: TypeId
) -> i32 {
    if !type_id::type_id_is_valid(key_id) || !type_id::type_id_is_valid(value_id) {
        return 0 - 1
    }
    let key = type_table::TypeTable_lookup(table, key_id)
    let value = type_table::TypeTable_lookup(table, value_id)
    let key_kind = type_table::type_entry_kind(key)
    let value_kind = type_table::type_entry_kind(value)
    let key_name = type_table::type_entry_name(key)
    let value_name = type_table::type_entry_name(value)
    let key_string = key_kind == kinds::TYPE_KIND_STRING()
    let value_string = value_kind == kinds::TYPE_KIND_STRING()
    let key_i32 = key_kind == kinds::TYPE_KIND_PRIMITIVE() && gc_layout_plan_name_is_i32(key_name)
    let value_i32 = value_kind == kinds::TYPE_KIND_PRIMITIVE() && gc_layout_plan_name_is_i32(value_name.clone())
    let value_fn = value_kind == kinds::TYPE_KIND_PRIMITIVE() && gc_layout_plan_name_is_fn(value_name)
    if key_i32 && value_i32 { return 10 }
    if key_string && value_i32 { return 16 }
    if key_i32 && value_string { return 17 }
    if key_string && value_string { return 18 }
    if key_i32 && value_fn { return 31 }
    if key_string && value_fn { return 32 }
    16
}

fn gc_layout_plan_hashmap_offset_from_name(name: String) -> i32 {
    if name.clone().starts_with("hashmap:i32fn") { return 31 }
    if name.clone().starts_with("hashmap:strfn") { return 32 }
    if name.clone().starts_with("hashmap:i32str") ||
    name.clone().starts_with("hashmap:i32:String") { return 17 }
    if name.clone().starts_with("hashmap:strstr") ||
    name.clone().starts_with("hashmap:String:String") { return 18 }
    if name.clone().starts_with("hashmap:i32i32") { return 10 }
    16
}

fn gc_layout_plan_fixed_offset_for_entry(table: TypeTable, entry: TypeEntry) -> i32 {
    let kind = type_table::type_entry_kind(entry)
    if kind == kinds::TYPE_KIND_STRING() {
        return 0
    }
    if kind == kinds::TYPE_KIND_OPTION() ||
    kind == kinds::TYPE_KIND_RESULT() ||
    kind == kinds::TYPE_KIND_ENUM() {
        return 14
    }
    if kind == kinds::TYPE_KIND_HASHSET() {
        return 16
    }
    if kind == kinds::TYPE_KIND_VEC() {
        if type_table::type_entry_type_param_count(entry) == 1 {
            let typed = gc_layout_plan_vec_offset_from_elem(
                table,
                type_table::type_entry_type_param_at(entry, 0)
            )
            if typed >= 0 { return typed }
        }
        return gc_layout_plan_vec_offset_from_name(table, type_table::type_entry_name(entry))
    }
    if kind == kinds::TYPE_KIND_HASHMAP() {
        if type_table::type_entry_type_param_count(entry) == 2 {
            let typed = gc_layout_plan_hashmap_offset_from_types(
                table,
                type_table::type_entry_type_param_at(entry, 0),
                type_table::type_entry_type_param_at(entry, 1)
            )
            if typed >= 0 { return typed }
        }
        return gc_layout_plan_hashmap_offset_from_name(type_table::type_entry_name(entry))
    }
    0 - 1
}

fn gc_layout_plan_bind_fixed_entries(mut plan: MirGcLayoutPlan, table: TypeTable) {
    let count = type_table::TypeTable_entry_count(table)
    let mut index = 0
    while index < count {
        let entry = type_table::TypeTable_entry_at(table, index)
        let offset = gc_layout_plan_fixed_offset_for_entry(table, entry)
        if offset >= 0 {
            gc_layout_plan::mir_gc_layout_plan_bind(
                plan,
                type_table::type_entry_id(entry),
                gc_layout_plan::MIR_GC_LAYOUT_SOURCE_FIXED_OFFSET(),
                offset
            )
        }
        index = index + 1
    }
}

fn gc_layout_plan_bind_struct_slots(
    module: MirModule
) {
    let count = module_gc_struct::MirModule_gc_struct_sig_count(module)
    let mut slot = 0
    while slot < count {
        gc_layout_slot_bind::mir_gc_layout_bind_struct_slot(module, slot)
        slot = slot + 1
    }
}

fn gc_layout_plan_bind_enum_variant_slots(
    module: MirModule
) {
    let count = module_gc_enum::MirModule_gc_enum_variant_sig_count(module)
    let mut slot = 0
    while slot < count {
        gc_layout_slot_bind::mir_gc_layout_bind_enum_variant_slot(module, slot)
        slot = slot + 1
    }
}

fn mir_module_build_gc_layout_plan(mut module: MirModule, target: String) {
    // #851 Phase 3: bind into the module-held plan. Registrations already
    // bound their slots incrementally; these sweeps are idempotent
    // overwrites that also cover modules built outside the lowering ctx.
    let mut plan = module_gc_layout_plan::MirModule_gc_layout_plan(module)
    if emit_target::is_gc_target(target) {
        let table = module_spine::MirModule_type_table(module)
        gc_layout_plan_bind_fixed_entries(plan, table)
        gc_layout_plan_bind_struct_slots(module)
        gc_layout_plan_bind_enum_variant_slots(module)
    }
    if !gc_layout_plan_validator::mir_gc_layout_plan_valid(plan) {
        stdio::eprintln("compiler ICE: invalid MIR GC layout plan")
        Process::exit(1)
    }
    module_gc_layout_plan::MirModule_set_gc_layout_plan(module, plan)
}
