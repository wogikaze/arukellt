use std::prelude::{clone}
use std::text
use mir::lower::ast_node
use mir::lower_kinds
use mir::lower::aggregate
use mir::lower::assign
use mir::lower::binary_emit
use mir::lower::binary_type_names
use mir::lower::body_aggregate_assign_field
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_fn_exists
use mir::lower::ctx_fn_index
use mir::lower::value_variants
use mir::value_types
fn lower_assign_expr(mut ctx: LowerCtx, node: AstNode) -> i32 {
    let child_count = ast_node::node_child_count(node)
    if child_count >= 2 {
        let target = ast_node::node_child_at(node, 0)
        let value = ast_node::node_child_at(node, 1)
        if ast_node::node_kind_is(target, lower_kinds::NK_IDENT()) {
            let val_idx = if mir_assign_value_is_fn_pair(ctx, target, value) {
                value_variants::lower_function_value(ctx, ast_node::node_text(value))
            } else {
                lower_expr(ctx, value)
            }
            assign::mir_emit_ident_assign(ctx, ast_node::node_text(target), val_idx)
        }
        if ast_node::node_kind_is(target, lower_kinds::NK_FIELD_ACCESS()) {
            let struct_idx = body_aggregate_assign_field::lower_field_assign_base(ctx, target)
            if struct_idx >= 0 {
                let val_idx = lower_expr(ctx, value)
                assign::mir_emit_field_assign(
                    ctx,
                    ast_node::node_text(target),
                    struct_idx,
                    val_idx
                )
            }
        }
    }
    0 - 1
}

fn lower_field_access_expr(mut ctx: LowerCtx, node: AstNode) -> i32 {
    let child_count = ast_node::node_child_count(node)
    if child_count >= 1 {
        let base = ast_node::node_child_at(node, 0)
        let base_idx = lower_expr(ctx, base)
        return aggregate::mir_emit_field_access(ctx, ast_node::node_text(node), base_idx)
    }
    0 - 1
}

fn lower_index_expr(mut ctx: LowerCtx, node: AstNode) -> i32 {
    let child_count = ast_node::node_child_count(node)
    if child_count >= 2 {
        let base = ast_node::node_child_at(node, 0)
        let idx_expr = ast_node::node_child_at(node, 1)
        let base_idx = lower_expr(ctx, base)
        let base_type = ctx_mono_type_params::ctx_resolve_mono_type_name(
            ctx,
            ctx_get_local_type(ctx, base_idx)
        )
        if !binary_type_names::mir_is_primitive_operator_type(clone(base_type)) {
            let ov_callee = clone(base_type).concat("::index")
            if ctx_fn_exists(ctx, clone(ov_callee)) != 0 {
                let _index_idx = lower_expr(ctx, idx_expr)
                return binary_emit::mir_emit_overloaded_binary_call(ctx, ov_callee)
            }
        }
        let index_idx = lower_expr(ctx, idx_expr)
        return aggregate::mir_emit_array_index(ctx, base_idx, index_idx)
    }
    0 - 1
}

// `f = answer` where f is a fn-valued local must store the fn pair,
// not the scalar result of an implicit 0-param call (#884).
fn mir_assign_value_is_fn_pair(ctx: LowerCtx, target: AstNode, value: AstNode) -> bool {
    if !ast_node::node_kind_is(value, lower_kinds::NK_IDENT()) {
        return false
    }
    let target_idx = ctx_api_local_alloc::ctx_lookup_local(ctx, ast_node::node_text(target))
    if target_idx < 0 || ctx_api_local_types::ctx_local_vt(ctx, target_idx) != value_types::VT_FUNCREF() {
        return false
    }
    let value_name = ast_node::node_text(value)
    if ctx_api_local_alloc::ctx_lookup_local(ctx, clone(value_name)) >= 0 {
        return false
    }
    ctx_fn_index::ctx_fn_index_find(ctx, value_name) >= 0
}
