use collections::name_index
fn ctx_variant_count(ctx: LowerCtx) -> i32 {
    ctx.variant_names.len()
}

fn ctx_variant_name_at(ctx: LowerCtx, index: i32) -> String {
    get_unchecked(ctx.variant_names, index).clone()
}

fn ctx_variant_tag_at(ctx: LowerCtx, index: i32) -> i32 {
    get_unchecked(ctx.variant_tags, index)
}

fn ctx_variant_push_tag(mut ctx: LowerCtx, name: String, tag: i32) {
    let index = ctx.variant_names.len()
    name_index::name_index_insert_first(ctx.variant_name_first, name.clone(), index)
    let key = variant_enum_variant_key(name.clone())
    let best = name_index::name_index_get(ctx.variant_key_best, key.clone())
    if best < 0 || name.len() > get_unchecked(ctx.variant_names, best).len() {
        name_index::name_index_set(ctx.variant_key_best, key, index)
    }
    push(ctx.variant_names, name)
    push(ctx.variant_tags, tag)
}

// Exact-name index, else the index of the longest registered name sharing the
// Enum::Variant key (module-aliased types::WitType::Bool to WitType::Bool).
// The fallback must return the slot index, not the stored tag: callers
// dereference it through ctx_variant_tag_at and ctx_variant_name_at, and a
// tag value re-read as an index silently maps every qualified variant to an
// unrelated entry (module qualified variant patterns compared as tag 0).
fn ctx_variant_name_index(ctx: LowerCtx, name: String) -> i32 {
    let first = name_index::name_index_get(ctx.variant_name_first, name.clone())
    if first >= 0 {
        return first
    }
    name_index::name_index_get(ctx.variant_key_best, variant_enum_variant_key(name))
}

/// Last two `::`-separated segments (`Enum::Variant`), or the whole name.
///
/// Lets `types::WitType::Bool` and `WitType::Bool` share one lookup key without
/// treating bare `Bool` as an alias for every `*::Bool` variant.
fn variant_enum_variant_key(name: String) -> String {
    let n = name.len()
    let mut last_sep = 0 - 1
    let mut prev_sep = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            prev_sep = last_sep
            last_sep = i
            i = i + 2
            continue
        }
        i = i + 1
    }
    if last_sep < 0 {
        return name
    }
    if prev_sep < 0 {
        return name
    }
    name.slice(prev_sep + 2, n)
}

fn ctx_payload_variant_count(ctx: LowerCtx) -> i32 {
    ctx.payload_variants.len()
}

fn ctx_payload_variant_name_at(ctx: LowerCtx, index: i32) -> String {
    get_unchecked(ctx.payload_variants, index).clone()
}

fn ctx_payload_variant_push(mut ctx: LowerCtx, name: String) {
    push(ctx.payload_variants, name)
}
