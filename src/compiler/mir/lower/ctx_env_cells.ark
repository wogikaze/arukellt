use mir::function_identity
use mir::inst_draft
use mir::inst_struct_set
use mir::lower::ctx_current_storage
use mir::opcodes

// Env-cell flush: in a closure that owns rebind cells, every return first
// writes each cell local back to its __env field so mutations persist across
// indirect calls (#874). Lives below ctx_locals_emit so closure_cells can
// keep depending on closure_env without an import cycle.
fn ctx_env_cell_flush(ctx: LowerCtx, inst: MirInstDraft) -> Vec<MirInstDraft> {
    let mut out = Vec::new<MirInstDraft>()
    if inst_draft::MirInstDraft_op(inst) != opcodes::MIR_RETURN() {
        return out
    }
    if ctx.cell_fn_names.len() == 0 {
        return out
    }
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    let fn_name = function_identity::MirFunction_name(func)
    let mut i = 0
    while i < ctx.cell_fn_names.len() {
        if get_unchecked(ctx.cell_fn_names, i).eq(fn_name.clone()) {
            push(out, inst_struct_set::MirInst_struct_set_named_idx(
                    get_unchecked(ctx.cell_env_locals, i),
                    get_unchecked(ctx.cell_local_indices, i),
                    get_unchecked(ctx.cell_env_names, i).clone(),
                    get_unchecked(ctx.cell_offsets, i),
                    get_unchecked(ctx.cell_field_indices, i),
                    get_unchecked(ctx.cell_totals, i),
                    get_unchecked(ctx.cell_vts, i)
                ))
        }
        i = i + 1
    }
    out
}

// 1 when any rebind flag is set, so callers can pass the env-cell presence
// to the trampoline and arity computations.
fn ctx_has_env_cell(rebind_flags: Vec<i32>) -> i32 {
    let mut i = 0
    while i < rebind_flags.len() {
        if get_unchecked(rebind_flags, i) != 0 {
            return 1
        }
        i = i + 1
    }
    0
}
