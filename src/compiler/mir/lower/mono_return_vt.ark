//
// When a generic function returning T is monomorphized, the fn_index
// registers the variant with the base return type (i32 for T). This
// module looks up the concrete return type from the MonoInstance.
// Call-time mangled-name reverse lookup is forbidden (#843); spine /
// MonoInstanceTable is the source of truth.

use std::prelude::{eq}
use mir::lower::mono_return_vt_table
use mir::lower::ctx_current_storage
use mir::lower::ctx_fn_return_type
use mir::lower::fn_index_method_return_type
use mir::lower::mono_suffix_parse
use mir::module_spine
use mir::value_types
use corehir::function_id
use corehir::signature_entry
use corehir::signature_registry
use corehir::type_info_to_mir_value
fn mono_return_vt(ctx: LowerCtx, name: String, fallback_vt: i32) -> i32 {
    let mono_id = mono_return_vt_registry_mono_id(ctx, name.clone())
    let table_vt = mono_return_vt_table::mono_return_vt_from_instance_table(ctx, mono_id)
    if table_vt >= 0 {
        // Prefer concrete spine / fn_index names over spine VT placeholders
        // left from generic T (add_any__f64 must not keep an i64 spine VT).
        let base_rtn = ctx_fn_return_type::ctx_fn_return_type_name(ctx, name.clone())
        let rtn = mono_return_type_name(ctx, name.clone(), base_rtn)
        if len(rtn) > 0 &&
        !mono_suffix_parse::is_mono_type_var_name(rtn.clone()) {
            let resolved_vt = fn_index_method_return_type::method_return_vt_from_type_name(rtn)
            if resolved_vt == value_types::VT_GC_REF() || resolved_vt == value_types::VT_REF() {
                return resolved_vt
            }
            if resolved_vt != table_vt {
                if resolved_vt == value_types::VT_F64() ||
                resolved_vt == value_types::VT_F32() ||
                resolved_vt == value_types::VT_I32() ||
                resolved_vt == value_types::VT_I64() {
                    return resolved_vt
                }
            }
        }
        return table_vt
    }
    fallback_vt
}

fn mono_return_mvt(ctx: LowerCtx, callee_name: String) -> MirValueType {
    let mono_id = mono_return_vt_registry_mono_id(ctx, callee_name.clone())
    mono_return_vt_table::mono_return_mvt_from_instance_table(ctx, mono_id)
}

fn mono_return_vt_registry_mono_id(ctx: LowerCtx, callee_name: String) -> i32 {
    let fid = mono_return_vt_registry_function_id(ctx, callee_name)
    if !function_id::function_id_is_valid(fid) {
        return 0 - 1
    }
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    let registry = module_spine::MirModule_signature_registry(m)
    signature_entry::signature_entry_mono_instance_id(signature_registry::signature_registry_lookup_by_id(registry, fid))
}

fn mono_return_vt_registry_function_id(ctx: LowerCtx, callee_name: String) -> FunctionId {
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    if !module_spine::MirModule_signature_spine_populated(m) {
        return function_id::FUNCTION_ID_INVALID()
    }
    let registry = module_spine::MirModule_signature_registry(m)
    let fid = signature_registry::signature_registry_lookup_by_mangled(registry, callee_name)
    if !function_id::function_id_is_valid(fid) {
        let short_name = short_name_after_last_double_colon(callee_name)
        if len(short_name) > 0 {
            fid = signature_registry::signature_registry_lookup_by_mangled(registry, short_name)
        }
    }
    if !function_id::function_id_is_valid(fid) {
        return function_id::FUNCTION_ID_INVALID()
    }
    fid
}

fn short_name_after_last_double_colon(name: String) -> String {
    let name_len = len(name)
    let mut index = name_len - 2
    while index >= 0 {
        if name.byte_at(index) == 58 && name.byte_at(index + 1) == 58 {
            return name.slice(index + 2, name_len)
        }
        index = index - 1
    }
    String_new()
}

fn mono_return_type_name(ctx: LowerCtx, name: String, fallback_name: String) -> String {
    // Spine first (#843). Build-time registration already concretes mono
    // returns via MonoInstanceTable; call-time must not parse mangled suffixes.
    let mono_id = mono_return_vt_registry_mono_id(ctx, name.clone())
    let spine_name = mono_return_vt_table::mono_return_type_name_from_instance_table(ctx, mono_id, String_new())
    if is_concrete_mono_return_type_name(spine_name.clone()) {
        return spine_name
    }
    let registry_name = mono_return_type_name_from_registry(ctx, name.clone())
    if len(registry_name) > 0 {
        return registry_name
    }
    if is_concrete_mono_return_type_name(fallback_name.clone()) {
        return fallback_name
    }
    if len(fallback_name) > 0 &&
    !mono_suffix_parse::is_mono_type_var_name(fallback_name.clone()) &&
    !fallback_name.clone().starts_with("?") &&
    !is_container_mono_return_type_name(fallback_name.clone()) {
        return fallback_name
    }
    fallback_name
}

fn mono_return_type_name_from_registry(ctx: LowerCtx, name: String) -> String {
    let fid = mono_return_vt_registry_function_id(ctx, name)
    if !function_id::function_id_is_valid(fid) {
        return String_new()
    }
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    let registry = module_spine::MirModule_signature_registry(m)
    let entry = signature_registry::signature_registry_lookup_by_id(registry, fid)
    if signature_entry::signature_entry_return_count(entry) <= 0 {
        return String_new()
    }
    type_info_to_mir_value::mvt_to_type_name(
        module_spine::MirModule_type_table(m),
        signature_entry::signature_entry_return_at(entry, 0)
    )
}

fn is_container_mono_return_type_name(type_name: String) -> bool {
    type_name.clone().starts_with("vec:") ||
    type_name.clone().starts_with("option:") ||
    type_name.clone().starts_with("Option") ||
    type_name.clone().starts_with("result:") ||
    type_name.clone().starts_with("Result") ||
    type_name.clone().starts_with("hashmap:") ||
    type_name.clone().starts_with("HashMap")
}

fn mono_resolve_return_type_name(ctx: LowerCtx, name: String) -> String {
    let base_rtn = ctx_fn_return_type::ctx_fn_return_type_name(ctx, name.clone())
    mono_return_type_name(ctx, name, base_rtn)
}

fn is_concrete_mono_return_type_name(type_name: String) -> bool {
    if len(type_name) == 0 {
        return false
    }
    if type_name.clone().starts_with("?") {
        return false
    }
    if type_name.clone().starts_with("struct:") {
        return true
    }
    if type_name.clone().starts_with("vec:") {
        return !type_name_has_type_var_suffix(type_name.clone())
    }
    if type_name.clone().starts_with("option:") {
        return !type_name_has_type_var_suffix(type_name.clone())
    }
    if type_name.clone().starts_with("hashmap:") {
        return true
    }
    if eq(type_name.clone(), "i32") ||
    eq(type_name.clone(), "i64") ||
    eq(type_name.clone(), "f64") ||
    eq(type_name.clone(), "f32") ||
    eq(type_name.clone(), "bool") ||
    eq(type_name.clone(), "char") ||
    eq(type_name.clone(), "String") ||
    eq(type_name.clone(), "string") {
        return true
    }
    // Bare user struct names from MonoInstance TypeTable entries (Point).
    if !mono_suffix_parse::is_mono_type_var_name(type_name.clone()) {
        let first = type_name.byte_at(0)
        if first >= 65 && first <= 90 {
            return true
        }
    }
    false
}

fn type_name_has_type_var_suffix(type_name: String) -> bool {
    let n = len(type_name)
    if n == 0 {
        return false
    }
    let last = type_name.byte_at(n - 1)
    if last >= 65 && last <= 90 {
        return true
    }
    false
}
