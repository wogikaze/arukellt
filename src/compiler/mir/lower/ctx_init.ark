use mir::function_factory
use mir::module_functions
use mir::source_location_record
use mir::emit_spec
use mir::lower::ctx_types
use wasm::emit_target
use wasm::ctx_record
use collections::name_index
use mir::post_pass_callee_cache
fn LowerCtx_new(m: MirModule) -> LowerCtx {
    LowerCtx_new_for_target(m, String_new(), String_new(), Vec::new<SourceLocation>())
}

fn LowerCtx_new_for_target(m: MirModule, target: String, source_text: String, fn_source_locations: Vec<SourceLocation>) -> LowerCtx {
    let mut effective_target = target.clone()
    if effective_target.len() == 0 {
        effective_target = "wasm32-gc"
    }
    LowerCtx {
        module: m,
        func: function_factory::MirFunction_new("", source_location_record::SourceLocation_unmapped()),
        cur_block: 0,
        local_names: Vec::new<String>(), local_indices: Vec::new<i32>(),
        local_name_buckets: Vec::new<i32>(),
        fn_names: Vec::new<String>(),
        fn_name_lengths: Vec::new<i32>(),
        fn_name_index: name_index::NameIndex_new(0),
        fn_indices: Vec::new<i32>(),
        fn_return_vts: Vec::new<i32>(), fn_return_type_names: Vec::new<String>(),
        const_names: Vec::new<String>(),
        qualified_fn_names: Vec::new<String>(),
        qualified_fn_name_index: name_index::NameIndex_new(0),
        qualified_fn_return_vts: Vec::new<i32>(),
        qualified_fn_return_type_names: Vec::new<String>(),
        loop_exit_block: 0 - 1, loop_cond_block: 0 - 1, nesting_depth: 0,
        loop_break_depth: 0 - 1, loop_continue_depth: 0 - 1, loop_break_local: 0 - 1,
        struct_names: Vec::new<String>(), struct_field_counts: Vec::new<i32>(),
        struct_all_fields: Vec::new<String>(), struct_field_types: Vec::new<String>(),
        generic_struct_names: Vec::new<String>(), generic_struct_params: Vec::new<String>(),
        generic_enum_names: Vec::new<String>(), generic_enum_params: Vec::new<String>(),
        expected_struct_inst: String_new(),
        struct_layout_first_index: name_index::NameIndex_empty(),
        struct_layout_struct_index: name_index::NameIndex_empty(),
        struct_layout_field_offsets: Vec::new<i32>(),
        struct_layout_name_memo: name_index::NameIndex_new(0),
        struct_layout_name_memo_values: Vec::new<String>(),
        local_types: Vec::new<String>(), local_type_indices: Vec::new<i32>(),
        match_result_indices: Vec::new<i32>(), match_result_states: Vec::new<i32>(),
        variant_names: Vec::new<String>(), variant_tags: Vec::new<i32>(),
        variant_name_first: name_index::NameIndex_empty(),
        variant_key_best: name_index::NameIndex_empty(),
        payload_variants: Vec::new<String>(),
        closure_counter: 0, closure_last_synth: String_new(), closure_last_caps: String_new(), closure_last_extra: 0, closure_last_identity: false,
        closure_last_env: 0 - 1,
        closure_bind_names: Vec::new<String>(), closure_bind_synth: Vec::new<String>(),
        closure_bind_caps: Vec::new<String>(), closure_bind_extra: Vec::new<i32>(), closure_bind_identity: Vec::new<bool>(),
        closure_bind_env: Vec::new<i32>(),
        closure_bind_fns: Vec::new<String>(),
        closure_thunk_names: Vec::new<String>(),
        pending_fn_thunks: Vec::new<String>(),
        cell_fn_names: Vec::new<String>(), cell_local_indices: Vec::new<i32>(),
        cell_env_locals: Vec::new<i32>(), cell_env_names: Vec::new<String>(),
        cell_offsets: Vec::new<i32>(), cell_field_indices: Vec::new<i32>(),
        cell_totals: Vec::new<i32>(), cell_vts: Vec::new<i32>(),
        wb_synths: Vec::new<String>(), wb_src_lis: Vec::new<i32>(),
        wb_env_lis: Vec::new<i32>(), wb_env_names: Vec::new<String>(),
        wb_offsets: Vec::new<i32>(), wb_field_indices: Vec::new<i32>(),
        wb_totals: Vec::new<i32>(), wb_vts: Vec::new<i32>(),
        pcell_fn_names: Vec::new<String>(), pcell_lis: Vec::new<i32>(),
        pcell_cell_lis: Vec::new<i32>(), pcell_cell_names: Vec::new<String>(),
        pcell_vts: Vec::new<i32>(), pcell_types: Vec::new<String>(),
        pcell_ref_names: Vec::new<String>(),
        pcell_reg_keys: Vec::new<String>(), pcell_reg_cells: Vec::new<String>(),
        pcell_reg_vts: Vec::new<i32>(), pcell_reg_types: Vec::new<String>(),
        pcell_mat_fns: Vec::new<String>(), pcell_mat_lis: Vec::new<i32>(),
        pcell_mat_tmps: Vec::new<i32>(),
        local_type_start: 0,
        hashset_locals: Vec::new<i32>(),
        mono_call_starts: Vec::new<i32>(), mono_call_span_sources: Vec::new<String>(),
        mono_call_span_targets: Vec::new<String>(),
        mono_call_span_used: Vec::new<i32>(),
        mono_span_buckets: Vec::new<i32>(),
        mono_span_next: Vec::new<i32>(),
        mono_call_sources: Vec::new<String>(), mono_call_name_targets: Vec::new<String>(),
        mono_call_used: Vec::new<i32>(),
        mono_call_bare_head: name_index::NameIndex_empty(),
        mono_call_bare_tail: name_index::NameIndex_empty(),
        mono_call_bare_next: Vec::new<i32>(),
        wit_call_names: Vec::new<String>(), wit_call_iface_ids: Vec::new<String>(), wit_call_func_names: Vec::new<String>(),
        is_gc_target: emit_target::is_gc_target(effective_target.clone()),
        lower_target: effective_target,
        gc_type_base: 0,
        gc_enum_variant_names: Vec::new<String>(), gc_enum_variant_sigs: Vec::new<String>(),
        gc_enum_variant_alias_names: Vec::new<String>(), gc_enum_variant_alias_slots: Vec::new<i32>(),
        gc_struct_names: Vec::new<String>(), gc_struct_sigs: Vec::new<String>(),
        gc_struct_sig_pending: Vec::new<bool>(),
        gc_seal_done: false,
        mono_type_param_names: Vec::new<String>(), mono_type_param_types: Vec::new<String>(),
        mono_instances: Vec::new<MonoInstance>(),
        mono_inst_keys: Vec::new<String>(),
        mono_inst_vals: Vec::new<i32>(),
        mono_inst_buckets: Vec::new<i32>(),
        source_text: source_text,
        fn_source_locations: fn_source_locations,
        edge_names: Vec::new<String>(),
        prop_cache: post_pass_callee_cache::callee_prop_cache_build(m),
        resolved_call_index: name_index::NameIndex_empty(),
        resolved_call_owners: Vec::new<String>(),
        current_body_decl_index: 0 - 1,
        current_body_child_index: 0 - 1,
        emit_ctx: ctx_record::SelfEmitCtx_new(
            m,
            module_functions::MirModule_functions(m),
            0 - 1, 0 - 1,
            effective_target.clone(),
            String_new(), false, String_new()
        ),
        emit_spec: emit_spec::mir_lower_emit_spec_disabled(),
        emit_in_loop: false,
        emit_fn_cursor: 0,
    }
}
