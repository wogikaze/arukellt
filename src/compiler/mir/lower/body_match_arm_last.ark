use mir::lower::ast_node
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_nesting
use mir::lower::ctx_types
use mir::lower_kinds
use mir::inst_local_get
use mir::inst_structured_control
use mir::lower::body_match_compare_or
use mir::lower::body_match_compare_single
use mir::lower::match

fn lower_last_match_arm(ctx: LowerCtx, arm_node: AstNode, arm_child_count: i32, pat: AstNode, body: AstNode, payload_info: MirMatchPayloadInfo, scrut_idx: i32, result: i32, if_depth: i32) -> i32 {
    let mut depth = if_depth
    let is_catchall = match::mir_match_is_catchall(ctx, pat)
    let is_struct_pattern = ast_node::node_kind_is(pat, lower_kinds::NK_PAT_STRUCT())
    let needs_condition = !is_catchall && !is_struct_pattern
    if needs_condition {
        let pattern_matches = lower_last_pattern_condition(ctx, pat, payload_info)
        ctx_emit(ctx, inst_local_get::MirInst_local_get(pattern_matches))
        ctx_emit(ctx, inst_structured_control::MirInst_if())
        let _pattern_nesting_depth = ctx_api_nesting::ctx_push_nesting(ctx)
        depth = depth + 1
    }
    if is_catchall && ast_node::node_kind_is(pat, lower_kinds::NK_PAT_IDENT()) {
        match::mir_emit_match_ident_bind(ctx, pat, scrut_idx)
    }
    if !is_catchall {
        match::mir_emit_payload_variant_binds_if_needed(ctx, payload_info, pat, scrut_idx)
    }
    if match::mir_match_arm_has_guard(arm_child_count) {
        let guard_last = ast_node::node_child_at(arm_node, 1)
        lower_expr(ctx, guard_last)
        match::mir_emit_match_guard_begin(ctx)
        depth = depth + 1
    }
    let arm_result = lower_expr(ctx, body)
    match::mir_store_match_arm_result(ctx, result, arm_result)
    if match::mir_match_arm_has_guard(arm_child_count) {
        match::mir_emit_match_guard_end(ctx)
        depth = depth - 1
    }
    if needs_condition {
        ctx_emit(ctx, inst_structured_control::MirInst_end())
        let _pattern_nesting_depth_after = ctx_api_nesting::ctx_pop_nesting(ctx)
        depth = depth - 1
    }
    depth
}

fn lower_last_pattern_condition(ctx: LowerCtx, pat: AstNode, payload_info: MirMatchPayloadInfo) -> i32 {
    if ast_node::node_kind_is(pat, lower_kinds::NK_PAT_OR()) {
        return body_match_compare_or::lower_or_match_compare_condition(ctx, pat, payload_info)
    }
    body_match_compare_single::lower_single_match_compare_condition(ctx, pat, payload_info)
}
