use mir::lower::ast_node
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_variants
use mir::lower::ctx_types
use mir::inst_local_set
use mir::value_types
use mir::lower::variants
use mir::lower::ast_node
use mir::lower::ctx_fn_index
use mir::lower::struct_lit
use mir::lower::value_variants
use mir::lower_kinds

fn lower_payload_variant_call(mut ctx: LowerCtx, node: AstNode, child_count: i32, var_tag: i32) -> i32 {
    let mut payload_locals = Vec::new<i32>()
    let mut payload_vts = Vec::new<i32>()
    let mut total_bytes = 4
    let mut pa = 1
    while pa < child_count {
        let parg = ast_node::node_child_at(node, pa)
        let p_idx = if mir_variant_arg_is_fn_value(ctx, node, parg) {
            value_variants::lower_function_value(ctx, ast_node::node_text(parg))
        } else {
            lower_expr(ctx, parg)
        }
        let p_vt = ctx_local_vt(ctx, p_idx)
        let save_local = ctx_fresh_local(ctx, p_vt)
        let src_type = ctx_api_local_types::ctx_get_local_type(ctx, p_idx)
        if src_type.len() > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, save_local, src_type.clone())
        }
        // The type name is only a lowering hint.  Preserve the producer's
        // concrete value type when staging a payload, otherwise a named enum
        // can be reclassified as an unrelated GC reference by the fallback
        // type-name resolver.
        ctx_api_local_types::ctx_set_local_mvt(
            ctx,
            save_local,
            ctx_api_local_types::ctx_local_mvt(ctx, p_idx)
        )
        // Copy enum-valued payloads' slots only when the payload itself is an
        // enum/Option/Result. String/struct field payloads must stay unslotted
        // so emit does not cast them to the enclosing variant type.
        let src_slot = ctx_api_local_types::ctx_get_local_variant_slot(ctx, p_idx)
        if src_slot >= 0 &&
        (src_type.clone().starts_with("enum:") ||
            src_type.clone().starts_with("Option") ||
            src_type.clone().starts_with("option") ||
            src_type.clone().starts_with("Result") ||
            src_type.clone().starts_with("result")) {
            ctx_api_local_types::ctx_set_local_variant_slot(ctx, save_local, src_slot)
        } else {
            ctx_api_local_types::ctx_set_local_variant_slot(ctx, save_local, 0 - 1)
        }
        ctx_emit(ctx, inst_local_set::MirInst_local_set_from(save_local, p_idx))
        push(payload_locals, save_local)
        push(payload_vts, p_vt)
        if p_vt == value_types::VT_F64() || p_vt == value_types::VT_I64() {
            total_bytes = total_bytes + 8
        } else {
            total_bytes = total_bytes + 4
        }
        pa = pa + 1
    }
    let callee = ast_node::node_child_at(node, 0)
    let raw_name = ast_node::node_text(callee)
    let canon = ctx_api_variants::ctx_canonical_variant_name(ctx, raw_name.clone())
    let variant_name = if canon.len() > 0 {
        canon
    } else {
        raw_name
    }
    variants::lower_payload_variant_from_locals(ctx, var_tag, payload_locals, payload_vts, total_bytes, variant_name)
}

// `Some(answer)` / `Ok(answer)` / `Err(answer)` inside an enum-typed
// expected position must store the fn pair, not the scalar result of an
// implicit call.  The generic enum erase the declared payload type, so
// the fn expectation comes from `ctx.expected_struct_inst` spellings:
// `Option_<t>`/`option:<t>` and `Result_<t>_<e>`/`result:<t>:<e>` (#884).
fn mir_variant_arg_is_fn_value(ctx: LowerCtx, node: AstNode, parg: AstNode) -> bool {
    if !ast_node::node_kind_is(parg, lower_kinds::NK_IDENT()) {
        return false
    }
    if !mir_expected_enum_payload_is_fn(ctx, ast_node::node_text(ast_node::node_child_at(node, 0))) {
        return false
    }
    let parg_name = ast_node::node_text(parg)
    if ctx_api_local_alloc::ctx_lookup_local(ctx, parg_name.clone()) >= 0 {
        return false
    }
    ctx_fn_index::ctx_fn_index_find(ctx, parg_name) >= 0
}

fn mir_expected_enum_payload_is_fn(ctx: LowerCtx, callee_name: String) -> bool {
    let is_err = callee_name.clone().eq("Err") || callee_name.clone().ends_with("::Err")
    let is_some_or_ok = callee_name.clone().eq("Some") || callee_name.clone().ends_with("::Some") ||
    callee_name.clone().eq("Ok") || callee_name.clone().ends_with("::Ok")
    if !is_err && !is_some_or_ok {
        return false
    }
    let want_index = if is_err { 2 } else { 1 }
    struct_lit::struct_lit_decl_is_fn_value(mir_expected_enum_type_arg(ctx.expected_struct_inst.clone(), want_index))
}

// Extract the which-th (1-based) type argument from an enum inst
// spelling: "Option_<a>"/"option:<a>"/"Option<a>" and
// "Result_<a>_<b>"/"result:<a>:<b>"/"Result<a, b>" use the head's own
// separator ("_" or ":") or top-level commas inside angle brackets.
fn mir_expected_enum_type_arg(expected: String, which: i32) -> String {
    if expected.clone().starts_with(String_from("Option<")) && expected.clone().ends_with(String_from(">")) {
        if which == 1 {
            return expected.slice(7, expected.len() - 1)
        }
        return String_new()
    }
    if expected.clone().starts_with(String_from("Result<")) && expected.clone().ends_with(String_from(">")) {
        let inner = expected.clone().slice(7, expected.len() - 1)
        let parts = mir_expected_enum_split_args(inner)
        if which >= 1 && which <= parts.len() {
            return parts.get_unchecked(which - 1)
        }
        return String_new()
    }
    let mut args = String_new()
    let mut sep = 0
    if expected.clone().starts_with("Option_") || expected.clone().starts_with("Result_") {
        args = expected.clone().slice(7, expected.len())
        sep = 95
    } else if expected.clone().starts_with("option:") || expected.clone().starts_with("result:") {
        args = expected.clone().slice(7, expected.len())
        sep = 58
    } else {
        return String_new()
    }
    let n = args.len()
    let mut seg_start = 0
    let mut index = 1
    let mut i = 0
    while i <= n {
        if i == n || args.clone().byte_at(i) == sep {
            if index == which {
                return args.clone().slice(seg_start, i)
            }
            seg_start = i + 1
            index = index + 1
        }
        i = i + 1
    }
    String_new()
}

// Split "Result<A, B>" argument text on top-level commas.  Unlike
// ctx_split_top_level_type_args this also treats "->" as atomic and
// tracks parens, so an "fn(A,B) -> R" argument does not split on its
// parameter comma and its arrow does not close the angle depth.
fn mir_expected_enum_split_args(inner: String) -> Vec<String> {
    let mut args = Vec::new<String>()
    let mut angle_depth = 0
    let mut paren_depth = 0
    let mut seg_start = 0
    let n = inner.len()
    let mut i = 0
    while i <= n {
        if i < n {
            let ch = inner.clone().byte_at(i)
            if ch == 60 {
                angle_depth = angle_depth + 1
            }
            if ch == 62 && (i == 0 || inner.clone().byte_at(i - 1) != 45) {
                angle_depth = angle_depth - 1
            }
            if ch == 40 {
                paren_depth = paren_depth + 1
            }
            if ch == 41 {
                paren_depth = paren_depth - 1
            }
        }
        if (i == n || inner.clone().byte_at(i) == 44) && angle_depth == 0 && paren_depth == 0 {
            push(args, inner.clone().slice(seg_start, i))
            seg_start = i + 1
        }
        i = i + 1
    }
    args
}
