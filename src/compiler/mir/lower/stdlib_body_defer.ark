use corehir::core_op_binding
use corehir::core_op_id
use corehir::param

// RFC-005 D3: CoreOp-bound and intrinsic-shim stdlib symbols keep call-site
// CoreOp / legacy lowering for now. Their Ark bodies become live fallbacks in
// #821/#822 after the #820 inliner exists. Pure Ark helpers (e.g. contains_i32)
// are not listed here and are lowered normally.
fn mir_should_defer_stdlib_body(decl_name: String) -> bool {
    let coid = core_op_binding::core_op_binding_lookup_for_callee(decl_name.clone())
    if core_op_id::core_op_id_is_some(coid) {
        return true
    }
    mir_is_unbound_prelude_intrinsic_shim(decl_name)
}

/// Like `mir_should_defer_stdlib_body`, but discriminates overloaded names
/// using the first parameter type when needed.
fn mir_should_defer_stdlib_body_with_param0(decl_name: String, param0: CoreHirParam) -> bool {
    // Fs::write_bytes(String, Vec)->Result stays deferred so the fs
    // intrinsic lowering owns the body; the retired std::io memory-buffer
    // write_bytes was the only non-path overload (#807).
    if decl_name.clone().eq(String_from("write_bytes")) {
        return true
    }
    // Bare `join` core_op is string.join(Vec,String). path::join(String,String)
    // must lower; otherwise call sites become drop+unreachable (#807).
    if decl_name.clone().eq(String_from("join")) {
        return mir_is_vec_join_overload(decl_name.clone(), param0)
    }
    mir_should_defer_stdlib_body(decl_name)
}

fn mir_is_vec_join_overload(decl_name: String, param0: CoreHirParam) -> bool {
    if !decl_name.clone().eq(String_from("join")) {
        return false
    }
    let p0 = param::param_type_name(param0)
    p0.clone().eq(String_from("Vec")) ||
    p0.clone().starts_with(String_from("Vec<")) ||
    p0.clone().starts_with(String_from("vec"))
}

fn mir_is_unbound_prelude_intrinsic_shim(decl_name: String) -> bool {
    if decl_name.clone().eq(String_from("contains")) { return true }
    if decl_name.clone().eq(String_from("contains_string")) { return true }
    if decl_name.clone().eq(String_from("sort_String")) { return true }
    if decl_name.clone().eq(String_from("map_i32_i32")) { return true }
    if decl_name.clone().eq(String_from("filter_i32")) { return true }
    if decl_name.clone().eq(String_from("fold_i32_i32")) { return true }
    if decl_name.clone().eq(String_from("map_option_i32_i32")) { return true }
    // any_i32 / find_i32: real Ark bodies in prelude (no intrinsic emitter).
    // i64 format Ark body scrambles Vec/i64 locals on wasm32-gc; keep deferred
    // so call sites use the text.format_i64 intrinsic emitter (#807).
    if decl_name.clone().eq(String_from("__core_format_i64_impl")) { return true }
    if decl_name.clone().eq(String_from("map_String_String")) { return true }
    if decl_name.clone().eq(String_from("filter_String")) { return true }
    if decl_name.clone().eq(String_from("map_i64_i64")) { return true }
    if decl_name.clone().eq(String_from("filter_i64")) { return true }
    if decl_name.clone().eq(String_from("fold_i64_i64")) { return true }
    if decl_name.clone().eq(String_from("map_f64_f64")) { return true }
    if decl_name.clone().eq(String_from("filter_f64")) { return true }
    if decl_name.clone().eq(String_from("get")) { return true }
    if decl_name.clone().eq(String_from("pop")) { return true }
    if decl_name.clone().eq(String_from("set")) { return true }
    // `len` is a signature-only prelude free with two receiver owners. Its call
    // sites bind `String::len` / `Vec::len`, so the declaration keeps its
    // sealed fallback body deferred instead of lowering it (#936).
    if decl_name.clone().eq(String_from("len")) { return true }
    if decl_name.clone().eq(String_from("values")) { return true }
    if decl_name.clone().eq(String_from("exit")) { return true }
    if decl_name.clone().eq(String_from("lines")) { return true }
    if decl_name.clone().eq(String_from("byte_len")) { return true }
    if decl_name.clone().eq(String_from("byte_at")) { return true }
    if decl_name.clone().eq(String_from("format_i32")) { return true }
    // format_bool is CoreOp-bound via legacy alias → text.format_bool (#822).
    if decl_name.clone().eq(String_from("any_i64")) { return true }
    if decl_name.clone().eq(String_from("any_f64")) { return true }
    if decl_name.clone().eq(String_from("any_String")) { return true }
    if decl_name.clone().eq(String_from("find_i64")) { return true }
    if decl_name.clone().eq(String_from("find_f64")) { return true }
    if decl_name.clone().eq(String_from("find_String")) { return true }
    if decl_name.clone().eq(String_from("fold_f64_f64")) { return true }
    false
}
