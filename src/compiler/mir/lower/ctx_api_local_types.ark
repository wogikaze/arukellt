use mir::lower::ctx_locals_type
use mir::lower::ctx_typed_mir_sync

fn ctx_set_local_type(mut ctx: LowerCtx, local_idx: i32, type_name: String) { ctx_locals_type::ctx_set_local_type(ctx, local_idx, type_name) }
fn ctx_get_local_type(ctx: LowerCtx, local_idx: i32) -> String { ctx_locals_type::ctx_get_local_type(ctx, local_idx) }
fn ctx_local_vt(ctx: LowerCtx, idx: i32) -> i32 { ctx_locals_type::ctx_local_vt(ctx, idx) }
fn ctx_set_local_vt(mut ctx: LowerCtx, idx: i32, vt: i32) { ctx_locals_type::ctx_set_local_vt(ctx, idx, vt) }
fn ctx_set_local_mvt(mut ctx: LowerCtx, idx: i32, value_type: MirValueType) { ctx_typed_mir_sync::ctx_set_local_mvt(ctx, idx, value_type) }
fn ctx_local_mvt(ctx: LowerCtx, idx: i32) -> MirValueType { ctx_typed_mir_sync::ctx_local_mvt(ctx, idx) }
fn ctx_set_local_variant_slot(mut ctx: LowerCtx, local_idx: i32, variant_slot: i32) { ctx_locals_type::ctx_set_local_variant_slot(ctx, local_idx, variant_slot) }
fn ctx_get_local_variant_slot(ctx: LowerCtx, local_idx: i32) -> i32 { ctx_locals_type::ctx_get_local_variant_slot(ctx, local_idx) }

// HashSet<T> lowers to vec:i32 or the String-keyed map's bucket alias, so
// the marker carries the element family across let bindings and calls.
// 1 = i32, 2 = String, 0 = not a set.
fn ctx_mark_hashset_local(mut ctx: LowerCtx, local_idx: i32, family: String) {
    if local_idx < 0 {
        return
    }
    while ctx.hashset_locals.len() <= local_idx {
        ctx.hashset_locals.push(0)
    }
    if family.clone().eq(String_from("String")) {
        ctx.hashset_locals.set(local_idx, 2)
    } else {
        ctx.hashset_locals.set(local_idx, 1)
    }
}

fn ctx_hashset_local_family(ctx: LowerCtx, local_idx: i32) -> String {
    if local_idx < 0 || local_idx >= ctx.hashset_locals.len() {
        return String_new()
    }
    let code = get_unchecked(ctx.hashset_locals, local_idx)
    if code == 1 {
        return String_from("i32")
    }
    if code == 2 {
        return String_from("String")
    }
    String_new()
}
