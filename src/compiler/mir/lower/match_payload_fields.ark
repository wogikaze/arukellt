use std::prelude::{clone, ends_with, eq, is_err, starts_with, substring}
use std::text
use mir::lower::ast_node
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_variants
use mir::lower::aggregate_tuple
use mir::lower::stmt_let_tuple
use mir::inst_struct_get
use mir::inst_gc_struct
use mir::inst_local_get
use mir::inst_local_set
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_enum_payload
use mir::lower::ctx_struct_layout
use mir::lower_kinds
use mir::lower::match_payload_bind_types
use mir::lower::match_payload_bind_gc_resolve
use mir::lower::match_payload_field_type
use mir::lower::match_payload_prepare
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_lookup
use mir::lower::ctx_struct_mono
use mir::lower::ctx_mono_type_params
use mir::value_types
fn mir_emit_payload_variant_binds(ctx: LowerCtx, pat: AstNode, scrut_idx: i32, scrut_ok_is_f64: bool, scrut_ok_is_i64: bool, scrut_ok_is_i32: bool) {
    let variant_name = ast_node::node_text(pat)
    let mut scrut_type = ctx_get_local_type(ctx, scrut_idx)
    let is_some_or_ok = match_payload_field_type::mir_match_variant_is_some_or_ok(clone(variant_name))
    let is_err = match_payload_field_type::mir_match_variant_is_err(clone(variant_name))
    let mut payload_hint = String_new()
    if is_some_or_ok || is_err {
        payload_hint = mir_payload_elem_type_from_scrut(clone(scrut_type), is_some_or_ok)
    }
    if is_some_or_ok && len(payload_hint) == 0 {
        if mir_option_scrut_type_is_untyped(clone(scrut_type)) {
            if match_payload_field_type::mir_variant_has_fnref_payload_field(ctx, clone(variant_name)) {
                payload_hint = String_from("fnref")
            }
        }
    }
    let mut bi = 0
    while bi < ast_node::node_child_count(pat) {
        let bind_pat = ast_node::node_child_at(pat, bi)
        if ast_node::node_kind_is(bind_pat, lower_kinds::NK_PAT_WILDCARD()) {
            bi = bi + 1
            continue
        }
        // Literal sub-patterns contribute a match condition, not a
        // binding; skipping them here keeps junk locals out (#902).
        if ast_node::node_kind_is(bind_pat, lower_kinds::NK_PAT_LITERAL()) {
            bi = bi + 1
            continue
        }
        // Ident children that name a registered unit variant (Some(None))
        // are tag conditions, not bindings — mir_subpat_child_is_condition
        // makes the same split for the compare phase.
        if ast_node::node_kind_is(bind_pat, lower_kinds::NK_PAT_IDENT()) {
            let bind_name = ast_node::node_text(bind_pat)
            if ctx_api_variants::ctx_variant_tag(ctx, clone(bind_name)) >= 0 {
                bi = bi + 1
                continue
            }
        }
        // Composite sub-patterns (tuple, nested variant) bind into an
        // unnamed temp first; each element ident is destructured from it
        // after the payload read lands (#890 Vec<(K, V)>::get match,
        // #902 nested payload binds).
        let is_composite_bind = ast_node::node_kind_is(bind_pat, lower_kinds::NK_PAT_TUPLE()) ||
        ast_node::node_kind_is(bind_pat, lower_kinds::NK_PAT_VARIANT())
        let hint_for_field = if bi == 0 {
            clone(payload_hint)
        } else {
            String_new()
        }
        let bind_vt = match_payload_field_type::mir_payload_field_vt_for_payload(
            ctx,
            clone(variant_name),
            bi,
            scrut_ok_is_f64,
            scrut_ok_is_i64,
            clone(hint_for_field)
        )
        let mut bind_local = 0 - 1
        if is_composite_bind {
            bind_local = ctx_api_local_alloc::ctx_fresh_local(ctx, bind_vt)
        } else {
            bind_local = ctx_alloc_local(ctx, ast_node::node_text(bind_pat), bind_vt)
        }
        if bind_vt == value_types::VT_FUNCREF() {
            ctx_set_local_type(ctx, bind_local, String_from("fnref"))
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_FUNCREF())
        } else if bind_vt == value_types::VT_GC_REF() || match_payload_field_type::mir_payload_gc_field_is_ref(ctx, clone(variant_name), bi) {
            ctx_set_local_type(ctx, bind_local, String_from("enum:open"))
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
        }
        match_payload_bind_types::set_gc_payload_bind_type_if_needed(ctx, clone(variant_name), bind_local, bind_vt, bi, clone(hint_for_field))
        match_payload_bind_types::set_i32_payload_bind_type_if_needed(ctx, clone(variant_name), bind_local, bind_vt, bi, scrut_ok_is_i32)
        match_payload_bind_types::set_narrow_int_payload_bind_type_if_needed(ctx, clone(variant_name), bind_local, bind_vt, bi)
        // Infer concrete payload type from scrutinee type for Option/Result.
        if bi == 0 {
            mir_infer_payload_bind_type(ctx, clone(variant_name), bind_local, bind_vt, scrut_idx)
        }
        // Only named payload binds are undecidable: the bind's downstream
        // use picks the arm's expected type after this point. Wildcard
        // children never consume the payload and composite children only
        // need a ref read, which the emitter can always emit.
        if !is_composite_bind && ast_node::node_kind_is(bind_pat, lower_kinds::NK_PAT_IDENT()) &&
        !eq(clone(ast_node::node_text(bind_pat)), String_from("_")) {
            match_payload_field_type::mir_report_weak_payload_scrutinee(ctx, clone(variant_name), clone(payload_hint))
        }
        emit_payload_field_bind(ctx, clone(variant_name), scrut_idx, bind_local, bind_vt, bi)
        if is_composite_bind {
            mir_emit_subpat_binds(ctx, bind_pat, bind_local)
        }
        bi = bi + 1
    }
}

// Load one payload field into an anonymous temp for a non-ident
// sub-pattern (literal compare, nested variant/tuple destructure). The
// setup mirrors the named-bind path so the temp sees the same vt and type
// spelling a bound payload local would (#902).
fn mir_subpat_load_field(ctx: LowerCtx, variant_name: String, scrut_idx: i32, field_idx: i32, scrut_ok_is_f64: bool, scrut_ok_is_i64: bool, scrut_ok_is_i32: bool, scrut_type: String) -> i32 {
    let is_some_or_ok = match_payload_field_type::mir_match_variant_is_some_or_ok(clone(variant_name))
    let is_err = match_payload_field_type::mir_match_variant_is_err(clone(variant_name))
    let mut payload_hint = String_new()
    if field_idx == 0 && (is_some_or_ok || is_err) {
        payload_hint = mir_payload_elem_type_from_scrut(clone(scrut_type), is_some_or_ok)
    }
    let bind_vt = match_payload_field_type::mir_payload_field_vt_for_payload(
        ctx,
        clone(variant_name),
        field_idx,
        scrut_ok_is_f64,
        scrut_ok_is_i64,
        clone(payload_hint)
    )
    let temp = ctx_api_local_alloc::ctx_fresh_local(ctx, bind_vt)
    if bind_vt == value_types::VT_FUNCREF() {
        ctx_set_local_type(ctx, temp, String_from("fnref"))
        ctx_api_local_types::ctx_set_local_vt(ctx, temp, value_types::VT_FUNCREF())
    } else if bind_vt == value_types::VT_GC_REF() || match_payload_field_type::mir_payload_gc_field_is_ref(ctx, clone(variant_name), field_idx) {
        ctx_set_local_type(ctx, temp, String_from("enum:open"))
        ctx_api_local_types::ctx_set_local_vt(ctx, temp, value_types::VT_GC_REF())
    }
    match_payload_bind_types::set_gc_payload_bind_type_if_needed(ctx, clone(variant_name), temp, bind_vt, field_idx, clone(payload_hint))
    match_payload_bind_types::set_i32_payload_bind_type_if_needed(ctx, clone(variant_name), temp, bind_vt, field_idx, scrut_ok_is_i32)
    if field_idx == 0 {
        mir_infer_payload_bind_type(ctx, clone(variant_name), temp, bind_vt, scrut_idx)
    }
    // Declared-field types keep the nested value's own type name (an enum
    // or tuple payload) so deeper tag/payload reads resolve layouts the
    // Option/Result inference would not see (#902).
    if len(ctx_get_local_type(ctx, temp)) == 0 {
        let declared = ctx_mono_type_params::ctx_resolve_mono_type_name(
            ctx,
            ctx_struct_field_type::ctx_struct_field_type_name(ctx, clone(variant_name), field_idx + 1)
        )
        if len(declared) > 0 {
            ctx_set_local_type(ctx, temp, declared)
        }
    }
    emit_payload_field_bind(ctx, clone(variant_name), scrut_idx, temp, bind_vt, field_idx)
    temp
}

// Bind every binding sub-pattern under a composite payload child whose
// value already sits in val_idx: ident children bind val directly, tuple
// children destructure their elements, nested variant children load their
// payload fields and recurse (#902).
fn mir_emit_subpat_binds(ctx: LowerCtx, pat: AstNode, val_idx: i32) {
    if ast_node::node_kind_is(pat, lower_kinds::NK_PAT_IDENT()) {
        let name = ast_node::node_text(pat)
        if eq(clone(name), "_") {
            return
        }
        if ctx_api_variants::ctx_variant_tag(ctx, clone(name)) >= 0 {
            return
        }
        // Inline of mir_emit_match_ident_bind: match_payload_bind already
        // imports this file, so the shared helper cannot be reached
        // without a module cycle.
        let bind_vt = ctx_api_local_types::ctx_local_vt(ctx, val_idx)
        let bind_local = ctx_alloc_local(ctx, clone(name), bind_vt)
        let val_type = ctx_get_local_type(ctx, val_idx)
        if len(val_type) > 0 {
            ctx_set_local_type(ctx, bind_local, clone(val_type))
            if starts_with(clone(val_type), "enum:") {
                ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
            }
        }
        ctx_emit(ctx, inst_local_get::MirInst_local_get(val_idx))
        ctx_emit(ctx, inst_local_set::MirInst_local_set(bind_local))
        return
    }
    if ast_node::node_kind_is(pat, lower_kinds::NK_PAT_TUPLE()) {
        let elem_count = ast_node::node_child_count(pat)
        let mut ei = 0
        while ei < elem_count {
            let elem = ast_node::node_child_at(pat, ei)
            if ast_node::node_kind_is(elem, lower_kinds::NK_PAT_IDENT()) ||
            ast_node::node_kind_is(elem, lower_kinds::NK_PAT_VARIANT()) ||
            ast_node::node_kind_is(elem, lower_kinds::NK_PAT_TUPLE()) {
                let elem_local = stmt_let_tuple::emit_tuple_element_extract(ctx, val_idx, ei, elem_count)
                mir_emit_subpat_binds(ctx, elem, elem_local)
            }
            ei = ei + 1
        }
        return
    }
    if ast_node::node_kind_is(pat, lower_kinds::NK_PAT_VARIANT()) {
        let variant_name = ast_node::node_text(pat)
        let scrut_type = ctx_get_local_type(ctx, val_idx)
        let is_f64 = match_payload_prepare::mir_option_result_scrut_type_is_f64(clone(scrut_type))
        let is_i64 = match_payload_prepare::mir_option_result_scrut_type_is_i64(clone(scrut_type))
        let is_i32 = match_payload_prepare::mir_option_result_scrut_type_is_i32(clone(scrut_type))
        let mut bi = 0
        while bi < ast_node::node_child_count(pat) {
            let bind_pat = ast_node::node_child_at(pat, bi)
            if ast_node::node_kind_is(bind_pat, lower_kinds::NK_PAT_WILDCARD()) ||
            ast_node::node_kind_is(bind_pat, lower_kinds::NK_PAT_LITERAL()) {
                bi = bi + 1
                continue
            }
            if ast_node::node_kind_is(bind_pat, lower_kinds::NK_PAT_IDENT()) {
                let bind_name = ast_node::node_text(bind_pat)
                if !eq(clone(bind_name), "_") && ctx_api_variants::ctx_variant_tag(ctx, clone(bind_name)) < 0 {
                    let field_local = mir_subpat_load_field(ctx, clone(variant_name), val_idx, bi, is_f64, is_i64, is_i32, clone(scrut_type))
                    let subpat_hint = if bi == 0 {
                        mir_payload_elem_type_from_scrut(clone(scrut_type), match_payload_field_type::mir_match_variant_is_some_or_ok(clone(variant_name)))
                    } else {
                        String_new()
                    }
                    match_payload_field_type::mir_report_weak_payload_scrutinee(ctx, clone(variant_name), subpat_hint)
                    let bind_vt = ctx_api_local_types::ctx_local_vt(ctx, field_local)
                    let bind_local = ctx_alloc_local(ctx, clone(bind_name), bind_vt)
                    let field_type = ctx_get_local_type(ctx, field_local)
                    if len(field_type) > 0 {
                        ctx_set_local_type(ctx, bind_local, clone(field_type))
                        if starts_with(clone(field_type), "enum:") {
                            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
                        }
                    }
                    ctx_emit(ctx, inst_local_get::MirInst_local_get(field_local))
                    ctx_emit(ctx, inst_local_set::MirInst_local_set(bind_local))
                }
                bi = bi + 1
                continue
            }
            let field_local = mir_subpat_load_field(ctx, clone(variant_name), val_idx, bi, is_f64, is_i64, is_i32, clone(scrut_type))
            mir_emit_subpat_binds(ctx, bind_pat, field_local)
            bi = bi + 1
        }
    }
}
fn mir_option_scrut_type_is_untyped(scrut_type: String) -> bool {
    eq(clone(scrut_type), String_from("Option")) ||
    eq(clone(scrut_type), String_from("option:")) ||
    eq(clone(scrut_type), String_from("Option:")) ||
    len(scrut_type) == 0
}

// Extract the concrete payload element type from the scrutinee type name.
fn mir_payload_bind_type_is_weak(current_type: String, is_err: bool) -> bool {
    if len(current_type) == 0 {
        return true
    }
    if eq(clone(current_type), String_from("enum:open")) {
        return true
    }
    if starts_with(clone(current_type), String_from("enum:")) {
        return true
    }
    if match_payload_field_type::mir_payload_scalar_type_name(clone(current_type)) {
        return true
    }
    if eq(clone(current_type), String_from("string")) || eq(clone(current_type), String_from("String")) {
        return true
    }
    if is_err && eq(clone(current_type), String_from("string")) {
        return true
    }
    false
}

fn mir_payload_elem_type_from_scrut(scrut_type: String, is_some_or_ok: bool) -> String {
    if is_some_or_ok {
        // Ok/Some payload is the first type parameter.
        // Normalize Vec_/Vec<T> → vec:T like Result Ok extraction so
        // Option_Vec / option:Vec binds resolve get/push (not bare Vec).
        if starts_with(clone(scrut_type), String_from("option:")) {
            return match_payload_bind_types::normalize_payload_elem_type_name(
                substring(scrut_type, 7, len(scrut_type))
            )
        }
        if starts_with(clone(scrut_type), String_from("Option_")) {
            return match_payload_bind_types::normalize_payload_elem_type_name(
                substring(scrut_type, 7, len(scrut_type))
            )
        }
        if starts_with(clone(scrut_type), String_from("Option:")) {
            return match_payload_bind_types::normalize_payload_elem_type_name(
                substring(scrut_type, 7, len(scrut_type))
            )
        }
        if starts_with(clone(scrut_type), String_from("?Option:")) {
            return match_payload_bind_types::normalize_payload_elem_type_name(
                substring(scrut_type, 8, len(scrut_type))
            )
        }
        if starts_with(clone(scrut_type), String_from("Option<")) && ends_with(clone(scrut_type), String_from(">")) {
            return match_payload_bind_types::normalize_payload_elem_type_name(
                substring(scrut_type, 7, len(scrut_type) - 1)
            )
        }
        if starts_with(clone(scrut_type), String_from("Result_")) ||
        starts_with(clone(scrut_type), String_from("result:")) ||
        starts_with(clone(scrut_type), String_from("Result:")) ||
        starts_with(clone(scrut_type), String_from("?Result:")) {
            return match_payload_bind_types::extract_first_result_type_param(scrut_type)
        }
        // Legacy mono wrote enum:Result:T (E dropped). Still recover Ok = T.
        if starts_with(clone(scrut_type), String_from("enum:Result:")) {
            return match_payload_bind_types::normalize_payload_elem_type_name(
                match_payload_bind_types::extract_first_result_type_param(
                    String_from("result:").concat(substring(scrut_type, 12, len(scrut_type)))
                )
            )
        }
        return String_new()
    }
    // Err payload is the second type parameter.
    if starts_with(clone(scrut_type), String_from("Result_")) ||
    starts_with(clone(scrut_type), String_from("result:")) ||
    starts_with(clone(scrut_type), String_from("Result:")) ||
    starts_with(clone(scrut_type), String_from("?Result:")) {
        return match_payload_bind_types::extract_second_result_type_param(scrut_type)
    }
    if starts_with(clone(scrut_type), String_from("enum:Result:")) {
        return match_payload_bind_types::extract_second_result_type_param(
            String_from("result:").concat(substring(scrut_type, 12, len(scrut_type)))
        )
    }
    String_new()
}

fn mir_infer_payload_set_type(ctx: LowerCtx, elem_ty: String) -> String {
    // For non-scalar, non-String types (e.g. AppError),
    // prefix with "enum:" so the emitter's ref local type
    // inference maps it to the enum open type.
    // However, types that already have a recognised ref
    // prefix (vec:, hashmap:, Option_, Result_, option:,
    // result:) should NOT be prefixed with "enum:" because
    // the emitter has dedicated GC type mappings for them.
    // Named GC structs (Token, etc.) must keep their bare
    // name so Option::Some can use gcsref<slot> (#726 display).
    let mut set_type = clone(elem_ty)
    if !match_payload_field_type::mir_payload_scalar_type_name(clone(elem_ty)) {
        if !eq(clone(elem_ty), "String") && !eq(clone(elem_ty), "string") {
            if starts_with(clone(elem_ty), "tuple:") {
                // Tuple payloads keep the tuple:<k,...> layout name and must
                // have the GC struct registered before emit resolves the
                // Some-bind local type (#890 Option<(A, B)>).
                aggregate_tuple::ctx_register_tuple_gc_struct_from_keys(
                    ctx,
                    substring(clone(elem_ty), 6, len(elem_ty))
                )
                return set_type
            }
            if !starts_with(clone(elem_ty), String_from("vec:")) &&
            !starts_with(clone(elem_ty), String_from("Vec<")) &&
            !starts_with(clone(elem_ty), String_from("Vec_")) &&
            !eq(clone(elem_ty), String_from("Vec")) &&
            !starts_with(clone(elem_ty), String_from("hashmap:")) &&
            !starts_with(clone(elem_ty), String_from("Option_")) &&
            !starts_with(clone(elem_ty), String_from("option:")) &&
            !starts_with(clone(elem_ty), String_from("Result_")) &&
            !starts_with(clone(elem_ty), String_from("result:")) {
                // Struct payloads keep their layout name so field access can
                // resolve indices; generic instantiations derive the
                // substituted layout first.
                let derived = ctx_struct_mono::ctx_derive_generic_struct_type_name(ctx, clone(elem_ty))
                if ctx_struct_layout::ctx_is_registered_struct_type(ctx, clone(derived)) {
                    set_type = derived
                } else {
                    set_type = String_from("enum:").concat(clone(elem_ty))
                }
            }
        }
    }
    set_type
}

// Infer the concrete payload type for the first bind of Some/Ok/Err patterns
// from the scrutinee's type name, then fix up the local's type and vt.
fn mir_infer_payload_bind_type(ctx: LowerCtx, variant_name: String, bind_local: i32, bind_vt: i32, scrut_idx: i32) {
    let is_some_or_ok = match_payload_field_type::mir_match_variant_is_some_or_ok(clone(variant_name))
    let is_err = match_payload_field_type::mir_match_variant_is_err(clone(variant_name))
    if !is_some_or_ok && !is_err {
        return
    }
    let current_type = ctx_get_local_type(ctx, bind_local)
    let scrut_type = ctx_get_local_type(ctx, scrut_idx)
    let mut elem_ty = mir_payload_elem_type_from_scrut(clone(scrut_type), is_some_or_ok)
    if len(elem_ty) == 0 {
        return
    }
    // Inside a monomorphized body the scrutinee keeps the generic spelling
    // (option:T / Option_T). Resolve the payload element and the bind's
    // declared name through the mono map so Some(v) binds get the concrete
    // payload type and vt instead of the unresolved parameter (#882).
    let resolved_elem = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, clone(elem_ty))
    if len(resolved_elem) > 0 {
        elem_ty = resolved_elem
    }
    let resolved_current = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, clone(current_type))
    let weak_check_type = if len(resolved_current) > 0 {
        resolved_current
    } else {
        clone(current_type)
    }
    if eq(clone(elem_ty), String_from("fnref")) ||
    eq(clone(elem_ty), String_from("fn")) ||
    starts_with(clone(elem_ty), String_from("fn(")) {
        ctx_set_local_type(ctx, bind_local, String_from("fnref"))
        ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_FUNCREF())
        return
    }
    // Override empty / unresolved / stale scalar placeholders. Generic
    // Option/Result lowering often leaves bind locals as "i32" or "string"
    // before the scrutinee type (e.g. result:JsonValue:…) is known.
    if !mir_payload_bind_type_is_weak(clone(weak_check_type), is_err) {
        return
    }
    let mut set_type = mir_infer_payload_set_type(ctx, clone(elem_ty))
    // Normalize unit Ok payload to i32 (matches Ok(()) lowering).
    if eq(clone(elem_ty), "unit") || eq(clone(elem_ty), "()") || eq(clone(elem_ty), "void") {
        set_type = String_from("i32")
    }
    ctx_set_local_type(ctx, bind_local, set_type)
    // Fix vt for scalars: i64/f64 keep their width; other
    // scalars collapse to i32. Do not force i64 → i32 (#726 debug_vec).
    if match_payload_field_type::mir_payload_scalar_type_name(clone(elem_ty)) {
        if eq(clone(elem_ty), "i64") || eq(clone(elem_ty), "I64") {
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_I64())
        } else if eq(clone(elem_ty), "f64") || eq(clone(elem_ty), "F64") {
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_F64())
        } else {
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_I32())
        }
    } else {
        // Non-scalar types (String, Vec, etc.) are GC refs
        // on GC targets.  Override VT_I32 to VT_GC_REF so
        // that the local is declared as a ref and the enum
        // variant is created with a ref field.
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
        }
    }
}

fn emit_payload_field_bind(ctx: LowerCtx, variant_name: String, scrut_idx: i32, bind_local: i32, bind_vt: i32, field_idx: i32) {
    // Use the current local vt, which may have been corrected by the
    // type inference block above (e.g. VT_GC_REF → VT_I32 for scalar
    // payloads from generic Option/Result types).
    let mut effective_vt = ctx_api_local_types::ctx_local_vt(ctx, bind_local)
    if effective_vt == value_types::VT_VOID() {
        effective_vt = bind_vt
    }
    if effective_vt == value_types::VT_FUNCREF() {
        ctx_set_local_type(ctx, bind_local, String_from("fnref"))
    } else if ctx_gc_enum::ctx_is_gc_target(ctx) && effective_vt != value_types::VT_GC_REF() {
        // Do not re-promote scalar Ok payloads (unit/i32/i64/f64) to GC ref
        // just because a stale Result::Ok slot was registered with _f1_ref*
        // (#726 Result<(), E> match vs Ok(()) emit).
        let bind_ty = ctx_get_local_type(ctx, bind_local)
        let is_fnref_bind = eq(clone(bind_ty), String_from("fnref")) || starts_with(clone(bind_ty), String_from("fn("))
        let scalar_bind = is_fnref_bind ||
        match_payload_field_type::mir_payload_scalar_type_name(clone(bind_ty)) ||
        eq(clone(bind_ty), "i32") ||
        eq(clone(bind_ty), "i64") ||
        eq(clone(bind_ty), "f64")
        if !scalar_bind && match_payload_field_type::mir_payload_gc_field_is_ref(ctx, clone(variant_name), field_idx) {
            effective_vt = value_types::VT_GC_REF()
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
            match_payload_bind_types::set_gc_payload_bind_type_if_needed(
                ctx,
                clone(variant_name),
                bind_local,
                effective_vt,
                field_idx,
                ctx_get_local_type(ctx, bind_local)
            )
            if len(ctx_api_local_types::ctx_get_local_type(ctx, bind_local)) == 0 {
                ctx_set_local_type(ctx, bind_local, String_from("enum:open"))
            }
        } else if !scalar_bind && match_payload_bind_types::payload_type_name_is_gc_ref(ctx, bind_local) {
            // The local type name indicates a GC ref type (String, Vec, etc.)
            // but core_payload_gc_field_is_ref could not detect it because
            // the variant was previously registered with an i32 payload.
            // Override effective_vt to VT_GC_REF so the enum variant is
            // created/found with a ref field.
            effective_vt = value_types::VT_GC_REF()
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
        }
    }
    let mut field_vt = value_types::VT_VOID()
    if effective_vt == value_types::VT_F64() {
        field_vt = value_types::VT_F64()
    } else if effective_vt == value_types::VT_I64() {
        field_vt = value_types::VT_I64()
    } else if effective_vt == value_types::VT_FUNCREF() {
        field_vt = value_types::VT_FUNCREF()
    } else if effective_vt == value_types::VT_GC_REF() || effective_vt == value_types::VT_REF() {
        // Ref payloads must not stay VT_VOID: Memory64 widen gating treats
        // VOID as an i32 scalar when the bind local is not yet marked ref.
        field_vt = value_types::VT_GC_REF()
    } else if effective_vt == value_types::VT_I32() {
        field_vt = value_types::VT_I32()
    }
    if emit_payload_field_bind_gc(ctx, clone(variant_name), field_idx, effective_vt, bind_local, scrut_idx, field_vt) {
        return
    }
    ctx_emit(ctx, inst_local_get::MirInst_local_get(scrut_idx))
    ctx_emit(
        ctx,
        inst_struct_get::MirInst_struct_get_field_idx(
            scrut_idx,
            clone(variant_name),
            ctx_struct_layout::ctx_struct_field_offset(ctx, clone(variant_name), field_idx + 1),
            field_idx + 1,
            ctx_struct_layout::ctx_struct_byte_size(ctx, clone(variant_name)),
            field_vt,
            bind_local
        )
    )
    ctx_emit(ctx, inst_local_set::MirInst_local_set(bind_local))
}

fn emit_payload_field_bind_gc(ctx: LowerCtx, variant_name: String, field_idx: i32, effective_vt: i32, bind_local: i32, scrut_idx: i32, field_vt: i32) -> bool {
    if !ctx_gc_enum::ctx_is_gc_target(ctx) {
        return false
    }
    let mut type_slot = ctx_gc_enum::ctx_gc_enum_variant_slot(ctx, clone(variant_name))
    // Multi-payload variants (Shape::Rect { width, height }) are already
    // registered at construction. Re-ensuring from field 0 alone creates a
    // single-payload twin; casting the real value to that twin traps (#807).
    if type_slot >= 0 && variant_layout_payload_field_count(ctx, clone(variant_name)) > 1 {
        let first_payload_type = match_payload_bind_gc_resolve::emit_payload_field_bind_gc_resolve_type(ctx, clone(variant_name), 0, bind_local)
        if len(first_payload_type) > 0 {
            let typed_vts = Vec::new<i32>()
            push(typed_vts, mir_payload_type_value_type(clone(first_payload_type)))
            let typed_slot = ctx_gc_enum_payload::ctx_ensure_gc_enum_payload_variant_typed(
                ctx,
                clone(variant_name),
                typed_vts,
                clone(first_payload_type)
            )
            if typed_slot >= 0 {
                type_slot = typed_slot
            }
        }
        ctx_emit(ctx, inst_gc_struct::MirInst_gc_struct_get(bind_local, scrut_idx, type_slot, field_idx + 1, field_vt))
        return true
    }
    let mut eff_vt = effective_vt
    if field_idx == 0 {
        // Resolve bind type first so vec:/enum: names force GC ref vt
        // before payload variant registration (#726 json Array / Result).
        let bind_type_name = match_payload_bind_gc_resolve::emit_payload_field_bind_gc_resolve_type(ctx, clone(variant_name), field_idx, bind_local)
        let is_fnref_payload = eq(clone(bind_type_name), String_from("fnref")) ||
        eq(clone(bind_type_name), String_from("fn")) ||
        starts_with(clone(bind_type_name), String_from("fn(")) ||
        eq(clone(bind_type_name), String_from("option:fnref")) ||
        eff_vt == value_types::VT_FUNCREF()
        let mut typed_payload_name = clone(bind_type_name)
        if is_fnref_payload {
            eff_vt = value_types::VT_FUNCREF()
            typed_payload_name = String_from("fnref")
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_FUNCREF())
            ctx_set_local_type(ctx, bind_local, String_from("fnref"))
        } else if starts_with(clone(bind_type_name), String_from("vec:")) ||
            starts_with(clone(bind_type_name), String_from("Vec")) ||
            starts_with(clone(bind_type_name), String_from("enum:")) ||
            starts_with(clone(bind_type_name), String_from("result:")) ||
            starts_with(clone(bind_type_name), String_from("option:")) ||
            eq(clone(bind_type_name), String_from("string")) ||
            eq(clone(bind_type_name), String_from("String")) ||
            ctx_struct_field_type::field_type_is_registered_enum(ctx, clone(bind_type_name)) {
                eff_vt = value_types::VT_GC_REF()
                ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
            }
            let payload_vts = Vec::new<i32>()
            push(payload_vts, eff_vt)
            let payload_slot = ctx_gc_enum_payload::ctx_ensure_gc_enum_payload_variant_typed(ctx, clone(variant_name), payload_vts, clone(typed_payload_name))
            if payload_slot >= 0 {
                type_slot = payload_slot
            }
            // Nested enum binds (enum:Inner) stay enum-open (#726 nested_enum).
            let bind_ty_for_slot = ctx_get_local_type(ctx, bind_local)
            if eff_vt == value_types::VT_GC_REF() &&
            type_slot >= 0 &&
            !starts_with(clone(bind_ty_for_slot), String_from("enum:")) &&
            match_payload_bind_types::payload_bind_needs_variant_slot(clone(bind_ty_for_slot), clone(variant_name)) {
                ctx_api_local_types::ctx_set_local_variant_slot(ctx, bind_local, type_slot)
            }
            ctx_emit(ctx, inst_gc_struct::MirInst_gc_struct_get(bind_local, scrut_idx, type_slot, field_idx + 1, field_vt))
            return true
        }
        if type_slot >= 0 {
            ctx_emit(ctx, inst_gc_struct::MirInst_gc_struct_get(bind_local, scrut_idx, type_slot, field_idx + 1, field_vt))
            return true
        }
        false
    }

    fn variant_layout_payload_field_count(ctx: LowerCtx, variant_name: String) -> i32 {
        let layout_name = ctx_struct_field_type::ctx_resolve_variant_layout_name(ctx, clone(variant_name))
        let mut field_count = ctx_struct_lookup::ctx_struct_field_count(ctx, clone(layout_name))
        if field_count <= 0 {
            field_count = ctx_struct_lookup::ctx_struct_field_count(ctx, clone(variant_name))
        }
        if field_count <= 1 {
            return 0
        }
        field_count - 1
    }

    fn mir_payload_type_value_type(type_name: String) -> i32 {
        if eq(clone(type_name), "f64") || eq(clone(type_name), "F64") {
            return value_types::VT_F64()
        }
        if eq(clone(type_name), "i64") || eq(clone(type_name), "I64") {
            return value_types::VT_I64()
        }
        if eq(clone(type_name), "fnref") ||
        eq(clone(type_name), "fn") ||
        starts_with(clone(type_name), "fn(") {
            return value_types::VT_FUNCREF()
        }
        if mir_payload_scalar_type_name(clone(type_name)) {
            return value_types::VT_I32()
        }
        value_types::VT_GC_REF()
    }
