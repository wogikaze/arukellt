// Extracted from core_match_payload_bind_core.ark to reduce import fan-out.

use std::prelude::{eq}
use std::text
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_types
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_enum_payload
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_lookup
use mir::lower::core_match_payload_bind_types
use mir::lower::core_match_payload_type_extract
use mir::inst_gc_struct
use mir::inst_local_get
use mir::inst_local_set
use mir::inst_struct_get
use mir::value_types
fn emit_payload_field_bind(mut ctx: LowerCtx, variant_name: String, bi: i32, scrut_idx: i32, bind_vt: i32, bind_local: i32) {
    // Use the current local vt, which may have been corrected by the
    // type inference block above (e.g. VT_GC_REF → VT_I32 for scalar
    // payloads from generic Option/Result types).
    let mut effective_vt = ctx_api_local_types::ctx_local_vt(ctx, bind_local)
    if effective_vt == value_types::VT_VOID() {
        effective_vt = bind_vt
    }
    if effective_vt == value_types::VT_FUNCREF() {
        ctx_api_local_types::ctx_set_local_type(ctx, bind_local, String_from("fnref"))
    } else if ctx_gc_enum::ctx_is_gc_target(ctx) && effective_vt != value_types::VT_GC_REF() {
        let bind_ty = ctx_api_local_types::ctx_get_local_type(ctx, bind_local)
        let is_fnref_bind = eq(bind_ty.clone(), String_from("fnref")) || bind_ty.clone().starts_with(String_from("fn("))
        let scalar_bind = is_fnref_bind ||
        core_match_payload_bind_types::core_payload_scalar_type_name(bind_ty.clone()) ||
        eq(bind_ty.clone(), "i32") ||
        eq(bind_ty.clone(), "i64") ||
        eq(bind_ty.clone(), "f64")
        if !scalar_bind && core_match_payload_bind_types::core_payload_gc_field_is_ref(
            ctx,
            variant_name.clone(),
            bi,
            ctx_api_local_types::ctx_get_local_type(ctx, scrut_idx)
        ) {
            effective_vt = value_types::VT_GC_REF()
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
            if len(ctx_api_local_types::ctx_get_local_type(ctx, bind_local)) == 0 {
                ctx_api_local_types::ctx_set_local_type(ctx, bind_local, String_from("enum:open"))
            }
        } else if !scalar_bind && core_match_payload_type_extract::core_payload_type_name_is_gc_ref(ctx, bind_local) {
            // The local type name indicates a GC ref type (String, Vec, etc.)
            // but core_payload_gc_field_is_ref could not detect it because
            // the variant was previously registered with an i32 payload.
            effective_vt = value_types::VT_GC_REF()
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
        }
    }
    let mut field_vt = value_types::VT_VOID()
    if effective_vt == value_types::VT_F64() {
        field_vt = value_types::VT_F64()
    } else if effective_vt == value_types::VT_I64() {
        field_vt = value_types::VT_I64()
    } else if effective_vt == value_types::VT_FUNCREF() {
        field_vt = value_types::VT_FUNCREF()
    } else if effective_vt == value_types::VT_GC_REF() || effective_vt == value_types::VT_REF() {
        field_vt = value_types::VT_GC_REF()
    } else if effective_vt == value_types::VT_I32() {
        field_vt = value_types::VT_I32()
    }
    if emit_payload_field_bind_gc(ctx, variant_name.clone(), bi, effective_vt, bind_local, scrut_idx, field_vt) {
        return
    }
    ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(scrut_idx))
    ctx_api_emit::ctx_emit(
        ctx,
        inst_struct_get::MirInst_struct_get_field_idx(
            scrut_idx,
            variant_name.clone(),
            ctx_struct_layout::ctx_struct_field_offset(ctx, variant_name.clone(), bi + 1),
            bi + 1,
            ctx_struct_layout::ctx_struct_byte_size(ctx, variant_name.clone()),
            field_vt,
            bind_local
        )
    )
    ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set(bind_local))
}

fn emit_payload_field_bind_gc(mut ctx: LowerCtx, variant_name: String, bi: i32, effective_vt: i32, bind_local: i32, scrut_idx: i32, field_vt: i32) -> bool {
    if !ctx_gc_enum::ctx_is_gc_target(ctx) {
        return false
    }
    let mut type_slot = ctx_gc_enum::ctx_gc_enum_variant_slot(ctx, variant_name.clone())
    // Multi-payload variants must reuse the construction slot; ensuring from
    // the first bind alone registers a single-payload twin that traps (#807).
    if type_slot >= 0 && variant_layout_payload_field_count(ctx, variant_name.clone()) > 1 {
        let first_payload_type = emit_payload_field_bind_gc_resolve_type(ctx, variant_name.clone(), 0, bind_local)
        if len(first_payload_type) > 0 {
            let mut typed_vts = Vec::new<i32>()
            push(typed_vts, core_payload_type_value_type(first_payload_type.clone()))
            let typed_slot = ctx_gc_enum_payload::ctx_ensure_gc_enum_payload_variant_typed(
                ctx,
                variant_name.clone(),
                typed_vts,
                first_payload_type.clone()
            )
            if typed_slot >= 0 {
                type_slot = typed_slot
            }
        }
        ctx_api_emit::ctx_emit(ctx, inst_gc_struct::MirInst_gc_struct_get(bind_local, scrut_idx, type_slot, bi + 1, field_vt))
        return true
    }
    let mut eff_vt = effective_vt
    if bi == 0 {
        let bind_type_name = emit_payload_field_bind_gc_resolve_type(ctx, variant_name.clone(), bi, bind_local)
        let is_fnref_payload = eq(bind_type_name.clone(), String_from("fnref")) ||
        eq(bind_type_name.clone(), String_from("fn")) ||
        bind_type_name.clone().starts_with(String_from("fn(")) ||
        eq(bind_type_name.clone(), String_from("option:fnref")) ||
        eff_vt == value_types::VT_FUNCREF()
        let mut typed_payload_name = bind_type_name.clone()
        if is_fnref_payload {
            eff_vt = value_types::VT_FUNCREF()
            typed_payload_name = String_from("fnref")
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_FUNCREF())
            ctx_api_local_types::ctx_set_local_type(ctx, bind_local, String_from("fnref"))
        } else if bind_type_name.clone().starts_with(String_from("vec:")) ||
            bind_type_name.clone().starts_with(String_from("Vec")) ||
            bind_type_name.clone().starts_with(String_from("enum:")) ||
            bind_type_name.clone().starts_with(String_from("result:")) ||
            bind_type_name.clone().starts_with(String_from("option:")) ||
            eq(bind_type_name.clone(), String_from("string")) ||
            eq(bind_type_name.clone(), String_from("String")) ||
            ctx_struct_field_type::field_type_is_registered_enum(ctx, bind_type_name.clone()) {
                eff_vt = value_types::VT_GC_REF()
                ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
            }
            let mut payload_vts = Vec::new<i32>()
            push(payload_vts, eff_vt)
            let payload_slot = ctx_gc_enum_payload::ctx_ensure_gc_enum_payload_variant_typed(ctx, variant_name.clone(), payload_vts, typed_payload_name.clone())
            if payload_slot >= 0 {
                type_slot = payload_slot
            }
            let bind_ty_for_slot = ctx_api_local_types::ctx_get_local_type(ctx, bind_local)
            if eff_vt == value_types::VT_GC_REF() &&
            type_slot >= 0 &&
            !bind_ty_for_slot.clone().starts_with(String_from("enum:")) &&
            core_match_payload_bind_types::payload_bind_needs_variant_slot(bind_ty_for_slot.clone(), variant_name.clone()) {
                ctx_api_local_types::ctx_set_local_variant_slot(ctx, bind_local, type_slot)
            }
            ctx_api_emit::ctx_emit(ctx, inst_gc_struct::MirInst_gc_struct_get(bind_local, scrut_idx, type_slot, bi + 1, field_vt))
            return true
        }
        if type_slot >= 0 {
            ctx_api_emit::ctx_emit(ctx, inst_gc_struct::MirInst_gc_struct_get(bind_local, scrut_idx, type_slot, bi + 1, field_vt))
            return true
        }
        false
    }

    fn variant_layout_payload_field_count(ctx: LowerCtx, variant_name: String) -> i32 {
        let layout_name = ctx_struct_field_type::ctx_resolve_variant_layout_name(ctx, variant_name.clone())
        let mut field_count = ctx_struct_lookup::ctx_struct_field_count(ctx, layout_name.clone())
        if field_count <= 0 {
            field_count = ctx_struct_lookup::ctx_struct_field_count(ctx, variant_name.clone())
        }
        if field_count <= 1 {
            return 0
        }
        field_count - 1
    }

    fn core_payload_type_value_type(type_name: String) -> i32 {
        if eq(type_name.clone(), String_from("f64")) || eq(type_name.clone(), String_from("F64")) {
            return value_types::VT_F64()
        }
        if eq(type_name.clone(), String_from("i64")) || eq(type_name.clone(), String_from("I64")) {
            return value_types::VT_I64()
        }
        if eq(type_name.clone(), String_from("fnref")) ||
        eq(type_name.clone(), String_from("fn")) ||
        type_name.clone().starts_with(String_from("fn(")) {
            return value_types::VT_FUNCREF()
        }
        if core_match_payload_bind_types::core_payload_scalar_type_name(type_name.clone()) {
            return value_types::VT_I32()
        }
        value_types::VT_GC_REF()
    }

    fn emit_payload_field_bind_gc_resolve_type(mut ctx: LowerCtx, variant_name: String, bi: i32, bind_local: i32) -> String {
        let mut bind_type_name = ctx_api_local_types::ctx_get_local_type(ctx, bind_local)
        let layout_ft = ctx_mono_type_params::ctx_resolve_mono_type_name(
            ctx,
            ctx_struct_field_type::ctx_struct_field_type_name(ctx, variant_name.clone(), bi + 1)
        )
        let layout_norm = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, layout_ft.clone())
        let mut layout_vec = String_new()
        if layout_norm.clone().starts_with(String_from("vec:")) {
            layout_vec = layout_norm.clone()
        } else if layout_norm.clone().starts_with(String_from("Vec<")) && layout_norm.clone().ends_with(String_from(">")) {
            layout_vec = String_from("vec:").concat(layout_norm.clone().slice(4, len(layout_norm) - 1))
        } else if layout_norm.clone().starts_with(String_from("Vec_")) {
            layout_vec = String_from("vec:").concat(layout_norm.clone().slice(4, len(layout_norm)))
        } else if eq(layout_norm.clone(), String_from("Vec")) {
            layout_vec = String_from("vec:i32")
        }
        if len(layout_vec) > 0 {
            bind_type_name = layout_vec
            ctx_api_local_types::ctx_set_local_type(ctx, bind_local, bind_type_name.clone())
        } else if len(bind_type_name) == 0 || eq(bind_type_name.clone(), String_from("enum:open")) {
            if len(layout_norm) > 0 {
                bind_type_name = layout_norm
                ctx_api_local_types::ctx_set_local_type(ctx, bind_local, bind_type_name.clone())
            }
        }
        if ctx_gc_enum::gc_enum_variant_is_vec_container(variant_name.clone()) {
            if !bind_type_name.clone().starts_with(String_from("vec:")) && !bind_type_name.clone().starts_with(String_from("Vec")) {
                let bare = ctx_gc_enum::ctx_gc_enum_bare_variant_name(variant_name.clone())
                if eq(bare.clone(), String_from("Table")) {
                    bind_type_name = String_from("vec:TomlField")
                } else if eq(bare.clone(), String_from("Object")) {
                    bind_type_name = String_from("vec:JsonField")
                } else if eq(bare.clone(), String_from("Array")) {
                    if variant_name.clone().starts_with(String_from("Json")) || variant_name.clone().contains(String_from("JsonValue")) {
                        bind_type_name = String_from("vec:JsonValue")
                    } else {
                        bind_type_name = String_from("vec:TomlValue")
                    }
                } else {
                    bind_type_name = String_from("vec:TomlValue")
                }
                ctx_api_local_types::ctx_set_local_type(ctx, bind_local, bind_type_name.clone())
            }
        }
        bind_type_name
    }
