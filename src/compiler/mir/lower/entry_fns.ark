use mir::lower::entry_body_source
use mir::lower::entry_body_input
use mir::lower::entry_core_body
use mir::lower::entry_fns_mono
use mir::lower::entry_view_fn
use mir::lower::entry_fallback_body
use mir::lower::ctx_corehir_probe
use mir::lower::legacy_body
use mir::lower::stdlib_body_defer
use corehir::mod as corehir_mod
fn mir_emit_top_level_fn_decl(
    mut ctx: LowerCtx,
    mut body_source: MirLowerEntryBodySource,
    decl_index: i32,
    decl_name: String,
    fn_idx: i32,
    entry_main_decl_index: i32,
    midx: MonoIndex,
    mir_tr: i32,
    emit_bodies: bool
) -> i32 {
    let entry_view = entry_body_source::mir_entry_body_source_view(body_source)
    let fn_info_index = entry_view_fn::mir_entry_fn_info_index_for_decl(entry_view, decl_index)
    let mut typed_index = fn_idx
    let mut body_idx = 0 - 1
    let mut param_count = 0
    let mut is_entry_main = decl_index == entry_main_decl_index
    if fn_info_index >= 0 {
        typed_index = entry_view_fn::mir_entry_fn_typed_index_at(entry_view, fn_info_index, typed_index)
        body_idx = entry_view_fn::mir_entry_fn_body_index_at(entry_view, fn_info_index, body_idx)
        param_count = entry_view_fn::mir_entry_fn_param_count_at(entry_view, fn_info_index, param_count)
        is_entry_main = entry_view_fn::mir_entry_fn_is_entry_main_at(entry_view, fn_info_index, is_entry_main)
    }
    let skip_shadow_main = eq(decl_name.clone(), String_from("main")) && !is_entry_main
    let defer_stdlib_body = mir_defer_body_for_decl(decl_name.clone(), entry_view, fn_info_index, param_count)
    if emit_bodies && !skip_shadow_main && !defer_stdlib_body {
        let body_input = entry_body_source::mir_entry_body_source_fn_input(body_source, decl_index, fn_info_index, body_idx)
        if ctx_corehir_probe::mir_probe_edges_enabled() != 0 {
            let probe_body = entry_body_input::mir_entry_body_input_core(body_input)
            ctx_corehir_probe::mir_probe_dump_body_calls(
                decl_name.clone(),
                entry_core_body::mir_entry_core_body_exprs(probe_body),
                entry_core_body::mir_entry_core_body_root(probe_body)
            )
            let fb = entry_body_input::mir_entry_body_input_fallback(body_input)
            ctx_corehir_probe::mir_probe_dump_ast_calls(
                decl_name.clone(),
                legacy_body::mir_legacy_body_node(entry_fallback_body::mir_entry_fallback_body_legacy(fb))
            )
        }
        entry_fns_mono::mir_emit_top_level_fn_mono_bodies(ctx, body_input, decl_name, typed_index, param_count, entry_view, fn_info_index, midx, mir_tr)
        let core_body = entry_body_input::mir_entry_body_input_core(body_input)
        corehir_mod::release_body_expr_subtree(
            entry_core_body::mir_entry_core_body_exprs(core_body),
            entry_core_body::mir_entry_core_body_root(core_body)
        )
    }
    entry_body_source::mir_entry_body_source_release_fn(body_source, decl_index, body_idx)
    fn_idx + 1
}

fn mir_defer_body_for_decl(
    decl_name: String,
    entry_view: MirLowerEntryView,
    fn_info_index: i32,
    param_count: i32
) -> bool {
    // CoreOp/intrinsic-shim deferral is only valid for stdlib decls. A user
    // module fn whose bare name collides with a bound callee (strings::repeat
    // vs repeat) must keep its body: its call sites resolve to the emitted
    // fn, not an intrinsic rewrite, so a deferred body becomes
    // drop+unreachable (#920). Missing fn_info keeps the historical bare-name
    // behavior.
    let is_stdlib = entry_view_fn::mir_entry_fn_is_stdlib_at(entry_view, fn_info_index, true)
    if !is_stdlib {
        return false
    }
    if fn_info_index >= 0 && param_count > 0 {
        if eq(decl_name.clone(), String_from("write_bytes")) ||
        eq(decl_name.clone(), String_from("join")) {
            let param0 = entry_view_fn::mir_entry_fn_param_at(entry_view, fn_info_index, 0)
            return stdlib_body_defer::mir_should_defer_stdlib_body_with_param0(decl_name.clone(), param0)
        }
    }
    let qualified_name = entry_view_fn::mir_entry_fn_qualified_name_at(entry_view, fn_info_index, String_new())
    stdlib_body_defer::mir_should_defer_stdlib_body_for_qualified(decl_name, qualified_name)
}
