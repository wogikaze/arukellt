use mir::function_factory
use mir::source_location_record
use collections::name_index

// LowerCtx is only needed while bodies are being lowered and call edges are
// recorded. The module owns the completed MIR and copied registry data before
// this point, so clear the lowering-only registries before later passes.
fn ctx_release_lowering_scratch(ctx: LowerCtx) {
    ctx.func = function_factory::MirFunction_new(
        String_new(),
        source_location_record::SourceLocation_unmapped()
    )
    ctx.cur_block = 0
    ctx.local_names = Vec::new<String>()
    ctx.local_indices = Vec::new<i32>()
    ctx.local_name_buckets = Vec::new<i32>()
    ctx.fn_names = Vec::new<String>()
    ctx.fn_name_lengths = Vec::new<i32>()
    ctx.fn_name_index = name_index::NameIndex_new(0)
    ctx.fn_indices = Vec::new<i32>()
    ctx.fn_return_vts = Vec::new<i32>()
    ctx.fn_return_type_names = Vec::new<String>()
    ctx.qualified_fn_names = Vec::new<String>()
    ctx.qualified_fn_name_index = name_index::NameIndex_new(0)
    ctx.qualified_fn_return_vts = Vec::new<i32>()
    ctx.qualified_fn_return_type_names = Vec::new<String>()
    ctx.struct_names = Vec::new<String>()
    ctx.struct_field_counts = Vec::new<i32>()
    ctx.struct_all_fields = Vec::new<String>()
    ctx.struct_field_types = Vec::new<String>()
    ctx.local_types = Vec::new<String>()
    ctx.local_type_indices = Vec::new<i32>()
    ctx.variant_names = Vec::new<String>()
    ctx.variant_tags = Vec::new<i32>()
    ctx.payload_variants = Vec::new<String>()
    ctx.closure_counter = 0
    ctx.closure_last_synth = String_new()
    ctx.closure_last_caps = String_new()
    ctx.closure_last_extra = 0
    ctx.closure_bind_names = Vec::new<String>()
    ctx.closure_bind_synth = Vec::new<String>()
    ctx.closure_bind_caps = Vec::new<String>()
    ctx.closure_bind_extra = Vec::new<i32>()
    ctx.local_type_start = 0
    ctx.mono_call_starts = Vec::new<i32>()
    ctx.mono_call_span_sources = Vec::new<String>()
    ctx.mono_call_span_targets = Vec::new<String>()
    ctx.mono_call_span_used = Vec::new<i32>()
    ctx.mono_span_buckets = Vec::new<i32>()
    ctx.mono_span_next = Vec::new<i32>()
    ctx.mono_call_sources = Vec::new<String>()
    ctx.mono_call_name_targets = Vec::new<String>()
    ctx.mono_call_used = Vec::new<i32>()
    ctx.wit_call_names = Vec::new<String>()
    ctx.wit_call_iface_ids = Vec::new<String>()
    ctx.wit_call_func_names = Vec::new<String>()
    ctx.gc_enum_variant_names = Vec::new<String>()
    ctx.gc_enum_variant_sigs = Vec::new<String>()
    ctx.gc_enum_variant_alias_names = Vec::new<String>()
    ctx.gc_enum_variant_alias_slots = Vec::new<i32>()
    ctx.gc_struct_names = Vec::new<String>()
    ctx.gc_struct_sigs = Vec::new<String>()
    ctx.mono_type_param_names = Vec::new<String>()
    ctx.mono_type_param_types = Vec::new<String>()
    ctx.mono_instances = Vec::new<MonoInstance>()
    ctx.mono_inst_keys = Vec::new<String>()
    ctx.mono_inst_vals = Vec::new<i32>()
    ctx.mono_inst_buckets = Vec::new<i32>()
    ctx.source_text = String_new()
    ctx.fn_source_locations = Vec::new<SourceLocation>()
    ctx.edge_names = Vec::new<String>()
    ctx.loop_exit_block = 0 - 1
    ctx.loop_cond_block = 0 - 1
    ctx.nesting_depth = 0
    ctx.loop_break_depth = 0 - 1
    ctx.loop_continue_depth = 0 - 1
    ctx.loop_break_local = 0 - 1
    ctx.is_gc_target = false
    ctx.lower_target = String_new()
    ctx.gc_type_base = 0
}
