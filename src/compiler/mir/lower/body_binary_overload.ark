use std::text
use mir::lower::binary_method
use mir::lower::binary_type_names
use mir::lower::binary_emit
use mir::lower::ctx_api_local_types
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_types
fn try_lower_overloaded_binary(mut ctx: LowerCtx, rhs: AstNode, mir_op: i32, l_idx: i32) -> i32 {
    let ov_ltype = ctx_mono_type_params::ctx_resolve_mono_type_name(
        ctx,
        ctx_get_local_type(ctx, l_idx)
    )
    let ov_is_primitive = binary_type_names::mir_is_primitive_operator_type(ov_ltype.clone())
    // String keeps the intrinsic path for eq/add, but ordering must compare
    // bytes rather than the String ref/pointer value. The cmp module is
    // explicit-import-only, so operators call the always-loaded helper.
    if ov_is_primitive &&
    binary_type_names::mir_is_string_type_name(ov_ltype.clone()) &&
    binary_emit::mir_is_order_comparison_op(mir_op) {
        let _ov_r_idx = lower_expr(ctx, rhs)
        return binary_emit::mir_emit_string_order_operator(ctx, mir_op)
    }
    if !ov_is_primitive {
        let ov_method = binary_method::mir_operator_method_name(mir_op)
        if len(ov_method) > 0 {
            let ov_callee = ov_ltype.clone().concat("::".concat(ov_method.clone()))
            if ctx_fn_exists(ctx, ov_callee.clone()) != 0 {
                let ov_r_idx = lower_expr(ctx, rhs)
                return binary_emit::mir_emit_overloaded_operator(ctx, ov_callee, mir_op)
            }
        }
    }
    0 - 2
}
