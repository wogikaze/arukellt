use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_types
use mir::lower::ctx_gc_enum
use mir::lower::ctx_struct_layout
use mir::inst_convert
use mir::inst_struct_set
use mir::inst_local_set
use mir::value_types

fn mir_emit_ident_assign(mut ctx: LowerCtx, name: String, val_idx: i32) {
    let local_idx = ctx_lookup_local(ctx, name.clone())
    if local_idx >= 0 && val_idx >= 0 {
        // Widen i32 values assigned into i64 locals before the local.set.
        // Use local_set_from: struct/if RHS values live in `val_idx` and are
        // not left on the operand stack (#726), so a stack-pop local.set would
        // capture a stale field temporary instead of the aggregate.
        if ctx_local_vt(ctx, local_idx) == value_types::VT_I64() && ctx_local_vt(ctx, val_idx) == value_types::VT_I32() {
            let ext_dest = ctx_fresh_local(ctx, value_types::VT_I64())
            ctx_emit(ctx, inst_convert::MirInst_extend_i32_to_i64(ext_dest, val_idx))
            ctx_emit(ctx, inst_local_set::MirInst_local_set_from(local_idx, ext_dest))
        } else {
            ctx_emit(ctx, inst_local_set::MirInst_local_set_from(local_idx, val_idx))
        }
    }
}

fn mir_save_field_base_from_stack(mut ctx: LowerCtx) -> i32 {
    let ref_vt = if ctx_gc_enum::ctx_is_gc_target(ctx) { value_types::VT_GC_REF() } else { value_types::VT_REF() }
    let temp = ctx_fresh_local(ctx, ref_vt)
    ctx_emit(ctx, inst_local_set::MirInst_local_set(temp))
    temp
}

fn mir_emit_field_assign(mut ctx: LowerCtx, field_name: String, struct_idx: i32, val_idx: i32) {
    let raw_type = ctx_get_local_type(ctx, struct_idx)
    let base_type = ctx_struct_layout::ctx_resolve_struct_layout_name(ctx, raw_type)
    let mut fi_assign = 0
    let mut field_off = 0
    let mut field_vt = value_types::VT_I32()
    let mut struct_byte_size = 0
    if len(base_type) > 0 {
        fi_assign = ctx_field_index(ctx, base_type.clone(), field_name.clone())
        field_off = ctx_struct_field_offset(ctx, base_type.clone(), fi_assign)
        struct_byte_size = ctx_struct_byte_size(ctx, base_type.clone())
        if ctx_struct_field_is_f64(ctx, base_type.clone(), fi_assign) {
            field_vt = value_types::VT_F64()
        } else if ctx_struct_field_is_i64(ctx, base_type.clone(), fi_assign) {
            field_vt = value_types::VT_I64()
        } else if ctx_struct_field_is_v128(ctx, base_type.clone(), fi_assign) {
            field_vt = value_types::VT_V128()
        } else if ctx_struct_layout::ctx_struct_field_is_gc_ref(ctx, base_type.clone(), fi_assign) {
            if ctx_gc_enum::ctx_is_gc_target(ctx) {
                field_vt = value_types::VT_GC_REF()
            } else {
                field_vt = value_types::VT_REF()
            }
        }
    } else {
        fi_assign = ctx_field_index_any(ctx, field_name.clone())
        field_off = fi_assign * 4
    }
    ctx_emit(ctx, inst_struct_set::MirInst_struct_set_named_idx(struct_idx, val_idx, base_type.clone(), field_off, fi_assign, struct_byte_size, field_vt))
}
