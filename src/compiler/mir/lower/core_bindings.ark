use mir::lower::closure_registry
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_types
use mir::inst_convert
use mir::inst_local_set
use mir::lower::core_bindings_type
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_calls
use mir::lower::core_expr_shape_atoms
use mir::lower::core_names
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_mono
use mir::lower::struct_lit
use mir::lower::value_variants
use mir::value_types
fn lower_core_let(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, expr: CoreHirExpr) -> i32 {
    let child_count = core_expr_shape_accessors::mir_core_expr_child_count(expr)
    let binding_name = core_expr_shape_accessors::mir_core_expr_text(expr)
    let type_name = core_expr_shape_accessors::mir_core_expr_type_name(expr)
    let resolved_type_name = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, type_name.clone())
    let resolved_type_name = ctx_struct_mono::ctx_derive_generic_struct_type_name(ctx, resolved_type_name)
    let mut val_idx = 0 - 1
    if child_count >= 1 {
        // A Pair<String> annotation is the literal's expected instantiation;
        // saved/restored so nested initializers cannot leak it.
        let saved_expected = ctx.expected_struct_inst.clone()
        ctx.expected_struct_inst = resolved_type_name.clone()
        let init_index = core_expr_shape_accessors::mir_core_expr_child(expr, 0)
        let init_expr = get_unchecked(exprs, init_index)
        if mir_core_let_init_is_fn_value(ctx, init_expr, resolved_type_name.clone()) {
            val_idx = value_variants::lower_function_value(ctx, core_expr_shape_accessors::mir_core_expr_text(init_expr))
        } else {
            val_idx = lower_core_expr(ctx, exprs, init_index)
        }
        ctx.expected_struct_inst = saved_expected
    }
    let mut vt = core_expr_shape_accessors::mir_core_expr_val_type(expr)
    if child_count >= 1 && len(type_name) == 0 && val_idx >= 0 {
        vt = ctx_api_local_types::ctx_local_vt(ctx, val_idx)
    }
    if vt == 0 {
        vt = value_types::VT_I32()
    }
    // A `fn(...) -> R` annotation makes the binding a fn-pair slot, so the
    // local must be VT_FUNCREF to receive the lowered pair (#884).
    if struct_lit::struct_lit_decl_is_fn_value(resolved_type_name.clone()) {
        vt = value_types::VT_FUNCREF()
    }
    let local_idx = ctx_api_local_alloc::ctx_alloc_local(ctx, binding_name.clone(), vt)
    // The initializer is the authoritative storage type for an unannotated
    // binding.  CoreHIR's let node can retain its default i32 value type even
    // when its child was widened (for example, `100i64`), so repair the newly
    // allocated local from the lowered value before emitting local.set.
    if len(type_name) == 0 && child_count >= 1 && val_idx >= 0 {
        ctx_api_local_types::ctx_set_local_vt(
            ctx,
            local_idx,
            ctx_api_local_types::ctx_local_vt(ctx, val_idx)
        )
    }
    if len(resolved_type_name) > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, local_idx, resolved_type_name.clone())
    }
    if child_count >= 1 && val_idx >= 0 {
        if ctx_api_local_types::ctx_local_vt(ctx, val_idx) == value_types::VT_F64() && ctx_api_local_types::ctx_local_vt(ctx, local_idx) == value_types::VT_I32() {
            ctx_api_local_types::ctx_set_local_vt(ctx, local_idx, value_types::VT_F64())
        }
        // Widen i32 initializers into i64-annotated bindings; the extend rides
        // the value already on the stack right before the local.set.
        if ctx_api_local_types::ctx_local_vt(ctx, local_idx) == value_types::VT_I64() && ctx_api_local_types::ctx_local_vt(ctx, val_idx) == value_types::VT_I32() {
            let ext_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I64())
            ctx_api_emit::ctx_emit(ctx, inst_convert::MirInst_extend_i32_to_i64(ext_dest, val_idx))
            val_idx = ext_dest
        }
        if val_idx != local_idx {
            ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set_from(local_idx, val_idx))
        }
        // An explicit annotation wins over the initializer's inferred type name;
        // e.g. `let r: Result<f64, _> = ...` must keep the payload-typed name.
        // For nested vec annotations (`Vec<Vec<i32>>` → vec:Vec) also rewrite the
        // initializer temp so Vec_new emission uses the structref-vec layout.
        let init_type = ctx_api_local_types::ctx_get_local_type(ctx, val_idx)
        if len(resolved_type_name) > 0 {
            if resolved_type_name.clone().starts_with("vec:") || resolved_type_name.clone().starts_with("hashmap:") {
                ctx_api_local_types::ctx_set_local_type(ctx, val_idx, resolved_type_name.clone())
                ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_GC_REF())
            }
        } else if len(init_type) > 0 {
            // One-character names are valid nominal types (ADR-089): a
            // declared `struct S` must keep its type through `let b = a`
            // instead of becoming an untyped local that cannot dispatch.
            ctx_api_local_types::ctx_set_local_type(ctx, local_idx, init_type)
        }
        core_bindings_type::infer_core_let_local_type_name(ctx, exprs, expr, local_idx, val_idx, resolved_type_name.clone(), child_count)
    }
    if child_count >= 1 {
        let init_expr = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(expr, 0))
        if core_expr_shape_calls::mir_core_expr_is_closure(init_expr) {
            if !binding_name.clone().eq("_") {
                closure_registry::closure_flush_pending_bind(ctx, binding_name.clone())
            } else {
                closure_registry::closure_clear_pending_bind(ctx)
            }
        }
    }
    0 - 1
}

// Bare function names at a `fn(...) -> R` let annotation lower to fn-pair
// values; the frontend resolves a 0-param ident by its result type,
// which would emit a call and store the scalar result (#884).
fn mir_core_let_init_is_fn_value(ctx: LowerCtx, init_expr: CoreHirExpr, resolved_type_name: String) -> bool {
    if !struct_lit::struct_lit_decl_is_fn_value(resolved_type_name) {
        return false
    }
    if !core_expr_shape_atoms::mir_core_expr_is_ident(init_expr) {
        return false
    }
    if core_names::mir_core_lookup_local(ctx, init_expr) >= 0 {
        return false
    }
    let init_name = core_expr_shape_accessors::mir_core_expr_text(init_expr)
    core_names::mir_function_parameter_count(ctx, init_name) >= 0
}
