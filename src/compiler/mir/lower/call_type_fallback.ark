use mir::lower::ctx_struct_lookup
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_mono
use mir::lower::ctx_fn_return_type
use mir::lower::ctx_api_local_types
use mir::lower::ctx_gc_enum
use mir::lower::ctx_types
use mir::lower::mono_return_vt
use mir::lower::mono_suffix_parse
use mir::lower::call_type_fallback_stdlib
use mir::typed_mir_compat
use mir::value_types
use corehir::mir_value_type
use corehir::kinds

// Layout / local-type tables use bare struct names. Strip only `::` qualifiers
// so `import_block::ImportBlockSpan` → `ImportBlockSpan`, without touching
// single-colon encodings like `struct:Name:8` or `option:i32`.
use std::prelude::{eq}
use std::text
fn strip_module_double_colon(type_name: String) -> String {
    let n = len(type_name)
    if n < 2 {
        return type_name
    }
    let mut i = n - 2
    while i >= 0 {
        if type_name.byte_at(i) == 58 && type_name.byte_at(i + 1) == 58 {
            return type_name.slice(i + 2, n)
        }
        i = i - 1
    }
    type_name
}

// Strip every `Module::` prefix inside a type encoding so
// `Result_parser::JsonValue_parser::JsonParseError` becomes
// `Result_JsonValue_JsonParseError`. Layout basename resolution would
// otherwise collapse the Result to the trailing enum name.
// Underscore is a Result_/Option_ encoding separator, not an ident char.
fn strip_embedded_module_path_prefixes(type_name: String) -> String {
    let mut result = type_name.clone()
    let mut guard = 0
    while guard < 16 {
        let n = len(result)
        let mut sep = 0 - 1
        let mut i = 0
        while i < n - 1 {
            if result.byte_at(i) == 58 && result.byte_at(i + 1) == 58 {
                sep = i
                i = n
            } else {
                i = i + 1
            }
        }
        if sep < 0 {
            return result
        }
        let mut start = sep - 1
        while start >= 0 {
            let ch = result.byte_at(start)
            let is_ident = (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122)
            if !is_ident {
                start = start + 1
                break
            }
            if start == 0 {
                break
            }
            start = start - 1
        }
        if start < 0 {
            start = 0
        }
        result = result.slice(0, start).concat(result.slice(sep + 2, n))
        guard = guard + 1
    }
    result
}

fn is_option_or_result_type_name(type_name: String) -> bool {
    type_name.clone().starts_with("Result_") ||
    type_name.clone().starts_with("result:") ||
    type_name.clone().starts_with("Option_") ||
    type_name.clone().starts_with("option:")
}

fn mark_call_result_from_return_type_name(mut ctx: LowerCtx, dest: i32, type_name: String) {
    let cleaned = strip_embedded_module_path_prefixes(type_name)
    if len(cleaned) == 0 {
        return
    }
    if eq(cleaned.clone(), "fnref") ||
    eq(cleaned.clone(), "fn") ||
    cleaned.clone().starts_with("fn(") {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "fnref")
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_FUNCREF())
        return
    }
    // Built-in names are also valid enum-variant basenames (for example
    // `WitType::String`). Keep the semantic built-in type before consulting
    // the layout registry, whose basename lookup cannot distinguish them.
    if eq(cleaned.clone(), "String") ||
    eq(cleaned.clone(), "string") ||
    eq(cleaned.clone(), "bool") ||
    eq(cleaned.clone(), "char") ||
    eq(cleaned.clone(), "i32") ||
    eq(cleaned.clone(), "i64") ||
    eq(cleaned.clone(), "f32") ||
    eq(cleaned.clone(), "f64") ||
    eq(cleaned.clone(), "u8") ||
    eq(cleaned.clone(), "i8") ||
    eq(cleaned.clone(), "u16") ||
    eq(cleaned.clone(), "u32") ||
    eq(cleaned.clone(), "u64") ||
    eq(cleaned.clone(), "i16") ||
    eq(cleaned.clone(), "unit") ||
    eq(cleaned.clone(), "()") ||
    eq(cleaned.clone(), "v128") {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, cleaned.clone())
        set_vt_for_resolved_type_name(ctx, dest, cleaned.clone())
        return
    }
    // A HashSet<T> value is its flat store alias (Vec<i32> / Vec<String>),
    // not a nominal struct layout. Resolving `HashSet<i32>` through the
    // struct registry would type the call result as a String-like ref and
    // break the store functions it feeds (#917).
    if cleaned.clone().starts_with("HashSet") {
        let store_type = if cleaned.clone().contains(String_from("String")) {
            String_from("vec:String")
        } else {
            String_from("vec:i32")
        }
        ctx_api_local_types::ctx_set_local_type(ctx, dest, store_type.clone())
        set_vt_for_resolved_type_name(ctx, dest, store_type)
        return
    }
    // Result/Option/Vec/HashMap encodings must not go through layout
    // basename resolve: `vec:Diagnostic` would become `Diagnostic`.
    if is_option_or_result_type_name(cleaned.clone()) ||
    cleaned.clone().starts_with("vec:") ||
    cleaned.clone().starts_with("hashmap:") ||
    cleaned.clone().starts_with("hashset:") ||
    cleaned.clone().starts_with("Vec<") ||
    cleaned.clone().starts_with("Vec_") {
        ctx_api_local_types::ctx_set_local_type(
            ctx,
            dest,
            ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, cleaned)
        )
        return
    }
    // `Box<i32>` / `?Box:T` spellings reference the generic decl — a
    // non-generic user struct sharing the base name (struct Box next to
    // prelude enum Box) cannot be the referent, so an enum base wins over
    // layout basename resolve.
    let generic_enum = ctx_struct_layout::ctx_generic_enum_type_name(ctx, cleaned.clone())
    if len(generic_enum) > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, generic_enum)
        return
    }
    // `Name<args>` instantiation spellings (VecIter<i32>) register their
    // substituted layout lazily. Derive it here so a call result whose
    // declared return type is a generic instantiation still resolves to a
    // struct reference instead of falling back to a scalar local (#860).
    if cleaned.clone().contains(String_from("<")) && cleaned.clone().ends_with(String_from(">")) {
        let _derived = ctx_struct_mono::ctx_derive_generic_struct_layout(ctx, cleaned.clone())
    }
    let resolved = ctx_struct_layout::ctx_resolve_struct_layout_name(ctx, cleaned)
    if len(resolved) > 0 {
        let marked = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, resolved)
        ctx_api_local_types::ctx_set_local_type(ctx, dest, marked.clone())
        // Struct results must not keep a stray enum variant_slot from an
        // earlier payload; Ok(TomlValStep) would otherwise become enum:open.
        if !marked.clone().starts_with("enum:") &&
        !marked.clone().starts_with("option:") &&
        !marked.clone().starts_with("Option") &&
        !marked.clone().starts_with("result:") &&
        !marked.clone().starts_with("Result") {
            ctx_api_local_types::ctx_set_local_variant_slot(ctx, dest, 0 - 1)
        }
    }
}

fn mark_fallback_call_result_type(mut ctx: LowerCtx, callee_name: String, dest: i32) {
    // Hard overrides must win over premature enum:open (#726 toml Result<Vec>).
    if call_type_fallback_stdlib::mark_toml_result_vec_call_type(ctx, callee_name.clone(), dest) {
        set_vt_for_resolved_type_name(ctx, dest, ctx_api_local_types::ctx_get_local_type(ctx, dest))
        return
    }
    // Re-apply known stdlib Result types when unset or demoted away from
    // Result/Option encodings (#834 cmd_init: write_main was i32).
    let existing = ctx_api_local_types::ctx_get_local_type(ctx, dest)
    let existing_is_weak = len(existing) == 0 || eq(existing.clone(), "enum:open")
    let needs_stdlib_result = existing_is_weak ||
    !is_option_or_result_type_name(existing.clone())
    if needs_stdlib_result &&
    call_type_fallback_stdlib::mark_known_stdlib_result_type(ctx, callee_name.clone(), dest) {
        set_vt_for_resolved_type_name(ctx, dest, ctx_api_local_types::ctx_get_local_type(ctx, dest))
        return
    }
    if existing_is_weak && len(ctx_api_local_types::ctx_get_local_type(ctx, dest)) == 0 {
        mark_struct_constructor_result_type(ctx, callee_name, dest)
    }
    if existing_is_weak && len(ctx_api_local_types::ctx_get_local_type(ctx, dest)) == 0 {
        let rtn = ctx_fn_return_type::ctx_fn_return_type_name(ctx, callee_name.clone())
        // For monomorphized calls, resolve concrete return type name
        // by substituting type vars from MonoInstance (e.g. "option:T"
        // → "option:i32"). Also handles generic T→Point → "struct:Point:8".
        let mono_rtn = mono_return_vt::mono_return_type_name(ctx, callee_name.clone(), rtn.clone())
        if len(mono_rtn) > 0 {
            mark_call_result_from_return_type_name(ctx, dest, mono_rtn)
        } else if len(rtn) > 1 && !mono_suffix_parse::is_mono_type_var_name(rtn.clone()) {
            mark_call_result_from_return_type_name(ctx, dest, rtn)
        }
    }
    // Call-time mangled-suffix reverse lookup removed (#843). Dest types must
    // come from spine / MonoInstanceTable / known stdlib markers above.
    let resolved_type = ctx_api_local_types::ctx_get_local_type(ctx, dest)
    set_vt_for_resolved_type_name(ctx, dest, resolved_type.clone())
    let mono_vt = mono_return_vt::mono_return_vt(ctx, callee_name.clone(), ctx_api_local_types::ctx_local_vt(ctx, dest))
    // Prefer mono-resolved scalar return vts when dest is not already a known
    // ref container (vec:/String/…). Unconditional scalar overwrite broke
    // Vec::new__T results that mark_vec typed as vec:Elem (#845).
    if mono_vt == value_types::VT_I32() || mono_vt == value_types::VT_I64() || mono_vt == value_types::VT_F64() || mono_vt == value_types::VT_F32() {
        if len(resolved_type) == 0 || !is_ref_type_name(ctx, resolved_type.clone()) {
            ctx_api_local_types::ctx_set_local_vt(ctx, dest, mono_vt)
        }
    } else if len(resolved_type) == 0 || !is_ref_type_name(ctx, resolved_type.clone()) {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, mono_vt)
    }
    // Sync MirLocal.value_type from MonoInstanceTable so emit spine lookup
    // matches SignatureRegistry (tuple mono returns; replaces body-scan infer).
    apply_mono_return_mvt_to_dest(ctx, callee_name.clone(), dest)
}

fn apply_mono_return_mvt_to_dest(mut ctx: LowerCtx, callee_name: String, dest: i32) {
    let mvt = mono_return_vt::mono_return_mvt(ctx, callee_name)
    if typed_mir_compat::mvt_is_invalid(mvt) {
        return
    }
    if mir_value_type::mir_value_type_repr(mvt) != kinds::VALUE_REPR_GC_REF() &&
    mir_value_type::mir_value_type_repr(mvt) != kinds::VALUE_REPR_LINEAR_PTR() {
        return
    }
    ctx_api_local_types::ctx_set_local_mvt(ctx, dest, mvt)
}

fn set_vt_for_resolved_type_name(mut ctx: LowerCtx, dest: i32, type_name: String) {
    if len(type_name) == 0 {
        return
    }
    if eq(type_name.clone(), "fnref") ||
    eq(type_name.clone(), "fn") ||
    type_name.clone().starts_with("fn(") {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_FUNCREF())
        return
    }
    if eq(type_name.clone(), "i32") || eq(type_name.clone(), "I32") || eq(type_name.clone(), "bool") || eq(type_name.clone(), "char") {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_I32())
        return
    }
    if eq(type_name.clone(), "i64") || eq(type_name.clone(), "I64") || eq(type_name.clone(), "u64") {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_I64())
        return
    }
    if eq(type_name.clone(), "f64") || eq(type_name.clone(), "F64") {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_F64())
        return
    }
    if eq(type_name.clone(), "f32") || eq(type_name.clone(), "F32") {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_F32())
        return
    }
    if eq(type_name.clone(), "v128") || eq(type_name.clone(), "V128") {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_V128())
        return
    }
    set_ref_vt_for_type_name(ctx, dest, type_name)
}

fn mark_struct_constructor_result_type(mut ctx: LowerCtx, callee_name: String, dest: i32) {
    let cn_stripped = call_type_fallback_stdlib::mir_strip_module_prefix(callee_name.clone())
    let cn_len = len(cn_stripped)
    if cn_len > 4 {
        let cn_suffix = cn_stripped.slice(cn_len - 4, cn_len)
        if eq(cn_suffix.clone(), "_new") {
            let struct_cand = cn_stripped.slice(0, cn_len - 4)
            // Name shadowing makes an X_new callee ambiguous: Box_new is
            // the prelude enum ctor, but a user struct Box claims the bare
            // name too. When both an enum base and a struct register under
            // struct_cand, defer to the callee's declared return type —
            // the rtn path resolves Box<T> / Box<i32> to enum:Box.
            let ambiguous = ctx_struct_layout::ctx_is_registered_enum_type(ctx, struct_cand.clone()) &&
            ctx_struct_layout::ctx_is_registered_struct_type(ctx, struct_cand.clone())
            if !ambiguous && ctx_struct_lookup::ctx_struct_field_count(ctx, struct_cand.clone()) > 0 {
                ctx_api_local_types::ctx_set_local_type(ctx, dest, ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, struct_cand))
                ctx_api_local_types::ctx_set_local_variant_slot(ctx, dest, 0 - 1)
            }
        }
    }
    // TomlValStep_ok / similar Type_ok helpers return the named struct.
    if cn_len > 3 {
        let ok_suffix = cn_stripped.slice(cn_len - 3, cn_len)
        if eq(ok_suffix.clone(), "_ok") {
            let struct_cand = cn_stripped.slice(0, cn_len - 3)
            if ctx_struct_lookup::ctx_struct_field_count(ctx, struct_cand.clone()) > 0 {
                ctx_api_local_types::ctx_set_local_type(ctx, dest, struct_cand.clone())
                ctx_api_local_types::ctx_set_local_variant_slot(ctx, dest, 0 - 1)
            }
        }
    }
}

// Set the local's val_type to VT_GC_REF or VT_REF when the type name
// is a reference type (String, struct, enum, vec, hashmap, option).
// This prevents the emitter from declaring the local as i32 and then
// storing a GC reference value into it, which produces invalid wasm.
fn set_ref_vt_for_type_name(mut ctx: LowerCtx, dest: i32, type_name: String) {
    if len(type_name) == 0 {
        return
    }
    if !is_ref_type_name(ctx, type_name.clone()) {
        return
    }
    if ctx_gc_enum::ctx_is_gc_target(ctx) {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_GC_REF())
    } else {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_REF())
    }
}

// Promote an Option/Result/enum container local to VT_GC_REF before
// MIR_GC_STRUCT_GET uses it as a base. Empty type_name forces VT_GC_REF.
fn mir_promote_gc_enum_container_vt(mut ctx: LowerCtx, local_idx: i32) {
    if !ctx_gc_enum::ctx_is_gc_target(ctx) {
        return
    }
    let tn = ctx_api_local_types::ctx_get_local_type(ctx, local_idx)
    if len(tn) > 0 {
        if is_ref_type_name(ctx, tn) {
            set_ref_vt_for_type_name(ctx, local_idx, tn)
        }
        return
    }
    ctx_api_local_types::ctx_set_local_vt(ctx, local_idx, value_types::VT_GC_REF())
}

fn is_ref_type_name(ctx: LowerCtx, type_name: String) -> bool {
    if eq(type_name.clone(), "String") || eq(type_name.clone(), "string") {
        return true
    }
    if type_name.clone().starts_with("vec:") || type_name.clone().starts_with("hashmap:") {
        return true
    }
    if type_name.clone().starts_with("option:") || type_name.clone().starts_with("Option_") {
        return true
    }
    if type_name.clone().starts_with("Result_") || type_name.clone().starts_with("result:") {
        return true
    }
    if type_name.clone().starts_with("enum:") {
        return true
    }
    if type_name.clone().starts_with("struct:") {
        return true
    }
    if type_name.clone().starts_with("tuple:") {
        return true
    }
    if ctx_struct_layout::ctx_is_registered_struct_type(ctx, type_name.clone()) {
        return true
    }
    if ctx_struct_layout::ctx_is_registered_enum_type(ctx, type_name.clone()) {
        return true
    }
    false
}
