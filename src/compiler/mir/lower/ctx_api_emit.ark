use mir::inst_draft
use mir::lower::ctx_emit_core
use mir::lower::ctx_locals_emit

fn ctx_emit(mut ctx: LowerCtx, mut inst: MirInstDraft) { ctx_locals_emit::ctx_emit(ctx, inst) }
fn ctx_current_block_ends_with_control_return(ctx: LowerCtx) -> bool {
    ctx_emit_core::ctx_current_block_ends_with_control_return(ctx)
}
fn ctx_alloc_block(mut ctx: LowerCtx) -> i32 { ctx_emit_core::ctx_alloc_block(ctx) }
fn ctx_enter_new_block(mut ctx: LowerCtx) -> i32 { ctx_emit_core::ctx_enter_new_block(ctx) }
