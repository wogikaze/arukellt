use mir::lower::call_rewrite
use mir::lower::call_rewrite_string
use mir::lower::call_emit_dest
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_types
use mir::lower::ctx_types
use mir::lower::call_args
use mir::lower::call_type_vec
use mir::lower::call_types
use mir::inst_call
use mir::value_types

fn mir_emit_method_call(ctx: LowerCtx, callee_name: String, arg_count: i32, first_arg_idx: i32) -> i32 {
    let bare_method = mir_method_bare_name(clone(callee_name))
    if eq(clone(bare_method), "to_string") {
        let string_rewrite = call_rewrite_string::mir_rewrite_to_string(ctx, "to_string", first_arg_idx)
        let return_local = call_rewrite_string::mir_string_call_rewrite_return_local(string_rewrite)
        if return_local >= 0 {
            return return_local
        }
        callee_name = call_rewrite_string::mir_string_call_rewrite_callee_name(string_rewrite)
    }
    let call_rewrite = call_rewrite::mir_rewrite_call_target(ctx, clone(callee_name), first_arg_idx, 0 - 1, false, 0)
    let return_local = call_rewrite::MirCallRewrite_return_local(call_rewrite)
    if return_local >= 0 {
        return return_local
    }
    callee_name = call_rewrite::MirCallRewrite_callee_name(call_rewrite)
    // Match direct-call dest allocation (including ::to_string GC-ref override).
    let dest = call_emit_dest::mir_prepare_direct_call_dest(ctx, clone(callee_name), first_arg_idx)
    // Reuse the same result-type propagation as direct calls so that
    // String/Vec/Hash/struct return types are inferred consistently.
    // first_arg_idx is the receiver's local index, which corresponds to
    // the first argument of the resolved intrinsic (e.g. vec_get_unchecked).
    call_types::mir_mark_call_result_type(ctx, clone(callee_name), dest, first_arg_idx)
    // Carry the marked dest vt onto the inst like mir_emit_direct_call does.
    // VT_VOID here made GC local-decl scans adopt the callee's declared
    // return (String for __core_string_clone_impl) even when the receiver
    // was a scalar type variable (#691).
    let mut dest_vt = value_types::VT_VOID()
    if dest >= 0 {
        dest_vt = ctx_api_local_types::ctx_local_vt(ctx, dest)
    }
    // Record the vec/receiver local on get_unchecked/push-style calls so GC
    // emit and mir_opt fallback resolution read arg0 instead of scanning
    // staged args — non-contiguous staging (tuple/record arg construction
    // interleaves LOCAL_GETs) otherwise resolves the wrong local (#888).
    // Same contract as mir_emit_direct_call; len/is_empty stay unrecorded
    // for STRUCT_GET→CALL stack-compose (#807 / #834).
    if first_arg_idx >= 0 && (
        call_args::mir_is_printlike_callee(clone(callee_name)) ||
        call_type_vec::is_get_unchecked_callee(clone(callee_name)) ||
        eq(clone(callee_name), String_from("push")) ||
        eq(clone(callee_name), String_from("vec_push")) ||
        eq(clone(callee_name), String_from("push_char")) ||
        starts_with(clone(callee_name), String_from("push__"))
    ) {
        ctx_emit(ctx, inst_call::MirInst_call_with_first_arg_vt(clone(callee_name), arg_count, dest, first_arg_idx, dest_vt))
    } else {
        ctx_emit(ctx, inst_call::MirInst_call_with_val_type(clone(callee_name), arg_count, dest, dest_vt))
    }
    if dest < 0 {
        return 0 - 1
    }
    dest
}

fn mir_method_bare_name(mangled: String) -> String {
    let pos = index_of(clone(mangled), "::")
    if pos < 0 {
        return clone(mangled)
    }
    substring(mangled, pos + 2, len(mangled))
}
