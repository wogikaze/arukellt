//
// When a generic function `<T: Trait>` is monomorphized, the type variable
// `T` is replaced by a concrete type. This module provides the mapping
// from type parameter names to concrete type names so that method call
// resolution can construct `ConcreteType::method` instead of `?T::method`.

use mir::lower::ctx_current_storage
use mir::lower::ctx_fn_index
use mir::lower::ctx_types
use mir::lower::return_typeinfo_names
use mir::lower_kinds
use mir::mono
use mir::function_locals_view
use mir::local_access
use mir::lower::ctx_api_module
use mir::type_contracts

// Convert a TypeInfo to a monomorphization type key string.
// Primitive types (i32, f64, etc.) carry only a tag with an empty name,
// so we must use the tag to produce the correct key.
fn mir_type_info_to_mono_key(ty: TypeInfo) -> String {
    let tag = type_contracts::TypeInfo_tag(ty)
    if tag == lower_kinds::TY_TYPE_VAR() {
        return concat("?", type_contracts::TypeInfo_name(ty))
    }
    if tag == lower_kinds::TY_I32() { return "i32" }
    if tag == lower_kinds::TY_I64() { return "i64" }
    if tag == lower_kinds::TY_F64() { return "f64" }
    if tag == lower_kinds::TY_F32() { return "f32" }
    if tag == lower_kinds::TY_BOOL() { return "bool" }
    if tag == lower_kinds::TY_STRING() { return "String" }
    if tag == lower_kinds::TY_CHAR() { return "char" }
    if tag == lower_kinds::TY_UNIT() { return "()" }
    // The parser represents `()` as an empty tuple TypeInfo. It is the unit
    // payload when it appears inside Result/Option, not an open type.
    if tag == lower_kinds::TY_TUPLE() && type_contracts::TypeInfo_type_arg_count(ty) == 0 {
        return "unit"
    }
    if tag == lower_kinds::TY_VEC() {
        let vec_name = return_typeinfo_names::mir_vec_return_type_name_from_type_info(ty)
        if len(vec_name) > 0 {
            return vec_name
        }
        return "vec:i32"
    }
    if tag == lower_kinds::TY_OPTION() {
        return return_typeinfo_names::mir_option_return_type_name_from_type_info(ty)
    }
    if tag == lower_kinds::TY_RESULT() {
        return return_typeinfo_names::mir_result_return_type_name_from_type_info(ty)
    }
    if tag == lower_kinds::TY_STRUCT() || tag == lower_kinds::TY_ENUM() {
        let name = type_contracts::TypeInfo_name(ty)
        // Built-in Vec is represented as a generic struct by the type
        // checker. Preserve its element type when it appears inside a
        // compound return such as `(Vec<T>, i32)`.
        if eq(clone(name), "Vec") && type_contracts::TypeInfo_type_arg_count(ty) > 0 {
            return return_typeinfo_names::mir_vec_return_type_name_from_type_info(ty)
        }
        // User generic structs keep their argument list (Pair<String>) so
        // monomorphized signatures and locals resolve the substituted
        // layout instead of the unsubstituted declaration.
        let arg_count = type_contracts::TypeInfo_type_arg_count(ty)
        if arg_count > 0 && !contains(clone(name), String_from("<")) {
            let mut out = concat(clone(name), String_from("<"))
            let mut ai = 0
            while ai < arg_count {
                if ai > 0 {
                    out = concat(out, String_from(","))
                }
                out = concat(out, mir_type_info_to_mono_key(type_contracts::TypeInfo_type_arg_at(ty, ai)))
                ai = ai + 1
            }
            return concat(out, String_from(">"))
        }
        return name
    }
    let name = type_contracts::TypeInfo_name(ty)
    if len(name) > 0 {
        return name
    }
    String_new()
}

fn ctx_set_mono_type_params(ctx: LowerCtx, names: Vec<String>, types: Vec<String>) {
    ctx.mono_type_param_names = names
    ctx.mono_type_param_types = types
}

// Aggregate annotations can contain an associated-type projection such as
// `vec:T::Item`. Keep the fully qualified spelling as an exact substitution
// key; splitting it into ordinary type-variable segments would lose the
// projection boundary and could resolve an unrelated `T` instead.
fn ctx_set_mono_type_projection(ctx: LowerCtx, generic_name: String, concrete_name: String) {
    if len(generic_name) == 0 || len(concrete_name) == 0 || eq(clone(generic_name), clone(concrete_name)) {
        return
    }
    push(ctx.mono_type_param_names, clone(generic_name))
    push(ctx.mono_type_param_types, clone(concrete_name))
    ctx_register_projection_arg_pairs(ctx, generic_name, concrete_name)
}

// An aggregate projection also binds element-wise: `vec:I::Item` ->
// `vec:i32` must answer `I::Item` -> `i32` for callers that only see the
// inner spelling, such as `Vec::new<I::Item>` inside a parametric impl
// body. Only same-shape aggregates decompose; plain type-var segments stay
// with ordinal setup, which registered them first.
fn ctx_register_projection_arg_pairs(ctx: LowerCtx, generic_name: String, concrete_name: String) {
    // Declared and instantiated spellings can differ in wrapper style
    // (`Vec<I::Item>` vs `vec:i32`); canonicalize before comparing shapes.
    let generic_name = ctx_projection_canonical_wrapper(generic_name)
    let concrete_name = ctx_projection_canonical_wrapper(concrete_name)
    if starts_with(clone(generic_name), String_from("vec:")) &&
    starts_with(clone(concrete_name), String_from("vec:")) {
        ctx_register_projection_segment(
            ctx,
            substring(clone(generic_name), 4, len(generic_name)),
            substring(clone(concrete_name), 4, len(concrete_name))
        )
        return
    }
    if starts_with(clone(generic_name), String_from("Option_")) &&
    starts_with(clone(concrete_name), String_from("Option_")) {
        ctx_register_projection_segment(
            ctx,
            substring(clone(generic_name), 7, len(generic_name)),
            substring(clone(concrete_name), 7, len(concrete_name))
        )
        return
    }
    let glt = index_of(clone(generic_name), String_from("<"))
    let clt = index_of(clone(concrete_name), String_from("<"))
    if glt <= 0 || clt <= 0 {
        return
    }
    if !ends_with(clone(generic_name), String_from(">")) ||
    !ends_with(clone(concrete_name), String_from(">")) {
        return
    }
    if !eq(
        substring(clone(generic_name), 0, glt),
        substring(clone(concrete_name), 0, clt)
    ) {
        return
    }
    let g_args = ctx_split_top_level_type_args(
        substring(clone(generic_name), glt + 1, len(generic_name) - 1)
    )
    let c_args = ctx_split_top_level_type_args(
        substring(clone(concrete_name), clt + 1, len(concrete_name) - 1)
    )
    if len(g_args) != len(c_args) {
        return
    }
    let mut i = 0
    while i < len(g_args) {
        ctx_register_projection_segment(
            ctx,
            get_unchecked(g_args, i),
            get_unchecked(c_args, i)
        )
        i = i + 1
    }
}

// Register one argument pair as a projection unless it is a plain type
// variable: `I` in `TakeIter<I>` is already bound by ordinal setup, while
// `I::Item` is a projection only the aggregate pair can describe.
// Canonicalize built-in wrappers to the local-type spelling used by the
// mono map: `Vec<X>` -> `vec:X`, `Option<X>` -> `Option_X`. User generic
// structs keep the `Name<args>` form.
fn ctx_projection_canonical_wrapper(name: String) -> String {
    if starts_with(clone(name), String_from("Vec<")) &&
    ends_with(clone(name), String_from(">")) {
        return concat(
            String_from("vec:"),
            substring(clone(name), 4, len(name) - 1)
        )
    }
    if starts_with(clone(name), String_from("Option<")) &&
    ends_with(clone(name), String_from(">")) {
        return concat(
            String_from("Option_"),
            substring(clone(name), 7, len(name) - 1)
        )
    }
    // Local-type spellings use option:payload; canonicalizing lets declared
    // Option_Pair / option:Pair pairs share the Option_ segment path (#860).
    if starts_with(clone(name), String_from("option:")) {
        return concat(
            String_from("Option_"),
            substring(clone(name), 7, len(name))
        )
    }
    name
}

fn ctx_register_projection_segment(ctx: LowerCtx, generic_seg: String, concrete_seg: String) {
    if len(generic_seg) == 0 || len(concrete_seg) == 0 {
        return
    }
    if is_plain_type_var_name(clone(generic_seg)) ||
    starts_with(clone(generic_seg), String_from("?")) {
        return
    }
    ctx_set_mono_type_projection(ctx, generic_seg, concrete_seg)
}

// Split `A<B, C<D,E>>` argument text on top-level commas only.
fn ctx_split_top_level_type_args(inner: String) -> Vec<String> {
    let args = Vec::new<String>()
    let mut depth = 0
    let mut seg_start = 0
    let n = len(inner)
    let mut i = 0
    while i <= n {
        let at_end = i == n
        if !at_end {
            let ch = byte_at(clone(inner), i)
            if ch == 60 {
                depth = depth + 1
            }
            if ch == 62 {
                depth = depth - 1
            }
        }
        if (at_end || byte_at(clone(inner), i) == 44) && depth == 0 {
            push(args, substring(clone(inner), seg_start, i))
            seg_start = i + 1
        }
        i = i + 1
    }
    args
}

fn ctx_clear_mono_type_params(ctx: LowerCtx) {
    if len(ctx.mono_type_param_names) == 0 && len(ctx.mono_type_param_types) == 0 {
        return
    }
    ctx.mono_type_param_names = Vec::new<String>()
    ctx.mono_type_param_types = Vec::new<String>()
}

fn ctx_resolve_mono_type_param(ctx: LowerCtx, type_var_name: String) -> String {
    let count = len(ctx.mono_type_param_names)
    let mut i = 0
    while i < count {
        let stored_name = clone(get_unchecked(ctx.mono_type_param_names, i))
        if eq(clone(stored_name), clone(type_var_name)) {
            return clone(get_unchecked(ctx.mono_type_param_types, i))
        }
        let seg_idx = ctx_mono_type_match_segment_index(stored_name, clone(type_var_name))
        if seg_idx >= 0 {
            return ctx_mono_type_segment_value(
                clone(get_unchecked(ctx.mono_type_param_names, i)),
                clone(get_unchecked(ctx.mono_type_param_types, i)),
                seg_idx
            )
        }
        i = i + 1
    }
    String_new()
}

// Return the index of the stored-name segment that equals the queried
// variable, or -1. Stored names may be composite (option:T, ?Result:T:E):
// a bare query (T) matches the variable segment, not the wrapper.
fn ctx_mono_type_match_segment_index(stored_name: String, query_name: String) -> i32 {
    let query = ctx_mono_type_var_bare_name(clone(query_name))
    let mut segment_start = 0
    let mut seg_index = 0
    let mut i = 0
    while i <= len(stored_name) {
        let at_end = i == len(stored_name)
        if at_end || byte_at(clone(stored_name), i) == 58 {
            let segment = substring(clone(stored_name), segment_start, i)
            if eq(ctx_mono_type_var_bare_name(clone(segment)), clone(query)) {
                return seg_index
            }
            segment_start = i + 1
            seg_index = seg_index + 1
        }
        i = i + 1
    }
    0 - 1
}

// A composite stored pair binds the queried variable at the matched
// segment position: option:T -> option:i32 answers T -> i32, not the
// whole option:i32 (which would poison vec:T into vec:option:i32).
// Whole-type answers stay only for mismatched shapes (I::Item -> i32)
// where segment positions cannot align.
fn ctx_mono_type_segment_value(stored_name: String, stored_type: String, seg_idx: i32) -> String {
    if ctx_mono_count_colon_segments(stored_name) != ctx_mono_count_colon_segments(clone(stored_type)) {
        return stored_type
    }
    ctx_mono_colon_segment_at(stored_type, seg_idx)
}

fn ctx_mono_count_colon_segments(name: String) -> i32 {
    let mut count = 1
    let mut i = 0
    while i < len(name) {
        if byte_at(clone(name), i) == 58 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn ctx_mono_colon_segment_at(name: String, want: i32) -> String {
    let mut segment_start = 0
    let mut seg_index = 0
    let mut i = 0
    while i <= len(name) {
        if i == len(name) || byte_at(clone(name), i) == 58 {
            if seg_index == want {
                return substring(clone(name), segment_start, i)
            }
            segment_start = i + 1
            seg_index = seg_index + 1
        }
        i = i + 1
    }
    name
}

fn ctx_mono_type_var_bare_name(name: String) -> String {
    if starts_with(clone(name), "?") {
        return substring(name, 1, len(name))
    }
    name
}

fn ctx_has_mono_type_params(ctx: LowerCtx) -> bool {
    len(ctx.mono_type_param_names) > 0
}

// Collect type variable names (strings starting with "?") from the
// current function's local type names, in order of local index.
// Returns a deduplicated ordered list.
fn ctx_collect_type_var_names(ctx: LowerCtx) -> Vec<String> {
    let result = Vec::new<String>()
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    let local_count = function_locals_view::MirFunction_local_count(func)
    let mut i = 0
    while i < local_count {
        let loc = function_locals_view::MirFunction_local_at(func, i)
        let ty_name = local_access::MirLocal_type_name(loc)
        // Extract the actual type variable name. For composite types like
        // "?Option:T", extract the inner "T". For plain type vars like "?T",
        // use the name as-is.
        let local_vars = ctx_type_var_names_from_local_type(clone(ty_name))
        let local_var_count = len(local_vars)
        let mut vi = 0
        while vi < local_var_count {
            let var_name = get_unchecked(local_vars, vi)
            let mut found = false
            let rcount = len(result)
            let mut k = 0
            while k < rcount {
                if eq(get_unchecked(result, k), clone(var_name)) {
                    found = true
                }
                k = k + 1
            }
            if !found {
                push(result, clone(var_name))
            }
            vi = vi + 1
        }
        i = i + 1
    }
    result
}

fn ctx_type_var_names_from_local_type(ty_name: String) -> Vec<String> {
    let result = Vec::new<String>()
    if starts_with(clone(ty_name), "?") {
        let stripped = substring(clone(ty_name), 1, len(ty_name))
        if !contains(clone(stripped), String_from(":")) {
            push(result, stripped)
            return result
        }
        ctx_push_colon_var_segments(stripped, result)
        return result
    }
    if is_plain_type_var_name(clone(ty_name)) {
        push(result, ty_name)
        return result
    }
    // fnsig:<param>;<return> locals carry the function's type variables
    // in both segments: a "f: fn(T) -> U" parameter must contribute T and
    // U to the ordinal pairing, otherwise the mono map leaves U unbound
    // and the fallback ordinal guess picks the wrong concrete type (#860).
    if starts_with(clone(ty_name), "fnsig:") {
        ctx_push_fnsig_var_segments(clone(ty_name), result)
        return result
    }
    // Canonical wrapper spellings (vec:T, option:T, result:T:E) carry the
    // function's type variables in their segments: a Vec<T> parameter keeps
    // the vec:T local spelling, so it must contribute T to the ordinal
    // pairing exactly like a ?T local does. struct:/enum: spellings are
    // excluded — their middle segment is a concrete layout name, and a
    // one-letter struct id (struct:P:7) is not a type variable.
    if ctx_local_type_is_var_wrapper(clone(ty_name)) {
        ctx_push_colon_var_segments(ty_name, result)
        return result
    }
    // Associated-type projections (I::Item) are not themselves type
    // variables, but their head segment is — a local typed I::Item still
    // needs I bound for the ordinal pairing.
    let proj = index_of(clone(ty_name), String_from("::"))
    if proj > 0 {
        let head = substring(clone(ty_name), 0, proj)
        if is_plain_type_var_name(clone(head)) {
            push(result, head)
        }
    }
    // Generic-instantiation spellings carry their type variables as
    // angle-bracket arguments: a self/param local typed Skip<I> or
    // Pair<T,Vec<U>> must still contribute its variables to the ordinal
    // pairing, otherwise the mono map stays empty and struct literals in
    // the body cannot derive their instantiated layout.
    let lt = index_of(clone(ty_name), String_from("<"))
    if lt > 0 && ends_with(clone(ty_name), String_from(">")) {
        let inner = substring(clone(ty_name), lt + 1, len(ty_name) - 1)
        let args = ctx_split_top_level_type_args(inner)
        let mut ai = 0
        while ai < len(args) {
            let arg = get_unchecked(args, ai)
            if is_plain_type_var_name(clone(arg)) {
                push(result, clone(arg))
            } else {
                let nested = ctx_type_var_names_from_local_type(clone(arg))
                let mut ni = 0
                while ni < len(nested) {
                    push(result, get_unchecked(nested, ni))
                    ni = ni + 1
                }
            }
            ai = ai + 1
        }
    }
    result
}

// Push the ;-separated segments of a fnsig: local spelling. Every
// segment is a type position (unlike colon wrappers whose first segment
// is the wrapper name), so each one contributes its variables.
fn ctx_push_fnsig_var_segments(ty_name: String, result: Vec<String>) {
    let rest = substring(clone(ty_name), 6, len(ty_name))
    let mut seg_start = 0
    let n = len(rest)
    let mut i = 0
    while i <= n {
        if i == n || byte_at(clone(rest), i) == 59 {
            let seg = substring(clone(rest), seg_start, i)
            ctx_push_var_segment(clone(seg), true, result)
            seg_start = i + 1
        }
        i = i + 1
    }
}

// Colon-composite local spellings whose argument segments may hold type
// variables. vec:/option:/result:/hashmap: are the canonical aggregate
// shapes produced by param_shape_local; Option:/Result: appear as param
// spellings in mono bodies.
fn ctx_local_type_is_var_wrapper(ty_name: String) -> bool {
    starts_with(clone(ty_name), String_from("vec:")) ||
    starts_with(clone(ty_name), String_from("option:")) ||
    starts_with(clone(ty_name), String_from("Option:")) ||
    starts_with(clone(ty_name), String_from("result:")) ||
    starts_with(clone(ty_name), String_from("Result:")) ||
    starts_with(clone(ty_name), String_from("hashmap:"))
}

// Push type-variable argument segments of a colon-composite spelling.
// The first segment is the wrapper name and never a variable; later
// segments contribute only when they are plain type variables (T, E).
// Composite segments (Pair<T>, vec:U) recurse so nested variables are
// still found — the angle-argument path below already handled them when
// the whole spelling was Name<args>.
fn ctx_push_colon_var_segments(stripped: String, result: Vec<String>) {
    let mut segment_start = 0
    let mut i = 0
    let n = len(stripped)
    let mut depth = 0
    while i <= n {
        let at_end = i == n
        let ch = if at_end { 58 } else { byte_at(stripped, i) }
        if !at_end && (ch == 60 || ch == 40) {
            depth = depth + 1
        }
        if !at_end && (ch == 62 || ch == 41) {
            depth = depth - 1
        }
        if (at_end || ch == 58) && depth == 0 {
            let segment = substring(clone(stripped), segment_start, i)
            ctx_push_var_segment(segment, segment_start > 0, result)
            segment_start = i + 1
        }
        i = i + 1
    }
}

fn ctx_push_var_segment(segment: String, is_arg: bool, result: Vec<String>) {
    if !is_arg {
        return
    }
    if is_plain_type_var_name(clone(segment)) {
        push(result, segment)
        return
    }
    let nested = ctx_type_var_names_from_local_type(segment)
    let mut i = 0
    while i < len(nested) {
        push(result, get_unchecked(nested, i))
        i = i + 1
    }
}

fn is_plain_type_var_name(name: String) -> bool {
    if len(name) != 1 {
        return false
    }
    let c = byte_at(name, 0)
    c >= 65 && c <= 90
}

// Resolve declaration-shaped generic field names before backend layout
// selection. For example, `T` becomes `i32` and `vec:T` becomes `vec:i32`
// inside a monomorphized `Box<i32>`/`Slice<i32>` body.
fn ctx_resolve_mono_type_name(ctx: LowerCtx, type_name: String) -> String {
    if len(type_name) == 0 {
        return type_name
    }
    if !ctx_has_mono_type_params(ctx) {
        return type_name
    }
    let direct = ctx_resolve_mono_type_param(ctx, clone(type_name))
    if len(direct) > 0 {
        return direct
    }
    // Generic-wrapper spellings: ?Pair:T -> Pair<String>, Pair<T> ->
    // Pair<String>. Each argument segment resolves through the mono map.
    if starts_with(clone(type_name), "?") {
        let wrapped = ctx_resolve_wrapper_type_vars(ctx, substring(clone(type_name), 1, len(type_name)))
        if len(wrapped) > 0 {
            return wrapped
        }
    }
    if contains(clone(type_name), String_from("<")) && ends_with(clone(type_name), String_from(">")) {
        let wrapped = ctx_resolve_angle_type_vars(ctx, clone(type_name))
        if len(wrapped) > 0 {
            return wrapped
        }
    }
    if starts_with(clone(type_name), "vec:") {
        let elem = substring(clone(type_name), 4, len(type_name))
        let concrete_elem = ctx_resolve_mono_type_param(ctx, clone(elem))
        if len(concrete_elem) > 0 {
            return concat("vec:", concrete_elem)
        }
    }
    // `fnsig:<param>;<return>` spellings resolve segment by segment so a
    // generic `fn(T) -> U` field or parameter specializes alongside the
    // enclosing monomorphization (#860).
    if starts_with(clone(type_name), "fnsig:") {
        let resolved_fnsig = ctx_resolve_fnsig_type_vars(ctx, clone(type_name))
        if len(resolved_fnsig) > 0 {
            return resolved_fnsig
        }
    }
    type_name
}

// Resolve each `;`-separated fnsig segment through the mono map. Bare
// type variables use ctx_resolve_mono_type_param; composite segments
// (vec:/option:/Name<..>) recurse. Returns empty when nothing changed.
fn ctx_resolve_fnsig_type_vars(ctx: LowerCtx, type_name: String) -> String {
    let rest = substring(clone(type_name), 6, len(type_name))
    let mut out = String_from("fnsig:")
    let mut seg_start = 0
    let n = len(rest)
    let mut i = 0
    let mut changed = false
    while i <= n {
        if i == n || byte_at(clone(rest), i) == 59 {
            let seg = substring(clone(rest), seg_start, i)
            let resolved = ctx_resolve_fnsig_segment(ctx, clone(seg))
            if !eq(clone(resolved), clone(seg)) {
                changed = true
            }
            out = concat(out, resolved)
            if i < n {
                out = concat(out, String_from(";"))
            }
            seg_start = i + 1
        }
        i = i + 1
    }
    if !changed {
        return String_new()
    }
    out
}

fn ctx_resolve_fnsig_segment(ctx: LowerCtx, seg: String) -> String {
    if len(seg) == 0 {
        return seg
    }
    let direct = ctx_resolve_mono_type_param(ctx, clone(seg))
    if len(direct) > 0 {
        return direct
    }
    if contains(clone(seg), String_from(":")) || contains(clone(seg), String_from("<")) {
        let resolved_name = ctx_resolve_mono_type_name(ctx, clone(seg))
        // `X::Item` projections resolve through the owner's Iterator::next
        // signature once the head is concrete (#860/#691).
        let assoc = ctx_resolve_assoc_projection_type(ctx, clone(seg))
        if len(assoc) > 0 {
            return assoc
        }
        return resolved_name
    }
    seg
}

// "Pair:T:U" -> "Pair<String,i32>" when every argument segment resolves to
// a concrete type. The first segment is the wrapper name, not a variable.
fn ctx_resolve_wrapper_type_vars(ctx: LowerCtx, name: String) -> String {
    let mut seg_start = 0
    let n = len(name)
    let mut i = 0
    let mut out = String_new()
    let mut seg_index = 0
    while i <= n {
        if i == n || byte_at(clone(name), i) == 58 {
            let seg = substring(clone(name), seg_start, i)
            if seg_index == 0 {
                out = concat(clone(seg), String_from("<"))
            } else {
                let concrete = ctx_resolve_mono_type_param(ctx, clone(seg))
                if len(concrete) == 0 {
                    return String_new()
                }
                if seg_index > 1 {
                    out = concat(out, String_from(","))
                }
                out = concat(out, concrete)
            }
            seg_index = seg_index + 1
            seg_start = i + 1
        }
        i = i + 1
    }
    if seg_index <= 1 {
        return String_new()
    }
    concat(out, String_from(">"))
}

// "Pair<T,vec:U>" -> "Pair<String,vec:i32>". Arguments that are already
// concrete (i32) or still unresolved keep their spelling so partially
// bound instantiations such as Pair<i32,I::Item> -> Pair<i32,i32> resolve
// instead of collapsing back to the unsubstituted name (#860).
fn ctx_resolve_angle_type_vars(ctx: LowerCtx, type_name: String) -> String {
    let lt = index_of(clone(type_name), String_from("<"))
    if lt < 0 {
        return String_new()
    }
    let base = substring(clone(type_name), 0, lt)
    // A base-name projection answers every instantiation spelling in this
    // body: Pair -> Pair<i32,i32> registered directly, or the payload of
    // option:Pair -> option:Pair<i32,i32>, resolves Pair<i32,I::Item>
    // whose projection argument never bound by ordinal (#860).
    let base_inst = ctx_resolve_mono_base_projection(ctx, clone(base))
    if len(base_inst) > 0 {
        return base_inst
    }
    let args = ctx_split_top_level_type_args(
        substring(clone(type_name), lt + 1, len(type_name) - 1)
    )
    let mut out = concat(base, String_from("<"))
    let mut arg_index = 0
    while arg_index < len(args) {
        let arg = ctx_trim_type_arg_ws(get_unchecked(args, arg_index))
        let mut concrete = ctx_resolve_mono_type_param(ctx, clone(arg))
        if len(concrete) == 0 && contains(clone(arg), String_from("<")) {
            concrete = ctx_resolve_angle_type_vars(ctx, clone(arg))
        }
        if len(concrete) == 0 {
            concrete = arg
        }
        if arg_index > 0 {
            out = concat(out, String_from(","))
        }
        out = concat(out, concrete)
        arg_index = arg_index + 1
    }
    if arg_index == 0 {
        return String_new()
    }
    concat(out, String_from(">"))
}

// Base-name projection lookup for Name<...> queries. An exact Pair ->
// Pair<i32,i32> entry wins; otherwise a wrapper-prefixed entry such as
// option:Pair -> option:Pair<i32,i32> still describes this body's single
// Pair instantiation, so Pair<i32,I::Item> resolves through its payload.
// Exact matching only: the segment matching in ctx_resolve_mono_type_param
// would bind a Pair query to the option:Pair wrapper entry itself (#860).
fn ctx_resolve_mono_base_projection(ctx: LowerCtx, base: String) -> String {
    let count = len(ctx.mono_type_param_names)
    let mut i = 0
    while i < count {
        if eq(get_unchecked(ctx.mono_type_param_names, i), clone(base)) {
            return clone(get_unchecked(ctx.mono_type_param_types, i))
        }
        i = i + 1
    }
    i = 0
    while i < count {
        let stored = clone(get_unchecked(ctx.mono_type_param_names, i))
        let concrete = clone(get_unchecked(ctx.mono_type_param_types, i))
        let mut hit = ctx_wrapper_payload_projection(clone(stored), clone(concrete), String_from("option:"), clone(base))
        if len(hit) == 0 {
            hit = ctx_wrapper_payload_projection(clone(stored), clone(concrete), String_from("Option_"), clone(base))
        }
        if len(hit) == 0 {
            hit = ctx_wrapper_payload_projection(clone(stored), clone(concrete), String_from("vec:"), clone(base))
        }
        if len(hit) > 0 {
            return hit
        }
        i = i + 1
    }
    String_new()
}

// A stored pair of the form prefix+Base -> prefix+C binds the payload
// base Base -> C inside this mono body.
fn ctx_wrapper_payload_projection(stored: String, concrete: String, prefix: String, base: String) -> String {
    if !starts_with(clone(stored), clone(prefix)) || !starts_with(clone(concrete), clone(prefix)) {
        return String_new()
    }
    let plen = len(prefix)
    if !eq(substring(stored, plen, len(stored)), clone(base)) {
        return String_new()
    }
    substring(concrete, plen, len(concrete))
}

// Type argument lists are split on raw commas, so annotation spellings
// such as "Pair<i32, I::Item>" keep a leading space on later segments.
fn ctx_trim_type_arg_ws(seg: String) -> String {
    let mut start = 0
    let mut end = len(seg)
    while start < end && byte_at(clone(seg), start) == 32 {
        start = start + 1
    }
    while end > start && byte_at(clone(seg), end - 1) == 32 {
        end = end - 1
    }
    substring(seg, start, end)
}

// Setup type parameter mapping by collecting type variable names from
// the current function's locals and pairing them with the MonoInstance's
// type arguments by ordinal.
fn ctx_setup_mono_type_params_by_ordinal(ctx: LowerCtx, mangled_name: String) {
    // Concrete names have no "__" suffix. Walking locals just to allocate
    // two empty maps was extra GC traffic on every function.
    let name_len = len(mangled_name)
    let mut i = 0
    let mut has_sep = false
    while i < name_len - 1 {
        if byte_at(mangled_name, i) == 95 && byte_at(mangled_name, i + 1) == 95 {
            has_sep = true
            i = name_len
        } else {
            i = i + 1
        }
    }
    if !has_sep {
        return
    }
    let type_var_names = ctx_collect_type_var_names(ctx)
    if len(type_var_names) == 0 {
        ctx_clear_mono_type_params(ctx)
        return
    }
    let inst = ctx_api_module::ctx_mono_instance_at(ctx, mangled_name)
    let arg_count = type_contracts::MonoInstance_type_arg_count(inst)
    if arg_count <= 0 {
        ctx_clear_mono_type_params(ctx)
        return
    }
    let names = Vec::new<String>()
    let types = Vec::new<String>()
    let mut j = 0
    while j < arg_count && j < len(type_var_names) {
        let ty = type_contracts::MonoInstance_type_arg_at(inst, j)
        let ty_name = mir_type_info_to_mono_key(ty)
        push(names, clone(get_unchecked(type_var_names, j)))
        push(types, ty_name)
        j = j + 1
    }
    ctx_set_mono_type_params(ctx, names, types)
}

// ---------------------------------------------------------------------------
// Associated-type projection resolution (Owner::Item)
// ---------------------------------------------------------------------------

// `Owner::Item` resolves through the owner's Iterator::next signature:
// `next` returns `Option<Item>`, so the Option payload recorded in the
// function index is the item type. Concrete impls (VecIter::next) and
// monomorphized ones (SkipIter<VecIter<String>>::next) both live in the
// function index (#860/#691).
fn ctx_resolve_iterator_item_type(ctx: LowerCtx, owner_name: String) -> String {
    let owner = ctx_assoc_owner_base_name(owner_name)
    if len(owner) == 0 {
        return String_new()
    }
    let mut rt = ctx_assoc_next_return_type_name(ctx, concat(clone(owner), String_from("::next")))
    if len(rt) == 0 {
        rt = ctx_assoc_next_return_type_name(ctx, concat(clone(owner), String_from("__next")))
    }
    if len(rt) == 0 {
        let candidates = ctx_assoc_mono_next_names(clone(owner))
        let mut ci = 0
        while ci < len(candidates) {
            let found = ctx_assoc_next_return_type_name(ctx, get_unchecked(candidates, ci))
            if len(found) > 0 {
                rt = found
                ci = len(candidates)
            }
            ci = ci + 1
        }
    }
    ctx_option_payload_type_name(rt)
}

// Normalize an owner spelling for the function-index lookup: strip the
// `?` mono-body marker and unwrap `struct:Name:size` / `enum:Name`
// shells so the bare constructor name remains.
fn ctx_assoc_owner_base_name(owner_name: String) -> String {
    let mut name = clone(owner_name)
    if starts_with(clone(name), String_from("?")) {
        name = substring(name, 1, len(name))
    }
    if starts_with(clone(name), String_from("struct:")) || starts_with(clone(name), String_from("enum:")) {
        let inner = substring(clone(name), index_of(clone(name), String_from(":")) + 1, len(name))
        let tail = index_of(clone(inner), String_from(":"))
        if tail > 0 {
            return substring(inner, 0, tail)
        }
        return inner
    }
    name
}

fn ctx_assoc_next_return_type_name(ctx: LowerCtx, fn_name: String) -> String {
    let idx = ctx_fn_index::ctx_fn_index_find(ctx, clone(fn_name))
    if idx >= 0 {
        return ctx_fn_index::ctx_fn_index_return_type_name_at(ctx, idx)
    }
    let qidx = ctx_fn_index::ctx_qualified_fn_index_find(ctx, clone(fn_name))
    if qidx >= 0 {
        return ctx_fn_index::ctx_qualified_fn_return_type_name_at(ctx, qidx)
    }
    String_new()
}

// Candidate mangled `next` names for a generic-instantiation owner.
// `Base<args>` spells `Base__next__arg` per mono instance; the underscore
// spelling `Base_arg` tries the raw rest and the `__`-separated form.
fn ctx_assoc_mono_next_names(owner: String) -> Vec<String> {
    let names = Vec::new<String>()
    let lt = index_of(clone(owner), String_from("<"))
    if lt > 0 && ends_with(clone(owner), String_from(">")) {
        let base = substring(clone(owner), 0, lt)
        let args = ctx_split_top_level_type_args(substring(clone(owner), lt + 1, len(owner) - 1))
        let mut mangled = concat(base, String_from("__next"))
        let mut ai = 0
        while ai < len(args) {
            let arg = ctx_trim_type_arg_ws(get_unchecked(args, ai))
            mangled = concat(mangled, concat(String_from("__"), mono::mono_safe_name(arg)))
            ai = ai + 1
        }
        push(names, mangled)
        return names
    }
    let us = index_of(clone(owner), String_from("_"))
    if us > 0 {
        let base = substring(clone(owner), 0, us)
        let rest = substring(clone(owner), us + 1, len(owner))
        push(names, concat(concat(base, String_from("__next__")), clone(rest)))
        // An underscore owner can hide a `__` argument boundary inside a
        // single `_` run (MapIter_String_i32 -> MapIter__next__String__i32).
        let mut separated = String_new()
        let mut i = 0
        let n = len(rest)
        while i < n {
            if byte_at(clone(rest), i) == 95 {
                separated = concat(separated, String_from("__"))
            } else {
                separated = concat(separated, substring(clone(rest), i, i + 1))
            }
            i = i + 1
        }
        push(names, concat(concat(base, String_from("__next__")), separated))
    }
    names
}

// `option:X` / `Option_X` / `Option<X>` / `Option:X` -> X; anything
// else returns empty so non-Option signatures never resolve.
fn ctx_option_payload_type_name(rt: String) -> String {
    if starts_with(clone(rt), String_from("option:")) {
        return substring(rt, 7, len(rt))
    }
    if starts_with(clone(rt), String_from("Option<")) && ends_with(clone(rt), String_from(">")) {
        return substring(rt, 7, len(rt) - 1)
    }
    if starts_with(clone(rt), String_from("Option_")) {
        return substring(rt, 7, len(rt))
    }
    if starts_with(clone(rt), String_from("Option:")) {
        return substring(rt, 7, len(rt))
    }
    String_new()
}

// `X::Assoc` segment -> concrete type. The head may still be a type
// variable inside a mono body (resolved through the mono map) or an
// already-concrete owner. Only `Item` resolves today — it is the only
// associated type spelled inside callback signatures (#860/#691).
fn ctx_resolve_assoc_projection_type(ctx: LowerCtx, seg: String) -> String {
    let sep = find_last_double_colon(clone(seg))
    if sep < 0 {
        return String_new()
    }
    let assoc = substring(clone(seg), sep + 2, len(seg))
    if !eq(clone(assoc), String_from("Item")) {
        return String_new()
    }
    let mut owner = substring(clone(seg), 0, sep)
    let head = ctx_resolve_mono_type_param(ctx, clone(owner))
    if len(head) > 0 {
        owner = head
    }
    ctx_resolve_iterator_item_type(ctx, owner)
}

fn find_last_double_colon(name: String) -> i32 {
    let mut found = 0 - 1
    let mut i = 0
    while i + 1 < len(name) {
        if byte_at(clone(name), i) == 58 && byte_at(clone(name), i + 1) == 58 {
            found = i
            i = i + 2
            continue
        }
        i = i + 1
    }
    found
}

fn assoc_ident_char(ch: i32) -> bool {
    (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

// Resolve `Owner::Item` projections embedded anywhere in a field type
// spelling (fnsig:/vec:/option: segments). Parameter substitution turns
// `fn(I::Item) -> I::Item` into `fnsig:VecIter::Item;VecIter::Item`;
// each projection resolves through the owner's Iterator::next signature
// so downstream consumers see a concrete type. Unresolved projections
// keep their spelling so partially bound instantiations degrade as
// before (#860/#691).
fn ctx_resolve_field_type_projections(ctx: LowerCtx, ft: String) -> String {
    if !contains(clone(ft), String_from("::")) {
        return ft
    }
    let n = len(ft)
    // out_start: first un-emitted byte. outer_start: start of the current
    // depth-0 type segment (after the last top-level `:`/`;`). inner_start:
    // start of the current angle-bracket argument (after `<`/`,`).
    let mut out = String_new()
    let mut out_start = 0
    let mut outer_start = 0
    let mut inner_start = 0
    let mut depth = 0
    let mut i = 0
    while i < n {
        let ch = byte_at(clone(ft), i)
        if ch == 60 || ch == 40 {
            depth = depth + 1
            inner_start = i + 1
            i = i + 1
            continue
        }
        if ch == 62 || ch == 41 {
            depth = depth - 1
            i = i + 1
            continue
        }
        if ch == 44 && depth > 0 {
            inner_start = i + 1
            i = i + 1
            continue
        }
        if ch == 44 && depth == 0 {
            outer_start = i + 1
            i = i + 1
            continue
        }
        if ch == 58 && i + 1 < n && byte_at(clone(ft), i + 1) == 58 {
            let owner_start = if depth > 0 { inner_start } else { outer_start }
            let owner = substring(clone(ft), owner_start, i)
            let mut assoc_end = i + 2
            while assoc_end < n && assoc_ident_char(byte_at(clone(ft), assoc_end)) {
                assoc_end = assoc_end + 1
            }
            let assoc = substring(clone(ft), i + 2, assoc_end)
            let mut resolved = String_new()
            if eq(clone(assoc), String_from("Item")) {
                resolved = ctx_resolve_iterator_item_type(ctx, clone(owner))
            }
            out = concat(out, substring(clone(ft), out_start, owner_start))
            if len(resolved) > 0 {
                out = concat(out, resolved)
            } else {
                out = concat(out, clone(owner))
                out = concat(out, String_from("::"))
                out = concat(out, assoc)
            }
            out_start = assoc_end
            outer_start = assoc_end
            inner_start = assoc_end
            i = assoc_end
            continue
        }
        if ch == 58 && depth == 0 {
            outer_start = i + 1
        }
        if ch == 59 && depth == 0 {
            outer_start = i + 1
        }
        i = i + 1
    }
    out = concat(out, substring(clone(ft), out_start, n))
    out
}
