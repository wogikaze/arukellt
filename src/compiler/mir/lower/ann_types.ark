use mir::lower::ann_shape
use mir::value_types
fn mir_param_type_name_from_ann(ty: AstNode) -> String {
    ann_shape::mir_param_type_name_from_ann_shape(ty)
}

fn mir_local_vt_from_type_name(type_name: String) -> i32 {
    if type_name.clone().eq("f64") {
        return value_types::VT_F64()
    }
    if type_name.clone().eq("f32") {
        return value_types::VT_F32()
    }
    if type_name.clone().eq("v128") {
        return value_types::VT_V128()
    }
    if type_name.clone().eq("i64") || type_name.clone().eq("u64") {
        return value_types::VT_I64()
    }
    if type_name.clone().eq("Vec") ||
    type_name.clone().eq("HashMap") ||
    type_name.clone().eq("HashSet") ||
    type_name.clone().eq("String") ||
    type_name.clone().eq("Option") ||
    type_name.clone().eq("Result") {
        return value_types::VT_GC_REF()
    }
    // fnref-family spellings (fnref/fnref2/fnrefss/fnrefsb/fnsig:/fn)
    // mark a callback ABI local, which must keep the pair-ABI value type
    // so stores into it do not expect a scalar (#884).
    if type_name.clone().eq("fn") ||
    type_name.clone().starts_with("fnref") ||
    type_name.clone().starts_with("fnsig:") {
        return value_types::VT_FUNCREF()
    }
    value_types::VT_I32()
}

fn mir_local_type_name_from_ann(ann: AstNode, known_struct_fields: i32) -> String {
    ann_shape::mir_local_type_name_from_ann_shape(ann, known_struct_fields)
}
