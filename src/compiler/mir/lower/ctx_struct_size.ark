use std::prelude::{eq}
use mir::lower::ctx_struct_storage
fn ctx_struct_layout_field_count(ctx: LowerCtx, struct_name: String) -> i32 {
    let li = ctx_struct_storage::ctx_struct_layout_preferred_index(ctx, struct_name.clone())
    if li < 0 {
        return 0
    }
    ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, li)
}

fn ctx_struct_byte_size(ctx: LowerCtx, struct_name: String) -> i32 {
    let li = ctx_struct_storage::ctx_struct_layout_preferred_index(ctx, struct_name.clone())
    if li < 0 {
        return 0
    }
    let offset = ctx_struct_storage::ctx_struct_layout_field_offset_at(ctx, li)
    let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, li)
    let mut byte_off = 0
    let mut fi = 0
    while fi < fc {
        let ft = ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, offset + fi)
        byte_off = byte_off + ctx_struct_field_byte_size(ft)
        fi = fi + 1
    }
    byte_off
}

fn ctx_struct_field_byte_size(field_type: String) -> i32 {
    if eq(field_type.clone(), "f64") {
        return 8
    }
    if eq(field_type.clone(), "i64") || eq(field_type.clone(), "u64") {
        return 8
    }
    4
}
