use std::prelude::{clone}
use corehir::mir_value_type
use corehir::type_id
use mir::inst_draft
use mir::function_locals_view
use mir::local_access
use mir::local_mutation
use mir::lower::ctx_current_storage
use mir::function_local_mutation
use mir::spine_lookup
use mir::typed_mir_compat
use mir::value_types
fn ctx_sync_local_value_type(ctx: LowerCtx, local_idx: i32) {
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    if local_idx < 0 || local_idx >= function_locals_view::MirFunction_local_count(func) {
        return
    }
    let loc = function_locals_view::MirFunction_local_at(func, local_idx)
    let vt = local_access::MirLocal_val_type(loc)
    let tn = local_access::MirLocal_type_name(loc)
    let mvt = spine_lookup::legacy_vt_to_mvt(m, vt, clone(tn))
    let mut f = func
    let new_loc = local_mutation::MirLocal_copy_with_value_type(loc, mvt)
    function_local_mutation::MirFunction_set_local(f, local_idx, new_loc)
    ctx_current_storage::ctx_set_current_func_value(ctx, f)
}

fn ctx_set_local_mvt(ctx: LowerCtx, local_idx: i32, value_type: MirValueType) {
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    if local_idx < 0 || local_idx >= function_locals_view::MirFunction_local_count(func) {
        return
    }
    let loc = function_locals_view::MirFunction_local_at(func, local_idx)
    let mut f = func
    let new_loc = local_mutation::MirLocal_copy_with_value_type(loc, value_type)
    function_local_mutation::MirFunction_set_local(f, local_idx, new_loc)
    ctx_current_storage::ctx_set_current_func_value(ctx, f)
}

fn ctx_local_mvt(ctx: LowerCtx, local_idx: i32) -> MirValueType {
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    if local_idx < 0 || local_idx >= function_locals_view::MirFunction_local_count(func) {
        return typed_mir_compat::mvt_invalid()
    }
    let loc = function_locals_view::MirFunction_local_at(func, local_idx)
    local_access::MirLocal_value_type(loc)
}

// INV-2: a result type that already carries a valid TypeId is authoritative.
// Deriving it again from the legacy vt used to overwrite every typed result
// with a TYPE_ID_INVALID MirValueType before it reached the block.
fn ctx_inst_has_typed_result(inst: MirInstDraft) -> bool {
    if inst_draft::MirInstDraft_result_type_count(inst) <= 0 {
        return false
    }
    let first = inst_draft::MirInstDraft_result_type_at(inst, 0)
    type_id::type_id_is_valid(mir_value_type::mir_value_type_type_id(first))
}

fn ctx_enrich_inst_result_types(ctx: LowerCtx, inst: MirInstDraft) -> MirInstDraft {
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    if !spine_lookup::spine_populated(m) {
        return inst
    }
    if ctx_inst_has_typed_result(inst) {
        return inst
    }
    let op = inst_draft::MirInstDraft_op(inst)
    let mvts = spine_lookup::call_return_mvts_from_fid(
        m,
        op,
        inst_draft::MirInstDraft_func_id_raw(inst)
    )
    if len(mvts) > 0 {
        let first = get_unchecked(mvts, 0)
        // A registry return without a valid TypeId cannot describe the call's
        // storage. Leave the result empty so W009 reports the gap; filling it
        // from the legacy vt would only recreate the fake packed result that
        // INV-1 rejects.
        if !type_id::type_id_is_valid(mir_value_type::mir_value_type_type_id(first)) {
            return inst
        }
        inst_draft::MirInstDraft_set_result_types(inst, mvts)
        return inst
    }
    let vt = inst_draft::MirInstDraft_val_type(inst)
    if vt != value_types::VT_VOID() {
        inst_draft::MirInstDraft_set_result_types(
            inst,
            typed_mir_compat::result_types_from_legacy_vt(vt)
        )
        return inst
    }
    inst
}
