use mir::lower::ctx_variant_storage
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_enum_sig

fn ctx_register_builtin_variant_tags(ctx: LowerCtx) {
    ctx_variant_storage::ctx_variant_push_tag(ctx, "Some", 0)
    ctx_variant_storage::ctx_variant_push_tag(ctx, "None", 1)
    ctx_variant_storage::ctx_variant_push_tag(ctx, "Option::Some", 0)
    ctx_variant_storage::ctx_variant_push_tag(ctx, "Option::None", 1)
    ctx_variant_storage::ctx_variant_push_tag(ctx, "Ok", 0)
    ctx_variant_storage::ctx_variant_push_tag(ctx, "Err", 1)
    ctx_variant_storage::ctx_variant_push_tag(ctx, "Result::Ok", 0)
    ctx_variant_storage::ctx_variant_push_tag(ctx, "Result::Err", 1)
}

fn ctx_register_builtin_payload_variants(ctx: LowerCtx) {
    ctx_variant_storage::ctx_payload_variant_push(ctx, "Some")
    ctx_variant_storage::ctx_payload_variant_push(ctx, "None")
    ctx_variant_storage::ctx_payload_variant_push(ctx, "Ok")
    ctx_variant_storage::ctx_payload_variant_push(ctx, "Err")
    ctx_variant_storage::ctx_payload_variant_push(ctx, "Option::Some")
    ctx_variant_storage::ctx_payload_variant_push(ctx, "Option::None")
    ctx_variant_storage::ctx_payload_variant_push(ctx, "Result::Ok")
    ctx_variant_storage::ctx_payload_variant_push(ctx, "Result::Err")
    if ctx_gc_enum::ctx_is_gc_target(ctx) {
        register_builtin_gc_variant(ctx, "Option::None", false, String_new())
        register_builtin_gc_variant(ctx, "Option::Some", true, "_f1_i32")
        register_builtin_gc_variant(ctx, "Option::Some", true, "_f1_i64")
        register_builtin_gc_variant(ctx, "Option::Some", true, "_f1_f64")
        register_builtin_gc_variant(ctx, "Option::Some", true, "_f1_ref0")
        register_builtin_gc_variant(ctx, "Result::Ok", true, "_f1_i32")
        register_builtin_gc_variant(ctx, "Result::Ok", true, "_f1_i64")
        register_builtin_gc_variant(ctx, "Result::Ok", true, "_f1_f64")
        register_builtin_gc_variant(ctx, "Result::Ok", true, "_f1_ref0")
        register_builtin_gc_variant(ctx, "Result::Ok", true, "_f1_ref10")
        register_builtin_gc_variant(ctx, "Ok", true, "_f1_ref10")
        register_builtin_gc_variant(ctx, "Result::Err", true, "_f1_i32")
        register_builtin_gc_variant(ctx, "Result::Err", true, "_f1_ref0")
        register_builtin_gc_variant(ctx, "Result::Err", true, "_f1_ref14")
    }
}

fn register_builtin_gc_variant(ctx: LowerCtx, name: String, has_payload: bool, field_sigs: String) {
    let slot = len(ctx.gc_enum_variant_names)
    let sig = if has_payload {
        ctx_gc_enum_sig::gc_enum_payload_variant_sig(slot, field_sigs)
    } else {
        ctx_gc_enum_sig::gc_enum_unit_variant_sig(slot)
    }
    ctx_gc_enum::ctx_register_gc_enum_variant(ctx, clone(name), sig)
}
