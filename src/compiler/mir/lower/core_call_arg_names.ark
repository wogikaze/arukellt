use std::prelude::{eq}
use mir::lower::ctx_fn_return_type
fn mir_core_is_printlike_callee(name: String) -> bool {
    eq(name.clone(), "stdio::println") ||
    eq(name.clone(), "println") ||
    eq(name.clone(), "stdio::print") ||
    eq(name.clone(), "print") ||
    eq(name.clone(), "stdio::eprintln") ||
    eq(name.clone(), "eprintln") ||
    eq(name.clone(), "__intrinsic_println") ||
    eq(name.clone(), "__intrinsic_eprintln") ||
    eq(name.clone(), "__intrinsic_eprint") ||
    eq(name.clone(), "__intrinsic_print")
}

fn mir_core_call_bool_result_name(name: String) -> bool {
    eq(name.clone(), "contains_i32") ||
    eq(name.clone(), "contains_string") ||
    eq(name.clone(), "contains_String") ||
    eq(name.clone(), "contains") ||
    eq(name.clone(), "is_empty") ||
    eq(name.clone(), "is_some") ||
    eq(name.clone(), "is_none") ||
    eq(name.clone(), "starts_with") ||
    eq(name.clone(), "ends_with")
}

fn mir_core_call_i32_result_name(name: String) -> bool {
    eq(name.clone(), "len") ||
    eq(name.clone(), "parse_i32") ||
    eq(name.clone(), "abs") ||
    eq(name.clone(), "min") ||
    eq(name.clone(), "max") ||
    eq(name.clone(), "sum_i32") ||
    eq(name.clone(), "product_i32") ||
    eq(name.clone(), "index_of") ||
    eq(name.clone(), "clamp_i32") ||
    eq(name.clone(), "get_unchecked") ||
    eq(name.clone(), "vec_get_unchecked_i32") ||
    eq(name.clone(), "bytes_get") ||
    eq(name.clone(), "bytes_len")
}

fn mir_core_call_short_name(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    name.clone()
}

fn mir_core_call_string_result_name(name: String) -> bool {
    if eq(name.clone(), "String_from") ||
    eq(name.clone(), "concat") ||
    eq(name.clone(), "text::concat") ||
    eq(name.clone(), "to_string") ||
    eq(name.clone(), "slice") ||
    eq(name.clone(), "substring") ||
    eq(name.clone(), "trim") ||
    eq(name.clone(), "replace") ||
    eq(name.clone(), "to_upper") ||
    eq(name.clone(), "to_lower") ||
    eq(name.clone(), "to_uppercase") ||
    eq(name.clone(), "to_lowercase") {
        return true
    }
    if name.clone().ends_with("_to_string") || name.clone().ends_with("_from_string") || name.clone().ends_with("_from_bytes") || name.clone().ends_with("_encode") {
        return true
    }
    let short = mir_core_call_short_name(name.clone())
    if eq(short.clone(), "slice") ||
    eq(short.clone(), "greet") ||
    eq(short.clone(), "string_from_bytes") ||
    eq(short.clone(), "hex_encode") ||
    eq(short.clone(), "rope_new") {
        return true
    }
    if eq(short.clone(), "rope_to_string") ||
    eq(short.clone(), "rope_from_string") ||
    eq(short.clone(), "rope_slice") ||
    eq(short.clone(), "rope_insert") ||
    eq(short.clone(), "rope_delete") ||
    eq(short.clone(), "rope_concat") {
        return true
    }
    false
}

// `mir_core_call_string_result_name` reads the callee spelling. That evidence
// is only conclusive for the removed CoreOp impl symbols (`raw_f64_to_string`,
// `__core_i32_to_string_impl`, `..._from_bytes`) that the DCE pass drops: they
// have no declaration left, so the name is all a call site can resolve.
// A live declaration owns its return type. The generated
// `core_op_handler_text_to_string` accessor ends with `_to_string` but returns
// the i32 handler id; typing that result as a String ref lowered
// `handler_id == core_op_handler_text_to_string()` as a reference comparison
// and produced invalid core Wasm.
fn mir_core_call_callee_returns_string(ctx: LowerCtx, name: String) -> bool {
    if !mir_core_call_string_result_name(name.clone()) {
        return false
    }
    len(ctx_fn_return_type::ctx_fn_return_type_name(ctx, name.clone())) == 0
}
