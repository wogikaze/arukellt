use std::prelude::{clone, eq}
use mir::lower::ctx_fn_return_type
fn mir_core_is_printlike_callee(name: String) -> bool {
    eq(clone(name), "stdio::println") ||
    eq(clone(name), "println") ||
    eq(clone(name), "stdio::print") ||
    eq(clone(name), "print") ||
    eq(clone(name), "stdio::eprintln") ||
    eq(clone(name), "eprintln") ||
    eq(clone(name), "__intrinsic_println") ||
    eq(clone(name), "__intrinsic_eprintln") ||
    eq(clone(name), "__intrinsic_eprint") ||
    eq(clone(name), "__intrinsic_print")
}

fn mir_core_call_bool_result_name(name: String) -> bool {
    eq(clone(name), "contains_i32") ||
    eq(clone(name), "contains_string") ||
    eq(clone(name), "contains_String") ||
    eq(clone(name), "contains") ||
    eq(clone(name), "is_empty") ||
    eq(clone(name), "is_some") ||
    eq(clone(name), "is_none") ||
    eq(clone(name), "starts_with") ||
    eq(clone(name), "ends_with")
}

fn mir_core_call_i32_result_name(name: String) -> bool {
    eq(clone(name), "len") ||
    eq(clone(name), "parse_i32") ||
    eq(clone(name), "abs") ||
    eq(clone(name), "min") ||
    eq(clone(name), "max") ||
    eq(clone(name), "sum_i32") ||
    eq(clone(name), "product_i32") ||
    eq(clone(name), "index_of") ||
    eq(clone(name), "clamp_i32") ||
    eq(clone(name), "get_unchecked") ||
    eq(clone(name), "vec_get_unchecked_i32") ||
    eq(clone(name), "bytes_get") ||
    eq(clone(name), "bytes_len")
}

fn mir_core_call_short_name(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    clone(name)
}

fn mir_core_call_string_result_name(name: String) -> bool {
    if eq(clone(name), "String_from") ||
    eq(clone(name), "concat") ||
    eq(clone(name), "text::concat") ||
    eq(clone(name), "to_string") ||
    eq(clone(name), "slice") ||
    eq(clone(name), "substring") ||
    eq(clone(name), "trim") ||
    eq(clone(name), "replace") ||
    eq(clone(name), "to_upper") ||
    eq(clone(name), "to_lower") ||
    eq(clone(name), "to_uppercase") ||
    eq(clone(name), "to_lowercase") {
        return true
    }
    if clone(name).ends_with("_to_string") || clone(name).ends_with("_from_string") || clone(name).ends_with("_from_bytes") || clone(name).ends_with("_encode") {
        return true
    }
    let short = mir_core_call_short_name(clone(name))
    if eq(clone(short), "slice") ||
    eq(clone(short), "greet") ||
    eq(clone(short), "string_from_bytes") ||
    eq(clone(short), "hex_encode") ||
    eq(clone(short), "rope_new") {
        return true
    }
    if eq(clone(short), "rope_to_string") ||
    eq(clone(short), "rope_from_string") ||
    eq(clone(short), "rope_slice") ||
    eq(clone(short), "rope_insert") ||
    eq(clone(short), "rope_delete") ||
    eq(clone(short), "rope_concat") {
        return true
    }
    false
}

// `mir_core_call_string_result_name` reads the callee spelling. That evidence
// is only conclusive for the removed CoreOp impl symbols (`raw_f64_to_string`,
// `__core_i32_to_string_impl`, `..._from_bytes`) that the DCE pass drops: they
// have no declaration left, so the name is all a call site can resolve.
// A live declaration owns its return type. The generated
// `core_op_handler_text_to_string` accessor ends with `_to_string` but returns
// the i32 handler id; typing that result as a String ref lowered
// `handler_id == core_op_handler_text_to_string()` as a reference comparison
// and produced invalid core Wasm.
fn mir_core_call_callee_returns_string(ctx: LowerCtx, name: String) -> bool {
    if !mir_core_call_string_result_name(clone(name)) {
        return false
    }
    len(ctx_fn_return_type::ctx_fn_return_type_name(ctx, clone(name))) == 0
}
