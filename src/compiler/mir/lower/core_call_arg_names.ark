use mir::lower::ctx_fn_return_type
fn mir_core_is_printlike_callee(name: String) -> bool {
    name.clone().eq("Stdio::println") ||
    name.clone().eq("Stdio::print") ||
    name.clone().eq("Stdio::eprintln") ||
    name.clone().eq("stdio::Stdio::println") ||
    name.clone().eq("stdio::Stdio::print") ||
    name.clone().eq("stdio::Stdio::eprintln") ||
    name.clone().eq("println") ||
    name.clone().eq("print") ||
    name.clone().eq("eprintln") ||
    name.clone().eq("__intrinsic_println") ||
    name.clone().eq("__intrinsic_eprintln") ||
    name.clone().eq("__intrinsic_eprint") ||
    name.clone().eq("__intrinsic_print")
}

fn mir_core_call_bool_result_name(name: String) -> bool {
    name.clone().eq("contains_i32") ||
    name.clone().eq("contains_string") ||
    name.clone().eq("contains_String") ||
    name.clone().eq("contains") ||
    name.clone().eq("is_empty") ||
    name.clone().eq("is_some") ||
    name.clone().eq("is_none") ||
    name.clone().eq("starts_with") ||
    name.clone().eq("ends_with")
}

fn mir_core_call_i32_result_name(name: String) -> bool {
    name.clone().eq("len") ||
    name.clone().eq("parse_i32") ||
    name.clone().eq("abs") ||
    name.clone().eq("min") ||
    name.clone().eq("max") ||
    name.clone().eq("sum_i32") ||
    name.clone().eq("product_i32") ||
    name.clone().eq("index_of") ||
    name.clone().eq("clamp_i32") ||
    name.clone().eq("get_unchecked") ||
    name.clone().eq("vec_get_unchecked_i32") ||
    name.clone().eq("bytes_get") ||
    name.clone().eq("bytes_len")
}

fn mir_core_call_short_name(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    name.clone()
}

fn mir_core_call_string_result_name(name: String) -> bool {
    if name.clone().eq("String_from") ||
    name.clone().eq("concat") ||
    name.clone().eq("text::concat") ||
    name.clone().eq("to_string") ||
    name.clone().eq("slice") ||
    name.clone().eq("substring") ||
    name.clone().eq("trim") ||
    name.clone().eq("replace") ||
    name.clone().eq("to_upper") ||
    name.clone().eq("to_lower") ||
    name.clone().eq("to_uppercase") ||
    name.clone().eq("to_lowercase") {
        return true
    }
    if name.clone().ends_with("_to_string") || name.clone().ends_with("_from_string") || name.clone().ends_with("_from_bytes") || name.clone().ends_with("_encode") {
        return true
    }
    let short = mir_core_call_short_name(name.clone())
    if short.clone().eq("slice") ||
    short.clone().eq("greet") ||
    short.clone().eq("string_from_bytes") ||
    short.clone().eq("hex_encode") ||
    short.clone().eq("rope_new") {
        return true
    }
    if short.clone().eq("rope_to_string") ||
    short.clone().eq("rope_from_string") ||
    short.clone().eq("rope_slice") ||
    short.clone().eq("rope_insert") ||
    short.clone().eq("rope_delete") ||
    short.clone().eq("rope_concat") {
        return true
    }
    false
}

// `mir_core_call_string_result_name` reads the callee spelling. That evidence
// is only conclusive for the removed CoreOp impl symbols (`raw_f64_to_string`,
// `__core_i32_to_string_impl`, `..._from_bytes`) that the DCE pass drops: they
// have no declaration left, so the name is all a call site can resolve.
// A live declaration owns its return type. The generated
// `core_op_handler_text_to_string` accessor ends with `_to_string` but returns
// the i32 handler id; typing that result as a String ref lowered
// `handler_id == core_op_handler_text_to_string()` as a reference comparison
// and produced invalid core Wasm.
fn mir_core_call_callee_returns_string(ctx: LowerCtx, name: String) -> bool {
    if !mir_core_call_string_result_name(name.clone()) {
        return false
    }
    len(ctx_fn_return_type::ctx_fn_return_type_name(ctx, name.clone())) == 0
}
