use std::prelude::{clone}
use mir::lower::ctx_struct_storage
fn ctx_struct_field_count(ctx: LowerCtx, struct_name: String) -> i32 {
    let li = ctx_struct_storage::ctx_struct_layout_preferred_index(ctx, clone(struct_name))
    if li < 0 {
        return 0
    }
    ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, li)
}

fn ctx_struct_field_name(ctx: LowerCtx, struct_name: String, field_idx: i32) -> String {
    let li = ctx_struct_storage::ctx_struct_layout_preferred_index(ctx, clone(struct_name))
    if li < 0 {
        return String_new()
    }
    let offset = ctx_struct_storage::ctx_struct_layout_field_offset_at(ctx, li)
    ctx_struct_storage::ctx_struct_field_name_at_offset(ctx, offset + field_idx)
}
