use mir::lower::ctx_api_emit
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_calls
use mir::inst_local_get
use mir::lower::method

fn lower_core_method_call(ctx: LowerCtx, exprs: Vec<CoreHirExpr>, expr: CoreHirExpr) -> i32 {
    let child_count = core_expr_shape_accessors::mir_core_expr_child_count(expr)
    if child_count < 1 {
        return 0 - 1
    }
    let receiver_expr_index = core_expr_shape_accessors::mir_core_expr_child(expr, 0)
    let receiver_expr = get_unchecked(exprs, receiver_expr_index)
    let receiver_is_composed = core_expr_shape_calls::mir_core_expr_is_method_call(receiver_expr) ||
    core_expr_shape_calls::mir_core_expr_is_call(receiver_expr)
    let receiver_idx = lower_core_expr(ctx, exprs, receiver_expr_index)
    if receiver_is_composed && receiver_idx >= 0 {
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(receiver_idx))
    }
    let callee_name = method::mir_initial_method_callee(ctx, core_expr_shape_accessors::mir_core_expr_text(expr), receiver_idx)
    let first_method_arg_idx = lower_core_method_first_arg(ctx, exprs, expr, child_count)
    method::mir_emit_method_call(ctx, method::mir_resolve_method_callee(ctx, callee_name, first_method_arg_idx, core_expr_shape_accessors::mir_core_expr_span_start(expr)), child_count, receiver_idx)
}

fn lower_core_method_first_arg(ctx: LowerCtx, exprs: Vec<CoreHirExpr>, expr: CoreHirExpr, child_count: i32) -> i32 {
    let mut a = 1
    let mut first_method_arg_idx = 0 - 1
    while a < child_count {
        let method_arg_expr_index = core_expr_shape_accessors::mir_core_expr_child(expr, a)
        let method_arg_expr = get_unchecked(exprs, method_arg_expr_index)
        let arg_is_composed = core_expr_shape_calls::mir_core_expr_is_method_call(method_arg_expr) ||
        core_expr_shape_calls::mir_core_expr_is_call(method_arg_expr)
        let method_arg_idx = lower_core_expr(ctx, exprs, method_arg_expr_index)
        if arg_is_composed && method_arg_idx >= 0 {
            ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(method_arg_idx))
        }
        if a == 1 {
            first_method_arg_idx = method_arg_idx
        }
        a = a + 1
    }
    first_method_arg_idx
}
