use std::host::stdio::Stdio
use std::text
use corehir::expr_raw
use corehir::frontend_ast_children
use corehir::frontend_ast_identity
use corehir::frontend_expr_kind
use corehir::kinds
use mir::function_identity
use mir::module_functions
use mir::function_return_view
use mir::lower::ctx_fn_index
use mir::lower::ctx_struct_layout
use mir::lower::edge_discovery
use mir::reachability_index
use mir::reachability_roots
use mir::reachability_walk
use resolver
use collections::name_index
// #851 Phase 3 probe: collect call-edge names by walking body sources
// (CoreHIR forest or fallback AstNode) instead of reading emitted
// CALL/REF_FUNC insts. The dump compares source-visible callees
// ([probeA] for AstNode, [probeK] for CoreHIR forest) against the
// recorded inst stream ([probeR]) to measure whether a pre-lower edge
// table can replace lower-time edge recording for reachability and
// per-fn pipelining. Gated on a source-level force switch because the env
// override is disabled; flip, rebuild, measure, flip back before commit.
fn mir_probe_edges_enabled() -> i32 {
    // Set to 1 in source to dump [probeA]/[probeK]/[probeR] edges on stderr.
    // Must stay 0 in committed code so --time measurement runs keep clean stderr.
    0
}

// Set to 0 in source to force emit_bodies=true while the edge-table probes
// still measure: [probeE-ureach] then names every fn the AST worklist would
// wrongly drop. Must stay 1 (skip active) in committed code.
fn mir_probe_skip_enabled() -> i32 {
    1
}

fn mir_probe_corehir_call_names(exprs: Vec<CoreHirExpr>, root: i32) -> Vec<String> {
    let mut names = Vec::new<String>()
    if root < 0 || root >= len(exprs) {
        return names
    }
    let mut queue = Vec::new<i32>()
    push(queue, root)
    let mut qi = 0
    while qi < len(queue) {
        let idx = get_unchecked(queue, qi)
        qi = qi + 1
        if idx < 0 || idx >= len(exprs) {
            continue
        }
        let e = get_unchecked(exprs, idx)
        let k = expr_raw::corehir_expr_kind(e)
        if k == kinds::COREHIR_EXPR_CALL() || k == kinds::COREHIR_EXPR_METHOD_CALL() {
            push(names, expr_raw::corehir_expr_text(e))
        }
        let cc = expr_raw::corehir_expr_child_count(e)
        let mut ci = 0
        while ci < cc {
            push(queue, expr_raw::corehir_expr_child(e, ci))
            ci = ci + 1
        }
    }
    names
}

fn mir_probe_dump_body_calls(caller: String, exprs: Vec<CoreHirExpr>, root: i32) {
    let names = mir_probe_corehir_call_names(exprs, root)
    let mut i = 0
    while i < len(names) {
        Stdio::eprintln("[probeK] ".concat(caller.clone().concat(" -> ".concat(get_unchecked(names, i).clone()))))
        i = i + 1
    }
}

// AST fallback-body variant: the actual body source on the current pipeline
// (MirLowerEntryFallbackBody wraps AstNode). Reuses the resolved-call
// scanner so call detection matches the frontend exactly.
fn mir_probe_dump_ast_calls(caller: String, node: AstNode) {
    let mut names = Vec::new<String>()
    mir_probe_ast_call_names(node, names)
    let mut i = 0
    while i < len(names) {
        Stdio::eprintln("[probeA] ".concat(caller.clone().concat(" -> ".concat(get_unchecked(names, i).clone()))))
        i = i + 1
    }
}

// Call-node text is empty; the callee name lives on the callee child (same
// rule as body_call_direct::corehir_direct_call_callee_name). Method calls
// keep their raw method name tagged 'm:' since mono resolution needs the
// receiver type, which the AST walk does not reproduce.
fn mir_probe_ast_call_names(node: AstNode, mut names: Vec<String>) {
    let kind = frontend_ast_identity::corehir_node_kind(node)
    if frontend_expr_kind::corehir_kind_is_expr_call(kind) &&
    frontend_ast_children::corehir_node_child_count(node) > 0 {
        let callee = frontend_ast_children::corehir_node_child_at(node, 0)
        push(names, frontend_ast_identity::corehir_node_text(callee))
    }
    if frontend_expr_kind::corehir_kind_is_expr_method_call(kind) {
        push(names, "m:".concat(frontend_ast_identity::corehir_node_text(node)))
    }
    let child_count = frontend_ast_children::corehir_node_child_count(node)
    let mut ci = 0
    while ci < child_count {
        mir_probe_ast_call_names(frontend_ast_children::corehir_node_child_at(node, ci), names)
        ci = ci + 1
    }
}

// Decode the recorded packed edge stream into caller -> callee lines so the
// source dump can be diffed against it. Payload >= 0 is a FunctionId raw;
// negative payloads are name tags (-(index+10), index >= 1e6 -> edge_names).
fn mir_probe_dump_recorded_edges(m: MirModule, edges: Vec<i32>, fn_names: Vec<String>, edge_names: Vec<String>) {
    let header = 10
    let mark = 0 - 8
    let bias = 1000000
    let n = len(edges)
    let mut frame_to_mir = Vec::new<i32>()
    let mut i = header
    while i < n {
        if get_unchecked(edges, i) == mark && i + 2 < n {
            let frame = get_unchecked(edges, i + 1)
            let mir = get_unchecked(edges, i + 2)
            if frame >= 0 {
                while len(frame_to_mir) <= frame {
                    push(frame_to_mir, 0 - 1)
                }
                set(frame_to_mir, frame, mir)
            }
            i = i + 3
        } else {
            i = i + 2
        }
    }
    i = header
    while i < n {
        if get_unchecked(edges, i) == mark {
            i = i + 3
            continue
        }
        if i + 1 >= n {
            i = n
            continue
        }
        let frame = get_unchecked(edges, i)
        let payload = get_unchecked(edges, i + 1)
        i = i + 2
        if frame < 0 || frame >= len(frame_to_mir) {
            continue
        }
        let mir = get_unchecked(frame_to_mir, frame)
        if mir < 0 || mir >= module_functions::MirModule_function_count(m) {
            continue
        }
        let caller = function_identity::MirFunction_name(module_functions::MirModule_function_at(m, mir))
        if payload >= 0 {
            Stdio::eprintln("[probeR] ".concat(caller.clone().concat(" -> fid:".concat(payload.to_string()))))
            continue
        }
        let ni = 0 - payload - 10
        if ni < 0 {
            continue
        }
        if ni < bias && ni < len(fn_names) {
            Stdio::eprintln("[probeR] ".concat(caller.clone().concat(" -> ".concat(get_unchecked(fn_names, ni).clone()))))
            continue
        }
        let oi = ni - bias
        if oi >= 0 && oi < len(edge_names) {
            Stdio::eprintln("[probeR] ".concat(caller.clone().concat(" -> ".concat(get_unchecked(edge_names, oi).clone()))))
        }
    }
}

// #851 Phase 3 probe: can the fn_index return table (all decl names + typed
// return names, built pre-body) replace the module-scanned callee cache?
// For every fn_index entry, compare the enum-normalized fn_index return name
// against MirFunction.return_type_name of the emitted MIR fn with the same
// name. [probeT] mismatch lines show name, mir value, fn_index value;
// [probeT-miss] entries have no MIR fn at all (never emitted / pruned),
// [probeT-extra] MIR fns missing from fn_index (synth/closure names).
fn mir_probe_dump_return_table_diff(mut ctx: LowerCtx, module: MirModule) {
    let fn_count = module_functions::MirModule_function_count(module)
    let mut mir_by_name = name_index::NameIndex_new(fn_count)
    let mut mi = 0
    while mi < fn_count {
        let f = module_functions::MirModule_function_at(module, mi)
        name_index::name_index_insert_first(mir_by_name, function_identity::MirFunction_name(f), mi)
        mi = mi + 1
    }
    let idx_count = ctx_fn_index::ctx_fn_index_count(ctx)
    let mut ii = 0
    while ii < idx_count {
        let name = ctx_fn_index::ctx_fn_index_name_at(ctx, ii)
        let want = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, ctx_fn_index::ctx_fn_index_return_type_name_at(ctx, ii))
        let mir = name_index::name_index_get(mir_by_name, name.clone())
        if mir < 0 {
            Stdio::eprintln("[probeT-miss] ".concat(name.clone()))
            ii = ii + 1
            continue
        }
        let got = function_return_view::MirFunction_return_type_name(module_functions::MirModule_function_at(module, mir))
        if !got.clone().eq(want.clone()) {
            Stdio::eprintln(
                "[probeT] ".concat(name.clone().concat(" : mir=".concat(got.clone().concat(" fnidx=".concat(want.clone())))))
            )
        }
        ii = ii + 1
    }
    mi = 0
    while mi < fn_count {
        let f = module_functions::MirModule_function_at(module, mi)
        if ctx_fn_index::ctx_fn_index_find(ctx, function_identity::MirFunction_name(f)) < 0 {
            Stdio::eprintln("[probeT-extra] ".concat(function_identity::MirFunction_name(f)))
        }
        mi = mi + 1
    }
}

// #851 Phase 3 probe: does the pre-lower AstEdgeTable cover every callee the
// recorded inst stream captured? For each recorded edge, resolve the
// caller's AST candidates once (stream frames are contiguous per caller;
// a re-appearing caller just re-resolves) and check the callee's resolved
// name against that set. Fid payloads go through the same fid_to_mir map
// reachability uses, so their callee name is checked identically.
// [probeE-miss] lines are under-approximation bugs a BFS worklist would hit;
// [probeE-nocaller] callers (synth thunks, closure wrappers) have no decl
// and must come from another source before the table can stand alone.
fn mir_probe_dump_ast_edge_coverage(
    ctx: LowerCtx,
    m: MirModule,
    edges: Vec<i32>,
    fn_names: Vec<String>,
    edge_names: Vec<String>,
    table: AstEdgeTable
) {
    let header = 10
    let mark = 0 - 8
    let bias = 1000000
    let n = len(edges)
    let mut frame_to_mir = Vec::new<i32>()
    let mut i = header
    while i < n {
        if get_unchecked(edges, i) == mark && i + 2 < n {
            let frame = get_unchecked(edges, i + 1)
            let mir = get_unchecked(edges, i + 2)
            if frame >= 0 {
                while len(frame_to_mir) <= frame {
                    push(frame_to_mir, 0 - 1)
                }
                set(frame_to_mir, frame, mir)
            }
            i = i + 3
        } else {
            i = i + 2
        }
    }
    let functions = module_functions::MirModule_functions(m)
    let index = reachability_index::mir_reachability_index_build(m, functions)
    let mut dbg = 0
    while dbg < len(functions) {
        Stdio::eprintln(
            "[probeE-fn] ".concat(function_identity::MirFunction_name(get_unchecked(functions, dbg)))
        )
        dbg = dbg + 1
    }
    let mut total = 0
    let mut covered = 0
    let mut missed = 0
    let mut nocaller = 0
    let mut unresolved = 0
    let mut printed = 0
    let mut cur_mir = 0 - 2
    let mut cur_state = 0
    let mut cur_caller = String_new()
    let mut cur_marked = name_index::NameIndex_new(4)
    i = header
    while i < n {
        if get_unchecked(edges, i) == mark {
            i = i + 3
            continue
        }
        if i + 1 >= n {
            i = n
            continue
        }
        let frame = get_unchecked(edges, i)
        let payload = get_unchecked(edges, i + 1)
        i = i + 2
        if frame < 0 || frame >= len(frame_to_mir) {
            continue
        }
        let mir = get_unchecked(frame_to_mir, frame)
        if mir < 0 || mir >= len(functions) {
            continue
        }
        if mir != cur_mir {
            cur_mir = mir
            cur_caller = function_identity::MirFunction_name(get_unchecked(functions, mir))
            let cidx = edge_discovery::mir_ast_edge_table_caller_find(table, cur_caller.clone())
            if cidx < 0 {
                cur_state = 0 - 1
                nocaller = nocaller + 1
                if printed < 50 {
                    Stdio::eprintln("[probeE-nocaller] ".concat(cur_caller.clone()))
                    printed = printed + 1
                }
            } else {
                cur_state = 1
                cur_marked = name_index::NameIndex_new(64)
                edge_discovery::mir_ast_edge_table_resolve_caller(ctx, table, cidx, cur_marked)
            }
        }
        let mut cname = String_new()
        if payload >= 0 {
            let c_mir = reachability_index::mir_reachability_lookup_by_func_id(index, payload)
            if c_mir >= 0 && c_mir < len(functions) {
                cname = function_identity::MirFunction_name(get_unchecked(functions, c_mir))
            }
        } else {
            let tagged = 0 - payload - 10
            if tagged >= 0 && tagged < bias && tagged < len(fn_names) {
                cname = get_unchecked(fn_names, tagged).clone()
            }
            if tagged >= bias {
                let oi = tagged - bias
                if oi >= 0 && oi < len(edge_names) {
                    cname = get_unchecked(edge_names, oi).clone()
                }
            }
        }
        if len(cname) == 0 {
            unresolved = unresolved + 1
            continue
        }
        if cur_state < 0 {
            continue
        }
        total = total + 1
        let mut hit = name_index::name_index_get(cur_marked, cname.clone()) >= 0
        if !hit && cname.clone().contains(String_from("::")) {
            hit = name_index::name_index_get(cur_marked, resolver::use_module_short_name(cname)) >= 0
        }
        if hit {
            covered = covered + 1
            continue
        }
        missed = missed + 1
        if printed < 50 {
            Stdio::eprintln(
                "[probeE-miss] ".concat(cur_caller.clone().concat(" -> ".concat(cname.clone())))
            )
            printed = printed + 1
        }
    }
    Stdio::eprintln(
        "[probeE] covered=".concat(
            covered.to_string().concat(
                "/".concat(total.to_string().concat(" miss=".concat(missed.to_string().concat(" nocaller=".concat(nocaller.to_string().concat(" unresolved=".concat(unresolved.to_string())))))))
            )
        )
    )
}

// AST-BFS enqueue: production reaches a name's first MirFunction index by
// name and any same-named twins via fid edges. Name-level worklists cannot
// tell twins apart, so mark every fn carrying the name (or its module
// short form) to keep [probeE-ureach] measuring real gaps only.
fn mir_probe_ast_enqueue_by_name(
    functions: Vec<MirFunction>,
    mut ast_reach: Vec<i32>,
    mut ast_queue: Vec<i32>,
    name: String
) {
    let want = resolver::use_module_short_name(name.clone())
    let mut i = 0
    while i < len(functions) {
        let fname = function_identity::MirFunction_name(get_unchecked(functions, i))
        if fname.clone().eq(name.clone()) || resolver::use_module_short_name(fname).eq(want.clone()) {
            if get_unchecked(ast_reach, i) == 0 {
                set(ast_reach, i, 1)
                push(ast_queue, i)
            }
        }
        i = i + 1
    }
}

// #851 Phase 3 probe: reachable-set diff, not just name coverage. Replays
// the production walk (recorded stream + inst scan, same roots) as the
// truth set, then BFSs the same roots through the AstEdgeTable.
// [probeE-ureach] = fns production keeps but AST edges lose (fatal for a
// pre-lower worklist); [probeE-oreach] = AST extra reach (harmless).
// [probeE-nocall] = reachable callers with no table entry (synth frames).
fn mir_probe_dump_ast_reach_diff(
    ctx: LowerCtx,
    m: MirModule,
    export_roots: Vec<String>,
    target: String,
    edges: Vec<i32>,
    fn_names: Vec<String>,
    edge_names: Vec<String>,
    table: AstEdgeTable
) {
    let fn_count = module_functions::MirModule_function_count(m)
    if fn_count <= 0 {
        return
    }
    let functions = module_functions::MirModule_functions(m)
    let index = reachability_index::mir_reachability_index_build(m, functions)
    let mut rec_reach = Vec::new<i32>()
    let mut zi = 0
    while zi < fn_count {
        push(rec_reach, 0)
        zi = zi + 1
    }
    let mut rec_queue = Vec::new<i32>()
    let root_count = reachability_roots::mir_mark_roots(index, functions, rec_reach, rec_queue, export_roots.clone())
    if root_count <= 0 {
        Stdio::eprintln("[probeE-reach] no roots; diff skipped")
        return
    }
    let packed = reachability_walk::mir_build_recorded_edge_lists(edges, fn_count)
    let mut qh = 0
    while qh < len(rec_queue) {
        let fi = get_unchecked(rec_queue, qh)
        qh = qh + 1
        reachability_walk::mir_enqueue_call_edges(
            m,
            index,
            functions,
            rec_reach,
            rec_queue,
            get_unchecked(functions, fi),
            target.clone(),
            packed,
            fi,
            fn_names,
            edge_names
        )
    }
    let mut ast_reach = Vec::new<i32>()
    zi = 0
    while zi < fn_count {
        push(ast_reach, 0)
        zi = zi + 1
    }
    let mut ast_queue = Vec::new<i32>()
    reachability_roots::mir_mark_roots(index, functions, ast_reach, ast_queue, export_roots)
    let mut nocall = 0
    let mut printed = 0
    qh = 0
    while qh < len(ast_queue) {
        let fi = get_unchecked(ast_queue, qh)
        qh = qh + 1
        let caller = function_identity::MirFunction_name(get_unchecked(functions, fi))
        let cidxs = edge_discovery::mir_ast_edge_table_caller_find_all(table, caller.clone())
        if len(cidxs) == 0 {
            nocall = nocall + 1
            if printed < 40 {
                Stdio::eprintln("[probeE-nocall] ".concat(caller.clone()))
                printed = printed + 1
            }
            continue
        }
        let mut ci = 0
        while ci < len(cidxs) {
            let names = edge_discovery::mir_ast_edge_table_resolve_caller_names(ctx, table, get_unchecked(cidxs, ci))
            let mut ni = 0
            while ni < len(names) {
                mir_probe_ast_enqueue_by_name(functions, ast_reach, ast_queue, get_unchecked(names, ni).clone())
                ni = ni + 1
            }
            ci = ci + 1
        }
    }
    let mut rec_total = 0
    let mut ast_total = 0
    let mut under = 0
    let mut over = 0
    let mut uprint = 0
    let mut fi2 = 0
    while fi2 < fn_count {
        let rr = get_unchecked(rec_reach, fi2)
        let ar = get_unchecked(ast_reach, fi2)
        if rr != 0 {
            rec_total = rec_total + 1
        }
        if ar != 0 {
            ast_total = ast_total + 1
        }
        if rr != 0 && ar == 0 {
            under = under + 1
            if uprint < 60 {
                Stdio::eprintln(
                    "[probeE-ureach] ".concat(function_identity::MirFunction_name(get_unchecked(functions, fi2)))
                )
                uprint = uprint + 1
            }
        }
        if rr == 0 && ar != 0 {
            over = over + 1
        }
        fi2 = fi2 + 1
    }
    Stdio::eprintln(
        "[probeE-reach] recorded=".concat(
            rec_total.to_string().concat(
                " ast=".concat(ast_total.to_string().concat(" under=".concat(under.to_string().concat(" over=".concat(over.to_string().concat(" nocall=".concat(nocall.to_string())))))))
            )
        )
    )
}
