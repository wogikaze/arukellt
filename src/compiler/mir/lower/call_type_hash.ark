fn is_hash_bool_query(callee_name: String) -> bool {
    if callee_eq(clone(callee_name), "hashmap_contains") {
        return true
    }
    if callee_eq(clone(callee_name), "hash::hashmap_contains") {
        return true
    }
    if callee_eq(clone(callee_name), "HashMap_i32_i32_contains_key") {
        return true
    }
    if callee_eq(clone(callee_name), "hashmap_i32_i32_contains") {
        return true
    }
    if callee_eq(clone(callee_name), "hash_map::hashmap_i32_i32_contains") {
        return true
    }
    if callee_eq(clone(callee_name), "hashmap_is_empty") {
        return true
    }
    if callee_eq(clone(callee_name), "hash::hashmap_is_empty") {
        return true
    }
    if callee_eq(clone(callee_name), "hashmap_i32_i32_is_empty") {
        return true
    }
    if callee_eq(clone(callee_name), "hash_map::hashmap_i32_i32_is_empty") {
        return true
    }
    if callee_eq(clone(callee_name), "hashset_contains") {
        return true
    }
    if callee_eq(clone(callee_name), "hash::hashset_contains") {
        return true
    }
    if callee_eq(clone(callee_name), "hashmap_str_contains") {
        return true
    }
    if callee_eq(clone(callee_name), "HashMap_String_i32_contains_key") {
        return true
    }
    if callee_eq(clone(callee_name), "hashmap_str_str_contains") {
        return true
    }
    callee_eq(callee_name, "HashMap_String_String_contains_key")
}

fn mark_hash_call_result_type(ctx: LowerCtx, callee_name: String, dest: i32) {
    if is_hashmap_si32_new(clone(callee_name)) {
        mark_hash_type_ref(ctx, dest, "hashmap:si32")
    }
    if is_hashmap_i32str_new(clone(callee_name)) {
        mark_hash_type_ref(ctx, dest, "hashmap:i32str")
    }
    if is_hashmap_i32fn_new(clone(callee_name)) {
        mark_hash_type_ref(ctx, dest, "hashmap:i32fn")
    }
    if is_hashmap_strfn_new(clone(callee_name)) {
        mark_hash_type_ref(ctx, dest, "hashmap:strfn")
    }
    if is_hashmap_strstr_new(clone(callee_name)) {
        mark_hash_type_ref(ctx, dest, "hashmap:strstr")
    }
    if callee_eq(clone(callee_name), "__hm_si_get_key") {
        mark_hash_type_ref(ctx, dest, "string")
    }
    if callee_eq(clone(callee_name), "__hm_is_get_key") ||
    callee_eq(clone(callee_name), "__hm_if_get_key") {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "i32")
    }
    if callee_eq(clone(callee_name), "__hm_is_get_val") ||
    callee_eq(clone(callee_name), "__hm_ss_get_key") ||
    callee_eq(clone(callee_name), "__hm_ss_get_val") {
        mark_hash_type_ref(ctx, dest, "string")
    }
    if callee_eq(clone(callee_name), "__hm_if_get_val") ||
    callee_eq(clone(callee_name), "__hm_sf_get_val") {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "fnref")
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_FUNCREF())
    }
    if callee_eq(clone(callee_name), "__hm_sf_get_key") {
        mark_hash_type_ref(ctx, dest, "string")
    }
    if is_hashmap_i32i32_new(clone(callee_name)) {
        mark_hash_type_ref(ctx, dest, "hashmap:i32i32")
    }
    if is_hashset_i32_new(clone(callee_name)) {
        mark_hash_type_ref(ctx, dest, "vec:i32")
    }
    if is_hash_vec_i32_result(clone(callee_name)) {
        mark_hash_type_ref(ctx, dest, "vec:i32")
    }
    if callee_eq(clone(callee_name), "hashset_str_new") || callee_eq(clone(callee_name), "hash_map::hashset_str_new") {
        mark_hash_type_ref(ctx, dest, "vec:String")
    }
    mark_hash_query_result_type(ctx, callee_name, dest)
}

fn mark_hash_query_result_type(ctx: LowerCtx, callee_name: String, dest: i32) {
    if is_option_i32_hash_query(clone(callee_name)) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "Option_i32")
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_GC_REF())
        }
    }
    if is_option_string_hash_query(clone(callee_name)) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "Option_String")
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_GC_REF())
        }
    }
    if is_option_fn_hash_query(clone(callee_name)) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "option:fnref")
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_GC_REF())
        }
    }
    if is_hash_size_query(clone(callee_name)) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "i32")
    }
    if is_hash_bool_query(clone(callee_name)) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "bool")
    }
}
// MIR call result type propagation for hash collections.
