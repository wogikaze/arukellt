use mir::lower::call_type_fallback
use mir::lower::closure_capture_args
use mir::lower::closure_cells
use mir::lower::closure_registry
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_fn_return_vt
use mir::lower::ctx_types
use mir::inst_call
use mir::inst_local_get
use mir::lower::core_expr_shape_accessors
use mir::value_types

fn lower_core_closure_call(ctx: LowerCtx, exprs: Vec<CoreHirExpr>, expr: CoreHirExpr) -> i32 {
    let child_count = core_expr_shape_accessors::mir_core_expr_child_count(expr)
    let clo_ix = closure_registry::ctx_closure_lookup(ctx, core_expr_shape_accessors::mir_core_expr_text(expr))
    if clo_ix < 0 {
        return 0 - 2
    }
    let synth = closure_registry::ctx_closure_synth_at(ctx, clo_ix)
    let packed = closure_registry::ctx_closure_caps_at(ctx, clo_ix)
    let extra = closure_registry::ctx_closure_extra_at(ctx, clo_ix)
    let is_identity = closure_registry::ctx_closure_is_identity(ctx, clo_ix)
    let mut first_arg = 0 - 1
    let mut ca = 1
    while ca < child_count {
        let arg_idx = lower_core_expr(ctx, exprs, core_expr_shape_accessors::mir_core_expr_child(expr, ca))
        if ca == 1 {
            first_arg = arg_idx
        }
        ca = ca + 1
    }
    if is_identity {
        if child_count == 2 {
            return first_arg
        }
        return 0 - 1
    }
    closure_capture_args::closure_emit_captured_args(ctx, packed)
    // Mirrors try_lower_closure_call: env-cell closures take the bound
    // env record as a trailing argument on the direct-call path (#874).
    let env_li = closure_registry::ctx_closure_env_local_at(ctx, clo_ix)
    if env_li >= 0 {
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get_to(env_li, env_li))
    }
    let env_arg = if env_li >= 0 { 1 } else { 0 }
    let dest_vt = ctx_fn_return_vt::ctx_fn_return_vt(ctx, clone(synth))
    let c_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, dest_vt)
    ctx_api_emit::ctx_emit(ctx, inst_call::MirInst_call(clone(synth), child_count - 1 + extra + env_arg, c_dest))
    // Refresh mut-borrowed source locals from their env cells, mirroring
    // try_lower_closure_call (#874, ADR-061).
    closure_cells::ctx_emit_closure_writeback(ctx, synth)
    call_type_fallback::mark_fallback_call_result_type(ctx, clone(synth), c_dest)
    c_dest
}
