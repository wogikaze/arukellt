use std::prelude::{eq}
use corehir::function_id
use corehir::mir_value_type
use corehir::type_table
use corehir::kinds
use mir::lower::mono_instance_table
use mir::lower::mono_suffix_parse
use mir::mono_names
use mir::type_contracts
fn mono_instance_table_register_from_instances(
    mut table: MonoInstanceTable,
    mut type_table: TypeTable,
    mono_instances: Vec<MonoInstance>,
    mangled: String,
    param_types: Vec<MirValueType>,
    return_types: Vec<MirValueType>
) -> i32 {
    let inst = mono_find_instance(mono_instances, mangled.clone())
    if type_contracts::MonoInstance_type_arg_count(inst) <= 0 {
        return 0 - 1
    }
    let mut subst_names = Vec::new<String>()
    let mut subst_ids = Vec::new<TypeId>()
    // Prefer mangled mono keys over MonoInstance TypeInfo args — those can
    // carry invalid handles across the flat-overlay TypeInfo duplicate.
    let suffix = mono_suffix_parse::extract_mono_suffix(mangled.clone())
    let keys = mono_suffix_parse::split_mono_suffix(suffix.clone())
    let arg_count = type_contracts::MonoInstance_type_arg_count(inst)
    let mut ai = 0
    while ai < arg_count {
        let var_name = mono_suffix_parse::mono_type_var_name_at(ai)
        let mut type_name = var_name.clone()
        if ai < len(keys) {
            type_name = get_unchecked(keys, ai)
        }
        push(subst_names, var_name.clone())
        let kind = mono_subst_kind_for_type_name(type_name.clone())
        push(subst_ids, type_table::TypeTable_intern(type_table, kind, type_name, Vec::new<TypeId>()))
        ai = ai + 1
    }
    let entry = mono_instance_table::MonoInstanceEntry_new(
        mangled.clone(),
        subst_names,
        subst_ids,
        param_types,
        return_types,
        function_id::FUNCTION_ID_INVALID(),
        function_id::FUNCTION_ID_INVALID()
    )
    let mono_id = mono_instance_table::mono_instance_table_register(table, entry)
    mono_instance_table::MonoInstanceId_raw(mono_id)
}

fn mono_subst_kind_for_type_name(type_name: String) -> i32 {
    if eq(type_name.clone(), "i32") ||
    eq(type_name.clone(), "bool") ||
    eq(type_name.clone(), "char") {
        return kinds::TYPE_KIND_PRIMITIVE()
    }
    if eq(type_name.clone(), "i64") || eq(type_name.clone(), "f64") || eq(type_name.clone(), "f32") {
        return kinds::TYPE_KIND_PRIMITIVE()
    }
    if eq(type_name.clone(), "String") || eq(type_name.clone(), "string") {
        return kinds::TYPE_KIND_STRING()
    }
    if mono_suffix_parse::is_mono_type_var_name(type_name.clone()) {
        return kinds::TYPE_KIND_TYPE_VAR()
    }
    kinds::TYPE_KIND_STRUCT()
}

fn mono_find_instance(mono_instances: Vec<MonoInstance>, mangled: String) -> MonoInstance {
    let safe = mono_names::mono_safe_name(mangled)
    let count = len(mono_instances)
    let mut i = 0
    while i < count {
        let inst = get_unchecked(mono_instances, i)
        if mono_names::mono_name_eq_safe(type_contracts::MonoInstance_mangled_name(inst), safe.clone()) {
            return inst
        }
        i = i + 1
    }
    type_contracts::MonoInstance_new(String_new(), String_new(), Vec::new<TypeInfo>())
}
