// Promoted borrow-capture cells (#891): a non-move closure that rebinds a
// capture (x = expr) promotes the source place into a shared heap cell so
// the managed env can carry a live alias. The captured name keeps a
// payload-typed local binding while a hidden cell-ref local holds the
// __cell_N ref; ctx_emit rewrites every value read/write on the payload
// local to a field-0 access through the cell ref, so the parent frame and
// the escaped closure observe the same mutation on wasm32-gc and linear
// wasm32. Entries key on (owning function name, value local index)
// because local indices are per-function — the synth flags its own
// payload shadow under its own frame name.

use std::prelude::{clone, eq}
use std::text
use mir::function_identity
use mir::inst_draft
use mir::inst_local_get
use mir::inst_local_set
use mir::inst_struct_get
use mir::inst_struct_new
use mir::inst_struct_set
use mir::lower::ctx_struct_layout
use mir::lower::closure_capture_type
use mir::lower::closure_env_layout
use mir::lower::ctx_emit_core
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_current_storage
use mir::lower::ctx_gc_struct
use mir::opcodes
use mir::value_types

fn ctx_pcell_fn_name(ctx: LowerCtx) -> String {
    function_identity::MirFunction_name(ctx_current_storage::ctx_current_func_value(ctx))
}

fn ctx_pcell_find(ctx: LowerCtx, fn_name: String, local_idx: i32) -> i32 {
    let mut i = 0
    while i < len(ctx.pcell_fn_names) {
        if get_unchecked(ctx.pcell_lis, i) == local_idx &&
        eq(get_unchecked(ctx.pcell_fn_names, i), clone(fn_name)) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn ctx_pcell_is_cell(ctx: LowerCtx, local_idx: i32) -> bool {
    if local_idx < 0 {
        return false
    }
    ctx_pcell_find(ctx, ctx_pcell_fn_name(ctx), local_idx) >= 0
}

// The cell-ref local's own name: capture supply lists pack it so env
// fields and cap args carry the verbatim cell ref instead of a payload
// read that the value-local rewrite would produce.
fn ctx_pcell_ref_name(ctx: LowerCtx, local_idx: i32) -> String {
    let idx = ctx_pcell_find(ctx, ctx_pcell_fn_name(ctx), local_idx)
    if idx < 0 {
        return String_new()
    }
    clone(get_unchecked(ctx.pcell_ref_names, idx))
}

// Declared type spelling for the cell ref (struct:__cell_N:slot), used
// for cap param and env field declarations.
fn ctx_pcell_cell_spelling(ctx: LowerCtx, local_idx: i32) -> String {
    let idx = ctx_pcell_find(ctx, ctx_pcell_fn_name(ctx), local_idx)
    if idx < 0 {
        return String_new()
    }
    "struct:".concat(clone(get_unchecked(ctx.pcell_cell_names, idx)).concat(":".concat(closure_env_layout::closure_env_slot_width(get_unchecked(ctx.pcell_vts, idx)).to_string())))
}

fn ctx_pcell_vt_sig(payload_vt: i32) -> String {
    if payload_vt == value_types::VT_I64() {
        return "i64"
    }
    if payload_vt == value_types::VT_F64() {
        return "f64"
    }
    if payload_vt == value_types::VT_F32() {
        return "f32"
    }
    if payload_vt == value_types::VT_V128() {
        return "v128"
    }
    if payload_vt == value_types::VT_FUNCREF() {
        return "funcref"
    }
    if payload_vt == value_types::VT_GC_REF() || payload_vt == value_types::VT_REF() {
        return "structref"
    }
    "i32"
}

// Cell layout name for a payload, registered once so equal payloads share
// one __cell_N GC type (and one linear slot width). Untyped payloads fall
// back to a vt-derived field signature.
fn ctx_pcell_cell_name_for(mut ctx: LowerCtx, payload_type: String, payload_vt: i32) -> String {
    let mut key = clone(payload_type)
    if len(key) == 0 {
        key = "vt:".concat(payload_vt.to_string())
    }
    let mut i = 0
    while i < len(ctx.pcell_reg_keys) {
        if eq(get_unchecked(ctx.pcell_reg_keys, i), clone(key)) {
            return clone(get_unchecked(ctx.pcell_reg_cells, i))
        }
        i = i + 1
    }
    let cell_name = "__cell_".concat(len(ctx.pcell_reg_cells).to_string())
    push(ctx.pcell_reg_keys, key)
    push(ctx.pcell_reg_cells, clone(cell_name))
    push(ctx.pcell_reg_vts, payload_vt)
    push(ctx.pcell_reg_types, clone(payload_type))
    if ctx.is_gc_target {
        let mut field_sig = "_f0_".concat(ctx_pcell_vt_sig(payload_vt))
        if len(payload_type) > 0 {
            field_sig = ctx_gc_struct::gc_struct_field_sig_for_type(ctx, payload_type, 0)
        }
        ctx_gc_struct::ctx_register_gc_struct(
            ctx,
            clone(cell_name),
            "GS".concat(field_sig)
        )
    }
    cell_name
}

fn ctx_pcell_reg_lookup(ctx: LowerCtx, cell_name: String) -> i32 {
    let mut i = 0
    while i < len(ctx.pcell_reg_cells) {
        if eq(get_unchecked(ctx.pcell_reg_cells, i), clone(cell_name)) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// Wrap the place behind the captured name in a fresh __cell_N so the
// closure env can carry a live alias. The payload local keeps its
// declared type and name; a hidden cell-ref local is initialized from it
// and every later read or write on the payload local is rewritten to
// field-0 access at ctx_emit. The init insts run before the flag
// registers so the read of src_li keeps its verbatim local meaning (the
// cell starts from the live value). Returns the payload local, or -1
// when the name is unbound.
fn ctx_promote_capture_cell(mut ctx: LowerCtx, name: String) -> i32 {
    let src_li = ctx_api_local_alloc::ctx_lookup_local(ctx, clone(name))
    if src_li < 0 {
        return 0 - 1
    }
    let fn_name = ctx_pcell_fn_name(ctx)
    if ctx_pcell_find(ctx, clone(fn_name), src_li) >= 0 {
        // Already cell-backed: a nested closure re-promoting a synth
        // shadow shares the existing cell through its ref name.
        return src_li
    }
    let payload_vt = ctx_api_local_types::ctx_local_vt(ctx, src_li)
    let payload_type = closure_capture_type::mir_closure_lookup_capture_type(ctx, src_li)
    let cell_name = ctx_pcell_cell_name_for(ctx, clone(payload_type), payload_vt)
    let slot_width = closure_env_layout::closure_env_slot_width(payload_vt)
    let ref_vt = closure_env_layout::closure_env_ref_vt(ctx)
    let cell_local_type = "struct:".concat(clone(cell_name).concat(":".concat(slot_width.to_string())))
    let ref_name = "__cellref_".concat(clone(name).concat("_".concat(src_li.to_string())))
    let ref_li = ctx_api_local_alloc::ctx_alloc_local(ctx, clone(ref_name), ref_vt)
    ctx_api_local_types::ctx_set_local_type(ctx, ref_li, cell_local_type)
    ctx_emit_core::ctx_emit_verbatim(ctx, inst_struct_new::MirInst_struct_new_named(
            ref_li,
            clone(cell_name),
            slot_width
        ))
    ctx_emit_core::ctx_emit_verbatim(ctx, inst_struct_set::MirInst_struct_set_named_idx(
            ref_li,
            src_li,
            clone(cell_name),
            0,
            0,
            slot_width,
            payload_vt
        ))
    push(ctx.pcell_fn_names, fn_name)
    push(ctx.pcell_lis, src_li)
    push(ctx.pcell_cell_lis, ref_li)
    push(ctx.pcell_cell_names, cell_name)
    push(ctx.pcell_vts, payload_vt)
    push(ctx.pcell_types, payload_type)
    push(ctx.pcell_ref_names, ref_name)
    src_li
}

fn ctx_pcell_cap_type_is_cell(cap_type: String) -> bool {
    clone(cap_type).starts_with("struct:__cell_")
}

// Param name for a cap whose packed supply carries a promoted cell ref.
// The unique __cellarg_ spelling keeps the ref-typed param out of the
// capture name's way: a payload-typed shadow takes the name so body
// expressions keep the source's declared type (a ref-typed "count" would
// misdispatch operators like + to string concat).
fn ctx_pcell_cap_param_name(cap_type: String, cname: String) -> String {
    if !ctx_pcell_cap_type_is_cell(clone(cap_type)) {
        return cname
    }
    "__cellarg_".concat(cname)
}

// Bind a synth cap param that carries a promoted cell ref: allocate a
// payload-typed shadow under the capture name and flag it so the body's
// accesses deref field 0 of the param's cell. The param name itself stays
// resolvable so a nested closure can re-pack the same cell ref as its own
// capture supply (write-through chains share one heap cell).
fn ctx_pcell_bind_cap_param(mut ctx: LowerCtx, param_li: i32, cap_type: String, cname: String) {
    if !ctx_pcell_cap_type_is_cell(clone(cap_type)) {
        return
    }
    let cell_name = ctx_struct_layout::strip_struct_type_prefix(cap_type)
    let reg = ctx_pcell_reg_lookup(ctx, clone(cell_name))
    if reg < 0 {
        return
    }
    let payload_vt = get_unchecked(ctx.pcell_reg_vts, reg)
    let payload_type = clone(get_unchecked(ctx.pcell_reg_types, reg))
    let shadow = ctx_api_local_alloc::ctx_alloc_local(ctx, clone(cname), payload_vt)
    if len(payload_type) > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, shadow, payload_type)
    }
    push(ctx.pcell_fn_names, ctx_pcell_fn_name(ctx))
    push(ctx.pcell_lis, shadow)
    push(ctx.pcell_cell_lis, param_li)
    push(ctx.pcell_cell_names, cell_name)
    push(ctx.pcell_vts, payload_vt)
    push(ctx.pcell_types, clone(get_unchecked(ctx.pcell_reg_types, reg)))
    push(ctx.pcell_ref_names, ctx_pcell_cap_param_name(clone(cap_type), cname))
}

fn ctx_pcell_mat_lookup(ctx: LowerCtx, fn_name: String, value_li: i32) -> i32 {
    let mut i = len(ctx.pcell_mat_fns) - 1
    while i >= 0 {
        if get_unchecked(ctx.pcell_mat_lis, i) == value_li &&
        eq(get_unchecked(ctx.pcell_mat_fns, i), clone(fn_name)) {
            return get_unchecked(ctx.pcell_mat_tmps, i)
        }
        i = i - 1
    }
    0 - 1
}

fn ctx_pcell_clear_mat_entry(mut ctx: LowerCtx, fn_name: String, value_li: i32) {
    let mut i = len(ctx.pcell_mat_fns) - 1
    while i >= 0 {
        if get_unchecked(ctx.pcell_mat_lis, i) == value_li &&
        eq(get_unchecked(ctx.pcell_mat_fns, i), clone(fn_name)) {
            set(ctx.pcell_mat_lis, i, 0 - 1)
        }
        i = i - 1
    }
}

// Call-like ops can run the closure that owns a cell, so cached payload
// temps in the calling frame go stale across them.
fn ctx_pcell_clear_fn_mats(mut ctx: LowerCtx, fn_name: String) {
    let mut i = len(ctx.pcell_mat_fns) - 1
    while i >= 0 {
        if eq(get_unchecked(ctx.pcell_mat_fns, i), clone(fn_name)) {
            set(ctx.pcell_mat_lis, i, 0 - 1)
        }
        i = i - 1
    }
}

fn ctx_pcell_fresh_payload_tmp(mut ctx: LowerCtx, idx: i32) -> i32 {
    let tmp = ctx_api_local_alloc::ctx_fresh_local(ctx, get_unchecked(ctx.pcell_vts, idx))
    let ptype = clone(get_unchecked(ctx.pcell_types, idx))
    if len(ptype) > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, tmp, ptype)
    }
    tmp
}

// Signature view: a promoted cell-backed local's VALUE type is the
// payload, so return-type resolution (and any other "type of the place's
// contents" query) must look at a payload-typed local, not the cell ref.
// The materialization the RETURN rewrite emitted is reused when present;
// otherwise a fresh payload temp stands in for typing purposes only.
fn ctx_pcell_value_local(mut ctx: LowerCtx, res: i32) -> i32 {
    if res < 0 {
        return res
    }
    let fn_name = ctx_pcell_fn_name(ctx)
    let idx = ctx_pcell_find(ctx, clone(fn_name), res)
    if idx < 0 {
        return res
    }
    let cached = ctx_pcell_mat_lookup(ctx, fn_name, res)
    if cached >= 0 {
        return cached
    }
    ctx_pcell_fresh_payload_tmp(ctx, idx)
}

// Emit field-0 read of the cell into a scratch payload local and record
// it as the value local's current materialization. Reusing the cached
// temp keeps a LOCAL_GET then consumer pair at one pushed payload.
fn ctx_pcell_materialize(mut ctx: LowerCtx, idx: i32, mut out: Vec<MirInstDraft>) -> i32 {
    let value_li = get_unchecked(ctx.pcell_lis, idx)
    let fn_name = ctx_pcell_fn_name(ctx)
    let cached = ctx_pcell_mat_lookup(ctx, clone(fn_name), value_li)
    if cached >= 0 {
        return cached
    }
    let tmp = ctx_pcell_fresh_payload_tmp(ctx, idx)
    push(out, inst_struct_get::MirInst_struct_get_field_idx(
            get_unchecked(ctx.pcell_cell_lis, idx),
            clone(get_unchecked(ctx.pcell_cell_names, idx)),
            0,
            0,
            closure_env_layout::closure_env_slot_width(get_unchecked(ctx.pcell_vts, idx)),
            get_unchecked(ctx.pcell_vts, idx),
            tmp
        ))
    push(ctx.pcell_mat_fns, fn_name)
    push(ctx.pcell_mat_lis, value_li)
    push(ctx.pcell_mat_tmps, tmp)
    tmp
}

fn ctx_pcell_store_inst(ctx: LowerCtx, idx: i32, src_li: i32) -> MirInstDraft {
    inst_struct_set::MirInst_struct_set_named_idx(
        get_unchecked(ctx.pcell_cell_lis, idx),
        src_li,
        clone(get_unchecked(ctx.pcell_cell_names, idx)),
        0,
        0,
        closure_env_layout::closure_env_slot_width(get_unchecked(ctx.pcell_vts, idx)),
        get_unchecked(ctx.pcell_vts, idx)
    )
}

// Ops whose arg0 emits (or resolves a local type from) a value read.
fn pcell_arg0_is_read(op: i32) -> bool {
    op == opcodes::MIR_STRUCT_GET() ||
    op == opcodes::MIR_STRUCT_SET() ||
    op == opcodes::MIR_ARRAY_GET() ||
    op == opcodes::MIR_ARRAY_SET() ||
    op == opcodes::MIR_ARRAY_LEN() ||
    op == opcodes::MIR_CALL() ||
    op == opcodes::MIR_CALL_INDIRECT() ||
    op == opcodes::MIR_CALL_REF() ||
    op == opcodes::MIR_RETURN() ||
    op == opcodes::MIR_EXTEND_I32_TO_I64() ||
    op == opcodes::MIR_TRUNC_I64_TO_I32() ||
    op == opcodes::MIR_FUTURE_NEW() ||
    op == opcodes::MIR_AWAIT() ||
    op == opcodes::MIR_EQZ() ||
    (op >= opcodes::MIR_ADD() && op <= opcodes::MIR_SHR())
}

// Ops whose arg1 carries a value local (LOCAL_SET is special-cased before
// this table runs; CALL arg1 is a lane immediate, not a local).
fn pcell_arg1_is_read(op: i32) -> bool {
    op == opcodes::MIR_STRUCT_SET() ||
    op == opcodes::MIR_ARRAY_GET() ||
    op == opcodes::MIR_ARRAY_SET() ||
    op == opcodes::MIR_REF_TEST() ||
    op == opcodes::MIR_REF_CAST() ||
    op == opcodes::MIR_GC_STRUCT_GET() ||
    op == opcodes::MIR_GC_STRUCT_SET() ||
    (op >= opcodes::MIR_ADD() && op <= opcodes::MIR_SHR())
}

// Only GC_STRUCT_SET reads a value from dest; every other op with a
// non-negative dest produces into it.
fn pcell_dest_is_read(op: i32) -> bool {
    op == opcodes::MIR_GC_STRUCT_SET()
}

fn pcell_dest_is_write(op: i32) -> bool {
    op != opcodes::MIR_LOCAL_GET() &&
    op != opcodes::MIR_LOCAL_SET() &&
    op != opcodes::MIR_STRUCT_SET() &&
    op != opcodes::MIR_GC_STRUCT_SET()
}

fn pcell_op_clears_mats(op: i32) -> bool {
    op == opcodes::MIR_CALL() ||
    op == opcodes::MIR_CALL_REF() ||
    op == opcodes::MIR_CALL_INDIRECT() ||
    op == opcodes::MIR_WIT_CALL() ||
    op == opcodes::MIR_AWAIT()
}

fn ctx_pcell_fn_has_cells(ctx: LowerCtx, fn_name: String) -> bool {
    let mut i = 0
    while i < len(ctx.pcell_fn_names) {
        if eq(get_unchecked(ctx.pcell_fn_names, i), clone(fn_name)) {
            return true
        }
        i = i + 1
    }
    false
}

// Rewrite LOCAL_SET through the cell place. The stack form stashes the
// value in a temp first because struct.set wants (ref, value) order; the
// copy form maps straight onto a named field store.
fn ctx_pcell_rewrite_local_set(mut ctx: LowerCtx, fn_name: String, inst: MirInstDraft, mut out: Vec<MirInstDraft>) -> Vec<MirInstDraft> {
    let dest = inst_draft::MirInstDraft_arg0(inst)
    let src = inst_draft::MirInstDraft_arg1(inst)
    let dcell = ctx_pcell_find(ctx, clone(fn_name), dest)
    let mut scell = 0 - 1
    if src >= 0 {
        scell = ctx_pcell_find(ctx, clone(fn_name), src)
    }
    if dcell < 0 && scell < 0 {
        push(out, inst)
        return out
    }
    if scell >= 0 {
        let stmp = ctx_pcell_materialize(ctx, scell, out)
        if dcell >= 0 {
            push(out, ctx_pcell_store_inst(ctx, dcell, stmp))
            ctx_pcell_clear_mat_entry(ctx, fn_name, dest)
            return out
        }
        push(out, inst_local_set::MirInst_local_set_from(dest, stmp))
        return out
    }
    if src >= 0 {
        push(out, ctx_pcell_store_inst(ctx, dcell, src))
    } else {
        let tmp = ctx_pcell_fresh_payload_tmp(ctx, dcell)
        push(out, inst_local_set::MirInst_local_set(tmp))
        push(out, ctx_pcell_store_inst(ctx, dcell, tmp))
    }
    ctx_pcell_clear_mat_entry(ctx, fn_name, dest)
    out
}

// ctx_emit stage: translate value reads and writes on cell-backed payload
// locals into field-0 access through the cell-ref local. The output insts
// are emitted verbatim — the cell refs and temps they name are never
// flagged, so no rewrite re-fires on them.
fn ctx_pcell_rewrite(mut ctx: LowerCtx, mut inst: MirInstDraft) -> Vec<MirInstDraft> {
    let mut out = Vec::new<MirInstDraft>()
    if len(ctx.pcell_lis) == 0 {
        push(out, inst)
        return out
    }
    let fn_name = ctx_pcell_fn_name(ctx)
    if !ctx_pcell_fn_has_cells(ctx, clone(fn_name)) {
        push(out, inst)
        return out
    }
    let op = inst_draft::MirInstDraft_op(inst)
    if pcell_op_clears_mats(op) {
        ctx_pcell_clear_fn_mats(ctx, clone(fn_name))
    }
    if op == opcodes::MIR_LOCAL_GET() {
        let arg0 = inst_draft::MirInstDraft_arg0(inst)
        let idx = ctx_pcell_find(ctx, clone(fn_name), arg0)
        if idx < 0 {
            push(out, inst)
            return out
        }
        let tmp = ctx_pcell_materialize(ctx, idx, out)
        // The trailing verbatim local.get keeps emit-side adjacency: a
        // following consumer sees prev LOCAL_GET of the same payload temp
        // instead of a second deref that would strand a value on the stack.
        push(out, inst_local_get::MirInst_local_get_to(tmp, tmp))
        return out
    }
    if op == opcodes::MIR_LOCAL_SET() {
        return ctx_pcell_rewrite_local_set(ctx, fn_name, inst, out)
    }
    let mut wdest = inst_draft::MirInstDraft_dest(inst)
    let mut warg0 = inst_draft::MirInstDraft_arg0(inst)
    let mut warg1 = inst_draft::MirInstDraft_arg1(inst)
    if pcell_arg0_is_read(op) && warg0 >= 0 {
        let ridx = ctx_pcell_find(ctx, clone(fn_name), warg0)
        if ridx >= 0 {
            warg0 = ctx_pcell_materialize(ctx, ridx, out)
        }
    }
    if pcell_arg1_is_read(op) && warg1 >= 0 {
        let ridx = ctx_pcell_find(ctx, clone(fn_name), warg1)
        if ridx >= 0 {
            warg1 = ctx_pcell_materialize(ctx, ridx, out)
        }
    }
    if pcell_dest_is_read(op) && wdest >= 0 {
        let ridx = ctx_pcell_find(ctx, clone(fn_name), wdest)
        if ridx >= 0 {
            wdest = ctx_pcell_materialize(ctx, ridx, out)
        }
    }
    let mut write_cell = 0 - 1
    if pcell_dest_is_write(op) && wdest >= 0 {
        write_cell = ctx_pcell_find(ctx, clone(fn_name), wdest)
    }
    if write_cell >= 0 {
        let tmp = ctx_pcell_fresh_payload_tmp(ctx, write_cell)
        push(out, inst_draft::MirInstDraft_copy_with_locals(inst, tmp, warg0, warg1))
        push(out, ctx_pcell_store_inst(ctx, write_cell, tmp))
        ctx_pcell_clear_mat_entry(ctx, fn_name, wdest)
        return out
    }
    if wdest != inst_draft::MirInstDraft_dest(inst) ||
    warg0 != inst_draft::MirInstDraft_arg0(inst) ||
    warg1 != inst_draft::MirInstDraft_arg1(inst) {
        push(out, inst_draft::MirInstDraft_copy_with_locals(inst, wdest, warg0, warg1))
        return out
    }
    push(out, inst)
    out
}
