fn mir_lower_phase_mir_size(
    enabled: i32,
    blocks_before: i32,
    blocks_after: i32,
    insts_before: i32,
    insts_after: i32
) {
    if enabled == 0 {
        return
    }
    stdio::eprintln(
        "[arukellt] lower.reachability_blocks: before=".concat(to_string(blocks_before).concat(" after=".concat(to_string(blocks_after))))
    )
    stdio::eprintln(
        "[arukellt] lower.reachability_insts: before=".concat(to_string(insts_before).concat(" after=".concat(to_string(insts_after))))
    )
}

fn mir_lower_wall_record(
    timing: i32,
    wall_ms: Vec<i32>,
    wall_name: Vec<String>,
    t_start: i64,
    name: String
) {
    if timing == 0 {
        return
    }
    push(wall_ms, mir_lower_phase_ms(t_start, clock::monotonic_now()))
    push(wall_name, name)
}

fn mir_lower_top_walls_note(enabled: i32, wall_ms: Vec<i32>, wall_name: Vec<String>) {
    if enabled == 0 {
        return
    }
    let n = len(wall_ms)
    let mut limit = n
    if limit > 32 {
        limit = 32
    }
    let mut rank = 0
    while rank < limit {
        let mut best = -1
        let mut best_ms = -1
        let mut i = 0
        while i < n {
            let ms = get_unchecked(wall_ms, i)
            if ms > best_ms {
                best_ms = ms
                best = i
            }
            i = i + 1
        }
        if best < 0 {
            return
        }
        set(wall_ms, best, -1)
        stdio::eprintln(
            "[arukellt] lower.fn_wall ".concat(to_string(rank).concat(" ".concat(clone(get_unchecked(wall_name, best)).concat(" ".concat(to_string(best_ms).concat("ms"))))))
        )
        rank = rank + 1
    }
}
