fn mir_lower_phase_mir_size(
    enabled: i32,
    blocks_before: i32,
    blocks_after: i32,
    insts_before: i32,
    insts_after: i32
) {
    if enabled == 0 {
        return
    }
    stdio::eprintln(
        "[arukellt] lower.reachability_blocks: before=".concat(blocks_before.to_string().concat(" after=".concat(blocks_after.to_string())))
    )
    stdio::eprintln(
        "[arukellt] lower.reachability_insts: before=".concat(insts_before.to_string().concat(" after=".concat(insts_after.to_string())))
    )
}

fn mir_lower_wall_record(
    timing: i32,
    mut wall_ms: Vec<i32>,
    mut wall_name: Vec<String>,
    t_start: i64,
    name: String
) {
    if timing == 0 {
        return
    }
    push(wall_ms, mir_lower_phase_ms(t_start, Clock::monotonic_now()))
    push(wall_name, name)
}

fn mir_lower_top_walls_note(enabled: i32, mut wall_ms: Vec<i32>, wall_name: Vec<String>) {
    if enabled == 0 {
        return
    }
    let n = len(wall_ms)
    let mut limit = n
    if limit > 32 {
        limit = 32
    }
    let mut rank = 0
    while rank < limit {
        let mut best = -1
        let mut best_ms = -1
        let mut i = 0
        while i < n {
            let ms = get_unchecked(wall_ms, i)
            if ms > best_ms {
                best_ms = ms
                best = i
            }
            i = i + 1
        }
        if best < 0 {
            return
        }
        set(wall_ms, best, -1)
        stdio::eprintln(
            "[arukellt] lower.fn_wall ".concat(rank.to_string().concat(" ".concat(get_unchecked(wall_name, best).clone().concat(" ".concat(best_ms.to_string().concat("ms"))))))
        )
        rank = rank + 1
    }
}
