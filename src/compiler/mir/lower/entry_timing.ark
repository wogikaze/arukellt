use std::host::clock
use std::host::stdio
use std::prelude::{clone, get_unchecked, i64_to_i32, len, push, set, to_string}
use std::text
fn mir_lower_phase_timing_enabled(report_flag: i32) -> i32 {
    // Env override disabled on wasm32-gc until Option-from-env::var locals
    // validate; --time / report_flag remains the supported enable path.
    if report_flag != 0 {
        return 1
    }
    0
}

fn mir_lower_phase_now() -> i64 {
    clock::monotonic_now()
}

fn mir_lower_phase_ms(t_start: i64, t_end: i64) -> i32 {
    // Inline ns→ms: `time::duration_ms` lowers to unreachable under pinned→s2 (#823).
    let diff = t_end - t_start
    if diff < 0i64 {
        return 0
    }
    i64_to_i32(diff / 1000000i64)
}

fn mir_lower_phase_note(enabled: i32, label: String, t_start: i64, t_end: i64) {
    if enabled == 0 {
        return
    }
    let ms = mir_lower_phase_ms(t_start, t_end)
    stdio::eprintln(
        "[arukellt] lower.".concat(clone(label).concat(": ".concat(to_string(ms).concat("ms"))))
    )
}

fn mir_lower_gc_late_note(enabled: i32, late_structs: i32, late_enums: i32) {
    if enabled == 0 {
        return
    }
    stdio::eprintln(
        "[arukellt] lower.gc_late: structs=".concat(to_string(late_structs).concat(" enums=".concat(to_string(late_enums))))
    )
}

