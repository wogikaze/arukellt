use std::host::clock::Clock
use std::host::stdio
use std::prelude::{get_unchecked, len, push, set}
use std::text
fn mir_lower_phase_timing_enabled(report_flag: i32) -> i32 {
    // Env override is disabled; --time / report_flag remains the supported
    // enable path.
    if report_flag != 0 {
        return 1
    }
    0
}

fn mir_lower_phase_now() -> i64 {
    Clock::monotonic_now()
}

fn mir_lower_phase_ms(t_start: i64, t_end: i64) -> i32 {
    // Inline ns→ms: `time::duration_ms` lowers to unreachable under pinned→s2 (#823).
    let diff = t_end - t_start
    if diff < 0i64 {
        return 0
    }
    __intrinsic_i64_to_i32(diff / 1000000i64)
}

fn mir_lower_phase_note(enabled: i32, label: String, t_start: i64, t_end: i64) {
    if enabled == 0 {
        return
    }
    let ms = mir_lower_phase_ms(t_start, t_end)
    stdio::eprintln(
        "[arukellt] lower.".concat(label.clone().concat(": ".concat(ms.to_string().concat("ms"))))
    )
}

fn mir_lower_gc_late_note(enabled: i32, late_structs: i32, late_enums: i32) {
    if enabled == 0 {
        return
    }
    stdio::eprintln(
        "[arukellt] lower.gc_late: structs=".concat(late_structs.to_string().concat(" enums=".concat(late_enums.to_string())))
    )
}

fn mir_lower_prefilter_note(enabled: i32, keep: i32, skip: i32) {
    if enabled == 0 {
        return
    }
    stdio::eprintln(
        "[arukellt] lower.prefilter: would_keep=".concat(keep.to_string().concat(" would_skip=".concat(skip.to_string())))
    )
}

fn mir_lower_phase_fns(enabled: i32, before: i32, after: i32) {
    if enabled == 0 {
        return
    }
    stdio::eprintln(
        "[arukellt] lower.reachability_fns: before=".concat(before.to_string().concat(" after=".concat(after.to_string())))
    )
