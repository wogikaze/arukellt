use mir::lower::ctx_api_local_types
use mir::lower::ctx_fn_exists
use mir::lower::ctx_fn_index
use mir::lower::ctx_types
use mir::mono
use mir::mono_instance_shape
use mir::value_types

fn mir_method_name_last_segment(name: String) -> String {
    let n = len(name)
    let mut last_start = 0 - 1
    let mut i = 0
    while i < n - 1 {
        if byte_at(name, i) == 58 && byte_at(name, i + 1) == 58 {
            last_start = i + 2
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if last_start >= 0 {
        return substring(name, last_start, n)
    }
    clone(name)
}

fn mir_method_name_last_two_segments(name: String) -> String {
    let n = len(name)
    let mut prev_start = 0 - 1
    let mut last_start = 0 - 1
    let mut i = 0
    while i < n - 1 {
        if byte_at(name, i) == 58 && byte_at(name, i + 1) == 58 {
            prev_start = last_start
            last_start = i + 2
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if prev_start >= 0 {
        return substring(name, prev_start, n)
    }
    if last_start >= 0 {
        return substring(name, last_start, n)
    }
    clone(name)
}

fn mir_is_all_digits(s: String) -> bool {
    let n = len(s)
    if n == 0 {
        return false
    }
    let mut i = 0
    while i < n {
        let c = byte_at(s, i)
        if c < 48 || c > 57 {
            return false
        }
        i = i + 1
    }
    true
}

fn mir_strip_type_instance_suffix(name: String) -> String {
    let n = len(name)
    if n == 0 {
        return name
    }
    let mut last_colon = 0 - 1
    let mut i = n - 1
    while i >= 0 {
        if byte_at(name, i) == 58 {
            last_colon = i
            i = 0 - 1
        }
        i = i - 1
    }
    if last_colon >= 0 {
        let suffix = substring(name, last_colon + 1, n)
        if mir_is_all_digits(suffix) {
            return substring(name, 0, last_colon)
        }
    }
    clone(name)
}

fn mir_normalize_type_name(t: String) -> String {
    let mut n = clone(t)
    if starts_with(clone(n), String_from("struct:")) {
        n = substring(n, 7, len(n))
    }
    if starts_with(clone(n), String_from("enum:")) {
        n = substring(n, 5, len(n))
    }
    n = mir_strip_type_instance_suffix(clone(n))
    n = mir_method_name_last_segment(clone(n))
    n
}

// Per-instantiation owner spelling for a concrete generic local type.
// "GenTakeIter<VecIter>" -> "GenTakeIter_VecIter"; names without a generic
// argument list pass through unchanged. Impl blocks on concrete
// instantiations register methods under this owner (same rule as
// HashMap_K_V), so method lookup must produce the same spelling.
fn mir_inst_owner_name(type_name: String) -> String {
    // Local-type spellings reach here as struct:Name<Args>:size; reduce them
    // to the declared instantiation spelling before splitting on <>.
    let normalized = mir_normalize_type_name(clone(type_name))
    let n = len(normalized)
    if n < 3 || byte_at(clone(normalized), n - 1) != 62 {
        return normalized
    }
    let mut lt = 0 - 1
    let mut i = 0
    while i < n {
        if byte_at(clone(normalized), i) == 60 {
            lt = i
            i = n
        }
        i = i + 1
    }
    if lt <= 0 {
        return normalized
    }
    let base = substring(clone(normalized), 0, lt)
    let inner = substring(clone(normalized), lt + 1, n - 1)
    // Vec and HashMap impl targets keep their established owner spellings:
    // Vec<String> -> Vec_String, other Vec<T> -> Vec; HashMap<K, V> with two
    // concrete named args -> HashMap_K_V, otherwise bare HashMap.
    if eq(clone(base), String_from("Vec")) {
        if eq(clone(inner), String_from("String")) ||
        eq(clone(inner), String_from("string")) {
            return String_from("Vec_String")
        }
        return String_from("Vec")
    }
    if eq(clone(base), String_from("HashMap")) {
        return mir_hashmap_decl_owner_name(inner)
    }
    let suffix = mir_inst_key_suffix(inner)
    if len(suffix) == 0 {
        // A type parameter or unkeyable argument means the impl is generic;
        // its methods register under the bare owner.
        return base
    }
    concat(clone(base), concat(String_from("_"), suffix))
}

// Bare owner spelling for a generic local type: "WrapIter<i32>" -> "WrapIter".
// Parametric impls (`impl Iterator for WrapIter<T>`) register methods under
// the bare constructor owner, so method lookup falls back here when the
// per-instantiation owner has no impl.
fn mir_bare_owner_name(type_name: String) -> String {
    let normalized = mir_normalize_type_name(clone(type_name))
    let n = len(normalized)
    let mut i = 0
    while i < n {
        if byte_at(clone(normalized), i) == 60 {
            return substring(normalized, 0, i)
        }
        i = i + 1
    }
    normalized
}

// Underscore-joined owner keys for a comma-separated generic argument list,
// or "" when any argument is a type parameter or otherwise unkeyable. An
// unkeyable argument makes the whole impl generic, so its methods register
// under the bare owner.
fn mir_inst_key_suffix(inner: String) -> String {
    let mut suffix = String_new()
    let mut seg_start = 0
    let mut depth = 0
    let m = len(inner)
    let mut j = 0
    while j <= m {
        let at_end = j == m
        let ch = if at_end { 44 } else { byte_at(clone(inner), j) }
        if ch == 60 {
            depth = depth + 1
        }
        if ch == 62 {
            depth = depth - 1
        }
        if (ch == 44 && depth == 0) || at_end {
            let seg = substring(clone(inner), seg_start, j)
            let key = mir_inst_arg_key(seg)
            if len(key) == 0 {
                return String_new()
            }
            if len(suffix) > 0 {
                suffix = concat(suffix, String_from("_"))
            }
            suffix = concat(suffix, key)
            seg_start = j + 1
        }
        j = j + 1
    }
    suffix
}

// HashMap impl targets specialize only on two concrete named type args
// (HashMap<String, i32> -> HashMap_String_i32). Type-parameter or nested
// generic args keep the bare HashMap owner, matching impl_self_type_name.
fn mir_hashmap_decl_owner_name(inner: String) -> String {
    let mut comma = 0 - 1
    let mut depth = 0
    let m = len(inner)
    let mut i = 0
    while i < m {
        let ch = byte_at(clone(inner), i)
        if ch == 60 {
            depth = depth + 1
        }
        if ch == 62 {
            depth = depth - 1
        }
        if ch == 44 && depth == 0 {
            if comma >= 0 {
                return String_from("HashMap")
            }
            comma = i
        }
        i = i + 1
    }
    if comma < 0 {
        return String_from("HashMap")
    }
    let key_seg = substring(clone(inner), 0, comma)
    let val_seg = substring(clone(inner), comma + 1, m)
    if !mir_inst_seg_is_named(key_seg) || !mir_inst_seg_is_named(val_seg) {
        return String_from("HashMap")
    }
    concat(
        String_from("HashMap_"),
        concat(
            mir_inst_named_seg_key(key_seg),
            concat(String_from("_"), mir_inst_named_seg_key(val_seg))
        )
    )
}

// A plain named type segment (no <>, no local-type classifier, not a type
// parameter) — the shape impl_self_type_name accepts for HashMap_K_V owners.
fn mir_inst_seg_is_named(seg: String) -> bool {
    if len(seg) == 0 {
        return false
    }
    if len(seg) == 1 && byte_at(clone(seg), 0) >= 65 && byte_at(clone(seg), 0) <= 90 {
        return false
    }
    let mut i = 0
    while i < len(seg) {
        let ch = byte_at(clone(seg), i)
        if ch == 60 || ch == 62 || ch == 58 || ch == 63 {
            return false
        }
        i = i + 1
    }
    true
}

fn mir_inst_named_seg_key(seg: String) -> String {
    if eq(clone(seg), String_from("string")) {
        return String_from("String")
    }
    seg
}

// Owner-key spelling for one concrete local-type argument. Mirrors the
// typechecker inst_arg_key mapping on the local-type name spelling
// (vec:i32 -> Vec_i32, hashmap:si32 -> HashMap_String_i32). Returns "" for
// type variables so generic impl heads keep the bare owner.
fn mir_inst_arg_key(seg: String) -> String {
    if len(seg) == 0 {
        return String_new()
    }
    if starts_with(clone(seg), String_from("vec:")) {
        let inner = substring(clone(seg), 4, len(seg))
        if len(inner) == 0 {
            return String_from("Vec")
        }
        let elem_key = mir_inst_arg_key(inner)
        if len(elem_key) == 0 {
            return String_new()
        }
        return concat(String_from("Vec_"), elem_key)
    }
    if starts_with(clone(seg), String_from("hashmap:")) {
        let owner = mir_hashmap_impl_owner_name(seg)
        if len(owner) == 0 {
            return String_from("HashMap")
        }
        return owner
    }
    if starts_with(clone(seg), String_from("struct:")) {
        let rest = substring(clone(seg), 7, len(seg))
        return mir_inst_arg_key(mir_strip_type_instance_suffix(rest))
    }
    if starts_with(clone(seg), String_from("enum:")) {
        return mir_inst_arg_key(substring(clone(seg), 5, len(seg)))
    }
    if eq(clone(seg), String_from("string")) {
        return String_from("String")
    }
    if byte_at(clone(seg), 0) == 63 {
        return String_new()
    }
    if len(seg) == 1 && byte_at(clone(seg), 0) >= 65 && byte_at(clone(seg), 0) <= 90 {
        return String_new()
    }
    if eq(clone(seg), String_from("fn")) ||
    starts_with(clone(seg), String_from("fn(")) ||
    starts_with(clone(seg), String_from("fnsig:")) ||
    starts_with(clone(seg), String_from("fnref")) {
        return String_from("fnref")
    }
    let mut k = 0
    while k < len(seg) {
        if byte_at(clone(seg), k) == 60 {
            // Nested generic arg: apply the generic key rule directly so
            // Vec<i32> stays Vec_i32 (the Vec/HashMap target-level owner
            // spellings do not apply to argument position). An unkeyable
            // nested arg makes the whole owner fall back to bare.
            let mut arg_end = len(seg)
            if byte_at(clone(seg), arg_end - 1) == 62 {
                arg_end = arg_end - 1
            }
            let arg_inner = substring(clone(seg), k + 1, arg_end)
            let arg_suffix = mir_inst_key_suffix(arg_inner)
            if len(arg_suffix) == 0 {
                return String_new()
            }
            return concat(
                substring(clone(seg), 0, k),
                concat(String_from("_"), arg_suffix)
            )
        }
        k = k + 1
    }
    seg
}

fn mir_is_vec_string_type(type_name: String) -> bool {
    eq(clone(type_name), String_from("vec:String")) ||
    eq(clone(type_name), String_from("vec:Vec_String"))
}

fn mir_is_vec_string_iteration_method(method_name: String) -> bool {
    eq(clone(method_name), String_from("iter")) ||
    eq(clone(method_name), String_from("into_iter"))
}

fn mir_is_vec_string_from_iter_source(type_name: String) -> bool {
    eq(clone(type_name), String_from("StringIter")) ||
    eq(clone(type_name), String_from("MapIter_String_String")) ||
    eq(clone(type_name), String_from("FilterIter_String")) ||
    eq(clone(type_name), String_from("TakeIter_MapIter_String_String")) ||
    eq(clone(type_name), String_from("TakeIter_FilterIter_String")) ||
    eq(clone(type_name), String_from("MapFilterIter_String_String")) ||
    eq(clone(type_name), String_from("FilterMapIter_String")) ||
    eq(clone(type_name), String_from("TakeIter_MapFilterIter_String_String")) ||
    eq(clone(type_name), String_from("TakeIter_FilterMapIter_String")) ||
    eq(clone(type_name), String_from("StringSkipMapIter")) ||
    eq(clone(type_name), String_from("StringSkipFilterIter"))
}

// Concrete HashMap<K, V> locals carry the hashmap:<pair> or HashMap_K_V
// spelling. Map each supported pair to the impl owner that registers its
// trait impl methods (for example HashMap_String_i32::into_iter).
// Function-valued maps stay unmapped so the typecheck boundary keeps
// reporting them as unsupported.
fn mir_hashmap_impl_owner_name(type_name: String) -> String {
    if eq(clone(type_name), "hashmap:i32i32") || eq(clone(type_name), "HashMap_i32_i32") {
        return String_from("HashMap_i32_i32")
    }
    if eq(clone(type_name), "hashmap:si32") || eq(clone(type_name), "HashMap_String_i32") {
        return String_from("HashMap_String_i32")
    }
    if eq(clone(type_name), "hashmap:i32str") || eq(clone(type_name), "HashMap_i32_String") {
        return String_from("HashMap_i32_String")
    }
    if eq(clone(type_name), "hashmap:strstr") || eq(clone(type_name), "HashMap_String_String") {
        return String_from("HashMap_String_String")
    }
    String_from("")
}

fn mir_resolve_short_method_name(ctx: LowerCtx, name: String) -> String {
    let norm = mir_normalize_type_name(clone(name))
    let exact = ctx_fn_index::ctx_fn_index_find(ctx, clone(norm))
    if exact >= 0 {
        return clone(ctx_fn_index::ctx_fn_index_name_at(ctx, exact))
    }
    let last_two = mir_method_name_last_two_segments(clone(norm))
    if !eq(clone(last_two), clone(norm)) {
        let found = ctx_fn_index::ctx_fn_index_find(ctx, clone(last_two))
        if found >= 0 {
            return clone(ctx_fn_index::ctx_fn_index_name_at(ctx, found))
        }
    }
    let last = mir_method_name_last_segment(clone(norm))
    if !eq(clone(last), clone(norm)) {
        let found = ctx_fn_index::ctx_fn_index_find(ctx, clone(last))
        if found >= 0 {
            return clone(ctx_fn_index::ctx_fn_index_name_at(ctx, found))
        }
    }
    String_from("")
}

fn mir_method_mono_type_key(ctx: LowerCtx, first_method_arg_idx: i32) -> String {
    if first_method_arg_idx < 0 {
        return String_from("")
    }
    let mut method_mono_type_key = ctx_get_local_type(ctx, first_method_arg_idx)
    if len(method_mono_type_key) == 0 {
        let method_arg_vt = ctx_local_vt(ctx, first_method_arg_idx)
        if method_arg_vt == value_types::VT_I64() {
            method_mono_type_key = String_from("i64")
        } else if method_arg_vt == value_types::VT_F64() {
            method_mono_type_key = String_from("f64")
        } else {
            method_mono_type_key = String_from("i32")
        }
    }
    if eq(clone(method_mono_type_key), String_from("string")) {
        method_mono_type_key = String_from("String")
    }
    method_mono_type_key
}

fn mir_resolve_method_callee(ctx: LowerCtx, callee_name: String, first_method_arg_idx: i32, span_start: i32) -> String {
    // Prefer CoreOp rewrite names for Vec mutating/access methods. Generic
    // `impl Vec<T> { push/... }` shells must not win mono as
    // `__core_vec_push_i32_impl` before element-type rewrite (#845).
    let early_vec = mir_vec_method_prefer_coreop_name(clone(callee_name))
    if len(early_vec) > 0 {
        return early_vec
    }
    let method_mono_type_key = mir_method_mono_type_key(ctx, first_method_arg_idx)
    if len(method_mono_type_key) > 0 {
        let method_mono_candidate = mono::mono_safe_name(concat(clone(callee_name), concat(String_from("__"), method_mono_type_key)))
        if ctx_has_fn_name(ctx, clone(method_mono_candidate)) {
            return method_mono_candidate
        }
    }
    // A nested generic receiver call can share its source span with the
    // surrounding method expression. Resolve non-generic String builtins
    // before span-based mono lookup so `get_unchecked(v, i).len()` does not
    // reuse the receiver call's `get_unchecked__String` specialization.
    let bare_builtin = mir_bare_method_name(clone(callee_name))
    if eq(mir_type_prefix(clone(callee_name)), String_from("String")) &&
    (eq(clone(bare_builtin), String_from("len")) || eq(clone(bare_builtin), String_from("char_at"))) {
        return bare_builtin
    }
    let mono_target = ctx_mono_lookup_call(ctx, span_start, clone(callee_name))
    if len(mono_target) > 0 {
        return mono_target
    }
    if ctx_has_fn_name(ctx, clone(callee_name)) {
        return callee_name
    }
    // Parametric impl method call on a per-instantiation owner (ADR-078):
    // `self.iter.next()` inside `Twice<I>` at I=WrapIter<i32> arrives as
    // `WrapIter_i32::next`. The propagated instance `WrapIter::next`+[i32]
    // emits as `WrapIter__next__i32`; map the inst-owner spelling back.
    let parametric_target = mir_parametric_impl_callee(ctx, clone(callee_name))
    if len(parametric_target) > 0 {
        return parametric_target
    }
    // The name-rewrite pool is instantiation-blind (first unused match for
    // the bare method name), so it runs only after the precise
    // receiver-derived paths above.
    let named_mono_target = ctx_resolve_unused_mono_by_name(ctx, callee_name)
    if len(named_mono_target) > 0 {
        return named_mono_target
    }
    // Fallback for builtin types: if the mangled callee (e.g. "Vec::push")
    // is not a MIR function, check if the type prefix is a builtin type.
    // If so, map to the corresponding compiler intrinsic name.
    let bare_name = mir_bare_method_name(callee_name)
    if len(bare_name) > 0 && mir_is_builtin_type_prefix(callee_name) {
        let intrinsic_name = mir_builtin_method_to_intrinsic(callee_name, bare_name)
        if len(intrinsic_name) > 0 {
            return intrinsic_name
        }
        // Prefer Type::method when present. Falling back to a free function of
        // the same bare name recurses through ADR-046 wrappers (#807 popcount).
        if ctx_has_fn_name(ctx, clone(callee_name)) {
            return callee_name
        }
        return bare_name
    }
    let short_name = mir_resolve_short_method_name(ctx, clone(callee_name))
    if len(short_name) > 0 {
        return short_name
    }
    callee_name
}

fn mir_vec_method_prefer_coreop_name(mangled: String) -> String {
    if !eq(mir_type_prefix(clone(mangled)), String_from("Vec")) {
        return String_from("")
    }
    let bare_name = mir_bare_method_name(clone(mangled))
    if eq(clone(bare_name), String_from("push")) || starts_with(clone(bare_name), String_from("push__")) {
        return String_from("push")
    }
    if eq(clone(bare_name), String_from("len")) || starts_with(clone(bare_name), String_from("len__")) {
        return String_from("raw_array_len")
    }
    if eq(clone(bare_name), String_from("set")) || starts_with(clone(bare_name), String_from("set__")) {
        return String_from("raw_array_set_unchecked")
    }
    if eq(clone(bare_name), String_from("pop")) || starts_with(clone(bare_name), String_from("pop__")) {
        return String_from("vec_pop")
    }
    if eq(clone(bare_name), String_from("get")) || starts_with(clone(bare_name), String_from("get__")) {
        return String_from("vec_get")
    }
    if eq(clone(bare_name), String_from("get_unchecked")) || starts_with(clone(bare_name), String_from("get_unchecked__")) {
        return String_from("get_unchecked")
    }
    if eq(clone(bare_name), String_from("is_empty")) || starts_with(clone(bare_name), String_from("is_empty__")) {
        return String_from("is_empty")
    }
    String_from("")
}

fn mir_builtin_method_to_intrinsic(mangled: String, bare_name: String) -> String {
    let prefix = mir_type_prefix(mangled)
    // Vec methods: some intrinsics use bare name, others use vec_ prefix.
    if eq(clone(prefix), String_from("Vec")) {
        let preferred = mir_vec_method_prefer_coreop_name(clone(mangled))
        if len(preferred) > 0 {
            return preferred
        }
        // Associated constructors: keep mangled Vec::new__T for wasm
        // is_vec_new_callee fallback (no MIR body; #845).
        if eq(clone(bare_name), String_from("new")) ||
        starts_with(clone(bare_name), String_from("new__")) ||
        eq(clone(bare_name), String_from("with_capacity")) ||
        starts_with(clone(bare_name), String_from("with_capacity__")) {
            return mangled
        }
        return String_from("")
    }
    // String methods: len, char_at, etc. use bare name — no mapping needed.
    // Scalar methods: map trait dispatch names to compare intrinsics so
    // prelude String `eq` is not used for i32/i64/f64/bool/char receivers.
    if eq(clone(bare_name), String_from("eq")) {
        if eq(clone(prefix), String_from("i32")) { return String_from("__intrinsic_i32_eq") }
        if eq(clone(prefix), String_from("i64")) { return String_from("__intrinsic_i64_eq") }
        if eq(clone(prefix), String_from("f64")) { return String_from("__intrinsic_f64_eq") }
        if eq(clone(prefix), String_from("bool")) { return String_from("__intrinsic_i32_eq") }
        if eq(clone(prefix), String_from("char")) { return String_from("__intrinsic_i32_eq") }
    }
    if eq(clone(bare_name), String_from("hash")) {
        if eq(clone(prefix), String_from("i32")) { return String_from("hash_i32") }
        if eq(clone(prefix), String_from("String")) { return String_from("hash_string") }
        if eq(clone(prefix), String_from("i64")) { return String_from("hash_i64") }
        if eq(clone(prefix), String_from("bool")) { return String_from("hash_i32") }
        if eq(clone(prefix), String_from("char")) { return String_from("hash_i32") }
        if eq(clone(prefix), String_from("f64")) { return String_from("hash_f64") }
    }
    String_from("")
}

// Parametric impl method call on a per-instantiation owner (ADR-078).
// `self.iter.next()` inside `Twice<I>` at I=WrapIter<i32> reaches here as
// `WrapIter_i32::next`: the receiver's concrete instantiation supplies the
// impl self-type arguments, and the propagated instance
// `WrapIter::next`+[i32] emits as `WrapIter__next__i32`. Scan recorded
// instances for the method whose owner safe-name prefixes the
// per-instantiation owner and whose argument key matches the remainder.
fn mir_parametric_impl_callee(ctx: LowerCtx, callee_name: String) -> String {
    let owner = mir_type_prefix(clone(callee_name))
    let method = mir_bare_method_name(clone(callee_name))
    if len(owner) == 0 || len(method) == 0 {
        return String_new()
    }
    if !contains(clone(owner), String_from("_")) {
        return String_new()
    }
    let method_suffix = concat("::", clone(method))
    let inst_count = len(ctx.mono_instances)
    let mut i = 0
    while i < inst_count {
        let inst = get_unchecked(ctx.mono_instances, i)
        let inst_fn = mono_instance_shape::mir_mono_instance_fn_name(inst)
        if ends_with(clone(inst_fn), clone(method_suffix)) {
            let inst_owner = substring(clone(inst_fn), 0, len(inst_fn) - len(method_suffix))
            let owner_safe = mono::mono_safe_name(inst_owner)
            let recv_prefix = concat(clone(owner_safe), String_from("_"))
            if starts_with(clone(owner), clone(recv_prefix)) {
                let recv_args = substring(clone(owner), len(recv_prefix), len(owner))
                let mangled_safe = mono::mono_safe_name(
                    mono_instance_shape::mir_mono_instance_mangled_name(inst)
                )
                let arg_prefix = concat(
                    clone(owner_safe),
                    concat("__", concat(clone(method), "__"))
                )
                if starts_with(clone(mangled_safe), clone(arg_prefix)) {
                    let inst_args = substring(clone(mangled_safe), len(arg_prefix), len(mangled_safe))
                    if mir_mono_arg_segments_eq(clone(recv_args), inst_args) &&
                    ctx_has_fn_name(ctx, clone(mangled_safe)) {
                        return mangled_safe
                    }
                }
            }
        }
        i = i + 1
    }
    String_new()
}

// Compare mono argument keys that use different separators. Per-
// instantiation owners join arguments with `_` (Pair_i32_String) while
// mangled instance names join with `__` (i32__String) and nested args
// keep a trailing `_` from `>`. Splitting on `_` and dropping empty
// segments normalizes both forms.
fn mir_mono_arg_segments_eq(recv_args: String, inst_args: String) -> bool {
    let recv_segs = mir_mono_arg_segments(recv_args)
    let inst_segs = mir_mono_arg_segments(inst_args)
    if len(recv_segs) != len(inst_segs) {
        return false
    }
    let mut i = 0
    while i < len(recv_segs) {
        if !eq(get_unchecked(recv_segs, i), get_unchecked(inst_segs, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn mir_mono_arg_segments(args: String) -> Vec<String> {
    let segs = Vec::new<String>()
    let mut seg_start = 0
    let n = len(args)
    let mut i = 0
    while i <= n {
        if i == n || byte_at(clone(args), i) == 95 {
            let seg = substring(clone(args), seg_start, i)
            if len(seg) > 0 {
                push(segs, seg)
            }
            seg_start = i + 1
        }
        i = i + 1
    }
    segs
}

fn mir_bare_method_name(mangled: String) -> String {
    let pos = index_of(clone(mangled), String_from("::"))
    if pos < 0 {
        return String_from("")
    }
    substring(mangled, pos + 2, len(mangled))
}

fn mir_is_builtin_type_prefix(mangled: String) -> bool {
    let prefix = mir_type_prefix(mangled)
    if eq(clone(prefix), String_from("Vec")) { return true }
    if eq(clone(prefix), String_from("String")) { return true }
    if eq(clone(prefix), String_from("i32")) { return true }
    if eq(clone(prefix), String_from("i64")) { return true }
    if eq(clone(prefix), String_from("f64")) { return true }
    if eq(clone(prefix), String_from("f32")) { return true }
    if eq(clone(prefix), String_from("bool")) { return true }
    if eq(clone(prefix), String_from("char")) { return true }
    false
}

fn mir_type_prefix(mangled: String) -> String {
    let pos = index_of(clone(mangled), String_from("::"))
    if pos < 0 {
        return String_from("")
    }
    substring(mangled, 0, pos)
}
