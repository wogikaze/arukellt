use std::text
use mir::lower::ctx_api_local_types
use mir::lower::ctx_fn_exists
use mir::lower::ctx_fn_index
use mir::lower::ctx_types
use mir::lower::ctx_resolved_calls
use mir::mono
use mir::mono_instance_shape
use mir::value_types

fn mir_method_name_last_segment(name: String) -> String {
    let n = name.len()
    let mut last_start = 0 - 1
    let mut i = 0
    while i < n - 1 {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            last_start = i + 2
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if last_start >= 0 {
        return name.slice(last_start, n)
    }
    name.clone()
}

fn mir_method_name_last_two_segments(name: String) -> String {
    let n = name.len()
    let mut prev_start = 0 - 1
    let mut last_start = 0 - 1
    let mut i = 0
    while i < n - 1 {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            prev_start = last_start
            last_start = i + 2
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if prev_start >= 0 {
        return name.slice(prev_start, n)
    }
    if last_start >= 0 {
        return name.slice(last_start, n)
    }
    name.clone()
}

fn mir_is_all_digits(s: String) -> bool {
    let n = s.len()
    if n == 0 {
        return false
    }
    let mut i = 0
    while i < n {
        let c = s.byte_at(i)
        if c < 48 || c > 57 {
            return false
        }
        i = i + 1
    }
    true
}

fn mir_strip_type_instance_suffix(name: String) -> String {
    let n = name.len()
    if n == 0 {
        return name
    }
    let mut last_colon = 0 - 1
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            last_colon = i
            i = 0 - 1
        }
        i = i - 1
    }
    if last_colon >= 0 {
        let suffix = name.slice(last_colon + 1, n)
        if mir_is_all_digits(suffix) {
            return name.slice(0, last_colon)
        }
    }
    name.clone()
}

fn mir_normalize_type_name(t: String) -> String {
    let mut n = t.clone()
    if n.clone().starts_with(String_from("struct:")) {
        n = n.slice(7, n.len())
    }
    if n.clone().starts_with(String_from("enum:")) {
        n = n.slice(5, n.len())
    }
    n = mir_strip_type_instance_suffix(n.clone())
    n = mir_method_name_last_segment(n.clone())
    n
}

// Per-instantiation owner spelling for a concrete generic local type.
// "GenTakeIter<VecIter>" -> "GenTakeIter_VecIter"; names without a generic
// argument list pass through unchanged. Impl blocks on concrete
// instantiations register methods under this owner (same rule as
// HashMap_K_V), so method lookup must produce the same spelling.
fn mir_inst_owner_name(type_name: String) -> String {
    // Local-type spellings reach here as struct:Name<Args>:size; reduce them
    // to the declared instantiation spelling before splitting on <>.
    let normalized = mir_normalize_type_name(type_name.clone())
    let n = normalized.len()
    if n < 3 || normalized.clone().byte_at(n - 1) != 62 {
        return normalized
    }
    let mut lt = 0 - 1
    let mut i = 0
    while i < n {
        if normalized.clone().byte_at(i) == 60 {
            lt = i
            i = n
        }
        i = i + 1
    }
    if lt <= 0 {
        return normalized
    }
    let base = normalized.clone().slice(0, lt)
    let inner = normalized.clone().slice(lt + 1, n - 1)
    // Vec and HashMap impl targets keep their established owner spellings:
    // Vec<String> -> Vec_String, other Vec<T> -> Vec; HashMap<K, V> with two
    // concrete named args -> HashMap_K_V, otherwise bare HashMap.
    if base.clone().eq(String_from("Vec")) {
        if inner.clone().eq(String_from("String")) ||
        inner.clone().eq(String_from("string")) {
            return String_from("Vec_String")
        }
        return String_from("Vec")
    }
    if base.clone().eq(String_from("HashMap")) {
        return mir_hashmap_decl_owner_name(inner)
    }
    let suffix = mir_inst_key_suffix(inner)
    if suffix.len() == 0 {
        // A type parameter or unkeyable argument means the impl is generic;
        // its methods register under the bare owner.
        return base
    }
    base.clone().concat(String_from("_").concat(suffix))
}

// Bare owner spelling for a generic local type: "WrapIter<i32>" -> "WrapIter".
// Parametric impls (`impl Iterator for WrapIter<T>`) register methods under
// the bare constructor owner, so method lookup falls back here when the
// per-instantiation owner has no impl.
fn mir_bare_owner_name(type_name: String) -> String {
    let normalized = mir_normalize_type_name(type_name.clone())
    let n = normalized.len()
    let mut i = 0
    while i < n {
        if normalized.clone().byte_at(i) == 60 {
            return normalized.slice(0, i)
        }
        i = i + 1
    }
    normalized
}

// Underscore-joined owner keys for a comma-separated generic argument list,
// or "" when any argument is a type parameter or otherwise unkeyable. An
// unkeyable argument makes the whole impl generic, so its methods register
// under the bare owner.
fn mir_inst_key_suffix(inner: String) -> String {
    let mut suffix = String_new()
    let mut seg_start = 0
    let mut depth = 0
    let m = inner.len()
    let mut j = 0
    while j <= m {
        let at_end = j == m
        let ch = if at_end { 44 } else { inner.clone().byte_at(j) }
        if ch == 60 {
            depth = depth + 1
        }
        if ch == 62 {
            depth = depth - 1
        }
        if (ch == 44 && depth == 0) || at_end {
            let seg = inner.clone().slice(seg_start, j)
            let key = mir_inst_arg_key(seg)
            if key.len() == 0 {
                return String_new()
            }
            if suffix.len() > 0 {
                suffix = suffix.concat(String_from("_"))
            }
            suffix = suffix.concat(key)
            seg_start = j + 1
        }
        j = j + 1
    }
    suffix
}

// HashMap impl targets specialize only on two concrete named type args
// (HashMap<String, i32> -> HashMap_String_i32). Type-parameter or nested
// generic args keep the bare HashMap owner, matching impl_self_type_name.
fn mir_hashmap_decl_owner_name(inner: String) -> String {
    let mut comma = 0 - 1
    let mut depth = 0
    let m = inner.len()
    let mut i = 0
    while i < m {
        let ch = inner.clone().byte_at(i)
        if ch == 60 {
            depth = depth + 1
        }
        if ch == 62 {
            depth = depth - 1
        }
        if ch == 44 && depth == 0 {
            if comma >= 0 {
                return String_from("HashMap")
            }
            comma = i
        }
        i = i + 1
    }
    if comma < 0 {
        return String_from("HashMap")
    }
    let key_seg = inner.clone().slice(0, comma)
    let val_seg = inner.clone().slice(comma + 1, m)
    if !mir_inst_seg_is_named(key_seg.clone()) {
        return String_from("HashMap")
    }
    if mir_inst_seg_is_named(val_seg.clone()) {
        return String_from("HashMap_").concat(mir_inst_named_seg_key(key_seg).concat(String_from("_").concat(mir_inst_named_seg_key(val_seg))))
    }
    // Function-valued pairs keep the shared fnref owner key that impl
    // registration and inst_arg_key use (HashMap_i32_fnref, #691).
    if mir_inst_seg_is_fn(val_seg.clone()) {
        return String_from("HashMap_").concat(mir_inst_named_seg_key(key_seg).concat(String_from("_fnref")))
    }
    String_from("HashMap")
}

// A plain named type segment (no <>, no local-type classifier, not a type
// parameter) — the shape impl_self_type_name accepts for HashMap_K_V owners.
fn mir_inst_seg_is_named(seg: String) -> bool {
    if seg.len() == 0 {
        return false
    }
    if seg.len() == 1 && seg.clone().byte_at(0) >= 65 && seg.clone().byte_at(0) <= 90 {
        return false
    }
    let mut i = 0
    while i < seg.len() {
        let ch = seg.clone().byte_at(i)
        if ch == 60 || ch == 62 || ch == 58 || ch == 63 {
            return false
        }
        i = i + 1
    }
    true
}

// A fn-typed generic argument segment (fn, fn(...), fn<...>, fnref,
// fnsig:). Leading whitespace from source spellings is skipped so
// "HashMap<i32, fn(i32) -> i32>" resolves the same owner as the compact
// forms (#691).
fn mir_inst_seg_is_fn(seg: String) -> bool {
    let n = seg.len()
    let mut i = 0
    while i < n && seg.clone().byte_at(i) == 32 {
        i = i + 1
    }
    let s = seg.clone().slice(i, n)
    s.clone().eq(String_from("fn")) ||
    s.clone().starts_with(String_from("fn(")) ||
    s.clone().starts_with(String_from("fn<")) ||
    s.clone().starts_with(String_from("fnref")) ||
    s.clone().starts_with(String_from("fnsig:"))
}

fn mir_inst_named_seg_key(seg: String) -> String {
    if seg.clone().eq(String_from("string")) {
        return String_from("String")
    }
    seg
}

// Owner-key spelling for one concrete local-type argument. Mirrors the
// typechecker inst_arg_key mapping on the local-type name spelling
// (vec:i32 -> Vec_i32, hashmap:si32 -> HashMap_String_i32). Returns "" for
// type variables so generic impl heads keep the bare owner.
fn mir_inst_arg_key(seg: String) -> String {
    if seg.len() == 0 {
        return String_new()
    }
    if seg.clone().starts_with(String_from("vec:")) {
        let inner = seg.clone().slice(4, seg.len())
        if inner.len() == 0 {
            return String_from("Vec")
        }
        let elem_key = mir_inst_arg_key(inner)
        if elem_key.len() == 0 {
            return String_new()
        }
        return String_from("Vec_").concat(elem_key)
    }
    if seg.clone().starts_with(String_from("hashmap:")) {
        let owner = mir_hashmap_impl_owner_name(seg)
        if owner.len() == 0 {
            return String_from("HashMap")
        }
        return owner
    }
    if seg.clone().starts_with(String_from("struct:")) {
        let rest = seg.clone().slice(7, seg.len())
        return mir_inst_arg_key(mir_strip_type_instance_suffix(rest))
    }
    if seg.clone().starts_with(String_from("enum:")) {
        return mir_inst_arg_key(seg.clone().slice(5, seg.len()))
    }
    if seg.clone().eq(String_from("string")) {
        return String_from("String")
    }
    if seg.clone().byte_at(0) == 63 {
        return String_new()
    }
    if seg.len() == 1 && seg.clone().byte_at(0) >= 65 && seg.clone().byte_at(0) <= 90 {
        return String_new()
    }
    if seg.clone().eq(String_from("fn")) ||
    seg.clone().starts_with(String_from("fn(")) ||
    seg.clone().starts_with(String_from("fnsig:")) ||
    seg.clone().starts_with(String_from("fnref")) {
        return String_from("fnref")
    }
    let mut k = 0
    while k < seg.len() {
        if seg.clone().byte_at(k) == 60 {
            // Nested generic arg: apply the generic key rule directly so
            // Vec<i32> stays Vec_i32 (the Vec/HashMap target-level owner
            // spellings do not apply to argument position). An unkeyable
            // nested arg makes the whole owner fall back to bare.
            let mut arg_end = seg.len()
            if seg.clone().byte_at(arg_end - 1) == 62 {
                arg_end = arg_end - 1
            }
            let arg_inner = seg.clone().slice(k + 1, arg_end)
            let arg_suffix = mir_inst_key_suffix(arg_inner)
            if arg_suffix.len() == 0 {
                return String_new()
            }
            return seg.clone().slice(0, k).concat(String_from("_").concat(arg_suffix))
        }
        k = k + 1
    }
    seg
}

fn mir_is_vec_string_type(type_name: String) -> bool {
    type_name.clone().eq(String_from("vec:String")) ||
    type_name.clone().eq(String_from("vec:Vec_String"))
}

fn mir_is_vec_string_iteration_method(method_name: String) -> bool {
    method_name.clone().eq(String_from("iter")) ||
    method_name.clone().eq(String_from("into_iter"))
}

fn mir_is_vec_string_from_iter_source(type_name: String) -> bool {
    type_name.clone().eq(String_from("VecIter_String")) ||
    type_name.clone().eq(String_from("MapIter_String_String")) ||
    type_name.clone().eq(String_from("FilterIter_String")) ||
    type_name.clone().eq(String_from("TakeIter_MapIter_String_String")) ||
    type_name.clone().eq(String_from("TakeIter_FilterIter_String")) ||
    type_name.clone().eq(String_from("MapFilterIter_String_String")) ||
    type_name.clone().eq(String_from("FilterMapIter_String_String")) ||
    type_name.clone().eq(String_from("TakeIter_MapFilterIter_String_String")) ||
    type_name.clone().eq(String_from("TakeIter_FilterMapIter_String_String")) ||
    type_name.clone().eq(String_from("SkipMapIter_VecIter_String")) ||
    type_name.clone().eq(String_from("SkipFilterIter_VecIter_String"))
}

// Concrete HashMap<K, V> locals carry the hashmap:<pair> or HashMap_K_V
// spelling. Map each supported pair to the impl owner that registers its
// trait impl methods (for example HashMap_String_i32::into_iter).
// Function-valued pairs map to the shared fnref owners
// (HashMap_i32_fnref::into_iter etc.) that impl registration produces
// for HashMap<K, fn> impl targets (#691).
fn mir_hashmap_impl_owner_name(type_name: String) -> String {
    if type_name.clone().eq("hashmap:i32i32") || type_name.clone().eq("HashMap_i32_i32") {
        return String_from("HashMap_i32_i32")
    }
    if type_name.clone().eq("hashmap:si32") || type_name.clone().eq("HashMap_String_i32") {
        return String_from("HashMap_String_i32")
    }
    if type_name.clone().eq("hashmap:i32str") || type_name.clone().eq("HashMap_i32_String") {
        return String_from("HashMap_i32_String")
    }
    if type_name.clone().eq("hashmap:strstr") || type_name.clone().eq("HashMap_String_String") {
        return String_from("HashMap_String_String")
    }
    if type_name.clone().eq("hashmap:i32fn") || type_name.clone().eq("HashMap_i32_fnref") {
        return String_from("HashMap_i32_fnref")
    }
    if type_name.clone().eq("hashmap:strfn") || type_name.clone().eq("HashMap_String_fnref") {
        return String_from("HashMap_String_fnref")
    }
    String_from("")
}

fn mir_resolve_short_method_name(ctx: LowerCtx, name: String) -> String {
    let norm = mir_normalize_type_name(name.clone())
    let exact = ctx_fn_index::ctx_fn_index_find(ctx, norm.clone())
    if exact >= 0 {
        return ctx_fn_index::ctx_fn_index_name_at(ctx, exact).clone()
    }
    let last_two = mir_method_name_last_two_segments(norm.clone())
    if !last_two.clone().eq(norm.clone()) {
        let found = ctx_fn_index::ctx_fn_index_find(ctx, last_two.clone())
        if found >= 0 {
            return ctx_fn_index::ctx_fn_index_name_at(ctx, found).clone()
        }
    }
    let last = mir_method_name_last_segment(norm.clone())
    if !last.clone().eq(norm.clone()) {
        let found = ctx_fn_index::ctx_fn_index_find(ctx, last.clone())
        if found >= 0 {
            return ctx_fn_index::ctx_fn_index_name_at(ctx, found).clone()
        }
    }
    String_from("")
}

fn mir_method_mono_type_key(ctx: LowerCtx, first_method_arg_idx: i32) -> String {
    if first_method_arg_idx < 0 {
        return String_from("")
    }
    let mut method_mono_type_key = ctx_get_local_type(ctx, first_method_arg_idx)
    if method_mono_type_key.len() == 0 {
        let method_arg_vt = ctx_local_vt(ctx, first_method_arg_idx)
        if method_arg_vt == value_types::VT_I64() {
            method_mono_type_key = String_from("i64")
        } else if method_arg_vt == value_types::VT_F64() {
            method_mono_type_key = String_from("f64")
        } else {
            method_mono_type_key = String_from("i32")
        }
    }
    if method_mono_type_key.clone().eq(String_from("string")) {
        method_mono_type_key = String_from("String")
    }
    method_mono_type_key
}

fn mir_resolve_method_callee(mut ctx: LowerCtx, callee_name: String, first_method_arg_idx: i32, span_start: i32) -> String {
    // Prefer CoreOp rewrite names for Vec mutating/access methods. Generic
    // `impl Vec<T> { push/... }` shells must not win mono as
    // `__core_vec_push_i32_impl` before element-type rewrite (#845).
    let early_vec = mir_vec_method_prefer_coreop_name(callee_name.clone())
    if early_vec.len() > 0 {
        return early_vec
    }
    let method_mono_type_key = mir_method_mono_type_key(ctx, first_method_arg_idx)
    if method_mono_type_key.len() > 0 {
        let method_mono_candidate = mono::mono_safe_name(callee_name.clone().concat(String_from("__").concat(method_mono_type_key)))
        if ctx_has_fn_name(ctx, method_mono_candidate.clone()) {
            return method_mono_candidate
        }
    }
    // A nested generic receiver call can share its source span with the
    // surrounding method expression. Resolve non-generic String builtins
    // before span-based mono lookup so `get_unchecked(v, i).len()` does not
    // reuse the receiver call's `get_unchecked__String` specialization.
    let bare_builtin = mir_bare_method_name(callee_name.clone())
    if mir_type_prefix(callee_name.clone()).eq(String_from("String")) &&
    bare_builtin.clone().eq(String_from("len")) {
        // Owner-qualified already: `.len()` method lowering emits the String
        // CoreOp owner instead of recovering a receiver from a local spelling.
        return String_from("String::len")
    }
    if mir_type_prefix(callee_name.clone()).eq(String_from("String")) &&
    bare_builtin.clone().eq(String_from("char_at")) {
        return bare_builtin
    }
    // The checker records the mono instance for a generic call site keyed by
    // the declaring body and span (#933), so it survives two modules that
    // place a call at the same byte offset. The span-rewrite pool below is
    // keyed by the span alone and hands out first-unused instances, so it
    // must not outrank the checker's module-scoped answer: `Vec<String>`
    // clone must stay `Vec__clone__String` even when another module records
    // `Vec__clone__TypeInfo` at the same offset. The recorded target must
    // still match the callee's owner: `Option::clone` records the bare
    // polymorphic `clone__Option_String_` shim, which is not a method
    // instance and must keep the identity fallback.
    let recorded_instance = ctx_resolved_calls::ctx_resolved_call_mono_instance_id(
        ctx,
        span_start,
        mir_bare_method_name(callee_name.clone())
    )
    if recorded_instance.len() > 0 {
        let recorded_target = mono::mono_safe_name(recorded_instance)
        if !recorded_target.clone().contains(String_from("?")) &&
        mono_target_matches_source(recorded_target.clone(), callee_name.clone()) &&
        ctx_has_fn_name(ctx, recorded_target.clone()) {
            return recorded_target
        }
    }
    let mono_target = ctx_mono_lookup_call(ctx, span_start, callee_name.clone())
    if mono_target.len() > 0 {
        return mono_target
    }
    if ctx_has_fn_name(ctx, callee_name.clone()) {
        return callee_name
    }
    // Parametric impl method call on a per-instantiation owner (ADR-078):
    // `self.iter.next()` inside `Twice<I>` at I=WrapIter<i32> arrives as
    // `WrapIter_i32::next`. The propagated instance `WrapIter::next`+[i32]
    // emits as `WrapIter__next__i32`; map the inst-owner spelling back.
    let parametric_target = mir_parametric_impl_callee(ctx, callee_name.clone())
    if parametric_target.len() > 0 {
        return parametric_target
    }
    // The name-rewrite pool is instantiation-blind (first unused match for
    // the bare method name), so it runs only after the precise
    // receiver-derived paths above.
    let named_mono_target = ctx_resolve_unused_mono_by_name(ctx, callee_name)
    if named_mono_target.len() > 0 {
        return named_mono_target
    }
    // Fallback for builtin types: if the mangled callee (e.g. "Vec::push")
    // is not a MIR function, check if the type prefix is a builtin type.
    // If so, map to the corresponding compiler intrinsic name.
    let bare_name = mir_bare_method_name(callee_name)
    if bare_name.len() > 0 && mir_is_builtin_type_prefix(callee_name) {
        let intrinsic_name = mir_builtin_method_to_intrinsic(callee_name, bare_name)
        if intrinsic_name.len() > 0 {
            return intrinsic_name
        }
        // Prefer Type::method when present. Falling back to a free function of
        // the same bare name recurses through ADR-046 wrappers (#807 popcount).
        if ctx_has_fn_name(ctx, callee_name.clone()) {
            return callee_name
        }
        return bare_name
    }
    let short_name = mir_resolve_short_method_name(ctx, callee_name.clone())
    if short_name.len() > 0 {
        return short_name
    }
    callee_name
}

fn mir_vec_method_prefer_coreop_name(mangled: String) -> String {
    if !mir_type_prefix(mangled.clone()).eq(String_from("Vec")) {
        return String_from("")
    }
    let bare_name = mir_bare_method_name(mangled.clone())
    if bare_name.clone().eq(String_from("push")) || bare_name.clone().starts_with(String_from("push__")) {
        return String_from("push")
    }
    if bare_name.clone().eq(String_from("len")) || bare_name.clone().starts_with(String_from("len__")) {
        return String_from("raw_array_len")
    }
    if bare_name.clone().eq(String_from("set")) || bare_name.clone().starts_with(String_from("set__")) {
        return String_from("raw_array_set_unchecked")
    }
    if bare_name.clone().eq(String_from("pop")) || bare_name.clone().starts_with(String_from("pop__")) {
        return String_from("vec_pop")
    }
    if bare_name.clone().eq(String_from("get")) || bare_name.clone().starts_with(String_from("get__")) {
        return String_from("vec_get")
    }
    if bare_name.clone().eq(String_from("get_unchecked")) || bare_name.clone().starts_with(String_from("get_unchecked__")) {
        // Bind the sealed raw accessor directly. The method receiver is always
        // a Vec, and the flat bootstrap overlay has no `Vec` element suffix to
        // retype a bare `get_unchecked` free; returning the raw name keeps the
        // element layout on the receiver local instead of losing it.
        return String_from("raw_array_get_unchecked")
    }
    if bare_name.clone().eq(String_from("is_empty")) || bare_name.clone().starts_with(String_from("is_empty__")) {
        return String_from("is_empty")
    }
    String_from("")
}

fn mir_builtin_method_to_intrinsic(mangled: String, bare_name: String) -> String {
    let prefix = mir_type_prefix(mangled)
    // Vec methods: some intrinsics use bare name, others use vec_ prefix.
    if prefix.clone().eq(String_from("Vec")) {
        let preferred = mir_vec_method_prefer_coreop_name(mangled.clone())
        if preferred.len() > 0 {
            return preferred
        }
        // Associated constructors: keep mangled Vec::new__T for wasm
        // is_vec_new_callee fallback (no MIR body; #845).
        if bare_name.clone().eq(String_from("new")) ||
        bare_name.clone().starts_with(String_from("new__")) ||
        bare_name.clone().eq(String_from("with_capacity")) ||
        bare_name.clone().starts_with(String_from("with_capacity__")) {
            return mangled
        }
        return String_from("")
    }
    // String methods: len, char_at, etc. use bare name — no mapping needed.
    // Scalar methods: map trait dispatch names to compare intrinsics so
    // prelude String `eq` is not used for i32/i64/f64/bool/char receivers.
    if bare_name.clone().eq(String_from("eq")) {
        if prefix.clone().eq(String_from("i32")) { return String_from("__intrinsic_i32_eq") }
        if prefix.clone().eq(String_from("i64")) { return String_from("__intrinsic_i64_eq") }
        if prefix.clone().eq(String_from("f64")) { return String_from("__intrinsic_f64_eq") }
        if prefix.clone().eq(String_from("bool")) { return String_from("__intrinsic_i32_eq") }
        if prefix.clone().eq(String_from("char")) { return String_from("__intrinsic_i32_eq") }
    }
    // Hash dispatch resolves through the registered `Type::hash` impl, which
    // shares the owner method namespace checked before this fallback. The
    // former `hash_i32` / `hash_string` / ... shims were removed per ADR-036,
    // so mapping to those names here would only produce a dangling callee.
    String_from("")
}

// Parametric impl method call on a per-instantiation owner (ADR-078).
// `self.iter.next()` inside `Twice<I>` at I=WrapIter<i32> reaches here as
// `WrapIter_i32::next`: the receiver's concrete instantiation supplies the
// impl self-type arguments, and the propagated instance
// `WrapIter::next`+[i32] emits as `WrapIter__next__i32`. Scan recorded
// instances for the method whose owner safe-name prefixes the
// per-instantiation owner and whose argument key matches the remainder.
fn mir_parametric_impl_callee(ctx: LowerCtx, callee_name: String) -> String {
    let owner = mir_type_prefix(callee_name.clone())
    let method = mir_bare_method_name(callee_name.clone())
    if owner.len() == 0 || method.len() == 0 {
        return String_new()
    }
    if !owner.clone().contains(String_from("_")) {
        return String_new()
    }
    let method_suffix = "::".concat(method.clone())
    let inst_count = ctx.mono_instances.len()
    let mut i = 0
    while i < inst_count {
        let inst = ctx.mono_instances.get_unchecked(i)
        let inst_fn = mono_instance_shape::mir_mono_instance_fn_name(inst)
        if inst_fn.clone().ends_with(method_suffix.clone()) {
            let inst_owner = inst_fn.clone().slice(0, inst_fn.len() - method_suffix.len())
            let owner_safe = mono::mono_safe_name(inst_owner)
            let recv_prefix = owner_safe.clone().concat(String_from("_"))
            if owner.clone().starts_with(recv_prefix.clone()) {
                let recv_args = owner.clone().slice(recv_prefix.len(), owner.len())
                let mangled_safe = mono::mono_safe_name(
                    mono_instance_shape::mir_mono_instance_mangled_name(inst)
                )
                let arg_prefix = owner_safe.clone().concat("__".concat(method.clone().concat("__")))
                if mangled_safe.clone().starts_with(arg_prefix.clone()) {
                    let inst_args = mangled_safe.clone().slice(arg_prefix.len(), mangled_safe.len())
                    if mir_mono_arg_segments_eq(recv_args.clone(), inst_args) &&
                    ctx_has_fn_name(ctx, mangled_safe.clone()) {
                        return mangled_safe
                    }
                }
            }
        }
        i = i + 1
    }
    String_new()
}

// Compare mono argument keys that use different separators. Per-
// instantiation owners join arguments with `_` (Pair_i32_String) while
// mangled instance names join with `__` (i32__String) and nested args
// keep a trailing `_` from `>`. Splitting on `_` and dropping empty
// segments normalizes both forms.
fn mir_mono_arg_segments_eq(recv_args: String, inst_args: String) -> bool {
    let recv_segs = mir_mono_arg_segments(recv_args)
    let inst_segs = mir_mono_arg_segments(inst_args)
    if recv_segs.len() != inst_segs.len() {
        return false
    }
    let mut i = 0
    while i < recv_segs.len() {
        if !recv_segs.get_unchecked(i).eq(inst_segs.get_unchecked(i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn mir_mono_arg_segments(args: String) -> Vec<String> {
    let mut segs = Vec::new<String>()
    let mut seg_start = 0
    let n = args.len()
    let mut i = 0
    while i <= n {
        if i == n || args.clone().byte_at(i) == 95 {
            let seg = args.clone().slice(seg_start, i)
            if seg.len() > 0 {
                segs.push(seg)
            }
            seg_start = i + 1
        }
        i = i + 1
    }
    segs
}

fn mir_bare_method_name(mangled: String) -> String {
    let pos = mangled.clone().index_of(String_from("::"))
    if pos < 0 {
        return String_from("")
    }
    mangled.slice(pos + 2, mangled.len())
}

// `with_capacity` takes a bucket count as its first argument, not a value
// whose type selects a specialization. The constructed type lives in the
// turbofish and is resolved by span-based mono lookup, so probing the count's
// i32 type would pin the i32 family of a generic container whenever both
// families are instantiated in the same module.
fn mir_method_is_capacity_constructor(name: String) -> bool {
    name.clone().ends_with(String_from("::with_capacity")) ||
    name.clone().ends_with(String_from("__with_capacity"))
}

fn mir_is_builtin_type_prefix(mangled: String) -> bool {
    let prefix = mir_type_prefix(mangled)
    if prefix.clone().eq(String_from("Vec")) { return true }
    if prefix.clone().eq(String_from("String")) { return true }
    if prefix.clone().eq(String_from("i32")) { return true }
    if prefix.clone().eq(String_from("i64")) { return true }
    if prefix.clone().eq(String_from("f64")) { return true }
    if prefix.clone().eq(String_from("f32")) { return true }
    if prefix.clone().eq(String_from("bool")) { return true }
    if prefix.clone().eq(String_from("char")) { return true }
    false
}

fn mir_type_prefix(mangled: String) -> String {
    let pos = mangled.clone().index_of(String_from("::"))
    if pos < 0 {
        return String_from("")
    }
    mangled.slice(0, pos)
}
