use mir::lower::ctx_api_nesting
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_types
use mir::inst_structured_control
use mir::inst_local_set
use mir::value_types

fn mir_begin_if_expr(ctx: LowerCtx) -> i32 {
    let result = ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_emit(ctx, inst_structured_control::MirInst_if())
    ctx_api_nesting::ctx_push_nesting(ctx)
    result
}

fn mir_store_if_branch_result(ctx: LowerCtx, result: i32, branch_result: i32) {
    if branch_result < 0 {
        return
    }
    let branch_vt = ctx_local_vt(ctx, branch_result)
    if branch_vt == value_types::VT_I64() || branch_vt == value_types::VT_F64() {
        ctx_set_local_vt(ctx, result, branch_vt)
    }
    if branch_vt == value_types::VT_GC_REF() || branch_vt == value_types::VT_REF() {
        ctx_set_local_vt(ctx, result, branch_vt)
        let branch_slot = ctx_api_local_types::ctx_get_local_variant_slot(ctx, branch_result)
        let branch_type = ctx_api_local_types::ctx_get_local_type(ctx, branch_result)
        let current_type = ctx_api_local_types::ctx_get_local_type(ctx, result)
        let branch_is_variant_struct = starts_with(clone(branch_type), "struct:") &&
        contains(clone(branch_type), "::")
        // A conditional that selects different enum variants needs the enum
        // base as its storage type.  Choosing the first variant here makes
        // the second branch's LOCAL_SET invalid on GC targets before the
        // common semantic type can be observed by the emitter.
        if branch_slot >= 0 || branch_is_variant_struct {
            ctx_api_local_types::ctx_set_local_variant_slot(ctx, result, 0 - 1)
            ctx_api_local_types::ctx_set_local_type(ctx, result, "enum:open")
        } else if len(current_type) == 0 && len(branch_type) > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, result, branch_type)
        } else if len(current_type) == 0 {
            // Enum variant constructors (Ok/Err/Some/None) can produce
            // GC_REF values with no semantic type name.  Keep their result
            // on the open enum base until a later consumer narrows it.
            ctx_api_local_types::ctx_set_local_type(ctx, result, "enum:open")
        }
    }
    ctx_emit(ctx, inst_local_set::MirInst_local_set_from(result, branch_result))
}

fn mir_emit_if_else(ctx: LowerCtx) {
    ctx_emit(ctx, inst_structured_control::MirInst_else())
}

fn mir_end_if_expr(ctx: LowerCtx, result: i32, then_result: i32, else_result: i32) -> i32 {
    ctx_emit(ctx, inst_structured_control::MirInst_end())
    ctx_api_nesting::ctx_pop_nesting(ctx)
    // Branch results are already stored into `result` via local_set.
    // Do not leave a local_get on the stack here: callers that need the
    // value (including MirInst_return_value) load the local themselves.
    // Emitting local_get + return_value caused "values remaining on stack"
    // on GC targets (#726 writer_write / io_*).
    if then_result >= 0 || else_result >= 0 {
        return result
    }
    0 - 1
}
