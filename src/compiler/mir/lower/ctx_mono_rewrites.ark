use collections::name_index
fn ctx_mono_span_rewrite_count(ctx: LowerCtx) -> i32 {
    ctx.mono_call_starts.len()
}

fn ctx_mono_span_rewrite_start_at(ctx: LowerCtx, index: i32) -> i32 {
    ctx.mono_call_starts.get_unchecked(index)
}

fn ctx_mono_span_rewrite_target_at(ctx: LowerCtx, index: i32) -> String {
    ctx.mono_call_span_targets.get_unchecked(index).clone()
}

fn ctx_mono_span_rewrite_source_at(ctx: LowerCtx, index: i32) -> String {
    ctx.mono_call_span_sources.get_unchecked(index).clone()
}

fn ctx_mono_mark_span_rewrite_used(mut ctx: LowerCtx, index: i32) {
    ctx.mono_call_span_used.set(index, 1)
}

fn ctx_mono_push_span_rewrite(
    mut ctx: LowerCtx,
    span_start: i32,
    decl_index: i32,
    body_child_index: i32,
    source: String,
    target: String
) {
    ctx.mono_call_starts.push(span_start)
    ctx.mono_call_span_sources.push(source)
    ctx.mono_call_span_targets.push(target)
    ctx.mono_call_span_used.push(0)
    ctx.mono_call_span_decls.push(decl_index)
    ctx.mono_call_span_children.push(body_child_index)
    ctx_mono_span_hash_insert(ctx, span_start)
}

// A span rewrite belongs to the body the typechecker recorded it in. The
// span is a byte offset inside one module's text, so equality of the span
// alone does not name one call site (#934).
fn ctx_mono_span_rewrite_is_in_body(ctx: LowerCtx, index: i32, decl_index: i32, body_child_index: i32) -> bool {
    ctx.mono_call_span_decls.get_unchecked(index) == decl_index &&
    ctx.mono_call_span_children.get_unchecked(index) == body_child_index
}

fn ctx_mono_span_hash_insert(mut ctx: LowerCtx, span_start: i32) {
    if ctx.mono_span_buckets.len() == 0 {
        let mut i = 0
        while i < 1024 {
            ctx.mono_span_buckets.push(0)
            i = i + 1
        }
    }
    let capacity = ctx.mono_span_buckets.len()
    let mut slot = span_start
    if slot < 0 {
        slot = 0
    }
    slot = slot % capacity
    let head = ctx.mono_span_buckets.get_unchecked(slot)
    ctx.mono_span_next.push(head)
    ctx.mono_span_buckets.set(slot, ctx.mono_call_starts.len())
}

fn ctx_mono_span_hash_head(ctx: LowerCtx, span_start: i32) -> i32 {
    let capacity = ctx.mono_span_buckets.len()
    if capacity <= 0 {
        return 0
    }
    let mut slot = span_start
    if slot < 0 {
        slot = 0
    }
    ctx.mono_span_buckets.get_unchecked(slot % capacity)
}

fn ctx_mono_name_rewrite_count(ctx: LowerCtx) -> i32 {
    ctx.mono_call_sources.len()
}

fn ctx_mono_name_rewrite_source_at(ctx: LowerCtx, index: i32) -> String {
    ctx.mono_call_sources.get_unchecked(index).clone()
}

fn ctx_mono_name_rewrite_target_at(ctx: LowerCtx, index: i32) -> String {
    ctx.mono_call_name_targets.get_unchecked(index).clone()
}

fn ctx_mono_name_rewrite_used_at(ctx: LowerCtx, index: i32) -> i32 {
    ctx.mono_call_used.get_unchecked(index)
}

fn ctx_mono_mark_name_rewrite_used(mut ctx: LowerCtx, index: i32) {
    ctx.mono_call_used.set(index, 1)
}

fn ctx_mono_push_name_rewrite(
    mut ctx: LowerCtx,
    decl_index: i32,
    body_child_index: i32,
    source: String,
    target: String
) {
    let index = ctx.mono_call_sources.len()
    let bare = mono_bare_source(source.clone())
    ctx.mono_call_sources.push(source)
    ctx.mono_call_name_targets.push(target)
    ctx.mono_call_used.push(0)
    ctx.mono_call_name_decls.push(decl_index)
    ctx.mono_call_name_children.push(body_child_index)
    ctx.mono_call_bare_next.push(0 - 1)
    let tail = name_index::name_index_get(ctx.mono_call_bare_tail, bare.clone())
    if tail < 0 {
        name_index::name_index_set(ctx.mono_call_bare_head, bare.clone(), index)
    } else {
        ctx.mono_call_bare_next.set(tail, index)
    }
    name_index::name_index_set(ctx.mono_call_bare_tail, bare, index)
}

// A name rewrite belongs to the body that minted the instance. The bare
// source (`pick` for `alpha::pick`) is shared by every module declaring that
// name, so without the body identity a lookup can pick another declaration's
// specialization of a different type (#934).
fn ctx_mono_name_rewrite_is_in_body(ctx: LowerCtx, index: i32, decl_index: i32, body_child_index: i32) -> bool {
    ctx.mono_call_name_decls.get_unchecked(index) == decl_index &&
    ctx.mono_call_name_children.get_unchecked(index) == body_child_index
}

// First rewrite index whose source has the same bare name as `source`, or -1.
fn ctx_mono_name_rewrite_first_for_source(ctx: LowerCtx, source: String) -> i32 {
    name_index::name_index_get(ctx.mono_call_bare_head, mono_bare_source(source))
}

// Next rewrite index with the same bare source after `index`, or -1.
fn ctx_mono_name_rewrite_next_same_source(ctx: LowerCtx, index: i32) -> i32 {
    ctx.mono_call_bare_next.get_unchecked(index)
}

// Text after the last `:`; `mod:fn` and `fn` name the same mono source.
fn mono_bare_source(source: String) -> String {
    let source_len = source.len()
    let mut index = source_len - 1
    while index >= 0 {
        if source.byte_at(index) == 58 {
            return source.slice(index + 1, source_len)
        }
        index = index - 1
    }
    source
}
