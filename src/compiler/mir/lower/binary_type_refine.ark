use mir::lower::ctx_api_local_types
use mir::lower::ctx_types
use mir::value_types

fn is_ref_binop_vt(vt: i32) -> bool {
    vt == value_types::VT_REF() || vt == value_types::VT_GC_REF()
}

// A call result is only typed after it is lowered, so the peeked vt that
// seeds mir_initial_binop_vt is i32 for an inline call. Promote from the
// lowered operand's local so `v.get_unchecked(i) == v.get_unchecked(j)` on
// Vec<String> takes the ref (string-intrinsic) path instead of i32.eq.
fn mir_refine_binop_vt_from_local(ctx: LowerCtx, current_vt: i32, local_idx: i32) -> i32 {
    if ctx_local_vt(ctx, local_idx) == value_types::VT_F64() {
        return value_types::VT_F64()
    }
    if ctx_local_vt(ctx, local_idx) == value_types::VT_F32() {
        return value_types::VT_F32()
    }
    if ctx_local_vt(ctx, local_idx) == value_types::VT_I64() {
        return value_types::VT_I64()
    }
    if is_ref_binop_vt(ctx_local_vt(ctx, local_idx)) {
        return value_types::VT_GC_REF()
    }
    current_vt
}

fn mir_refine_binop_vt_from_left(ctx: LowerCtx, current_vt: i32, left_idx: i32, right_peek_vt: i32) -> i32 {
    if ctx_local_vt(ctx, left_idx) == value_types::VT_F64() || right_peek_vt == value_types::VT_F64() {
        return value_types::VT_F64()
    }
    if ctx_local_vt(ctx, left_idx) == value_types::VT_F32() || right_peek_vt == value_types::VT_F32() {
        return value_types::VT_F32()
    }
    if ctx_local_vt(ctx, left_idx) == value_types::VT_I64() || right_peek_vt == value_types::VT_I64() {
        return value_types::VT_I64()
    }
    if is_ref_binop_vt(ctx_local_vt(ctx, left_idx)) || is_ref_binop_vt(right_peek_vt) {
        return value_types::VT_GC_REF()
    }
    current_vt
}
