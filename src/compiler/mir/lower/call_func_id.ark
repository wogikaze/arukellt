use corehir::callee_spelling
use corehir::function_id
use corehir::signature_registry
use corehir::core_op_binding
use corehir::core_op_id
use corehir::signature_entry
use mir::inst_draft
use mir::opcodes
use mir::lower::ctx_current_storage
use mir::module_spine
fn mir_inst_attach_func_id_for_symbol(ctx: LowerCtx, mut inst: MirInstDraft, symbol: String) -> MirInstDraft {
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    if !module_spine::MirModule_signature_spine_populated(m) {
        return inst
    }
    let mut registry = module_spine::MirModule_signature_registry(m)
    let mut canonical_symbol = symbol.clone()
    let mut fid = signature_registry::signature_registry_lookup_by_mangled(registry, symbol.clone())
    // Loaded-module bodies keep `module::Type::method` because the resolver
    // only rewrites the entry module. The registry holds the impl under
    // `Type::method`, so retry the canonical spellings before giving up;
    // the call keeps the matching name for emit-side fallbacks.
    if !function_id::function_id_is_valid(fid) {
        let variants = callee_spelling::callee_spelling_variants(symbol.clone())
        let mut vi = 0
        while vi < len(variants) {
            let variant = get_unchecked(variants, vi).clone()
            let variant_fid = signature_registry::signature_registry_lookup_by_mangled(
                registry,
                variant.clone()
            )
            if function_id::function_id_is_valid(variant_fid) {
                fid = variant_fid
                canonical_symbol = signature_registry::signature_registry_mangled_at(
                    registry,
                    function_id::FunctionId_raw(variant_fid)
                )
                vi = len(variants)
            } else {
                vi = vi + 1
            }
        }
    }
    let exact_coid = core_op_binding::core_op_binding_lookup_for_callee(symbol.clone())
    if function_id::function_id_is_valid(fid) && is_seq_extremum_alias(symbol.clone()) {
        let entry = signature_registry::signature_registry_lookup_by_id(registry, fid)
        let entry_coid = signature_entry::signature_entry_core_op_id(entry)
        if !core_op_id::core_op_id_is_some(entry_coid) ||
        core_op_id::CoreOpId_raw(entry_coid) != core_op_id::CoreOpId_raw(exact_coid) {
            fid = signature_registry::signature_registry_register_core_op_alias(
                registry,
                symbol.clone(),
                exact_coid
            )
        }
    }
    if !function_id::function_id_is_valid(fid) {
        // Exact SignatureRegistry miss → exact CoreOp alias.
        // Do not use short-name / param-count FunctionId search.
        if core_op_id::core_op_id_is_some(exact_coid) {
            fid = signature_registry::signature_registry_register_core_op_alias(
                registry,
                symbol.clone(),
                exact_coid
            )
        }
    }
    if function_id::function_id_is_valid(fid) {
        return inst_draft::MirInstDraft_with_call_target(
            inst,
            canonical_symbol,
            function_id::FunctionId_raw(fid)
        )
    }
    inst
}

fn is_seq_extremum_alias(symbol: String) -> bool {
    symbol.clone().eq(String_from("seq::min_i32")) ||
    symbol.clone().eq(String_from("seq::max_i32"))
}

fn mir_inst_attach_func_id_if_call(ctx: LowerCtx, mut inst: MirInstDraft) -> MirInstDraft {
    let op = inst_draft::MirInstDraft_op(inst)
    if op != opcodes::MIR_CALL() && op != opcodes::MIR_REF_FUNC() {
        return inst
    }
    mir_inst_attach_func_id_for_symbol(ctx, inst, inst_draft::MirInstDraft_str_val(inst))
}
