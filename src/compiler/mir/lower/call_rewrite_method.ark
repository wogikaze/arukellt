//
// Direct calls like `to_string(t)` or `eq(a, b)` must resolve to the
// monomorphized impl method (e.g. "Token::to_string", "Point::eq") when the
// receiver type is a user-defined struct carried via enum:/struct: local types.

use mir::lower::ctx_fn_exists
use mir::lower::ctx_api_local_types
use mir::lower::method_resolve

fn mir_bare_receiver_type_name(arg_type: String) -> String {
    if len(arg_type) == 0 {
        return String_new()
    }
    if starts_with(clone(arg_type), "struct:") {
        let rest = substring(clone(arg_type), 7, len(arg_type))
        let n = len(rest)
        let mut i = 0
        while i < n {
            if byte_at(rest, i) == 58 {
                return substring(rest, 0, i)
            }
            i = i + 1
        }
        return rest
    }
    if starts_with(clone(arg_type), "enum:") {
        return substring(clone(arg_type), 5, len(arg_type))
    }
    // Vec locals are typed "vec:i32" / "vec:String"; impl methods are
    // mangled as "Vec::read" / "Vec::seek", not "i32::seek" (#726 seek_to).
    if starts_with(clone(arg_type), "vec:") {
        return "Vec"
    }
    if eq(clone(arg_type), "Vec") {
        return "Vec"
    }
    if starts_with(clone(arg_type), "hashmap:") {
        return "HashMap"
    }
    if eq(clone(arg_type), "HashMap") {
        return "HashMap"
    }
    if starts_with(clone(arg_type), "option:") {
        return substring(clone(arg_type), 7, len(arg_type))
    }
    if starts_with(clone(arg_type), "Option_") {
        return substring(clone(arg_type), 7, len(arg_type))
    }
    arg_type
}

fn mir_try_resolve_impl_method(ctx: LowerCtx, bare_method: String, first_arg_idx: i32) -> String {
    if first_arg_idx < 0 {
        return bare_method
    }
    let arg_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
    let mut bare_type = mir_bare_receiver_type_name(clone(arg_type))
    if method_resolve::mir_is_vec_string_iteration_method(clone(bare_method)) &&
    method_resolve::mir_is_vec_string_type(clone(arg_type)) {
        bare_type = String_from("Vec_String")
    }
    if len(bare_type) == 0 {
        return bare_method
    }
    let mangled = concat(clone(bare_type), concat("::", clone(bare_method)))
    if ctx_fn_exists::ctx_has_fn_name(ctx, clone(mangled)) {
        return mangled
    }
    bare_method
}

// Associated conversion functions keep the source-level `Type::method`
// spelling, but concrete impl bodies include the source type in their static
// symbol. Select that symbol from the first argument when it exists; leaving
// the original name intact preserves ordinary associated functions.
fn mir_try_resolve_associated_function(ctx: LowerCtx, associated_name: String, first_arg_idx: i32) -> String {
    if first_arg_idx < 0 || !contains(clone(associated_name), String_from("::")) {
        return associated_name
    }
    let arg_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
    let source_name = mir_bare_receiver_type_name(clone(arg_type))
    if len(source_name) == 0 {
        return associated_name
    }
    let mut owner_name = mir_type_prefix(clone(associated_name))
    if eq(clone(associated_name), String_from("Vec::from_iter")) &&
    eq(clone(source_name), String_from("StringIter")) {
        owner_name = String_from("Vec_String")
    }
    let method_name = mir_bare_method_name(clone(associated_name))
    let candidate = concat(
        concat(owner_name, concat("::", method_name)),
        concat("__", clone(source_name))
    )
    if ctx_fn_exists::ctx_has_fn_name(ctx, clone(candidate)) {
        return candidate
    }
    associated_name
}
