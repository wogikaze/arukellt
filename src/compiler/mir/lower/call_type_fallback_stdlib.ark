use std::prelude::{byte_at, clone, contains, ends_with, eq, starts_with, substring}
use mir::lower::ctx_api_local_types
use mir::lower::ctx_gc_enum
use mir::value_types
fn set_stdlib_result_type(mut ctx: LowerCtx, dest: i32, type_name: String) {
    ctx_api_local_types::ctx_set_local_type(ctx, dest, type_name)
    if ctx_gc_enum::ctx_is_gc_target(ctx) {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_GC_REF())
    } else {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_REF())
    }
}

fn mark_known_stdlib_result_type(mut ctx: LowerCtx, callee_name: String, dest: i32) -> bool {
    let cn = mir_strip_module_prefix(clone(callee_name))
    if eq(clone(cn), "cmp") || ends_with(clone(cn), String_from("::cmp")) || starts_with(clone(cn), String_from("cmp__")) || contains(clone(cn), String_from("::cmp__")) {
        set_stdlib_result_type(ctx, dest, String_from("enum:Ordering"))
        return true
    }
    if eq(clone(cn), "find_i64") {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, String_from("Option_i64"))
        return true
    }
    if eq(clone(cn), "find_f64") {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, String_from("Option_f64"))
        return true
    }
    if eq(clone(cn), "find_String") {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, String_from("Option_String"))
        return true
    }
    if eq(clone(cn), "find_i32") {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, String_from("Option_i32"))
        return true
    }
    if eq(clone(cn), "read_to_string") || eq(clone(cn), "fs_read_file") || eq(clone(cn), "__runtime_abi_fs_read_file") || ends_with(clone(callee_name), String_from("::read_to_string")) {
        set_stdlib_result_type(ctx, dest, String_from("result:String:String"))
        return true
    }
    // Fs::read_bytes returns Result<Vec<i32>, String>; keep the Vec payload so
    // an unannotated match in user code resolves the byte vector.
    if ends_with(clone(callee_name), String_from("Fs::read_bytes")) {
        set_stdlib_result_type(ctx, dest, String_from("result:vec:i32:String"))
        return true
    }
    if is_host_fs_write_string_callee(clone(callee_name)) ||
    eq(clone(cn), "fs_write_file") ||
    eq(clone(cn), "__runtime_abi_fs_write_file") {
        set_stdlib_result_type(ctx, dest, String_from("result:unit:String"))
        return true
    }
    // Host fs write_bytes is the only Result-returning write_bytes; the
    // std::io memory-buffer helper was retired in ADR-085 Phase F (#807).
    if eq(clone(cn), "fs_write_bytes") ||
    eq(clone(cn), "__runtime_abi_fs_write_bytes") ||
    ends_with(clone(callee_name), String_from("Fs::write_bytes")) {
        // Without this, Result dest locals stay Memory64 i64 and ref.null/Ok
        // from the GC intrinsic fails validate (#730 write_compile_output).
        set_stdlib_result_type(ctx, dest, String_from("result:unit:String"))
        return true
    }
    // Host env intrinsics return managed refs. A namespace method has no
    // registered free-call spine entry, so the call result needs the same
    // explicit typing the fs file intrinsics get above; without it the MIR
    // temp stays scalar and the emitter stores a Vec/Option ref into an i64
    // local (invalid core Wasm on wasm32-gc) (#917).
    if eq(clone(cn), "__intrinsic_args") || ends_with(clone(callee_name), String_from("::__intrinsic_args")) {
        set_stdlib_result_type(ctx, dest, String_from("vec:String"))
        return true
    }
    if eq(clone(cn), "__runtime_abi_env_var") || ends_with(clone(callee_name), String_from("::__runtime_abi_env_var")) {
        set_stdlib_result_type(ctx, dest, String_from("Option_String"))
        return true
    }
    if eq(clone(cn), "__intrinsic_arg_at") || ends_with(clone(callee_name), String_from("::__intrinsic_arg_at")) {
        set_stdlib_result_type(ctx, dest, String_from("Option_String"))
        return true
    }
    if is_parse_callee(clone(callee_name), String_from("parse_i32")) {
        set_stdlib_result_type(ctx, dest, String_from("result:i32:String"))
        return true
    }
    if is_parse_callee(clone(callee_name), String_from("parse_i64")) {
        set_stdlib_result_type(ctx, dest, String_from("result:i64:String"))
        return true
    }
    if is_parse_callee(clone(callee_name), String_from("parse_f64")) {
        set_stdlib_result_type(ctx, dest, String_from("result:f64:String"))
        return true
    }
    false
}

// Only the text parsers return Result. JsonValue::parse_i32 is an unrelated
// i32 reader with the same leaf name, so do not match every `::parse_i32`.
fn is_parse_callee(callee_name: String, leaf: String) -> bool {
    if eq(clone(callee_name), clone(leaf)) {
        return true
    }
    if eq(clone(callee_name), String_from("raw_").concat(clone(leaf))) {
        return true
    }
    if eq(clone(callee_name), String_from("__intrinsic_").concat(clone(leaf))) {
        return true
    }
    if eq(clone(callee_name), String_from("RawString::").concat(clone(leaf))) {
        return true
    }
    if ends_with(clone(callee_name), String_from("::raw_").concat(clone(leaf))) {
        return true
    }
    if ends_with(clone(callee_name), String_from("::__intrinsic_").concat(clone(leaf))) {
        return true
    }
    starts_with(
        clone(callee_name),
        String_from("RawString__").concat(clone(leaf)).concat(String_from("__"))
    )
}

fn is_host_fs_write_string_callee(callee_name: String) -> bool {
    ends_with(clone(callee_name), String_from("Fs::write_string"))
}

fn mark_toml_result_vec_call_type(mut ctx: LowerCtx, callee_name: String, dest: i32) -> bool {
    let cn = mir_strip_module_prefix(clone(callee_name))
    if eq(clone(cn), "toml_navigate_table_count") || eq(clone(cn), "toml_navigate_table") || eq(clone(cn), "toml_append_array_table") {
        set_stdlib_result_type(ctx, dest, String_from("result:vec:TomlField:String"))
        return true
    }
    if eq(clone(cn), "toml_insert_key") {
        set_stdlib_result_type(ctx, dest, String_from("result:unit:String"))
        return true
    }
    // Option accessors — fixtures match with Result::Ok/Err; keep Vec elem types (#726 dotted).
    if eq(clone(cn), "toml_as_array") {
        set_stdlib_result_type(ctx, dest, String_from("option:vec:TomlValue"))
        return true
    }
    if eq(clone(cn), "toml_as_table") {
        set_stdlib_result_type(ctx, dest, String_from("option:vec:TomlField"))
        return true
    }
    if eq(clone(cn), "toml_get") {
        set_stdlib_result_type(ctx, dest, String_from("option:TomlValue"))
        return true
    }
    false
}

fn mir_strip_module_prefix(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if byte_at(name, i) == 58 {
            return substring(name, i + 1, n)
        }
        i = i - 1
    }
    clone(name)
}
