use std::text
use mir::lower::ctx_gc_enum_sig
use mir::lower::ctx_gc_canon
use mir::lower::ctx_struct_field_type
use mir::gc_layout_slot_bind
use mir::module_gc_order
use mir::module_gc_enum
use wasm::emit_target
fn ctx_is_gc_target(ctx: LowerCtx) -> bool {
    emit_target::is_gc_target(ctx.lower_target.clone())
}

fn ctx_register_gc_enum_variant(mut ctx: LowerCtx, variant_name: String, sig: String) -> i32 {
    let canon = ctx_gc_enum_normalize_variant_name(variant_name.clone())
    let count = ctx.gc_enum_variant_sigs.len()
    let mut i = 0
    while i < count {
        if ctx.gc_enum_variant_sigs.get_unchecked(i).eq(sig.clone()) {
            let existing = ctx.gc_enum_variant_names.get_unchecked(i).clone()
            let existing_canon = ctx_gc_enum_normalize_variant_name(existing.clone())
            if existing_canon.eq(canon.clone()) || existing.eq(variant_name.clone()) {
                ctx.gc_enum_variant_alias_names.push(variant_name)
                ctx.gc_enum_variant_alias_slots.push(i)
                return i
            }
        }
        i = i + 1
    }
    ctx.gc_enum_variant_names.push(variant_name)
    ctx.gc_enum_variant_sigs.push(sig)
    // Post-seal registration is "late": record it so the type section emits
    // it after the sealed types in registration order. Packed as
    // slot*2+1 (kind 1 = enum variant). #851 Phase 3.
    if ctx.gc_seal_done {
        module_gc_order::MirModule_push_late_gc_order(
            ctx.module,
            (ctx.gc_enum_variant_names.len() - 1) * 2 + 1
        )
        // Materialize immediately so body emit can read the module slot and
        // canon index without waiting for the post-loop flush. Enum sigs are
        // final at registration (no placeholder pass like gc structs), and
        // ensuring here keeps canon order identical to the late_gc_order
        // sweep ctx_gc_canon_ensure_late performs.
        let mut m = ctx.module
        let slot = ctx.gc_enum_variant_names.len() - 1
        module_gc_enum::MirModule_push_gc_enum_variant(
            m,
            variant_name.clone(),
            sig.clone()
        )
        let canon = ctx_gc_canon::ctx_gc_canon_ensure_sig(ctx, sig.clone())
        module_gc_enum::MirModule_set_gc_enum_variant_canon_idx(m, slot, canon)
        gc_layout_slot_bind::mir_gc_layout_bind_enum_variant_slot(m, slot)
    }
    ctx.gc_enum_variant_names.len() - 1
}

fn ctx_gc_enum_lookup_slot(ctx: LowerCtx, variant_name: String) -> i32 {
    let count = ctx.gc_enum_variant_names.len()
    let mut i = 0
    while i < count {
        if ctx.gc_enum_variant_names.get_unchecked(i).eq(variant_name.clone()) {
            return i
        }
        i = i + 1
    }
    let alias_count = ctx.gc_enum_variant_alias_names.len()
    let mut ai = 0
    while ai < alias_count {
        if ctx.gc_enum_variant_alias_names.get_unchecked(ai).eq(variant_name.clone()) {
            return ctx.gc_enum_variant_alias_slots.get_unchecked(ai)
        }
        ai = ai + 1
    }
    0 - 1
}

fn ctx_gc_enum_normalize_variant_name(variant_name: String) -> String {
    if variant_name.clone().eq("Some") {
        return "Option::Some"
    }
    if variant_name.clone().eq("None") {
        return "Option::None"
    }
    if variant_name.clone().eq("Ok") {
        return "Result::Ok"
    }
    if variant_name.clone().eq("Err") {
        return "Result::Err"
    }
    variant_name
}

// Bare variant leaf after the last `::` (TomlValue::Table → Table).
// Option/Result keep their qualified normalize form for disambiguation.
fn ctx_gc_enum_bare_variant_name(variant_name: String) -> String {
    let normalized = ctx_gc_enum_normalize_variant_name(variant_name.clone())
    if normalized.clone().starts_with("Option::") || normalized.clone().starts_with("Result::") {
        return normalized
    }
    if !normalized.clone().contains("::") {
        return normalized
    }
    let n = normalized.len()
    let mut i = n - 1
    while i >= 0 {
        if normalized.clone().byte_at(i) == 58 {
            return normalized.clone().slice(i + 1, n)
        }
        i = i - 1
    }
    normalized
}

// A constructed enum variant is a subtype of its enum base. Preserve that
// semantic type on the result local so a later aggregate can choose the enum
// reference field instead of treating the value as a String reference.
fn ctx_gc_enum_type_name_from_variant(variant_name: String) -> String {
    let normalized = ctx_gc_enum_normalize_variant_name(variant_name.clone())
    let n = normalized.len()
    let mut last_sep = 0 - 1
    let mut prev_sep = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if normalized.byte_at(i) == 58 && normalized.byte_at(i + 1) == 58 {
            prev_sep = last_sep
            last_sep = i
            i = i + 2
            continue
        }
        i = i + 1
    }
    if last_sep < 0 {
        return String_new()
    }
    if prev_sep < 0 {
        return normalized.slice(0, last_sep)
    }
    normalized.slice(prev_sep + 2, last_sep)
}

fn ctx_gc_enum_variant_names_match(a: String, b: String) -> bool {
    if a.clone().eq(b.clone()) {
        return true
    }
    let a_norm = ctx_gc_enum_normalize_variant_name(a.clone())
    let b_norm = ctx_gc_enum_normalize_variant_name(b.clone())
    if a_norm.clone().eq(b_norm.clone()) {
        return true
    }
    ctx_gc_enum_bare_variant_name(a_norm.clone()).eq(ctx_gc_enum_bare_variant_name(b_norm.clone()))
}

fn ctx_gc_enum_variant_slot(ctx: LowerCtx, variant_name: String) -> i32 {
    let normalized = ctx_gc_enum_normalize_variant_name(variant_name.clone())
    let found = ctx_gc_enum_lookup_slot(ctx, normalized.clone())
    if found >= 0 {
        return found
    }
    let direct = ctx_gc_enum_lookup_slot(ctx, variant_name.clone())
    if direct >= 0 {
        return direct
    }
    // Bare `Table` must resolve to `TomlValue::Table` when unique (#726).
    let bare = ctx_gc_enum_bare_variant_name(normalized.clone())
    let suffix = "::".concat(bare.clone())
    let count = ctx.gc_enum_variant_names.len()
    let mut i = 0
    let mut hit = 0 - 1
    let mut hits = 0
    while i < count {
        let nm = ctx.gc_enum_variant_names.get_unchecked(i).clone()
        if nm.clone().eq(bare.clone()) || nm.clone().ends_with(suffix.clone()) {
            hit = i
            hits = hits + 1
        }
        i = i + 1
    }
    if hits == 1 {
        return hit
    }
    0 - 1
}

fn ctx_gc_enum_variant_slot_for_payload(mut ctx: LowerCtx, variant_name: String, payload_vts: Vec<i32>) -> i32 {
    let normalized = ctx_gc_enum_normalize_variant_name(variant_name.clone())
    let field_sigs = ctx_gc_enum_sig::ctx_gc_enum_payload_field_sigs_from_vts(ctx, payload_vts)
    let want_sig = ctx_gc_enum_sig::gc_enum_payload_variant_sig(0, field_sigs)
    let count = ctx.gc_enum_variant_sigs.len()
    let mut i = 0
    while i < count {
        if ctx.gc_enum_variant_sigs.get_unchecked(i).eq(want_sig.clone()) {
            let name_canon = ctx_gc_enum_normalize_variant_name(ctx.gc_enum_variant_names.get_unchecked(i).clone())
            if name_canon.eq(normalized) {
                return i
            }
        }
        i = i + 1
    }
    0 - 1
}

fn gc_enum_variant_is_vec_container(normalized: String) -> bool {
    let bare = ctx_gc_enum_bare_variant_name(normalized.clone())
    bare.clone().eq("Array") || bare.clone().eq("Table") || bare.clone().eq("Object")
}

fn ctx_gc_enum_variant_count(ctx: LowerCtx) -> i32 {
    ctx.gc_enum_variant_names.len()
}

fn ctx_flush_gc_enum_variants(mut ctx: LowerCtx) {
    ctx_flush_gc_enum_variants_from(ctx, 0)
}

fn ctx_flush_gc_enum_variants_from(mut ctx: LowerCtx, start: i32) {
    let mut m = ctx.module
    let count = ctx.gc_enum_variant_names.len()
    let mut i = if start < 0 { 0 } else { start }
    // Post-seal entries are materialized at registration; resume after them.
    let materialized = module_gc_enum::MirModule_gc_enum_variant_sig_count(m)
    if i < materialized {
        i = materialized
    }
    while i < count {
        let sig = ctx.gc_enum_variant_sigs.get_unchecked(i).clone()
        module_gc_enum::MirModule_push_gc_enum_variant(m, ctx.gc_enum_variant_names.get_unchecked(i).clone(), sig.clone())
        if !ctx.gc_seal_done {
            let canon = ctx_gc_canon::ctx_gc_canon_ensure_sig(ctx, sig)
            module_gc_enum::MirModule_set_gc_enum_variant_canon_idx(m, i, canon)
        }
        i = i + 1
    }
}
