use std::prelude::{eq}
use corehir::callee_spelling
use mir::lower::ctx_fn_index
use mir::lower::ctx_fn_return_type
use mir::lower::ctx_fn_return_vt_simd
use mir::lower::ctx_gc_enum
use mir::lower::mono_return_vt
use mir::value_types
fn ctx_fn_return_vt(ctx: LowerCtx, name: String) -> i32 {
    // Host clock APIs are always i64. Prefer this over fn_index: a wrong i32
    // dest makes binary `/ 1000000i64` insert extend_i32_s on a real i64 load.
    if ctx_is_i64_clock_callee(name.clone()) {
        return value_types::VT_I64()
    }
    // SIMD intrinsic declarations can be shadowed in the flat fn_index by
    // short names with a scalar placeholder return type. The intrinsic name
    // is the authoritative ABI here, so resolve v128 before consulting that
    // index.
    let bare_simd_name = ctx_bare_builtin_name(name.clone())
    if ctx_fn_return_vt_simd::ctx_is_v128_returning_simd_intrinsic(bare_simd_name.clone()) {
        return value_types::VT_V128()
    }
    if ctx_fn_return_vt_simd::ctx_is_v128_returning_wasm_intrinsic(bare_simd_name.clone()) {
        return value_types::VT_V128()
    }
    if ctx_fn_return_vt_simd::ctx_is_f32_returning_simd_intrinsic(bare_simd_name.clone()) {
        return value_types::VT_F32()
    }
    if ctx_fn_return_vt_simd::ctx_is_f64_returning_simd_intrinsic(bare_simd_name.clone()) {
        return value_types::VT_F64()
    }
    if ctx_fn_return_vt_simd::ctx_is_i64_returning_simd_intrinsic(bare_simd_name.clone()) {
        return value_types::VT_I64()
    }
    let found = ctx_fn_index::ctx_fn_index_find(ctx, name.clone())
    if found >= 0 {
        let rvt = ctx_fn_index::ctx_fn_index_return_vt_at(ctx, found)
        let resolved = mono_return_vt::mono_return_vt(ctx, name.clone(), rvt)
        if resolved == value_types::VT_GC_REF() ||
        resolved == value_types::VT_REF() ||
        resolved == value_types::VT_I32() ||
        resolved == value_types::VT_I64() ||
        resolved == value_types::VT_F64() ||
        resolved == value_types::VT_F32() ||
        resolved == value_types::VT_V128() ||
        resolved == value_types::VT_FUNCREF() {
            if resolved == value_types::VT_REF() && ctx_gc_enum::ctx_is_gc_target(ctx) {
                return value_types::VT_GC_REF()
            }
            return resolved
        }
        if rvt == value_types::VT_REF() && ctx_gc_enum::ctx_is_gc_target(ctx) {
            return value_types::VT_GC_REF()
        }
        return rvt
    }
    let qualified = ctx_fn_index::ctx_qualified_fn_index_find(ctx, name.clone())
    if qualified >= 0 {
        let qualified_vt = get_unchecked(ctx.qualified_fn_return_vts, qualified)
        if qualified_vt == value_types::VT_REF() && ctx_gc_enum::ctx_is_gc_target(ctx) {
            return value_types::VT_GC_REF()
        }
        return qualified_vt
    }
    // Loaded-module calls keep `module::Type::method`; resolve the registered
    // `Type::method` spelling before the last-segment fallback.
    let variants = callee_spelling::callee_spelling_variants(name.clone())
    let mut vi = 0
    while vi < len(variants) {
        let variant = get_unchecked(variants, vi).clone()
        let variant_found = ctx_fn_index::ctx_fn_index_find(ctx, variant.clone())
        if variant_found >= 0 {
            let variant_vt = ctx_fn_index::ctx_fn_index_return_vt_at(ctx, variant_found)
            if variant_vt == value_types::VT_REF() && ctx_gc_enum::ctx_is_gc_target(ctx) {
                return value_types::VT_GC_REF()
            }
            return variant_vt
        }
        vi = vi + 1
    }
    let nlen = len(name)
    let mut colon_pos = 0 - 1
    let mut ci = nlen - 1
    while ci >= 0 {
        if name.byte_at(ci) == 58 {
            colon_pos = ci
            ci = 0 - 1
        }
        ci = ci - 1
    }
    if colon_pos >= 0 {
        let short = name.slice(colon_pos + 1, nlen)
        let short_found = ctx_fn_index::ctx_fn_index_find(ctx, short)
        if short_found >= 0 {
            return ctx_fn_index::ctx_fn_index_return_vt_at(ctx, short_found)
        }
    }
    // Same as ctx_fn_return_type_name: module__FnName export mangling.
    let dunder_short = ctx_fn_return_type::short_name_after_last_dunder(name.clone())
    if len(dunder_short) > 0 {
        let dunder_found = ctx_fn_index::ctx_fn_index_find(ctx, dunder_short.clone())
        if dunder_found >= 0 {
            let dunder_vt = ctx_fn_index::ctx_fn_index_return_vt_at(ctx, dunder_found)
            return mono_return_vt::mono_return_vt(ctx, name.clone(), dunder_vt)
        }
    }
    let bare_name = ctx_bare_builtin_name(name)
    let bare_found = ctx_fn_index::ctx_fn_index_find(ctx, bare_name.clone())
    if bare_found >= 0 {
        return ctx_fn_index::ctx_fn_index_return_vt_at(ctx, bare_found)
    }
    ctx_fn_return_vt_builtin(ctx, bare_name)
}

fn ctx_fn_return_vt_builtin(ctx: LowerCtx, bare_name: String) -> i32 {
    if is_void_returning_builtin(bare_name.clone()) {
        return value_types::VT_VOID()
    }
    if eq(bare_name.clone(), "to_string") ||
    eq(bare_name.clone(), "i32_to_string") ||
    eq(bare_name.clone(), "i64_to_string") ||
    eq(bare_name.clone(), "f64_to_string") ||
    eq(bare_name.clone(), "bool_to_string") ||
    eq(bare_name.clone(), "char_to_string") ||
    eq(bare_name.clone(), "f32_to_string") {
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            return value_types::VT_GC_REF()
        }
        return value_types::VT_REF()
    }
    if bare_name.clone().ends_with("::to_string") {
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            return value_types::VT_GC_REF()
        }
        return value_types::VT_REF()
    }
    if eq(bare_name.clone(), "i32_to_i64") || eq(bare_name.clone(), "u32_to_u64") {
        return value_types::VT_I64()
    }
    if eq(bare_name.clone(), "clock_now") ||
    eq(bare_name.clone(), "clock_now_ms") ||
    eq(bare_name.clone(), "monotonic_now") ||
    eq(bare_name.clone(), "now_ms") ||
    eq(bare_name.clone(), "__intrinsic_clock_now") ||
    eq(bare_name.clone(), "__intrinsic_clock_now_ms") {
        return value_types::VT_I64()
    }
    if eq(bare_name.clone(), "sqrt") || eq(bare_name.clone(), "math::sqrt") || eq(bare_name.clone(), "abs_f64") || eq(bare_name.clone(), "f64_abs") || eq(bare_name.clone(), "__intrinsic_sqrt") {
        return value_types::VT_F64()
    }
    if ctx_fn_return_vt_simd::ctx_is_v128_returning_simd_intrinsic(bare_name) {
        return value_types::VT_V128()
    }
    if ctx_fn_return_vt_simd::ctx_is_v128_returning_wasm_intrinsic(bare_name.clone()) {
        return value_types::VT_V128()
    }
    if ctx_fn_return_vt_simd::ctx_is_f32_returning_simd_intrinsic(bare_name.clone()) {
        return value_types::VT_F32()
    }
    if ctx_fn_return_vt_simd::ctx_is_f64_returning_simd_intrinsic(bare_name.clone()) {
        return value_types::VT_F64()
    }
    if ctx_fn_return_vt_simd::ctx_is_i64_returning_simd_intrinsic(bare_name.clone()) {
        return value_types::VT_I64()
    }
    if eq(bare_name.clone(), "concat") || eq(bare_name.clone(), "__intrinsic_concat") {
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            return value_types::VT_GC_REF()
        }
        return value_types::VT_REF()
    }
    // String-returning stdlib functions that may not be in the fn_index.
    if eq(bare_name.clone(), "split") ||
    eq(bare_name.clone(), "join") ||
    eq(bare_name.clone(), "clone") ||
    eq(bare_name.clone(), "slice") ||
    eq(bare_name.clone(), "to_lower") ||
    eq(bare_name.clone(), "to_upper") ||
    eq(bare_name.clone(), "trim") ||
    eq(bare_name.clone(), "replace") {
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            return value_types::VT_GC_REF()
        }
        return value_types::VT_REF()
    }
    value_types::VT_I32()
}

fn ctx_bare_builtin_name(name: String) -> String {
    let mut bare_name = name.clone()
    if len(bare_name) > 12 && bare_name.clone().starts_with("__intrinsic_") {
        bare_name = bare_name.slice(12, len(bare_name))
    }
    bare_name
}

fn ctx_is_i64_clock_callee(name: String) -> bool {
    if name.clone().ends_with("::monotonic_now") ||
    name.clone().ends_with("::now_ms") ||
    name.clone().ends_with("::clock_now") ||
    name.clone().ends_with("::clock_now_ms") {
        return true
    }
    let bare = ctx_bare_builtin_name(name)
    eq(bare.clone(), "clock_now") ||
    eq(bare.clone(), "clock_now_ms") ||
    eq(bare.clone(), "monotonic_now") ||
    eq(bare.clone(), "now_ms")
}

fn is_void_returning_builtin(bare_name: String) -> bool {
    if eq(bare_name.clone(), "__hm_si_set_size") || eq(bare_name.clone(), "__hm_si_set_flag") || eq(bare_name.clone(), "__hm_si_set_val") || eq(bare_name.clone(), "__hm_si_set_key") {
        return true
    }
    if eq(bare_name.clone(), "__hm_is_set_size") || eq(bare_name.clone(), "__hm_is_set_flag") || eq(bare_name.clone(), "__hm_is_set_val") || eq(bare_name.clone(), "__hm_is_set_key") {
        return true
    }
    if eq(bare_name.clone(), "__hm_if_set_size") || eq(bare_name.clone(), "__hm_if_set_flag") || eq(bare_name.clone(), "__hm_if_set_val") || eq(bare_name.clone(), "__hm_if_set_key") {
        return true
    }
    if eq(bare_name.clone(), "__hm_ss_set_size") || eq(bare_name.clone(), "__hm_ss_set_flag") || eq(bare_name.clone(), "__hm_ss_set_val") || eq(bare_name.clone(), "__hm_ss_set_key") {
        return true
    }
    if eq(bare_name.clone(), "hash_string::hashmap_i32_str_set") ||
    eq(bare_name.clone(), "hash_fn::hashmap_i32_fn_set") ||
    eq(bare_name.clone(), "hash_string::hashmap_str_str_set") {
        return true
    }
    eq(bare_name.clone(), "stdio::println") ||
    eq(bare_name.clone(), "println") ||
    eq(bare_name.clone(), "stdio::print") ||
    eq(bare_name.clone(), "print") ||
    eq(bare_name.clone(), "stdio::eprintln") ||
    eq(bare_name.clone(), "eprintln") ||
    eq(bare_name.clone(), "stdio::eprint") ||
    eq(bare_name.clone(), "eprint") ||
    eq(bare_name.clone(), "process::exit") ||
    eq(bare_name.clone(), "host::process::exit") ||
    eq(bare_name.clone(), "process::abort") ||
    eq(bare_name.clone(), "host::process::abort") ||
    eq(bare_name.clone(), "push_char") ||
    eq(bare_name.clone(), "push") ||
    eq(bare_name.clone(), "push_byte") ||
    eq(bare_name.clone(), "push_i64") ||
    eq(bare_name.clone(), "push_f64") ||
    eq(bare_name.clone(), "sort_i32") ||
    eq(bare_name.clone(), "sort_i64") ||
    eq(bare_name.clone(), "sort_f64") ||
    eq(bare_name.clone(), "reverse_String") ||
    eq(bare_name.clone(), "assert") ||
    eq(bare_name.clone(), "assert_eq") ||
    eq(bare_name.clone(), "assert_ne") ||
    eq(bare_name.clone(), "assert_eq_str") ||
    eq(bare_name.clone(), "assert_eq_i64") ||
    eq(bare_name.clone(), "memory_copy") ||
    eq(bare_name.clone(), "memory_fill") ||
    eq(bare_name.clone(), "hashmap_set") ||
    eq(bare_name.clone(), "hashmap_str_set") ||
    eq(bare_name.clone(), "hashmap_i32_str_set") ||
    eq(bare_name.clone(), "hashmap_i32_fn_set") ||
    eq(bare_name.clone(), "hashmap_str_fn_set") ||
    eq(bare_name.clone(), "hashmap_str_str_set") ||
    eq(bare_name.clone(), "hashmap_clear") ||
    eq(bare_name.clone(), "hashmap_reserve") ||
    eq(bare_name.clone(), "hashmap_shrink_to_fit") ||
    eq(bare_name.clone(), "hashmap_extend") ||
    eq(bare_name.clone(), "hashset_insert") ||
    eq(bare_name.clone(), "hashset_remove") ||
    eq(bare_name.clone(), "hashset_str_insert") ||
    eq(bare_name.clone(), "hashset_str_remove") ||
    eq(bare_name.clone(), "assert_true") ||
    eq(bare_name.clone(), "assert_false") ||
    eq(bare_name.clone(), "assert_eq_i32") ||
    eq(bare_name.clone(), "assert_eq_f64") ||
    eq(bare_name.clone(), "assert_eq_string") ||
    eq(bare_name.clone(), "assert_eq_bool") ||
    eq(bare_name.clone(), "assert_ne_i32") ||
    eq(bare_name.clone(), "assert_ne_string") ||
    eq(bare_name.clone(), "assert_contains") ||
    eq(bare_name.clone(), "assert_eq_snapshot") ||
    eq(bare_name.clone(), "assert_msg")
}
