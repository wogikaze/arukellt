use mir::opcodes
use mir::lower_kinds

fn mir_operator_method_name(mir_op: i32) -> String {
    if mir_op == opcodes::MIR_ADD() {
        return "add"
    }
    if mir_op == opcodes::MIR_SUB() {
        return "sub"
    }
    if mir_op == opcodes::MIR_MUL() {
        return "mul"
    }
    if mir_op == opcodes::MIR_DIV() {
        return "div"
    }
    if mir_op == opcodes::MIR_MOD() {
        return "rem"
    }
    if mir_op == opcodes::MIR_EQ() {
        return "eq"
    }
    if mir_op == opcodes::MIR_NEQ() {
        return "eq"
    }
    if mir_op == opcodes::MIR_LT() {
        return "cmp"
    }
    if mir_op == opcodes::MIR_GT() {
        return "cmp"
    }
    if mir_op == opcodes::MIR_LTEQ() {
        return "cmp"
    }
    if mir_op == opcodes::MIR_GTEQ() {
        return "cmp"
    }
    if mir_op == opcodes::MIR_BIT_AND() {
        return "bitand"
    }
    if mir_op == opcodes::MIR_BIT_OR() {
        return "bitor"
    }
    if mir_op == opcodes::MIR_BIT_XOR() {
        return "bitxor"
    }
    if mir_op == opcodes::MIR_SHL() {
        return "shl"
    }
    if mir_op == opcodes::MIR_SHR() {
        return "shr"
    }
    String_new()
}

fn mir_unary_operator_method_name(uop: i32) -> String {
    if uop == lower_kinds::UOP_NEG() {
        return "neg"
    }
    if uop == lower_kinds::UOP_NOT() {
        return "not"
    }
    if uop == lower_kinds::UOP_BITNOT() {
        return "bitnot"
    }
    String_new()
}
