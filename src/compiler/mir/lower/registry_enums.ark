use std::text
use mir::lower::ctx_api_variants
use mir::lower::ctx_struct_storage
use mir::lower::ctx_types
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_enum_payload
use mir::lower::ctx_gc_enum_sig
use corehir::layout_decl_name
use corehir::layout_decl_type_params
use corehir::layout_decl_variants
use corehir::layout_variant
use mir::lower::registry_enum_payload
fn mir_enum_has_payload(decl: CoreHirLayoutDecl) -> bool {
    registry_enum_payload::mir_enum_has_payload(decl)
}

fn mir_register_payload_variant_layout(mut ctx: LowerCtx, full_name: String, variant: CoreHirLayoutVariant) {
    registry_enum_payload::mir_register_payload_variant_layout(ctx, full_name, variant)
}

fn mir_register_enum_variant_gc_sig(mut ctx: LowerCtx, full_name: String, has_payload: bool) {
    if !ctx_gc_enum::ctx_is_gc_target(ctx) {
        return
    }
    let slot = len(ctx.gc_enum_variant_names)
    let sig = if has_payload {
        let fields = ctx_gc_enum_payload::gc_enum_build_payload_field_sigs(ctx, full_name.clone())
        ctx_gc_enum_sig::gc_enum_payload_variant_sig(slot, fields)
    } else {
        ctx_gc_enum_sig::gc_enum_unit_variant_sig(slot)
    }
    ctx_gc_enum::ctx_register_gc_enum_variant(ctx, full_name.clone(), sig)
}

// Generic enum declarations record their parameter names so match payload
// lowering can substitute a concrete instantiation's arguments into the
// declared payload field types (Wrap::Some(T) matched at Wrap<i32>).
fn mir_register_generic_enum_params(mut ctx: LowerCtx, enum_name: String, decl: CoreHirLayoutDecl) {
    let param_count = layout_decl_type_params::layout_decl_type_param_count(decl)
    if param_count <= 0 {
        return
    }
    let mut joined = String_new()
    let mut pi = 0
    while pi < param_count {
        if pi > 0 {
            joined = joined.concat(String_from(","))
        }
        joined = joined.concat(layout_decl_type_params::layout_decl_type_param_at(decl, pi))
        pi = pi + 1
    }
    push(ctx.generic_enum_names, enum_name.clone())
    push(ctx.generic_enum_params, joined)
}

fn mir_register_enum_layout(mut ctx: LowerCtx, decl: CoreHirLayoutDecl) {
    let ec = layout_decl_variants::layout_decl_variant_count(decl)
    let has_payload = mir_enum_has_payload(decl)
    let enum_name = layout_decl_name::layout_decl_name(decl)
    mir_register_generic_enum_params(ctx, enum_name.clone(), decl)
    ctx_struct_storage::ctx_struct_push_layout(ctx, enum_name.clone(), 1)
    ctx_struct_storage::ctx_struct_push_field(ctx, "_tag", "")
    let mut vi = 0
    while vi < ec {
        let variant = layout_decl_variants::layout_decl_variant_at(decl, vi)
        let full_name = enum_name.clone().concat("::".concat(layout_variant::layout_variant_name(variant)))
        ctx_api_variants::ctx_register_variant_tag(ctx, full_name.clone(), vi)
        if layout_variant::layout_variant_has_payload(variant) {
            mir_register_payload_variant_layout(ctx, full_name.clone(), variant)
        } else if has_payload {
            ctx_api_variants::ctx_register_payload_variant(ctx, full_name.clone())
            ctx_struct_storage::ctx_struct_push_layout(ctx, full_name.clone(), 1)
            ctx_struct_storage::ctx_struct_push_field(ctx, "_tag", "")
        }
        mir_register_enum_variant_gc_sig(ctx, full_name.clone(), layout_variant::layout_variant_has_payload(variant))
        vi = vi + 1
    }
}
