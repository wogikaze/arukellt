use std::prelude::{eq, String_from}
use std::text
use mir::lower::call_type_vec
use mir::lower::ctx_fn_mono
use mir::lower::ctx_fn_exists
use mir::lower::ctx_api_local_types
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_types
use mir::lower::mono_suffix_parse
use mir::mono
use mir::value_types
use wasm::sections_types_gc_phase7
fn mir_resolve_mono_call_target(mut ctx: LowerCtx, rewritten: String, first_arg_idx: i32, span_start: i32) -> String {
    let mut resolved = concretize_var_owner_call_target(ctx, rewritten.clone())
    let mut mono_resolved_by_type = false
    if first_arg_idx >= 0 {
        let mono_arg_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
        let mut mono_type_key = normalize_mono_type_key(mono_arg_type)
        // Int/float literals often have empty type_name; derive from VT so
        // write_debug_to(buf, 42) resolves to write_debug_to__i32 rather than
        // the first unused write_debug_to__String specialization.
        if len(mono_type_key) == 0 {
            mono_type_key = mono_type_key_from_local_vt(ctx, first_arg_idx)
        }
        if len(mono_type_key) > 0 {
            let type_resolve = mir_try_resolve_mono_by_type_key(ctx, resolved.clone(), mono_type_key.clone(), mono_arg_type.clone())
            if len(type_resolve) > 0 {
                resolved = type_resolve
                mono_resolved_by_type = true
            } else {
                // Memory64 int literals are i64 locals while mono keys stay i32
                // (write_debug_to__i32). Retry i32 before falling to name rewrite.
                if eq(mono_type_key.clone(), "i64") {
                    let i32_resolve = mir_try_resolve_mono_by_type_key(
                        ctx,
                        resolved.clone(),
                        "i32",
                        "i32"
                    )
                    if len(i32_resolve) > 0 {
                        resolved = i32_resolve
                        mono_resolved_by_type = true
                    }
                }
            }
        }
    }
    if !mono_resolved_by_type {
        // Don't let mono span lookup override already-resolved mangled names
        // that have already been mono-safe'd (contain "__" but no "::").
        // Names with "::" (e.g. "Picker::echo") still need span-based and
        // name-based mono lookup for generic method calls.
        if !resolved.clone().contains("__") || resolved.clone().contains("::") {
            let mono_target = ctx_fn_mono::ctx_mono_lookup_call(ctx, span_start, resolved.clone())
            if len(mono_target) > 0 {
                resolved = mono_target
            } else {
                // Fallback: assign unused mono specialization in registration order.
                // ctx_mono_lookup_name_rewrite always returns the first match and
                // breaks multi-param generics (e.g. pair_first__i32__String for
                // every pair_first call site).
                let name_rewrite = ctx_fn_mono::ctx_resolve_unused_mono_by_name(ctx, resolved.clone())
                if len(name_rewrite) > 0 {
                    resolved = name_rewrite
                }
            }
        }
    }
    resolved = concretize_vec_ctor_projection(ctx, resolved)
    resolved = resolve_format_debug_mono_target(ctx, resolved.clone(), first_arg_idx)
    resolved
}

// `Var::method` callees (`T::cmp`, `K::cmp`) inside a monomorphized body
// keep the type-variable owner because the enclosing instance binds it
// only in the type-param map, not in the local type names. Bind the
// owner through that map (T -> i32) so the concrete impl method
// resolves; owners that are not bound vars, or whose binding does not
// name an emitted function, keep the symbolic spelling for the
// existing fallback chain.
fn concretize_var_owner_call_target(ctx: LowerCtx, resolved: String) -> String {
    let sep = resolved.clone().index_of(String_from("::"))
    if sep <= 0 {
        return resolved
    }
    let first = resolved.clone().byte_at(0)
    if first != 63 && (first < 65 || first > 90) {
        return resolved
    }
    let owner = resolved.clone().slice(0, sep)
    let concrete = ctx_mono_type_params::ctx_resolve_mono_type_param(ctx, owner.clone())
    if len(concrete) == 0 {
        return resolved
    }
    let candidate = concrete.clone().concat(resolved.clone().slice(sep, len(resolved)))
    if ctx_fn_exists::ctx_has_fn_name(ctx, candidate.clone()) {
        return candidate
    }
    resolved
}

// A Vec constructor recorded inside a parametric impl body keeps the
// projection spelling (`Vec::new<I::Item>` -> `Vec__new__I__Item`). The
// enclosing instance's projection map binds `I::Item` to the concrete
// element type, so rewrite the suffix here; otherwise emit derives a
// structref array for the unresolvable element name.
fn concretize_vec_ctor_projection(ctx: LowerCtx, resolved: String) -> String {
    let elem_start = call_type_vec::vec_constructor_element_start(resolved.clone(), 0 - 1)
    if elem_start < 0 {
        return resolved
    }
    let mut elem = resolved.clone().slice(elem_start, len(resolved))
    elem = sections_types_gc_phase7::gc_normalize_vec_element_name(elem)
    elem = call_type_vec::decode_mono_vec_element_projection(elem)
    // A bare type-variable element (`Vec::with_capacity<T>` inside a generic
    // body) keeps the declared spelling because the constructor name is built
    // from the AST annotation text. The enclosing instance binds it, so
    // rewrite through the mono map; otherwise the ctor lowers as an i32 vec
    // and a Vec<T> local receives a mismatched struct ref (#965).
    if mono_suffix_parse::is_mono_type_var_name(elem.clone()) {
        let concrete = ctx_mono_type_params::ctx_resolve_mono_type_param(ctx, elem.clone())
        if len(concrete) > 0 && !eq(concrete.clone(), elem.clone()) {
            return mono::mono_safe_name(
                resolved.clone().slice(0, elem_start).concat(concrete)
            )
        }
        return resolved
    }
    // Only projection-shaped elements (`Owner::Assoc`) are rewritten; a
    // concrete element like `Item` must not resolve through a stored
    // `I::Item` segment match.
    if !elem.clone().contains(String_from("::")) {
        return resolved
    }
    let concrete = ctx_mono_type_params::ctx_resolve_mono_type_param(ctx, elem.clone())
    if len(concrete) == 0 || eq(concrete.clone(), elem.clone()) {
        return resolved
    }
    mono::mono_safe_name(
        resolved.clone().slice(0, elem_start).concat(concrete)
    )
}

fn mono_vec_element_candidate(callee: String, mono_arg_type: String) -> String {
    if !mono_arg_type.clone().starts_with("vec:") {
        return String_new()
    }
    let element_type = mono_arg_type.slice(4, len(mono_arg_type))
    if len(element_type) == 0 {
        return String_new()
    }
    mono::mono_safe_name(
        mir_strip_callee_module_prefix(callee).concat("__".concat(element_type))
    )
}

fn mir_strip_callee_module_prefix(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    name.clone()
}

fn mono_type_key_from_local_vt(ctx: LowerCtx, local_idx: i32) -> String {
    let vt = ctx_api_local_types::ctx_local_vt(ctx, local_idx)
    if vt == value_types::VT_I32() {
        return "i32"
    }
    if vt == value_types::VT_I64() {
        return "i64"
    }
    if vt == value_types::VT_F64() {
        return "f64"
    }
    if vt == value_types::VT_V128() {
        return "v128"
    }
    String_new()
}

fn mir_try_resolve_mono_by_type_key(
    ctx: LowerCtx,
    resolved: String,
    mono_type_key: String,
    mono_arg_type: String
) -> String {
    let mono_candidate = mono::mono_safe_name(resolved.clone().concat("__".concat(mono_type_key.clone())))
    if ctx_fn_exists::ctx_has_fn_name(ctx, mono_candidate.clone()) {
        return mono_candidate
    }
    let bare_candidate = mono::mono_safe_name(
        mir_strip_callee_module_prefix(resolved.clone()).concat("__".concat(mono_type_key.clone()))
    )
    if ctx_fn_exists::ctx_has_fn_name(ctx, bare_candidate.clone()) {
        return bare_candidate
    }
    let vec_element_candidate = mono_vec_element_candidate(resolved.clone(), mono_arg_type.clone())
    if len(vec_element_candidate) > 0 && ctx_fn_exists::ctx_has_fn_name(ctx, vec_element_candidate.clone()) {
        return vec_element_candidate
    }
    let method_leaf = mir_strip_callee_module_prefix(resolved.clone())
    let type_method = mono_type_key.clone().concat("::".concat(method_leaf.clone()))
    if ctx_fn_exists::ctx_has_fn_name(ctx, type_method.clone()) {
        return type_method
    }
    if eq(mono_type_key.clone(), "string") {
        let mono_candidate_string = mono::mono_safe_name(method_leaf.clone().concat("__String"))
        if ctx_fn_exists::ctx_has_fn_name(ctx, mono_candidate_string.clone()) {
            return mono_candidate_string
        }
    }
    String_new()
}

fn normalize_mono_type_key(mono_arg_type: String) -> String {
    let mut mono_type_key = mono_arg_type.clone()
    // Nested containers: vec:vec:i32 → Vec<i32> (same as call_mono_by_type).
    if mono_arg_type.clone().starts_with("vec:") {
        mono_type_key = call_mono_nested_vec_type_key(mono_arg_type.slice(4, len(mono_arg_type)))
    }
    // struct:Person:8 → Person so eq resolves to Person::eq (#808 eq_trait_*).
    if mono_type_key.clone().starts_with("struct:") {
        let rest = mono_type_key.clone().slice(7, len(mono_type_key))
        let rest_len = len(rest)
        let mut cut = rest_len
        let mut i = 0
        while i < rest_len {
            if rest.byte_at(i) == 58 {
                cut = i
                i = rest_len
            } else {
                i = i + 1
            }
        }
        mono_type_key = rest.slice(0, cut)
    }
    if mono_type_key.clone().starts_with("Option:") {
        mono_type_key = mono_type_key.clone().slice(7, len(mono_type_key))
    }
    if mono_type_key.clone().starts_with("enum:") {
        mono_type_key = mono_type_key.clone().slice(5, len(mono_type_key))
    }
    mono_type_key
}

fn resolve_format_debug_mono_target(ctx: LowerCtx, resolved: String, first_arg_idx: i32) -> String {
    // format_debug / fmt::format_debug__?t0 → concrete T::fmt_debug
    let bare = mir_strip_callee_module_prefix(resolved.clone())
    if bare.clone().starts_with("format_debug") && first_arg_idx >= 0 {
        let mut key = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
        if key.clone().starts_with("option:") || key.clone().starts_with("Option_") {
            key = key.clone().slice(7, len(key))
        }
        if eq(key.clone(), "string") {
            key = "String"
        }
        if len(key) == 0 || key.clone().starts_with("?") || eq(key.clone(), "enum:open") {
            let vt = ctx_api_local_types::ctx_local_vt(ctx, first_arg_idx)
            if vt == value_types::VT_I32() {
                key = "i32"
            } else {
                if vt == value_types::VT_I64() {
                    key = "i64"
                } else {
                    if vt == value_types::VT_F64() {
                        key = "f64"
                    }
                }
            }
        }
        if len(key) > 0 && !key.clone().starts_with("?") && !eq(key.clone(), "enum:open") {
            let trait_method = key.clone().concat("::fmt_debug")
            if ctx_fn_exists::ctx_has_fn_name(ctx, trait_method.clone()) {
                return trait_method
            }
        }
    }
    resolved
}

fn call_mono_nested_vec_type_key(type_name: String) -> String {
    if type_name.clone().starts_with("vec:") {
        let inner = call_mono_nested_vec_type_key(type_name.clone().slice(4, len(type_name)))
        return "Vec<".concat(inner.concat(">"))
    }
    // Bare "Vec" from Vec<Vec<...>> annotations that lost the inner key.
    if eq(type_name.clone(), "Vec") {
        return "Vec<i32>"
    }
    type_name
}
