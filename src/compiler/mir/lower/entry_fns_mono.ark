use std::prelude::{clone, eq}
use corehir::mir_type_source
use mir::lower::aggregate_tuple
use mir::lower::ctx_api_module
use mir::lower::ctx_mono_type_params
use mir::lower::entry_emit_top
use mir::lower::entry_view_record
use mir::lower::entry_view_fn
use mir::lower::return_typeinfo
use mir::lower::return_types
use mir::lower_kinds
use mir::mono
use mir::type_contracts
use mir::typeinfo_shape
fn mir_emit_top_level_fn_mono_bodies(
    ctx: LowerCtx,
    body_input: MirLowerEntryBodyInput,
    decl_name: String,
    typed_index: i32,
    param_count: i32,
    entry_view: MirLowerEntryView,
    fn_info_index: i32,
    midx: MonoIndex,
    mir_tr: i32
) {
    let mut mono_key = clone(decl_name)
    let mut mono_emit_count_raw = mono::mono_index_count(midx, clone(decl_name))
    if mono_emit_count_raw == 0 {
        // Module-member generics record instances under the qualified fn_name
        // (test::assert_eq_debug), so the decl key never sees them. A single
        // instance is still emitted as the concrete leaf body below; with
        // two or more, emit the qualified-keyed variants and leave the leaf
        // decl as the unreachable generic fallback.
        let mono_qualified_name = entry_view_fn::mir_entry_fn_qualified_name_at(entry_view, fn_info_index, String_new())
        if len(mono_qualified_name) > 0 && !eq(clone(mono_qualified_name), clone(decl_name)) {
            let qualified_count = mono::mono_index_count(midx, clone(mono_qualified_name))
            if qualified_count > 1 {
                mono_emit_count_raw = qualified_count
                mono_key = mono_qualified_name
            }
        }
    }
    if mono_emit_count_raw > 0 {
        let mut mono_emit_i = 0
        let generic_rt_tag = mir_entry_typed_return_tag_at(entry_view, typed_index)
        let generic_rt_type_name = mir_entry_typed_return_type_name_at(entry_view, typed_index)
        let generic_rt_type_var_name = mir_entry_typed_return_type_var_name(entry_view, typed_index)
        let generic_return_ty = mir_entry_typed_return_type_at(entry_view, typed_index)
        while mono_emit_i < mono_emit_count_raw {
            let mangled = mono::mono_index_mangled_at(midx, clone(mono_key), mono_emit_i)
            let emit_fn_name = mono::mono_safe_name(mangled)
            let mut rt_tag = generic_rt_tag
            let mut rt_type_name = clone(generic_rt_type_name)
            let concrete = mono_instantiate_return_from_instance(ctx, clone(mangled), generic_return_ty)
            if type_contracts::TypeInfo_tag(concrete) != 0 {
                rt_tag = return_typeinfo::mir_return_tag_from_type_info(concrete)
                rt_type_name = return_typeinfo::mir_return_type_name_from_type_info(concrete)
                if type_contracts::TypeInfo_tag(concrete) == lower_kinds::TY_TUPLE() {
                    aggregate_tuple::ctx_register_tuple_gc_struct_from_return_name(ctx, clone(rt_type_name))
                }
            }
            entry_top::mir_emit_top_level_fn_body(
                ctx,
                body_input,
                rt_tag,
                rt_type_name,
                clone(generic_rt_type_name),
                emit_fn_name,
                param_count,
                typed_index,
                mir_tr,
                entry_view,
                fn_info_index
            )
            mono_emit_i = mono_emit_i + 1
        }
        return
    }
    let generic_rt_tag = mir_entry_typed_return_tag_at(entry_view, typed_index)
    let generic_rt_type_name = mir_entry_typed_return_type_name_at(entry_view, typed_index)
    let mut leaf_rt_tag = generic_rt_tag
    let mut leaf_rt_type_name = clone(generic_rt_type_name)
    // A generic emitted under its leaf name reaches this branch because its
    // instances were recorded under the qualified caller spelling
    // (seq::sort_by -> seq::sort_by__i32 while the decl is sort_by). The
    // emitted body still belongs to one concrete instantiation: keep the
    // recorded return type concrete so callee-propagation hands callers
    // vec:i32 instead of the declared vec:T, which would declare the
    // caller's result local as the structref-element vec on wasm32-gc.
    let leaf_inst_idx = ctx_mono_type_params::ctx_find_leaf_mono_instance_index(ctx, clone(decl_name))
    if leaf_inst_idx >= 0 {
        let leaf_inst = get_unchecked(ctx.mono_instances, leaf_inst_idx)
        let leaf_concrete = mono_instantiate_return_from_instance(
            ctx,
            type_contracts::MonoInstance_mangled_name(leaf_inst),
            mir_entry_typed_return_type_at(entry_view, typed_index)
        )
        if type_contracts::TypeInfo_tag(leaf_concrete) != 0 {
            leaf_rt_tag = return_typeinfo::mir_return_tag_from_type_info(leaf_concrete)
            leaf_rt_type_name = return_typeinfo::mir_return_type_name_from_type_info(leaf_concrete)
            if type_contracts::TypeInfo_tag(leaf_concrete) == lower_kinds::TY_TUPLE() {
                aggregate_tuple::ctx_register_tuple_gc_struct_from_return_name(ctx, clone(leaf_rt_type_name))
            }
        }
    }
    entry_top::mir_emit_top_level_fn_body(
        ctx,
        body_input,
        leaf_rt_tag,
        clone(leaf_rt_type_name),
        clone(generic_rt_type_name),
        clone(decl_name),
        param_count,
        typed_index,
        mir_tr,
        entry_view,
        fn_info_index
    )
}

fn mono_instantiate_return_from_instance(ctx: LowerCtx, mangled: String, generic_return_ty: TypeInfo) -> TypeInfo {
    let inst = ctx_api_module::ctx_mono_instance_at(ctx, mangled)
    let recorded_return = corehir::type_contracts::MonoInstance_return_type(inst)
    if type_contracts::TypeInfo_tag(recorded_return) != 0 {
        return recorded_return
    }
    if type_contracts::MonoInstance_type_arg_count(inst) <= 0 {
        return type_contracts::TypeInfo_simple(0)
    }
    mono_instantiate_return_type(generic_return_ty, inst)
}

fn mono_instantiate_return_type(ty: TypeInfo, inst: MonoInstance) -> TypeInfo {
    let tag = type_contracts::TypeInfo_tag(ty)
    if tag == lower_kinds::TY_TYPE_VAR() {
        let var_name = type_contracts::TypeInfo_name(ty)
        let idx = mono_return_type_arg_index_from_var_name(var_name, type_contracts::MonoInstance_type_arg_count(inst))
        if idx >= 0 && idx < type_contracts::MonoInstance_type_arg_count(inst) {
            return type_contracts::MonoInstance_type_arg_at(inst, idx)
        }
        return type_contracts::TypeInfo_simple(0)
    }
    let arg_count = type_contracts::TypeInfo_type_arg_count(ty)
    if arg_count <= 0 {
        return ty
    }
    let result = type_contracts::TypeInfo_new(tag, type_contracts::TypeInfo_name(ty), Vec::new<TypeInfo>())
    let mut ai = 0
    while ai < arg_count {
        let arg = type_contracts::TypeInfo_type_arg_at(ty, ai)
        type_contracts::TypeInfo_push_type_arg(result, mono_instantiate_return_type(arg, inst))
        ai = ai + 1
    }
    result
}

// Find the first type argument from the MonoInstance matching `mangled`.
// Returns TY_UNKNOWN (tag 0) if not found.
fn lookup_mono_type_arg(ctx: LowerCtx, mangled: String) -> TypeInfo {
    let inst = ctx_api_module::ctx_mono_instance_at(ctx, mangled)
    if type_contracts::MonoInstance_type_arg_count(inst) > 0 {
        return type_contracts::MonoInstance_type_arg_at(inst, 0)
    }
    type_contracts::TypeInfo_simple(0)
}

// Find the type argument at a specific index from the MonoInstance matching `mangled`.
fn lookup_mono_type_arg_at(ctx: LowerCtx, mangled: String, index: i32) -> TypeInfo {
    let inst = ctx_api_module::ctx_mono_instance_at(ctx, mangled)
    let arg_count = type_contracts::MonoInstance_type_arg_count(inst)
    if index >= 0 && index < arg_count {
        return type_contracts::MonoInstance_type_arg_at(inst, index)
    }
    if arg_count > 0 {
        return type_contracts::MonoInstance_type_arg_at(inst, 0)
    }
    type_contracts::TypeInfo_simple(0)
}

// Get the type argument count from the MonoInstance matching `mangled`.
fn lookup_mono_type_arg_count(ctx: LowerCtx, mangled: String) -> i32 {
    type_contracts::MonoInstance_type_arg_count(ctx_api_module::ctx_mono_instance_at(ctx, mangled))
}

// Map a return type variable name (e.g. "B") to a type argument index.
fn mono_return_type_arg_index_from_var_name(var_name: String, arg_count: i32) -> i32 {
    if arg_count <= 0 {
        return 0
    }
    if len(var_name) == 0 {
        return 0
    }
    let idx = type_var_to_index(var_name)
    if idx >= 0 && idx < arg_count {
        return idx
    }
    0
}

fn type_var_to_index(var_name: String) -> i32 {
    if eq(clone(var_name), "T") { return 0 }
    if eq(clone(var_name), "E") { return 1 }
    if eq(clone(var_name), "U") { return 2 }
    if eq(clone(var_name), "V") { return 3 }
    if eq(clone(var_name), "W") { return 4 }
    if eq(clone(var_name), "K") { return 0 }
    if eq(clone(var_name), "A") { return 0 }
    if eq(clone(var_name), "B") { return 1 }
    if eq(clone(var_name), "C") { return 2 }
    if eq(clone(var_name), "D") { return 3 }
    0
}

fn mir_entry_typed_return_tag_at(view: MirLowerEntryView, typed_index: i32) -> i32 {
    let tf = type_source::mir_type_source_typed_fn_at(entry_view_record::entry_view_type_source(view), typed_index)
    return_types::mir_return_tag_from_typed_fn(tf)
}

fn mir_entry_typed_return_type_name_at(view: MirLowerEntryView, typed_index: i32) -> String {
    let ts = entry_view_record::entry_view_type_source(view)
    let count = type_source::mir_type_source_typed_fn_count(ts)
    if typed_index < 0 || typed_index >= count {
        return ""
    }
    let tf = type_source::mir_type_source_typed_fn_at(ts, typed_index)
    return_types::mir_return_type_name_from_typed_fn(tf)
}

fn mir_entry_typed_return_type_at(view: MirLowerEntryView, typed_index: i32) -> TypeInfo {
    let ts = entry_view_record::entry_view_type_source(view)
    let count = type_source::mir_type_source_typed_fn_count(ts)
    if typed_index < 0 || typed_index >= count {
        return type_contracts::TypeInfo_simple(0)
    }
    let tf = type_source::mir_type_source_typed_fn_at(ts, typed_index)
    typeinfo_shape::mir_typed_fn_return_type(tf)
}

fn mir_entry_typed_return_type_var_name(view: MirLowerEntryView, typed_index: i32) -> String {
    let ts = entry_view_record::entry_view_type_source(view)
    let count = type_source::mir_type_source_typed_fn_count(ts)
    if typed_index < 0 || typed_index >= count {
        return ""
    }
    let tf = type_source::mir_type_source_typed_fn_at(ts, typed_index)
    let ret_ty = typeinfo_shape::mir_typed_fn_return_type(tf)
    if typeinfo_shape::mir_type_info_tag(ret_ty) == lower_kinds::TY_TYPE_VAR() {
        return typeinfo_shape::mir_type_info_name(ret_ty)
    }
    ""
}
