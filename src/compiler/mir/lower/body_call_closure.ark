use mir::lower::ast_node
use mir::lower::call_type_fallback
use mir::lower::closure_capture_args
use mir::lower::closure_cells
use mir::lower::closure_registry
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_fn_return_vt
use mir::lower_kinds
use mir::lower::ctx_types
use mir::inst_call
use mir::inst_local_get
use mir::value_types
fn try_lower_closure_call(mut ctx: LowerCtx, node: AstNode, callee: AstNode, child_count: i32) -> i32 {
    if !ast_node::node_kind_is(callee, lower_kinds::NK_IDENT()) {
        return 0 - 1
    }
    let clo_ix = closure_registry::ctx_closure_lookup(ctx, ast_node::node_text(callee))
    if clo_ix < 0 {
        return 0 - 1
    }
    let synth = closure_registry::ctx_closure_synth_at(ctx, clo_ix)
    let packed = closure_registry::ctx_closure_caps_at(ctx, clo_ix)
    let extra = closure_registry::ctx_closure_extra_at(ctx, clo_ix)
    let is_identity = closure_registry::ctx_closure_is_identity(ctx, clo_ix)
    let mut first_arg = 0 - 1
    let mut ca = 1
    while ca < child_count {
        let carg = ast_node::node_child_at(node, ca)
        let arg_idx = lower_expr(ctx, carg)
        if ca == 1 {
            first_arg = arg_idx
        }
        ca = ca + 1
    }
    if is_identity {
        if child_count == 2 {
            return first_arg
        }
        return 0 - 1
    }
    closure_capture_args::closure_emit_captured_args(ctx, packed)
    // Env-cell closures take the __env record as a trailing direct-call
    // argument: the trampoline passes it for indirect calls, so the named
    // call path pushes the same env local here (#874).
    let env_li = closure_registry::ctx_closure_env_local_at(ctx, clo_ix)
    if env_li >= 0 {
        ctx_emit(ctx, inst_local_get::MirInst_local_get_to(env_li, env_li))
    }
    let env_arg = if env_li >= 0 { 1 } else { 0 }
    let dest_vt = ctx_fn_return_vt::ctx_fn_return_vt(ctx, synth.clone())
    let c_dest = ctx_fresh_local(ctx, dest_vt)
    ctx_emit(ctx, inst_call::MirInst_call(synth.clone(), child_count - 1 + extra + env_arg, c_dest))
    // Refresh mut-borrowed source locals from their env cells so reads
    // after the call observe the closure's writes (#874, ADR-061).
    closure_cells::ctx_emit_closure_writeback(ctx, synth)
    call_type_fallback::mark_fallback_call_result_type(ctx, synth.clone(), c_dest)
    c_dest
}
