use mir::function_locals_view
use mir::local_access
use mir::lower::closure_cells
use mir::lower::closure_env_layout
use mir::lower::closure_pcells
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_function_frame
use mir::lower::ctx_current_storage
use mir::lower::ctx_struct_layout
use mir::lower::ctx_types
use mir::local_factory
use mir::value_types
fn core_closure_lookup_capture_type(mut ctx: LowerCtx, cli: i32) -> String {
    let mut cap_type = String_new()
    if cli < 0 {
        return cap_type
    }
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    if cli < function_locals_view::MirFunction_local_count(func) {
        let loc = function_locals_view::MirFunction_local_at(func, cli)
        cap_type = local_access::MirLocal_type_name(loc)
    }
    if cap_type.len() == 0 {
        cap_type = ctx_api_local_types::ctx_get_local_type(ctx, cli)
    }
    if cap_type.len() > 0 {
        cap_type = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, cap_type.clone())
    } else {
        if ctx_api_local_types::ctx_local_vt(ctx, cli) == value_types::VT_GC_REF() {
            cap_type = "String"
        }
    }
    cap_type
}

fn core_closure_capture_vts(mut ctx: LowerCtx, caps: Vec<String>) -> Vec<i32> {
    let cap_n = caps.len()
    let mut cap_vts = Vec::new<i32>()
    let mut cvi = 0
    while cvi < cap_n {
        let cname = caps.get_unchecked(cvi).clone()
        let cli = ctx_api_local_alloc::ctx_lookup_local(ctx, cname.clone())
        let mut pvt = value_types::VT_I32()
        if cli >= 0 {
            if closure_pcells::ctx_pcell_is_cell(ctx, cli) {
                // Promoted borrow cells pass the cell ref as the cap
                // argument (#891).
                pvt = closure_env_layout::closure_env_ref_vt(ctx)
                push(cap_vts, pvt)
                cvi = cvi + 1
                continue
            }
            pvt = ctx_api_local_types::ctx_local_vt(ctx, cli)
            let cap_type = core_closure_lookup_capture_type(ctx, cli)
            if cap_type.clone().starts_with("struct:") ||
            cap_type.clone().eq("String") ||
            cap_type.clone().eq("string") ||
            cap_type.clone().starts_with("enum:") ||
            cap_type.clone().starts_with("vec:") ||
            cap_type.clone().starts_with("Option_") ||
            cap_type.clone().starts_with("Result_") {
                pvt = value_types::VT_GC_REF()
            }
        }
        push(cap_vts, pvt)
        cvi = cvi + 1
    }
    cap_vts
}

fn core_closure_capture_types(mut ctx: LowerCtx, caps: Vec<String>) -> Vec<String> {
    let cap_n = caps.len()
    let mut cap_types = Vec::new<String>()
    let mut cvi = 0
    while cvi < cap_n {
        let cname = caps.get_unchecked(cvi).clone()
        let cli = ctx_api_local_alloc::ctx_lookup_local(ctx, cname.clone())
        if cli >= 0 && closure_pcells::ctx_pcell_is_cell(ctx, cli) {
            // Promoted cap params declare the cell ref type so direct
            // calls and the env trampoline pass the shared cell (#891).
            push(cap_types, closure_pcells::ctx_pcell_cell_spelling(ctx, cli))
            cvi = cvi + 1
            continue
        }
        let cap_type = core_closure_lookup_capture_type(ctx, cli)
        push(cap_types, cap_type)
        cvi = cvi + 1
    }
    cap_types
}

fn core_emit_closure_captures(mut ctx: LowerCtx, caps: Vec<String>, cap_vts: Vec<i32>, cap_types: Vec<String>, rebind_flags: Vec<i32>, env_name: String) {
    let cap_n = caps.len()
    let mut ci = 0
    while ci < cap_n {
        let cname = caps.get_unchecked(ci).clone()
        let pvt = cap_vts.get_unchecked(ci)
        let cap_type = cap_types.get_unchecked(ci).clone()
        let pname = closure_pcells::ctx_pcell_cap_param_name(
            cap_type.clone(),
            cname.clone()
        )
        let _idx2 = ctx_api_local_alloc::ctx_alloc_local(ctx, pname.clone(), pvt)
        if cap_type.len() > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, _idx2, cap_type.clone())
        }
        // Mirrors mir_emit_closure_captures: a promoted-cell cap param
        // gets a payload shadow under the capture name (#891).
        closure_pcells::ctx_pcell_bind_cap_param(ctx, _idx2, cap_type.clone(), cname.clone())
        ctx_api_function_frame::ctx_push_func_param(ctx, local_factory::MirLocal_new(pname.clone(), pvt, cap_type))
        ci = ci + 1
    }
    // Trailing __env param + cell registration when a capture is rebound
    // (env cells, #874); mirrors mir_emit_closure_captures.
    closure_cells::ctx_bind_closure_env_cells(ctx, caps, cap_vts, rebind_flags, env_name)
}
