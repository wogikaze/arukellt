use std::text
use mir::lower::ast_node
use mir::function_return_view
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_variants
use mir::lower::ctx_current_storage
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_lookup_index
use mir::lower_kinds
use mir::lower::ctx_gc_enum
use mir::lower::call_type_fallback
use mir::lower::match_arms
use mir::lower::match_payload_field_type
use mir::lower::param_sig_infer
use mir::inst_struct_get
use mir::inst_gc_struct
use mir::inst_local_get
use mir::inst_local_set
use mir::value_types
struct MirMatchPayloadInfo {
    is_payload_match: bool,
    scrut_ok_is_f64: bool,
    scrut_ok_is_i64: bool,
    scrut_ok_is_i32: bool,
    compare_idx: i32,
}

fn mir_match_payload_info_new(is_payload_match: bool, scrut_ok_is_f64: bool, scrut_ok_is_i64: bool, scrut_ok_is_i32: bool, compare_idx: i32) -> MirMatchPayloadInfo {
    MirMatchPayloadInfo { is_payload_match: is_payload_match, scrut_ok_is_f64: scrut_ok_is_f64, scrut_ok_is_i64: scrut_ok_is_i64, scrut_ok_is_i32: scrut_ok_is_i32, compare_idx: compare_idx }
}

fn mir_match_payload_info_is_payload_match(info: MirMatchPayloadInfo) -> bool {
    info.is_payload_match
}

fn mir_match_payload_info_scrut_ok_is_f64(info: MirMatchPayloadInfo) -> bool {
    info.scrut_ok_is_f64
}

fn mir_match_payload_info_scrut_ok_is_i64(info: MirMatchPayloadInfo) -> bool {
    info.scrut_ok_is_i64
}

fn mir_match_payload_info_scrut_ok_is_i32(info: MirMatchPayloadInfo) -> bool {
    info.scrut_ok_is_i32
}

fn mir_match_payload_info_compare_idx(info: MirMatchPayloadInfo) -> i32 {
    info.compare_idx
}

fn mir_prepare_match_payload(mut ctx: LowerCtx, node: AstNode, child_count: i32, scrut_idx: i32) -> MirMatchPayloadInfo {
    let is_payload_match = mir_match_has_payload_pattern(node, child_count)
    let has_variant_arm = mir_match_has_variant_pattern(node, child_count)
    mir_fix_unresolved_scrutinee_type(ctx, node, child_count, scrut_idx, has_variant_arm)
    let scrut_type = ctx_get_local_type(ctx, scrut_idx)
    let scrut_ok_is_f64 = mir_option_result_scrut_type_is_f64(scrut_type.clone())
    let scrut_ok_is_i64 = mir_option_result_scrut_type_is_i64(scrut_type.clone())
    let scrut_ok_is_i32 = mir_option_result_scrut_type_is_i32(scrut_type.clone())
    // On wasm32 every variant of an enum that declares payloads is a heap
    // record, including payload-less arms like `Opt::None`.  Comparing the
    // record pointer against the tag constant is always false, so variant
    // patterns of a record-repr enum must read the tag field first (#892).
    let has_record_variant_arm = mir_match_has_record_variant_pattern(ctx, node, child_count)
    let mut compare_idx = scrut_idx
    if is_payload_match ||
    (ctx_gc_enum::ctx_is_gc_target(ctx) && has_variant_arm) ||
    (!ctx_gc_enum::ctx_is_gc_target(ctx) && has_record_variant_arm) {
        call_type_fallback::mir_promote_gc_enum_container_vt(ctx, scrut_idx)
        compare_idx = mir_emit_payload_tag_local(ctx, scrut_idx)
    }
    mir_match_payload_info_new(is_payload_match, scrut_ok_is_f64, scrut_ok_is_i64, scrut_ok_is_i32, compare_idx)
}

// Option/Result payload-scalar spelling checks shared by the top-level
// scrutinee probe and tuple-element payload binds (#893): a tuple element
// whose field type is option:i32/result:... needs the same flags a
// top-level Option/Result scrutinee would.
fn mir_option_result_scrut_type_is_f64(scrut_type: String) -> bool {
    scrut_type.clone().eq("Result_f64") ||
    scrut_type.clone().eq("Option_f64") ||
    scrut_type.clone().eq("option:f64") ||
    scrut_type.clone().starts_with("Result_f64_") ||
    scrut_type.clone().starts_with("result:f64:")
}

fn mir_option_result_scrut_type_is_i64(scrut_type: String) -> bool {
    scrut_type.clone().eq("Result_i64") ||
    scrut_type.clone().eq("Option_i64") ||
    scrut_type.clone().eq("option:i64") ||
    scrut_type.clone().starts_with("Result_i64_") ||
    scrut_type.clone().starts_with("result:i64:")
}

fn mir_option_result_scrut_type_is_i32(scrut_type: String) -> bool {
    scrut_type.clone().eq("Option_i32") ||
    scrut_type.clone().eq("Result_i32") ||
    scrut_type.clone().eq("option:i32") ||
    scrut_type.clone().starts_with("Result_i32_") ||
    scrut_type.clone().starts_with("result:i32:")
}

fn mir_match_has_variant_pattern(node: AstNode, child_count: i32) -> bool {
    let mut arm_scan = 1
    while arm_scan < child_count {
        let scan_arm = ast_node::node_child_at(node, arm_scan)
        if ast_node::node_child_count(scan_arm) > 0 {
            let scan_pat = ast_node::node_child_at(scan_arm, 0)
            if ast_node::node_kind_is(scan_pat, lower_kinds::NK_PAT_VARIANT()) {
                return true
            }
            if ast_node::node_kind_is(scan_pat, lower_kinds::NK_PAT_IDENT()) {
                if mir_ident_is_unit_variant_name(ast_node::node_text(scan_pat)) {
                    return true
                }
            }
            if ast_node::node_kind_is(scan_pat, lower_kinds::NK_PAT_OR()) {
                // Variant alternatives inside an or-arm still require tag
                // extraction on wasm32-gc; without the descent compare_idx
                // stays the scrutinee ref and i32.eq fails validate (#901).
                if mir_pat_or_has_variant_alternative(scan_pat) {
                    return true
                }
            }
        }
        arm_scan = arm_scan + 1
    }
    false
}

fn mir_pat_or_has_variant_alternative(pat: AstNode) -> bool {
    let alt_count = ast_node::node_child_count(pat)
    let mut or_oi = 0
    while or_oi < alt_count {
        let or_alt = ast_node::node_child_at(pat, or_oi)
        if ast_node::node_kind_is(or_alt, lower_kinds::NK_PAT_VARIANT()) {
            return true
        }
        if ast_node::node_kind_is(or_alt, lower_kinds::NK_PAT_IDENT()) {
            if mir_ident_is_unit_variant_name(ast_node::node_text(or_alt)) {
                return true
            }
        }
        or_oi = or_oi + 1
    }
    false
}

fn mir_ident_is_unit_variant_name(name: String) -> bool {
    name.clone().eq(String_from("None")) ||
    name.clone().eq(String_from("Some")) ||
    name.clone().eq(String_from("Ok")) ||
    name.clone().eq(String_from("Err"))
}

fn mir_match_has_payload_pattern(node: AstNode, child_count: i32) -> bool {
    let mut arm_scan = 1
    while arm_scan < child_count {
        let scan_arm = ast_node::node_child_at(node, arm_scan)
        if ast_node::node_child_count(scan_arm) > 0 {
            let scan_pat = ast_node::node_child_at(scan_arm, 0)
            if ast_node::node_kind_is(scan_pat, lower_kinds::NK_PAT_VARIANT()) && ast_node::node_child_count(scan_pat) > 0 {
                return true
            }
        }
        arm_scan = arm_scan + 1
    }
    false
}

fn mir_match_has_record_variant_pattern(ctx: LowerCtx, node: AstNode, child_count: i32) -> bool {
    let mut arm_scan = 1
    while arm_scan < child_count {
        let scan_arm = ast_node::node_child_at(node, arm_scan)
        if ast_node::node_child_count(scan_arm) > 0 {
            let scan_pat = ast_node::node_child_at(scan_arm, 0)
            if mir_pat_is_record_variant(ctx, scan_pat) {
                return true
            }
        }
        arm_scan = arm_scan + 1
    }
    false
}

// Payload-variant registration marks every variant of a record-repr enum on
// wasm32 (`Opt::None` is registered alongside `Opt::Some`), so it is the
// oracle for whether an arm pattern requires tag-field extraction.
fn mir_pat_is_record_variant(ctx: LowerCtx, pat: AstNode) -> bool {
    if ast_node::node_kind_is(pat, lower_kinds::NK_PAT_OR()) {
        let alt_count = ast_node::node_child_count(pat)
        let mut or_oi = 0
        while or_oi < alt_count {
            if mir_pat_is_record_variant(ctx, ast_node::node_child_at(pat, or_oi)) {
                return true
            }
            or_oi = or_oi + 1
        }
        return false
    }
    if !ast_node::node_kind_is(pat, lower_kinds::NK_PAT_VARIANT()) && !ast_node::node_kind_is(pat, lower_kinds::NK_PAT_IDENT()) {
        return false
    }
    ctx_api_variants::ctx_is_payload_variant(ctx, ast_node::node_text(pat))
}

fn mir_emit_payload_tag_local(mut ctx: LowerCtx, scrut_idx: i32) -> i32 {
    let tag_local = ctx_fresh_local(ctx, value_types::VT_I32())
    if ctx_gc_enum::ctx_is_gc_target(ctx) {
        ctx_emit(ctx, inst_gc_struct::MirInst_gc_struct_get(tag_local, scrut_idx, 0 - 1, 0, value_types::VT_I32()))
        return tag_local
    }
    ctx_emit(ctx, inst_local_get::MirInst_local_get(scrut_idx))
    ctx_emit(ctx, inst_struct_get::MirInst_struct_get(0, value_types::VT_VOID()))
    ctx_emit(ctx, inst_local_set::MirInst_local_set(tag_local))
    tag_local
}

// An unannotated fn parameter reaches MIR as a scalar local, but the match
// arms prove its managed type: variant patterns need an enum ref, string
// literal patterns a String ref, and ident.field guards a struct ref.
// Stamp that type back into the signature/local records so the emitted
// func type agrees with the body (#894).
fn mir_fix_unresolved_scrutinee_type(mut ctx: LowerCtx, node: AstNode, child_count: i32, scrut_idx: i32, has_variant_arm: bool) {
    if scrut_idx < 0 {
        return
    }
    if !ctx_gc_enum::ctx_is_gc_target(ctx) {
        return
    }
    if ctx_get_local_type(ctx, scrut_idx).len() > 0 {
        return
    }
    if has_variant_arm {
        let inferred = mir_match_option_scrutinee_type(ctx, node, child_count)
        if inferred.len() > 0 {
            param_sig_infer::mir_stamp_scrutinee_type(ctx, scrut_idx, inferred)
        } else {
            param_sig_infer::mir_stamp_scrutinee_type(ctx, scrut_idx, "enum:open")
        }
        return
    }
    if mir_match_has_string_literal_pattern(node, child_count) {
        param_sig_infer::mir_stamp_scrutinee_type(ctx, scrut_idx, "String")
        return
    }
    let owner = mir_match_guard_struct_owner(ctx, node, child_count)
    if owner.len() > 0 {
        param_sig_infer::mir_stamp_scrutinee_type(ctx, scrut_idx, ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, owner))
        return
    }
    // A plain binding arm that returns its own bind (s => s) returns the
    // scrutinee itself, so an annotated ref return type pins the scrutinee's
    // signature type as well (#894 fn id(s) -> String = s).
    let aliased = mir_match_bind_return_scrutinee_type(ctx, node, child_count)
    if aliased.len() > 0 {
        param_sig_infer::mir_stamp_scrutinee_type(ctx, scrut_idx, aliased)
    }
}

fn mir_match_has_string_literal_pattern(node: AstNode, child_count: i32) -> bool {
    let mut arm_scan = 1
    while arm_scan < child_count {
        let scan_arm = ast_node::node_child_at(node, arm_scan)
        if ast_node::node_child_count(scan_arm) > 0 {
            let scan_pat = ast_node::node_child_at(scan_arm, 0)
            if mir_pat_or_has_string_literal(scan_pat) {
                return true
            }
        }
        arm_scan = arm_scan + 1
    }
    false
}

fn mir_pat_or_has_string_literal(pat: AstNode) -> bool {
    if match_arms::mir_pat_is_string_literal(pat) {
        return true
    }
    if !ast_node::node_kind_is(pat, lower_kinds::NK_PAT_OR()) {
        return false
    }
    let alt_count = ast_node::node_child_count(pat)
    let mut or_oi = 0
    while or_oi < alt_count {
        if match_arms::mir_pat_is_string_literal(ast_node::node_child_at(pat, or_oi)) {
            return true
        }
        or_oi = or_oi + 1
    }
    false
}

fn mir_match_guard_struct_owner(ctx: LowerCtx, node: AstNode, child_count: i32) -> String {
    let mut arm_scan = 1
    while arm_scan < child_count {
        let scan_arm = ast_node::node_child_at(node, arm_scan)
        if ast_node::node_child_count(scan_arm) == 3 {
            let scan_pat = ast_node::node_child_at(scan_arm, 0)
            if ast_node::node_kind_is(scan_pat, lower_kinds::NK_PAT_IDENT()) && mir_pat_is_plain_binding(ctx, scan_pat) {
                let guard = ast_node::node_child_at(scan_arm, 1)
                let owner = mir_guard_ident_field_owner(ctx, guard, ast_node::node_text(scan_pat))
                if owner.len() > 0 {
                    return owner
                }
            }
        }
        arm_scan = arm_scan + 1
    }
    String_new()
}

// Recover an Option scrutinee's element type when a payload bind flows
// straight into the function result: unwrap(Option::Some(v)) -> i32 = v
// implies option:i32, so the Some payload bind must select the i32-payload
// variant layout the caller constructed (#894). User enum variants do not
// need this: their declared payload field types are already concrete.
fn mir_match_option_scrutinee_type(ctx: LowerCtx, node: AstNode, child_count: i32) -> String {
    let f = ctx_current_storage::ctx_current_func_value(ctx)
    let rtn = function_return_view::MirFunction_return_type_name(f)
    if !mir_option_elem_name_is_usable(rtn.clone()) {
        return String_new()
    }
    let mut arm_scan = 1
    while arm_scan < child_count {
        let scan_arm = ast_node::node_child_at(node, arm_scan)
        if mir_arm_is_option_bind_return(scan_arm) {
            return String_from("option:").concat(rtn)
        }
        arm_scan = arm_scan + 1
    }
    String_new()
}

fn mir_option_elem_name_is_usable(type_name: String) -> bool {
    if type_name.len() == 0 {
        return false
    }
    if type_name.clone().eq(String_from("String")) || type_name.clone().eq(String_from("string")) {
        return true
    }
    match_payload_field_type::mir_payload_scalar_type_name(type_name)
}

fn mir_arm_is_option_bind_return(arm: AstNode) -> bool {
    let arm_cc = ast_node::node_child_count(arm)
    if arm_cc < 1 {
        return false
    }
    let pat = ast_node::node_child_at(arm, 0)
    if !ast_node::node_kind_is(pat, lower_kinds::NK_PAT_VARIANT()) || ast_node::node_child_count(pat) != 1 {
        return false
    }
    if !mir_variant_owner_is_option(ast_node::node_text(pat)) {
        return false
    }
    let bind_pat = ast_node::node_child_at(pat, 0)
    if !ast_node::node_kind_is(bind_pat, lower_kinds::NK_PAT_IDENT()) && !ast_node::node_kind_is(bind_pat, lower_kinds::NK_IDENT()) {
        return false
    }
    let body = ast_node::node_child_at(arm, arm_cc - 1)
    if !ast_node::node_kind_is(body, lower_kinds::NK_IDENT()) {
        return false
    }
    ast_node::node_text(body).clone().eq(ast_node::node_text(bind_pat).clone())
}

fn mir_variant_owner_is_option(variant_name: String) -> bool {
    let normalized = ctx_gc_enum::ctx_gc_enum_normalize_variant_name(variant_name.clone())
    normalized.starts_with(String_from("Option::"))
}

// Canonical scrutinee type when an arm binds the scrutinee and returns the
// binding unchanged. Only ref-typed returns are interesting: a scalar
// return keeps the default i64 signature, which is already valid.
fn mir_match_bind_return_scrutinee_type(mut ctx: LowerCtx, node: AstNode, child_count: i32) -> String {
    let f = ctx_current_storage::ctx_current_func_value(ctx)
    let rt = function_return_view::MirFunction_return_type(f)
    if rt != value_types::VT_GC_REF() && rt != value_types::VT_REF() {
        return String_new()
    }
    let rtn = function_return_view::MirFunction_return_type_name(f)
    if rtn.len() == 0 {
        return String_new()
    }
    let mut arm_scan = 1
    while arm_scan < child_count {
        let scan_arm = ast_node::node_child_at(node, arm_scan)
        if mir_arm_is_bind_return_ident(ctx, scan_arm) {
            return ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, rtn)
        }
        arm_scan = arm_scan + 1
    }
    String_new()
}

fn mir_arm_is_bind_return_ident(ctx: LowerCtx, arm: AstNode) -> bool {
    let arm_cc = ast_node::node_child_count(arm)
    if arm_cc < 1 {
        return false
    }
    let pat = ast_node::node_child_at(arm, 0)
    if !ast_node::node_kind_is(pat, lower_kinds::NK_PAT_IDENT()) || !mir_pat_is_plain_binding(ctx, pat) {
        return false
    }
    let body = ast_node::node_child_at(arm, arm_cc - 1)
    if !ast_node::node_kind_is(body, lower_kinds::NK_IDENT()) {
        return false
    }
    ast_node::node_text(body).clone().eq(ast_node::node_text(pat).clone())
}

fn mir_pat_is_plain_binding(ctx: LowerCtx, pat: AstNode) -> bool {
    let name = ast_node::node_text(pat)
    if mir_ident_is_unit_variant_name(name.clone()) {
        return false
    }
    ctx_api_variants::ctx_variant_tag(ctx, name) < 0
}

// Find the struct that owns the field a guard reads through a bound
// scrutinee (pt.x > 0 → field x → owner Point). Nested field bases
// (a.b.c) recurse until the access rooted in the binding ident is found.
fn mir_guard_ident_field_owner(ctx: LowerCtx, expr: AstNode, bind_name: String) -> String {
    if ast_node::node_kind_is(expr, lower_kinds::NK_FIELD_ACCESS()) {
        let base = ast_node::node_child_at(expr, 0)
        if ast_node::node_kind_is(base, lower_kinds::NK_IDENT()) && ast_node::node_text(base).clone().eq(bind_name.clone()) {
            return ctx_struct_lookup_index::ctx_field_owner_struct_name(ctx, ast_node::node_text(expr))
        }
    }
    let cc = ast_node::node_child_count(expr)
    let mut ci = 0
    while ci < cc {
        let owner = mir_guard_ident_field_owner(ctx, ast_node::node_child_at(expr, ci), bind_name.clone())
        if owner.len() > 0 {
            return owner
        }
        ci = ci + 1
    }
    String_new()
}
