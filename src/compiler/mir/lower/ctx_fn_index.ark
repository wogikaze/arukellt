use collections::name_index
use corehir::frontend_decl_kind
use corehir::frontend_ast_node
fn ctx_fn_index_count(ctx: LowerCtx) -> i32 {
    ctx.fn_names.len()
}

fn ctx_fn_index_name_at(ctx: LowerCtx, index: i32) -> String {
    ctx.fn_names.get_unchecked(index).clone()
}

fn ctx_fn_index_return_vt_at(ctx: LowerCtx, index: i32) -> i32 {
    ctx.fn_return_vts.get_unchecked(index)
}

fn ctx_fn_index_return_type_name_at(ctx: LowerCtx, index: i32) -> String {
    ctx.fn_return_type_names.get_unchecked(index).clone()
}

fn ctx_fn_index_find(ctx: LowerCtx, name: String) -> i32 {
    name_index::name_index_get(ctx.fn_name_index, name)
}

fn ctx_qualified_fn_index_find(ctx: LowerCtx, name: String) -> i32 {
    name_index::name_index_get(ctx.qualified_fn_name_index, name)
}

fn ctx_qualified_fn_return_type_name_at(ctx: LowerCtx, index: i32) -> String {
    ctx.qualified_fn_return_type_names.get_unchecked(index).clone()
}

fn ctx_fn_index_replace(
    mut ctx: LowerCtx,
    fn_names: Vec<String>,
    fn_return_vts: Vec<i32>,
    fn_return_type_names: Vec<String>,
    priority_fn_indices: Vec<i32>
) {
    ctx.fn_names = fn_names
    ctx.fn_return_vts = fn_return_vts
    ctx.fn_return_type_names = fn_return_type_names
    let count = fn_names.len()
    let mut index = name_index::NameIndex_new(count)
    // Entry-module generic decls claim their bare names before the in-order
    // pass. Loaded modules are listed first and insert_first keeps the first
    // writer, so an imported concrete decl sharing the name
    // (std::core::identity(i32) vs fn identity<T>) would own the slot and
    // bare-name return lookups would read the imported signature. This
    // mirrors the typechecker's build_fn_sig_index priority (#914).
    let priority_count = priority_fn_indices.len()
    let mut p = 0
    while p < priority_count {
        let priority_index = priority_fn_indices.get_unchecked(p)
        if priority_index >= 0 && priority_index < count {
            name_index::name_index_insert_first(
                index,
                fn_names.get_unchecked(priority_index).clone(),
                priority_index
            )
        }
        p = p + 1
    }
    let mut lengths = Vec::new<i32>()
    let mut i = 0
    while i < count {
        let name = fn_names.get_unchecked(i).clone()
        lengths.push(name.clone().len())
        name_index::name_index_insert_first(index, name, i)
        i = i + 1
    }
    ctx.fn_name_lengths = lengths
    ctx.fn_name_index = index
}

fn ctx_qualified_fn_index_replace(
    mut ctx: LowerCtx,
    names: Vec<String>,
    return_vts: Vec<i32>,
    return_type_names: Vec<String>
) {
    ctx.qualified_fn_names = names
    ctx.qualified_fn_return_vts = return_vts
    ctx.qualified_fn_return_type_names = return_type_names
    let count = names.len()
    let mut index = name_index::NameIndex_new(count)
    let mut i = 0
    while i < count {
        name_index::name_index_insert_first(index, names.get_unchecked(i).clone(), i)
        i = i + 1
    }
    ctx.qualified_fn_name_index = index
}

fn ctx_fn_index_push(mut ctx: LowerCtx, name: String, return_vt: i32, return_type_name: String) {
    let index = ctx.fn_names.len()
    name_index::name_index_insert_first(ctx.fn_name_index, name.clone(), index)
    ctx.fn_name_lengths.push(name.clone().len())
    ctx.fn_names.push(name)
    ctx.fn_return_vts.push(return_vt)
    ctx.fn_return_type_names.push(return_type_name)
}

fn ctx_set_const_names(mut ctx: LowerCtx, decls: Vec<AstNode>) {
    ctx.const_names = Vec::new<String>()
    let mut i = 0
    while i < decls.len() {
        let decl = decls.get_unchecked(i)
        if frontend_decl_kind::corehir_kind_is_decl_const(frontend_ast_node::corehir_node_kind(decl)) {
            ctx.const_names.push(frontend_ast_node::corehir_node_text(decl))
        }
        i = i + 1
    }
}

fn ctx_is_const_name(ctx: LowerCtx, name: String) -> bool {
    let mut i = ctx.const_names.len() - 1
    while i >= 0 {
        if ctx.const_names.get_unchecked(i).eq(name.clone()) {
            return true
        }
        i = i - 1
    }
    false
}
