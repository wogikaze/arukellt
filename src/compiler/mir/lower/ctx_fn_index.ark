use collections::name_index
use corehir::frontend_ast_node
use parser::kinds

fn ctx_fn_index_count(ctx: LowerCtx) -> i32 {
    len(ctx.fn_names)
}

fn ctx_fn_index_name_at(ctx: LowerCtx, index: i32) -> String {
    clone(get_unchecked(ctx.fn_names, index))
}

fn ctx_fn_index_return_vt_at(ctx: LowerCtx, index: i32) -> i32 {
    get_unchecked(ctx.fn_return_vts, index)
}

fn ctx_fn_index_return_type_name_at(ctx: LowerCtx, index: i32) -> String {
    clone(get_unchecked(ctx.fn_return_type_names, index))
}

fn ctx_fn_index_find(ctx: LowerCtx, name: String) -> i32 {
    name_index::name_index_get(ctx.fn_name_index, name)
}

fn ctx_qualified_fn_index_find(ctx: LowerCtx, name: String) -> i32 {
    name_index::name_index_get(ctx.qualified_fn_name_index, name)
}

fn ctx_qualified_fn_return_type_name_at(ctx: LowerCtx, index: i32) -> String {
    clone(get_unchecked(ctx.qualified_fn_return_type_names, index))
}

fn ctx_fn_index_replace(ctx: LowerCtx, fn_names: Vec<String>, fn_return_vts: Vec<i32>, fn_return_type_names: Vec<String>) {
    ctx.fn_names = fn_names
    ctx.fn_return_vts = fn_return_vts
    ctx.fn_return_type_names = fn_return_type_names
    let count = len(fn_names)
    let index = name_index::NameIndex_new(count)
    let mut lengths = Vec::new<i32>()
    let mut i = 0
    while i < count {
        let name = clone(get_unchecked(fn_names, i))
        push(lengths, len(clone(name)))
        name_index::name_index_insert_first(index, name, i)
        i = i + 1
    }
    ctx.fn_name_lengths = lengths
    ctx.fn_name_index = index
}

fn ctx_qualified_fn_index_replace(
    ctx: LowerCtx,
    names: Vec<String>,
    return_vts: Vec<i32>,
    return_type_names: Vec<String>
) {
    ctx.qualified_fn_names = names
    ctx.qualified_fn_return_vts = return_vts
    ctx.qualified_fn_return_type_names = return_type_names
    let count = len(names)
    let index = name_index::NameIndex_new(count)
    let mut i = 0
    while i < count {
        name_index::name_index_insert_first(index, clone(get_unchecked(names, i)), i)
        i = i + 1
    }
    ctx.qualified_fn_name_index = index
}

fn ctx_fn_index_push(ctx: LowerCtx, name: String, return_vt: i32, return_type_name: String) {
    let index = len(ctx.fn_names)
    name_index::name_index_insert_first(ctx.fn_name_index, clone(name), index)
    push(ctx.fn_name_lengths, len(clone(name)))
    push(ctx.fn_names, name)
    push(ctx.fn_return_vts, return_vt)
    push(ctx.fn_return_type_names, return_type_name)
}

fn ctx_set_const_names(ctx: LowerCtx, decls: Vec<AstNode>) {
    ctx.const_names = Vec::new<String>()
    let mut i = 0
    while i < len(decls) {
        let decl = get_unchecked(decls, i)
        if frontend_ast_node::corehir_node_kind(decl) == kinds::NK_CONST_DECL() {
            push(ctx.const_names, frontend_ast_node::corehir_node_text(decl))
        }
        i = i + 1
    }
}

fn ctx_is_const_name(ctx: LowerCtx, name: String) -> bool {
    let mut i = len(ctx.const_names) - 1
    while i >= 0 {
        if eq(get_unchecked(ctx.const_names, i), clone(name)) {
            return true
        }
        i = i - 1
    }
    false
}
