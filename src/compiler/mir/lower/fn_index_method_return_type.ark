use mir::lower::mono_suffix_parse
use mir::lower_kinds
use mir::type_contracts
use mir::value_types
fn method_generic_return_type_from_name(type_name: String, has_mono_variants: bool) -> TypeInfo {
    if type_name.len() == 0 && has_mono_variants {
        return type_contracts::TypeInfo_new(lower_kinds::TY_TYPE_VAR(), "T", Vec::new<TypeInfo>())
    }
    method_return_type_info_from_name(type_name)
}

fn method_return_type_info_from_name(type_name: String) -> TypeInfo {
    if type_name.len() == 0 {
        return type_contracts::TypeInfo_simple(0)
    }
    if type_name.clone().eq("i32") ||
    type_name.clone().eq("u32") ||
    type_name.clone().eq("u8") ||
    type_name.clone().eq("u16") ||
    type_name.clone().eq("i16") ||
    type_name.clone().eq("i8") {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_I32())
    }
    if type_name.clone().eq("i64") || type_name.clone().eq("u64") {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_I64())
    }
    if type_name.clone().eq("f64") {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_F64())
    }
    if type_name.clone().eq("f32") {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_F32())
    }
    if type_name.clone().eq("v128") {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_V128())
    }
    if type_name.clone().eq("bool") {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_BOOL())
    }
    if type_name.clone().eq("char") {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_CHAR())
    }
    if type_name.clone().eq("String") || type_name.clone().eq("string") {
        return type_contracts::TypeInfo_new(lower_kinds::TY_STRING(), "String", Vec::new<TypeInfo>())
    }
    if type_name.clone().starts_with("vec:") {
        return type_contracts::TypeInfo_new(lower_kinds::TY_VEC(), type_name.clone(), Vec::new<TypeInfo>())
    }
    // Only a `?` marker is a type variable here. A method's declared type
    // parameters are spelled empty by return_index_type_name, so any
    // remaining name is a concrete nominal type, including a one-character
    // struct (ADR-089).
    if type_name.clone().starts_with("?") {
        return type_contracts::TypeInfo_new(lower_kinds::TY_TYPE_VAR(), type_name.clone(), Vec::new<TypeInfo>())
    }
    type_contracts::TypeInfo_new(lower_kinds::TY_STRUCT(), type_name.clone(), Vec::new<TypeInfo>())
}

// Resolve a generic method mono return from the mangled function name suffix
// (e.g. Picker__echo__String → "String" when the generic return is T).
fn method_concrete_return_from_mono_fn_name(fn_name: String, generic_return_name: String) -> String {
    let mut var_name = generic_return_name.clone()
    if var_name.len() == 0 {
        var_name = "T"
    } else if var_name.clone().starts_with("?") {
        var_name = var_name.slice(1, var_name.len())
    } else {
        // A concrete return name is not substituted from the mono suffix.
        return String_new()
    }
    let suffix = mono_suffix_parse::extract_mono_suffix(fn_name.clone())
    if suffix.len() == 0 {
        return String_new()
    }
    let keys = mono_suffix_parse::split_mono_suffix(suffix.clone())
    let key_count = keys.len()
    if key_count <= 0 {
        return String_new()
    }
    if key_count == 1 {
        return get_unchecked(keys, 0)
    }
    let idx = mono_suffix_parse::mono_type_var_to_index(var_name.clone())
    if idx >= 0 && idx < key_count {
        return get_unchecked(keys, idx)
    }
    get_unchecked(keys, key_count - 1)
}

fn method_return_vt_from_type_name(type_name: String) -> i32 {
    if type_name.clone().eq("i32") ||
    type_name.clone().eq("u32") ||
    type_name.clone().eq("u8") ||
    type_name.clone().eq("u16") ||
    type_name.clone().eq("i16") ||
    type_name.clone().eq("i8") ||
    type_name.clone().eq("bool") ||
    type_name.clone().eq("char") {
        return value_types::VT_I32()
    }
    if type_name.clone().eq("i64") || type_name.clone().eq("u64") {
        return value_types::VT_I64()
    }
    if type_name.clone().eq("f64") {
        return value_types::VT_F64()
    }
    if type_name.clone().eq("f32") {
        return value_types::VT_F32()
    }
    if type_name.clone().eq("v128") {
        return value_types::VT_V128()
    }
    if type_name.clone().eq("String") || type_name.clone().eq("string") {
        return value_types::VT_REF()
    }
    if type_name.clone().eq("fnref") ||
    type_name.clone().eq("fn") ||
    type_name.clone().starts_with("fn(") {
        return value_types::VT_FUNCREF()
    }
    value_types::VT_GC_REF()
}
