use mir::lower::ast_node
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_variants
use mir::lower::ctx_gc_enum
use mir::lower::ctx_types
use mir::lower_kinds
use mir::inst_const_i32
use mir::inst_factory
use mir::inst_local_get
use mir::inst_local_set
use mir::inst_op
use mir::opcodes
use mir::lower::match_arms
use mir::lower::match_subpat
use mir::lower::match_payload_fields
use mir::lower::match_payload_prepare
use mir::lower::stmt_let_tuple
use mir::value_types

// Emit the arm-head tuple condition: destructure the scrutinee tuple into
// element locals and AND-fold one compare per checked element so the arm
// if consumes a single i32 like other arm conditions (#893).
// Returns a local holding the folded result; callers load it before IF so
// guarded and unguarded arm shapes share one emission form.
fn emit_tuple_arm_condition(mut ctx: LowerCtx, pat: AstNode, scrut_idx: i32) -> i32 {
    let elem_count = ast_node::node_child_count(pat)
    let mut has_cmp = false
    let mut ei = 0
    while ei < elem_count {
        let sub = ast_node::node_child_at(pat, ei)
        if emit_tuple_elem_condition(ctx, sub, scrut_idx, ei, elem_count) {
            if has_cmp {
                let and_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
                ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_BIT_AND(), and_dest, and_dest, and_dest))
            }
            has_cmp = true
        }
        ei = ei + 1
    }
    if !has_cmp {
        // All-bind / wildcard-only tuple arms match unconditionally; keep the
        // shared if/else arm skeleton by feeding if a constant-true value.
        let one = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
        ctx_api_emit::ctx_emit(ctx, inst_const_i32::MirInst_const_i32(1, one))
    }
    let cond = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set(cond))
    cond
}

// Emit ident and variant payload binds for a matched tuple arm. Call after
// the arm if opens so guards and bodies resolve the bound names (#893).
fn emit_tuple_arm_binds(mut ctx: LowerCtx, pat: AstNode, scrut_idx: i32) {
    let elem_count = ast_node::node_child_count(pat)
    let mut ei = 0
    while ei < elem_count {
        let sub = ast_node::node_child_at(pat, ei)
        if ast_node::node_kind_is(sub, lower_kinds::NK_PAT_IDENT()) {
            let name = ast_node::node_text(sub)
            if !name.clone().eq("_") && ctx_api_variants::ctx_variant_tag(ctx, name.clone()) < 0 {
                emit_tuple_elem_ident_bind(ctx, name.clone(), scrut_idx, ei, elem_count)
            }
        }
        if ast_node::node_kind_is(sub, lower_kinds::NK_PAT_VARIANT()) {
            emit_tuple_elem_variant_binds(ctx, sub, scrut_idx, ei, elem_count)
        }
        ei = ei + 1
    }
}

// One element compare contribution. Returns true when a condition value
// was pushed; wildcard / pure-bind elements contribute nothing.
fn emit_tuple_elem_condition(mut ctx: LowerCtx, sub: AstNode, scrut_idx: i32, elem_index: i32, elem_count: i32) -> bool {
    if ast_node::node_kind_is(sub, lower_kinds::NK_PAT_WILDCARD()) {
        return false
    }
    if ast_node::node_kind_is(sub, lower_kinds::NK_PAT_IDENT()) {
        let name = ast_node::node_text(sub)
        if name.clone().eq("_") {
            return false
        }
        if ctx_api_variants::ctx_variant_tag(ctx, name.clone()) < 0 {
            return false
        }
        return emit_tuple_elem_variant_compare(ctx, sub, scrut_idx, elem_index, elem_count)
    }
    if ast_node::node_kind_is(sub, lower_kinds::NK_PAT_VARIANT()) {
        return emit_tuple_elem_variant_compare(ctx, sub, scrut_idx, elem_index, elem_count)
    }
    if ast_node::node_kind_is(sub, lower_kinds::NK_PAT_LITERAL()) {
        let elem_local = stmt_let_tuple::emit_tuple_element_extract(ctx, scrut_idx, elem_index, elem_count)
        if match_arms::mir_pat_is_string_literal(sub) {
            let _str_cmp = match_arms::mir_emit_string_pattern_compare(ctx, elem_local, sub)
            return true
        }
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(elem_local))
        let pat_idx = lower_expr(ctx, sub)
        let cmp_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
        ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_EQ(), cmp_dest, elem_local, pat_idx))
        return true
    }
    if ast_node::node_kind_is(sub, lower_kinds::NK_PAT_OR()) {
        return emit_tuple_elem_or_condition(ctx, sub, scrut_idx, elem_index, elem_count)
    }
    // Nested tuple/struct element shapes are rejected by the typechecker;
    // trap defensively so a stray pipeline cannot emit invalid Wasm (#893).
    ctx_api_emit::ctx_emit(ctx, inst_factory::MirInst_new(opcodes::MIR_UNREACHABLE()))
    false
}

// Variant element compare: record-repr enums compare the extracted tag
// field, bare-tag enums compare the element value itself, the same split
// prepare_match_payload makes between has_variant_arm and
// has_record_variant_arm on wasm32; wasm32-gc values are always refs.
// Elements with literal/composite payload children emit the guarded flag
// form so payload reads stay inside the tag-true branch (#902).
fn emit_tuple_elem_variant_compare(mut ctx: LowerCtx, sub: AstNode, scrut_idx: i32, elem_index: i32, elem_count: i32) -> bool {
    let vname = ast_node::node_text(sub)
    let tag = ctx_api_variants::ctx_variant_tag(ctx, vname.clone())
    if tag < 0 {
        return false
    }
    let elem_local = stmt_let_tuple::emit_tuple_element_extract(ctx, scrut_idx, elem_index, elem_count)
    if ast_node::node_kind_is(sub, lower_kinds::NK_PAT_VARIANT()) &&
    match_subpat::mir_variant_pat_has_checked_children(ctx, sub) {
        let flag = match_subpat::mir_emit_variant_subpat_flag_tagged(ctx, sub, elem_local, 0 - 1)
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(flag))
        return true
    }
    let mut compare_idx = elem_local
    if ctx_gc_enum::ctx_is_gc_target(ctx) || ctx_api_variants::ctx_is_payload_variant(ctx, vname.clone()) {
        compare_idx = match_payload_prepare::mir_emit_payload_tag_local(ctx, elem_local)
    }
    ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(compare_idx))
    let tag_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_const_i32::MirInst_const_i32(tag, tag_dest))
    let cmp_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_EQ(), cmp_dest, compare_idx, tag_dest))
    true
}

// Or-pattern element: all-literal alternatives compare the element value,
// all-variant alternatives compare its tag. Mixed or nested alternatives
// are rejected by the typechecker; the trap keeps stray pipelines safe.
fn emit_tuple_elem_or_condition(mut ctx: LowerCtx, sub: AstNode, scrut_idx: i32, elem_index: i32, elem_count: i32) -> bool {
    let alt_count = ast_node::node_child_count(sub)
    let mut has_variant_alt = false
    let mut has_literal_alt = false
    let mut unsupported = false
    let mut ai = 0
    while ai < alt_count {
        let alt = ast_node::node_child_at(sub, ai)
        if ast_node::node_kind_is(alt, lower_kinds::NK_PAT_LITERAL()) {
            has_literal_alt = true
        } else if ast_node::node_kind_is(alt, lower_kinds::NK_PAT_VARIANT()) {
            has_variant_alt = true
        } else if ast_node::node_kind_is(alt, lower_kinds::NK_PAT_IDENT()) {
            if ctx_api_variants::ctx_variant_tag(ctx, ast_node::node_text(alt)) >= 0 {
                has_variant_alt = true
            } else {
                unsupported = true
            }
        } else {
            unsupported = true
        }
        ai = ai + 1
    }
    if unsupported || (has_variant_alt && has_literal_alt) {
        ctx_api_emit::ctx_emit(ctx, inst_factory::MirInst_new(opcodes::MIR_UNREACHABLE()))
        return false
    }
    let elem_local = stmt_let_tuple::emit_tuple_element_extract(ctx, scrut_idx, elem_index, elem_count)
    let mut compare_idx = elem_local
    if has_variant_alt {
        if ctx_gc_enum::ctx_is_gc_target(ctx) || tuple_or_alt_is_record_variant(ctx, sub) {
            compare_idx = match_payload_prepare::mir_emit_payload_tag_local(ctx, elem_local)
        }
    }
    let mut or_oi = 0
    let mut or_prev_cmp = 0 - 1
    while or_oi < alt_count {
        let or_alt = ast_node::node_child_at(sub, or_oi)
        let mut or_cmp = 0 - 1
        if ast_node::node_kind_is(or_alt, lower_kinds::NK_PAT_VARIANT()) &&
        match_subpat::mir_variant_pat_has_checked_children(ctx, or_alt) {
            // Variant alternatives with checked payload children carry
            // their own guarded flag; it folds into the same OR
            // accumulator as the flat compares, so the flag local is
            // pushed to feed BIT_OR (#902).
            or_cmp = match_subpat::mir_emit_variant_subpat_flag_tagged(ctx, or_alt, elem_local, compare_idx)
            ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(or_cmp))
        } else if match_arms::mir_pat_is_string_literal(or_alt) {
            or_cmp = match_arms::mir_emit_string_pattern_compare(ctx, compare_idx, or_alt)
        } else {
            ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(compare_idx))
            let or_pat_idx = lower_expr(ctx, or_alt)
            or_cmp = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
            ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_EQ(), or_cmp, compare_idx, or_pat_idx))
        }
        if or_oi > 0 {
            let or_acc = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
            ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_BIT_OR(), or_acc, or_prev_cmp, or_cmp))
            or_prev_cmp = or_acc
        } else {
            or_prev_cmp = or_cmp
        }
        or_oi = or_oi + 1
    }
    true
}

fn tuple_or_alt_is_record_variant(ctx: LowerCtx, sub: AstNode) -> bool {
    let alt_count = ast_node::node_child_count(sub)
    let mut ai = 0
    while ai < alt_count {
        let alt = ast_node::node_child_at(sub, ai)
        if ctx_api_variants::ctx_is_payload_variant(ctx, ast_node::node_text(alt)) {
            return true
        }
        ai = ai + 1
    }
    false
}

// Ident bind for one tuple element: extract the field and copy it into the
// named local, mirroring mir_emit_match_ident_bind's type propagation.
fn emit_tuple_elem_ident_bind(mut ctx: LowerCtx, name: String, scrut_idx: i32, elem_index: i32, elem_count: i32) {
    let elem_local = stmt_let_tuple::emit_tuple_element_extract(ctx, scrut_idx, elem_index, elem_count)
    let bind_vt = ctx_api_local_types::ctx_local_vt(ctx, elem_local)
    let bind_local = ctx_api_local_alloc::ctx_alloc_local(ctx, name.clone(), bind_vt)
    let elem_type = ctx_api_local_types::ctx_get_local_type(ctx, elem_local)
    if len(elem_type) > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, bind_local, elem_type.clone())
        if elem_type.clone().starts_with("enum:") {
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
        }
    }
    ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(elem_local))
    ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set(bind_local))
}

// Variant payload binds for one tuple element. The element local carries
// the tuple field's type name so Option/Result payload inference sees the
// same scrutinee spelling a top-level arm would (#893).
fn emit_tuple_elem_variant_binds(mut ctx: LowerCtx, sub: AstNode, scrut_idx: i32, elem_index: i32, elem_count: i32) {
    if ast_node::node_child_count(sub) == 0 {
        return
    }
    let elem_local = stmt_let_tuple::emit_tuple_element_extract(ctx, scrut_idx, elem_index, elem_count)
    let elem_type = ctx_api_local_types::ctx_get_local_type(ctx, elem_local)
    let is_f64 = match_payload_prepare::mir_option_result_scrut_type_is_f64(elem_type.clone())
    let is_i64 = match_payload_prepare::mir_option_result_scrut_type_is_i64(elem_type.clone())
    let is_i32 = match_payload_prepare::mir_option_result_scrut_type_is_i32(elem_type.clone())
    match_payload_fields::mir_emit_payload_variant_binds(ctx, sub, elem_local, is_f64, is_i64, is_i32)
}
