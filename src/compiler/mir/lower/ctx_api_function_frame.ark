use mir::lower::ctx_locals_fn

fn ctx_push_func_param(mut ctx: LowerCtx, mut ml: MirLocal) { ctx_locals_fn::ctx_push_func_param(ctx, ml) }
fn ctx_set_current_return_type(mut ctx: LowerCtx, vt: i32) { ctx_locals_fn::ctx_set_current_return_type(ctx, vt) }
fn ctx_set_current_return_type_name(mut ctx: LowerCtx, type_name: String) { ctx_locals_fn::ctx_set_current_return_type_name(ctx, type_name) }
fn ctx_current_return_type(ctx: LowerCtx) -> i32 { ctx_locals_fn::ctx_current_return_type(ctx) }
fn ctx_apply_fn_return_type_for_rt_tag(mut ctx: LowerCtx, rt_tag: i32) { ctx_locals_fn::ctx_apply_fn_return_type_for_rt_tag(ctx, rt_tag) }
fn ctx_set_func_param_type(mut ctx: LowerCtx, param_ordinal: i32, pvt: i32, type_name: String) { ctx_locals_fn::ctx_set_func_param_type(ctx, param_ordinal, pvt, type_name) }
fn ctx_set_func_param_sig_type(mut ctx: LowerCtx, param_ordinal: i32, pvt: i32, type_name: String) { ctx_locals_fn::ctx_set_func_param_sig_type(ctx, param_ordinal, pvt, type_name) }
