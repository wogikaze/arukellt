use mir::lower::ctx_api_nesting
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_variants
use mir::lower::ctx_types
use mir::inst_const_i32
use mir::inst_local_get
use mir::inst_local_set
use mir::inst_op
use mir::inst_structured_control
use mir::opcodes
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_patterns
use mir::lower::core_match_patterns
use mir::lower::core_match_payload_bind_core
use mir::lower::core_match_payload_bind_types
use mir::lower::core_match_payload_info
use mir::lower::match_arms
use mir::lower::match_payload_prepare
use mir::lower::stmt_let_tuple
use mir::value_types

// CoreHIR mirror of match_subpat (#902): payload sub-pattern conditions.
// See match_subpat.ark for the semantics — composite checks emit a
// guarded flag so payload reads stay inside the enclosing tag-true
// branch on both backends. Condition helpers leave exactly one i32 on
// the operand stack and return the local it materializes into.

fn core_subpat_child_is_condition(ctx: LowerCtx, exprs: Vec<CoreHirExpr>, pat: CoreHirExpr) -> bool {
    if core_expr_shape_patterns::mir_core_expr_is_pat_literal(pat) ||
    core_expr_shape_patterns::mir_core_expr_is_pat_variant(pat) ||
    core_expr_shape_patterns::mir_core_expr_is_pat_tuple(pat) ||
    core_expr_shape_patterns::mir_core_expr_is_pat_or(pat) {
        return true
    }
    if core_expr_shape_patterns::mir_core_expr_is_pat_ident(pat) {
        let name = core_expr_shape_accessors::mir_core_expr_text(pat)
        if name.clone().eq("_") {
            return false
        }
        return ctx_api_variants::ctx_variant_tag(ctx, name) >= 0
    }
    false
}

fn core_variant_pat_has_checked_children(ctx: LowerCtx, exprs: Vec<CoreHirExpr>, pat: CoreHirExpr) -> bool {
    let count = core_expr_shape_accessors::mir_core_expr_child_count(pat)
    let mut i = 0
    while i < count {
        let child = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(pat, i))
        if core_subpat_child_is_condition(ctx, exprs, child) {
            return true
        }
        i = i + 1
    }
    false
}

fn core_emit_subpat_cond(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, pat: CoreHirExpr, val_idx: i32) -> i32 {
    if core_expr_shape_patterns::mir_core_expr_is_pat_literal(pat) {
        if core_match_patterns::mir_core_pat_is_string_literal(pat) {
            let cmp = match_arms::mir_emit_string_pattern_compare_text(
                ctx,
                val_idx,
                core_expr_shape_accessors::mir_core_expr_text(pat)
            )
            ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(cmp))
            return cmp
        }
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(val_idx))
        let lit_idx = core_match_patterns::lower_core_pattern_value(ctx, pat)
        let cmp_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
        ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_EQ(), cmp_dest, val_idx, lit_idx))
        return cmp_dest
    }
    if core_expr_shape_patterns::mir_core_expr_is_pat_ident(pat) {
        let name = core_expr_shape_accessors::mir_core_expr_text(pat)
        let tag = ctx_api_variants::ctx_variant_tag(ctx, name.clone())
        if tag >= 0 {
            return core_emit_tag_compare_cond(ctx, val_idx, tag)
        }
        return core_const_true_cond(ctx)
    }
    if core_expr_shape_patterns::mir_core_expr_is_pat_variant(pat) {
        let flag = core_emit_variant_subpat_flag_tagged(ctx, exprs, pat, val_idx, 0 - 1)
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(flag))
        return flag
    }
    if core_expr_shape_patterns::mir_core_expr_is_pat_tuple(pat) {
        return core_emit_tuple_subpat_cond(ctx, exprs, pat, val_idx)
    }
    if core_expr_shape_patterns::mir_core_expr_is_pat_or(pat) {
        let alt_count = core_expr_shape_accessors::mir_core_expr_child_count(pat)
        let mut acc = 0 - 1
        let mut ai = 0
        while ai < alt_count {
            let alt = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(pat, ai))
            let alt_cond = core_emit_subpat_cond(ctx, exprs, alt, val_idx)
            if ai > 0 {
                let or_acc = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
                ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_BIT_OR(), or_acc, acc, alt_cond))
                acc = or_acc
            } else {
                acc = alt_cond
            }
            ai = ai + 1
        }
        if acc < 0 {
            return core_const_true_cond(ctx)
        }
        return acc
    }
    core_const_true_cond(ctx)
}

fn core_emit_variant_subpat_flag_tagged(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, pat: CoreHirExpr, val_idx: i32, known_tag_idx: i32) -> i32 {
    let variant_name = core_expr_shape_accessors::mir_core_expr_text(pat)
    let flag = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_const_i32::MirInst_const_i32(0, flag))
    ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set(flag))
    let mut tag_idx = known_tag_idx
    if tag_idx < 0 {
        tag_idx = core_match_payload_info::core_emit_payload_tag_local(ctx, val_idx)
    }
    ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(tag_idx))
    let tag = ctx_api_variants::ctx_variant_tag(ctx, variant_name.clone())
    let tag_const = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_const_i32::MirInst_const_i32(tag, tag_const))
    let tag_cmp = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_EQ(), tag_cmp, tag_idx, tag_const))
    ctx_api_emit::ctx_emit(ctx, inst_structured_control::MirInst_if())
    let _core_subpat_tag_nesting = ctx_api_nesting::ctx_push_nesting(ctx)
    // Payload-field reads belong to this variant's layout only while the
    // tag check holds; every child load stays inside the if (#902).
    let scrut_type = ctx_api_local_types::ctx_get_local_type(ctx, val_idx)
    let is_f64 = match_payload_prepare::mir_option_result_scrut_type_is_f64(scrut_type.clone())
    let is_i64 = match_payload_prepare::mir_option_result_scrut_type_is_i64(scrut_type.clone())
    let is_i32 = match_payload_prepare::mir_option_result_scrut_type_is_i32(scrut_type.clone())
    let is_ref = core_match_payload_info::core_scrut_type_is_ref(scrut_type.clone())
    let mut cond_count = 0
    let mut acc = 0 - 1
    let count = core_expr_shape_accessors::mir_core_expr_child_count(pat)
    let mut i = 0
    while i < count {
        let child = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(pat, i))
        if !core_subpat_child_is_condition(ctx, exprs, child) {
            i = i + 1
            continue
        }
        let field_local = core_match_payload_bind_core::core_subpat_load_field(
            ctx,
            variant_name.clone(),
            val_idx,
            i,
            is_f64,
            is_i64,
            is_i32,
            is_ref,
            scrut_type.clone()
        )
        let child_cond = core_emit_subpat_cond(ctx, exprs, child, field_local)
        if cond_count > 0 {
            let and_acc = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
            ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_BIT_AND(), and_acc, acc, child_cond))
            acc = and_acc
        } else {
            acc = child_cond
        }
        cond_count = cond_count + 1
        i = i + 1
    }
    if cond_count == 0 {
        let one = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
        ctx_api_emit::ctx_emit(ctx, inst_const_i32::MirInst_const_i32(1, one))
        acc = one
    }
    ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set(flag))
    ctx_api_emit::ctx_emit(ctx, inst_structured_control::MirInst_end())
    let _core_subpat_tag_nesting_after = ctx_api_nesting::ctx_pop_nesting(ctx)
    flag
}

fn core_emit_tuple_subpat_cond(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, pat: CoreHirExpr, val_idx: i32) -> i32 {
    let count = core_expr_shape_accessors::mir_core_expr_child_count(pat)
    let mut cond_count = 0
    let mut acc = 0 - 1
    let mut i = 0
    while i < count {
        let elem = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(pat, i))
        if !core_subpat_child_is_condition(ctx, exprs, elem) {
            i = i + 1
            continue
        }
        let elem_local = stmt_let_tuple::emit_tuple_element_extract(ctx, val_idx, i, count)
        let elem_cond = core_emit_subpat_cond(ctx, exprs, elem, elem_local)
        if cond_count > 0 {
            let and_acc = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
            ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_BIT_AND(), and_acc, acc, elem_cond))
            acc = and_acc
        } else {
            acc = elem_cond
        }
        cond_count = cond_count + 1
        i = i + 1
    }
    if cond_count == 0 {
        return core_const_true_cond(ctx)
    }
    acc
}

fn core_emit_tag_compare_cond(mut ctx: LowerCtx, val_idx: i32, tag: i32) -> i32 {
    let tag_idx = core_match_payload_info::core_emit_payload_tag_local(ctx, val_idx)
    ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(tag_idx))
    let tag_const = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_const_i32::MirInst_const_i32(tag, tag_const))
    let cmp_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_EQ(), cmp_dest, tag_idx, tag_const))
    cmp_dest
}

fn core_const_true_cond(mut ctx: LowerCtx) -> i32 {
    let one = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_const_i32::MirInst_const_i32(1, one))
    one
}
