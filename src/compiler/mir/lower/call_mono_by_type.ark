use std::text
use mir::lower::ctx_fn_exists
use mir::lower::ctx_api_local_types
use mir::value_types
use mir::mono
fn mir_resolve_mono_call_by_type(ctx: LowerCtx, resolved: String, first_arg_idx: i32) -> String {
    let mut out = call_mono_by_type_strip_module_prefix(resolved.clone())
    if first_arg_idx < 0 {
        return out
    }
    let mono_arg_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
    let mut mono_type_key = mono_arg_type.clone()
    if mono_arg_type.clone().starts_with("vec:") {
        mono_type_key = mono_type_key_from_local_type_name(mono_arg_type.slice(4, mono_arg_type.len()))
    }
    if mono_type_key.clone().starts_with("Option:") {
        mono_type_key = mono_type_key.clone().slice(7, mono_type_key.len())
    }
    if mono_type_key.clone().starts_with("option:") {
        mono_type_key = mono_type_key.clone().slice(7, mono_type_key.len())
    }
    if mono_type_key.clone().starts_with("Option_") {
        mono_type_key = mono_type_key.clone().slice(7, mono_type_key.len())
    }
    if mono_type_key.clone().starts_with("enum:") {
        mono_type_key = mono_type_key.clone().slice(5, mono_type_key.len())
    }
    if mono_type_key.len() == 0 {
        return out
    }
    let mono_candidate = mono::mono_safe_name(out.clone().concat("__".concat(mono_type_key)))
    if ctx_fn_exists::ctx_has_fn_name(ctx, mono_candidate.clone()) {
        return mono_candidate
    }
    let type_method = mono_type_key.clone().concat("::".concat(out.clone()))
    if ctx_fn_exists::ctx_has_fn_name(ctx, type_method.clone()) {
        return type_method
    }
    if mono_type_key.clone().eq("string") {
        let mono_candidate_string = mono::mono_safe_name(out.clone().concat("__String"))
        if ctx_fn_exists::ctx_has_fn_name(ctx, mono_candidate_string.clone()) {
            return mono_candidate_string
        }
    }
    let special = resolve_special_mono_target(ctx, out.clone(), mono_type_key.clone(), first_arg_idx)
    if special.len() > 0 {
        return special
    }
    out
}

fn resolve_special_mono_target(ctx: LowerCtx, out: String, mono_type_key: String, first_arg_idx: i32) -> String {
    // ADR-040 Phase 5: format_debug<T> / format_debug__?t0 defers to
    // T::fmt_debug. Type-var mono shells must not stay as unreachable stubs.
    if out.clone().eq("format_debug") || out.clone().starts_with("format_debug__") {
        let mut key = mono_type_key.clone()
        if key.len() == 0 || key.clone().starts_with("?") {
            key = call_mono_by_type_scalar_key_from_local(ctx, first_arg_idx)
        }
        if key.clone().eq("string") {
            key = "String"
        }
        if key.len() > 0 && !key.clone().starts_with("?") {
            let trait_method = key.clone().concat("::fmt_debug")
            if ctx_fn_exists::ctx_has_fn_name(ctx, trait_method.clone()) {
                return trait_method
            }
        }
    }
    // write_debug_to__?t0 → write_debug_to__i32 / __String (value type key).
    if out.clone().eq("write_debug_to") || out.clone().starts_with("write_debug_to__") {
        let mut key = mono_type_key.clone()
        if key.len() == 0 || key.clone().starts_with("?") {
            key = call_mono_by_type_scalar_key_from_local(ctx, first_arg_idx)
        }
        if key.clone().eq("string") {
            key = "String"
        }
        if key.len() > 0 && !key.clone().starts_with("?") {
            let mono_candidate = mono::mono_safe_name("write_debug_to__".concat(key))
            if ctx_fn_exists::ctx_has_fn_name(ctx, mono_candidate.clone()) {
                return mono_candidate
            }
        }
    }
    String_new()
}

fn call_mono_by_type_scalar_key_from_local(ctx: LowerCtx, arg_idx: i32) -> String {
    let vt = ctx_api_local_types::ctx_local_vt(ctx, arg_idx)
    if vt == value_types::VT_I32() {
        return "i32"
    }
    if vt == value_types::VT_I64() {
        return "i64"
    }
    if vt == value_types::VT_F64() {
        return "f64"
    }
    if vt == value_types::VT_GC_REF() || vt == value_types::VT_REF() {
        let tn = ctx_api_local_types::ctx_get_local_type(ctx, arg_idx)
        if tn.clone().eq("string") || tn.clone().eq("String") {
            return "String"
        }
        if tn.clone().eq("bool") || tn.clone().eq("Bool") {
            return "bool"
        }
        if tn.clone().eq("char") {
            return "char"
        }
    }
    String_new()
}

fn mono_type_key_from_local_type_name(type_name: String) -> String {
    if type_name.clone().starts_with("vec:") {
        let inner = mono_type_key_from_local_type_name(type_name.clone().slice(4, type_name.len()))
        return "Vec<".concat(inner.concat(">"))
    }
    if type_name.clone().eq("Vec") {
        return "Vec<i32>"
    }
    type_name
}

fn call_mono_by_type_strip_module_prefix(name: String) -> String {
    let n = name.len()
    let mut i = n - 1
    while i > 0 {
        if name.byte_at(i) == 58 && name.byte_at(i - 1) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    name.clone()
}
