use mir::lower::ctx_fn_exists
use mir::lower::ctx_api_local_types
use mir::value_types
use mir::mono

fn mir_resolve_mono_call_by_type(ctx: LowerCtx, resolved: String, first_arg_idx: i32) -> String {
    let mut out = call_mono_by_type_strip_module_prefix(clone(resolved))
    if first_arg_idx < 0 {
        return out
    }
    let mono_arg_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
    let mut mono_type_key = clone(mono_arg_type)
    if starts_with(clone(mono_arg_type), "vec:") {
        mono_type_key = mono_type_key_from_local_type_name(substring(mono_arg_type, 4, len(mono_arg_type)))
    }
    if starts_with(clone(mono_type_key), "Option:") {
        mono_type_key = substring(clone(mono_type_key), 7, len(mono_type_key))
    }
    if starts_with(clone(mono_type_key), "option:") {
        mono_type_key = substring(clone(mono_type_key), 7, len(mono_type_key))
    }
    if starts_with(clone(mono_type_key), "Option_") {
        mono_type_key = substring(clone(mono_type_key), 7, len(mono_type_key))
    }
    if starts_with(clone(mono_type_key), "enum:") {
        mono_type_key = substring(clone(mono_type_key), 5, len(mono_type_key))
    }
    if len(mono_type_key) == 0 {
        return out
    }
    let mono_candidate = mono::mono_safe_name(concat(clone(out), concat("__", mono_type_key)))
    if ctx_fn_exists::ctx_has_fn_name(ctx, clone(mono_candidate)) {
        return mono_candidate
    }
    let type_method = concat(clone(mono_type_key), concat("::", clone(out)))
    if ctx_fn_exists::ctx_has_fn_name(ctx, clone(type_method)) {
        return type_method
    }
    if eq(clone(mono_type_key), "string") {
        let mono_candidate_string = mono::mono_safe_name(concat(clone(out), "__String"))
        if ctx_fn_exists::ctx_has_fn_name(ctx, clone(mono_candidate_string)) {
            return mono_candidate_string
        }
    }
    let special = resolve_special_mono_target(ctx, clone(out), clone(mono_type_key), first_arg_idx)
    if len(special) > 0 {
        return special
    }
    out
}

fn resolve_special_mono_target(ctx: LowerCtx, out: String, mono_type_key: String, first_arg_idx: i32) -> String {
    // ADR-040 Phase 5: format_debug<T> / format_debug__?t0 defers to
    // T::fmt_debug. Type-var mono shells must not stay as unreachable stubs.
    if eq(clone(out), "format_debug") || starts_with(clone(out), "format_debug__") {
        let mut key = clone(mono_type_key)
        if len(key) == 0 || starts_with(clone(key), "?") {
            key = call_mono_by_type_scalar_key_from_local(ctx, first_arg_idx)
        }
        if eq(clone(key), "string") {
            key = "String"
        }
        if len(key) > 0 && !starts_with(clone(key), "?") {
            let trait_method = concat(clone(key), "::fmt_debug")
            if ctx_fn_exists::ctx_has_fn_name(ctx, clone(trait_method)) {
                return trait_method
            }
        }
    }
    // write_debug_to__?t0 → write_debug_to__i32 / __String (value type key).
    if eq(clone(out), "write_debug_to") || starts_with(clone(out), "write_debug_to__") {
        let mut key = clone(mono_type_key)
        if len(key) == 0 || starts_with(clone(key), "?") {
            key = call_mono_by_type_scalar_key_from_local(ctx, first_arg_idx)
        }
        if eq(clone(key), "string") {
            key = "String"
        }
        if len(key) > 0 && !starts_with(clone(key), "?") {
            let mono_candidate = mono::mono_safe_name(concat("write_debug_to__", key))
            if ctx_fn_exists::ctx_has_fn_name(ctx, clone(mono_candidate)) {
                return mono_candidate
            }
        }
    }
    String_new()
}

fn call_mono_by_type_scalar_key_from_local(ctx: LowerCtx, arg_idx: i32) -> String {
    let vt = ctx_api_local_types::ctx_local_vt(ctx, arg_idx)
    if vt == value_types::VT_I32() {
        return "i32"
    }
    if vt == value_types::VT_I64() {
        return "i64"
    }
    if vt == value_types::VT_F64() {
        return "f64"
    }
    if vt == value_types::VT_GC_REF() || vt == value_types::VT_REF() {
        let tn = ctx_api_local_types::ctx_get_local_type(ctx, arg_idx)
        if eq(clone(tn), "string") || eq(clone(tn), "String") {
            return "String"
        }
        if eq(clone(tn), "bool") || eq(clone(tn), "Bool") {
            return "bool"
        }
        if eq(clone(tn), "char") {
            return "char"
        }
    }
    String_new()
}

fn mono_type_key_from_local_type_name(type_name: String) -> String {
    if starts_with(clone(type_name), "vec:") {
        let inner = mono_type_key_from_local_type_name(substring(clone(type_name), 4, len(type_name)))
        return concat("Vec<", concat(inner, ">"))
    }
    if eq(clone(type_name), "Vec") {
        return "Vec<i32>"
    }
    type_name
}

fn call_mono_by_type_strip_module_prefix(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i > 0 {
        if char_at(name, i) == 58 && char_at(name, i - 1) == 58 {
            return substring(name, i + 1, n)
        }
        i = i - 1
    }
    clone(name)
}
