use std::prelude::{clone, eq}
use mir::lower::ast_node
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_variants
use mir::lower::ctx_fn_index
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_lookup
use mir::lower::ctx_struct_mono
use mir::lower_kinds
use mir::lower::ctx_types
use mir::inst_const_i32
use mir::inst_local_set
use mir::lower::struct_lit
use mir::lower::value_variants
use mir::value_types
fn lower_struct_lit_expr(ctx: LowerCtx, node: AstNode) -> i32 {
    let child_count = ast_node::node_child_count(node)
    let raw_name = ast_node::node_text(node)
    let canon = ctx_api_variants::ctx_canonical_variant_name(ctx, clone(raw_name))
    let struct_name = if len(canon) > 0 {
        canon
    } else {
        raw_name
    }
    // Evaluate the functional-update base and field values first. For a
    // generic base (Pair<T>) their types decide the monomorphized
    // instantiation (Pair<String>) before struct.new picks a GC type.
    let mut base_idx = 0 - 1
    let mut has_base = false
    let field_names = Vec::new<String>()
    let field_vals = Vec::new<i32>()
    // When this literal's type is already known (`Queue<String>`), a field
    // declared as `Deque<T>` must instantiate as `Deque<String>` before the
    // nested literal is lowered. Otherwise the nested literal falls back to
    // the generic declaration and emits i32 Vec slots for reference elements
    // (#710).
    let outer_expected = clone(ctx.expected_struct_inst)
    let mut outer_params = Vec::new<String>()
    let mut outer_args = Vec::new<String>()
    if eq(ctx_struct_mono::generic_inst_base_name(clone(outer_expected)), clone(struct_name)) {
        outer_args = ctx_struct_mono::generic_inst_args(clone(outer_expected))
        if len(outer_args) > 0 {
            outer_params = struct_lit::struct_lit_split_params(
                ctx_struct_mono::ctx_generic_struct_params(ctx, clone(struct_name))
            )
        }
    }
    let mut f = 0
    while f < child_count {
        let field = ast_node::node_child_at(node, f)
        if ast_node::node_kind_is(field, lower_kinds::NK_RANGE()) {
            let base_expr = ast_node::node_child_at(field, 0)
            base_idx = lower_expr(ctx, base_expr)
            ctx_emit(ctx, inst_local_set::MirInst_local_set(base_idx))
            has_base = true
        } else {
            let fc = ast_node::node_child_count(field)
            if fc >= 1 {
                let init = ast_node::node_child_at(field, 0)
                let saved_expected = clone(ctx.expected_struct_inst)
                if len(outer_params) > 0 && len(outer_params) == len(outer_args) {
                    let fi = ctx_struct_lookup::ctx_field_index(ctx, clone(struct_name), ast_node::node_text(field))
                    if fi >= 0 {
                        let ft = ctx_struct_field_type::ctx_struct_field_type_name(ctx, clone(struct_name), fi)
                        let sub = ctx_struct_mono::ctx_substitute_generic_field_type(
                            ft,
                            clone(outer_params),
                            clone(outer_args)
                        )
                        if len(sub) > 0 {
                            ctx.expected_struct_inst = sub
                        }
                    }
                }
                let mut val_idx = 0 - 1
                if mir_struct_lit_field_fn_ident(ctx, clone(struct_name), ast_node::node_text(field), init) {
                    val_idx = value_variants::lower_function_value(ctx, ast_node::node_text(init))
                } else {
                    val_idx = lower_expr(ctx, init)
                }
                ctx.expected_struct_inst = saved_expected
                // Field sets run after struct.new, so the stack-composed
                // value must land in its local now; otherwise the linear
                // store policy leaves it under the next producer.
                ctx_emit(ctx, inst_local_set::MirInst_local_set(val_idx))
                push(field_names, ast_node::node_text(field))
                push(field_vals, val_idx)
            }
        }
        f = f + 1
    }
    let inst_name = struct_lit::mir_struct_lit_instance_name(ctx, clone(struct_name), field_names, field_vals, base_idx)
    let dest = struct_lit::mir_emit_struct_new(ctx, clone(inst_name))
    // If this is an enum variant, set the _tag field to the variant's tag value.
    let tag = ctx_api_variants::ctx_variant_tag(ctx, clone(inst_name))
    if tag >= 0 {
        let enum_type = struct_lit::mir_enum_variant_local_type_name(ctx, clone(inst_name))
        if len(clone(enum_type)) > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, dest, enum_type)
        }
        let tag_local = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
        ctx_api_emit::ctx_emit(ctx, inst_const_i32::MirInst_const_i32(tag, tag_local))
        struct_lit::mir_emit_struct_field_set(ctx, clone(inst_name), dest, "_tag", tag_local)
    }
    if has_base {
        struct_lit::mir_copy_struct_base_fields(ctx, clone(inst_name), dest, base_idx)
    }
    let mut emit_i = 0
    while emit_i < len(field_names) {
        struct_lit::mir_emit_struct_field_set(
            ctx,
            clone(inst_name),
            dest,
            clone(get_unchecked(field_names, emit_i)),
            get_unchecked(field_vals, emit_i)
        )
        emit_i = emit_i + 1
    }
    struct_lit::mir_emit_struct_get_local(ctx, dest)
}

// A bare function name initialising a fn-typed field must lower to the fn
// pair; otherwise a 0-param ident emits a call and stores the i32 result
// into the fn slot (#883).
fn mir_struct_lit_field_fn_ident(ctx: LowerCtx, struct_name: String, field_name: String, init: AstNode) -> bool {
    if !ast_node::node_kind_is(init, lower_kinds::NK_IDENT()) {
        return false
    }
    if ctx_api_local_alloc::ctx_lookup_local(ctx, ast_node::node_text(init)) >= 0 {
        return false
    }
    if ctx_fn_index::ctx_fn_index_find(ctx, ast_node::node_text(init)) < 0 {
        return false
    }
    let fi_idx = ctx_struct_lookup::ctx_field_index(ctx, clone(struct_name), clone(field_name))
    if fi_idx < 0 {
        return false
    }
    struct_lit::mir_struct_field_type_is_fn(ctx_struct_field_type::ctx_struct_field_type_name(ctx, clone(struct_name), fi_idx))
}
