use mir::mono_names
use mir::type_contracts

// Monomorphized-instance index over LowerCtx. Lives below ctx_api_module so
// ctx_mono_type_params can read instances without importing the module that
// pulls in ctx_module/emit_inloop.
fn ctx_set_mono_instances(mut ctx: LowerCtx, instances: Vec<MonoInstance>) {
    ctx.mono_instances = instances
    let count = instances.len()
    let mut capacity = 16
    let required = count * 2
    while capacity < required {
        capacity = capacity * 2
    }
    let mut buckets = Vec::new<i32>()
    let mut bi = 0
    while bi < capacity {
        buckets.push(0)
        bi = bi + 1
    }
    ctx.mono_inst_keys = Vec::new<String>()
    ctx.mono_inst_vals = Vec::new<i32>()
    ctx.mono_inst_buckets = buckets
    let mut i = 0
    while i < count {
        let inst = instances.get_unchecked(i)
        ctx_mono_inst_insert_first(
            ctx,
            mono_names::mono_safe_name(type_contracts::MonoInstance_mangled_name(inst)),
            i
        )
        i = i + 1
    }
}

fn ctx_mono_inst_insert_first(mut ctx: LowerCtx, name: String, value: i32) {
    let slot = ctx_mono_inst_probe_slot(ctx, name.clone())
    if slot < 0 {
        return
    }
    if ctx.mono_inst_buckets.get_unchecked(slot) != 0 {
        return
    }
    ctx.mono_inst_keys.push(name)
    ctx.mono_inst_vals.push(value)
    ctx.mono_inst_buckets.set(slot, ctx.mono_inst_keys.len())
}

fn ctx_mono_inst_probe_slot(ctx: LowerCtx, name: String) -> i32 {
    let capacity = ctx.mono_inst_buckets.len()
    if capacity <= 0 {
        return 0 - 1
    }
    let fnv_offset = 216613626
    let fnv_prime = 16777619
    let mut hash = fnv_offset
    let name_len = name.len()
    let mut hi = 0
    while hi < name_len {
        hash = hash * fnv_prime ^ name.byte_at(hi)
        if hash < 0 {
            hash = 0 - hash
        }
        hi = hi + 1
    }
    if hash < 0 {
        hash = 0
    }
    let mut slot = hash % capacity
    let mut probes = 0
    while probes < capacity {
        let bucket = ctx.mono_inst_buckets.get_unchecked(slot)
        if bucket == 0 {
            return slot
        }
        let key = ctx.mono_inst_keys.get_unchecked(bucket - 1)
        let mut same = key.len() == name_len
        if same {
            let mut i = 0
            while i < name_len {
                if key.byte_at(i) != name.byte_at(i) {
                    same = false
                    i = name_len
                } else {
                    i = i + 1
                }
            }
        }
        if same {
            return slot
        }
        slot = (slot + 1) % capacity
        probes = probes + 1
    }
    0 - 1
}

fn ctx_mono_instance_at(ctx: LowerCtx, mangled: String) -> MonoInstance {
    let slot = ctx_mono_inst_probe_slot(ctx, mono_names::mono_safe_name(mangled))
    if slot < 0 {
        return type_contracts::MonoInstance_new(String_new(), String_new(), Vec::new<TypeInfo>())
    }
    let bucket = ctx.mono_inst_buckets.get_unchecked(slot)
    if bucket == 0 {
        return type_contracts::MonoInstance_new(String_new(), String_new(), Vec::new<TypeInfo>())
    }
    let inst_index = ctx.mono_inst_vals.get_unchecked(bucket - 1)
    if inst_index < 0 || inst_index >= ctx.mono_instances.len() {
        return type_contracts::MonoInstance_new(String_new(), String_new(), Vec::new<TypeInfo>())
    }
    ctx.mono_instances.get_unchecked(inst_index)
}
