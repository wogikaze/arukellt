use std::prelude::{eq}
use mir::lower::ctx_fn_return_vt
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_gc_enum
use mir::lower::ctx_types
use mir::lower::call_rewrite_vec
use mir::value_types
fn mir_prepare_direct_call_dest(mut ctx: LowerCtx, callee_name: String, first_arg_idx: i32) -> i32 {
    // Direct calls take the callee's return value type as-is (f64 included);
    // narrowing to i32/i64 only mistypes f64-returning call destinations.
    let mut dest_vt = ctx_fn_return_vt::ctx_fn_return_vt(ctx, callee_name.clone())
    if dest_vt == value_types::VT_VOID() {
        dest_vt = mir_vec_call_dest_vt(ctx, callee_name.clone(), first_arg_idx)
        if dest_vt == value_types::VT_VOID() {
            return 0 - 1
        }
    }
    if mir_is_vec_get_unchecked_callee(callee_name.clone()) {
        dest_vt = mir_vec_call_dest_vt(ctx, callee_name.clone(), first_arg_idx)
    }
    if callee_name.clone().ends_with("::to_string") && ctx_gc_enum::ctx_is_gc_target(ctx) {
        dest_vt = value_types::VT_GC_REF()
    }
    if eq(callee_name.clone(), "vec_get_unchecked_i64") {
        dest_vt = value_types::VT_I64()
    }
    if eq(callee_name.clone(), "vec_get_unchecked_f64") {
        dest_vt = value_types::VT_F64()
    }
    if call_rewrite_vec::is_vec_push_callee(callee_name.clone()) && first_arg_idx >= 0 {
        dest_vt = mir_vec_receiver_vt(ctx, first_arg_idx)
    }
    ctx_api_local_alloc::ctx_fresh_local(ctx, dest_vt)
}

fn mir_vec_receiver_vt(ctx: LowerCtx, receiver_idx: i32) -> i32 {
    let receiver_vt = ctx_api_local_types::ctx_local_vt(ctx, receiver_idx)
    if receiver_vt == value_types::VT_GC_REF() ||
    receiver_vt == value_types::VT_REF() ||
    receiver_vt == value_types::VT_FUNCREF() {
        return receiver_vt
    }
    if ctx_gc_enum::ctx_is_gc_target(ctx) {
        return value_types::VT_GC_REF()
    }
    value_types::VT_REF()
}

fn mir_vec_call_dest_vt(ctx: LowerCtx, callee_name: String, first_arg_idx: i32) -> i32 {
    if first_arg_idx < 0 {
        return value_types::VT_VOID()
    }
    if eq(callee_name.clone(), "vec_get") {
        return value_types::VT_GC_REF()
    }
    if !mir_is_vec_get_unchecked_callee(callee_name.clone()) {
        return value_types::VT_VOID()
    }
    let vec_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
    if !vec_type.clone().starts_with("vec:") && !vec_type.clone().starts_with("array:") {
        return value_types::VT_VOID()
    }
    let elem_start = if vec_type.clone().starts_with("array:") { 6 } else { 4 }
    let elem_type = vec_type.slice(elem_start, len(vec_type))
    if eq(elem_type.clone(), "i64") || eq(elem_type.clone(), "I64") {
        return value_types::VT_I64()
    }
    if eq(elem_type.clone(), "f64") || eq(elem_type.clone(), "F64") {
        return value_types::VT_F64()
    }
    if eq(elem_type.clone(), "i32") ||
    eq(elem_type.clone(), "I32") ||
    eq(elem_type.clone(), "bool") ||
    eq(elem_type.clone(), "char") {
        return value_types::VT_I32()
    }
    if ctx_gc_enum::ctx_is_gc_target(ctx) {
        return value_types::VT_GC_REF()
    }
    value_types::VT_REF()
}

fn mir_is_vec_get_unchecked_callee(callee_name: String) -> bool {
    if eq(callee_name.clone(), "vec_get_unchecked") ||
    eq(callee_name.clone(), "raw_array_get_unchecked") ||
    eq(callee_name.clone(), "get_unchecked") {
        return true
    }
    callee_name.clone().starts_with("vec_get_unchecked__") ||
    callee_name.clone().starts_with("get_unchecked__") ||
    callee_name.clone().starts_with("raw_array_get_unchecked__")
}
