use std::prelude::{clone, eq}
use mir::lower::ast_node
use mir::lower::closure_free
use mir::lower::closure_capture_args
use mir::lower::closure_pcells
use mir::lower::closure_registry
use mir::lower::ctx_api_local_frame
use mir::lower::ctx_types
use mir::function_return_mutation
use mir::lower::body_closure_capture
use mir::lower::ctx_env_cells
use mir::lower::closure_env
use mir::lower::body_closure_context
use mir::lower::body_closure_params
use mir::lower::body_closure_return
use mir::lower::closure_return_type
use mir::lower_kinds
use mir::value_types
fn mir_emit_closure_fn(mut ctx: LowerCtx, synth: String, clos: AstNode, caps: Vec<String>, rebind_flags: Vec<i32>) -> MirFunction {
    let saved_frame = ctx_api_local_frame::LowerCtxLocalFrame_capture(ctx)
    let cap_vts = body_closure_capture::mir_closure_capture_vts(ctx, caps)
    let cap_types = body_closure_capture::mir_closure_capture_types(ctx, caps)
    body_closure_context::mir_begin_closure_function_context(ctx, synth)
    let child_count = ast_node::node_child_count(clos)
    let body = ast_node::node_child_at(clos, child_count - 1)
    body_closure_params::mir_emit_closure_params(ctx, clos, child_count)
    body_closure_capture::mir_emit_closure_captures(ctx, caps, cap_vts, cap_types, rebind_flags, closure_env::closure_env_type_name(clone(synth)))
    let res = body_closure_return::mir_emit_closure_return(ctx, body)
    let mut fret = ctx_api_local_frame::ctx_current_function(ctx)
    closure_return_type::mir_set_closure_return_from_local(ctx, fret, res)
    ctx_api_local_frame::ctx_set_current_function(ctx, fret)
    let out_fn = ctx_api_local_frame::ctx_current_function(ctx)
    body_closure_context::mir_restore_closure_parent_context(ctx, saved_frame)
    out_fn
}

fn lower_closure_expr(mut ctx: LowerCtx, node: AstNode) -> i32 {
    if is_identity_closure(node) {
        // One monomorphic funcref cannot represent `|x| x` at both scalar and
        // GC-reference call sites. Keep this pure identity closure in the
        // registry and inline each call at its concrete argument type.
        return closure_registry::closure_register_identity(ctx)
    }
    let mut caps = Vec::new<String>()
    let mut direct_caps = Vec::new<String>()
    let cap_child_count = ast_node::node_child_count(node)
    if cap_child_count > 0 {
        let cap_body = ast_node::node_child_at(node, cap_child_count - 1)
        closure_free::closure_collect_free(ctx, cap_body, node, caps)
        closure_free::closure_collect_direct(ctx, cap_body, node, direct_caps)
    }
    let synth = closure_registry::closure_next_synth_name(ctx)
    let is_move = if ast_node::node_is_move(node) { 1 } else { 0 }
    let rebind_flags = closure_free::closure_collect_rebind_flags(node, caps)
    // Non-move rebind captures are mutable borrows: promote each source
    // place into a shared heap cell before the supply is computed so the
    // env packs the cell ref and the closure may escape with write-through
    // semantics intact (#891). Env-cell/write-back flags keep only the
    // captures that could not be promoted.
    let mut eff_rebinds = Vec::new<i32>()
    let mut pi = 0
    while pi < len(caps) {
        let mut eff = get_unchecked(rebind_flags, pi)
        // A move closure owns only its direct captures: a name that a
        // nested closure rebinds through this frame is still a borrow of
        // the source place, so the cell promotion applies regardless of
        // this frame's move prefix (#900).
        if eff != 0 && (is_move == 0 ||
            !closure_free::closure_caps_contain(direct_caps, clone(get_unchecked(caps, pi)))) &&
        closure_pcells::ctx_promote_capture_cell(ctx, clone(get_unchecked(caps, pi))) >= 0 {
            eff = 0
        }
        push(eff_rebinds, eff)
        pi = pi + 1
    }
    let supply_caps = body_closure_capture::mir_closure_snapshot_copy_captures(ctx, caps, clone(synth))
    let packed = closure_capture_args::closure_pack_caps(supply_caps)
    let extra = len(caps)
    let mut mf = mir_emit_closure_fn(ctx, synth, node, caps, eff_rebinds)
    closure_registry::closure_register_synth_fn(ctx, mf, packed, extra, ctx_env_cells::ctx_has_env_cell(eff_rebinds), caps, eff_rebinds, is_move)
}

fn is_identity_closure(node: AstNode) -> bool {
    let child_count = ast_node::node_child_count(node)
    if child_count != 2 {
        return false
    }
    let param = ast_node::node_child_at(node, 0)
    let body = ast_node::node_child_at(node, 1)
    if !ast_node::node_kind_is(param, lower_kinds::NK_IDENT()) ||
    !ast_node::node_kind_is(body, lower_kinds::NK_IDENT()) {
        return false
    }
    eq(ast_node::node_text(param), ast_node::node_text(body))
}
