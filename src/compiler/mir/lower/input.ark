use mir::lower::entry_body_source
use corehir::mir_body_source
use corehir::body
use corehir::mod as corehir_mod

struct MirLowerInput {
    view: CoreHirMirView,
    body_source: MirLowerEntryBodySource,
    wit_paths: Vec<String>,
    decl_nodes: Vec<AstNode>,
    target: String,
    report_phase_timing: i32,
    source_text: String,
}

fn mir_lower_input_new(
    view: CoreHirMirView,
    fallback_source: MirLowerFallbackSource,
    wit_paths: Vec<String>,
    decl_nodes: Vec<AstNode>,
    target: String,
    report_phase_timing: i32,
    source_text: String
) -> MirLowerInput {
    let mut effective_target = clone(target)
    if len(effective_target) == 0 {
        effective_target = "wasm32-gc"
    }
    let lazy_body = eq(clone(effective_target), String_from("wasm32-gc"))
    let body_source_decls = if lazy_body {
        decl_nodes
    } else {
        Vec::new<AstNode>()
    }
    let body_source = entry_body_source::mir_entry_body_source_new(
        entry_body_source::mir_entry_body_source_view_from_core(view),
        fallback_source,
        body_source_decls,
        lazy_body,
        body::CoreHirBodyTable_new()
    )
    if lazy_body {
        mir_body_source::mir_body_source_release(corehir_mod::view_body_source(view))
    }
    MirLowerInput {
        view: view,
        body_source: body_source,
        wit_paths: wit_paths,
        decl_nodes: decl_nodes,
        target: effective_target,
        report_phase_timing: report_phase_timing,
        source_text: source_text
    }
}

fn mir_lower_input_wit_paths(input: MirLowerInput) -> Vec<String> {
    input.wit_paths
}

fn mir_lower_input_decl_nodes(input: MirLowerInput) -> Vec<AstNode> {
    input.decl_nodes
}

fn mir_lower_input_view(input: MirLowerInput) -> CoreHirMirView {
    input.view
}

fn mir_lower_input_body_source(input: MirLowerInput) -> MirLowerEntryBodySource {
    input.body_source
}

fn mir_lower_input_target(input: MirLowerInput) -> String {
    clone(input.target)
}
