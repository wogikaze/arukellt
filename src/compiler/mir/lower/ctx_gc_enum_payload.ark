use std::text
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_enum_sig
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_field_type
fn ctx_ensure_gc_enum_payload_variant(mut ctx: LowerCtx, variant_name: String, payload_vts: Vec<i32>) -> i32 {
    let payload_found = ctx_gc_enum::ctx_gc_enum_variant_slot_for_payload(ctx, variant_name.clone(), payload_vts)
    if payload_found >= 0 {
        return payload_found
    }
    let name_slot = ctx_gc_enum::ctx_gc_enum_variant_slot(ctx, variant_name.clone())
    if name_slot >= 0 {
        let layout_field_sigs = gc_enum_build_payload_field_sigs(ctx, variant_name.clone())
        if layout_field_sigs.len() > 0 {
            let existing_sig = ctx.gc_enum_variant_sigs.get_unchecked(name_slot).clone()
            let existing_payload = ctx_gc_enum_sig::gc_enum_payload_suffix_after_prefix(existing_sig.clone(), "SubF+14_S_f0_i32")
            if existing_payload.clone().eq(layout_field_sigs.clone()) {
                return name_slot
            }
        }
        let existing_sig = ctx.gc_enum_variant_sigs.get_unchecked(name_slot).clone()
        let want_field_sigs = ctx_gc_enum_sig::ctx_gc_enum_payload_field_sigs_from_vts(ctx, payload_vts)
        if ctx_gc_enum_sig::gc_enum_payload_sigs_compatible(existing_sig, want_field_sigs) {
            return name_slot
        }
    }
    let normalized = ctx_gc_enum::ctx_gc_enum_normalize_variant_name(variant_name.clone())
    let field_sigs = ctx_gc_enum_sig::ctx_gc_enum_payload_field_sigs_from_vts(ctx, payload_vts)
    let sig = ctx_gc_enum_sig::gc_enum_payload_variant_sig(ctx.gc_enum_variant_names.len(), field_sigs)
    ctx_gc_enum::ctx_register_gc_enum_variant(ctx, normalized.clone(), sig)
}

fn ctx_ensure_gc_enum_payload_variant_typed(mut ctx: LowerCtx, variant_name: String, payload_vts: Vec<i32>, type_name: String) -> i32 {
    let layout_field_sigs = gc_enum_build_payload_field_sigs_for_type(ctx, variant_name.clone(), type_name.clone())
    let field_sigs = gc_enum_payload_typed_resolve_field_sigs(ctx, variant_name.clone(), payload_vts, type_name.clone(), layout_field_sigs.clone())
    let normalized = ctx_gc_enum::ctx_gc_enum_normalize_variant_name(variant_name.clone())
    let want_sig = ctx_gc_enum_sig::gc_enum_payload_variant_sig(0, field_sigs.clone())
    let slot = gc_enum_payload_typed_find_slot(ctx, variant_name.clone(), normalized.clone(), want_sig, field_sigs.clone(), layout_field_sigs.clone(), type_name.clone())
    if slot >= 0 {
        return slot
    }
    let sig = ctx_gc_enum_sig::gc_enum_payload_variant_sig(ctx.gc_enum_variant_names.len(), field_sigs.clone())
    ctx_gc_enum::ctx_register_gc_enum_variant(ctx, normalized.clone(), sig)
}

fn gc_enum_payload_typed_resolve_field_sigs(mut ctx: LowerCtx, variant_name: String, payload_vts: Vec<i32>, type_name: String, layout_field_sigs: String) -> String {
    let mut field_sigs = ctx_gc_enum_sig::ctx_gc_enum_payload_field_sigs_typed(ctx, payload_vts, type_name.clone())
    let normalized = ctx_gc_enum::ctx_gc_enum_normalize_variant_name(variant_name.clone())
    let is_vec_container = ctx_gc_enum::gc_enum_variant_is_vec_container(normalized.clone())
    // For user enum variants the declaration layout describes every payload
    // field, while the typed call site only carries a type hint for its first
    // field.  Using `_f1_ref0` for a later GC_REF payload aliases it to the
    // String reference type and produces invalid `struct.set` operations for
    // recursive enums such as `List::Cons(i32, List)`.
    if layout_field_sigs.len() > 0 &&
    !gc_enum_payload_is_builtin_result_or_option(normalized.clone()) {
        return layout_field_sigs
    }
    if is_vec_container {
        if field_sigs.clone().contains("ref14") || field_sigs.len() == 0 {
            if layout_field_sigs.len() > 0 && !layout_field_sigs.clone().contains("ref14") {
                field_sigs = layout_field_sigs
            } else if type_name.clone().starts_with("vec:") || type_name.clone().starts_with("Vec") {
                field_sigs = ctx_gc_enum_sig::ctx_gc_enum_payload_field_sigs_typed(ctx, payload_vts, type_name.clone())
            } else {
                field_sigs = "_f1_ref25"
            }
        }
    }
    // Only reuse layout field sigs when the typed want is still open/enum-open
    // and the layout itself was selected for this payload type. Never let a
    // first-name Option::Some(String) layout override a concrete Inner want.
    let typed_is_open = type_name.len() == 0 || type_name.clone().eq("enum:open")
    if layout_field_sigs.len() > 0 && typed_is_open {
        if layout_field_sigs.clone().contains("ref") || layout_field_sigs.clone().contains("gcsref") {
            if !(is_vec_container && layout_field_sigs.clone().contains("ref14")) {
                field_sigs = layout_field_sigs
            }
        }
    } else if layout_field_sigs.len() > 0 && field_sigs.clone().contains("ref14") && is_vec_container {
        if layout_field_sigs.clone().contains("ref") || layout_field_sigs.clone().contains("gcsref") {
            if !layout_field_sigs.clone().contains("ref14") {
                field_sigs = layout_field_sigs
            }
        }
    }
    if is_vec_container && layout_field_sigs.len() > 0 && !layout_field_sigs.clone().contains("ref14") {
        field_sigs = layout_field_sigs
    }
    field_sigs
}

fn gc_enum_payload_is_builtin_result_or_option(variant_name: String) -> bool {
    variant_name.clone().starts_with("Option::") ||
    variant_name.clone().starts_with("Result::")
}

fn gc_enum_payload_typed_find_slot(ctx: LowerCtx, variant_name: String, normalized: String, want_sig: String, field_sigs: String, layout_field_sigs: String, type_name: String) -> i32 {
    let count = ctx.gc_enum_variant_sigs.len()
    let mut i = 0
    while i < count {
        if ctx.gc_enum_variant_sigs.get_unchecked(i).eq(want_sig.clone()) {
            if ctx_gc_enum::ctx_gc_enum_variant_names_match(ctx.gc_enum_variant_names.get_unchecked(i).clone(), normalized.clone()) {
                return i
            }
        }
        i = i + 1
    }
    i = 0
    while i < count {
        if ctx_gc_enum::ctx_gc_enum_variant_names_match(ctx.gc_enum_variant_names.get_unchecked(i).clone(), normalized.clone()) {
            let existing_sig = ctx.gc_enum_variant_sigs.get_unchecked(i).clone()
            let existing_payload = ctx_gc_enum_sig::gc_enum_payload_suffix_after_prefix(existing_sig.clone(), "SubF+14_S_f0_i32")
            if existing_payload.clone().eq(field_sigs.clone()) {
                return i
            }
        }
        i = i + 1
    }
    // When the typed want field sig is known, never fall back to the first
    // same-named slot unless its payload sig matches exactly. Name-only reuse
    // is how Option::Some(i32) steals Option::Some(String) / gcsref binds.
    if field_sigs.len() > 0 {
        return 0 - 1
    }
    let name_slot = ctx_gc_enum::ctx_gc_enum_variant_slot(ctx, variant_name.clone())
    if name_slot >= 0 {
        let existing_sig = ctx.gc_enum_variant_sigs.get_unchecked(name_slot).clone()
        let existing_payload = ctx_gc_enum_sig::gc_enum_payload_suffix_after_prefix(existing_sig.clone(), "SubF+14_S_f0_i32")
        let is_vec_container = ctx_gc_enum::gc_enum_variant_is_vec_container(normalized.clone())
        if is_vec_container && existing_payload.clone().contains("ref14") && field_sigs.clone().contains("ref25") {
            // fall through to register a fresh typed slot
        } else {
            if layout_field_sigs.len() > 0 && existing_payload.clone().eq(layout_field_sigs.clone()) {
                if field_sigs.len() == 0 || existing_payload.clone().eq(field_sigs.clone()) {
                    return name_slot
                }
            }
            if (type_name.len() == 0 || type_name.clone().eq("enum:open")) && existing_payload.len() > 0 {
                if layout_field_sigs.len() == 0 || existing_payload.clone().eq(layout_field_sigs.clone()) {
                    if field_sigs.len() == 0 || existing_payload.clone().eq(field_sigs.clone()) {
                        if existing_payload.clone().contains("ref") || existing_payload.clone().contains("gcsref") {
                            return name_slot
                        }
                    }
                }
            }
            if field_sigs.len() > 0 &&
            !ctx_gc_enum_sig::gc_enum_payload_is_scalar_sig(field_sigs.clone()) &&
            ctx_gc_enum_sig::gc_enum_payload_is_scalar_sig(existing_payload.clone()) {
                // fall through
            } else if ctx_gc_enum_sig::gc_enum_payload_sigs_compatible(existing_sig, field_sigs.clone()) {
                return name_slot
            }
        }
    }
    0 - 1
}

fn gc_enum_build_payload_field_sigs(mut ctx: LowerCtx, variant_name: String) -> String {
    gc_enum_build_payload_field_sigs_for_type(ctx, variant_name, String_new())
}

fn gc_enum_build_payload_field_sigs_for_type(mut ctx: LowerCtx, variant_name: String, type_name: String) -> String {
    let mut sig = String_new()
    let layout_name = ctx_struct_field_type::ctx_resolve_variant_layout_name(ctx, variant_name.clone())
    let layout_count = ctx.struct_names.len()
    let mut li = 0
    let mut first_sig = String_new()
    while li < layout_count {
        if ctx.struct_names.get_unchecked(li).eq(layout_name.clone()) || ctx.struct_names.get_unchecked(li).eq(variant_name.clone()) {
            let field_count = ctx.struct_field_counts.get_unchecked(li)
            let mut row_sig = String_new()
            let mut payload_ft = String_new()
            let mut fi = 1
            while fi < field_count {
                let mut off = 0
                let mut si = 0
                while si < li {
                    off = off + ctx.struct_field_counts.get_unchecked(si)
                    si = si + 1
                }
                off = off + fi
                let raw_ft = ctx.struct_field_types.get_unchecked(off)
                let ft = if fi == 1 && type_name.len() > 0 && ctx_struct_field_type::ctx_payload_field_types_match(raw_ft.clone(), type_name.clone()) {
                    type_name.clone()
                } else {
                    ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, raw_ft.clone())
                }
                if fi == 1 {
                    payload_ft = raw_ft.clone()
                }
                row_sig = row_sig.concat(ctx_gc_enum_sig::gc_enum_field_sig_for_type_ctx(ctx, ft.clone()))
                fi = fi + 1
            }
            if first_sig.len() == 0 {
                first_sig = row_sig.clone()
            }
            if type_name.len() > 0 && ctx_struct_field_type::ctx_payload_field_types_match(payload_ft.clone(), type_name.clone()) {
                return row_sig
            }
            if type_name.len() == 0 {
                return row_sig
            }
        }
        li = li + 1
    }
    if first_sig.len() > 0 {
        return first_sig
    }
    sig
}
