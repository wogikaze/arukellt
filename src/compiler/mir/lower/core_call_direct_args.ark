use mir::inst_local_get
use mir::inst_convert
use mir::value_types
use mir::lower::binary_cast
use mir::lower::call_arg_i64
use mir::lower::call_emit
use mir::lower::call_indirect_emit
use mir::lower::call_rewrite_vec
use mir::lower::core_call_args
use mir::lower::core_call_direct_arg
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_aggregate
use mir::lower::core_expr_shape_atoms
use mir::lower::core_expr_shape_calls
use mir::lower::core_expr_shape_ops
use mir::lower::core_literals
use mir::lower::core_names
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_types
use mir::lower::ctx_fn_index
use mir::lower::loop_vec
use mir::lower::method
use mir::lower::struct_lit
use mir::lower_kinds
use mir::lower::value_variants
fn lower_core_direct_call_args(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, expr: CoreHirExpr, child_count: i32) -> i32 {
    let callee_name = core_expr_shape_accessors::mir_core_expr_text(expr)
    if callee_name.clone().eq("String_from") && child_count == 2 {
        let arg_expr = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(expr, 1))
        if core_expr_shape_atoms::mir_core_expr_is_string(arg_expr) {
            return core_literals::lower_core_literal_value(ctx, arg_expr)
        }
    }
    let callee_name = core_expr_shape_accessors::mir_core_expr_text(expr)
    let callee_node = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(expr, 0))
    if core_expr_shape_atoms::mir_core_expr_is_ident(callee_node) {
        let callee_local = core_names::mir_core_lookup_local(ctx, callee_node)
        if callee_local >= 0 && call_indirect_emit::mir_is_funcref_local(ctx, callee_local) {
            return call_indirect_emit::mir_lower_indirect_call(ctx, exprs, expr, child_count, callee_local)
        }
    }
    // Expression callee: call / field get → call_ref when funcref (#832 / #807 MapIter).
    if core_expr_shape_calls::mir_core_expr_is_call(callee_node) ||
    core_expr_shape_aggregate::mir_core_expr_is_field_access(callee_node) {
        let callee_local = lower_core_expr(ctx, exprs, core_expr_shape_accessors::mir_core_expr_child(expr, 0))
        if callee_local >= 0 && call_indirect_emit::mir_is_funcref_local(ctx, callee_local) {
            return call_indirect_emit::mir_lower_indirect_call(ctx, exprs, expr, child_count, callee_local)
        }
    }
    let is_println = core_call_args::mir_core_is_printlike_callee(callee_name.clone())
    // Printlike calls record the staged local as their receiver hint, so the
    // argument must be materialized in a local. Leaving it stack-resident lets
    // the previous call's store rule consume it before the print call reads
    // the local (linear wasm32 `println(x.to_string())`). The legacy AST
    // lowering stages printlike args for the same reason.
    let stage_call_args = is_println || child_count > 2
    let mut staged_arg_locals = Vec::new<i32>()
    let mut arg_widen_i64 = Vec::new<i32>()
    let mut first_arg_idx = 0 - 1
    let mut second_arg_idx = 0 - 1
    let mut lane_immediate = 0 - 1
    let mut receiver_writeback = 0 - 1
    let mut call_result = 0 - 1
    let lane_immediate_position = call_emit::mir_simd_lane_immediate_argument_index(callee_name.clone())
    let mut a = 1
    if child_count == 1 {
        call_result = call_emit::mir_emit_direct_call(
            ctx,
            callee_name,
            0,
            first_arg_idx,
            second_arg_idx,
            staged_arg_locals,
            arg_widen_i64,
            stage_call_args,
            core_expr_shape_accessors::mir_core_expr_span_start(expr),
            lane_immediate,
            receiver_writeback
        )
    }
    while a < child_count {
        let arg_expr = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(expr, a))
        let mut arg_idx = 0 - 1
        let param_idx = a - 1
        let is_lane_immediate = a == lane_immediate_position && core_expr_shape_atoms::mir_core_expr_is_int(arg_expr)
        if is_lane_immediate {
            lane_immediate = core_expr_shape_accessors::mir_core_expr_int_val(arg_expr)
            if a + 1 == child_count {
                call_result = call_emit::mir_emit_direct_call(
                    ctx,
                    callee_name,
                    child_count - 1,
                    first_arg_idx,
                    second_arg_idx,
                    staged_arg_locals,
                    arg_widen_i64,
                    stage_call_args,
                    core_expr_shape_accessors::mir_core_expr_span_start(expr),
                    lane_immediate,
                    receiver_writeback
                )
                a = child_count
            } else {
                a = a + 1
            }
            continue
        }
        let needs_print_convert = is_println &&
        a == 1 &&
        core_expr_shape_atoms::mir_core_expr_is_ident(arg_expr) &&
        core_call_args::mir_core_print_arg_needs_string_conversion(ctx, arg_expr, core_names::mir_core_lookup_local(ctx, arg_expr))
        let staged_ident_local = if stage_call_args && core_expr_shape_atoms::mir_core_expr_is_ident(arg_expr) {
            core_names::mir_core_lookup_local(ctx, arg_expr)
        } else {
            0 - 1
        }
        // A module constant lowers through its accessor call and is
        // materialized in a local, so it is never on the operand stack. The
        // staged copy would underflow and the unstaged call would lose the
        // operand (`v.push(K)` on the linear target).
        let arg_is_const_ident = core_expr_shape_atoms::mir_core_expr_is_ident(arg_expr) &&
        core_names::mir_core_lookup_local(ctx, arg_expr) < 0 &&
        ctx_fn_index::ctx_is_const_name(ctx, core_expr_shape_accessors::mir_core_expr_text(arg_expr))
        let mut arg_source_on_stack = true
        if staged_ident_local >= 0 {
            // Staging already copies a local with local.set.  Avoid an
            // intermediate local.get, which composes multiple arguments on
            // the value stack in the wrong order.
            arg_idx = staged_ident_local
            arg_source_on_stack = false
        } else if needs_print_convert {
            arg_idx = core_names::mir_core_lookup_local(ctx, arg_expr)
            arg_source_on_stack = false
        } else if core_expr_shape_atoms::mir_core_expr_is_int(arg_expr) && call_arg_i64::mir_should_force_int_lit_i64(ctx, callee_name.clone(), param_idx) {
            arg_idx = core_literals::lower_core_int_literal_forced_i64(ctx, arg_expr)
        } else if core_expr_shape_ops::mir_core_expr_is_unary(arg_expr) &&
            core_expr_shape_accessors::mir_core_expr_int_val(arg_expr) == lower_kinds::UOP_NEG() &&
            core_expr_shape_accessors::mir_core_expr_child_count(arg_expr) >= 1 {
                // -100 passed to format_i64 / parse_i64 must be i64 NEG, not i32 (#807).
                let unary_operand = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(arg_expr, 0))
                if core_expr_shape_atoms::mir_core_expr_is_int(unary_operand) &&
                call_arg_i64::mir_should_force_int_lit_i64(ctx, callee_name.clone(), param_idx) {
                    arg_idx = core_literals::lower_core_unary_neg_forced_i64(ctx, unary_operand)
                } else {
                    arg_idx = lower_core_expr(ctx, exprs, core_expr_shape_accessors::mir_core_expr_child(expr, a))
                    if !stage_call_args && method::mir_method_arg_leaves_no_stack(ctx, arg_idx) {
                        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(arg_idx))
                    }
                }
            } else if mir_core_arg_is_fn_value_for_param(ctx, callee_name.clone(), arg_expr, param_idx) ||
                mir_core_vec_push_arg_is_fn(ctx, callee_name.clone(), arg_expr, param_idx, first_arg_idx) {
                    arg_idx = value_variants::lower_function_value(ctx, core_expr_shape_accessors::mir_core_expr_text(arg_expr))
                } else {
                    arg_idx = lower_core_expr(ctx, exprs, core_expr_shape_accessors::mir_core_expr_child(expr, a))
                    if !stage_call_args && method::mir_method_arg_leaves_no_stack(ctx, arg_idx) {
                        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(arg_idx))
                    }
                    if !stage_call_args && arg_is_const_ident && arg_idx >= 0 {
                        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(arg_idx))
                    }
                }
                if arg_idx >= 0 && call_arg_i64::mir_should_wrap_i64_arg_to_i32(ctx, callee_name.clone(), param_idx) {
                    arg_idx = binary_cast::mir_wrap_i64_to_i32_if_needed(ctx, arg_idx)
                }
                arg_idx = core_call_direct_arg::mir_lower_core_direct_print_arg(ctx, arg_expr, arg_idx, is_println, a)
                // i32-scalar arg into an i64 param: component emit leaves
                // i32 locals as real i32 on the operand stack. Unstaged args
                // are already pushed; staged args widen on re-read (#923).
                let needs_i64_arg_widen = arg_idx >= 0 &&
                call_arg_i64::mir_callee_param_is_i64(ctx, callee_name.clone(), param_idx) &&
                ctx_api_local_types::ctx_local_vt(ctx, arg_idx) == value_types::VT_I32()
                if !stage_call_args && needs_i64_arg_widen {
                    ctx_api_emit::ctx_emit(ctx, inst_convert::MirInst_extend_i32_to_i64_stack())
                }
                if a == 1 && callee_name.clone().eq(String_from("push_char")) && arg_idx >= 0 {
                    receiver_writeback = arg_idx
                }
                let mut staged_arg_now = false
                if stage_call_args && arg_idx >= 0 {
                    staged_arg_now = true
                }
                if stage_call_args && arg_is_const_ident && arg_idx >= 0 {
                    // Already a materialized local; copying it would consume a
                    // stack operand that does not exist. Stage the local itself.
                    staged_arg_locals.push(arg_idx)
                } else if stage_call_args && !arg_source_on_stack && arg_idx >= 0 {
                    arg_idx = core_call_args::mir_core_stage_call_arg_from_local(
                        ctx,
                        staged_arg_locals,
                        arg_idx
                    )
                } else {
                    arg_idx = core_call_direct_arg::mir_lower_core_direct_stage_arg(
                        ctx,
                        staged_arg_locals,
                        arg_idx,
                        stage_call_args
                    )
                }
                if staged_arg_now {
                    arg_widen_i64.push(if needs_i64_arg_widen { 1 } else { 0 })
                }
                if a == 1 {
                    first_arg_idx = arg_idx
                }
                if a == 2 {
                    second_arg_idx = arg_idx
                }
                if a + 1 == child_count {
                    call_result = call_emit::mir_emit_direct_call(
                        ctx,
                        callee_name,
                        child_count - 1,
                        first_arg_idx,
                        second_arg_idx,
                        staged_arg_locals,
                        arg_widen_i64,
                        stage_call_args,
                        core_expr_shape_accessors::mir_core_expr_span_start(expr),
                        lane_immediate,
                        receiver_writeback
                    )
                    a = child_count
                } else {
                    a = a + 1
                }
            }
            call_result
        }

        // Bare function names at fn-typed parameters must lower to fn-pair values.
        // The frontend resolves a 0-param ident by its result type, which would
        // otherwise emit a call and store the i32 result into the fn slot (#883).
        fn mir_core_arg_is_fn_value_for_param(ctx: LowerCtx, callee_name: String, arg_expr: CoreHirExpr, param_idx: i32) -> bool {
            if !core_expr_shape_atoms::mir_core_expr_is_ident(arg_expr) {
                return false
            }
            if core_names::mir_core_lookup_local(ctx, arg_expr) >= 0 {
                return false
            }
            let arg_name = core_expr_shape_accessors::mir_core_expr_text(arg_expr)
            if core_names::mir_function_parameter_count(ctx, arg_name.clone()) < 0 {
                return false
            }
            call_arg_i64::mir_callee_param_is_funcref(ctx, callee_name, param_idx)
        }

        // Bare fn names pushed onto Vec<fn...> must lower to fn pairs.  The
        // generic push spine reports the element param as T, so the expected
        // type comes from the receiver local's Vec element type (#884).
        fn mir_core_vec_push_arg_is_fn(ctx: LowerCtx, callee_name: String, arg_expr: CoreHirExpr, param_idx: i32, vec_idx: i32) -> bool {
            if param_idx != 1 || vec_idx < 0 {
                return false
            }
            if !call_rewrite_vec::is_vec_push_callee(callee_name) {
                return false
            }
            if !core_expr_shape_atoms::mir_core_expr_is_ident(arg_expr) {
                return false
            }
            if core_names::mir_core_lookup_local(ctx, arg_expr) >= 0 {
                return false
            }
            let arg_name = core_expr_shape_accessors::mir_core_expr_text(arg_expr)
            if core_names::mir_function_parameter_count(ctx, arg_name.clone()) < 0 {
                return false
            }
            let vec_type = ctx_api_local_types::ctx_get_local_type(ctx, vec_idx)
            struct_lit::struct_lit_decl_is_fn_value(loop_vec::mir_vec_element_type_name(vec_type))
        }
