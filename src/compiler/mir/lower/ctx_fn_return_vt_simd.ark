use std::prelude::{clone, ends_with, eq, starts_with}
fn ctx_is_v128_returning_simd_intrinsic(bare_name: String) -> bool {
    if starts_with(clone(bare_name), "__simd_v128_") {
        if eq(clone(bare_name), "__simd_v128_any_true") {
            return false
        }
        return true
    }
    if starts_with(clone(bare_name), "__simd_f32x4_") {
        if ends_with(clone(bare_name), "_extract_lane") {
            return false
        }
        return true
    }
    if starts_with(clone(bare_name), "__simd_f64x2_") {
        if ends_with(clone(bare_name), "_extract_lane") {
            return false
        }
        return true
    }
    if simd_i32x4_is_v128(clone(bare_name)) {
        return true
    }
    if starts_with(clone(bare_name), "__simd_i64x2_") {
        if ends_with(clone(bare_name), "_extract_lane") {
            return false
        }
        if ends_with(clone(bare_name), "_all_true") {
            return false
        }
        if ends_with(clone(bare_name), "_bitmask") {
            return false
        }
        return true
    }
    if simd_i8x16_is_v128(clone(bare_name)) {
        return true
    }
    if simd_i16x8_is_v128(clone(bare_name)) {
        return true
    }
    if ctx_is_v128_returning_unsigned_simd_intrinsic(bare_name) {
        return true
    }
    false
}

fn ctx_is_unsigned_lane_simd_intrinsic(bare_name: String) -> bool {
    starts_with(clone(bare_name), "__simd_u8x16_") ||
    starts_with(clone(bare_name), "__simd_u16x8_") ||
    starts_with(clone(bare_name), "__simd_u32x4_") ||
    starts_with(clone(bare_name), "__simd_u64x2_")
}

fn ctx_is_v128_returning_unsigned_simd_intrinsic(bare_name: String) -> bool {
    if !ctx_is_unsigned_lane_simd_intrinsic(clone(bare_name)) {
        return false
    }
    if ends_with(clone(bare_name), "_extract_lane") { return false }
    if ends_with(clone(bare_name), "_extract_lane_s") { return false }
    if ends_with(clone(bare_name), "_extract_lane_u") { return false }
    if ends_with(clone(bare_name), "_all_true") { return false }
    if ends_with(clone(bare_name), "_bitmask") { return false }
    true
}

fn ctx_is_f32_returning_simd_intrinsic(bare_name: String) -> bool {
    eq(clone(bare_name), "__simd_f32x4_extract_lane")
}

fn ctx_is_f64_returning_simd_intrinsic(bare_name: String) -> bool {
    eq(clone(bare_name), "__simd_f64x2_extract_lane")
}

fn ctx_is_i64_returning_simd_intrinsic(bare_name: String) -> bool {
    eq(clone(bare_name), "__simd_i64x2_extract_lane") ||
    eq(clone(bare_name), "__simd_u64x2_extract_lane")
}

fn ctx_is_v128_returning_wasm_intrinsic(bare_name: String) -> bool {
    eq(clone(bare_name), "__wasm_v128_load") ||
    eq(clone(bare_name), "__wasm_v128_load_splat") ||
    eq(clone(bare_name), "__wasm_v128_load_lane") ||
    eq(clone(bare_name), "__wasm_v128_load8x8_s") ||
    eq(clone(bare_name), "__wasm_v128_load8x8_u") ||
    eq(clone(bare_name), "__wasm_v128_load16x4_s") ||
    eq(clone(bare_name), "__wasm_v128_load16x4_u") ||
    eq(clone(bare_name), "__wasm_v128_load32x2_s") ||
    eq(clone(bare_name), "__wasm_v128_load32x2_u")
}

fn simd_i32x4_is_v128(bare_name: String) -> bool {
    if !starts_with(clone(bare_name), "__simd_i32x4_") {
        return false
    }
    if ends_with(clone(bare_name), "_extract_lane") {
        return false
    }
    if ends_with(clone(bare_name), "_all_true") {
        return false
    }
    if ends_with(clone(bare_name), "_bitmask") {
        return false
    }
    true
}

fn simd_i8x16_is_v128(bare_name: String) -> bool {
    if !starts_with(clone(bare_name), "__simd_i8x16_") {
        return false
    }
    if ends_with(clone(bare_name), "_extract_lane_s") {
        return false
    }
    if ends_with(clone(bare_name), "_extract_lane_u") {
        return false
    }
    if ends_with(clone(bare_name), "_all_true") {
        return false
    }
    if ends_with(clone(bare_name), "_bitmask") {
        return false
    }
    true
}

fn simd_i16x8_is_v128(bare_name: String) -> bool {
    if !starts_with(clone(bare_name), "__simd_i16x8_") {
        return false
    }
    if ends_with(clone(bare_name), "_extract_lane_s") {
        return false
    }
    if ends_with(clone(bare_name), "_extract_lane_u") {
        return false
    }
    if ends_with(clone(bare_name), "_all_true") {
        return false
    }
    if ends_with(clone(bare_name), "_bitmask") {
        return false
    }
    true
}
