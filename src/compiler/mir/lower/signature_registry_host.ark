use corehir::kinds
use corehir::function_id
use corehir::signature_entry
use corehir::signature_registry
use corehir::type_table
use corehir::core_op_binding
use mir::host_intrinsic_stub_names

fn sig_reg_register_host_intrinsics(table: TypeTable, registry: SignatureRegistry) -> i32 {
    let stub_count = host_intrinsic_stub_names::host_intrinsic_stub_count()
    let mut missing = 0
    let mut i = 0
    while i < stub_count {
        let stub_name = host_intrinsic_stub_names::host_intrinsic_stub_name_at(i)
        if !sig_reg_registry_has_mangled(registry, clone(stub_name)) {
            sig_reg_register_host_entry(table, registry, clone(stub_name))
            missing = missing + 1
        }
        i = i + 1
    }
    sig_reg_log_stub_diff(registry, stub_count)
    missing
}

fn sig_reg_registry_has_mangled(registry: SignatureRegistry, name: String) -> bool {
    let count = signature_registry::signature_registry_entry_count(registry)
    let mut i = 0
    while i < count {
        if eq(clone(name), signature_registry::signature_registry_mangled_at(registry, i)) {
            return true
        }
        i = i + 1
    }
    false
}

fn sig_reg_register_host_entry(table: TypeTable, registry: SignatureRegistry, name: String) {
    let returns = Vec_new_MirValueType()
    push(returns, sig_reg_host_return_mvt(table, clone(name)))
    let params = Vec_new_MirValueType()
    let receiver = mir_value_type::MirValueType_new(
        type_table::TypeTable_intern(table, kinds::TYPE_KIND_PRIMITIVE(), "void", Vec_new_TypeId()),
        kinds::VALUE_REPR_SCALAR(),
        kinds::NULLABILITY_NOT_REF()
    )
    let entry = signature_entry::SignatureEntry_new(
        function_id::FunctionId_new(0),
        clone(name),
        params,
        returns,
        false,
        receiver,
        0 - 1,
        0 - 1,
        0 - 1,
        kinds::ABI_KIND_HOST_INTRINSIC(),
        core_op_binding::core_op_binding_lookup_for_mangled(clone(name))
    )
    signature_registry::signature_registry_register(registry, entry, name)
}

// Host stub return shapes used when the mangled name is absent from the
// regular fn index. Keep names aligned with std::host surfaces.
fn sig_reg_host_return_mvt(table: TypeTable, name: String) -> MirValueType {
    if sig_reg_host_returns_bool(clone(name)) {
        let id = type_table::TypeTable_intern(table, kinds::TYPE_KIND_PRIMITIVE(), "bool", Vec_new_TypeId())
        return mir_value_type::MirValueType_new(id, kinds::VALUE_REPR_SCALAR(), kinds::NULLABILITY_NOT_REF())
    }
    if eq(clone(name), String_from("clock_now")) {
        let id = type_table::TypeTable_intern(table, kinds::TYPE_KIND_PRIMITIVE(), "i64", Vec_new_TypeId())
        return mir_value_type::MirValueType_new(id, kinds::VALUE_REPR_SCALAR(), kinds::NULLABILITY_NOT_REF())
    }
    if eq(clone(name), String_from("args")) {
        let id = type_table::TypeTable_intern(table, kinds::TYPE_KIND_VEC(), "Vec<String>", Vec_new_TypeId())
        return mir_value_type::MirValueType_new(id, kinds::VALUE_REPR_GC_REF(), kinds::NULLABILITY_NULLABLE())
    }
    if sig_reg_host_returns_option_string(clone(name)) {
        let id = type_table::TypeTable_intern(table, kinds::TYPE_KIND_OPTION(), "Option<String>", Vec_new_TypeId())
        return mir_value_type::MirValueType_new(id, kinds::VALUE_REPR_GC_REF(), kinds::NULLABILITY_NULLABLE())
    }
    if sig_reg_host_returns_result_i32(clone(name)) {
        let id = type_table::TypeTable_intern(table, kinds::TYPE_KIND_RESULT(), "Result<i32, String>", Vec_new_TypeId())
        return mir_value_type::MirValueType_new(id, kinds::VALUE_REPR_GC_REF(), kinds::NULLABILITY_NULLABLE())
    }
    if eq(clone(name), String_from("read")) {
        let id = type_table::TypeTable_intern(table, kinds::TYPE_KIND_RESULT(), "Result<Vec<i32>, String>", Vec_new_TypeId())
        return mir_value_type::MirValueType_new(id, kinds::VALUE_REPR_GC_REF(), kinds::NULLABILITY_NULLABLE())
    }
    if sig_reg_host_returns_result_string(clone(name)) {
        let id = type_table::TypeTable_intern(table, kinds::TYPE_KIND_RESULT(), "Result<String, String>", Vec_new_TypeId())
        return mir_value_type::MirValueType_new(id, kinds::VALUE_REPR_GC_REF(), kinds::NULLABILITY_NULLABLE())
    }
    if eq(clone(name), String_from("serve")) {
        let id = type_table::TypeTable_intern(table, kinds::TYPE_KIND_RESULT(), "Result<(), String>", Vec_new_TypeId())
        return mir_value_type::MirValueType_new(id, kinds::VALUE_REPR_GC_REF(), kinds::NULLABILITY_NULLABLE())
    }
    // var_or_default / read_stdin and remaining string returns
    let id = type_table::TypeTable_intern(table, kinds::TYPE_KIND_STRING(), "String", Vec_new_TypeId())
    mir_value_type::MirValueType_new(id, kinds::VALUE_REPR_GC_REF(), kinds::NULLABILITY_NULLABLE())
}

fn sig_reg_host_returns_bool(name: String) -> bool {
    eq(clone(name), String_from("exists")) ||
    eq(clone(name), String_from("is_file")) ||
    eq(clone(name), String_from("is_dir")) ||
    eq(clone(name), String_from("is_readable_file"))
}

fn sig_reg_host_returns_option_string(name: String) -> bool {
    eq(clone(name), String_from("arg_at")) ||
    eq(clone(name), String_from("var")) ||
    eq(clone(name), String_from("get_var"))
}

fn sig_reg_host_returns_result_i32(name: String) -> bool {
    eq(clone(name), String_from("connect")) ||
    eq(clone(name), String_from("listen")) ||
    eq(clone(name), String_from("accept")) ||
    eq(clone(name), String_from("write"))
}

fn sig_reg_host_returns_result_string(name: String) -> bool {
    eq(clone(name), String_from("get")) ||
    eq(clone(name), String_from("request"))
}

fn sig_reg_log_stub_diff(registry: SignatureRegistry, stub_count: i32) {
    let mut diff = 0
    let mut i = 0
    while i < stub_count {
        let stub_name = host_intrinsic_stub_names::host_intrinsic_stub_name_at(i)
        if !sig_reg_registry_has_mangled(registry, clone(stub_name)) {
            diff = diff + 1
        }
        i = i + 1
    }
    if diff > 0 {
        stdio::eprintln(concat("sig-reg: host intrinsic stub diff count=", i32_to_string(diff)))
    }
}
