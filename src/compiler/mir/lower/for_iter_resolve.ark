use mir::lower::ctx_fn_return_type
use mir::lower::ctx_fn_exists
use mir::lower::ctx_fn_mono
use mir::lower::loop_vec
use mir::lower::method_resolve

// Resolve the concrete IntoIterator owner used by a `for` source. The
// lowering runs after monomorphisation, so this is a concrete type lookup;
// generic type variables must not be turned into guessed method names.
use std::text
fn mir_for_into_iterator_owner(source_type: String) -> String {
    let normalized = method_resolve::mir_normalize_type_name(source_type.clone())
    if normalized.len() == 0 || normalized.byte_at(0) == 63 {
        return String_from("")
    }
    if loop_vec::mir_is_vec_type_name(source_type.clone()) {
        let element_type = loop_vec::mir_vec_element_type_name(source_type.clone())
        if element_type.clone().eq("i32") || element_type.clone().eq("I32") {
            return String_from("Vec")
        }
        if element_type.clone().eq("String") || element_type.clone().eq("string") {
            return String_from("Vec_String")
        }
        return String_from("")
    }
    let hashmap_owner = method_resolve::mir_hashmap_impl_owner_name(normalized.clone())
    if hashmap_owner.len() > 0 {
        return hashmap_owner
    }
    // Concrete generic sources (GenTakeIter<VecIter>) own their IntoIterator
    // impl under the per-instantiation owner (GenTakeIter_VecIter).
    method_resolve::mir_inst_owner_name(normalized)
}

fn mir_for_into_iterator_type(mut ctx: LowerCtx, span_start: i32, source_type: String) -> String {
    let callee = mir_for_into_iterator_callee(ctx, span_start, source_type)
    if callee.len() == 0 {
        return String_from("")
    }
    ctx_fn_return_type::ctx_fn_return_type_name(ctx, callee)
}

// Resolve the `into_iter` callee for a `for` source. Concrete-instantiation
// impls live under the per-instantiation owner (`Ctor_arg::into_iter`);
// parametric impls (`impl IntoIterator for Ctor<T>`) live under the bare
// constructor owner (`Ctor::into_iter`). The instantiated owner wins when
// both exist because it is the more specific impl.
fn mir_for_into_iterator_callee(mut ctx: LowerCtx, span_start: i32, source_type: String) -> String {
    let owner = mir_for_into_iterator_owner(source_type.clone())
    if owner.len() > 0 {
        let resolved = mir_for_desugar_callee(
            ctx,
            span_start,
            owner.clone().concat("::into_iter")
        )
        if resolved.len() > 0 {
            return resolved
        }
    }
    let bare = method_resolve::mir_bare_owner_name(source_type)
    if bare.len() == 0 || bare.clone().eq(owner.clone()) {
        return String_new()
    }
    mir_for_desugar_callee(ctx, span_start, bare.concat("::into_iter"))
}

// Resolve the `next` callee for a `for` iterator with the same
// instantiation-then-bare-owner order as `into_iter`.
fn mir_for_next_callee(mut ctx: LowerCtx, span_start: i32, iterator_type: String) -> String {
    let inst_next = method_resolve::mir_inst_owner_name(iterator_type.clone()).concat("::next")
    let resolved = mir_for_desugar_callee(ctx, span_start, inst_next.clone())
    if resolved.len() > 0 {
        return resolved
    }
    let bare_next = method_resolve::mir_bare_owner_name(iterator_type).concat("::next")
    if bare_next.clone().eq(inst_next.clone()) {
        return String_new()
    }
    mir_for_desugar_callee(ctx, span_start, bare_next)
}

// Resolve a desugared for-call to its emitted symbol. Concrete impls
// register plain Owner::method symbols; parametric impls (ADR-078) only
// exist as mangled mono variants found through the per-site span rewrite
// recorded by the typechecker or, as a fallback, the first registered
// name rewrite for the declared callee.
fn mir_for_desugar_callee(mut ctx: LowerCtx, span_start: i32, declared: String) -> String {
    let span_target = ctx_fn_mono::ctx_mono_lookup_call(ctx, span_start, declared.clone())
    if span_target.len() > 0 {
        return span_target
    }
    if ctx_fn_exists::ctx_has_fn_name(ctx, declared.clone()) {
        return declared
    }
    // Per-instantiation owner spellings (Take_VecIter::next) map to the
    // propagated parametric instance (Take__next__VecIter) by argument
    // segments; the instantiation-blind name pool only runs after that.
    let parametric_target = method_resolve::mir_parametric_impl_callee(ctx, declared.clone())
    if parametric_target.len() > 0 {
        return parametric_target
    }
    let name_target = ctx_fn_mono::ctx_mono_lookup_name_rewrite(ctx, declared.clone())
    if name_target.len() > 0 {
        return name_target
    }
    String_new()
}
