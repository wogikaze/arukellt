use std::prelude::{clone}
use mir::lower::ast_node
use mir::lower::control
use mir::lower::ctx_api_function_frame
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_fn_index
use mir::lower::value_variants
use mir::lower_kinds
use mir::value_types
fn lower_return_stmt(ctx: LowerCtx, node: AstNode) -> i32 {
    let child_count = ast_node::node_child_count(node)
    if child_count >= 1 {
        let expr = ast_node::node_child_at(node, 0)
        let val_idx = if mir_return_expr_is_fn_value(ctx, expr) {
            value_variants::lower_function_value(ctx, ast_node::node_text(expr))
        } else {
            lower_expr(ctx, expr)
        }
        control::mir_emit_return_value(ctx, val_idx)
    } else {
        control::mir_emit_return_void(ctx)
    }
    0 - 1
}

// `return answer` inside a `-> fn(...) -> R` body must lower the bare fn
// name to a fn pair; otherwise a 0-param ident lowers to `call answer()`
// and the scalar lands in the funcref return slot (#884).
fn mir_return_expr_is_fn_value(ctx: LowerCtx, expr: AstNode) -> bool {
    if ctx_api_function_frame::ctx_current_return_type(ctx) != value_types::VT_FUNCREF() {
        return false
    }
    if !ast_node::node_kind_is(expr, lower_kinds::NK_IDENT()) {
        return false
    }
    let expr_name = ast_node::node_text(expr)
    if ctx_api_local_alloc::ctx_lookup_local(ctx, clone(expr_name)) >= 0 {
        return false
    }
    ctx_fn_index::ctx_fn_index_find(ctx, expr_name) >= 0
}
