// MIR match payload GC bind type resolution.
use std::text
use mir::lower::ctx_gc_enum
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_layout
fn emit_payload_field_bind_gc_resolve_type(mut ctx: LowerCtx, variant_name: String, field_idx: i32, bind_local: i32) -> String {
    let mut bind_type_name = ctx_get_local_type(ctx, bind_local)
    // A bind declared as `T` inside a monomorphized body must use the
    // concrete argument so variant-layout matching compares real payload
    // types instead of the parameter name (#882).
    let resolved_bind = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, bind_type_name.clone())
    if len(resolved_bind) > 0 {
        bind_type_name = resolved_bind
        ctx_set_local_type(ctx, bind_local, bind_type_name.clone())
    }
    // When the bind already has a concrete payload type (from scrutinee
    // inference), select the matching Option/Result layout instead of the
    // first same-named Some/Ok/Err registration.
    let layout_ft = if len(bind_type_name) > 0 && !bind_type_name.clone().eq("enum:open") {
        ctx_struct_field_type::ctx_struct_field_type_name_for_payload(ctx, variant_name.clone(), field_idx + 1, bind_type_name.clone())
    } else {
        ctx_struct_field_type::ctx_struct_field_type_name(ctx, variant_name.clone(), field_idx + 1)
    }
    let resolved_layout_ft = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, layout_ft.clone())
    let layout_norm = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, resolved_layout_ft.clone())
    let mut layout_vec = String_new()
    if layout_norm.clone().starts_with("vec:") {
        layout_vec = layout_norm.clone()
    } else if layout_norm.clone().starts_with("Vec<") && layout_norm.clone().ends_with(">") {
        layout_vec = "vec:".concat(layout_norm.clone().slice(4, len(layout_norm) - 1))
    } else if layout_norm.clone().starts_with("Vec_") {
        layout_vec = "vec:".concat(layout_norm.clone().slice(4, len(layout_norm)))
    } else if layout_norm.clone().eq("Vec") {
        layout_vec = "vec:i32"
    }
    if len(layout_vec) > 0 {
        bind_type_name = layout_vec
        ctx_set_local_type(ctx, bind_local, bind_type_name.clone())
    } else if len(bind_type_name) == 0 || bind_type_name.clone().eq("enum:open") {
        if len(layout_norm) > 0 {
            bind_type_name = layout_norm
            ctx_set_local_type(ctx, bind_local, bind_type_name.clone())
        }
    }
    if ctx_gc_enum::gc_enum_variant_is_vec_container(variant_name.clone()) {
        if !bind_type_name.clone().starts_with("vec:") && !bind_type_name.clone().starts_with("Vec") {
            let bare = ctx_gc_enum::ctx_gc_enum_bare_variant_name(variant_name.clone())
            if bare.clone().eq("Table") {
                bind_type_name = "vec:TomlField"
            } else if bare.clone().eq("Object") {
                bind_type_name = "vec:JsonField"
            } else if bare.clone().eq("Array") {
                if variant_name.clone().starts_with("Json") || variant_name.clone().contains("JsonValue") {
                    bind_type_name = "vec:JsonValue"
                } else {
                    bind_type_name = "vec:TomlValue"
                }
            } else {
                bind_type_name = "vec:TomlValue"
            }
            ctx_set_local_type(ctx, bind_local, bind_type_name.clone())
        }
    }
    bind_type_name
}
