use mir::lower::ctx_api_local_types
use mir::lower::ctx_decl_return
use mir::lower::ctx_fn_return_type
use mir::lower::ctx_fn_return_vt
use mir::lower::ctx_resolved_calls
use mir::lower::ctx_types
use mir::lower::core_call_arg_names
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_atoms
use mir::lower::core_expr_shape_calls
use mir::lower::core_expr_shape_ops
use mir::value_types
fn mir_core_print_arg_needs_string_conversion(ctx: LowerCtx, arg: CoreHirExpr, arg_idx: i32) -> bool {
    if core_expr_shape_calls::mir_core_expr_is_call(arg) {
        let cn = core_expr_shape_accessors::mir_core_expr_text(arg)
        if core_call_arg_names::mir_core_call_callee_returns_string(ctx, cn.clone()) {
            return false
        }
        // Prefer the checker-resolved declaration's return contract over the
        // flat name index (see call_arg_print_needs, #934).
        let decl_fid = ctx_resolved_calls::ctx_resolved_call_decl_fid(
            ctx,
            core_expr_shape_accessors::mir_core_expr_span_start(arg),
            cn.clone()
        )
        let return_type_name = if decl_fid >= 0 {
            ctx_decl_return::ctx_decl_return_type_name(ctx, decl_fid)
        } else {
            ctx_fn_return_type::ctx_fn_return_type_name(ctx, cn.clone())
        }
        if return_type_name.clone().eq("String") || return_type_name.clone().eq("str") || return_type_name.clone().eq("string") {
            return false
        }
        let rv = if decl_fid >= 0 {
            ctx_decl_return::ctx_decl_return_vt(ctx, decl_fid)
        } else {
            ctx_fn_return_vt::ctx_fn_return_vt(ctx, cn.clone())
        }
        if rv == value_types::VT_GC_REF() || rv == value_types::VT_REF() {
            return false
        }
        if return_type_name.len() > 0 {
            if rv == value_types::VT_I32() || rv == value_types::VT_I64() || rv == value_types::VT_F64() {
                return true
            }
        }
    }
    if arg_idx >= 0 {
        let lt = ctx_api_local_types::ctx_get_local_type(ctx, arg_idx)
        if lt.clone().eq("String") || lt.clone().eq("str") || lt.clone().eq("string") {
            return false
        }
        let arg_vt = ctx_api_local_types::ctx_local_vt(ctx, arg_idx)
        if arg_vt == value_types::VT_I32() || arg_vt == value_types::VT_I64() || arg_vt == value_types::VT_F64() {
            return true
        }
    }
    let mut needs_convert = core_expr_shape_atoms::mir_core_expr_is_int(arg) ||
    core_expr_shape_atoms::mir_core_expr_is_bool(arg) ||
    core_expr_shape_atoms::mir_core_expr_is_char(arg) ||
    core_expr_shape_atoms::mir_core_expr_is_float(arg) ||
    core_expr_shape_ops::mir_core_expr_is_unary(arg)
    if !needs_convert {
        let lt = ctx_api_local_types::ctx_get_local_type(ctx, arg_idx)
        if lt.clone().eq("char") ||
        lt.clone().eq("u8") ||
        lt.clone().eq("i8") ||
        lt.clone().eq("u16") ||
        lt.clone().eq("u32") ||
        lt.clone().eq("u64") ||
        lt.clone().eq("i16") ||
        lt.clone().eq("i32") ||
        lt.clone().eq("i64") ||
        lt.clone().eq("bool") ||
        lt.clone().eq("f64") {
            needs_convert = true
        }
    }
    needs_convert
}
