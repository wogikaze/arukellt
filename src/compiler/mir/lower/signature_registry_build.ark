use std::text
use corehir::kinds
use corehir::mir_signature_method
use corehir::signature_registry
use corehir::type_table
use corehir::core_op_binding
use corehir::core_op_id
use corehir::signature_entry
use mir::lower::decl_source
use mir::lower::fn_index_source
use mir::lower::mono_instance_table
use mir::lower::signature_registry_build_mono
use mir::lower::signature_registry_entry
use mir::lower::signature_registry_host
use mir::lower::signature_registry_builtin
use mir::lower::signature_spine
use corehir::param
use corehir::mir_signature_fn
use mir::lower::stdlib_body_defer
use mir::mono
use corehir::function_id
use corehir::type_contracts
fn mir_build_signature_spine_from_view(view: CoreHirMirView, midx: MonoIndex, expected_fn_names: Vec<String>) -> MirSignatureSpine {
    let mut table = type_table::TypeTable_new()
    let mut registry = signature_registry::SignatureRegistry_new()
    let mut mono_table = mono_instance_table::MonoInstanceTable_new()
    let decl_source = decl_source::mir_decl_source_from_view(view)
    let decl_count = decl_source::mir_decl_source_count(decl_source)
    let source = fn_index_source::mir_fn_index_source_from_view(view)
    let sig_source = corehir::mod::view_signature_source(view)
    let leaf_index = signature_registry_build_mono::SigRegLeafIndex::build(
        fn_index_source::mir_fn_index_source_mono_instances(source)
    )
    let mut d = 0
    let mut fn_counter = 0
    while d < decl_count {
        let decl_name = decl_source::mir_decl_source_name_at(decl_source, d)
        if decl_source::mir_decl_source_is_fn_at(decl_source, d) {
            sig_reg_index_top_level_fn(table, registry, mono_table, source, sig_source, midx, d, decl_name, fn_counter, leaf_index)
            fn_counter = fn_counter + 1
        }
        if decl_source::mir_decl_source_is_impl_at(decl_source, d) {
            let owner = mir_signature_method::mir_signature_method_owner_name_for_impl(sig_source, d, decl_name)
            sig_reg_index_impl_methods(table, registry, mono_table, source, sig_source, midx, d, owner)
        }
        d = d + 1
    }
    signature_registry_host::sig_reg_register_host_intrinsics(table, registry)
    signature_registry_builtin::sig_reg_register_builtin_intrinsics(table, registry)
    signature_registry_apply_core_op_bindings(registry)
    sig_reg_log_count_match(expected_fn_names, registry)
    signature_spine::MirSignatureSpine_new(table, registry, mono_table)
}

fn signature_registry_apply_core_op_bindings(mut registry: SignatureRegistry) {
    let count = signature_registry::signature_registry_entry_count(registry)
    let mut i = 0
    while i < count {
        let entry = signature_registry::signature_registry_entry_at(registry, i)
        if core_op_id::core_op_id_is_some(signature_entry::signature_entry_core_op_id(entry)) {
            i = i + 1
            continue
        }
        let mangled = signature_registry::signature_registry_mangled_at(registry, i)
        let coid = core_op_binding::core_op_binding_lookup_for_mangled(mangled.clone())
        if core_op_id::core_op_id_is_some(coid) {
            signature_registry::signature_registry_set_core_op_id_at(registry, i, coid)
        }
        i = i + 1
    }
}

fn sig_reg_log_count_match(expected_fn_names: Vec<String>, registry: SignatureRegistry) {
    let fn_count = len(expected_fn_names)
    let reg_count = signature_registry::signature_registry_entry_count(registry)
    let host_count = signature_registry::signature_registry_host_intrinsic_count(registry)
    let builtin_count = signature_registry::signature_registry_builtin_count(registry)
    let reg_function = reg_count - host_count - builtin_count
    if fn_count != reg_function {
        let counts = (fn_count).to_string().concat(String_from(" reg=").concat((reg_function).to_string()))
        stdio::eprintln(String_from("sig-reg: fn_index/registry count mismatch fn=").concat(counts))
    }
}

fn sig_reg_index_top_level_fn(
    mut table: TypeTable,
    mut registry: SignatureRegistry,
    mut mono_table: MonoInstanceTable,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    midx: MonoIndex,
    decl_index: i32,
    decl_name: String,
    fn_counter: i32,
    leaf_index: signature_registry_build_mono::SigRegLeafIndex
) {
    let mut typed_index = fn_counter
    let fn_info_index = fn_index_source::mir_fn_index_source_fn_info_index_for_decl(source, decl_index)
    if fn_info_index >= 0 {
        typed_index = fn_index_source::mir_fn_index_source_fn_typed_index_at(source, fn_info_index, typed_index)
    }
    let entry_main = fn_index_source::mir_fn_index_source_entry_main_decl_index(source)
    let skip_shadow = decl_name.clone().eq(String_from("main")) && decl_index != entry_main
    // string.join(Vec,…) stays CoreOp-only; registering it as bare `join`
    // overwrites path::join(String,String) and yields invalid wasm (#807).
    if !skip_shadow && !sig_reg_skip_join_vec_overload(sig_source, fn_info_index, decl_name.clone()) {
        let qualified_name = fn_index_source::mir_fn_index_source_fn_qualified_name_at(source, fn_info_index)
        let mut registered = function_id::FUNCTION_ID_INVALID()
        // A generic whose instances all arrived through the qualified path
        // emits one leaf-named concrete body (entry_fns_mono). Its decl entry
        // is what qualified calls resolve, so register that instance's
        // concrete signature instead of the declared vec:T.
        let mut leaf_inst_idx = 0 - 1
        if mono::mono_index_count(midx, decl_name.clone()) == 0 {
            leaf_inst_idx = signature_registry_build_mono::SigRegLeafIndex::instance_index(
                leaf_index,
                fn_index_source::mir_fn_index_source_mono_instances(source),
                decl_name.clone(),
                qualified_name.clone()
            )
        }
        if leaf_inst_idx >= 0 {
            let leaf_inst = get_unchecked(
                fn_index_source::mir_fn_index_source_mono_instances(source),
                leaf_inst_idx
            )
            registered = signature_registry_entry::sig_reg_register_fn_leaf_instance(
                table,
                registry,
                mono_table,
                source,
                sig_source,
                fn_info_index,
                typed_index,
                decl_name.clone(),
                type_contracts::MonoInstance_mangled_name(leaf_inst),
                fn_index_source::mir_fn_index_source_mono_instances(source),
                decl_index
            )
        } else {
            registered = signature_registry_entry::sig_reg_register_fn(table, registry, source, sig_source, fn_info_index, typed_index, decl_name.clone(), decl_index, 0 - 1, kinds::ABI_KIND_NORMAL())
        }
        if sig_reg_fn_is_signature_only(source, fn_info_index, decl_name.clone()) {
            signature_registry::signature_registry_mark_signature_only(registry, FunctionId_raw(registered))
        }
        if len(qualified_name) > 0 {
            signature_registry::signature_registry_register_alias(registry, qualified_name.clone(), registered)
            let import_name = sig_reg_import_facing_qualified_name(qualified_name)
            let qualified_coid = core_op_binding::core_op_binding_lookup_for_callee(qualified_name.clone())
            if core_op_id::core_op_id_is_some(qualified_coid) {
                signature_registry::signature_registry_set_core_op_id_at(
                    registry,
                    FunctionId_raw(registered),
                    qualified_coid
                )
            }
            if len(import_name) > 0 {
                signature_registry::signature_registry_register_alias(registry, import_name, registered)
            }
        }
        // Mono variants belong to the generic decl only. A concrete decl
        // sharing the bare name with an entry-module generic would claim
        // the same mono-index group and register identity__String with its
        // own concrete param signature (#914).
        if fn_index_source::mir_fn_index_source_decl_is_generic(source, typed_index) {
            signature_registry_build_mono::sig_reg_index_mono_variants(table, registry, mono_table, source, sig_source, midx, decl_name.clone(), typed_index, fn_info_index, decl_index)
            // Qualified-keyed instances (Test::assert_eq_debug__i32, ...) also
            // need registry entries so call sites can bind variant FunctionIds.
            // The decl keeps the generic signature as the unresolved fallback.
            // Instances can arrive under both keys: a same-module wrapper records
            // the bare name while downstream calls record the qualified name
            // (#908). The bare==0 && qualified==1 case stays on the leaf
            // registration above; anything beyond that needs per-variant entries.
            let bare_mono_count = mono::mono_index_count(midx, decl_name.clone())
            let mut qualified_mono_count = 0
            if len(qualified_name) > 0 && !qualified_name.clone().eq(decl_name.clone()) {
                qualified_mono_count = mono::mono_index_count(midx, qualified_name.clone())
            }
            if qualified_mono_count > 1 || (bare_mono_count > 0 && qualified_mono_count > 0) {
                signature_registry_build_mono::sig_reg_index_mono_variants(table, registry, mono_table, source, sig_source, midx, qualified_name.clone(), typed_index, fn_info_index, decl_index)
            }
        }
    }
}

// Imported stdlib modules are addressed as `path::join`/`stdio::println` in
// source, while the flattened declaration keeps the `std::`/`std::host::`
// prefixes. Keep both names on the same registry entry so qualified calls use
// the declaration's signature and FunctionId.
fn sig_reg_import_facing_qualified_name(qualified_name: String) -> String {
    let n = len(qualified_name)
    let mut last = 0 - 1
    let mut previous = 0 - 1
    let mut i = 0
    while i < n - 1 {
        if qualified_name.byte_at(i) == 58 && qualified_name.byte_at(i + 1) == 58 {
            previous = last
            last = i
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if previous < 0 {
        return String_new()
    }
    qualified_name.slice(previous + 2, n)
}

fn sig_reg_skip_join_vec_overload(sig_source: CoreHirMirSignatureSource, fn_info_index: i32, decl_name: String) -> bool {
    if !decl_name.clone().eq(String_from("join")) {
        return false
    }
    if fn_info_index < 0 {
        return false
    }
    let param_count = mir_signature_fn::mir_signature_fn_param_count_at(sig_source, fn_info_index, 0)
    if param_count <= 0 {
        return false
    }
    let param0 = mir_signature_fn::mir_signature_fn_param_at(sig_source, fn_info_index, 0)
    stdlib_body_defer::mir_is_vec_join_overload(decl_name.clone(), param0)
}

// Mirrors mir_defer_body_for_decl: a stdlib decl whose body is deferred for
// CoreOp / intrinsic-shim lowering registers its signature but never emits
// a MirFunction. Mark the entry so same-name fid chains skip it — otherwise
// the deferred decl consumes the chain slot that belongs to an emitted user
// fn sharing the bare name (#920: user strings::repeat bound a stdlib
// "repeat" fid, was pruned as unreachable, and its call site stayed an
// unpatched call 0).
fn sig_reg_fn_is_signature_only(
    source: MirLowerFnIndexSource,
    fn_info_index: i32,
    decl_name: String
) -> bool {
    let is_stdlib = fn_index_source::mir_fn_index_source_fn_is_stdlib_at(source, fn_info_index, true)
    if !is_stdlib {
        return false
    }
    if fn_info_index >= 0 && fn_index_source::mir_fn_index_source_fn_param_count_at(source, fn_info_index) > 0 {
        if decl_name.clone().eq(String_from("write_bytes")) ||
        decl_name.clone().eq(String_from("join")) {
            let param0 = fn_index_source::mir_fn_index_source_fn_param_at(source, fn_info_index, 0)
            return stdlib_body_defer::mir_should_defer_stdlib_body_with_param0(decl_name.clone(), param0)
        }
    }
    let qualified_name = fn_index_source::mir_fn_index_source_fn_qualified_name_at(source, fn_info_index)
    stdlib_body_defer::mir_should_defer_stdlib_body_for_qualified(decl_name, qualified_name)
}

fn sig_reg_index_impl_methods(
    mut table: TypeTable,
    mut registry: SignatureRegistry,
    mut mono_table: MonoInstanceTable,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    midx: MonoIndex,
    impl_decl_index: i32,
    struct_name: String
) {
    let method_count = fn_index_source::mir_fn_index_source_method_count_for_impl(source, impl_decl_index)
    let mut mi = 0
    while mi < method_count {
        let method_info_index = fn_index_source::mir_fn_index_source_method_info_index(source, impl_decl_index, mi)
        let mut mangled = struct_name.clone()
        if method_info_index >= 0 {
            mangled = fn_index_source::mir_fn_index_source_method_mangled_name_at(source, method_info_index, mangled)
        }
        signature_registry_entry::sig_reg_register_method(table, registry, mono_table, source, sig_source, method_info_index, mangled.clone(), impl_decl_index)
        signature_registry_build_mono::sig_reg_index_method_mono(table, registry, mono_table, source, sig_source, midx, mangled.clone(), method_info_index, impl_decl_index)
        mi = mi + 1
    }
}
