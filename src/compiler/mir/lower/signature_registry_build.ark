use corehir::kinds
use corehir::function_id
use corehir::mir_signature_method
use corehir::signature_registry
use corehir::type_table
use corehir::core_op_binding
use corehir::core_op_id
use mir::lower::decl_source
use mir::lower::fn_index_source
use mir::lower::mono_instance_table
use mir::lower::signature_registry_build_mono
use mir::lower::signature_registry_entry
use mir::lower::signature_registry_host
use mir::lower::signature_spine

fn mir_build_signature_spine_from_view(view: CoreHirMirView, midx: MonoIndex, expected_fn_names: Vec<String>) -> MirSignatureSpine {
    let table = type_table::TypeTable_new()
    let registry = signature_registry::SignatureRegistry_new()
    let mono_table = mono_instance_table::MonoInstanceTable_new()
    let decl_source = decl_source::mir_decl_source_from_view(view)
    let decl_count = decl_source::mir_decl_source_count(decl_source)
    let source = fn_index_source::mir_fn_index_source_from_view(view)
    let sig_source = corehir::mod::view_signature_source(view)
    let mut d = 0
    while d < decl_count {
        let decl_name = decl_source::mir_decl_source_name_at(decl_source, d)
        if decl_source::mir_decl_source_is_fn_at(decl_source, d) {
            sig_reg_index_top_level_fn(table, registry, mono_table, source, sig_source, midx, d, decl_name)
        }
        if decl_source::mir_decl_source_is_impl_at(decl_source, d) {
            let owner = mir_signature_method::mir_signature_method_owner_name_for_impl(sig_source, d, decl_name)
            sig_reg_index_impl_methods(table, registry, mono_table, source, sig_source, midx, d, owner)
        }
        d = d + 1
    }
    signature_registry_host::sig_reg_register_host_intrinsics(table, registry)
    signature_registry_apply_core_op_bindings(registry)
    sig_reg_log_count_match(expected_fn_names, registry)
    signature_spine::MirSignatureSpine_new(table, registry, mono_table)
}

fn signature_registry_is_first_mangled_entry(registry: SignatureRegistry, index: i32, mangled: String) -> bool {
    let mut prior = 0
    while prior < index {
        if eq(signature_registry::signature_registry_mangled_at(registry, prior), clone(mangled)) {
            return false
        }
        prior = prior + 1
    }
    true
}

fn signature_registry_apply_core_op_bindings(registry: SignatureRegistry) {
    let count = signature_registry::signature_registry_entry_count(registry)
    let mut i = 0
    while i < count {
        let mangled = signature_registry::signature_registry_mangled_at(registry, i)
        let coid = core_op_binding::core_op_binding_lookup_for_mangled(clone(mangled))
        // Bare aliases like `join` → string.join must not stamp every same-leaf
        // stdlib twin (`path::join`, later `text::join` bodies). Only the first
        // registry entry with that short mangled name inherits the bare CoreOp.
        if core_op_id::core_op_id_is_some(coid) &&
        signature_registry_is_first_mangled_entry(registry, i, mangled) {
            signature_registry::signature_registry_set_core_op_id_at(registry, i, coid)
        }
        i = i + 1
    }
}

fn sig_reg_log_count_match(expected_fn_names: Vec<String>, registry: SignatureRegistry) {
    let fn_count = len(expected_fn_names)
    let reg_count = signature_registry::signature_registry_entry_count(registry)
    let host_count = signature_registry::signature_registry_host_intrinsic_count(registry)
    let reg_normal = reg_count - host_count
    if fn_count != reg_normal {
        stdio::eprintln(concat(String_from("sig-reg: fn_index/registry count mismatch fn="), concat(i32_to_string(fn_count), concat(String_from(" reg="), i32_to_string(reg_normal)))))
    }
}

fn sig_reg_import_facing_qualified_name(qualified_name: String) -> String {
    let name_len = len(qualified_name)
    let separators = Vec_new_i32()
    let mut index = 0
    while index < name_len - 1 {
        if char_at(qualified_name, index) == 58 && char_at(qualified_name, index + 1) == 58 {
            push(separators, index)
            index = index + 2
        } else {
            index = index + 1
        }
    }
    if len(separators) < 2 {
        return String_new()
    }
    substring(qualified_name, get_unchecked(separators, len(separators) - 2) + 2, name_len)
}

fn sig_reg_add_qualified_name_aliases(
    registry: SignatureRegistry,
    source: MirLowerFnIndexSource,
    fn_info_index: i32,
    decl_name: String,
    fid: FunctionId
) {
    // Primary mangled stays the short decl name (native-cpp FunctionId resolve and
    // ordinal matching key on MirFunction_name). Qualified aliases let MIR_CALL
    // symbols like `path::join` hit the correct twin instead of short-name fallback.
    if fn_info_index < 0 {
        return
    }
    let qualified = fn_index_source::mir_fn_index_source_fn_qualified_name_at(source, fn_info_index)
    if len(qualified) == 0 {
        return
    }
    if !eq(clone(qualified), clone(decl_name)) {
        signature_registry::signature_registry_add_name_alias(registry, clone(qualified), fid)
    }
    let import_facing = sig_reg_import_facing_qualified_name(qualified)
    if len(import_facing) > 0 && !eq(clone(import_facing), clone(decl_name)) {
        signature_registry::signature_registry_add_name_alias(registry, import_facing, fid)
    }
}

fn sig_reg_index_top_level_fn(
    table: TypeTable,
    registry: SignatureRegistry,
    mono_table: MonoInstanceTable,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    midx: MonoIndex,
    decl_index: i32,
    decl_name: String
) {
    let mut typed_index = 0
    let fn_info_index = fn_index_source::mir_fn_index_source_fn_info_index_for_decl(source, decl_index)
    if fn_info_index >= 0 {
        typed_index = fn_index_source::mir_fn_index_source_fn_typed_index_at(source, fn_info_index, typed_index)
    }
    let entry_main = fn_index_source::mir_fn_index_source_entry_main_decl_index(source)
    let skip_shadow = eq(clone(decl_name), String_from("main")) && decl_index != entry_main
    if !skip_shadow {
        let function_id = signature_registry_entry::sig_reg_register_fn(
            table,
            registry,
            source,
            sig_source,
            fn_info_index,
            typed_index,
            clone(decl_name),
            decl_index,
            0 - 1,
            kinds::ABI_KIND_NORMAL()
        )
        sig_reg_add_qualified_name_aliases(registry, source, fn_info_index, clone(decl_name), function_id)
        signature_registry_build_mono::sig_reg_index_mono_variants(
            table,
            registry,
            mono_table,
            source,
            sig_source,
            midx,
            clone(decl_name),
            typed_index,
            fn_info_index,
            decl_index
        )
    }
}

fn sig_reg_index_impl_methods(
    table: TypeTable,
    registry: SignatureRegistry,
    mono_table: MonoInstanceTable,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    midx: MonoIndex,
    impl_decl_index: i32,
    struct_name: String
) {
    let method_count = fn_index_source::mir_fn_index_source_method_count_for_impl(source, impl_decl_index)
    let mut mi = 0
    while mi < method_count {
        let method_info_index = fn_index_source::mir_fn_index_source_method_info_index(source, impl_decl_index, mi)
        let mut mangled = clone(struct_name)
        if method_info_index >= 0 {
            mangled = fn_index_source::mir_fn_index_source_method_mangled_name_at(source, method_info_index, mangled)
        }
        signature_registry_entry::sig_reg_register_method(table, registry, source, sig_source, method_info_index, clone(mangled), impl_decl_index)
        signature_registry_build_mono::sig_reg_index_method_mono(table, registry, mono_table, source, sig_source, midx, clone(mangled), method_info_index, impl_decl_index)
        mi = mi + 1
    }
}
