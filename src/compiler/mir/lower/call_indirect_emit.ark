use mir::inst_call_ref
use mir::inst_local_get
use mir::lower::ast_node
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_types
use mir::lower::core_expr_shape_accessors
use mir::lower::call_emit_dest
use mir::lower::call_types
use mir::value_types

fn mir_is_funcref_local(ctx: LowerCtx, local_idx: i32) -> bool {
    if ctx_api_local_types::ctx_local_vt(ctx, local_idx) == value_types::VT_FUNCREF() {
        return true
    }
    let type_name = ctx_api_local_types::ctx_get_local_type(ctx, local_idx)
    if eq(clone(type_name), String_from("fnref")) || eq(clone(type_name), String_from("fn")) {
        return true
    }
    starts_with(clone(type_name), String_from("fn("))
}

fn mir_lower_indirect_call(ctx: LowerCtx, exprs: Vec<CoreHirExpr>, expr: CoreHirExpr, child_count: i32, callee_local: i32) -> i32 {
    let arg_count = child_count - 1
    let mut first_arg_vt = 0 - 1
    let mut a = 1
    while a < child_count {
        let arg_local = lower_core_expr(ctx, exprs, core_expr_shape_accessors::mir_core_expr_child(expr, a))
        if a == 1 && arg_local >= 0 {
            first_arg_vt = ctx_api_local_types::ctx_local_vt(ctx, arg_local)
        }
        a = a + 1
    }
    let mut dest = 0 - 1
    let mut dest_vt = value_types::VT_VOID()
    if arg_count != 0 {
        dest = call_emit_dest::mir_prepare_direct_call_dest(ctx, String_from("__indirect"), 0 - 1)
        call_types::mir_mark_call_result_type(ctx, String_from("__indirect"), dest, 0 - 1)
        dest_vt = ctx_api_local_types::ctx_local_vt(ctx, dest)
    }
    // Class A/B: typed funcref + call_ref. Class C keeps MIR_CALL_INDIRECT elsewhere.
    ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(callee_local))
    ctx_api_emit::ctx_emit(ctx, inst_call_ref::MirInst_call_ref_with_arg0_vt(callee_local, 0 - 1, arg_count, dest, dest_vt, first_arg_vt))
    dest
}

// AST-level funcref call lowering (Class A/B → call_ref).
fn mir_lower_ast_indirect_call(ctx: LowerCtx, node: AstNode, child_count: i32, callee_local: i32) -> i32 {
    let arg_count = child_count - 1
    let mut first_arg_vt = 0 - 1
    let mut a = 1
    while a < child_count {
        let arg = ast_node::node_child_at(node, a)
        let arg_local = lower_expr(ctx, arg)
        if a == 1 && arg_local >= 0 {
            first_arg_vt = ctx_api_local_types::ctx_local_vt(ctx, arg_local)
        }
        a = a + 1
    }
    let mut dest = 0 - 1
    let mut dest_vt = value_types::VT_VOID()
    if arg_count != 0 {
        dest = call_emit_dest::mir_prepare_direct_call_dest(ctx, String_from("__indirect"), 0 - 1)
        call_types::mir_mark_call_result_type(ctx, String_from("__indirect"), dest, 0 - 1)
        dest_vt = ctx_api_local_types::ctx_local_vt(ctx, dest)
    }
    ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(callee_local))
    ctx_api_emit::ctx_emit(ctx, inst_call_ref::MirInst_call_ref_with_arg0_vt(callee_local, 0 - 1, arg_count, dest, dest_vt, first_arg_vt))
    dest
}
