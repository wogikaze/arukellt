use std::prelude::{eq}
use mir::inst_call_ref
use mir::inst_local_get
use mir::lower::ast_node
use mir::lower::call_args
use mir::lower::call_emit_staged
use mir::lower::closure_env
use mir::lower::closure_env_layout
use mir::lower::core_call_args
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_types
use mir::lower::ctx_gc_enum
use mir::lower::core_expr_shape_accessors
use mir::lower::call_emit_dest
use mir::lower::call_types
use mir::value_types
fn mir_is_funcref_local(ctx: LowerCtx, local_idx: i32) -> bool {
    if ctx_api_local_types::ctx_local_vt(ctx, local_idx) == value_types::VT_FUNCREF() {
        return true
    }
    let type_name = ctx_api_local_types::ctx_get_local_type(ctx, local_idx)
    // fnref2 = binary fold callbacks; must take call_ref, not direct CALL (#807).
    eq(type_name.clone(), String_from("fnref")) ||
    eq(type_name.clone(), String_from("fnref2")) ||
    type_name.clone().starts_with(String_from("fnref")) ||
    type_name.clone().starts_with(String_from("fnsig:")) ||
    eq(type_name.clone(), String_from("fn")) ||
    type_name.clone().starts_with(String_from("fn("))
}

fn mark_indirect_callback_result_type(mut ctx: LowerCtx, callee_type_name: String, dest: i32) {
    if dest < 0 {
        return
    }
    if eq(callee_type_name.clone(), String_from("fnrefss")) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, String_from("String"))
        let string_vt = if ctx_gc_enum::ctx_is_gc_target(ctx) {
            value_types::VT_GC_REF()
        } else {
            value_types::VT_REF()
        }
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, string_vt)
        return
    }
    if eq(callee_type_name.clone(), String_from("fnrefsb")) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, String_from("bool"))
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_I32())
    }
    // `fnsig:<param>;<return>` carries the concrete callback signature, so
    // the call result can be typed from the return segment instead of
    // collapsing to i32 (#860/#691).
    if callee_type_name.clone().starts_with(String_from("fnsig:")) {
        mark_fnsig_callback_result_type(ctx, callee_type_name.clone(), dest)
    }
}

// Type the call_ref destination from the return segment of a
// `fnsig:<param>;<return>` callee. Scalars keep their value type; named
// and container returns are reference types on both backends.
fn mark_fnsig_callback_result_type(mut ctx: LowerCtx, callee_type_name: String, dest: i32) {
    let rest = callee_type_name.clone().slice(6, len(callee_type_name))
    let sep = rest.clone().index_of(String_from(";"))
    if sep < 0 {
        return
    }
    let ret_seg = rest.clone().slice(sep + 1, len(rest))
    if len(ret_seg) == 0 {
        return
    }
    if eq(ret_seg.clone(), String_from("i32")) || eq(ret_seg.clone(), String_from("bool")) ||
    eq(ret_seg.clone(), String_from("char")) || eq(ret_seg.clone(), String_from("u8")) ||
    eq(ret_seg.clone(), String_from("i8")) || eq(ret_seg.clone(), String_from("u16")) ||
    eq(ret_seg.clone(), String_from("u32")) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, ret_seg)
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_I32())
        return
    }
    if eq(ret_seg.clone(), String_from("i64")) || eq(ret_seg.clone(), String_from("u64")) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, ret_seg)
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_I64())
        return
    }
    if eq(ret_seg.clone(), String_from("f64")) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, ret_seg)
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_F64())
        return
    }
    if eq(ret_seg.clone(), String_from("f32")) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, ret_seg)
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_F32())
        return
    }
    ctx_api_local_types::ctx_set_local_type(ctx, dest, ret_seg)
    let ref_vt = if ctx_gc_enum::ctx_is_gc_target(ctx) {
        value_types::VT_GC_REF()
    } else {
        value_types::VT_REF()
    }
    ctx_api_local_types::ctx_set_local_vt(ctx, dest, ref_vt)
}

fn mir_lower_indirect_call(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, expr: CoreHirExpr, child_count: i32, callee_local: i32) -> i32 {
    let arg_count = child_count - 1
    let callee_type_name = ctx_api_local_types::ctx_get_local_type(ctx, callee_local)
    // Pair ABI (#872): env is pushed before the user args so the stack is
    // (env, args..., fnptr) when the call consumes it.
    closure_env::closure_emit_pair_env_arg(ctx, callee_local)
    let mut arg_lis = Vec::new<i32>()
    let mut a = 1
    while a < child_count {
        let arg_li = lower_core_expr(ctx, exprs, core_expr_shape_accessors::mir_core_expr_child(expr, a))
        if arg_li >= 0 {
            // Stage each arg like direct calls: the copy consumes a name
            // arg's just-pushed value and reloads literal/call-result temps,
            // so every staged local can be pushed unconditionally below.
            core_call_args::mir_core_stage_call_arg(ctx, arg_lis, arg_li)
        }
        a = a + 1
    }
    // Zero-arg calls need a dest too: without one the call result stays on
    // the stack untyped and expression consumers (println arg, let rhs)
    // store it into a local of the wrong type (#872).
    let dest = call_emit_dest::mir_prepare_direct_call_dest(ctx, String_from("__indirect"), 0 - 1)
    call_types::mir_mark_call_result_type(ctx, String_from("__indirect"), dest, 0 - 1)
    mark_indirect_callback_result_type(ctx, callee_type_name.clone(), dest)
    let dest_vt = ctx_api_local_types::ctx_local_vt(ctx, dest)
    call_emit_staged::mir_emit_staged_call_args(ctx, arg_lis, Vec::new<i32>())
    // The fnptr field read leaves a raw funcref/table-index on the stack;
    // the emitter casts/narrows it to the trampoline signature.
    closure_env::closure_emit_pair_fnptr(ctx, callee_local)
    ctx_api_emit::ctx_emit(ctx, inst_call_ref::MirInst_call_ref_with_arg0_vt(
            callee_local,
            0 - 1,
            arg_count + 1,
            dest,
            dest_vt,
            closure_env_layout::closure_env_ref_vt(ctx),
            closure_env::closure_pair_call_hint(ctx, callee_type_name, arg_lis, dest)
        ))
    dest
}

// AST-level funcref call lowering (Class A/B → call_ref).
fn mir_lower_ast_indirect_call(mut ctx: LowerCtx, node: AstNode, child_count: i32, callee_local: i32) -> i32 {
    let arg_count = child_count - 1
    let callee_type_name = ctx_api_local_types::ctx_get_local_type(ctx, callee_local)
    closure_env::closure_emit_pair_env_arg(ctx, callee_local)
    let mut arg_lis = Vec::new<i32>()
    let mut a = 1
    while a < child_count {
        let arg = ast_node::node_child_at(node, a)
        let arg_li = lower_expr(ctx, arg)
        if arg_li >= 0 {
            call_args::mir_stage_call_arg(ctx, arg_lis, arg_li)
        }
        a = a + 1
    }
    let dest = call_emit_dest::mir_prepare_direct_call_dest(ctx, String_from("__indirect"), 0 - 1)
    call_types::mir_mark_call_result_type(ctx, String_from("__indirect"), dest, 0 - 1)
    mark_indirect_callback_result_type(ctx, callee_type_name.clone(), dest)
    let dest_vt = ctx_api_local_types::ctx_local_vt(ctx, dest)
    call_emit_staged::mir_emit_staged_call_args(ctx, arg_lis, Vec::new<i32>())
    closure_env::closure_emit_pair_fnptr(ctx, callee_local)
    ctx_api_emit::ctx_emit(ctx, inst_call_ref::MirInst_call_ref_with_arg0_vt(
            callee_local,
            0 - 1,
            arg_count + 1,
            dest,
            dest_vt,
            closure_env_layout::closure_env_ref_vt(ctx),
            closure_env::closure_pair_call_hint(ctx, callee_type_name, arg_lis, dest)
        ))
    dest
}
