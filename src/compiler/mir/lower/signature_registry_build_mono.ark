use std::prelude::{clone, eq}
use std::text
use collections::name_index
use corehir::name_match
use corehir::kinds
use corehir::function_id
use corehir::signature_entry
use corehir::signature_registry
use corehir::type_info_to_mir_value
use mir::lower::fn_index_method_return_type
use mir::lower::fn_index_mono
use mir::lower::fn_index_source
use mir::lower::mono_instance_build
use mir::lower::return_typeinfo
use mir::lower::signature_registry_entry
use mir::mono
use corehir::core_op_id
use corehir::type_contracts
fn sig_reg_index_mono_variants(
    mut table: TypeTable,
    mut registry: SignatureRegistry,
    mut mono_table: MonoInstanceTable,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    midx: MonoIndex,
    base_name: String,
    typed_index: i32,
    fn_info_index: i32,
    decl_index: i32
) {
    let mono_count = mono::mono_index_count(midx, clone(base_name))
    let mono_instances = fn_index_source::mir_fn_index_source_mono_instances(source)
    let mut mono_i = 0
    while mono_i < mono_count {
        let mono_name = mono::mono_index_mangled_at(midx, clone(base_name), mono_i)
        let safe_name = mono::mono_safe_name(mono_name)
        sig_reg_register_mono_fn(
            table,
            registry,
            mono_table,
            source,
            sig_source,
            fn_info_index,
            typed_index,
            clone(safe_name),
            mono_instances,
            decl_index
        )
        mono_i = mono_i + 1
    }
}

fn sig_reg_register_mono_fn(
    mut table: TypeTable,
    mut registry: SignatureRegistry,
    mut mono_table: MonoInstanceTable,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    fn_info_index: i32,
    typed_index: i32,
    mangled: String,
    mono_instances: Vec<MonoInstance>,
    decl_index: i32
) {
    let params = signature_registry_entry::sig_reg_params_from_fn_info_mono(
        sig_source,
        fn_info_index,
        table,
        clone(mangled),
        mono_instances
    )
    let mut returns = Vec::new<MirValueType>()
    let mut return_vt = fn_index_source::mir_fn_index_source_typed_return_vt(source, typed_index)
    let mut return_type_name = fn_index_source::mir_fn_index_source_typed_return_type_name(source, typed_index)
    let generic_return_ty = fn_index_source::mir_fn_index_source_typed_return_type(source, typed_index)
    let concrete_ret = fn_index_mono::mir_mono_concrete_return_type(
        mono_instances,
        clone(mangled),
        generic_return_ty
    )
    if type_contracts::TypeInfo_tag(concrete_ret) != 0 {
        return_vt = return_typeinfo::mir_return_vt_from_type_info(concrete_ret)
        return_type_name = return_typeinfo::mir_return_type_name_from_type_info(concrete_ret)
    } else {
        // Keep a build-time fallback for incomplete type facts. Call-time
        // lowering still receives only the registered concrete result.
        let concrete = fn_index_method_return_type::method_concrete_return_from_mono_fn_name(
            clone(mangled),
            clone(return_type_name)
        )
        if len(concrete) > 0 {
            return_type_name = concrete
            return_vt = fn_index_method_return_type::method_return_vt_from_type_name(clone(return_type_name))
        }
    }
    push(
        returns,
        type_info_to_mir_value::vt_to_mir_value(table, return_vt, return_type_name)
    )
    let mono_id = mono_instance_build::mono_instance_table_register_from_instances(
        mono_table,
        table,
        mono_instances,
        clone(mangled),
        params,
        returns
    )
    let receiver = type_info_to_mir_value::vt_to_mir_value(table, 0, String_new())
    let entry = signature_entry::SignatureEntry_new(
        function_id::FunctionId_new(0),
        clone(mangled),
        params,
        returns,
        false,
        receiver,
        0 - 1,
        decl_index,
        mono_id,
        kinds::ABI_KIND_NORMAL(),
        core_op_id::CORE_OP_ID_NONE()
    )
    signature_registry::signature_registry_register(registry, entry, mangled)
}

// A decl emitted under its leaf name resolves its single instantiation
// through the qualified instance fn_name (Vec::sort), which mono_index
// never keys by the leaf. The registry build asks this for every decl without
// mono instances, so the previous all-instance scan was quadratic on the
// instance list. Build a leaf-name bucket index once instead: `head` maps a
// leaf to the newest qualifying instance and `next` chains the older ones.
pub struct SigRegLeafIndex {
    head: NameIndex,
    next: Vec<i32>,
}

fn sig_reg_leaf_name(name: String) -> String {
    let name_len = len(name)
    let mut i = name_len - 1
    while i >= 1 {
        if name.byte_at(i) == 58 && name.byte_at(i - 1) == 58 {
            return name.slice(i + 1, name_len)
        }
        i = i - 1
    }
    name
}

impl SigRegLeafIndex {
    fn build(mono_instances: Vec<MonoInstance>) -> SigRegLeafIndex {
        let count = len(mono_instances)
        let mut head = name_index::NameIndex_new(count)
        let mut next = Vec::new<i32>()
        let mut i = 0
        while i < count {
            push(next, 0 - 1)
            i = i + 1
        }
        i = 0
        while i < count {
            let inst = get_unchecked(mono_instances, i)
            i = i + 1
            if type_contracts::MonoInstance_type_arg_count(inst) <= 0 {
                continue
            }
            let first_arg = type_contracts::MonoInstance_type_arg_at(inst, 0)
            if type_contracts::TypeInfo_tag(first_arg) < 0 {
                continue
            }
            let leaf = sig_reg_leaf_name(type_contracts::MonoInstance_fn_name(inst))
            let previous = name_index::name_index_get(head, clone(leaf))
            set(next, i - 1, previous)
            name_index::name_index_set(head, leaf, i - 1)
        }
        SigRegLeafIndex { head: head, next: next }
    }

    // Return the unique non-marker instance index for the decl; -1 when absent or
    // ambiguous. Every spelling `sig_reg_leaf_instance_name_match` accepts has the
    // same leaf segment as the query, so walking the leaf bucket is equivalent to
    // the old full scan.
    fn instance_index(
        index: SigRegLeafIndex,
        mono_instances: Vec<MonoInstance>,
        decl_name: String,
        qualified_name: String
    ) -> i32 {
        let mut query_name = clone(decl_name)
        if len(qualified_name) > 0 {
            query_name = clone(qualified_name)
        }
        let query_leaf = sig_reg_leaf_name(query_name)
        let mut matched = 0 - 1
        let mut matched_mangled = String_new()
        let mut ambiguous = false
        let mut i = name_index::name_index_get(index.head, query_leaf)
        while i >= 0 {
            let inst = get_unchecked(mono_instances, i)
            if sig_reg_leaf_instance_name_match(
                type_contracts::MonoInstance_fn_name(inst),
                clone(decl_name),
                clone(qualified_name)
            ) {
                let inst_mangled = type_contracts::MonoInstance_mangled_name(inst)
                if len(matched_mangled) > 0 && !eq(clone(inst_mangled), clone(matched_mangled)) {
                    ambiguous = true
                }
                if len(matched_mangled) == 0 {
                    matched = i
                }
                matched_mangled = inst_mangled
            }
            i = get_unchecked(index.next, i)
        }
        if ambiguous {
            return 0 - 1
        }
        matched
    }
}

// Instance fn_names can spell the same decl with different qualification
// depending on which side recorded the instance, so a strict equality check
// would miss real instantiations. Suffix matching on
// either side keeps the binding without accepting an unrelated module's
// same-leaf generic.
fn sig_reg_leaf_instance_name_match(
    inst_name: String,
    decl_name: String,
    qualified_name: String
) -> bool {
    if len(qualified_name) > 0 {
        if name_match::NameMatch::equal(inst_name, qualified_name) {
            return true
        }
        // Compare the `::`-qualified forms in place; this runs for every
        // monomorphized method instance and the per-call `"::" + name`
        // allocations showed up in the overlay GC profile.
        if name_match::NameMatch::ends_with_qualified(inst_name, qualified_name) ||
        name_match::NameMatch::ends_with_qualified(qualified_name, inst_name) {
            return true
        }
        return false
    }
    name_match::NameMatch::equal(inst_name, decl_name)
}

fn sig_reg_index_method_mono(
    mut table: TypeTable,
    mut registry: SignatureRegistry,
    mut mono_table: MonoInstanceTable,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    midx: MonoIndex,
    mangled: String,
    method_info_index: i32,
    impl_decl_index: i32
) {
    let mono_count = mono::mono_index_count(midx, clone(mangled))
    let mut mono_i = 0
    while mono_i < mono_count {
        let mono_name = mono::mono_index_mangled_at(midx, clone(mangled), mono_i)
        let safe_name = mono::mono_safe_name(mono_name)
        signature_registry_entry::sig_reg_register_method(
            table,
            registry,
            mono_table,
            source,
            sig_source,
            method_info_index,
            clone(safe_name),
            impl_decl_index
        )
        mono_i = mono_i + 1
    }
}
