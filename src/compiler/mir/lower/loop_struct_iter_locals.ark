use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_gc_enum
use mir::lower::ctx_types
use mir::lower::loop_conditions
use mir::lower::loop_vec
use mir::value_types
fn mir_struct_iterator_iter_ptr(mut ctx: LowerCtx, struct_type: String) -> i32 {
    let iter_ptr = ctx_fresh_local(ctx, value_types::VT_I32())
    loop_conditions::mir_save_stack_to_local(ctx, iter_ptr)
    ctx_set_local_type(ctx, iter_ptr, struct_type)
    iter_ptr
}

fn mir_struct_iterator_iter_var(mut ctx: LowerCtx, iter_name: String, next_callee: String) -> i32 {
    let payload_type = mir_struct_iterator_payload_type(ctx, next_callee)
    let mut payload_vt = value_types::VT_I32()
    if len(payload_type) > 0 {
        payload_vt = mir_struct_iterator_payload_vt(ctx, payload_type.clone())
    }
    let iter_var = ctx_alloc_local(ctx, iter_name, payload_vt)
    if len(payload_type) > 0 {
        ctx_set_local_type(ctx, iter_var, payload_type)
    }
    iter_var
}

fn mir_struct_iterator_payload_vt(ctx: LowerCtx, payload_type: String) -> i32 {
    let payload_vt = loop_vec::mir_vec_element_vt(ctx, payload_type)
    if payload_vt == value_types::VT_GC_REF() && !ctx_gc_enum::ctx_is_gc_target(ctx) {
        return value_types::VT_REF()
    }
    payload_vt
}

fn mir_struct_iterator_payload_type(ctx: LowerCtx, next_callee: String) -> String {
    let ret_type_name = ctx_fn_return_type_name(ctx, next_callee.clone())
    if ret_type_name.clone().starts_with("option:") {
        return ret_type_name.slice(7, len(ret_type_name))
    }
    ""
}

fn mir_struct_iterator_temp_i32(mut ctx: LowerCtx) -> i32 {
    ctx_fresh_local(ctx, value_types::VT_I32())
}
