use mir::module_functions
use mir::module_strings
use mir::emit_artifacts
use mir::module_emit_artifacts
use mir::block_inst_access
use mir::function_block_queries
use mir::inst_accessors_literals
use mir::inst_accessors_shape
use mir::opcodes
use mir::lower::ctx_call_edges
use mir::lower::ctx_current_storage
use mir::lower::emit_inloop
use mir::function_identity
use mir::reachability
use mir::function_return_view
use mir::module_spine
use mir::post_pass_callee_cache
use mir::post_pass_type_propagate
use mir::typed_mir_sync_module
use mir::lower::emit_spec
use mir_opt::optimize_fn

fn ctx_push_module_function(mut ctx: LowerCtx, mut func: MirFunction) {
    let mut m = ctx_current_storage::ctx_current_module_value(ctx)
    let ret_slot = function_return_view::mir_function_return_variant_slot(func)
    module_functions::MirModule_push_function(m, func)
    let mir_index = module_functions::MirModule_function_count(m) - 1
    module_functions::MirModule_set_return_variant_slot_at(m, mir_index, ret_slot)
    post_pass_callee_cache::callee_prop_cache_add_fn(
        ctx.prop_cache,
        mir_index,
        function_identity::MirFunction_name(func),
        function_return_view::MirFunction_return_type_name(func),
        ret_slot
    )
    if ctx_call_edges::ctx_edge_pending_map_open(ctx) {
        ctx_call_edges::ctx_edge_complete_pending_map(ctx, mir_index)
    } else {
        ctx_call_edges::ctx_edge_finish_current_map(ctx, mir_index)
    }
    ctx_run_per_fn_post_pass(ctx, m, func, mir_index)
}

fn ctx_push_current_function(mut ctx: LowerCtx) {
    let mut m = ctx_current_storage::ctx_current_module_value(ctx)
    let mut func = ctx_current_storage::ctx_current_func_value(ctx)
    let ret_slot = function_return_view::mir_function_return_variant_slot(func)
    module_functions::MirModule_push_function(m, func)
    let mir_index = module_functions::MirModule_function_count(m) - 1
    module_functions::MirModule_set_return_variant_slot_at(m, mir_index, ret_slot)
    ctx_call_edges::ctx_edge_finish_current_map(ctx, mir_index)
    post_pass_callee_cache::callee_prop_cache_add_fn(
        ctx.prop_cache,
        mir_index,
        function_identity::MirFunction_name(func),
        function_return_view::MirFunction_return_type_name(func),
        ret_slot
    )
    ctx_run_per_fn_post_pass(ctx, m, func, mir_index)
}

// #851 Phase 3: run the post passes on each function while its body is
// still the only one live. Mirrors the module-level order (sync ->
// propagate -> sync) so the post-loop module passes converge immediately
// for this function. The cache is appended before the pass so recursive
// self-calls resolve their own return name.
fn ctx_run_per_fn_post_pass(mut ctx: LowerCtx, mut m: MirModule, mut func: MirFunction, mir_index: i32) {
    if module_spine::MirModule_signature_spine_populated(m) {
        let mut table = module_spine::MirModule_type_table(m)
        func = typed_mir_sync_module::mir_function_sync_all_value_types(func, table)
        let _iters = post_pass_type_propagate::mir_function_propagate_local_types(
            ctx.prop_cache,
            func,
            table
        )
        func = typed_mir_sync_module::mir_function_sync_all_value_types(func, table)
        module_functions::MirModule_set_function_at(m, mir_index, func)
    }
    // Fused in-loop emit (#851 Phase 3): run the per-fn opt pipeline while
    // this body is the only one live. Every pass is function-local (the
    // only module reads are the fully-populated signature spine), so the
    // result is identical to the batch optimize_module the drain replaced.
    // opt_fn_count stays a prefix watermark since pushes are ordered.
    let art = module_emit_artifacts::MirModule_emit_artifacts(m)
    if emit_artifacts::MirEmitArtifacts_enabled(art) {
        let spec = ctx.emit_spec
        if emit_spec::mir_lower_emit_spec_enabled(spec) {
            func = mir_opt::optimize_fn(
                m,
                func,
                emit_spec::mir_lower_emit_spec_opt_level(spec),
                emit_spec::mir_lower_emit_spec_target(spec)
            )
            module_functions::MirModule_set_function_at(m, mir_index, func)
            art.opt_fn_count = art.opt_fn_count + 1
        }
    }
    ctx_record_fn_pair_refs(m, func, mir_index)
    // Fused in-loop emit (#851 Phase 3): emit the optimized body now when
    // every call it makes resolves push-stably; otherwise leave an empty
    // body_bytes slot the drain fills through the same emit path.
    if ctx.emit_in_loop {
        emit_inloop::emit_inloop_prepare(ctx)
        let emit_ok = emit_inloop::emit_inloop_fn_emittable(ctx, func)
        emit_inloop::emit_inloop_push(ctx, func, mir_index, emit_ok)
    }
}

// #851 Phase 3: record this fn's CALL_REF sites as raw (owner func_idx,
// hint, vt) tuples on the module emit artifacts. The seal derives pair
// sigs from them in kept-fn order — the same inputs the batch body scan
// used — so pair-sig collection survives per-push body emit. The same
// scan flags funcref-class insts: pushed bodies detach at emit, so the
// emit-phase table section cannot re-derive their presence by rescan.
fn ctx_record_fn_pair_refs(m: MirModule, func: MirFunction, mir_index: i32) {
    let mut art = module_emit_artifacts::MirModule_emit_artifacts(m)
    if !emit_artifacts::MirEmitArtifacts_enabled(art) {
        return
    }
    let bc = function_block_queries::MirFunction_block_count(func)
    let mut bi = 0
    while bi < bc {
        let block = function_block_queries::MirFunction_block_at(func, bi)
        let ic = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < ic {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            if op == opcodes::MIR_CALL_REF() {
                push(art.pair_ref_fn, mir_index)
                push(art.pair_ref_hint, inst_accessors_literals::MirInst_str_val(inst))
                push(art.pair_ref_vt, inst_accessors_shape::MirInst_val_type(inst))
            }
            if op == opcodes::MIR_CALL_REF() || op == opcodes::MIR_CALL_INDIRECT() || op == opcodes::MIR_REF_FUNC() {
                art.saw_funcref_values = true
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn ctx_intern_string(ctx: LowerCtx, s: String) -> i32 {
    module_strings::intern_string(ctx_current_storage::ctx_current_module_value(ctx), s)
}

fn ctx_prune_unreachable(ctx: LowerCtx) -> i32 {
    reachability::mir_prune_unreachable(ctx_current_storage::ctx_current_module_value(ctx))
}

fn ctx_current_module(ctx: LowerCtx) -> MirModule {
    ctx_current_storage::ctx_current_module_value(ctx)
}
