use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::opcodes
use mir::inst_local_get
use mir::inst_op
use mir::inst_structured_control
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_patterns
use mir::lower::core_match_patterns
use mir::lower::core_match_subpat
use mir::lower::match_arms
use mir::value_types

fn core_emit_or_pattern_condition(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, pat: CoreHirExpr, compare_idx: i32, scrut_idx: i32) {
    let alt_count = core_expr_shape_accessors::mir_core_expr_child_count(pat)
    let mut or_oi = 0
    let mut or_prev_cmp = 0 - 1
    while or_oi < alt_count {
        let or_alt = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(pat, or_oi))
        let mut or_cmp = 0 - 1
        if core_expr_shape_patterns::mir_core_expr_is_pat_variant(or_alt) &&
        core_match_subpat::core_variant_pat_has_checked_children(ctx, exprs, or_alt) {
            // Alternatives like Circle(5) carry their own guarded payload
            // conditions; the returned flag folds into the same OR
            // accumulator as the flat compares, so the flag local is
            // pushed to feed BIT_OR (#902).
            or_cmp = core_match_subpat::core_emit_variant_subpat_flag_tagged(ctx, exprs, or_alt, scrut_idx, compare_idx)
            ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(or_cmp))
        } else if core_match_patterns::mir_core_pat_is_string_literal(or_alt) {
            or_cmp = match_arms::mir_emit_string_pattern_compare_text(ctx, compare_idx, core_expr_shape_accessors::mir_core_expr_text(or_alt))
        } else {
            ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(compare_idx))
            let alt_idx = core_match_patterns::lower_core_pattern_value(ctx, or_alt)
            or_cmp = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
            ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_EQ(), or_cmp, compare_idx, alt_idx))
        }
        if or_oi > 0 {
            let or_acc = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
            ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_BIT_OR(), or_acc, or_prev_cmp, or_cmp))
            or_prev_cmp = or_acc
        } else {
            or_prev_cmp = or_cmp
        }
        or_oi = or_oi + 1
    }
}

fn core_emit_value_pattern_condition(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, pat: CoreHirExpr, compare_idx: i32, scrut_idx: i32) {
    // A variant pattern with literal/composite payload children must
    // compare the sub-patterns, not only the tag: emit the guarded flag
    // form whose payload loads sit inside the tag-true branch (#902).
    if core_expr_shape_patterns::mir_core_expr_is_pat_variant(pat) &&
    core_match_subpat::core_variant_pat_has_checked_children(ctx, exprs, pat) {
        let flag = core_match_subpat::core_emit_variant_subpat_flag_tagged(ctx, exprs, pat, scrut_idx, compare_idx)
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(flag))
        return
    }
    if core_match_patterns::mir_core_pat_is_string_literal(pat) {
        let _str_cmp = match_arms::mir_emit_string_pattern_compare_text(ctx, compare_idx, core_expr_shape_accessors::mir_core_expr_text(pat))
        return
    }
    ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(compare_idx))
    let pat_idx = core_match_patterns::lower_core_pattern_value(ctx, pat)
    let cmp_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_EQ(), cmp_dest, compare_idx, pat_idx))
}
