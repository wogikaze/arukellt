use std::prelude::{clone, eq, starts_with, substring}
use std::text
use mir::lower::ast_node
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_variants
use mir::lower::ctx_struct_layout
use mir::lower::ctx_fn_exists
use mir::lower::ctx_mono_type_params
use mir::lower::method_emit
use mir::lower::method_resolve
use mir::lower::ctx_emit_core
use mir::lower_kinds
use mir::opcodes

fn mir_initial_method_callee(ctx: LowerCtx, method_name: String, receiver_idx: i32) -> String {
    let mut struct_name = ""
    if receiver_idx >= 0 {
        struct_name = ctx_get_local_type(ctx, receiver_idx)
    }
    // An enum-variant struct literal constructs the payload layout, so the
    // binding's local type is `Enum::Variant` rather than the enum. Resolve a
    // method that exists on the owning enum (Error::message) instead of
    // falling through the ambiguous bare-name fallback; the payload value is
    // a subtype/pointer-compatible receiver on both targets.
    if len(clone(struct_name)) > 0 {
        let variant = ctx_api_variants::ctx_canonical_variant_name(ctx, clone(struct_name))
        if ctx_api_variants::ctx_variant_tag(ctx, clone(variant)) >= 0 {
            let owner = ctx_api_variants::ctx_variant_owner_name(clone(variant))
            let enum_name = ctx_struct_layout::ctx_struct_basename(clone(owner))
            if len(clone(enum_name)) > 0 {
                let candidate = clone(enum_name).concat(String_from("::").concat(clone(method_name)))
                if ctx_has_fn_name(ctx, clone(candidate)) {
                    return candidate
                }
            }
        }
    }
    // When the receiver type is a type variable (e.g. "?T"), try to
    // resolve it to a concrete type via the monomorphization type
    // parameter mapping. This enables `x.method()` inside generic
    // functions `<T: Trait>` to resolve to `ConcreteType::method`.
    if len(struct_name) > 0 && starts_with(clone(struct_name), "?") {
        let bare_name = substring(clone(struct_name), 1, len(struct_name))
        let resolved = ctx_mono_type_params::ctx_resolve_mono_type_param(ctx, bare_name)
        if len(resolved) > 0 {
            struct_name = resolved
        }
    }
    // Normalize builtin type names so method calls resolve correctly.
    // Vec locals carry type "vec:i32" / "vec:String" etc.; the String
    // conversion has its own impl owner because GC references are distinct.
    // String locals carry type "string"; normalize to "String".
    if starts_with(clone(struct_name), "vec:") {
        if method_resolve::mir_is_vec_string_iteration_method(clone(method_name)) &&
        method_resolve::mir_is_vec_string_type(clone(struct_name)) {
            struct_name = "Vec_String"
        } else {
            struct_name = "Vec"
        }
    }
    if starts_with(clone(struct_name), "hashmap:") {
        struct_name = "HashMap"
    }
    if eq(clone(struct_name), "string") {
        struct_name = "String"
    }
    // An Option call result carries the canonical `option:<T>` encoding from
    // the typechecker, while concrete impls (`impl Option<i32>`) register
    // their methods under the annotation spelling `Option_<T>`. Bridge the
    // two when the concrete method exists so a receiver call on a call result
    // (`pop(v).unwrap()`) resolves instead of lowering to the unresolved-call
    // trap stub. Falling through keeps generic `impl<T> Option<T>` methods.
    if starts_with(clone(struct_name), "option:") {
        let some_type = substring(clone(struct_name), 7, len(struct_name))
        let concrete_method = String_from("Option_").concat(
            some_type.concat(String_from("::").concat(clone(method_name)))
        )
        if ctx_has_fn_name(ctx, clone(concrete_method)) {
            return concrete_method
        }
    }
    // Strip aggregate classifiers, module path prefixes, and per-use instance
    // suffixes (e.g. "struct:VecIter:12" or "std::core::iter::VecIter:12")
    // so method calls resolve to the unqualified base type name.
    struct_name = method_resolve::mir_normalize_type_name(clone(struct_name))
    // Concrete generic receivers (GenTakeIter<VecIter>) own their impl
    // methods under the per-instantiation owner (GenTakeIter_VecIter), the
    // same collision rule as HashMap_K_V.
    struct_name = method_resolve::mir_inst_owner_name(clone(struct_name))
    if len(struct_name) > 0 {
        return clone(struct_name).concat("::".concat(clone(method_name)))
    }
    method_name
}

fn mir_method_mono_type_key(ctx: LowerCtx, first_method_arg_idx: i32) -> String {
    method_resolve::mir_method_mono_type_key(ctx, first_method_arg_idx)
}

fn mir_resolve_method_callee(mut ctx: LowerCtx, callee_name: String, first_method_arg_idx: i32, span_start: i32) -> String {
    method_resolve::mir_resolve_method_callee(ctx, callee_name, first_method_arg_idx, span_start)
}

// `String` values are GC array references on the gc target and data pointers on
// the linear target, so `push_char` cannot grow in place: the call-site emit
// replaces the receiver local. A field receiver is materialized into a load
// temp, so the caller must store that replaced value back into its owner.
fn mir_method_replaces_string_receiver(callee_name: String) -> bool {
    eq(clone(callee_name), String_from("String::push_char")) ||
    eq(clone(callee_name), String_from("push_char"))
}

fn mir_emit_method_call(mut ctx: LowerCtx, mut callee_name: String, arg_count: i32, first_arg_idx: i32, value_arg_idx: i32) -> i32 {
    method_emit::mir_emit_method_call(ctx, callee_name, arg_count, first_arg_idx, value_arg_idx)
}

// Method-call operands are stack-passed: every producer must leave its
// value. Record-literal, fnpair, and variant constructions terminate in a
// side-effecting SET op whose result lives only in a MIR local, so the
// call underflows its operand stack. Resolved real calls recover via
// prev_arg0 in call_fallback_resolved, but core-op intrinsic emits
// (e.g. `__core_vec_push_i32_impl` -> inlined vec_push) have no such
// recovery. The caller re-pushes the result local for these.
// MIR_END is the same contract: if/match/block-tail expressions deliver
// their result via a result local (mir_store_if_branch_result), so an
// arg whose lowering ends at END holds the value in arg_idx, not on the
// operand stack (#921).
fn mir_method_arg_leaves_no_stack(ctx: LowerCtx, arg_idx: i32) -> bool {
    if arg_idx < 0 {
        return false
    }
    let last_op = ctx_emit_core::ctx_current_block_last_inst_op(ctx)
    last_op == opcodes::MIR_STRUCT_SET() ||
    last_op == opcodes::MIR_ARRAY_SET() ||
    last_op == opcodes::MIR_GC_STRUCT_SET() ||
    last_op == opcodes::MIR_END()
}

// A receiver differs from a stack-passed argument: the method emit re-reads
// it from its local, so a field read that the emit store policy materializes
// into the operand local must be re-pushed. That only happens when explicit
// arguments are lowered between the field get and the call; a zero-argument
// call consumes the field get directly and the emitter forwards it to the
// call operand. Re-pushing a zero-argument field receiver would materialize
// the get and split the compiler's own bootstrap fixpoint (#693).
fn mir_method_receiver_leaves_no_stack(ctx: LowerCtx, receiver_idx: i32, has_arguments: bool) -> bool {
    if mir_method_arg_leaves_no_stack(ctx, receiver_idx) {
        return true
    }
    if !has_arguments || receiver_idx < 0 {
        return false
    }
    let last_op = ctx_emit_core::ctx_current_block_last_inst_op(ctx)
    if last_op != opcodes::MIR_STRUCT_GET() && last_op != opcodes::MIR_GC_STRUCT_GET() {
        return false
    }
    ctx_emit_core::ctx_current_block_last_inst_dest(ctx) == receiver_idx
}

// A scalar literal argument followed by a field-access argument needs an
// explicit reload: the emit store policy materializes scalar constants ahead
// of a LOCAL_GET + STRUCT_GET base chain so an assignment's RHS cannot sit
// under the base operand stack (#807). In call-argument position that store
// leaves the literal in its local while the call still expects it on the
// operand stack, so the intrinsic's operand pops underflow. Reloading the
// literal local both forces that store and restores the operand; the
// pattern is only reachable from a currently invalid call, so the extra
// load does not change valid call emission.
fn mir_method_arg_needs_repush_before_field_access(ctx: LowerCtx, arg_idx: i32) -> bool {
    if arg_idx < 0 {
        return false
    }
    let last_op = ctx_emit_core::ctx_current_block_last_inst_op(ctx)
    last_op == opcodes::MIR_CONST_I32() ||
    last_op == opcodes::MIR_CONST_I64() ||
    last_op == opcodes::MIR_CONST_F64()
}

// Whether lowering this expression starts by loading a field base (and then
// emitting STRUCT_GET). Only the leading shape matters: the store policy
// decision above is made while that first base load is the next instruction.
// Calls and operators lower their first child first; other shapes (if/match,
// struct literals, ...) start with their own control or construction.
fn mir_expr_leads_with_field_access(node: AstNode) -> bool {
    let kind = ast_node::node_kind(node)
    if kind == lower_kinds::NK_FIELD_ACCESS() {
        return true
    }
    if kind == lower_kinds::NK_METHOD_CALL() ||
    kind == lower_kinds::NK_CALL() ||
    kind == lower_kinds::NK_BINARY() ||
    kind == lower_kinds::NK_UNARY() ||
    kind == lower_kinds::NK_INDEX() ||
    kind == lower_kinds::NK_TRY() {
        if ast_node::node_child_count(node) > 0 {
            return mir_expr_leads_with_field_access(ast_node::node_child_at(node, 0))
        }
    }
    false
}
