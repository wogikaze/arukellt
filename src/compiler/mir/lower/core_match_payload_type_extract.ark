use mir::lower::ctx_api_local_types
use mir::value_types

fn core_extract_first_result_type_param(scrut_type: String) -> String {
    let prefix_len = 7
    let rest = substring(scrut_type, prefix_len, len(scrut_type))
    // Split Ok/Err on the LAST encoding separator so nested vec:T /
    // option:T stay intact. result:… uses ':'; Result_… uses '_' (#832).
    // Do not split vec:T on its own ':' — that turned Result_vec:fn_E into
    // bare "vec" and collapsed fn payloads to vec:i32.
    let sep_char = if starts_with(clone(scrut_type), "result:") { 58 } else { 95 }
    let last = find_last_sep_char(clone(rest), sep_char)
    if last > 0 {
        return normalize_payload_elem_type_name(substring(rest, 0, last))
    }
    normalize_payload_elem_type_name(rest)
}

fn core_extract_second_result_type_param(scrut_type: String) -> String {
    let prefix_len = 7
    let rest = substring(scrut_type, prefix_len, len(scrut_type))
    // Mirror first-param: last ':' for result:…, last '_' for Result_… (#832).
    let sep_char = if starts_with(clone(scrut_type), "result:") { 58 } else { 95 }
    let last = find_last_sep_char(clone(rest), sep_char)
    if last >= 0 && last + 1 < len(rest) {
        return substring(rest, last + 1, len(rest))
    }
    String_new()
}

fn find_last_sep_char(s: String, sep_char: i32) -> i32 {
    let n = len(s)
    let mut i = n - 1
    while i >= 0 {
        if char_at(clone(s), i) == sep_char {
            // result:T:E uses ':'. Skip '::' so io::IoError stays in E.
            if sep_char == 58 && find_sep_is_path_colon(clone(s), i, n) {
                i = i - 1
                continue
            }
            return i
        }
        i = i - 1
    }
    0 - 1
}

fn find_sep_is_path_colon(s: String, i: i32, n: i32) -> bool {
    if i > 0 && char_at(clone(s), i - 1) == 58 {
        return true
    }
    if i + 1 < n && char_at(clone(s), i + 1) == 58 {
        return true
    }
    false
}

fn normalize_payload_elem_type_name(elem_ty: String) -> String {
    if eq(clone(elem_ty), "Vec") {
        return "vec:i32"
    }
    if starts_with(clone(elem_ty), "Vec<") && ends_with(clone(elem_ty), ">") {
        let inner = substring(clone(elem_ty), 4, len(elem_ty) - 1)
        return concat("vec:", inner)
    }
    if starts_with(clone(elem_ty), "Vec_") {
        return concat("vec:", substring(clone(elem_ty), 4, len(elem_ty)))
    }
    elem_ty
}

fn core_payload_type_name_is_gc_ref(ctx: LowerCtx, bind_local: i32) -> bool {
    let type_name = ctx_api_local_types::ctx_get_local_type(ctx, bind_local)
    if len(type_name) == 0 {
        return false
    }
    if eq(clone(type_name), "string") || eq(clone(type_name), "String") {
        return true
    }
    if starts_with(clone(type_name), "vec:") {
        return true
    }
    if starts_with(clone(type_name), "hashmap:") {
        return true
    }
    if starts_with(clone(type_name), "option:") || starts_with(clone(type_name), "Option_") {
        return true
    }
    if starts_with(clone(type_name), "Result_") || starts_with(clone(type_name), "result:") {
        return true
    }
    if starts_with(clone(type_name), "enum:") {
        return true
    }
    if starts_with(clone(type_name), "struct:") {
        return true
    }
    false
}
