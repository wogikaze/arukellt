use mir::lower::ast_node
use mir::lower::ctx_api_local_alloc
use mir::lower_kinds
use mir::lower::ctx_types
fn closure_is_param_name(clos: AstNode, name: String) -> bool {
    let c = ast_node::node_child_count(clos)
    if c <= 1 {
        return false
    }
    let mut i = 0
    while i < c - 1 {
        let p = ast_node::node_child_at(clos, i)
        if ast_node::node_kind_is(p, lower_kinds::NK_IDENT()) && ast_node::node_text(p).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn closure_collect_free(ctx: LowerCtx, expr: AstNode, clos: AstNode, mut acc: Vec<String>) {
    closure_collect_free_mode(ctx, expr, clos, acc, 1)
}

// Names this frame's own body references, without the transitively
// needed names nested closures pull through. The promote decision
// distinguishes them: a move closure owns only its direct captures,
// while a transport name always carries the descendant's borrow (#900).
fn closure_collect_direct(ctx: LowerCtx, expr: AstNode, clos: AstNode, mut acc: Vec<String>) {
    closure_collect_free_mode(ctx, expr, clos, acc, 0)
}

fn closure_collect_free_mode(ctx: LowerCtx, expr: AstNode, clos: AstNode, mut acc: Vec<String>, descend: i32) {
    if ast_node::node_kind_is(expr, lower_kinds::NK_CLOSURE()) {
        if descend == 0 {
            return
        }
        // A nested closure reaches through this frame: the names it
        // frees must ride this closure's env, or the inner capture
        // resolves to a local the intermediate frame never received
        // and emit produces invalid Wasm (#900).
        let cc = ast_node::node_child_count(expr)
        if cc > 0 {
            closure_collect_free_mode(ctx, ast_node::node_child_at(expr, cc - 1), expr, acc, descend)
        }
        return
    }
    if ast_node::node_kind_is(expr, lower_kinds::NK_IDENT()) {
        collect_free_ident(ctx, expr, clos, acc)
        return
    }
    let cc = ast_node::node_child_count(expr)
    let mut ci = 0
    while ci < cc {
        closure_collect_free_mode(ctx, ast_node::node_child_at(expr, ci), clos, acc, descend)
        ci = ci + 1
    }
}

fn closure_caps_contain(caps: Vec<String>, name: String) -> bool {
    let mut i = 0
    while i < caps.len() {
        if caps.get_unchecked(i).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn collect_free_ident(ctx: LowerCtx, expr: AstNode, clos: AstNode, mut acc: Vec<String>) {
    let capture_name = ast_node::node_text(expr)
    if closure_is_param_name(clos, capture_name.clone()) {
        return
    }
    if ctx_lookup_local(ctx, capture_name.clone()) < 0 {
        return
    }
    let n = capture_name.clone()
    let mut j = acc.len() - 1
    let mut dup = false
    while j >= 0 && !dup {
        if acc.get_unchecked(j).clone().eq(n.clone()) {
            dup = true
        }
        j = j - 1
    }
    if !dup {
        acc.push(n)
    }
}

// Flags parallel to caps: 1 when the closure body rebinds that capture
// with a plain name assignment. A rebound move capture is stored in an
// env cell so writes survive across calls (#874). Nested closures are a
// different frame: their own captures are collected separately, so the
// walk stops at NK_CLOSURE. Field/method mutation targets the shared
// env ref and does not need a cell.
fn closure_collect_rebind_flags(clos: AstNode, caps: Vec<String>) -> Vec<i32> {
    let mut flags = Vec::new<i32>()
    let mut i = 0
    while i < caps.len() {
        flags.push(0)
        i = i + 1
    }
    let child_count = ast_node::node_child_count(clos)
    if child_count == 0 {
        return flags
    }
    closure_mark_rebind(ast_node::node_child_at(clos, child_count - 1), caps, flags, Vec::new<String>())
    flags
}

fn closure_mark_rebind(node: AstNode, caps: Vec<String>, mut flags: Vec<i32>, shadowed: Vec<String>) {
    if ast_node::node_kind_is(node, lower_kinds::NK_CLOSURE()) {
        // A nested rebind of a name this frame captures still borrows
        // this frame's slot: the flag must ride up, or the env packs a
        // dead snapshot and the write is silently lost (#900). Nested
        // params shadow the outer name, so they join the blocked set.
        let nested_child_count = ast_node::node_child_count(node)
        if nested_child_count == 0 {
            return
        }
        let inner_shadowed = closure_rebind_extend_shadowed(node, shadowed, nested_child_count)
        let nested_body = ast_node::node_child_at(node, nested_child_count - 1)
        closure_mark_rebind(nested_body, caps, flags, inner_shadowed)
        return
    }
    if ast_node::node_kind_is(node, lower_kinds::NK_ASSIGN()) &&
    ast_node::node_child_count(node) >= 1 {
        let target = ast_node::node_child_at(node, 0)
        if ast_node::node_kind_is(target, lower_kinds::NK_IDENT()) {
            let name = ast_node::node_text(target)
            if !closure_rebind_name_is_shadowed(shadowed, name.clone()) {
                let mut ci = 0
                while ci < caps.len() {
                    if caps.get_unchecked(ci).eq(name.clone()) {
                        flags.set(ci, 1)
                        ci = caps.len()
                    }
                    ci = ci + 1
                }
            }
        }
    }
    let child_count = ast_node::node_child_count(node)
    let mut i = 0
    while i < child_count {
        closure_mark_rebind(ast_node::node_child_at(node, i), caps, flags, shadowed)
        i = i + 1
    }
}

// A fresh shadowed set for a nested closure's body keeps the params it
// adds from leaking into sibling subtrees.
fn closure_rebind_extend_shadowed(node: AstNode, shadowed: Vec<String>, child_count: i32) -> Vec<String> {
    let mut inner = Vec::new<String>()
    let mut i = 0
    while i < shadowed.len() {
        inner.push(shadowed.get_unchecked(i).clone())
        i = i + 1
    }
    let mut pi = 0
    while pi < child_count - 1 {
        let param = ast_node::node_child_at(node, pi)
        if ast_node::node_kind_is(param, lower_kinds::NK_IDENT()) {
            inner.push(ast_node::node_text(param))
        }
        pi = pi + 1
    }
    inner
}

fn closure_rebind_name_is_shadowed(shadowed: Vec<String>, name: String) -> bool {
    let mut i = 0
    while i < shadowed.len() {
        if shadowed.get_unchecked(i).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}
