use mir::legacy_vt_compat
use mir::lower::core_call_arg_names
use mir::lower::core_call_arg_print_convert
use mir::lower::core_call_arg_print_needs
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_module
use mir::lower::ctx_types
use mir::inst_local_get
use mir::inst_local_set
use mir::module_spine
use mir::typed_mir_compat

fn mir_core_is_printlike_callee(name: String) -> bool {
    core_call_arg_names::mir_core_is_printlike_callee(name)
}

fn mir_core_call_bool_result_name(name: String) -> bool {
    core_call_arg_names::mir_core_call_bool_result_name(name)
}

fn mir_core_call_i32_result_name(name: String) -> bool {
    core_call_arg_names::mir_core_call_i32_result_name(name)
}

fn mir_core_print_arg_needs_string_conversion(ctx: LowerCtx, arg: CoreHirExpr, arg_idx: i32) -> bool {
    core_call_arg_print_needs::mir_core_print_arg_needs_string_conversion(ctx, arg, arg_idx)
}

fn mir_core_convert_print_arg_to_string(mut ctx: LowerCtx, arg: CoreHirExpr, arg_idx: i32) -> i32 {
    core_call_arg_print_convert::mir_core_convert_print_arg_to_string(ctx, arg, arg_idx)
}

fn mir_core_stage_call_arg(mut ctx: LowerCtx, staged_arg_locals: Vec<i32>, arg_idx: i32) -> i32 {
    mir_core_stage_call_arg_mode(ctx, staged_arg_locals, arg_idx, true)
}

// See call_args::mir_stage_call_arg_from_local: ident/constant sources are not
// lowered, so the staged copy must produce the value itself.
fn mir_core_stage_call_arg_from_local(mut ctx: LowerCtx, staged_arg_locals: Vec<i32>, arg_idx: i32) -> i32 {
    mir_core_stage_call_arg_mode(ctx, staged_arg_locals, arg_idx, false)
}

fn mir_core_stage_call_arg_mode(
    mut ctx: LowerCtx,
    mut staged_arg_locals: Vec<i32>,
    arg_idx: i32,
    source_on_stack: bool
) -> i32 {
    let staged_vt = mir_core_stage_call_arg_vt(ctx, arg_idx)
    let staged_local = ctx_api_local_alloc::ctx_fresh_local(ctx, staged_vt)
    let staged_type = ctx_api_local_types::ctx_get_local_type(ctx, arg_idx)
    if staged_type.len() > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, staged_local, staged_type)
    }
    ctx_api_local_types::ctx_set_local_mvt(
        ctx,
        staged_local,
        ctx_api_local_types::ctx_local_mvt(ctx, arg_idx)
    )
    if !source_on_stack {
        // Protect any earlier producer of the same local that the enclosing
        // call still needs: the explicit get is what the copy peephole
        // consumes. Keep `local_set_from` so the local-type pass still sees
        // the source index.
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(arg_idx))
    }
    ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set_from(staged_local, arg_idx))
    staged_arg_locals.push(staged_local)
    staged_local
}

fn mir_core_stage_call_arg_vt(ctx: LowerCtx, arg_idx: i32) -> i32 {
    let mvt = ctx_api_local_types::ctx_local_mvt(ctx, arg_idx)
    if !typed_mir_compat::mvt_is_invalid(mvt) {
        let module = ctx_api_module::ctx_current_module(ctx)
        let table = module_spine::MirModule_type_table(module)
        return legacy_vt_compat::legacy_vt_from_mir_value_type(table, mvt)
    }
    ctx_api_local_types::ctx_local_vt(ctx, arg_idx)
}
