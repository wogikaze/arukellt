use std::prelude::{clone, eq, starts_with, to_string}
use std::text
use mir::function_locals_view
use mir::local_access
use mir::inst_local_set
use mir::lower::closure_cells
use mir::lower::closure_env
use mir::lower::closure_pcells
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_function_frame
use mir::lower::ctx_current_storage
use mir::lower::ctx_struct_layout
use mir::lower::ctx_types
use mir::local_factory
use mir::value_types
fn mir_closure_lookup_capture_type(ctx: LowerCtx, cli: i32) -> String {
    let mut cap_type = String_new()
    if cli < 0 {
        return cap_type
    }
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    if cli < function_locals_view::MirFunction_local_count(func) {
        let loc = function_locals_view::MirFunction_local_at(func, cli)
        cap_type = local_access::MirLocal_type_name(loc)
    }
    if len(cap_type) == 0 {
        cap_type = ctx_api_local_types::ctx_get_local_type(ctx, cli)
    }
    if len(cap_type) > 0 {
        cap_type = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, clone(cap_type))
    } else {
        if ctx_api_local_types::ctx_local_vt(ctx, cli) == value_types::VT_GC_REF() {
            cap_type = "String"
        }
    }
    cap_type
}

fn mir_closure_capture_vts(ctx: LowerCtx, caps: Vec<String>) -> Vec<i32> {
    let cap_n = len(caps)
    let cap_vts = Vec::new<i32>()
    let mut cvi = 0
    while cvi < cap_n {
        let cname = clone(get_unchecked(caps, cvi))
        let cli = ctx_api_local_alloc::ctx_lookup_local(ctx, clone(cname))
        let mut pvt = value_types::VT_I32()
        if cli >= 0 {
            if closure_pcells::ctx_pcell_is_cell(ctx, cli) {
                // Promoted borrow cells pass the cell ref as the cap
                // argument (#891).
                pvt = closure_env::closure_env_ref_vt(ctx)
                push(cap_vts, pvt)
                cvi = cvi + 1
                continue
            }
            pvt = ctx_api_local_types::ctx_local_vt(ctx, cli)
            let cap_type = mir_closure_lookup_capture_type(ctx, cli)
            if starts_with(clone(cap_type), "struct:") ||
            eq(clone(cap_type), "String") ||
            eq(clone(cap_type), "string") ||
            starts_with(clone(cap_type), "enum:") ||
            starts_with(clone(cap_type), "vec:") ||
            starts_with(clone(cap_type), "Option_") ||
            starts_with(clone(cap_type), "Result_") {
                pvt = value_types::VT_GC_REF()
            }
        }
        push(cap_vts, pvt)
        cvi = cvi + 1
    }
    cap_vts
}

fn mir_closure_capture_types(ctx: LowerCtx, caps: Vec<String>) -> Vec<String> {
    let cap_n = len(caps)
    let cap_types = Vec::new<String>()
    let mut cvi = 0
    while cvi < cap_n {
        let cname = clone(get_unchecked(caps, cvi))
        let cli = ctx_api_local_alloc::ctx_lookup_local(ctx, clone(cname))
        if cli >= 0 && closure_pcells::ctx_pcell_is_cell(ctx, cli) {
            // Promoted cap params declare the cell ref type so direct
            // calls and the env trampoline pass the shared cell (#891).
            push(cap_types, closure_pcells::ctx_pcell_cell_spelling(ctx, cli))
            cvi = cvi + 1
            continue
        }
        let cap_type = mir_closure_lookup_capture_type(ctx, cli)
        push(cap_types, cap_type)
        cvi = cvi + 1
    }
    cap_types
}

fn mir_emit_closure_captures(ctx: LowerCtx, caps: Vec<String>, cap_vts: Vec<i32>, cap_types: Vec<String>, rebind_flags: Vec<i32>, env_name: String) {
    let cap_n = len(caps)
    let mut ci = 0
    while ci < cap_n {
        let cname = clone(get_unchecked(caps, ci))
        let pvt = get_unchecked(cap_vts, ci)
        let cap_type = clone(get_unchecked(cap_types, ci))
        let pname = closure_pcells::ctx_pcell_cap_param_name(
            clone(cap_type),
            clone(cname)
        )
        let _idx2 = ctx_api_local_alloc::ctx_alloc_local(ctx, clone(pname), pvt)
        if len(cap_type) > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, _idx2, clone(cap_type))
        }
        // A cap whose packed supply carries a promoted cell ref gets a
        // payload shadow under the capture name so body accesses deref
        // field 0 of the param's cell (#891).
        closure_pcells::ctx_pcell_bind_cap_param(ctx, _idx2, clone(cap_type), clone(cname))
        ctx_api_function_frame::ctx_push_func_param(ctx, local_factory::MirLocal_new(clone(pname), pvt, cap_type))
        ci = ci + 1
    }
    // The synth signature gains a trailing __env param when any capture is
    // rebound: the rebound move captures live in the caller-owned env record
    // (env cells, #874), so the body reads the field at entry and every
    // return flushes the local back via closure_cells::ctx_env_cell_flush.
    closure_cells::ctx_bind_closure_env_cells(ctx, caps, cap_vts, rebind_flags, env_name)
}

fn mir_closure_vt_is_snapshot_copy(vt: i32) -> bool {
    vt == value_types::VT_I32() ||
    vt == value_types::VT_I64() ||
    vt == value_types::VT_F64() ||
    vt == value_types::VT_F32() ||
    vt == value_types::VT_V128()
}

// ADR-061 shared-copy capture: a Copy binding is copied at the capture point,
// so the closure must not observe a later reassignment of the source local.
// Scalar captures are snapshotted into hidden locals at the literal position
// and the packed supply names point at the snapshots. Non-Copy captures keep
// the source-local name: borrow captures read the live local (they cannot
// escape, E0213) and move captures read a slot whose source is already dead.
fn mir_closure_snapshot_copy_captures(ctx: LowerCtx, caps: Vec<String>, scope: String) -> Vec<String> {
    let out = Vec::new<String>()
    let cap_n = len(caps)
    let mut ci = 0
    while ci < cap_n {
        let cname = clone(get_unchecked(caps, ci))
        let li = ctx_api_local_alloc::ctx_lookup_local(ctx, clone(cname))
        if li >= 0 && closure_pcells::ctx_pcell_is_cell(ctx, li) {
            // Promoted borrow cells pack the cell-ref local's own name so
            // the env carries the shared place, not a payload read (#891).
            push(out, closure_pcells::ctx_pcell_ref_name(ctx, li))
            ci = ci + 1
            continue
        }
        if li < 0 || !mir_closure_vt_is_snapshot_copy(ctx_api_local_types::ctx_local_vt(ctx, li)) {
            push(out, cname)
            ci = ci + 1
            continue
        }
        let vt = ctx_api_local_types::ctx_local_vt(ctx, li)
        let snap_name = text::concat(text::concat("__capsnap_", clone(scope)), text::concat("_", to_string(ci)))
        let snap = ctx_api_local_alloc::ctx_alloc_local(ctx, clone(snap_name), vt)
        let cap_type = mir_closure_lookup_capture_type(ctx, li)
        if len(cap_type) > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, snap, cap_type)
        }
        ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set_from(snap, li))
        push(out, snap_name)
        ci = ci + 1
    }
    out
}
