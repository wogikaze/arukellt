use mir::lower::fn_index_mono
use mir::lower::fn_index_method_return_type
use mir::lower::fn_index_source
use mir::mono
use mir::type_contracts
use mir::value_types
fn mir_index_impl_methods(
    mut fn_names: Vec<String>,
    mut fn_return_vts: Vec<i32>,
    mut fn_return_type_names: Vec<String>,
    impl_decl_index: i32,
    struct_name: String,
    fn_index: i32,
    source: MirLowerFnIndexSource,
    midx: MonoIndex
) -> i32 {
    let mut next_fn_index = fn_index
    let method_count = fn_index_source::mir_fn_index_source_method_count_for_impl(source, impl_decl_index)
    let mono_instances = fn_index_source::mir_fn_index_source_mono_instances(source)
    let mut mi = 0
    while mi < method_count {
        let method_info_index = fn_index_source::mir_fn_index_source_method_info_index(source, impl_decl_index, mi)
        let mut mangled = struct_name.clone()
        if method_info_index >= 0 {
            mangled = fn_index_source::mir_fn_index_source_method_mangled_name_at(source, method_info_index, mangled)
        }
        fn_names.push(mangled)
        let mrvt = fn_index_source::mir_fn_index_source_method_return_vt_at(source, method_info_index, value_types::VT_I32())
        let mrtn = fn_index_source::mir_fn_index_source_method_return_type_name_at(source, method_info_index, "")
        let generic_return_ty = fn_index_method_return_type::method_generic_return_type_from_name(mrtn.clone(), mono::mono_index_count(midx, mangled.clone()) > 0)
        fn_return_vts.push(mrvt)
        fn_return_type_names.push(mrtn)
        fn_index_mono::mir_index_method_mono_variants(fn_names, fn_return_vts, fn_return_type_names, midx, mangled.clone(), mrvt, mrtn.clone(), mono_instances, generic_return_ty)
        next_fn_index = next_fn_index + 1
        mi = mi + 1
    }
    next_fn_index
}
