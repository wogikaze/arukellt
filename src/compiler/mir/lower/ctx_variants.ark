use std::prelude::{clone, eq, index_of, substring}
use mir::lower::ctx_variant_storage
use mir::lower::ctx_variants_builtin
fn ctx_strip_first_path_segment(name: String) -> String {
    let pos = index_of(clone(name), String_from("::"))
    if pos < 0 {
        return String_new()
    }
    substring(name, pos + 2, len(name))
}

// Resolve module::Enum::Variant spellings to the registered layout name
// Enum::Variant used by MIR struct/enum lowering. The lookup already
// normalizes through the Enum::Variant key index, so return the registered
// spelling rather than the caller's text; downstream layout/GC lookups are
// keyed by the registered name and miss on module-prefixed spellings.
fn ctx_canonical_variant_name(ctx: LowerCtx, name: String) -> String {
    let exact = ctx_variant_storage::ctx_variant_name_index(ctx, clone(name))
    if exact >= 0 {
        return ctx_variant_storage::ctx_variant_name_at(ctx, exact)
    }
    let mut rest = clone(name)
    while true {
        let next = ctx_strip_first_path_segment(clone(rest))
        if len(next) == 0 {
            return String_new()
        }
        let idx = ctx_variant_storage::ctx_variant_name_index(ctx, clone(next))
        if idx >= 0 {
            return ctx_variant_storage::ctx_variant_name_at(ctx, idx)
        }
        rest = next
    }
    String_new()
}

fn ctx_variant_tag(ctx: LowerCtx, name: String) -> i32 {
    let canon = ctx_canonical_variant_name(ctx, clone(name))
    if len(canon) == 0 {
        return 0 - 1
    }
    let idx = ctx_variant_storage::ctx_variant_name_index(ctx, clone(canon))
    if idx < 0 {
        return 0 - 1
    }
    ctx_variant_storage::ctx_variant_tag_at(ctx, idx)
}

fn ctx_is_payload_variant_exact(ctx: LowerCtx, name: String) -> bool {
    let count = ctx_variant_storage::ctx_payload_variant_count(ctx)
    let mut i = 0
    while i < count {
        if eq(ctx_variant_storage::ctx_payload_variant_name_at(ctx, i), clone(name)) {
            return true
        }
        i = i + 1
    }
    let query_key = ctx_variant_storage::variant_enum_variant_key(clone(name))
    i = 0
    while i < count {
        let vn = ctx_variant_storage::ctx_payload_variant_name_at(ctx, i)
        if eq(ctx_variant_storage::variant_enum_variant_key(clone(vn)), clone(query_key)) {
            return true
        }
        i = i + 1
    }
    false
}

fn ctx_register_builtin_variants(ctx: LowerCtx) {
    ctx_variants_builtin::ctx_register_builtin_variant_tags(ctx)
    ctx_variants_builtin::ctx_register_builtin_payload_variants(ctx)
}

fn ctx_register_variant_tag(ctx: LowerCtx, name: String, tag: i32) {
    ctx_variant_storage::ctx_variant_push_tag(ctx, name, tag)
}

fn ctx_register_payload_variant(ctx: LowerCtx, name: String) {
    ctx_variant_storage::ctx_payload_variant_push(ctx, name)
}
