use mir::lower::ctx_variant_storage
use mir::lower::ctx_variants_builtin
fn ctx_strip_first_path_segment(name: String) -> String {
    let pos = name.clone().index_of(String_from("::"))
    if pos < 0 {
        return String_new()
    }
    name.slice(pos + 2, name.len())
}

// Enum owner of a registered variant spelling:
// "Error::IndexOutOfBounds" -> "Error". Returns "" when the name has no
// enum owner segment. Used to type an enum-variant struct literal as the
// enum, not the payload struct it constructs.
fn ctx_variant_owner_name(name: String) -> String {
    let n = name.len()
    let mut last_sep = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            last_sep = i
            i = i + 2
            continue
        }
        i = i + 1
    }
    if last_sep < 0 {
        return String_new()
    }
    name.slice(0, last_sep)
}

// Resolve module::Enum::Variant spellings to the registered layout name
// Enum::Variant used by MIR struct/enum lowering. The lookup already
// normalizes through the Enum::Variant key index, so return the registered
// spelling rather than the caller's text; downstream layout/GC lookups are
// keyed by the registered name and miss on module-prefixed spellings.
fn ctx_canonical_variant_name(ctx: LowerCtx, name: String) -> String {
    let exact = ctx_variant_storage::ctx_variant_name_index(ctx, name.clone())
    if exact >= 0 {
        return ctx_variant_storage::ctx_variant_name_at(ctx, exact)
    }
    let mut rest = name.clone()
    while true {
        let next = ctx_strip_first_path_segment(rest.clone())
        if next.len() == 0 {
            return String_new()
        }
        let idx = ctx_variant_storage::ctx_variant_name_index(ctx, next.clone())
        if idx >= 0 {
            return ctx_variant_storage::ctx_variant_name_at(ctx, idx)
        }
        rest = next
    }
    String_new()
}

fn ctx_variant_tag(ctx: LowerCtx, name: String) -> i32 {
    let canon = ctx_canonical_variant_name(ctx, name.clone())
    if canon.len() == 0 {
        return 0 - 1
    }
    let idx = ctx_variant_storage::ctx_variant_name_index(ctx, canon.clone())
    if idx < 0 {
        return 0 - 1
    }
    ctx_variant_storage::ctx_variant_tag_at(ctx, idx)
}

fn ctx_is_payload_variant_exact(ctx: LowerCtx, name: String) -> bool {
    let count = ctx_variant_storage::ctx_payload_variant_count(ctx)
    let mut i = 0
    while i < count {
        if ctx_variant_storage::ctx_payload_variant_name_at(ctx, i).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    let query_key = ctx_variant_storage::variant_enum_variant_key(name.clone())
    i = 0
    while i < count {
        let vn = ctx_variant_storage::ctx_payload_variant_name_at(ctx, i)
        if ctx_variant_storage::variant_enum_variant_key(vn.clone()).eq(query_key.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn ctx_register_builtin_variants(mut ctx: LowerCtx) {
    ctx_variants_builtin::ctx_register_builtin_variant_tags(ctx)
    ctx_variants_builtin::ctx_register_builtin_payload_variants(ctx)
}

fn ctx_register_variant_tag(mut ctx: LowerCtx, name: String, tag: i32) {
    ctx_variant_storage::ctx_variant_push_tag(ctx, name, tag)
}

fn ctx_register_payload_variant(mut ctx: LowerCtx, name: String) {
    ctx_variant_storage::ctx_payload_variant_push(ctx, name)
}
