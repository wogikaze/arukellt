use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_function_frame
use mir::lower::ctx_api_local_types
use mir::lower::ctx_types
use mir::local_factory
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_atoms
use mir::value_types
fn core_emit_closure_params(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, clos: CoreHirExpr) {
    let child_count = core_expr_shape_accessors::mir_core_expr_child_count(clos)
    let mut pi = 0
    while pi + 1 < child_count {
        let p = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(clos, pi))
        if core_expr_shape_atoms::mir_core_expr_is_ident(p) {
            let param_name = core_expr_shape_accessors::mir_core_expr_text(p)
            // Typed params arrive with the resolved expr type; falling back
            // to i32 broke ref-typed closure params at the wasm boundary
            // (#872).
            let mut pvt = core_expr_shape_accessors::mir_core_expr_val_type(p)
            let ptype = core_expr_shape_accessors::mir_core_expr_type_name(p)
            if pvt <= 0 {
                pvt = value_types::VT_I32()
            }
            let _idx = ctx_api_local_alloc::ctx_alloc_local(ctx, param_name.clone(), pvt)
            if ptype.len() > 0 {
                ctx_api_local_types::ctx_set_local_type(ctx, _idx, ptype.clone())
            }
            ctx_api_function_frame::ctx_push_func_param(ctx, local_factory::MirLocal_new(param_name.clone(), pvt, ptype.clone()))
        }
        pi = pi + 1
    }
}
