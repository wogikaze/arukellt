use std::prelude::{eq}
use std::text
use corehir::param
use corehir::type_info_to_mir_value
use mir::function_identity
use mir::legacy_vt_compat
use mir::lower::binary_type_names
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_function_frame
use mir::lower::ctx_api_local_types
use mir::lower::ctx_current_storage
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_mono
use mir::lower::ctx_types
use mir::lower::params_fn
use mir::local_factory
use mir::module_spine
use mir::spine_lookup
use mir::typed_mir_compat
use mir::types
use mir::value_types
fn mir_bind_method_param(mut ctx: LowerCtx, struct_name: String, param: CoreHirParam) {
    if !param::param_is_bindable(param) {
        return
    }
    let p_name = param::param_name(param)
    if param::param_is_self(param) {
        mir_bind_method_self_param(ctx, struct_name, param)
        return
    }
    let mut pvt = param::param_value_type(param)
    let p_type_name = param::param_type_name(param)
    let local_type_name = param::param_local_type_name(param)
    let mut mir_type_name = p_type_name.clone()
    let mut sig_type_name = p_type_name.clone()
    if len(local_type_name) > 0 {
        // The frontend spells a declared enum parameter as enum:<name> so
        // the enum kind survives call and local typing (ADR-089). It is not
        // a struct layout and must keep its canonical spelling.
        if local_type_name.clone().starts_with("enum:") {
            pvt = value_types::VT_GC_REF()
            mir_type_name = local_type_name.clone()
            sig_type_name = local_type_name.clone()
        } else {
            // Concrete instantiation spellings (GenTakeIter<VecIter>) derive
            // the substituted layout so the registered-struct check sees the
            // real GC layout instead of the unsubstituted declaration.
            let derived_local = ctx_struct_mono::ctx_derive_generic_struct_type_name(ctx, local_type_name.clone())
            mir_type_name = derived_local.clone()
            sig_type_name = derived_local.clone()
            if local_type_name.clone().starts_with("vec:") ||
            local_type_name.clone().starts_with("hashmap:") ||
            local_type_name.clone().starts_with("Option_") ||
            local_type_name.clone().starts_with("option:") ||
            local_type_name.clone().starts_with("result:") ||
            local_type_name.clone().starts_with("Result_") {
                pvt = value_types::VT_GC_REF()
            } else if ctx_struct_layout::ctx_is_registered_struct_type(ctx, derived_local.clone()) {
                // Struct context wins when a user struct shadows an enum name:
                // a bare Box param is the user struct, while enum decls stay
                // reachable through enum:/variant-qualified spellings.
                pvt = value_types::VT_GC_REF()
                sig_type_name = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, derived_local.clone())
            } else if ctx_struct_layout::ctx_is_registered_enum_type(ctx, derived_local.clone()) {
                pvt = value_types::VT_GC_REF()
                mir_type_name = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, derived_local.clone())
                sig_type_name = mir_type_name.clone()
            } else if !params_fn::mir_param_type_is_fnref(local_type_name.clone()) {
                // fnref-family names (fnref/fnref2/fnsig:/fn() keep the
                // callback ABI: the ':' inside fnsig: is a signature
                // separator, not a module qualifier (#860).
                let bare = mir_method_strip_module_prefix(local_type_name.clone())
                let named = mir_method_resolve_named_user_type(bare.clone())
                if len(named) > 0 {
                    pvt = value_types::VT_GC_REF()
                    mir_type_name = named.clone()
                    sig_type_name = named.clone()
                }
            }
        }
    } else {
        if p_type_name.clone().starts_with("Option:") {
            mir_type_name = "option:".concat(p_type_name.slice(7, len(p_type_name)))
            sig_type_name = mir_type_name.clone()
            pvt = value_types::VT_GC_REF()
        } else if p_type_name.clone().starts_with("Result:") {
            mir_type_name = "result:".concat(p_type_name.slice(7, len(p_type_name)))
            sig_type_name = mir_type_name.clone()
            pvt = value_types::VT_GC_REF()
        } else if ctx_struct_layout::ctx_is_registered_struct_type(ctx, p_type_name.clone()) {
            pvt = value_types::VT_GC_REF()
            sig_type_name = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, p_type_name.clone())
        } else {
            let named = mir_method_resolve_named_user_type(p_type_name.clone())
            if len(named) > 0 {
                pvt = value_types::VT_GC_REF()
                mir_type_name = "?".concat(named.clone())
                sig_type_name = mir_type_name.clone()
            }
        }
    }
    let param_local = ctx_alloc_local(ctx, p_name.clone(), pvt)
    ctx_push_func_param(ctx, local_factory::MirLocal_new(p_name.clone(), pvt, sig_type_name))
    ctx_api_local_types::ctx_set_local_type(ctx, param_local, mir_type_name)
    if p_type_name.clone().starts_with(String_from("HashSet")) {
        // Method parameters take this path rather than params_fn; mark a
        // HashSet operand (the `other` side of union / eq / extend) so its
        // own `len` / `is_empty` stay on the hash store (#917).
        let mut family = String_from("i32")
        if eq(local_type_name.clone(), String_from("vec:String")) ||
        p_type_name.clone().starts_with(String_from("HashSet<String>")) ||
        p_type_name.clone().starts_with(String_from("HashSet_String")) {
            family = String_from("String")
        }
        ctx_api_local_types::ctx_mark_hashset_local(ctx, param_local, family)
    }
    mir_apply_param_mvt_override(ctx, param_local)
}

fn mir_bind_method_self_param(mut ctx: LowerCtx, struct_name: String, param: CoreHirParam) {
    // Determine the correct value type for `self` based on the actual type
    // annotation, not just assuming it is always a GC heap reference.
    // For builtin scalar types (i32, i64, f64, f32, bool, char) self is a
    // plain value; for String it is a reference; for Vec/HashMap/user structs
    // it is a GC reference.
    let mut self_vt = param::param_value_type(param)
    let local_type_name = param::param_local_type_name(param)
    // Prefer the annotated local type (e.g. vec:i32) over the bare impl
    // type name ("Vec"). Bare "Vec" falls through to string GC type in the
    // emitter and causes ref-vs-ref on `local.set self` (#726 Vec::read).
    let mut self_type_name = struct_name.clone()
    if len(local_type_name) > 0 {
        // A concrete instantiation spelling (GenTakeIter<VecIter>) derives
        // its substituted layout here so the registered-struct check and the
        // signature type name both see the real GC layout, not the impl
        // owner spelling (GenTakeIter_VecIter) or the unsubstituted decl.
        self_type_name = ctx_struct_mono::ctx_derive_generic_struct_type_name(ctx, local_type_name.clone())
        if local_type_name.clone().starts_with("vec:") || local_type_name.clone().starts_with("hashmap:") {
            self_vt = value_types::VT_GC_REF()
        } else {
            if ctx_struct_layout::ctx_is_registered_struct_type(ctx, self_type_name.clone()) {
                self_vt = value_types::VT_GC_REF()
            }
        }
    } else {
        if ctx_struct_layout::ctx_is_registered_enum_type(ctx, struct_name.clone()) {
            self_vt = value_types::VT_GC_REF()
        } else {
            if ctx_struct_layout::ctx_is_registered_struct_type(ctx, struct_name.clone()) {
                self_vt = value_types::VT_GC_REF()
            }
        }
        // An unannotated self param on a generic impl head still needs the
        // declared Holder<T> spelling: the ordinal mono map
        // (ctx_setup_mono_type_params_by_ordinal) collects type-variable
        // names from param spellings, and a bare Holder drops T so ?T span
        // rewrites cannot concretize inside the body (#874).
        let impl_params = ctx_struct_mono::ctx_generic_struct_params(ctx, struct_name.clone())
        if len(impl_params) > 0 {
            self_type_name = struct_name.clone().concat(String_from("<").concat(impl_params.concat(String_from(">"))))
        }
        // Bare Vec / HashMap / HashSet without element annotation → i32 vec.
        if eq(struct_name.clone(), "Vec") || eq(struct_name.clone(), "HashMap") || eq(struct_name.clone(), "HashSet") {
            self_vt = value_types::VT_GC_REF()
            self_type_name = "vec:i32"
        }
    }
    let self_local = ctx_alloc_local(ctx, "self", self_vt)
    let self_sig_type_name = if self_type_name.clone().starts_with("vec:") || self_type_name.clone().starts_with("hashmap:") {
        self_type_name.clone()
    } else if self_vt == value_types::VT_GC_REF() {
        ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, self_type_name.clone())
    } else {
        self_type_name.clone()
    }
    // The receiver local carries the same enum-open spelling a free-function
    // parameter gets. With the bare owner name, a match wildcard that copies
    // `self` resolves through the struct/type table and falls back to the
    // string storage type; the resulting `(ref null <string>)` local cannot
    // accept the enum-open receiver (#917).
    let mut self_local_type_name = self_type_name.clone()
    if self_vt == value_types::VT_GC_REF() {
        let enum_spelling = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, self_type_name.clone())
        if enum_spelling.clone().starts_with(String_from("enum:")) {
            self_local_type_name = enum_spelling
        }
    }
    ctx_push_func_param(ctx, local_factory::MirLocal_new("self", self_vt, self_sig_type_name.clone()))
    ctx_set_local_type(ctx, self_local, self_local_type_name.clone())
    if struct_name.clone().starts_with("HashSet") {
        // The set receiver is a flat Vec alias. The marker is what keeps
        // `len` / `is_empty` on the hash store instead of the Vec core-op
        // rewrites; the element family selects the i32 or String store.
        // Concrete impl owners reach here as HashSet_i32 / HashSet_String,
        // generic shells as HashSet (#917).
        let mut family = String_from("i32")
        if eq(self_type_name.clone(), String_from("vec:String")) ||
        eq(local_type_name.clone(), String_from("vec:String")) ||
        self_type_name.clone().starts_with(String_from("HashSet<String>")) ||
        self_type_name.clone().starts_with(String_from("HashSet_String")) {
            family = String_from("String")
        }
        ctx_api_local_types::ctx_mark_hashset_local(ctx, self_local, family)
    }
    mir_apply_param_mvt_override(ctx, self_local)
}

// If the signature spine has a concrete container MirValueType (Vec/Option/
// Result/HashMap) for this parameter, overwrite the legacy type_name/val_type
// and function-sig type_name with the canonical alias so the emitter uses the
// right GC ref type. Non-container types are left to the existing string path.
fn mir_apply_param_mvt_override(mut ctx: LowerCtx, param_local: i32) {
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    let func_name = function_identity::MirFunction_name(func)
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    let mut table = module_spine::MirModule_type_table(m)
    let mut param_mvt = spine_lookup::function_param_mvt(m, func_name, param_local)
    let current_type = ctx_api_local_types::ctx_get_local_type(ctx, param_local)
    if mir_method_param_type_name_is_concrete(current_type.clone()) {
        param_mvt = type_info_to_mir_value::vt_to_mir_value(
            table,
            ctx_api_local_types::ctx_local_vt(ctx, param_local),
            current_type.clone()
        )
    }
    if typed_mir_compat::mvt_is_invalid(param_mvt) {
        return
    }
    if current_type.clone().starts_with(String_from("enum:")) {
        param_mvt = type_info_to_mir_value::vt_to_mir_value(
            table,
            value_types::VT_GC_REF(),
            current_type.clone()
        )
    }
    ctx_api_local_types::ctx_set_local_mvt(ctx, param_local, param_mvt)
    let alias = type_info_to_mir_value::mvt_gc_layout_alias(table, param_mvt)
    if len(alias) == 0 {
        return
    }
    let current = ctx_api_local_types::ctx_get_local_type(ctx, param_local)
    // fnref-family params keep the callback ABI; a container/struct alias
    // from the legacy spine must not rewrite fnsig: locals to GC refs (#860).
    if params_fn::mir_param_type_is_fnref(current.clone()) {
        return
    }
    if type_info_to_mir_value::concrete_type_outranks_mvt_alias(current.clone(), alias.clone()) {
        return
    }
    let mvt_vt = legacy_vt_compat::legacy_vt_from_mir_value_type(table, param_mvt)
    // A var-carrying spelling (?HashMap:K:V, hashmap:K:V, vec:K) still holds
    // the function's type variables; the ordinal mono map collects them from
    // this name before mono substitution resolves the concrete alias.
    // Overwriting the local type name here would erase the vars and leave
    // the map empty; ctx_set_func_param_type would also sync the local
    // record, so only the signature record takes the alias (#691).
    if len(ctx_mono_type_params::ctx_type_var_names_from_local_type(current.clone())) > 0 {
        ctx_api_local_types::ctx_set_local_vt(ctx, param_local, mvt_vt)
        ctx_api_function_frame::ctx_set_func_param_sig_type(ctx, param_local, mvt_vt, alias.clone())
        return
    }
    ctx_api_local_types::ctx_set_local_vt(ctx, param_local, mvt_vt)
    ctx_api_local_types::ctx_set_local_type(ctx, param_local, alias.clone())
    ctx_api_function_frame::ctx_set_func_param_type(ctx, param_local, mvt_vt, alias.clone())
}

fn mir_method_param_type_name_is_concrete(type_name: String) -> bool {
    if len(type_name) == 0 || type_name.clone().starts_with(String_from("?")) {
        return false
    }
    if len(type_name) == 1 {
        let ch = type_name.byte_at(0)
        if ch >= 65 && ch <= 90 {
            return false
        }
    }
    true
}

fn mir_method_resolve_named_user_type(bare: String) -> String {
    if !binary_type_names::mir_is_builtin_type_name(bare.clone()) &&
    len(bare) > 0 &&
    mir_method_param_type_name_is_concrete(bare.clone()) {
        return bare
    }
    String_new()
}

fn mir_method_strip_module_prefix(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    name.clone()
}
