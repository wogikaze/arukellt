use std::text
use std::prelude::{clone}
fn closure_pack_caps(caps: Vec<String>) -> String {
    let mut s = String_new()
    let c = len(caps)
    let mut i = 0
    while i < c {
        if i > 0 {
            s = s.concat(",")
        }
        s = s.concat(clone(get_unchecked(caps, i)))
        i = i + 1
    }
    s
}
