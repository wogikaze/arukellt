use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_types
use mir::inst_call
use mir::inst_local_get
use mir::lower::loop_conditions
use mir::value_types

fn mir_is_vec_type_name(vec_type: String) -> bool {
    if eq(clone(vec_type), "Vec") || starts_with(clone(vec_type), "vec:") {
        return true
    }
    starts_with(clone(vec_type), "Vec<") && ends_with(clone(vec_type), ">")
}

fn mir_vec_element_type_name(vec_type: String) -> String {
    if starts_with(clone(vec_type), "vec:") {
        return substring(vec_type, 4, len(vec_type))
    }
    if starts_with(clone(vec_type), "Vec<") && ends_with(clone(vec_type), ">") {
        return substring(vec_type, 4, len(vec_type) - 1)
    }
    "i32"
}

fn mir_vec_element_vt(elem_type: String) -> i32 {
    if eq(clone(elem_type), "i64") || eq(clone(elem_type), "I64") {
        return value_types::VT_I64()
    }
    if eq(clone(elem_type), "f64") || eq(clone(elem_type), "F64") {
        return value_types::VT_F64()
    }
    if eq(clone(elem_type), "v128") || eq(clone(elem_type), "V128") {
        return value_types::VT_V128()
    }
    if eq(clone(elem_type), "fnref") || eq(clone(elem_type), "fn") || starts_with(clone(elem_type), "fn(") {
        return value_types::VT_FUNCREF()
    }
    if eq(clone(elem_type), "i32") || eq(clone(elem_type), "I32") || eq(clone(elem_type), "bool") || eq(clone(elem_type), "char") {
        return value_types::VT_I32()
    }
    if len(elem_type) == 1 {
        let ch = char_at(elem_type, 0)
        if ch >= 65 && ch <= 90 {
            return value_types::VT_I32()
        }
    }
    value_types::VT_GC_REF()
}

fn mir_emit_vec_len_saved(ctx: LowerCtx, vec_local: i32) -> i32 {
    ctx_emit(ctx, inst_local_get::MirInst_local_get(vec_local))
    let end_local = ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_emit(ctx, inst_call::MirInst_call(String_from("raw_array_len"), 1, end_local))
    loop_conditions::mir_save_stack_to_local(ctx, end_local)
    end_local
}

fn mir_emit_vec_get_unchecked_to_local(ctx: LowerCtx, vec_local: i32, idx_var: i32, iter_var: i32) {
    ctx_emit(ctx, inst_local_get::MirInst_local_get(vec_local))
    ctx_emit(ctx, inst_local_get::MirInst_local_get(idx_var))
    ctx_emit(ctx, inst_call::MirInst_call(String_from("vec_get_unchecked"), 2, iter_var))
    loop_conditions::mir_save_stack_to_local(ctx, iter_var)
}
