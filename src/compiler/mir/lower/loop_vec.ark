use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_types
use mir::inst_call
use mir::inst_local_get
use mir::lower::loop_conditions
use mir::lower::ctx_gc_struct
use mir::value_types
fn mir_is_vec_type_name(vec_type: String) -> bool {
    if vec_type.clone().eq("Vec") || vec_type.clone().starts_with("vec:") {
        return true
    }
    vec_type.clone().starts_with("Vec<") && vec_type.clone().ends_with(">")
}

fn mir_vec_element_type_name(vec_type: String) -> String {
    if vec_type.clone().starts_with("vec:") {
        return vec_type.slice(4, len(vec_type))
    }
    if vec_type.clone().starts_with("Vec<") && vec_type.clone().ends_with(">") {
        return vec_type.slice(4, len(vec_type) - 1)
    }
    "i32"
}

fn mir_vec_element_vt(ctx: LowerCtx, elem_type: String) -> i32 {
    if elem_type.clone().eq("i64") || elem_type.clone().eq("I64") {
        return value_types::VT_I64()
    }
    if elem_type.clone().eq("f64") || elem_type.clone().eq("F64") {
        return value_types::VT_F64()
    }
    if elem_type.clone().eq("v128") || elem_type.clone().eq("V128") {
        return value_types::VT_V128()
    }
    if elem_type.clone().eq("fnref") || elem_type.clone().eq("fn") || elem_type.clone().starts_with("fn(") {
        return value_types::VT_FUNCREF()
    }
    if elem_type.clone().eq("i32") || elem_type.clone().eq("I32") || elem_type.clone().eq("bool") || elem_type.clone().eq("char") {
        return value_types::VT_I32()
    }
    if len(elem_type) == 1 {
        let ch = elem_type.byte_at(0)
        if ch >= 65 && ch <= 90 {
            // A declared single-letter element type (struct P) is a ref,
            // not an unsubstituted-param scalar.
            if ctx_gc_struct::gc_struct_field_name_is_declared(ctx, elem_type.clone()) {
                return value_types::VT_GC_REF()
            }
            return value_types::VT_I32()
        }
    }
    value_types::VT_GC_REF()
}

fn mir_emit_vec_len_saved(mut ctx: LowerCtx, vec_local: i32) -> i32 {
    ctx_emit(ctx, inst_local_get::MirInst_local_get(vec_local))
    let end_local = ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_emit(ctx, inst_call::MirInst_call(String_from("raw_array_len"), 1, end_local))
    loop_conditions::mir_save_stack_to_local(ctx, end_local)
    end_local
}

fn mir_emit_vec_get_unchecked_to_local(mut ctx: LowerCtx, vec_local: i32, idx_var: i32, iter_var: i32) {
    ctx_emit(ctx, inst_local_get::MirInst_local_get(vec_local))
    ctx_emit(ctx, inst_local_get::MirInst_local_get(idx_var))
    ctx_emit(ctx, inst_call::MirInst_call(String_from("vec_get_unchecked"), 2, iter_var))
    loop_conditions::mir_save_stack_to_local(ctx, iter_var)
}
