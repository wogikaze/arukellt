use std::text
use corehir::hashmap_type_name
use mir::lower::ctx_struct_storage

// A derived generic layout stores `HashMap<i32, i32>` while locals and store
// lowering speak the `hashmap:` storage alias. Normalize before the type
// reaches method dispatch or local declaration so a field receiver gets the
// same ref type as the map value (#974).
fn ctx_struct_field_hashmap_alias(type_name: String) -> String {
    if !type_name.clone().starts_with(String_from("HashMap<")) ||
    !type_name.clone().ends_with(String_from(">")) {
        return type_name
    }
    let inner = type_name.clone().slice(8, type_name.len() - 1)
    let comma = inner.clone().index_of(String_from(","))
    if comma < 0 {
        return type_name
    }
    let key = ctx_struct_trim_type_segment(inner.clone().slice(0, comma))
    let value = ctx_struct_trim_type_segment(inner.clone().slice(comma + 1, inner.len()))
    if key.clone().len() == 0 || value.clone().len() == 0 {
        return type_name
    }
    if ctx_struct_is_type_param_segment(key.clone()) || ctx_struct_is_type_param_segment(value.clone()) {
        return type_name
    }
    String_from("hashmap:").concat(hashmap_type_name::hashmap_type_alias(key, value))
}

fn ctx_struct_trim_type_segment(segment: String) -> String {
    let length = segment.len()
    let mut start = 0
    while start < length && segment.clone().byte_at(start) == 32 {
        start = start + 1
    }
    let mut end = length
    while end > start && segment.clone().byte_at(end - 1) == 32 {
        end = end - 1
    }
    segment.slice(start, end)
}

fn ctx_struct_is_type_param_segment(segment: String) -> bool {
    if segment.len() != 1 {
        return false
    }
    let ch = segment.byte_at(0)
    ch >= 65 && ch <= 90
}

fn ctx_struct_field_type_name(ctx: LowerCtx, struct_name: String, field_idx: i32) -> String {
    let found = ctx_struct_field_hashmap_alias(
        ctx_struct_field_type_name_exact(ctx, struct_name.clone(), field_idx)
    )
    if found.len() > 0 || ctx_struct_layout_exists(ctx, struct_name.clone()) {
        return found
    }
    // Match arms may use bare `Table` while layouts are registered as
    // `TomlValue::Table` (#726 toml_full_*).
    let resolved = ctx_resolve_variant_layout_name(ctx, struct_name.clone())
    if resolved.len() > 0 && !resolved.clone().eq(struct_name.clone()) {
        return ctx_struct_field_hashmap_alias(
            ctx_struct_field_type_name_exact(ctx, resolved, field_idx)
        )
    }
    String_new()
}

// Option/Result variants register multiple layouts under the same name
// (Some/Ok/Err) with different payload field types. Prefer the layout whose
// payload field matches `payload_type_name` instead of the first name hit.
fn ctx_struct_field_type_name_for_payload(ctx: LowerCtx, struct_name: String, field_idx: i32, payload_type_name: String) -> String {
    if payload_type_name.len() == 0 {
        return ctx_struct_field_type_name(ctx, struct_name, field_idx)
    }
    let want = ctx_normalize_payload_field_type_name(payload_type_name.clone())
    let found = ctx_struct_field_type_name_exact_for_payload(ctx, struct_name.clone(), field_idx, want.clone())
    if found.len() > 0 {
        return found
    }
    let resolved = ctx_resolve_variant_layout_name(ctx, struct_name.clone())
    if resolved.len() > 0 && !resolved.clone().eq(struct_name.clone()) {
        let resolved_found = ctx_struct_field_type_name_exact_for_payload(ctx, resolved, field_idx, want.clone())
        if resolved_found.len() > 0 {
            return resolved_found
        }
    }
    ctx_struct_field_type_name(ctx, struct_name, field_idx)
}

fn ctx_normalize_payload_field_type_name(type_name: String) -> String {
    if type_name.clone().eq(String_from("string")) {
        return String_from("String")
    }
    if type_name.clone().starts_with(String_from("enum:")) {
        return type_name.slice(5, type_name.len())
    }
    if type_name.clone().starts_with(String_from("option:")) {
        return String_from("option:").concat(type_name.slice(7, type_name.len()))
    }
    if type_name.clone().starts_with(String_from("Option_")) {
        return String_from("option:").concat(type_name.slice(7, type_name.len()))
    }
    if type_name.clone().starts_with(String_from("Option:")) {
        return String_from("option:").concat(type_name.slice(7, type_name.len()))
    }
    if type_name.clone().starts_with(String_from("Option<")) && type_name.clone().ends_with(String_from(">")) {
        return String_from("option:").concat(type_name.slice(7, type_name.len() - 1))
    }
    type_name
}

fn ctx_payload_field_types_match(layout_ft: String, want: String) -> bool {
    if layout_ft.clone().eq(want.clone()) {
        return true
    }
    let layout_norm = ctx_normalize_payload_field_type_name(layout_ft.clone())
    let want_norm = ctx_normalize_payload_field_type_name(want.clone())
    if layout_norm.clone().eq(want_norm.clone()) {
        return true
    }
    if layout_norm.clone().eq(String_from("String")) && want_norm.clone().eq(String_from("String")) {
        return true
    }
    if ctx_generic_field_type_matches(layout_norm.clone(), want_norm.clone()) {
        return true
    }
    false
}

fn ctx_generic_field_type_matches(layout_type: String, want_type: String) -> bool {
    if is_generic_type_parameter_name(layout_type.clone()) {
        return true
    }
    if layout_type.clone().starts_with("vec:") && want_type.clone().starts_with("vec:") {
        let layout_elem = layout_type.clone().slice(4, layout_type.len())
        return is_generic_type_parameter_name(layout_elem.clone())
    }
    false
}

fn is_generic_type_parameter_name(type_name: String) -> bool {
    let bare = if type_name.clone().starts_with("?") {
        type_name.slice(1, type_name.len())
    } else {
        type_name
    }
    if bare.len() != 1 {
        return false
    }
    let ch = bare.byte_at(0)
    ch >= 65 && ch <= 90
}

fn ctx_struct_field_type_name_exact(ctx: LowerCtx, struct_name: String, field_idx: i32) -> String {
    let li = ctx_struct_storage::ctx_struct_layout_preferred_index(ctx, struct_name.clone())
    if li < 0 {
        return String_new()
    }
    let offset = ctx_struct_storage::ctx_struct_layout_field_offset_at(ctx, li)
    let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, li)
    if field_idx < fc {
        return ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, offset + field_idx)
    }
    String_new()
}

fn ctx_struct_field_type_name_exact_for_payload(ctx: LowerCtx, struct_name: String, field_idx: i32, want: String) -> String {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut offset = 0
    let mut si = 0
    while si < sc {
        let sn = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si)
        if sn.clone().eq(struct_name.clone()) {
            if field_idx < fc {
                let ft = ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, offset + field_idx)
                if ctx_payload_field_types_match(ft.clone(), want.clone()) {
                    return ft
                }
            }
        }
        offset = offset + fc
        si = si + 1
    }
    String_new()
}

fn ctx_struct_layout_exists(ctx: LowerCtx, struct_name: String) -> bool {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut si = 0
    while si < sc {
        if ctx_struct_storage::ctx_struct_layout_name_at(ctx, si).eq(struct_name.clone()) {
            return true
        }
        si = si + 1
    }
    false
}

fn ctx_resolve_variant_layout_name(ctx: LowerCtx, variant_name: String) -> String {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    // Bare `Table` → unique `TomlValue::Table` (#726).
    if !variant_name.clone().contains(String_from("::")) {
        let suffix = String_from("::").concat(variant_name.clone())
        let mut si = 0
        let mut found = String_new()
        let mut hits = 0
        while si < sc {
            let sn = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
            if sn.clone().ends_with(suffix.clone()) {
                found = sn
                hits = hits + 1
            }
            si = si + 1
        }
        if hits == 1 {
            return found
        }
        return variant_name
    }
    // Module-qualified arms (`types::WitType::List`) share the Enum::Variant
    // key with layouts registered as `WitType::List` (#809).
    let query_key = variant_layout_enum_variant_key(variant_name.clone())
    let mut si2 = 0
    let mut best = String_new()
    let mut best_len = 0 - 1
    let mut hits2 = 0
    while si2 < sc {
        let sn = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si2)
        if variant_layout_enum_variant_key(sn.clone()).eq(query_key.clone()) {
            hits2 = hits2 + 1
            let sn_len = sn.len()
            if sn_len > best_len {
                best_len = sn_len
                best = sn
            }
        }
        si2 = si2 + 1
    }
    if hits2 > 0 {
        return best
    }
    variant_name
}

fn variant_layout_enum_variant_key(name: String) -> String {
    let n = name.len()
    let mut last_sep = 0 - 1
    let mut prev_sep = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            prev_sep = last_sep
            last_sep = i
            i = i + 2
            continue
        }
        i = i + 1
    }
    if last_sep < 0 || prev_sep < 0 {
        return name
    }
    name.slice(prev_sep + 2, n)
}

fn ctx_struct_field_is_gc_ref(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    let ft = ctx_struct_field_type_name(ctx, struct_name.clone(), field_idx)
    if ft.len() == 0 {
        return false
    }
    if ft.clone().eq("String") || ft.clone().eq("string") {
        return true
    }
    // Declared aggregates win over the single-letter type-param heuristic:
    // `p: P` on a declared struct P is a ref field, not a scalar param slot.
    if field_type_is_registered_enum(ctx, ft.clone()) {
        return true
    }
    if field_type_is_registered_struct(ctx, ft.clone()) {
        return true
    }
    // Unsubstituted type params are scalar placeholders, not GC refs.
    if field_type_is_type_param(ft.clone()) {
        return false
    }
    // Function refs are i32 table indices.
    if ft.clone().eq("fnref") || ft.clone().starts_with(String_from("fnref")) || ft.clone().eq("fn") || ft.clone().starts_with(String_from("fn(")) {
        return false
    }
    // `fnsig:` callback fields are typed funcrefs, not GC data refs (#860).
    if ft.clone().starts_with(String_from("fnsig:")) {
        return false
    }
    // Vec/HashMap/HashSet container fields are GC refs (not i32 handles).
    if field_type_is_container_ref(ft.clone()) {
        return true
    }
    false
}

fn field_type_is_container_ref(type_name: String) -> bool {
    if type_name.clone().eq(String_from("Vec")) || type_name.clone().eq(String_from("HashMap")) || type_name.clone().eq(String_from("HashSet")) {
        return true
    }
    if type_name.clone().starts_with(String_from("vec:")) || type_name.clone().starts_with(String_from("hashmap:")) || type_name.clone().starts_with(String_from("hashset:")) {
        return true
    }
    if type_name.clone().starts_with(String_from("Vec<")) || type_name.clone().starts_with(String_from("HashMap<")) || type_name.clone().starts_with(String_from("HashSet<")) {
        return true
    }
    // Result/Option angle-bracket forms are GC enum-open refs (#726 json).
    if type_name.clone().starts_with(String_from("Result<")) || type_name.clone().starts_with(String_from("Result_")) || type_name.clone().starts_with(String_from("result:")) {
        return true
    }
    if type_name.clone().starts_with(String_from("Option<")) || type_name.clone().starts_with(String_from("Option_")) || type_name.clone().starts_with(String_from("option:")) {
        return true
    }
    false
}

fn field_type_is_type_param(type_name: String) -> bool {
    if type_name.len() == 0 {
        return false
    }
    if type_name.clone().starts_with(String_from("?")) {
        return field_type_is_type_param(type_name.slice(1, type_name.len()))
    }
    if type_name.len() == 1 {
        let ch = type_name.byte_at(0)
        if ch >= 65 && ch <= 90 {
            return true
        }
    }
    false
}

fn field_type_is_registered_struct(ctx: LowerCtx, type_name: String) -> bool {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut si = 0
    while si < sc {
        if ctx_struct_storage::ctx_struct_layout_name_at(ctx, si).eq(type_name.clone()) {
            return true
        }
        si = si + 1
    }
    false
}

fn field_type_is_registered_enum(ctx: LowerCtx, type_name: String) -> bool {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut si = 0
    while si < sc {
        if ctx_struct_storage::ctx_struct_layout_name_at(ctx, si).eq(type_name.clone()) {
            if ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si) == 1 {
                let mut off = 0
                let mut li = 0
                while li < si {
                    off = off + ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, li)
                    li = li + 1
                }
                if ctx_struct_storage::ctx_struct_field_name_at_offset(ctx, off).eq(String_from("_tag")) {
                    return true
                }
            }
            return false
        }
        si = si + 1
    }
    false
}

fn ctx_struct_field_is_f64(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut offset = 0
    let mut si = 0
    while si < sc {
        let sn = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si)
        if sn.clone().eq(struct_name.clone()) {
            if field_idx < fc {
                let ft = ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, offset + field_idx)
                return ft.clone().eq("f64")
            }
            return false
        }
        offset = offset + fc
        si = si + 1
    }
    false
}

fn ctx_struct_field_is_i64(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut offset = 0
    let mut si = 0
    while si < sc {
        let sn = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si)
        if sn.clone().eq(struct_name.clone()) {
            if field_idx < fc {
                let ft = ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, offset + field_idx)
                return ft.clone().eq("i64") || ft.clone().eq("u64")
            }
            return false
        }
        offset = offset + fc
        si = si + 1
    }
    false
}

fn ctx_struct_field_is_v128(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    let ft = ctx_struct_field_type_name(ctx, struct_name.clone(), field_idx)
    ft.clone().eq("v128") || ft.clone().eq("V128")
}

// Normalize a struct field type name (possibly module-qualified) to the MIR
// local type name used by the GC emitter (e.g. Vec<String> -> vec:String).
fn normalize_gc_field_type_name(type_name: String) -> String {
    if type_name.clone().starts_with(String_from("vec:")) {
        let elem = type_name.clone().slice(4, type_name.len())
        return String_from("vec:").concat(normalize_gc_field_type_name(elem))
    }
    if type_name.clone().starts_with(String_from("Vec<")) &&
    type_name.clone().ends_with(String_from(">")) {
        let elem = type_name.clone().slice(4, type_name.len() - 1)
        if elem.clone().eq(String_from("String")) || elem.clone().eq(String_from("string")) {
            return String_from("vec:String")
        }
        return String_from("vec:").concat(normalize_gc_field_type_name(elem.clone()))
    }
    if type_name.clone().starts_with(String_from("Vec_")) {
        let elem = type_name.clone().slice(4, type_name.len())
        if elem.clone().eq(String_from("String")) || elem.clone().eq(String_from("string")) {
            return String_from("vec:String")
        }
        return String_from("vec:").concat(normalize_gc_field_type_name(elem.clone()))
    }
    let base = strip_module_prefix(type_name.clone())
    if base.clone().eq(String_from("Vec")) {
        return String_from("vec:i32")
    }
    if base.clone().eq(String_from("String")) || base.clone().eq(String_from("string")) {
        return String_from("String")
    }
    base
}

fn strip_module_prefix(name: String) -> String {
    let name_len = name.len()
    let mut index = name_len - 2
    while index >= 0 {
        if name.byte_at(index) == 58 && name.byte_at(index + 1) == 58 {
            return name.slice(index + 2, name_len)
        }
        index = index - 1
    }
    name
}
