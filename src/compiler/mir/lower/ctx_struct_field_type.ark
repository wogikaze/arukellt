use mir::lower::ctx_struct_storage

fn ctx_struct_field_type_name(ctx: LowerCtx, struct_name: String, field_idx: i32) -> String {
    let found = ctx_struct_field_type_name_exact(ctx, clone(struct_name), field_idx)
    if len(found) > 0 || ctx_struct_layout_exists(ctx, clone(struct_name)) {
        return found
    }
    // Match arms may use bare `Table` while layouts are registered as
    // `TomlValue::Table` (#726 toml_full_*).
    let resolved = ctx_resolve_variant_layout_name(ctx, clone(struct_name))
    if len(resolved) > 0 && !eq(clone(resolved), clone(struct_name)) {
        return ctx_struct_field_type_name_exact(ctx, resolved, field_idx)
    }
    String_new()
}

// Option/Result variants register multiple layouts under the same name
// (Some/Ok/Err) with different payload field types. Prefer the layout whose
// payload field matches `payload_type_name` instead of the first name hit.
fn ctx_struct_field_type_name_for_payload(ctx: LowerCtx, struct_name: String, field_idx: i32, payload_type_name: String) -> String {
    if len(payload_type_name) == 0 {
        return ctx_struct_field_type_name(ctx, struct_name, field_idx)
    }
    let want = ctx_normalize_payload_field_type_name(clone(payload_type_name))
    let found = ctx_struct_field_type_name_exact_for_payload(ctx, clone(struct_name), field_idx, clone(want))
    if len(found) > 0 {
        return found
    }
    let resolved = ctx_resolve_variant_layout_name(ctx, clone(struct_name))
    if len(resolved) > 0 && !eq(clone(resolved), clone(struct_name)) {
        let resolved_found = ctx_struct_field_type_name_exact_for_payload(ctx, resolved, field_idx, clone(want))
        if len(resolved_found) > 0 {
            return resolved_found
        }
    }
    ctx_struct_field_type_name(ctx, struct_name, field_idx)
}

fn ctx_normalize_payload_field_type_name(type_name: String) -> String {
    if eq(clone(type_name), "string") {
        return "String"
    }
    if starts_with(clone(type_name), "enum:") {
        return substring(type_name, 5, len(type_name))
    }
    if starts_with(clone(type_name), "option:") {
        return concat("option:", substring(type_name, 7, len(type_name)))
    }
    if starts_with(clone(type_name), "Option_") {
        return concat("option:", substring(type_name, 7, len(type_name)))
    }
    if starts_with(clone(type_name), "Option:") {
        return concat("option:", substring(type_name, 7, len(type_name)))
    }
    if starts_with(clone(type_name), "Option<") && ends_with(clone(type_name), ">") {
        return concat("option:", substring(type_name, 7, len(type_name) - 1))
    }
    type_name
}

fn ctx_payload_field_types_match(layout_ft: String, want: String) -> bool {
    if eq(clone(layout_ft), clone(want)) {
        return true
    }
    let layout_norm = ctx_normalize_payload_field_type_name(clone(layout_ft))
    let want_norm = ctx_normalize_payload_field_type_name(clone(want))
    if eq(clone(layout_norm), clone(want_norm)) {
        return true
    }
    if eq(clone(layout_norm), "String") && eq(clone(want_norm), "String") {
        return true
    }
    false
}

fn ctx_struct_field_type_name_exact(ctx: LowerCtx, struct_name: String, field_idx: i32) -> String {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut offset = 0
    let mut si = 0
    while si < sc {
        let sn = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si)
        if eq(clone(sn), clone(struct_name)) {
            if field_idx < fc {
                return ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, offset + field_idx)
            }
            return String_new()
        }
        offset = offset + fc
        si = si + 1
    }
    String_new()
}

fn ctx_struct_field_type_name_exact_for_payload(ctx: LowerCtx, struct_name: String, field_idx: i32, want: String) -> String {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut offset = 0
    let mut si = 0
    while si < sc {
        let sn = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si)
        if eq(clone(sn), clone(struct_name)) {
            if field_idx < fc {
                let ft = ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, offset + field_idx)
                if ctx_payload_field_types_match(clone(ft), clone(want)) {
                    return ft
                }
            }
        }
        offset = offset + fc
        si = si + 1
    }
    String_new()
}

fn ctx_struct_layout_exists(ctx: LowerCtx, struct_name: String) -> bool {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut si = 0
    while si < sc {
        if eq(ctx_struct_storage::ctx_struct_layout_name_at(ctx, si), clone(struct_name)) {
            return true
        }
        si = si + 1
    }
    false
}

fn ctx_resolve_variant_layout_name(ctx: LowerCtx, variant_name: String) -> String {
    if contains(clone(variant_name), "::") {
        return variant_name
    }
    let suffix = concat("::", clone(variant_name))
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut si = 0
    let mut found = String_new()
    let mut hits = 0
    while si < sc {
        let sn = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        if ends_with(clone(sn), clone(suffix)) {
            found = sn
            hits = hits + 1
        }
        si = si + 1
    }
    if hits == 1 {
        return found
    }
    variant_name
}

fn ctx_struct_field_is_gc_ref(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    let ft = ctx_struct_field_type_name(ctx, clone(struct_name), field_idx)
    if len(ft) == 0 {
        return false
    }
    if eq(clone(ft), "String") || eq(clone(ft), "string") {
        return true
    }
    // Unsubstituted type params are scalar placeholders, not GC refs.
    if field_type_is_type_param(clone(ft)) {
        return false
    }
    // Function refs are i32 table indices.
    if eq(clone(ft), "fnref") || eq(clone(ft), "fn") || starts_with(clone(ft), "fn(") {
        return false
    }
    // Vec/HashMap/HashSet container fields are GC refs (not i32 handles).
    if field_type_is_container_ref(clone(ft)) {
        return true
    }
    if field_type_is_registered_enum(ctx, clone(ft)) {
        return true
    }
    if field_type_is_registered_struct(ctx, clone(ft)) {
        return true
    }
    false
}

fn field_type_is_container_ref(type_name: String) -> bool {
    if eq(clone(type_name), "Vec") || eq(clone(type_name), "HashMap") || eq(clone(type_name), "HashSet") {
        return true
    }
    if starts_with(clone(type_name), "vec:") || starts_with(clone(type_name), "hashmap:") || starts_with(clone(type_name), "hashset:") {
        return true
    }
    if starts_with(clone(type_name), "Vec<") || starts_with(clone(type_name), "HashMap<") || starts_with(clone(type_name), "HashSet<") {
        return true
    }
    // Result/Option angle-bracket forms are GC enum-open refs (#726 json).
    if starts_with(clone(type_name), "Result<") || starts_with(clone(type_name), "Result_") || starts_with(clone(type_name), "result:") {
        return true
    }
    if starts_with(clone(type_name), "Option<") || starts_with(clone(type_name), "Option_") || starts_with(clone(type_name), "option:") {
        return true
    }
    false
}

fn field_type_is_type_param(type_name: String) -> bool {
    if len(type_name) == 0 {
        return false
    }
    if starts_with(clone(type_name), "?") {
        return field_type_is_type_param(substring(type_name, 1, len(type_name)))
    }
    if len(type_name) == 1 {
        let ch = char_at(type_name, 0)
        if ch >= 65 && ch <= 90 {
            return true
        }
    }
    false
}

fn field_type_is_registered_struct(ctx: LowerCtx, type_name: String) -> bool {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut si = 0
    while si < sc {
        if eq(ctx_struct_storage::ctx_struct_layout_name_at(ctx, si), clone(type_name)) {
            return true
        }
        si = si + 1
    }
    false
}

fn field_type_is_registered_enum(ctx: LowerCtx, type_name: String) -> bool {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut si = 0
    while si < sc {
        if eq(ctx_struct_storage::ctx_struct_layout_name_at(ctx, si), clone(type_name)) {
            if ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si) == 1 {
                let mut off = 0
                let mut li = 0
                while li < si {
                    off = off + ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, li)
                    li = li + 1
                }
                if eq(ctx_struct_storage::ctx_struct_field_name_at_offset(ctx, off), "_tag") {
                    return true
                }
            }
            return false
        }
        si = si + 1
    }
    false
}

fn ctx_struct_field_is_f64(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut offset = 0
    let mut si = 0
    while si < sc {
        let sn = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si)
        if eq(clone(sn), clone(struct_name)) {
            if field_idx < fc {
                let ft = ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, offset + field_idx)
                return eq(clone(ft), "f64")
            }
            return false
        }
        offset = offset + fc
        si = si + 1
    }
    false
}

fn ctx_struct_field_is_i64(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut offset = 0
    let mut si = 0
    while si < sc {
        let sn = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si)
        if eq(clone(sn), clone(struct_name)) {
            if field_idx < fc {
                let ft = ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, offset + field_idx)
                return eq(clone(ft), "i64") || eq(clone(ft), "u64")
            }
            return false
        }
        offset = offset + fc
        si = si + 1
    }
    false
}

fn ctx_struct_field_is_v128(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    let ft = ctx_struct_field_type_name(ctx, clone(struct_name), field_idx)
    eq(clone(ft), "v128") || eq(clone(ft), "V128")
}
