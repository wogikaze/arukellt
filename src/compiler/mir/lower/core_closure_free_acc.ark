use std::prelude::{eq}
fn core_closure_push_unique_cap(mut acc: Vec<String>, name: String) {
    let mut j = len(acc) - 1
    let mut dup = false
    while j >= 0 && !dup {
        if eq(get_unchecked(acc, j).clone(), name.clone()) {
            dup = true
        }
        j = j - 1
    }
    if !dup {
        push(acc, name)
    }
}
