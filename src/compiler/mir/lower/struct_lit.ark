use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_lookup
use mir::lower::ctx_struct_mono
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_gc_enum
use mir::lower::ctx_types
use mir::inst_struct_new
use mir::inst_struct_set
use mir::lower::struct_lit_copy
use mir::value_types
// Resolve the layout name a struct literal should instantiate. For a
// generic base (Pair<T>) the monomorphized name (Pair<String>) comes
// from, in order: an explicit Pair<...> literal spelling, the pending
// let annotation, the functional-update base, or the field value types
// bound to the declared parameters. Non-generic names pass through.
use std::text

fn mir_struct_lit_instance_name(mut ctx: LowerCtx, base_name: String, field_names: Vec<String>, val_idxs: Vec<i32>, base_idx: i32) -> String {
    let canon = ctx_struct_layout::ctx_resolve_struct_layout_name(ctx, base_name.clone())
    if ctx_struct_mono::generic_inst_base_name(canon.clone()).len() > 0 {
        let _ok = ctx_struct_mono::ctx_derive_generic_struct_layout(ctx, canon.clone())
        return canon
    }
    if !ctx_struct_mono::ctx_struct_name_is_generic(ctx, canon.clone()) {
        return canon
    }
    // The let annotation is authoritative when present (Pair<i64> must
    // not degrade to Pair<i32> from an integer literal field). Under an
    // Option<T> annotation the literal is the Some payload, so unwrap the
    // payload type before comparing base names.
    let expected = ctx_struct_mono::ctx_derive_generic_struct_type_name(
        ctx,
        struct_lit_expected_payload_type(ctx.expected_struct_inst.clone())
    )
    if ctx_struct_mono::generic_inst_base_name(expected.clone()).eq(canon.clone()) {
        return expected
    }
    if base_idx >= 0 {
        let base_type = ctx_struct_mono::ctx_derive_generic_struct_type_name(
            ctx,
            ctx_api_local_types::ctx_get_local_type(ctx, base_idx)
        )
        if ctx_struct_mono::generic_inst_base_name(base_type.clone()).eq(canon.clone()) {
            return base_type
        }
    }
    // Bind each declared parameter from the field value's resolved type.
    // Declared field types may embed a parameter inside a container
    // (vec:T, option:T, result:T:E, Inner<T>), not only as a bare T, so the
    // binding unifies the declared shape against the value's resolved type
    // segment by segment.
    let joined = ctx_struct_mono::ctx_generic_struct_params(ctx, canon.clone())
    let params = struct_lit_split_params(joined)
    if params.len() == 0 {
        return canon
    }
    let mut args = Vec::new<String>()
    let mut bound = Vec::new<bool>()
    let mut pi = 0
    while pi < params.len() {
        args.push(String_new())
        bound.push(false)
        pi = pi + 1
    }
    let mut i = 0
    while i < field_names.len() {
        let fi = ctx_struct_lookup::ctx_field_index(ctx, canon.clone(), get_unchecked(field_names, i).clone())
        let ft = ctx_struct_field_type::ctx_struct_field_type_name(ctx, canon.clone(), fi)
        if i < val_idxs.len() && struct_lit_field_type_mentions_params(ft.clone(), params) {
            let mut val_ty = ctx_struct_mono::ctx_derive_generic_struct_type_name(
                ctx,
                ctx_api_local_types::ctx_get_local_type(ctx, get_unchecked(val_idxs, i))
            )
            if val_ty.len() == 0 {
                val_ty = struct_lit_scalar_type_for_vt(
                    ctx_api_local_types::ctx_local_vt(ctx, get_unchecked(val_idxs, i))
                )
            }
            if val_ty.len() == 0 {
                return canon
            }
            if !struct_lit_unify_segments(ft.clone(), val_ty.clone(), params, args, bound) {
                if !struct_lit_fn_field_already_bound(ft.clone(), val_ty.clone(), params, bound) &&
                !struct_lit_enum_field_already_bound(ft.clone(), val_ty.clone(), params, bound) {
                    return canon
                }
            }
        }
        i = i + 1
    }
    let mut all_bound = true
    let mut inst = canon.clone().concat(String_from("<"))
    let mut bi = 0
    while bi < params.len() {
        if !get_unchecked(bound, bi) {
            all_bound = false
        }
        if bi > 0 {
            inst = inst.concat(String_from(","))
        }
        inst = inst.concat(get_unchecked(args, bi).clone())
        bi = bi + 1
    }
    inst = inst.concat(String_from(">"))
    if !all_bound {
        return canon
    }
    if ctx_struct_mono::ctx_derive_generic_struct_layout(ctx, inst.clone()) {
        return inst
    }
    canon
}

// When the expected type is Option<T> (let annotation on a Some(payload)
// initializer), the struct literal instantiates T, not the Option name.
fn struct_lit_expected_payload_type(expected: String) -> String {
    if expected.clone().starts_with(String_from("Option_")) {
        return expected.slice(7, expected.len())
    }
    if expected.clone().starts_with(String_from("option:")) {
        return expected.slice(7, expected.len())
    }
    if expected.clone().starts_with(String_from("Option<")) && expected.clone().ends_with(String_from(">")) {
        return expected.slice(7, expected.len() - 1)
    }
    expected
}

// Scalar literal fields carry no local type name; recover the type argument
// from the value's MIR width so Pair { first: 7, second: 0 } instantiates
// Pair<i32,i32> instead of staying a bare generic base.
fn struct_lit_scalar_type_for_vt(vt: i32) -> String {
    if vt == value_types::VT_I32() {
        return String_from("i32")
    }
    if vt == value_types::VT_I64() {
        return String_from("i64")
    }
    if vt == value_types::VT_F64() {
        return String_from("f64")
    }
    String_new()
}

fn struct_lit_ident_char(ch: i32) -> bool {
    (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

fn struct_lit_param_index(params: Vec<String>, name: String) -> i32 {
    let mut i = 0
    while i < params.len() {
        if get_unchecked(params, i).eq(name.clone()) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// True when a declared field type mentions one of the struct's type
// parameters as a whole identifier token (T in vec:T / Pair<T>, not the T
// inside Token or i32).
fn struct_lit_field_type_mentions_params(ft: String, params: Vec<String>) -> bool {
    let n = ft.len()
    let mut i = 0
    while i < n {
        let ch = ft.clone().byte_at(i)
        if !struct_lit_ident_char(ch) {
            i = i + 1
        } else {
            let start = i
            while i < n && struct_lit_ident_char(ft.clone().byte_at(i)) {
                i = i + 1
            }
            let tok = ft.clone().slice(start, i)
            if struct_lit_param_index(params, tok) >= 0 {
                return true
            }
        }
    }
    false
}

// Normalize the surface spellings a resolved value type can carry into the
// canonical vec:/option:/result: space used by declared field types.
fn struct_lit_canonical_type_spelling(name: String) -> String {
    if name.clone().starts_with(String_from("Vec<")) && name.clone().ends_with(String_from(">")) {
        return String_from("vec:").concat(struct_lit_canonical_type_spelling(name.clone().slice(4, name.len() - 1)))
    }
    if name.clone().starts_with(String_from("Option<")) && name.clone().ends_with(String_from(">")) {
        return String_from("option:").concat(struct_lit_canonical_type_spelling(name.clone().slice(7, name.len() - 1)))
    }
    if name.clone().starts_with(String_from("Option_")) {
        return String_from("option:").concat(struct_lit_canonical_type_spelling(name.clone().slice(7, name.len())))
    }
    if name.clone().starts_with(String_from("Result<")) && name.clone().ends_with(String_from(">")) {
        let inner = name.clone().slice(7, name.len() - 1)
        let parts = ctx_mono_type_params::ctx_split_top_level_type_args(inner)
        if parts.len() == 2 {
            return String_from("result:").concat(
                struct_lit_canonical_type_spelling(get_unchecked(parts, 0).clone()).concat(String_from(":").concat(struct_lit_canonical_type_spelling(get_unchecked(parts, 1).clone())))
            )
        }
        return name
    }
    if name.clone().starts_with(String_from("Result_")) {
        let inner = name.clone().slice(7, name.len())
        let us = inner.clone().index_of(String_from("_"))
        if us > 0 && us + 1 < inner.len() {
            return String_from("result:").concat(
                struct_lit_canonical_type_spelling(inner.clone().slice(0, us)).concat(String_from(":").concat(struct_lit_canonical_type_spelling(inner.clone().slice(us + 1, inner.len()))))
            )
        }
        return String_from("result:").concat(inner)
    }
    name
}

// Split a canonical type spelling on ':' / ';' separators that sit outside
// any <...> / (...) group (vec:Pair<T> -> [vec, Pair<T>]). ';' is the
// fnsig: param/return separator: fnsig:T;U must align segment-wise with
// fnsig:String;i32 so both type variables bind (#860).
fn struct_lit_split_colon_top(name: String) -> Vec<String> {
    let mut result = Vec::new<String>()
    let n = name.len()
    let mut depth = 0
    let mut seg_start = 0
    let mut i = 0
    while i <= n {
        let at_end = i == n
        let ch = if at_end { 58 } else { name.clone().byte_at(i) }
        if !at_end && (ch == 60 || ch == 40) {
            depth = depth + 1
        }
        if !at_end && (ch == 62 || ch == 41) {
            depth = depth - 1
        }
        // `Owner::Assoc` projections stay one segment: the double colon is
        // a name qualifier, not a type-spelling separator (#860/#691).
        if !at_end && ch == 58 && i + 1 < n && name.clone().byte_at(i + 1) == 58 {
            i = i + 2
            continue
        }
        if (at_end || ch == 58 || ch == 59) && depth == 0 {
            result.push(name.clone().slice(seg_start, i))
            seg_start = i + 1
        }
        i = i + 1
    }
    result
}

fn struct_lit_type_is_composite(name: String) -> bool {
    name.clone().contains(String_from("<")) || name.clone().contains(String_from(":"))
}

// Legacy fnref-family value spellings carry no param/return segments.
// Expand them against the declared fnsig: shape so parameter positions
// bind the callback family the value spelling implies (fnref is the
// i32-ABI bucket, fnrefss is String->String, fnrefsb is String->bool)
// while concrete declared segments stay fixed — a declared fn(T)->bool
// expands a fnref value to fnsig:i32;bool, not fnsig:i32;i32.
fn struct_lit_fnref_value_spelling(f: String, v: String, params: Vec<String>) -> String {
    if !f.clone().starts_with(String_from("fnsig:")) {
        return v
    }
    let mut family = Vec::new<String>()
    if v.clone().eq(String_from("fnref")) {
        family.push(String_from("i32"))
        family.push(String_from("i32"))
    } else if v.clone().eq(String_from("fnrefss")) {
        family.push(String_from("String"))
        family.push(String_from("String"))
    } else if v.clone().eq(String_from("fnrefsb")) {
        family.push(String_from("String"))
        family.push(String_from("bool"))
    } else {
        return v
    }
    let f_segs = struct_lit_split_colon_top(f.clone())
    if f_segs.len() != 3 {
        return v
    }
    let mut out = String_from("fnsig:")
    let mut k = 1
    while k < f_segs.len() {
        if k > 1 {
            out = out.concat(String_from(";"))
        }
        let f_seg = get_unchecked(f_segs, k)
        if struct_lit_param_index(params, f_seg.clone()) >= 0 {
            out = out.concat(get_unchecked(family, k - 1).clone())
        } else {
            out = out.concat(f_seg)
        }
        k = k + 1
    }
    out
}

// Align a declared field type with the resolved value type and bind every
// declared-parameter leaf to its concrete counterpart. A bare parameter
// leaf (T) binds the whole value type; composite spellings (vec:T,
// option:T, result:T:E, Inner<T>) recurse segment by segment. Returns
// false when a parameter position lacks a concrete counterpart or the
// shapes cannot align — the caller then keeps the unsubstituted base
// layout instead of guessing an instantiation.
fn struct_lit_unify_segments(ft: String, vt: String, params: Vec<String>, mut args: Vec<String>, mut bound: Vec<bool>) -> bool {
    let direct = struct_lit_param_index(params, ft.clone())
    if direct >= 0 {
        if vt.len() == 0 ||
        ctx_struct_mono::generic_arg_is_unbound(vt.clone()) ||
        struct_lit_field_type_mentions_params(vt.clone(), params) {
            return false
        }
        args.set(direct, vt)
        bound.set(direct, true)
        return true
    }
    let f = struct_lit_canonical_type_spelling(ft)
    let v = struct_lit_fnref_value_spelling(f.clone(), struct_lit_canonical_type_spelling(vt), params)
    let f_segs = struct_lit_split_colon_top(f.clone())
    let v_segs = struct_lit_split_colon_top(v.clone())
    if f_segs.len() > 1 || v_segs.len() > 1 {
        if f_segs.len() != v_segs.len() {
            return !struct_lit_field_type_mentions_params(f, params)
        }
        let mut k = 0
        while k < f_segs.len() {
            let f_seg = get_unchecked(f_segs, k)
            let v_seg = get_unchecked(v_segs, k)
            if struct_lit_param_index(params, f_seg.clone()) >= 0 {
                if !struct_lit_unify_segments(f_seg.clone(), v_seg.clone(), params, args, bound) {
                    return false
                }
            } else if !f_seg.clone().eq(v_seg.clone()) {
                // `X::Assoc` declared leaf: a projection binds no
                // parameter here; the derived layout resolves it through
                // the owner's impl (#860/#691).
                if f_seg.clone().contains(String_from("::")) {
                    // compatible — keep checking the remaining segments
                } else if struct_lit_type_is_composite(f_seg.clone()) {
                    if !struct_lit_unify_segments(f_seg.clone(), v_seg.clone(), params, args, bound) {
                        return false
                    }
                } else {
                    return !struct_lit_field_type_mentions_params(f.clone(), params)
                }
            }
            k = k + 1
        }
        return true
    }
    let f_base = ctx_struct_mono::generic_inst_base_name(f.clone())
    if f_base.len() > 0 && f_base.clone().eq(ctx_struct_mono::generic_inst_base_name(v.clone())) {
        let f_args = ctx_struct_mono::generic_inst_args(f.clone())
        let v_args = ctx_struct_mono::generic_inst_args(v.clone())
        if f_args.len() != v_args.len() {
            return false
        }
        let mut k = 0
        while k < f_args.len() {
            if !struct_lit_unify_segments(
                get_unchecked(f_args, k).clone(),
                get_unchecked(v_args, k).clone(),
                params,
                args,
                bound
            ) {
                return false
            }
            k = k + 1
        }
        return true
    }
    // A bare `X::Assoc` declared type binds no parameter; the derived
    // layout resolves it through the owner's impl (#860/#691).
    if f.clone().contains(String_from("::")) {
        return true
    }
    !struct_lit_field_type_mentions_params(f, params)
}

fn struct_lit_split_params(joined: String) -> Vec<String> {
    let mut params = Vec::new<String>()
    let n = joined.len()
    let mut seg_start = 0
    let mut i = 0
    while i <= n {
        if i == n || joined.clone().byte_at(i) == 44 {
            params.push(joined.clone().slice(seg_start, i))
            seg_start = i + 1
        }
        i = i + 1
    }
    params
}

// Fallback for fn-typed fields whose opaque pair type (fnref / fnref2 /
// fnsig value spellings) cannot align segment-wise with a declared
// fnsig:/fn( field type.  The pair ABI accepts any fn value, so the
// binding only needs the struct's type parameters to already be bound by
// other fields — e.g. ScanBox<T>.f: fnsig:T,T;option:T with vec:vec:i32
// and state:i32 (#881).
fn struct_lit_fn_field_already_bound(ft: String, vt: String, params: Vec<String>, bound: Vec<bool>) -> bool {
    if !struct_lit_decl_is_fn_value(ft.clone()) || !struct_lit_decl_is_fn_value(vt.clone()) {
        return false
    }
    struct_lit_params_bound(ft.clone(), params, bound)
}

// Same fallback for enum-typed fields: variant literals type their local
// as enum:<EnumName> (enum:Option for None/Some), not the field's
// option:/result:/enum: spelling, so segment unify cannot bind.  The
// value is compatible when the enum head matches and every declared
// parameter is already bound by other fields (#881).
fn struct_lit_enum_field_already_bound(ft: String, vt: String, params: Vec<String>, bound: Vec<bool>) -> bool {
    if !struct_lit_enum_head_matches(ft.clone(), vt.clone()) {
        return false
    }
    struct_lit_params_bound(ft.clone(), params, bound)
}

fn struct_lit_enum_head_matches(ft: String, vt: String) -> bool {
    if ft.clone().starts_with(String_from("option:")) {
        return vt.clone().eq(String_from("enum:Option"))
    }
    if ft.clone().starts_with(String_from("result:")) {
        return vt.clone().eq(String_from("enum:Result"))
    }
    if ft.clone().starts_with(String_from("enum:")) {
        let want = ft.clone().slice(5, ft.len())
        return vt.clone().eq(String_from("enum:").concat(want))
    }
    false
}

// Every type-parameter token mentioned in ft must already be bound.
fn struct_lit_params_bound(ft: String, params: Vec<String>, bound: Vec<bool>) -> bool {
    let n = ft.len()
    let mut i = 0
    while i < n {
        let ch = ft.clone().byte_at(i)
        if !struct_lit_ident_char(ch) {
            i = i + 1
        } else {
            let start = i
            while i < n && struct_lit_ident_char(ft.clone().byte_at(i)) {
                i = i + 1
            }
            let tok = ft.clone().slice(start, i)
            let pi = struct_lit_param_index(params.clone(), tok.clone())
            if pi >= 0 && (pi >= bound.len() || !get_unchecked(bound, pi)) {
                return false
            }
        }
    }
    true
}

fn struct_lit_decl_is_fn_value(type_name: String) -> bool {
    type_name.clone().eq(String_from("fn")) ||
    type_name.clone().starts_with(String_from("fnref")) ||
    type_name.clone().starts_with(String_from("fnsig:")) ||
    type_name.clone().starts_with(String_from("fn("))
}

fn mir_emit_struct_new(mut ctx: LowerCtx, struct_name: String) -> i32 {
    let canon = ctx_struct_layout::ctx_resolve_struct_layout_name(ctx, struct_name)
    let dest = ctx_fresh_local(ctx, value_types::VT_GC_REF())
    ctx_emit(ctx, inst_struct_new::MirInst_struct_new_named(dest, canon.clone(), ctx_struct_byte_size(ctx, canon.clone())))
    ctx_set_local_type(ctx, dest, canon.clone())
    dest
}

// fn-typed struct field type names use the same spelling set as the
// aggregate/call paths: "fn", "fnref*", "fn(...)" (#883).
fn mir_struct_field_type_is_fn(type_name: String) -> bool {
    type_name.clone().eq(String_from("fn")) ||
    type_name.clone().starts_with(String_from("fnref")) ||
    type_name.clone().starts_with(String_from("fn("))
}

fn mir_copy_struct_base_fields(mut ctx: LowerCtx, struct_name: String, dest: i32, base_idx: i32) {
    let canon = ctx_struct_layout::ctx_resolve_struct_layout_name(ctx, struct_name)
    struct_lit_copy::mir_copy_struct_base_fields(ctx, canon, dest, base_idx)
}

fn mir_emit_struct_field_set(mut ctx: LowerCtx, struct_name: String, dest: i32, field_name: String, val_idx: i32) {
    let canon = ctx_struct_layout::ctx_resolve_struct_layout_name(ctx, struct_name)
    let fi_idx = ctx_field_index(ctx, canon.clone(), field_name.clone())
    let mut field_vt = value_types::VT_VOID()
    if ctx_struct_field_is_f64(ctx, canon.clone(), fi_idx) {
        field_vt = value_types::VT_F64()
    }
    if field_vt == value_types::VT_VOID() && ctx_struct_field_is_i64(ctx, canon.clone(), fi_idx) {
        field_vt = value_types::VT_I64()
    }
    if field_vt == value_types::VT_VOID() && ctx_struct_field_is_v128(ctx, canon.clone(), fi_idx) {
        field_vt = value_types::VT_V128()
    }
    // i32 / fn-table-index fields must carry VT_I32 so Memory64 emit wraps
    // i64 locals before struct.set (MapIter.f, FilterIter.f, …).
    if field_vt == value_types::VT_VOID() &&
    !ctx_struct_field_is_gc_ref(ctx, canon.clone(), fi_idx) {
        field_vt = value_types::VT_I32()
    }
    // GC-typed struct fields give their concrete type to the initializer temp
    // so Vec::new resolves the field's GC layout instead of vec:i32.
    if ctx_struct_field_is_gc_ref(ctx, canon.clone(), fi_idx) {
        let field_type_name = ctx_struct_field_type_name(ctx, canon.clone(), fi_idx)
        let normalized_type_name = ctx_struct_field_type::normalize_gc_field_type_name(
            field_type_name.clone()
        )
        if normalized_type_name.len() > 0 {
            let semantic_type_name = ctx_struct_layout::ctx_maybe_enum_return_type_name(
                ctx,
                normalized_type_name.clone()
            )
            // A still-generic field type (vec:T on the unbound base layout)
            // must not overwrite the value local's concrete mono type —
            // stamping vec:T onto a Vec<i32> parameter collapses later
            // len()/get_unchecked calls to the Vec<i32> fallback.
            let base_name = ctx_struct_mono::generic_inst_base_name(canon.clone())
            let param_owner = if base_name.len() > 0 { base_name } else { canon.clone() }
            let decl_params = struct_lit_split_params(
                ctx_struct_mono::ctx_generic_struct_params(ctx, param_owner)
            )
            if !struct_lit_field_type_mentions_params(semantic_type_name.clone(), decl_params) {
                ctx_api_local_types::ctx_set_local_type(ctx, val_idx, semantic_type_name)
                if ctx_gc_enum::ctx_is_gc_target(ctx) {
                    ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_GC_REF())
                } else {
                    ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_REF())
                }
            }
        }
    }
    ctx_emit(
        ctx,
        inst_struct_set::MirInst_struct_set_named_idx(
            dest,
            val_idx,
            canon.clone(),
            ctx_struct_field_offset(ctx, canon.clone(), fi_idx),
            fi_idx,
            ctx_struct_byte_size(ctx, canon.clone()),
            field_vt
        )
    )
}

fn mir_emit_struct_get_local(ctx: LowerCtx, dest: i32) -> i32 {
    // Value already lives in `dest`; do not push a duplicate local_get
    // (return_value / local_set_from load it themselves). Fixes #726
    // TomlValStep_ok double local.get before return.
    dest
}
