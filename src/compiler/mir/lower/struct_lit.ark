use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_lookup
use mir::lower::ctx_struct_mono
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_gc_enum
use mir::lower::ctx_types
use mir::inst_struct_new
use mir::inst_struct_set
use mir::lower::struct_lit_copy
use mir::value_types

// Resolve the layout name a struct literal should instantiate. For a
// generic base (Pair<T>) the monomorphized name (Pair<String>) comes
// from, in order: an explicit Pair<...> literal spelling, the pending
// let annotation, the functional-update base, or the field value types
// bound to the declared parameters. Non-generic names pass through.
fn mir_struct_lit_instance_name(ctx: LowerCtx, base_name: String, field_names: Vec<String>, val_idxs: Vec<i32>, base_idx: i32) -> String {
    let canon = ctx_struct_layout::ctx_resolve_struct_layout_name(ctx, clone(base_name))
    if len(ctx_struct_mono::generic_inst_base_name(clone(canon))) > 0 {
        let _ok = ctx_struct_mono::ctx_derive_generic_struct_layout(ctx, clone(canon))
        return canon
    }
    if !ctx_struct_mono::ctx_struct_name_is_generic(ctx, clone(canon)) {
        return canon
    }
    // The let annotation is authoritative when present (Pair<i64> must
    // not degrade to Pair<i32> from an integer literal field). Under an
    // Option<T> annotation the literal is the Some payload, so unwrap the
    // payload type before comparing base names.
    let expected = ctx_struct_mono::ctx_derive_generic_struct_type_name(
        ctx,
        struct_lit_expected_payload_type(clone(ctx.expected_struct_inst))
    )
    if eq(ctx_struct_mono::generic_inst_base_name(clone(expected)), clone(canon)) {
        return expected
    }
    if base_idx >= 0 {
        let base_type = ctx_struct_mono::ctx_derive_generic_struct_type_name(
            ctx,
            ctx_api_local_types::ctx_get_local_type(ctx, base_idx)
        )
        if eq(ctx_struct_mono::generic_inst_base_name(clone(base_type)), clone(canon)) {
            return base_type
        }
    }
    // Bind each declared parameter from the field value's resolved type.
    // Declared field types may embed a parameter inside a container
    // (vec:T, option:T, result:T:E, Inner<T>), not only as a bare T, so the
    // binding unifies the declared shape against the value's resolved type
    // segment by segment.
    let joined = ctx_struct_mono::ctx_generic_struct_params(ctx, clone(canon))
    let params = struct_lit_split_params(joined)
    if len(params) == 0 {
        return canon
    }
    let args = Vec::new<String>()
    let bound = Vec::new<bool>()
    let mut pi = 0
    while pi < len(params) {
        push(args, String_new())
        push(bound, false)
        pi = pi + 1
    }
    let mut i = 0
    while i < len(field_names) {
        let fi = ctx_struct_lookup::ctx_field_index(ctx, clone(canon), clone(get_unchecked(field_names, i)))
        let ft = ctx_struct_field_type::ctx_struct_field_type_name(ctx, clone(canon), fi)
        if i < len(val_idxs) && struct_lit_field_type_mentions_params(clone(ft), params) {
            let mut val_ty = ctx_struct_mono::ctx_derive_generic_struct_type_name(
                ctx,
                ctx_api_local_types::ctx_get_local_type(ctx, get_unchecked(val_idxs, i))
            )
            if len(val_ty) == 0 {
                val_ty = struct_lit_scalar_type_for_vt(
                    ctx_api_local_types::ctx_local_vt(ctx, get_unchecked(val_idxs, i))
                )
            }
            if len(val_ty) == 0 {
                return canon
            }
            if !struct_lit_unify_segments(clone(ft), clone(val_ty), params, args, bound) {
                return canon
            }
        }
        i = i + 1
    }
    let mut all_bound = true
    let mut inst = concat(clone(canon), String_from("<"))
    let mut bi = 0
    while bi < len(params) {
        if !get_unchecked(bound, bi) {
            all_bound = false
        }
        if bi > 0 {
            inst = concat(inst, String_from(","))
        }
        inst = concat(inst, clone(get_unchecked(args, bi)))
        bi = bi + 1
    }
    inst = concat(inst, String_from(">"))
    if !all_bound {
        return canon
    }
    if ctx_struct_mono::ctx_derive_generic_struct_layout(ctx, clone(inst)) {
        return inst
    }
    canon
}

// When the expected type is Option<T> (let annotation on a Some(payload)
// initializer), the struct literal instantiates T, not the Option name.
fn struct_lit_expected_payload_type(expected: String) -> String {
    if starts_with(clone(expected), String_from("Option_")) {
        return substring(expected, 7, len(expected))
    }
    if starts_with(clone(expected), String_from("option:")) {
        return substring(expected, 7, len(expected))
    }
    if starts_with(clone(expected), String_from("Option<")) && ends_with(clone(expected), String_from(">")) {
        return substring(expected, 7, len(expected) - 1)
    }
    expected
}

// Scalar literal fields carry no local type name; recover the type argument
// from the value's MIR width so Pair { first: 7, second: 0 } instantiates
// Pair<i32,i32> instead of staying a bare generic base.
fn struct_lit_scalar_type_for_vt(vt: i32) -> String {
    if vt == value_types::VT_I32() {
        return String_from("i32")
    }
    if vt == value_types::VT_I64() {
        return String_from("i64")
    }
    if vt == value_types::VT_F64() {
        return String_from("f64")
    }
    String_new()
}

fn struct_lit_ident_char(ch: i32) -> bool {
    (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

fn struct_lit_param_index(params: Vec<String>, name: String) -> i32 {
    let mut i = 0
    while i < len(params) {
        if eq(get_unchecked(params, i), clone(name)) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// True when a declared field type mentions one of the struct's type
// parameters as a whole identifier token (T in vec:T / Pair<T>, not the T
// inside Token or i32).
fn struct_lit_field_type_mentions_params(ft: String, params: Vec<String>) -> bool {
    let n = len(ft)
    let mut i = 0
    while i < n {
        let ch = byte_at(clone(ft), i)
        if !struct_lit_ident_char(ch) {
            i = i + 1
        } else {
            let start = i
            while i < n && struct_lit_ident_char(byte_at(clone(ft), i)) {
                i = i + 1
            }
            let tok = substring(clone(ft), start, i)
            if struct_lit_param_index(params, tok) >= 0 {
                return true
            }
        }
    }
    false
}

// Normalize the surface spellings a resolved value type can carry into the
// canonical vec:/option:/result: space used by declared field types.
fn struct_lit_canonical_type_spelling(name: String) -> String {
    if starts_with(clone(name), String_from("Vec<")) && ends_with(clone(name), String_from(">")) {
        return concat(
            String_from("vec:"),
            struct_lit_canonical_type_spelling(substring(clone(name), 4, len(name) - 1))
        )
    }
    if starts_with(clone(name), String_from("Option<")) && ends_with(clone(name), String_from(">")) {
        return concat(
            String_from("option:"),
            struct_lit_canonical_type_spelling(substring(clone(name), 7, len(name) - 1))
        )
    }
    if starts_with(clone(name), String_from("Option_")) {
        return concat(
            String_from("option:"),
            struct_lit_canonical_type_spelling(substring(clone(name), 7, len(name)))
        )
    }
    if starts_with(clone(name), String_from("Result<")) && ends_with(clone(name), String_from(">")) {
        let inner = substring(clone(name), 7, len(name) - 1)
        let parts = ctx_mono_type_params::ctx_split_top_level_type_args(inner)
        if len(parts) == 2 {
            return concat(
                String_from("result:"),
                concat(
                    struct_lit_canonical_type_spelling(clone(get_unchecked(parts, 0))),
                    concat(
                        String_from(":"),
                        struct_lit_canonical_type_spelling(clone(get_unchecked(parts, 1)))
                    )
                )
            )
        }
        return name
    }
    if starts_with(clone(name), String_from("Result_")) {
        let inner = substring(clone(name), 7, len(name))
        let us = index_of(clone(inner), String_from("_"))
        if us > 0 && us + 1 < len(inner) {
            return concat(
                String_from("result:"),
                concat(
                    struct_lit_canonical_type_spelling(substring(clone(inner), 0, us)),
                    concat(
                        String_from(":"),
                        struct_lit_canonical_type_spelling(substring(clone(inner), us + 1, len(inner)))
                    )
                )
            )
        }
        return concat(String_from("result:"), inner)
    }
    name
}

// Split a canonical type spelling on ':' / ';' separators that sit outside
// any <...> / (...) group (vec:Pair<T> -> [vec, Pair<T>]). ';' is the
// fnsig: param/return separator: fnsig:T;U must align segment-wise with
// fnsig:String;i32 so both type variables bind (#860).
fn struct_lit_split_colon_top(name: String) -> Vec<String> {
    let result = Vec::new<String>()
    let n = len(name)
    let mut depth = 0
    let mut seg_start = 0
    let mut i = 0
    while i <= n {
        let at_end = i == n
        let ch = if at_end { 58 } else { byte_at(clone(name), i) }
        if !at_end && (ch == 60 || ch == 40) {
            depth = depth + 1
        }
        if !at_end && (ch == 62 || ch == 41) {
            depth = depth - 1
        }
        if (at_end || ch == 58 || ch == 59) && depth == 0 {
            push(result, substring(clone(name), seg_start, i))
            seg_start = i + 1
        }
        i = i + 1
    }
    result
}

fn struct_lit_type_is_composite(name: String) -> bool {
    contains(clone(name), String_from("<")) || contains(clone(name), String_from(":"))
}

// Legacy fnref-family value spellings carry no param/return segments.
// Expand them against the declared fnsig: shape so parameter positions
// bind the callback family the value spelling implies (fnref is the
// i32-ABI bucket, fnrefss is String->String, fnrefsb is String->bool)
// while concrete declared segments stay fixed — a declared fn(T)->bool
// expands a fnref value to fnsig:i32;bool, not fnsig:i32;i32.
fn struct_lit_fnref_value_spelling(f: String, v: String, params: Vec<String>) -> String {
    if !starts_with(clone(f), String_from("fnsig:")) {
        return v
    }
    let family = Vec::new<String>()
    if eq(clone(v), String_from("fnref")) {
        push(family, String_from("i32"))
        push(family, String_from("i32"))
    } else if eq(clone(v), String_from("fnrefss")) {
        push(family, String_from("String"))
        push(family, String_from("String"))
    } else if eq(clone(v), String_from("fnrefsb")) {
        push(family, String_from("String"))
        push(family, String_from("bool"))
    } else {
        return v
    }
    let f_segs = struct_lit_split_colon_top(clone(f))
    if len(f_segs) != 3 {
        return v
    }
    let mut out = String_from("fnsig:")
    let mut k = 1
    while k < len(f_segs) {
        if k > 1 {
            out = concat(out, String_from(";"))
        }
        let f_seg = get_unchecked(f_segs, k)
        if struct_lit_param_index(params, clone(f_seg)) >= 0 {
            out = concat(out, clone(get_unchecked(family, k - 1)))
        } else {
            out = concat(out, f_seg)
        }
        k = k + 1
    }
    out
}

// Align a declared field type with the resolved value type and bind every
// declared-parameter leaf to its concrete counterpart. A bare parameter
// leaf (T) binds the whole value type; composite spellings (vec:T,
// option:T, result:T:E, Inner<T>) recurse segment by segment. Returns
// false when a parameter position lacks a concrete counterpart or the
// shapes cannot align — the caller then keeps the unsubstituted base
// layout instead of guessing an instantiation.
fn struct_lit_unify_segments(ft: String, vt: String, params: Vec<String>, args: Vec<String>, bound: Vec<bool>) -> bool {
    let direct = struct_lit_param_index(params, clone(ft))
    if direct >= 0 {
        if len(vt) == 0 ||
        ctx_struct_mono::generic_arg_is_unbound(clone(vt)) ||
        struct_lit_field_type_mentions_params(clone(vt), params) {
            return false
        }
        set(args, direct, vt)
        set(bound, direct, true)
        return true
    }
    let f = struct_lit_canonical_type_spelling(ft)
    let v = struct_lit_fnref_value_spelling(clone(f), struct_lit_canonical_type_spelling(vt), params)
    let f_segs = struct_lit_split_colon_top(clone(f))
    let v_segs = struct_lit_split_colon_top(clone(v))
    if len(f_segs) > 1 || len(v_segs) > 1 {
        if len(f_segs) != len(v_segs) {
            return !struct_lit_field_type_mentions_params(f, params)
        }
        let mut k = 0
        while k < len(f_segs) {
            let f_seg = get_unchecked(f_segs, k)
            let v_seg = get_unchecked(v_segs, k)
            if struct_lit_param_index(params, clone(f_seg)) >= 0 {
                if !struct_lit_unify_segments(clone(f_seg), clone(v_seg), params, args, bound) {
                    return false
                }
            } else if !eq(clone(f_seg), clone(v_seg)) {
                if struct_lit_type_is_composite(clone(f_seg)) {
                    if !struct_lit_unify_segments(clone(f_seg), clone(v_seg), params, args, bound) {
                        return false
                    }
                } else {
                    return !struct_lit_field_type_mentions_params(clone(f), params)
                }
            }
            k = k + 1
        }
        return true
    }
    let f_base = ctx_struct_mono::generic_inst_base_name(clone(f))
    if len(f_base) > 0 && eq(clone(f_base), ctx_struct_mono::generic_inst_base_name(clone(v))) {
        let f_args = ctx_struct_mono::generic_inst_args(clone(f))
        let v_args = ctx_struct_mono::generic_inst_args(clone(v))
        if len(f_args) != len(v_args) {
            return false
        }
        let mut k = 0
        while k < len(f_args) {
            if !struct_lit_unify_segments(
                clone(get_unchecked(f_args, k)),
                clone(get_unchecked(v_args, k)),
                params,
                args,
                bound
            ) {
                return false
            }
            k = k + 1
        }
        return true
    }
    !struct_lit_field_type_mentions_params(f, params)
}

fn struct_lit_split_params(joined: String) -> Vec<String> {
    let params = Vec::new<String>()
    let n = len(joined)
    let mut seg_start = 0
    let mut i = 0
    while i <= n {
        if i == n || byte_at(clone(joined), i) == 44 {
            push(params, substring(clone(joined), seg_start, i))
            seg_start = i + 1
        }
        i = i + 1
    }
    params
}

fn mir_emit_struct_new(ctx: LowerCtx, struct_name: String) -> i32 {
    let canon = ctx_struct_layout::ctx_resolve_struct_layout_name(ctx, struct_name)
    let dest = ctx_fresh_local(ctx, value_types::VT_GC_REF())
    ctx_emit(ctx, inst_struct_new::MirInst_struct_new_named(dest, clone(canon), ctx_struct_byte_size(ctx, clone(canon))))
    ctx_set_local_type(ctx, dest, clone(canon))
    dest
}

fn mir_copy_struct_base_fields(ctx: LowerCtx, struct_name: String, dest: i32, base_idx: i32) {
    let canon = ctx_struct_layout::ctx_resolve_struct_layout_name(ctx, struct_name)
    struct_lit_copy::mir_copy_struct_base_fields(ctx, canon, dest, base_idx)
}

fn mir_emit_struct_field_set(ctx: LowerCtx, struct_name: String, dest: i32, field_name: String, val_idx: i32) {
    let canon = ctx_struct_layout::ctx_resolve_struct_layout_name(ctx, struct_name)
    let fi_idx = ctx_field_index(ctx, clone(canon), clone(field_name))
    let mut field_vt = value_types::VT_VOID()
    if ctx_struct_field_is_f64(ctx, clone(canon), fi_idx) {
        field_vt = value_types::VT_F64()
    }
    if field_vt == value_types::VT_VOID() && ctx_struct_field_is_i64(ctx, clone(canon), fi_idx) {
        field_vt = value_types::VT_I64()
    }
    if field_vt == value_types::VT_VOID() && ctx_struct_field_is_v128(ctx, clone(canon), fi_idx) {
        field_vt = value_types::VT_V128()
    }
    // i32 / fn-table-index fields must carry VT_I32 so Memory64 emit wraps
    // i64 locals before struct.set (MapIter.f, FilterIter.f, …).
    if field_vt == value_types::VT_VOID() &&
    !ctx_struct_field_is_gc_ref(ctx, clone(canon), fi_idx) {
        field_vt = value_types::VT_I32()
    }
    // GC-typed struct fields give their concrete type to the initializer temp
    // so Vec::new resolves the field's GC layout instead of vec:i32.
    if ctx_struct_field_is_gc_ref(ctx, clone(canon), fi_idx) {
        let field_type_name = ctx_struct_field_type_name(ctx, clone(canon), fi_idx)
        let normalized_type_name = ctx_struct_field_type::normalize_gc_field_type_name(
            clone(field_type_name)
        )
        if len(normalized_type_name) > 0 {
            let semantic_type_name = ctx_struct_layout::ctx_maybe_enum_return_type_name(
                ctx,
                clone(normalized_type_name)
            )
            // A still-generic field type (vec:T on the unbound base layout)
            // must not overwrite the value local's concrete mono type —
            // stamping vec:T onto a Vec<i32> parameter collapses later
            // len()/get_unchecked calls to the Vec<i32> fallback.
            let base_name = ctx_struct_mono::generic_inst_base_name(clone(canon))
            let param_owner = if len(base_name) > 0 { base_name } else { clone(canon) }
            let decl_params = struct_lit_split_params(
                ctx_struct_mono::ctx_generic_struct_params(ctx, param_owner)
            )
            if !struct_lit_field_type_mentions_params(clone(semantic_type_name), decl_params) {
                ctx_api_local_types::ctx_set_local_type(ctx, val_idx, semantic_type_name)
                if ctx_gc_enum::ctx_is_gc_target(ctx) {
                    ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_GC_REF())
                } else {
                    ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_REF())
                }
            }
        }
    }
    ctx_emit(
        ctx,
        inst_struct_set::MirInst_struct_set_named_idx(
            dest,
            val_idx,
            clone(canon),
            ctx_struct_field_offset(ctx, clone(canon), fi_idx),
            fi_idx,
            ctx_struct_byte_size(ctx, clone(canon)),
            field_vt
        )
    )
}

fn mir_emit_struct_get_local(ctx: LowerCtx, dest: i32) -> i32 {
    // Value already lives in `dest`; do not push a duplicate local_get
    // (return_value / local_set_from load it themselves). Fixes #726
    // TomlValStep_ok double local.get before return.
    dest
}
