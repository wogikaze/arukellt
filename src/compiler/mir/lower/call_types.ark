use mir::lower::call_type_fallback
use mir::lower::call_type_hash
use mir::lower::call_type_vec
use mir::inst_accessors_operands
use mir::lower::ctx_gc_enum
use mir::lower::ctx_api_local_types
use mir::lower::ctx_types
use mir::value_types

fn mir_mark_call_result_type(ctx: LowerCtx, callee_name: String, dest: i32, first_arg_idx: i32) {
    call_type_vec::mark_vec_call_result_type(ctx, clone(callee_name), dest, first_arg_idx)
    call_type_hash::mark_hash_call_result_type(ctx, clone(callee_name), dest)
    // clone(T) -> T (identity). Never force "string" or prelude String return;
    // that makes GC struct temps validate as String while holding a user struct.
    if is_clone_result_callee(clone(callee_name)) {
        mark_clone_call_result_type(ctx, clone(callee_name), dest, first_arg_idx)
        return
    }
    mark_string_call_result_type(ctx, clone(callee_name), dest)
    call_type_fallback::mark_fallback_call_result_type(ctx, callee_name, dest)
}

fn is_clone_result_callee(callee_name: String) -> bool {
    eq(clone(callee_name), "clone") ||
    eq(clone(callee_name), "__intrinsic_clone") ||
    eq(clone(callee_name), "__intrinsic_string_clone") ||
    eq(clone(callee_name), "__core_string_clone_impl") ||
    eq(clone(callee_name), "raw_string_clone") ||
    ends_with(clone(callee_name), "::clone") ||
    ends_with(clone(callee_name), "__clone") ||
    ends_with(clone(callee_name), "::raw_string_clone") ||
    ends_with(clone(callee_name), "string_clone")
}

fn mark_clone_call_result_type(ctx: LowerCtx, callee_name: String, dest: i32, first_arg_idx: i32) -> bool {
    if dest < 0 || first_arg_idx < 0 || !is_clone_result_callee(clone(callee_name)) {
        return false
    }
    let arg_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
    if len(arg_type) == 0 {
        return false
    }
    ctx_api_local_types::ctx_set_local_type(ctx, dest, clone(arg_type))
    let arg_vt = ctx_api_local_types::ctx_local_vt(ctx, first_arg_idx)
    if arg_vt != value_types::VT_I32() {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, arg_vt)
    } else if ctx_gc_enum::ctx_is_gc_target(ctx) {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_GC_REF())
    } else {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_REF())
    }
    true
}

fn mark_string_call_result_type(ctx: LowerCtx, callee_name: String, dest: i32) {
    if mir_callee_returns_string(clone(callee_name)) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "string")
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_GC_REF())
        } else {
            ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_REF())
        }
    }
}

fn mir_callee_returns_string(callee_name: String) -> bool {
    if eq(clone(callee_name), "String_from") ||
    eq(clone(callee_name), "concat") ||
    eq(clone(callee_name), "__intrinsic_concat") ||
    eq(clone(callee_name), "text::concat") ||
    eq(clone(callee_name), "text::builder_append") ||
    eq(clone(callee_name), "to_string") ||
    eq(clone(callee_name), "i32_to_string") ||
    eq(clone(callee_name), "i64_to_string") ||
    eq(clone(callee_name), "text::format_i32") ||
    eq(clone(callee_name), "convert::i32_to_string") ||
    eq(clone(callee_name), "to_upper") ||
    eq(clone(callee_name), "to_lower") ||
    eq(clone(callee_name), "to_uppercase") ||
    eq(clone(callee_name), "to_lowercase") ||
    eq(clone(callee_name), "char_to_string") ||
    eq(clone(callee_name), "bool_to_string") ||
    eq(clone(callee_name), "f32_to_string") ||
    eq(clone(callee_name), "f64_to_string") ||
    eq(clone(callee_name), "slice") ||
    eq(clone(callee_name), "substring") ||
    eq(clone(callee_name), "__intrinsic_string_slice") ||
    eq(clone(callee_name), "trim") ||
    eq(clone(callee_name), "replace") ||
    eq(clone(callee_name), "string::repeat") ||
    eq(clone(callee_name), "stdio::read_stdin") ||
    eq(clone(callee_name), "__intrinsic_stdin_read_to_string") ||
    eq(clone(callee_name), "__intrinsic_i32_to_string") ||
    eq(clone(callee_name), "__intrinsic_i64_to_string") ||
    eq(clone(callee_name), "__intrinsic_f64_to_string") ||
    eq(clone(callee_name), "__intrinsic_bool_to_string") ||
    eq(clone(callee_name), "__intrinsic_char_to_string") ||
    eq(clone(callee_name), "join") ||
    eq(clone(callee_name), "text::join") ||
    eq(clone(callee_name), "__intrinsic_join") ||
    eq(clone(callee_name), "string_from_bytes") ||
    eq(clone(callee_name), "__intrinsic_string_from_bytes") ||
    eq(clone(callee_name), "bytes::string_from_bytes") {
        return true
    }
    ends_with(clone(callee_name), "::to_string")
}
