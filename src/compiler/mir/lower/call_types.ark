use mir::lower::call_type_fallback
use mir::lower::call_type_hash
use mir::lower::call_rewrite_hashset
use mir::lower::call_type_vec
use mir::inst_accessors_operands
use mir::lower::ctx_gc_enum
use mir::lower::ctx_api_local_types
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_types
use mir::lower::core_call_arg_names
use mir::lower::gc_layout_plan_build
use mir::value_types
fn mir_mark_call_result_type(mut ctx: LowerCtx, callee_name: String, dest: i32, first_arg_idx: i32) {
    call_rewrite_hashset::mark_hashset_result_type(ctx, callee_name.clone(), dest)
    call_type_vec::mark_vec_call_result_type(ctx, callee_name.clone(), dest, first_arg_idx)
    call_type_hash::mark_hash_call_result_type(ctx, callee_name.clone(), dest)
    // clone(T) -> T (identity). Never force "string" or prelude String return;
    // that makes GC struct temps validate as String while holding a user struct.
    if is_clone_result_callee(callee_name.clone()) {
        mark_clone_call_result_type(ctx, callee_name.clone(), dest, first_arg_idx)
        return
    }
    mark_string_call_result_type(ctx, callee_name.clone(), dest)
    call_type_fallback::mark_fallback_call_result_type(ctx, callee_name, dest)
}

fn is_clone_result_callee(callee_name: String) -> bool {
    callee_name.clone().eq("clone") ||
    callee_name.clone().eq("__intrinsic_clone") ||
    callee_name.clone().eq("__intrinsic_string_clone") ||
    callee_name.clone().eq("__core_string_clone_impl") ||
    callee_name.clone().eq("raw_string_clone") ||
    callee_name.clone().ends_with("::clone") ||
    callee_name.clone().ends_with("__clone") ||
    callee_name.clone().ends_with("::raw_string_clone") ||
    callee_name.clone().ends_with("string_clone")
}

fn mark_clone_call_result_type(mut ctx: LowerCtx, callee_name: String, dest: i32, first_arg_idx: i32) -> bool {
    if dest < 0 || first_arg_idx < 0 || !is_clone_result_callee(callee_name.clone()) {
        return false
    }
    let arg_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
    if len(arg_type) == 0 {
        // Identity clone with an unnamed arg: keep the arg's storage class
        // so the dest never adopts the callee's declared return layout.
        ctx_api_local_types::ctx_set_local_vt(
            ctx,
            dest,
            ctx_api_local_types::ctx_local_vt(ctx, first_arg_idx)
        )
        return true
    }
    let arg_vt = ctx_api_local_types::ctx_local_vt(ctx, first_arg_idx)
    // Generic receivers can keep a ?T spelling inside mono bodies; resolve
    // through the substitution map before layout checks (#691).
    let resolved_type = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, arg_type.clone())
    ctx_api_local_types::ctx_set_local_type(ctx, dest, resolved_type.clone())
    if arg_vt != value_types::VT_I32() {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, arg_vt)
    } else if ctx_gc_enum::ctx_is_gc_target(ctx) {
        // A GC string arg already carries VT_GC_REF, so a VT_I32 arg here is
        // a real scalar (e.g. clone(mapped) with mapped: i32). Keeping the
        // scalar vt lets the local declare i64; forcing GC_REF made the
        // producer scan adopt the callee's String return (#691).
        if gc_layout_plan_build::gc_layout_plan_name_is_i32(resolved_type.clone()) {
            ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_I32())
        } else {
            ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_GC_REF())
        }
    } else {
        ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_REF())
    }
    true
}

fn mark_string_call_result_type(mut ctx: LowerCtx, callee_name: String, dest: i32) {
    if mir_callee_returns_string(ctx, callee_name.clone()) {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "string")
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_GC_REF())
        } else {
            ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_REF())
        }
    }
}

fn mir_callee_returns_string(ctx: LowerCtx, callee_name: String) -> bool {
    if core_call_arg_names::mir_core_call_callee_returns_string(ctx, callee_name.clone()) {
        return true
    }
    if callee_name.clone().eq("String_from") ||
    callee_name.clone().eq("concat") ||
    callee_name.clone().eq("String::concat") ||
    callee_name.clone().eq("std::text::String::concat") ||
    callee_name.clone().eq("__intrinsic_concat") ||
    callee_name.clone().eq("text::concat") ||
    callee_name.clone().eq("text::builder_append") ||
    callee_name.clone().eq("to_string") ||
    callee_name.clone().eq("i32_to_string") ||
    callee_name.clone().eq("i64_to_string") ||
    callee_name.clone().eq("text::format_i32") ||
    callee_name.clone().eq("convert::i32_to_string") ||
    callee_name.clone().eq("to_upper") ||
    callee_name.clone().eq("to_lower") ||
    callee_name.clone().eq("to_uppercase") ||
    callee_name.clone().eq("to_lowercase") ||
    callee_name.clone().eq("char_to_string") ||
    callee_name.clone().eq("bool_to_string") ||
    callee_name.clone().eq("f32_to_string") ||
    callee_name.clone().eq("f64_to_string") ||
    callee_name.clone().eq("slice") ||
    callee_name.clone().eq("substring") ||
    callee_name.clone().eq("__intrinsic_string_slice") ||
    callee_name.clone().eq("trim") ||
    callee_name.clone().eq("replace") ||
    callee_name.clone().eq("string::repeat") ||
    callee_name.clone().eq("stdio::read_stdin") ||
    callee_name.clone().eq("__intrinsic_stdin_read_to_string") ||
    callee_name.clone().eq("__intrinsic_i32_to_string") ||
    callee_name.clone().eq("__intrinsic_i64_to_string") ||
    callee_name.clone().eq("__intrinsic_f64_to_string") ||
    callee_name.clone().eq("__intrinsic_bool_to_string") ||
    callee_name.clone().eq("__intrinsic_char_to_string") ||
    callee_name.clone().eq("join") ||
    callee_name.clone().eq("text::join") ||
    callee_name.clone().eq("__intrinsic_join") ||
    callee_name.clone().eq("string_from_bytes") ||
    callee_name.clone().eq("__intrinsic_string_from_bytes") ||
    callee_name.clone().eq("bytes::string_from_bytes") {
        return true
    }
    callee_name.clone().ends_with("::to_string")
}
