use mir::lower::ctx_types

// Nested ensure registers parents before children, so gcsref fields can point at
// higher slots. Wasm type indices forbid those forward refs outside a rec group.
// Reorder deps-first and rewrite gcsref slot numbers before flush.

use std::text
fn ctx_reorder_gc_structs_deps_first(mut ctx: LowerCtx) {
    let count = ctx.gc_struct_names.len()
    if count <= 1 {
        return
    }
    let order = gc_struct_deps_first_order(ctx.gc_struct_sigs)
    let mut remap = Vec::new<i32>()
    let mut ri = 0
    while ri < count {
        remap.push(0)
        ri = ri + 1
    }
    let mut new_i = 0
    while new_i < count {
        let old_i = order.get_unchecked(new_i)
        remap.set(old_i, new_i)
        new_i = new_i + 1
    }
    let mut new_names = Vec::new<String>()
    let mut new_sigs = Vec::new<String>()
    new_i = 0
    while new_i < count {
        let old_i = order.get_unchecked(new_i)
        new_names.push(ctx.gc_struct_names.get_unchecked(old_i).clone())
        new_sigs.push(gc_struct_rewrite_gcsref_slots(ctx.gc_struct_sigs.get_unchecked(old_i).clone(), remap))
        new_i = new_i + 1
    }
    ctx.gc_struct_names = new_names
    ctx.gc_struct_sigs = new_sigs
    let enum_count = ctx.gc_enum_variant_sigs.len()
    let mut ei = 0
    while ei < enum_count {
        let rewritten = gc_struct_rewrite_gcsref_slots(ctx.gc_enum_variant_sigs.get_unchecked(ei).clone(), remap)
        ctx.gc_enum_variant_sigs.set(ei, rewritten)
        ei = ei + 1
    }
}

fn gc_struct_deps_first_order(sigs: Vec<String>) -> Vec<i32> {
    let count = sigs.len()
    let mut placed = Vec::new<i32>()
    let mut pi = 0
    while pi < count {
        placed.push(0)
        pi = pi + 1
    }
    let mut order = Vec::new<i32>()
    while order.len() < count {
        let mut progress = false
        let mut i = 0
        while i < count {
            if placed.get_unchecked(i) == 0 {
                if gc_struct_sig_deps_placed(sigs.get_unchecked(i).clone(), placed, i) {
                    order.push(i)
                    placed.set(i, 1)
                    progress = true
                }
            }
            i = i + 1
        }
        if !progress {
            let mut rest = 0
            while rest < count {
                if placed.get_unchecked(rest) == 0 {
                    order.push(rest)
                    placed.set(rest, 1)
                }
                rest = rest + 1
            }
        }
    }
    order
}

fn gc_struct_sig_deps_placed(sig: String, placed: Vec<i32>, self_slot: i32) -> bool {
    let n = sig.len()
    let mut i = 0
    while i + 6 <= n {
        if gc_struct_at_gcsref_marker(sig.clone(), i) {
            let parsed = gc_struct_parse_gcsref_slot(sig.clone(), i + 6)
            let slot = parsed.get_unchecked(0)
            let end = parsed.get_unchecked(1)
            if end > i + 6 {
                if slot != self_slot && slot >= 0 && slot < placed.len() {
                    if placed.get_unchecked(slot) == 0 {
                        return false
                    }
                }
                i = end
                continue
            }
        }
        i = i + 1
    }
    true
}

fn gc_struct_rewrite_gcsref_slots(sig: String, remap: Vec<i32>) -> String {
    let n = sig.len()
    let mut out = String_new()
    let mut i = 0
    while i < n {
        if i + 6 <= n && gc_struct_at_gcsref_marker(sig.clone(), i) {
            let parsed = gc_struct_parse_gcsref_slot(sig.clone(), i + 6)
            let slot = parsed.get_unchecked(0)
            let end = parsed.get_unchecked(1)
            if end > i + 6 && slot >= 0 && slot < remap.len() {
                out = out.concat("gcsref".concat((remap.get_unchecked(slot)).to_string()))
                i = end
                continue
            }
        }
        out = out.concat(sig.clone().slice(i, i + 1))
        i = i + 1
    }
    out
}

fn gc_struct_at_gcsref_marker(sig: String, i: i32) -> bool {
    if i + 6 > sig.len() {
        return false
    }
    sig.clone().slice(i, i + 6).eq("gcsref")
}

// Returns [slot, end_index] after parsing digits at `start`.
fn gc_struct_parse_gcsref_slot(sig: String, start: i32) -> Vec<i32> {
    let n = sig.len()
    let mut j = start
    let mut slot = 0
    let mut has_digit = false
    while j < n {
        let c = sig.clone().byte_at(j)
        if c >= 48 && c <= 57 {
            slot = slot * 10 + (c - 48)
            has_digit = true
            j = j + 1
        } else {
            break
        }
    }
    let mut out = Vec::new<i32>()
    if has_digit {
        out.push(slot)
        out.push(j)
    } else {
        out.push(0 - 1)
        out.push(start)
    }
    out
}
