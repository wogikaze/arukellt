use mir::lower::ast_node
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_emit
use mir::lower::ctx_types
use mir::lower::ctx_struct_layout
use mir::lower_kinds
use mir::inst_local_get
use mir::inst_local_set
use mir::inst_struct_get
use mir::value_types

fn lower_tuple_destructure_let(ctx: LowerCtx, node: AstNode) {
    let child_count = ast_node::node_child_count(node)
    if child_count < 2 {
        return
    }
    let pat = ast_node::node_child_at(node, 0)
    let init = ast_node::node_child_at(node, 1)
    let tuple_local = lower_expr(ctx, init)
    if tuple_local < 0 {
        return
    }
    let pat_kind = ast_node::node_kind(pat)
    if pat_kind != lower_kinds::NK_PAT_TUPLE() {
        return
    }
    let elem_count = ast_node::node_child_count(pat)
    let total_bytes = elem_count * 4
    let tuple_type = ctx_api_local_types::ctx_get_local_type(ctx, tuple_local)
    let struct_name = tuple_struct_name_from_type(tuple_type)
    let mut byte_off = 0
    let mut ei = 0
    while ei < elem_count {
        let elem = ast_node::node_child_at(pat, ei)
        if ast_node::node_kind_is(elem, lower_kinds::NK_PAT_IDENT()) {
            let bind_name = ast_node::node_text(elem)
            let field_vt = tuple_field_vt_from_struct_name(struct_name, ei)
            let dest = ctx_api_local_alloc::ctx_alloc_local(ctx, clone(bind_name), field_vt)
            let field_type_name = tuple_field_type_name(struct_name, ei)
            if len(field_type_name) > 0 {
                ctx_api_local_types::ctx_set_local_type(
                    ctx,
                    dest,
                    ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, field_type_name)
                )
            }
            ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(tuple_local))
            if len(struct_name) > 0 {
                ctx_api_emit::ctx_emit(ctx, inst_struct_get::MirInst_struct_get_field_idx(tuple_local, clone(struct_name), byte_off, ei, total_bytes, field_vt, dest))
            } else {
                ctx_api_emit::ctx_emit(ctx, inst_struct_get::MirInst_struct_get_field_sized(tuple_local, String_new(), byte_off, total_bytes, field_vt, dest))
            }
            // Store policy may leave STRUCT_GET on the stack when the next
            // op is LOCAL_GET (next field base). Consume into dest explicitly
            // so bindings are not left at 0 (#807 variables/tuple).
            ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set(dest))
        }
        byte_off = byte_off + 4
        ei = ei + 1
    }
}

fn tuple_struct_name_from_type(type_name: String) -> String {
    if starts_with(clone(type_name), "tuple:") {
        return type_name
    }
    if !starts_with(clone(type_name), "struct:") {
        return String_new()
    }
    let n = len(type_name)
    let mut first = 0 - 1
    let mut last = 0 - 1
    let mut i = 0
    while i < n {
        if char_at(type_name, i) == 58 {
            if first < 0 {
                first = i
            }
            last = i
        }
        i = i + 1
    }
    if first < 0 || last <= first {
        return String_new()
    }
    let inner = substring(type_name, first + 1, last)
    if starts_with(clone(inner), "tuple:") {
        return inner
    }
    if eq(clone(inner), "tuple") {
        let byte_size = substring(type_name, last + 1, n)
        return tuple_struct_name_from_byte_size(byte_size)
    }
    String_new()
}

fn tuple_struct_name_from_byte_size(byte_size_str: String) -> String {
    let byte_size = parse_i32_from_string(byte_size_str)
    if byte_size <= 0 {
        return String_new()
    }
    let field_count = byte_size / 4
    if field_count <= 0 {
        return String_new()
    }
    let mut name = "tuple:"
    let mut i = 0
    while i < field_count {
        if i > 0 {
            name = concat(name, ",")
        }
        name = concat(name, "i32")
        i = i + 1
    }
    name
}

fn parse_i32_from_string(s: String) -> i32 {
    let n = len(s)
    let mut value = 0
    let mut i = 0
    while i < n {
        let d = char_at(s, i)
        if d >= 48 && d <= 57 {
            value = value * 10 + (d - 48)
        } else {
            return 0
        }
        i = i + 1
    }
    value
}

fn tuple_field_vt_from_struct_name(struct_name: String, elem_index: i32) -> i32 {
    if len(struct_name) == 0 {
        if elem_index > 0 {
            return value_types::VT_GC_REF()
        }
        return value_types::VT_I32()
    }
    let key = tuple_field_type_name(struct_name, elem_index)
    if eq(clone(key), "String") || eq(clone(key), "string") {
        return value_types::VT_GC_REF()
    }
    if eq(clone(key), "f64") || eq(clone(key), "F64") {
        return value_types::VT_F64()
    }
    if eq(clone(key), "f32") || eq(clone(key), "F32") {
        return value_types::VT_F32()
    }
    if eq(clone(key), "i64") || eq(clone(key), "I64") || eq(clone(key), "u64") {
        return value_types::VT_I64()
    }
    if eq(clone(key), "i32") || eq(clone(key), "I32") ||
    eq(clone(key), "bool") || eq(clone(key), "char") ||
    eq(clone(key), "u8") || eq(clone(key), "u16") ||
    eq(clone(key), "u32") || eq(clone(key), "i16") ||
    eq(clone(key), "unit") || eq(clone(key), "()") {
        return value_types::VT_I32()
    }
    if eq(clone(key), "fnref") || eq(clone(key), "fn") || starts_with(clone(key), "fn(") {
        return value_types::VT_FUNCREF()
    }
    if starts_with(clone(key), "vec:") ||
    starts_with(clone(key), "option:") ||
    starts_with(clone(key), "result:") ||
    starts_with(clone(key), "hashmap:") ||
    starts_with(clone(key), "hashset:") {
        return value_types::VT_GC_REF()
    }
    // A non-primitive tuple element is a named GC value even when its layout
    // has not been registered yet. Registration order must not change the
    // tuple field ABI (`WitType`, `Point`, and qualified names all follow this
    // path).
    if len(key) > 1 {
        return value_types::VT_GC_REF()
    }
    value_types::VT_I32()
}

fn tuple_field_type_name(struct_name: String, elem_index: i32) -> String {
    if len(struct_name) == 0 {
        return String_new()
    }
    let keys = substring(struct_name, 6, len(struct_name))
    tuple_key_at(keys, elem_index)
}

fn tuple_key_at(keys: String, index: i32) -> String {
    let n = len(keys)
    let mut cur = 0
    let mut start = 0
    let mut i = 0
    while i <= n {
        if i == n || char_at(keys, i) == 44 {
            if cur == index {
                return substring(keys, start, i)
            }
            cur = cur + 1
            start = i + 1
        }
        i = i + 1
    }
    String_new()
}
