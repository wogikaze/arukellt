use mir::legacy_vt_compat
use mir::lower::call_arg_print_convert
use mir::lower::call_arg_print_needs
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_module
use mir::lower::ctx_types
use mir::inst_local_set
use mir::module_spine
use mir::typed_mir_compat
use mir::value_types

fn mir_is_printlike_callee(name: String) -> bool {
    eq(clone(name), "stdio::println") ||
    eq(clone(name), "println") ||
    eq(clone(name), "stdio::print") ||
    eq(clone(name), "print") ||
    eq(clone(name), "stdio::eprintln") ||
    eq(clone(name), "eprintln") ||
    eq(clone(name), "__intrinsic_println") ||
    eq(clone(name), "__intrinsic_eprintln") ||
    eq(clone(name), "__intrinsic_print")
}

fn mir_print_arg_needs_string_conversion(ctx: LowerCtx, arg: AstNode, arg_idx: i32) -> bool {
    call_arg_print_needs::mir_print_arg_needs_string_conversion(ctx, arg, arg_idx)
}

fn mir_convert_print_arg_to_string(ctx: LowerCtx, arg: AstNode, arg_idx: i32) -> i32 {
    call_arg_print_convert::mir_convert_print_arg_to_string(ctx, arg, arg_idx)
}

fn mir_stage_call_arg(ctx: LowerCtx, staged_arg_locals: Vec<i32>, arg_idx: i32) -> i32 {
    let staged_vt = mir_stage_call_arg_vt(ctx, arg_idx)
    let staged_local = ctx_api_local_alloc::ctx_fresh_local(ctx, staged_vt)
    let staged_type = ctx_api_local_types::ctx_get_local_type(ctx, arg_idx)
    if len(staged_type) > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, staged_local, staged_type)
    }
    // A type name is not sufficient to identify a nominal GC reference.  A
    // staged argument must retain the producer's exact MirValueType.
    ctx_api_local_types::ctx_set_local_mvt(
        ctx,
        staged_local,
        ctx_api_local_types::ctx_local_mvt(ctx, arg_idx)
    )
    ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set_from(staged_local, arg_idx))
    push(staged_arg_locals, staged_local)
    staged_local
}

fn mir_stage_call_arg_vt(ctx: LowerCtx, arg_idx: i32) -> i32 {
    let legacy_vt = ctx_api_local_types::ctx_local_vt(ctx, arg_idx)
    // Primitive ABI types are authoritative here.  A stale or widened MVT
    // must not turn an f64/i64 argument into a GC local while staging a call;
    // the function signature already carries the exact scalar representation.
    if legacy_vt != value_types::VT_GC_REF() && legacy_vt != value_types::VT_REF() {
        return legacy_vt
    }
    let mvt = ctx_api_local_types::ctx_local_mvt(ctx, arg_idx)
    if !typed_mir_compat::mvt_is_invalid(mvt) {
        let module = ctx_api_module::ctx_current_module(ctx)
        let table = module_spine::MirModule_type_table(module)
        return legacy_vt_compat::legacy_vt_from_mir_value_type(table, mvt)
    }
    ctx_api_local_types::ctx_local_vt(ctx, arg_idx)
}
