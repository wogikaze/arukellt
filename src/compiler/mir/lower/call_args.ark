use mir::legacy_vt_compat
use mir::lower::call_arg_print_convert
use mir::lower::call_arg_print_needs
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_emit_core
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_module
use mir::lower::ctx_types
use mir::inst_local_get
use mir::inst_local_set
use mir::module_spine
use mir::typed_mir_compat
use mir::value_types
fn mir_is_printlike_callee(name: String) -> bool {
    name.clone().eq("Stdio::println") ||
    name.clone().eq("Stdio::print") ||
    name.clone().eq("Stdio::eprintln") ||
    name.clone().eq("stdio::Stdio::println") ||
    name.clone().eq("stdio::Stdio::print") ||
    name.clone().eq("stdio::Stdio::eprintln") ||
    name.clone().eq("println") ||
    name.clone().eq("print") ||
    name.clone().eq("eprintln") ||
    name.clone().eq("__intrinsic_println") ||
    name.clone().eq("__intrinsic_eprintln") ||
    name.clone().eq("__intrinsic_eprint") ||
    name.clone().eq("__intrinsic_print")
}

fn mir_print_arg_needs_string_conversion(mut ctx: LowerCtx, arg: AstNode, arg_idx: i32) -> bool {
    call_arg_print_needs::mir_print_arg_needs_string_conversion(ctx, arg, arg_idx)
}

fn mir_convert_print_arg_to_string(mut ctx: LowerCtx, arg: AstNode, arg_idx: i32) -> i32 {
    call_arg_print_convert::mir_convert_print_arg_to_string(ctx, arg, arg_idx)
}

fn mir_stage_call_arg(mut ctx: LowerCtx, staged_arg_locals: Vec<i32>, arg_idx: i32) -> i32 {
    mir_stage_call_arg_mode(ctx, staged_arg_locals, arg_idx, true)
}

// Staging for a source that was not lowered (a bare local or constant name):
// no value is on the operand stack, so the copy must emit its own local.get.
// `local_set_from` would let the emitter's copy peephole consume an earlier
// producer of the same local that the enclosing call still needs
// (`v.push(get_unchecked(v, 0))` lost the push receiver).
fn mir_stage_call_arg_from_local(mut ctx: LowerCtx, staged_arg_locals: Vec<i32>, arg_idx: i32) -> i32 {
    mir_stage_call_arg_mode(ctx, staged_arg_locals, arg_idx, false)
}

fn mir_stage_call_arg_mode(
    mut ctx: LowerCtx,
    mut staged_arg_locals: Vec<i32>,
    arg_idx: i32,
    source_on_stack: bool
) -> i32 {
    let staged_vt = mir_stage_call_arg_vt(ctx, arg_idx)
    let staged_local = ctx_api_local_alloc::ctx_fresh_local(ctx, staged_vt)
    let staged_type = ctx_api_local_types::ctx_get_local_type(ctx, arg_idx)
    if staged_type.len() > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, staged_local, staged_type)
    }
    // A type name is not sufficient to identify a nominal GC reference.  A
    // staged argument must retain the producer's exact MirValueType.
    ctx_api_local_types::ctx_set_local_mvt(
        ctx,
        staged_local,
        ctx_api_local_types::ctx_local_mvt(ctx, arg_idx)
    )
    if !source_on_stack && mir_stage_arg_needs_reload(ctx, arg_idx) {
        // Only a producer that materialized this exact local loses its stack
        // copy to the staged copy: the store policy SETs when a copy reloads
        // the local it just wrote (`v.push(get_unchecked(v, 0))`). A producer
        // of another local keeps its TEE/SKIP decision and must not be
        // duplicated on the operand stack here.
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(arg_idx))
    }
    ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set_from(staged_local, arg_idx))
    staged_arg_locals.push(staged_local)
    staged_local
}

// True when the last emitted instruction materialized `arg_idx` itself, so
// the staged copy is about to consume the only stack copy of that value.
fn mir_stage_arg_needs_reload(ctx: LowerCtx, arg_idx: i32) -> bool {
    if arg_idx < 0 {
        return false
    }
    ctx_emit_core::ctx_current_block_last_inst_dest(ctx) == arg_idx
}

fn mir_stage_call_arg_vt(ctx: LowerCtx, arg_idx: i32) -> i32 {
    let legacy_vt = ctx_api_local_types::ctx_local_vt(ctx, arg_idx)
    // Primitive ABI types are authoritative here.  A stale or widened MVT
    // must not turn an f64/i64 argument into a GC local while staging a call;
    // the function signature already carries the exact scalar representation.
    if legacy_vt != value_types::VT_GC_REF() && legacy_vt != value_types::VT_REF() {
        return legacy_vt
    }
    let mvt = ctx_api_local_types::ctx_local_mvt(ctx, arg_idx)
    if !typed_mir_compat::mvt_is_invalid(mvt) {
        let module = ctx_api_module::ctx_current_module(ctx)
        let table = module_spine::MirModule_type_table(module)
        return legacy_vt_compat::legacy_vt_from_mir_value_type(table, mvt)
    }
    ctx_api_local_types::ctx_local_vt(ctx, arg_idx)
}
