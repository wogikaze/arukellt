use mir::lower::entry_body_source
use mir::lower::entry_body_input
use mir::lower::edge_discovery
use mir::lower::entry_core_body
use mir::lower::entry_methods_mono
use mir::lower::entry_view_method
use mir::lower::ctx_corehir_probe
use mir::lower::entry_fallback_body
use mir::lower::legacy_body
use corehir::mod as corehir_mod
fn mir_emit_impl_methods(mut ctx: LowerCtx, mut body_source: MirLowerEntryBodySource, impl_decl_index: i32, struct_name: String, midx: MonoIndex, emit_keep: NameIndex, prune_enabled: bool) -> i32 {
    let entry_view = entry_body_source::mir_entry_body_source_view(body_source)
    let method_count = entry_view_method::mir_entry_method_count_for_impl(entry_view, impl_decl_index)
    let mut mi = 0
    let mut skipped = 0
    while mi < method_count {
        let method_info_index = entry_view_method::mir_entry_method_info_index(entry_view, impl_decl_index, mi)
        let mut mangled = struct_name.clone()
        let mut m_body_idx = 0 - 1
        let mut method_param_count = 0
        if method_info_index >= 0 {
            mangled = entry_view_method::mir_entry_method_mangled_name_at(entry_view, method_info_index, mangled)
            m_body_idx = entry_view_method::mir_entry_method_body_index_at(entry_view, method_info_index, m_body_idx)
            method_param_count = entry_view_method::mir_entry_method_param_count_at(entry_view, method_info_index, method_param_count)
        }
        let body_input = entry_body_source::mir_entry_body_source_method_input(body_source, impl_decl_index, mi, method_info_index, m_body_idx)
        if ctx_corehir_probe::mir_probe_edges_enabled() != 0 {
            let probe_body = entry_body_input::mir_entry_body_input_core(body_input)
            ctx_corehir_probe::mir_probe_dump_body_calls(
                mangled.clone(),
                entry_core_body::mir_entry_core_body_exprs(probe_body),
                entry_core_body::mir_entry_core_body_root(probe_body)
            )
            let fb = entry_body_input::mir_entry_body_input_fallback(body_input)
            ctx_corehir_probe::mir_probe_dump_ast_calls(
                mangled.clone(),
                legacy_body::mir_legacy_body_node(entry_fallback_body::mir_entry_fallback_body_legacy(fb))
            )
        }
        // #851 Phase 3 worklist skip: emit the method's bodies only when at
        // least one of its emit names is AST-edge reachable.
        let mut emit_bodies = true
        if prune_enabled {
            emit_bodies = edge_discovery::mir_ast_edge_emit_names_needed(
                edge_discovery::edge_emit_names_for_method(mangled.clone(), midx),
                emit_keep
            )
        }
        if emit_bodies {
            entry_methods_mono::mir_emit_method_mono_bodies(ctx, body_input, struct_name, mangled, method_param_count, entry_view, method_info_index, midx)
        } else {
            skipped = skipped + 1
        }
        let core_body = entry_body_input::mir_entry_body_input_core(body_input)
        corehir_mod::release_body_expr_subtree(
            entry_core_body::mir_entry_core_body_exprs(core_body),
            entry_core_body::mir_entry_core_body_root(core_body)
        )
        entry_body_source::mir_entry_body_source_release_method(body_source, impl_decl_index, mi, m_body_idx)
        mi = mi + 1
    }
    skipped
}
