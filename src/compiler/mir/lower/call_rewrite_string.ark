use mir::lower::call_rewrite_method
use mir::lower::ctx_api_local_types
use mir::lower::ctx_types
use mir::value_types
struct MirStringCallRewrite {
    callee_name: String,
    return_local: i32,
}

fn mir_string_call_rewrite_new(callee_name: String, return_local: i32) -> MirStringCallRewrite {
    MirStringCallRewrite { callee_name: callee_name, return_local: return_local }
}

fn mir_string_call_rewrite_callee_name(rewrite: MirStringCallRewrite) -> String {
    rewrite.callee_name.clone()
}

fn mir_string_call_rewrite_return_local(rewrite: MirStringCallRewrite) -> i32 {
    rewrite.return_local
}

fn mir_rewrite_to_string(ctx: LowerCtx, callee_name: String, first_arg_idx: i32) -> MirStringCallRewrite {
    let mut rewritten = callee_name
    let mut return_local = 0 - 1
    if first_arg_idx >= 0 {
        // Prefer the registered Display impl so `to_string(x)` and
        // `x.to_string()` share one dispatch path (#702). The builtin
        // fallbacks below remain for unresolved type variables and for
        // builds whose fn index does not yet carry the impl method.
        let impl_method = call_rewrite_method::mir_try_resolve_impl_method(ctx, "to_string", first_arg_idx)
        if !impl_method.clone().eq(String_from("to_string")) {
            return mir_string_call_rewrite_new(impl_method, 0 - 1)
        }
        let arg_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
        if arg_type.clone().eq("char") {
            rewritten = "char_to_string"
        } else {
            if arg_type.clone().eq("f64") || ctx_api_local_types::ctx_local_vt(ctx, first_arg_idx) == value_types::VT_F64() {
                rewritten = "f64_to_string"
            } else {
                if arg_type.clone().eq("bool") {
                    rewritten = "bool_to_string"
                } else {
                    if arg_type.clone().eq("i64") || arg_type.clone().eq("u64") || ctx_api_local_types::ctx_local_vt(ctx, first_arg_idx) == value_types::VT_I64() {
                        rewritten = "i64_to_string"
                    } else {
                        if arg_type.clone().eq("string") || arg_type.clone().eq("String") {
                            return_local = first_arg_idx
                        } else {
                            rewritten = call_rewrite_method::mir_try_resolve_impl_method(ctx, "to_string", first_arg_idx)
                        }
                    }
                }
            }
        }
    }
    mir_string_call_rewrite_new(rewritten, return_local)
}
