use mir::lower::ast_node
use mir::lower::assign
use mir::lower::body_aggregate_assign_field
use mir::lower::ctx_api_emit
use mir::lower::method
use mir::inst_local_get
use mir::lower_kinds

fn lower_method_call_expr(mut ctx: LowerCtx, node: AstNode) -> i32 {
    let child_count = ast_node::node_child_count(node)
    if child_count >= 1 {
        let receiver = ast_node::node_child_at(node, 0)
        let receiver_is_composed = ast_node::node_kind_is(receiver, lower_kinds::NK_METHOD_CALL()) ||
        ast_node::node_kind_is(receiver, lower_kinds::NK_CALL())
        let receiver_idx = lower_expr(ctx, receiver)
        if (receiver_is_composed && receiver_idx >= 0) ||
        method::mir_method_receiver_leaves_no_stack(ctx, receiver_idx, child_count > 1) {
            ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(receiver_idx))
        }
        let callee_name = method::mir_initial_method_callee(ctx, ast_node::node_text(node), receiver_idx)
        let mut a = 1
        let mut first_method_arg_idx = 0 - 1
        let mut last_method_arg_idx = 0 - 1
        while a < child_count {
            let arg = ast_node::node_child_at(node, a)
            let arg_is_composed = ast_node::node_kind_is(arg, lower_kinds::NK_METHOD_CALL()) ||
            ast_node::node_kind_is(arg, lower_kinds::NK_CALL())
            let method_arg_idx = lower_expr(ctx, arg)
            let arg_is_scalar_const = method::mir_method_arg_needs_repush_before_field_access(ctx, method_arg_idx)
            if (arg_is_composed && method_arg_idx >= 0) ||
            method::mir_method_arg_leaves_no_stack(ctx, method_arg_idx) {
                ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(method_arg_idx))
            }
            // A following field-access argument makes the emit store policy
            // materialize this literal ahead of the base load (#807), which
            // would drop it from the call's operand stack. Reload it so the
            // call still sees every operand.
            if arg_is_scalar_const && a + 1 < child_count &&
            method::mir_expr_leads_with_field_access(ast_node::node_child_at(node, a + 1)) {
                ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(method_arg_idx))
            }
            if a == 1 {
                first_method_arg_idx = method_arg_idx
            }
            last_method_arg_idx = method_arg_idx
            a = a + 1
        }
        let mut resolved_callee = method::mir_resolve_method_callee(
            ctx,
            callee_name,
            first_method_arg_idx,
            ast_node::node_span_start(node)
        )
        let call_result = method::mir_emit_method_call(ctx, resolved_callee, child_count, receiver_idx, last_method_arg_idx)
        if method::mir_method_replaces_string_receiver(resolved_callee.clone()) &&
        receiver_idx >= 0 &&
        ast_node::node_kind_is(receiver, lower_kinds::NK_FIELD_ACCESS()) {
            let struct_idx = body_aggregate_assign_field::lower_field_assign_base(ctx, receiver)
            if struct_idx >= 0 {
                assign::mir_emit_field_assign(
                    ctx,
                    ast_node::node_text(receiver),
                    struct_idx,
                    receiver_idx
                )
            }
        }
        return call_result
    }
    0 - 1
}
