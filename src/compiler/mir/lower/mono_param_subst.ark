//
// After mono type params are set up, re-substitute type-variable param
// locals with the concrete monomorphized type.

use mir::lower::ctx_api_function_frame
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_module
use mir::lower::ctx_current_storage
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_mono
use mir::lower::mono_suffix_parse
use mir::lower::return_typeinfo_names
use mir::lower_kinds
use mir::function_identity
use mir::function_param_view
use mir::function_locals_view
use mir::local_access
use mir::type_contracts
use mir::value_types

fn mir_substitute_mono_param_types(ctx: LowerCtx) {
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    let fn_name = function_identity::MirFunction_name(func)
    // Extract the mono type suffix from the function name (e.g. "i32" from
    // "unwrap_or_default__i32"). If no "__" separator, this is not a
    // specialized mono function — skip substitution.
    let mono_suffix = mono_suffix_parse::extract_mono_suffix(clone(fn_name))
    // Prefer the mono type parameter mapping (set up by
    // ctx_setup_mono_type_params_by_ordinal) which correctly maps
    // individual type variables to their concrete types even for
    // multi-parameter generics (e.g. T→i32, E→String).
    let has_mono_map = ctx_mono_type_params::ctx_has_mono_type_params(ctx)
    // Nested keys like Vec_i32_ were once rejected by extract_mono_suffix;
    // still allow substitution when the ordinal mono map is present.
    if len(clone(mono_suffix)) == 0 && !has_mono_map {
        return
    }
    let param_count = function_param_view::MirFunction_param_count(func)
    let mut p = 0
    while p < param_count {
        // Read the local record, not the parameter record: the parameter
        // carries the signature spelling (struct:Pair:8) while the local
        // keeps the semantic generic name (?Pair:T) that substitution needs.
        let local = function_locals_view::MirFunction_local_at(func, p)
        let ty_name = local_access::MirLocal_type_name(local)
        // Handle composite type names containing type variables, e.g.
        // "?Option:T" or "?Result:T" — substitute the inner type variable
        // with the concrete monomorphized type.
        if !mono_subst_wrapped_param(ctx, p, clone(ty_name), clone(mono_suffix), has_mono_map) {
            mono_subst_bare_param(ctx, p, clone(ty_name), clone(mono_suffix), has_mono_map)
        }
        p = p + 1
    }
}

// Substitute vec:/option:/?Option: wrapped type-variable params.
// Returns true when the type name matched one of the wrapped forms
// (whether or not a concrete substitution was applied).
fn mono_subst_wrapped_param(ctx: LowerCtx, p: i32, ty_name: String, mono_suffix: String, has_mono_map: bool) -> bool {
    if starts_with(clone(ty_name), String_from("fnsig:")) {
        mono_subst_fnsig_param(ctx, p, clone(ty_name), clone(mono_suffix), has_mono_map)
        return true
    }
    if starts_with(clone(ty_name), String_from("vec:")) {
        let type_var = substring(clone(ty_name), 4, len(ty_name))
        // Concrete elems (vec:i32, vec:String, vec:Point, ...) must keep their
        // annotation. Only type-variable elems (vec:T, vec:?t0, ...) are
        // rewritten from the mono suffix — otherwise "__core_*" / accidental
        // "__" names force structref-array Vec layouts (i64<-structref).
        if !mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(type_var)) {
            return true
        }
        let mut concrete = resolve_concrete_type(ctx, clone(type_var), clone(mono_suffix), has_mono_map)
        if len(concrete) == 0 {
            concrete = resolve_nested_vec_concrete_type(ctx, clone(type_var), clone(mono_suffix), has_mono_map)
        }
        if len(concrete) > 0 {
            mono_set_param_gc_type(ctx, p, concat(String_from("vec:"), concrete))
        }
        return true
    }
    if starts_with(clone(ty_name), String_from("option:")) || starts_with(clone(ty_name), String_from("Option:")) {
        let type_var = substring(clone(ty_name), 7, len(ty_name))
        if !mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(type_var)) {
            // Concrete payloads still need the canonical option: prefix.
            if starts_with(clone(ty_name), String_from("Option:")) {
                mono_set_param_gc_type(ctx, p, concat(String_from("option:"), type_var))
            }
            return true
        }
        let concrete = resolve_concrete_type(ctx, clone(type_var), clone(mono_suffix), has_mono_map)
        if len(concrete) > 0 {
            mono_set_param_gc_type(ctx, p, concat(String_from("option:"), concrete))
        }
        return true
    }
    if starts_with(clone(ty_name), String_from("?Option:")) {
        let type_var = substring(clone(ty_name), 8, len(ty_name))
        if !mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(type_var)) {
            // Already-concrete "?Option:String" must drop the generic marker
            // so wasm emit does not treat the whole function as unreachable.
            mono_set_param_gc_type(ctx, p, concat(String_from("option:"), type_var))
            return true
        }
        let concrete = resolve_concrete_type(ctx, clone(type_var), clone(mono_suffix), has_mono_map)
        if len(concrete) > 0 {
            mono_set_param_gc_type(ctx, p, concat(String_from("option:"), concrete))
        }
        return true
    }
    if starts_with(clone(ty_name), String_from("result:")) ||
    starts_with(clone(ty_name), String_from("Result:")) ||
    starts_with(clone(ty_name), String_from("?Result:")) {
        let rest = if starts_with(clone(ty_name), String_from("?Result:")) {
            substring(clone(ty_name), 8, len(ty_name))
        } else {
            substring(clone(ty_name), 7, len(ty_name))
        }
        mono_subst_result_type_args(ctx, p, rest, mono_suffix, has_mono_map)
        return true
    }
    if starts_with(clone(ty_name), String_from("?")) && contains(clone(ty_name), String_from(":")) {
        return mono_subst_named_generic_param(ctx, p, clone(ty_name), clone(mono_suffix), has_mono_map)
    }
    false
}

// `fnsig:<param>;<return>` locals keep segment spellings so a generic
// `f: fn(T) -> U` parameter specializes to `fnsig:i32;i32` etc. Each
// segment resolves through the same concrete-type map as bare params;
// unresolved segments keep their spelling so partially bound signatures
// degrade to the declaration instead of a wrong concrete ABI (#860).
fn mono_subst_fnsig_param(ctx: LowerCtx, p: i32, ty_name: String, mono_suffix: String, has_mono_map: bool) {
    let rest = substring(clone(ty_name), 6, len(ty_name))
    let mut out = String_from("fnsig:")
    let mut seg_start = 0
    let n = len(rest)
    let mut i = 0
    let mut changed = false
    while i <= n {
        if i == n || byte_at(clone(rest), i) == 59 {
            let seg = substring(clone(rest), seg_start, i)
            let resolved = resolve_fnsig_segment(ctx, clone(seg), clone(mono_suffix), has_mono_map)
            if !eq(clone(resolved), clone(seg)) {
                changed = true
            }
            out = concat(out, resolved)
            if i < n {
                out = concat(out, String_from(";"))
            }
            seg_start = i + 1
        }
        i = i + 1
    }
    if changed {
        // Keep the funcref value type: fnsig locals are (ref $callback),
        // not GC data refs — GC_REF here would mis-type ref.func stores.
        mono_set_param_fnsig_type(ctx, p, out)
    }
}

fn mono_set_param_fnsig_type(ctx: LowerCtx, p: i32, mono_type_name: String) {
    ctx_api_local_types::ctx_set_local_vt(ctx, p, value_types::VT_FUNCREF())
    ctx_api_local_types::ctx_set_local_type(ctx, p, clone(mono_type_name))
    ctx_api_function_frame::ctx_set_func_param_type(ctx, p, value_types::VT_FUNCREF(), mono_type_name)
}

fn resolve_fnsig_segment(ctx: LowerCtx, seg: String, mono_suffix: String, has_mono_map: bool) -> String {
    if len(seg) == 0 {
        return seg
    }
    if mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(seg)) {
        let concrete = resolve_concrete_type(ctx, clone(seg), clone(mono_suffix), has_mono_map)
        if len(concrete) > 0 {
            return concrete
        }
        return seg
    }
    if contains(clone(seg), String_from(":")) || contains(clone(seg), String_from("<")) {
        let resolved_name = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, clone(seg))
        // `X::Item` projections resolve through the owner's Iterator::next
        // signature once the head is concrete (#860/#691).
        let assoc = ctx_mono_type_params::ctx_resolve_assoc_projection_type(ctx, clone(seg))
        if len(assoc) > 0 {
            return assoc
        }
        return resolved_name
    }
    seg
}

// Generic user-defined containers are represented as `?Box:T` until the
// function is monomorphized. The parameter remains an open enum/struct
// reference, while the type-variable mapping is used by payload lowering.
fn mono_subst_named_generic_param(ctx: LowerCtx, p: i32, ty_name: String, mono_suffix: String, has_mono_map: bool) -> bool {
    let first_colon = find_type_name_colon(clone(ty_name), 1)
    if first_colon < 0 {
        return false
    }
    let base = substring(clone(ty_name), 1, first_colon)
    let first_arg = substring(clone(ty_name), first_colon + 1, len(ty_name))
    if eq(clone(base), String_from("HashMap")) {
        mono_subst_hashmap_param(ctx, p, clone(first_arg))
        return true
    }
    let type_var = first_generic_type_arg(clone(first_arg))
    if len(type_var) == 0 {
        return false
    }
    let concrete = resolve_concrete_type(ctx, clone(type_var), clone(mono_suffix), has_mono_map)
    if len(concrete) == 0 {
        return true
    }
    // ?Pair:T inside a mono body denotes the instantiated layout
    // (Pair<String>), not the unsubstituted declaration. Resolve through
    // the mono map and register the derived layout so field access and
    // the parameter signature use the concrete struct type.
    let resolved_inst = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, clone(ty_name))
    if ctx_struct_mono::ctx_derive_generic_struct_layout(ctx, clone(resolved_inst)) {
        mono_set_param_gc_type(
            ctx,
            p,
            ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, resolved_inst)
        )
        return true
    }
    let ref_type = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, clone(base))
    let canonical = if len(ref_type) > 0 { ref_type } else { concat(String_from("enum:"), base) }
    mono_set_param_gc_type(ctx, p, canonical)
    true
}

// ?HashMap:K:V params keep the builtin hashmap:<pair> local-type
// spelling so GC layout and method rewrites see the same name concrete
// map locals carry. The generic-struct derive path only knows user
// structs, so builtin pairs resolve here instead (#691).
fn mono_subst_hashmap_param(ctx: LowerCtx, p: i32, args: String) {
    let colon = find_type_name_colon(clone(args), 0)
    if colon < 0 {
        return
    }
    let key_var = substring(clone(args), 0, colon)
    let val_var = substring(clone(args), colon + 1, len(args))
    let key_ty = mono_hashmap_arg_type_info(ctx, key_var)
    let val_ty = mono_hashmap_arg_type_info(ctx, val_var)
    // An unresolved variable must keep the ? marker (loud unreachable)
    // rather than silently taking the si32 default of the pair lookup.
    if type_contracts::TypeInfo_tag(key_ty) == lower_kinds::TY_TYPE_VAR() ||
    type_contracts::TypeInfo_tag(val_ty) == lower_kinds::TY_TYPE_VAR() {
        return
    }
    let map_ty = type_contracts::TypeInfo_simple(lower_kinds::TY_HASHMAP())
    type_contracts::TypeInfo_push_type_arg(map_ty, key_ty)
    type_contracts::TypeInfo_push_type_arg(map_ty, val_ty)
    let alias = return_typeinfo_names::mir_hashmap_return_type_name_from_type_info(map_ty)
    if len(alias) > 0 {
        mono_set_param_gc_type(ctx, p, alias)
    }
}

// TypeInfo for one ?HashMap arg segment. Type variables resolve to the
// enclosing mono instance's recorded type argument by name position; the
// string mono map cannot carry fn signatures, so the TypeInfo record is
// the only source that keeps fn(i32) -> i32 (#691).
fn mono_hashmap_arg_type_info(ctx: LowerCtx, arg: String) -> TypeInfo {
    if !mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(arg)) {
        return mono_hashmap_concrete_type_info(arg)
    }
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    let inst = ctx_api_module::ctx_mono_instance_at(ctx, function_identity::MirFunction_name(func))
    let inst_args = type_contracts::MonoInstance_type_arg_count(inst)
    let count = len(ctx.mono_type_param_names)
    let mut i = 0
    while i < count && i < inst_args {
        if eq(get_unchecked(ctx.mono_type_param_names, i), clone(arg)) {
            return type_contracts::MonoInstance_type_arg_at(inst, i)
        }
        i = i + 1
    }
    type_contracts::TypeInfo_simple(lower_kinds::TY_TYPE_VAR())
}

// TypeInfo for an already-concrete ?HashMap arg spelling. Only the
// scalar/fn shapes the storage adapters support need real tags; anything
// else stays an unknown marker so the pair lookup falls back.
fn mono_hashmap_concrete_type_info(arg: String) -> TypeInfo {
    if eq(clone(arg), String_from("i32")) {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_I32())
    }
    if eq(clone(arg), String_from("String")) || eq(clone(arg), String_from("string")) {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_STRING())
    }
    if eq(clone(arg), String_from("fn")) || eq(clone(arg), String_from("fnref")) ||
    starts_with(clone(arg), String_from("fn(")) ||
    starts_with(clone(arg), String_from("fn<")) ||
    starts_with(clone(arg), String_from("fnsig:")) ||
    starts_with(clone(arg), String_from("fn_")) {
        return type_contracts::TypeInfo_new(lower_kinds::TY_STRUCT(), String_from("fnref"), Vec::new<TypeInfo>())
    }
    type_contracts::TypeInfo_simple(lower_kinds::TY_TYPE_VAR())
}

fn find_type_name_colon(name: String, start: i32) -> i32 {
    let mut i = start
    while i < len(name) {
        if byte_at(name, i) == 58 {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn first_generic_type_arg(args: String) -> String {
    let mut i = 0
    while i < len(args) {
        if byte_at(args, i) == 58 {
            return substring(args, 0, i)
        }
        i = i + 1
    }
    args
}

// Substitute bare type-variable params (e.g. "T" or "?T").
fn mono_subst_bare_param(ctx: LowerCtx, p: i32, ty_name: String, mono_suffix: String, has_mono_map: bool) {
    let mut type_var = String_new()
    if starts_with(clone(ty_name), String_from("?")) {
        type_var = substring(clone(ty_name), 1, len(ty_name))
    } else if mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(ty_name)) {
        // Method parameters are recorded as the bare spelling "T", while
        // older lowering paths used "?T".  Both spellings denote the same
        // generic parameter and must receive the specialized ABI type.
        type_var = clone(ty_name)
    }
    if len(type_var) == 0 {
        return
    }
    let concrete = resolve_concrete_type(ctx, clone(type_var), clone(mono_suffix), has_mono_map)
    if len(concrete) > 0 {
        let pvt = mono_concrete_type_vt(clone(concrete))
        // For struct/enum types, transform the concrete type
        // name the same way the return type does (e.g.
        // "Point" → "struct:Point:8") so the emitter's type
        // sig builder can use the byte-size fallback when the
        // struct is not in the gc_struct list (deduplicated by
        // sig).  Skip this for String and primitives, which
        // have their own dedicated type sigs.
        let sig_type_name = clone(concrete)
        if pvt == value_types::VT_GC_REF() {
            if !eq(clone(concrete), String_from("String")) && !eq(clone(concrete), String_from("string")) {
                sig_type_name = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, clone(concrete))
            }
        }
        ctx_api_local_types::ctx_set_local_vt(ctx, p, pvt)
        ctx_api_local_types::ctx_set_local_type(ctx, p, clone(concrete))
        ctx_api_function_frame::ctx_set_func_param_type(ctx, p, pvt, sig_type_name)
    }
}

// Resolve Result<T, E> args into canonical result:T:E for match payload
// extraction. enum:Result:T alone drops E and selects the wrong Ok field
// type on wasm32-gc (generics/result_generic).
fn mono_subst_result_type_args(
    ctx: LowerCtx,
    p: i32,
    rest: String,
    mono_suffix: String,
    has_mono_map: bool
) {
    let t_var = mono_suffix_parse::extract_first_type_var(clone(rest))
    let e_var = extract_result_err_type_var(clone(rest))
    let t_needs = mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(t_var))
    let e_needs = len(e_var) > 0 && mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(e_var))
    if !t_needs && !e_needs {
        mono_set_param_gc_type(ctx, p, concat(String_from("result:"), clone(rest)))
        return
    }
    let mut t_concrete = clone(t_var)
    if t_needs {
        t_concrete = resolve_concrete_type(ctx, clone(t_var), clone(mono_suffix), has_mono_map)
    }
    let mut e_concrete = clone(e_var)
    if e_needs {
        e_concrete = resolve_concrete_type(ctx, clone(e_var), clone(mono_suffix), has_mono_map)
    }
    if len(t_concrete) == 0 {
        return
    }
    if len(e_concrete) > 0 {
        mono_set_param_gc_type(
            ctx,
            p,
            concat(String_from("result:"), concat(clone(t_concrete), concat(String_from(":"), e_concrete)))
        )
        return
    }
    mono_set_param_gc_type(ctx, p, concat(String_from("result:"), t_concrete))
}

fn extract_result_err_type_var(rest: String) -> String {
    let rlen = len(rest)
    let mut ci = 0
    while ci < rlen {
        if byte_at(rest, ci) == 58 {
            return substring(rest, ci + 1, rlen)
        }
        ci = ci + 1
    }
    String_new()
}

// Set a param local to a GC ref with the given mono type name.
fn mono_set_param_gc_type(ctx: LowerCtx, p: i32, mono_type_name: String) {
    ctx_api_local_types::ctx_set_local_vt(ctx, p, value_types::VT_GC_REF())
    ctx_api_local_types::ctx_set_local_type(ctx, p, clone(mono_type_name))
    ctx_api_function_frame::ctx_set_func_param_type(ctx, p, value_types::VT_GC_REF(), mono_type_name)
}

// Determine the value type (VT) for a concrete monomorphized type name.
// Primitive types map to their corresponding VT; all other types (String,
// struct, enum, vec, etc.) are GC reference types.
fn mono_concrete_type_vt(type_name: String) -> i32 {
    if eq(clone(type_name), String_from("i32")) || eq(clone(type_name), String_from("bool")) || eq(clone(type_name), String_from("char")) {
        return value_types::VT_I32()
    }
    if eq(clone(type_name), String_from("i64")) || eq(clone(type_name), String_from("u64")) {
        return value_types::VT_I64()
    }
    if eq(clone(type_name), String_from("f64")) {
        return value_types::VT_F64()
    }
    if eq(clone(type_name), String_from("f32")) {
        return value_types::VT_F32()
    }
    if eq(clone(type_name), String_from("v128")) {
        return value_types::VT_V128()
    }
    value_types::VT_GC_REF()
}

// Resolve nested generic vec element types (e.g. vec:T with T = Vec<i32>).
// When the mono suffix is a composite type key like "Vec<i32>", use it
// directly instead of splitting on "__" type parameter ordinals.
fn resolve_nested_vec_concrete_type(ctx: LowerCtx, type_var: String, mono_suffix: String, has_mono_map: bool) -> String {
    if has_mono_map {
        let resolved = ctx_mono_type_params::ctx_resolve_mono_type_param(ctx, clone(type_var))
        if len(resolved) > 0 {
            return resolved
        }
    }
    if len(mono_suffix) == 0 {
        return String_new()
    }
    if starts_with(clone(mono_suffix), String_from("Vec")) {
        return clone(mono_suffix)
    }
    let type_keys = mono_suffix_parse::split_mono_suffix(clone(mono_suffix))
    let key_count = len(type_keys)
    if key_count == 1 {
        let only = get_unchecked(type_keys, 0)
        if starts_with(clone(only), String_from("Vec")) {
            return only
        }
    }
    String_new()
}

// Resolve a type variable name to its concrete monomorphized type.
// Uses the mono type parameter mapping when available, falling back to
// the function name suffix.  For multi-parameter generics the suffix
// contains multiple type keys separated by "__" (e.g. "i32__String");
// the fallback uses the type variable name to pick the right one.
fn resolve_concrete_type(ctx: LowerCtx, type_var: String, mono_suffix: String, has_mono_map: bool) -> String {
    if has_mono_map {
        let resolved = ctx_mono_type_params::ctx_resolve_mono_type_param(ctx, clone(type_var))
        if len(resolved) > 0 {
            return resolved
        }
    }
    // Fallback: split the suffix by "__" and use the type variable name
    // to determine the correct type parameter index.
    let type_keys = mono_suffix_parse::split_mono_suffix(clone(mono_suffix))
    let key_count = len(type_keys)
    if key_count == 0 {
        return String_new()
    }
    if key_count == 1 {
        return get_unchecked(type_keys, 0)
    }
    let idx = mono_suffix_parse::mono_type_var_to_index(clone(type_var))
    if idx < 0 || idx >= key_count {
        return get_unchecked(type_keys, 0)
    }
    get_unchecked(type_keys, idx)
}
