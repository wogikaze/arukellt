//
// After mono type params are set up, re-substitute type-variable param
// locals with the concrete monomorphized type.

use std::text
use mir::lower::ctx_api_function_frame
use mir::lower::ctx_api_local_types
use mir::lower::ctx_mono_index
use mir::lower::ctx_current_storage
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_mono
use mir::lower::mono_suffix_parse
use mir::lower::return_typeinfo_names
use mir::lower_kinds
use mir::function_identity
use mir::function_param_view
use mir::function_locals_view
use mir::local_access
use mir::type_contracts
use mir::value_types

fn mir_substitute_mono_param_types(mut ctx: LowerCtx) {
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    let fn_name = function_identity::MirFunction_name(func)
    // Extract the mono type suffix from the function name (e.g. "i32" from
    // "unwrap_or_default__i32"). If no "__" separator, this is not a
    // specialized mono function — skip substitution.
    let mono_suffix = mono_suffix_parse::extract_mono_suffix(fn_name.clone())
    // Prefer the mono type parameter mapping (set up by
    // ctx_setup_mono_type_params_by_ordinal) which correctly maps
    // individual type variables to their concrete types even for
    // multi-parameter generics (e.g. T→i32, E→String).
    let has_mono_map = ctx_mono_type_params::ctx_has_mono_type_params(ctx)
    // Nested keys like Vec_i32_ were once rejected by extract_mono_suffix;
    // still allow substitution when the ordinal mono map is present.
    if mono_suffix.clone().len() == 0 && !has_mono_map {
        return
    }
    let param_count = function_param_view::MirFunction_param_count(func)
    let mut p = 0
    while p < param_count {
        // Read the local record, not the parameter record: the parameter
        // carries the signature spelling (struct:Pair:8) while the local
        // keeps the semantic generic name (?Pair:T) that substitution needs.
        let local = function_locals_view::MirFunction_local_at(func, p)
        let ty_name = local_access::MirLocal_type_name(local)
        // Handle composite type names containing type variables, e.g.
        // "?Option:T" or "?Result:T" — substitute the inner type variable
        // with the concrete monomorphized type.
        if !mono_subst_wrapped_param(ctx, p, ty_name.clone(), mono_suffix.clone(), has_mono_map) {
            mono_subst_bare_param(ctx, p, ty_name.clone(), mono_suffix.clone(), has_mono_map)
        }
        p = p + 1
    }
}

// Substitute vec:/option:/?Option: wrapped type-variable params.
// Returns true when the type name matched one of the wrapped forms
// (whether or not a concrete substitution was applied).
fn mono_subst_wrapped_param(mut ctx: LowerCtx, p: i32, ty_name: String, mono_suffix: String, has_mono_map: bool) -> bool {
    if ty_name.clone().starts_with(String_from("fnsig:")) {
        mono_subst_fnsig_param(ctx, p, ty_name.clone(), mono_suffix.clone(), has_mono_map)
        return true
    }
    if ty_name.clone().starts_with(String_from("vec:")) {
        let type_var = ty_name.clone().slice(4, ty_name.len())
        // Concrete elems (vec:i32, vec:String, vec:Point, ...) must keep their
        // annotation. Only type-variable elems (vec:T, vec:?t0, ...) are
        // rewritten from the mono suffix — otherwise "__core_*" / accidental
        // "__" names force structref-array Vec layouts (i64<-structref).
        if !mono_param_type_name_needs_subst(ctx, type_var.clone()) {
            return true
        }
        let mut concrete = resolve_concrete_type(ctx, type_var.clone(), mono_suffix.clone(), has_mono_map)
        if concrete.len() == 0 {
            concrete = resolve_nested_vec_concrete_type(ctx, type_var.clone(), mono_suffix.clone(), has_mono_map)
        }
        if concrete.len() > 0 {
            mono_set_param_gc_type(ctx, p, String_from("vec:").concat(concrete))
        }
        return true
    }
    if ty_name.clone().starts_with(String_from("option:")) || ty_name.clone().starts_with(String_from("Option:")) {
        let type_var = ty_name.clone().slice(7, ty_name.len())
        if !mono_param_type_name_needs_subst(ctx, type_var.clone()) {
            // Concrete payloads still need the canonical option: prefix.
            if ty_name.clone().starts_with(String_from("Option:")) {
                mono_set_param_gc_type(ctx, p, String_from("option:").concat(type_var))
            }
            return true
        }
        let concrete = resolve_concrete_type(ctx, type_var.clone(), mono_suffix.clone(), has_mono_map)
        if concrete.len() > 0 {
            mono_set_param_gc_type(ctx, p, String_from("option:").concat(concrete))
        }
        return true
    }
    if ty_name.clone().starts_with(String_from("?Option:")) {
        let type_var = ty_name.clone().slice(8, ty_name.len())
        if !mono_param_type_name_needs_subst(ctx, type_var.clone()) {
            // Already-concrete "?Option:String" must drop the generic marker
            // so wasm emit does not treat the whole function as unreachable.
            mono_set_param_gc_type(ctx, p, String_from("option:").concat(type_var))
            return true
        }
        let concrete = resolve_concrete_type(ctx, type_var.clone(), mono_suffix.clone(), has_mono_map)
        if concrete.len() > 0 {
            mono_set_param_gc_type(ctx, p, String_from("option:").concat(concrete))
        }
        return true
    }
    if ty_name.clone().starts_with(String_from("result:")) ||
    ty_name.clone().starts_with(String_from("Result:")) ||
    ty_name.clone().starts_with(String_from("?Result:")) {
        let rest = if ty_name.clone().starts_with(String_from("?Result:")) {
            ty_name.clone().slice(8, ty_name.len())
        } else {
            ty_name.clone().slice(7, ty_name.len())
        }
        mono_subst_result_type_args(ctx, p, rest, mono_suffix, has_mono_map)
        return true
    }
    // The signature-spine mvt override writes `hashmap:K:V` for
    // `self: HashMap<K,V>` before mono names bind; resolve each segment
    // through the same path as `?HashMap:K:V` (#691).
    if ty_name.clone().starts_with(String_from("hashmap:")) {
        mono_subst_hashmap_param(ctx, p, ty_name.clone().slice(8, ty_name.len()))
        return true
    }
    if ty_name.clone().starts_with(String_from("?")) && ty_name.clone().contains(String_from(":")) {
        return mono_subst_named_generic_param(ctx, p, ty_name.clone(), mono_suffix.clone(), has_mono_map)
    }
    false
}

// `fnsig:<param>;<return>` locals keep segment spellings so a generic
// `f: fn(T) -> U` parameter specializes to `fnsig:i32;i32` etc. Each
// segment resolves through the same concrete-type map as bare params;
// unresolved segments keep their spelling so partially bound signatures
// degrade to the declaration instead of a wrong concrete ABI (#860).
fn mono_subst_fnsig_param(mut ctx: LowerCtx, p: i32, ty_name: String, mono_suffix: String, has_mono_map: bool) {
    let rest = ty_name.clone().slice(6, ty_name.len())
    let mut out = String_from("fnsig:")
    let mut seg_start = 0
    let n = rest.len()
    let mut i = 0
    let mut changed = false
    while i <= n {
        if i == n || rest.clone().byte_at(i) == 59 {
            let seg = rest.clone().slice(seg_start, i)
            let resolved = resolve_fnsig_segment(ctx, seg.clone(), mono_suffix.clone(), has_mono_map)
            if !resolved.clone().eq(seg.clone()) {
                changed = true
            }
            out = out.concat(resolved)
            if i < n {
                out = out.concat(String_from(";"))
            }
            seg_start = i + 1
        }
        i = i + 1
    }
    if changed {
        // Keep the funcref value type: fnsig locals are (ref $callback),
        // not GC data refs — GC_REF here would mis-type ref.func stores.
        mono_set_param_fnsig_type(ctx, p, out)
    }
}

fn mono_set_param_fnsig_type(mut ctx: LowerCtx, p: i32, mono_type_name: String) {
    ctx_api_local_types::ctx_set_local_vt(ctx, p, value_types::VT_FUNCREF())
    ctx_api_local_types::ctx_set_local_type(ctx, p, mono_type_name.clone())
    ctx_api_function_frame::ctx_set_func_param_type(ctx, p, value_types::VT_FUNCREF(), mono_type_name)
}

fn resolve_fnsig_segment(ctx: LowerCtx, seg: String, mono_suffix: String, has_mono_map: bool) -> String {
    if seg.len() == 0 {
        return seg
    }
    if mono_param_type_name_needs_subst(ctx, seg.clone()) {
        let concrete = resolve_concrete_type(ctx, seg.clone(), mono_suffix.clone(), has_mono_map)
        if concrete.len() > 0 {
            return concrete
        }
        return seg
    }
    if seg.clone().contains(String_from(":")) || seg.clone().contains(String_from("<")) {
        let resolved_name = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, seg.clone())
        // `X::Item` projections resolve through the owner's Iterator::next
        // signature once the head is concrete (#860/#691).
        let assoc = ctx_mono_type_params::ctx_resolve_assoc_projection_type(ctx, seg.clone())
        if assoc.len() > 0 {
            return assoc
        }
        return resolved_name
    }
    seg
}

// Generic user-defined containers are represented as `?Box:T` until the
// function is monomorphized. The parameter remains an open enum/struct
// reference, while the type-variable mapping is used by payload lowering.
fn mono_subst_named_generic_param(mut ctx: LowerCtx, p: i32, ty_name: String, mono_suffix: String, has_mono_map: bool) -> bool {
    let first_colon = find_type_name_colon(ty_name.clone(), 1)
    if first_colon < 0 {
        return false
    }
    let base = ty_name.clone().slice(1, first_colon)
    let first_arg = ty_name.clone().slice(first_colon + 1, ty_name.len())
    if base.clone().eq(String_from("HashMap")) {
        mono_subst_hashmap_param(ctx, p, first_arg.clone())
        return true
    }
    let type_var = first_generic_type_arg(first_arg.clone())
    if type_var.len() == 0 {
        return false
    }
    let concrete = resolve_concrete_type(ctx, type_var.clone(), mono_suffix.clone(), has_mono_map)
    if concrete.len() == 0 {
        return true
    }
    // The ?Base:args spelling references the generic declaration — when a
    // non-generic user struct shadows an enum name (struct Box next to
    // prelude enum Box), unbox keeps ?Box:T meaning enum Box<T>. A base
    // that owns a generic struct decl belongs to the derive path below;
    // an enum base wins over the plain struct lookup here.
    let mut base_is_generic_struct = false
    let gcount = ctx.generic_struct_names.len()
    let mut gi = 0
    while gi < gcount {
        if ctx.generic_struct_names.get_unchecked(gi).eq(base.clone()) {
            base_is_generic_struct = true
        }
        gi = gi + 1
    }
    if !base_is_generic_struct && ctx_struct_layout::ctx_is_registered_enum_type(ctx, base.clone()) {
        mono_set_param_gc_type(ctx, p, String_from("enum:").concat(base))
        return true
    }
    // ?Pair:T inside a mono body denotes the instantiated layout
    // (Pair<String>), not the unsubstituted declaration. Resolve through
    // the mono map and register the derived layout so field access and
    // the parameter signature use the concrete struct type.
    let resolved_inst = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, ty_name.clone())
    if ctx_struct_mono::ctx_derive_generic_struct_layout(ctx, resolved_inst.clone()) {
        mono_set_param_gc_type(
            ctx,
            p,
            ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, resolved_inst)
        )
        return true
    }
    let ref_type = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, base.clone())
    let canonical = if ref_type.len() > 0 { ref_type } else { String_from("enum:").concat(base) }
    mono_set_param_gc_type(ctx, p, canonical)
    true
}

// ?HashMap:K:V params keep the builtin hashmap:<pair> local-type
// spelling so GC layout and method rewrites see the same name concrete
// map locals carry. The generic-struct derive path only knows user
// structs, so builtin pairs resolve here instead (#691).
fn mono_subst_hashmap_param(mut ctx: LowerCtx, p: i32, args: String) {
    let colon = find_type_name_colon(args.clone(), 0)
    if colon < 0 {
        return
    }
    let key_var = args.clone().slice(0, colon)
    let val_var = args.clone().slice(colon + 1, args.len())
    let key_ty = mono_hashmap_arg_type_info(ctx, key_var)
    let val_ty = mono_hashmap_arg_type_info(ctx, val_var)
    // An unresolved variable must keep the ? marker (loud unreachable)
    // rather than silently taking the si32 default of the pair lookup.
    if type_contracts::TypeInfo_tag(key_ty) == lower_kinds::TY_TYPE_VAR() ||
    type_contracts::TypeInfo_tag(val_ty) == lower_kinds::TY_TYPE_VAR() {
        return
    }
    let mut map_ty = type_contracts::TypeInfo_simple(lower_kinds::TY_HASHMAP())
    type_contracts::TypeInfo_push_type_arg(map_ty, key_ty)
    type_contracts::TypeInfo_push_type_arg(map_ty, val_ty)
    let alias = return_typeinfo_names::mir_hashmap_return_type_name_from_type_info(map_ty)
    if alias.len() > 0 {
        mono_set_param_gc_type(ctx, p, alias)
    }
}

// TypeInfo for one ?HashMap arg segment. Type variables resolve to the
// enclosing mono instance's recorded type argument by name position; the
// string mono map cannot carry fn signatures, so the TypeInfo record is
// the only source that keeps fn(i32) -> i32 (#691).
fn mono_hashmap_arg_type_info(ctx: LowerCtx, arg: String) -> TypeInfo {
    if !mono_param_type_name_needs_subst(ctx, arg.clone()) {
        return mono_hashmap_concrete_type_info(arg)
    }
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    let inst = ctx_mono_index::ctx_mono_instance_at(ctx, function_identity::MirFunction_name(func))
    let inst_args = type_contracts::MonoInstance_type_arg_count(inst)
    let count = ctx.mono_type_param_names.len()
    let mut i = 0
    while i < count && i < inst_args {
        if ctx.mono_type_param_names.get_unchecked(i).eq(arg.clone()) {
            return type_contracts::MonoInstance_type_arg_at(inst, i)
        }
        i = i + 1
    }
    type_contracts::TypeInfo_simple(lower_kinds::TY_TYPE_VAR())
}

// TypeInfo for an already-concrete ?HashMap arg spelling. Only the
// scalar/fn shapes the storage adapters support need real tags; anything
// else stays an unknown marker so the pair lookup falls back.
fn mono_hashmap_concrete_type_info(arg: String) -> TypeInfo {
    if arg.clone().eq(String_from("i32")) {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_I32())
    }
    if arg.clone().eq(String_from("String")) || arg.clone().eq(String_from("string")) {
        return type_contracts::TypeInfo_simple(lower_kinds::TY_STRING())
    }
    if arg.clone().eq(String_from("fn")) || arg.clone().eq(String_from("fnref")) ||
    arg.clone().starts_with(String_from("fn(")) ||
    arg.clone().starts_with(String_from("fn<")) ||
    arg.clone().starts_with(String_from("fnsig:")) ||
    arg.clone().starts_with(String_from("fn_")) {
        return type_contracts::TypeInfo_new(lower_kinds::TY_STRUCT(), String_from("fnref"), Vec::new<TypeInfo>())
    }
    type_contracts::TypeInfo_simple(lower_kinds::TY_TYPE_VAR())
}

fn find_type_name_colon(name: String, start: i32) -> i32 {
    let mut i = start
    while i < name.len() {
        if name.byte_at(i) == 58 {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn first_generic_type_arg(args: String) -> String {
    let mut i = 0
    while i < args.len() {
        if args.byte_at(i) == 58 {
            return args.slice(0, i)
        }
        i = i + 1
    }
    args
}

// Substitute bare type-variable params (e.g. "T" or "?T").
fn mono_subst_bare_param(mut ctx: LowerCtx, p: i32, ty_name: String, mono_suffix: String, has_mono_map: bool) {
    let mut type_var = String_new()
    if ty_name.clone().starts_with(String_from("?")) {
        type_var = ty_name.clone().slice(1, ty_name.len())
    } else if mono_param_type_name_needs_subst(ctx, ty_name.clone()) {
        // Method parameters are recorded as the bare spelling "T", while
        // older lowering paths used "?T".  Both spellings denote the same
        // generic parameter and must receive the specialized ABI type.
        type_var = ty_name.clone()
    }
    if type_var.len() == 0 {
        return
    }
    let concrete = resolve_concrete_type(ctx, type_var.clone(), mono_suffix.clone(), has_mono_map)
    if concrete.len() > 0 {
        let pvt = mono_concrete_type_vt(concrete.clone())
        // For struct/enum types, transform the concrete type
        // name the same way the return type does (e.g.
        // "Point" → "struct:Point:8") so the emitter's type
        // sig builder can use the byte-size fallback when the
        // struct is not in the gc_struct list (deduplicated by
        // sig).  Skip this for String and primitives, which
        // have their own dedicated type sigs.
        let sig_type_name = concrete.clone()
        if pvt == value_types::VT_GC_REF() {
            if !concrete.clone().eq(String_from("String")) && !concrete.clone().eq(String_from("string")) {
                sig_type_name = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, concrete.clone())
            }
        }
        ctx_api_local_types::ctx_set_local_vt(ctx, p, pvt)
        ctx_api_local_types::ctx_set_local_type(ctx, p, concrete.clone())
        ctx_api_function_frame::ctx_set_func_param_type(ctx, p, pvt, sig_type_name)
    }
}

// Resolve Result<T, E> args into canonical result:T:E for match payload
// extraction. enum:Result:T alone drops E and selects the wrong Ok field
// type on wasm32-gc (generics/result_generic).
fn mono_subst_result_type_args(
    mut ctx: LowerCtx,
    p: i32,
    rest: String,
    mono_suffix: String,
    has_mono_map: bool
) {
    let t_var = mono_suffix_parse::extract_first_type_var(rest.clone())
    let e_var = extract_result_err_type_var(rest.clone())
    let t_needs = mono_param_type_name_needs_subst(ctx, t_var.clone())
    let e_needs = e_var.len() > 0 &&
    mono_param_type_name_needs_subst(ctx, e_var.clone())
    if !t_needs && !e_needs {
        mono_set_param_gc_type(ctx, p, String_from("result:").concat(rest.clone()))
        return
    }
    let mut t_concrete = t_var.clone()
    if t_needs {
        t_concrete = resolve_concrete_type(ctx, t_var.clone(), mono_suffix.clone(), has_mono_map)
    }
    let mut e_concrete = e_var.clone()
    if e_needs {
        e_concrete = resolve_concrete_type(ctx, e_var.clone(), mono_suffix.clone(), has_mono_map)
    }
    if t_concrete.len() == 0 {
        return
    }
    if e_concrete.len() > 0 {
        mono_set_param_gc_type(
            ctx,
            p,
            String_from("result:").concat(t_concrete.clone().concat(String_from(":").concat(e_concrete)))
        )
        return
    }
    mono_set_param_gc_type(ctx, p, String_from("result:").concat(t_concrete))
}

fn extract_result_err_type_var(rest: String) -> String {
    let rlen = rest.len()
    let mut ci = 0
    while ci < rlen {
        if rest.byte_at(ci) == 58 {
            return rest.slice(ci + 1, rlen)
        }
        ci = ci + 1
    }
    String_new()
}

// Set a param local to a GC ref with the given mono type name.
fn mono_set_param_gc_type(mut ctx: LowerCtx, p: i32, mono_type_name: String) {
    ctx_api_local_types::ctx_set_local_vt(ctx, p, value_types::VT_GC_REF())
    ctx_api_local_types::ctx_set_local_type(ctx, p, mono_type_name.clone())
    ctx_api_function_frame::ctx_set_func_param_type(ctx, p, value_types::VT_GC_REF(), mono_type_name)
}

// Determine the value type (VT) for a concrete monomorphized type name.
// Primitive types map to their corresponding VT; all other types (String,
// struct, enum, vec, etc.) are GC reference types.
fn mono_concrete_type_vt(type_name: String) -> i32 {
    if type_name.clone().eq(String_from("i32")) || type_name.clone().eq(String_from("bool")) || type_name.clone().eq(String_from("char")) {
        return value_types::VT_I32()
    }
    if type_name.clone().eq(String_from("i64")) || type_name.clone().eq(String_from("u64")) {
        return value_types::VT_I64()
    }
    if type_name.clone().eq(String_from("f64")) {
        return value_types::VT_F64()
    }
    if type_name.clone().eq(String_from("f32")) {
        return value_types::VT_F32()
    }
    if type_name.clone().eq(String_from("v128")) {
        return value_types::VT_V128()
    }
    value_types::VT_GC_REF()
}

// Resolve nested generic vec element types (e.g. vec:T with T = Vec<i32>).
// When the mono suffix is a composite type key like "Vec<i32>", use it
// directly instead of splitting on "__" type parameter ordinals.
fn resolve_nested_vec_concrete_type(ctx: LowerCtx, type_var: String, mono_suffix: String, has_mono_map: bool) -> String {
    if has_mono_map {
        let resolved = ctx_mono_type_params::ctx_resolve_mono_type_param(ctx, type_var.clone())
        if resolved.len() > 0 {
            return resolved
        }
    }
    if mono_suffix.len() == 0 {
        return String_new()
    }
    if mono_suffix.clone().starts_with(String_from("Vec")) {
        return mono_suffix.clone()
    }
    let type_keys = mono_suffix_parse::split_mono_suffix(mono_suffix.clone())
    let key_count = type_keys.len()
    if key_count == 1 {
        let only = type_keys.get_unchecked(0)
        if only.clone().starts_with(String_from("Vec")) {
            return only
        }
    }
    String_new()
}

// Resolve a type variable name to its concrete monomorphized type.
// Uses the mono type parameter mapping when available, falling back to
// the function name suffix.  For multi-parameter generics the suffix
// contains multiple type keys separated by "__" (e.g. "i32__String");
// the fallback uses the type variable name to pick the right one.
fn resolve_concrete_type(ctx: LowerCtx, type_var: String, mono_suffix: String, has_mono_map: bool) -> String {
    if has_mono_map {
        let resolved = ctx_mono_type_params::ctx_resolve_mono_type_param(ctx, type_var.clone())
        if resolved.len() > 0 {
            return resolved
        }
    }
    // Fallback: split the suffix by "__" and use the type variable name
    // to determine the correct type parameter index.
    let type_keys = mono_suffix_parse::split_mono_suffix(mono_suffix.clone())
    let key_count = type_keys.len()
    if key_count == 0 {
        return String_new()
    }
    if key_count == 1 {
        return type_keys.get_unchecked(0)
    }
    let idx = mono_suffix_parse::mono_type_var_to_index(type_var.clone())
    if idx < 0 || idx >= key_count {
        return type_keys.get_unchecked(0)
    }
    type_keys.get_unchecked(idx)
}

// A local spelling that names a declared struct or enum is a concrete
// parameter type, not a type variable, even at one uppercase letter. The
// shape predicate remains the fallback for unresolved spellings (ADR-089).
fn mono_param_type_name_needs_subst(ctx: LowerCtx, name: String) -> bool {
    if ctx_struct_layout::ctx_is_registered_struct_type(ctx, name.clone()) ||
    ctx_struct_layout::ctx_is_registered_enum_type(ctx, name.clone()) {
        return false
    }
    mono_suffix_parse::is_mono_type_var_name(name.clone())
}
