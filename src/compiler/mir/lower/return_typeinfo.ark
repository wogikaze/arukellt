use std::text
use mir::typeinfo_shape
use mir::lower::return_typeinfo_names
use mir::value_types
use corehir::type_ann_node
fn mir_return_tag_from_type_info(ty: TypeInfo) -> i32 {
    typeinfo_shape::mir_type_info_tag(ty)
}

fn mir_return_tag_from_typed_fn(tf: TypedFn) -> i32 {
    mir_return_tag_from_type_info(typeinfo_shape::mir_typed_fn_return_type(tf))
}

fn mir_return_vt_from_type_info(ty: TypeInfo) -> i32 {
    // Typechecker resolves TYPE_FN ann text "fnref" as TY_STRUCT; keep FUNCREF ABI (#832).
    if mir_return_type_name_is_fnref(typeinfo_shape::mir_type_info_name(ty)) {
        return value_types::VT_FUNCREF()
    }
    let tag = mir_return_tag_from_type_info(ty)
    match tag {
        0 => value_types::VT_VOID(),
        2 => value_types::VT_I64(),
        3 => value_types::VT_F64(),
        5 => value_types::VT_REF(),
        7 => value_types::VT_VOID(),
        8 => value_types::VT_VOID(),
        9 => value_types::VT_F32(),
        11 => value_types::VT_GC_REF(),
        12 => value_types::VT_GC_REF(),
        13 => value_types::VT_GC_REF(),
        // TY_FN: every fn value is the {fnptr, env} pair, so the MIR value
        // type is FUNCREF even though the TypeInfo name is empty (#872).
        20 => value_types::VT_FUNCREF(),
        21 => value_types::VT_GC_REF(),
        22 => value_types::VT_GC_REF(),
        23 => value_types::VT_GC_REF(),
        40 => value_types::VT_V128(),
        _ => value_types::VT_I32(),
    }
}

fn mir_return_vt_from_typed_fn(tf: TypedFn) -> i32 {
    mir_return_vt_from_type_info(typeinfo_shape::mir_typed_fn_return_type(tf))
}

fn mir_return_type_name_from_type_info(ty: TypeInfo) -> String {
    if mir_return_type_name_is_fnref(typeinfo_shape::mir_type_info_name(ty)) {
        return "fnref"
    }
    let tag = mir_return_tag_from_type_info(ty)
    match tag {
        1 => {
            let name = typeinfo_shape::mir_type_info_name(ty)
            if name.len() > 0 {
                return name
            }
            "i32"
        },
        2 => {
            let name = typeinfo_shape::mir_type_info_name(ty)
            if name.len() > 0 {
                return name
            }
            "i64"
        },
        3 => {
            let name = typeinfo_shape::mir_type_info_name(ty)
            if name.len() > 0 {
                return name
            }
            "f64"
        },
        4 => {
            let name = typeinfo_shape::mir_type_info_name(ty)
            if name.len() > 0 {
                return name
            }
            "bool"
        },
        6 => "char",
        9 => {
            let name = typeinfo_shape::mir_type_info_name(ty)
            if name.len() > 0 {
                return name
            }
            "f32"
        },
        5 => {
            let name = typeinfo_shape::mir_type_info_name(ty)
            if name.len() == 0 {
                return "String"
            }
            name
        },
        10 => return_typeinfo_names::mir_vec_return_type_name_from_type_info(ty),
        11 => return_typeinfo_names::mir_option_return_type_name_from_type_info(ty),
        12 => return_typeinfo_names::mir_result_return_type_name_from_type_info(ty),
        13 => return_typeinfo_names::mir_hashmap_return_type_name_from_type_info(ty),
        21 => {
            return_typeinfo_names::mir_struct_return_type_name_from_type_info(ty)
        },
        22 => return_typeinfo_names::mir_enum_return_type_name_from_type_info(ty),
        23 => return_typeinfo_names::mir_tuple_return_type_name_from_type_info(ty),
        // TY_FN TypeInfos carry their signature in type args
        // ([params..., return]); mirror type_ann_function_ref_name so a
        // fn(A) -> R return spells fnsig:<A>;<R> and indirect-call
        // results keep their value type through the pair ABI (#872).
        20 => mir_fn_return_type_name_from_type_info(ty),
        _ => "",
    }
}

// Return-type spelling for a TY_FN TypeInfo. Type args are the parameter
// types with the return type last (resolve_type_fn_node); the segment
// names reuse the generic-inst arg spelling, which keeps nested fn types
// opaque as fnref — the same collapse the annotation path performs.
fn mir_fn_return_type_name_from_type_info(ty: TypeInfo) -> String {
    let argc = typeinfo_shape::mir_type_info_type_arg_count(ty)
    if argc == 1 {
        // Zero-param fn values carry only the return type arg. Named
        // non-scalar returns spell fnsig:;<ret> so indirect-call dests keep
        // the ref type; scalar returns keep the legacy bucket, matching
        // the annotation rule in type_ann_function_ref_name (#872).
        let ret_seg_zero = return_typeinfo_names::mir_generic_inst_arg_type_name(
            typeinfo_shape::mir_type_info_type_arg_at(ty, 0)
        )
        if ret_seg_zero.len() == 0 || type_ann_node::fn_sig_segment_is_i32_family(ret_seg_zero.clone()) {
            return String_from("fnref")
        }
        return String_from("fnsig:;").concat(ret_seg_zero)
    }
    if argc == 2 {
        let pseg = return_typeinfo_names::mir_generic_inst_arg_type_name(
            typeinfo_shape::mir_type_info_type_arg_at(ty, 0)
        )
        let rseg = return_typeinfo_names::mir_generic_inst_arg_type_name(
            typeinfo_shape::mir_type_info_type_arg_at(ty, 1)
        )
        if pseg.clone().eq(String_from("String")) && rseg.clone().eq(String_from("String")) {
            return String_from("fnrefss")
        }
        if pseg.clone().eq(String_from("String")) && rseg.clone().eq(String_from("bool")) {
            return String_from("fnrefsb")
        }
        if type_ann_node::fn_sig_segment_is_i32_family(pseg.clone()) &&
        type_ann_node::fn_sig_segment_is_i32_family(rseg.clone()) {
            return String_from("fnref")
        }
        return String_from("fnsig:").concat(pseg.clone().concat(String_from(";").concat(rseg)))
    }
    if argc > 2 {
        // Mirror the multi-param annotation rule: a named non-scalar return
        // spells fnsig:<params>;<ret> so indirect-call dests carry the real
        // type instead of collapsing to the fnref2 scalar bucket (#872).
        let ret_seg_multi = return_typeinfo_names::mir_generic_inst_arg_type_name(
            typeinfo_shape::mir_type_info_type_arg_at(ty, argc - 1)
        )
        if ret_seg_multi.len() > 0 &&
        !type_ann_node::fn_sig_segment_is_i32_family(ret_seg_multi.clone()) {
            let mut params = String_new()
            let mut pi = 0
            let mut unresolved = false
            while pi < argc - 1 {
                if pi > 0 {
                    params = params.concat(String_from(","))
                }
                let pseg = return_typeinfo_names::mir_generic_inst_arg_type_name(
                    typeinfo_shape::mir_type_info_type_arg_at(ty, pi)
                )
                if pseg.len() == 0 {
                    unresolved = true
                }
                params = params.concat(pseg)
                pi = pi + 1
            }
            if !unresolved {
                return String_from("fnsig:").concat(params.clone().concat(String_from(";").concat(ret_seg_multi)))
            }
        }
        return String_from("fnref2")
    }
    String_from("fnref")
}

fn mir_return_type_name_is_fnref(type_name: String) -> bool {
    type_name.clone().eq("fnref") ||
    type_name.clone().eq("fn") ||
    type_name.clone().starts_with("fn(")
}

// Build a return type name for enum types.  For Result, include type
// parameters (e.g. "Result_i32_String") so that match payload type
// inference can extract the Ok/Err payload types.  For other enums,
// fall back to "enum:Name".

fn mir_return_type_name_from_typed_fn(tf: TypedFn) -> String {
    let return_ty = typeinfo_shape::mir_typed_fn_return_type(tf)
    let result = mir_return_type_name_from_type_info(return_ty)
    result
}
