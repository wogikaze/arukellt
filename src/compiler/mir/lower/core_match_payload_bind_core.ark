use std::prelude::{clone, eq}
use std::text
use mir::lower::ctx_api_variants
use mir::lower::ctx_api_emit
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_struct
use mir::lower::aggregate_tuple
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_mono
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_mono_type_params
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_patterns
use mir::lower::core_match_payload_bind_types
use mir::lower::core_match_payload_bind_emit
use mir::lower::core_match_payload_type_extract
use mir::lower::core_match_payload_info
use mir::lower::match_payload_prepare
use mir::lower::match_payload_field_type
use mir::lower::stmt_let_tuple
use mir::inst_local_get
use mir::inst_local_set
use mir::value_types
fn core_emit_payload_variant_binds(
    mut ctx: LowerCtx,
    exprs: Vec<CoreHirExpr>,
    pat: CoreHirExpr,
    scrut_idx: i32,
    scrut_ok_is_f64: bool,
    scrut_ok_is_i64: bool,
    scrut_ok_is_i32: bool,
    scrut_ok_is_ref: bool
) {
    let variant_name = core_expr_shape_accessors::mir_core_expr_text(pat)
    let mut scrut_type = ctx_api_local_types::ctx_get_local_type(ctx, scrut_idx)
    let is_some_or_ok = core_match_payload_bind_types::core_match_variant_is_some_or_ok(clone(variant_name))
    let mut payload_hint = String_new()
    if is_some_or_ok {
        payload_hint = core_payload_elem_type_from_scrut(clone(scrut_type), true)
        // Bare Option / empty scrut: recover fnref from an already-registered
        // Some(_f1_fnref) layout when present (#831).
        if len(payload_hint) == 0 {
            let slot = ctx_gc_enum::ctx_gc_enum_variant_slot(ctx, clone(variant_name))
            if slot >= 0 {
                let sig = clone(get_unchecked(ctx.gc_enum_variant_sigs, slot))
                if clone(sig).contains("_f1_fnref") {
                    payload_hint = "fnref"
                    scrut_type = "option:fnref"
                    ctx_api_local_types::ctx_set_local_type(ctx, scrut_idx, clone(scrut_type))
                }
            }
        }
    }
    let mut bi = 0
    while bi < core_expr_shape_accessors::mir_core_expr_child_count(pat) {
        let bind_pat = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(pat, bi))
        if core_expr_shape_patterns::mir_core_expr_is_pat_wildcard(bind_pat) {
            bi = bi + 1
            continue
        }
        // Literal children are match conditions, not bindings (#902).
        if core_expr_shape_patterns::mir_core_expr_is_pat_literal(bind_pat) {
            bi = bi + 1
            continue
        }
        // Ident children naming a registered unit variant (Some(None))
        // are tag conditions, not bindings.
        if core_expr_shape_patterns::mir_core_expr_is_pat_ident(bind_pat) {
            let ident_name = core_expr_shape_accessors::mir_core_expr_text(bind_pat)
            if !eq(clone(ident_name), "_") && ctx_api_variants::ctx_variant_tag(ctx, clone(ident_name)) >= 0 {
                bi = bi + 1
                continue
            }
        }
        // Composite children (tuple, nested variant) load the payload
        // into an unnamed temp and destructure recursively (#902).
        let is_composite_bind = core_expr_shape_patterns::mir_core_expr_is_pat_tuple(bind_pat) ||
        core_expr_shape_patterns::mir_core_expr_is_pat_variant(bind_pat)
        let mut bind_vt = core_match_payload_bind_types::core_payload_field_vt(
            ctx,
            clone(variant_name),
            bi,
            scrut_ok_is_f64,
            scrut_ok_is_i64,
            scrut_ok_is_ref,
            clone(scrut_type)
        )
        if bi == 0 && core_match_payload_bind_types::core_payload_type_is_fnref(clone(payload_hint)) {
            bind_vt = value_types::VT_FUNCREF()
        }
        let mut bind_local = 0 - 1
        if is_composite_bind {
            bind_local = ctx_api_local_alloc::ctx_fresh_local(ctx, bind_vt)
        } else {
            bind_local = ctx_api_local_alloc::ctx_alloc_local(ctx, core_expr_shape_accessors::mir_core_expr_text(bind_pat), bind_vt)
        }
        if bind_vt == value_types::VT_FUNCREF() {
            ctx_api_local_types::ctx_set_local_type(ctx, bind_local, "fnref")
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_FUNCREF())
        } else {
            core_match_payload_bind_types::set_gc_payload_bind_type_if_needed(ctx, clone(variant_name), bind_local, bind_vt, bi)
        }
        let bind_is_ref = bind_vt == value_types::VT_GC_REF() ||
        core_match_payload_bind_types::core_payload_gc_field_is_ref(
            ctx,
            clone(variant_name),
            bi,
            clone(scrut_type)
        )
        if bind_vt != value_types::VT_FUNCREF() && bind_is_ref {
            if len(ctx_api_local_types::ctx_get_local_type(ctx, bind_local)) == 0 {
                ctx_api_local_types::ctx_set_local_type(ctx, bind_local, "enum:open")
            }
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
        }
        if bind_vt == value_types::VT_I32() && scrut_ok_is_i32 && bi == 0 {
            if core_match_payload_bind_types::core_payload_i32_name_needs_type(clone(variant_name)) {
                ctx_api_local_types::ctx_set_local_type(ctx, bind_local, "i32")
            }
        }
        core_match_payload_bind_types::set_narrow_int_payload_bind_type_if_needed(ctx, clone(variant_name), bind_local, bind_vt, bi)
        if bind_vt == value_types::VT_GC_REF() && scrut_ok_is_ref && bi == 0 {
            if core_match_payload_bind_types::core_match_variant_is_some_or_ok(clone(variant_name)) {
                if len(ctx_api_local_types::ctx_get_local_type(ctx, bind_local)) == 0 {
                    ctx_api_local_types::ctx_set_local_type(ctx, bind_local, "string")
                }
            }
        }
        // Infer concrete payload type from scrutinee type for Option/Result.
        if bi == 0 {
            core_infer_payload_bind_type(ctx, clone(variant_name), bind_local, bind_vt, scrut_idx)
        }
        // Named binds only — see the AST-side loop for the rationale.
        if !is_composite_bind && core_expr_shape_patterns::mir_core_expr_is_pat_ident(bind_pat) &&
        !eq(core_expr_shape_accessors::mir_core_expr_text(bind_pat), String_from("_")) {
            match_payload_field_type::mir_report_weak_payload_scrutinee(ctx, clone(variant_name), clone(payload_hint))
        }
        core_match_payload_bind_emit::emit_payload_field_bind(ctx, variant_name, bi, scrut_idx, bind_vt, bind_local)
        if is_composite_bind {
            core_emit_subpat_binds(ctx, exprs, bind_pat, bind_local)
        }
        bi = bi + 1
    }
}

// Load one payload field into an anonymous temp for a non-ident
// sub-pattern. Mirrors the named-bind setup so the temp carries the same
// vt and type spelling a bound payload local would (#902).
fn core_subpat_load_field(
    mut ctx: LowerCtx,
    variant_name: String,
    scrut_idx: i32,
    field_idx: i32,
    scrut_ok_is_f64: bool,
    scrut_ok_is_i64: bool,
    scrut_ok_is_i32: bool,
    scrut_ok_is_ref: bool,
    scrut_type: String
) -> i32 {
    let is_some_or_ok = core_match_payload_bind_types::core_match_variant_is_some_or_ok(clone(variant_name))
    let mut payload_hint = String_new()
    if field_idx == 0 && is_some_or_ok {
        payload_hint = core_payload_elem_type_from_scrut(clone(scrut_type), true)
    }
    let mut bind_vt = core_match_payload_bind_types::core_payload_field_vt(
        ctx,
        clone(variant_name),
        field_idx,
        scrut_ok_is_f64,
        scrut_ok_is_i64,
        scrut_ok_is_ref,
        clone(scrut_type)
    )
    if field_idx == 0 && core_match_payload_bind_types::core_payload_type_is_fnref(clone(payload_hint)) {
        bind_vt = value_types::VT_FUNCREF()
    }
    let temp = ctx_api_local_alloc::ctx_fresh_local(ctx, bind_vt)
    if bind_vt == value_types::VT_FUNCREF() {
        ctx_api_local_types::ctx_set_local_type(ctx, temp, "fnref")
        ctx_api_local_types::ctx_set_local_vt(ctx, temp, value_types::VT_FUNCREF())
    } else {
        core_match_payload_bind_types::set_gc_payload_bind_type_if_needed(ctx, clone(variant_name), temp, bind_vt, field_idx)
    }
    let bind_is_ref = bind_vt == value_types::VT_GC_REF() ||
    core_match_payload_bind_types::core_payload_gc_field_is_ref(
        ctx,
        clone(variant_name),
        field_idx,
        clone(scrut_type)
    )
    if bind_vt != value_types::VT_FUNCREF() && bind_is_ref {
        if len(ctx_api_local_types::ctx_get_local_type(ctx, temp)) == 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, temp, "enum:open")
        }
        ctx_api_local_types::ctx_set_local_vt(ctx, temp, value_types::VT_GC_REF())
    }
    if bind_vt == value_types::VT_I32() && scrut_ok_is_i32 && field_idx == 0 {
        if core_match_payload_bind_types::core_payload_i32_name_needs_type(clone(variant_name)) {
            ctx_api_local_types::ctx_set_local_type(ctx, temp, "i32")
        }
    }
    if bind_vt == value_types::VT_GC_REF() && scrut_ok_is_ref && field_idx == 0 {
        if core_match_payload_bind_types::core_match_variant_is_some_or_ok(clone(variant_name)) {
            if len(ctx_api_local_types::ctx_get_local_type(ctx, temp)) == 0 {
                ctx_api_local_types::ctx_set_local_type(ctx, temp, "string")
            }
        }
    }
    if field_idx == 0 {
        core_infer_payload_bind_type(ctx, clone(variant_name), temp, bind_vt, scrut_idx)
    }
    // Declared-field types keep the nested value's own type name (an enum
    // or tuple payload) so deeper tag/payload reads resolve layouts the
    // Option/Result inference would not see (#902).
    if len(ctx_api_local_types::ctx_get_local_type(ctx, temp)) == 0 {
        let declared = ctx_mono_type_params::ctx_resolve_mono_type_name(
            ctx,
            ctx_struct_field_type::ctx_struct_field_type_name(ctx, clone(variant_name), field_idx + 1)
        )
        if len(declared) > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, temp, declared)
        }
    }
    core_match_payload_bind_emit::emit_payload_field_bind(ctx, variant_name, field_idx, scrut_idx, bind_vt, temp)
    temp
}

// Bind every binding sub-pattern under a composite payload child whose
// value already sits in val_idx (#902).
fn core_emit_subpat_binds(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, pat: CoreHirExpr, val_idx: i32) {
    if core_expr_shape_patterns::mir_core_expr_is_pat_ident(pat) {
        let name = core_expr_shape_accessors::mir_core_expr_text(pat)
        if eq(clone(name), "_") {
            return
        }
        if ctx_api_variants::ctx_variant_tag(ctx, clone(name)) >= 0 {
            return
        }
        let bind_vt = ctx_api_local_types::ctx_local_vt(ctx, val_idx)
        let bind_local = ctx_api_local_alloc::ctx_alloc_local(ctx, clone(name), bind_vt)
        let val_type = ctx_api_local_types::ctx_get_local_type(ctx, val_idx)
        if len(val_type) > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, bind_local, clone(val_type))
        }
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(val_idx))
        ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set(bind_local))
        return
    }
    if core_expr_shape_patterns::mir_core_expr_is_pat_tuple(pat) {
        let elem_count = core_expr_shape_accessors::mir_core_expr_child_count(pat)
        let mut ei = 0
        while ei < elem_count {
            let elem = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(pat, ei))
            if core_expr_shape_patterns::mir_core_expr_is_pat_ident(elem) ||
            core_expr_shape_patterns::mir_core_expr_is_pat_variant(elem) ||
            core_expr_shape_patterns::mir_core_expr_is_pat_tuple(elem) {
                let elem_local = stmt_let_tuple::emit_tuple_element_extract(ctx, val_idx, ei, elem_count)
                core_emit_subpat_binds(ctx, exprs, elem, elem_local)
            }
            ei = ei + 1
        }
        return
    }
    if core_expr_shape_patterns::mir_core_expr_is_pat_variant(pat) {
        let variant_name = core_expr_shape_accessors::mir_core_expr_text(pat)
        let scrut_type = ctx_api_local_types::ctx_get_local_type(ctx, val_idx)
        let is_f64 = match_payload_prepare::mir_option_result_scrut_type_is_f64(clone(scrut_type))
        let is_i64 = match_payload_prepare::mir_option_result_scrut_type_is_i64(clone(scrut_type))
        let is_i32 = match_payload_prepare::mir_option_result_scrut_type_is_i32(clone(scrut_type))
        let is_ref = core_match_payload_info::core_scrut_type_is_ref(clone(scrut_type))
        let mut bi = 0
        while bi < core_expr_shape_accessors::mir_core_expr_child_count(pat) {
            let bind_pat = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(pat, bi))
            if core_expr_shape_patterns::mir_core_expr_is_pat_wildcard(bind_pat) ||
            core_expr_shape_patterns::mir_core_expr_is_pat_literal(bind_pat) {
                bi = bi + 1
                continue
            }
            let field_local = core_subpat_load_field(ctx, clone(variant_name), val_idx, bi, is_f64, is_i64, is_i32, is_ref, clone(scrut_type))
            if core_expr_shape_patterns::mir_core_expr_is_pat_ident(bind_pat) &&
            !eq(core_expr_shape_accessors::mir_core_expr_text(bind_pat), String_from("_")) {
                let subpat_hint = if bi == 0 {
                    core_payload_elem_type_from_scrut(clone(scrut_type), core_match_payload_bind_types::core_match_variant_is_some_or_ok(clone(variant_name)))
                } else {
                    String_new()
                }
                match_payload_field_type::mir_report_weak_payload_scrutinee(ctx, clone(variant_name), subpat_hint)
            }
            core_emit_subpat_binds(ctx, exprs, bind_pat, field_local)
            bi = bi + 1
        }
    }
}

// Extract the concrete payload element type from the scrutinee type name.
// When scrutinee has type "option:Token" or "Option_Token", bind local should get "Token".
// When scrutinee has type "Result_i32_String", Ok bind should get "i32", Err bind should get "String".
fn core_payload_elem_type_from_scrut(scrut_type: String, is_some_or_ok: bool) -> String {
    if is_some_or_ok {
        // Normalize Vec_/Vec<T> → vec:T like Result Ok extraction so
        // Option_Vec / option:Vec binds resolve get/push (not bare Vec).
        if clone(scrut_type).starts_with("option:") {
            return core_match_payload_type_extract::normalize_payload_elem_type_name(
                scrut_type.slice(7, len(scrut_type))
            )
        }
        if clone(scrut_type).starts_with("Option_") {
            return core_match_payload_type_extract::normalize_payload_elem_type_name(
                scrut_type.slice(7, len(scrut_type))
            )
        }
        if clone(scrut_type).starts_with("Option:") {
            return core_match_payload_type_extract::normalize_payload_elem_type_name(
                scrut_type.slice(7, len(scrut_type))
            )
        }
        if clone(scrut_type).starts_with("Result_") || clone(scrut_type).starts_with("result:") {
            return core_match_payload_type_extract::core_extract_first_result_type_param(scrut_type)
        }
        return String_new()
    }
    if clone(scrut_type).starts_with("Result_") || clone(scrut_type).starts_with("result:") {
        return core_match_payload_type_extract::core_extract_second_result_type_param(scrut_type)
    }
    String_new()
}

fn core_infer_payload_set_type(mut ctx: LowerCtx, elem_ty: String) -> String {
    // For non-scalar, non-String types (e.g. AppError),
    // prefix with "enum:" so the emitter's ref local type
    // inference maps it to the enum open type.
    // However, types that already have a recognised ref
    // prefix (vec:, hashmap:, Option_, Result_, option:,
    // result:) should NOT be prefixed with "enum:" because
    // the emitter has dedicated GC type mappings for them.
    // Named GC structs keep their bare name for gcsref (#726).
    if core_match_payload_bind_types::core_payload_type_is_fnref(clone(elem_ty)) {
        return "fnref"
    }
    let mut set_type = clone(elem_ty)
    if !core_match_payload_bind_types::core_payload_scalar_type_name(clone(elem_ty)) {
        if !eq(clone(elem_ty), "String") && !eq(clone(elem_ty), "string") {
            if clone(elem_ty).starts_with("tuple:") {
                // Tuple payloads keep the tuple:<k,...> layout name and must
                // have the GC struct registered before emit resolves the
                // Some-bind local type (#890 Option<(A, B)>).
                aggregate_tuple::ctx_register_tuple_gc_struct_from_keys(
                    ctx,
                    clone(elem_ty).slice(6, len(elem_ty))
                )
                return set_type
            }
            if !clone(elem_ty).starts_with("vec:") &&
            !clone(elem_ty).starts_with("Vec<") &&
            !clone(elem_ty).starts_with("Vec_") &&
            !eq(clone(elem_ty), "Vec") &&
            !clone(elem_ty).starts_with("hashmap:") &&
            !clone(elem_ty).starts_with("Option_") &&
            !clone(elem_ty).starts_with("option:") &&
            !clone(elem_ty).starts_with("Option<") &&
            !clone(elem_ty).starts_with("Result_") &&
            !clone(elem_ty).starts_with("result:") &&
            !clone(elem_ty).starts_with("Result<") {
                // Struct payloads keep their layout name so field access can
                // resolve indices; GC struct slots only exist on GC targets,
                // so the layout registry must also accept a bare struct name.
                // Generic instantiations derive the substituted layout first.
                let derived = ctx_struct_mono::ctx_derive_generic_struct_type_name(ctx, clone(elem_ty))
                if ctx_gc_struct::ctx_gc_struct_slot(ctx, clone(derived)) < 0 &&
                !ctx_struct_layout::ctx_is_registered_struct_type(ctx, clone(derived)) {
                    set_type = "enum:".concat(clone(elem_ty))
                } else {
                    set_type = derived
                }
            }
        }
    }
    set_type
}

// Infer the concrete payload type for the first bind of Some/Ok/Err patterns
// from the scrutinee's type name, then fix up the local's type and vt.
fn core_infer_payload_bind_type(mut ctx: LowerCtx, variant_name: String, bind_local: i32, bind_vt: i32, scrut_idx: i32) {
    let is_some_or_ok = core_match_payload_bind_types::core_match_variant_is_some_or_ok(clone(variant_name))
    let is_err = core_match_payload_bind_types::core_match_variant_is_err(clone(variant_name))
    if !is_some_or_ok && !is_err {
        return
    }
    // Override when type is empty, "enum:open", or contains an
    // unresolved type variable.  Also override the "string"
    // fallback set by set_gc_payload_bind_type_if_needed for Err
    // variants, so that non-String Err payloads (e.g. AppError)
    // get the correct type.
    let current_type = ctx_api_local_types::ctx_get_local_type(ctx, bind_local)
    if !(len(current_type) == 0 || eq(current_type, "enum:open") || current_type.starts_with("enum:") || (is_err && eq(current_type, "string"))) {
        return
    }
    let scrut_type = ctx_api_local_types::ctx_get_local_type(ctx, scrut_idx)
    let elem_ty = core_payload_elem_type_from_scrut(scrut_type, is_some_or_ok)
    if len(elem_ty) == 0 {
        return
    }
    let mut set_type = core_infer_payload_set_type(ctx, clone(elem_ty))
    if eq(clone(elem_ty), "unit") || eq(clone(elem_ty), "()") || eq(clone(elem_ty), "void") {
        set_type = "i32"
    }
    if core_match_payload_bind_types::core_payload_type_is_fnref(clone(elem_ty)) {
        ctx_api_local_types::ctx_set_local_type(ctx, bind_local, "fnref")
        ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_FUNCREF())
        return
    }
    ctx_api_local_types::ctx_set_local_type(ctx, bind_local, set_type)
    // Fix vt for scalars: preserve i64/f64 width (#726 debug_vec).
    if core_match_payload_bind_types::core_payload_scalar_type_name(clone(elem_ty)) {
        if eq(clone(elem_ty), "i64") || eq(clone(elem_ty), "I64") {
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_I64())
        } else if eq(clone(elem_ty), "f64") || eq(clone(elem_ty), "F64") {
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_F64())
        } else {
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_I32())
        }
    } else {
        // Non-scalar types (String, Vec, etc.) are GC refs
        // on GC targets.  Override VT_I32 to VT_GC_REF so
        // that the local is declared as a ref and the enum
        // variant is created with a ref field.  This is
        // critical when core_payload_gc_field_is_ref could
        // not detect the ref type because the variant was
        // previously registered with an i32 payload.
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
        }
    }
}
