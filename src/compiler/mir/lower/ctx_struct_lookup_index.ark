use mir::lower::ctx_struct_storage
fn ctx_field_index(ctx: LowerCtx, struct_name: String, field_name: String) -> i32 {
    let li = ctx_struct_storage::ctx_struct_layout_preferred_index(ctx, struct_name.clone())
    if li < 0 {
        return 0
    }
    let offset = ctx_struct_storage::ctx_struct_layout_field_offset_at(ctx, li)
    let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, li)
    let mut fi = 0
    while fi < fc {
        let fn_name = ctx_struct_storage::ctx_struct_field_name_at_offset(ctx, offset + fi)
        if fn_name.clone().eq(field_name.clone()) {
            return fi
        }
        fi = fi + 1
    }
    0
}

fn ctx_field_index_any(ctx: LowerCtx, field_name: String) -> i32 {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut offset = 0
    let mut si = 0
    while si < sc {
        let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si)
        let mut fi = 0
        while fi < fc {
            let fn_name = ctx_struct_storage::ctx_struct_field_name_at_offset(ctx, offset + fi)
            if fn_name.clone().eq(field_name.clone()) {
                return fi
            }
            fi = fi + 1
        }
        offset = offset + fc
        si = si + 1
    }
    0
}

fn ctx_field_owner_struct_name(ctx: LowerCtx, field_name: String) -> String {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut offset = 0
    let mut si = 0
    while si < sc {
        let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si)
        let mut fi = 0
        while fi < fc {
            let fn_name = ctx_struct_storage::ctx_struct_field_name_at_offset(ctx, offset + fi)
            if fn_name.clone().eq(field_name.clone()) {
                return ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
            }
            fi = fi + 1
        }
        offset = offset + fc
        si = si + 1
    }
    String_new()
}
