use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_variants
use mir::lower::ctx_types
use mir::inst_local_set
use mir::lower::body_call_variant
use mir::lower::core_expr_shape_atoms
use mir::lower::core_names
use mir::lower::core_expr_shape_accessors
use mir::lower::value_variants
use mir::lower::variants
use mir::value_types
fn lower_core_payload_variant_call(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, expr: CoreHirExpr) -> i32 {
    let child_count = core_expr_shape_accessors::mir_core_expr_child_count(expr)
    let raw_name = core_expr_shape_accessors::mir_core_expr_text(expr)
    let canon = ctx_api_variants::ctx_canonical_variant_name(ctx, raw_name.clone())
    let variant_name = if canon.len() > 0 {
        canon
    } else {
        raw_name
    }
    let var_tag = ctx_api_variants::ctx_variant_tag(ctx, variant_name.clone())
    if var_tag < 0 || child_count <= 1 {
        return 0 - 2
    }
    let mut payload_locals = Vec::new<i32>()
    let mut payload_vts = Vec::new<i32>()
    let struct_bytes = ctx_struct_byte_size(ctx, variant_name.clone())
    let mut total_bytes = 4
    let mut pa = 1
    while pa < child_count {
        let parg_index = core_expr_shape_accessors::mir_core_expr_child(expr, pa)
        let parg_expr = exprs.get_unchecked(parg_index)
        let p_idx = if mir_core_variant_arg_is_fn_value(ctx, variant_name.clone(), parg_expr) {
            value_variants::lower_function_value(ctx, core_expr_shape_accessors::mir_core_expr_text(parg_expr))
        } else {
            lower_core_expr(ctx, exprs, parg_index)
        }
        let p_vt = ctx_api_local_types::ctx_local_vt(ctx, p_idx)
        let save_local = ctx_api_local_alloc::ctx_fresh_local(ctx, p_vt)
        let src_type = ctx_api_local_types::ctx_get_local_type(ctx, p_idx)
        if src_type.len() > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, save_local, src_type.clone())
        }
        // Keep the exact producer storage type.  Re-resolving a named enum
        // from its display name can select the wrong nominal GC type.
        ctx_api_local_types::ctx_set_local_mvt(
            ctx,
            save_local,
            ctx_api_local_types::ctx_local_mvt(ctx, p_idx)
        )
        // Never inherit the producer variant slot onto payload saves; the
        // payload value is the field contents, not the enum variant itself.
        ctx_api_local_types::ctx_set_local_variant_slot(ctx, save_local, 0 - 1)
        ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set_from(save_local, p_idx))
        payload_locals.push(save_local)
        payload_vts.push(p_vt)
        if p_vt == value_types::VT_F64() || p_vt == value_types::VT_I64() {
            total_bytes = total_bytes + 8
        } else {
            total_bytes = total_bytes + 4
        }
        pa = pa + 1
    }
    if struct_bytes > total_bytes {
        total_bytes = struct_bytes
    }
    variants::lower_payload_variant_from_locals(ctx, var_tag, payload_locals, payload_vts, total_bytes, variant_name.clone())
}

// `Some(answer)` / `Ok(answer)` / `Err(answer)` inside an enum-typed
// expected position must store the fn pair, not the scalar result of an
// implicit 0-param call.  Mirrors mir_variant_arg_is_fn_value on the AST
// path; the fn expectation is decoded from ctx.expected_struct_inst
// (#884).
fn mir_core_variant_arg_is_fn_value(ctx: LowerCtx, variant_name: String, parg: CoreHirExpr) -> bool {
    if !core_expr_shape_atoms::mir_core_expr_is_ident(parg) {
        return false
    }
    if !body_call_variant::mir_expected_enum_payload_is_fn(ctx, variant_name) {
        return false
    }
    let parg_name = core_expr_shape_accessors::mir_core_expr_text(parg)
    if ctx_api_local_alloc::ctx_lookup_local(ctx, parg_name.clone()) >= 0 {
        return false
    }
    core_names::mir_function_parameter_count(ctx, parg_name) >= 0
}
