use mir::lower::ctx_api_local_types
use mir::mono_names

// HashMap's source-level generic methods are semantic shells. Lower each
// supported pair to the existing typed adapter so GC and linear-memory targets
// share the same operation and Option/bool result contract.
fn mir_rewrite_hashmap_constructor(callee_name: String) -> String {
    if hashmap_constructor_matches(clone(callee_name), "i32", "i32") {
        return String_from("hash_map::hashmap_i32_i32_new")
    }
    if hashmap_constructor_matches(clone(callee_name), "String", "i32") {
        return String_from("hash_map::hashmap_str_i32_new")
    }
    if hashmap_constructor_matches(clone(callee_name), "i32", "String") {
        return String_from("hash_map::hashmap_i32_str_new")
    }
    if hashmap_constructor_matches(clone(callee_name), "String", "String") {
        return String_from("hash_map::hashmap_str_str_new")
    }
    if hashmap_constructor_matches(clone(callee_name), "i32", "fn") {
        return String_from("hash_map::hashmap_i32_fn_new")
    }
    if hashmap_constructor_matches(clone(callee_name), "String", "fn") {
        return String_from("hash_map::hashmap_str_fn_new")
    }
    String_new()
}

fn mir_rewrite_hashmap_method(ctx: LowerCtx, callee_name: String, receiver_idx: i32) -> String {
    if receiver_idx < 0 {
        return String_new()
    }
    let family = hashmap_family_for_type(ctx_api_local_types::ctx_get_local_type(ctx, receiver_idx))
    if len(family) == 0 {
        family = hashmap_family_for_callee(clone(callee_name))
    }
    if len(family) == 0 {
        return String_new()
    }
    let method = hashmap_method_name(clone(callee_name))
    if len(method) == 0 {
        return String_new()
    }
    if eq(clone(method), String_from("contains_key")) {
        return concat(clone(family), String_from("_contains"))
    }
    if eq(clone(method), String_from("insert")) ||
    eq(clone(method), String_from("get")) ||
    eq(clone(method), String_from("remove")) ||
    eq(clone(method), String_from("len")) ||
    eq(clone(method), String_from("keys")) ||
    eq(clone(method), String_from("is_empty")) {
        return concat(clone(family), concat(String_from("_"), method))
    }
    String_new()
}

fn mir_hashmap_target_is_adapter(callee_name: String) -> bool {
    starts_with(clone(callee_name), String_from("hash_map::hashmap_"))
}

fn hashmap_constructor_matches(callee_name: String, key_name: String, value_name: String) -> bool {
    let suffix = concat(
        String_from("__"),
        concat(key_name, concat(String_from("__"), value_name))
    )
    let safe_prefix = concat(String_from("HashMap__new"), suffix)
    let source_prefix = concat(String_from("HashMap::new"), suffix)
    let legacy_safe_prefix = concat(String_from("HashMap_new"), suffix)
    eq(clone(callee_name), safe_prefix) ||
    eq(clone(callee_name), source_prefix) ||
    eq(clone(callee_name), legacy_safe_prefix) ||
    // fn(i32) -> i32 type args mangle with the full signature spelling
    // (fn_i32_i32_), not the bare fn tag used by type names (#691).
    hashmap_constructor_matches_sig(callee_name, key_name, value_name)
}

fn hashmap_constructor_matches_sig(callee_name: String, key_name: String, value_name: String) -> bool {
    if !eq(clone(value_name), String_from("fn")) {
        return false
    }
    let suffix = concat(
        String_from("__"),
        concat(key_name, String_from("__fn_i32_i32_"))
    )
    // The incoming name may still carry the raw fn<i32,i32> spelling or the
    // HashMap:: prefix; normalize once so every variant compares equal.
    let safe = mono_names::mono_safe_name(callee_name)
    eq(clone(safe), concat(String_from("HashMap__new"), clone(suffix))) ||
    eq(clone(safe), concat(String_from("HashMap_new"), suffix))
}

fn hashmap_method_name(callee_name: String) -> String {
    if is_hashmap_method_leaf(clone(callee_name)) {
        return strip_hashmap_method_suffix(clone(callee_name))
    }
    if starts_with(clone(callee_name), String_from("HashMap::")) {
        return strip_hashmap_method_suffix(substring(callee_name, 9, len(callee_name)))
    }
    if starts_with(clone(callee_name), String_from("HashMap__")) {
        return strip_hashmap_method_suffix(substring(callee_name, 9, len(callee_name)))
    }
    String_new()
}

fn is_hashmap_method_leaf(name: String) -> bool {
    eq(clone(name), String_from("insert")) ||
    eq(clone(name), String_from("get")) ||
    eq(clone(name), String_from("contains_key")) ||
    eq(clone(name), String_from("remove")) ||
    eq(clone(name), String_from("len")) ||
    eq(clone(name), String_from("keys")) ||
    eq(clone(name), String_from("is_empty"))
}

fn strip_hashmap_method_suffix(name: String) -> String {
    let separator = index_of(clone(name), String_from("__"))
    if separator >= 0 {
        return substring(name, 0, separator)
    }
    name
}

fn hashmap_family_for_type(type_name: String) -> String {
    let normalized = hashmap_pair_alias_for_type_name(type_name)
    if eq(clone(normalized), String_from("hashmap:i32i32")) ||
    eq(clone(normalized), String_from("HashMap_i32_i32")) {
        return String_from("hash_map::hashmap_i32_i32")
    }
    if eq(clone(normalized), String_from("hashmap:si32")) ||
    eq(clone(normalized), String_from("HashMap_String_i32")) {
        return String_from("hash_map::hashmap_str_i32")
    }
    if eq(clone(normalized), String_from("hashmap:i32str")) ||
    eq(clone(normalized), String_from("HashMap_i32_String")) {
        return String_from("hash_map::hashmap_i32_str")
    }
    if eq(clone(normalized), String_from("hashmap:strstr")) ||
    eq(clone(normalized), String_from("HashMap_String_String")) {
        return String_from("hash_map::hashmap_str_str")
    }
    if eq(clone(normalized), String_from("hashmap:i32fn")) ||
    eq(clone(normalized), String_from("HashMap_i32_fn")) ||
    eq(clone(normalized), String_from("HashMap_i32_fnref")) {
        return String_from("hash_map::hashmap_i32_fn")
    }
    if eq(clone(normalized), String_from("hashmap:strfn")) ||
    eq(clone(normalized), String_from("HashMap_String_fn")) ||
    eq(clone(normalized), String_from("HashMap_String_fnref")) {
        return String_from("hash_map::hashmap_str_fn")
    }
    String_new()
}

// HashMap<i32,i32>-style instantiation spellings reach this lookup from
// monomorphized method bodies: self: HashMap<K,V> keeps the angle form
// while free-function params normalize to hashmap:<pair>. Map the
// supported pairs onto the same alias so method rewrites resolve (#691).
fn hashmap_pair_alias_for_type_name(type_name: String) -> String {
    if !starts_with(clone(type_name), String_from("HashMap<")) ||
    !ends_with(clone(type_name), String_from(">")) {
        return type_name
    }
    let inner = substring(clone(type_name), 8, len(type_name) - 1)
    let comma = hashmap_angle_comma_index(clone(inner))
    if comma < 0 {
        return type_name
    }
    let key = hashmap_angle_key_tag(substring(clone(inner), 0, comma))
    let val = hashmap_angle_val_tag(substring(clone(inner), comma + 1, len(inner)))
    if len(key) == 0 || len(val) == 0 {
        return type_name
    }
    concat(String_from("hashmap:"), concat(key, val))
}

// Index of the comma separating the two HashMap type arguments, skipping
// commas nested inside <> or () (fn-signature arguments).
fn hashmap_angle_comma_index(inner: String) -> i32 {
    let mut depth = 0
    let mut i = 0
    let n = len(inner)
    while i < n {
        let ch = byte_at(clone(inner), i)
        if ch == 60 || ch == 40 {
            depth = depth + 1
        }
        if ch == 62 || ch == 41 {
            depth = depth - 1
        }
        if ch == 44 && depth == 0 {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn hashmap_angle_seg_trim(seg: String) -> String {
    let n = len(seg)
    let mut i = 0
    while i < n && byte_at(clone(seg), i) == 32 {
        i = i + 1
    }
    substring(seg, i, n)
}

fn hashmap_angle_key_tag(seg: String) -> String {
    let s = hashmap_angle_seg_trim(seg)
    if eq(clone(s), String_from("i32")) {
        return String_from("i32")
    }
    if eq(clone(s), String_from("String")) {
        return String_from("s")
    }
    String_new()
}

fn hashmap_angle_val_tag(seg: String) -> String {
    let s = hashmap_angle_seg_trim(seg)
    if eq(clone(s), String_from("i32")) {
        return String_from("i32")
    }
    if eq(clone(s), String_from("String")) {
        return String_from("str")
    }
    // fn-valued maps share the fnref storage family; every fn spelling
    // (fn, fn(...), fn<...>, fnref, fnsig:) resolves to the same pair tag.
    if eq(clone(s), String_from("fn")) ||
    starts_with(clone(s), String_from("fn(")) ||
    starts_with(clone(s), String_from("fn<")) ||
    starts_with(clone(s), String_from("fnref")) ||
    starts_with(clone(s), String_from("fnsig:")) {
        return String_from("fn")
    }
    String_new()
}

fn hashmap_family_for_callee(callee_name: String) -> String {
    if ends_with(clone(callee_name), String_from("__i32__i32")) {
        return String_from("hash_map::hashmap_i32_i32")
    }
    if ends_with(clone(callee_name), String_from("__String__i32")) {
        return String_from("hash_map::hashmap_str_i32")
    }
    if ends_with(clone(callee_name), String_from("__i32__String")) {
        return String_from("hash_map::hashmap_i32_str")
    }
    if ends_with(clone(callee_name), String_from("__String__String")) {
        return String_from("hash_map::hashmap_str_str")
    }
    if ends_with(clone(callee_name), String_from("__i32__fn")) ||
    ends_with(mono_names::mono_safe_name(clone(callee_name)), String_from("__i32__fn_i32_i32_")) {
        return String_from("hash_map::hashmap_i32_fn")
    }
    if ends_with(clone(callee_name), String_from("__String__fn")) ||
    ends_with(mono_names::mono_safe_name(clone(callee_name)), String_from("__String__fn_i32_i32_")) {
        return String_from("hash_map::hashmap_str_fn")
    }
    String_new()
}
