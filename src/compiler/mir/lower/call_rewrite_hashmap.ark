use mir::lower::ctx_api_local_types
use mir::mono_names

// HashMap's source-level generic methods are semantic shells. The i32->i32
// pair is the flat Vec<i32> store in std::collections::hash, so its methods
// lower directly to those implementation functions. Every other supported
// pair rewrites to the non-public implementation functions in
// std::collections::hash_string / hash_fn / hash_str_fn so GC and
// linear-memory targets share one operation and Option/bool result contract.
use std::text
fn mir_rewrite_hashmap_constructor(callee_name: String) -> String {
    // Cheap gate before the spelling probes below: each probe builds
    // several concatenated candidate names, and almost every call site in
    // real programs is not a HashMap constructor at all (#851).
    if !callee_name.clone().starts_with(String_from("HashMap")) {
        return String_new()
    }
    // The CoreHIR path can drop the explicit type arguments, so match the
    // bare associated spelling as well. Every pair now has a capacity
    // constructor; the typed spellings below pick the pair-specific store
    // before this flat fallback (#917).
    if callee_name.clone().eq("HashMap::with_capacity") ||
    callee_name.clone().eq("HashMap__with_capacity") ||
    callee_name.clone().eq("HashMap_with_capacity") ||
    hashmap_constructor_matches(callee_name.clone(), "with_capacity", "i32", "i32") {
        return String_from("hashmap_with_capacity")
    }
    if hashmap_constructor_matches(callee_name.clone(), "with_capacity", "String", "i32") {
        return String_from("hash_string::hashmap_str_with_capacity")
    }
    if hashmap_constructor_matches(callee_name.clone(), "with_capacity", "i32", "String") {
        return String_from("hash_string::hashmap_i32_str_with_capacity")
    }
    if hashmap_constructor_matches(callee_name.clone(), "with_capacity", "String", "String") {
        return String_from("hash_string::hashmap_str_str_with_capacity")
    }
    if hashmap_constructor_matches(callee_name.clone(), "with_capacity", "i32", "fn") {
        return String_from("hash_fn::hashmap_i32_fn_with_capacity")
    }
    if hashmap_constructor_matches(callee_name.clone(), "with_capacity", "String", "fn") {
        return String_from("hash_str_fn::hashmap_str_fn_with_capacity")
    }
    if hashmap_constructor_matches(callee_name.clone(), "new", "i32", "i32") {
        return String_from("hashmap_new")
    }
    if hashmap_constructor_matches(callee_name.clone(), "new", "String", "i32") {
        return String_from("hash_string::hashmap_str_i32_new")
    }
    if hashmap_constructor_matches(callee_name.clone(), "new", "i32", "String") {
        return String_from("hash_string::hashmap_i32_str_new")
    }
    if hashmap_constructor_matches(callee_name.clone(), "new", "String", "String") {
        return String_from("hash_string::hashmap_str_str_new")
    }
    if hashmap_constructor_matches(callee_name.clone(), "new", "i32", "fn") {
        return String_from("hash_fn::hashmap_i32_fn_new")
    }
    if hashmap_constructor_matches(callee_name.clone(), "new", "String", "fn") {
        return String_from("hash_str_fn::hashmap_str_fn_new")
    }
    String_new()
}

fn mir_rewrite_hashmap_method(ctx: LowerCtx, callee_name: String, receiver_idx: i32) -> String {
    if receiver_idx < 0 {
        return String_new()
    }
    let family = hashmap_family_for_type(ctx_api_local_types::ctx_get_local_type(ctx, receiver_idx))
    if len(family) == 0 {
        family = hashmap_family_for_callee(callee_name.clone())
    }
    if len(family) == 0 {
        return String_new()
    }
    let method = hashmap_method_name(callee_name.clone())
    if len(method) == 0 {
        return String_new()
    }
    // `iter` and `entry` are source-level methods on the concrete pair impls,
    // not per-pair store targets; `retain` lowers to a store target and is
    // handled by the family table below. The call arrives with the generic
    // `HashMap` owner, so select the pair impl that declared it; the body
    // then lowers its `keys` / `values` / `insert` calls per pair (#974).
    if hashmap_method_is_source_level(method.clone()) {
        return hashmap_source_method_owner(family.clone(), method)
    }
    hashmap_family_method_target(family.clone(), method.clone())
}

fn hashmap_method_is_source_level(method: String) -> bool {
    method.clone().eq(String_from("iter")) ||
    method.clone().eq(String_from("entry"))
}

// Concrete pair owner for the source-level surface. The impl target name
// matches `impl_self_type_name`; fn-valued pairs share the fnref owner.
fn hashmap_source_method_owner(family: String, method: String) -> String {
    let owner = if family.clone().eq(String_from("hash::ii")) {
        String_from("HashMap_i32_i32")
    } else if family.clone().eq(String_from("hash_string::hashmap_str")) {
        String_from("HashMap_String_i32")
    } else if family.clone().eq(String_from("hash_string::hashmap_i32_str")) {
        String_from("HashMap_i32_String")
    } else if family.clone().eq(String_from("hash_string::hashmap_str_str")) {
        String_from("HashMap_String_String")
    } else if family.clone().eq(String_from("hash_fn::hashmap_i32_fn")) {
        String_from("HashMap_i32_fnref")
    } else if family.clone().eq(String_from("hash_str_fn::hashmap_str_fn")) {
        String_from("HashMap_String_fnref")
    } else {
        String_new()
    }
    if len(owner) == 0 {
        return String_new()
    }
    owner.concat(String_from("::").concat(method))
}

// Method name -> implementation spelling for one pair family. The i32->i32
// family is the only one whose implementation names do not follow
// `<family>_<method>` (get -> hashmap_get_option, len -> hashmap_size,
// entries -> hashmap_entry_pairs), so it owns a table.
fn hashmap_i32_i32_method_target(method: String) -> String {
    if method.clone().eq(String_from("insert")) {
        return String_from("hashmap_insert")
    }
    if method.clone().eq(String_from("get")) {
        return String_from("hashmap_get_option")
    }
    if method.clone().eq(String_from("contains_key")) {
        return String_from("hashmap_contains")
    }
    if method.clone().eq(String_from("remove")) {
        return String_from("hashmap_remove")
    }
    if method.clone().eq(String_from("len")) {
        return String_from("hashmap_size")
    }
    if method.clone().eq(String_from("is_empty")) {
        return String_from("hashmap_is_empty")
    }
    if method.clone().eq(String_from("keys")) {
        return String_from("hashmap_keys")
    }
    if method.clone().eq(String_from("values")) {
        return String_from("hashmap_values")
    }
    if method.clone().eq(String_from("entries")) {
        return String_from("hashmap_entry_pairs")
    }
    if method.clone().eq(String_from("capacity")) {
        return String_from("hashmap_capacity")
    }
    if method.clone().eq(String_from("reserve")) {
        return String_from("hashmap_reserve")
    }
    if method.clone().eq(String_from("try_reserve")) {
        return String_from("hashmap_try_reserve")
    }
    if method.clone().eq(String_from("shrink_to_fit")) {
        return String_from("hashmap_shrink_to_fit")
    }
    if method.clone().eq(String_from("clear")) {
        return String_from("hashmap_clear")
    }
    if method.clone().eq(String_from("drain")) {
        return String_from("hashmap_drain_pairs")
    }
    if method.clone().eq(String_from("remove_entry")) {
        return String_from("hashmap_remove_entry_pair")
    }
    if method.clone().eq(String_from("extend")) {
        return String_from("hashmap_extend")
    }
    if method.clone().eq(String_from("retain")) {
        return String_from("hashmap_retain")
    }
    String_new()
}

fn hashmap_family_method_target(family: String, method: String) -> String {
    if family.clone().eq(String_from("hash::ii")) {
        return hashmap_i32_i32_method_target(method)
    }
    // The capacity / bulk-maintenance group exists on every supported pair.
    // Non-flat families spell their targets `<family>_<method>` over the
    // compiler-managed bucket bridge; the flat i32 pair owns its own table
    // above because several of its method names do not follow that shape.
    if hashmap_method_is_capacity_group(method.clone()) {
        return family.concat(String_from("_").concat(method))
    }
    if family.clone().eq(String_from("hash_string::hashmap_str")) {
        return hashmap_str_i32_method_target(method)
    }
    if method.clone().eq(String_from("contains_key")) {
        return family.clone().concat(String_from("_contains"))
    }
    family.clone().concat(String_from("_").concat(method))
}

fn hashmap_method_is_capacity_group(method: String) -> bool {
    method.clone().eq(String_from("capacity")) ||
    method.clone().eq(String_from("reserve")) ||
    method.clone().eq(String_from("try_reserve")) ||
    method.clone().eq(String_from("shrink_to_fit")) ||
    method.clone().eq(String_from("clear")) ||
    method.clone().eq(String_from("drain")) ||
    method.clone().eq(String_from("remove_entry")) ||
    method.clone().eq(String_from("extend"))
}

// HashMap<String, i32> is the one pair whose implementation names do not
// share a single `<family>_<method>` shape: get/contains/remove/len use the
// short `hashmap_str_*` spelling while new/keys/values/entries spell the pair
// explicitly. The table keeps the lowering target names in one place.
fn hashmap_str_i32_method_target(method: String) -> String {
    if method.clone().eq(String_from("new")) {
        return String_from("hash_string::hashmap_str_i32_new")
    }
    if method.clone().eq(String_from("contains_key")) {
        return String_from("hash_string::hashmap_str_contains")
    }
    if method.clone().eq(String_from("keys")) {
        return String_from("hash_string::hashmap_str_i32_keys")
    }
    if method.clone().eq(String_from("values")) {
        return String_from("hash_string::hashmap_str_i32_values")
    }
    if method.clone().eq(String_from("entries")) {
        return String_from("hash_string::hashmap_str_i32_entries")
    }
    if method.clone().eq(String_from("retain")) {
        return String_from("hash_string::hashmap_str_retain")
    }
    text::concat(String_from("hash_string::hashmap_str_"), method)
}

fn mir_hashmap_target_is_lowering(callee_name: String) -> bool {
    // Non-public implementation targets whose short name would otherwise be
    // run through mono target resolution. The i32->i32 direct targets use the
    // bare hashmap_* emit names and resolve like the old builtin aliases.
    callee_name.clone().starts_with(String_from("hash_string::hashmap_")) ||
    callee_name.clone().starts_with(String_from("hash_fn::hashmap_")) ||
    callee_name.clone().starts_with(String_from("hash_str_fn::hashmap_"))
}

fn hashmap_constructor_matches(
    callee_name: String,
    ctor_name: String,
    key_name: String,
    value_name: String
) -> bool {
    let suffix = String_from("__").concat(key_name.concat(String_from("__").concat(value_name)))
    let safe_prefix = String_from("HashMap__").concat(ctor_name.clone().concat(suffix.clone()))
    let source_prefix = String_from("HashMap::").concat(ctor_name.clone().concat(suffix.clone()))
    let legacy_safe_prefix = String_from("HashMap_").concat(ctor_name.concat(suffix))
    callee_name.clone().eq(safe_prefix) ||
    callee_name.clone().eq(source_prefix) ||
    callee_name.clone().eq(legacy_safe_prefix) ||
    // fn(i32) -> i32 type args mangle with the full signature spelling
    // (fn_i32_i32_), not the bare fn tag used by type names (#691).
    hashmap_constructor_matches_sig(callee_name, ctor_name, key_name, value_name)
}

fn hashmap_constructor_matches_sig(
    callee_name: String,
    ctor_name: String,
    key_name: String,
    value_name: String
) -> bool {
    if !value_name.clone().eq(String_from("fn")) {
        return false
    }
    let suffix = String_from("__").concat(key_name.concat(String_from("__fn_i32_i32_")))
    // The incoming name may still carry the raw fn<i32,i32> spelling or the
    // HashMap:: prefix; normalize once so every variant compares equal.
    let safe = mono_names::mono_safe_name(callee_name)
    safe.clone().eq(String_from("HashMap__").concat(ctor_name.clone().concat(suffix.clone()))) ||
    safe.clone().eq(String_from("HashMap_").concat(ctor_name.concat(suffix)))
}

fn hashmap_method_name(callee_name: String) -> String {
    if is_hashmap_method_leaf(callee_name.clone()) {
        return strip_hashmap_method_suffix(callee_name.clone())
    }
    if callee_name.clone().starts_with(String_from("HashMap::")) {
        return strip_hashmap_method_suffix(callee_name.slice(9, len(callee_name)))
    }
    if callee_name.clone().starts_with(String_from("HashMap__")) {
        return strip_hashmap_method_suffix(callee_name.slice(9, len(callee_name)))
    }
    // The capacity / bulk methods are declared on the concrete
    // `impl HashMap<i32, i32>`; impl-method resolution can hand the call
    // over as `HashMap_i32_i32::capacity` (#917). The source-level pair
    // impls (iter / entry) register under every supported pair owner
    // (`HashMap_String_i32::iter`, `HashMap_i32_fnref::entry`), and
    // field receivers can keep the angle spelling, so strip the owner from
    // any HashMap-qualified method call.
    if callee_name.clone().starts_with(String_from("HashMap_")) ||
    callee_name.clone().starts_with(String_from("HashMap<")) {
        let separator = callee_name.clone().index_of(String_from("::"))
        if separator > 0 {
            return strip_hashmap_method_suffix(callee_name.slice(separator + 2, len(callee_name)))
        }
    }
    String_new()
}

fn is_hashmap_method_leaf(name: String) -> bool {
    name.clone().eq(String_from("insert")) ||
    name.clone().eq(String_from("get")) ||
    name.clone().eq(String_from("contains_key")) ||
    name.clone().eq(String_from("remove")) ||
    name.clone().eq(String_from("len")) ||
    name.clone().eq(String_from("keys")) ||
    name.clone().eq(String_from("values")) ||
    name.clone().eq(String_from("entries")) ||
    name.clone().eq(String_from("is_empty")) ||
    name.clone().eq(String_from("capacity")) ||
    name.clone().eq(String_from("reserve")) ||
    name.clone().eq(String_from("try_reserve")) ||
    name.clone().eq(String_from("shrink_to_fit")) ||
    name.clone().eq(String_from("clear")) ||
    name.clone().eq(String_from("drain")) ||
    name.clone().eq(String_from("remove_entry")) ||
    name.clone().eq(String_from("extend"))
}

fn strip_hashmap_method_suffix(name: String) -> String {
    let separator = name.clone().index_of(String_from("__"))
    if separator >= 0 {
        return name.slice(0, separator)
    }
    name
}

fn hashmap_family_for_type(type_name: String) -> String {
    let normalized = hashmap_pair_alias_for_type_name(type_name)
    if normalized.clone().eq(String_from("hashmap:i32i32")) ||
    normalized.clone().eq(String_from("HashMap_i32_i32")) {
        return String_from("hash::ii")
    }
    if normalized.clone().eq(String_from("hashmap:si32")) ||
    normalized.clone().eq(String_from("HashMap_String_i32")) {
        return String_from("hash_string::hashmap_str")
    }
    if normalized.clone().eq(String_from("hashmap:i32str")) ||
    normalized.clone().eq(String_from("HashMap_i32_String")) {
        return String_from("hash_string::hashmap_i32_str")
    }
    if normalized.clone().eq(String_from("hashmap:strstr")) ||
    normalized.clone().eq(String_from("HashMap_String_String")) {
        return String_from("hash_string::hashmap_str_str")
    }
    if normalized.clone().eq(String_from("hashmap:i32fn")) ||
    normalized.clone().eq(String_from("HashMap_i32_fn")) ||
    normalized.clone().eq(String_from("HashMap_i32_fnref")) {
        return String_from("hash_fn::hashmap_i32_fn")
    }
    if normalized.clone().eq(String_from("hashmap:strfn")) ||
    normalized.clone().eq(String_from("HashMap_String_fn")) ||
    normalized.clone().eq(String_from("HashMap_String_fnref")) {
        return String_from("hash_str_fn::hashmap_str_fn")
    }
    String_new()
}

// HashMap<i32,i32>-style instantiation spellings reach this lookup from
// monomorphized method bodies: self: HashMap<K,V> keeps the angle form
// while free-function params normalize to hashmap:<pair>. Map the
// supported pairs onto the same alias so method rewrites resolve (#691).
fn hashmap_pair_alias_for_type_name(type_name: String) -> String {
    if !type_name.clone().starts_with(String_from("HashMap<")) ||
    !type_name.clone().ends_with(String_from(">")) {
        return type_name
    }
    let inner = type_name.clone().slice(8, len(type_name) - 1)
    let comma = hashmap_angle_comma_index(inner.clone())
    if comma < 0 {
        return type_name
    }
    let key = hashmap_angle_key_tag(inner.clone().slice(0, comma))
    let val = hashmap_angle_val_tag(inner.clone().slice(comma + 1, len(inner)))
    if len(key) == 0 || len(val) == 0 {
        return type_name
    }
    String_from("hashmap:").concat(key.concat(val))
}

// Index of the comma separating the two HashMap type arguments, skipping
// commas nested inside <> or () (fn-signature arguments).
fn hashmap_angle_comma_index(inner: String) -> i32 {
    let mut depth = 0
    let mut i = 0
    let n = len(inner)
    while i < n {
        let ch = inner.clone().byte_at(i)
        if ch == 60 || ch == 40 {
            depth = depth + 1
        }
        if ch == 62 || ch == 41 {
            depth = depth - 1
        }
        if ch == 44 && depth == 0 {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn hashmap_angle_seg_trim(seg: String) -> String {
    let n = len(seg)
    let mut i = 0
    while i < n && seg.clone().byte_at(i) == 32 {
        i = i + 1
    }
    seg.slice(i, n)
}

fn hashmap_angle_key_tag(seg: String) -> String {
    let s = hashmap_angle_seg_trim(seg)
    if s.clone().eq(String_from("i32")) {
        return String_from("i32")
    }
    if s.clone().eq(String_from("String")) {
        return String_from("s")
    }
    String_new()
}

fn hashmap_angle_val_tag(seg: String) -> String {
    let s = hashmap_angle_seg_trim(seg)
    if s.clone().eq(String_from("i32")) {
        return String_from("i32")
    }
    if s.clone().eq(String_from("String")) {
        return String_from("str")
    }
    // fn-valued maps share the fnref storage family; every fn spelling
    // (fn, fn(...), fn<...>, fnref, fnsig:) resolves to the same pair tag.
    if s.clone().eq(String_from("fn")) ||
    s.clone().starts_with(String_from("fn(")) ||
    s.clone().starts_with(String_from("fn<")) ||
    s.clone().starts_with(String_from("fnref")) ||
    s.clone().starts_with(String_from("fnsig:")) {
        return String_from("fn")
    }
    String_new()
}

fn hashmap_family_for_callee(callee_name: String) -> String {
    if callee_name.clone().ends_with(String_from("__i32__i32")) {
        return String_from("hash::ii")
    }
    if callee_name.clone().ends_with(String_from("__String__i32")) {
        return String_from("hash_string::hashmap_str")
    }
    if callee_name.clone().ends_with(String_from("__i32__String")) {
        return String_from("hash_string::hashmap_i32_str")
    }
    if callee_name.clone().ends_with(String_from("__String__String")) {
        return String_from("hash_string::hashmap_str_str")
    }
    if callee_name.clone().ends_with(String_from("__i32__fn")) ||
    mono_names::mono_safe_name(callee_name.clone()).ends_with(String_from("__i32__fn_i32_i32_")) {
        return String_from("hash_fn::hashmap_i32_fn")
    }
    if callee_name.clone().ends_with(String_from("__String__fn")) ||
    mono_names::mono_safe_name(callee_name.clone()).ends_with(String_from("__String__fn_i32_i32_")) {
        return String_from("hash_str_fn::hashmap_str_fn")
    }
    String_new()
}

test mod "hashmap_rewrite" {
    test "constructor" {
        assert(mir_rewrite_hashmap_constructor("HashMap__new__i32__i32") == "hashmap_new")
        assert(mir_rewrite_hashmap_constructor("HashMap__with_capacity__i32__i32") == "hashmap_with_capacity")
        assert(mir_rewrite_hashmap_constructor("HashMap__with_capacity__String__i32") == "hash_string::hashmap_str_with_capacity")
        assert(mir_rewrite_hashmap_constructor("HashMap__with_capacity__i32__String") == "hash_string::hashmap_i32_str_with_capacity")
        assert(mir_rewrite_hashmap_constructor("HashMap__with_capacity__String__String") == "hash_string::hashmap_str_str_with_capacity")
        assert(mir_rewrite_hashmap_constructor("HashMap__with_capacity__i32__fn") == "hash_fn::hashmap_i32_fn_with_capacity")
        assert(mir_rewrite_hashmap_constructor("HashMap__with_capacity__String__fn") == "hash_str_fn::hashmap_str_fn_with_capacity")
    }
    test "source_level_methods_are_not_family_targets" {
        assert(hashmap_method_is_source_level(String_from("iter")))
        assert(hashmap_method_is_source_level(String_from("entry")))
        assert(hashmap_method_is_source_level(String_from("retain")) == false)
        assert(hashmap_method_is_source_level(String_from("insert")) == false)
    }
    test "store_maintenance_targets" {
        assert(hashmap_method_name("HashMap_i32_i32::capacity") == "capacity")
        assert(hashmap_method_name("capacity") == "capacity")
        assert(hashmap_family_method_target("hash::ii", "capacity") == "hashmap_capacity")
        assert(hashmap_family_method_target("hash::ii", "drain") == "hashmap_drain_pairs")
        assert(hashmap_family_method_target("hash::ii", "remove_entry") == "hashmap_remove_entry_pair")
        assert(hashmap_family_method_target("hash::ii", "extend") == "hashmap_extend")
        assert(hashmap_family_method_target("hash::ii", "retain") == "hashmap_retain")
    }
    test "store_maintenance_targets_every_pair" {
        assert(hashmap_family_method_target("hash_string::hashmap_str", "capacity") ==
            "hash_string::hashmap_str_capacity")
        assert(hashmap_family_method_target("hash_string::hashmap_str", "drain") ==
            "hash_string::hashmap_str_drain")
        assert(hashmap_family_method_target("hash_string::hashmap_i32_str", "remove_entry") ==
            "hash_string::hashmap_i32_str_remove_entry")
        assert(hashmap_family_method_target("hash_string::hashmap_str_str", "extend") ==
            "hash_string::hashmap_str_str_extend")
        assert(hashmap_family_method_target("hash_fn::hashmap_i32_fn", "try_reserve") ==
            "hash_fn::hashmap_i32_fn_try_reserve")
        assert(hashmap_family_method_target("hash_str_fn::hashmap_str_fn", "shrink_to_fit") ==
            "hash_str_fn::hashmap_str_fn_shrink_to_fit")
        assert(hashmap_family_method_target("hash_string::hashmap_str", "insert") ==
            "hash_string::hashmap_str_insert")
    }
}
