// Monomorphized user-struct layouts.
//
// A generic struct declaration registers one layout keyed by the bare decl
// name (Pair with fields typed T). Uses such as Pair<String> need a layout
// with substituted field types so GC field access and struct.new pick the
// named GC type with reference fields instead of the i32 placeholder
// fields of the unsubstituted declaration. This module derives those
// instantiated layouts lazily from the declared parameter names recorded
// in ctx.generic_struct_names / generic_struct_params.

use mir::lower::ctx_struct_storage
use mir::lower::ctx_struct_layout
use mir::lower::ctx_gc_struct
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_types
// Comma-joined declared type parameter names for a generic struct base,
// or "" when base is not a registered generic struct.
use std::text

fn ctx_generic_struct_params(ctx: LowerCtx, base: String) -> String {
    let count = len(ctx.generic_struct_names)
    let mut i = 0
    while i < count {
        if ctx.generic_struct_names.get_unchecked(i).eq(base.clone()) {
            return ctx.generic_struct_params.get_unchecked(i).clone()
        }
        i = i + 1
    }
    String_new()
}

fn ctx_struct_name_is_generic(ctx: LowerCtx, base: String) -> bool {
    len(ctx_generic_struct_params(ctx, base)) > 0
}

// Comma-joined declared type parameter names for a generic enum base, or ""
// when base is not a registered generic enum.
fn ctx_generic_enum_params(ctx: LowerCtx, base: String) -> String {
    let count = len(ctx.generic_enum_names)
    let mut i = 0
    while i < count {
        if ctx.generic_enum_names.get_unchecked(i).eq(base.clone()) {
            return ctx.generic_enum_params.get_unchecked(i).clone()
        }
        i = i + 1
    }
    String_new()
}

// Split a comma-joined declared parameter list ("T" / "K,V").
fn ctx_split_declared_params(joined: String) -> Vec<String> {
    let mut params = Vec::new<String>()
    let pn = len(joined)
    if pn == 0 {
        return params
    }
    let mut seg_start = 0
    let mut k = 0
    while k <= pn {
        if k == pn || joined.clone().byte_at(k) == 44 {
            push(params, joined.clone().slice(seg_start, k))
            seg_start = k + 1
        }
        k = k + 1
    }
    params
}

// "Pair<String>" -> "Pair"; "" when name is not a Name<args> spelling.
fn generic_inst_base_name(name: String) -> String {
    let n = len(name)
    if n < 3 || name.clone().byte_at(n - 1) != 62 {
        return String_new()
    }
    let mut depth = 0
    let mut i = 0
    while i < n {
        let ch = name.clone().byte_at(i)
        if ch == 60 {
            if depth == 0 {
                return name.clone().slice(0, i)
            }
            depth = depth + 1
        }
        if ch == 62 {
            depth = depth - 1
        }
        i = i + 1
    }
    String_new()
}

// "Pair<String,vec:i32>" -> ["String", "vec:i32"] split at top-level commas.
fn generic_inst_args(name: String) -> Vec<String> {
    let mut result = Vec::new<String>()
    let n = len(name)
    if n < 3 || name.clone().byte_at(n - 1) != 62 {
        return result
    }
    // The first '<' opens the outermost argument list. A later '<' belongs
    // to a nested argument (VecIter<Vec<i32>>) and must not be mistaken for
    // the head, or the derived layout sees a bogus argument list.
    let mut lt = 0 - 1
    let mut i = 0
    while i < n {
        if name.clone().byte_at(i) == 60 {
            lt = i
            break
        }
        i = i + 1
    }
    if lt < 0 {
        return result
    }
    let inner = name.clone().slice(lt + 1, n - 1)
    let mut depth = 0
    let mut seg_start = 0
    let m = len(inner)
    let mut j = 0
    while j <= m {
        let at_end = j == m
        let ch = if at_end { 44 } else { inner.clone().byte_at(j) }
        if !at_end && ch == 60 {
            depth = depth + 1
        }
        if !at_end && ch == 62 {
            depth = depth - 1
        }
        if (at_end || ch == 44) && depth == 0 {
            push(result, inner.clone().slice(seg_start, j))
            seg_start = j + 1
        }
        j = j + 1
    }
    result
}

// A bare tuple argument spells its elements with top-level commas
// (`VecIter<tuple:i32,i32>`), which the depth scan reads as argument
// separators. When the split yields more arguments than the declaration
// takes and exactly one argument is a bare tuple, re-join the trailing
// pieces onto that tuple. Container-nested tuples such as
// `Wrap<Vec<tuple:i32,i32>>` are already balanced by the depth scan.
// Tuple arguments can carry the storage wrapper `struct:tuple:...:size` on
// paths that start from a local type instead of an annotation.
fn generic_inst_arg_is_tuple(arg: String) -> bool {
    arg.clone().starts_with(String_from("tuple:")) ||
    arg.clone().starts_with(String_from("struct:tuple:"))
}

fn generic_inst_args_for_param_count(name: String, param_count: i32) -> Vec<String> {
    let args = generic_inst_args(name)
    if param_count <= 0 || len(args) <= param_count {
        return args
    }
    let extra = len(args) - param_count
    let mut tuple_index = 0 - 1
    let mut tuple_heads = 0
    let mut i = 0
    while i < len(args) {
        if generic_inst_arg_is_tuple(args.get_unchecked(i).clone()) {
            if tuple_index < 0 {
                tuple_index = i
            }
            tuple_heads = tuple_heads + 1
        }
        i = i + 1
    }
    if tuple_index < 0 || tuple_heads > 1 {
        return args
    }
    let mut merged = Vec::new<String>()
    let mut j = 0
    while j < len(args) {
        let mut arg = args.get_unchecked(j).clone()
        if j == tuple_index {
            let mut absorbed = 0
            while absorbed < extra && j + 1 < len(args) {
                arg = arg.concat(String_from(",").concat(args.get_unchecked(j + 1).clone()))
                j = j + 1
                absorbed = absorbed + 1
            }
        }
        push(merged, arg)
        j = j + 1
    }
    merged
}

fn type_ident_char(ch: i32) -> bool {
    (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

// A still-generic argument: bare type parameter (T), ?-prefixed variable
// (?T), or empty. Derived layouts require concrete arguments.
fn generic_arg_is_unbound(arg: String) -> bool {
    if len(arg) == 0 {
        return true
    }
    if arg.clone().starts_with(String_from("?")) {
        return true
    }
    if len(arg) == 1 {
        let ch = arg.byte_at(0)
        if ch >= 65 && ch <= 90 {
            return true
        }
    }
    false
}

// Replace whole identifier tokens equal to a declared parameter with the
// matching argument (vec:T -> vec:String, Pair<T> -> Pair<String>).
fn ctx_substitute_generic_field_type(ft: String, params: Vec<String>, args: Vec<String>) -> String {
    let n = len(ft)
    let mut out = String_new()
    let mut i = 0
    while i < n {
        let ch = ft.clone().byte_at(i)
        if !type_ident_char(ch) {
            out = out.concat(ft.clone().slice(i, i + 1))
            i = i + 1
            continue
        }
        let start = i
        while i < n && type_ident_char(ft.clone().byte_at(i)) {
            i = i + 1
        }
        let tok = ft.clone().slice(start, i)
        let mut replaced = false
        let mut pi = 0
        while pi < len(params) {
            if pi < len(args) && params.get_unchecked(pi).eq(tok.clone()) {
                out = out.concat(args.get_unchecked(pi).clone())
                replaced = true
                pi = len(params)
            }
            pi = pi + 1
        }
        if !replaced {
            out = out.concat(tok)
        }
    }
    out
}

// Derive and register the layout for inst_name (Pair<String>) from the
// generic base declaration. Idempotent; returns false when inst_name is
// not a fully concrete instantiation of a registered generic struct.
fn ctx_derive_generic_struct_layout(mut ctx: LowerCtx, inst_name: String) -> bool {
    if ctx_struct_storage::ctx_struct_layout_first_index(ctx, inst_name.clone()) >= 0 {
        // A layout registered by a non-derive path can lack its GC struct;
        // keep the derive contract "layout + GC struct exist" on GC targets.
        if ctx_gc_struct::ctx_is_gc_target(ctx) {
            let _slot = ctx_gc_struct::ctx_ensure_gc_struct_registered(ctx, inst_name.clone())
        }
        return true
    }
    let base = generic_inst_base_name(inst_name.clone())
    if len(base) == 0 {
        return false
    }
    let joined = ctx_generic_struct_params(ctx, base.clone())
    if len(joined) == 0 {
        return false
    }
    let params = ctx_split_declared_params(joined.clone())
    let args = generic_inst_args_for_param_count(inst_name.clone(), len(params))
    if len(args) != len(params) || len(args) == 0 {
        return false
    }
    let mut ai = 0
    while ai < len(args) {
        if generic_arg_is_unbound(args.get_unchecked(ai).clone()) {
            return false
        }
        ai = ai + 1
    }
    // Copy the base layout with substituted field types.
    // A generic struct may shadow an enum name (struct Box<T> vs prelude
    // enum Box); the mono derivation must read the struct layout, not the
    // enum base registered first.
    let base_index = ctx_struct_storage::ctx_struct_layout_struct_index(ctx, base.clone())
    if base_index < 0 {
        return false
    }
    let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, base_index)
    let base_off = ctx_struct_storage::ctx_struct_layout_field_offset_at(ctx, base_index)
    ctx_struct_storage::ctx_struct_push_layout(ctx, inst_name.clone(), fc)
    let mut fi = 0
    while fi < fc {
        let fname = ctx_struct_storage::ctx_struct_field_name_at_offset(ctx, base_off + fi)
        let fty = ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, base_off + fi)
        ctx_struct_storage::ctx_struct_push_field(
            ctx,
            fname,
            // Token substitution turns `fn(I::Item) -> I::Item` into
            // `fnsig:VecIter::Item;VecIter::Item`; resolve the remaining
            // Owner::Item projections through the owner's Iterator::next
            // signature so emit sees a concrete callback type (#860/#691).
            ctx_mono_type_params::ctx_resolve_field_type_projections(
                ctx,
                ctx_substitute_generic_field_type(fty, params, args)
            )
        )
        fi = fi + 1
    }
    if ctx_gc_struct::ctx_is_gc_target(ctx) {
        let _slot = ctx_gc_struct::ctx_ensure_gc_struct_registered(ctx, inst_name)
    }
    true
}

// Normalize a local/annotation type name to the monomorphized layout name
// and derive its layout when possible. Handles ?Wrapper:T mono-body
// spellings and Name<args> instantiations; other names pass through.
fn ctx_derive_generic_struct_type_name(mut ctx: LowerCtx, type_name: String) -> String {
    if len(type_name) == 0 {
        return type_name
    }
    // Local type names can carry the storage spelling struct:Name:id;
    // strip it so instantiation derivation sees the semantic type name.
    let semantic = ctx_struct_layout::ctx_struct_semantic_type_name(type_name)
    let resolved = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, semantic)
    if len(generic_inst_base_name(resolved.clone())) == 0 {
        return resolved
    }
    if ctx_derive_generic_struct_layout(ctx, resolved.clone()) {
        return resolved
    }
    resolved
}
