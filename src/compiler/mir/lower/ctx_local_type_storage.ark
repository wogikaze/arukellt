fn ctx_local_type_push(mut ctx: LowerCtx, local_idx: i32, type_name: String) {
    push(ctx.local_types, type_name.clone())
    push(ctx.local_type_indices, local_idx)
}

fn ctx_local_type_count(ctx: LowerCtx) -> i32 {
    ctx.local_type_indices.len()
}

fn ctx_local_type_start(ctx: LowerCtx) -> i32 {
    ctx.local_type_start
}

fn ctx_local_type_index_at(ctx: LowerCtx, index: i32) -> i32 {
    ctx.local_type_indices.get_unchecked(index)
}

fn ctx_local_type_name_at(ctx: LowerCtx, index: i32) -> String {
    ctx.local_types.get_unchecked(index).clone()
}

fn ctx_local_type_reset_for_function(mut ctx: LowerCtx) {
    ctx.local_types = Vec::new<String>()
    ctx.local_type_indices = Vec::new<i32>()
    ctx.local_type_start = ctx.local_types.len()
}

fn ctx_local_type_values(ctx: LowerCtx) -> Vec<String> {
    ctx.local_types
}

fn ctx_local_type_indices(ctx: LowerCtx) -> Vec<i32> {
    ctx.local_type_indices
}

fn ctx_local_type_restore(mut ctx: LowerCtx, local_types: Vec<String>, local_type_indices: Vec<i32>, local_type_start: i32) {
    ctx.local_types = local_types
    ctx.local_type_indices = local_type_indices
    ctx.local_type_start = local_type_start
}
