// #851 Phase 3: fused body emit — post-prune drain. Once reachability has
// compacted the module and the GC layout plan is rebuilt, every remaining
// function is optimized and emitted into per-fn byte vecs recorded on
// MirEmitArtifacts. The wasm emit phase adopts those vecs instead of
// re-emitting, so emit-order byte content is unchanged while lower still
// owns the module.
//
// The drain sees exactly what the emit phase sees: the post-prune
// function vec, post-opt MIR, and a canon table sealed by the same
// build_type_sigs + canonicalize_type_sigs run emit_type_section
// performs. canon_ensure is idempotent, so the emit-phase canonicalize
// replays as pure lookups and the emitted type section is byte-identical.

use mir::emit_artifacts
use mir::lower::emit_spec
use mir::module_canon
use mir::module_emit_artifacts
use mir::module_functions
use mir::module_gc_enum
use mir::module_gc_struct
use mir::module_spine
use mir::types
use mir_opt::optimize_module
use wasm::code_body
use wasm::ctx_record
use wasm::emit_target
use wasm::gc_layout_table
use wasm::gc_layout_table_build
use wasm::sections_types
use wasm::sections_types_sigs
use wasm::wasm_context
use wasm::wasm_start
use wasm::writer_core

fn emit_inloop_drain(mir: MirModule, spec: MirLowerEmitSpec) {
    let target = emit_spec::mir_lower_emit_spec_target(spec)
    let wasi_version = emit_spec::mir_lower_emit_spec_wasi_version(spec)
    let opt_level = emit_spec::mir_lower_emit_spec_opt_level(spec)
    let memory64 = emit_spec::mir_lower_emit_spec_memory64(spec)
    let bindings = emit_spec::mir_lower_emit_spec_bindings(spec)
    // The driver's optimize_module pipeline runs here while the module is
    // final: keeping the module-level pass preserves its pass order and
    // translation-validation reporting. Artifacts are enabled only after
    // this call so the driver's own optimize_module becomes a no-op.
    mir_opt::optimize_module(mir, opt_level, clone(target))
    let mut art = module_emit_artifacts::MirModule_emit_artifacts(mir)
    emit_artifacts::MirEmitArtifacts_enable(art)
    // Re-read after opt: the O2 passes may replace the module function vec.
    let functions = module_functions::MirModule_functions(mir)
    let fn_count = len(functions)
    // Seal the canon table with the same sig stream emit_type_section
    // builds over the post-prune module. The emit-phase canonicalize then
    // replays as lookups only — identical type_map and section bytes.
    let main_idx = wasm_start::wasm_module_start_function_index(mir, fn_count)
    let needs_wrapper = if emit_target::is_p2_wasi(clone(wasi_version)) {
        if main_idx >= 0 { 1 } else { 0 }
    } else {
        wasm_start::wasm_module_needs_start_wrapper(mir, fn_count)
    }
    let pair_sigs = sections_types_sigs::collect_pair_call_type_sigs(
        functions,
        fn_count,
        clone(target),
        memory64,
        module_gc_struct::MirModule_gc_struct_names(mir)
    )
    let type_sigs = sections_types::build_type_sigs(
        mir,
        functions,
        fn_count,
        needs_wrapper,
        clone(target),
        clone(wasi_version),
        memory64,
        bindings,
        pair_sigs
    )
    let _canon_plan = sections_types::canonicalize_type_sigs(mir, type_sigs)
    // The drain ctx shares live module state (functions, canon sigs, gc
    // name/sig vecs, signature spine) so lookups see the fully-lowered
    // module. true/false string indices stay -1: bool-literal offsets are
    // plan-tail appends carried as STR relocs, resolved on the emit ctx.
    let mut ectx = ctx_record::SelfEmitCtx_new(
        mir,
        functions,
        0 - 1,
        0 - 1,
        clone(target),
        clone(wasi_version),
        memory64,
        emit_spec::mir_lower_emit_spec_source_file(spec)
    )
    wasm_context::emit_wasm_context_set_gc_enum_variant_names(ectx, module_gc_enum::MirModule_gc_enum_variant_names(mir))
    wasm_context::emit_wasm_context_set_gc_enum_variant_sigs(ectx, module_gc_enum::MirModule_gc_enum_variant_sigs(mir))
    wasm_context::emit_wasm_context_set_gc_struct_names(ectx, module_gc_struct::MirModule_gc_struct_names(mir))
    wasm_context::emit_wasm_context_set_gc_struct_sigs(ectx, module_gc_struct::MirModule_gc_struct_sigs(mir))
    wasm_context::emit_wasm_context_set_gc_type_base(ectx, sections_types::first_gc_type_index(module_canon::MirModule_canon_sigs(mir)))
    let mut gc_struct_base = 0 - 1
    if module_gc_struct::MirModule_gc_struct_sig_count(mir) > 0 {
        gc_struct_base = get_unchecked(module_gc_struct::MirModule_gc_struct_canon_idxs(mir), 0)
    }
    wasm_context::emit_wasm_context_set_gc_struct_base(ectx, gc_struct_base)
    let mut gc_enum_variant_base = 0 - 1
    if module_gc_enum::MirModule_gc_enum_variant_sig_count(mir) > 0 {
        gc_enum_variant_base = get_unchecked(module_gc_enum::MirModule_gc_enum_variant_canon_idxs(mir), 0)
    }
    wasm_context::emit_wasm_context_set_gc_enum_variant_base(ectx, gc_enum_variant_base)
    wasm_context::emit_wasm_context_finalize_gc_indexes(ectx)
    wasm_context::emit_wasm_context_set_signature_spine(
        ectx,
        module_spine::MirModule_signature_registry(mir),
        module_spine::MirModule_type_table(mir),
        module_spine::MirModule_mono_instance_table(mir),
        module_spine::MirModule_signature_spine_populated(mir)
    )
    wasm_context::emit_wasm_context_set_pair_call_sigs(ectx, pair_sigs)
    let gc_layout = gc_layout_table::GcLayoutTable_new()
    wasm_context::emit_wasm_context_set_gc_layout_table(ectx, gc_layout)
    // Post-prune the plan's type-section slots are all final — the drain
    // runs the same all-or-ICE populate the emit phase runs.
    gc_layout_table_build::populate_gc_layout_table_for_emit(
        gc_layout,
        mir,
        ctx_record::SelfEmitCtx_gc_type_base(ectx),
        module_gc_enum::MirModule_gc_enum_variant_canon_idxs(mir),
        module_gc_struct::MirModule_gc_struct_canon_idxs(mir)
    )
    // Artifact vecs are shared with the drain ctx: body pushes land on the
    // module record directly and the emit phase adopts them unchanged —
    // every recorded index is already post-prune final.
    ectx.body_bytes = art.body_bytes
    ectx.reloc_func = art.reloc_func
    ectx.reloc_off = art.reloc_off
    ectx.reloc_kind = art.reloc_kind
    ectx.reloc_ikey = art.reloc_ikey
    ectx.reloc_ikey2 = art.reloc_ikey2
    ectx.reloc_ikey3 = art.reloc_ikey3
    ectx.reloc_skey = art.reloc_skey
    ectx.reloc_skey2 = art.reloc_skey2
    ectx.call_reloc_offs = art.call_reloc_offs
    ectx.call_reloc_fids = art.call_reloc_fids
    ectx.call_reloc_funcs = art.call_reloc_funcs
    ectx.call_reloc_names = art.call_reloc_names
    ectx.in_loop_emitted = true
    // Emit bodies in module order — identical to the emit-phase loop.
    // Per-fn timing notes stay emit-phase-only; the drain measures the
    // whole step as the lower-phase "inloop_emit" span instead.
    let mut fi = 0
    while fi < fn_count {
        let f = get_unchecked(functions, fi)
        ctx_record::SelfEmitCtx_set_current_func_idx(ectx, fi)
        let body_w = writer_core::WasmWriter_with_memory64(memory64)
        code_body::emit_function_body(body_w, f, ectx, bindings)
        push(ectx.body_bytes, writer_core::writer_bytes(body_w))
        fi = fi + 1
    }
    // Audit counters accumulate on the drain ctx — copy them so the
    // emit-phase summaries print the same totals.
    art.registry_audit_candidates = ectx.registry_audit_candidates
    art.registry_audit_matched = ectx.registry_audit_matched
    art.registry_audit_mismatched = ectx.registry_audit_mismatched
    art.registry_audit_mismatch_budget = ectx.registry_audit_mismatch_budget
    art.core_op_shadow_candidates = ectx.core_op_shadow_candidates
    art.core_op_shadow_matched = ectx.core_op_shadow_matched
    art.core_op_shadow_mismatched = ectx.core_op_shadow_mismatched
    art.core_op_shadow_unresolved = ectx.core_op_shadow_unresolved
    art.core_op_shadow_mismatch_budget = ectx.core_op_shadow_mismatch_budget
    art.gc_layout_typed_lookups = gc_layout_table::gc_layout_table_typed_lookup_count(gc_layout)
    art.gc_layout_conflicts = gc_layout_table::gc_layout_table_conflict_count(gc_layout)
}
