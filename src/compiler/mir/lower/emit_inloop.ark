// #851 Phase 3: fused body emit — pre-prune drain. Once every decl body
// (including late __fnthunk_ flushes and GC late canon) is pushed but
// BEFORE reachability compaction removes dead functions, each surviving
// body is optimized and emitted into a per-fn byte vec recorded on
// MirEmitArtifacts. The wasm emit phase adopts those vecs instead of
// re-emitting, compacting them through MirEmitArtifacts.prune_old_to_new.
//
// Ordering contract vs the emit phase:
//   - canon is sealed by running the same build_type_sigs +
//     canonicalize_type_sigs emit_type_section runs, but over the KEPT
//     function vec (marks-filtered) — identical sigs in identical order,
//     so the emit-phase canonicalize replays as pure lookups.
//   - body emit runs while the pre-prune function vec is intact, so
//     SelfEmitCtx function/name lookups resolve exactly as they do at
//     emit time; only recorded indices are pre-prune and get remapped.
//   - fid<0 calls defer by name (in_loop_emitted) so their patch lands
//     on the post-prune index at reloc-apply time.

use corehir::callee_spelling
use collections::name_index
use mir::block_inst_access
use mir::emit_artifacts
use mir::function_block_queries
use mir::inst_accessors_literals
use mir::inst_accessors_shape
use mir::inst_record
use mir::lower::ctx_call_edges
use mir::lower::ctx_gc_canon
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_struct
use mir::emit_spec
use mir::module_block_pool
use mir::module_canon
use mir::module_emit_artifacts
use mir::module_functions
use mir::module_gc_enum
use mir::module_gc_struct
use mir::module_spine
use mir::opcodes
use mir::reachability_entry
use mir::types
use mir::function_identity
use mir::function_return_view
use mir::function_locals_view
use mir::local_access
use mir::value_types
use mir_opt::optimize_fn
use wasm::call_resolve
use wasm::call_indirect
use wasm::code_body
use wasm::ctx_fid_map
use wasm::hash_aliases
use wasm::inst_ctx
use wasm::ctx_record
use wasm::ctx_gc_layout_lookup
use wasm::emit_target
use wasm::emit_rung_census
use wasm::gc_layout_table
use wasm::gc_layout_table_build
use wasm::sections_types
use wasm::sections_types_sigs
use wasm::start_names
use wasm::wasm_context
use wasm::writer_core

// Post-prune equivalent of wasm_start::wasm_module_start_function_index:
// scans the kept vec so a dead start-named fn cannot surface a stale index.
fn emit_inloop_start_fn_index(kept: Vec<MirFunction>) -> i32 {
    let mut main_idx = 0 - 1
    let mut mi = 0
    while mi < kept.len() {
        let f = kept.get_unchecked(mi)
        if start_names::is_wasm_start_function_name(function_identity::MirFunction_name(f)) {
            main_idx = mi
        }
        mi = mi + 1
    }
    main_idx
}

// Post-prune equivalent of wasm_start::wasm_module_needs_start_wrapper.
fn emit_inloop_needs_start_wrapper(kept: Vec<MirFunction>) -> i32 {
    let mut needs_wrapper = 0
    let mut i = 0
    while i < kept.len() {
        let f = kept.get_unchecked(i)
        if start_names::is_wasm_start_function_name(function_identity::MirFunction_name(f)) {
            if function_return_view::MirFunction_return_type(f) != 0 {
                needs_wrapper = 1
            }
        }
        i = i + 1
    }
    needs_wrapper
}

// --- per-push body emit (fused emit, defer strategy) ---
//
// A fn emits into art.body_bytes[mir_index] right after its per-fn post
// pass when every MIR_CALL it contains resolves to state that cannot move
// under later pushes: fid>=0 calls resolve through the fid map (immutable
// once bound), and fid<0 calls are emitted only when the name matches no
// pushed fn AND is absent from the discovery oracle — the remaining cases
// are true intrinsics whose fallback path is identical at any emit point.
// Everything else (forward module calls, CALL_REF / CALL_INDIRECT /
// WIT_CALL — whose pair/fn-type canon indices are not sealed until the
// drain) leaves an empty slot the drain fills through the same code path,
// so bytes are identical whether a body emitted at push or at drain.

fn emit_inloop_prepare(mut ctx: LowerCtx) {
    // Materialize gc registrations produced since the last push and assign
    // their canon indices. Post-seal registrations already self-materialize
    // on the module at registration; these sweeps are incremental and
    // idempotent, and late canon indices bind in late_gc_order either way.
    ctx_gc_struct::ctx_flush_gc_structs_from(ctx, 0)
    ctx_gc_enum::ctx_flush_gc_enum_variants_from(ctx, 0)
    ctx_gc_canon::ctx_gc_canon_ensure_late(ctx)
    let m = ctx.module
    let spec = ctx.emit_spec
    let mut ectx = ctx.emit_ctx
    ectx.functions = module_functions::MirModule_functions(m)
    ectx.wasi_version = emit_spec::mir_lower_emit_spec_wasi_version(spec).clone()
    ectx.memory64 = emit_spec::mir_lower_emit_spec_memory64(spec)
    ectx.source_file = emit_spec::mir_lower_emit_spec_source_file(spec)
    if !ectx.spine_populated {
        if module_spine::MirModule_signature_spine_populated(m) {
            // Bind the spine once and keep the fid consumption chains live
            // so each push folds its own fn through fn_index_drain.
            ctx_fid_map::SelfEmitCtx_bind_spine_incremental(
                ectx,
                module_spine::MirModule_signature_registry(m),
                module_spine::MirModule_type_table(m),
                module_spine::MirModule_mono_instance_table(m)
            )
        }
    }
    ctx_record::SelfEmitCtx_fn_index_drain(ectx)
    // Module gc vecs are the live objects — rebind so registrations
    // appended since the last push (or a vec swap) are visible.
    wasm_context::emit_wasm_context_set_gc_enum_variant_names(
        ectx, module_gc_enum::MirModule_gc_enum_variant_names(m))
    wasm_context::emit_wasm_context_set_gc_enum_variant_sigs(
        ectx, module_gc_enum::MirModule_gc_enum_variant_sigs(m))
    wasm_context::emit_wasm_context_set_gc_struct_names(
        ectx, module_gc_struct::MirModule_gc_struct_names(m))
    wasm_context::emit_wasm_context_set_gc_struct_sigs(
        ectx, module_gc_struct::MirModule_gc_struct_sigs(m))
    wasm_context::emit_wasm_context_set_gc_type_base(
        ectx,
        sections_types::first_gc_type_index(
            module_canon::MirModule_canon_sigs(m)))
    let mut gc_struct_base = 0 - 1
    if module_gc_struct::MirModule_gc_struct_sig_count(m) > 0 {
        gc_struct_base = module_gc_struct::MirModule_gc_struct_canon_idxs(m).get_unchecked(0)
    }
    wasm_context::emit_wasm_context_set_gc_struct_base(ectx, gc_struct_base)
    let mut gc_enum_variant_base = 0 - 1
    if module_gc_enum::MirModule_gc_enum_variant_sig_count(m) > 0 {
        gc_enum_variant_base = module_gc_enum::MirModule_gc_enum_variant_canon_idxs(m).get_unchecked(0)
    }
    wasm_context::emit_wasm_context_set_gc_enum_variant_base(
        ectx, gc_enum_variant_base)
    wasm_context::emit_wasm_context_finalize_gc_indexes(ectx)
    // Incremental layout-plan drain: a binding whose type-section slot is
    // final registers now; the rest stay pending for a later push or the
    // drain's final all-or-ICE pass. GC local typing reads this table.
    gc_layout_table_build::gc_layout_table_drain_plan(
        ctx_record::SelfEmitCtx_gc_layout_table(ectx),
        m,
        ctx_record::SelfEmitCtx_gc_type_base(ectx),
        module_gc_enum::MirModule_gc_enum_variant_canon_idxs(m),
        module_gc_struct::MirModule_gc_struct_canon_idxs(m),
        false
    )
    // Artifact vecs are shared with the drain: body pushes land on the
    // module record directly and call/body relocs ride the same
    // deferred-patch vecs the drain-bound ctx uses.
    let art = module_emit_artifacts::MirModule_emit_artifacts(m)
    ectx.body_bytes = art.body_bytes
    ectx.reloc_func = art.reloc_func
    ectx.reloc_off = art.reloc_off
    ectx.reloc_kind = art.reloc_kind
    ectx.reloc_ikey = art.reloc_ikey
    ectx.reloc_ikey2 = art.reloc_ikey2
    ectx.reloc_ikey3 = art.reloc_ikey3
    ectx.reloc_skey = art.reloc_skey
    ectx.reloc_skey2 = art.reloc_skey2
    ectx.call_reloc_offs = art.call_reloc_offs
    ectx.call_reloc_fids = art.call_reloc_fids
    ectx.call_reloc_funcs = art.call_reloc_funcs
    ectx.call_reloc_names = art.call_reloc_names
    ectx.in_loop_emitted = true
}

// Discovery-oracle probe for a fid<0 callee name: hit means a module fn
// under this spelling is or will be pushed, so the emit-time intrinsic
// fallback must not run — defer. Covers the exact, stripped, and builtin
// alias spellings resolve_fn_index tries.
fn emit_inloop_disc_hit(disc: NameIndex, name: String) -> bool {
    if name_index::name_index_get(disc, name.clone()) >= 0 {
        return true
    }
    // A loaded-module call keeps `module::Type::method`; the pushed body is
    // registered as `Type::method`. Without these variants the oracle misses
    // and the call is emitted as a permanent drop+unreachable instead of
    // being deferred to the drain.
    let variants = callee_spelling::callee_spelling_variants(name.clone())
    let mut vi = 0
    while vi < variants.len() {
        if name_index::name_index_get(disc, variants.get_unchecked(vi).clone()) >= 0 {
            return true
        }
        vi = vi + 1
    }
    let alias = hash_aliases::hashmap_builtin_alias(name.clone())
    if !alias.clone().eq(name.clone()) {
        if name_index::name_index_get(disc, alias) >= 0 {
            return true
        }
    }
    let n = name.len()
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            let stripped = name.slice(i + 1, n)
            return name_index::name_index_get(disc, stripped) >= 0
        }
        i = i - 1
    }
    false
}

fn emit_inloop_fn_emittable(ctx: LowerCtx, f: MirFunction) -> bool {
    let ectx = ctx.emit_ctx
    // Layout-plan bindings whose type-section slot is not final yet stay
    // pending between pushes. Emit-time local typing consults this table
    // (wasm_ref_type_idx_for_local / storage_ref_type_idx_for_mir_value_type
    // and every infer path layered on them); a miss that resolves at the
    // drain flips which infer branch wins, so a pushed body can diverge
    // from the drained one. Defer while any binding is still pending —
    // resolved bindings are append-stable, the drain covers the rest.
    let layout_table = ctx_record::SelfEmitCtx_gc_layout_table(ectx)
    if layout_table.plan_pending.len() > 0 {
        return false
    }
    // Storage-layout consults are miss-then-hit flippable while later
    // function bodies can still register GC types: a ref local whose
    // MirValueType has no bound table entry now may bind one by the drain,
    // switching which storage-infer branch wins (the hashmap_i32_fn_get
    // $result 14->39 drift). Bound entries are append-stable; defer only
    // the locals whose spine consult is still a miss.
    let variant_map = module_gc_enum::MirModule_gc_enum_variant_canon_idxs(ctx.module)
    let local_count = function_locals_view::MirFunction_local_count(f)
    let mut li = 0
    while li < local_count {
        let loc = function_locals_view::MirFunction_local_at(f, li)
        let lvt = local_access::MirLocal_val_type(loc)
        if lvt == value_types::VT_GC_REF() || lvt == value_types::VT_REF() {
            let mvt = local_access::MirLocal_value_type(loc)
            if ctx_gc_layout_lookup::SelfEmitCtx_wasm_storage_ref_type_idx_for_mir_value_type(ectx, mvt) < 0 {
                return false
            }
            let vs = local_access::MirLocal_variant_slot(loc)
            if vs >= variant_map.len() {
                return false
            }
        }
        li = li + 1
    }
    let disc = ctx.prop_cache.disc_names
    let fn_count = ctx_record::SelfEmitCtx_function_count(ectx)
    let bc = function_block_queries::MirFunction_block_count(f)
    let mut bi = 0
    while bi < bc {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let ic = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < ic {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            if op == opcodes::MIR_CALL_INDIRECT() ||
            op == opcodes::MIR_WIT_CALL() ||
            op == opcodes::MIR_CALL_REF() {
                return false
            }
            if op == opcodes::MIR_CALL() {
                let fid_raw = inst_record::mir_inst_func_id_raw(inst)
                if fid_raw >= 0 {
                    // Emit resolves fid through the fid map when it maps;
                    // an unmapped fid falls to the name path, whose result
                    // still shifts under later pushes — defer.
                    let mapped = ctx_record::SelfEmitCtx_mir_index_for_func_id(
                        ectx, fid_raw)
                    if mapped < 0 || mapped >= fn_count {
                        return false
                    }
                } else {
                    let callee =
                    inst_accessors_literals::MirInst_str_val(inst).clone()
                    if inst_ctx::resolve_fn_index_for_call(
                        ectx, callee.clone(), fid_raw) >= 0 {
                        return false
                    }
                    if emit_inloop_disc_hit(disc, callee) {
                        return false
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    true
}

// Slot mir_index of art.body_bytes: emit the optimized body when it is
// push-stable, else leave the empty placeholder for the drain to fill.
fn emit_inloop_push(
    ctx: LowerCtx,
    mut func: MirFunction,
    mir_index: i32,
    emittable: bool
) {
    let mut m = ctx.module
    let mut art = module_emit_artifacts::MirModule_emit_artifacts(m)
    push(art.body_bytes, Vec::new<i32>())
    if !emittable {
        return
    }
    let spec = ctx.emit_spec
    let mut ectx = ctx.emit_ctx
    ctx_record::SelfEmitCtx_set_current_func_idx(ectx, mir_index)
    let mut body_w = writer_core::WasmWriter_with_memory64(
        emit_spec::mir_lower_emit_spec_memory64(spec))
    code_body::emit_function_body(
        body_w, func, ectx,
        emit_spec::mir_lower_emit_spec_bindings(spec))
    set(art.body_bytes, mir_index, writer_core::writer_bytes(body_w))
    // Arena reset (#851 Phase 3): the emitted body is durable as wasm
    // bytes now, so its MIR blocks go back to the module pool for the
    // next lowering take. Deferred bodies stay live for the drain.
    module_block_pool::mir_function_detach_blocks(func, m)
}

fn emit_inloop_drain(
    ctx: LowerCtx,
    mut module: MirModule,
    export_roots: Vec<String>,
    prune_enabled: bool,
    spec: MirLowerEmitSpec
) {
    let target = emit_spec::mir_lower_emit_spec_target(spec)
    let wasi_version = emit_spec::mir_lower_emit_spec_wasi_version(spec)
    let opt_level = emit_spec::mir_lower_emit_spec_opt_level(spec)
    let memory64 = emit_spec::mir_lower_emit_spec_memory64(spec)
    let bindings = emit_spec::mir_lower_emit_spec_bindings(spec)
    // Per-push post passes already ran the per-fn opt pipeline on the
    // first art.opt_fn_count pushed fns (a prefix — pushes are ordered).
    // Run the same per-fn pipeline on any remainder — fns pushed outside
    // the decl-loop push paths — rather than the module pass: every pass
    // is function-local (module reads hit only the fully-populated
    // signature spine), so results match the batch run, and the prefix
    // avoids double-optimizing.
    let mut art = module_emit_artifacts::MirModule_emit_artifacts(module)
    let fns_for_opt = module_functions::MirModule_functions(module)
    let mut opt_i = art.opt_fn_count
    while opt_i < fns_for_opt.len() {
        let mut opt_f = fns_for_opt.get_unchecked(opt_i)
        let mut opt_f = mir_opt::optimize_fn(module, opt_f, opt_level, target.clone())
        module_functions::MirModule_set_function_at(module, opt_i, opt_f)
        opt_i = opt_i + 1
    }
    // Mark the module opt pipeline as consumed by the drain so the
    // driver-side optimize_module call no-ops (artifacts were enabled at
    // entry, before this drain ran).
    art.opt_done = true
    // Re-read after opt: the O2 passes may replace the module function vec.
    let functions = module_functions::MirModule_functions(module)
    let fn_count = functions.len()
    // Reachability marks over the recorded edge table — identical inputs
    // to the prune pass about to run, so the kept set is exactly what
    // emit would see post-compaction. Empty marks = no prune (all kept).
    let marks = if prune_enabled {
        reachability_entry::mir_reachability_marks_for_target_and_edges(
            module,
            export_roots,
            target.clone(),
            ctx_call_edges::ctx_edge_table(ctx),
            ctx_call_edges::ctx_edge_fn_names(ctx),
            ctx_call_edges::ctx_edge_overflow_names(ctx)
        )
    } else {
        Vec::new<i32>()
    }
    let mut kept = Vec::new<MirFunction>()
    let mut ki = 0
    while ki < fn_count {
        if marks.len() == 0 || marks.get_unchecked(ki) != 0 {
            push(kept, functions.get_unchecked(ki))
        }
        ki = ki + 1
    }
    // Seal the canon table with the sig stream emit_type_section builds
    // over the post-prune module — kept order equals pruned order, so the
    // emit-phase canonicalize replays as lookups only.
    let main_idx = emit_inloop_start_fn_index(kept)
    let needs_wrapper = if emit_target::is_p2_wasi(wasi_version.clone()) {
        if main_idx >= 0 { 1 } else { 0 }
    } else {
        emit_inloop_needs_start_wrapper(kept)
    }
    // Pair-ABI call-site sigs come from the per-push raw records: walk
    // records in push order, skip owners the prune marks dropped, and
    // derive each sig on the final gc name table. Same stream the batch
    // kept-scan produced — bodies no longer need to be alive for this.
    let gc_names = module_gc_struct::MirModule_gc_struct_names(module)
    let mut pair_sigs = Vec::new<String>()
    let mut pr = 0
    while pr < art.pair_ref_fn.len() {
        let owner = art.pair_ref_fn.get_unchecked(pr)
        if marks.len() == 0 || marks.get_unchecked(owner) != 0 {
            let sig = call_indirect::pair_call_sig_from_hint(
                art.pair_ref_hint.get_unchecked(pr).clone(),
                art.pair_ref_vt.get_unchecked(pr),
                memory64,
                gc_names.clone()
            )
            if sig.len() > 0 {
                let mut seen = false
                let mut si = 0
                while si < pair_sigs.len() {
                    if sig.clone().eq(pair_sigs.get_unchecked(si).clone()) {
                        seen = true
                    }
                    si = si + 1
                }
                if !seen {
                    push(pair_sigs, sig)
                }
            }
        }
        pr = pr + 1
    }
    // Fns pushed outside the ctx push paths (late __fnthunk_ flushes and
    // other non-decl bodies) never produced pair_ref records. Their MIR
    // bodies are still live here, so union their CALL_REF evidence the
    // same way the batch collection does — the sealed set must match
    // what the emit-phase scan would find over the kept functions.
    let mut late_kept = Vec::new<MirFunction>()
    let mut li = art.opt_fn_count
    while li < fn_count {
        if marks.len() == 0 || marks.get_unchecked(li) != 0 {
            push(late_kept, functions.get_unchecked(li))
        }
        li = li + 1
    }
    let late_pair_sigs = sections_types_sigs::collect_pair_call_type_sigs(
        late_kept,
        late_kept.len(),
        target.clone(),
        memory64,
        gc_names.clone()
    )
    let mut lsi = 0
    while lsi < late_pair_sigs.len() {
        let late_sig = late_pair_sigs.get_unchecked(lsi)
        let mut seen = false
        let mut si = 0
        while si < pair_sigs.len() {
            if late_sig.clone().eq(pair_sigs.get_unchecked(si).clone()) {
                seen = true
            }
            si = si + 1
        }
        if !seen {
            push(pair_sigs, late_sig)
        }
        lsi = lsi + 1
    }
    // Seal for the emit phase (#851 Phase 3): pushed and deferred bodies
    // detach right after their emit, so emit-phase consumers can no
    // longer re-derive this set by scanning — they replay the sealed list.
    art.pair_call_sigs = pair_sigs
    art.pair_call_sigs_final = true
    let type_sigs = sections_types::build_type_sigs(
        module,
        kept,
        kept.len(),
        needs_wrapper,
        target.clone(),
        wasi_version.clone(),
        memory64,
        bindings,
        pair_sigs
    )
    let _canon_plan = sections_types::canonicalize_type_sigs(module, type_sigs)
    // Reuse the lowering-held emit ctx (LowerCtx.emit_ctx — built on the
    // live module handles at ctx init, mir already bound). opt passes may
    // replace the module functions vec, so rebind it, then fold pushed
    // fns into the name tables via fn_index_drain — the incremental form
    // of the constructor batch build. remap_colliding_short_names runs
    // post-fold on the complete vec, same ordering as SelfEmitCtx_new.
    // true/false string indices stay -1: bool-literal offsets are
    // plan-tail appends carried as STR relocs, resolved on the emit ctx.
    let mut ectx = ctx.emit_ctx
    ectx.functions = functions
    ectx.wasi_version = wasi_version.clone()
    ectx.memory64 = memory64
    ectx.source_file = emit_spec::mir_lower_emit_spec_source_file(spec)
    ctx_record::SelfEmitCtx_fn_index_drain(ectx)
    call_resolve::call_resolve_remap_colliding_short_names(
        functions,
        ectx.function_name_index,
        ectx.function_name_counts
    )
    wasm_context::emit_wasm_context_set_gc_enum_variant_names(ectx, module_gc_enum::MirModule_gc_enum_variant_names(module))
    wasm_context::emit_wasm_context_set_gc_enum_variant_sigs(ectx, module_gc_enum::MirModule_gc_enum_variant_sigs(module))
    wasm_context::emit_wasm_context_set_gc_struct_names(ectx, module_gc_struct::MirModule_gc_struct_names(module))
    wasm_context::emit_wasm_context_set_gc_struct_sigs(ectx, module_gc_struct::MirModule_gc_struct_sigs(module))
    wasm_context::emit_wasm_context_set_gc_type_base(ectx, sections_types::first_gc_type_index(module_canon::MirModule_canon_sigs(module)))
    let mut gc_struct_base = 0 - 1
    if module_gc_struct::MirModule_gc_struct_sig_count(module) > 0 {
        gc_struct_base = module_gc_struct::MirModule_gc_struct_canon_idxs(module).get_unchecked(0)
    }
    wasm_context::emit_wasm_context_set_gc_struct_base(ectx, gc_struct_base)
    let mut gc_enum_variant_base = 0 - 1
    if module_gc_enum::MirModule_gc_enum_variant_sig_count(module) > 0 {
        gc_enum_variant_base = module_gc_enum::MirModule_gc_enum_variant_canon_idxs(module).get_unchecked(0)
    }
    wasm_context::emit_wasm_context_set_gc_enum_variant_base(ectx, gc_enum_variant_base)
    wasm_context::emit_wasm_context_finalize_gc_indexes(ectx)
    wasm_context::emit_wasm_context_set_signature_spine(
        ectx,
        module_spine::MirModule_signature_registry(module),
        module_spine::MirModule_type_table(module),
        module_spine::MirModule_mono_instance_table(module),
        module_spine::MirModule_signature_spine_populated(module)
    )
    wasm_context::emit_wasm_context_set_pair_call_sigs(ectx, pair_sigs)
    // Reuse the in-loop ctx's layout table: per-push emits already drained
    // the incremental plan into it (and accumulated lookup counters). The
    // non-fused path gets the same fresh empty table the init left.
    let mut gc_layout = ctx_record::SelfEmitCtx_gc_layout_table(ectx)
    wasm_context::emit_wasm_context_set_gc_layout_table(ectx, gc_layout)
    // The plan is built before prune (it reads only type/gc tables), so
    // every binding's type-section slot is final — same all-or-ICE
    // populate the emit phase runs.
    gc_layout_table_build::populate_gc_layout_table_for_emit(
        gc_layout,
        module,
        ctx_record::SelfEmitCtx_gc_type_base(ectx),
        module_gc_enum::MirModule_gc_enum_variant_canon_idxs(module),
        module_gc_struct::MirModule_gc_struct_canon_idxs(module)
    )
    // Artifact vecs are shared with the drain ctx: body pushes land on the
    // module record directly; the emit phase compacts through
    // prune_old_to_new since every recorded index is PRE-prune.
    ectx.body_bytes = art.body_bytes
    ectx.reloc_func = art.reloc_func
    ectx.reloc_off = art.reloc_off
    ectx.reloc_kind = art.reloc_kind
    ectx.reloc_ikey = art.reloc_ikey
    ectx.reloc_ikey2 = art.reloc_ikey2
    ectx.reloc_ikey3 = art.reloc_ikey3
    ectx.reloc_skey = art.reloc_skey
    ectx.reloc_skey2 = art.reloc_skey2
    ectx.call_reloc_offs = art.call_reloc_offs
    ectx.call_reloc_fids = art.call_reloc_fids
    ectx.call_reloc_funcs = art.call_reloc_funcs
    ectx.call_reloc_names = art.call_reloc_names
    ectx.in_loop_emitted = true
    // Emit kept bodies in pre-prune module order — identical to what the
    // emit-phase loop produces over the post-prune vec. Fns already
    // emitted at push keep their recorded bytes; empty slots (deferred
    // fns, and fns pushed outside the in-loop path) emit now. Unmarked
    // slots keep an empty entry so body_bytes stays index-aligned.
    let mut fi = 0
    while fi < fn_count {
        while ectx.body_bytes.len() <= fi {
            push(ectx.body_bytes, Vec::new<i32>())
        }
        if marks.len() == 0 || marks.get_unchecked(fi) != 0 {
            if ectx.body_bytes.get_unchecked(fi).len() == 0 {
                let mut f = functions.get_unchecked(fi)
                ctx_record::SelfEmitCtx_set_current_func_idx(ectx, fi)
                let mut body_w = writer_core::WasmWriter_with_memory64(memory64)
                code_body::emit_function_body(body_w, f, ectx, bindings)
                set(ectx.body_bytes, fi, writer_core::writer_bytes(body_w))
                // Arena reset for deferred ctx-pushed bodies (#851 Phase
                // 3): emitted here, detach now. Late fns (>= opt_fn_count)
                // never recorded body evidence, so their MIR stays live
                // until the emit-phase sweep answers opcode queries.
                if fi < art.opt_fn_count {
                    module_block_pool::mir_function_detach_blocks(f, module)
                }
            }
        }
        fi = fi + 1
    }
    // Audit counters accumulate on the drain ctx — copy them so the
    // emit-phase summaries print the same totals.
    art.registry_audit_candidates = ectx.registry_audit_candidates
    art.registry_audit_matched = ectx.registry_audit_matched
    art.registry_audit_mismatched = ectx.registry_audit_mismatched
    art.registry_audit_mismatch_budget = ectx.registry_audit_mismatch_budget
    art.core_op_shadow_candidates = ectx.core_op_shadow_candidates
    art.core_op_shadow_matched = ectx.core_op_shadow_matched
    art.core_op_shadow_mismatched = ectx.core_op_shadow_mismatched
    art.core_op_shadow_unresolved = ectx.core_op_shadow_unresolved
    art.core_op_shadow_mismatch_budget = ectx.core_op_shadow_mismatch_budget
    art.gc_layout_typed_lookups = gc_layout_table::gc_layout_table_typed_lookup_count(gc_layout)
    art.gc_layout_conflicts = gc_layout_table::gc_layout_table_conflict_count(gc_layout)
    // Phase 5.0 ladder census: the declared bodies were emitted on this ctx,
    // so its rung decisions are the ones to print. The emit-phase ctx only
    // adopts the body bytes and never runs the local-declaration ladder.
    if emit_spec::mir_lower_emit_spec_report_timing(spec) != 0 {
        emit_rung_census::emit_rung_census_print(ectx)
    }
}
