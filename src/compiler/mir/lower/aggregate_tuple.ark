use std::text
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_struct
use mir::lower::ctx_types
use mir::inst_const_i32
use mir::inst_struct_new
use mir::inst_struct_set
use mir::inst_local_get
use mir::value_types
use mir::lower::ctx_api_local_types
use mir::lower::match_payload_field_type
fn mir_emit_tuple_from_locals(mut ctx: LowerCtx, field_locals: Vec<i32>, field_vts: Vec<i32>, total_bytes: i32) -> i32 {
    let child_count = field_locals.len()
    // Empty tuple `()` is the unit value. Represent it as i32 0 so
    // `Ok(())` / `Result<(), E>` select the builtin `_f1_i32` Ok variant
    // instead of a GC struct ref that collapses to `_f1_ref0` (String).
    if child_count == 0 {
        let dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
        ctx_api_emit::ctx_emit(ctx, inst_const_i32::MirInst_const_i32(0, dest))
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "i32")
        return dest
    }
    let dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_GC_REF())
    let tuple_name = tuple_name_keys_from_field_locals(ctx, field_locals, field_vts, child_count)
    let mut struct_name = String_new()
    if tuple_field_vts_need_named_gc_struct(ctx, field_vts, child_count) {
        struct_name = tuple_name.clone()
    }
    if struct_name.len() > 0 {
        let sig = tuple_gc_sig_from_type_keys(ctx, struct_name.slice(6, struct_name.len()))
        ctx_gc_struct::ctx_register_gc_struct(ctx, struct_name.clone(), sig)
        ctx_api_emit::ctx_emit(ctx, inst_struct_new::MirInst_struct_new_named(dest, struct_name.clone(), total_bytes))
    } else {
        ctx_api_emit::ctx_emit(ctx, inst_struct_new::MirInst_struct_new(dest, total_bytes))
    }
    let mut byte_off = 0
    let mut ti = 0
    while ti < child_count {
        let field_local = get_unchecked(field_locals, ti)
        let field_vt = get_unchecked(field_vts, ti)
        ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(field_local))
        let set_off = byte_off
        let mut set_vt = value_types::VT_VOID()
        if field_vt == value_types::VT_F64() {
            set_vt = value_types::VT_F64()
            byte_off = byte_off + 8
        } else {
            if field_vt == value_types::VT_I64() {
                set_vt = value_types::VT_I64()
            } else {
                if field_vt == value_types::VT_GC_REF() || field_vt == value_types::VT_REF() {
                    set_vt = value_types::VT_GC_REF()
                }
            }
            byte_off = byte_off + 4
        }
        if struct_name.len() > 0 {
            ctx_api_emit::ctx_emit(ctx, inst_struct_set::MirInst_struct_set_named_idx(dest, field_local, struct_name.clone(), set_off, ti, total_bytes, set_vt))
        } else {
            ctx_api_emit::ctx_emit(ctx, inst_struct_set::MirInst_struct_set_named_sized(dest, field_local, String_new(), set_off, total_bytes, set_vt))
        }
        ti = ti + 1
    }
    // Value lives in `dest`; callers load via local_set_from / return_value.
    if struct_name.len() > 0 {
        let type_name = "struct:".concat(struct_name.clone().concat(":".concat((total_bytes).to_string())))
        ctx_api_local_types::ctx_set_local_type(ctx, dest, type_name)
    } else if tuple_name.len() > 0 {
        // Anonymous small-int tuples (LM path) still record the tuple:<k,...>
        // key name so tuple-let destructure recovers each field's value type
        // instead of defaulting non-first fields to a GC ref (#890).
        ctx_api_local_types::ctx_set_local_type(ctx, dest, tuple_name)
    }
    dest
}

fn tuple_name_keys_from_field_locals(ctx: LowerCtx, field_locals: Vec<i32>, field_vts: Vec<i32>, field_count: i32) -> String {
    let mut name = String_from("tuple:")
    let mut i = 0
    while i < field_count {
        if i > 0 {
            name = name.concat(String_from(","))
        }
        let local_type = ctx_api_local_types::ctx_get_local_type(ctx, get_unchecked(field_locals, i))
        let key = tuple_key_from_local_type(local_type, get_unchecked(field_vts, i))
        name = name.concat(key)
        i = i + 1
    }
    name
}

fn tuple_key_from_local_type(type_name: String, field_vt: i32) -> String {
    if type_name.len() == 0 {
        return tuple_field_mono_key(field_vt)
    }
    // Canonical element keys: a String-typed local reads "string" here while
    // annotations and param spellings produce "String"; fn-typed locals carry
    // fn/fnref/fnsig spellings. Vec<(K,V)> entries adapters derive the vec
    // element name from the annotation, so the literal-built struct must pick
    // the same tuple:* name (#888).
    if type_name.clone().eq("string") || type_name.clone().eq("str") {
        return "String"
    }
    // Narrow integers occupy the i32 ABI slot; using their source spelling
    // here would register a second identical-layout tuple type and break
    // calls/returns that name the tuple through their annotation.
    if match_payload_field_type::mir_narrow_int_type_name(type_name.clone()) {
        return "i32"
    }
    if ctx_gc_struct::gc_struct_field_type_is_fn_value(type_name.clone()) {
        return "fnref"
    }
    if type_name.clone().starts_with(String_from("enum:")) {
        return type_name.slice(5, type_name.len())
    }
    if type_name.clone().starts_with(String_from("struct:")) {
        let n = type_name.len()
        let mut first = 0 - 1
        let mut last = 0 - 1
        let mut i = 0
        while i < n {
            if type_name.byte_at(i) == 58 {
                if first < 0 {
                    first = i
                }
                last = i
            }
            i = i + 1
        }
        if first >= 0 && last > first {
            return type_name.slice(first + 1, last)
        }
    }
    type_name
}

fn tuple_struct_name_from_field_vts(ctx: LowerCtx, field_vts: Vec<i32>, field_count: i32, total_bytes: i32) -> String {
    if !tuple_field_vts_need_named_gc_struct(ctx, field_vts, field_count) {
        return String_new()
    }
    let mut name = "tuple:"
    let mut ti = 0
    while ti < field_count {
        if ti > 0 {
            name = name.concat(",")
        }
        name = name.concat(tuple_field_mono_key(get_unchecked(field_vts, ti)))
        ti = ti + 1
    }
    let _ = total_bytes
    name
}

fn tuple_field_vts_need_named_gc_struct(ctx: LowerCtx, field_vts: Vec<i32>, field_count: i32) -> bool {
    if ctx_gc_enum::ctx_is_gc_target(ctx) && field_count > 0 {
        return true
    }
    let mut ti = 0
    while ti < field_count {
        let field_vt = get_unchecked(field_vts, ti)
        // fn-valued fields need the named tuple:fnref,... layout on every
        // backend — destructured bindings recover their fn type from the
        // field key, and an anonymous tuple demotes them to i32 (#874).
        if field_vt == value_types::VT_GC_REF() || field_vt == value_types::VT_REF() ||
        field_vt == value_types::VT_FUNCREF() {
            return true
        }
        ti = ti + 1
    }
    false
}

fn tuple_field_mono_key(field_vt: i32) -> String {
    if field_vt == value_types::VT_F64() {
        return "f64"
    }
    if field_vt == value_types::VT_I64() {
        return "i64"
    }
    if field_vt == value_types::VT_FUNCREF() {
        return "fnref"
    }
    if field_vt == value_types::VT_GC_REF() || field_vt == value_types::VT_REF() {
        return "String"
    }
    "i32"
}

fn tuple_gc_sig_from_field_vts(field_vts: Vec<i32>, field_count: i32) -> String {
    let mut sig = "GS"
    let mut ti = 0
    while ti < field_count {
        let field_vt = get_unchecked(field_vts, ti)
        sig = sig.concat(tuple_gc_field_sig_for_vt(field_vt, ti))
        ti = ti + 1
    }
    sig
}

fn tuple_gc_field_sig_for_vt(field_vt: i32, field_idx: i32) -> String {
    let prefix = "_f".concat((field_idx).to_string())
    if field_vt == value_types::VT_F64() {
        return prefix.concat("_f64")
    }
    if field_vt == value_types::VT_I64() {
        return prefix.concat("_i64")
    }
    if field_vt == value_types::VT_GC_REF() || field_vt == value_types::VT_REF() {
        return prefix.concat("_ref0")
    }
    prefix.concat("_i32")
}

fn tuple_wasm_name_from_param_alias(param_type_name: String) -> String {
    // CoreHIR param aliases use Tuple:A:B; GC structs are tuple:A,B (#810).
    if !param_type_name.clone().starts_with(String_from("Tuple:")) {
        return String_new()
    }
    let rest = param_type_name.slice(6, param_type_name.len())
    let mut sep = 0 - 1
    let mut i = 0
    while i < rest.len() {
        if rest.byte_at(i) == 58 {
            sep = i
            i = rest.len()
        }
        i = i + 1
    }
    if sep <= 0 {
        return String_new()
    }
    let keys = rest.slice(0, sep).concat(String_from(",").concat(rest.slice(sep + 1, rest.len())))
    String_from("tuple:").concat(keys)
}

fn ctx_register_tuple_gc_struct_from_param_name(mut ctx: LowerCtx, param_type_name: String) -> i32 {
    let wasm_name = tuple_wasm_name_from_param_alias(param_type_name)
    if wasm_name.len() == 0 {
        return 0
    }
    let keys = wasm_name.slice(6, wasm_name.len())
    let sig = tuple_gc_sig_from_type_keys(ctx, keys)
    if sig.len() <= 2 {
        return 0
    }
    ctx_gc_struct::ctx_register_gc_struct(ctx, wasm_name, sig)
    1
}

fn tuple_type_name_from_param_alias(mut ctx: LowerCtx, param_type_name: String) -> String {
    let wasm_name = tuple_wasm_name_from_param_alias(param_type_name)
    if wasm_name.len() == 0 {
        return String_new()
    }
    let keys = wasm_name.slice(6, wasm_name.len())
    let sig = tuple_gc_sig_from_type_keys(ctx, keys)
    if sig.len() <= 2 {
        return String_new()
    }
    ctx_gc_struct::ctx_register_gc_struct(ctx, wasm_name.clone(), sig)
    "struct:".concat(wasm_name.concat(":".concat((tuple_byte_size_from_keys(keys)).to_string())))
}

fn tuple_byte_size_from_keys(keys: String) -> i32 {
    let mut total = 0
    let count = tuple_key_count(keys)
    let mut i = 0
    while i < count {
        let key = tuple_field_key_at(keys, i)
        if key.clone().eq("f64") || key.clone().eq("F64") ||
        key.clone().eq("i64") || key.clone().eq("I64") ||
        key.clone().eq("u64") {
            total = total + 8
        } else {
            total = total + 4
        }
        i = i + 1
    }
    total
}

fn ctx_register_tuple_gc_struct_from_return_name(mut ctx: LowerCtx, return_type_name: String) -> i32 {
    if !return_type_name.clone().starts_with("struct:") {
        return 0
    }
    let n = return_type_name.len()
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if return_type_name.byte_at(i) == 58 {
            if first_colon < 0 {
                first_colon = i
            }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon <= first_colon {
        return 0
    }
    let inner = return_type_name.slice(first_colon + 1, last_colon)
    if !inner.clone().starts_with("tuple:") {
        return 0
    }
    let keys = inner.slice(6, inner.len())
    let sig = tuple_gc_sig_from_type_keys(ctx, keys)
    if sig.len() <= 2 {
        return 0
    }
    ctx_gc_struct::ctx_register_gc_struct(ctx, inner.clone(), sig)
    1
}

fn ctx_register_tuple_gc_struct_from_keys(mut ctx: LowerCtx, keys: String) -> i32 {
    if keys.len() == 0 {
        return 0
    }
    let sig = tuple_gc_sig_from_type_keys(ctx, keys)
    if sig.len() <= 2 {
        return 0
    }
    ctx_gc_struct::ctx_register_gc_struct(ctx, String_from("tuple:").concat(keys), sig)
    1
}

fn ctx_register_tuple_gc_struct_from_field_vts(mut ctx: LowerCtx, field_vts: Vec<i32>) -> i32 {
    let field_count = field_vts.len()
    if field_count == 0 {
        return 0
    }
    let mut keys = String_new()
    let mut i = 0
    while i < field_count {
        if i > 0 {
            keys = keys.concat(",")
        }
        keys = keys.concat(tuple_field_mono_key(get_unchecked(field_vts, i)))
        i = i + 1
    }
    ctx_register_tuple_gc_struct_from_keys(ctx, keys)
}

fn tuple_gc_sig_from_type_keys(mut ctx: LowerCtx, keys: String) -> String {
    let mut sig = "GS"
    let key_count = tuple_key_count(keys)
    let mut i = 0
    while i < key_count {
        let key = tuple_field_key_at(keys, i)
        sig = sig.concat(tuple_gc_field_sig_for_key(ctx, key, i))
        i = i + 1
    }
    sig
}

fn tuple_key_count(keys: String) -> i32 {
    let n = keys.len()
    if n == 0 {
        return 0
    }
    let mut count = 1
    let mut i = 0
    while i < n {
        if keys.byte_at(i) == 44 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn tuple_field_key_at(keys: String, index: i32) -> String {
    let n = keys.len()
    let mut cur = 0
    let mut start = 0
    let mut i = 0
    while i <= n {
        if i == n || keys.byte_at(i) == 44 {
            if cur == index {
                return keys.slice(start, i)
            }
            cur = cur + 1
            start = i + 1
        }
        i = i + 1
    }
    String_new()
}

fn tuple_gc_field_sig_for_key(mut ctx: LowerCtx, key: String, field_idx: i32) -> String {
    let prefix = "_f".concat((field_idx).to_string())
    if key.clone().eq("f64") || key.clone().eq("F64") {
        return prefix.concat("_f64")
    }
    if key.clone().eq("i64") || key.clone().eq("I64") || key.clone().eq("u64") {
        return prefix.concat("_i64")
    }
    if key.clone().eq("f32") || key.clone().eq("F32") {
        return prefix.concat("_f32")
    }
    if key.clone().eq("i32") || key.clone().eq("I32") ||
    key.clone().eq("bool") || key.clone().eq("char") ||
    key.clone().eq("u8") || key.clone().eq("i8") ||
    key.clone().eq("u16") || key.clone().eq("u32") ||
    key.clone().eq("i16") ||
    key.clone().eq("unit") || key.clone().eq("()") {
        return prefix.concat("_i32")
    }
    if key.clone().eq("String") || key.clone().eq("string") {
        return prefix.concat("_ref0")
    }
    // fn-valued fields hold a {fnptr, env} pair under the managed closure
    // ABI (#872): the shared __fnpair struct slot, not the open enum base.
    if ctx_gc_struct::gc_struct_field_type_is_fn_value(key.clone()) {
        let pair_slot = ctx_gc_struct::ctx_ensure_fnpair_struct(ctx)
        if pair_slot >= 0 {
            return prefix.concat(String_from("_gcsref").concat((pair_slot).to_string()))
        }
        return prefix.concat("_ref14")
    }
    if key.clone().starts_with("vec:") ||
    key.clone().starts_with("Vec<") ||
    key.clone().starts_with("Vec_") {
        return prefix.concat(tuple_gc_vec_field_ref_suffix(key.clone()))
    }
    if key.clone().starts_with("option:") ||
    key.clone().starts_with("Option:") ||
    key.clone().starts_with("Option_") ||
    key.clone().starts_with("result:") ||
    key.clone().starts_with("Result:") ||
    key.clone().starts_with("Result_") {
        return prefix.concat("_ref14")
    }
    if key.len() == 1 {
        let ch = key.byte_at(0)
        if ch >= 65 && ch <= 90 {
            // A declared single-letter aggregate is a ref field. Use the
            // named struct slot so the stored value keeps its concrete type;
            // enums stay on the open base. Only an unbound type parameter
            // keeps the scalar placeholder.
            if ctx_gc_struct::gc_struct_field_name_is_declared(ctx, key.clone()) {
                let slot = ctx_gc_struct::ctx_ensure_gc_struct_registered(ctx, key.clone())
                if slot >= 0 {
                    return prefix.concat(String_from("_gcsref").concat((slot).to_string()))
                }
                return prefix.concat("_ref14")
            }
            return prefix.concat("_i32")
        }
    }
    // Named structs and enums share the open GC base type. This keeps tuple
    // signatures independent of declaration order while preserving a GC ref
    // slot for values such as WitType and Point.
    prefix.concat("_ref14")
}

fn tuple_gc_vec_field_ref_suffix(type_name: String) -> String {
    let elem = if type_name.clone().starts_with("vec:") {
        type_name.slice(4, type_name.len())
    } else if type_name.clone().starts_with("Vec<") && type_name.clone().ends_with(">") {
        type_name.slice(4, type_name.len() - 1)
    } else if type_name.clone().starts_with("Vec_") {
        type_name.slice(4, type_name.len())
    } else {
        String_new()
    }
    if elem.clone().eq("String") || elem.clone().eq("string") {
        return "_ref19"
    }
    if elem.clone().eq("i64") || elem.clone().eq("I64") {
        return "_ref22"
    }
    if elem.clone().eq("f64") || elem.clone().eq("F64") {
        return "_ref23"
    }
    if elem.clone().eq("v128") || elem.clone().eq("V128") {
        return "_ref21"
    }
    if elem.clone().eq("fnref") || elem.clone().eq("fn") || elem.clone().starts_with("fn(") {
        return "_ref28"
    }
    if elem.clone().starts_with("Option") ||
    elem.clone().starts_with("option:") ||
    elem.clone().starts_with("Result") ||
    elem.clone().starts_with("result:") ||
    elem.clone().starts_with("enum:") {
        return "_ref30"
    }
    if elem.clone().eq("i32") || elem.clone().eq("I32") ||
    elem.clone().eq("bool") || elem.clone().eq("char") ||
    elem.clone().eq("u8") || elem.clone().eq("i8") ||
    elem.clone().eq("u16") || elem.clone().eq("u32") ||
    elem.clone().eq("u64") || elem.clone().eq("i16") {
        return "_ref10"
    }
    "_ref25"
}
