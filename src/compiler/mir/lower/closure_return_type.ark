use mir::function_locals_view
use mir::function_return_mutation
use mir::local_access
use mir::lower::ctx_api_local_types
use mir::lower::ctx_current_storage
use mir::lower::closure_pcells
use mir::lower::ctx_struct_layout
use mir::lower::ctx_types
use mir::value_types
fn mir_set_closure_return_from_local(mut ctx: LowerCtx, mut f: MirFunction, res_idx: i32) {
    if res_idx < 0 {
        function_return_mutation::MirFunction_set_return_type(f, value_types::VT_VOID())
        return
    }
    // A promoted borrow-capture cell local holds the env-carried ref; the
    // function's VALUE return type is the cell's payload (#891).
    let val_idx = closure_pcells::ctx_pcell_value_local(ctx, res_idx)
    let mut ret_vt = ctx_api_local_types::ctx_local_vt(ctx, val_idx)
    let mut ret_type = String_new()
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    if val_idx < function_locals_view::MirFunction_local_count(func) {
        let loc = function_locals_view::MirFunction_local_at(func, val_idx)
        ret_type = local_access::MirLocal_type_name(loc)
    }
    if ret_type.len() == 0 {
        ret_type = ctx_api_local_types::ctx_get_local_type(ctx, val_idx)
    }
    if ret_type.len() > 0 {
        ret_type = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, ret_type.clone())
    } else {
        if ret_vt == value_types::VT_GC_REF() {
            ret_type = "String"
        }
    }
    if ret_type.clone().starts_with("struct:") ||
    ret_type.clone().eq("String") ||
    ret_type.clone().eq("string") ||
    ret_type.clone().starts_with("enum:") ||
    ret_type.clone().starts_with("vec:") ||
    ret_type.clone().starts_with("Option_") ||
    ret_type.clone().starts_with("Result_") {
        ret_vt = value_types::VT_GC_REF()
    }
    function_return_mutation::MirFunction_set_return_type(f, ret_vt)
    if ret_type.len() > 0 {
        function_return_mutation::MirFunction_set_return_type_name(f, ret_type)
    }
}
