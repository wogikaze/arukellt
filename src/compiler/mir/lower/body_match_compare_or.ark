use mir::lower::ast_node
use mir::lower::ctx_api_nesting
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::opcodes
use mir::lower::ctx_types
use mir::inst_structured_control
use mir::inst_local_get
use mir::inst_local_set
use mir::inst_op
use mir::lower::match
use mir::value_types

fn lower_or_match_compare_prefix(ctx: LowerCtx, pat: AstNode, payload_info: MirMatchPayloadInfo, if_depth: i32) -> i32 {
    let compare_idx = match::mir_match_payload_compare_idx(payload_info)
    emit_or_compare_fold(ctx, pat, compare_idx)
    ctx_emit(ctx, inst_structured_control::MirInst_if())
    let _or_nesting_depth = ctx_api_nesting::ctx_push_nesting(ctx)
    if_depth + 1
}

// Condition-local form for callers that load the folded result before IF
// (guarded or-arms and last or-arms). Mirrors
// lower_single_match_compare_condition: emit the per-alternative compares,
// OR-fold them, and store into a fresh local (#898).
fn lower_or_match_compare_condition(ctx: LowerCtx, pat: AstNode, payload_info: MirMatchPayloadInfo) -> i32 {
    let compare_idx = match::mir_match_payload_compare_idx(payload_info)
    emit_or_compare_fold(ctx, pat, compare_idx)
    let cond = ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_emit(ctx, inst_local_set::MirInst_local_set(cond))
    cond
}

// Emit compare/eq per or-alternative and OR-fold them, leaving the folded
// i32 on the operand stack. The compare itself is shared with the
// condition/prefix forms so arm shapes cannot drift (#898).
fn emit_or_compare_fold(ctx: LowerCtx, pat: AstNode, compare_idx: i32) {
    let alt_count = ast_node::node_child_count(pat)
    let mut or_oi = 0
    let mut or_prev_cmp = 0 - 1
    while or_oi < alt_count {
        let or_alt = ast_node::node_child_at(pat, or_oi)
        let mut or_cmp = 0 - 1
        if match::mir_pat_is_string_literal(or_alt) {
            or_cmp = match::mir_emit_string_pattern_compare(ctx, compare_idx, or_alt)
        } else {
            ctx_emit(ctx, inst_local_get::MirInst_local_get(compare_idx))
            let or_pat_idx = lower_expr(ctx, or_alt)
            or_cmp = ctx_fresh_local(ctx, value_types::VT_I32())
            ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_EQ(), or_cmp, compare_idx, or_pat_idx))
        }
        if or_oi > 0 {
            let or_acc = ctx_fresh_local(ctx, value_types::VT_I32())
            ctx_emit(ctx, inst_op::MirInst_binop(opcodes::MIR_BIT_OR(), or_acc, or_prev_cmp, or_cmp))
            or_prev_cmp = or_acc
        } else {
            or_prev_cmp = or_cmp
        }
        or_oi = or_oi + 1
    }
}
