use mir::lower::ast_node
use mir::lower::ann_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_function_frame
use mir::lower::ctx_api_local_types
use mir::lower::ctx_struct_layout
use mir::lower_kinds
use mir::lower::ctx_types
use mir::local_factory
use mir::value_types
fn mir_emit_closure_params(mut ctx: LowerCtx, clos: AstNode, child_count: i32) {
    let mut pi = 0
    while pi + 1 < child_count {
        let p = ast_node::node_child_at(clos, pi)
        if ast_node::node_kind_is(p, lower_kinds::NK_IDENT()) {
            let param_name = ast_node::node_text(p)
            // The x: T annotation lives on the ident node; without it every
            // param collapsed to i32 and ref-typed params (Vec, String,
            // user structs) failed validation at the wasm boundary (#872).
            let mut pvt = value_types::VT_I32()
            let mut ptype = String_new()
            if ast_node::node_type_ann_count(p) > 0 {
                let ann = ast_node::node_type_ann_at(p, 0)
                let ann_name = ast_node::node_text(ann)
                pvt = ann_types::mir_local_vt_from_type_name(ann_name.clone())
                ptype = ctx_struct_layout::ctx_maybe_enum_return_type_name(
                    ctx,
                    ann_types::mir_local_type_name_from_ann(ann, 0)
                )
                if len(ptype) == 0 {
                    ptype = ann_name.clone()
                }
                if pvt == value_types::VT_I32() {
                    if ctx_struct_layout::ctx_is_registered_struct_type(ctx, ann_name.clone()) ||
                    ctx_struct_layout::ctx_is_registered_enum_type(ctx, ann_name.clone()) {
                        pvt = value_types::VT_GC_REF()
                    }
                }
                if closure_param_type_is_fnref(ptype.clone()) {
                    pvt = value_types::VT_FUNCREF()
                }
            }
            let _idx = ctx_alloc_local(ctx, param_name.clone(), pvt)
            if len(ptype) > 0 {
                ctx_api_local_types::ctx_set_local_type(ctx, _idx, ptype.clone())
            }
            ctx_api_function_frame::ctx_push_func_param(ctx, local_factory::MirLocal_new(param_name.clone(), pvt, ptype.clone()))
        }
        pi = pi + 1
    }
}

// fnref-family spellings (fnref/fnref2/fnsig:/fn() mark a callback ABI
// param; they must keep VT_FUNCREF rather than widening to a data ref.
fn closure_param_type_is_fnref(type_name: String) -> bool {
    type_name.clone().eq(String_from("fnref")) ||
    type_name.clone().eq(String_from("fnref2")) ||
    type_name.clone().starts_with(String_from("fnref")) ||
    type_name.clone().starts_with(String_from("fnsig:")) ||
    type_name.clone().starts_with(String_from("fn("))
}
