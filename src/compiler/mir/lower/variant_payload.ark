use std::text
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_types
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_enum_payload
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_layout
use mir::lower::ctx_types
use mir::lower::match_payload_field_type
use mir::inst_const_i32
use mir::inst_convert
use mir::inst_local_get
use mir::inst_struct_new
use mir::inst_struct_set
use mir::inst_gc_struct
use mir::lower::variant_payload_fields
use mir::value_types
fn lower_payload_variant_from_locals(mut ctx: LowerCtx, tag: i32, payload_locals: Vec<i32>, payload_vts: Vec<i32>, total_bytes: i32, variant_name: String) -> i32 {
    if ctx_gc_enum::ctx_is_gc_target(ctx) {
        return lower_gc_payload_variant_from_locals(ctx, tag, payload_locals, payload_vts, variant_name.clone())
    }
    let dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_struct_new::MirInst_struct_new(dest, total_bytes))
    set_linear_enum_type(ctx, dest, variant_name.clone())
    emit_variant_tag_field(ctx, dest, tag, 0 - 1)
    variant_payload_fields::emit_variant_payload_fields(ctx, dest, payload_locals, payload_vts, variant_name.clone())
    dest
}

fn set_linear_enum_type(mut ctx: LowerCtx, dest: i32, variant_name: String) {
    let enum_name = ctx_gc_enum::ctx_gc_enum_type_name_from_variant(variant_name)
    if enum_name.len() > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "enum:".concat(enum_name))
    }
}

fn lower_gc_payload_variant_from_locals(mut ctx: LowerCtx, tag: i32, payload_locals: Vec<i32>, payload_vts: Vec<i32>, variant_name: String) -> i32 {
    let type_slot = if payload_vts.len() > 0 {
        let first_local = payload_locals.get_unchecked(0)
        let payload_type_name = ctx_mono_type_params::ctx_resolve_mono_type_name(
            ctx,
            ctx_api_local_types::ctx_get_local_type(ctx, first_local)
        )
        let first_vt = payload_vts.get_unchecked(0)
        let typed_name = gc_payload_typed_variant_name(ctx, first_local, payload_type_name.clone(), variant_name.clone(), first_vt)
        if typed_name.len() > 0 {
            let effective_vts = gc_payload_vts_with_first(payload_vts, gc_payload_promote_vt(ctx, first_local, first_vt, typed_name.clone()))
            let slot = ctx_gc_enum_payload::ctx_ensure_gc_enum_payload_variant_typed(ctx, variant_name.clone(), effective_vts, typed_name)
            // Keep payload field stores aligned with the promoted VT used for
            // typed variant selection (String → VT_GC_REF / `_f1_ref0`).
            let dest_slot = slot
            let dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_GC_REF())
            ctx_api_local_types::ctx_set_local_variant_slot(ctx, dest, dest_slot)
            let enum_name = ctx_gc_enum::ctx_gc_enum_type_name_from_variant(variant_name.clone())
            if enum_name.len() > 0 {
                ctx_api_local_types::ctx_set_local_type(ctx, dest, gc_ctor_enum_local_type(enum_name.clone(), variant_name.clone(), payload_type_name.clone(), typed_name.clone()))
            }
            ctx_api_emit::ctx_emit(ctx, inst_gc_struct::MirInst_gc_struct_new(dest, dest_slot))
            emit_variant_tag_field(ctx, dest, tag, dest_slot)
            emit_gc_variant_payload_fields(ctx, dest, dest_slot, payload_locals, effective_vts, variant_name.clone())
            // Value lives in `dest`; callers load via local_set_from / return_value.
            return dest
        } else {
            ctx_gc_enum_payload::ctx_ensure_gc_enum_payload_variant(ctx, variant_name.clone(), payload_vts)
        }
    } else {
        ctx_gc_enum::ctx_gc_enum_variant_slot(ctx, variant_name.clone())
    }
    let dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_GC_REF())
    ctx_api_local_types::ctx_set_local_variant_slot(ctx, dest, type_slot)
    let enum_name = ctx_gc_enum::ctx_gc_enum_type_name_from_variant(variant_name.clone())
    if enum_name.len() > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, "enum:".concat(enum_name))
    }
    ctx_api_emit::ctx_emit(ctx, inst_gc_struct::MirInst_gc_struct_new(dest, type_slot))
    emit_variant_tag_field(ctx, dest, tag, type_slot)
    emit_gc_variant_payload_fields(ctx, dest, type_slot, payload_locals, payload_vts, variant_name.clone())
    dest
}

// Local type stamped on a freshly constructed enum value. Option/Result
// payload constructors record the concrete payload spelling
// (option:<t> / result:<t>:) so match payload reads select the same GC
// variant slot the constructor picked; bare enum:Option/enum:Result
// carried no payload type and made untyped scrutinees read the generic
// ref slot — invalid core Wasm for scalar payloads (#904). Result::Err
// keeps enum:Result because the result:<ok>:<err> spelling needs an Ok
// segment the Err constructor cannot supply. Non-generic enums keep
// enum:<name>: their declared field types already carry the payload vt.
// typed_name is the storage-slot hint; enum:open means "untyped ref", so
// an enum-valued payload must fall back to the payload local type or
// nested matches lose the payload element type (Some(Some(v))).
fn gc_ctor_enum_local_type(enum_name: String, variant_name: String, payload_type_name: String, typed_name: String) -> String {
    if typed_name.len() == 0 || !match_payload_field_type::mir_match_variant_is_some_or_ok(variant_name.clone()) {
        return "enum:".concat(enum_name)
    }
    let mut segment = typed_name.clone()
    if segment.clone().eq("enum:open") {
        segment = gc_ctor_semantic_payload_segment(payload_type_name.clone())
    } else if segment.clone().starts_with("enum:") {
        // enum:Foo is a storage spelling; the payload segment keeps the
        // semantic enum name so binds rebuild enum:Foo once.
        segment = segment.slice(5, segment.len())
    }
    if segment.len() == 0 || segment.clone().eq("open") {
        return "enum:".concat(enum_name)
    }
    if enum_name.clone().eq("Option") {
        return "option:".concat(segment)
    }
    if enum_name.clone().eq("Result") {
        return "result:".concat(segment.concat(":"))
    }
    "enum:".concat(enum_name)
}

// Semantic payload spelling for the option:/result: segment. Storage
// prefixes (enum:, struct:) describe the ref ABI, not the payload type;
// strip them so `enum:Foo` becomes `Foo` and `option:i32` passes through.
// Returns "" when the payload type is genuinely unknown (enum:open).
fn gc_ctor_semantic_payload_segment(payload_type_name: String) -> String {
    let mut name = payload_type_name.clone()
    if name.clone().starts_with("enum:") {
        name = name.slice(5, name.len())
    } else if name.clone().starts_with("struct:") {
        name = ctx_struct_layout::ctx_struct_semantic_type_name(name.clone())
    }
    if name.clone().eq("open") {
        return String_new()
    }
    name
}

fn gc_payload_typed_variant_name(ctx: LowerCtx, local_idx: i32, type_name: String, variant_name: String, vt: i32) -> String {
    if gc_payload_type_name_needs_typed_variant(type_name.clone()) {
        // Tuple locals can carry the storage wrapper struct:tuple:...:size;
        // the GC struct registry keys the semantic tuple:<keys> name, so the
        // variant must be selected with the same spelling.
        if type_name.clone().starts_with(String_from("tuple:")) ||
        type_name.clone().starts_with(String_from("Tuple:")) ||
        type_name.clone().starts_with(String_from("struct:tuple:")) {
            return ctx_struct_layout::ctx_struct_semantic_type_name(type_name)
        }
        return type_name
    }
    // String payloads must select the `_f1_ref0` Ok/Some variant, not the
    // first name-only `_f1_i32` registration (see #726 buf_read / io_*).
    if gc_payload_is_string_type_name(type_name.clone()) {
        return "string"
    }
    // Concrete scalar VT on the payload local must drive variant selection
    // even when the enum layout field is a wider type (Float/f64 vs i32) (#726 toml).
    if vt == value_types::VT_F64() {
        return "f64"
    }
    if vt == value_types::VT_I64() {
        return "i64"
    }
    if vt == value_types::VT_FUNCREF() ||
    type_name.clone().eq("fnref") ||
    type_name.clone().eq("fn") ||
    type_name.clone().starts_with("fn(") {
        return "fnref"
    }
    if vt == value_types::VT_I32() && (type_name.len() == 0 || gc_payload_is_scalar_type_name(type_name.clone())) {
        return "i32"
    }
    // Named struct payloads (TomlValStep, etc.) must win over a stray
    // variant_slot inherited from an inner enum field. Otherwise Ok(step)
    // selects the open-enum layout and struct.set fails (#726 toml).
    if vt == value_types::VT_GC_REF() || vt == value_types::VT_REF() {
        if type_name.clone().starts_with("struct:") {
            // Storage spellings carry the byte size; the GC struct registry
            // and field-sig resolver key on the semantic name.
            return ctx_struct_layout::ctx_struct_semantic_type_name(type_name)
        }
        if type_name.len() > 0 && ctx_struct_field_type::field_type_is_registered_struct(ctx, type_name.clone()) {
            return type_name
        }
    }
    // Enum-valued locals (TomlValue::Table etc.) must win over Ok's default
    // String layout before layout_result collapses them to _f1_ref0 (#726).
    if vt == value_types::VT_GC_REF() || vt == value_types::VT_REF() {
        if ctx_api_local_types::ctx_get_local_variant_slot(ctx, local_idx) >= 0 {
            return "enum:open"
        }
        if type_name.clone().starts_with("enum:") {
            return type_name
        }
        if ctx_struct_field_type::field_type_is_registered_enum(ctx, type_name.clone()) {
            return "enum:".concat(type_name)
        }
    }
    let layout_result = gc_payload_typed_variant_from_layout(ctx, variant_name.clone(), type_name.clone(), vt)
    if layout_result.len() > 0 {
        return layout_result
    }
    // Concrete non-scalar payload type on the local wins over Ok's String layout.
    if type_name.len() > 0 && !gc_payload_is_scalar_type_name(type_name.clone()) && !gc_payload_is_string_type_name(type_name.clone()) {
        if vt == value_types::VT_GC_REF() || vt == value_types::VT_REF() {
            return type_name
        }
    }
    if vt == value_types::VT_GC_REF() || vt == value_types::VT_REF() {
        if gc_payload_is_err_variant_name(variant_name.clone()) {
            return "enum:open"
        }
        // Untyped GC payload into Ok/Some → enum-open (not string) (#726 toml_parse).
        return "enum:open"
    }
    if type_name.clone().starts_with("enum:") {
        return type_name
    }
    if type_name.len() > 0 {
        return String_new()
    }
    String_new()
}

fn gc_payload_typed_variant_from_layout(ctx: LowerCtx, variant_name: String, type_name: String, vt: i32) -> String {
    let layout_type = gc_payload_layout_field_type_name(ctx, variant_name.clone(), 1)
    if layout_type.len() > 0 {
        // Ok/Some layout often defaults to String; only use that when the
        // payload local is actually a string. Untyped GC refs are often
        // enums (TomlValue) — do not collapse them to _f1_ref0 (#726).
        if gc_payload_is_string_type_name(layout_type.clone()) {
            if gc_payload_is_string_type_name(type_name.clone()) {
                return "string"
            }
            // Result::Err defaults to String — keep _f1_ref0 even when the
            // error local is still untyped (#726 connect_read_write).
            if gc_payload_is_err_variant_name(variant_name.clone()) && type_name.len() == 0 {
                return "string"
            }
            // Empty type_name + GC ref into Ok/Some → leave unresolved so
            // callers can pick enum:open (TomlValue) instead of collapsing
            // to string (#726 toml_parse).
            if type_name.len() == 0 && (vt == value_types::VT_GC_REF() || vt == value_types::VT_REF()) {
                return String_new()
            }
            if type_name.len() == 0 {
                return "string"
            }
        } else {
            if gc_payload_type_name_needs_typed_variant(layout_type.clone()) {
                return layout_type
            }
            if ctx_struct_field_type::field_type_is_registered_enum(ctx, layout_type.clone()) {
                if layout_type.clone().starts_with("enum:") {
                    return layout_type
                }
                return "enum:".concat(layout_type.clone())
            }
            if vt == value_types::VT_GC_REF() || vt == value_types::VT_REF() || ctx_struct_field_type::ctx_struct_field_is_gc_ref(ctx, variant_name.clone(), 1) {
                if layout_type.len() > 0 && !gc_payload_is_scalar_type_name(layout_type.clone()) {
                    return layout_type
                }
            }
        }
    }
    String_new()
}

fn gc_payload_is_string_type_name(type_name: String) -> bool {
    type_name.clone().eq("String") || type_name.clone().eq("string")
}

fn gc_payload_is_err_variant_name(variant_name: String) -> bool {
    variant_name.clone().eq("Err") || variant_name.clone().eq("Result::Err") || variant_name.clone().ends_with("::Err")
}

fn gc_payload_layout_field_type_name(ctx: LowerCtx, variant_name: String, field_idx: i32) -> String {
    if variant_name.len() == 0 {
        return String_new()
    }
    ctx_mono_type_params::ctx_resolve_mono_type_name(
        ctx,
        ctx_struct_field_type::ctx_struct_field_type_name(ctx, variant_name.clone(), field_idx)
    )
}

fn gc_payload_is_scalar_type_name(type_name: String) -> bool {
    type_name.clone().eq("i32") ||
    type_name.clone().eq("I32") ||
    type_name.clone().eq("i64") ||
    type_name.clone().eq("I64") ||
    type_name.clone().eq("u64") ||
    type_name.clone().eq("U64") ||
    type_name.clone().eq("f64") ||
    type_name.clone().eq("F64") ||
    type_name.clone().eq("bool") ||
    type_name.clone().eq("Bool") ||
    match_payload_field_type::mir_narrow_int_type_name(type_name.clone())
}

fn gc_payload_type_name_needs_typed_variant(type_name: String) -> bool {
    if type_name.clone().eq("Vec") ||
    type_name.clone().starts_with("vec:") ||
    type_name.clone().starts_with("Vec<") ||
    type_name.clone().starts_with("Vec_") {
        return true
    }
    if type_name.clone().starts_with("hashmap:") {
        return true
    }
    if type_name.clone().starts_with("enum:") {
        return true
    }
    if type_name.clone().eq("Ordering") {
        return true
    }
    // Tuple payloads are nominal heap structs. Their element keys are not
    // scalar names, so an untyped selection collapses the variant to
    // `_f1_i32` and the ref-valued payload fails validation (#974).
    if type_name.clone().starts_with("tuple:") ||
    type_name.clone().starts_with("Tuple:") ||
    type_name.clone().starts_with("struct:tuple:") {
        return true
    }
    false
}

fn gc_payload_promote_vt(mut ctx: LowerCtx, local_idx: i32, vt: i32, type_name: String) -> i32 {
    if gc_payload_type_name_needs_typed_variant(type_name.clone()) || gc_payload_is_string_type_name(type_name.clone()) {
        // Payload locals must not keep a stray enclosing-variant slot;
        // otherwise emit casts String → Ok/String-variant before struct.set.
        ctx_api_local_types::ctx_set_local_variant_slot(ctx, local_idx, 0 - 1)
        if ctx_gc_enum::ctx_is_gc_target(ctx) {
            ctx_api_local_types::ctx_set_local_vt(ctx, local_idx, value_types::VT_GC_REF())
            return value_types::VT_GC_REF()
        }
        ctx_api_local_types::ctx_set_local_vt(ctx, local_idx, value_types::VT_REF())
        return value_types::VT_REF()
    }
    vt
}

fn gc_payload_vts_with_first(payload_vts: Vec<i32>, first_vt: i32) -> Vec<i32> {
    let mut result = Vec::new<i32>()
    result.push(first_vt)
    let mut i = 1
    while i < payload_vts.len() {
        result.push(payload_vts.get_unchecked(i))
        i = i + 1
    }
    result
}

fn emit_variant_tag_field(mut ctx: LowerCtx, dest: i32, tag: i32, type_slot: i32) {
    let tag_tmp = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_const_i32::MirInst_const_i32(tag, tag_tmp))
    if type_slot >= 0 {
        ctx_api_emit::ctx_emit(ctx, inst_gc_struct::MirInst_gc_struct_set(dest, tag_tmp, type_slot, 0, value_types::VT_I32()))
    } else {
        ctx_api_emit::ctx_emit(ctx, inst_struct_set::MirInst_struct_set(dest, tag_tmp, 0, value_types::VT_VOID()))
    }
}

fn emit_gc_variant_payload_fields(mut ctx: LowerCtx, dest: i32, type_slot: i32, payload_locals: Vec<i32>, payload_vts: Vec<i32>, variant_name: String) {
    let layout_name = ctx_struct_field_type::ctx_resolve_variant_layout_name(ctx, variant_name.clone())
    let mut fi = 0
    let child_count = payload_locals.len()
    while fi < child_count {
        let mut field_local = payload_locals.get_unchecked(fi)
        let field_vt = payload_vts.get_unchecked(fi)
        let mut set_vt = value_types::VT_VOID()
        let mut needs_i64_widen = false
        if field_vt == value_types::VT_I32() {
            needs_i64_widen = ctx_struct_layout::ctx_struct_field_is_i64(
                ctx,
                layout_name.clone(),
                fi + 1
            )
        }
        if field_vt == value_types::VT_F64() {
            set_vt = value_types::VT_F64()
        } else if field_vt == value_types::VT_I64() {
            set_vt = value_types::VT_I64()
        } else if field_vt == value_types::VT_FUNCREF() {
            set_vt = value_types::VT_FUNCREF()
        } else if needs_i64_widen {
            // User enums declare an i64 payload (for example
            // TomlValue::Integer) while the constructor argument is an
            // unannotated integer literal. The variant layout keeps the
            // declared i64 field, so widen before struct.set instead of
            // emitting an i32 store into an i64 field.
            let ext = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I64())
            ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get(field_local))
            ctx_api_emit::ctx_emit(ctx, inst_convert::MirInst_extend_i32_to_i64(ext, field_local))
            field_local = ext
            set_vt = value_types::VT_I64()
        }
        ctx_api_emit::ctx_emit(
            ctx,
            inst_gc_struct::MirInst_gc_struct_set(dest, field_local, type_slot, fi + 1, set_vt)
        )
        fi = fi + 1
    }
}
