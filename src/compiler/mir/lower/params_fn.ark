use std::text
use corehir::param
use corehir::type_info_to_mir_value
use mir::function_identity
use mir::legacy_vt_compat
use mir::lower::binary_type_names
use mir::lower::aggregate_tuple
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_function_frame
use mir::lower::ctx_api_local_types
use mir::lower::ctx_current_storage
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_layout
use mir::lower::ctx_types
use mir::local_factory
use mir::module_spine
use mir::spine_lookup
use mir::typed_mir_compat
use mir::types
use mir::value_types
fn mir_bind_fn_param(mut ctx: LowerCtx, param: CoreHirParam) {
    if !param::param_is_bindable(param) {
        return
    }
    let mut pvt = param::param_value_type(param)
    let p_type_name = param::param_type_name(param)
    let local_type_name = param::param_local_type_name(param)
    let mut mir_type_name = p_type_name.clone()
    let mut sig_type_name = p_type_name.clone()
    let mut is_type_var = false
    if len(local_type_name) > 0 {
        mir_type_name = local_type_name.clone()
        sig_type_name = local_type_name.clone()
        if local_type_name.clone().starts_with(String_from("vec:")) ||
        local_type_name.clone().starts_with(String_from("hashmap:")) ||
        local_type_name.clone().starts_with(String_from("Option_")) ||
        local_type_name.clone().starts_with(String_from("option:")) ||
        local_type_name.clone().starts_with(String_from("Result_")) ||
        local_type_name.clone().starts_with(String_from("result:")) {
            pvt = value_types::VT_GC_REF()
        } else if !mir_param_type_is_fnref(local_type_name.clone()) {
            // fnref-family names (fnref/fnref2/fnsig:/fn() carry the callback
            // ABI. The ':' inside fnsig: is a signature separator, not a
            // module qualifier — stripping it here would rewrite the param
            // as a named user struct (GC_REF) and lose the funcref (#860).
            // Qualified names like "parser::TomlValue" need the bare enum
            // name for layout lookup; without this, export shells keep VT_I32.
            let bare = mir_param_strip_module_prefix(local_type_name.clone())
            // Struct context wins when a user struct shadows an enum name:
            // a bare Box param is the user struct, while the prelude enum
            // stays reachable through enum:/qualified spellings.
            if ctx_struct_layout::ctx_is_registered_struct_type(ctx, local_type_name.clone()) || ctx_struct_layout::ctx_is_registered_struct_type(ctx, bare.clone()) {
                pvt = value_types::VT_GC_REF()
                sig_type_name = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, bare.clone())
            } else {
                if ctx_struct_layout::ctx_is_registered_enum_type(ctx, bare.clone()) || ctx_struct_layout::ctx_is_registered_enum_type(ctx, local_type_name.clone()) {
                    pvt = value_types::VT_GC_REF()
                    mir_type_name = ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, bare.clone())
                    sig_type_name = mir_type_name.clone()
                } else {
                    let named = mir_param_resolve_named_user_type(ctx, bare.clone())
                    if len(named) > 0 {
                        pvt = value_types::VT_GC_REF()
                        sig_type_name = named.clone()
                        mir_type_name = named
                    }
                }
            }
        }
    } else {
        let resolved = mir_param_resolve_no_local_type(ctx, p_type_name.clone())
        if len(resolved) > 0 {
            pvt = value_types::VT_GC_REF()
            mir_type_name = get_unchecked(resolved, 0)
            sig_type_name = get_unchecked(resolved, 1)
            if mir_type_name.clone().starts_with(String_from("?")) {
                is_type_var = true
            }
        }
    }
    let param_name = param::param_name(param)
    let param_local = ctx_alloc_local(ctx, param_name.clone(), pvt)
    ctx_push_func_param(ctx, local_factory::MirLocal_new(param_name.clone(), pvt, sig_type_name))
    ctx_api_local_types::ctx_set_local_type(ctx, param_local, mir_type_name)
    if p_type_name.clone().starts_with(String_from("HashSet")) {
        // Mirror the receiver marker for a `HashSet` argument (e.g. the
        // `other` operand of union / intersection / difference / extend).
        let mut family = String_from("i32")
        if local_type_name.clone().eq(String_from("vec:String")) ||
        local_type_name.clone().eq(String_from("hashmap:si32")) ||
        p_type_name.clone().starts_with(String_from("HashSet<String>")) ||
        p_type_name.clone().starts_with(String_from("HashSet_String")) {
            family = String_from("String")
        }
        ctx_api_local_types::ctx_mark_hashset_local(ctx, param_local, family)
    }
    let func = ctx_current_storage::ctx_current_func_value(ctx)
    let func_name = function_identity::MirFunction_name(func)
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    let mut table = module_spine::MirModule_type_table(m)
    let preserved_type_name = mir_type_name.clone()
    let mut param_mvt = spine_lookup::function_param_mvt(m, func_name, param_local)
    // A source annotation is the authoritative identity for a concrete
    // parameter.  The legacy spine can point at a same-shaped declaration
    // after imported functions are flattened; accepting that MVT would make
    // the body local scalar/ref disagree with the function signature.
    if mir_param_type_name_is_concrete(preserved_type_name.clone()) {
        param_mvt = type_info_to_mir_value::vt_to_mir_value(
            table,
            pvt,
            preserved_type_name.clone()
        )
    }
    // The legacy signature spine may still describe a user enum as a named
    // struct because type checking predates enum registration.  The lowering
    // context has already canonicalized this parameter to enum:<name>, so use
    // that concrete type rather than reintroducing the stale struct TypeId.
    if preserved_type_name.clone().starts_with(String_from("enum:")) {
        param_mvt = type_info_to_mir_value::vt_to_mir_value(
            table,
            value_types::VT_GC_REF(),
            preserved_type_name.clone()
        )
    }
    if !typed_mir_compat::mvt_is_invalid(param_mvt) {
        ctx_api_local_types::ctx_set_local_mvt(ctx, param_local, param_mvt)
        let alias = type_info_to_mir_value::mvt_gc_layout_alias(table, param_mvt)
        if len(alias) > 0 && !type_info_to_mir_value::concrete_type_outranks_mvt_alias(preserved_type_name.clone(), alias.clone()) {
            let mvt_vt = legacy_vt_compat::legacy_vt_from_mir_value_type(table, param_mvt)
            ctx_api_local_types::ctx_set_local_vt(ctx, param_local, mvt_vt)
            // A var-carrying spelling (?HashMap:K:V, vec:K) must keep its
            // local type name: the ordinal mono map collects the variables
            // from it before mono substitution resolves the concrete alias
            // (#691). ctx_set_func_param_type would also sync the local
            // record, so only the signature record takes the alias.
            if len(ctx_mono_type_params::ctx_type_var_names_from_local_type(preserved_type_name.clone())) == 0 {
                ctx_api_local_types::ctx_set_local_type(ctx, param_local, alias.clone())
                ctx_api_function_frame::ctx_set_func_param_type(ctx, param_local, mvt_vt, alias.clone())
            } else {
                ctx_api_function_frame::ctx_set_func_param_sig_type(ctx, param_local, mvt_vt, alias.clone())
            }
        }
    }
    // Keep Option<fn> as option:fnref across MVT aliasing (#831).
    if mir_param_type_is_option_fnref(preserved_type_name.clone()) {
        ctx_api_local_types::ctx_set_local_type(ctx, param_local, String_from("option:fnref"))
        ctx_api_local_types::ctx_set_local_vt(ctx, param_local, value_types::VT_GC_REF())
        ctx_api_function_frame::ctx_set_func_param_type(ctx, param_local, value_types::VT_GC_REF(), String_from("option:fnref"))
    }
    // Keep unary/binary fn params as VT_FUNCREF (fnref2 must not become GC_REF) (#807).
    if mir_param_type_is_fnref(preserved_type_name.clone()) {
        ctx_api_local_types::ctx_set_local_type(ctx, param_local, preserved_type_name.clone())
        ctx_api_local_types::ctx_set_local_vt(ctx, param_local, value_types::VT_FUNCREF())
        ctx_api_function_frame::ctx_set_func_param_type(
            ctx,
            param_local,
            value_types::VT_FUNCREF(),
            preserved_type_name.clone()
        )
    }
}

fn mir_param_type_name_is_concrete(type_name: String) -> bool {
    if len(type_name) == 0 || type_name.clone().starts_with(String_from("?")) {
        return false
    }
    !mir_param_name_is_type_param(type_name.clone())
}

fn mir_param_type_is_fnref(type_name: String) -> bool {
    type_name.clone().eq(String_from("fnref")) ||
    type_name.clone().eq(String_from("fnref2")) ||
    type_name.clone().starts_with(String_from("fnref")) ||
    type_name.clone().starts_with(String_from("fnsig:")) ||
    type_name.clone().starts_with(String_from("fn("))
}

fn mir_param_type_is_option_fnref(type_name: String) -> bool {
    type_name.clone().eq(String_from("option:fnref")) ||
    type_name.clone().eq(String_from("Option:fnref")) ||
    type_name.clone().eq(String_from("Option:fn")) ||
    (type_name.clone().ends_with(String_from(":fnref")) && mir_param_type_is_option_container(type_name.clone()))
}

fn mir_param_type_is_option_container(type_name: String) -> bool {
    // The loose :fnref suffix clause is only valid for Option-family
    // spellings.  Without the prefix gate, vec:fnref / result:*:fnref
    // params were rewritten to option:fnref and lost their container
    // identity before GC vec emission could see it (#874).
    type_name.clone().starts_with(String_from("option:")) ||
    type_name.clone().starts_with(String_from("Option:")) ||
    type_name.clone().starts_with(String_from("Option_")) ||
    type_name.clone().starts_with(String_from("Option<"))
}

fn mir_param_resolve_no_local_type(mut ctx: LowerCtx, p_type_name: String) -> Vec<String> {
    let mut result = Vec::new<String>()
    let tuple_type = aggregate_tuple::tuple_type_name_from_param_alias(ctx, p_type_name.clone())
    if len(tuple_type) > 0 {
        push(result, tuple_type.clone())
        push(result, tuple_type.clone())
        return result
    }
    // Surface Option:/Result: forms must become option:/result: — never
    // "?Option:..." which makes is_generic_function emit unreachable bodies.
    let normalized = mir_param_normalize_option_result_type_name(p_type_name.clone())
    if len(normalized) > 0 {
        push(result, normalized.clone())
        push(result, normalized.clone())
        return result
    }
    if ctx_struct_layout::ctx_is_registered_struct_type(ctx, p_type_name.clone()) {
        push(result, p_type_name.clone())
        push(result, ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, p_type_name.clone()))
        return result
    }
    if ctx_struct_layout::ctx_is_registered_enum_type(ctx, p_type_name.clone()) {
        let mt = String_from("enum:").concat(p_type_name)
        push(result, mt)
        push(result, mt.clone())
        return result
    }
    if !binary_type_names::mir_is_builtin_type_name(p_type_name.clone()) && len(p_type_name) > 0 {
        let mt = String_from("?").concat(p_type_name.clone())
        push(result, mt)
        push(result, mt.clone())
        return result
    }
    result
}

fn mir_param_normalize_option_result_type_name(type_name: String) -> String {
    if type_name.clone().starts_with(String_from("option:")) || type_name.clone().starts_with(String_from("result:")) {
        return type_name
    }
    if type_name.clone().starts_with(String_from("Option_")) {
        return String_from("option:").concat(type_name.slice(7, len(type_name)))
    }
    if type_name.clone().starts_with(String_from("Option:")) {
        return String_from("option:").concat(type_name.slice(7, len(type_name)))
    }
    if type_name.clone().starts_with(String_from("?Option:")) {
        return String_from("option:").concat(type_name.slice(8, len(type_name)))
    }
    if type_name.clone().starts_with(String_from("Option<")) && type_name.clone().ends_with(String_from(">")) {
        return String_from("option:").concat(type_name.slice(7, len(type_name) - 1))
    }
    if type_name.clone().starts_with(String_from("Result:")) {
        return String_from("result:").concat(type_name.slice(7, len(type_name)))
    }
    if type_name.clone().starts_with(String_from("?Result:")) {
        return String_from("result:").concat(type_name.slice(8, len(type_name)))
    }
    if type_name.clone().starts_with(String_from("Result_")) {
        return String_from("result:").concat(type_name.slice(7, len(type_name)))
    }
    String_new()
}

fn mir_param_resolve_named_user_type(ctx: LowerCtx, bare: String) -> String {
    // Named user type not yet in layout table (or all-i32
    // struct that previously skipped GC registration): still
    // use the GC ABI so range_iter(Range) is not i32.
    // Unsubstituted type params (T, U, ...) stay i32.
    if !binary_type_names::mir_is_builtin_type_name(bare.clone()) && len(bare) > 0 && !mir_param_name_is_type_param(bare.clone()) {
        return bare
    }
    String_new()
}

fn mir_param_strip_module_prefix(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    name.clone()
}

fn mir_param_name_is_type_param(name: String) -> bool {
    if len(name) == 0 {
        return false
    }
    if name.clone().starts_with(String_from("?")) {
        return mir_param_name_is_type_param(name.slice(1, len(name)))
    }
    if len(name) == 1 {
        let ch = name.byte_at(0)
        if ch >= 65 && ch <= 90 {
            return true
        }
    }
    false
}
