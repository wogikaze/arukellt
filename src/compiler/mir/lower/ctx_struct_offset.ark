use std::prelude::{clone}
use mir::lower::ctx_struct_storage
use mir::lower::ctx_struct_size
fn ctx_struct_field_offset(ctx: LowerCtx, struct_name: String, target_field_idx: i32) -> i32 {
    let li = ctx_struct_storage::ctx_struct_layout_preferred_index(ctx, clone(struct_name))
    if li >= 0 {
        let offset = ctx_struct_storage::ctx_struct_layout_field_offset_at(ctx, li)
        let fc = ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, li)
        let mut byte_off = 0
        let mut fi = 0
        while fi < target_field_idx && fi < fc {
            let ft = ctx_struct_storage::ctx_struct_field_type_at_offset(ctx, offset + fi)
            byte_off = byte_off + ctx_struct_size::ctx_struct_field_byte_size(ft)
            fi = fi + 1
        }
        return byte_off
    }
    target_field_idx * 4
}
