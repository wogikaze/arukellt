use std::prelude::{clone}
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_types
use mir::inst_call
use mir::lower::call_arg_i64
use mir::lower::call_args
use mir::lower::call_emit_dest
use mir::lower::call_emit_staged
use mir::lower::call_rewrite
use mir::lower::call_type_vec
use mir::lower::call_types
use mir::value_types
// Position (1-based argument index) of the compile-time lane operand, or -1
// when the callee has none. The SIMD lane intrinsics put the lane second;
// the v128 memory lane intrinsics are (address, offset, value, lane).
fn mir_simd_lane_immediate_argument_index(callee_name: String) -> i32 {
    if eq(clone(callee_name), "__wasm_v128_load_lane") {
        return 4
    }
    if eq(clone(callee_name), "__wasm_v128_store_lane") {
        return 4
    }
    if mir_is_simd_lane_immediate_callee(clone(callee_name)) {
        return 2
    }
    0 - 1
}

fn mir_is_simd_lane_immediate_callee(callee_name: String) -> bool {
    if clone(callee_name).starts_with(String_from("__simd_")) && clone(callee_name).ends_with(String_from("_replace_lane")) {
        return true
    }
    if clone(callee_name).starts_with(String_from("__simd_")) && clone(callee_name).ends_with(String_from("_extract_lane")) {
        return true
    }
    if clone(callee_name).starts_with(String_from("__simd_")) && clone(callee_name).ends_with(String_from("_extract_lane_s")) {
        return true
    }
    if clone(callee_name).starts_with(String_from("__simd_")) && clone(callee_name).ends_with(String_from("_extract_lane_u")) {
        return true
    }
    false
}

fn mir_emit_direct_call(
    mut ctx: LowerCtx,
    callee_text: String,
    arg_count: i32,
    first_arg_idx: i32,
    second_arg_idx: i32,
    staged_arg_locals: Vec<i32>,
    mut arg_widen_i64: Vec<i32>,
    stage_call_args: bool,
    span_start: i32,
    lane_immediate: i32,
    receiver_writeback: i32
) -> i32 {
    let call_rewrite = call_rewrite::mir_rewrite_call_target(ctx, clone(callee_text), first_arg_idx, second_arg_idx, stage_call_args, span_start)
    let return_local = call_rewrite::MirCallRewrite_return_local(call_rewrite)
    if return_local >= 0 {
        return return_local
    }
    let callee_name = call_rewrite::MirCallRewrite_callee_name(call_rewrite)
    let dest = call_emit_dest::mir_prepare_direct_call_dest(ctx, clone(callee_name), first_arg_idx)
    call_types::mir_mark_call_result_type(ctx, clone(callee_name), dest, first_arg_idx)
    let mut dest_vt = value_types::VT_VOID()
    if dest >= 0 {
        dest_vt = ctx_api_local_types::ctx_local_vt(ctx, dest)
    }
    if stage_call_args {
        let mut push_i64_needs_extend = call_rewrite::MirCallRewrite_push_i64_needs_extend(call_rewrite)
        let staged_count = staged_arg_locals.len()
        if !push_i64_needs_extend && staged_count > 0 {
            let last_param = staged_count - 1
            let last_local = staged_arg_locals.get_unchecked(last_param)
            if ctx_api_local_types::ctx_local_vt(ctx, last_local) == value_types::VT_I32() {
                if call_arg_i64::mir_callee_param_is_i64(ctx, clone(callee_name), last_param) {
                    push_i64_needs_extend = true
                }
            }
        }
        // The legacy vec_push rewrite flag predates the per-param widen
        // table; map it onto the last staged arg, matching the old emit
        // order (extend applied to the final pushed value).
        if push_i64_needs_extend && staged_count > 0 {
            while arg_widen_i64.len() < staged_count {
                arg_widen_i64.push(0)
            }
            arg_widen_i64.set(staged_count - 1, 1)
        }
        call_emit_staged::mir_emit_staged_call_args(ctx, staged_arg_locals, arg_widen_i64)
    }
    // Prefer pre-stage receiver for GC mutating calls (push_char writeback).
    // Staged temps are stack copies; writing them back does not update `let mut s`.
    let mut recorded_first = first_arg_idx
    if receiver_writeback >= 0 {
        recorded_first = receiver_writeback
    }
    // Record the vec/receiver local on calls whose emit resolves types from
    // it (printlike, vec intrinsics) so GC emit reads the lowering's truth
    // instead of scanning stack operands (#730, #917).
    // Do not record first_arg on len/is_empty: STRUCT_GET→CALL stack-compose
    // keeps the vec on the stack only when CALL.arg0 < 0 (#807 / #834).
    if recorded_first >= 0 && (
        call_args::mir_is_printlike_callee(clone(callee_name)) ||
        call_type_vec::is_vec_receiver_recording_callee(clone(callee_name))
    ) {
        ctx_api_emit::ctx_emit(ctx, inst_call::MirInst_call_with_first_arg_vt(clone(callee_name), arg_count, dest, recorded_first, dest_vt))
    } else if lane_immediate >= 0 && mir_simd_lane_immediate_argument_index(clone(callee_name)) >= 0 {
        ctx_api_emit::ctx_emit(ctx, inst_call::MirInst_call_with_lane_vt(clone(callee_name), arg_count, dest, lane_immediate, dest_vt))
    } else {
        ctx_api_emit::ctx_emit(ctx, inst_call::MirInst_call_with_val_type(clone(callee_name), arg_count, dest, dest_vt))
    }
    if dest < 0 {
        return 0 - 1
    }
    dest
}
