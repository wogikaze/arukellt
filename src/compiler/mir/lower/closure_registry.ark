use std::text
use mir::lower::ctx_fn_mono
use corehir::type_ann_node
use mir::local_access
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_module
use mir::lower::ctx_gc_struct
use mir::lower::closure_capture_type
use mir::lower::closure_env
use mir::lower::closure_env_layout
use mir::lower::closure_cells
use mir::lower::ctx_call_edges
use mir::lower::ctx_current_storage
use mir::lower::ctx_types
use mir::function_return_view
use mir::function_param_view
use mir::function_identity
use mir::lower::closure_storage
use mir::value_types
fn closure_clear_pending_bind(mut ctx: LowerCtx) {
    closure_storage::closure_storage_clear_pending_bind(ctx)
}

fn closure_next_synth_name(mut ctx: LowerCtx) -> String {
    closure_storage::closure_storage_next_synth_name(ctx)
}

fn closure_flush_pending_bind(mut ctx: LowerCtx, bind_name: String) {
    if len(closure_storage::closure_storage_pending_synth(ctx)) == 0 && !ctx.closure_last_identity {
        return
    }
    closure_storage::closure_storage_push_bind(ctx, bind_name)
    closure_clear_pending_bind(ctx)
}

fn closure_register_synth_fn(mut ctx: LowerCtx, mut mf: MirFunction, packed: String, extra: i32, has_env_cell: i32, wb_caps: Vec<String>, wb_rebinds: Vec<i32>, wb_is_move: i32) -> i32 {
    ctx_api_module::ctx_push_module_function(ctx, mf)
    ctx_fn_mono::ctx_register_fn_signature(ctx, function_identity::MirFunction_name(mf), function_return_view::MirFunction_return_type(mf), "")
    // Managed env pair ABI (#872): the fn value is a {fnptr, env} record.
    // The env holds the supply captures (the same locals the direct-call
    // path passes as trailing args); a <synth>_env trampoline unpacks it
    // for indirect calls so both call paths observe identical semantics.
    let synth = function_identity::MirFunction_name(mf)
    let type_name = closure_funcref_type_name(mf, extra + has_env_cell)
    let cap_names = closure_env::closure_split_packed(packed)
    let mut cap_vts = Vec::new<i32>()
    let mut cap_types = Vec::new<String>()
    let mut ci = 0
    while ci < len(cap_names) {
        let li = ctx_api_local_alloc::ctx_lookup_local(ctx, get_unchecked(cap_names, ci).clone())
        if li >= 0 {
            push(cap_vts, ctx_api_local_types::ctx_local_vt(ctx, li))
            push(cap_types, closure_capture_type::mir_closure_lookup_capture_type(ctx, li))
        } else {
            push(cap_vts, value_types::VT_I32())
            push(cap_types, String_new())
        }
        ci = ci + 1
    }
    let env_name = closure_env::closure_env_type_name(synth.clone())
    ctx_gc_struct::ctx_ensure_fnpair_struct(ctx)
    closure_env::closure_register_env_type(ctx, env_name.clone(), cap_types)
    let env_local = closure_env::closure_emit_env_alloc(ctx, env_name.clone(), cap_names, cap_vts)
    // env_local is registered only when the synth owns cells: a direct
    // name(...) call passes it as the trailing __env arg (#874).
    let bind_env = if has_env_cell != 0 { env_local } else { 0 - 1 }
    closure_storage::closure_storage_set_pending_bind(ctx, synth.clone(), packed.clone(), extra, bind_env)
    // Mutable-borrow write-through (#874, ADR-061): in a non-move
    // closure a rebound capture is a mutable borrow, so the env cell is
    // the shared place the borrow aliases. After every direct call the
    // source local must be refreshed from that field; move captures own
    // the cell outright, so they register no write-back pairs.
    if wb_is_move == 0 && env_local >= 0 {
        let env_total = closure_env_layout::closure_env_byte_size(cap_vts)
        let mut wb_off = 0
        let mut wi = 0
        while wi < len(cap_names) {
            let cvt = get_unchecked(cap_vts, wi)
            if wi < len(wb_rebinds) && get_unchecked(wb_rebinds, wi) != 0 {
                let src_li = ctx_api_local_alloc::ctx_lookup_local(
                    ctx,
                    get_unchecked(wb_caps, wi).clone()
                )
                if src_li >= 0 {
                    closure_cells::ctx_register_env_writeback(
                        ctx,
                        synth.clone(),
                        src_li,
                        env_local,
                        env_name.clone(),
                        wb_off,
                        wi,
                        env_total,
                        cvt
                    )
                }
            }
            wb_off = wb_off + closure_env_layout::closure_env_slot_width(cvt)
            wi = wi + 1
        }
    }
    // mf params are (closure_params..., captures..., __env?): subtract the
    // captures and the trailing env param to recover the user arity.
    let closure_param_count = function_param_view::MirFunction_param_count(mf) - extra - has_env_cell
    let tramp = closure_env::closure_synth_env_trampoline(ctx, synth, mf, env_name, cap_vts, closure_param_count, has_env_cell)
    // The trampoline's own call edge is dropped by the edge-frame
    // bookkeeping (same as synthetic fn bodies), so keep the synthetic
    // function reachable from the producing frame explicitly.
    ctx_call_edges::ctx_edge_record_name(ctx, synth.clone())
    let pair = closure_env::closure_emit_pair(ctx, env_local, tramp.clone())
    ctx_api_local_types::ctx_set_local_type(ctx, pair, type_name.clone())
    pair
}

fn closure_register_identity(mut ctx: LowerCtx) -> i32 {
    closure_storage::closure_storage_set_pending_identity(ctx)
    0 - 1
}

fn closure_funcref_type_name(mf: MirFunction, cap_count: i32) -> String {
    // mf params are (closure_params..., captures...); the fn value's arity
    // counts only the user-visible closure params.
    let closure_params = function_param_view::MirFunction_param_count(mf) - cap_count
    if closure_params >= 2 {
        // Mirrors the fn(...) -> T annotation rule in type_ann_node: keep the
        // fnref2 bucket for i32-family returns, but a named non-scalar return
        // spells fnsig:<params>;<ret> so indirect-call dests carry the real
        // type instead of collapsing to i32 (and i64 on GC) (#874/#881).
        let ret_seg_multi = function_return_view::MirFunction_return_type_name(mf)
        if len(ret_seg_multi) > 0 && !type_ann_node::fn_sig_segment_is_i32_family(ret_seg_multi.clone()) {
            let mut params = String_new()
            let mut pi = 0
            while pi < closure_params {
                if pi > 0 {
                    params = params.concat(String_from(","))
                }
                let mut pseg = local_access::MirLocal_type_name(function_param_view::MirFunction_param_at(mf, pi))
                if len(pseg) == 0 {
                    pseg = String_from("i32")
                }
                params = params.concat(pseg)
                pi = pi + 1
            }
            return String_from("fnsig:").concat(params.clone().concat(String_from(";").concat(ret_seg_multi)))
        }
        return "fnref2"
    }
    // fnsig:<param>;<return> keeps the result type reachable at indirect
    // call sites (mark_fnsig_callback_result_type); scalar-only
    // signatures stay on the legacy buckets, mirroring the annotation
    // spelling rules. Zero-param closures spell fnsig:;<return> so a
    // ref-returning thunk still types its call result (#872).
    let mut ret_seg = function_return_view::MirFunction_return_type_name(mf)
    if len(ret_seg) == 0 {
        // No name means the signature never carried one; keep the legacy
        // bucket rather than emitting a fnsig with an empty segment.
        return "fnref"
    }
    if closure_params == 0 {
        if len(ret_seg) == 0 || type_ann_node::fn_sig_segment_is_i32_family(ret_seg.clone()) {
            return "fnref"
        }
        return String_from("fnsig:;").concat(ret_seg)
    }
    let param = function_param_view::MirFunction_param_at(mf, 0)
    let mut param_seg = local_access::MirLocal_type_name(param)
    if len(param_seg) == 0 {
        param_seg = "i32"
    }
    if param_seg.clone().eq(String_from("String")) && ret_seg.clone().eq(String_from("String")) {
        return String_from("fnrefss")
    }
    if param_seg.clone().eq(String_from("String")) && ret_seg.clone().eq(String_from("bool")) {
        return String_from("fnrefsb")
    }
    if type_ann_node::fn_sig_segment_is_i32_family(param_seg.clone()) &&
    type_ann_node::fn_sig_segment_is_i32_family(ret_seg.clone()) {
        return String_from("fnref")
    }
    String_from("fnsig:").concat(param_seg.clone().concat(String_from(";").concat(ret_seg)))
}

fn ctx_closure_lookup(ctx: LowerCtx, name: String) -> i32 {
    let cur_fn = function_identity::MirFunction_name(
        ctx_current_storage::ctx_current_func_value(ctx)
    )
    let count = closure_storage::closure_storage_bind_count(ctx)
    let mut i = count - 1
    while i >= 0 {
        if closure_storage::closure_storage_bind_name_at(ctx, i).eq(name.clone()) &&
        closure_storage::closure_storage_bind_fn_at(ctx, i).eq(cur_fn.clone()) {
            return i
        }
        i = i - 1
    }
    0 - 1
}

fn ctx_closure_synth_at(ctx: LowerCtx, index: i32) -> String {
    closure_storage::closure_storage_bind_synth_at(ctx, index)
}

fn ctx_closure_caps_at(ctx: LowerCtx, index: i32) -> String {
    closure_storage::closure_storage_bind_caps_at(ctx, index)
}

fn ctx_closure_extra_at(ctx: LowerCtx, index: i32) -> i32 {
    closure_storage::closure_storage_bind_extra_at(ctx, index)
}

fn ctx_closure_env_local_at(ctx: LowerCtx, index: i32) -> i32 {
    closure_storage::closure_storage_bind_env_at(ctx, index)
}

fn ctx_closure_is_identity(ctx: LowerCtx, index: i32) -> bool {
    closure_storage::closure_storage_bind_identity_at(ctx, index)
}
