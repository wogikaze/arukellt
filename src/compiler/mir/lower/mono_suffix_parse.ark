use std::prelude::{clone, eq}
use std::text
fn split_mono_suffix(suffix: String) -> Vec<String> {
    let mut result = Vec::new<String>()
    let slen = len(suffix)
    let mut start = 0
    let mut i = 0
    while i < slen - 1 {
        if suffix.byte_at(i) == 95 && suffix.byte_at(i + 1) == 95 {
            push(result, suffix.slice(start, i))
            start = i + 2
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if start <= slen {
        push(result, suffix.slice(start, slen))
    }
    result
}

// Fallback ordinal for a type-variable name when the function's declared
// parameter list is unavailable. The declared list is authoritative; this
// only preserves the historical single-letter convention for call sites
// that carry nothing but a name. Ordinal placeholders (t0, T0, t12, ...)
// bind by their numeric suffix.
fn mono_type_var_to_index(type_var: String) -> i32 {
    let mut name = clone(type_var)
    if clone(name).starts_with("?") {
        name = name.slice(1, len(name))
    }
    let name_len = len(name)
    if name_len >= 2 {
        let first = clone(name).byte_at(0)
        if first == 116 || first == 84 {
            let mut num = 0
            let mut all_digits = true
            let mut i = 1
            while i < name_len {
                let digit = clone(name).byte_at(i)
                if digit < 48 || digit > 57 {
                    all_digits = false
                } else {
                    num = num * 10 + (digit - 48)
                }
                i = i + 1
            }
            if all_digits {
                return num
            }
        }
    }
    if eq(clone(name), "T") { return 0 }
    if eq(clone(name), "E") { return 1 }
    if eq(clone(name), "U") { return 2 }
    if eq(clone(name), "V") { return 3 }
    if eq(clone(name), "W") { return 4 }
    if eq(clone(name), "K") { return 0 }
    if eq(clone(name), "A") { return 0 }
    if eq(clone(name), "B") { return 1 }
    if eq(clone(name), "C") { return 2 }
    if eq(clone(name), "D") { return 3 }
    0
}

// Position of a type variable in the function's declared type-parameter
// list, or -1 when it is not a declared name. MonoInstance type arguments
// and the mangled suffix keys are both recorded in this declaration order,
// so this is the only ordinal that binds R/W-style names to their own
// concrete layouts.
fn mono_type_var_decl_index(type_var: String, type_params: Vec<String>) -> i32 {
    let mut name = clone(type_var)
    if clone(name).starts_with("?") {
        name = name.slice(1, len(name))
    }
    let count = len(type_params)
    let mut i = 0
    while i < count {
        if eq(get_unchecked(type_params, i), clone(name)) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn mono_type_var_index(type_var: String, type_params: Vec<String>) -> i32 {
    let declared = mono_type_var_decl_index(clone(type_var), type_params)
    if declared >= 0 {
        return declared
    }
    mono_type_var_to_index(type_var)
}

fn mono_type_var_name_at(index: i32) -> String {
    if index == 0 { return "T" }
    if index == 1 { return "E" }
    if index == 2 { return "U" }
    if index == 3 { return "V" }
    if index == 4 { return "W" }
    "T".concat((index).to_string())
}

fn extract_first_type_var(rest: String) -> String {
    let rlen = len(rest)
    let mut ci = 0
    while ci < rlen {
        if rest.byte_at(ci) == 58 {
            return rest.slice(0, ci)
        }
        ci = ci + 1
    }
    rest
}

fn extract_mono_suffix(fn_name: String) -> String {
    let name_len = len(fn_name)
    let mut sep_positions = Vec::new<i32>()
    let mut i = 0
    while i < name_len - 1 {
        if fn_name.byte_at(i) == 95 && fn_name.byte_at(i + 1) == 95 {
            push(sep_positions, i)
        }
        i = i + 1
    }
    let sep_count = len(sep_positions)
    if sep_count == 0 {
        return String_new()
    }
    let mut si = 0
    while si < sep_count {
        let sep_pos = get_unchecked(sep_positions, si)
        let suffix = fn_name.slice(sep_pos + 2, name_len)
        let type_keys = split_mono_suffix(suffix)
        let key_count = len(type_keys)
        if key_count > 0 && all_valid_mono_type_keys(type_keys, key_count) {
            return suffix
        }
        si = si + 1
    }
    // No valid mono type-key suffix. Do not fall back to an arbitrary "__"
    // split: names like "__core_vec_contains_i32_impl" and "foo__scan" are
    // not monomorphizations, and treating them as such rewrites concrete
    // Vec<i32> params into structref-array Vec layouts.
    String_new()
}

// Structural type-variable test shared by param/return substitution, mono
// suffix parsing and the wasm signature fallback. A hardcoded letter list
// silently dropped R/Z/Y and left their params as TYPE_VAR (#693).
fn is_mono_type_var_name(type_name: String) -> bool {
    if len(type_name) == 0 {
        return false
    }
    if clone(type_name).starts_with("?") {
        return is_mono_type_var_name(type_name.slice(1, len(type_name)))
    }
    if len(type_name) == 1 {
        let c = type_name.byte_at(0)
        if c >= 65 && c <= 90 {
            return true
        }
        return false
    }
    // Ordinal placeholders: t0, T0, t12, ...
    let c0 = type_name.byte_at(0)
    if c0 == 116 || c0 == 84 {
        let mut i = 1
        let mut all_digit = true
        while i < len(type_name) {
            let c = type_name.byte_at(i)
            if c < 48 || c > 57 {
                all_digit = false
            }
            i = i + 1
        }
        if all_digit {
            return true
        }
    }
    false
}

fn all_valid_mono_type_keys(type_keys: Vec<String>, key_count: i32) -> bool {
    let mut ki = 0
    while ki < key_count {
        let key = get_unchecked(type_keys, ki)
        if !is_valid_mono_type_key(key) {
            return false
        }
        ki = ki + 1
    }
    true
}

fn is_valid_mono_type_key(key: String) -> bool {
    if eq(clone(key), "i32") ||
    eq(clone(key), "i64") ||
    eq(clone(key), "f64") ||
    eq(clone(key), "f32") ||
    eq(clone(key), "bool") ||
    eq(clone(key), "char") ||
    eq(clone(key), "String") ||
    eq(clone(key), "string") {
        return true
    }
    // Nested container mangling uses underscores for type args
    // (Vec_i32_, Option_String, HashMap_i32_String_). These must be
    // accepted so count__Vec_i32_ substitutes vec:T → vec:Vec_i32_ and
    // takes the structref-array vec ABI (#808 nested_generic_call).
    if clone(key).starts_with("Vec_") ||
    clone(key).starts_with("Option_") ||
    clone(key).starts_with("Result_") ||
    clone(key).starts_with("HashMap_") ||
    clone(key).starts_with("HashSet_") {
        return true
    }
    // Nominal keys are PascalCase type names (Point). Reject snake_case
    // tails from module__FnName exports (Token_float_val).
    if len(key) > 0 {
        let first = key.byte_at(0)
        if first >= 65 && first <= 90 {
            let mut ki = 1
            while ki < len(key) {
                if key.byte_at(ki) == 95 {
                    return false
                }
                ki = ki + 1
            }
            return true
        }
    }
    false
}
