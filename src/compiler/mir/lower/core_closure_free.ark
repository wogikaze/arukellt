use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_types
use mir::lower::core_closure_free_acc
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_atoms
use mir::lower::core_expr_shape_calls
use mir::lower::core_expr_shape_ops
fn core_closure_is_param_name(exprs: Vec<CoreHirExpr>, clos: CoreHirExpr, name: String) -> bool {
    let c = core_expr_shape_accessors::mir_core_expr_child_count(clos)
    if c <= 1 {
        return false
    }
    let mut i = 0
    while i < c - 1 {
        let p = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(clos, i))
        if core_expr_shape_atoms::mir_core_expr_is_ident(p) && core_expr_shape_accessors::mir_core_expr_text(p).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn core_closure_collect_free(ctx: LowerCtx, exprs: Vec<CoreHirExpr>, expr: CoreHirExpr, clos: CoreHirExpr, mut acc: Vec<String>) {
    if core_expr_shape_calls::mir_core_expr_is_closure(expr) {
        // A nested closure reaches through this frame: the names it
        // frees must ride this closure's env, or the inner capture
        // resolves to a local the intermediate frame never received
        // and emit produces invalid Wasm (#900).
        let nested_body_count = core_expr_shape_accessors::mir_core_expr_child_count(expr)
        if nested_body_count > 0 {
            let nested_body = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(expr, nested_body_count - 1))
            core_closure_collect_free(ctx, exprs, nested_body, expr, acc)
        }
        return
    }
    if core_expr_shape_atoms::mir_core_expr_is_ident(expr) {
        let capture_name = core_expr_shape_accessors::mir_core_expr_text(expr)
        if core_closure_is_param_name(exprs, clos, capture_name.clone()) {
            return
        }
        if ctx_api_local_alloc::ctx_lookup_local(ctx, capture_name.clone()) < 0 {
            return
        }
        core_closure_free_acc::core_closure_push_unique_cap(acc, capture_name)
        return
    }
    let cc = core_expr_shape_accessors::mir_core_expr_child_count(expr)
    let mut ci = 0
    while ci < cc {
        core_closure_collect_free(ctx, exprs, exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(expr, ci)), clos, acc)
        ci = ci + 1
    }
}

fn core_closure_collect_caps(ctx: LowerCtx, exprs: Vec<CoreHirExpr>, clos: CoreHirExpr) -> Vec<String> {
    let mut caps = Vec::new<String>()
    let child_count = core_expr_shape_accessors::mir_core_expr_child_count(clos)
    if child_count > 0 {
        let cap_body = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(clos, child_count - 1))
        core_closure_collect_free(ctx, exprs, cap_body, clos, caps)
    }
    caps
}

// Flags parallel to caps: 1 when the body rebinds that capture with a
// plain name assignment. Mirrors closure_free::closure_collect_rebind_flags
// for the CoreHIR path (#874).
fn core_closure_collect_rebind_flags(exprs: Vec<CoreHirExpr>, clos: CoreHirExpr, caps: Vec<String>) -> Vec<i32> {
    let mut flags = Vec::new<i32>()
    let mut i = 0
    while i < caps.len() {
        flags.push(0)
        i = i + 1
    }
    let child_count = core_expr_shape_accessors::mir_core_expr_child_count(clos)
    if child_count == 0 {
        return flags
    }
    let body = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(clos, child_count - 1))
    core_closure_mark_rebind(exprs, body, caps, flags, Vec::new<String>())
    flags
}

fn core_closure_mark_rebind(exprs: Vec<CoreHirExpr>, expr: CoreHirExpr, caps: Vec<String>, mut flags: Vec<i32>, shadowed: Vec<String>) {
    if core_expr_shape_calls::mir_core_expr_is_closure(expr) {
        // A nested rebind of a name this frame captures still borrows
        // this frame's slot: the flag must ride up, or the env packs a
        // dead snapshot and the write is silently lost (#900). Nested
        // params shadow the outer name, so they join the blocked set.
        let nested_child_count = core_expr_shape_accessors::mir_core_expr_child_count(expr)
        if nested_child_count == 0 {
            return
        }
        let inner_shadowed = core_closure_extend_shadowed(exprs, expr, shadowed, nested_child_count)
        let nested_body = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(expr, nested_child_count - 1))
        core_closure_mark_rebind(exprs, nested_body, caps, flags, inner_shadowed)
        return
    }
    if core_expr_shape_ops::mir_core_expr_is_assign(expr) {
        // CoreHIR ASSIGN carries the plain target name in node text;
        // field/index targets leave it empty (ref mutation, not a rebind).
        let name = core_expr_shape_accessors::mir_core_expr_text(expr)
        if name.len() > 0 && !core_closure_name_is_shadowed(shadowed, name.clone()) {
            let mut ci = 0
            while ci < caps.len() {
                if caps.get_unchecked(ci).eq(name.clone()) {
                    flags.set(ci, 1)
                    ci = caps.len()
                }
                ci = ci + 1
            }
        }
    }
    let cc = core_expr_shape_accessors::mir_core_expr_child_count(expr)
    let mut i = 0
    while i < cc {
        core_closure_mark_rebind(
            exprs,
            exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(expr, i)),
            caps,
            flags,
            shadowed
        )
        i = i + 1
    }
}

// A fresh shadowed set for a nested closure's body keeps the params it
// adds from leaking into sibling subtrees.
fn core_closure_extend_shadowed(exprs: Vec<CoreHirExpr>, clos: CoreHirExpr, shadowed: Vec<String>, child_count: i32) -> Vec<String> {
    let mut inner = Vec::new<String>()
    let mut i = 0
    while i < shadowed.len() {
        inner.push(shadowed.get_unchecked(i).clone())
        i = i + 1
    }
    let mut pi = 0
    while pi < child_count - 1 {
        let param = exprs.get_unchecked(core_expr_shape_accessors::mir_core_expr_child(clos, pi))
        if core_expr_shape_atoms::mir_core_expr_is_ident(param) {
            inner.push(core_expr_shape_accessors::mir_core_expr_text(param))
        }
        pi = pi + 1
    }
    inner
}

fn core_closure_name_is_shadowed(shadowed: Vec<String>, name: String) -> bool {
    let mut i = 0
    while i < shadowed.len() {
        if shadowed.get_unchecked(i).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}
