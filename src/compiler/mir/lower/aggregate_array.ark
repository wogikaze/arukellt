use std::text
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::lower::ctx_types
use mir::inst_array
use mir::inst_local_get
use mir::value_types
fn mir_emit_array_new(mut ctx: LowerCtx, child_count: i32) -> i32 {
    let dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_GC_REF())
    ctx_api_emit::ctx_emit(ctx, inst_array::MirInst_array_new(dest, child_count))
    dest
}

fn mir_emit_array_set(mut ctx: LowerCtx, dest: i32, val_idx: i32, elem_index: i32) {
    ctx_api_emit::ctx_emit(ctx, inst_array::MirInst_array_set(dest, val_idx, elem_index))
}

// MIR_ARRAY_NEW is deliberately untyped, so infer the raw array element from
// the first value before the emitter chooses its GC array layout. Keep raw
// arrays distinct from Vec headers: both carry an element name, but only Vec
// values have the header struct around the backing array.
fn mir_set_array_type_from_value(mut ctx: LowerCtx, dest: i32, val_idx: i32) {
    let elem_type = mir_array_element_type_from_value(ctx, val_idx)
    if len(elem_type) == 0 {
        return
    }
    ctx_api_local_types::ctx_set_local_type(ctx, dest, "array:".concat(elem_type.clone()))
    ctx_api_local_types::ctx_set_local_vt(ctx, dest, value_types::VT_GC_REF())
}

fn mir_array_element_type_from_value(ctx: LowerCtx, val_idx: i32) -> String {
    let type_name = ctx_api_local_types::ctx_get_local_type(ctx, val_idx)
    if type_name.clone().eq("String") || type_name.clone().eq("string") {
        return "String"
    }
    if type_name.clone().starts_with("vec:") ||
    type_name.clone().starts_with("Vec_") ||
    type_name.clone().starts_with("Vec<") {
        return type_name.clone()
    }
    if type_name.clone().eq("i32") || type_name.clone().eq("I32") ||
    type_name.clone().eq("bool") || type_name.clone().eq("char") {
        return "i32"
    }
    if type_name.clone().eq("i64") || type_name.clone().eq("I64") {
        return "i64"
    }
    if type_name.clone().eq("f64") || type_name.clone().eq("F64") {
        return "f64"
    }
    if type_name.clone().eq("v128") || type_name.clone().eq("V128") {
        return "v128"
    }
    if type_name.clone().eq("fnref") || type_name.clone().starts_with("fnref") || type_name.clone().eq("fn") || type_name.clone().starts_with("fn(") {
        return "fnref"
    }
    let value_type = ctx_api_local_types::ctx_local_vt(ctx, val_idx)
    if value_type == value_types::VT_I64() {
        return "i64"
    }
    if value_type == value_types::VT_F64() {
        return "f64"
    }
    if value_type == value_types::VT_V128() {
        return "v128"
    }
    if value_type == value_types::VT_FUNCREF() {
        return "fnref"
    }
    if (value_type == value_types::VT_GC_REF() || value_type == value_types::VT_REF()) && len(type_name) > 0 {
        return type_name.clone()
    }
    "i32"
}

fn mir_array_element_type_from_container(container_type: String) -> String {
    if container_type.clone().starts_with("vec:") {
        return container_type.slice(4, len(container_type))
    }
    if container_type.clone().starts_with("array:") {
        return container_type.slice(6, len(container_type))
    }
    String_new()
}

fn mir_array_element_vt(element_type: String) -> i32 {
    if element_type.clone().eq("i64") || element_type.clone().eq("I64") {
        return value_types::VT_I64()
    }
    if element_type.clone().eq("f64") || element_type.clone().eq("F64") {
        return value_types::VT_F64()
    }
    if element_type.clone().eq("v128") || element_type.clone().eq("V128") {
        return value_types::VT_V128()
    }
    if element_type.clone().eq("fnref") || element_type.clone().starts_with("fnref") || element_type.clone().eq("fn") || element_type.clone().starts_with("fn(") {
        return value_types::VT_FUNCREF()
    }
    if element_type.clone().eq("i32") || element_type.clone().eq("I32") ||
    element_type.clone().eq("bool") || element_type.clone().eq("char") {
        return value_types::VT_I32()
    }
    value_types::VT_GC_REF()
}

fn mir_emit_local_get_ref(mut ctx: LowerCtx, local_idx: i32) -> i32 {
    ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get_to(local_idx, local_idx))
    local_idx
}

fn mir_emit_array_index(mut ctx: LowerCtx, base_idx: i32, index_idx: i32) -> i32 {
    let base_type = ctx_api_local_types::ctx_get_local_type(ctx, base_idx)
    let mut dest_type = mir_array_element_type_from_container(base_type.clone())
    if len(dest_type) == 0 {
        dest_type = "i32"
    }
    let dest_vt = mir_array_element_vt(dest_type.clone())
    let dest = ctx_api_local_alloc::ctx_fresh_local(ctx, dest_vt)
    ctx_api_local_types::ctx_set_local_type(ctx, dest, dest_type)
    ctx_api_emit::ctx_emit(ctx, inst_array::MirInst_array_get(base_idx, index_idx, dest))
    dest
}
