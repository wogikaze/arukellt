use mir::lower::ctx_api_local_types
use mir::lower::ctx_struct_layout
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_emit
use mir::inst_convert
use mir::inst_local_set
use mir::lower::expr_types
use mir::typed_mir_compat
use mir::value_types
fn emit_let_initializer_store(mut ctx: LowerCtx, node: AstNode, vt: i32, local_idx: i32, val_idx: i32, pre_init_kind: i32, ta_count: i32) {
    if val_idx < 0 {
        return
    }
    let mut binding_vt = vt
    if ta_count == 0 {
        let initializer_vt = ctx_api_local_types::ctx_local_vt(ctx, val_idx)
        // FUNCREF propagates like the other non-i32 value types so a
        // let-bound fn value keeps its pair-ABI marker on both backends
        // (#874).
        if initializer_vt == value_types::VT_F64() ||
        initializer_vt == value_types::VT_I64() ||
        initializer_vt == value_types::VT_GC_REF() ||
        initializer_vt == value_types::VT_FUNCREF() {
            binding_vt = initializer_vt
            ctx_api_local_types::ctx_set_local_vt(ctx, local_idx, initializer_vt)
        }
    }
    let actual_val_idx = sync_let_local_value_type(ctx, binding_vt, local_idx, val_idx)
    if actual_val_idx != local_idx {
        ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set_from(local_idx, actual_val_idx))
    }
    // Keep the initializer's concrete storage type across the let binding;
    // display names such as `List` and `String` are not nominally unique.
    // An explicit annotation is authoritative: a generic call result can
    // still carry the i64 default, so copy the annotation mvt onto the
    // initializer temp instead of overwriting the binding (#708).
    let val_mvt = ctx_api_local_types::ctx_local_mvt(ctx, actual_val_idx)
    if ta_count == 0 {
        ctx_api_local_types::ctx_set_local_mvt(ctx, local_idx, val_mvt)
    } else {
        let annotated_mvt = ctx_api_local_types::ctx_local_mvt(ctx, local_idx)
        if !typed_mir_compat::mvt_is_invalid(annotated_mvt) {
            ctx_api_local_types::ctx_set_local_mvt(ctx, actual_val_idx, annotated_mvt)
        } else {
            // No concrete annotation mvt: clear the initializer's scalar
            // default so the emitter resolves the annotated type name (#708).
            ctx_api_local_types::ctx_set_local_mvt(
                ctx,
                actual_val_idx,
                typed_mir_compat::mvt_invalid()
            )
        }
    }
    sync_let_local_type_name(ctx, local_idx, actual_val_idx, pre_init_kind, ta_count)
    let mut set_family = ctx_api_local_types::ctx_hashset_local_family(ctx, actual_val_idx)
    if len(set_family) == 0 {
        set_family = ctx_api_local_types::ctx_hashset_local_family(ctx, val_idx)
    }
    if len(set_family) > 0 {
        ctx_api_local_types::ctx_mark_hashset_local(ctx, local_idx, set_family)
    }
}

fn sync_let_local_value_type(mut ctx: LowerCtx, vt: i32, local_idx: i32, val_idx: i32) -> i32 {
    if ctx_api_local_types::ctx_local_vt(ctx, val_idx) == value_types::VT_F64() && ctx_api_local_types::ctx_local_vt(ctx, local_idx) == value_types::VT_I32() {
        ctx_api_local_types::ctx_set_local_vt(ctx, local_idx, value_types::VT_F64())
    }
    if vt == value_types::VT_I64() && ctx_api_local_types::ctx_local_vt(ctx, val_idx) == value_types::VT_I32() {
        let ext_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I64())
        ctx_api_emit::ctx_emit(ctx, inst_convert::MirInst_extend_i32_to_i64(ext_dest, val_idx))
        return ext_dest
    }
    val_idx
}

fn sync_let_local_type_name(mut ctx: LowerCtx, local_idx: i32, val_idx: i32, pre_init_kind: i32, ta_count: i32) {
    let existing = ctx_api_local_types::ctx_get_local_type(ctx, local_idx)
    if existing.clone().starts_with("enum:") {
        let init_type = ctx_api_local_types::ctx_get_local_type(ctx, val_idx)
        let init_vt = ctx_api_local_types::ctx_local_vt(ctx, val_idx)
        let is_enum_annotation = existing.clone().eq("enum:Option") || existing.clone().eq("enum:Result")
        let init_is_result = init_type.clone().starts_with("option:") ||
        init_type.clone().starts_with("result:") ||
        init_type.clone().starts_with("Option_") ||
        init_type.clone().starts_with("Result_")
        if is_enum_annotation && init_is_result {
            ctx_api_local_types::ctx_set_local_type(ctx, local_idx, init_type)
            return
        }
        if len(init_type) == 0 ||
        init_vt == value_types::VT_I32() ||
        init_vt == value_types::VT_I64() {
            // A scalar/default call-result temp under an enum annotation is
            // the initializer of a ref-valued binding; carry the annotation.
            ctx_api_local_types::ctx_set_local_type(ctx, val_idx, existing.clone())
            ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_GC_REF())
        }
        return
    }
    // A `Wrap<i32>` annotation is the concrete enum instantiation, not the
    // bare `enum:Wrap` storage name a call result carries. Keep the arguments
    // on both locals so match payload lowering can substitute the enum's type
    // parameters; without them the value takes the unsubstituted `T` layout.
    if ctx_struct_layout::ctx_type_name_is_generic_enum_instance(ctx, existing.clone()) {
        ctx_api_local_types::ctx_set_local_type(ctx, val_idx, existing.clone())
        ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_GC_REF())
        return
    }
    // Preserve specific Option_/Result_ annotation types from being overridden
    // by generic enum:open/enum:Option from the initializer, and propagate the
    // annotation to a scalar/empty call-result temp. A trait method returning
    // Result<T, E> otherwise registers its call dest as the i64 default while
    // the callee actually returns the Result ref (#708).
    if existing.clone().eq("Option") || existing.clone().eq("Result") ||
    existing.clone().starts_with("Option_") ||
    existing.clone().starts_with("Result_") ||
    existing.clone().starts_with("option:") ||
    existing.clone().starts_with("result:") {
        // The annotation is authoritative even when the callee's placeholder
        // Result is a GC ref without the concrete args (#708).
        ctx_api_local_types::ctx_set_local_type(ctx, val_idx, existing.clone())
        ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_GC_REF())
        let mvt = ctx_api_local_types::ctx_local_mvt(ctx, local_idx)
        if !typed_mir_compat::mvt_is_invalid(mvt) {
            ctx_api_local_types::ctx_set_local_mvt(ctx, val_idx, mvt)
        } else {
            ctx_api_local_types::ctx_set_local_mvt(ctx, val_idx, typed_mir_compat::mvt_invalid())
        }
        return
    }
    // Preserve explicit vec:/hashmap: annotations (e.g. Vec<Vec<i32>> → vec:Vec)
    // so Vec::new<i32>() initializers do not collapse nested container locals to vec:i32.
    if existing.clone().starts_with("vec:") || existing.clone().starts_with("hashmap:") || existing.clone().starts_with("hashset:") {
        // Propagate the annotation back onto the initializer temp so Vec_new
        // emission (resolve_vec_type_for_new_dest) sees vec:Vec / structref layout.
        let init_type = ctx_api_local_types::ctx_get_local_type(ctx, val_idx)
        if init_type.clone().starts_with("vec:") || len(init_type) == 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, val_idx, existing.clone())
            ctx_api_local_types::ctx_set_local_vt(ctx, val_idx, value_types::VT_GC_REF())
        }
        return
    }
    // An explicit `fn(...) -> R` annotation (fnsig:/fn( spellings) carries the
    // concrete callback signature; the opaque `fnref*` bucket stored on a
    // lowered pair initializer is not a refinement. Letting it overwrite
    // drops the return segment, so indirect-call dests fall back to the
    // scalar bucket and land in i64 locals on GC (#872).
    if existing.clone().starts_with("fnsig:") || existing.clone().starts_with("fn(") {
        return
    }
    let init_type = ctx_api_local_types::ctx_get_local_type(ctx, val_idx)
    if len(init_type) > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, local_idx, init_type)
    }
    if ta_count == 0 && len(ctx_api_local_types::ctx_get_local_type(ctx, local_idx)) == 0 {
        let mut literal_type_name = expr_types::mir_literal_kind_type_name(pre_init_kind)
        let initializer_vt = ctx_api_local_types::ctx_local_vt(ctx, val_idx)
        if initializer_vt == value_types::VT_I64() {
            literal_type_name = "i64"
        }
        if len(literal_type_name) > 0 {
            ctx_api_local_types::ctx_set_local_type(ctx, local_idx, literal_type_name)
        }
    }
}
