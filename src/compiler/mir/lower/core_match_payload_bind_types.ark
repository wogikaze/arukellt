// CoreHIR match payload bind types.
use std::text
use mir::lower::ctx_api_local_types
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_struct
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_layout
use mir::lower::ctx_struct_mono
use mir::lower::match_payload_field_type
use mir::value_types
fn core_match_variant_is_err(variant_name: String) -> bool {
    variant_name.clone().eq("Err") || variant_name.clone().eq("Result::Err")
}

fn core_payload_type_is_fnref(type_name: String) -> bool {
    type_name.clone().eq("fnref") ||
    type_name.clone().eq("fn") ||
    type_name.clone().starts_with("fn(")
}

fn core_match_variant_is_some_or_ok(variant_name: String) -> bool {
    if variant_name.clone().eq("Ok") || variant_name.clone().eq("Result::Ok") {
        return true
    }
    if variant_name.clone().eq("Some") || variant_name.clone().eq("Option::Some") {
        return true
    }
    false
}

fn core_payload_field_vt(
    ctx: LowerCtx,
    variant_name: String,
    field_idx: i32,
    scrut_ok_is_f64: bool,
    scrut_ok_is_i64: bool,
    scrut_ok_is_ref: bool,
    scrut_type: String
) -> i32 {
    let field_type = match_payload_field_type::mir_variant_payload_type_name_for_scrut(
        ctx,
        variant_name.clone(),
        field_idx,
        String_new(),
        scrut_type.clone()
    )
    if core_payload_type_is_fnref(field_type.clone()) {
        return value_types::VT_FUNCREF()
    }
    // Inspect the declaration before the compact variant signature.  The
    // signature repeats `_f1_*` for each field, so a reference payload later
    // in the variant must not change an earlier scalar bind to a ref.
    if field_type.clone().eq("f64") || field_type.clone().eq("F64") {
        return value_types::VT_F64()
    }
    if field_type.clone().eq("i64") || field_type.clone().eq("I64") {
        return value_types::VT_I64()
    }
    if core_payload_scalar_type_name(field_type.clone()) {
        return value_types::VT_I32()
    }
    // _f1_fnref must not be treated as an open GC ref payload (#831).
    let slot = ctx_gc_enum::ctx_gc_enum_variant_slot(ctx, variant_name.clone())
    if slot >= 0 && field_idx == 0 {
        let sig = get_unchecked(ctx.gc_enum_variant_sigs, slot).clone()
        if sig.clone().contains("_f1_fnref") {
            return value_types::VT_FUNCREF()
        }
    }
    if ctx_struct_layout::ctx_struct_field_is_gc_ref(ctx, variant_name.clone(), field_idx + 1) {
        return value_types::VT_GC_REF()
    }
    if field_type.len() > 0 && !core_payload_scalar_type_name(field_type.clone()) {
        return value_types::VT_GC_REF()
    }
    if core_match_variant_is_err(variant_name.clone()) && field_idx == 0 {
        return value_types::VT_GC_REF()
    }
    if scrut_ok_is_ref && field_idx == 0 {
        if core_match_variant_is_some_or_ok(variant_name.clone()) {
            return value_types::VT_GC_REF()
        }
    }
    let mut field_is_f64 = ctx_struct_layout::ctx_struct_field_is_f64(ctx, variant_name.clone(), field_idx + 1)
    if !field_is_f64 && scrut_ok_is_f64 && field_idx == 0 {
        if core_match_variant_is_some_or_ok(variant_name.clone()) {
            field_is_f64 = true
        }
    }
    if field_is_f64 {
        return value_types::VT_F64()
    }
    let field_is_i64 = ctx_struct_layout::ctx_struct_field_is_i64(ctx, variant_name.clone(), field_idx + 1)
    if field_is_i64 {
        return value_types::VT_I64()
    }
    if scrut_ok_is_i64 && field_idx == 0 {
        if core_match_variant_is_some_or_ok(variant_name.clone()) {
            return value_types::VT_I64()
        }
    }
    if ctx_gc_enum::ctx_is_gc_target(ctx) && core_payload_gc_field_is_ref(ctx, variant_name.clone(), field_idx, scrut_type.clone()) {
        return value_types::VT_GC_REF()
    }
    value_types::VT_I32()
}

fn core_payload_gc_field_is_ref(ctx: LowerCtx, variant_name: String, field_idx: i32, scrut_type: String) -> bool {
    let declared_type = match_payload_field_type::mir_variant_payload_type_name_for_scrut(
        ctx,
        variant_name.clone(),
        field_idx,
        String_new(),
        scrut_type.clone()
    )
    if core_payload_scalar_type_name(declared_type.clone()) ||
    core_payload_type_is_fnref(declared_type.clone()) {
        return false
    }
    let slot = ctx_gc_enum::ctx_gc_enum_variant_slot(ctx, variant_name.clone())
    if slot < 0 {
        return false
    }
    let sig = get_unchecked(ctx.gc_enum_variant_sigs, slot).clone()
    if field_idx == 0 {
        // Typed funcref payload is not an open enum/GC struct ref (#831).
        if sig.clone().contains("_f1_fnref") {
            return false
        }
        if sig.clone().contains("_f1_ref") {
            return true
        }
    }
    false
}

fn core_payload_i32_name_needs_type(variant_name: String) -> bool {
    core_match_variant_is_some_or_ok(variant_name)
}

fn set_gc_payload_bind_type_if_needed(mut ctx: LowerCtx, variant_name: String, bind_local: i32, bind_vt: i32, field_idx: i32) {
    if bind_vt != value_types::VT_GC_REF() {
        return
    }
    let field_type = ctx_mono_type_params::ctx_resolve_mono_type_name(
        ctx,
        ctx_struct_field_type::ctx_struct_field_type_name(ctx, variant_name.clone(), field_idx + 1)
    )
    if field_type.clone().eq("String") || field_type.clone().eq("string") {
        ctx_api_local_types::ctx_set_local_type(ctx, bind_local, "string")
        return
    }
    // Vec<T> must stay a container type — never enum:Vec<...> (#726 toml Table).
    let vec_type = normalize_core_payload_vec_type_name(field_type.clone())
    if vec_type.len() > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, bind_local, vec_type)
        ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
        return
    }
    if field_type.len() > 0 &&
    ctx_struct_layout::ctx_is_registered_enum_type(ctx, field_type.clone()) &&
    !ctx_struct_layout::ctx_is_registered_struct_type(ctx, field_type.clone()) {
        ctx_api_local_types::ctx_set_local_type(ctx, bind_local, "enum:".concat(field_type))
        ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
        return
    }
    if field_type.len() > 0 && !core_payload_scalar_type_name(field_type.clone()) {
        // Named GC structs keep bare names for gcsref Option payloads (#726).
        // Linear-memory targets have no GC struct slots; the layout registry
        // must also keep a bare struct name or field binds resolve as enum:Name
        // and every field index falls back to 0.
        let derived_field = ctx_struct_mono::ctx_derive_generic_struct_type_name(ctx, field_type.clone())
        if ctx_gc_struct::ctx_gc_struct_slot(ctx, derived_field.clone()) >= 0 ||
        ctx_struct_layout::ctx_is_registered_struct_type(ctx, derived_field.clone()) {
            ctx_api_local_types::ctx_set_local_type(ctx, bind_local, derived_field)
        } else {
            ctx_api_local_types::ctx_set_local_type(ctx, bind_local, "enum:".concat(field_type))
        }
        ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_GC_REF())
        return
    }
    if core_match_variant_is_err(variant_name.clone()) && field_idx == 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, bind_local, "string")
    }
}

fn normalize_core_payload_vec_type_name(field_type: String) -> String {
    if field_type.clone().starts_with("vec:") {
        return field_type
    }
    if field_type.clone().eq("Vec") {
        return "vec:i32"
    }
    if field_type.clone().starts_with("Vec<") && field_type.clone().ends_with(">") {
        let inner = field_type.clone().slice(4, field_type.len() - 1)
        return "vec:".concat(inner)
    }
    if field_type.clone().starts_with("Vec_") {
        let inner = field_type.clone().slice(4, field_type.len())
        return "vec:".concat(inner)
    }
    String_new()
}

fn core_payload_scalar_type_name(type_name: String) -> bool {
    if type_name.clone().eq("i32") || type_name.clone().eq("I32") {
        return true
    }
    if type_name.clone().eq("i64") || type_name.clone().eq("I64") {
        return true
    }
    if type_name.clone().eq("u64") || type_name.clone().eq("U64") {
        return true
    }
    if type_name.clone().eq("f64") || type_name.clone().eq("F64") {
        return true
    }
    if type_name.clone().eq("bool") || type_name.clone().eq("Bool") {
        return true
    }
    if type_name.clone().eq("char") {
        return true
    }
    if match_payload_field_type::mir_narrow_int_type_name(type_name.clone()) {
        return true
    }
    // Result<(), E> Ok payload is i32 0 (#726 toml_insert_key).
    if type_name.clone().eq("unit") || type_name.clone().eq("()") || type_name.clone().eq("void") {
        return true
    }
    false
}

// Narrow integer payload binds keep the declared spelling instead of the
// collapsed i32 ABI slot. Option/Result binds recover it from the scrutinee;
// user enum variants only carry the declared field type.
fn set_narrow_int_payload_bind_type_if_needed(mut ctx: LowerCtx, variant_name: String, bind_local: i32, bind_vt: i32, field_idx: i32) {
    if bind_vt != value_types::VT_I32() {
        return
    }
    if ctx_api_local_types::ctx_get_local_type(ctx, bind_local).len() > 0 {
        return
    }
    let field_type = ctx_mono_type_params::ctx_resolve_mono_type_name(
        ctx,
        ctx_struct_field_type::ctx_struct_field_type_name(ctx, variant_name.clone(), field_idx + 1)
    )
    if !match_payload_field_type::mir_narrow_int_type_name(field_type.clone()) {
        return
    }
    ctx_api_local_types::ctx_set_local_type(ctx, bind_local, field_type)
    ctx_api_local_types::ctx_set_local_vt(ctx, bind_local, value_types::VT_I32())
}

fn normalize_payload_elem_type_name(elem_ty: String) -> String {
    if elem_ty.clone().eq("Vec") {
        return "vec:i32"
    }
    if elem_ty.clone().starts_with("Vec<") && elem_ty.clone().ends_with(">") {
        let inner = elem_ty.clone().slice(4, elem_ty.len() - 1)
        return "vec:".concat(inner)
    }
    if elem_ty.clone().starts_with("Vec_") {
        return "vec:".concat(elem_ty.clone().slice(4, elem_ty.len()))
    }
    elem_ty
}

fn payload_bind_needs_variant_slot(type_name: String, variant_name: String) -> bool {
    if core_match_variant_is_some_or_ok(variant_name.clone()) || core_match_variant_is_err(variant_name.clone()) {
        return false
    }
    if type_name.len() == 0 || type_name.clone().eq("enum:open") {
        return false
    }
    // Nested enum payloads must stay enum-open (#726 nested_enum).
    if type_name.clone().starts_with("enum:") {
        return false
    }
    false
}

fn core_extract_first_result_type_param(scrut_type: String) -> String {
    let prefix_len = 7
    let rest = scrut_type.slice(prefix_len, scrut_type.len())
    // Split Ok/Err on the LAST encoding separator (#726 toml/json).
    let sep_char = if scrut_type.clone().starts_with("result:") { 58 } else { 95 }
    let last = find_last_sep_char(rest.clone(), sep_char)
    if last > 0 {
        return normalize_payload_elem_type_name(rest.slice(0, last))
    }
    normalize_payload_elem_type_name(rest)
}

fn core_extract_second_result_type_param(scrut_type: String) -> String {
    let prefix_len = 7
    let rest = scrut_type.slice(prefix_len, scrut_type.len())
    let sep_char = if scrut_type.clone().starts_with("result:") { 58 } else { 95 }
    let last = find_last_sep_char(rest.clone(), sep_char)
    if last >= 0 && last + 1 < rest.len() {
        return rest.slice(last + 1, rest.len())
    }
    String_new()
}

fn find_last_sep_char(s: String, sep_char: i32) -> i32 {
    let n = s.len()
    let mut i = n - 1
    while i >= 0 {
        if s.clone().byte_at(i) == sep_char {
            return i
        }
        i = i - 1
    }
    0 - 1
}

fn core_payload_type_name_is_gc_ref(ctx: LowerCtx, bind_local: i32) -> bool {
    let type_name = ctx_api_local_types::ctx_get_local_type(ctx, bind_local)
    if type_name.len() == 0 {
        return false
    }
    if type_name.clone().eq("string") || type_name.clone().eq("String") {
        return true
    }
    if type_name.clone().starts_with("vec:") {
        return true
    }
    if type_name.clone().starts_with("hashmap:") {
        return true
    }
    if type_name.clone().starts_with("option:") || type_name.clone().starts_with("Option_") {
        return true
    }
    if type_name.clone().starts_with("Result_") ||
    type_name.clone().starts_with("result:") ||
    type_name.clone().starts_with("enum:") ||
    type_name.clone().starts_with("struct:") {
        return true
    }
    false
}
