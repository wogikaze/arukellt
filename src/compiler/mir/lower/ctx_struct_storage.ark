use collections::name_index
fn ctx_struct_layout_count(ctx: LowerCtx) -> i32 {
    ctx.struct_names.len()
}

fn ctx_struct_layout_name_at(ctx: LowerCtx, index: i32) -> String {
    ctx.struct_names.get_unchecked(index).clone()
}

fn ctx_struct_layout_field_count_at(ctx: LowerCtx, index: i32) -> i32 {
    ctx.struct_field_counts.get_unchecked(index)
}

fn ctx_struct_field_name_at_offset(ctx: LowerCtx, offset: i32) -> String {
    ctx.struct_all_fields.get_unchecked(offset).clone()
}

fn ctx_struct_field_type_at_offset(ctx: LowerCtx, offset: i32) -> String {
    ctx.struct_field_types.get_unchecked(offset).clone()
}

fn ctx_struct_push_layout(mut ctx: LowerCtx, struct_name: String, field_count: i32) {
    let index = ctx.struct_names.len()
    let field_offset = if index == 0 {
        0
    } else {
        ctx.struct_layout_field_offsets.get_unchecked(index - 1) + ctx.struct_field_counts.get_unchecked(index - 1)
    }
    name_index::name_index_insert_first(ctx.struct_layout_first_index, struct_name.clone(), index)
    ctx.struct_layout_field_offsets.push(field_offset)
    ctx.struct_names.push(struct_name)
    ctx.struct_field_counts.push(field_count)
    ctx_struct_layout_name_memo_reset(ctx)
    if field_count == 0 {
        ctx_struct_layout_record_struct_index(ctx, index)
    }
}

// Record `index` as a struct-context layout unless it is an enum base. Called
// once per layout, when the layout's fields finish registering; a layout is
// never mutated after that point.
fn ctx_struct_layout_record_struct_index(mut ctx: LowerCtx, index: i32) {
    if ctx_struct_layout_is_enum_base_at(ctx, index) {
        return
    }
    name_index::name_index_insert_first(
        ctx.struct_layout_struct_index,
        ctx_struct_layout_name_at(ctx, index),
        index
    )
}

// Index of the first layout named `struct_name`, or -1.
fn ctx_struct_layout_first_index(ctx: LowerCtx, struct_name: String) -> i32 {
    name_index::name_index_get(ctx.struct_layout_first_index, struct_name)
}

// A single-field `_tag` layout is an enum base (or the tag-only layout of a
// unit variant), not a user struct. Enum bases share the layout registry
// with structs so variant payloads can reuse the same storage.
fn ctx_struct_layout_is_enum_base_at(ctx: LowerCtx, index: i32) -> bool {
    if ctx_struct_layout_field_count_at(ctx, index) != 1 {
        return false
    }
    let off = ctx_struct_layout_field_offset_at(ctx, index)
    ctx_struct_field_name_at_offset(ctx, off).eq("_tag")
}

// Index of the first non-enum-base layout registered under `struct_name`,
// or -1. A user struct may reuse a name an earlier enum registration claimed
// (`struct Box` next to the prelude `enum Box`); the user decl shadows the
// enum for struct-context lookups while enum machinery keeps its own
// variant/tag registries. `struct_layout_struct_index` is filled as layouts
// finish registering, so this is O(1) rather than a registry scan.
fn ctx_struct_layout_struct_index(ctx: LowerCtx, struct_name: String) -> i32 {
    name_index::name_index_get(ctx.struct_layout_struct_index, struct_name)
}

// Preferred layout for `struct_name`: the user struct when one shadows an
// enum base under the same name, otherwise the first exact registration so
// enum-only names keep resolving to their base layout.
fn ctx_struct_layout_preferred_index(ctx: LowerCtx, struct_name: String) -> i32 {
    let si = ctx_struct_layout_struct_index(ctx, struct_name.clone())
    if si >= 0 {
        return si
    }
    ctx_struct_layout_first_index(ctx, struct_name)
}

// Offset of layout `index`'s first field in struct_all_fields / struct_field_types.
fn ctx_struct_layout_field_offset_at(ctx: LowerCtx, index: i32) -> i32 {
    ctx.struct_layout_field_offsets.get_unchecked(index)
}

fn ctx_struct_layout_name_memo_reset(mut ctx: LowerCtx) {
    ctx.struct_layout_name_memo = name_index::NameIndex_new(0)
    ctx.struct_layout_name_memo_values = Vec::new<String>()
}

fn ctx_struct_layout_name_memo_slot(ctx: LowerCtx, type_name: String) -> i32 {
    name_index::name_index_get(ctx.struct_layout_name_memo, type_name)
}

fn ctx_struct_layout_name_memo_value_at(ctx: LowerCtx, slot: i32) -> String {
    ctx.struct_layout_name_memo_values.get_unchecked(slot).clone()
}

fn ctx_struct_layout_name_memo_put(mut ctx: LowerCtx, type_name: String, resolved: String) {
    name_index::name_index_set(ctx.struct_layout_name_memo, type_name, ctx.struct_layout_name_memo_values.len())
    ctx.struct_layout_name_memo_values.push(resolved)
}

fn ctx_struct_push_field(mut ctx: LowerCtx, field_name: String, field_type: String) {
    ctx.struct_all_fields.push(field_name)
    ctx.struct_field_types.push(field_type)
    let index = ctx.struct_names.len() - 1
    if index >= 0 {
        let field_count = ctx.struct_field_counts.get_unchecked(index)
        let field_offset = ctx.struct_layout_field_offsets.get_unchecked(index)
        if ctx.struct_all_fields.len() - field_offset == field_count {
            ctx_struct_layout_record_struct_index(ctx, index)
        }
    }
    ctx_struct_layout_name_memo_reset(ctx)
}
