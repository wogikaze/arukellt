use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_offset
use mir::lower::ctx_struct_storage
use mir::lower::ctx_struct_size

fn ctx_struct_field_offset(ctx: LowerCtx, struct_name: String, target_field_idx: i32) -> i32 {
    ctx_struct_offset::ctx_struct_field_offset(ctx, struct_name, target_field_idx)
}

fn ctx_struct_byte_size(ctx: LowerCtx, struct_name: String) -> i32 {
    ctx_struct_size::ctx_struct_byte_size(ctx, struct_name)
}

fn ctx_struct_field_is_f64(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    ctx_struct_field_type::ctx_struct_field_is_f64(ctx, struct_name, field_idx)
}

fn ctx_struct_field_is_i64(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    ctx_struct_field_type::ctx_struct_field_is_i64(ctx, struct_name, field_idx)
}

fn ctx_struct_field_is_v128(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    ctx_struct_field_type::ctx_struct_field_is_v128(ctx, struct_name, field_idx)
}

fn ctx_struct_field_is_gc_ref(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    ctx_struct_field_type::ctx_struct_field_is_gc_ref(ctx, struct_name, field_idx)
}

fn ctx_struct_field_byte_size(field_type: String) -> i32 {
    ctx_struct_size::ctx_struct_field_byte_size(field_type)
}

fn ctx_is_registered_struct_type(ctx: LowerCtx, struct_name: String) -> bool {
    let layout_index = ctx_struct_storage::ctx_struct_layout_first_index(ctx, struct_name)
    if layout_index < 0 {
        return false
    }
    // Enum bases share the layout registry with structs, but their single
    // `_tag` layout must be represented as an open enum reference. Treating
    // it as a named struct makes payload inference keep the bare enum name,
    // which the GC local mapper can misread as a generic Vec layout.
    !ctx_is_registered_enum_type(ctx, struct_name)
}

fn ctx_maybe_enum_return_type_name(ctx: LowerCtx, type_name: String) -> String {
    if len(type_name) == 0 {
        return type_name
    }
    if starts_with(clone(type_name), "enum:") {
        return type_name
    }
    // Built-in scalar and String names can also be enum-variant basenames
    // (for example `WitType::String`). They are field types here, not a
    // request to resolve a variant layout; resolving them would turn a
    // String field into an open enum reference.
    if is_builtin_type_name(clone(type_name)) {
        return type_name
    }
    // Container prefixes are part of the semantic type. Resolving the whole
    // name as a struct would strip a qualified element name (`vec:types::T`)
    // to `T` and turn Vec<T> into the element struct itself.
    let normalized = ctx_normalize_generic_type_name(clone(type_name))
    if !eq(clone(normalized), clone(type_name)) {
        return ctx_maybe_enum_return_type_name(ctx, normalized)
    }
    if starts_with(clone(type_name), "vec:") ||
    starts_with(clone(type_name), "hashmap:") ||
    starts_with(clone(type_name), "hashset:") ||
    starts_with(clone(type_name), "option:") ||
    starts_with(clone(type_name), "Option_") ||
    starts_with(clone(type_name), "result:") ||
    starts_with(clone(type_name), "Result_") {
        return type_name
    }
    let resolved_layout = ctx_resolve_struct_layout_name(ctx, clone(type_name))
    if !eq(clone(resolved_layout), clone(type_name)) {
        return ctx_maybe_enum_return_type_name(ctx, resolved_layout)
    }
    // Normalize angle-bracket forms so GC locals / match payload see
    // the same prefixes as Result_ / option: / vec: (#726 json/toml).
    if starts_with(clone(type_name), "vec:") {
        return type_name
    }
    if starts_with(clone(type_name), "hashmap:") {
        return type_name
    }
    if eq(clone(type_name), "HashMap") {
        return type_name
    }
    if eq(clone(type_name), "HashSet") {
        return type_name
    }
    if eq(clone(type_name), "Vec") {
        return type_name
    }
    if starts_with(clone(type_name), "struct:") {
        return type_name
    }
    if starts_with(clone(type_name), "option:") || starts_with(clone(type_name), "Option_") {
        return type_name
    }
    if starts_with(clone(type_name), "Result_") || starts_with(clone(type_name), "result:") {
        return type_name
    }
    if ctx_is_registered_enum_type(ctx, clone(type_name)) {
        return concat("enum:", type_name)
    }
    if ctx_is_registered_struct_type(ctx, clone(type_name)) {
        let byte_size = ctx_struct_byte_size(ctx, clone(type_name))
        return concat(concat("struct:", type_name), concat(":", i32_to_string(byte_size)))
    }
    type_name
}

fn is_builtin_type_name(type_name: String) -> bool {
    eq(clone(type_name), "String") ||
    eq(clone(type_name), "string") ||
    eq(clone(type_name), "bool") ||
    eq(clone(type_name), "char") ||
    eq(clone(type_name), "i32") ||
    eq(clone(type_name), "i64") ||
    eq(clone(type_name), "f32") ||
    eq(clone(type_name), "f64") ||
    eq(clone(type_name), "u8") ||
    eq(clone(type_name), "u16") ||
    eq(clone(type_name), "u32") ||
    eq(clone(type_name), "u64") ||
    eq(clone(type_name), "i16") ||
    eq(clone(type_name), "unit") ||
    eq(clone(type_name), "()") ||
    eq(clone(type_name), "v128") ||
    eq(clone(type_name), "fn") ||
    eq(clone(type_name), "fnref")
}

fn ctx_normalize_generic_type_name(type_name: String) -> String {
    if starts_with(clone(type_name), "Vec<") && ends_with(clone(type_name), ">") {
        let inner = substring(clone(type_name), 4, len(type_name) - 1)
        return concat("vec:", inner)
    }
    if starts_with(clone(type_name), "Option<") && ends_with(clone(type_name), ">") {
        let inner = substring(clone(type_name), 7, len(type_name) - 1)
        return concat("option:", inner)
    }
    if starts_with(clone(type_name), "Result<") && ends_with(clone(type_name), ">") {
        let inner = substring(clone(type_name), 7, len(type_name) - 1)
        let sep = find_top_level_comma(clone(inner))
        if sep >= 0 {
            let ok_ty = substring(clone(inner), 0, sep)
            let err_ty = substring(clone(inner), sep + 1, len(inner))
            // Trim a single leading space after the comma if present.
            let mut err = err_ty
            if len(err) > 0 && char_at(err, 0) == 32 {
                err = substring(err, 1, len(err))
            }
            // Normalize Ok/Err sides so Result<Vec<T>, String> becomes
            // result:vec:T:String (#726 toml navigate Result match).
            let ok_norm = ctx_normalize_generic_type_name(ok_ty)
            let err_norm = ctx_normalize_generic_type_name(err)
            return concat(concat("result:", ok_norm), concat(":", err_norm))
        }
        return concat("result:", inner)
    }
    type_name
}

fn find_top_level_comma(s: String) -> i32 {
    let n = len(s)
    let mut depth = 0
    let mut i = 0
    while i < n {
        let ch = char_at(s, i)
        if ch == 60 {
            depth = depth + 1
        } else if ch == 62 {
            depth = depth - 1
        } else if ch == 44 && depth == 0 {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn ctx_struct_semantic_type_name(type_name: String) -> String {
    let mut s = clone(type_name)
    if starts_with(clone(s), "struct:") {
        s = substring(s, 7, len(s))
        let n = len(s)
        let mut last_colon = 0 - 1
        let mut i = 0
        while i < n {
            if char_at(s, i) == 58 {
                last_colon = i
            }
            i = i + 1
        }
        if last_colon > 0 {
            let mut all_digit = true
            let mut j = last_colon + 1
            while j < n {
                let ch = char_at(s, j)
                if ch < 48 || ch > 57 {
                    all_digit = false
                }
                j = j + 1
            }
            if all_digit {
                s = substring(s, 0, last_colon)
            }
        }
    }
    s
}

fn ctx_struct_basename(type_name: String) -> String {
    let s = ctx_struct_semantic_type_name(type_name)
    let n = len(s)
    let mut i = n - 2
    while i >= 0 {
        if char_at(s, i) == 58 && char_at(s, i + 1) == 58 {
            return substring(s, i + 2, n)
        }
        i = i - 1
    }
    s
}

fn ctx_count_layout_matches(ctx: LowerCtx, candidate: String) -> i32 {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut count = 0
    let mut si = 0
    while si < sc {
        let name = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        if eq(clone(name), clone(candidate)) {
            count = count + 1
        } else {
            let basename = ctx_struct_basename(name)
            if eq(clone(basename), clone(candidate)) {
                count = count + 1
            }
        }
        si = si + 1
    }
    count
}

fn ctx_find_layout_name(ctx: LowerCtx, candidate: String) -> String {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut si = 0
    while si < sc {
        let name = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        if eq(clone(name), clone(candidate)) {
            return name
        }
        si = si + 1
    }
    si = 0
    while si < sc {
        let name = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        let basename = ctx_struct_basename(name)
        if eq(clone(basename), clone(candidate)) {
            return name
        }
        si = si + 1
    }
    candidate
}

// Every CALL lowering resolves its return type name here; the uncached
// resolution walks the whole layout registry up to six times.
fn ctx_resolve_struct_layout_name(ctx: LowerCtx, type_name: String) -> String {
    if len(type_name) == 0 {
        return type_name
    }
    let memo_slot = ctx_struct_storage::ctx_struct_layout_name_memo_slot(ctx, clone(type_name))
    if memo_slot >= 0 {
        return ctx_struct_storage::ctx_struct_layout_name_memo_value_at(ctx, memo_slot)
    }
    let resolved = resolve_struct_layout_name_uncached(ctx, clone(type_name))
    ctx_struct_storage::ctx_struct_layout_name_memo_put(ctx, type_name, clone(resolved))
    resolved
}

fn resolve_struct_layout_name_uncached(ctx: LowerCtx, type_name: String) -> String {
    let candidate = ctx_struct_semantic_type_name(type_name)
    if ctx_is_registered_struct_type(ctx, clone(candidate)) || ctx_is_registered_enum_type(ctx, clone(candidate)) {
        return candidate
    }
    let basename = ctx_struct_basename(clone(candidate))
    if ctx_is_registered_struct_type(ctx, clone(basename)) || ctx_is_registered_enum_type(ctx, clone(basename)) {
        return basename
    }
    if ctx_count_layout_matches(ctx, clone(candidate)) == 1 {
        return ctx_find_layout_name(ctx, candidate)
    }
    if ctx_count_layout_matches(ctx, clone(basename)) == 1 {
        return ctx_find_layout_name(ctx, basename)
    }
    candidate
}

// A registered enum is a single-field layout whose only field is `_tag`.
fn ctx_is_registered_enum_type(ctx: LowerCtx, enum_name: String) -> bool {
    let si = ctx_struct_storage::ctx_struct_layout_first_index(ctx, enum_name)
    if si < 0 || ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si) != 1 {
        return false
    }
    let off = ctx_struct_storage::ctx_struct_layout_field_offset_at(ctx, si)
    eq(ctx_struct_storage::ctx_struct_field_name_at_offset(ctx, off), "_tag")
}
