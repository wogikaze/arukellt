use std::prelude::{eq}
use std::text
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_offset
use mir::lower::ctx_struct_storage
use mir::lower::ctx_struct_size
fn ctx_struct_field_offset(ctx: LowerCtx, struct_name: String, target_field_idx: i32) -> i32 {
    ctx_struct_offset::ctx_struct_field_offset(ctx, struct_name, target_field_idx)
}

fn ctx_struct_byte_size(ctx: LowerCtx, struct_name: String) -> i32 {
    ctx_struct_size::ctx_struct_byte_size(ctx, struct_name)
}

fn ctx_struct_field_is_f64(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    ctx_struct_field_type::ctx_struct_field_is_f64(ctx, struct_name, field_idx)
}

fn ctx_struct_field_is_i64(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    ctx_struct_field_type::ctx_struct_field_is_i64(ctx, struct_name, field_idx)
}

fn ctx_struct_field_is_v128(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    ctx_struct_field_type::ctx_struct_field_is_v128(ctx, struct_name, field_idx)
}

fn ctx_struct_field_is_gc_ref(ctx: LowerCtx, struct_name: String, field_idx: i32) -> bool {
    ctx_struct_field_type::ctx_struct_field_is_gc_ref(ctx, struct_name, field_idx)
}

fn ctx_struct_field_byte_size(field_type: String) -> i32 {
    ctx_struct_size::ctx_struct_field_byte_size(field_type)
}

fn ctx_is_registered_struct_type(ctx: LowerCtx, struct_name: String) -> bool {
    // Enum bases share the layout registry with structs, but their single
    // `_tag` layout must be represented as an open enum reference. Treating
    // it as a named struct makes payload inference keep the bare enum name,
    // which the GC local mapper can misread as a generic Vec layout. A user
    // struct may still shadow an enum base under the same name (struct Box
    // next to prelude enum Box), so the struct index skips enum bases rather
    // than taking the first registration.
    ctx_struct_storage::ctx_struct_layout_struct_index(ctx, struct_name) >= 0
}

// `?Name:args` and `Name<args>` spellings reference a generic declaration,
// so a non-generic user struct sharing the base name can never be the
// referent — prelude `unbox` keeps `?Box:T` meaning `enum Box<T>` even
// when a user `struct Box` shadows the bare name. Returns `enum:<base>`
// for generic-enum spellings, "" otherwise.
fn ctx_generic_enum_type_name(ctx: LowerCtx, type_name: String) -> String {
    let mut base = String_new()
    if type_name.clone().starts_with(String_from("?")) {
        let stripped = type_name.clone().slice(1, len(type_name))
        let sn = len(stripped)
        let mut i = 0
        while i < sn {
            if stripped.clone().byte_at(i) == 58 {
                base = stripped.clone().slice(0, i)
                i = sn
            }
            i = i + 1
        }
    } else {
        let n = len(type_name)
        if n > 2 && type_name.clone().byte_at(n - 1) == 62 {
            let mut i = 0
            while i < n {
                if type_name.clone().byte_at(i) == 60 {
                    base = type_name.clone().slice(0, i)
                    i = n
                }
                i = i + 1
            }
        }
    }
    if len(base) == 0 {
        return String_new()
    }
    // A generic struct owning the same base keeps Name<args> for itself.
    let gc = len(ctx.generic_struct_names)
    let mut gi = 0
    while gi < gc {
        if eq(get_unchecked(ctx.generic_struct_names, gi), base.clone()) {
            return String_new()
        }
        gi = gi + 1
    }
    if ctx_is_registered_enum_type(ctx, base.clone()) {
        return String_from("enum:").concat(base)
    }
    String_new()
}

fn ctx_maybe_enum_return_type_name(mut ctx: LowerCtx, type_name: String) -> String {
    if len(type_name) == 0 {
        return type_name
    }
    if type_name.clone().starts_with(String_from("fnref")) {
        return type_name
    }
    if type_name.clone().starts_with(String_from("fnsig:")) {
        return type_name
    }
    if type_name.clone().starts_with("enum:") {
        return type_name
    }
    // Built-in scalar and String names can also be enum-variant basenames
    // (for example `WitType::String`). They are field types here, not a
    // request to resolve a variant layout; resolving them would turn a
    // String field into an open enum reference.
    if is_builtin_type_name(type_name.clone()) {
        return type_name
    }
    // Container prefixes are part of the semantic type. Resolving the whole
    // name as a struct would strip a qualified element name (`vec:types::T`)
    // to `T` and turn Vec<T> into the element struct itself.
    let normalized = ctx_normalize_generic_type_name(type_name.clone())
    if !eq(normalized.clone(), type_name.clone()) {
        return ctx_maybe_enum_return_type_name(ctx, normalized)
    }
    if type_name.clone().starts_with("vec:") ||
    type_name.clone().starts_with("hashmap:") ||
    type_name.clone().starts_with("hashset:") ||
    type_name.clone().starts_with("option:") ||
    type_name.clone().starts_with("Option_") ||
    type_name.clone().starts_with("result:") ||
    type_name.clone().starts_with("Result_") {
        return type_name
    }
    let resolved_layout = ctx_resolve_struct_layout_name(ctx, type_name.clone())
    if !eq(resolved_layout.clone(), type_name.clone()) {
        return ctx_maybe_enum_return_type_name(ctx, resolved_layout)
    }
    // Normalize angle-bracket forms so GC locals / match payload see
    // the same prefixes as Result_ / option: / vec: (#726 json/toml).
    if type_name.clone().starts_with("vec:") {
        return type_name
    }
    if type_name.clone().starts_with("hashmap:") {
        return type_name
    }
    if eq(type_name.clone(), "HashMap") {
        return type_name
    }
    if eq(type_name.clone(), "HashSet") {
        return type_name
    }
    if eq(type_name.clone(), "Vec") {
        return type_name
    }
    if type_name.clone().starts_with("struct:") {
        return type_name
    }
    if type_name.clone().starts_with("option:") || type_name.clone().starts_with("Option_") {
        return type_name
    }
    if type_name.clone().starts_with("Result_") || type_name.clone().starts_with("result:") {
        return type_name
    }
    if ctx_is_registered_struct_type(ctx, type_name.clone()) {
        let byte_size = ctx_struct_byte_size(ctx, type_name.clone())
        return "struct:".concat(type_name).concat(":".concat((byte_size).to_string()))
    }
    let generic_enum = ctx_generic_enum_type_name(ctx, type_name.clone())
    if len(generic_enum) > 0 {
        return generic_enum
    }
    if ctx_is_registered_enum_type(ctx, type_name.clone()) {
        return "enum:".concat(type_name)
    }
    type_name
}

fn is_builtin_type_name(type_name: String) -> bool {
    eq(type_name.clone(), "String") ||
    eq(type_name.clone(), "string") ||
    eq(type_name.clone(), "bool") ||
    eq(type_name.clone(), "char") ||
    eq(type_name.clone(), "i32") ||
    eq(type_name.clone(), "i64") ||
    eq(type_name.clone(), "f32") ||
    eq(type_name.clone(), "f64") ||
    eq(type_name.clone(), "u8") ||
    eq(type_name.clone(), "i8") ||
    eq(type_name.clone(), "u16") ||
    eq(type_name.clone(), "u32") ||
    eq(type_name.clone(), "u64") ||
    eq(type_name.clone(), "i16") ||
    eq(type_name.clone(), "unit") ||
    eq(type_name.clone(), "()") ||
    eq(type_name.clone(), "v128") ||
    eq(type_name.clone(), "fn") ||
    eq(type_name.clone(), "fnref") ||
    type_name.clone().starts_with(String_from("fnref")) ||
    type_name.clone().starts_with(String_from("fnsig:"))
}

fn ctx_normalize_generic_type_name(type_name: String) -> String {
    if type_name.clone().starts_with("Vec<") && type_name.clone().ends_with(">") {
        let inner = type_name.clone().slice(4, len(type_name) - 1)
        return "vec:".concat(inner)
    }
    if type_name.clone().starts_with("Option<") && type_name.clone().ends_with(">") {
        let inner = type_name.clone().slice(7, len(type_name) - 1)
        return "option:".concat(inner)
    }
    if type_name.clone().starts_with("Result<") && type_name.clone().ends_with(">") {
        let inner = type_name.clone().slice(7, len(type_name) - 1)
        let sep = find_top_level_comma(inner.clone())
        if sep >= 0 {
            let ok_ty = inner.clone().slice(0, sep)
            let err_ty = inner.clone().slice(sep + 1, len(inner))
            // Trim a single leading space after the comma if present.
            let mut err = err_ty
            if len(err) > 0 && err.byte_at(0) == 32 {
                err = err.slice(1, len(err))
            }
            // Normalize Ok/Err sides so Result<Vec<T>, String> becomes
            // result:vec:T:String (#726 toml navigate Result match).
            let ok_norm = ctx_normalize_generic_type_name(ok_ty)
            let err_norm = ctx_normalize_generic_type_name(err)
            return "result:".concat(ok_norm).concat(":".concat(err_norm))
        }
        return "result:".concat(inner)
    }
    type_name
}

fn find_top_level_comma(s: String) -> i32 {
    let n = len(s)
    let mut depth = 0
    let mut i = 0
    while i < n {
        let ch = s.byte_at(i)
        if ch == 60 {
            depth = depth + 1
        } else if ch == 62 {
            depth = depth - 1
        } else if ch == 44 && depth == 0 {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn ctx_struct_semantic_type_name(type_name: String) -> String {
    let mut s = type_name.clone()
    if s.clone().starts_with("struct:") {
        s = s.slice(7, len(s))
        let n = len(s)
        let mut last_colon = 0 - 1
        let mut i = 0
        while i < n {
            if s.byte_at(i) == 58 {
                last_colon = i
            }
            i = i + 1
        }
        if last_colon > 0 {
            let mut all_digit = true
            let mut j = last_colon + 1
            while j < n {
                let ch = s.byte_at(j)
                if ch < 48 || ch > 57 {
                    all_digit = false
                }
                j = j + 1
            }
            if all_digit {
                s = s.slice(0, last_colon)
            }
        }
    }
    s
}

fn ctx_struct_basename(type_name: String) -> String {
    let s = ctx_struct_semantic_type_name(type_name)
    let n = len(s)
    let mut i = n - 2
    while i >= 0 {
        if s.byte_at(i) == 58 && s.byte_at(i + 1) == 58 {
            return s.slice(i + 2, n)
        }
        i = i - 1
    }
    s
}

fn ctx_count_layout_matches(ctx: LowerCtx, candidate: String) -> i32 {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut count = 0
    let mut si = 0
    while si < sc {
        let name = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        if eq(name.clone(), candidate.clone()) {
            count = count + 1
        } else {
            let basename = ctx_struct_basename(name)
            if eq(basename.clone(), candidate.clone()) {
                count = count + 1
            }
        }
        si = si + 1
    }
    count
}

fn ctx_find_layout_name(ctx: LowerCtx, candidate: String) -> String {
    let sc = ctx_struct_storage::ctx_struct_layout_count(ctx)
    let mut si = 0
    while si < sc {
        let name = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        if eq(name.clone(), candidate.clone()) {
            return name
        }
        si = si + 1
    }
    si = 0
    while si < sc {
        let name = ctx_struct_storage::ctx_struct_layout_name_at(ctx, si)
        let basename = ctx_struct_basename(name)
        if eq(basename.clone(), candidate.clone()) {
            return name
        }
        si = si + 1
    }
    candidate
}

// Every CALL lowering resolves its return type name here; the uncached
// resolution walks the whole layout registry up to six times.
fn ctx_resolve_struct_layout_name(mut ctx: LowerCtx, type_name: String) -> String {
    if len(type_name) == 0 {
        return type_name
    }
    let memo_slot = ctx_struct_storage::ctx_struct_layout_name_memo_slot(ctx, type_name.clone())
    if memo_slot >= 0 {
        return ctx_struct_storage::ctx_struct_layout_name_memo_value_at(ctx, memo_slot)
    }
    let resolved = resolve_struct_layout_name_uncached(ctx, type_name.clone())
    ctx_struct_storage::ctx_struct_layout_name_memo_put(ctx, type_name, resolved.clone())
    resolved
}

fn resolve_struct_layout_name_uncached(ctx: LowerCtx, type_name: String) -> String {
    let candidate = ctx_struct_semantic_type_name(type_name)
    if ctx_is_registered_struct_type(ctx, candidate.clone()) || ctx_is_registered_enum_type(ctx, candidate.clone()) {
        return candidate
    }
    let basename = ctx_struct_basename(candidate.clone())
    if ctx_is_registered_struct_type(ctx, basename.clone()) || ctx_is_registered_enum_type(ctx, basename.clone()) {
        return basename
    }
    if ctx_count_layout_matches(ctx, candidate.clone()) == 1 {
        return ctx_find_layout_name(ctx, candidate)
    }
    if ctx_count_layout_matches(ctx, basename.clone()) == 1 {
        return ctx_find_layout_name(ctx, basename)
    }
    candidate
}

// A registered enum is a single-field layout whose only field is `_tag`.
fn ctx_is_registered_enum_type(ctx: LowerCtx, enum_name: String) -> bool {
    let si = ctx_struct_storage::ctx_struct_layout_first_index(ctx, enum_name)
    if si < 0 || ctx_struct_storage::ctx_struct_layout_field_count_at(ctx, si) != 1 {
        return false
    }
    let off = ctx_struct_storage::ctx_struct_layout_field_offset_at(ctx, si)
    eq(ctx_struct_storage::ctx_struct_field_name_at_offset(ctx, off), "_tag")
}

// Strip "struct:TypeName:byte_size" → "TypeName" so struct layout lookups
// (ctx_field_index, ctx_struct_byte_size, etc.) match the registered name.
// Passes through non-"struct:" type names unchanged. Shared by aggregate
// lowering, closure packing, and GC layout planning.
fn strip_struct_type_prefix(type_name: String) -> String {
    if !type_name.clone().starts_with("struct:") {
        return type_name
    }
    let n = len(type_name)
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if type_name.byte_at(i) == ':' {
            if first_colon < 0 {
                first_colon = i
            }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon < 0 || first_colon == last_colon {
        return type_name
    }
    type_name.slice(first_colon + 1, last_colon)
}
