use mir::inst_draft
use mir::lower::closure_pcells
use mir::lower::ctx_emit_core
use mir::lower::ctx_env_cells

fn ctx_emit(mut ctx: LowerCtx, mut inst: MirInstDraft) {
    // Env-cell flush runs before the pcell rewrite so the flush struct.set
    // itself passes through the same emit pipeline.
    let flush = ctx_env_cells::ctx_env_cell_flush(ctx, inst)
    let mut ri = 0
    while ri < flush.len() {
        ctx_emit(ctx, get_unchecked(flush, ri))
        ri = ri + 1
    }
    // Promoted borrow-capture cells: value reads/writes on a cell local are
    // rewritten to field-0 access here so every lowering site shares the
    // same place (#891). The stage may emit extra insts; all of them go
    // through the same identify/enrich/record pipeline verbatim.
    let rewritten = closure_pcells::ctx_pcell_rewrite(ctx, inst)
    let mut wi = 0
    while wi < rewritten.len() {
        ctx_emit_core::ctx_emit_verbatim(ctx, get_unchecked(rewritten, wi))
        wi = wi + 1
    }
}
