use std::prelude::{eq}
use corehir::function_id
use corehir::signature_entry
use corehir::signature_registry
use mir::lower::closure_registry
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_variants
use mir::lower::closure_env
use mir::lower::ctx_current_storage
use mir::lower::ctx_fn_index
use mir::lower::ctx_fn_return_type
use mir::lower::ctx_fn_return_vt
use mir::function_identity
use mir::function_param_view
use mir::inst_call
use mir::inst_local_get
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_atoms
use mir::module_functions
use mir::module_spine
use mir::lower::variants
use mir::value_types
fn mir_core_lookup_local(ctx: LowerCtx, expr: CoreHirExpr) -> i32 {
    ctx_api_local_alloc::ctx_lookup_local(ctx, core_expr_shape_accessors::mir_core_expr_text(expr))
}

fn mir_fnref_type_name_for_function(ctx: LowerCtx, fn_name: String) -> String {
    // A named function coerced to a fn value spells the same callback
    // signature a same-shaped closure does (zero captures): scalar
    // signatures keep the legacy fnref* buckets and named non-scalar
    // returns spell fnsig:<params>;<ret>, so an indirect call dest carries
    // the real return type (#872).
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    let n = module_functions::MirModule_function_count(m)
    let mut i = 0
    while i < n {
        let f = module_functions::MirModule_function_at(m, i)
        if eq(function_identity::MirFunction_name(f), fn_name.clone()) {
            return closure_registry::closure_funcref_type_name(f, 0)
        }
        i = i + 1
    }
    let parameter_count = mir_function_parameter_count(ctx, fn_name.clone())
    // Binary fold callbacks need fnref2 so ref.func type matches call param (#807).
    if parameter_count >= 2 {
        return String_from("fnref2")
    }
    String_from("fnref")
}

fn mir_function_parameter_count(ctx: LowerCtx, fn_name: String) -> i32 {
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    if module_spine::MirModule_signature_spine_populated(m) {
        let registry = module_spine::MirModule_signature_registry(m)
        let fid = signature_registry::signature_registry_lookup_by_mangled(registry, fn_name.clone())
        if function_id::function_id_is_valid(fid) {
            let entry = signature_registry::signature_registry_lookup_by_id(registry, fid)
            return signature_entry::signature_entry_param_count(entry)
        }
    }
    let n = module_functions::MirModule_function_count(m)
    let mut i = 0
    while i < n {
        let f = module_functions::MirModule_function_at(m, i)
        if eq(function_identity::MirFunction_name(f), fn_name.clone()) {
            return function_param_view::MirFunction_param_count(f)
        }
        i = i + 1
    }
    0 - 1
}

// A const decl is indexed as a nullary fn, but a reference to it is a value:
// lower it to a call whose result type is the declared const type. Reading the
// destination type from the CoreHIR expr instead left i64/f64 consts in i32
// locals (the frontend has no type for a const ident), so binary operands
// extended the wrong side and validation failed (#954, #970).
fn lower_core_const_reference(mut ctx: LowerCtx, const_name: String) -> i32 {
    let dest = ctx_api_local_alloc::ctx_fresh_local(ctx, ctx_fn_return_vt(ctx, const_name.clone()))
    let type_name = ctx_fn_return_type::ctx_fn_return_type_name(ctx, const_name.clone())
    if len(type_name) > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, dest, type_name.clone())
    }
    ctx_api_emit::ctx_emit(ctx, inst_call::MirInst_call(const_name, 0, dest))
    dest
}

// Qualified const spellings (`i32::MAX`, `f64::INF`) reach MIR as a path, and
// the flat fn index keys consts by bare name, so the path branch cannot use
// the bare lookup. The leaf segment is what the const decl registered, and the
// qualified index resolves the module spelling to the decl's signature.
fn lower_core_qualified_const_reference(mut ctx: LowerCtx, path_name: String, leaf_name: String) -> i32 {
    if !ctx_fn_index::ctx_is_const_name(ctx, leaf_name.clone()) {
        return 0 - 2
    }
    if ctx_fn_index::ctx_qualified_fn_index_find(ctx, path_name.clone()) < 0 {
        return 0 - 2
    }
    lower_core_const_reference(ctx, path_name)
}

fn const_path_leaf(name: String) -> String {
    let name_len = len(name)
    let mut leaf_start = 0
    let mut i = 0
    while i + 1 < name_len {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            leaf_start = i + 2
            i = i + 2
        } else {
            i = i + 1
        }
    }
    name.slice(leaf_start, name_len)
}

fn lower_core_name_value(mut ctx: LowerCtx, expr: CoreHirExpr) -> i32 {
    if core_expr_shape_atoms::mir_core_expr_is_ident(expr) {
        let raw_name = core_expr_shape_accessors::mir_core_expr_text(expr)
        let idx = ctx_api_local_alloc::ctx_lookup_local(ctx, raw_name.clone())
        if idx >= 0 {
            ctx_api_emit::ctx_emit(ctx, inst_local_get::MirInst_local_get_to(idx, idx))
            return idx
        }
        let canon = ctx_api_variants::ctx_canonical_variant_name(ctx, raw_name.clone())
        let variant_name = if len(canon) > 0 {
            canon
        } else {
            raw_name.clone()
        }
        let ident_tag = ctx_api_variants::ctx_variant_tag(ctx, variant_name.clone())
        if ident_tag >= 0 {
            return variants::lower_variant_value(ctx, variant_name, ident_tag)
        }
        let fn_name = core_expr_shape_accessors::mir_core_expr_text(expr)
        let fn_idx = ctx_fn_index::ctx_fn_index_find(ctx, fn_name.clone())
        if fn_idx >= 0 {
            if ctx_fn_index::ctx_is_const_name(ctx, fn_name.clone()) {
                return lower_core_const_reference(ctx, fn_name)
            }
            let expr_vt = core_expr_shape_accessors::mir_core_expr_val_type(expr)
            if expr_vt != value_types::VT_FUNCREF() &&
            mir_function_parameter_count(ctx, fn_name.clone()) <= 0 {
                let dest = ctx_api_local_alloc::ctx_fresh_local(ctx, expr_vt)
                let expr_type_name = core_expr_shape_accessors::mir_core_expr_type_name(expr)
                if len(expr_type_name) > 0 {
                    ctx_api_local_types::ctx_set_local_type(ctx, dest, expr_type_name)
                }
                ctx_api_emit::ctx_emit(ctx, inst_call::MirInst_call(fn_name, 0, dest))
                return dest
            }
            let type_name = mir_fnref_type_name_for_function(ctx, fn_name.clone())
            let tramp = closure_env::closure_ensure_fn_thunk(ctx, fn_name.clone())
            let pair = closure_env::closure_emit_pair(ctx, 0 - 1, tramp.clone())
            ctx_api_local_types::ctx_set_local_type(ctx, pair, type_name.clone())
            return pair
        }
        return 0 - 1
    }
    if core_expr_shape_atoms::mir_core_expr_is_path(expr) {
        let raw_name = core_expr_shape_accessors::mir_core_expr_text(expr)
        let canon = ctx_api_variants::ctx_canonical_variant_name(ctx, raw_name.clone())
        let variant_name = if len(canon) > 0 {
            canon
        } else {
            raw_name
        }
        let tag = ctx_api_variants::ctx_variant_tag(ctx, variant_name.clone())
        if tag >= 0 {
            return variants::lower_variant_value(ctx, variant_name, tag)
        }
        let fn_name = core_expr_shape_accessors::mir_core_expr_text(expr)
        let const_ref = lower_core_qualified_const_reference(ctx, fn_name.clone(), const_path_leaf(fn_name.clone()))
        if const_ref != 0 - 2 {
            return const_ref
        }
        let fn_idx = ctx_fn_index::ctx_fn_index_find(ctx, fn_name.clone())
        if fn_idx >= 0 {
            let type_name = mir_fnref_type_name_for_function(ctx, fn_name.clone())
            let tramp = closure_env::closure_ensure_fn_thunk(ctx, fn_name.clone())
            let pair = closure_env::closure_emit_pair(ctx, 0 - 1, tramp.clone())
            ctx_api_local_types::ctx_set_local_type(ctx, pair, type_name.clone())
            return pair
        }
        return 0 - 1
    }
    0 - 2
}
