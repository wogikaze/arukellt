use corehir::kinds
use corehir::function_id
use corehir::mir_signature_method
use corehir::mir_signature_fn
use corehir::signature_entry
use corehir::signature_registry
use corehir::type_id
use corehir::mir_value_type
use corehir::type_info_to_mir_value
use corehir::core_op_id
use corehir::param
use mir::lower::fn_index_method_return_type
use mir::lower::fn_index_mono
use mir::lower::fn_index_source
use mir::lower::mono_instance_build
use mir::lower::mono_suffix_parse
use mir::lower::return_typeinfo
use mir::lower::return_typeinfo_names
use mir::lower_kinds
use mir::value_types
use corehir::type_contracts

fn sig_reg_register_fn(
    table: TypeTable,
    registry: SignatureRegistry,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    fn_info_index: i32,
    typed_index: i32,
    mangled: String,
    impl_id: i32,
    mono_id: i32,
    abi: i32
) -> FunctionId {
    // CoreHir params/VT only — TypedFn.TypeInfo values are unsafe across the
    // duplicate TypeInfo/TypedFn structs in the flat selfhost overlay.
    let params = sig_reg_params_from_fn_info(sig_source, fn_info_index, table)
    let returns = Vec::new<MirValueType>()
    push(
        returns,
        type_info_to_mir_value::vt_to_mir_value(
            table,
            fn_index_source::mir_fn_index_source_typed_return_vt(source, typed_index),
            fn_index_source::mir_fn_index_source_typed_return_type_name(source, typed_index)
        )
    )
    let receiver = mir_value_type::MirValueType_new(type_id::TYPE_ID_INVALID(), kinds::VALUE_REPR_SCALAR(), kinds::NULLABILITY_NOT_REF())
    let entry = signature_entry::SignatureEntry_new(
        function_id::FunctionId_new(0),
        clone(mangled),
        params,
        returns,
        false,
        receiver,
        0 - 1,
        impl_id,
        mono_id,
        abi,
        core_op_id::CORE_OP_ID_NONE()
    )
    signature_registry::signature_registry_register(registry, entry, mangled)
}

fn sig_reg_register_method(
    table: TypeTable,
    registry: SignatureRegistry,
    mono_table: MonoInstanceTable,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    method_info_index: i32,
    mangled: String,
    impl_decl_index: i32
) {
    let mono_instances = fn_index_source::mir_fn_index_source_mono_instances(source)
    let params = sig_reg_params_from_method_info(sig_source, method_info_index, table, clone(mangled), mono_instances)
    let returns = Vec::new<MirValueType>()
    let mrvt_name = fn_index_source::mir_fn_index_source_method_return_type_name_at(source, method_info_index, "")
    let mut return_vt = fn_index_source::mir_fn_index_source_method_return_vt_at(source, method_info_index, 1)
    let mut return_type_name = clone(mrvt_name)
    // Monomorphized method instances (Pair__get_first__String) must register
    // the substituted return so call sites see String, not the T template.
    // Plain method registrations carry no mono suffix and keep the declared
    // return untouched.
    let generic_return_ty = fn_index_method_return_type::method_return_type_info_from_name(clone(mrvt_name))
    let concrete_ret = fn_index_mono::mir_mono_concrete_return_type(mono_instances, clone(mangled), generic_return_ty)
    if type_contracts::TypeInfo_tag(concrete_ret) != 0 {
        return_vt = return_typeinfo::mir_return_vt_from_type_info(concrete_ret)
        return_type_name = return_typeinfo::mir_return_type_name_from_type_info(concrete_ret)
    } else {
        let concrete = fn_index_method_return_type::method_concrete_return_from_mono_fn_name(clone(mangled), clone(mrvt_name))
        if len(concrete) > 0 {
            return_type_name = concrete
            return_vt = fn_index_method_return_type::method_return_vt_from_type_name(clone(return_type_name))
        }
    }
    push(returns, type_info_to_mir_value::vt_to_mir_value(table, return_vt, return_type_name))
    let mono_id = mono_instance_build::mono_instance_table_register_from_instances(
        mono_table,
        table,
        mono_instances,
        clone(mangled),
        params,
        returns
    )
    let receiver = type_info_to_mir_value::vt_to_mir_value(table, 5, "String")
    let trait_id = mir_signature_method::mir_signature_method_trait_id_at(sig_source, method_info_index)
    let entry = signature_entry::SignatureEntry_new(
        function_id::FunctionId_new(0),
        clone(mangled),
        params,
        returns,
        true,
        receiver,
        trait_id,
        impl_decl_index,
        mono_id,
        kinds::ABI_KIND_TRAIT_DISPATCH(),
        core_op_id::CORE_OP_ID_NONE()
    )
    signature_registry::signature_registry_register(registry, entry, mangled)
}

fn sig_reg_params_from_fn_info(sig_source: CoreHirMirSignatureSource, fn_info_index: i32, table: TypeTable) -> Vec<MirValueType> {
    sig_reg_params_from_fn_info_mono(sig_source, fn_info_index, table, String_new(), Vec::new<MonoInstance>())
}

fn sig_reg_params_from_fn_info_mono(
    sig_source: CoreHirMirSignatureSource,
    fn_info_index: i32,
    table: TypeTable,
    mangled: String,
    mono_instances: Vec<MonoInstance>
) -> Vec<MirValueType> {
    let result = Vec::new<MirValueType>()
    if fn_info_index < 0 {
        return result
    }
    let pc = mir_signature_fn::mir_signature_fn_param_count_at(sig_source, fn_info_index, 0)
    let mut pi = 0
    while pi < pc {
        let p = mir_signature_fn::mir_signature_fn_param_at(sig_source, fn_info_index, pi)
        let mut type_name = param::param_type_name(p)
        let local_name = param::param_local_type_name(p)
        if len(local_name) > 0 {
            type_name = local_name
        }
        if len(mangled) > 0 {
            type_name = sig_reg_subst_mono_param_type_name(clone(type_name), clone(mangled))
        }
        if starts_with(clone(type_name), String_from("hashmap:")) ||
        starts_with(clone(type_name), String_from("?HashMap:")) {
            type_name = sig_reg_mono_hashmap_param_alias(type_name, clone(mangled), mono_instances)
        }
        let mut vt = param::param_value_type(p)
        if starts_with(clone(type_name), "vec:") ||
        starts_with(clone(type_name), "option:") ||
        starts_with(clone(type_name), "struct:") {
            vt = value_types::VT_GC_REF()
        } else if !fn_index_method_return_type::method_return_type_name_is_type_var(clone(type_name)) &&
            len(type_name) > 0 {
                vt = fn_index_method_return_type::method_return_vt_from_type_name(clone(type_name))
            }
            push(result, type_info_to_mir_value::vt_to_mir_value(table, vt, type_name))
            pi = pi + 1
        }
        result
    }

    fn sig_reg_subst_mono_param_type_name(type_name: String, mangled: String) -> String {
        let suffix = mono_suffix_parse::extract_mono_suffix(clone(mangled))
        if len(suffix) == 0 {
            return type_name
        }
        if starts_with(clone(type_name), "vec:") {
            let elem = substring(clone(type_name), 4, len(type_name))
            if !mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(elem)) {
                return type_name
            }
            let concrete = sig_reg_resolve_mono_type_key(clone(elem), clone(suffix))
            if len(concrete) == 0 {
                return type_name
            }
            return concat("vec:", concrete)
        }
        if starts_with(clone(type_name), "option:") {
            let elem = substring(clone(type_name), 7, len(type_name))
            if !mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(elem)) {
                return type_name
            }
            let concrete = sig_reg_resolve_mono_type_key(clone(elem), clone(suffix))
            if len(concrete) == 0 {
                return type_name
            }
            return concat("option:", concrete)
        }
        if fn_index_method_return_type::method_return_type_name_is_type_var(clone(type_name)) {
            let concrete = sig_reg_resolve_mono_type_key(clone(type_name), clone(suffix))
            if len(concrete) > 0 {
                return concrete
            }
        }
        type_name
    }

    fn sig_reg_resolve_mono_type_key(type_var: String, mono_suffix: String) -> String {
        if starts_with(clone(mono_suffix), "Vec") {
            return mono_suffix
        }
        let keys = mono_suffix_parse::split_mono_suffix(clone(mono_suffix))
        let key_count = len(keys)
        if key_count <= 0 {
            return String_new()
        }
        if key_count == 1 {
            return get_unchecked(keys, 0)
        }
        let idx = mono_suffix_parse::mono_type_var_to_index(clone(type_var))
        if idx >= 0 && idx < key_count {
            return get_unchecked(keys, idx)
        }
        get_unchecked(keys, 0)
    }

    fn sig_reg_params_from_method_info(
        sig_source: CoreHirMirSignatureSource,
        method_info_index: i32,
        table: TypeTable,
        mangled: String,
        mono_instances: Vec<MonoInstance>
    ) -> Vec<MirValueType> {
        let result = Vec::new<MirValueType>()
        if method_info_index < 0 {
            return result
        }
        let pc = mir_signature_method::mir_signature_method_param_count_at(sig_source, method_info_index, 0)
        let mut pi = 0
        while pi < pc {
            let p = mir_signature_method::mir_signature_method_param_at(sig_source, method_info_index, pi)
            let mut type_name = param::param_type_name(p)
            if starts_with(clone(type_name), String_from("hashmap:")) {
                type_name = sig_reg_mono_hashmap_param_alias(type_name, clone(mangled), mono_instances)
            }
            push(result, type_info_to_mir_value::vt_to_mir_value(table, param::param_value_type(p), type_name))
            pi = pi + 1
        }
        result
    }

    // `hashmap:K:V` param spellings reach the registry unresolved: the
    // declared HashMap<K,V> annotation aliases to `K:V` before mono names
    // bind, and the pair lookup would silently take the si32 default layout.
    // Resolve each segment through the MonoInstance type args (which keep fn
    // signatures the mangled suffix cannot) and rebuild the canonical
    // hashmap:<pair> alias (#691).
    fn sig_reg_mono_hashmap_param_alias(type_name: String, mangled: String, mono_instances: Vec<MonoInstance>) -> String {
        let args = if starts_with(clone(type_name), String_from("?HashMap:")) {
            substring(clone(type_name), 9, len(type_name))
        } else {
            substring(clone(type_name), 8, len(type_name))
        }
        let colon = index_of(clone(args), String_from(":"))
        if colon < 0 {
            return type_name
        }
        let key_seg = substring(clone(args), 0, colon)
        let val_seg = substring(clone(args), colon + 1, len(args))
        if !mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(key_seg)) &&
        !mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(val_seg)) {
            return type_name
        }
        let inst = mono_instance_build::mono_find_instance(mono_instances, clone(mangled))
        if type_contracts::MonoInstance_type_arg_count(inst) < 2 {
            return type_name
        }
        let key_ty = sig_reg_hashmap_seg_type_info(key_seg, inst, 0)
        let val_ty = sig_reg_hashmap_seg_type_info(val_seg, inst, 1)
        if type_contracts::TypeInfo_tag(key_ty) == lower_kinds::TY_TYPE_VAR() ||
        type_contracts::TypeInfo_tag(val_ty) == lower_kinds::TY_TYPE_VAR() {
            return type_name
        }
        let map_ty = type_contracts::TypeInfo_simple(lower_kinds::TY_HASHMAP())
        type_contracts::TypeInfo_push_type_arg(map_ty, key_ty)
        type_contracts::TypeInfo_push_type_arg(map_ty, val_ty)
        let alias = return_typeinfo_names::mir_hashmap_return_type_name_from_type_info(map_ty)
        if len(alias) == 0 {
            return type_name
        }
        alias
    }

    // TypeInfo for one hashmap:<k>:<v> segment. A substitutable variable
    // resolves to the MonoInstance argument at its segment ordinal — the
    // `HashMap<K,V>` annotation lists impl parameters in declaration order,
    // so segment position and argument position agree (#691).
    fn sig_reg_hashmap_seg_type_info(seg: String, inst: MonoInstance, ordinal: i32) -> TypeInfo {
        if mono_suffix_parse::mono_elem_is_substitutable_type_var(clone(seg)) {
            if ordinal >= 0 && ordinal < type_contracts::MonoInstance_type_arg_count(inst) {
                return type_contracts::MonoInstance_type_arg_at(inst, ordinal)
            }
            return type_contracts::TypeInfo_simple(lower_kinds::TY_TYPE_VAR())
        }
        sig_reg_hashmap_concrete_seg_type_info(seg)
    }

    fn sig_reg_hashmap_concrete_seg_type_info(seg: String) -> TypeInfo {
        if eq(clone(seg), String_from("i32")) {
            return type_contracts::TypeInfo_simple(lower_kinds::TY_I32())
        }
        if eq(clone(seg), String_from("String")) || eq(clone(seg), String_from("string")) {
            return type_contracts::TypeInfo_simple(lower_kinds::TY_STRING())
        }
        if eq(clone(seg), String_from("fn")) ||
        eq(clone(seg), String_from("fnref")) ||
        starts_with(clone(seg), String_from("fn(")) ||
        starts_with(clone(seg), String_from("fn<")) ||
        starts_with(clone(seg), String_from("fnsig:")) ||
        starts_with(clone(seg), String_from("fn_")) {
            return type_contracts::TypeInfo_new(lower_kinds::TY_STRUCT(), String_from("fnref"), Vec::new<TypeInfo>())
        }
        type_contracts::TypeInfo_simple(lower_kinds::TY_TYPE_VAR())
    }
