use std::prelude::{eq}
use std::text
use corehir::kinds
use corehir::function_id
use corehir::mir_signature_method
use corehir::mir_signature_fn
use corehir::signature_entry
use corehir::signature_registry
use corehir::type_id
use corehir::mir_value_type
use corehir::type_info_to_mir_value
use corehir::core_op_id
use corehir::param
use mir::lower::fn_index_method_return_type
use mir::lower::fn_index_mono
use mir::lower::fn_index_source
use mir::lower::mono_instance_build
use mir::lower::mono_suffix_parse
use mir::lower::return_typeinfo
use mir::lower::return_typeinfo_names
use mir::lower_kinds
use mir::value_types
use corehir::type_contracts

fn sig_reg_register_fn(
    mut table: TypeTable,
    mut registry: SignatureRegistry,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    fn_info_index: i32,
    typed_index: i32,
    mangled: String,
    impl_id: i32,
    mono_id: i32,
    abi: i32
) -> FunctionId {
    // CoreHir params/VT only — TypedFn.TypeInfo values are unsafe across the
    // duplicate TypeInfo/TypedFn structs in the flat selfhost overlay.
    let params = sig_reg_params_from_fn_info(sig_source, fn_info_index, table)
    let mut returns = Vec::new<MirValueType>()
    push(
        returns,
        type_info_to_mir_value::vt_to_mir_value(
            table,
            fn_index_source::mir_fn_index_source_typed_return_vt(source, typed_index),
            fn_index_source::mir_fn_index_source_typed_return_type_name(source, typed_index)
        )
    )
    let receiver = mir_value_type::MirValueType_new(type_id::TYPE_ID_INVALID(), kinds::VALUE_REPR_SCALAR(), kinds::NULLABILITY_NOT_REF())
    let entry = signature_entry::SignatureEntry_new(
        function_id::FunctionId_new(0),
        mangled.clone(),
        params,
        returns,
        false,
        receiver,
        0 - 1,
        impl_id,
        mono_id,
        abi,
        core_op_id::CORE_OP_ID_NONE()
    )
    signature_registry::signature_registry_register(registry, entry, mangled)
}

// Register a generic decl that was emitted under its leaf name because its
// only instantiation arrived through the qualified spelling (Vec::sort
// records the instance under Vec::sort, while the decl key is sort).
// The leaf-emitted body is that one concrete instance, so the decl entry —
// which call sites resolve through the qualified alias — must carry the
// instance's substituted params/return and mono link. Leaving the declared
// vec:T here makes call-result locals declare the wrong GC struct type.
fn sig_reg_register_fn_leaf_instance(
    mut table: TypeTable,
    mut registry: SignatureRegistry,
    mut mono_table: MonoInstanceTable,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    fn_info_index: i32,
    typed_index: i32,
    decl_name: String,
    inst_mangled: String,
    mono_instances: Vec<MonoInstance>,
    decl_index: i32
) -> FunctionId {
    let params = sig_reg_params_from_fn_info_mono(
        sig_source,
        fn_info_index,
        table,
        inst_mangled.clone(),
        mono_instances.clone()
    )
    let mut returns = Vec::new<MirValueType>()
    let mut return_vt = fn_index_source::mir_fn_index_source_typed_return_vt(source, typed_index)
    let mut return_type_name = fn_index_source::mir_fn_index_source_typed_return_type_name(source, typed_index)
    let generic_return_ty = fn_index_source::mir_fn_index_source_typed_return_type(source, typed_index)
    let concrete_ret = fn_index_mono::mir_mono_concrete_return_type(
        mono_instances,
        inst_mangled,
        generic_return_ty
    )
    if type_contracts::TypeInfo_tag(concrete_ret) != 0 {
        return_vt = return_typeinfo::mir_return_vt_from_type_info(concrete_ret)
        return_type_name = return_typeinfo::mir_return_type_name_from_type_info(concrete_ret)
    }
    push(
        returns,
        type_info_to_mir_value::vt_to_mir_value(table, return_vt, return_type_name)
    )
    let mono_id = mono_instance_build::mono_instance_table_register_from_instances(
        mono_table,
        table,
        mono_instances,
        inst_mangled,
        params,
        returns
    )
    let receiver = mir_value_type::MirValueType_new(type_id::TYPE_ID_INVALID(), kinds::VALUE_REPR_SCALAR(), kinds::NULLABILITY_NOT_REF())
    let entry = signature_entry::SignatureEntry_new(
        function_id::FunctionId_new(0),
        decl_name.clone(),
        params,
        returns,
        false,
        receiver,
        0 - 1,
        decl_index,
        mono_id,
        kinds::ABI_KIND_NORMAL(),
        core_op_id::CORE_OP_ID_NONE()
    )
    signature_registry::signature_registry_register(registry, entry, decl_name)
}

fn sig_reg_register_method(
    mut table: TypeTable,
    mut registry: SignatureRegistry,
    mut mono_table: MonoInstanceTable,
    source: MirLowerFnIndexSource,
    sig_source: CoreHirMirSignatureSource,
    method_info_index: i32,
    mangled: String,
    impl_decl_index: i32
) {
    let mono_instances = fn_index_source::mir_fn_index_source_mono_instances(source)
    let params = sig_reg_params_from_method_info(sig_source, method_info_index, table, mangled.clone(), mono_instances)
    let mut returns = Vec::new<MirValueType>()
    let mrvt_name = fn_index_source::mir_fn_index_source_method_return_type_name_at(source, method_info_index, "")
    let mut return_vt = fn_index_source::mir_fn_index_source_method_return_vt_at(source, method_info_index, 1)
    let mut return_type_name = mrvt_name.clone()
    // Monomorphized method instances (Pair__get_first__String) must register
    // the substituted return so call sites see String, not the T template.
    // Plain method registrations carry no mono suffix and keep the declared
    // return untouched.
    let generic_return_ty = fn_index_method_return_type::method_return_type_info_from_name(mrvt_name.clone())
    let concrete_ret = fn_index_mono::mir_mono_concrete_return_type(mono_instances, mangled.clone(), generic_return_ty)
    if type_contracts::TypeInfo_tag(concrete_ret) != 0 {
        return_vt = return_typeinfo::mir_return_vt_from_type_info(concrete_ret)
        return_type_name = return_typeinfo::mir_return_type_name_from_type_info(concrete_ret)
    } else {
        let concrete = fn_index_method_return_type::method_concrete_return_from_mono_fn_name(mangled.clone(), mrvt_name.clone())
        if len(concrete) > 0 {
            return_type_name = concrete
            return_vt = fn_index_method_return_type::method_return_vt_from_type_name(return_type_name.clone())
        }
    }
    push(returns, type_info_to_mir_value::vt_to_mir_value(table, return_vt, return_type_name))
    let mono_id = mono_instance_build::mono_instance_table_register_from_instances(
        mono_table,
        table,
        mono_instances,
        mangled.clone(),
        params,
        returns
    )
    let receiver = type_info_to_mir_value::vt_to_mir_value(table, 5, "String")
    let trait_id = mir_signature_method::mir_signature_method_trait_id_at(sig_source, method_info_index)
    let entry = signature_entry::SignatureEntry_new(
        function_id::FunctionId_new(0),
        mangled.clone(),
        params,
        returns,
        true,
        receiver,
        trait_id,
        impl_decl_index,
        mono_id,
        kinds::ABI_KIND_TRAIT_DISPATCH(),
        core_op_id::CORE_OP_ID_NONE()
    )
    signature_registry::signature_registry_register(registry, entry, mangled)
}

fn sig_reg_params_from_fn_info(sig_source: CoreHirMirSignatureSource, fn_info_index: i32, mut table: TypeTable) -> Vec<MirValueType> {
    sig_reg_params_from_fn_info_mono(sig_source, fn_info_index, table, String_new(), Vec::new<MonoInstance>())
}

fn sig_reg_params_from_fn_info_mono(
    sig_source: CoreHirMirSignatureSource,
    fn_info_index: i32,
    mut table: TypeTable,
    mangled: String,
    mono_instances: Vec<MonoInstance>
) -> Vec<MirValueType> {
    let mut result = Vec::new<MirValueType>()
    if fn_info_index < 0 {
        return result
    }
    let pc = mir_signature_fn::mir_signature_fn_param_count_at(sig_source, fn_info_index, 0)
    let type_params = mir_signature_fn::mir_signature_fn_type_params_at(sig_source, fn_info_index)
    let mut pi = 0
    while pi < pc {
        let p = mir_signature_fn::mir_signature_fn_param_at(sig_source, fn_info_index, pi)
        let mut type_name = param::param_type_name(p)
        let local_name = param::param_local_type_name(p)
        if len(local_name) > 0 {
            type_name = local_name
        }
        if len(mangled) > 0 {
            type_name = sig_reg_subst_mono_param_type_name(type_name.clone(), mangled.clone(), mono_instances, type_params)
        }
        if type_name.clone().starts_with(String_from("hashmap:")) ||
        type_name.clone().starts_with(String_from("?HashMap:")) {
            type_name = sig_reg_mono_hashmap_param_alias(type_name, mangled.clone(), mono_instances)
        }
        let mut vt = param::param_value_type(p)
        if type_name.clone().starts_with("vec:") ||
        type_name.clone().starts_with("option:") ||
        type_name.clone().starts_with("struct:") {
            vt = value_types::VT_GC_REF()
        } else if !mono_suffix_parse::is_mono_type_var_name(type_name.clone()) &&
            len(type_name) > 0 {
                vt = fn_index_method_return_type::method_return_vt_from_type_name(type_name.clone())
            }
            push(result, type_info_to_mir_value::vt_to_mir_value(table, vt, type_name))
            pi = pi + 1
        }
        result
    }

    fn sig_reg_subst_mono_param_type_name(
        type_name: String,
        mangled: String,
        mono_instances: Vec<MonoInstance>,
        type_params: Vec<String>
    ) -> String {
        let suffix = mono_suffix_parse::extract_mono_suffix(mangled.clone())
        if len(suffix) == 0 {
            // Mangle keys that is_valid_mono_type_key rejects: fn(A) -> R
            // flattens to fn_<params>_<ret>_ with lowercase + underscores,
            // still resolve through the recorded MonoInstance type args so
            // Vec<fn(i32) -> i32> params spell vec:fnref (#874).
            return sig_reg_subst_via_mono_instance(type_name, mangled, mono_instances, type_params)
        }
        if type_name.clone().starts_with("vec:") {
            let elem = type_name.clone().slice(4, len(type_name))
            if !mono_suffix_parse::is_mono_type_var_name(elem.clone()) {
                return type_name
            }
            let concrete = sig_reg_resolve_mono_type_key(elem.clone(), suffix.clone(), type_params)
            if len(concrete) == 0 {
                return type_name
            }
            return "vec:".concat(concrete)
        }
        if type_name.clone().starts_with("option:") {
            let elem = type_name.clone().slice(7, len(type_name))
            if !mono_suffix_parse::is_mono_type_var_name(elem.clone()) {
                return type_name
            }
            let concrete = sig_reg_resolve_mono_type_key(elem.clone(), suffix.clone(), type_params)
            if len(concrete) == 0 {
                return type_name
            }
            return "option:".concat(concrete)
        }
        if mono_suffix_parse::is_mono_type_var_name(type_name.clone()) {
            let concrete = sig_reg_resolve_mono_type_key(type_name.clone(), suffix.clone(), type_params)
            if len(concrete) > 0 {
                return concrete
            }
        }
        type_name
    }

    fn sig_reg_resolve_mono_type_key(type_var: String, mono_suffix: String, type_params: Vec<String>) -> String {
        if mono_suffix.clone().starts_with("Vec") {
            return mono_suffix
        }
        let keys = mono_suffix_parse::split_mono_suffix(mono_suffix.clone())
        let key_count = len(keys)
        if key_count <= 0 {
            return String_new()
        }
        if key_count == 1 {
            return get_unchecked(keys, 0)
        }
        let idx = mono_suffix_parse::mono_type_var_index(type_var.clone(), type_params)
        if idx >= 0 && idx < key_count {
            return get_unchecked(keys, idx)
        }
        get_unchecked(keys, 0)
    }

    // Substitute a generic param type name through the recorded MonoInstance
    // type args when the mangled suffix is not a parseable mono key (fn
    // signatures flatten to fn_<params>_<ret>_ which is_valid_mono_type_key
    // rejects). The substitution key is mir_type_info_to_mono_key, the same
    // spelling the enclosing body map records, so vec:fnref reaches the
    // signature exactly like the resolved locals do (#874).
    fn sig_reg_subst_via_mono_instance(
        type_name: String,
        mangled: String,
        mono_instances: Vec<MonoInstance>,
        type_params: Vec<String>
    ) -> String {
        if len(type_name) == 0 || len(mangled) == 0 || len(mono_instances) == 0 {
            return type_name
        }
        let inst = mono_instance_build::mono_find_instance(mono_instances, mangled.clone())
        if type_contracts::MonoInstance_type_arg_count(inst) <= 0 {
            return type_name
        }
        if type_name.clone().starts_with("vec:") {
            let elem = type_name.clone().slice(4, len(type_name))
            if !mono_suffix_parse::is_mono_type_var_name(elem.clone()) {
                return type_name
            }
            let key = sig_reg_mono_instance_arg_key(inst, elem.clone(), type_params)
            if len(key) > 0 {
                return "vec:".concat(key)
            }
            return type_name
        }
        if type_name.clone().starts_with("option:") {
            let elem = type_name.clone().slice(7, len(type_name))
            if !mono_suffix_parse::is_mono_type_var_name(elem.clone()) {
                return type_name
            }
            let key = sig_reg_mono_instance_arg_key(inst, elem.clone(), type_params)
            if len(key) > 0 {
                return "option:".concat(key)
            }
            return type_name
        }
        if mono_suffix_parse::is_mono_type_var_name(type_name.clone()) {
            let key = sig_reg_mono_instance_arg_key(inst, type_name.clone(), type_params)
            if len(key) > 0 {
                return key
            }
        }
        type_name
    }

    fn sig_reg_mono_instance_arg_key(inst: MonoInstance, type_var: String, type_params: Vec<String>) -> String {
        let idx = mono_suffix_parse::mono_type_var_index(type_var.clone(), type_params)
        if idx < 0 || idx >= type_contracts::MonoInstance_type_arg_count(inst) {
            return String_new()
        }
        let ty = type_contracts::MonoInstance_type_arg_at(inst, idx)
        mir_type_info_to_mono_key(ty)
    }

    fn sig_reg_params_from_method_info(
        sig_source: CoreHirMirSignatureSource,
        method_info_index: i32,
        mut table: TypeTable,
        mangled: String,
        mono_instances: Vec<MonoInstance>
    ) -> Vec<MirValueType> {
        let mut result = Vec::new<MirValueType>()
        if method_info_index < 0 {
            return result
        }
        let pc = mir_signature_method::mir_signature_method_param_count_at(sig_source, method_info_index, 0)
        // Method instances carry the same declared binders as top-level
        // generics (impl binders first, then method binders). Without the
        // suffix projection `self: Vec<T>` registers as vec:T and the
        // signature fallback selects the vec:i32 layout while the MIR body
        // holds the concrete Vec<i64>/Vec<String>; callers then pass a
        // mismatched struct ref (#965).
        let type_params = mir_signature_method::mir_signature_method_type_params_at(sig_source, method_info_index)
        let mut pi = 0
        while pi < pc {
            let p = mir_signature_method::mir_signature_method_param_at(sig_source, method_info_index, pi)
            let mut type_name = param::param_type_name(p)
            let local_name = param::param_local_type_name(p)
            if len(local_name) > 0 {
                type_name = local_name
            }
            if len(mangled) > 0 {
                type_name = sig_reg_subst_mono_param_type_name(type_name.clone(), mangled.clone(), mono_instances, type_params)
            }
            if type_name.clone().starts_with(String_from("hashmap:")) {
                type_name = sig_reg_mono_hashmap_param_alias(type_name, mangled.clone(), mono_instances)
            }
            let is_container = type_name.clone().starts_with("vec:") ||
            type_name.clone().starts_with("option:") ||
            type_name.clone().starts_with("struct:")
            let mut vt = param::param_value_type(p)
            if is_container {
                vt = value_types::VT_GC_REF()
            } else if len(type_name) > 0 && !mono_suffix_parse::is_mono_type_var_name(type_name.clone()) {
                vt = fn_index_method_return_type::method_return_vt_from_type_name(type_name.clone())
            }
            push(result, type_info_to_mir_value::vt_to_mir_value(table, vt, type_name))
            pi = pi + 1
        }
        result
    }

    // `hashmap:K:V` param spellings reach the registry unresolved: the
    // declared HashMap<K,V> annotation aliases to `K:V` before mono names
    // bind, and the pair lookup would silently take the si32 default layout.
    // Resolve each segment through the MonoInstance type args (which keep fn
    // signatures the mangled suffix cannot) and rebuild the canonical
    // hashmap:<pair> alias (#691).
    fn sig_reg_mono_hashmap_param_alias(type_name: String, mangled: String, mono_instances: Vec<MonoInstance>) -> String {
        let args = if type_name.clone().starts_with(String_from("?HashMap:")) {
            type_name.clone().slice(9, len(type_name))
        } else {
            type_name.clone().slice(8, len(type_name))
        }
        let colon = args.clone().index_of(String_from(":"))
        if colon < 0 {
            return type_name
        }
        let key_seg = args.clone().slice(0, colon)
        let val_seg = args.clone().slice(colon + 1, len(args))
        if !mono_suffix_parse::is_mono_type_var_name(key_seg.clone()) &&
        !mono_suffix_parse::is_mono_type_var_name(val_seg.clone()) {
            return type_name
        }
        let inst = mono_instance_build::mono_find_instance(mono_instances, mangled.clone())
        if type_contracts::MonoInstance_type_arg_count(inst) < 2 {
            return type_name
        }
        let key_ty = sig_reg_hashmap_seg_type_info(key_seg, inst, 0)
        let val_ty = sig_reg_hashmap_seg_type_info(val_seg, inst, 1)
        if type_contracts::TypeInfo_tag(key_ty) == lower_kinds::TY_TYPE_VAR() ||
        type_contracts::TypeInfo_tag(val_ty) == lower_kinds::TY_TYPE_VAR() {
            return type_name
        }
        let mut map_ty = type_contracts::TypeInfo_simple(lower_kinds::TY_HASHMAP())
        type_contracts::TypeInfo_push_type_arg(map_ty, key_ty)
        type_contracts::TypeInfo_push_type_arg(map_ty, val_ty)
        let alias = return_typeinfo_names::mir_hashmap_return_type_name_from_type_info(map_ty)
        if len(alias) == 0 {
            return type_name
        }
        alias
    }

    // TypeInfo for one hashmap:<k>:<v> segment. A substitutable variable
    // resolves to the MonoInstance argument at its segment ordinal — the
    // `HashMap<K,V>` annotation lists impl parameters in declaration order,
    // so segment position and argument position agree (#691).
    fn sig_reg_hashmap_seg_type_info(seg: String, inst: MonoInstance, ordinal: i32) -> TypeInfo {
        if mono_suffix_parse::is_mono_type_var_name(seg.clone()) {
            if ordinal >= 0 && ordinal < type_contracts::MonoInstance_type_arg_count(inst) {
                return type_contracts::MonoInstance_type_arg_at(inst, ordinal)
            }
            return type_contracts::TypeInfo_simple(lower_kinds::TY_TYPE_VAR())
        }
        sig_reg_hashmap_concrete_seg_type_info(seg)
    }

    fn sig_reg_hashmap_concrete_seg_type_info(seg: String) -> TypeInfo {
        if eq(seg.clone(), String_from("i32")) {
            return type_contracts::TypeInfo_simple(lower_kinds::TY_I32())
        }
        if eq(seg.clone(), String_from("String")) || eq(seg.clone(), String_from("string")) {
            return type_contracts::TypeInfo_simple(lower_kinds::TY_STRING())
        }
        if eq(seg.clone(), String_from("fn")) ||
        eq(seg.clone(), String_from("fnref")) ||
        seg.clone().starts_with(String_from("fn(")) ||
        seg.clone().starts_with(String_from("fn<")) ||
        seg.clone().starts_with(String_from("fnsig:")) ||
        seg.clone().starts_with(String_from("fn_")) {
            return type_contracts::TypeInfo_new(lower_kinds::TY_STRUCT(), String_from("fnref"), Vec::new<TypeInfo>())
        }
        type_contracts::TypeInfo_simple(lower_kinds::TY_TYPE_VAR())
    }
