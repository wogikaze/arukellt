use mir::lower::ctx_api_module
use collections::name_index
use mir::lower::ctx_call_edges
use mir::lower::ctx_fn_index
use mir::lower::ctx_gc_enum
use mir::lower::ctx_gc_struct
use mir::lower::ctx_gc_struct_order
use mir::lower::ctx_struct_layout
use mir::lower::closure_env
use mir::lower::decl_source
use mir::lower::ctx_corehir_probe
use mir::lower::edge_discovery
use mir::lower::emit_inloop
use mir::lower::emit_spec
use mir::emit_artifacts
use mir::module_emit_artifacts
use mir::lower::entry_context
use mir::lower::entry_decls
use mir::lower::entry_input
use mir::lower::entry_source_locations
use mir::lower::entry_fn_index_facade
use mir::lower::entry_timing
use mir::lower::entry_trace
use mir::lower::gc_layout_plan_build
use mir::lower::mono_view
use mir::lower::registry_view
use mir::lower::trace
use mir::lower::ctx_gc_canon
use mir::module_factory
use mir::module_gc_order
use mir::module_functions
use mir::post_pass_callee_cache
use mir::reachability
use mir::reachability_legacy
use corehir::mir_body_source
use corehir::mod as corehir_mod

// Bootstrap flat overlay may inject mir_dedupe_functions_by_name into monolithic
// mir_lower.ark as an identity no-op; modular lowering never MIR-dedupes here.
// Export-only dedupe (wasm/sections_exports.ark) handles overlay name collisions.

fn lower_entry_input_to_mir(input: MirLowerEntryInput, export_roots: Vec<String>, prune_enabled: bool) -> MirModule {
    let timing = entry_timing::mir_lower_phase_timing_enabled(input.report_phase_timing)
    let t_enter = entry_timing::mir_lower_phase_now()
    let view = entry_input::mir_entry_input_view(input)
    let body_source = entry_input::mir_entry_input_body_source(input)
    let m = module_factory::MirModule_new()
    // #851 Phase 3: enable emit artifacts up front so per-push recording
    // (pair CALL_REF tuples now; body bytes once emit moves in-loop)
    // captures every pushed function — the drain only reads them.
    if emit_spec::mir_lower_emit_spec_enabled(input.emit_spec) {
        emit_artifacts::MirEmitArtifacts_enable(module_emit_artifacts::MirModule_emit_artifacts(m))
    }
    if prune_enabled {
        module_functions::MirModule_set_export_names(m, clone_export_roots(export_roots))
    }
    let decl_source = decl_source::mir_decl_source_from_view(view)
    let decl_count = decl_source::mir_decl_source_count(decl_source)
    let mono_view = mono_view::mir_lower_mono_view_from_core(view)
    let midx = mono_view::mir_lower_mono_view_index(mono_view)
    let fn_index_info = entry_fn_index_facade::mir_build_fn_index_from_view(view, midx, m)
    let t_after_fn_index = entry_timing::mir_lower_phase_now()
    entry_timing::mir_lower_phase_note(timing, "fn_index", t_enter, t_after_fn_index)
    let mir_tr = entry_trace::mir_lower_entry_trace_enabled()
    mir_lower_trace_line(mir_tr, -1, decl_count, entry_fn_index_facade::mir_fn_index_typed_fn_count(fn_index_info), 0, 0)
    let source_text = clone(input.source_text)
    let fn_source_locations = entry_source_locations::compute_fn_source_locations(view, input.decl_nodes, clone(source_text))
    let mut ctx = entry_context::mir_prepare_lower_ctx(m, fn_index_info, mono_view, mir_tr, input.wit_paths, input.decl_nodes, input.target, source_text, fn_source_locations)
    // #851 Phase 3: hand the emit spec to the lowering ctx so per-push
    // post passes (per-fn opt now, body emit next) see the same opt
    // level and target spelling the drain spec carries.
    if emit_spec::mir_lower_emit_spec_enabled(input.emit_spec) {
        ctx.emit_spec = input.emit_spec
        // Per-push body emit is gated to gc targets on the non-legacy
        // reachability path — the drain still covers deferred bodies and
        // every configuration that leaves this flag off.
        if ctx.is_gc_target {
            if !reachability_legacy::mir_reachability_legacy_enabled() {
                ctx.emit_in_loop = true
            }
        }
    }
    registry_view::mir_register_view_layouts(ctx, view)
    // View registration seals named GC types (ticks 166–167). Reorder and
    // flush the prefix once. Body emit may still append; flush only the tail
    // so prefix type indices stay stable. A full second flush duplicates.
    ctx_gc_struct_order::ctx_reorder_gc_structs_deps_first(ctx)
    // Sealed flush order must match the emit order (structs before enum
    // variants): flushes also assign canon indices inline, and the section
    // emits canon_sigs in ensure order — enum payload sigs may reference
    // struct slots via gcsref, so structs must ensure first.
    ctx_gc_struct::ctx_flush_gc_structs(ctx)
    ctx_gc_enum::ctx_flush_gc_enum_variants(ctx)
    let sealed_structs = ctx_gc_struct::ctx_gc_struct_count(ctx)
    let sealed_enums = ctx_gc_enum::ctx_gc_enum_variant_count(ctx)
    // #851 Phase 3: everything sealed so far keeps its slot position in
    // the module type region. Registrations after this point are "late"
    // and get recorded on the module in registration order so emit can
    // place them after the sealed types — a forward type index is invalid
    // outside a rec group.
    ctx.gc_seal_done = true
    module_gc_order::MirModule_set_sealed_gc_counts(
        ctx.module,
        sealed_structs,
        sealed_enums
    )
    // #851 Phase 3: bind fixed + sealed layout entries into the module-held
    // plan now. Post-seal registrations bind their own slot at materialize
    // time; the post-loop build below re-runs all binds idempotently.
    gc_layout_plan_build::mir_module_build_gc_layout_plan(ctx.module, clone(input.target))
    let t_after_ctx = entry_timing::mir_lower_phase_now()
    entry_timing::mir_lower_phase_note(timing, "ctx_prep", t_after_fn_index, t_after_ctx)
    // #851 Phase 3: snapshot the fn_index return catalog onto the module so
    // callee metadata survives body detach. Names carry the same enum
    // normalization MirFunction.return_type_name uses; late ctx_register
    // names are covered by the tier-1 module index instead.
    let disc_count = ctx_fn_index::ctx_fn_index_count(ctx)
    let mut disc_i = 0
    // Append into the module vecs (not replace): signatures registered
    // during ctx prep (e.g. WIT bindings) may already have pushed entries.
    let disc_names = module_functions::MirModule_discovery_fn_names(m)
    let disc_ret_names = module_functions::MirModule_discovery_fn_ret_names(m)
    while disc_i < disc_count {
        push(disc_names, ctx_fn_index::ctx_fn_index_name_at(ctx, disc_i))
        push(
            disc_ret_names,
            ctx_struct_layout::ctx_maybe_enum_return_type_name(
                ctx,
                ctx_fn_index::ctx_fn_index_return_type_name_at(ctx, disc_i)
            )
        )
        disc_i = disc_i + 1
    }
    // Seed the incremental callee cache now that the discovery table is on
    // the module: tier 1 starts empty (no bodies pushed yet), tier 2 covers
    // every decl name so forward callees resolve during per-fn passes.
    ctx.prop_cache = post_pass_callee_cache::callee_prop_cache_build(m)
    // #851 Phase 3: pre-lower AST call-edge table. When pruning is on it
    // drives the worklist skip (emit no body an unreachable decl would
    // produce); under the probe switch it is also diffed against the
    // recorded stream.
    let mut ast_edges = edge_discovery::mir_ast_edge_table_empty()
    if prune_enabled || ctx_corehir_probe::mir_probe_edges_enabled() != 0 {
        ast_edges = edge_discovery::mir_ast_edge_table_build(ctx, body_source, view, midx)
    }
    let t_after_edges = entry_timing::mir_lower_phase_now()
    entry_timing::mir_lower_phase_note(timing, "edge_table", t_after_ctx, t_after_edges)
    let mut emit_keep = name_index::NameIndex_new(4)
    if prune_enabled {
        emit_keep = edge_discovery::mir_ast_edge_reachable_names(ctx, ast_edges, clone_export_roots(export_roots))
    }
    let t_after_bfs = entry_timing::mir_lower_phase_now()
    entry_timing::mir_lower_phase_note(timing, "edge_bfs", t_after_edges, t_after_bfs)
    // Decl-level bodies the AST-edge worklist skipped never enter the
    // module; count them in fns_before so reachability_fns still reports
    // "fns considered -> fns surviving" instead of only the post-skip
    // module population.
    let skipped_bodies = entry_decls::mir_emit_view_decls(
        ctx,
        view,
        body_source,
        fn_index_info,
        midx,
        mir_tr,
        prune_enabled,
        emit_keep,
        timing
    )
    input.decl_nodes = Vec::new<AstNode>()
    input.wit_paths = Vec::new<String>()
    input.source_text = String_new()
    mir_body_source::mir_body_source_release(corehir_mod::view_body_source(view))
    // Forward-referenced __fnthunk_ shims are emitted now that every
    // decl body is pushed; their edge frames join the recorded stream
    // before reachability consumes it.
    closure_env::closure_flush_pending_fn_thunks(ctx)
    let late_structs = ctx_gc_struct::ctx_gc_struct_count(ctx) - sealed_structs
    // fn-typed signatures without a produced pair value still need the
    // shared __fnpair record for their param/return/field types (#872).
    if closure_env::closure_module_uses_fn_types(ctx) {
        ctx_gc_struct::ctx_ensure_fnpair_struct(ctx)
    }
    let late_enums = ctx_gc_enum::ctx_gc_enum_variant_count(ctx) - sealed_enums
    ctx_gc_struct::ctx_flush_gc_structs_from(ctx, sealed_structs)
    ctx_gc_enum::ctx_flush_gc_enum_variants_from(ctx, sealed_enums)
    // Late canon indices are assigned in late_gc_order — the emission
    // order — after the slot-order pushes above kept module slot == ctx
    // slot.
    ctx_gc_canon::ctx_gc_canon_ensure_late(ctx)
    entry_timing::mir_lower_gc_late_note(timing, late_structs, late_enums)
    let t_after_decl = entry_timing::mir_lower_phase_now()
    entry_timing::mir_lower_phase_note(timing, "body_emit", t_after_ctx, t_after_decl)
    entry_timing::mir_lower_phase_note(timing, "decl_emit", t_enter, t_after_decl)

    let module = ctx_api_module::ctx_current_module(ctx)
    let fns_before = module_functions::MirModule_function_count(module) + skipped_bodies
    if ctx_corehir_probe::mir_probe_edges_enabled() != 0 {
        ctx_corehir_probe::mir_probe_dump_recorded_edges(
            module,
            ctx_call_edges::ctx_edge_table(ctx),
            ctx_call_edges::ctx_edge_fn_names(ctx),
            ctx_call_edges::ctx_edge_overflow_names(ctx)
        )
        ctx_corehir_probe::mir_probe_dump_return_table_diff(ctx, module)
        ctx_corehir_probe::mir_probe_dump_ast_edge_coverage(
            ctx,
            module,
            ctx_call_edges::ctx_edge_table(ctx),
            ctx_call_edges::ctx_edge_fn_names(ctx),
            ctx_call_edges::ctx_edge_overflow_names(ctx),
            ast_edges
        )
        ctx_corehir_probe::mir_probe_dump_ast_reach_diff(
            ctx,
            module,
            clone_export_roots(export_roots),
            clone(input.target),
            ctx_call_edges::ctx_edge_table(ctx),
            ctx_call_edges::ctx_edge_fn_names(ctx),
            ctx_call_edges::ctx_edge_overflow_names(ctx),
            ast_edges
        )
    }
    let blocks_before = module_functions::MirModule_block_count(module)
    let insts_before = module_functions::MirModule_inst_count(module)
    // #851 Phase 3: sync/propagate already ran per-function at push time
    // (ctx_run_per_fn_post_pass appends the cache entry first so forward
    // callees resolve through the discovery tier). The module-wide scans
    // are gone; the GC layout plan binds only type/gc tables so it is
    // built before prune, where the fused drain can populate the emit
    // layout table from the same plan the emit phase uses.
    gc_layout_plan_build::mir_module_build_gc_layout_plan(module, clone(input.target))
    let t_after_plan = entry_timing::mir_lower_phase_now()
    entry_timing::mir_lower_phase_note(timing, "gc_layout_plan", t_after_decl, t_after_plan)

    // #851 Phase 3 fused emit (pre-prune drain): bodies emit while the
    // pre-prune module is still intact — every function/name lookup
    // resolves exactly as it would at emit time — and recorded indices
    // are compacted through prune_old_to_new at artifact adoption. The
    // legacy reachability path keeps the legacy post-lower emit loop.
    if emit_spec::mir_lower_emit_spec_enabled(input.emit_spec) {
        if !reachability_legacy::mir_reachability_legacy_enabled() {
            emit_inloop::emit_inloop_drain(ctx, module, export_roots, prune_enabled, input.emit_spec)
        }
    }
    let t_after_inloop = entry_timing::mir_lower_phase_now()
    entry_timing::mir_lower_phase_note(timing, "inloop_emit", t_after_plan, t_after_inloop)

    if prune_enabled {
        // Sync/propagate is O(locals^2) per function; prune with export roots first
        // so selfhost-scale modules do not sync the full emitter graph (#730).
        let _pruned = reachability::mir_prune_unreachable_with_roots_for_target_and_edges(
            module,
            export_roots,
            clone(input.target),
            ctx_call_edges::ctx_edge_table(ctx),
            ctx_call_edges::ctx_edge_fn_names(ctx),
            ctx_call_edges::ctx_edge_overflow_names(ctx)
        )
    }
    let fns_after = module_functions::MirModule_function_count(module)
    let blocks_after = module_functions::MirModule_block_count(module)
    let insts_after = module_functions::MirModule_inst_count(module)
    let t_after_reach = entry_timing::mir_lower_phase_now()
    entry_timing::mir_lower_phase_note(timing, "reachability", t_after_inloop, t_after_reach)
    entry_timing::mir_lower_phase_fns(timing, fns_before, fns_after)
    entry_timing::mir_lower_phase_mir_size(timing, blocks_before, blocks_after, insts_before, insts_after)
    entry_timing::mir_lower_phase_note(timing, "sync", t_after_reach, t_after_reach)
    entry_timing::mir_lower_phase_note(timing, "propagate", t_after_reach, t_after_reach)
    entry_timing::mir_lower_phase_note(timing, "total", t_enter, t_after_reach)

    module
}

fn clone_export_roots(export_roots: Vec<String>) -> Vec<String> {
    let mut cloned = Vec::new<String>()
    let mut i = 0
    while i < len(export_roots) {
        push(cloned, clone(get_unchecked(export_roots, i)))
        i = i + 1
    }
    cloned
}

fn lower_program_to_mir(input: MirLowerInput) -> MirModule {
    // Callers without an export surface keep the full graph through sync.
    // Driver/session T3 paths use lower_program_to_mir_with_roots instead.
    lower_entry_input_to_mir(entry_input::mir_entry_input_from_lower_input(input), Vec::new<String>(), false)
}

fn lower_program_to_mir_no_prune(input: MirLowerInput) -> MirModule {
    lower_entry_input_to_mir(entry_input::mir_entry_input_from_lower_input(input), Vec::new<String>(), false)
}

fn lower_program_to_mir_with_roots(input: MirLowerInput, export_roots: Vec<String>) -> MirModule {
    lower_entry_input_to_mir(entry_input::mir_entry_input_from_lower_input(input), export_roots, true)
}
