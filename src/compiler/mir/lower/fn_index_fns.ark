use std::prelude::{clone, eq}
use mir::lower::fn_index_mono
use mir::lower::fn_index_source
use mir::lower::stdlib_body_defer
use mir::mono
fn mir_index_top_level_fn(
    mut fn_names: Vec<String>,
    mut fn_return_vts: Vec<i32>,
    mut fn_return_type_names: Vec<String>,
    decl_index: i32,
    decl_name: String,
    fn_index: i32,
    source: MirLowerFnIndexSource,
    midx: MonoIndex
) -> i32 {
    let mut typed_index = fn_index
    let fn_info_index = fn_index_source::mir_fn_index_source_fn_info_index_for_decl(source, decl_index)
    if fn_info_index >= 0 {
        typed_index = fn_index_source::mir_fn_index_source_fn_typed_index_at(source, fn_info_index, typed_index)
    }
    let rvt = fn_index_source::mir_fn_index_source_typed_return_vt(source, typed_index)
    let rtn = fn_index_source::mir_fn_index_source_typed_return_type_name(source, typed_index)
    let generic_return_ty = fn_index_source::mir_fn_index_source_typed_return_type(source, typed_index)
    let mono_instances = fn_index_source::mir_fn_index_source_mono_instances(source)
    let entry_main_decl_index = fn_index_source::mir_fn_index_source_entry_main_decl_index(source)
    let skip_shadow_main = eq(clone(decl_name), "main") && decl_index != entry_main_decl_index
    let skip_join_vec = if fn_info_index >= 0 {
        let param_count = fn_index_source::mir_fn_index_source_fn_param_count_at(source, fn_info_index)
        if param_count > 0 {
            let param0 = fn_index_source::mir_fn_index_source_fn_param_at(source, fn_info_index, 0)
            stdlib_body_defer::mir_is_vec_join_overload(clone(decl_name), param0)
        } else {
            false
        }
    } else {
        false
    }
    if !skip_shadow_main && !skip_join_vec {
        push(fn_names, clone(decl_name))
        push(fn_return_vts, rvt)
        push(fn_return_type_names, clone(rtn))
        // Mono variants belong to the generic decl only. A concrete decl
        // sharing the bare name with an entry-module generic (imported
        // std::collections::string::to_lower vs the program's to_lower<T>)
        // would otherwise publish to_lower__String with its own signature
        // (#914).
        if fn_index_source::mir_fn_index_source_decl_is_generic(source, typed_index) {
            fn_index_mono::mir_index_mono_variants(fn_names, fn_return_vts, fn_return_type_names, midx, clone(decl_name), rvt, clone(rtn), mono_instances, generic_return_ty)
            // Instances of a module member record under the qualified fn_name
            // (test::assert_eq_debug), which the decl-keyed index above never
            // sees. With two or more distinct instantiations the leaf emit is a
            // generic stub, so publish the variant names under the qualified key
            // — call-site resolution and emit both look them up by that name.
            // One decl can hold instances under both keys: a wrapper inside the
            // same module records the bare name (binary_search →
            // binary_search_by__i32) while a downstream call records the
            // qualified name (Vec::binary_search__String). Publish the
            // qualified-keyed variants whenever they are not served by the
            // single-instance leaf path; otherwise the extra instantiation is
            // dropped and callers bind the first-registered specialization
            // (#908).
            if fn_info_index >= 0 {
                let mono_qualified_name = fn_index_source::mir_fn_index_source_fn_qualified_name_at(source, fn_info_index)
                let bare_mono_count = mono::mono_index_count(midx, clone(decl_name))
                let mut qualified_mono_count = 0
                if len(mono_qualified_name) > 0 && !eq(clone(mono_qualified_name), clone(decl_name)) {
                    qualified_mono_count = mono::mono_index_count(midx, clone(mono_qualified_name))
                }
                if qualified_mono_count > 1 || (bare_mono_count > 0 && qualified_mono_count > 0) {
                    fn_index_mono::mir_index_mono_variants(fn_names, fn_return_vts, fn_return_type_names, midx, mono_qualified_name, rvt, clone(rtn), mono_instances, generic_return_ty)
                }
            }
        }
    }
    fn_index + 1
}
