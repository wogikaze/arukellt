use std::text
use mir::lower::ctx_fn_exists
use mir::lower::ctx_fn_index
use mir::lower::ctx_mono_rewrites
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_layout
use mir::lower::ctx_current_storage
use mir::module_functions
use collections::name_index
use mir::mono_names
fn ctx_replace_fn_index(
    mut ctx: LowerCtx,
    fn_names: Vec<String>,
    fn_return_vts: Vec<i32>,
    fn_return_type_names: Vec<String>,
    priority_fn_indices: Vec<i32>,
    qualified_names: Vec<String>,
    qualified_return_vts: Vec<i32>,
    qualified_return_type_names: Vec<String>
) {
    ctx_fn_index::ctx_fn_index_replace(ctx, fn_names, fn_return_vts, fn_return_type_names, priority_fn_indices)
    ctx_fn_index::ctx_qualified_fn_index_replace(
        ctx,
        qualified_names,
        qualified_return_vts,
        qualified_return_type_names
    )
}

fn ctx_register_fn_signature(mut ctx: LowerCtx, name: String, return_vt: i32, return_type_name: String) {
    ctx_fn_index::ctx_fn_index_push(ctx, name.clone(), return_vt, return_type_name.clone())
    // Keep the discovery return catalog parallel (#851 Phase 3): names
    // registered after ctx_prep (synth fns, late signatures) are reachable
    // by per-fn callee lookups before their bodies exist.
    let m = ctx_current_storage::ctx_current_module_value(ctx)
    let mut names = module_functions::MirModule_discovery_fn_names(m)
    push(names, name.clone())
    let mut ret_names = module_functions::MirModule_discovery_fn_ret_names(m)
    push(ret_names, ctx_struct_layout::ctx_maybe_enum_return_type_name(ctx, return_type_name.clone()))
    // The seeded cache index is not rebuilt on growth; register the new
    // name so tier-2 lookups find it too.
    name_index::name_index_insert_first(ctx.prop_cache.disc_names, name.clone(), names.len() - 1)
}

fn ctx_mono_lookup_call(mut ctx: LowerCtx, span_start: i32, source: String) -> String {
    let mut first_match = 0 - 1
    let mut cursor = ctx_mono_rewrites::ctx_mono_span_hash_head(ctx, span_start)
    while cursor > 0 {
        let i = cursor - 1
        if ctx.mono_call_starts.get_unchecked(i) == span_start {
            let candidate_source = ctx.mono_call_span_sources.get_unchecked(i)
            let candidate_target = ctx.mono_call_span_targets.get_unchecked(i)
            if mono_sources_match(candidate_source, source.clone()) &&
            mono_target_matches_source(candidate_target.clone(), source.clone()) {
                if first_match < 0 {
                    first_match = i
                }
                if ctx.mono_call_span_used.get_unchecked(i) == 0 {
                    ctx_mono_rewrites::ctx_mono_mark_span_rewrite_used(ctx, i)
                    return ctx_mono_concretize_span_target(ctx, candidate_target)
                }
            }
        }
        cursor = ctx.mono_span_next.get_unchecked(i)
    }
    if first_match >= 0 {
        return ctx_mono_concretize_span_target(ctx, ctx.mono_call_span_targets.get_unchecked(first_match))
    }
    ""
}

// A span rewrite recorded inside a generic body pins the template
// spelling (`Take__next__?I`). The enclosing instance binds the type
// variables, so rewrite `?Var` segments through the current mono map
// before accepting the target. An unbound variable means the site was
// recorded for a different instantiation; returning "" lets the name
// and receiver-derived fallbacks resolve it instead of pinning a
// callee that can only trap.
fn ctx_mono_concretize_span_target(ctx: LowerCtx, target: String) -> String {
    if !target.clone().contains(String_from("?")) {
        return target
    }
    let resolved = ctx_mono_substitute_span_vars(ctx, target.clone())
    if resolved.len() > 0 && ctx_fn_exists::ctx_has_fn_name(ctx, resolved.clone()) {
        return resolved
    }
    String_new()
}

fn ctx_mono_substitute_span_vars(ctx: LowerCtx, target: String) -> String {
    if !ctx_mono_type_params::ctx_has_mono_type_params(ctx) {
        return String_new()
    }
    let count = ctx.mono_type_param_names.len()
    let mut out = target.clone()
    let mut i = 0
    while i < count {
        let var_name = ctx.mono_type_param_names.get_unchecked(i)
        let concrete = ctx.mono_type_param_types.get_unchecked(i)
        out = ctx_mono_replace_var_token(
            out.clone(),
            String_from("?").concat(var_name.clone()),
            mono_names::mono_safe_name(concrete.clone())
        )
        i = i + 1
    }
    if out.clone().contains(String_from("?")) {
        return String_new()
    }
    out
}

// Replace `?Name` only at a mono argument boundary (end of name or the
// `__` separator) so `?I` does not rewrite inside `?Item` or inside a
// nested argument's mapped underscores.
fn ctx_mono_replace_var_token(target: String, token: String, replacement: String) -> String {
    let tlen = token.len()
    let n = target.len()
    if tlen == 0 || tlen > n {
        return target
    }
    let mut out = String_new()
    let mut i = 0
    while i < n {
        let mut matched = false
        if i + tlen <= n && target.clone().slice(i, i + tlen).eq(token.clone()) {
            let tail = i + tlen
            if tail >= n {
                matched = true
            } else if tail + 1 < n && target.clone().byte_at(tail) == 95 && target.clone().byte_at(tail + 1) == 95 {
                matched = true
            }
        }
        if matched {
            out = out.concat(replacement.clone())
            i = i + tlen
        } else {
            out = out.concat(target.clone().slice(i, i + 1))
            i = i + 1
        }
    }
    out
}

fn ctx_register_mono_span_rewrite(mut ctx: LowerCtx, span_start: i32, source: String, target: String) {
    // Associated Vec::new__T / with_capacity__T lower via wasm name fallback
    // (no MIR body). Still register the span rewrite so call sites get the
    // mangled callee for mark_vec / layout (#845).
    // Template spellings (Take__next__?I, Holder__read__?T) are not callable
    // functions either: they exist so ctx_mono_concretize_span_target can map
    // them through the enclosing instance's type-variable bindings at lookup
    // time. Dropping them here sends generic-impl sibling calls to the bare
    // template name, which is pruned and emits unreachable (#874).
    let accept = target.clone().contains(String_from("?")) ||
    ctx_fn_exists::ctx_has_fn_name(ctx, target.clone()) ||
    is_vec_ctor_mono_target(target.clone())
    if !accept {
        return
    }
    ctx_mono_rewrites::ctx_mono_push_span_rewrite(ctx, span_start, source, target)
}

fn is_vec_ctor_mono_target(target: String) -> bool {
    target.clone().starts_with(String_from("Vec::new__")) ||
    target.clone().starts_with(String_from("Vec__new__")) ||
    target.clone().starts_with(String_from("Vec::with_capacity__")) ||
    target.clone().starts_with(String_from("Vec__with_capacity__"))
}

fn mono_sources_match(candidate: String, requested: String) -> bool {
    if candidate.clone().eq(requested.clone()) {
        return true
    }
    ctx_mono_rewrites::mono_bare_source(candidate).eq(ctx_mono_rewrites::mono_bare_source(requested))
}

fn mono_target_matches_source(target: String, source: String) -> bool {
    let bare_source = ctx_mono_rewrites::mono_bare_source(source)
    let prefix = bare_source.clone().concat("__")
    if target.clone().starts_with(prefix.clone()) {
        // The owner guard exists for Type::method sources (Vec::into_iter
        // must not steal a free into_iter__X target). Module-qualified free
        // functions (seq::min_by_key) record their specialization under the
        // bare name, so a lowercase module owner has nothing to check
        // against and must not be rejected (#691).
        if !mono_source_has_module_owner(source.clone()) &&
        !mono_source_owner_matches(source.clone(), String_new()) {
            return false
        }
        let rest = target.slice(prefix.len(), target.len())
        // Reject opaque numeric stubs like eq__1; accept type keys
        // such as eq__Person / pair_first__i32__String.
        if rest.len() == 0 {
            return false
        }
        let first = rest.byte_at(0)
        if first >= 48 && first <= 57 {
            return false
        }
        return true
    }
    // Owner check: Take__into_iter__VecIter specializes Take::into_iter,
    // not Vec::into_iter. The target owner is the segment before the
    // __method__ infix; a per-instantiation source owner (Take_VecIter)
    // relaxes to its constructor base (Take).
    let infix = String_from("__").concat(bare_source.clone().concat(String_from("__")))
    let pos = target.clone().index_of(infix.clone())
    if pos < 0 {
        return false
    }
    mono_source_owner_matches(source.clone(), target.clone().slice(0, pos))
}

// A lowercase owner segment before the module separator is a module path
// (seq::, iter::), not a type owner. Bare-mangled free-function targets
// carry no owner segment, so module-qualified sources would otherwise
// always fail the owner check.
fn mono_source_has_module_owner(source: String) -> bool {
    let sep = source.clone().index_of(String_from("::"))
    if sep <= 0 {
        return false
    }
    let first = source.clone().byte_at(0)
    first >= 97 && first <= 122
}

fn mono_source_owner_matches(source: String, target_owner: String) -> bool {
    let sep = source.clone().index_of(String_from("::"))
    if sep < 0 {
        return true
    }
    let source_owner = source.clone().slice(0, sep)
    if source_owner.clone().eq(target_owner.clone()) {
        return true
    }
    target_owner.clone().eq(mono_owner_inst_base(source_owner).clone())
}

// Constructor base of a per-instantiation owner spelling
// (Take_VecIter -> Take, HashMap_i32_String -> HashMap).
fn mono_owner_inst_base(owner: String) -> String {
    let n = owner.len()
    let mut i = 0
    while i < n {
        if owner.clone().byte_at(i) == 95 {
            return owner.slice(0, i)
        }
        i = i + 1
    }
    owner
}

fn ctx_register_mono_name_rewrite(mut ctx: LowerCtx, source: String, target: String) {
    // Template instantiations (?Var args) are not callable
    // specializations; they exist so span rewrites can pin the template
    // spelling for per-enclosing-instance concretization.
    if target.clone().contains(String_from("?")) {
        return
    }
    if !ctx_fn_exists::ctx_has_fn_name(ctx, target.clone()) && !is_vec_ctor_mono_target(target.clone()) {
        return
    }
    ctx_mono_rewrites::ctx_mono_push_name_rewrite(ctx, source, target)
}

fn ctx_mono_source_rewrite_count(ctx: LowerCtx) -> i32 {
    ctx_mono_rewrites::ctx_mono_name_rewrite_count(ctx)
}

// Candidates are exactly the rewrites sharing the bare source: an exact
// source match implies a bare match, so the chain loses nothing.
fn ctx_resolve_unused_mono_by_name(mut ctx: LowerCtx, source: String) -> String {
    // A callee that exists as a real function (concrete impl method such as
    // Vec::into_iter) must not be stolen by a pooled specialization of a
    // different owner's same-named method (Take::into_iter__VecIter).
    if ctx_fn_exists::ctx_has_fn_name(ctx, source.clone()) {
        return String_new()
    }
    let mut i = ctx_mono_rewrites::ctx_mono_name_rewrite_first_for_source(ctx, source.clone())
    while i >= 0 {
        if ctx_mono_rewrites::ctx_mono_name_rewrite_used_at(ctx, i) == 0 &&
        mono_target_matches_source(ctx_mono_rewrites::ctx_mono_name_rewrite_target_at(ctx, i), source.clone()) {
            ctx_mono_rewrites::ctx_mono_mark_name_rewrite_used(ctx, i)
            return ctx_mono_rewrites::ctx_mono_name_rewrite_target_at(ctx, i)
        }
        i = ctx_mono_rewrites::ctx_mono_name_rewrite_next_same_source(ctx, i)
    }
    ""
}

fn ctx_mono_lookup_name_rewrite(ctx: LowerCtx, source: String) -> String {
    if ctx_fn_exists::ctx_has_fn_name(ctx, source.clone()) {
        return String_new()
    }
    let mut i = ctx_mono_rewrites::ctx_mono_name_rewrite_first_for_source(ctx, source.clone())
    while i >= 0 {
        if mono_target_matches_source(ctx_mono_rewrites::ctx_mono_name_rewrite_target_at(ctx, i), source.clone()) {
            return ctx_mono_rewrites::ctx_mono_name_rewrite_target_at(ctx, i)
        }
        i = ctx_mono_rewrites::ctx_mono_name_rewrite_next_same_source(ctx, i)
    }
    ""
}
