use std::text
use corehir::mod
use mir::lower::decl_source
use mir::lower::edge_discovery
use mir::lower::ctx_corehir_probe
use mir::lower::entry_body_source
use mir::lower::entry_fns
use mir::lower::entry_methods
use mir::lower::entry_timing
use mir::lower::entry_view_fn
use mir::lower::ctx_fn_index
use mir::lower::fn_index
fn mir_emit_view_decls(
    mut ctx: LowerCtx,
    view: CoreHirMirView,
    mut body_source: MirLowerEntryBodySource,
    fn_index_info: MirLowerFnIndex,
    midx: MonoIndex,
    mir_tr: i32,
    prune_enabled: bool,
    emit_keep: NameIndex,
    timing: i32
) -> i32 {
    let decl_source = decl_source::mir_decl_source_from_view(view)
    let decl_count = decl_source::mir_decl_source_count(decl_source)
    let entry_main_decl_index = fn_index::mir_fn_index_entry_main_decl_index(fn_index_info)
    let entry_view = entry_body_source::mir_entry_body_source_view(body_source)
    let mut wall_ms: Vec<i32> = Vec::new<i32>()
    let mut wall_name: Vec<String> = Vec::new<String>()
    let mut i = 0
    let mut fn_idx = 0
    let mut keep_n = 0
    let mut skip_n = 0
    while i < decl_count {
        let decl_name = decl_source::mir_decl_source_name_at(decl_source, i)
        if decl_source::mir_decl_source_is_fn_at(decl_source, i) {
            // #851 Phase 3 worklist skip: a fn decl emits no body when every
            // emit name it could produce is outside the AST-edge reachable
            // set. Decl-level bookkeeping (fn_idx) still advances.
            let mut emit_bodies = true
            if prune_enabled && ctx_corehir_probe::mir_probe_skip_enabled() != 0 {
                let fn_info_index = entry_view_fn::mir_entry_fn_info_index_for_decl(entry_view, i)
                let mut typed_index = 0 - 1
                if fn_info_index >= 0 {
                    typed_index = entry_view_fn::mir_entry_fn_typed_index_at(entry_view, fn_info_index, typed_index)
                }
                emit_bodies = edge_discovery::mir_ast_edge_emit_names_needed(
                    edge_discovery::edge_emit_names_for_fn_decl(
                        entry_view,
                        i,
                        clone(decl_name),
                        fn_info_index,
                        typed_index,
                        midx
                    ),
                    emit_keep
                )
            }
            // A const reference lowers to a call of the decl's zero-argument
            // body, and a value path such as `i32::MAX` is not an AST call edge,
            // so the stdlib edge prune would drop the callee and the emitted
            // call would trap (#970).
            if ctx_fn_index::ctx_is_const_name(ctx, clone(decl_name)) {
                emit_bodies = true
            }
            if emit_bodies {
                keep_n = keep_n + 1
            } else {
                skip_n = skip_n + 1
            }
            let wall_key = clone(decl_name)
            let wall_t = entry_timing::mir_lower_phase_now()
            fn_idx = entry_fns::mir_emit_top_level_fn_decl(
                ctx,
                body_source,
                i,
                decl_name,
                fn_idx,
                entry_main_decl_index,
                midx,
                mir_tr,
                emit_bodies
            )
            entry_timing::mir_lower_wall_record(timing, wall_ms, wall_name, wall_t, wall_key)
        }
        if decl_source::mir_decl_source_is_impl_at(decl_source, i) {
            let struct_name = signature_method::mir_signature_method_owner_name_for_impl(mod::view_signature_source(view), i, decl_name)
            let wall_key = "impl ".concat(clone(struct_name))
            let wall_t = entry_timing::mir_lower_phase_now()
            skip_n = skip_n + entry_methods::mir_emit_impl_methods(ctx, body_source, i, struct_name, midx, emit_keep, prune_enabled && ctx_corehir_probe::mir_probe_skip_enabled() != 0)
            entry_timing::mir_lower_wall_record(timing, wall_ms, wall_name, wall_t, wall_key)
        }
        i = i + 1
    }
    entry_timing::mir_lower_top_walls_note(timing, wall_ms, wall_name)
    entry_timing::mir_lower_prefilter_note(timing, keep_n, skip_n)
    skip_n
}
