use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_types
use mir::lower::ctx_match_result_state
use mir::lower::ctx_types
use mir::inst_factory
use mir::inst_local_set
use mir::opcodes
use mir::value_types

fn core_record_match_terminating_arm(ctx: LowerCtx, result: i32) {
    let current_state = ctx_match_result_state::ctx_match_result_state_get(ctx, result)
    if current_state == ctx_match_result_state::ctx_match_result_state_none() {
        ctx_match_result_state::ctx_match_result_state_set(
            ctx,
            result,
            ctx_match_result_state::ctx_match_result_state_all_terminating()
        )
        return
    }
    if current_state == ctx_match_result_state::ctx_match_result_state_all_terminating() {
        ctx_match_result_state::ctx_match_result_state_set(
            ctx,
            result,
            ctx_match_result_state::ctx_match_result_state_all_terminating()
        )
    }
}

fn core_record_match_nonterminating_arm(ctx: LowerCtx, result: i32) {
    let current_state = ctx_match_result_state::ctx_match_result_state_get(ctx, result)
    if current_state == ctx_match_result_state::ctx_match_result_state_none() ||
    current_state == ctx_match_result_state::ctx_match_result_state_all_terminating() {
        ctx_match_result_state::ctx_match_result_state_set(
            ctx,
            result,
            ctx_match_result_state::ctx_match_result_state_has_nonterminating_arm()
        )
    }
}

fn core_store_match_arm_result(ctx: LowerCtx, result: i32, arm_result: i32) {
    if arm_result < 0 {
        if ctx_api_emit::ctx_current_block_ends_with_control_return(ctx) {
            core_record_match_terminating_arm(ctx, result)
        } else {
            core_record_match_nonterminating_arm(ctx, result)
        }
        return
    }
    let arm_vt = ctx_api_local_types::ctx_local_vt(ctx, arm_result)
    if arm_vt == value_types::VT_I64() || arm_vt == value_types::VT_F64() ||
    arm_vt == value_types::VT_REF() || arm_vt == value_types::VT_GC_REF() {
        ctx_api_local_types::ctx_set_local_vt(ctx, result, arm_vt)
    }
    let arm_type = ctx_api_local_types::ctx_get_local_type(ctx, arm_result)
    if len(arm_type) > 0 {
        ctx_api_local_types::ctx_set_local_type(ctx, result, arm_type)
    }
    ctx_match_result_state::ctx_match_result_state_set(
        ctx,
        result,
        ctx_match_result_state::ctx_match_result_state_has_value()
    )
    ctx_api_emit::ctx_emit(ctx, inst_local_set::MirInst_local_set_from(result, arm_result))
}

fn core_emit_match_result_get(ctx: LowerCtx, result: i32) -> i32 {
    let state = ctx_match_result_state::ctx_match_result_state_get(ctx, result)
    if state == ctx_match_result_state::ctx_match_result_state_all_terminating() {
        ctx_api_emit::ctx_emit(ctx, inst_factory::MirInst_new(opcodes::MIR_UNREACHABLE()))
        return 0 - 1
    }
    // Arm results are already stored into `result` via local_set.
    // Do not leave a local_get on the stack (see match_result.ark / #726).
    result
}
