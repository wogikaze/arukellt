use std::prelude::{clone, eq}
use mir::value_types
fn mir_is_string_type_name(type_name: String) -> bool {
    eq(clone(type_name), "String") || eq(clone(type_name), "string")
}

fn mir_is_primitive_operator_type(type_name: String) -> bool {
    if len(type_name) == 0 {
        return true
    }
    if eq(clone(type_name), "i32") || eq(clone(type_name), "i64") || eq(clone(type_name), "f64") {
        return true
    }
    if eq(clone(type_name), "bool") || eq(clone(type_name), "char") {
        return true
    }
    if mir_is_string_type_name(clone(type_name)) {
        return true
    }
    if clone(type_name).starts_with("vec:") || clone(type_name).starts_with("option:") {
        return true
    }
    false
}

fn mir_is_builtin_type_name(name: String) -> bool {
    if eq(clone(name), "i32") { return true }
    if eq(clone(name), "i64") { return true }
    if eq(clone(name), "f64") { return true }
    if eq(clone(name), "f32") { return true }
    if eq(clone(name), "bool") { return true }
    if eq(clone(name), "String") { return true }
    if eq(clone(name), "string") { return true }
    if eq(clone(name), "char") { return true }
    if eq(clone(name), "u8") { return true }
    if eq(clone(name), "u16") { return true }
    if eq(clone(name), "u32") { return true }
    if eq(clone(name), "u64") { return true }
    if eq(clone(name), "i8") { return true }
    if eq(clone(name), "i16") { return true }
    if eq(clone(name), "Vec") { return true }
    if eq(clone(name), "fnref") { return true }
    if eq(clone(name), "fnref2") { return true }
    if clone(name).starts_with("vec:") { return true }
    if clone(name).starts_with("hashmap:") { return true }
    if eq(clone(name), "enum") { return true }
    if clone(name).starts_with("enum:") { return true }
    false
}

fn mir_binop_dest_type_name(dest_vt: i32, is_cmp: bool) -> String {
    if is_cmp {
        return "bool"
    }
    if dest_vt == value_types::VT_F64() {
        return "f64"
    }
    if dest_vt == value_types::VT_F32() {
        return String_from("f32")
    }
    if dest_vt == value_types::VT_I64() {
        return "i64"
    }
    if dest_vt == value_types::VT_GC_REF() || dest_vt == value_types::VT_REF() {
        return "string"
    }
    "i32"
}
