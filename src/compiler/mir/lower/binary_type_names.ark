use mir::opcodes
use mir::value_types
fn mir_is_string_type_name(type_name: String) -> bool {
    type_name.clone().eq("String") || type_name.clone().eq("string")
}

// String addition is an ordinary `Add::add` call now. The intrinsic MIR_ADD
// fast path must not intercept it: that path concatenates on wasm32-gc but
// performs pointer arithmetic on wasm32-linear. Equality stays intrinsic
// because it compares contents directly.
fn mir_is_string_add_operator(type_name: String, mir_op: i32) -> bool {
    mir_is_string_type_name(type_name.clone()) && mir_op == opcodes::MIR_ADD()
}

// String locals carry the lowercase "string" spelling, while impl methods
// register under the canonical owner "String::". Operator lowering builds the
// callee name from the local type, so normalize the owner before the lookup;
// otherwise the `String::add` candidate is missed and MIR_ADD falls back to
// backend-specific ref arithmetic.
fn mir_operator_owner_type_name(type_name: String) -> String {
    if mir_is_string_type_name(type_name.clone()) {
        return String_from("String")
    }
    type_name
}

fn mir_is_primitive_operator_type(type_name: String) -> bool {
    if type_name.len() == 0 {
        return true
    }
    if type_name.clone().eq("i32") || type_name.clone().eq("i64") || type_name.clone().eq("f64") {
        return true
    }
    if type_name.clone().eq("bool") || type_name.clone().eq("char") {
        return true
    }
    if mir_is_string_type_name(type_name.clone()) {
        return true
    }
    if type_name.clone().starts_with("vec:") || type_name.clone().starts_with("option:") {
        return true
    }
    false
}

fn mir_is_builtin_type_name(name: String) -> bool {
    if name.clone().eq("i32") { return true }
    if name.clone().eq("i64") { return true }
    if name.clone().eq("f64") { return true }
    if name.clone().eq("f32") { return true }
    if name.clone().eq("bool") { return true }
    if name.clone().eq("String") { return true }
    if name.clone().eq("string") { return true }
    if name.clone().eq("char") { return true }
    if name.clone().eq("u8") { return true }
    if name.clone().eq("u16") { return true }
    if name.clone().eq("u32") { return true }
    if name.clone().eq("u64") { return true }
    if name.clone().eq("i8") { return true }
    if name.clone().eq("i16") { return true }
    if name.clone().eq("Vec") { return true }
    if name.clone().eq("fnref") { return true }
    if name.clone().eq("fnref2") { return true }
    if name.clone().starts_with("vec:") { return true }
    if name.clone().starts_with("hashmap:") { return true }
    if name.clone().eq("enum") { return true }
    if name.clone().starts_with("enum:") { return true }
    false
}

fn mir_binop_dest_type_name(dest_vt: i32, is_cmp: bool) -> String {
    if is_cmp {
        return "bool"
    }
    if dest_vt == value_types::VT_F64() {
        return "f64"
    }
    if dest_vt == value_types::VT_F32() {
        return String_from("f32")
    }
    if dest_vt == value_types::VT_I64() {
        return "i64"
    }
    if dest_vt == value_types::VT_GC_REF() || dest_vt == value_types::VT_REF() {
        return "string"
    }
    "i32"
}
