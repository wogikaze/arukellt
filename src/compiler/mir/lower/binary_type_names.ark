use std::prelude::{eq}
use mir::value_types
fn mir_is_string_type_name(type_name: String) -> bool {
    eq(type_name.clone(), "String") || eq(type_name.clone(), "string")
}

fn mir_is_primitive_operator_type(type_name: String) -> bool {
    if len(type_name) == 0 {
        return true
    }
    if eq(type_name.clone(), "i32") || eq(type_name.clone(), "i64") || eq(type_name.clone(), "f64") {
        return true
    }
    if eq(type_name.clone(), "bool") || eq(type_name.clone(), "char") {
        return true
    }
    if mir_is_string_type_name(type_name.clone()) {
        return true
    }
    if type_name.clone().starts_with("vec:") || type_name.clone().starts_with("option:") {
        return true
    }
    false
}

fn mir_is_builtin_type_name(name: String) -> bool {
    if eq(name.clone(), "i32") { return true }
    if eq(name.clone(), "i64") { return true }
    if eq(name.clone(), "f64") { return true }
    if eq(name.clone(), "f32") { return true }
    if eq(name.clone(), "bool") { return true }
    if eq(name.clone(), "String") { return true }
    if eq(name.clone(), "string") { return true }
    if eq(name.clone(), "char") { return true }
    if eq(name.clone(), "u8") { return true }
    if eq(name.clone(), "u16") { return true }
    if eq(name.clone(), "u32") { return true }
    if eq(name.clone(), "u64") { return true }
    if eq(name.clone(), "i8") { return true }
    if eq(name.clone(), "i16") { return true }
    if eq(name.clone(), "Vec") { return true }
    if eq(name.clone(), "fnref") { return true }
    if eq(name.clone(), "fnref2") { return true }
    if name.clone().starts_with("vec:") { return true }
    if name.clone().starts_with("hashmap:") { return true }
    if eq(name.clone(), "enum") { return true }
    if name.clone().starts_with("enum:") { return true }
    false
}

fn mir_binop_dest_type_name(dest_vt: i32, is_cmp: bool) -> String {
    if is_cmp {
        return "bool"
    }
    if dest_vt == value_types::VT_F64() {
        return "f64"
    }
    if dest_vt == value_types::VT_F32() {
        return String_from("f32")
    }
    if dest_vt == value_types::VT_I64() {
        return "i64"
    }
    if dest_vt == value_types::VT_GC_REF() || dest_vt == value_types::VT_REF() {
        return "string"
    }
    "i32"
}
