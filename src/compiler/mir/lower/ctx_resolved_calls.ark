use collections::name_index
use corehir::raw_dto
use mir::lower::ctx_types

// Register the checker's per-call resolution table on the lowering ctx (#933).
// The key carries the source body identity as well as the span, so a call in a
// loaded module never aliases a same-offset call in another file.
fn ctx_register_resolved_calls(mut ctx: LowerCtx, calls: Vec<CoreHirResolvedCall>) {
    let count = calls.len()
    ctx.resolved_call_index = name_index::NameIndex_new(count)
    ctx.resolved_call_owners = Vec::new<String>()
    ctx.resolved_call_function_ids = Vec::new<String>()
    ctx.resolved_call_mono_ids = Vec::new<String>()
    ctx.resolved_call_callee_decls = Vec::new<i32>()
    let mut i = 0
    while i < count {
        let call = calls.get_unchecked(i)
        let key = resolved_call_key(
            raw_dto::CoreHirResolvedCall_decl_index(call.clone()),
            raw_dto::CoreHirResolvedCall_body_child_index(call.clone()),
            raw_dto::CoreHirResolvedCall_span_start(call.clone()),
            raw_dto::CoreHirResolvedCall_callee_name(call.clone())
        )
        if name_index::name_index_get(ctx.resolved_call_index, key.clone()) < 0 {
            name_index::name_index_set(ctx.resolved_call_index, key, ctx.resolved_call_owners.len())
            ctx.resolved_call_owners.push(raw_dto::CoreHirResolvedCall_owner_name(call.clone()))
            ctx.resolved_call_function_ids.push(raw_dto::CoreHirResolvedCall_function_id(call.clone()))
            ctx.resolved_call_mono_ids.push(raw_dto::CoreHirResolvedCall_mono_instance_id(call.clone()))
            ctx.resolved_call_callee_decls.push(raw_dto::CoreHirResolvedCall_callee_decl_index(call))
        }
        i = i + 1
    }
}

// Install the decl-index -> registry FunctionId map built with the signature
// spine. It is indexed by the declaration identity the checker records, not
// by a mangled name, so a shared bare name cannot redirect the call (#934).
fn ctx_set_decl_function_ids(mut ctx: LowerCtx, decl_function_ids: Vec<i32>) {
    ctx.decl_function_ids = decl_function_ids
}

// Registry FunctionId of a top-level declaration, or -1 when it has no
// registry entry (skipped shadow decl, out-of-range index).
fn ctx_decl_function_id(ctx: LowerCtx, decl_index: i32) -> i32 {
    if decl_index < 0 || decl_index >= ctx.decl_function_ids.len() {
        return 0 - 1
    }
    ctx.decl_function_ids.get_unchecked(decl_index)
}

fn ctx_set_body_identity(mut ctx: LowerCtx, decl_index: i32, child_index: i32) {
    ctx.current_body_decl_index = decl_index
    ctx.current_body_child_index = child_index
}

// Slot of the checker resolution for this call site, or -1 when the site has
// no resolution.
fn ctx_resolved_call_slot(ctx: LowerCtx, span_start: i32, callee_name: String) -> i32 {
    if ctx.current_body_decl_index < 0 {
        return 0 - 1
    }
    let key = resolved_call_key(
        ctx.current_body_decl_index,
        ctx.current_body_child_index,
        span_start,
        callee_name
    )
    let index = name_index::name_index_get(ctx.resolved_call_index, key)
    if index < 0 || index >= ctx.resolved_call_owners.len() {
        return 0 - 1
    }
    index
}

// Owner recorded by the checker for this call site, or "" when the site has
// no resolution. Callers must treat "" as "not a resolved prelude callable"
// and keep the original callee instead of guessing an owner.
fn ctx_resolved_call_owner(ctx: LowerCtx, span_start: i32, callee_name: String) -> String {
    let index = ctx_resolved_call_slot(ctx, span_start, callee_name)
    if index < 0 {
        return String_new()
    }
    ctx.resolved_call_owners.get_unchecked(index).clone()
}

// Declaration identity the checker selected for this call site, or "" when the
// site has no resolution. Lowering binds this FunctionId instead of
// re-resolving the callee name (#934 / #936).
fn ctx_resolved_call_function_id(ctx: LowerCtx, span_start: i32, callee_name: String) -> String {
    let index = ctx_resolved_call_slot(ctx, span_start, callee_name)
    if index < 0 {
        return String_new()
    }
    ctx.resolved_call_function_ids.get_unchecked(index).clone()
}

// Mono instance the checker minted for this generic call site, or "" for a
// non-generic call.
fn ctx_resolved_call_mono_instance_id(ctx: LowerCtx, span_start: i32, callee_name: String) -> String {
    let index = ctx_resolved_call_slot(ctx, span_start, callee_name)
    if index < 0 {
        return String_new()
    }
    ctx.resolved_call_mono_ids.get_unchecked(index).clone()
}

// Declaration index the checker selected for this call site, or -1 when the
// callable has no top-level declaration (method, intrinsic, WIT import).
fn ctx_resolved_call_callee_decl_index(ctx: LowerCtx, span_start: i32, callee_name: String) -> i32 {
    let index = ctx_resolved_call_slot(ctx, span_start, callee_name)
    if index < 0 {
        return 0 - 1
    }
    ctx.resolved_call_callee_decls.get_unchecked(index)
}

// Registry FunctionId of the declaration this call site resolved to, or -1
// when lowering must resolve the callee another way. A generic call targets
// its minted mono instance, whose FunctionId is registered under the instance
// spelling, so the declaration entry is deliberately not used there.
fn ctx_resolved_call_decl_fid(ctx: LowerCtx, span_start: i32, callee_name: String) -> i32 {
    if ctx_resolved_call_mono_instance_id(ctx, span_start, callee_name.clone()).len() > 0 {
        return 0 - 1
    }
    let decl_index = ctx_resolved_call_callee_decl_index(ctx, span_start, callee_name)
    ctx_decl_function_id(ctx, decl_index)
}

fn resolved_call_key(decl_index: i32, child_index: i32, span_start: i32, callee_name: String) -> String {
    String_from("b").concat(
        decl_index.to_string().concat(
            String_from(":").concat(
                child_index.to_string().concat(
                    String_from(":").concat(
                        span_start.to_string().concat(String_from(":").concat(callee_name))
                    )
                )
            )
        )
    )
}
