use std::prelude::{clone, eq}
use mir::lower::ast_node
use mir::lower::ctx_api_local_types
use mir::lower::ctx_fn_return_type
use mir::lower::ctx_fn_return_vt
use mir::lower_kinds
use mir::lower::ctx_types
use mir::value_types
fn mir_print_arg_is_string_type(lt: String) -> bool {
    eq(clone(lt), "String") || eq(clone(lt), "str") || eq(clone(lt), "string")
}

fn mir_print_arg_needs_string_conversion(ctx: LowerCtx, arg: AstNode, arg_idx: i32) -> bool {
    // The lowered argument local is the value that will actually be printed, so
    // its type decides before any callee-name lookup. The lowerer's function
    // index is keyed by bare name and keeps the first writer: once the loader
    // pulls an imported module in for a member import, a concrete declaration
    // sharing the name of a local generic (`std::core::identity(i32)` vs
    // `fn identity<T>`) wins that slot, and `println(identity(s))` was formatted
    // as an integer even though the call returns a String (#914).
    if arg_idx >= 0 {
        let arg_vt = ctx_api_local_types::ctx_local_vt(ctx, arg_idx)
        if arg_vt == value_types::VT_GC_REF() || arg_vt == value_types::VT_REF() {
            return false
        }
        let lt = ctx_api_local_types::ctx_get_local_type(ctx, arg_idx)
        if mir_print_arg_is_string_type(lt) {
            return false
        }
        if arg_vt == value_types::VT_I32() || arg_vt == value_types::VT_I64() || arg_vt == value_types::VT_F64() {
            return true
        }
    }
    if ast_node::node_kind_is(arg, lower_kinds::NK_CALL()) && ast_node::node_child_count(arg) > 0 {
        let callee = ast_node::node_child_at(arg, 0)
        let cn = ast_node::node_text(callee)
        let rtn = ctx_fn_return_type::ctx_fn_return_type_name(ctx, cn)
        if mir_print_arg_is_string_type(rtn) {
            return false
        }
        if ctx_fn_return_vt::ctx_fn_return_vt(ctx, cn) == value_types::VT_GC_REF() || ctx_fn_return_vt::ctx_fn_return_vt(ctx, cn) == value_types::VT_REF() {
            return false
        }
        if len(rtn) > 0 {
            if ctx_fn_return_vt::ctx_fn_return_vt(ctx, cn) == value_types::VT_I32() ||
            ctx_fn_return_vt::ctx_fn_return_vt(ctx, cn) == value_types::VT_I64() ||
            ctx_fn_return_vt::ctx_fn_return_vt(ctx, cn) == value_types::VT_F64() {
                return true
            }
        }
    }
    let mut needs_convert = ast_node::node_kind_is(arg, lower_kinds::NK_INT_LIT()) ||
    ast_node::node_kind_is(arg, lower_kinds::NK_BOOL_LIT()) ||
    ast_node::node_kind_is(arg, lower_kinds::NK_CHAR_LIT()) ||
    ast_node::node_kind_is(arg, lower_kinds::NK_FLOAT_LIT()) ||
    ast_node::node_kind_is(arg, lower_kinds::NK_UNARY())
    if !needs_convert {
        let lt = ctx_api_local_types::ctx_get_local_type(ctx, arg_idx)
        if mir_print_arg_local_type_needs_string_conversion(lt) {
            needs_convert = true
        }
    }
    if !needs_convert && ast_node::node_kind_is(arg, lower_kinds::NK_CALL()) && ast_node::node_child_count(arg) > 0 {
        needs_convert = mir_print_call_result_needs_string_conversion(ctx, arg, arg_idx)
    }
    needs_convert
}

fn mir_print_arg_local_type_needs_string_conversion(lt: String) -> bool {
    eq(clone(lt), "char") ||
    eq(clone(lt), "u8") ||
    eq(clone(lt), "u16") ||
    eq(clone(lt), "u32") ||
    eq(clone(lt), "u64") ||
    eq(clone(lt), "i16") ||
    eq(clone(lt), "i32") ||
    eq(clone(lt), "i64") ||
    eq(clone(lt), "bool") ||
    eq(clone(lt), "f64")
}

fn mir_print_call_result_needs_string_conversion(ctx: LowerCtx, arg: AstNode, arg_idx: i32) -> bool {
    let call_callee = ast_node::node_child_at(arg, 0)
    let cn = ast_node::node_text(call_callee)
    if eq(clone(cn), "contains_i32") ||
    eq(clone(cn), "contains_string") ||
    eq(clone(cn), "contains_String") ||
    eq(clone(cn), "contains") ||
    eq(clone(cn), "is_empty") ||
    eq(clone(cn), "is_some") ||
    eq(clone(cn), "is_none") ||
    eq(clone(cn), "starts_with") ||
    eq(clone(cn), "ends_with") {
        ctx_api_local_types::ctx_set_local_type(ctx, arg_idx, "bool")
        return true
    }
    if eq(clone(cn), "len") ||
    eq(clone(cn), "parse_i32") ||
    eq(clone(cn), "abs") ||
    eq(clone(cn), "min") ||
    eq(clone(cn), "max") ||
    eq(clone(cn), "sum_i32") ||
    eq(clone(cn), "product_i32") ||
    eq(clone(cn), "index_of") ||
    eq(clone(cn), "clamp_i32") ||
    eq(clone(cn), "get_unchecked") ||
    eq(clone(cn), "vec_get_unchecked_i32") ||
    eq(clone(cn), "bytes_get") ||
    eq(clone(cn), "bytes_len") {
        ctx_api_local_types::ctx_set_local_type(ctx, arg_idx, "i32")
        return true
    }
    false
}
