use mir::types
use mir::source_location_record
use collections::name_index
use mir::emit_spec
use mir::post_pass_callee_cache
use wasm::ctx_record

pub struct LowerCtx {
    module: MirModule,
    func: MirFunction,
    cur_block: i32,
    local_names: Vec<String>,
    local_indices: Vec<i32>,
    // Open-addressed local name → index. Last push wins (same as scan-from-end).
    // Vec fields on LowerCtx so probe does not copy a NameIndex.
    local_name_buckets: Vec<i32>,
    fn_names: Vec<String>,
    fn_name_lengths: Vec<i32>,
    fn_name_index: NameIndex,
    fn_indices: Vec<i32>,
    fn_return_vts: Vec<i32>,
    fn_return_type_names: Vec<String>,
    // Constants are lowered as zero-argument MIR functions. Keep their names
    // separate so identifier expressions do not become function references.
    const_names: Vec<String>,
    qualified_fn_names: Vec<String>,
    qualified_fn_name_index: NameIndex,
    qualified_fn_return_vts: Vec<i32>,
    qualified_fn_return_type_names: Vec<String>,
    loop_exit_block: i32,
    loop_cond_block: i32,
    nesting_depth: i32,
    loop_break_depth: i32,
    loop_continue_depth: i32,
    loop_break_local: i32,
    struct_names: Vec<String>,
    struct_field_counts: Vec<i32>,
    struct_all_fields: Vec<String>,
    struct_field_types: Vec<String>,
    // Generic struct decl name -> comma-joined declared type parameter
    // names (Pair -> "T"; HashMap-like user structs -> "K,V"). Registered
    // from CoreHirLayoutDecl.type_params; used to derive monomorphized
    // layouts such as Pair<String> on demand.
    generic_struct_names: Vec<String>,
    generic_struct_params: Vec<String>,
    // Generic enum decl name -> comma-joined declared type parameter names
    // (Box -> "T"). Match payload lowering instantiates the declared payload
    // field types with the scrutinee's arguments (Box<i32> -> Owned(i32)).
    generic_enum_names: Vec<String>,
    generic_enum_params: Vec<String>,
    // Pending let-annotation instantiation (Pair<String>) consulted by
    // struct literal lowering so the literal picks the annotation's
    // monomorphized layout over field-value inference. Set/restored
    // around initializer lowering.
    expected_struct_inst: String,
    // struct_names[i] -> i for the first layout with that name, and the
    // field offset (prefix sum of struct_field_counts) of every layout.
    struct_layout_first_index: NameIndex,
    // struct_names[i] -> i for the first layout that is not an enum base.
    // ctx_struct_layout_struct_index used to scan the whole registry per
    // struct-context lookup; a layout is recorded here when its fields finish
    // registering (zero-field layouts at registration), so lookups are O(1).
    struct_layout_struct_index: NameIndex,
    struct_layout_field_offsets: Vec<i32>,
    // type_name -> resolved layout name memo (ctx_struct_layout); reset on
    // every ctx_struct_push_layout because registration can change the answer.
    struct_layout_name_memo: NameIndex,
    struct_layout_name_memo_values: Vec<String>,
    local_types: Vec<String>,
    local_type_indices: Vec<i32>,
    match_result_indices: Vec<i32>,
    match_result_states: Vec<i32>,
    variant_names: Vec<String>,
    variant_tags: Vec<i32>,
    // name -> first variant index; Enum::Variant key -> longest registered name's index.
    variant_name_first: NameIndex,
    variant_key_best: NameIndex,
    payload_variants: Vec<String>,
    closure_counter: i32,
    closure_last_synth: String,
    closure_last_caps: String,
    closure_last_extra: i32,
    closure_last_identity: bool,
    // Env record local of the last bound closure, or -1 when the synth has
    // no env cell. A direct name(...) call passes it as the trailing __env
    // argument so cell reads/flushes observe the pair's env (#874).
    closure_last_env: i32,
    closure_bind_names: Vec<String>,
    closure_bind_synth: Vec<String>,
    closure_bind_caps: Vec<String>,
    closure_bind_extra: Vec<i32>,
    closure_bind_identity: Vec<bool>,
    closure_bind_env: Vec<i32>,
    // Owning function name per bind row: a direct-call bind only resolves
    // inside the frame whose supply locals it names, so lookups from a
    // different function must not match (stale binds produced underfunded
    // direct calls when a let-bound closure escaped through a return).
    closure_bind_fns: Vec<String>,
    // Named functions already lifted to __fnthunk_<name> pair shims.
    closure_thunk_names: Vec<String>,
    // Forward-referenced names whose __fnthunk_ shim could not be emitted
    // yet because their MirFunction body had not been pushed. Drained by
    // closure_flush_pending_fn_thunks before reachability runs.
    pending_fn_thunks: Vec<String>,
    // Env-cell captures: a move closure that rebinds a captured name owns a
    // mutable slot in its __env record: the synth gains a trailing __env
    // param, each cell local is loaded from its field at entry, and every
    // return flushes the local back so writes persist across indirect
    // calls. Entries are scoped by owning function name because local
    // indices are per-function (#874, ADR-061).
    cell_fn_names: Vec<String>,
    cell_local_indices: Vec<i32>,
    cell_env_locals: Vec<i32>,
    cell_env_names: Vec<String>,
    cell_offsets: Vec<i32>,
    cell_field_indices: Vec<i32>,
    cell_totals: Vec<i32>,
    cell_vts: Vec<i32>,
    // Borrow-rebind write-back pairs: after a direct call to a non-move
    // closure that rebinds a capture, each rebound source local is
    // refreshed from its env field so later reads of the source observe
    // the mutation (mutable-borrow write-through, #874, ADR-061). Entries
    // are keyed by synth name; source/env local indices belong to the
    // enclosing function, which is the only frame that can reach the
    // non-escaping borrow closure's call sites.
    wb_synths: Vec<String>,
    wb_src_lis: Vec<i32>,
    wb_env_lis: Vec<i32>,
    wb_env_names: Vec<String>,
    wb_offsets: Vec<i32>,
    wb_field_indices: Vec<i32>,
    wb_totals: Vec<i32>,
    wb_vts: Vec<i32>,
    // Promoted borrow-capture cells (#891): a non-move closure that
    // rebinds a capture promotes the source place into a shared heap cell
    // so the managed env can carry a live alias and the closure may
    // escape. The captured name keeps a payload-typed local binding and a
    // hidden cell-ref local holds the __cell_N ref; ctx_emit rewrites
    // every value read/write on the payload local to a field-0 access.
    // Entries key on (owning function name, value local index) because
    // local indices are per-function — a nested closure body lowered
    // under a synth frame never matches the parent's cells.
    pcell_fn_names: Vec<String>,
    pcell_lis: Vec<i32>,
    pcell_cell_lis: Vec<i32>,
    pcell_cell_names: Vec<String>,
    pcell_vts: Vec<i32>,
    pcell_types: Vec<String>,
    pcell_ref_names: Vec<String>,
    // payload key (declared type name, or "vt:<n>" when untyped) -> the
    // __cell_N layout registered for it, so equal payloads share one cell
    // type. Parallel vts/types let a synth recover the payload contract
    // from the cap param's struct:__cell_N:w spelling.
    pcell_reg_keys: Vec<String>,
    pcell_reg_cells: Vec<String>,
    pcell_reg_vts: Vec<i32>,
    pcell_reg_types: Vec<String>,
    // Last materialized payload temp per (fn, value local): LOCAL_GET
    // rewrites reuse it so a following consumer sees one pushed payload
    // instead of a second deref leaving a stray stack value. Writes to the
    // cell and call-like ops (the callee may invoke the closure that owns
    // it) drop entries.
    pcell_mat_fns: Vec<String>,
    pcell_mat_lis: Vec<i32>,
    pcell_mat_tmps: Vec<i32>,
    local_type_start: i32,
    // Locals holding a HashSet<T> value. The storage type is vec:i32 or
    // the String-keyed map's hashmap:si32 bucket alias, so the marker is
    // the only way to tell `s.len()` / `s.is_empty()` apart from Vec and
    // HashMap methods during call rewriting (#917).
    hashset_locals: Vec<i32>,
    mono_call_starts: Vec<i32>,
    mono_call_span_sources: Vec<String>,
    mono_call_span_targets: Vec<String>,
    mono_call_span_used: Vec<i32>,
    // Declaring body of each span rewrite: top-level decl index plus body
    // child index in the combined loaded+entry decl list. `span_start` is a
    // byte offset inside one module's source, so matching it alone lets two
    // modules' calls alias (#934).
    mono_call_span_decls: Vec<i32>,
    mono_call_span_children: Vec<i32>,
    // Chains of rewrite indices (1-based) keyed by span_start % capacity.
    mono_span_buckets: Vec<i32>,
    mono_span_next: Vec<i32>,
    mono_call_sources: Vec<String>,
    mono_call_name_targets: Vec<String>,
    mono_call_used: Vec<i32>,
    // Declaring body of each name rewrite, same identity as the span pool.
    // The pool is keyed by bare source, so `alpha::pick` and `beta::pick`
    // share one chain; without this body check a call can consume the other
    // module's specialization of a different type (#934).
    mono_call_name_decls: Vec<i32>,
    mono_call_name_children: Vec<i32>,
    // Name rewrites sharing one bare source (`mono_bare_source`) form a
    // forward chain: head/tail indexed by bare source, next per rewrite.
    // Every CALL lowering asks "unused rewrite for this source?", which was a
    // linear scan over every rewrite with a substring per candidate.
    mono_call_bare_head: NameIndex,
    mono_call_bare_tail: NameIndex,
    mono_call_bare_next: Vec<i32>,
    wit_call_names: Vec<String>,
    wit_call_iface_ids: Vec<String>,
    wit_call_func_names: Vec<String>,
    is_gc_target: bool,
    lower_target: String,
    gc_type_base: i32,
    gc_enum_variant_names: Vec<String>,
    gc_enum_variant_sigs: Vec<String>,
    gc_enum_variant_alias_names: Vec<String>,
    gc_enum_variant_alias_slots: Vec<i32>,
    gc_struct_names: Vec<String>,
    gc_struct_sigs: Vec<String>,
    // Parallel to gc_struct_names: true while the slot holds a cycle-breaker
    // placeholder sig ("GS") awaiting ctx_set_gc_struct_sig. Post-seal
    // materialize drains only up to the first pending slot so module pushes
    // and canon ensures stay in registration order (#851 Phase 3).
    gc_struct_sig_pending: Vec<bool>,
    // Set once the ctx_prep prefix flush runs (entry.ark). GC types
    // registered while true are "late": their registration order is
    // recorded on the module so the type section can emit them after the
    // sealed types without breaking the no-forward-reference rule
    // (#851 Phase 3).
    gc_seal_done: bool,
    mono_type_param_names: Vec<String>,
    mono_type_param_types: Vec<String>,
    mono_instances: Vec<MonoInstance>,
    // Open-addressed safe-mangled → instance slot. Vec fields on LowerCtx
    // (handle); probe inlines against these fields so the table is not copied.
    mono_inst_keys: Vec<String>,
    mono_inst_vals: Vec<i32>,
    mono_inst_buckets: Vec<i32>,
    source_text: String,
    fn_source_locations: Vec<SourceLocation>,
    // Callee names that are not in fn_name_index (HashMap aliases, etc.).
    // Must not go into MirModule.string_constants — the emitter dumps those.
    edge_names: Vec<String>,
    // Incrementally-built callee cache (#851 Phase 3): seeded at ctx_prep
    // from the fn_index discovery table, extended at each function push so
    // per-fn post passes resolve both pushed and forward callees.
    prop_cache: CalleePropCache,
    // Checker-resolved calls (#933 / #934). Keyed by the lowered body's source
    // identity plus span and callee. Call rewriting reads the owner, the
    // declaration FunctionId and the mono instance here instead of
    // re-deriving them from the receiver local's type spelling or the callee
    // name. The three vectors are parallel.
    resolved_call_index: NameIndex,
    resolved_call_owners: Vec<String>,
    resolved_call_function_ids: Vec<String>,
    resolved_call_mono_ids: Vec<String>,
    resolved_call_callee_decls: Vec<i32>,
    // Top-level decl index -> registry FunctionId raw, parallel to the decl
    // list (-1 when the decl has no registry entry). Filled from the fn index
    // before bodies lower so a resolved call binds its declaration identity
    // instead of the first registry entry sharing a bare name (#934).
    decl_function_ids: Vec<i32>,
    current_body_decl_index: i32,
    // Impl-method ordinal inside the impl decl; -1 for top-level fn/const
    // bodies. Matches the checker's body identity so resolutions agree.
    current_body_child_index: i32,
    // Fused in-loop body emit (#851 Phase 3): when the driver attaches an
    // enabled MirLowerEmitSpec for a GC target, emit_ctx is the shared
    // SelfEmitCtx (its mir/functions/string handles are the live module
    // objects) and each pushed function is emitted into
    // emit_ctx.body_bytes right after its per-fn post pass.
    // emit_fn_cursor = number of module functions already emitted.
    emit_ctx: SelfEmitCtx,
    emit_spec: MirLowerEmitSpec,
    emit_in_loop: bool,
    emit_fn_cursor: i32,
}
