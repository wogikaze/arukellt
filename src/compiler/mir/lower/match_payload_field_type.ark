use std::text
use mir::function_identity
use mir::function_param_view
use mir::lower::ctx_gc_enum
use mir::lower::ctx_api_module
use mir::lower::ctx_current_storage
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_struct_mono
use mir::lower::ctx_types
use mir::module_functions
use mir::value_types
fn mir_payload_field_vt(ctx: LowerCtx, variant_name: String, field_idx: i32, scrut_ok_is_f64: bool, scrut_ok_is_i64: bool, scrut_type: String) -> i32 {
    mir_payload_field_vt_for_payload(ctx, variant_name, field_idx, scrut_ok_is_f64, scrut_ok_is_i64, String_new(), scrut_type)
}

fn mir_payload_field_vt_for_payload(
    ctx: LowerCtx,
    variant_name: String,
    field_idx: i32,
    scrut_ok_is_f64: bool,
    scrut_ok_is_i64: bool,
    payload_type_name: String,
    scrut_type: String
) -> i32 {
    let field_type = mir_variant_payload_type_name_for_scrut(
        ctx,
        variant_name.clone(),
        field_idx,
        payload_type_name,
        scrut_type.clone()
    )
    // Scrutinee-derived Option/Result payload types must win over a stale
    // first-name Option::Some(i32) layout when selecting the bind VT.
    if payload_type_name.len() > 0 && field_idx == 0 {
        if payload_type_name.clone().eq("fnref") ||
        payload_type_name.clone().eq("fn") ||
        payload_type_name.clone().starts_with("fn(") {
            return value_types::VT_FUNCREF()
        }
        if mir_payload_type_name_is_gc_ref_payload(payload_type_name.clone()) {
            return value_types::VT_GC_REF()
        }
        if payload_type_name.clone().eq("f64") || payload_type_name.clone().eq("F64") {
            return value_types::VT_F64()
        }
        if payload_type_name.clone().eq("i64") || payload_type_name.clone().eq("I64") {
            return value_types::VT_I64()
        }
        if mir_payload_scalar_type_name(payload_type_name.clone()) {
            return value_types::VT_I32()
        }
    }
    // A multi-field signature may contain a reference marker for a later
    // payload.  Decide known scalar fields from the declaration first so that
    // a recursive field does not make an earlier i32 bind look like a ref.
    if payload_type_name.len() == 0 {
        if field_type.clone().eq("f64") || field_type.clone().eq("F64") {
            return value_types::VT_F64()
        }
        if field_type.clone().eq("i64") || field_type.clone().eq("I64") {
            return value_types::VT_I64()
        }
        if mir_payload_scalar_type_name(field_type.clone()) {
            return value_types::VT_I32()
        }
    }
    if ctx_struct_field_type::ctx_struct_field_is_gc_ref(ctx, variant_name.clone(), field_idx + 1) {
        return value_types::VT_GC_REF()
    }
    if field_type.len() > 0 && !mir_payload_scalar_type_name(field_type.clone()) {
        return value_types::VT_GC_REF()
    }
    if mir_match_variant_is_err(variant_name.clone()) && field_idx == 0 {
        return value_types::VT_GC_REF()
    }
    let mut field_is_f64 = ctx_struct_field_is_f64(ctx, variant_name.clone(), field_idx + 1)
    if !field_is_f64 && scrut_ok_is_f64 && field_idx == 0 {
        if mir_match_variant_is_some_or_ok(variant_name.clone()) {
            field_is_f64 = true
        }
    }
    if field_is_f64 {
        return value_types::VT_F64()
    }
    let field_is_i64 = ctx_struct_field_is_i64(ctx, variant_name.clone(), field_idx + 1)
    if field_is_i64 {
        return value_types::VT_I64()
    }
    if scrut_ok_is_i64 && field_idx == 0 {
        if mir_match_variant_is_some_or_ok(variant_name.clone()) {
            return value_types::VT_I64()
        }
    }
    if ctx_gc_enum::ctx_is_gc_target(ctx) && mir_payload_gc_field_is_ref(ctx, variant_name.clone(), field_idx, String_new()) {
        return value_types::VT_GC_REF()
    }
    value_types::VT_I32()
}

// Declared payload field type with the owning enum's declared type
// parameters substituted from the scrutinee's instantiation. A generic
// variant payload keeps `T` in the layout registry, so `Wrap<i32>` would
// otherwise read the payload as an open GC reference: the bind VT and the
// GC variant slot would then disagree with the constructor's `i32` field.
fn mir_variant_payload_type_name_for_scrut(
    ctx: LowerCtx,
    variant_name: String,
    field_idx: i32,
    payload_type_name: String,
    scrut_type: String
) -> String {
    let declared = if payload_type_name.len() > 0 {
        ctx_struct_field_type::ctx_struct_field_type_name_for_payload(
            ctx,
            variant_name.clone(),
            field_idx + 1,
            payload_type_name
        )
    } else {
        ctx_struct_field_type::ctx_struct_field_type_name(ctx, variant_name.clone(), field_idx + 1)
    }
    let resolved = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, declared.clone())
    let source = if resolved.len() > 0 {
        resolved
    } else {
        declared
    }
    if source.len() == 0 || scrut_type.len() == 0 {
        return source
    }
    let layout_name = ctx_struct_field_type::ctx_resolve_variant_layout_name(ctx, variant_name.clone())
    let base = mir_variant_enum_base_name(layout_name.clone())
    if base.len() == 0 {
        return source
    }
    let params = ctx_struct_mono::ctx_split_declared_params(
        ctx_struct_mono::ctx_generic_enum_params(ctx, base.clone())
    )
    if params.len() == 0 {
        return source
    }
    let args = mir_scrut_type_args_for_base(scrut_type.clone(), base.clone())
    if args.len() == 0 || args.len() != params.len() {
        return source
    }
    ctx_mono_type_params::ctx_resolve_mono_type_name(
        ctx,
        ctx_struct_mono::ctx_substitute_generic_field_type(source, params, args)
    )
}

// Variant layout name `Enum::Variant` (possibly module-qualified) -> enum base.
fn mir_variant_enum_base_name(layout_name: String) -> String {
    let n = layout_name.len()
    let mut last_sep = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if layout_name.byte_at(i) == 58 && layout_name.byte_at(i + 1) == 58 {
            last_sep = i
            i = i + 2
            continue
        }
        i = i + 1
    }
    if last_sep <= 0 {
        return String_new()
    }
    layout_name.slice(0, last_sep)
}

// Type arguments of an instantiated spelling (`Wrap<i32>` / `?Wrap:i32` /
// `enum:Wrap<i32>`) when its head names base; empty on any mismatch.
fn mir_scrut_type_args_for_base(scrut_type: String, base: String) -> Vec<String> {
    let mut args = Vec::new<String>()
    let mut s = scrut_type.clone()
    if s.clone().starts_with("enum:") {
        s = s.slice(5, s.len())
    } else if s.clone().starts_with("struct:") {
        s = s.slice(7, s.len())
    }
    if s.clone().starts_with("?") {
        s = s.slice(1, s.len())
    }
    let lt = s.clone().index_of(String_from("<"))
    if lt > 0 && s.clone().ends_with(String_from(">")) {
        if !s.clone().slice(0, lt).eq(base.clone()) {
            return args
        }
        return ctx_mono_type_params::ctx_split_top_level_type_args(s.slice(lt + 1, s.len() - 1))
    }
    let prefix = base.clone().concat(String_from(":"))
    if !s.clone().starts_with(prefix.clone()) {
        return args
    }
    mir_split_colon_type_args(s.slice(prefix.len(), s.len()))
}

// Split `A:B:C` argument text on encoding colons, keeping `Module::Type`
// path separators intact.
fn mir_split_colon_type_args(inner: String) -> Vec<String> {
    let mut args = Vec::new<String>()
    let n = inner.len()
    if n == 0 {
        return args
    }
    let mut seg_start = 0
    let mut i = 0
    while i < n {
        if inner.clone().byte_at(i) == 58 {
            if i + 1 < n && inner.clone().byte_at(i + 1) == 58 {
                i = i + 2
                continue
            }
            args.push(inner.clone().slice(seg_start, i))
            seg_start = i + 1
        }
        i = i + 1
    }
    args.push(inner.clone().slice(seg_start, n))
    args
}

fn mir_payload_type_name_is_gc_ref_payload(type_name: String) -> bool {
    if type_name.clone().eq("fnref") ||
    type_name.clone().eq("fn") ||
    type_name.clone().starts_with("fn(") {
        return false
    }
    if type_name.clone().eq("String") || type_name.clone().eq("string") {
        return true
    }
    if mir_payload_scalar_type_name(type_name.clone()) {
        return false
    }
    if type_name.len() == 0 {
        return false
    }
    true
}

fn mir_variant_has_fnref_payload_field(ctx: LowerCtx, variant_name: String) -> bool {
    let count = ctx.gc_enum_variant_names.len()
    let mut i = 0
    while i < count {
        if ctx_gc_enum::ctx_gc_enum_variant_names_match(ctx.gc_enum_variant_names.get_unchecked(i).clone(), variant_name.clone()) {
            let sig = ctx.gc_enum_variant_sigs.get_unchecked(i).clone()
            if sig.clone().contains("_f1_fnref") {
                return true
            }
        }
        i = i + 1
    }
    false
}

fn mir_payload_gc_field_is_ref(ctx: LowerCtx, variant_name: String, field_idx: i32, scrut_type: String) -> bool {
    let declared_type = mir_variant_payload_type_name_for_scrut(
        ctx,
        variant_name.clone(),
        field_idx,
        String_new(),
        scrut_type.clone()
    )
    if declared_type.len() > 0 {
        if mir_payload_scalar_type_name(declared_type.clone()) ||
        declared_type.clone().eq("fnref") ||
        declared_type.clone().eq("fn") ||
        declared_type.clone().starts_with("fn(") {
            return false
        }
    }
    // Walk all same-named slots; the first Option::Some may be scalar while a
    // later registration holds the ref payload used by this match.
    // Prefer an explicit fnref payload over an earlier open-ref registration
    // so Option<fn> match binds stay typed funcrefs (#831).
    if field_idx == 0 && mir_variant_has_fnref_payload_field(ctx, variant_name.clone()) {
        return false
    }
    let count = ctx.gc_enum_variant_names.len()
    let mut i = 0
    let mut saw_name = false
    while i < count {
        if ctx_gc_enum::ctx_gc_enum_variant_names_match(ctx.gc_enum_variant_names.get_unchecked(i).clone(), variant_name.clone()) {
            saw_name = true
            let sig = ctx.gc_enum_variant_sigs.get_unchecked(i).clone()
            if field_idx == 0 {
                if sig.clone().contains("_f1_ref") || sig.clone().contains("gcsref") {
                    return true
                }
            }
        }
        i = i + 1
    }
    if saw_name {
        return false
    }
    false
}

fn mir_match_variant_is_err(variant_name: String) -> bool {
    variant_name.clone().eq("Err") || variant_name.clone().eq("Result::Err")
}

// Narrow integer ABI names. They occupy the i32 slot but keep their source
// spelling so payload binds can sign/zero-extend on print and resolve the
// narrow receiver's methods instead of collapsing to a plain i32.
fn mir_narrow_int_type_name(type_name: String) -> bool {
    type_name.clone().eq("i8") ||
    type_name.clone().eq("u8") ||
    type_name.clone().eq("i16") ||
    type_name.clone().eq("u16") ||
    type_name.clone().eq("u32")
}

fn mir_payload_scalar_type_name(type_name: String) -> bool {
    if type_name.clone().eq("i32") || type_name.clone().eq("I32") {
        return true
    }
    if type_name.clone().eq("i64") || type_name.clone().eq("I64") {
        return true
    }
    if type_name.clone().eq("u64") || type_name.clone().eq("U64") {
        return true
    }
    if type_name.clone().eq("f64") || type_name.clone().eq("F64") {
        return true
    }
    if type_name.clone().eq("bool") || type_name.clone().eq("Bool") {
        return true
    }
    if type_name.clone().eq("char") {
        return true
    }
    if mir_narrow_int_type_name(type_name.clone()) {
        return true
    }
    // Result<(), E> Ok payload is represented as i32 0 (#726 toml_insert_key).
    if type_name.clone().eq("unit") || type_name.clone().eq("()") || type_name.clone().eq("void") {
        return true
    }
    false
}

fn mir_match_variant_is_some_or_ok(variant_name: String) -> bool {
    if variant_name.clone().eq("Ok") || variant_name.clone().eq("Result::Ok") {
        return true
    }
    if variant_name.clone().eq("Some") || variant_name.clone().eq("Option::Some") {
        return true
    }
    false
}

// Report a compile diagnostic when a Some/Ok/Err payload pattern is
// matched against a scrutinee whose local type carries no payload
// segment (enum:Option / enum:Result / enum:open / untyped local).
// Multiple registrations of the same variant name can disagree on the
// payload slot type (i32, i64, f64, and ref payloads coexist on
// wasm32-gc), so without the scrutinee spelling the emitter can only
// guess from registration order; a wrong guess emits a struct.get the
// runtime value does not have — invalid core Wasm (#906). The
// diagnostic is pushed onto the module and the pipeline rejects the
// module before emit. wasm32 linear is unaffected and keeps lowering.
fn mir_report_weak_payload_scrutinee(ctx: LowerCtx, variant_name: String, payload_hint: String) {
    if payload_hint.len() > 0 {
        return
    }
    if !ctx_gc_enum::ctx_is_gc_target(ctx) {
        return
    }
    if !mir_match_variant_is_some_or_ok(variant_name.clone()) && !mir_match_variant_is_err(variant_name.clone()) {
        return
    }
    // Generic template bodies are lowered for registration only; the
    // emitted MIR comes from the monomorphized instance where the same
    // scrutinee carries option:<t> spellings. Diagnosing the template
    // would reject every program that merely imports a generic adapter
    // (e.g. TakeIter<I>::next matching self.iter.next()). The mangled
    // name keeps ? for every unsubstituted type variable, including
    // impl-side params the signature view does not expose.
    let cur_fn = ctx_current_storage::ctx_current_func_value(ctx)
    if function_param_view::MirFunction_has_unsubstituted_generic_param(cur_fn) ||
    function_identity::MirFunction_name(cur_fn).contains(String_from("?")) {
        return
    }
    let message = String_from("unsupported match on an untyped Option/Result scrutinee: cannot determine the payload type for `").concat(
        variant_name.clone().concat(
            String_from("` in body `").concat(function_identity::MirFunction_name(cur_fn).concat(String_from("` — annotate the scrutinee with a concrete type (e.g. `let x: Option<i32> = ...`)")))
        )
    )
    let mut m = ctx_api_module::ctx_current_module(ctx)
    module_functions::MirModule_record_diagnostic(m, message)
}
