use std::prelude::{clone, contains, eq, starts_with}
use std::text
use mir::function_identity
use mir::function_param_view
use mir::lower::ctx_gc_enum
use mir::lower::ctx_api_module
use mir::lower::ctx_current_storage
use mir::lower::ctx_mono_type_params
use mir::lower::ctx_struct_field_type
use mir::lower::ctx_types
use mir::module_functions
use mir::value_types
fn mir_payload_field_vt(ctx: LowerCtx, variant_name: String, field_idx: i32, scrut_ok_is_f64: bool, scrut_ok_is_i64: bool) -> i32 {
    mir_payload_field_vt_for_payload(ctx, variant_name, field_idx, scrut_ok_is_f64, scrut_ok_is_i64, String_new())
}

fn mir_payload_field_vt_for_payload(
    ctx: LowerCtx,
    variant_name: String,
    field_idx: i32,
    scrut_ok_is_f64: bool,
    scrut_ok_is_i64: bool,
    payload_type_name: String
) -> i32 {
    let declared_field_type = if len(payload_type_name) > 0 {
        ctx_struct_field_type::ctx_struct_field_type_name_for_payload(ctx, clone(variant_name), field_idx + 1, clone(payload_type_name))
    } else {
        ctx_struct_field_type::ctx_struct_field_type_name(ctx, clone(variant_name), field_idx + 1)
    }
    let field_type = ctx_mono_type_params::ctx_resolve_mono_type_name(ctx, clone(declared_field_type))
    // Scrutinee-derived Option/Result payload types must win over a stale
    // first-name Option::Some(i32) layout when selecting the bind VT.
    if len(payload_type_name) > 0 && field_idx == 0 {
        if eq(clone(payload_type_name), "fnref") ||
        eq(clone(payload_type_name), "fn") ||
        starts_with(clone(payload_type_name), "fn(") {
            return value_types::VT_FUNCREF()
        }
        if mir_payload_type_name_is_gc_ref_payload(clone(payload_type_name)) {
            return value_types::VT_GC_REF()
        }
        if eq(clone(payload_type_name), "f64") || eq(clone(payload_type_name), "F64") {
            return value_types::VT_F64()
        }
        if eq(clone(payload_type_name), "i64") || eq(clone(payload_type_name), "I64") {
            return value_types::VT_I64()
        }
        if mir_payload_scalar_type_name(clone(payload_type_name)) {
            return value_types::VT_I32()
        }
    }
    // A multi-field signature may contain a reference marker for a later
    // payload.  Decide known scalar fields from the declaration first so that
    // a recursive field does not make an earlier i32 bind look like a ref.
    if len(payload_type_name) == 0 {
        if eq(clone(field_type), "f64") || eq(clone(field_type), "F64") {
            return value_types::VT_F64()
        }
        if eq(clone(field_type), "i64") || eq(clone(field_type), "I64") {
            return value_types::VT_I64()
        }
        if mir_payload_scalar_type_name(clone(field_type)) {
            return value_types::VT_I32()
        }
    }
    if ctx_struct_field_type::ctx_struct_field_is_gc_ref(ctx, clone(variant_name), field_idx + 1) {
        return value_types::VT_GC_REF()
    }
    if len(field_type) > 0 && !mir_payload_scalar_type_name(clone(field_type)) {
        return value_types::VT_GC_REF()
    }
    if mir_match_variant_is_err(clone(variant_name)) && field_idx == 0 {
        return value_types::VT_GC_REF()
    }
    let mut field_is_f64 = ctx_struct_field_is_f64(ctx, clone(variant_name), field_idx + 1)
    if !field_is_f64 && scrut_ok_is_f64 && field_idx == 0 {
        if mir_match_variant_is_some_or_ok(clone(variant_name)) {
            field_is_f64 = true
        }
    }
    if field_is_f64 {
        return value_types::VT_F64()
    }
    let field_is_i64 = ctx_struct_field_is_i64(ctx, clone(variant_name), field_idx + 1)
    if field_is_i64 {
        return value_types::VT_I64()
    }
    if scrut_ok_is_i64 && field_idx == 0 {
        if mir_match_variant_is_some_or_ok(clone(variant_name)) {
            return value_types::VT_I64()
        }
    }
    if ctx_gc_enum::ctx_is_gc_target(ctx) && mir_payload_gc_field_is_ref(ctx, clone(variant_name), field_idx) {
        return value_types::VT_GC_REF()
    }
    value_types::VT_I32()
}

fn mir_payload_type_name_is_gc_ref_payload(type_name: String) -> bool {
    if eq(clone(type_name), "fnref") ||
    eq(clone(type_name), "fn") ||
    starts_with(clone(type_name), "fn(") {
        return false
    }
    if eq(clone(type_name), "String") || eq(clone(type_name), "string") {
        return true
    }
    if mir_payload_scalar_type_name(clone(type_name)) {
        return false
    }
    if len(type_name) == 0 {
        return false
    }
    true
}

fn mir_variant_has_fnref_payload_field(ctx: LowerCtx, variant_name: String) -> bool {
    let count = len(ctx.gc_enum_variant_names)
    let mut i = 0
    while i < count {
        if ctx_gc_enum::ctx_gc_enum_variant_names_match(clone(get_unchecked(ctx.gc_enum_variant_names, i)), clone(variant_name)) {
            let sig = clone(get_unchecked(ctx.gc_enum_variant_sigs, i))
            if contains(clone(sig), "_f1_fnref") {
                return true
            }
        }
        i = i + 1
    }
    false
}

fn mir_payload_gc_field_is_ref(ctx: LowerCtx, variant_name: String, field_idx: i32) -> bool {
    let declared_type = ctx_mono_type_params::ctx_resolve_mono_type_name(
        ctx,
        ctx_struct_field_type::ctx_struct_field_type_name(ctx, clone(variant_name), field_idx + 1)
    )
    if len(declared_type) > 0 {
        if mir_payload_scalar_type_name(clone(declared_type)) ||
        eq(clone(declared_type), "fnref") ||
        eq(clone(declared_type), "fn") ||
        starts_with(clone(declared_type), "fn(") {
            return false
        }
    }
    // Walk all same-named slots; the first Option::Some may be scalar while a
    // later registration holds the ref payload used by this match.
    // Prefer an explicit fnref payload over an earlier open-ref registration
    // so Option<fn> match binds stay typed funcrefs (#831).
    if field_idx == 0 && mir_variant_has_fnref_payload_field(ctx, clone(variant_name)) {
        return false
    }
    let count = len(ctx.gc_enum_variant_names)
    let mut i = 0
    let mut saw_name = false
    while i < count {
        if ctx_gc_enum::ctx_gc_enum_variant_names_match(clone(get_unchecked(ctx.gc_enum_variant_names, i)), clone(variant_name)) {
            saw_name = true
            let sig = clone(get_unchecked(ctx.gc_enum_variant_sigs, i))
            if field_idx == 0 {
                if contains(clone(sig), "_f1_ref") || contains(clone(sig), "gcsref") {
                    return true
                }
            }
        }
        i = i + 1
    }
    if saw_name {
        return false
    }
    false
}

fn mir_match_variant_is_err(variant_name: String) -> bool {
    eq(clone(variant_name), "Err") || eq(clone(variant_name), "Result::Err")
}

// Narrow integer ABI names. They occupy the i32 slot but keep their source
// spelling so payload binds can sign/zero-extend on print and resolve the
// narrow receiver's methods instead of collapsing to a plain i32.
fn mir_narrow_int_type_name(type_name: String) -> bool {
    eq(clone(type_name), "i8") ||
    eq(clone(type_name), "u8") ||
    eq(clone(type_name), "i16") ||
    eq(clone(type_name), "u16") ||
    eq(clone(type_name), "u32")
}

fn mir_payload_scalar_type_name(type_name: String) -> bool {
    if eq(clone(type_name), "i32") || eq(clone(type_name), "I32") {
        return true
    }
    if eq(clone(type_name), "i64") || eq(clone(type_name), "I64") {
        return true
    }
    if eq(clone(type_name), "u64") || eq(clone(type_name), "U64") {
        return true
    }
    if eq(clone(type_name), "f64") || eq(clone(type_name), "F64") {
        return true
    }
    if eq(clone(type_name), "bool") || eq(clone(type_name), "Bool") {
        return true
    }
    if eq(clone(type_name), "char") {
        return true
    }
    if mir_narrow_int_type_name(clone(type_name)) {
        return true
    }
    // Result<(), E> Ok payload is represented as i32 0 (#726 toml_insert_key).
    if eq(clone(type_name), "unit") || eq(clone(type_name), "()") || eq(clone(type_name), "void") {
        return true
    }
    false
}

fn mir_match_variant_is_some_or_ok(variant_name: String) -> bool {
    if eq(clone(variant_name), "Ok") || eq(clone(variant_name), "Result::Ok") {
        return true
    }
    if eq(clone(variant_name), "Some") || eq(clone(variant_name), "Option::Some") {
        return true
    }
    false
}

// Report a compile diagnostic when a Some/Ok/Err payload pattern is
// matched against a scrutinee whose local type carries no payload
// segment (enum:Option / enum:Result / enum:open / untyped local).
// Multiple registrations of the same variant name can disagree on the
// payload slot type (i32, i64, f64, and ref payloads coexist on
// wasm32-gc), so without the scrutinee spelling the emitter can only
// guess from registration order; a wrong guess emits a struct.get the
// runtime value does not have — invalid core Wasm (#906). The
// diagnostic is pushed onto the module and the pipeline rejects the
// module before emit. wasm32 linear is unaffected and keeps lowering.
fn mir_report_weak_payload_scrutinee(ctx: LowerCtx, variant_name: String, payload_hint: String) {
    if len(payload_hint) > 0 {
        return
    }
    if !ctx_gc_enum::ctx_is_gc_target(ctx) {
        return
    }
    if !mir_match_variant_is_some_or_ok(clone(variant_name)) && !mir_match_variant_is_err(clone(variant_name)) {
        return
    }
    // Generic template bodies are lowered for registration only; the
    // emitted MIR comes from the monomorphized instance where the same
    // scrutinee carries option:<t> spellings. Diagnosing the template
    // would reject every program that merely imports a generic adapter
    // (e.g. TakeIter<I>::next matching self.iter.next()). The mangled
    // name keeps ? for every unsubstituted type variable, including
    // impl-side params the signature view does not expose.
    let cur_fn = ctx_current_storage::ctx_current_func_value(ctx)
    if function_param_view::MirFunction_has_unsubstituted_generic_param(cur_fn) ||
    contains(function_identity::MirFunction_name(cur_fn), String_from("?")) {
        return
    }
    let message = String_from("unsupported match on an untyped Option/Result scrutinee: cannot determine the payload type for `").concat(
        clone(variant_name).concat(
            String_from("` in body `").concat(function_identity::MirFunction_name(cur_fn).concat(String_from("` — annotate the scrutinee with a concrete type (e.g. `let x: Option<i32> = ...`)")))
        )
    )
    let mut m = ctx_api_module::ctx_current_module(ctx)
    module_functions::MirModule_record_diagnostic(m, message)
}
