use std::text
use mir::function_identity
use mir::lower::ctx_current_storage
fn closure_storage_clear_pending_bind(mut ctx: LowerCtx) {
    ctx.closure_last_synth = String_new()
    ctx.closure_last_caps = String_new()
    ctx.closure_last_extra = 0
    ctx.closure_last_identity = false
    ctx.closure_last_env = 0 - 1
}

fn closure_storage_next_synth_name(mut ctx: LowerCtx) -> String {
    let synth = "__closure_".concat(ctx.closure_counter.to_string())
    ctx.closure_counter = ctx.closure_counter + 1
    synth
}

fn closure_storage_pending_synth(ctx: LowerCtx) -> String {
    ctx.closure_last_synth.clone()
}

fn closure_storage_set_pending_bind(mut ctx: LowerCtx, synth: String, packed: String, extra: i32, env_local: i32) {
    ctx.closure_last_synth = synth
    ctx.closure_last_caps = packed
    ctx.closure_last_extra = extra
    ctx.closure_last_identity = false
    ctx.closure_last_env = env_local
}

fn closure_storage_set_pending_identity(mut ctx: LowerCtx) {
    ctx.closure_last_synth = String_new()
    ctx.closure_last_caps = String_new()
    ctx.closure_last_extra = 0
    ctx.closure_last_identity = true
    ctx.closure_last_env = 0 - 1
}

fn closure_storage_push_bind(mut ctx: LowerCtx, bind_name: String) {
    ctx.closure_bind_names.push(bind_name)
    ctx.closure_bind_synth.push(ctx.closure_last_synth.clone())
    ctx.closure_bind_caps.push(ctx.closure_last_caps.clone())
    ctx.closure_bind_extra.push(ctx.closure_last_extra)
    ctx.closure_bind_identity.push(ctx.closure_last_identity)
    ctx.closure_bind_env.push(ctx.closure_last_env)
    ctx.closure_bind_fns.push(function_identity::MirFunction_name(ctx_current_storage::ctx_current_func_value(ctx)))
}

fn closure_storage_bind_count(ctx: LowerCtx) -> i32 {
    ctx.closure_bind_names.len()
}

fn closure_storage_bind_name_at(ctx: LowerCtx, index: i32) -> String {
    ctx.closure_bind_names.get_unchecked(index).clone()
}

fn closure_storage_bind_synth_at(ctx: LowerCtx, index: i32) -> String {
    ctx.closure_bind_synth.get_unchecked(index).clone()
}

fn closure_storage_bind_caps_at(ctx: LowerCtx, index: i32) -> String {
    ctx.closure_bind_caps.get_unchecked(index).clone()
}

fn closure_storage_bind_extra_at(ctx: LowerCtx, index: i32) -> i32 {
    ctx.closure_bind_extra.get_unchecked(index)
}

fn closure_storage_bind_env_at(ctx: LowerCtx, index: i32) -> i32 {
    ctx.closure_bind_env.get_unchecked(index)
}

fn closure_storage_bind_fn_at(ctx: LowerCtx, index: i32) -> String {
    ctx.closure_bind_fns.get_unchecked(index).clone()
}

fn closure_storage_bind_identity_at(ctx: LowerCtx, index: i32) -> bool {
    ctx.closure_bind_identity.get_unchecked(index)
}
