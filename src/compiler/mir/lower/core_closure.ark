use std::prelude::{clone, eq}
use mir::lower::closure_capture_args
use mir::lower::ctx_env_cells
use mir::lower::closure_pcells
use mir::lower::closure_registry
use mir::lower::body_closure_capture
use mir::lower::core_closure_emit
use mir::lower::core_closure_free
use mir::lower::core_expr_shape_accessors
use mir::lower::core_expr_shape_atoms
fn lower_core_closure(mut ctx: LowerCtx, exprs: Vec<CoreHirExpr>, expr: CoreHirExpr) -> i32 {
    if is_identity_core_closure(exprs, expr) {
        // A single funcref type cannot serve both scalar and GC-reference
        // instantiations of `|x| x`; inline this pure identity at each call.
        return closure_registry::closure_register_identity(ctx)
    }
    let caps = core_closure_free::core_closure_collect_caps(ctx, exprs, expr)
    let synth = closure_registry::closure_next_synth_name(ctx)
    let rebind_flags = core_closure_free::core_closure_collect_rebind_flags(exprs, expr, caps)
    // CoreHIR closures are generated without move; every rebind capture is
    // a mutable borrow, so promote the source place into a shared cell and
    // keep env-cell/write-back flags only for unpromoted captures (#891).
    let mut eff_rebinds = Vec::new<i32>()
    let mut pi = 0
    while pi < len(caps) {
        let mut eff = get_unchecked(rebind_flags, pi)
        if eff != 0 &&
        closure_pcells::ctx_promote_capture_cell(ctx, clone(get_unchecked(caps, pi))) >= 0 {
            eff = 0
        }
        push(eff_rebinds, eff)
        pi = pi + 1
    }
    let supply_caps = body_closure_capture::mir_closure_snapshot_copy_captures(ctx, caps, clone(synth))
    let packed = closure_capture_args::closure_pack_caps(supply_caps)
    let extra = len(caps)
    let mut mf = core_closure_emit::core_emit_closure_fn(ctx, exprs, synth, expr, caps, eff_rebinds)
    closure_registry::closure_register_synth_fn(ctx, mf, packed, extra, ctx_env_cells::ctx_has_env_cell(eff_rebinds), caps, eff_rebinds, 0)
}

fn is_identity_core_closure(exprs: Vec<CoreHirExpr>, expr: CoreHirExpr) -> bool {
    let child_count = core_expr_shape_accessors::mir_core_expr_child_count(expr)
    if child_count != 2 {
        return false
    }
    let param = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(expr, 0))
    let body = get_unchecked(exprs, core_expr_shape_accessors::mir_core_expr_child(expr, 1))
    if !core_expr_shape_atoms::mir_core_expr_is_ident(param) ||
    !core_expr_shape_atoms::mir_core_expr_is_ident(body) {
        return false
    }
    eq(
        core_expr_shape_accessors::mir_core_expr_text(param),
        core_expr_shape_accessors::mir_core_expr_text(body)
    )
}
