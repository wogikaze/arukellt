use std::text
use corehir::callee_spelling
use mir::lower::call_rewrite_vec_access
use mir::lower::call_rewrite_vec_push
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_resolved_calls
use mir::lower::ctx_types
use mir::inst_call
use mir::inst_misc_control
use mir::value_types
struct MirVecCallRewrite {
    callee_name: String,
    push_i64_needs_extend: bool,
}

fn mir_vec_call_rewrite_new(callee_name: String, push_i64_needs_extend: bool) -> MirVecCallRewrite {
    MirVecCallRewrite { callee_name: callee_name, push_i64_needs_extend: push_i64_needs_extend }
}

fn mir_vec_call_rewrite_callee_name(rewrite: MirVecCallRewrite) -> String {
    rewrite.callee_name.clone()
}

fn mir_vec_call_rewrite_push_i64_needs_extend(rewrite: MirVecCallRewrite) -> bool {
    rewrite.push_i64_needs_extend
}

fn mir_vec_call_target_is_intrinsic(callee_name: String) -> bool {
    callee_name.clone().eq(String_from("vec_get")) ||
    callee_name.clone().eq(String_from("vec_get_unchecked")) ||
    callee_name.clone().eq(String_from("vec_get_unchecked_i64")) ||
    callee_name.clone().eq(String_from("vec_get_unchecked_f64")) ||
    callee_name.clone().eq(String_from("vec_len")) ||
    callee_name.clone().eq(String_from("Vec::len")) ||
    callee_name.clone().eq(String_from("String::len")) ||
    callee_name.clone().eq(String_from("raw_array_len")) ||
    callee_name.clone().eq(String_from("raw_array_get_unchecked")) ||
    callee_name.clone().eq(String_from("raw_array_set_unchecked")) ||
    callee_name.clone().eq(String_from("raw_array_grow")) ||
    callee_name.clone().eq(String_from("vec_push")) ||
    callee_name.clone().eq(String_from("push_i64")) ||
    callee_name.clone().eq(String_from("push_f64")) ||
    callee_name.clone().eq(String_from("vec_push_i64")) ||
    callee_name.clone().eq(String_from("vec_push_f64")) ||
    callee_name.clone().eq(String_from("vec_set")) ||
    callee_name.clone().eq(String_from("vec_pop")) ||
    callee_name.clone().eq(String_from("Vec::pop")) ||
    callee_name.clone().eq(String_from("Vec::push")) ||
    callee_name.clone().eq(String_from("Vec::get"))
}

// Free `push(v, x)` is rewritten to `Vec::push` when `impl Vec<T>` is registered
// (#700 / #845). Match that form too so GC String/struct vecs keep the
// `vec_push` CoreOp path instead of mono → `__core_vec_push_i32_impl`.
fn is_vec_push_callee(name: String) -> bool {
    name.clone().eq(String_from("push")) ||
    name.clone().eq(String_from("prelude::push")) ||
    name.clone().eq(String_from("std::prelude::push")) ||
    name.clone().eq(String_from("vec_push")) ||
    name.clone().eq(String_from("push_i64")) ||
    name.clone().eq(String_from("push_f64")) ||
    name.clone().eq(String_from("Vec::push")) ||
    name.clone().starts_with(String_from("Vec::push__")) ||
    name.clone().starts_with(String_from("push__"))
}

fn is_vec_len_callee(name: String) -> bool {
    name.clone().eq(String_from("len")) ||
    name.clone().eq(String_from("Vec::len")) ||
    name.clone().starts_with(String_from("Vec::len__")) ||
    name.clone().starts_with(String_from("len__")) ||
    name.clone().eq(String_from("prelude::len")) ||
    name.clone().eq(String_from("std::prelude::len"))
}

fn is_vec_pop_callee(name: String) -> bool {
    name.clone().eq(String_from("pop")) ||
    name.clone().eq(String_from("Vec::pop")) ||
    name.clone().starts_with(String_from("Vec::pop__")) ||
    name.clone().starts_with(String_from("pop__"))
}

fn is_vec_set_callee(name: String) -> bool {
    name.clone().eq(String_from("set")) ||
    name.clone().eq(String_from("vec_set")) ||
    name.clone().eq(String_from("Vec::set")) ||
    name.clone().starts_with(String_from("Vec::set__")) ||
    name.clone().starts_with(String_from("set__"))
}

fn mir_rewrite_vec_access_after_mono(ctx: LowerCtx, callee_name: String, first_arg_idx: i32) -> String {
    if is_vec_get_unchecked_callee(callee_name.clone()) {
        return call_rewrite_vec_access::mir_rewrite_vec_get_unchecked(ctx, callee_name, first_arg_idx)
    }
    if is_vec_get_callee(callee_name.clone()) {
        return call_rewrite_vec_access::mir_rewrite_vec_get(ctx, callee_name, first_arg_idx)
    }
    callee_name
}

// Namespace members lower to the canonical sealed-raw CoreOp spellings before
// method mono resolution. The associated wrappers stay for the sealed stdlib
// surface, but a call site must bind the CoreOp so the emitter can pick the
// concrete Vec element type from the enclosing return (#917).
fn mir_rewrite_raw_array_namespace(callee_name: String) -> String {
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_new"),
        String_from("RawArray"),
        String_from("new")
    ) {
        return String_from("raw_array_new")
    }
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_len"),
        String_from("RawArray"),
        String_from("len")
    ) {
        return String_from("raw_array_len")
    }
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_get_unchecked"),
        String_from("RawArray"),
        String_from("get_unchecked")
    ) {
        return String_from("raw_array_get_unchecked")
    }
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_set_unchecked"),
        String_from("RawArray"),
        String_from("set_unchecked")
    ) {
        return String_from("raw_array_set_unchecked")
    }
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_grow"),
        String_from("RawArray"),
        String_from("grow")
    ) {
        return String_from("raw_array_grow")
    }
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_set_len"),
        String_from("RawArray"),
        String_from("set_len")
    ) {
        return String_from("raw_array_set_len")
    }
    callee_name
}

fn mir_rewrite_vec_call(mut ctx: LowerCtx, callee_name: String, first_arg_idx: i32, second_arg_idx: i32, stage_call_args: bool, span_start: i32) -> MirVecCallRewrite {
    let mut rewritten = mir_rewrite_raw_array_namespace(
        normalize_vec_constructor_callee(callee_name)
    )
    let mut push_i64_needs_extend = false
    if is_vec_len_callee(rewritten.clone()) {
        rewritten = mir_rewrite_vec_len(ctx, span_start, rewritten)
    }
    if is_vec_push_callee(rewritten.clone()) {
        let push_rewrite = call_rewrite_vec_push::mir_rewrite_vec_push(ctx, span_start, rewritten, first_arg_idx, second_arg_idx, stage_call_args)
        rewritten = call_rewrite_vec_push::mir_vec_push_rewrite_callee_name(push_rewrite)
        push_i64_needs_extend = call_rewrite_vec_push::mir_vec_push_rewrite_push_i64_needs_extend(push_rewrite)
    }
    if is_vec_get_unchecked_callee(rewritten.clone()) {
        rewritten = call_rewrite_vec_access::mir_rewrite_vec_get_unchecked(ctx, rewritten, first_arg_idx)
    }
    if is_vec_get_callee(rewritten.clone()) {
        rewritten = mir_rewrite_vec_get_call(ctx, span_start, rewritten, first_arg_idx)
    }
    if is_vec_pop_callee(rewritten.clone()) {
        rewritten = mir_rewrite_vec_pop(ctx, span_start, rewritten)
    }
    rewritten = mir_rewrite_vec_basic(rewritten)
    mir_vec_call_rewrite_new(rewritten, push_i64_needs_extend)
}

fn normalize_vec_constructor_callee(callee_name: String) -> String {
    if callee_name.clone().starts_with(String_from("Vec_new_")) {
        return String_from("Vec__new__").concat(callee_name.slice(8, len(callee_name)))
    }
    if callee_name.clone().starts_with(String_from("Vec::new__")) {
        return String_from("Vec__new__").concat(callee_name.slice(10, len(callee_name)))
    }
    if callee_name.clone().starts_with(String_from("Vec_with_capacity_")) {
        return String_from("Vec__with_capacity__").concat(callee_name.slice(18, len(callee_name)))
    }
    if callee_name.clone().starts_with(String_from("Vec::with_capacity__")) {
        return String_from("Vec__with_capacity__").concat(callee_name.slice(20, len(callee_name)))
    }
    callee_name
}

fn is_vec_get_unchecked_callee(name: String) -> bool {
    name.clone().eq(String_from("get_unchecked")) ||
    name.clone().eq(String_from("__intrinsic_get_unchecked")) ||
    name.clone().ends_with(String_from("::get_unchecked")) ||
    name.clone().starts_with(String_from("get_unchecked__")) ||
    name.contains(String_from("::get_unchecked__"))
}

fn is_vec_get_callee(name: String) -> bool {
    is_prelude_get_name(name.clone()) ||
    name.clone().eq(String_from("__intrinsic_get")) ||
    name.clone().eq(String_from("Vec::get")) ||
    name.clone().starts_with(String_from("Vec::get__")) ||
    name.clone().ends_with(String_from("::get")) ||
    name.clone().starts_with(String_from("get__")) ||
    name.contains(String_from("::get__"))
}

fn mir_rewrite_vec_is_empty_to_local(mut ctx: LowerCtx, first_arg_idx: i32) -> i32 {
    if first_arg_idx < 0 {
        return 0 - 1
    }
    let first_arg_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
    if !first_arg_type.clone().eq(String_from("Vec")) &&
    !first_arg_type.clone().starts_with("vec:") &&
    !first_arg_type.clone().starts_with("array:") {
        return 0 - 1
    }
    // The receiver value is already on the stack from lower_expr.
    // Emit sealed raw length; eqz dest (#822 — avoid generic vec.len shell).
    let len_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_call::MirInst_call(String_from("raw_array_len"), 1, len_dest))
    ctx_api_local_types::ctx_set_local_type(ctx, len_dest, String_from("i32"))
    ctx_api_local_types::ctx_set_local_vt(ctx, len_dest, value_types::VT_I32())
    let eqz_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_misc_control::MirInst_eqz(eqz_dest, len_dest))
    ctx_api_local_types::ctx_set_local_type(ctx, eqz_dest, String_from("bool"))
    ctx_api_local_types::ctx_set_local_vt(ctx, eqz_dest, value_types::VT_I32())
    eqz_dest
}

// The prelude `len` free is signature-only and serves two receiver owners.
// The checker records the owner per call site (#933); lowering binds the
// owner-qualified FunctionId the CoreOp registry already maps to
// `string.len` / `vec.len`. No local-type re-derivation and no bare-`len`
// name dispatch remain. A site without a resolution is not the prelude free,
// so its callee stays untouched.
fn mir_rewrite_vec_len(ctx: LowerCtx, span_start: i32, callee_name: String) -> String {
    if callee_name.clone().eq(String_from("String::len")) ||
    callee_name.clone().starts_with(String_from("String::len__")) {
        return String_from("String::len")
    }
    if callee_name.clone().eq(String_from("Vec::len")) ||
    callee_name.clone().starts_with(String_from("Vec::len__")) {
        return String_from("Vec::len")
    }
    if !is_dispatchable_len_name(callee_name) {
        return callee_name
    }
    let owner = ctx_resolved_calls::ctx_resolved_call_owner(ctx, span_start, String_from("len"))
    if len(owner.clone()) == 0 {
    }
    if owner.eq(String_from("String")) {
        return String_from("String::len")
    }
    if owner.eq(String_from("Vec")) {
        return String_from("Vec::len")
    }
    callee_name
}

fn is_dispatchable_len_name(callee_name: String) -> bool {
    callee_name.clone().eq(String_from("len")) ||
    callee_name.clone().eq(String_from("prelude::len")) ||
    callee_name.clone().eq(String_from("std::prelude::len")) ||
    callee_name.clone().starts_with(String_from("len__"))
}

// `pop` is the second prelude callable proven through the owner handoff. The
// checker records the Vec receiver owner; lowering emits the owner-qualified
// `Vec::pop`, which the registry binds to `vec.pop`. A method-call rewrite
// (span 0) keeps its historical Vec target because the method receiver has
// already been resolved before call rewriting.
fn mir_rewrite_vec_pop(ctx: LowerCtx, span_start: i32, callee_name: String) -> String {
    if callee_name.clone().eq(String_from("Vec::pop")) ||
    callee_name.clone().starts_with(String_from("Vec::pop__")) ||
    callee_name.clone().starts_with(String_from("pop__")) {
        return String_from("Vec::pop")
    }
    if !callee_name.clone().eq(String_from("pop")) &&
    !callee_name.clone().eq(String_from("prelude::pop")) &&
    !callee_name.clone().eq(String_from("std::prelude::pop")) {
        return callee_name
    }
    if span_start == 0 {
        return String_from("Vec::pop")
    }
    let owner = ctx_resolved_calls::ctx_resolved_call_owner(ctx, span_start, String_from("pop"))
    if owner.eq(String_from("Vec")) {
        return String_from("Vec::pop")
    }
    callee_name
}

// `get` follows `push` through the same handoff. The checker records the Vec
// receiver owner per call site (#933); lowering binds the owner-qualified
// `Vec::get` when the receiver local carries no element type, and keeps the
// element-typed `vec_get` CoreOp when the local type can select it. A site
// without a resolution is not the prelude free, so its callee stays untouched.
fn mir_rewrite_vec_get_call(
    ctx: LowerCtx,
    span_start: i32,
    callee_name: String,
    first_arg_idx: i32
) -> String {
    if callee_name.clone().eq(String_from("Vec::get")) ||
    callee_name.clone().starts_with(String_from("Vec::get__")) {
        return String_from("Vec::get")
    }
    if !is_prelude_get_name(callee_name.clone()) {
        return call_rewrite_vec_access::mir_rewrite_vec_get(ctx, callee_name, first_arg_idx)
    }
    if span_start == 0 {
        return call_rewrite_vec_access::mir_rewrite_vec_get(ctx, callee_name, first_arg_idx)
    }
    let owner = ctx_resolved_calls::ctx_resolved_call_owner(ctx, span_start, String_from("get"))
    if !owner.eq(String_from("Vec")) {
        return callee_name
    }
    let refined = call_rewrite_vec_access::mir_rewrite_vec_get(ctx, callee_name.clone(), first_arg_idx)
    if refined.eq(callee_name) {
        return String_from("Vec::get")
    }
    refined
}

fn is_prelude_get_name(callee_name: String) -> bool {
    callee_name.clone().eq(String_from("get")) ||
    callee_name.clone().eq(String_from("prelude::get")) ||
    callee_name.clone().eq(String_from("std::prelude::get"))
}

fn mir_rewrite_vec_basic(callee_name: String) -> String {
    let mut rewritten = callee_name
    if is_vec_set_callee(rewritten.clone()) {
        rewritten = String_from("raw_array_set_unchecked")
    }
    rewritten
}
