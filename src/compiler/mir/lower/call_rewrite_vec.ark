use std::prelude::{eq}
use std::text
use corehir::callee_spelling
use mir::lower::call_rewrite_vec_access
use mir::lower::call_rewrite_vec_push
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::ctx_types
use mir::inst_call
use mir::inst_misc_control
use mir::value_types
struct MirVecCallRewrite {
    callee_name: String,
    push_i64_needs_extend: bool,
}

fn mir_vec_call_rewrite_new(callee_name: String, push_i64_needs_extend: bool) -> MirVecCallRewrite {
    MirVecCallRewrite { callee_name: callee_name, push_i64_needs_extend: push_i64_needs_extend }
}

fn mir_vec_call_rewrite_callee_name(rewrite: MirVecCallRewrite) -> String {
    rewrite.callee_name.clone()
}

fn mir_vec_call_rewrite_push_i64_needs_extend(rewrite: MirVecCallRewrite) -> bool {
    rewrite.push_i64_needs_extend
}

fn mir_vec_call_target_is_intrinsic(callee_name: String) -> bool {
    eq(callee_name.clone(), String_from("vec_get")) ||
    eq(callee_name.clone(), String_from("vec_get_unchecked")) ||
    eq(callee_name.clone(), String_from("vec_get_unchecked_i64")) ||
    eq(callee_name.clone(), String_from("vec_get_unchecked_f64")) ||
    eq(callee_name.clone(), String_from("vec_len")) ||
    eq(callee_name.clone(), String_from("raw_array_len")) ||
    eq(callee_name.clone(), String_from("raw_array_get_unchecked")) ||
    eq(callee_name.clone(), String_from("raw_array_set_unchecked")) ||
    eq(callee_name.clone(), String_from("raw_array_grow")) ||
    eq(callee_name.clone(), String_from("vec_push")) ||
    eq(callee_name.clone(), String_from("push_i64")) ||
    eq(callee_name.clone(), String_from("push_f64")) ||
    eq(callee_name.clone(), String_from("vec_push_i64")) ||
    eq(callee_name.clone(), String_from("vec_push_f64")) ||
    eq(callee_name.clone(), String_from("vec_set")) ||
    eq(callee_name.clone(), String_from("vec_pop"))
}

// Free `push(v, x)` is rewritten to `Vec::push` when `impl Vec<T>` is registered
// (#700 / #845). Match that form too so GC String/struct vecs keep the
// `vec_push` CoreOp path instead of mono → `__core_vec_push_i32_impl`.
fn is_vec_push_callee(name: String) -> bool {
    eq(name.clone(), String_from("push")) ||
    eq(name.clone(), String_from("vec_push")) ||
    eq(name.clone(), String_from("push_i64")) ||
    eq(name.clone(), String_from("push_f64")) ||
    eq(name.clone(), String_from("Vec::push")) ||
    name.clone().starts_with(String_from("Vec::push__")) ||
    name.clone().starts_with(String_from("push__"))
}

fn is_vec_len_callee(name: String) -> bool {
    eq(name.clone(), String_from("len")) ||
    eq(name.clone(), String_from("Vec::len")) ||
    name.clone().starts_with(String_from("Vec::len__")) ||
    name.clone().starts_with(String_from("len__"))
}

fn is_vec_pop_callee(name: String) -> bool {
    eq(name.clone(), String_from("pop")) ||
    eq(name.clone(), String_from("Vec::pop")) ||
    name.clone().starts_with(String_from("Vec::pop__")) ||
    name.clone().starts_with(String_from("pop__"))
}

fn is_vec_set_callee(name: String) -> bool {
    eq(name.clone(), String_from("set")) ||
    eq(name.clone(), String_from("vec_set")) ||
    eq(name.clone(), String_from("Vec::set")) ||
    name.clone().starts_with(String_from("Vec::set__")) ||
    name.clone().starts_with(String_from("set__"))
}

fn mir_rewrite_vec_access_after_mono(ctx: LowerCtx, callee_name: String, first_arg_idx: i32) -> String {
    if is_vec_get_unchecked_callee(callee_name.clone()) {
        return call_rewrite_vec_access::mir_rewrite_vec_get_unchecked(ctx, callee_name, first_arg_idx)
    }
    if is_vec_get_callee(callee_name.clone()) {
        return call_rewrite_vec_access::mir_rewrite_vec_get(ctx, callee_name, first_arg_idx)
    }
    callee_name
}

// Namespace members lower to the canonical sealed-raw CoreOp spellings before
// method mono resolution. The associated wrappers stay for the sealed stdlib
// surface, but a call site must bind the CoreOp so the emitter can pick the
// concrete Vec element type from the enclosing return (#917).
fn mir_rewrite_raw_array_namespace(callee_name: String) -> String {
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_new"),
        String_from("RawArray"),
        String_from("new")
    ) {
        return String_from("raw_array_new")
    }
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_len"),
        String_from("RawArray"),
        String_from("len")
    ) {
        return String_from("raw_array_len")
    }
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_get_unchecked"),
        String_from("RawArray"),
        String_from("get_unchecked")
    ) {
        return String_from("raw_array_get_unchecked")
    }
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_set_unchecked"),
        String_from("RawArray"),
        String_from("set_unchecked")
    ) {
        return String_from("raw_array_set_unchecked")
    }
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_grow"),
        String_from("RawArray"),
        String_from("grow")
    ) {
        return String_from("raw_array_grow")
    }
    if callee_spelling::is_namespace_member_callee(
        callee_name.clone(),
        String_from("raw_array_set_len"),
        String_from("RawArray"),
        String_from("set_len")
    ) {
        return String_from("raw_array_set_len")
    }
    callee_name
}

fn mir_rewrite_vec_call(mut ctx: LowerCtx, callee_name: String, first_arg_idx: i32, second_arg_idx: i32, stage_call_args: bool) -> MirVecCallRewrite {
    let mut rewritten = mir_rewrite_raw_array_namespace(
        normalize_vec_constructor_callee(callee_name)
    )
    let mut push_i64_needs_extend = false
    if is_vec_len_callee(rewritten.clone()) {
        rewritten = mir_rewrite_vec_len(ctx, rewritten, first_arg_idx)
    }
    if is_vec_push_callee(rewritten.clone()) {
        // Normalize to bare `push` so element-type rewrite (vec_push / push_i64)
        // stays centralized in call_rewrite_vec_push.
        rewritten = String_from("push")
        let push_rewrite = call_rewrite_vec_push::mir_rewrite_vec_push(ctx, rewritten, first_arg_idx, second_arg_idx, stage_call_args)
        rewritten = call_rewrite_vec_push::mir_vec_push_rewrite_callee_name(push_rewrite)
        push_i64_needs_extend = call_rewrite_vec_push::mir_vec_push_rewrite_push_i64_needs_extend(push_rewrite)
    }
    if is_vec_get_unchecked_callee(rewritten.clone()) {
        rewritten = call_rewrite_vec_access::mir_rewrite_vec_get_unchecked(ctx, rewritten, first_arg_idx)
    }
    if is_vec_get_callee(rewritten.clone()) {
        rewritten = call_rewrite_vec_access::mir_rewrite_vec_get(ctx, rewritten, first_arg_idx)
    }
    rewritten = mir_rewrite_vec_basic(rewritten)
    mir_vec_call_rewrite_new(rewritten, push_i64_needs_extend)
}

fn normalize_vec_constructor_callee(callee_name: String) -> String {
    if callee_name.clone().starts_with(String_from("Vec_new_")) {
        return String_from("Vec__new__").concat(callee_name.slice(8, len(callee_name)))
    }
    if callee_name.clone().starts_with(String_from("Vec::new__")) {
        return String_from("Vec__new__").concat(callee_name.slice(10, len(callee_name)))
    }
    if callee_name.clone().starts_with(String_from("Vec_with_capacity_")) {
        return String_from("Vec__with_capacity__").concat(callee_name.slice(18, len(callee_name)))
    }
    if callee_name.clone().starts_with(String_from("Vec::with_capacity__")) {
        return String_from("Vec__with_capacity__").concat(callee_name.slice(20, len(callee_name)))
    }
    callee_name
}

fn is_vec_get_unchecked_callee(name: String) -> bool {
    eq(name.clone(), String_from("get_unchecked")) ||
    eq(name.clone(), String_from("__intrinsic_get_unchecked")) ||
    name.clone().ends_with(String_from("::get_unchecked")) ||
    name.clone().starts_with(String_from("get_unchecked__")) ||
    name.contains(String_from("::get_unchecked__"))
}

fn is_vec_get_callee(name: String) -> bool {
    eq(name.clone(), String_from("get")) ||
    eq(name.clone(), String_from("__intrinsic_get")) ||
    name.clone().ends_with(String_from("::get")) ||
    name.clone().starts_with(String_from("get__")) ||
    name.contains(String_from("::get__"))
}

fn mir_rewrite_vec_is_empty_to_local(mut ctx: LowerCtx, first_arg_idx: i32) -> i32 {
    if first_arg_idx < 0 {
        return 0 - 1
    }
    let first_arg_type = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
    if !eq(first_arg_type.clone(), String_from("Vec")) &&
    !first_arg_type.clone().starts_with("vec:") &&
    !first_arg_type.clone().starts_with("array:") {
        return 0 - 1
    }
    // The receiver value is already on the stack from lower_expr.
    // Emit sealed raw length; eqz dest (#822 — avoid generic vec.len shell).
    let len_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_call::MirInst_call(String_from("raw_array_len"), 1, len_dest))
    ctx_api_local_types::ctx_set_local_type(ctx, len_dest, String_from("i32"))
    ctx_api_local_types::ctx_set_local_vt(ctx, len_dest, value_types::VT_I32())
    let eqz_dest = ctx_api_local_alloc::ctx_fresh_local(ctx, value_types::VT_I32())
    ctx_api_emit::ctx_emit(ctx, inst_misc_control::MirInst_eqz(eqz_dest, len_dest))
    ctx_api_local_types::ctx_set_local_type(ctx, eqz_dest, String_from("bool"))
    ctx_api_local_types::ctx_set_local_vt(ctx, eqz_dest, value_types::VT_I32())
    eqz_dest
}

fn mir_rewrite_vec_len(ctx: LowerCtx, callee_name: String, first_arg_idx: i32) -> String {
    if first_arg_idx >= 0 {
        let arg_type_len = ctx_api_local_types::ctx_get_local_type(ctx, first_arg_idx)
        if eq(arg_type_len.clone(), String_from("Vec")) ||
        arg_type_len.clone().starts_with("vec:") ||
        arg_type_len.clone().starts_with("array:") {
            // Prefer sealed raw at the call site so GC sees the concrete vec local.
            return String_from("raw_array_len")
        }
    }
    callee_name
}

fn mir_rewrite_vec_basic(callee_name: String) -> String {
    let mut rewritten = callee_name
    if is_vec_pop_callee(rewritten.clone()) {
        rewritten = String_from("vec_pop")
    }
    if is_vec_set_callee(rewritten.clone()) {
        rewritten = String_from("raw_array_set_unchecked")
    }
    rewritten
}
