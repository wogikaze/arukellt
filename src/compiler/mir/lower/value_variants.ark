use std::prelude::{clone}
use mir::lower::ast_node
use mir::lower_kinds
use mir::lower::ctx_api_variants
use mir::lower::ctx_api_emit
use mir::lower::ctx_api_local_alloc
use mir::lower::ctx_api_local_types
use mir::lower::closure_env
use mir::lower::ctx_fn_index
use mir::lower::core_names
use mir::lower::ctx_types
use mir::value_types
use mir::lower::variants
fn lower_atomic_path_variant(ctx: LowerCtx, node: AstNode) -> i32 {
    if ast_node::node_kind_is(node, lower_kinds::NK_PATH()) {
        let raw_name = ast_node::node_text(node)
        let canon = ctx_api_variants::ctx_canonical_variant_name(ctx, clone(raw_name))
        let variant_name = if len(canon) > 0 {
            canon
        } else {
            raw_name
        }
        let tag = ctx_api_variants::ctx_variant_tag(ctx, clone(variant_name))
        if tag >= 0 {
            return variants::lower_variant_value(ctx, variant_name, tag)
        }
        let fn_name = ast_node::node_text(node)
        let fn_idx = ctx_fn_index::ctx_fn_index_find(ctx, clone(fn_name))
        if fn_idx >= 0 {
            return lower_function_value(ctx, fn_name)
        }
        return 0 - 1
    }
    0 - 2
}

fn lower_atomic_function(ctx: LowerCtx, node: AstNode) -> i32 {
    if !ast_node::node_kind_is(node, lower_kinds::NK_IDENT()) {
        return 0 - 2
    }
    let fn_name = ast_node::node_text(node)
    if ctx_fn_index::ctx_is_const_name(ctx, clone(fn_name)) {
        return 0 - 2
    }
    if ctx_fn_index::ctx_fn_index_find(ctx, clone(fn_name)) < 0 {
        return 0 - 2
    }
    lower_function_value(ctx, fn_name)
}

fn lower_function_value(ctx: LowerCtx, fn_name: String) -> i32 {
    let type_name = core_names::mir_fnref_type_name_for_function(ctx, clone(fn_name))
    let tramp = closure_env::closure_ensure_fn_thunk(ctx, clone(fn_name))
    let pair = closure_env::closure_emit_pair(ctx, 0 - 1, clone(tramp))
    ctx_api_local_types::ctx_set_local_type(ctx, pair, clone(type_name))
    pair
}

fn lower_atomic_ident_variant(ctx: LowerCtx, node: AstNode) -> i32 {
    let raw_name = ast_node::node_text(node)
    let canon = ctx_api_variants::ctx_canonical_variant_name(ctx, clone(raw_name))
    let variant_name = if len(canon) > 0 {
        canon
    } else {
        raw_name
    }
    let ident_tag = ctx_api_variants::ctx_variant_tag(ctx, clone(variant_name))
    if ident_tag >= 0 {
        return variants::lower_variant_value(ctx, variant_name, ident_tag)
    }
    0 - 1
}
