use corehir::mir_value_type
use corehir::type_id
use mir::block_factory
use mir::block_inst_access
use mir::block_record
use mir::inst_draft
use mir::types

fn mir_block_clear_insts(mut block: MirBlock) {
    // Keep column capacity. Vec::new here is a new bump and cannot move ru_maxrss.
    // raw_array_set_len dispatch is incomplete; pop of GC struct vecs makes s2 invalid.
    block.inst_count = 0
}

fn mir_block_store_str(mut block: MirBlock, idx: i32, text: String, reuse: bool) {
    if text.len() == 0 {
        if reuse {
            block.str_ids.set(idx, 0 - 1)
            return
        }
        block.str_ids.push(0 - 1)
        return
    }
    if reuse {
        let old_id = get_unchecked(block.str_ids, idx)
        if old_id >= 0 && old_id < block.str_pool.len() {
            block.str_pool.set(old_id, text)
            return
        }
    }
    if reuse {
        block.str_ids.set(idx, block.str_pool.len())
        block.str_pool.push(text)
        return
    }
    block.str_ids.push(block.str_pool.len())
    block.str_pool.push(text)
}

fn mir_block_store_result_types(mut block: MirBlock, reuse: bool, result_types: Vec<MirValueType>) {
    if result_types.len() == 0 {
        if reuse {
            block.type_ids.set(block.inst_count, 0 - 1)
            block.type_reprs.set(block.inst_count, 0)
            block.type_nulls.set(block.inst_count, 0)
            return
        }
        block.type_ids.push(0 - 1)
        block.type_reprs.push(0)
        block.type_nulls.push(0)
        return
    }
    let first = get_unchecked(result_types, 0)
    let tid = type_id::TypeId_raw(mir_value_type::mir_value_type_type_id(first))
    let repr = mir_value_type::mir_value_type_repr(first)
    let nulls = mir_value_type::mir_value_type_nullability(first)
    if reuse {
        block.type_ids.set(block.inst_count, tid)
        block.type_reprs.set(block.inst_count, repr)
        block.type_nulls.set(block.inst_count, nulls)
        return
    }
    block.type_ids.push(tid)
    block.type_reprs.push(repr)
    block.type_nulls.push(nulls)
}

fn mir_block_append_draft(mut block: MirBlock, inst: MirInstDraft) {
    let idx = block.inst_count
    let reuse = idx < block.ops.len()
    let op = inst_draft::MirInstDraft_op(inst)
    let dest = inst_draft::MirInstDraft_dest(inst)
    let arg0 = inst_draft::MirInstDraft_arg0(inst)
    let arg1 = inst_draft::MirInstDraft_arg1(inst)
    let int_val = inst_draft::MirInstDraft_int_val(inst)
    let float_val = inst_draft::MirInstDraft_float_val(inst)
    let val_type = inst_draft::MirInstDraft_val_type(inst)
    let func_id = inst_draft::MirInstDraft_func_id_raw(inst)
    if reuse {
        block.ops.set(idx, op)
        block.dests.set(idx, dest)
        block.arg0s.set(idx, arg0)
        block.arg1s.set(idx, arg1)
        block.int_vals.set(idx, int_val)
        block_record::mir_float_box_set_value(get_unchecked(block.float_vals, idx), float_val)
        block.val_types.set(idx, val_type)
        block.func_ids.set(idx, func_id)
    }
    if !reuse {
        block.ops.push(op)
        block.dests.push(dest)
        block.arg0s.push(arg0)
        block.arg1s.push(arg1)
        block.int_vals.push(int_val)
        block.float_vals.push(block_record::MirFloatBox_new(float_val))
        block.val_types.push(val_type)
        block.func_ids.push(func_id)
    }
    mir_block_store_str(block, idx, inst_draft::MirInstDraft_str_val(inst), reuse)
    mir_block_store_result_types(block, reuse, inst_draft::MirInstDraft_result_types(inst))
    block.inst_count = idx + 1
}

fn MirBlock_push_inst(mut block: MirBlock, inst: MirInstDraft) {
    mir_block_append_draft(block, inst)
}

fn MirBlock_set_instructions(mut block: MirBlock, instructions: Vec<MirInstDraft>) {
    mir_block_clear_insts(block)
    let n = instructions.len()
    let mut i = 0
    while i < n {
        mir_block_append_draft(block, get_unchecked(instructions, i))
        i = i + 1
    }
}

fn MirBlock_set_from_refs(mut block: MirBlock, refs: Vec<MirInst>) {
    MirBlock_set_instructions(block, block_inst_access::MirBlock_drafts_from_refs(refs))
}

fn MirInst_bind_draft(inst: MirInstDraft) -> MirInst {
    let mut block = block_factory::MirBlock_new(0)
    MirBlock_push_inst(block, inst)
    block_inst_access::MirBlock_inst_at(block, 0)
}
