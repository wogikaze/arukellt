fn mir_push_unique_i32(mut ids: Vec<i32>, block_id: i32) {
    let pred_count = ids.len()
    let mut i = 0
    while i < pred_count {
        if get_unchecked(ids, i) == block_id {
            return
        }
        i = i + 1
    }
    ids.push(block_id)
}

test mod "dom_set_mutate" {
    test "push_unique_adds_new" {
        let mut ids = Vec::new<i32>()
        mir_push_unique_i32(ids, 3)
        assert(ids.len() == 1)
    }
    test "push_unique_skips_dup" {
        let mut ids = Vec::new<i32>()
        mir_push_unique_i32(ids, 3)
        mir_push_unique_i32(ids, 3)
        assert(ids.len() == 1)
    }
    test "push_unique_keeps_order" {
        let mut ids = Vec::new<i32>()
        mir_push_unique_i32(ids, 5)
        mir_push_unique_i32(ids, 2)
        mir_push_unique_i32(ids, 5)
        assert(ids.len() == 2)
        assert(ids.get_unchecked(0) == 5)
        assert(ids.get_unchecked(1) == 2)
    }
}
