use std::text
use mir::dump_format_local
use mir::dump_format_types
use mir::dump_op_names
use mir::phi_access

fn mir_format_phi_args(f: MirFunction, args: Vec<MirPhiArg>) -> String {
    let count = args.len()
    let mut out = "["
    let mut i = 0
    while i < count {
        let arg = args.get_unchecked(i)
        if i > 0 {
            out = out.concat(", ")
        }
        out = out.concat("bb")
        out = out.concat(phi_access::MirPhiArg_pred_block(arg).to_string())
        out = out.concat(" -> ")
        out = out.concat(dump_format_local::mir_format_local_ref(f, phi_access::MirPhiArg_local(arg)))
        i = i + 1
    }
    out.concat("]")
}

fn mir_format_phi(f: MirFunction, phi: MirPhi) -> String {
    let mut out = dump_op_names::mir_op_name(phi_access::MirPhi_op(phi))
    out = out.concat(" ")
    out = out.concat(dump_format_local::mir_format_local_ref(f, phi_access::MirPhi_dest(phi)))
    out = out.concat(" = ")
    out = out.concat(mir_format_phi_args(f, phi_access::MirPhi_args(phi)))
    out = out.concat(" : ")
    out.concat(dump_format_types::mir_value_type_name(phi_access::MirPhi_val_type(phi)))
}
