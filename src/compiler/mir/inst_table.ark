use corehir::mir_value_type
use corehir::type_id
// Column store for MirInst. Handles are (table, hid). Floats are kept as
// IEEE-754 bits so compiler-source records do not carry nested f64 fields.

pub struct MirFloatBits {
    lo: i32,
    hi: i32,
}

fn MirFloatBits_new(value: f64) -> MirFloatBits {
    MirFloatBits {
        lo: __intrinsic_f64_bits_lo(value),
        hi: __intrinsic_f64_bits_hi(value),
    }
}

fn MirFloatBits_from_parts(lo: i32, hi: i32) -> MirFloatBits {
    MirFloatBits { lo: lo, hi: hi }
}

fn mir_float_bits_lo(bits: MirFloatBits) -> i32 {
    bits.lo
}

fn mir_float_bits_hi(bits: MirFloatBits) -> i32 {
    bits.hi
}

fn mir_float_bits_byte_to_f64(value: i32) -> f64 {
    let mut remaining = value
    let mut bit = 1.0
    let mut result = 0.0
    let mut i = 0
    while i < 8 {
        if (remaining & 1) == 1 {
            result = result + bit
        }
        remaining = u32_shr(remaining, 1)
        bit = bit + bit
        i = i + 1
    }
    result
}

fn mir_float_bits_unsigned_i32_to_f64(value: i32) -> f64 {
    let byte0 = value & 255
    let byte1 = u32_shr(value, 8) & 255
    let byte2 = u32_shr(value, 16) & 255
    let byte3 = u32_shr(value, 24) & 255
    mir_float_bits_byte_to_f64(byte0) +
    mir_float_bits_byte_to_f64(byte1) * 256.0 +
    mir_float_bits_byte_to_f64(byte2) * 65536.0 +
    mir_float_bits_byte_to_f64(byte3) * 16777216.0
}

fn mir_float_bits_pow2(exponent: i32) -> f64 {
    let mut remaining = if exponent < 0 { 0 - exponent } else { exponent }
    let mut factor = if exponent < 0 { 0.5 } else { 2.0 }
    let mut result = 1.0
    while remaining > 0 {
        if (remaining & 1) == 1 {
            result = result * factor
        }
        factor = factor * factor
        remaining = u32_shr(remaining, 1)
    }
    result
}

fn mir_float_bits_value(bits: MirFloatBits) -> f64 {
    let sign = if bits.hi < 0 { 0.0 - 1.0 } else { 1.0 }
    let exponent = u32_shr(bits.hi & 2147483647, 20) & 2047
    let mantissa_hi = bits.hi & 1048575
    let mantissa = mir_float_bits_unsigned_i32_to_f64(mantissa_hi) * 4294967296.0 +
    mir_float_bits_unsigned_i32_to_f64(bits.lo)
    if exponent == 2047 {
        if mantissa == 0.0 {
            return sign * (1.0 / 0.0)
        }
        return 0.0 / 0.0
    }
    if exponent == 0 {
        return sign * (mantissa / 4503599627370496.0) * mir_float_bits_pow2(-1022)
    }
    let unbiased_exponent = exponent - 1023
    sign * (1.0 + mantissa / 4503599627370496.0) * mir_float_bits_pow2(unbiased_exponent)
}

pub struct MirInstTable {
    op: Vec<i32>,
    dest: Vec<i32>,
    arg0: Vec<i32>,
    arg1: Vec<i32>,
    int_val: Vec<i32>,
    // Interleaved IEEE-754 lo/hi pairs; Vec<struct> is not supported by the
    // legacy GC emitter used to bootstrap this compiler.
    float_val: Vec<i32>,
    string_pool: Vec<String>,
    metadata: Vec<i32>,
    result_type_starts: Vec<i32>,
    result_type_counts: Vec<i32>,
    // Result types are scalar columns. Reconstruct a MirValueType only at an
    // API boundary; keeping GC records in the instruction table made every
    // result-bearing instruction retain a nested object.
    result_type_ids: Vec<i32>,
    result_type_reprs: Vec<i32>,
    result_type_nullabilities: Vec<i32>,
}

fn MirInstTable_new() -> MirInstTable {
    MirInstTable_new_with_string_pool(Vec::new<String>())
}

fn MirInstTable_new_with_string_pool(string_pool: Vec<String>) -> MirInstTable {
    MirInstTable {
        op: Vec::new<i32>(),
        dest: Vec::new<i32>(),
        arg0: Vec::new<i32>(),
        arg1: Vec::new<i32>(),
        int_val: Vec::new<i32>(),
        float_val: Vec::new<i32>(),
        string_pool: string_pool,
        metadata: Vec::new<i32>(),
        result_type_starts: Vec::new<i32>(),
        result_type_counts: Vec::new<i32>(),
        result_type_ids: Vec::new<i32>(),
        result_type_reprs: Vec::new<i32>(),
        result_type_nullabilities: Vec::new<i32>(),
    }
}

fn mir_inst_table_intern(
    mut table: MirInstTable,
    op: i32,
    dest: i32,
    arg0: i32,
    arg1: i32,
    int_val: i32,
    float_val: f64,
    str_val: String,
    val_type: i32,
    func_id_raw: i32,
    result_types: Vec<MirValueType>
) -> i32 {
    let hid = table.op.len()
    table.op.push(op)
    table.dest.push(dest)
    table.arg0.push(arg0)
    table.arg1.push(arg1)
    table.int_val.push(int_val)
    mir_inst_table_append_float(table.float_val, float_val)
    let string_id = mir_inst_table_string_id(table, str_val)
    table.metadata.push(string_id)
    table.metadata.push(val_type)
    table.metadata.push(func_id_raw)
    mir_inst_table_append_result_types(table, result_types)
    hid
}

fn mir_inst_table_intern_with_str_id(
    mut table: MirInstTable,
    op: i32,
    dest: i32,
    arg0: i32,
    arg1: i32,
    int_val: i32,
    float_val: f64,
    string_id: i32,
    val_type: i32,
    func_id_raw: i32,
    result_types: Vec<MirValueType>
) -> i32 {
    let hid = table.op.len()
    table.op.push(op)
    table.dest.push(dest)
    table.arg0.push(arg0)
    table.arg1.push(arg1)
    table.int_val.push(int_val)
    mir_inst_table_append_float(table.float_val, float_val)
    table.metadata.push(string_id)
    table.metadata.push(val_type)
    table.metadata.push(func_id_raw)
    mir_inst_table_append_result_types(table, result_types)
    hid
}

fn mir_inst_table_append_float(mut values: Vec<i32>, value: f64) {
    let bits = MirFloatBits_new(value)
    mir_inst_table_append_float_bits(values, bits)
}

fn mir_inst_table_append_float_bits(mut values: Vec<i32>, bits: MirFloatBits) {
    values.push(mir_float_bits_lo(bits))
    values.push(mir_float_bits_hi(bits))
}

fn mir_inst_table_append_result_types(mut table: MirInstTable, result_types: Vec<MirValueType>) {
    table.result_type_starts.push(table.result_type_ids.len())
    table.result_type_counts.push(result_types.len())
    let mut i = 0
    while i < result_types.len() {
        let value_type = get_unchecked(result_types, i)
        table.result_type_ids.push(type_id::TypeId_raw(mir_value_type::mir_value_type_type_id(value_type)))
        table.result_type_reprs.push(mir_value_type::mir_value_type_repr(value_type))
        table.result_type_nullabilities.push(mir_value_type::mir_value_type_nullability(value_type))
        i = i + 1
    }
}

fn mir_inst_table_intern_with_scalar_result(
    mut table: MirInstTable,
    op: i32,
    dest: i32,
    arg0: i32,
    arg1: i32,
    int_val: i32,
    float_val: f64,
    str_val: String,
    val_type: i32,
    func_id_raw: i32,
    result_type_count: i32,
    result_type_id_raw: i32,
    result_type_repr: i32,
    result_type_nullability: i32
) -> i32 {
    let hid = table.op.len()
    table.op.push(op)
    table.dest.push(dest)
    table.arg0.push(arg0)
    table.arg1.push(arg1)
    table.int_val.push(int_val)
    mir_inst_table_append_float(table.float_val, float_val)
    let string_id = mir_inst_table_string_id(table, str_val)
    table.metadata.push(string_id)
    table.metadata.push(val_type)
    table.metadata.push(func_id_raw)
    mir_inst_table_append_scalar_result_type(
        table,
        result_type_count,
        result_type_id_raw,
        result_type_repr,
        result_type_nullability
    )
    hid
}

fn mir_inst_table_intern_with_str_id_scalar_result(
    mut table: MirInstTable,
    op: i32,
    dest: i32,
    arg0: i32,
    arg1: i32,
    int_val: i32,
    float_val: f64,
    string_id: i32,
    val_type: i32,
    func_id_raw: i32,
    result_type_count: i32,
    result_type_id_raw: i32,
    result_type_repr: i32,
    result_type_nullability: i32
) -> i32 {
    let hid = table.op.len()
    table.op.push(op)
    table.dest.push(dest)
    table.arg0.push(arg0)
    table.arg1.push(arg1)
    table.int_val.push(int_val)
    mir_inst_table_append_float(table.float_val, float_val)
    table.metadata.push(string_id)
    table.metadata.push(val_type)
    table.metadata.push(func_id_raw)
    mir_inst_table_append_scalar_result_type(
        table,
        result_type_count,
        result_type_id_raw,
        result_type_repr,
        result_type_nullability
    )
    hid
}

fn mir_inst_table_intern_with_str_id_scalar_result_bits(
    mut table: MirInstTable,
    op: i32,
    dest: i32,
    arg0: i32,
    arg1: i32,
    int_val: i32,
    float_bits: MirFloatBits,
    string_id: i32,
    val_type: i32,
    func_id_raw: i32,
    result_type_count: i32,
    result_type_id_raw: i32,
    result_type_repr: i32,
    result_type_nullability: i32
) -> i32 {
    let hid = table.op.len()
    table.op.push(op)
    table.dest.push(dest)
    table.arg0.push(arg0)
    table.arg1.push(arg1)
    table.int_val.push(int_val)
    mir_inst_table_append_float_bits(table.float_val, float_bits)
    table.metadata.push(string_id)
    table.metadata.push(val_type)
    table.metadata.push(func_id_raw)
    mir_inst_table_append_scalar_result_type(
        table,
        result_type_count,
        result_type_id_raw,
        result_type_repr,
        result_type_nullability
    )
    hid
}

fn mir_inst_table_intern_with_str_id_bits(
    mut table: MirInstTable,
    op: i32,
    dest: i32,
    arg0: i32,
    arg1: i32,
    int_val: i32,
    float_bits: MirFloatBits,
    string_id: i32,
    val_type: i32,
    func_id_raw: i32,
    result_types: Vec<MirValueType>
) -> i32 {
    let hid = table.op.len()
    table.op.push(op)
    table.dest.push(dest)
    table.arg0.push(arg0)
    table.arg1.push(arg1)
    table.int_val.push(int_val)
    mir_inst_table_append_float_bits(table.float_val, float_bits)
    table.metadata.push(string_id)
    table.metadata.push(val_type)
    table.metadata.push(func_id_raw)
    mir_inst_table_append_result_types(table, result_types)
    hid
}

fn mir_inst_table_append_scalar_result_type(
    mut table: MirInstTable,
    result_type_count: i32,
    result_type_id_raw: i32,
    result_type_repr: i32,
    result_type_nullability: i32
) {
    table.result_type_starts.push(table.result_type_ids.len())
    table.result_type_counts.push(result_type_count)
    if result_type_count <= 0 {
        return
    }
    table.result_type_ids.push(result_type_id_raw)
    table.result_type_reprs.push(result_type_repr)
    table.result_type_nullabilities.push(result_type_nullability)
}

fn mir_inst_table_op(table: MirInstTable, hid: i32) -> i32 {
    get_unchecked(table.op, hid)
}

fn mir_inst_table_dest(table: MirInstTable, hid: i32) -> i32 {
    get_unchecked(table.dest, hid)
}

fn mir_inst_table_arg0(table: MirInstTable, hid: i32) -> i32 {
    get_unchecked(table.arg0, hid)
}

fn mir_inst_table_arg1(table: MirInstTable, hid: i32) -> i32 {
    get_unchecked(table.arg1, hid)
}

fn mir_inst_table_int_val(table: MirInstTable, hid: i32) -> i32 {
    get_unchecked(table.int_val, hid)
}

fn mir_inst_table_float_val(table: MirInstTable, hid: i32) -> f64 {
    let offset = hid * 2
    let bits = MirFloatBits_from_parts(
        get_unchecked(table.float_val, offset),
        get_unchecked(table.float_val, offset + 1)
    )
    mir_float_bits_value(bits)
}

fn mir_inst_table_count(table: MirInstTable) -> i32 {
    table.op.len()
}

// Reuse one decoded table across function-at-a-time emission. Truncating the
// columns keeps their capacity while releasing the previous function's
// handles and scalar values before the next body is decoded.
fn mir_inst_table_reset(mut table: MirInstTable) {
    while table.op.len() > 0 { table.op.pop() }
    while table.dest.len() > 0 { table.dest.pop() }
    while table.arg0.len() > 0 { table.arg0.pop() }
    while table.arg1.len() > 0 { table.arg1.pop() }
    while table.int_val.len() > 0 { table.int_val.pop() }
    while table.float_val.len() > 0 { table.float_val.pop() }
    while table.metadata.len() > 0 { table.metadata.pop() }
    while table.result_type_starts.len() > 0 { table.result_type_starts.pop() }
    while table.result_type_counts.len() > 0 { table.result_type_counts.pop() }
    while table.result_type_ids.len() > 0 { table.result_type_ids.pop() }
    while table.result_type_reprs.len() > 0 { table.result_type_reprs.pop() }
    while table.result_type_nullabilities.len() > 0 { table.result_type_nullabilities.pop() }
}

fn mir_inst_table_set_string_pool(mut table: MirInstTable, string_pool: Vec<String>) {
    table.string_pool = string_pool
}

fn mir_inst_table_str_val(table: MirInstTable, hid: i32) -> String {
    let string_id = get_unchecked(table.metadata, hid * 3)
    if string_id < 0 || string_id >= table.string_pool.len() {
        return String_new()
    }
    get_unchecked(table.string_pool, string_id).clone()
}

fn mir_inst_table_str_id(table: MirInstTable, hid: i32) -> i32 {
    get_unchecked(table.metadata, hid * 3)
}

fn mir_inst_table_val_type(table: MirInstTable, hid: i32) -> i32 {
    get_unchecked(table.metadata, hid * 3 + 1)
}

fn mir_inst_table_func_id_raw(table: MirInstTable, hid: i32) -> i32 {
    get_unchecked(table.metadata, hid * 3 + 2)
}

fn mir_inst_table_result_types(table: MirInstTable, hid: i32) -> Vec<MirValueType> {
    let mut result = Vec::new<MirValueType>()
    let start = get_unchecked(table.result_type_starts, hid)
    let count = get_unchecked(table.result_type_counts, hid)
    let mut i = 0
    while i < count {
        result.push(MirValueType_new_from_columns(
                get_unchecked(table.result_type_ids, start + i),
                get_unchecked(table.result_type_reprs, start + i),
                get_unchecked(table.result_type_nullabilities, start + i)
            ))
        i = i + 1
    }
    result
}

fn mir_inst_table_result_type_count(table: MirInstTable, hid: i32) -> i32 {
    get_unchecked(table.result_type_counts, hid)
}

fn mir_inst_table_result_type_at(table: MirInstTable, hid: i32, index: i32) -> MirValueType {
    let start = get_unchecked(table.result_type_starts, hid)
    MirValueType_new_from_columns(
        get_unchecked(table.result_type_ids, start + index),
        get_unchecked(table.result_type_reprs, start + index),
        get_unchecked(table.result_type_nullabilities, start + index)
    )
}

fn MirValueType_new_from_columns(type_id_raw: i32, repr: i32, nullability: i32) -> MirValueType {
    mir_value_type::MirValueType_new(type_id::TypeId_new(type_id_raw), repr, nullability)
}

fn mir_inst_table_set_dest(mut table: MirInstTable, hid: i32, dest: i32) {
    table.dest.set(hid, dest)
}

fn mir_inst_table_set_arg0(mut table: MirInstTable, hid: i32, arg0: i32) {
    table.arg0.set(hid, arg0)
}

fn mir_inst_table_set_arg1(mut table: MirInstTable, hid: i32, arg1: i32) {
    table.arg1.set(hid, arg1)
}

fn mir_inst_table_set_str_val(mut table: MirInstTable, hid: i32, str_val: String) {
    let string_id = mir_inst_table_string_id(table, str_val)
    table.metadata.set(hid * 3, string_id)
}

fn mir_inst_table_set_str_id(mut table: MirInstTable, hid: i32, string_id: i32) {
    table.metadata.set(hid * 3, string_id)
}

fn mir_inst_table_string_id(mut table: MirInstTable, value: String) -> i32 {
    if value.len() == 0 {
        return 0 - 1
    }
    let mut i = 0
    while i < table.string_pool.len() {
        if get_unchecked(table.string_pool, i).clone().eq(value.clone()) {
            return i
        }
        i = i + 1
    }
    let string_id = table.string_pool.len()
    table.string_pool.push(value)
    string_id
}

fn mir_inst_table_set_func_id_raw(mut table: MirInstTable, hid: i32, func_id_raw: i32) {
    table.metadata.set(hid * 3 + 2, func_id_raw)
}

fn mir_inst_table_set_result_types(mut table: MirInstTable, hid: i32, result_types: Vec<MirValueType>) {
    let old_start = get_unchecked(table.result_type_starts, hid)
    let old_count = get_unchecked(table.result_type_counts, hid)
    let new_count = result_types.len()
    if old_count == new_count {
        let mut i = 0
        while i < new_count {
            let value_type = get_unchecked(result_types, i)
            table.result_type_ids.set(old_start + i, type_id::TypeId_raw(mir_value_type::mir_value_type_type_id(value_type)))
            table.result_type_reprs.set(old_start + i, mir_value_type::mir_value_type_repr(value_type))
            table.result_type_nullabilities.set(old_start + i, mir_value_type::mir_value_type_nullability(value_type))
            i = i + 1
        }
        return
    }
    table.result_type_starts.set(hid, table.result_type_ids.len())
    table.result_type_counts.set(hid, new_count)
    let mut i = 0
    while i < new_count {
        let value_type = get_unchecked(result_types, i)
        table.result_type_ids.push(type_id::TypeId_raw(mir_value_type::mir_value_type_type_id(value_type)))
        table.result_type_reprs.push(mir_value_type::mir_value_type_repr(value_type))
        table.result_type_nullabilities.push(mir_value_type::mir_value_type_nullability(value_type))
        i = i + 1
    }
}

fn mir_inst_table_set_val_type(mut table: MirInstTable, hid: i32, val_type: i32) {
    table.metadata.set(hid * 3 + 1, val_type)
}
