    table: MirInstTable,
    op: i32,
    dest: i32,
    arg0: i32,
    arg1: i32,
    int_val: i32,
    float_val: f64,
    string_id: i32,
    val_type: i32,
    func_id_raw: i32,
    result_type_count: i32,
    result_type_id_raw: i32,
    result_type_repr: i32,
    result_type_nullability: i32
) -> i32 {
    let hid = len(table.op)
    push(table.op, op)
    push(table.dest, dest)
    push(table.arg0, arg0)
    push(table.arg1, arg1)
    push(table.int_val, int_val)
    mir_inst_table_append_float(table.float_val, float_val)
    push(table.metadata, string_id)
    push(table.metadata, val_type)
    push(table.metadata, func_id_raw)
    mir_inst_table_append_scalar_result_type(
        table,
        result_type_count,
        result_type_id_raw,
        result_type_repr,
        result_type_nullability
    )
    hid
}

pub fn mir_inst_table_intern_with_str_id_scalar_result_bits(
    table: MirInstTable,
    op: i32,
    dest: i32,
    arg0: i32,
    arg1: i32,
    int_val: i32,
    float_bits: MirFloatBits,
    string_id: i32,
    val_type: i32,
    func_id_raw: i32,
    result_type_count: i32,
    result_type_id_raw: i32,
    result_type_repr: i32,
    result_type_nullability: i32
) -> i32 {
    let hid = len(table.op)
    push(table.op, op)
    push(table.dest, dest)
    push(table.arg0, arg0)
    push(table.arg1, arg1)
    push(table.int_val, int_val)
    mir_inst_table_append_float_bits(table.float_val, float_bits)
    push(table.metadata, string_id)
    push(table.metadata, val_type)
    push(table.metadata, func_id_raw)
    mir_inst_table_append_scalar_result_type(
        table,
        result_type_count,
        result_type_id_raw,
        result_type_repr,
        result_type_nullability
