use mir::block_inst_mutation
use mir::function_core_record
use mir::types

fn MirFunction_next_block(f: MirFunction) -> i32 {
    f.next_block
}

fn MirFunction_increment_next_block(f: MirFunction) {
    f.next_block = f.next_block + 1
}

fn MirFunction_push_block(f: MirFunction, block: MirBlock) {
    push(f.blocks, block)
}

fn MirFunction_set_blocks(f: MirFunction, blocks: Vec<MirBlock>) {
    f.blocks = blocks
}

fn MirFunction_release_body(f: MirFunction) {
    // Keep the MirBlock objects and SoA capacity when no module pool is
    // present. Emit uses mir_function_detach_blocks after the body is written.
    let n = len(f.blocks)
    let mut i = 0
    while i < n {
        block_inst_mutation::mir_block_clear_insts(get_unchecked(f.blocks, i))
        i = i + 1
    }
}
