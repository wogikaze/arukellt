use std::prelude::{clone, eq}
use mir::module_record
fn MirModule_gc_enum_variant_sig_count(m: MirModule) -> i32 {
    len(m.gc_enum_variant_sigs)
}

fn MirModule_gc_enum_variant_sig_at(m: MirModule, idx: i32) -> String {
    clone(get_unchecked(m.gc_enum_variant_sigs, idx))
}

fn MirModule_gc_enum_variant_name_at(m: MirModule, idx: i32) -> String {
    clone(get_unchecked(m.gc_enum_variant_names, idx))
}

fn MirModule_gc_enum_variant_names(m: MirModule) -> Vec<String> {
    m.gc_enum_variant_names
}

fn MirModule_gc_enum_variant_sigs(m: MirModule) -> Vec<String> {
    m.gc_enum_variant_sigs
}

fn MirModule_push_gc_enum_variant(mut m: MirModule, name: String, sig: String) {
    push(m.gc_enum_variant_names, name)
    push(m.gc_enum_variant_sigs, sig)
    push(m.gc_enum_variant_canon_idx, 0 - 1)
    // The emit-side derived indexes key off name arrivals too, not just
    // canon assignments, so pushes bump the same version (#851).
    m.gc_canon_version = m.gc_canon_version + 1
}

fn MirModule_gc_enum_variant_canon_idx_at(m: MirModule, slot: i32) -> i32 {
    if slot < 0 || slot >= len(m.gc_enum_variant_canon_idx) {
        return 0 - 1
    }
    get_unchecked(m.gc_enum_variant_canon_idx, slot)
}

fn MirModule_set_gc_enum_variant_canon_idx(mut m: MirModule, slot: i32, canon_idx: i32) {
    if slot < 0 || slot >= len(m.gc_enum_variant_canon_idx) {
        return
    }
    // Count only the -1 -> final transition: emit-side derived indexes
    // rebuild on version bumps (#851), and re-setting the same final
    // value must not masquerade as new canon state.
    if canon_idx >= 0 && get_unchecked(m.gc_enum_variant_canon_idx, slot) < 0 {
        m.gc_canon_version = m.gc_canon_version + 1
    }
    set(m.gc_enum_variant_canon_idx, slot, canon_idx)
}

fn MirModule_gc_enum_variant_canon_idxs(m: MirModule) -> Vec<i32> {
    m.gc_enum_variant_canon_idx
}

fn MirModule_gc_enum_variant_slot(m: MirModule, name: String) -> i32 {
    let count = MirModule_gc_enum_variant_sig_count(m)
    let mut i = 0
    while i < count {
        if eq(MirModule_gc_enum_variant_name_at(m, i), clone(name)) {
            return i
        }
        i = i + 1
    }
    0 - 1
}
