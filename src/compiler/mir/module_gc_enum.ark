use std::prelude::{clone, eq}
use std::text
use corehir::name_match
use mir::module_record
fn MirModule_gc_enum_variant_sig_count(m: MirModule) -> i32 {
    len(m.gc_enum_variant_sigs)
}

fn MirModule_gc_enum_variant_sig_at(m: MirModule, idx: i32) -> String {
    clone(get_unchecked(m.gc_enum_variant_sigs, idx))
}

fn MirModule_gc_enum_variant_name_at(m: MirModule, idx: i32) -> String {
    clone(get_unchecked(m.gc_enum_variant_names, idx))
}

fn MirModule_gc_enum_variant_names(m: MirModule) -> Vec<String> {
    m.gc_enum_variant_names
}

fn MirModule_gc_enum_variant_sigs(m: MirModule) -> Vec<String> {
    m.gc_enum_variant_sigs
}

fn MirModule_push_gc_enum_variant(mut m: MirModule, name: String, sig: String) {
    push(m.gc_enum_variant_names, name)
    push(m.gc_enum_variant_sigs, sig)
    push(m.gc_enum_variant_canon_idx, 0 - 1)
    // The emit-side derived indexes key off name arrivals too, not just
    // canon assignments, so pushes bump the same version (#851).
    m.gc_canon_version = m.gc_canon_version + 1
}

fn MirModule_gc_enum_variant_canon_idx_at(m: MirModule, slot: i32) -> i32 {
    if slot < 0 || slot >= len(m.gc_enum_variant_canon_idx) {
        return 0 - 1
    }
    get_unchecked(m.gc_enum_variant_canon_idx, slot)
}

fn MirModule_set_gc_enum_variant_canon_idx(mut m: MirModule, slot: i32, canon_idx: i32) {
    if slot < 0 || slot >= len(m.gc_enum_variant_canon_idx) {
        return
    }
    // Count only the -1 -> final transition: emit-side derived indexes
    // rebuild on version bumps (#851), and re-setting the same final
    // value must not masquerade as new canon state.
    if canon_idx >= 0 && get_unchecked(m.gc_enum_variant_canon_idx, slot) < 0 {
        m.gc_canon_version = m.gc_canon_version + 1
    }
    set(m.gc_enum_variant_canon_idx, slot, canon_idx)
}

fn MirModule_gc_enum_variant_canon_idxs(m: MirModule) -> Vec<i32> {
    m.gc_enum_variant_canon_idx
}

fn MirModule_gc_enum_variant_slot(m: MirModule, name: String) -> i32 {
    let count = MirModule_gc_enum_variant_sig_count(m)
    let mut i = 0
    while i < count {
        if eq(MirModule_gc_enum_variant_name_at(m, i), clone(name)) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// Whether a registered variant belongs to this enum base. Registered enum
// variants are the module's nominal-enum table, so a one-uppercase base is
// still a declared enum rather than a name-shaped type variable (ADR-089).
//
// `typed_mvt_sig` runs this per variant per type, so the `"enum:"` prefix or
// `"::"+base+"::"` pattern is matched in place instead of rebuilding both
// strings; the allocations were a top GC-churn source in the overlay profile.
fn MirModule_gc_enum_name_has_enum_prefix(enum_name: String) -> bool {
    len(enum_name) >= 5 &&
    enum_name.byte_at(0) == 101 &&
    enum_name.byte_at(1) == 110 &&
    enum_name.byte_at(2) == 117 &&
    enum_name.byte_at(3) == 109 &&
    enum_name.byte_at(4) == 58
}

fn MirModule_gc_enum_variant_matches(enum_name: String, variant_name: String) -> bool {
    let base_start = if MirModule_gc_enum_name_has_enum_prefix(enum_name) { 5 } else { 0 }
    let base_len = len(enum_name) - base_start
    if base_len <= 0 {
        return false
    }
    let variant_len = len(variant_name)
    if variant_len >= base_len + 2 &&
    name_match::name_region_equal(variant_name, 0, enum_name, base_start, base_len) &&
    variant_name.byte_at(base_len) == 58 &&
    variant_name.byte_at(base_len + 1) == 58 {
        return true
    }
    let pattern_len = 2 + base_len + 2
    let mut i = 0
    while i + pattern_len <= variant_len {
        if variant_name.byte_at(i) == 58 &&
        variant_name.byte_at(i + 1) == 58 &&
        name_match::name_region_equal(variant_name, i + 2, enum_name, base_start, base_len) &&
        variant_name.byte_at(i + 2 + base_len) == 58 &&
        variant_name.byte_at(i + 3 + base_len) == 58 {
            return true
        }
        i = i + 1
    }
    false
}

fn MirModule_gc_enum_base_has_variants(m: MirModule, type_name: String) -> bool {
    let count = MirModule_gc_enum_variant_sig_count(m)
    let mut i = 0
    while i < count {
        if MirModule_gc_enum_variant_matches(type_name, MirModule_gc_enum_variant_name_at(m, i)) {
            return true
        }
        i = i + 1
    }
    false
}
