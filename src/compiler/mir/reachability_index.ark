use collections::name_index
use corehir::function_id
use corehir::signature_registry
use mir::function_identity
use mir::module_spine
use resolver

// Explicit FunctionId.raw → MirFunction index. Never assume raw == mir index:
// SignatureRegistry also holds core-op aliases without Mir bodies (#823).
struct MirReachabilityIndex {
    name_to_mir: NameIndex,
    fid_to_mir: Vec<i32>,
}

fn mir_reachability_index_bind_fid(
    m: MirModule,
    mut fid_to_mir: Vec<i32>,
    fname: String,
    fi: i32,
    ordinal: i32,
    fid_chain_head: NameIndex,
    fid_chain_next: Vec<i32>
) {
    if !module_spine::MirModule_signature_spine_populated(m) {
        return
    }
    // Walk the prebuilt name chain ordinal steps -- the old code scanned
    // the whole registry once per pushed function (#851).
    let mut slot = name_index::name_index_get(fid_chain_head, fname.clone())
    let mut step = ordinal
    while step > 0 && slot >= 0 {
        slot = get_unchecked(fid_chain_next, slot)
        step = step - 1
    }
    let fid = if slot >= 0 {
        function_id::FunctionId_new(slot)
    } else {
        function_id::FUNCTION_ID_INVALID()
    }
    if !function_id::function_id_is_valid(fid) {
        return
    }
    let raw = function_id::FunctionId_raw(fid)
    if raw < 0 || raw >= len(fid_to_mir) {
        return
    }
    // First MirFunction wins if aliases collide.
    if get_unchecked(fid_to_mir, raw) >= 0 {
        return
    }
    set(fid_to_mir, raw, fi)
}

fn mir_reachability_index_bind_name(mut name_to_mir: NameIndex, fname: String, fi: i32) {
    name_index::name_index_insert_first(name_to_mir, fname.clone(), fi)
    let short = resolver::use_module_short_name(fname.clone())
    if !short.clone().eq(fname.clone()) {
        name_index::name_index_insert_first(name_to_mir, short, fi)
    }
}

fn mir_reachability_index_build(m: MirModule, functions: Vec<MirFunction>) -> MirReachabilityIndex {
    let fn_count = len(functions)
    let mut name_to_mir = name_index::NameIndex_new(fn_count + fn_count)
    let mut fid_to_mir = Vec::new<i32>()
    let mut registry_count = 0
    // Name -> ordered chain of non-signature-only registry slots, plus
    // per-name ordinal counters: the old helpers re-scanned functions
    // [0..fi) and the whole registry per fn, which made the build
    // O(fns x registry) (#851). Chains preserve registry order via a
    // head+tail pair so the ordinal-th entry matches the old scan.
    let mut fid_chain_head = name_index::NameIndex_new(0)
    let mut fid_chain_tail = name_index::NameIndex_new(0)
    let mut fid_chain_next = Vec::new<i32>()
    let mut ordinal_counts = name_index::NameIndex_new(0)
    if module_spine::MirModule_signature_spine_populated(m) {
        let registry = module_spine::MirModule_signature_registry(m)
        registry_count = signature_registry::signature_registry_entry_count(registry)
        let mut ri = 0
        while ri < registry_count {
            if signature_registry::signature_registry_is_signature_only(registry, ri) {
                push(fid_chain_next, 0 - 1)
            } else {
                let rname = signature_registry::signature_registry_mangled_at(registry, ri)
                let tail = name_index::name_index_get(fid_chain_tail, rname.clone())
                push(fid_chain_next, 0 - 1)
                if tail < 0 {
                    name_index::name_index_set(fid_chain_head, rname.clone(), ri)
                } else {
                    set(fid_chain_next, tail, ri)
                }
                name_index::name_index_set(fid_chain_tail, rname, ri)
            }
            ri = ri + 1
        }
    }
    let mut si = 0
    while si < registry_count {
        push(fid_to_mir, 0 - 1)
        si = si + 1
    }
    let mut fi = 0
    while fi < fn_count {
        let f = get_unchecked(functions, fi)
        let fname = function_identity::MirFunction_name(f)
        mir_reachability_index_bind_name(name_to_mir, fname.clone(), fi)
        let mut ordinal = name_index::name_index_get(ordinal_counts, fname.clone())
        if ordinal < 0 {
            ordinal = 0
        }
        name_index::name_index_set(ordinal_counts, fname.clone(), ordinal + 1)
        mir_reachability_index_bind_fid(
            m,
            fid_to_mir,
            fname,
            fi,
            ordinal,
            fid_chain_head,
            fid_chain_next
        )
        fi = fi + 1
    }
    MirReachabilityIndex { name_to_mir: name_to_mir, fid_to_mir: fid_to_mir }
}

fn mir_reachability_lookup_by_func_id(index: MirReachabilityIndex, func_id_raw: i32) -> i32 {
    if func_id_raw < 0 || func_id_raw >= len(index.fid_to_mir) {
        return 0 - 1
    }
    get_unchecked(index.fid_to_mir, func_id_raw)
}

fn mir_reachability_try_enqueue(mut reachable: Vec<i32>, mut queue: Vec<i32>, mir_index: i32) -> bool {
    if mir_index < 0 || mir_index >= len(reachable) {
        return false
    }
    if get_unchecked(reachable, mir_index) != 0 {
        return false
    }
    set(reachable, mir_index, 1)
    push(queue, mir_index)
    true
}

fn mir_reachability_enqueue_by_func_id(
    index: MirReachabilityIndex,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    func_id_raw: i32
) -> bool {
    let mir_index = mir_reachability_lookup_by_func_id(index, func_id_raw)
    mir_reachability_try_enqueue(reachable, queue, mir_index)
}

fn mir_reachability_enqueue_by_name_exact(
    index: MirReachabilityIndex,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    name: String
) -> bool {
    let exact = name_index::name_index_get(index.name_to_mir, name)
    if exact < 0 {
        return false
    }
    mir_reachability_try_enqueue(reachable, queue, exact)
}

// Exact NameIndex hit first; short-name fallback scans all Mir names (rare path).
fn mir_reachability_enqueue_by_name(
    index: MirReachabilityIndex,
    functions: Vec<MirFunction>,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    name: String
) -> bool {
    let exact = name_index::name_index_get(index.name_to_mir, name.clone())
    if exact >= 0 {
        return mir_reachability_try_enqueue(reachable, queue, exact)
    }
    let short = resolver::use_module_short_name(name.clone())
    if short.clone().eq(name.clone()) {
        return false
    }
    let short_hit = name_index::name_index_get(index.name_to_mir, short)
    if short_hit < 0 {
        return false
    }
    mir_reachability_try_enqueue(reachable, queue, short_hit)
}
