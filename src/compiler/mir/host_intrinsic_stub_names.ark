fn host_intrinsic_stub_count() -> i32 {
    // read_to_string / write_string / write_bytes are stdlib wrappers that
    // call __intrinsic_fs_* — do not treat them as GC unreachable stubs
    // (that collided with std::host::fs and left fs_read_* validate-fail).
    21
}

fn host_intrinsic_stub_name_at(index: i32) -> String {
    if index == 0 { return "args" }
    if index == 1 { return "arg_at" }
    if index == 2 { return "var" }
    if index == 3 { return "get_var" }
    if index == 4 { return "var_or_default" }
    if index == 5 { return "read_stdin" }
    if index == 6 { return "read_dir" }
    if index == 7 { return "metadata" }
    if index == 8 { return "is_readable_file" }
    if index == 9 { return "exists" }
    if index == 10 { return "is_file" }
    if index == 11 { return "is_dir" }
    if index == 12 { return "connect" }
    if index == 13 { return "read" }
    if index == 14 { return "write" }
    if index == 15 { return "listen" }
    if index == 16 { return "accept" }
    if index == 17 { return "get" }
    if index == 18 { return "request" }
    if index == 19 { return "serve" }
    if index == 20 { return "clock_now" }
    String_new()
}

fn host_intrinsic_stub_is_known(name: String) -> bool {
    let count = host_intrinsic_stub_count()
    let mut i = 0
    while i < count {
        if eq(clone(name), host_intrinsic_stub_name_at(i)) {
            return true
        }
        i = i + 1
    }
    false
}
