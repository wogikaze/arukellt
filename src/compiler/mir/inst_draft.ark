use corehir::mir_value_type
use mir::typed_mir_compat

pub struct MirInstDraft {
    op: i32,
    dest: i32,
    arg0: i32,
    arg1: i32,
    int_val: i32,
    float_val: f64,
    str_val: String,
    val_type: i32,
    result_types: Vec<MirValueType>,
    func_id_raw: i32,
}

fn MirInstDraft_new_full(
    op: i32,
    dest: i32,
    arg0: i32,
    arg1: i32,
    int_val: i32,
    float_val: f64,
    str_val: String,
    val_type: i32
) -> MirInstDraft {
    MirInstDraft {
        op: op,
        dest: dest,
        arg0: arg0,
        arg1: arg1,
        int_val: int_val,
        float_val: float_val,
        str_val: str_val,
        val_type: val_type,
        result_types: typed_mir_compat::result_types_from_legacy_vt(val_type),
        func_id_raw: 0 - 1,
    }
}

fn MirInstDraft_op(inst: MirInstDraft) -> i32 { inst.op }
fn MirInstDraft_dest(inst: MirInstDraft) -> i32 { inst.dest }
fn MirInstDraft_arg0(inst: MirInstDraft) -> i32 { inst.arg0 }
fn MirInstDraft_arg1(inst: MirInstDraft) -> i32 { inst.arg1 }
fn MirInstDraft_int_val(inst: MirInstDraft) -> i32 { inst.int_val }
fn MirInstDraft_float_val(inst: MirInstDraft) -> f64 { inst.float_val }
fn MirInstDraft_str_val(inst: MirInstDraft) -> String { clone(inst.str_val) }
fn MirInstDraft_val_type(inst: MirInstDraft) -> i32 { inst.val_type }
fn MirInstDraft_func_id_raw(inst: MirInstDraft) -> i32 { inst.func_id_raw }
fn MirInstDraft_result_types(inst: MirInstDraft) -> Vec<MirValueType> { inst.result_types }
fn MirInstDraft_result_type_count(inst: MirInstDraft) -> i32 { len(inst.result_types) }
fn MirInstDraft_result_type_at(inst: MirInstDraft, index: i32) -> MirValueType {
    get_unchecked(inst.result_types, index)
}

fn MirInstDraft_with_func_id_raw(inst: MirInstDraft, func_id_raw: i32) -> MirInstDraft {
    inst.func_id_raw = func_id_raw
    inst
}

fn MirInstDraft_set_result_types(inst: MirInstDraft, result_types: Vec<MirValueType>) {
    inst.result_types = result_types
}

fn MirInstDraft_copy_with_locals(inst: MirInstDraft, dest: i32, arg0: i32, arg1: i32) -> MirInstDraft {
    inst.dest = dest
    inst.arg0 = arg0
    inst.arg1 = arg1
    inst
}

fn MirInstDraft_with_call_target(inst: MirInstDraft, callee: String, func_id_raw: i32) -> MirInstDraft {
    inst.str_val = callee
    inst.func_id_raw = func_id_raw
    inst
}
