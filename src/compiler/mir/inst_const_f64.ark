use mir::inst_factory
use mir::opcodes
use mir::types
use mir::value_types

fn MirInst_const_f64(val: f64, dest: i32) -> MirInst {
    inst_factory::MirInst_full(opcodes::MIR_CONST_F64(), dest, 0 - 1, 0 - 1, 0, val, String_new(), value_types::VT_F64())
}

fn MirInst_const_f32(val: f64, dest: i32) -> MirInst {
    // Reuse MIR_CONST_F64 opcode; emitter selects f32.const from val_type.
    inst_factory::MirInst_full(opcodes::MIR_CONST_F64(), dest, 0 - 1, 0 - 1, 0, val, String_new(), value_types::VT_F32())
}
