use corehir::mir_value_type
use corehir::type_id
use mir::block_record
use mir::inst_draft
use mir::inst_record
use mir::types
fn MirBlock_inst_count(block: MirBlock) -> i32 {
    block.inst_count
}

fn MirBlock_inst_op(block: MirBlock, idx: i32) -> i32 {
    block.ops.get_unchecked(idx)
}

fn MirBlock_inst_dest(block: MirBlock, idx: i32) -> i32 {
    block.dests.get_unchecked(idx)
}

fn MirBlock_inst_arg0(block: MirBlock, idx: i32) -> i32 {
    block.arg0s.get_unchecked(idx)
}

fn MirBlock_inst_arg1(block: MirBlock, idx: i32) -> i32 {
    block.arg1s.get_unchecked(idx)
}

fn MirBlock_inst_int_val(block: MirBlock, idx: i32) -> i32 {
    block.int_vals.get_unchecked(idx)
}

fn MirBlock_inst_float_val(block: MirBlock, idx: i32) -> f64 {
    block_record::mir_float_box_value(block.float_vals.get_unchecked(idx))
}

fn MirBlock_inst_val_type(block: MirBlock, idx: i32) -> i32 {
    block.val_types.get_unchecked(idx)
}

fn MirBlock_inst_func_id(block: MirBlock, idx: i32) -> i32 {
    block.func_ids.get_unchecked(idx)
}

fn MirBlock_inst_str_val(block: MirBlock, idx: i32) -> String {
    let str_id = block.str_ids.get_unchecked(idx)
    if str_id < 0 || str_id >= block.str_pool.len() {
        return String_new()
    }
    // See mir_inst_str_val: pooled names are returned without cloning.
    block.str_pool.get_unchecked(str_id)
}

fn MirBlock_inst_at(block: MirBlock, idx: i32) -> MirInst {
    inst_record::MirInst_ref(block, idx)
}

fn mir_block_export_packed_result(block: MirBlock, idx: i32) -> Vec<MirValueType> {
    // INV-1: never export a result type whose TypeId is invalid.
    let stored = block.type_ids.get_unchecked(idx)
    if !type_id::type_id_is_valid(type_id::TypeId_new(stored)) {
        return Vec::new<MirValueType>()
    }
    let mut result = Vec::new<MirValueType>()
    push(
        result,
        mir_value_type::MirValueType_new(
            type_id::TypeId_new(stored),
            block.type_reprs.get_unchecked(idx),
            block.type_nulls.get_unchecked(idx)
        )
    )
    result
}

fn mir_block_export_draft_body(block: MirBlock, idx: i32, text: String) -> MirInstDraft {
    inst_draft::MirInstDraft_new_full(
        MirBlock_inst_op(block, idx),
        MirBlock_inst_dest(block, idx),
        MirBlock_inst_arg0(block, idx),
        MirBlock_inst_arg1(block, idx),
        MirBlock_inst_int_val(block, idx),
        MirBlock_inst_float_val(block, idx),
        text,
        MirBlock_inst_val_type(block, idx)
    )
}

fn MirBlock_export_draft(block: MirBlock, idx: i32) -> MirInstDraft {
    let mut draft = mir_block_export_draft_body(block, idx, MirBlock_inst_str_val(block, idx))
    inst_draft::MirInstDraft_set_result_types(draft, mir_block_export_packed_result(block, idx))
    inst_draft::MirInstDraft_with_func_id_raw(draft, MirBlock_inst_func_id(block, idx))
}

fn MirBlock_export_drafts(block: MirBlock) -> Vec<MirInstDraft> {
    let mut out = Vec::new<MirInstDraft>()
    let n = MirBlock_inst_count(block)
    let mut i = 0
    while i < n {
        push(out, MirBlock_export_draft(block, i))
        i = i + 1
    }
    out
}

fn MirBlock_instructions(block: MirBlock) -> Vec<MirInst> {
    let mut out = Vec::new<MirInst>()
    let n = MirBlock_inst_count(block)
    let mut i = 0
    while i < n {
        push(out, inst_record::MirInst_ref(block, i))
        i = i + 1
    }
    out
}

fn MirInst_as_draft(inst: MirInst) -> MirInstDraft {
    MirBlock_export_draft(inst_record::mir_inst_home(inst), inst_record::mir_inst_index(inst))
}

fn MirBlock_drafts_from_refs(refs: Vec<MirInst>) -> Vec<MirInstDraft> {
    let mut out = Vec::new<MirInstDraft>()
    let n = refs.len()
    let mut i = 0
    while i < n {
        push(out, MirInst_as_draft(refs.get_unchecked(i)))
        i = i + 1
    }
    out
}
