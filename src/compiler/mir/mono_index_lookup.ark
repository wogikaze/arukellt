use mir::mono_index_types
fn mono_index_count(idx: MonoIndex, fn_name: String) -> i32 {
    let pos = mono_index_types::mono_index_name_pos(idx, fn_name.clone())
    if pos < 0 {
        return 0
    }
    mono_index_types::mono_index_count_at(idx, pos)
}

fn mono_index_mangled_at(idx: MonoIndex, fn_name: String, ordinal: i32) -> String {
    mono_index_types::mono_index_base_mangled_at(idx, fn_name, ordinal)
}
