use mir::reachability_index
use mir::types

fn mir_enqueue_reachable_name(
    index: MirReachabilityIndex,
    functions: Vec<MirFunction>,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    name: String
) -> bool {
    reachability_index::mir_reachability_enqueue_by_name(index, functions, reachable, queue, name)
}

fn mir_enqueue_reachable_name_exact(
    index: MirReachabilityIndex,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    name: String
) -> bool {
    reachability_index::mir_reachability_enqueue_by_name_exact(index, reachable, queue, name)
}
