use corehir::signature_registry
use corehir::type_table
use collections::name_index
use mir::emit_artifacts
use mir::block_record
use mir::function_core_record
use mir::gc_layout_plan
use mir::lower::mono_instance_table

pub struct MirModule {
    functions: Vec<MirFunction>,
    // Per-function metadata parallel to 'functions': the consistent variant
    // slot of each function's RETURN locals. Recorded when the function body
    // finishes lowering so post passes never rescan bodies for it
    // (#851 Phase 3: callee metadata must outlive the body MIR).
    return_variant_slots: Vec<i32>,
    // Pre-body discovery catalog: every decl-level fn name with its
    // enum-normalized declared return type name. Recorded at ctx_prep from
    // the fn_index so callee lookups can resolve functions whose bodies
    // are not lowered yet (#851 Phase 3: forward-callee metadata for
    // per-fn post passes).
    discovery_fn_names: Vec<String>,
    discovery_fn_ret_names: Vec<String>,
    export_names: Vec<String>,
    export_surface_set: bool,
    string_constants: Vec<String>,
    // Per-string packed data offset relative to the data section base,
    // maintained at push time so offsets are final at intern (#851 Phase 3
    // in-loop emit prerequisite). rel_i = 4 + sum_{j<i}(4+len_j); the wasm
    // emit layer adds DATA_START. string_data_next is the running
    // cumulative end = sum_j(4+len_j).
    string_data_rel: Vec<i32>,
    string_data_next: i32,
    mono_pruned_count: i32,
    gc_enum_variant_sigs: Vec<String>,
    gc_enum_variant_names: Vec<String>,
    gc_struct_sigs: Vec<String>,
    gc_struct_names: Vec<String>,
    // Name -> first slot in gc_struct_names. The type planner calls
    // MirModule_gc_struct_slot for every candidate spelling; a linear String
    // scan there was the largest eq caller in the overlay profile.
    // insert_first preserves the old "first registration wins" answer.
    gc_struct_slot_index: NameIndex,
    // Module-region split for the wasm type section (#851 Phase 3).
    // sealed_*_count is the number of gc struct / enum variant slots
    // registered by ctx_prep (before body lowering); -1 means the module was
    // built outside the lowering ctx and every slot is sealed. Slots
    // registered after the seal are "late" (enum payload variants, __fnpair,
    // tuple/aggregate structs) and their registration order is recorded in
    // late_gc_order as packed slot*2+kind entries (kind 0 = struct,
    // 1 = enum variant). The type section emits sealed types first, then
    // late types in this order, then every signature region — a forward
    // type reference is invalid outside a rec group, so this ordering keeps
    // every intra-module reference backward while still giving each late
    // type a final index that is fixed at registration time.
    sealed_gc_struct_count: i32,
    sealed_gc_enum_count: i32,
    late_gc_order: Vec<i32>,
    // Append-only canonical type table (#851 Phase 3). canon_sigs[i] is the
    // i-th distinct type signature in ensure order and canon_index maps sig
    // text to canon idx. For GC module types the ensure order matches the
    // emission order above, so a registered type's final index is stable;
    // signature-region entries may still shift and are resolved at emit
    // time like today.
    canon_sigs: Vec<String>,
    canon_index: NameIndex,
    // Per-slot canon idx for module GC entities, assigned at registration
    // (#851 Phase 3, sealed/late). gc_struct_canon_idx[slot] is the final
    // type-section index of gc_struct_names[slot] once ensured; -1 while
    // the late-registration push happened but ordered ensure has not run
    // yet (sealed entries ensure inline at flush, late entries ensure in
    // late_gc_order order). gc_canon_prefix_done marks the one-time
    // ensure of the fixed GC + typed-callback sig prefix every module GC
    // registration must follow — those sigs are what module GC field
    // types reference, so they must hold lower canon indices.
    gc_struct_canon_idx: Vec<i32>,
    gc_enum_variant_canon_idx: Vec<i32>,
    gc_canon_prefix_done: bool,
    // Monotonic version of module GC registration state (#851): bumped
    // by MirModule_push_gc_{struct,enum_variant} on each new name and by
    // the two MirModule_set_gc_*_canon_idx setters on each -1 -> final
    // transition, so emit-side derived indexes can rebuild only when the
    // state actually changed instead of on every pushed function.
    gc_canon_version: i32,
    gc_layout_plan: MirGcLayoutPlan,
    spine_populated: bool,
    type_table: TypeTable,
    signature_registry: SignatureRegistry,
    mono_instance_table: MonoInstanceTable,
    // Live count into block_pool. Walk 0..used only. No pop of Vec<MirBlock>.
    block_pool: Vec<MirBlock>,
    block_pool_used: i32,
    // Lower-phase diagnostics that must halt the pipeline before emit.
    // Payload binds whose type the emitter cannot recover record a
    // user-facing message here instead of emitting invalid core Wasm
    // (#906).
    diagnostics: Vec<String>,
    // Fused-emit handoff (#851 Phase 3): per-fn body bytes, reloc tables,
    // pair sigs, and audit counters produced when declared bodies emit
    // inside the lowering decl loop. Disabled in the legacy two-phase path.
    emit_artifacts: MirEmitArtifacts,
}

fn MirModule_new() -> MirModule {
    MirModule {
        functions: Vec::new<MirFunction>(),
        return_variant_slots: Vec::new<i32>(),
        discovery_fn_names: Vec::new<String>(),
        discovery_fn_ret_names: Vec::new<String>(),
        export_names: Vec::new<String>(),
        export_surface_set: false,
        string_constants: Vec::new<String>(),
        string_data_rel: Vec::new<i32>(),
        string_data_next: 0,
        mono_pruned_count: 0,
        gc_enum_variant_sigs: Vec::new<String>(),
        gc_enum_variant_names: Vec::new<String>(),
        gc_struct_sigs: Vec::new<String>(),
        gc_struct_names: Vec::new<String>(),
        gc_struct_slot_index: name_index::NameIndex_new(0),
        sealed_gc_struct_count: 0 - 1,
        sealed_gc_enum_count: 0 - 1,
        late_gc_order: Vec::new<i32>(),
        canon_sigs: Vec::new<String>(),
        canon_index: name_index::NameIndex_new(64),
        gc_struct_canon_idx: Vec::new<i32>(),
        gc_enum_variant_canon_idx: Vec::new<i32>(),
        gc_canon_prefix_done: false,
        gc_canon_version: 0,
        gc_layout_plan: gc_layout_plan::MirGcLayoutPlan_new(),
        spine_populated: false,
        type_table: type_table::TypeTable_new(),
        signature_registry: signature_registry::SignatureRegistry_new(),
        mono_instance_table: mono_instance_table::MonoInstanceTable_new(),
        block_pool: Vec::new<MirBlock>(),
        block_pool_used: 0,
        diagnostics: Vec::new<String>(),
        emit_artifacts: emit_artifacts::MirEmitArtifacts_disabled()
    }
}
