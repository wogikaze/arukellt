use corehir::signature_registry
use corehir::type_table
use mir::block_record
use mir::function_core_record
use mir::gc_layout_plan
use mir::lower::mono_instance_table

pub struct MirModule {
    functions: Vec<MirFunction>,
    // Per-function metadata parallel to 'functions': the consistent variant
    // slot of each function's RETURN locals. Recorded when the function body
    // finishes lowering so post passes never rescan bodies for it
    // (#851 Phase 3: callee metadata must outlive the body MIR).
    return_variant_slots: Vec<i32>,
    // Pre-body discovery catalog: every decl-level fn name with its
    // enum-normalized declared return type name. Recorded at ctx_prep from
    // the fn_index so callee lookups can resolve functions whose bodies
    // are not lowered yet (#851 Phase 3: forward-callee metadata for
    // per-fn post passes).
    discovery_fn_names: Vec<String>,
    discovery_fn_ret_names: Vec<String>,
    export_names: Vec<String>,
    export_surface_set: bool,
    string_constants: Vec<String>,
    mono_pruned_count: i32,
    gc_enum_variant_sigs: Vec<String>,
    gc_enum_variant_names: Vec<String>,
    gc_struct_sigs: Vec<String>,
    gc_struct_names: Vec<String>,
    gc_layout_plan: MirGcLayoutPlan,
    spine_populated: bool,
    type_table: TypeTable,
    signature_registry: SignatureRegistry,
    mono_instance_table: MonoInstanceTable,
    // Live count into block_pool. Walk 0..used only. No pop of Vec<MirBlock>.
    block_pool: Vec<MirBlock>,
    block_pool_used: i32,
    // Lower-phase diagnostics that must halt the pipeline before emit.
    // Payload binds whose type the emitter cannot recover record a
    // user-facing message here instead of emitting invalid core Wasm
    // (#906).
    diagnostics: Vec<String>,
}

fn MirModule_new() -> MirModule {
    MirModule {
        functions: Vec::new<MirFunction>(),
        return_variant_slots: Vec::new<i32>(),
        discovery_fn_names: Vec::new<String>(),
        discovery_fn_ret_names: Vec::new<String>(),
        export_names: Vec::new<String>(),
        export_surface_set: false,
        string_constants: Vec::new<String>(),
        mono_pruned_count: 0,
        gc_enum_variant_sigs: Vec::new<String>(),
        gc_enum_variant_names: Vec::new<String>(),
        gc_struct_sigs: Vec::new<String>(),
        gc_struct_names: Vec::new<String>(),
        gc_layout_plan: gc_layout_plan::MirGcLayoutPlan_new(),
        spine_populated: false,
        type_table: type_table::TypeTable_new(),
        signature_registry: signature_registry::SignatureRegistry_new(),
        mono_instance_table: mono_instance_table::MonoInstanceTable_new(),
        block_pool: Vec::new<MirBlock>(),
        block_pool_used: 0,
        diagnostics: Vec::new<String>()
    }
}
