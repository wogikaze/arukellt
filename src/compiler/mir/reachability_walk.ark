use mir::inst_accessors_shape
use mir::inst_accessors_literals
use mir::inst_record
use mir::block_inst_access
use mir::opcodes
use mir::function_block_queries
use mir::core_op_call
use mir::reachability_names
use mir::reachability_index
use mir::types
use corehir::core_op_binding
use corehir::core_op_id
use corehir::function_id
use corehir::signature_registry
use mir::module_spine
use wasm::hash_aliases

fn mir_edge_header_len() -> i32 {
    10
}

fn mir_edge_map_mark() -> i32 {
    0 - 8
}

fn mir_edge_intern_bias() -> i32 {
    1000000
}

fn mir_edge_ensure_i32_len(mut values: Vec<i32>, min_len: i32, fill: i32) {
    while values.len() < min_len {
        values.push(fill)
    }
}

// Packed table: [fn_count, recorded[fn_count], offset[fn_count+1], callees...]
fn mir_build_recorded_edge_lists(edges: Vec<i32>, fn_count: i32) -> Vec<i32> {
    let mut recorded = Vec::new<i32>()
    let mut counts = Vec::new<i32>()
    let mut fi = 0
    while fi < fn_count {
        recorded.push(0)
        counts.push(0)
        fi = fi + 1
    }
    let n = edges.len()
    let header = mir_edge_header_len()
    let mut packed = Vec::new<i32>()
    packed.push(fn_count)
    if n <= header || fn_count <= 0 {
        fi = 0
        while fi < fn_count {
            packed.push(0)
            fi = fi + 1
        }
        fi = 0
        while fi <= fn_count {
            packed.push(0)
            fi = fi + 1
        }
        return packed
    }
    let mut frame_to_mir = Vec::new<i32>()
    let mark = mir_edge_map_mark()
    let mut i = header
    while i < n {
        if edges.get_unchecked(i) == mark {
            if i + 2 >= n {
                i = n
            } else {
                let frame = edges.get_unchecked(i + 1)
                let mir = edges.get_unchecked(i + 2)
                if frame >= 0 {
                    mir_edge_ensure_i32_len(frame_to_mir, frame + 1, 0 - 1)
                    frame_to_mir.set(frame, mir)
                }
                if mir >= 0 && mir < fn_count {
                    recorded.set(mir, 1)
                }
                i = i + 3
            }
        } else {
            i = i + 2
        }
    }
    i = header
    while i < n {
        if edges.get_unchecked(i) == mark {
            if i + 2 >= n {
                i = n
            } else {
                i = i + 3
            }
        } else if i + 1 >= n {
            i = n
        } else {
            let frame = edges.get_unchecked(i)
            if frame >= 0 && frame < frame_to_mir.len() {
                let mir = frame_to_mir.get_unchecked(frame)
                if mir >= 0 && mir < fn_count {
                    recorded.set(mir, 1)
                    counts.set(mir, counts.get_unchecked(mir) + 1)
                }
            }
            i = i + 2
        }
    }
    fi = 0
    while fi < fn_count {
        packed.push(recorded.get_unchecked(fi))
        fi = fi + 1
    }
    let mut running = 1 + fn_count + fn_count + 1
    fi = 0
    while fi < fn_count {
        packed.push(running)
        running = running + counts.get_unchecked(fi)
        fi = fi + 1
    }
    packed.push(running)
    let mut cursor = Vec::new<i32>()
    fi = 0
    while fi < fn_count {
        cursor.push(packed.get_unchecked(1 + fn_count + fi))
        fi = fi + 1
    }
    i = header
    while i < n {
        if edges.get_unchecked(i) == mark {
            if i + 2 >= n {
                i = n
            } else {
                i = i + 3
            }
        } else if i + 1 >= n {
            i = n
        } else {
            let frame = edges.get_unchecked(i)
            let fid = edges.get_unchecked(i + 1)
            if frame >= 0 && frame < frame_to_mir.len() {
                let mir = frame_to_mir.get_unchecked(frame)
                if mir >= 0 && mir < fn_count {
                    let at = cursor.get_unchecked(mir)
                    mir_edge_ensure_i32_len(packed, at + 1, 0)
                    packed.set(at, fid)
                    cursor.set(mir, at + 1)
                }
            }
            i = i + 2
        }
    }
    packed
}

fn mir_enqueue_call_edges(
    m: MirModule,
    index: MirReachabilityIndex,
    functions: Vec<MirFunction>,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    f: MirFunction,
    target: String,
    packed: Vec<i32>,
    fi: i32,
    fn_names: Vec<String>,
    edge_names: Vec<String>
) {
    if packed.len() > 0 && fi >= 0 && fi < packed.get_unchecked(0) {
        mir_enqueue_recorded_callees(
            m,
            index,
            functions,
            reachable,
            queue,
            target.clone(),
            packed,
            fi,
            fn_names,
            edge_names
        )
        return
    }
    mir_enqueue_call_edges_from_insts(m, index, functions, reachable, queue, f, target)
}

fn mir_enqueue_recorded_payload(
    m: MirModule,
    index: MirReachabilityIndex,
    functions: Vec<MirFunction>,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    payload: i32,
    target: String,
    fn_names: Vec<String>,
    edge_names: Vec<String>
) {
    if payload >= 0 {
        reachability_index::mir_reachability_enqueue_by_func_id(index, reachable, queue, payload)
        return
    }
    let tagged = 0 - payload - 10
    if tagged < 0 {
        return
    }
    let bias = mir_edge_intern_bias()
    if tagged < bias {
        if tagged < fn_names.len() {
            reachability_names::mir_enqueue_reachable_name(
                index,
                functions,
                reachable,
                queue,
                fn_names.get_unchecked(tagged).clone()
            )
        }
        return
    }
    let overflow = tagged - bias
    if overflow >= 0 && overflow < edge_names.len() {
        reachability_names::mir_enqueue_reachable_name(
            index,
            functions,
            reachable,
            queue,
            edge_names.get_unchecked(overflow).clone()
        )
    }
}

fn mir_enqueue_recorded_callees(
    m: MirModule,
    index: MirReachabilityIndex,
    functions: Vec<MirFunction>,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    target: String,
    packed: Vec<i32>,
    fi: i32,
    fn_names: Vec<String>,
    edge_names: Vec<String>
) {
    let fn_count = packed.get_unchecked(0)
    let off = packed.get_unchecked(1 + fn_count + fi)
    let off_end = packed.get_unchecked(1 + fn_count + fi + 1)
    let mut i = off
    while i < off_end && i < packed.len() {
        mir_enqueue_recorded_payload(
            m,
            index,
            functions,
            reachable,
            queue,
            packed.get_unchecked(i),
            target.clone(),
            fn_names,
            edge_names
        )
        i = i + 1
    }
}

fn mir_enqueue_call_edges_from_insts(
    m: MirModule,
    index: MirReachabilityIndex,
    functions: Vec<MirFunction>,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    f: MirFunction,
    target: String
) {
    let call_op = opcodes::MIR_CALL()
    let ref_op = opcodes::MIR_REF_FUNC()
    let skip_fallback = target.clone().eq(String_from("wasm32-gc"))
    let block_count = function_block_queries::MirFunction_block_count(f)
    let mut bi = 0
    while bi < block_count {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let op = block_inst_access::MirBlock_inst_op(block, ii)
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if op == call_op || op == ref_op {
                mir_enqueue_inst_callee(m, index, functions, reachable, queue, inst, target.clone())
            }
            if op == call_op && !skip_fallback {
                let fallback = core_op_call::mir_call_normal_fallback_symbol(m, inst)
                if fallback.len() > 0 {
                    mir_enqueue_symbol(m, index, functions, reachable, queue, fallback, target.clone())
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn mir_enqueue_inst_callee(
    m: MirModule,
    index: MirReachabilityIndex,
    functions: Vec<MirFunction>,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    inst: MirInst,
    target: String
) {
    let fid_raw = inst_record::mir_inst_func_id_raw(inst)
    if fid_raw >= 0 {
        if reachability_index::mir_reachability_enqueue_by_func_id(index, reachable, queue, fid_raw) {
            return
        }
    }
    mir_enqueue_symbol(
        m,
        index,
        functions,
        reachable,
        queue,
        inst_accessors_literals::MirInst_str_val(inst),
        target
    )
}

fn mir_reachability_skips_hashmap_alias_bodies(target: String) -> bool {
    target.clone().starts_with(String_from("native"))
}

fn mir_enqueue_symbol(
    m: MirModule,
    index: MirReachabilityIndex,
    functions: Vec<MirFunction>,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    symbol: String,
    target: String
) {
    if module_spine::MirModule_signature_spine_populated(m) {
        let registry = module_spine::MirModule_signature_registry(m)
        let fid = signature_registry::signature_registry_lookup_by_mangled(registry, symbol.clone())
        if function_id::function_id_is_valid(fid) {
            if reachability_index::mir_reachability_enqueue_by_func_id(
                index,
                reachable,
                queue,
                function_id::FunctionId_raw(fid)
            ) {
                return
            }
        }
    }
    if reachability_names::mir_enqueue_reachable_name(index, functions, reachable, queue, symbol.clone()) {
        return
    }
    let alias = hash_aliases::hashmap_builtin_alias(symbol.clone())
    if alias.clone().eq(symbol.clone()) {
        return
    }
    if mir_reachability_skips_hashmap_alias_bodies(target.clone()) {
        let coid = core_op_binding::core_op_binding_lookup_for_callee(symbol.clone())
        if core_op_id::core_op_id_is_some(coid) {
            return
        }
    }
    mir_enqueue_symbol(m, index, functions, reachable, queue, alias, target)
}
