use std::host::stdio
use mir::module_strings

fn mir_dump_dominance_fixture_print_string_interns(m: MirModule) {
    let s0 = module_strings::intern_string(m, "hello")
    let s1 = module_strings::intern_string(m, "world")
    let s2 = module_strings::intern_string(m, "hello")
    stdio::println(concat("intern 'hello': ", to_string(s0)))
    stdio::println(concat("intern 'world': ", to_string(s1)))
    stdio::println(concat("intern 'hello' again: ", to_string(s2)))
}
