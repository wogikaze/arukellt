struct MirDomInfo {
    idom: Vec<i32>,
    frontier_offsets: Vec<i32>,
    frontier_lengths: Vec<i32>,
    frontier_blocks: Vec<i32>,
}

fn MirDomInfo_new() -> MirDomInfo {
    MirDomInfo { idom: Vec::new<i32>(), frontier_offsets: Vec::new<i32>(), frontier_lengths: Vec::new<i32>(), frontier_blocks: Vec::new<i32>() }
}

fn MirDomInfo_idom_count(info: MirDomInfo) -> i32 {
    info.idom.len()
}

fn MirDomInfo_push_block(mut info: MirDomInfo, idom: i32, frontier_count: i32) {
    push(info.idom, idom)
    push(info.frontier_offsets, info.frontier_blocks.len())
    push(info.frontier_lengths, frontier_count)
}

fn MirDomInfo_push_frontier_block(mut info: MirDomInfo, block: i32) {
    push(info.frontier_blocks, block)
}
