use collections::name_index
use mir::function_identity
use mir::function_return_view
use mir::module_functions
//
// Module-scoped callee lookup for type propagation.
// Linear scan of every MirFunction on each CALL (× fixpoint iterations) was
// the dominant cost of lower.propagate on selfhost-scale modules (#829).

struct CalleePropCache {
    by_name: NameIndex,
    by_bare: NameIndex,
    ret_type_names: Vec<String>,
    ret_variant_slots: Vec<i32>,
    // Tier 2 discovery catalog (#851 Phase 3): fn_index names +
    // enum-normalized return names recorded on the module at ctx_prep.
    // Consulted only for exact names when the tier-1 module index misses,
    // so callees whose bodies are not lowered yet still resolve during
    // per-fn propagation. Bare-name and variant-slot lookups stay tier 1:
    // discovery adds bare ambiguity (#730) and variant slots are a
    // body-level fact signatures cannot supply.
    disc_names: NameIndex,
    disc_ret_names: Vec<String>,
}

fn callee_prop_cache_build(m: MirModule) -> CalleePropCache {
    let count = module_functions::MirModule_function_count(m)
    let mut by_name = name_index::NameIndex_new(count)
    let mut by_bare = name_index::NameIndex_new(count)
    let mut ret_type_names = Vec::new<String>()
    let mut ret_variant_slots = Vec::new<i32>()
    let mut fi = 0
    while fi < count {
        let f = module_functions::MirModule_function_at(m, fi)
        let fname = function_identity::MirFunction_name(f)
        name_index::name_index_insert_first(by_name, fname.clone(), fi)
        let bare = strip_module_prefix(fname.clone())
        let existing_bare = name_index::name_index_get(by_bare, bare.clone())
        if existing_bare < 0 {
            name_index::name_index_set(by_bare, bare, fi)
        } else if existing_bare != fi {
            // Ambiguous bare name: same rule as linear lookup (no unique match).
            name_index::name_index_set(by_bare, bare, 0 - 2)
        }
        push(ret_type_names, function_return_view::MirFunction_return_type_name(f))
        // The lower pipeline records each function's return-variant slot at
        // body completion (MirModule.return_variant_slots, #851). Modules
        // built outside that path report 'unrecorded' and keep the original
        // body scan as fallback.
        let mut ret_slot = module_functions::MirModule_return_variant_slot_at(m, fi)
        if ret_slot == module_functions::mir_return_variant_slot_unrecorded() {
            ret_slot = function_return_view::mir_function_return_variant_slot(f)
        }
        push(ret_variant_slots, ret_slot)
        fi = fi + 1
    }
    let disc_names_list = module_functions::MirModule_discovery_fn_names(m)
    let mut disc_index = name_index::NameIndex_new(disc_names_list.len())
    let mut di = 0
    while di < disc_names_list.len() {
        name_index::name_index_insert_first(disc_index, get_unchecked(disc_names_list, di).clone(), di)
        di = di + 1
    }
    CalleePropCache {
        by_name: by_name,
        by_bare: by_bare,
        ret_type_names: ret_type_names,
        ret_variant_slots: ret_variant_slots,
        disc_names: disc_index,
        disc_ret_names: module_functions::MirModule_discovery_fn_ret_names(m),
    }
}

// Append one emitted function to the tier-1 index. Must mirror the build
// loop exactly: same insert order semantics for by_name/by_bare and the
// same parallel ret tables.
fn callee_prop_cache_add_fn(mut cache: CalleePropCache, fi: i32, fname: String, ret_name: String, ret_slot: i32) {
    name_index::name_index_insert_first(cache.by_name, fname.clone(), fi)
    let bare = strip_module_prefix(fname.clone())
    let existing_bare = name_index::name_index_get(cache.by_bare, bare.clone())
    if existing_bare < 0 {
        name_index::name_index_set(cache.by_bare, bare, fi)
    } else if existing_bare != fi {
        name_index::name_index_set(cache.by_bare, bare, 0 - 2)
    }
    push(cache.ret_type_names, ret_name)
    push(cache.ret_variant_slots, ret_slot)
}

fn callee_prop_cache_lookup(cache: CalleePropCache, callee: String) -> i32 {
    let exact = name_index::name_index_get(cache.by_name, callee.clone())
    if exact >= 0 {
        return exact
    }
    let bare = strip_module_prefix(callee)
    let bare_idx = name_index::name_index_get(cache.by_bare, bare)
    if bare_idx >= 0 {
        return bare_idx
    }
    0 - 1
}

fn callee_prop_cache_return_type_name(cache: CalleePropCache, callee: String) -> String {
    let idx = callee_prop_cache_lookup(cache, callee)
    if idx >= 0 && idx < cache.ret_type_names.len() {
        return get_unchecked(cache.ret_type_names, idx).clone()
    }
    let di = name_index::name_index_get(cache.disc_names, callee)
    if di < 0 || di >= cache.disc_ret_names.len() {
        return String_new()
    }
    get_unchecked(cache.disc_ret_names, di).clone()
}

fn callee_prop_cache_return_variant_slot(cache: CalleePropCache, callee: String) -> i32 {
    let idx = callee_prop_cache_lookup(cache, callee)
    if idx < 0 || idx >= cache.ret_variant_slots.len() {
        return 0 - 1
    }
    get_unchecked(cache.ret_variant_slots, idx)
}

fn strip_module_prefix(name: String) -> String {
    let n = name.len()
    let mut last = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            let next = i + 2
            if next < n {
                last = next
            }
        }
        i = i + 1
    }
    if last >= 0 {
        return name.slice(last, n)
    }
    name
}
