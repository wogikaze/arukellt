use mir::source_location_record
use mir::types_block
use mir::value_types

pub struct MirFunction {
    name: String,
    params: Vec<MirLocal>,
    locals: Vec<MirLocal>,
    blocks: Vec<MirBlock>,
    return_type: i32,
    return_type_name: String,
    next_local: i32,
    next_block: i32,
    source_location: SourceLocation,
}

fn MirFunction_new(name: String, source_location: SourceLocation) -> MirFunction {
    MirFunction {
        name: name,
        params: Vec::new<MirLocal>(),
        locals: Vec::new<MirLocal>(),
        blocks: Vec::new<MirBlock>(),
        return_type: value_types::VT_VOID(),
        return_type_name: String_new(),
        next_local: 0,
        next_block: 0,
        source_location: source_location,
    }
}

fn MirFunction_source_location(f: MirFunction) -> SourceLocation { f.source_location }
