fn parse_decimal_as_i64(text: String) -> i64 {
    let n = len(text)
    let mut result: i64 = 0i64
    let mut i = 0
    let mut neg = false
    if i < n && text.byte_at(i) == 45 {
        neg = true
        i = i + 1
    }
    let mut stop = false
    while i < n && !stop {
        let d = text.byte_at(i)
        if d >= 48 && d <= 57 {
            result = result * 10i64 + __intrinsic_i32_to_i64(d - 48)
        } else {
            if d == 95 {
            } else {
                stop = true
            }
        }
        i = i + 1
    }
    if neg {
        result = 0i64 - result
    }
    result
}

test mod "decimal" {
    test "simple" { assert(parse_decimal_as_i64("123") == 123i64) }
    test "zero" { assert(parse_decimal_as_i64("0") == 0i64) }
    test "underscore_separators" { assert(parse_decimal_as_i64("1_000_000") == 1000000i64) }
    test "negative" { assert(parse_decimal_as_i64("-42") == 0i64 - 42i64) }
    test "stops_at_nondigit" { assert(parse_decimal_as_i64("12abc") == 12i64) }
    test "i64_range" { assert(parse_decimal_as_i64("3000000000") == 3000000000i64) }
}
