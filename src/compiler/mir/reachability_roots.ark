use mir::reachability_names
use mir::reachability_index
use mir::types
fn mir_mark_roots(
    index: MirReachabilityIndex,
    functions: Vec<MirFunction>,
    mut reachable: Vec<i32>,
    mut queue: Vec<i32>,
    extra_roots: Vec<String>
) -> i32 {
    let mut root_count = 0
    if reachability_names::mir_enqueue_reachable_name(
        index,
        functions,
        reachable,
        queue,
        "main"
    ) {
        root_count = root_count + 1
    }
    if reachability_names::mir_enqueue_reachable_name(
        index,
        functions,
        reachable,
        queue,
        "_start"
    ) {
        root_count = root_count + 1
    }
    // Root the synthesized `arukellt test` entry (#719): under p2/GC emit
    // nothing else references it, so an unrooted `__test_main` is pruned
    // before the export pass can see it.
    if reachability_names::mir_enqueue_reachable_name(
        index,
        functions,
        reachable,
        queue,
        "__test_main"
    ) {
        root_count = root_count + 1
    }
    let extra_count = extra_roots.len()
    let mut ei = 0
    while ei < extra_count {
        if reachability_names::mir_enqueue_reachable_name(
            index,
            functions,
            reachable,
            queue,
            get_unchecked(extra_roots, ei).clone()
        ) {
            root_count = root_count + 1
        }
        ei = ei + 1
    }
    root_count
}
