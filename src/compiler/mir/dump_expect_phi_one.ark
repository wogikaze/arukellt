use std::host::process::Process
use std::host::stdio
use std::text
use std::prelude::{to_string}
use mir::opcodes
use mir::block_phi_access
use mir::dump_format_types
use mir::dump_format_phi
use mir::function_block_queries
use mir::phi_access
fn mir_expect_single_phi(f: MirFunction, block_id: i32, expected_dest: i32, expected_vt: i32) -> MirPhi {
    let block = function_block_queries::MirFunction_block_at(f, block_id)
    let actual_count = block_phi_access::MirBlock_phi_count(block)
    if actual_count != 1 {
        let mut msg = "phi check failed for bb".concat(to_string(block_id))
        msg = msg.concat(": expected phi count=1 actual=")
        msg = msg.concat(to_string(actual_count))
        stdio::eprintln(msg)
        Process::exit(1)
    }
    let phi = block_phi_access::MirBlock_phi_at(block, 0)
    if phi_access::MirPhi_op(phi) != opcodes::MIR_PHI() || phi_access::MirPhi_dest(phi) != expected_dest || phi_access::MirPhi_val_type(phi) != expected_vt {
        let mut msg = "phi check failed for bb".concat(to_string(block_id))
        msg = msg.concat(": expected dest=%")
        msg = msg.concat(to_string(expected_dest))
        msg = msg.concat(" type=")
        msg = msg.concat(dump_format_types::mir_value_type_name(expected_vt))
        msg = msg.concat(" actual=")
        msg = msg.concat(dump_format_phi::mir_format_phi(f, phi))
        stdio::eprintln(msg)
        Process::exit(1)
    }
    phi
}
