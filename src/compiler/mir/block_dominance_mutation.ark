use mir::types_block

fn MirBlock_set_idom(mut block: MirBlock, idom: i32) {
    block.idom = idom
}

fn MirBlock_reset_idom(mut block: MirBlock) {
    block.idom = 0 - 1
}

fn MirBlock_set_dom_set(mut block: MirBlock, dom_set: Vec<i32>) {
    block.dom_set = dom_set
}

fn MirBlock_reset_dom_set(mut block: MirBlock) {
    block.dom_set = Vec::new<i32>()
}

fn MirBlock_push_dom_set(mut block: MirBlock, block_id: i32) {
    push(block.dom_set, block_id)
}

fn MirBlock_reset_dom_frontier(mut block: MirBlock) {
    block.dom_frontier = Vec::new<i32>()
}

fn MirBlock_push_dom_frontier_unique(mut block: MirBlock, block_id: i32) {
    let count = block.dom_frontier.len()
    let mut i = 0
    while i < count {
        if block.dom_frontier.get_unchecked(i) == block_id {
            return
        }
        i = i + 1
    }
    push(block.dom_frontier, block_id)
}
