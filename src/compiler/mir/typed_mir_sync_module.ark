use corehir::kinds
use corehir::mir_value_type
use corehir::type_id
use corehir::type_info_to_mir_value
use corehir::type_table
use mir::function_locals_view
use mir::function_param_view
use mir::legacy_vt_compat
use mir::local_access
use mir::local_mutation
use mir::module_functions
use mir::module_spine
use mir::value_types

fn mir_module_sync_all_value_types(m: MirModule) {
    if !module_spine::MirModule_signature_spine_populated(m) {
        return
    }
    let table = module_spine::MirModule_type_table(m)
    let count = module_functions::MirModule_function_count(m)
    let mut fi = 0
    while fi < count {
        let synced = mir_function_sync_all_value_types(module_functions::MirModule_function_at(m, fi), table)
        module_functions::MirModule_set_function_at(m, fi, synced)
        fi = fi + 1
    }
}

fn mir_function_sync_all_value_types(f: MirFunction, table: TypeTable) -> MirFunction {
    let pc = function_param_view::MirFunction_param_count(f)
    let mut pi = 0
    while pi < pc {
        let loc = function_param_view::MirFunction_param_at(f, pi)
        let synced = mir_local_sync_value_type_preserving(loc, table)
        f = mir_function_set_param_at(f, pi, synced)
        pi = pi + 1
    }
    let lc = function_locals_view::MirFunction_local_count(f)
    let mut li = 0
    while li < lc {
        let loc = function_locals_view::MirFunction_local_at(f, li)
        let synced = mir_local_sync_value_type_preserving(loc, table)
        f = mir_function_set_local_at(f, li, synced)
        li = li + 1
    }
    f
}

fn mir_sync_type_name_alias(type_name: String) -> String {
    let n = len(type_name)
    if n > 8 && starts_with(clone(type_name), "Option<") && char_at(type_name, n - 1) == 62 {
        return concat("option:", substring(type_name, 7, n - 1))
    }
    type_name
}

fn mir_local_name_is_string(loc: MirLocal) -> bool {
    let type_name = local_access::MirLocal_type_name(loc)
    eq(clone(type_name), "String") || eq(type_name, "string")
}

fn mir_canonical_string_type_id(table: TypeTable) -> TypeId {
    let args = Vec::new<TypeId>()
    type_table::type_table_find_existing(table, kinds::TYPE_KIND_STRING(), "String", args)
}

fn mir_canonicalize_string_mvt(
    loc: MirLocal,
    table: TypeTable,
    value_type: MirValueType
) -> MirValueType {
    if !mir_local_name_is_string(loc) {
        return value_type
    }
    let canonical = mir_canonical_string_type_id(table)
    if !type_id::type_id_is_valid(canonical) {
        return value_type
    }
    mir_value_type::MirValueType_new(
        canonical,
        mir_value_type::mir_value_type_repr(value_type),
        mir_value_type::mir_value_type_nullability(value_type)
    )
}

fn mir_local_sync_value_type(loc: MirLocal, table: TypeTable) -> MirLocal {
    let vt = local_access::MirLocal_val_type(loc)
    let tn = local_access::MirLocal_type_name(loc)
    let lookup_name = mir_sync_type_name_alias(clone(tn))
    let inferred = type_info_to_mir_value::vt_to_mir_value(table, vt, lookup_name)
    let mvt = mir_canonicalize_string_mvt(loc, table, inferred)
    let synced = local_mutation::MirLocal_copy_with_value_type(loc, mvt)
    if type_id::type_id_is_valid(mir_value_type::mir_value_type_type_id(mvt)) {
        local_mutation::MirLocal_set_val_type_only(synced, legacy_vt_compat::legacy_vt_from_mir_value_type(table, mvt))
    }
    synced
}

fn mir_explicit_aggregate_type_name(type_name: String, vt: i32) -> bool {
    if len(type_name) == 0 || starts_with(clone(type_name), "?") {
        return false
    }
    if len(type_name) == 1 {
        let ch = char_at(clone(type_name), 0)
        if ch >= 65 && ch <= 90 {
            return false
        }
    }
    if starts_with(clone(type_name), "struct:") ||
    starts_with(clone(type_name), "enum:") ||
    starts_with(clone(type_name), "vec:") ||
    starts_with(clone(type_name), "hashmap:") ||
    starts_with(clone(type_name), "hashset:") ||
    starts_with(clone(type_name), "option:") ||
    starts_with(clone(type_name), "Option_") ||
    starts_with(clone(type_name), "Option:") ||
    starts_with(clone(type_name), "Option<") ||
    starts_with(clone(type_name), "result:") ||
    starts_with(clone(type_name), "Result_") ||
    starts_with(clone(type_name), "Result:") ||
    starts_with(clone(type_name), "Result<") {
        return true
    }
    if vt == value_types::VT_GC_REF() || vt == value_types::VT_REF() {
        return !type_info_to_mir_value::type_name_is_scalar_primitive(clone(type_name))
    }
    false
}

fn mir_same_explicit_type_alias(table: TypeTable, existing: MirValueType, type_name: String) -> bool {
    let current = type_info_to_mir_value::mvt_to_type_name(table, existing)
    if len(current) == 0 {
        return false
    }
    let expected_name = mir_sync_type_name_alias(type_name)
    if eq(clone(current), clone(expected_name)) {
        return true
    }
    // Struct layout names carry representation bytes (`struct:Name:8`) while
    // TypeTable identity is the nominal `Name`.
    if starts_with(clone(expected_name), "struct:") {
        let n = len(expected_name)
        let mut last_colon = 0 - 1
        let mut i = 7
        while i < n {
            if char_at(clone(expected_name), i) == 58 {
                last_colon = i
            }
            i = i + 1
        }
        if last_colon > 7 {
            let nominal = substring(expected_name, 7, last_colon)
            if eq(current, nominal) {
                return true
            }
        }
    }
    false
}

fn mir_existing_value_type_is_canonical(
    loc: MirLocal,
    table: TypeTable,
    existing: MirValueType
) -> bool {
    if mir_local_name_is_string(loc) {
        let existing_id = mir_value_type::mir_value_type_type_id(existing)
        let canonical_id = mir_canonical_string_type_id(table)
        return type_id::type_id_is_valid(existing_id) &&
        type_id::type_id_is_valid(canonical_id) &&
        type_id::type_id_value(existing_id) == type_id::type_id_value(canonical_id)
    }
    let type_name = local_access::MirLocal_type_name(loc)
    let vt = local_access::MirLocal_val_type(loc)
    if !mir_explicit_aggregate_type_name(clone(type_name), vt) {
        return true
    }
    mir_same_explicit_type_alias(table, existing, type_name)
}

// Preserve an already-typed value_type when it is concrete (no open type
// variables) and agrees with the canonical nominal identity implied by name.
fn mir_local_sync_value_type_preserving(loc: MirLocal, table: TypeTable) -> MirLocal {
    let existing = local_access::MirLocal_value_type(loc)
    if type_info_to_mir_value::mvt_is_concrete(table, existing) &&
    mir_existing_value_type_is_canonical(loc, table, existing) {
        let synced = local_mutation::MirLocal_copy_with_value_type(loc, existing)
        local_mutation::MirLocal_set_val_type_only(synced, legacy_vt_compat::legacy_vt_from_mir_value_type(table, existing))
        return synced
    }
    mir_local_sync_value_type(loc, table)
}

// Propagate writes type_name via mvt_from_legacy_vt (no TypeTable). Re-sync
// immediately so callers can drop the full-module second sync pass (#823).
fn mir_local_with_type_name_synced(loc: MirLocal, type_name: String, table: TypeTable) -> MirLocal {
    let named = local_mutation::MirLocal_copy_with_type_name(loc, type_name)
    mir_local_sync_value_type(named, table)
}

fn mir_local_with_value_type_synced(
    loc: MirLocal,
    value_type: MirValueType,
    table: TypeTable
) -> MirLocal {
    let canonical = mir_canonicalize_string_mvt(loc, table, value_type)
    let synced = local_mutation::MirLocal_copy_with_value_type(loc, canonical)
    local_mutation::MirLocal_set_val_type_only(
        synced,
        legacy_vt_compat::legacy_vt_from_mir_value_type(table, canonical)
    )
    synced
}

fn mir_function_set_param_at(f: MirFunction, idx: i32, local: MirLocal) -> MirFunction {
    // In-place: per-element Vec rebuild is Θ(L²) across a full sync (#823).
    set(f.params, idx, local)
    f
}

fn mir_function_set_local_at(f: MirFunction, idx: i32, local: MirLocal) -> MirFunction {
    set(f.locals, idx, local)
    f
}
