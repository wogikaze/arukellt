use corehir::mir_value_type
use corehir::type_id
use mir::block_record
pub struct MirInst {
    home: MirBlock,
    index: i32,
}

fn MirInst_ref(home: MirBlock, index: i32) -> MirInst {
    MirInst { home: home, index: index }
}

fn mir_inst_home(inst: MirInst) -> MirBlock {
    inst.home
}

fn mir_inst_index(inst: MirInst) -> i32 {
    inst.index
}

// The emitter reuses one handle while walking a block. The handle points at
// the block's column storage, so changing only its index does not copy or
// mutate the MIR instruction columns.
fn mir_inst_set_index(mut inst: MirInst, index: i32) {
    inst.index = index
}

fn mir_inst_val_type(inst: MirInst) -> i32 {
    get_unchecked(inst.home.val_types, inst.index)
}

// INV-1: a packed result is only real when its TypeId is valid. The legacy
// vt default stored TYPE_ID_INVALID next to a ref repr, so every non-void
// instruction appeared to carry a result type the emitter could not map.
fn mir_inst_has_packed_result(inst: MirInst) -> bool {
    type_id::type_id_is_valid(
        type_id::TypeId_new(get_unchecked(inst.home.type_ids, inst.index))
    )
}

fn mir_inst_result_types(inst: MirInst) -> Vec<MirValueType> {
    if !mir_inst_has_packed_result(inst) {
        return Vec::new<MirValueType>()
    }
    let mut result = Vec::new<MirValueType>()
    result.push(mir_value_type::MirValueType_new(
            type_id::TypeId_new(get_unchecked(inst.home.type_ids, inst.index)),
            get_unchecked(inst.home.type_reprs, inst.index),
            get_unchecked(inst.home.type_nulls, inst.index)
        ))
    result
}

fn mir_inst_result_type_count(inst: MirInst) -> i32 {
    if mir_inst_has_packed_result(inst) {
        return 1
    }
    0
}

fn mir_inst_result_type_at(inst: MirInst, _index: i32) -> MirValueType {
    // Packed single-result storage: callers gate on result_type_count > 0
    // and pass index 0, so read the columns directly instead of
    // materializing a Vec<MirValueType> per access.
    if !mir_inst_has_packed_result(inst) {
        return mir_value_type::MirValueType_new(
            type_id::TYPE_ID_INVALID(),
            0,
            0
        )
    }
    mir_value_type::MirValueType_new(
        type_id::TypeId_new(get_unchecked(inst.home.type_ids, inst.index)),
        get_unchecked(inst.home.type_reprs, inst.index),
        get_unchecked(inst.home.type_nulls, inst.index)
    )
}

fn mir_inst_set_result_types(mut inst: MirInst, result_types: Vec<MirValueType>) {
    if result_types.len() == 0 {
        inst.home.type_ids.set(inst.index, 0 - 1)
        inst.home.type_reprs.set(inst.index, 0)
        inst.home.type_nulls.set(inst.index, 0)
        return
    }
    let first = get_unchecked(result_types, 0)
    inst.home.type_ids.set(inst.index, type_id::TypeId_raw(mir_value_type::mir_value_type_type_id(first)))
    inst.home.type_reprs.set(inst.index, mir_value_type::mir_value_type_repr(first))
    inst.home.type_nulls.set(inst.index, mir_value_type::mir_value_type_nullability(first))
}

fn mir_inst_op(inst: MirInst) -> i32 {
    get_unchecked(inst.home.ops, inst.index)
}

fn mir_inst_dest(inst: MirInst) -> i32 {
    get_unchecked(inst.home.dests, inst.index)
}

fn mir_inst_arg0(inst: MirInst) -> i32 {
    get_unchecked(inst.home.arg0s, inst.index)
}

fn mir_inst_arg1(inst: MirInst) -> i32 {
    get_unchecked(inst.home.arg1s, inst.index)
}

fn mir_inst_int_val(inst: MirInst) -> i32 {
    get_unchecked(inst.home.int_vals, inst.index)
}

fn mir_inst_float_val(inst: MirInst) -> f64 {
    block_record::mir_float_box_value(get_unchecked(inst.home.float_vals, inst.index))
}

fn mir_inst_str_val(inst: MirInst) -> String {
    let str_id = get_unchecked(inst.home.str_ids, inst.index)
    if str_id < 0 {
        return String_new()
    }
    // Return the pooled String without cloning: emit-side callers only
    // read (eq/concat/parse); mutating a pooled name would corrupt the
    // block str_pool shared by every instruction.
    get_unchecked(inst.home.str_pool, str_id)
}

fn mir_inst_set_arg0(mut inst: MirInst, arg0: i32) {
    inst.home.arg0s.set(inst.index, arg0)
}

fn mir_inst_set_arg1(mut inst: MirInst, arg1: i32) {
    inst.home.arg1s.set(inst.index, arg1)
}

fn mir_inst_set_dest(mut inst: MirInst, dest: i32) {
    inst.home.dests.set(inst.index, dest)
}

fn mir_inst_func_id_raw(inst: MirInst) -> i32 {
    get_unchecked(inst.home.func_ids, inst.index)
}

fn mir_inst_with_func_id_raw(mut inst: MirInst, func_id_raw: i32) -> MirInst {
    inst.home.func_ids.set(inst.index, func_id_raw)
    inst
}

fn mir_inst_with_call_target(mut inst: MirInst, callee: String, func_id_raw: i32) -> MirInst {
    let pool_index = inst.home.str_pool.len()
    inst.home.str_pool.push(callee)
    inst.home.str_ids.set(inst.index, pool_index)
    inst.home.func_ids.set(inst.index, func_id_raw)
    inst
}

fn mir_inst_copy_with_locals(mut inst: MirInst, dest: i32, arg0: i32, arg1: i32) -> MirInst {
    inst.home.dests.set(inst.index, dest)
    inst.home.arg0s.set(inst.index, arg0)
    inst.home.arg1s.set(inst.index, arg1)
    inst
}
