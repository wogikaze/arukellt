use corehir::mir_value_type
use corehir::type_id
use mir::block_record

pub struct MirInst {
    home: MirBlock,
    index: i32,
}

fn MirInst_ref(home: MirBlock, index: i32) -> MirInst {
    MirInst { home: home, index: index }
}

fn mir_inst_home(inst: MirInst) -> MirBlock {
    inst.home
}

fn mir_inst_index(inst: MirInst) -> i32 {
    inst.index
}

// The emitter reuses one handle while walking a block. The handle points at
// the block's column storage, so changing only its index does not copy or
// mutate the MIR instruction columns.
fn mir_inst_set_index(inst: MirInst, index: i32) {
    inst.index = index
}

fn mir_inst_val_type(inst: MirInst) -> i32 {
    get_unchecked(inst.home.val_types, inst.index)
}

fn mir_inst_has_packed_result(inst: MirInst) -> bool {
    get_unchecked(inst.home.type_ids, inst.index) >= 0 ||
    get_unchecked(inst.home.type_reprs, inst.index) > 0
}

fn mir_inst_result_types(inst: MirInst) -> Vec<MirValueType> {
    if !mir_inst_has_packed_result(inst) {
        return Vec::new<MirValueType>()
    }
    let result = Vec::new<MirValueType>()
    push(
        result,
        mir_value_type::MirValueType_new(
            type_id::TypeId_new(get_unchecked(inst.home.type_ids, inst.index)),
            get_unchecked(inst.home.type_reprs, inst.index),
            get_unchecked(inst.home.type_nulls, inst.index)
        )
    )
    result
}

fn mir_inst_result_type_count(inst: MirInst) -> i32 {
    if mir_inst_has_packed_result(inst) {
        return 1
    }
    0
}

fn mir_inst_result_type_at(inst: MirInst, index: i32) -> MirValueType {
    get_unchecked(mir_inst_result_types(inst), index)
}

fn mir_inst_set_result_types(inst: MirInst, result_types: Vec<MirValueType>) {
    if len(result_types) == 0 {
        set(inst.home.type_ids, inst.index, 0 - 1)
        set(inst.home.type_reprs, inst.index, 0)
        set(inst.home.type_nulls, inst.index, 0)
        return
    }
    let first = get_unchecked(result_types, 0)
    set(
        inst.home.type_ids,
        inst.index,
        type_id::TypeId_raw(mir_value_type::mir_value_type_type_id(first))
    )
    set(inst.home.type_reprs, inst.index, mir_value_type::mir_value_type_repr(first))
    set(inst.home.type_nulls, inst.index, mir_value_type::mir_value_type_nullability(first))
}

fn mir_inst_op(inst: MirInst) -> i32 {
    get_unchecked(inst.home.ops, inst.index)
}

fn mir_inst_dest(inst: MirInst) -> i32 {
    get_unchecked(inst.home.dests, inst.index)
}

fn mir_inst_arg0(inst: MirInst) -> i32 {
    get_unchecked(inst.home.arg0s, inst.index)
}

fn mir_inst_arg1(inst: MirInst) -> i32 {
    get_unchecked(inst.home.arg1s, inst.index)
}

fn mir_inst_int_val(inst: MirInst) -> i32 {
    get_unchecked(inst.home.int_vals, inst.index)
}

fn mir_inst_float_val(inst: MirInst) -> f64 {
    block_record::mir_float_box_value(get_unchecked(inst.home.float_vals, inst.index))
}

fn mir_inst_str_val(inst: MirInst) -> String {
    let str_id = get_unchecked(inst.home.str_ids, inst.index)
    if str_id < 0 {
        return String_new()
    }
    clone(get_unchecked(inst.home.str_pool, str_id))
}

fn mir_inst_set_arg0(inst: MirInst, arg0: i32) {
    set(inst.home.arg0s, inst.index, arg0)
}

fn mir_inst_set_arg1(inst: MirInst, arg1: i32) {
    set(inst.home.arg1s, inst.index, arg1)
}

fn mir_inst_set_dest(inst: MirInst, dest: i32) {
    set(inst.home.dests, inst.index, dest)
}

fn mir_inst_func_id_raw(inst: MirInst) -> i32 {
    get_unchecked(inst.home.func_ids, inst.index)
}

fn mir_inst_with_func_id_raw(inst: MirInst, func_id_raw: i32) -> MirInst {
    set(inst.home.func_ids, inst.index, func_id_raw)
    inst
}

fn mir_inst_with_call_target(inst: MirInst, callee: String, func_id_raw: i32) -> MirInst {
    let pool_index = len(inst.home.str_pool)
    push(inst.home.str_pool, callee)
    set(inst.home.str_ids, inst.index, pool_index)
    set(inst.home.func_ids, inst.index, func_id_raw)
    inst
}

fn mir_inst_copy_with_locals(inst: MirInst, dest: i32, arg0: i32, arg1: i32) -> MirInst {
    set(inst.home.dests, inst.index, dest)
    set(inst.home.arg0s, inst.index, arg0)
    set(inst.home.arg1s, inst.index, arg1)
    inst
}
