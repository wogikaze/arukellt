use std::text
fn mir_format_block_ids(ids: Vec<i32>) -> String {
    let count = ids.len()
    let mut out = "["
    let mut i = 0
    while i < count {
        if i > 0 {
            out = out.concat(",")
        }
        out = out.concat(ids.get_unchecked(i).to_string())
        i = i + 1
    }
    out.concat("]")
}

fn mir_format_edge(edge: i32) -> String {
    if edge < 0 {
        return "-"
    }
    edge.to_string()
}

fn mir_format_edges(succ0: i32, succ1: i32) -> String {
    "[".concat(mir_format_edge(succ0).concat(",".concat(mir_format_edge(succ1).concat("]"))))
}
