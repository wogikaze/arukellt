use std::text
use std::prelude::{to_string}
fn mir_format_block_ids(ids: Vec<i32>) -> String {
    let count = len(ids)
    let mut out = "["
    let mut i = 0
    while i < count {
        if i > 0 {
            out = out.concat(",")
        }
        out = out.concat(to_string(get_unchecked(ids, i)))
        i = i + 1
    }
    out.concat("]")
}

fn mir_format_edge(edge: i32) -> String {
    if edge < 0 {
        return "-"
    }
    to_string(edge)
}

fn mir_format_edges(succ0: i32, succ1: i32) -> String {
    "[".concat(mir_format_edge(succ0).concat(",".concat(mir_format_edge(succ1).concat("]"))))
}
