use mir::gc_layout_plan

fn mir_gc_layout_plan_valid(plan: MirGcLayoutPlan) -> bool {
    if gc_layout_plan::mir_gc_layout_plan_schema_version(plan) != 1 {
        return false
    }
    // O(n) validation (#851): per-binding field checks plus the
    // index_by_raw consistency check, which detects duplicate TypeIds
    // without the old pairwise scan. The drain used to run the O(n^2)
    // version once per pushed function.
    gc_layout_plan::mir_gc_layout_plan_validate_range(plan, 0)
}
