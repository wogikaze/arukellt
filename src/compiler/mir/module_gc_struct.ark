use collections::name_index
use mir::module_record
fn MirModule_gc_struct_sig_count(m: MirModule) -> i32 {
    m.gc_struct_sigs.len()
}

fn MirModule_gc_struct_sig_at(m: MirModule, idx: i32) -> String {
    m.gc_struct_sigs.get_unchecked(idx).clone()
}

fn MirModule_gc_struct_name_at(m: MirModule, idx: i32) -> String {
    m.gc_struct_names.get_unchecked(idx).clone()
}

fn MirModule_gc_struct_names(m: MirModule) -> Vec<String> {
    m.gc_struct_names
}

fn MirModule_gc_struct_sigs(m: MirModule) -> Vec<String> {
    m.gc_struct_sigs
}

fn MirModule_push_gc_struct(mut m: MirModule, name: String, sig: String) {
    name_index::name_index_insert_first(m.gc_struct_slot_index, name.clone(), m.gc_struct_names.len())
    push(m.gc_struct_names, name)
    push(m.gc_struct_sigs, sig)
    // Canon idx is -1 until ordered ensure runs (sealed: inline at flush;
    // late: in late_gc_order order via ctx_gc_canon_ensure_late).
    push(m.gc_struct_canon_idx, 0 - 1)
    // The emit-side derived indexes key off name arrivals too, not just
    // canon assignments, so pushes bump the same version (#851).
    m.gc_canon_version = m.gc_canon_version + 1
}

fn MirModule_gc_struct_canon_idx_at(m: MirModule, slot: i32) -> i32 {
    if slot < 0 || slot >= m.gc_struct_canon_idx.len() {
        return 0 - 1
    }
    m.gc_struct_canon_idx.get_unchecked(slot)
}

fn MirModule_set_gc_struct_canon_idx(mut m: MirModule, slot: i32, canon_idx: i32) {
    if slot < 0 || slot >= m.gc_struct_canon_idx.len() {
        return
    }
    // Count only the -1 -> final transition: emit-side derived indexes
    // rebuild on version bumps (#851), and re-setting the same final
    // value must not masquerade as new canon state.
    if canon_idx >= 0 && m.gc_struct_canon_idx.get_unchecked(slot) < 0 {
        m.gc_canon_version = m.gc_canon_version + 1
    }
    set(m.gc_struct_canon_idx, slot, canon_idx)
}

fn MirModule_gc_struct_canon_idxs(m: MirModule) -> Vec<i32> {
    m.gc_struct_canon_idx
}

fn MirModule_gc_struct_slot(m: MirModule, name: String) -> i32 {
    name_index::name_index_get(m.gc_struct_slot_index, name)
}
