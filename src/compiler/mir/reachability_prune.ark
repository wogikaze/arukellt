use mir::module_functions
use mir::module_emit_artifacts
use mir::module_metadata
use mir::types

fn mir_prune_unmarked_functions(mut m: MirModule, reachable: Vec<i32>) -> i32 {
    let fn_count = module_functions::MirModule_function_count(m)
    let mut kept = Vec::new<MirFunction>()
    // 'return_variant_slots' stays parallel to 'functions' across the prune;
    // a mismatched length means the module was built without recording, so
    // the list resets to unrecorded instead of going stale.
    let slots = module_functions::MirModule_return_variant_slots(m)
    let keep_slots = slots.len() == fn_count
    let mut kept_slots = Vec::new<i32>()
    let mut pruned = 0
    let mut i = 0
    // #851 Phase 3: the fused in-loop emit indexes body bytes and relocs by
    // the pre-prune func_idx; the emit phase compacts/remaps them through
    // this old->new map (identity when nothing was pruned).
    let mut old_to_new = Vec::new<i32>()
    while i < fn_count {
        let f = module_functions::MirModule_function_at(m, i)
        if reachable.get_unchecked(i) != 0 {
            kept.push(f)
            old_to_new.push(kept.len() - 1)
            if keep_slots {
                kept_slots.push(slots.get_unchecked(i))
            }
        } else {
            old_to_new.push(0 - 1)
            pruned = pruned + 1
        }
        i = i + 1
    }
    module_functions::MirModule_set_functions(m, kept)
    module_functions::MirModule_set_return_variant_slots(m, kept_slots)
    module_metadata::MirModule_set_mono_pruned_count(m, pruned)
    let mut emit_art = module_emit_artifacts::MirModule_emit_artifacts(m)
    emit_art.prune_old_to_new = old_to_new
    pruned
}
