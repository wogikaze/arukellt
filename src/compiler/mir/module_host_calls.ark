fn mir_call_is_wasi_http_outgoing(callee: String) -> bool {
    if eq(clone(callee), "http_get") { return true }
    if eq(clone(callee), "__runtime_abi_http_get") { return true }
    if eq(clone(callee), "http::get") { return true }
    if eq(clone(callee), "std::host::http::get") { return true }
    if eq(clone(callee), "runtime.get") { return true }
    if eq(clone(callee), "http_request") { return true }
    if eq(clone(callee), "__runtime_abi_http_request") { return true }
    if eq(clone(callee), "http::request") { return true }
    if eq(clone(callee), "std::host::http::request") { return true }
    if eq(clone(callee), "runtime.request") { return true }
    if eq(clone(callee), "http_serve") { return true }
    if eq(clone(callee), "__runtime_abi_http_serve") { return true }
    if eq(clone(callee), "http::serve") { return true }
    if eq(clone(callee), "std::host::http::serve") { return true }
    if eq(clone(callee), "runtime.serve") { return true }
    if eq(clone(callee), "std::host::http::request_with_headers") { return true }
    false
}

fn mir_call_is_arukellt_host_sockets(callee: String) -> bool {
    if eq(clone(callee), "sockets_connect") { return true }
    if eq(clone(callee), "__runtime_abi_sockets_connect") { return true }
    if eq(clone(callee), "sockets::connect") { return true }
    if eq(clone(callee), "std::host::sockets::connect") { return true }
    if eq(clone(callee), "runtime.connect") { return true }
    if eq(clone(callee), "sockets_read") { return true }
    if eq(clone(callee), "__runtime_abi_sockets_read") { return true }
    if eq(clone(callee), "sockets::read") { return true }
    if eq(clone(callee), "std::host::sockets::read") { return true }
    if eq(clone(callee), "runtime.read") { return true }
    if eq(clone(callee), "sockets_write") { return true }
    if eq(clone(callee), "__runtime_abi_sockets_write") { return true }
    if eq(clone(callee), "sockets::write") { return true }
    if eq(clone(callee), "std::host::sockets::write") { return true }
    if eq(clone(callee), "runtime.write") { return true }
    if eq(clone(callee), "sockets_listen") { return true }
    if eq(clone(callee), "__runtime_abi_sockets_listen") { return true }
    if eq(clone(callee), "sockets::listen") { return true }
    if eq(clone(callee), "std::host::sockets::listen") { return true }
    if eq(clone(callee), "runtime.listen") { return true }
    if eq(clone(callee), "sockets_accept") { return true }
    if eq(clone(callee), "__runtime_abi_sockets_accept") { return true }
    if eq(clone(callee), "sockets::accept") { return true }
    if eq(clone(callee), "std::host::sockets::accept") { return true }
    if eq(clone(callee), "runtime.accept") { return true }
    false
}

fn mir_call_is_arukellt_host(callee: String) -> bool {
    if mir_call_is_wasi_http_outgoing(clone(callee)) { return true }
    if mir_call_is_arukellt_host_sockets(clone(callee)) { return true }
    false
}
