use mir::inst_draft
use mir::inst_factory
use mir::opcodes
use mir::value_types

fn MirInst_call_ref(callee_local: i32, type_idx: i32, arg_count: i32, dest: i32, return_vt: i32) -> MirInstDraft {
    inst_factory::MirInst_full(opcodes::MIR_CALL_REF(), dest, callee_local, type_idx, arg_count, 0.0, String_new(), return_vt)
}

// first_arg_vt and the callee's semantic callback marker are encoded in
// str_val so the Wasm emitter can preserve a typed field after struct.get.
fn MirInst_call_ref_with_arg0_vt(
    callee_local: i32,
    type_idx: i32,
    arg_count: i32,
    dest: i32,
    return_vt: i32,
    first_arg_vt: i32,
    callee_type_name: String
) -> MirInstDraft {
    let numeric_hint = if first_arg_vt >= 0 {
        i32_to_string(first_arg_vt)
    } else {
        String_new()
    }
    let hint = if len(callee_type_name) > 0 {
        concat(numeric_hint, concat(String_from("|"), callee_type_name))
    } else {
        numeric_hint
    }
    inst_factory::MirInst_full(opcodes::MIR_CALL_REF(), dest, callee_local, type_idx, arg_count, 0.0, hint, return_vt)
}
