use mir::types_block

fn MirBlock_reset_preds(mut block: MirBlock) {
    block.preds = Vec::new<i32>()
}

fn MirBlock_push_pred_unique(mut block: MirBlock, pred_id: i32) {
    let count = block.preds.len()
    let mut i = 0
    while i < count {
        if get_unchecked(block.preds, i) == pred_id {
            return
        }
        i = i + 1
    }
    push(block.preds, pred_id)
}
