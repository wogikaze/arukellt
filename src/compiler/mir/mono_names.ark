use std::text

// `<`, `>`, `,`, `:`, ` ` cannot appear in a mangled mono function name.
use std::prelude::{byte_at, substring}
fn is_mono_unsafe_char(ch: i32) -> bool {
    ch == 60 || ch == 62 || ch == 44 || ch == 58 || ch == 32
}

// Most callee names are already safe; return them untouched so the hot CALL
// path does not copy. Otherwise copy runs between unsafe chars instead of one
// substring per character.
fn mono_safe_name(name: String) -> String {
    let n = len(name)
    let mut run_start = 0
    let mut out = ""
    let mut i = 0
    while i < n {
        if is_mono_unsafe_char(byte_at(name, i)) {
            out = out.concat(substring(name, run_start, i))
            out = out.concat("_")
            run_start = i + 1
        }
        i = i + 1
    }
    if run_start == 0 {
        return name
    }
    out.concat(substring(name, run_start, n))
}

// Compare a possibly-unsafe mangled name against an already-safe name without
// allocating: each unsafe char in `name` must read as `_` in `safe`.
// Equivalent to eq(mono_safe_name(name), safe) but scans bytes in place, which
// keeps mono_find_instance lookups off the GC-heap allocation path.
fn mono_name_eq_safe(name: String, safe: String) -> bool {
    let n = len(name)
    if len(safe) != n {
        return false
    }
    let mut i = 0
    while i < n {
        let ch = byte_at(name, i)
        let mut expected = ch
        if is_mono_unsafe_char(ch) {
            expected = 95
        }
        if byte_at(safe, i) != expected {
            return false
        }
        i = i + 1
    }
    true
}

test mod "mono_names" {
    test "safe_name_passthrough" { assert(mono_safe_name("plain_name") == "plain_name") }
    test "safe_name_angle_brackets" { assert(mono_safe_name("f<i32>") == "f_i32_") }
    test "safe_name_comma_space" { assert(mono_safe_name("f<i32, i64>") == "f_i32__i64_") }
    test "unsafe_char_detection" {
        assert(is_mono_unsafe_char(60))
        assert(is_mono_unsafe_char(44))
        assert(is_mono_unsafe_char(97) == false)
    }
    test "eq_safe_accepts_mangled" { assert(mono_name_eq_safe("f<i32>", "f_i32_")) }
    test "eq_safe_rejects_plain" { assert(mono_name_eq_safe("f<i32>", "f<i32>") == false) }
}
