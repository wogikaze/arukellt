use mir::function_core_record
use mir::local_record

fn mir_function_local_count(f: MirFunction) -> i32 {
    len(f.locals)
}

fn mir_function_local_at(f: MirFunction, idx: i32) -> MirLocal {
    get_unchecked(f.locals, idx)
}

fn mir_function_next_local(f: MirFunction) -> i32 {
    f.next_local
}

fn mir_function_str_pool(f: MirFunction) -> MirStrPool {
    if len(f.locals) > 0 {
        return local_record::mir_local_str_pool(get_unchecked(f.locals, 0))
    }
    if len(f.params) > 0 {
        return local_record::mir_local_str_pool(get_unchecked(f.params, 0))
    }
    local_record::MirStrPool_new()
}

fn mir_function_attach_local(f: MirFunction, local: MirLocal) -> MirLocal {
    local_record::mir_local_rebind_strings(local, mir_function_str_pool(f))
    local
}

fn mir_function_new_local(f: MirFunction, name: String, vt: i32) -> MirLocal {
    if len(f.locals) > 0 || len(f.params) > 0 {
        return local_record::MirLocal_new_in_pool(
            mir_function_str_pool(f),
            name,
            vt,
            String_new()
        )
    }
    local_record::MirLocal_new(name, vt, String_new())
}

fn mir_function_push_local(f: MirFunction, local: MirLocal) {
    push(f.locals, mir_function_attach_local(f, local))
}

fn mir_function_alloc_local(f: MirFunction, name: String, vt: i32) -> i32 {
    let idx = f.next_local
    f.next_local = f.next_local + 1
    push(f.locals, mir_function_new_local(f, name, vt))
    idx
}

fn mir_function_set_local(f: MirFunction, local_id: i32, local: MirLocal) {
    set(f.locals, local_id, mir_function_attach_local(f, local))
}
