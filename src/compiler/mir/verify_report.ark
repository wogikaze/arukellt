use std::text
use std::host::stdio::Stdio
struct MirVerifyReport {
    w001: i32,
    w002: i32,
    w003: i32,
    w004: i32,
    w005: i32,
    w006: i32,
    w007: i32,
    w008: i32,
    // Phase 5.0 typed-MIR census: W009 counts a valid-func_id call whose
    // GC/ref dest has no result TypeId; W010 counts a GC/ref local whose
    // valid TypeId has no GcLayoutTable binding. Warning-only.
    w009: i32,
    w010: i32,
    detail_messages: Vec<String>,
}

fn MirVerifyReport_new() -> MirVerifyReport {
    MirVerifyReport {
        w001: 0,
        w002: 0,
        w003: 0,
        w004: 0,
        w005: 0,
        w006: 0,
        w007: 0,
        w008: 0,
        w009: 0,
        w010: 0,
        detail_messages: Vec::new<String>(),
    }
}

fn mir_verify_report_w001(report: MirVerifyReport) -> i32 { report.w001 }
fn mir_verify_report_w002(report: MirVerifyReport) -> i32 { report.w002 }
fn mir_verify_report_w003(report: MirVerifyReport) -> i32 { report.w003 }
fn mir_verify_report_w004(report: MirVerifyReport) -> i32 { report.w004 }
fn mir_verify_report_w005(report: MirVerifyReport) -> i32 { report.w005 }
fn mir_verify_report_w006(report: MirVerifyReport) -> i32 { report.w006 }
fn mir_verify_report_w007(report: MirVerifyReport) -> i32 { report.w007 }
fn mir_verify_report_w008(report: MirVerifyReport) -> i32 { report.w008 }
fn mir_verify_report_w009(report: MirVerifyReport) -> i32 { report.w009 }
fn mir_verify_report_w010(report: MirVerifyReport) -> i32 { report.w010 }

fn mir_verify_report_total(report: MirVerifyReport) -> i32 {
    report.w001 + report.w002 + report.w003 + report.w004 + report.w005 + report.w006 + report.w007 + report.w008 + report.w009 + report.w010
}

fn mir_verify_report_add_w001(mut report: MirVerifyReport) {
    report.w001 = report.w001 + 1
}

fn mir_verify_report_add_w002(mut report: MirVerifyReport) {
    report.w002 = report.w002 + 1
}

fn mir_verify_report_add_w003(mut report: MirVerifyReport) {
    report.w003 = report.w003 + 1
}

fn mir_verify_report_add_w004(mut report: MirVerifyReport) {
    report.w004 = report.w004 + 1
}

fn mir_verify_report_add_w005(mut report: MirVerifyReport) {
    report.w005 = report.w005 + 1
}

fn mir_verify_report_add_w006(mut report: MirVerifyReport) {
    report.w006 = report.w006 + 1
}

fn mir_verify_report_add_w007(mut report: MirVerifyReport) {
    report.w007 = report.w007 + 1
}

fn mir_verify_report_add_w008(mut report: MirVerifyReport) {
    report.w008 = report.w008 + 1
}

fn mir_verify_report_add_w009(mut report: MirVerifyReport) {
    report.w009 = report.w009 + 1
}

fn mir_verify_report_add_w010(mut report: MirVerifyReport) {
    report.w010 = report.w010 + 1
}

fn mir_verify_report_push_detail(mut report: MirVerifyReport, message: String) {
    if report.detail_messages.len() < 32 {
        report.detail_messages.push(message)
    }
}

fn mir_verify_report_print_summary(report: MirVerifyReport) {
    if mir_verify_report_total(report) <= 0 {
        return
    }
    // Split concat depth: deep nesting breaks selfhost wasm emission (s2 load).
    let head = "mir-verify: W001=".concat((report.w001).to_string().concat(" W002=".concat((report.w002).to_string().concat(" W003=".concat((report.w003).to_string())))))
    let middle = " W004=".concat((report.w004).to_string().concat(" W005=".concat((report.w005).to_string().concat(" W006=".concat((report.w006).to_string())))))
    let tail = " W007=".concat(
        (report.w007).to_string().concat(" W008=".concat((report.w008).to_string().concat(" W009=".concat((report.w009).to_string().concat(" W010=".concat((report.w010).to_string()))))))
    )
    Stdio::eprintln(head.concat(middle.concat(tail)))
}
