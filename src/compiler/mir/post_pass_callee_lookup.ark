use mir::function_locals_view
use mir::function_local_mutation
use mir::inst_accessors_operands
use mir::inst_record
use mir::local_access
use mir::opcodes
use mir::post_pass_callee_cache
use mir::post_pass_enum_normalize
use mir::typed_mir_sync_module
use corehir::callee_spelling
use corehir::type_info_to_mir_value
//
// Extracted from post_pass_type_propagate.ark to reduce import fan-out.
// Callee name / return metadata comes from CalleePropCache (#829).

// Set type_name / variant_slot on dest based on the producer instruction type.
// For CALL, looks up the callee's return metadata from the module cache.
use std::prelude::{eq}
fn propagate_from_producer_inst(
    cache: CalleePropCache,
    mut f: MirFunction,
    inst: MirInst,
    op: i32,
    dest: i32,
    mut table: TypeTable
) -> bool {
    if dest < 0 || dest >= function_locals_view::MirFunction_local_count(f) {
        return false
    }
    let dst_loc = function_locals_view::MirFunction_local_at(f, dest)
    let dst_variant_slot = local_access::MirLocal_variant_slot(dst_loc)
    let dst_type_name = local_access::MirLocal_type_name(dst_loc)
    let mut updated = false
    // `new_loc` is a rewritten copy of `dst_loc`; the original is still read
    // below, so the copy must not move it.
    let mut new_loc = dst_loc.clone()
    if op == opcodes::MIR_GC_STRUCT_NEW() {
        let slot = inst_accessors_operands::MirInst_arg0(inst)
        if dst_variant_slot < 0 && slot >= 0 {
            let dst_type_name_now = local_access::MirLocal_type_name(dst_loc)
            if !post_pass_enum_normalize::is_open_enum_container_type_name(dst_type_name_now.clone()) && !post_pass_enum_normalize::is_ref_container_type_name(dst_type_name_now.clone()) {
                local_access::MirLocal_set_variant_slot(new_loc, slot)
                updated = true
            }
        }
    }
    if op == opcodes::MIR_CONST_STRING() {
        new_loc = typed_mir_sync_module::mir_local_with_type_name_synced(new_loc, "string", table)
        local_access::MirLocal_set_variant_slot(new_loc, 0 - 1)
        updated = true
    }
    if op == opcodes::MIR_STRUCT_NEW() {
        let struct_name = inst_record::mir_inst_str_val(inst)
        if len(struct_name) > 0 {
            new_loc = typed_mir_sync_module::mir_local_with_type_name_synced(new_loc, struct_name, table)
            local_access::MirLocal_set_variant_slot(new_loc, 0 - 1)
            updated = true
        }
    }
    if op == opcodes::MIR_CALL() {
        let callee = inst_record::mir_inst_str_val(inst)
        if propagate_call_variant_slot(cache, callee, dst_variant_slot, dst_type_name, new_loc) {
            updated = true
        }
        // get_unchecked dest type is set from the vec element's type during
        // lowering. A wrong mono name (get_unchecked__String) would otherwise
        // overwrite WitParsedInterface/etc. with string here.
        let skip_ret_sync =
        (is_get_unchecked_callee(callee.clone()) && len(dst_type_name) > 0) ||
        (is_vec_constructor_callee(callee.clone()) &&
            dst_type_name.clone().starts_with("vec:"))
        if is_vec_constructor_callee(callee.clone()) &&
        dst_type_name.clone().starts_with("vec:") {
            new_loc = typed_mir_sync_module::mir_local_with_type_name_synced(
                new_loc,
                dst_type_name.clone(),
                table
            )
            updated = true
        }
        let mut ret_name = String_new()
        // clone(T)->T must win over CalleePropCache / string-intrinsic tables.
        // Cache often maps bare "clone" to String and poisons GC struct temps
        // (doc_parse_manifest → doc_flush_fn validate fail, #730).
        if !skip_ret_sync && is_generic_clone_intrinsic(callee.clone()) {
            ret_name = type_name_of_call_arg(f, inst)
        } else {
            if !skip_ret_sync {
                ret_name = producer_result_type_name(inst, table)
                if len(ret_name) == 0 {
                    ret_name = post_pass_callee_cache::callee_prop_cache_return_type_name(cache, callee.clone())
                }
                if len(ret_name) == 0 {
                    ret_name = lookup_intrinsic_return_type_name(callee)
                }
            }
        }
        if len(ret_name) > 0 {
            new_loc = typed_mir_sync_module::mir_local_with_type_name_synced(new_loc, ret_name, table)
            if !post_pass_enum_normalize::is_open_enum_container_type_name(ret_name.clone()) {
                local_access::MirLocal_set_variant_slot(new_loc, 0 - 1)
            }
            updated = true
        }
    }
    if updated {
        function_local_mutation::MirFunction_set_local(f, dest, new_loc)
    }
    updated
}

fn producer_result_type_name(inst: MirInst, table: TypeTable) -> String {
    if inst_record::mir_inst_result_type_count(inst) <= 0 {
        return String_new()
    }
    type_info_to_mir_value::mvt_to_type_name(
        table,
        inst_record::mir_inst_result_type_at(inst, 0)
    )
}

fn propagate_call_variant_slot(
    cache: CalleePropCache,
    callee: String,
    dst_variant_slot: i32,
    dst_type_name: String,
    mut new_loc: MirLocal
) -> bool {
    if dst_variant_slot >= 0 {
        return false
    }
    let ret_slot = post_pass_callee_cache::callee_prop_cache_return_variant_slot(cache, callee)
    if ret_slot >= 0 {
        if !post_pass_enum_normalize::is_open_enum_container_type_name(dst_type_name.clone()) && !post_pass_enum_normalize::is_ref_container_type_name(dst_type_name.clone()) {
            local_access::MirLocal_set_variant_slot(new_loc, ret_slot)
            return true
        }
    }
    false
}

// Keep in sync with mir::lower::call_types::is_clone_result_callee.
fn is_generic_clone_intrinsic(name: String) -> bool {
    eq(name.clone(), "clone") ||
    eq(name.clone(), "__intrinsic_clone") ||
    eq(name.clone(), "__intrinsic_string_clone") ||
    eq(name.clone(), "__core_string_clone_impl") ||
    eq(name.clone(), "raw_string_clone") ||
    eq(name.clone(), "RawString__clone") ||
    name.clone().starts_with("RawString__clone__") ||
    name.clone().ends_with("::clone") ||
    name.clone().ends_with("__clone") ||
    name.clone().ends_with("::raw_string_clone") ||
    name.clone().ends_with("string_clone")
}

fn is_get_unchecked_callee(name: String) -> bool {
    if eq(name.clone(), "vec_get_unchecked") ||
    eq(name.clone(), "get_unchecked") ||
    eq(name.clone(), "__intrinsic_get_unchecked") ||
    callee_spelling::is_namespace_member_callee(
        name.clone(),
        String_from("raw_array_get_unchecked"),
        String_from("RawArray"),
        String_from("get_unchecked")
    ) {
        return true
    }
    name.clone().starts_with("get_unchecked__") ||
    name.clone().starts_with("vec_get_unchecked__") ||
    name.clone().starts_with("__intrinsic_get_unchecked__") ||
    name.clone().starts_with("raw_array_get_unchecked__")
}

fn is_vec_constructor_callee(name: String) -> bool {
    eq(name.clone(), "Vec::new") ||
    eq(name.clone(), "Vec__new") ||
    eq(name.clone(), "Vec::with_capacity") ||
    eq(name.clone(), "Vec__with_capacity") ||
    name.clone().starts_with("Vec::new__") ||
    name.clone().starts_with("Vec__new__") ||
    name.clone().starts_with("Vec::with_capacity__") ||
    name.clone().starts_with("Vec__with_capacity__")
}

fn type_name_of_call_arg(f: MirFunction, inst: MirInst) -> String {
    let arg0 = inst_accessors_operands::MirInst_arg0(inst)
    if arg0 < 0 || arg0 >= function_locals_view::MirFunction_local_count(f) {
        return String_new()
    }
    let loc = function_locals_view::MirFunction_local_at(f, arg0)
    local_access::MirLocal_type_name(loc).clone()
}

fn lookup_intrinsic_return_type_name(callee: String) -> String {
    if is_string_returning_intrinsic(callee.clone()) {
        return "string"
    }
    if is_vec_string_returning_intrinsic(callee.clone()) {
        return "vec:String"
    }
    let base = intrinsic_strip_mono_suffix(callee.clone())
    if len(base) > 0 && !eq(base.clone(), callee.clone()) {
        if is_string_returning_intrinsic(base) {
            return "string"
        }
        if is_vec_string_returning_intrinsic(base) {
            return "vec:string"
        }
    }
    String_new()
}

fn is_string_returning_intrinsic(name: String) -> bool {
    if is_string_constructor_or_conversion(name.clone()) {
        return true
    }
    if is_common_string_method(name.clone()) {
        return true
    }
    if is_text_free_function_returning_string(name.clone()) {
        return true
    }
    if is_core_string_impl_returning_string(name.clone()) {
        return true
    }
    if is_raw_string_intrinsic_returning_string(name.clone()) {
        return true
    }
    if is_hashmap_string_accessor(name.clone()) {
        return true
    }
    if is_string_type_method(name.clone()) {
        return true
    }
    false
}

fn is_vec_string_returning_intrinsic(name: String) -> bool {
    if eq(name.clone(), "split")
    || eq(name.clone(), "text::split")
    || eq(name.clone(), "string::split")
    || eq(name.clone(), "__intrinsic_split")
    || eq(name.clone(), "chars")
    || eq(name.clone(), "text::chars")
    || eq(name.clone(), "__intrinsic_chars")
    || eq(name.clone(), "lines") {
        return true
    }
    if name.clone().ends_with("::split") || name.clone().ends_with("::chars") || name.clone().ends_with("::lines") {
        return true
    }
    if name.clone().starts_with("split__") || name.clone().starts_with("chars__") {
        return true
    }
    if eq(name.clone(), "filter_String") || eq(name.clone(), "__intrinsic_filter_String") || name.clone().starts_with("filter_String__") {
        return true
    }
    if eq(name.clone(), "map_String_String") || eq(name.clone(), "__intrinsic_map_String_String") || name.clone().starts_with("map_String_String__") {
        return true
    }
    if eq(name.clone(), "std::vec::Vec<String>::new") {
        return true
    }
    false
}

fn is_string_constructor_or_conversion(name: String) -> bool {
    if is_string_new_like(name.clone()) || is_string_from_like(name.clone()) {
        return true
    }
    if is_to_string_name(name.clone()) {
        return true
    }
    false
}

fn is_string_new_like(name: String) -> bool {
    if eq(name.clone(), "new") || eq(name.clone(), "String_new") || eq(name.clone(), "String::new") {
        return true
    }
    false
}

fn is_string_from_like(name: String) -> bool {
    if eq(name.clone(), "from") || eq(name.clone(), "String_from") || eq(name.clone(), "String::from") || eq(name.clone(), "__intrinsic_string_from") {
        return true
    }
    false
}

fn is_to_string_name(name: String) -> bool {
    if eq(name.clone(), "to_string")
    || eq(name.clone(), "char_to_string")
    || eq(name.clone(), "bool_to_string")
    || eq(name.clone(), "f64_to_string")
    || eq(name.clone(), "i32_to_string")
    || eq(name.clone(), "i64_to_string") {
        return true
    }
    if name.clone().starts_with("__intrinsic_") && name.clone().ends_with("_to_string") {
        return true
    }
    if name.clone().ends_with("::to_string") || name.clone().ends_with("::to_string__1") {
        return true
    }
    false
}

fn is_common_string_method(name: String) -> bool {
    // "clone" is identity clone(T)->T (see is_generic_clone_intrinsic), not a
    // String-only method. Keeping it here made GC struct clone temps validate
    // as (ref null String) (#730).
    if eq(name.clone(), "concat")
    || eq(name.clone(), "trim")
    || eq(name.clone(), "trim_start")
    || eq(name.clone(), "trim_end")
    || eq(name.clone(), "to_lower")
    || eq(name.clone(), "to_upper") {
        return true
    }
    if eq(name.clone(), "to_lowercase")
    || eq(name.clone(), "to_uppercase")
    || eq(name.clone(), "replace")
    || eq(name.clone(), "replace_all")
    || eq(name.clone(), "repeat")
    || eq(name.clone(), "slice")
    || eq(name.clone(), "slice_bytes")
    || eq(name.clone(), "substring")
    || eq(name.clone(), "reverse")
    || eq(name.clone(), "pad_left")
    || eq(name.clone(), "pad_right")
    || eq(name.clone(), "pad_start")
    || eq(name.clone(), "pad_end")
    || eq(name.clone(), "join") {
        return true
    }
    false
}

fn is_text_free_function_returning_string(name: String) -> bool {
    if name.clone().starts_with("text::") || name.clone().starts_with("string::") {
        let base = strip_module_prefix(name)
        if is_common_string_method(base) {
            return true
        }
    }
    false
}

fn is_string_type_method(name: String) -> bool {
    if name.clone().starts_with("String::") {
        let n = len(name)
        let prefix_len = len("String::")
        let base = name.slice(prefix_len, n)
        if is_common_string_method(base) || is_string_new_like(base) || is_string_from_like(base) || is_to_string_name(base) {
            return true
        }
    }
    if name.clone().starts_with("std::text::String::") {
        let n = len(name)
        let prefix_len = len("std::text::String::")
        let base = name.slice(prefix_len, n)
        if is_common_string_method(base) || is_string_new_like(base) || is_string_from_like(base) || is_to_string_name(base) {
            return true
        }
    }
    false
}

fn strip_module_prefix(name: String) -> String {
    let n = len(name)
    let mut last = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            let next = i + 2
            if next < n {
                last = next
            }
        }
        i = i + 1
    }
    if last >= 0 {
        return name.slice(last, n)
    }
    name
}

fn is_core_string_impl_returning_string(name: String) -> bool {
    if !name.clone().starts_with("__core_string_") {
        return false
    }
    if !name.clone().ends_with("_impl") {
        return false
    }
    let n = len(name)
    let prefix_len = len("__core_string_")
    let suffix_len = len("_impl")
    let middle_len = n - prefix_len - suffix_len
    if middle_len <= 0 {
        return false
    }
    let middle = name.slice(prefix_len, n - suffix_len)
    if eq(middle.clone(), "concat")
    || eq(middle.clone(), "clone")
    || eq(middle.clone(), "from_bytes")
    || eq(middle.clone(), "new")
    || eq(middle.clone(), "slice")
    || eq(middle.clone(), "push_range")
    || eq(middle.clone(), "join")
    || eq(middle.clone(), "pad_left")
    || eq(middle.clone(), "pad_left_fill")
    || eq(middle.clone(), "pad_right")
    || eq(middle.clone(), "pad_right_fill")
    || eq(middle.clone(), "repeat")
    || eq(middle.clone(), "replace")
    || eq(middle.clone(), "to_lowercase")
    || eq(middle.clone(), "to_uppercase")
    || eq(middle.clone(), "trim")
    || eq(middle.clone(), "trim_end")
    || eq(middle.clone(), "trim_start") {
        return true
    }
    false
}

fn is_raw_string_intrinsic_returning_string(name: String) -> bool {
    if is_direct_string_intrinsic(name.clone()) {
        return true
    }
    if eq(name.clone(), "raw.string_new")
    || eq(name.clone(), "raw.string_clone")
    || eq(name.clone(), "raw.string_from_bytes")
    || eq(name.clone(), "raw::raw_string_new")
    || eq(name.clone(), "raw::raw_string_clone")
    || eq(name.clone(), "raw::raw_string_from_bytes")
    || eq(name.clone(), "std::core::raw::raw_string_new")
    || eq(name.clone(), "std::core::raw::raw_string_clone")
    || eq(name.clone(), "std::core::raw::raw_string_from_bytes")
    || callee_spelling::is_namespace_member_callee(
        name.clone(),
        String_from("raw_string_new"),
        String_from("RawString"),
        String_from("new")
    )
    || callee_spelling::is_namespace_member_callee(
        name.clone(),
        String_from("raw_string_clone"),
        String_from("RawString"),
        String_from("clone")
    )
    || callee_spelling::is_namespace_member_callee(
        name.clone(),
        String_from("raw_string_from_bytes"),
        String_from("RawString"),
        String_from("from_bytes")
    ) {
        return true
    }
    false
}

fn is_direct_string_intrinsic(name: String) -> bool {
    if eq(name.clone(), "__intrinsic_string_new")
    || eq(name.clone(), "__intrinsic_string_clone")
    || eq(name.clone(), "__intrinsic_string_from")
    || eq(name.clone(), "__intrinsic_string_from_bytes")
    || eq(name.clone(), "__intrinsic_string_slice")
    || eq(name.clone(), "__intrinsic_concat")
    || eq(name.clone(), "__intrinsic_substring")
    || eq(name.clone(), "__intrinsic_replace")
    || eq(name.clone(), "__intrinsic_trim")
    || eq(name.clone(), "__intrinsic_to_lower")
    || eq(name.clone(), "__intrinsic_to_upper")
    || eq(name.clone(), "__intrinsic_join")
    || eq(name.clone(), "__intrinsic_char_to_string") {
        return true
    }
    false
}

fn is_hashmap_string_accessor(name: String) -> bool {
    if eq(name.clone(), "__hm_si_get_key") || eq(name.clone(), "__hm_is_get_val") || eq(name.clone(), "__hm_ss_get_key") || eq(name.clone(), "__hm_ss_get_val") {
        return true
    }
    if eq(name.clone(), "hash_string::hashmap_str_str_get_key") ||
    eq(name.clone(), "hash_string::hashmap_str_str_get_val") ||
    eq(name.clone(), "hash_string::hashmap_i32_str_get_val") ||
    eq(name.clone(), "hash_string::hashmap_str_i32_get_key") {
        return true
    }
    false
}

fn intrinsic_strip_mono_suffix(name: String) -> String {
    let name_len = len(name)
    let mut i = 0
    while i < name_len - 1 {
        if name.byte_at(i) == 95 && name.byte_at(i + 1) == 95 {
            return name.slice(0, i)
        }
        i = i + 1
    }
    name
}
