use std::host::stdio
use mir::function_core_record
use mir::module_record
use mir::function_block_queries
use mir::function_locals_view
use mir::block_inst_access

fn MirModule_functions(m: MirModule) -> Vec<MirFunction> {
    m.functions
}

fn MirModule_function_count(m: MirModule) -> i32 {
    len(m.functions)
}

fn MirModule_function_at(m: MirModule, idx: i32) -> MirFunction {
    get_unchecked(m.functions, idx)
}

fn MirModule_set_functions(m: MirModule, functions: Vec<MirFunction>) {
    m.functions = functions
}

fn MirModule_set_function_at(m: MirModule, idx: i32, f: MirFunction) {
    // In-place slot update: rebuilding the whole functions Vec per call is
    // Θ(F) alloc+copy and compounds under bump allocation (#823 / #730).
    set(m.functions, idx, f)
}

fn MirModule_push_function(m: MirModule, f: MirFunction) {
    push(m.functions, f)
}

fn MirModule_block_count(m: MirModule) -> i32 {
    let fn_count = MirModule_function_count(m)
    let mut total = 0
    let mut fi = 0
    while fi < fn_count {
        let f = MirModule_function_at(m, fi)
        total = total + function_block_queries::MirFunction_block_count(f)
        fi = fi + 1
    }
    total
}

fn MirModule_inst_count(m: MirModule) -> i32 {
    let fn_count = MirModule_function_count(m)
    let mut total = 0
    let mut fi = 0
    while fi < fn_count {
        let f = MirModule_function_at(m, fi)
        let block_count = function_block_queries::MirFunction_block_count(f)
        let mut bi = 0
        while bi < block_count {
            let block = function_block_queries::MirFunction_block_at(f, bi)
            total = total + block_inst_access::MirBlock_inst_count(block)
            bi = bi + 1
        }
        fi = fi + 1
    }
    total
}

fn MirModule_local_count(m: MirModule) -> i32 {
    let fn_count = MirModule_function_count(m)
    let mut total = 0
    let mut fi = 0
    while fi < fn_count {
        let f = MirModule_function_at(m, fi)
        total = total + function_locals_view::MirFunction_local_count(f)
        fi = fi + 1
    }
    total
}

fn mir_note_receipt_counts(m: MirModule, enabled: i32) {
    if enabled == 0 {
        return
    }
    stdio::eprintln(
        concat(
            "[arukellt] mir.counts: functions=",
            concat(
                to_string(MirModule_function_count(m)),
                concat(
                    " locals=",
                    concat(
                        to_string(MirModule_local_count(m)),
                        concat(" insts=", to_string(MirModule_inst_count(m)))
                    )
                )
            )
        )
    )
}
