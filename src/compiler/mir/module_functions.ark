use std::host::stdio::Stdio
use std::text
use mir::function_core_record
use mir::module_record
use mir::function_block_queries
use mir::function_locals_view
use mir::block_inst_access
fn MirModule_functions(m: MirModule) -> Vec<MirFunction> {
    m.functions
}

fn MirModule_function_count(m: MirModule) -> i32 {
    m.functions.len()
}

fn MirModule_function_at(m: MirModule, idx: i32) -> MirFunction {
    get_unchecked(m.functions, idx)
}

fn MirModule_set_functions(mut m: MirModule, functions: Vec<MirFunction>) {
    m.functions = functions
}

fn MirModule_set_function_at(mut m: MirModule, idx: i32, f: MirFunction) {
    // In-place slot update: rebuilding the whole functions Vec per call is
    // Θ(F) alloc+copy and compounds under bump allocation (#823 / #730).
    set(m.functions, idx, f)
}

fn MirModule_set_export_names(mut m: MirModule, names: Vec<String>) {
    m.export_names = names
    m.export_surface_set = true
}

fn MirModule_has_export_name(m: MirModule, name: String) -> bool {
    if !m.export_surface_set {
        return true
    }
    let mut i = 0
    while i < m.export_names.len() {
        if get_unchecked(m.export_names, i).clone().eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn MirModule_push_function(mut m: MirModule, f: MirFunction) {
    push(m.functions, f)
    // Keep 'return_variant_slots' parallel: 'unrecorded' marks functions
    // pushed outside the ctx lower path (smoke fixtures, ad-hoc modules)
    // so consumers fall back to deriving the slot from the body.
    push(m.return_variant_slots, mir_return_variant_slot_unrecorded())
}

// Sentinel for MirModule.return_variant_slots entries that were registered
// without a computed slot. Real slots are >= 0 or -1 (none/conflicting).
fn mir_return_variant_slot_unrecorded() -> i32 {
    0 - 2
}

fn MirModule_return_variant_slot_at(m: MirModule, idx: i32) -> i32 {
    if idx < 0 || idx >= m.return_variant_slots.len() {
        return mir_return_variant_slot_unrecorded()
    }
    get_unchecked(m.return_variant_slots, idx)
}

fn MirModule_set_return_variant_slot_at(mut m: MirModule, idx: i32, slot: i32) {
    if idx < 0 || idx >= m.return_variant_slots.len() {
        return
    }
    set(m.return_variant_slots, idx, slot)
}

fn MirModule_return_variant_slots(m: MirModule) -> Vec<i32> {
    m.return_variant_slots
}

fn MirModule_set_return_variant_slots(mut m: MirModule, slots: Vec<i32>) {
    m.return_variant_slots = slots
}

fn MirModule_discovery_fn_names(m: MirModule) -> Vec<String> {
    m.discovery_fn_names
}

fn MirModule_discovery_fn_ret_names(m: MirModule) -> Vec<String> {
    m.discovery_fn_ret_names
}

// Lower-phase diagnostics sink. Emit-side code paths that can prove the
// requested lowering is not representable record a message here; the
// pipeline rejects the module before emit so the failure surfaces as a
// compile diagnostic rather than invalid core Wasm (#906).
// Identical messages are deduplicated because the same weak scrutinee
// can be visited by several lowering paths in one module.
fn MirModule_record_diagnostic(mut m: MirModule, message: String) {
    let mut i = 0
    while i < m.diagnostics.len() {
        if get_unchecked(m.diagnostics, i).eq(message.clone()) {
            return
        }
        i = i + 1
    }
    push(m.diagnostics, message)
}

// Takes the recorded diagnostics out of the module, leaving an empty
// list. Returning the Vec keeps callers on std sequence ops instead of
// one accessor per query.
fn MirModule_drain_diagnostics(mut m: MirModule) -> Vec<String> {
    let out = m.diagnostics.clone()
    m.diagnostics = Vec::new<String>()
    out
}

fn MirModule_block_count(m: MirModule) -> i32 {
    let fn_count = MirModule_function_count(m)
    let mut total = 0
    let mut fi = 0
    while fi < fn_count {
        let f = MirModule_function_at(m, fi)
        total = total + function_block_queries::MirFunction_block_count(f)
        fi = fi + 1
    }
    total
}

fn MirModule_inst_count(m: MirModule) -> i32 {
    let fn_count = MirModule_function_count(m)
    let mut total = 0
    let mut fi = 0
    while fi < fn_count {
        let f = MirModule_function_at(m, fi)
        let block_count = function_block_queries::MirFunction_block_count(f)
        let mut bi = 0
        while bi < block_count {
            let block = function_block_queries::MirFunction_block_at(f, bi)
            total = total + block_inst_access::MirBlock_inst_count(block)
            bi = bi + 1
        }
        fi = fi + 1
    }
    total
}

fn MirModule_local_count(m: MirModule) -> i32 {
    let fn_count = MirModule_function_count(m)
    let mut total = 0
    let mut fi = 0
    while fi < fn_count {
        let f = MirModule_function_at(m, fi)
        total = total + function_locals_view::MirFunction_local_count(f)
        fi = fi + 1
    }
    total
}

fn mir_note_receipt_counts(m: MirModule, enabled: i32) {
    if enabled == 0 {
        return
    }
    Stdio::eprintln(
        "[arukellt] mir.counts: functions=".concat(
            MirModule_function_count(m).to_string().concat(" locals=".concat(MirModule_local_count(m).to_string().concat(" insts=".concat(MirModule_inst_count(m).to_string()))))
        )
    )
}
