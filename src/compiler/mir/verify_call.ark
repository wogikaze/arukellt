use std::text
use corehir::function_id
use mir::function_identity
use mir::host_intrinsic_stub_names
use mir::module_functions
use mir::block_inst_access
use mir::function_block_queries
use mir::inst_accessors_literals
use mir::inst_accessors_shape
use mir::inst_record
use mir::opcodes
use mir::spine_lookup
use mir::value_types
use mir::verify_report
use collections::name_index
fn verify_calls_in_module(m: MirModule, mut report: MirVerifyReport, verbose: bool) {
    let fn_names = verify_collect_module_fn_names(m)
    let count = module_functions::MirModule_function_count(m)
    let mut fi = 0
    while fi < count {
        let f = module_functions::MirModule_function_at(m, fi)
        verify_calls_in_function(f, m, report, verbose, fn_names)
        fi = fi + 1
    }
}

fn verify_calls_in_function(f: MirFunction, m: MirModule, mut report: MirVerifyReport, verbose: bool, fn_names: NameIndex) {
    let bc = function_block_queries::MirFunction_block_count(f)
    let mut bi = 0
    while bi < bc {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let ic = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < ic {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_CALL() {
                verify_one_call(inst, m, report, verbose, fn_names, function_identity::MirFunction_name(f))
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn verify_one_call(inst: MirInst, m: MirModule, mut report: MirVerifyReport, verbose: bool, fn_names: NameIndex, caller: String) {
    let callee = inst_accessors_literals::MirInst_str_val(inst)
    if len(callee) == 0 {
        mir_verify_report_add_w002(report)
        if verbose {
            mir_verify_report_push_detail(report, "W002 empty-callee in ".concat(caller))
        }
        return
    }
    if verify_call_w003_excluded(callee.clone()) {
        return
    }
    if !verify_fn_names_contains(fn_names, callee.clone()) {
        mir_verify_report_add_w003(report)
    }
    verify_call_result_type_present(inst, report, verbose, caller)
    verify_call_inv8_result_types(inst, m, report, verbose, caller)
}

// W009: a call with a valid func_id and a GC/ref result but no typed result
// cannot have its dest declared from the spine. Warning-only in 5.0 so the
// census shows where lowering still fabricates a call result type.
fn verify_call_result_type_present(
    inst: MirInst,
    mut report: MirVerifyReport,
    verbose: bool,
    caller: String
) {
    let fid = function_id::FunctionId_new(inst_record::mir_inst_func_id_raw(inst))
    if !function_id::function_id_is_valid(fid) {
        return
    }
    let vt = inst_accessors_shape::MirInst_val_type(inst)
    if vt != value_types::VT_GC_REF() && vt != value_types::VT_REF() {
        return
    }
    if inst_record::mir_inst_result_type_count(inst) > 0 {
        return
    }
    mir_verify_report_add_w009(report)
    if verbose {
        mir_verify_report_push_detail(report, "W009 call-missing-result-type ".concat(caller))
    }
}

fn verify_call_inv8_result_types(inst: MirInst, m: MirModule, mut report: MirVerifyReport, verbose: bool, caller: String) {
    let status = spine_lookup::call_result_types_status(m, inst)
    if status == 1 {
        mir_verify_report_add_w007(report)
        if verbose {
            mir_verify_report_push_detail(report, "W007 call-missing-result-types ".concat(caller))
        }
        return
    }
    if status == 2 {
        mir_verify_report_add_w007(report)
        if verbose {
            mir_verify_report_push_detail(report, "W007 call-result-vt-mismatch ".concat(caller))
        }
    }
}

fn verify_call_w003_excluded(callee: String) -> bool {
    if host_intrinsic_stub_names::host_intrinsic_stub_is_known(callee.clone()) {
        return true
    }
    if callee.clone().starts_with("__intrinsic_") {
        return true
    }
    if callee.clone().starts_with("__simd_") {
        return true
    }
    if callee.clone().eq("print") || callee.clone().eq("println") {
        return true
    }
    false
}

fn verify_fn_names_contains(fn_names: NameIndex, name: String) -> bool {
    name_index::name_index_get(fn_names, name) >= 0
}

fn verify_collect_module_fn_names(m: MirModule) -> NameIndex {
    let count = module_functions::MirModule_function_count(m)
    let mut result = name_index::NameIndex_new(count)
    let mut i = 0
    while i < count {
        name_index::name_index_insert_first(
            result,
            function_identity::MirFunction_name(module_functions::MirModule_function_at(m, i)),
            i
        )
        i = i + 1
    }
    result
}
