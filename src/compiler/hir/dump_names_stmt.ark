use hir::kinds

fn hir_stmt_tag_name(tag: i32) -> String {
    if tag == commands::HIR_LET() { return "Let" }
    if tag == commands::HIR_RETURN() { return "Return" }
    if tag == commands::HIR_WHILE() { return "While" }
    if tag == commands::HIR_EXPR_STMT() { return "ExprStmt" }
    String_new()
}
