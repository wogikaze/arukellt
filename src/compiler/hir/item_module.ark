use hir::item_function_core_record
use hir::item_trait_record

struct HirModule {
    functions: Vec<HirFunction>,
    structs: Vec<HirStructDef>,
    enums: Vec<HirEnumDef>,
    traits: Vec<HirTraitDecl>,
    impls: Vec<HirImplBlock>,
    imports: Vec<String>,
}

fn HirModule_new() -> HirModule {
    HirModule {
        functions: Vec::new<HirFunction>(),
        structs: Vec::new<HirStructDef>(),
        enums: Vec::new<HirEnumDef>(),
        traits: Vec::new<HirTraitDecl>(),
        impls: Vec::new<HirImplBlock>(),
        imports: Vec::new<String>()
    }
}

fn HirModule_push_function(mut module: HirModule, func: HirFunction) {
    module.functions.push(func)
}

fn HirModule_function_count(module: HirModule) -> i32 {
    module.functions.len()
}

fn HirModule_function_at(module: HirModule, index: i32) -> HirFunction {
    get_unchecked(module.functions, index)
}

fn HirModule_push_struct(mut module: HirModule, defn: HirStructDef) {
    module.structs.push(defn)
}

fn HirModule_push_enum(mut module: HirModule, defn: HirEnumDef) {
    module.enums.push(defn)
}

fn HirModule_push_trait(mut module: HirModule, decl: HirTraitDecl) {
    module.traits.push(decl)
}

fn HirModule_push_impl(mut module: HirModule, block: HirImplBlock) {
    module.impls.push(block)
}

fn HirModule_push_import(mut module: HirModule, import_path: String) {
    module.imports.push(import_path)
}
