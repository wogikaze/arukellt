use hir::kinds

fn hir_expr_tag_name(tag: i32) -> String {
    if tag == commands::HIR_INT_LIT() { return "IntLit" }
    if tag == commands::HIR_FLOAT_LIT() { return "FloatLit" }
    if tag == commands::HIR_STRING_LIT() { return "StringLit" }
    if tag == commands::HIR_BOOL_LIT() { return "BoolLit" }
    if tag == commands::HIR_IDENT() { return "Ident" }
    if tag == commands::HIR_BINARY() { return "Binary" }
    if tag == commands::HIR_UNARY() { return "Unary" }
    if tag == commands::HIR_CALL() { return "Call" }
    if tag == commands::HIR_FIELD() { return "Field" }
    if tag == commands::HIR_STRUCT_LIT() { return "StructLit" }
    if tag == commands::HIR_IF() { return "If" }
    if tag == commands::HIR_MATCH() { return "Match" }
    if tag == commands::HIR_BLOCK() { return "Block" }
    String_new()
}
