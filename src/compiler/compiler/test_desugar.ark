// ADR-041 Phase 2 (#719): AST-level desugar of `test` declarations for
// `arukellt test`. Each `test "name" { ... }` becomes a synthesized fn decl
// `__test_<n>` whose body is the test block; nested `test mod` blocks
// flatten their tests with `mod::name` display prefixes. One `__test_main`
// calls them in order and prints `PASS <name>` after each completed call.
// Desugared fns ride the normal resolve / typecheck / MIR pipeline, so no
// MIR-level synthesis is needed. Only applies when DriverConfig.test_mode
// is set; normal compiles still skip test decls at MIR per ADR-041 D5.
use std::text
use compiler::session_parse
use parser::ast
use parser::core_ast_children
use parser::core_ast_factory
use parser::core_ast_span_fields
use parser::core_ast_text_fields
use parser::kinds

pub fn desugar_test_decls(decls: Vec<AstNode>) -> Vec<AstNode> {
    let mut out = Vec::new<AstNode>()
    let mut names = Vec::new<String>()
    let decl_count = decls.len()
    let mut i = 0
    while i < decl_count {
        let decl = get_unchecked(decls, i)
        desugar_test_node(decl, out, names, String_new())
        i = i + 1
    }
    if names.len() == 0 {
        return out
    }
    let extra = synthesize_test_main(names, decls)
    let extra_count = extra.len()
    let mut j = 0
    while j < extra_count {
        push(out, get_unchecked(extra, j))
        j = j + 1
    }
    out
}

fn desugar_test_node(node: AstNode, mut out: Vec<AstNode>, mut names: Vec<String>, prefix: String) {
    let kind = ast::ast_node_kind(node)
    if kind == kinds::NK_TEST_MOD() {
        let mod_name = ast::ast_node_text(node)
        let child_count = ast::ast_node_child_count(node)
        let mut i = 0
        while i < child_count {
            let inner = ast::ast_node_child_at(node, i)
            desugar_test_node(inner, out, names, mod_name.clone())
            i = i + 1
        }
        return
    }
    if kind != kinds::NK_TEST_DECL() {
        push(out, node)
        return
    }
    let index = names.len()
    push(names, test_display_name(prefix, ast::ast_node_text(node)))
    push(out, synthesize_test_fn(node, index))
}

fn test_display_name(prefix: String, name: String) -> String {
    if prefix.clone().len() == 0 {
        return name
    }
    prefix.concat("::".concat(name))
}

// A `test "name" { body }` decl keeps its block as the only child — the
// optional `test <fn>` target ident is metadata for resolution only and
// is dropped (the body resolves the target fn by name like any caller).
fn synthesize_test_fn(test_node: AstNode, index: i32) -> AstNode {
    let span = core_ast_span_fields::AstNode_span(test_node)
    let mut node = core_ast_factory::AstNode_new(kinds::NK_FN_DECL(), span)
    core_ast_text_fields::AstNode_set_text(node, "__test_".concat(index.to_string()))
    core_ast_span_fields::AstNode_set_name_span(node, span)
    let child_count = ast::ast_node_child_count(test_node)
    let body = ast::ast_node_child_at(test_node, child_count - 1)
    core_ast_children::AstNode_push_child(node, body)
    node
}

// The `__test_main` body (and its `use std::host::stdio::Stdio`) are built by
// parsing a generated snippet — the call/print statement shapes stay in
// sync with the real grammar instead of hand-built child layouts.
fn synthesize_test_main(names: Vec<String>, decls: Vec<AstNode>) -> Vec<AstNode> {
    let mut src = String_new()
    if !has_stdio_use(decls) {
        src = src.concat("use std::host::stdio::Stdio\n")
    }
    src = src.concat("fn __test_main() {\n")
    let name_count = names.len()
    let mut i = 0
    while i < name_count {
        src = src.concat("    __test_".concat(i.to_string()))
        src = src.concat("()\n")
        src = src.concat("    Stdio::println(\"  PASS ".concat(escape_test_name(get_unchecked(names, i))))
        src = src.concat("\")\n")
        i = i + 1
    }
    src = src.concat("}\n")
    session_parse::session_parse_decls(src)
}

fn has_stdio_use(decls: Vec<AstNode>) -> bool {
    let decl_count = decls.len()
    let mut i = 0
    while i < decl_count {
        let decl = get_unchecked(decls, i)
        if ast::ast_node_kind(decl) == kinds::NK_USE() {
            if ast::ast_node_text(decl).eq("std::host::stdio::Stdio") && ast::ast_node_child_count(decl) == 0 {
                return true
            }
        }
        i = i + 1
    }
    false
}

fn escape_test_name(name: String) -> String {
    let mut out = String_new()
    let n = name.len()
    let mut i = 0
    while i < n {
        let ch = name.clone().slice(i, i + 1)
        if ch.clone().eq("\\") {
            out = out.concat("\\\\")
        } else if ch.clone().eq("\"") {
            out = out.concat("\\\"")
        } else {
            out = out.concat(ch)
        }
        i = i + 1
    }
    out
}
