// Canonical Layer C WIT identity validation and rendering.
// Source-module paths intentionally remain outside this namespace.

use std::text
fn wit_identity_find(s: String, ch: i32, from: i32) -> i32 {
    let mut i = from
    while i < len(s) {
        if s.byte_at(i) == ch {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn wit_identity_name_byte(ch: i32) -> bool {
    (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 45
}

fn wit_identity_name_is_valid(s: String, start: i32, end: i32) -> bool {
    if end <= start {
        return false
    }
    let first = s.byte_at(start)
    if first < 97 || first > 122 {
        return false
    }
    let mut i = start
    while i < end {
        let ch = s.byte_at(i)
        if !wit_identity_name_byte(ch) {
            return false
        }
        if ch == 45 {
            if i == start || i + 1 == end || s.byte_at(i - 1) == 45 {
                return false
            }
        }
        i = i + 1
    }
    true
}

fn wit_identity_version_is_valid(version: String) -> bool {
    if len(version) == 0 {
        return false
    }
    let mut component_start = 0
    let mut component_count = 0
    let mut i = 0
    while i <= len(version) {
        if i == len(version) || version.byte_at(i) == 46 {
            if i == component_start {
                return false
            }
            component_count = component_count + 1
            component_start = i + 1
        } else {
            let ch = version.byte_at(i)
            if ch < 48 || ch > 57 {
                return false
            }
        }
        i = i + 1
    }
    component_count == 3
}

pub fn wit_package_identity_error(id: String) -> String {
    if len(id) == 0 {
        return "WIT package identifier must not be empty"
    }
    let colon = wit_identity_find(id, 58, 0)
    if colon <= 0 || wit_identity_find(id, 58, colon + 1) >= 0 {
        return "WIT package identifier must use namespace:package form"
    }
    if wit_identity_find(id, 47, 0) >= 0 {
        return "WIT package identifier must not contain /"
    }
    let at = wit_identity_find(id, 64, colon + 1)
    let package_end = if at < 0 { len(id) } else { at }
    if !wit_identity_name_is_valid(id, 0, colon) {
        return "WIT namespace must use a lowercase kebab-case identifier"
    }
    if !wit_identity_name_is_valid(id, colon + 1, package_end) {
        return "WIT package must use a lowercase kebab-case identifier"
    }
    if at >= 0 {
        if wit_identity_find(id, 64, at + 1) >= 0 {
            return "WIT package identifier may contain only one @version suffix"
        }
        if !wit_identity_version_is_valid(id.slice(at + 1, len(id))) {
            return "WIT package version must use major.minor.patch form"
        }
    }
    String_new()
}

pub fn wit_identifier_error(id: String) -> String {
    if len(id) == 0 {
        return "WIT import string must not be empty"
    }
    let colon = wit_identity_find(id, 58, 0)
    if colon <= 0 || wit_identity_find(id, 58, colon + 1) >= 0 {
        return "WIT import must use namespace:package/interface form"
    }
    let slash = wit_identity_find(id, 47, colon + 1)
    if slash <= colon + 1 || wit_identity_find(id, 47, slash + 1) >= 0 {
        return "WIT import must use namespace:package/interface form"
    }
    if !wit_identity_name_is_valid(id, 0, colon) {
        return "WIT namespace must use a lowercase kebab-case identifier"
    }
    if !wit_identity_name_is_valid(id, colon + 1, slash) {
        return "WIT package must use a lowercase kebab-case identifier"
    }
    let at = wit_identity_find(id, 64, slash + 1)
    let interface_end = if at < 0 { len(id) } else { at }
    if !wit_identity_name_is_valid(id, slash + 1, interface_end) {
        return "WIT interface must use a lowercase kebab-case identifier"
    }
    if at >= 0 {
        if wit_identity_find(id, 64, at + 1) >= 0 {
            return "WIT import may contain only one @version suffix"
        }
        let version = id.slice(at + 1, len(id))
        if !wit_identity_version_is_valid(version) {
            return "WIT import version must use major.minor.patch form"
        }
    }
    String_new()
}

pub fn wit_identifier_package(id: String) -> String {
    let slash = wit_identity_find(id, 47, 0)
    if slash < 0 {
        return id.clone()
    }
    id.slice(0, slash)
}

pub fn wit_identifier_interface(id: String) -> String {
    let slash = wit_identity_find(id, 47, 0)
    if slash < 0 {
        return String_new()
    }
    let start = slash + 1
    let at = wit_identity_find(id, 64, start)
    if at < 0 {
        return id.slice(start, len(id))
    }
    id.slice(start, at)
}

pub fn wit_identifier_version(id: String) -> String {
    let slash = wit_identity_find(id, 47, 0)
    if slash < 0 {
        return String_new()
    }
    let at = wit_identity_find(id, 64, slash + 1)
    if at < 0 {
        return String_new()
    }
    id.slice(at + 1, len(id))
}

pub fn wit_identifier_path(package: String, interface: String) -> String {
    package.clone().concat("/".concat(interface.clone()))
}

pub fn wit_identifier_canonical(package: String, interface: String, version: String) -> String {
    let path = wit_identifier_path(package.clone(), interface.clone())
    if len(version) == 0 {
        return path
    }
    path.concat("@".concat(version.clone()))
}

pub fn wit_identifier_default_alias(id: String) -> String {
    wit_identifier_interface(id.clone())
}
