use std::text
use analysis::diagnostic_record
use analysis::snapshot_state_record
use compiler::session_analyze_pipeline
use compiler::phase_tags
use compiler::phases

/// Identifies diagnostics produced before a token stream is available.
pub fn PHASE_LEX() -> i32 {
    phases::PHASE_LEX()
}

/// Identifies diagnostics produced while constructing the syntax tree.
pub fn PHASE_PARSE() -> i32 {
    phases::PHASE_PARSE()
}

/// Identifies diagnostics produced while binding names and modules.
pub fn PHASE_RESOLVE() -> i32 {
    phases::PHASE_RESOLVE()
}

/// Identifies diagnostics produced while checking types and calls.
pub fn PHASE_TYPECHECK() -> i32 {
    phases::PHASE_TYPECHECK()
}

/// Identifies non-fatal diagnostics produced by the lint pass.
pub fn PHASE_LINT() -> i32 {
    phases::PHASE_LINT()
}

/// Analyzes one source document without imported module declarations.
pub fn analyze(uri: String, text: String) -> AnalysisSnapshot {
    session_analyze_pipeline::run_session_analyze(uri, text)
}

/// Analyzes a source document with the supplied imported-module declarations.
pub fn analyze_with_modules(uri: String, text: String, modules: Vec<ModuleDecls>) -> AnalysisSnapshot {
    session_analyze_pipeline::run_session_analyze_with_modules(uri, text, modules)
}

/// Serializes an analysis snapshot in the stable line-oriented IDE summary format.
pub fn snapshot_summary(snap: AnalysisSnapshot) -> String {
    let mut out = "analysis "
    out = out.concat(snapshot_state_record::snapshot_uri(snap))
    out = out.concat("\n")
    out = out.concat("decls=")
    out = out.concat(snapshot_state_record::snapshot_decl_count(snap).to_string())
    out = out.concat(" symbols=")
    out = out.concat(snapshot_state_record::snapshot_symbol_count(snap).to_string())
    out = out.concat(" typed=")
    out = out.concat(snapshot_state_record::snapshot_typed_fn_count(snap).to_string())
    out = out.concat(" diagnostics=")
    out = out.concat(snapshot_state_record::snapshot_reported_diagnostic_count(snap).to_string())
    out = out.concat("\n")
    let dn = snapshot_state_record::snapshot_diagnostic_count(snap)
    let mut i = 0
    while i < dn {
        let d = snapshot_state_record::snapshot_diagnostic_at(snap, i)
        out = out.concat(phase_tags::phase_tag(diagnostic_record::analysis_diagnostic_phase(d)))
        out = out.concat(": ")
        out = out.concat(diagnostic_record::analysis_diagnostic_message(d))
        out = out.concat("\n")
        i = i + 1
    }
    out
}
