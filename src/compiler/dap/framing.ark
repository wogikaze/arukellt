use std::json
use std::text
struct DapFrameResult {
    body: String,
    next: i32,
    ok: bool,
}

fn dap_frame(body: String) -> String {
    let header = "Content-Length: ".concat(len(body.clone()).to_string().concat("\r\n\r\n"))
    header.concat(body)
}

fn dap_parse_frame(input: String, pos: i32) -> DapFrameResult {
    let n = len(input)
    let mut p = pos
    while p < n {
        let c = input.byte_at(p)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        p = p + 1
    }
    if p >= n {
        return DapFrameResult { body: String_new(), next: n, ok: false }
    }
    let header_end_rel = input.clone().slice(p, n).index_of("\r\n\r\n")
    if header_end_rel < 0 {
        return DapFrameResult { body: String_new(), next: n, ok: false }
    }
    let header_block = input.clone().slice(p, p + header_end_rel)
    let clen = json::JsonText::content_length(header_block.clone())
    if clen < 0 {
        return DapFrameResult { body: String_new(), next: n, ok: false }
    }
    let body_start = p + header_end_rel + 4
    if body_start + clen > n {
        return DapFrameResult { body: String_new(), next: n, ok: false }
    }
    let body_text = input.clone().slice(body_start, body_start + clen)
    DapFrameResult { body: body_text, next: body_start + clen, ok: true }
}

fn dap_frame_result_ok(result: DapFrameResult) -> bool {
    result.ok
}

fn dap_frame_result_body(result: DapFrameResult) -> String {
    result.body.clone()
}

fn dap_frame_result_next(result: DapFrameResult) -> i32 {
    result.next
}
