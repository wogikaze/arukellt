use std::text

fn dap_init_resp(seq: i32, request_seq: i32) -> String {
    let mut body = "{\"seq\":"
    body = text::builder_append(body, to_string(seq))
    body = text::builder_append(body, ",\"type\":\"response\",\"request_seq\":")
    body = text::builder_append(body, to_string(request_seq))
    body = text::builder_append(body, ",\"success\":true,\"command\":\"initialize\"")
    body = text::builder_append(body, ",\"body\":{\"supportsConfigurationDoneRequest\":true}}")
    body
}

fn dap_launch_resp(seq: i32, request_seq: i32) -> String {
    let mut body = "{\"seq\":"
    body = text::builder_append(body, to_string(seq))
    body = text::builder_append(body, ",\"type\":\"response\",\"request_seq\":")
    body = text::builder_append(body, to_string(request_seq))
    body = text::builder_append(body, ",\"success\":true,\"command\":\"launch\",\"body\":{}}")
    body
}

fn dap_disconnect_resp(seq: i32, request_seq: i32) -> String {
    let mut body = "{\"seq\":"
    body = text::builder_append(body, to_string(seq))
    body = text::builder_append(body, ",\"type\":\"response\",\"request_seq\":")
    body = text::builder_append(body, to_string(request_seq))
    body = text::builder_append(body, ",\"success\":true,\"command\":\"disconnect\",\"body\":{}}")
    body
}

fn dap_init_evt(seq: i32) -> String {
    let mut body = "{\"seq\":"
    body = text::builder_append(body, to_string(seq))
    body = text::builder_append(body, ",\"type\":\"event\",\"event\":\"initialized\"}")
    body
}
