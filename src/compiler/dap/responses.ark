use std::text
fn dap_init_resp(seq: i32, request_seq: i32) -> String {
    let mut body = "{\"seq\":"
    body = body.concat(seq.to_string())
    body = body.concat(",\"type\":\"response\",\"request_seq\":")
    body = body.concat(request_seq.to_string())
    body = body.concat(",\"success\":true,\"command\":\"initialize\"")
    body = body.concat(",\"body\":{\"supportsConfigurationDoneRequest\":true}}")
    body
}

fn dap_launch_resp(seq: i32, request_seq: i32) -> String {
    let mut body = "{\"seq\":"
    body = body.concat(seq.to_string())
    body = body.concat(",\"type\":\"response\",\"request_seq\":")
    body = body.concat(request_seq.to_string())
    body = body.concat(",\"success\":true,\"command\":\"launch\",\"body\":{}}")
    body
}

fn dap_disconnect_resp(seq: i32, request_seq: i32) -> String {
    let mut body = "{\"seq\":"
    body = body.concat(seq.to_string())
    body = body.concat(",\"type\":\"response\",\"request_seq\":")
    body = body.concat(request_seq.to_string())
    body = body.concat(",\"success\":true,\"command\":\"disconnect\",\"body\":{}}")
    body
}

fn dap_init_evt(seq: i32) -> String {
    let mut body = "{\"seq\":"
    body = body.concat(seq.to_string())
    body = body.concat(",\"type\":\"event\",\"event\":\"initialized\"}")
    body
}
