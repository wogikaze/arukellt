use std::host::fs::Fs
use std::text
use loader::registry_config
fn registry_error_unreachable(url: String, reason: String) -> String {
    "registry unreachable: ".concat(url.clone().concat(" (".concat(reason.concat(")"))))
}

fn registry_error_not_found(package_name: String) -> String {
    "package '".concat(package_name.clone().concat("' not found in registry"))
}

fn starts_with_http(url: String) -> bool {
    url.clone().starts_with("http://") || url.clone().starts_with("https://")
}

fn starts_with_file(url: String) -> bool {
    url.clone().starts_with("file://")
}

fn file_registry_root(package_root: String, registry_url: String) -> String {
    if registry_url.clone().eq("file://.") {
        return package_root.clone()
    }
    if registry_url.clone().starts_with("file://./") {
        let rel = registry_url.slice(7, len(registry_url))
        return package_root.clone().concat("/".concat(rel))
    }
    if registry_url.clone().starts_with("file://") {
        return registry_url.slice(7, len(registry_url))
    }
    package_root.clone()
}

fn registry_package_primary_path(registry_root: String, package_name: String) -> String {
    registry_root.clone().concat("/".concat(package_name.clone().concat(".ark")))
}

fn registry_package_mod_path(registry_root: String, package_name: String) -> String {
    registry_root.clone().concat("/".concat(package_name.clone().concat("/mod.ark")))
}

fn read_local_registry_source(registry_root: String, package_name: String) -> Result<String, String> {
    let primary = registry_package_primary_path(registry_root.clone(), package_name.clone())
    match Fs::read_to_string(primary.clone()) {
        Result::Ok(source) => Result::Ok(source),
        Result::Err(_) => {
            let mod_path = registry_package_mod_path(registry_root.clone(), package_name.clone())
            match Fs::read_to_string(mod_path.clone()) {
                Result::Ok(source) => Result::Ok(source),
                Result::Err(_) => Result::Err(registry_error_not_found(package_name.clone())),
            }
        },
    }
}

fn http_registry_fetch_url(registry_url: String, package_name: String) -> String {
    if registry_url.clone().ends_with("/") {
        return registry_url.clone().concat(package_name.clone().concat(".ark"))
    }
    registry_url.clone().concat("/".concat(package_name.clone().concat(".ark")))
}

fn read_http_registry_source(registry_url: String, package_name: String) -> Result<String, String> {
    // Registry fetch is intentionally independent of application network
    // imports; network access belongs to an explicit official WIT world.
    let _package_name = package_name
    Result::Err(registry_error_unreachable(registry_url.clone(), "http registry fetch unsupported on wasm32-gc"))
}

pub fn resolve_registry_module_source(package_root: String, package_name: String) -> Result<String, String> {
    if !registry_config::is_registry_dependency(package_root.clone(), package_name.clone()) {
        return Result::Err(registry_error_not_found(package_name.clone()))
    }
    let registry_url = registry_config::registry_url_for_root(package_root.clone())
    if len(registry_url) == 0 {
        return Result::Err(registry_error_not_found(package_name.clone()))
    }
    if starts_with_file(registry_url.clone()) {
        let registry_root = file_registry_root(package_root.clone(), registry_url.clone())
        return read_local_registry_source(registry_root, package_name.clone())
    }
    if starts_with_http(registry_url.clone()) {
        return read_http_registry_source(registry_url.clone(), package_name.clone())
    }
    Result::Err(registry_error_unreachable(registry_url.clone(), "unsupported registry URL scheme"))
}
