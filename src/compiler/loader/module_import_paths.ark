use std::prelude::{clone}
use resolver::ast_access
use resolver::ast_decl_predicates
use resolver::paths
use loader::module_paths
fn push_import_decl_paths(mut paths: Vec<String>, decl: AstNode) {
    let num_children = ast_access::node_child_count(decl)
    let decl_path = ast_access::node_text(decl)
    if num_children > 0 {
        let parent_path = paths::use_module_parent_path(clone(decl_path))
        if len(clone(parent_path)) > 0 {
            push(paths, parent_path)
        } else {
            push(paths, decl_path)
        }
        // Destructure children may name submodules ("use std::text::{string}").
        // Push each child path too: module children resolve to real files while
        // function children ("use std::text::string::{split}") fail to load
        // silently — stdlib reads return Err and local reads fall back to the
        // parent module before reporting an error.
        let mut ci = 0
        while ci < num_children {
            let child = ast_access::node_child_at(decl, ci)
            if ast_decl_predicates::node_is_use(child) {
                push(paths, ast_access::node_text(child))
            }
            ci = ci + 1
        }
        return
    }
    // A single member path (`use std::collections::deque::Deque`) is not a
    // module, so loading it directly fails silently and its defining module
    // never loads. Load the parent module as well; the full path stays for
    // real module imports, which resolve first.
    push(paths, clone(decl_path))
    let import_parent_path = paths::use_module_parent_path(clone(decl_path))
    if len(clone(import_parent_path)) > 0 && module_paths::is_stdlib_path(clone(import_parent_path)) {
        push(paths, import_parent_path)
    }
}

pub fn collect_import_paths(decls: Vec<AstNode>) -> Vec<String> {
    let mut paths = Vec::new<String>()
    let count = len(decls)
    let mut i = 0
    while i < count {
        let d = get_unchecked(decls, i)
        if ast_decl_predicates::node_is_use(d) {
            push_import_decl_paths(paths, d)
        } else {
            if ast_decl_predicates::node_is_import(d) {
                push(paths, ast_access::node_text(d))
            }
        }
        i = i + 1
    }
    paths
}
