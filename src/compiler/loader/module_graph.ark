use std::prelude::{clone, contains, eq}
use loader::module_state_loading
use loader::module_import_paths
use loader::module_local_decls
use loader::module_file_load_local
use loader::module_package_root
use loader::module_paths
use loader::module_sealed_raw
use loader::module_state
use loader::module_state_errors
use loader::module_stdlib_decls
use loader::wit_manifest
pub fn load_stdlib_module(stdlib_path: String, mut state: LoadState) {
    let mod_decls = module_stdlib_decls::load_stdlib_module_decls(stdlib_path, state)
    // Stdlib modules may import sealed raw APIs.
    load_imported_modules_at(mod_decls, ".", ".", state, true)
    if stdlib_adapter_needs_flat_hashmap(clone(stdlib_path)) {
        // __hm_*_new calls inside these adapter bodies lower to a call of
        // hash::hashmap_new on linear targets. The adapters cannot spell the
        // dependency as `use std::collections::hash` because its short name
        // collides with `use std::core::hash`, so the module edge is
        // injected here for every load path (#874).
        load_stdlib_module("std::collections::hash", state)
    }
}

fn stdlib_adapter_needs_flat_hashmap(stdlib_path: String) -> bool {
    eq(clone(stdlib_path), "std::collections::hash_map") ||
    eq(clone(stdlib_path), "std::collections::hash_string") ||
    eq(clone(stdlib_path), "std::collections::hash_fn") ||
    eq(clone(stdlib_path), "std::collections::hash_str_fn")
}

pub fn load_imported_modules(decls: Vec<AstNode>, base_dir: String, mut state: LoadState) {
    let root_dir = module_package_root::find_package_root(clone(base_dir))
    // User/package modules cannot import sealed raw APIs.
    load_imported_modules_at(decls, clone(base_dir), root_dir, state, false)
}

fn load_imported_modules_at(
    decls: Vec<AstNode>,
    current_dir: String,
    root_dir: String,
    mut state: LoadState,
    importer_is_stdlib: bool
) {
    let import_paths = module_import_paths::collect_import_paths(decls)
    let count = len(import_paths)
    let mut i = 0
    while i < count {
        load_import_path(
            clone(get_unchecked(import_paths, i)),
            clone(current_dir),
            clone(root_dir),
            state,
            importer_is_stdlib
        )
        i = i + 1
    }
}

fn load_import_path(
    use_path: String,
    current_dir: String,
    root_dir: String,
    mut state: LoadState,
    importer_is_stdlib: bool
) {
    if module_sealed_raw::is_sealed_raw_api_path(clone(use_path)) {
        if !importer_is_stdlib {
            module_state_errors::LoadState_push_error(
                state,
                module_sealed_raw::sealed_raw_api_reject_message(clone(use_path))
            )
            return
        }
        let std_path = module_sealed_raw::sealed_raw_api_stdlib_path(clone(use_path))
        load_stdlib_module(std_path, state)
        return
    }
    if module_paths::is_stdlib_path(clone(use_path)) {
        load_stdlib_module(clone(use_path), state)
        return
    }
    if wit_manifest::is_wit_package_id(clone(use_path)) {
        return
    }
    load_local_module_or_parent(
        clone(use_path),
        module_base_dir_for_import(clone(use_path), clone(current_dir), clone(root_dir)),
        current_dir,
        root_dir,
        state
    )
}

fn load_local_module_or_parent(
    module_name: String,
    base_dir: String,
    fallback_dir: String,
    root_dir: String,
    mut state: LoadState
) {
    // Dedup before touching the filesystem: every `use` edge reaches this
    // point, and re-reading an already-loaded module file per edge multiplied
    // file I/O by the edge count.
    if module_local_decls::should_skip_local_module_read(clone(module_name), clone(base_dir), state) {
        return
    }
    let direct = module_file_load_local::read_local_module_source(clone(module_name), clone(base_dir))
    if module_file_load_local::DriverLoadedSource_is_ok(direct) {
        load_single_module(module_name, base_dir, root_dir, state)
        return
    }
    if try_load_at_package_root(clone(module_name), clone(base_dir), clone(root_dir), state) {
        return
    }
    let parent_name = resolver::paths::use_module_parent_path(clone(module_name))
    if len(clone(parent_name)) > 0 {
        let parent_base = module_base_dir_for_import(clone(parent_name), clone(fallback_dir), clone(root_dir))
        let parent = module_file_load_local::read_local_module_source(clone(parent_name), clone(parent_base))
        if module_file_load_local::DriverLoadedSource_is_ok(parent) {
            load_single_module(parent_name, parent_base, root_dir, state)
            return
        }
        if try_load_at_package_root(clone(parent_name), clone(parent_base), clone(root_dir), state) {
            return
        }
    }
    load_single_module(module_name, base_dir, root_dir, state)
}

// Importer-relative candidates already missed. A file in a nested package
// dir can still reference a module that lives at the package root, so retry
// there before reporting a miss. Runs after the sibling candidates so
// existing resolution order is unchanged.
fn try_load_at_package_root(module_name: String, tried_dir: String, root_dir: String, mut state: LoadState) -> bool {
    if eq(clone(tried_dir), clone(root_dir)) {
        return false
    }
    if module_local_decls::should_skip_local_module_read(clone(module_name), clone(root_dir), state) {
        // Already loaded from the root location (or a circular edge, which
        // pushed its own error) — resolved, nothing left to try.
        return true
    }
    let at_root = module_file_load_local::read_local_module_source(clone(module_name), clone(root_dir))
    if !module_file_load_local::DriverLoadedSource_is_ok(at_root) {
        return false
    }
    load_single_module(module_name, root_dir, root_dir, state)
    true
}

fn load_single_module(module_name: String, base_dir: String, root_dir: String, mut state: LoadState) {
    let loaded = module_local_decls::load_local_module_decls(clone(module_name), clone(base_dir), state)
    let next_dir = module_paths::parent_dir(module_local_decls::DriverLocalModuleDecls_path(loaded))
    // Local package modules are never stdlib importers.
    load_imported_modules_at(module_local_decls::DriverLocalModuleDecls_decls(loaded), next_dir, root_dir, state, false)
    if module_local_decls::DriverLocalModuleDecls_pushed_stack(loaded) {
        module_state_loading::LoadState_pop_loading(state)
    }
}

fn module_base_dir_for_import(use_path: String, current_dir: String, root_dir: String) -> String {
    if contains(use_path, "::") {
        return root_dir
    }
    current_dir
}
