use std::prelude::{eq}
fn vec_has(v: Vec<String>, name: String) -> bool {
    let count = len(v)
    let mut i = 0
    while i < count {
        if eq(get_unchecked(v, i).clone(), name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

// Open-addressing index over loaded_names. Module loading re-checks membership
// once per `use` edge, and the compiler closure has ~1.4k modules / ~10k edges,
// so a linear scan here dominated all of load time. Same FNV-1a + probing
// convention as mir::mono_index_types (#912).
fn load_state_string_hash(name: String) -> i32 {
    let mut hash = 216613626
    let name_len = len(name)
    let mut hi = 0
    while hi < name_len {
        hash = hash * 16777619 ^ name.byte_at(hi)
        if hash < 0 {
            hash = 0 - hash
        }
        hi = hi + 1
    }
    if hash < 0 {
        return 0
    }
    hash
}

// Returns the probe slot: a 0 bucket is an insertion point, a nonzero bucket
// holds keys[bucket-1] == name.
fn load_state_probe(keys: Vec<String>, slots: Vec<i32>, name: String) -> i32 {
    let capacity = len(slots)
    if capacity <= 0 {
        return 0 - 1
    }
    let mut slot = load_state_string_hash(name) % capacity
    let mut probes = 0
    while probes < capacity {
        let bucket = get_unchecked(slots, slot)
        if bucket == 0 {
            return slot
        }
        if eq(get_unchecked(keys, bucket - 1), name.clone()) {
            return slot
        }
        slot = (slot + 1) % capacity
        probes = probes + 1
    }
    0 - 1
}

fn load_state_zero_slots(size: i32) -> Vec<i32> {
    let mut slots = Vec::new<i32>()
    let mut i = 0
    while i < size {
        push(slots, 0)
        i = i + 1
    }
    slots
}

fn load_state_rehash(keys: Vec<String>, capacity: i32) -> Vec<i32> {
    let mut slots = load_state_zero_slots(capacity)
    let mut i = 0
    while i < len(keys) {
        let slot = load_state_probe(keys.clone(), slots, get_unchecked(keys, i).clone())
        set(slots, slot, i + 1)
        i = i + 1
    }
    slots
}

fn load_state_ensure_loaded_index(mut state: LoadState) {
    let mut capacity = len(state.loaded_slots)
    if capacity > 0 && len(state.loaded_names) * 2 < capacity {
        return
    }
    if capacity == 0 {
        capacity = 64
    }
    while capacity <= len(state.loaded_names) * 2 {
        capacity = capacity * 2
    }
    state.loaded_slots = load_state_rehash(state.loaded_names.clone(), capacity)
}

fn LoadState_has_loaded(state: LoadState, name: String) -> bool {
    if len(state.loaded_slots) <= 0 {
        return false
    }
    let slot = load_state_probe(state.loaded_names.clone(), state.loaded_slots.clone(), name.clone())
    if slot < 0 {
        return false
    }
    get_unchecked(state.loaded_slots, slot) > 0
}

fn LoadState_has_loading(state: LoadState, name: String) -> bool {
    vec_has(state.loading_stack, name)
}

fn LoadState_push_loading(mut state: LoadState, name: String) {
    push(state.loading_stack, name)
}

fn LoadState_pop_loading(mut state: LoadState) {
    if len(state.loading_stack) > 0 {
        pop(state.loading_stack)
    }
}

fn LoadState_push_loaded(mut state: LoadState, name: String) {
    push(state.loaded_names, name)
    load_state_ensure_loaded_index(state)
    let slot = load_state_probe(state.loaded_names.clone(), state.loaded_slots.clone(), name.clone())
    if slot < 0 {
        return
    }
    set(state.loaded_slots, slot, len(state.loaded_names))
}
