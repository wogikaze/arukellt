use std::prelude::{eq}
use std::text
pub fn is_stdlib_path(path: String) -> bool {
    let n = len(path)
    if n < 5 {
        return false
    }
    eq(path.slice(0, 5), "std::")
}

pub fn stdlib_path_to_file(path: String) -> String {
    let n = len(path)
    let mut result = ""
    let mut i = 0
    let mut seg_start = 0
    while i < n {
        if path.byte_at(i) == 58 && i + 1 < n && path.byte_at(i + 1) == 58 {
            result = result.clone().concat(path.clone().slice(seg_start, i).concat("/"))
            i = i + 2
            seg_start = i
        } else {
            i = i + 1
        }
    }
    result.clone().concat(path.clone().slice(seg_start, n).concat(".ark"))
}

pub fn stdlib_mod_fallback_path(primary: String) -> String {
    let n = len(primary)
    primary.clone().slice(0, n - 4).concat("/mod.ark")
}
test mod "stdlib_path" {
    test "is_std" { assert(is_stdlib_path("std::core")) }
    test "not_std" { assert(is_stdlib_path("local::m") == false) }
    test "to_file" { assert(eq(stdlib_path_to_file("std::core"), "std/core.ark")) }
}
