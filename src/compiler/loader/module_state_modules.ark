struct ModuleDecls {
    name: String,
    decls: Vec<AstNode>,
}

fn ModuleDecls_new(name: String, decls: Vec<AstNode>) -> ModuleDecls {
    ModuleDecls { name: name, decls: decls }
}

fn LoadState_modules(state: LoadState) -> Vec<ModuleDecls> {
    state.modules
}

// ModuleDecls stays {name, decls}: the resolver namespace owns a same-named
// public record and the typechecker resolves both by bare name, so widening
// this struct corrupts the shared layout. Stdlib provenance rides in the
// parallel LoadState.module_stdlib_flags vec instead.
fn LoadState_add_module(mut state: LoadState, name: String, decls: Vec<AstNode>, is_stdlib: bool) {
    state.modules.push(ModuleDecls_new(name, decls))
    state.module_stdlib_flags.push(is_stdlib)
}

// Stdlib provenance per registered module, index-aligned with modules. The
// CoreOp body-defer shim list is only valid for stdlib decls: a user module
// whose bare fn name matches a bound callee (strings::repeat vs repeat) must
// still lower its own body, or the emitted call collapses to
// drop+unreachable (#920).
fn LoadState_module_stdlib_flags(state: LoadState) -> Vec<bool> {
    state.module_stdlib_flags
}

fn ModuleDecls_decl_count(module: ModuleDecls) -> i32 {
    module.decls.len()
}

fn ModuleDecls_decl_at(module: ModuleDecls, index: i32) -> AstNode {
    module.decls.get_unchecked(index)
}

fn LoadState_release_module_asts(mut state: LoadState) {
    let module_count = state.modules.len()
    let mut mi = 0
    while mi < module_count {
        let mut module = state.modules.get_unchecked(mi)
        module.decls = Vec::new<AstNode>()
        mi = mi + 1
    }
    state.modules = Vec::new<ModuleDecls>()
}
