use std::text
pub fn path_parent_dir(path: String) -> String {
    let n = path.len()
    let mut last_slash = 0 - 1
    let mut i = n - 1
    while i >= 0 {
        if path.slice(i, i + 1).eq("/") {
            last_slash = i
            i = 0 - 1
        } else {
            i = i - 1
        }
    }
    if last_slash < 0 {
        "."
    } else {
        if last_slash == 0 {
            "/"
        } else {
            path.slice(0, last_slash)
        }
    }
}

pub fn module_path_to_file_stem(path: String) -> String {
    let n = path.len()
    let mut result = ""
    let mut i = 0
    let mut seg_start = 0
    while i < n {
        if path.byte_at(i) == 58 && i + 1 < n && path.byte_at(i + 1) == 58 {
            result = result.clone().concat(path.clone().slice(seg_start, i).concat("/"))
            i = i + 2
            seg_start = i
        } else {
            i = i + 1
        }
    }
    result.clone().concat(path.clone().slice(seg_start, n))
}

pub fn module_stem_to_mod_path(base_dir: String, stem: String) -> String {
    base_dir.clone().concat("/".concat(stem.clone().concat("/mod.ark")))
}

pub fn module_stem_to_file_path(base_dir: String, stem: String) -> String {
    base_dir.clone().concat("/".concat(stem.clone().concat(".ark")))
}
test mod "local_path" {
    test "parent" { assert(path_parent_dir("a/b/c.ark").eq("a/b")) }
    test "stem" { assert(module_path_to_file_stem("foo::bar").eq("foo/bar")) }
}
