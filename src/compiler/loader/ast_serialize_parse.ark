// ── AST cache deserialization ────────────────────────────────────────
//
// Read side of the cache wire format; the writer and the full binary
// contract live in ast_serialize.ark.  Format constants duplicated there
// must stay in sync (module-private const; Ark has no pub const).
//
// All readers bounds-check against `limit` and return new_pos = -1 on
// violation.  The sentinel propagates through chained reads, so each
// level checks once instead of after every field.

use std::core::convert
use std::text

const ASTC_HEADER_LEN: i32 = 20
const ASTC_FORMAT_VERSION: i32 = 2
const ASTC_MIN_NODE_LEN: i32 = 49
const FNV_BASIS: i32 = 216613626
const FNV_PRIME: i32 = 16777619

fn read_i32(data: String, pos: i32, limit: i32) -> (i32, i32) {
    if pos < 0 || pos > limit - 4 {
        return (0, -1)
    }
    let b0 = data.byte_at(pos) & 255
    let b1 = data.byte_at(pos + 1) & 255
    let b2 = data.byte_at(pos + 2) & 255
    let b3 = data.byte_at(pos + 3) & 255
    // NOTE: infix `|` is not an expression operator in Ark, and chained
    // bitwise trait calls mis-emit on the wasm32 linear backend (#922
    // family).  Plain arithmetic assembles the same little-endian word.
    // Tuple literals must use `return`: a bare tuple in tail position
    // emits drop+unreachable on the wasm32 linear backend (#922 family).
    let word = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    return (word, pos + 4)
}

fn read_byte(data: String, pos: i32, limit: i32) -> (i32, i32) {
    if pos < 0 || pos >= limit {
        return (0, -1)
    }
    return (data.byte_at(pos) & 255, pos + 1)
}

fn read_string(data: String, pos: i32, limit: i32) -> (String, i32) {
    let (n, start) = read_i32(data, pos, limit)
    if start < 0 || n < 0 || n > limit - start {
        return (String_new(), -1)
    }
    // Byte-faithful slice keeps multi-byte UTF-8 text intact; a length
    // that lands mid-codepoint means the payload was hand-crafted or
    // corrupt (valid writers always end on a boundary), so fail closed.
    match data.try_slice_bytes(start, start + n) {
        Option::Some(s) => { return (s, start + n) }
        Option::None => { return (String_new(), -1) }
    }
}

fn seq_count_fits(pos: i32, count: i32, limit: i32) -> bool {
    if pos < 0 || count < 0 {
        return false
    }
    count <= (limit - pos) / ASTC_MIN_NODE_LEN
}

// FNV-1a-style checksum over a byte range of the file.  Same policy as
// std::core::hash (basis/prime, abs-normalized) and the writer side.
fn fnv1a_range(data: String, start: i32, end: i32) -> i32 {
    let mut h = FNV_BASIS
    let mut i = start
    while i < end {
        h = (h * FNV_PRIME).bitxor((data.byte_at(i)).bitand(255))
        if h < 0 {
            h = 0 - h
        }
        i = i + 1
    }
    h
}

// Placeholder returned alongside pos = -1; callers check the position and
// never observe this node.
fn invalid_node() -> AstNode {
    AstNode {
        kind: 0,
        span: Span { start: 0, end: 0 },
        name_span: Span { start: 0, end: 0 },
        text: String_new(),
        int_val: 0,
        float_val: 0.0,
        op: 0,
        children: Vec::new<AstNode>(),
        type_ann: Vec::new<AstNode>(),
        is_mut: false,
        is_pub: false,
        is_async: false,
        is_component_export: false,
        is_move: false,
    }
}

// Deserialize a cache file.  Ok carries the node forest (possibly empty);
// Err means the input was not a well-formed v2 cache — callers must treat
// it as a cache miss, never as an empty AST.
pub fn deserialize_ast_nodes(data: String) -> Result<Vec<AstNode>, String> {
    let data_len = data.len()
    if data_len < ASTC_HEADER_LEN {
        return Result::Err(String_from("astc: file smaller than header"))
    }
    if data.byte_at(0) != 65 || data.byte_at(1) != 83 || data.byte_at(2) != 84 || data.byte_at(3) != 67 {
        return Result::Err(String_from("astc: bad magic"))
    }
    let (version, p1) = read_i32(data, 4, data_len)
    if version != ASTC_FORMAT_VERSION {
        return Result::Err(String_from("astc: unsupported format version"))
    }
    let (count, p2) = read_i32(data, p1, data_len)
    let (payload_len, p3) = read_i32(data, p2, data_len)
    let (crc, payload_start) = read_i32(data, p3, data_len)
    if count < 0 {
        return Result::Err(String_from("astc: negative node count"))
    }
    if payload_len < 0 || payload_start + payload_len != data_len {
        return Result::Err(String_from("astc: payload length mismatch"))
    }
    if !seq_count_fits(payload_start, count, data_len) {
        return Result::Err(String_from("astc: node count exceeds payload"))
    }
    if fnv1a_range(data, payload_start, data_len) != crc {
        return Result::Err(String_from("astc: checksum mismatch"))
    }
    let mut nodes: Vec<AstNode> = Vec::new<AstNode>()
    let mut i = 0
    let mut cur = payload_start
    while i < count {
        let (node, next) = deserialize_node(data, cur, data_len)
        if next < 0 {
            return Result::Err(String_from("astc: corrupt node payload"))
        }
        push(nodes, node)
        cur = next
        i = i + 1
    }
    if cur != data_len {
        return Result::Err(String_from("astc: trailing payload bytes"))
    }
    return Result::Ok(nodes)
}

fn deserialize_node(data: String, pos: i32, limit: i32) -> (AstNode, i32) {
    let (kind, c1) = read_i32(data, pos, limit)
    let (span_start, c2) = read_i32(data, c1, limit)
    let (span_end, c3) = read_i32(data, c2, limit)
    let (nspan_start, c4) = read_i32(data, c3, limit)
    let (nspan_end, c5) = read_i32(data, c4, limit)
    let (text, c6) = read_string(data, c5, limit)
    let (int_val, c7) = read_i32(data, c6, limit)
    let (float_text, c8) = read_string(data, c7, limit)
    let (op, c9) = read_i32(data, c8, limit)
    let (children_count, c10) = read_i32(data, c9, limit)
    if !seq_count_fits(c10, children_count, limit) {
        return (invalid_node(), -1)
    }
    let (children, c11) = deserialize_seq(data, c10, children_count, limit)
    if c11 < 0 {
        return (invalid_node(), -1)
    }
    let (type_ann_count, c12) = read_i32(data, c11, limit)
    if !seq_count_fits(c12, type_ann_count, limit) {
        return (invalid_node(), -1)
    }
    let (type_ann, c13) = deserialize_seq(data, c12, type_ann_count, limit)
    if c13 < 0 {
        return (invalid_node(), -1)
    }
    let (flags, c14) = read_byte(data, c13, limit)
    if c14 < 0 {
        return (invalid_node(), -1)
    }
    // The writer always emits the decimal form, so an empty slot means the
    // file was hand-crafted or corrupt.
    if float_text.len() == 0 {
        return (invalid_node(), -1)
    }
    let mut float_val = 0.0
    match f64::try_from(float_text) {
        Result::Ok(v) => { float_val = v }
        Result::Err(_) => { return (invalid_node(), -1) }
    }
    let node = AstNode {
        kind: kind,
        span: Span { start: span_start, end: span_end },
        name_span: Span { start: nspan_start, end: nspan_end },
        text: text,
        int_val: int_val,
        float_val: float_val,
        op: op,
        children: children,
        type_ann: type_ann,
        is_mut: (flags & 1) != 0,
        is_pub: (flags & 2) != 0,
        is_async: (flags & 4) != 0,
        is_move: (flags & 8) != 0,
        is_component_export: (flags & 16) != 0,
    }
    return (node, c14)
}

fn deserialize_seq(data: String, pos: i32, count: i32, limit: i32) -> (Vec<AstNode>, i32) {
    let mut items: Vec<AstNode> = Vec::new<AstNode>()
    let mut i = 0
    let mut cur = pos
    while i < count {
        let (node, next) = deserialize_node(data, cur, limit)
        if next < 0 {
            return (items, -1)
        }
        push(items, node)
        cur = next
        i = i + 1
    }
    return (items, cur)
}
