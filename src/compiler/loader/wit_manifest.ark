use std::host::fs::Fs
use std::toml
use std::text
use compiler::wit_identity
use loader::module_paths
use loader::module_package_root
use loader::registry_config
pub fn is_wit_package_id(name: String) -> bool {
    if wit_identity::wit_identifier_error(name.clone()).len() == 0 {
        return true
    }
    wit_identity::wit_package_identity_error(name.clone()).len() == 0
}

pub fn merge_wit_paths_for_source(source_file: String, cli_paths: Vec<String>) -> Vec<String> {
    let base_dir = module_paths::parent_dir(source_file.clone())
    let package_root = module_package_root::find_package_root(base_dir.clone())
    let mut merged = collect_wit_paths_from_manifest(package_root.clone())
    for i in 0..cli_paths.len() {
        wit_push_unique(merged, cli_paths.get_unchecked(i))
    }
    merged
}

fn wit_push_unique(mut paths: Vec<String>, path: String) {
    if path.len() == 0 {
        return
    }
    for i in 0..paths.len() {
        if paths.get_unchecked(i).eq(path.clone()) {
            return
        }
    }
    push(paths, path)
}

fn collect_wit_paths_from_manifest(package_root: String) -> Vec<String> {
    let mut paths = Vec::new<String>()
    let content = registry_config::read_package_manifest(package_root.clone())
    if content.len() == 0 {
        return paths
    }
    let deps_section = toml::TomlText::find_section(content.clone(), String_from("dependencies"))
    if deps_section.len() == 0 {
        return paths
    }
    let mut line_start = 0
    let content_len = deps_section.len()
    let mut i = 0
    while i < content_len {
        if deps_section.byte_at(i) == 10 || i == content_len - 1 {
            let line_end = if deps_section.byte_at(i) == 10 { i } else { i + 1 }
            let line = deps_section.slice(line_start, line_end)
            wit_collect_line_dependency(paths, package_root.clone(), line)
            line_start = i + 1
        }
        i = i + 1
    }
    paths
}

// Side-effecting collector: no bool result. A discarded i32 return was left on
// the wasm stack under the caller's loop increment (KEEP_CLOCK validate fail).
fn wit_collect_line_dependency(mut paths: Vec<String>, package_root: String, line: String) {
    let eq_pos = line.clone().index_of(String_from("="))
    if eq_pos < 0 {
        return
    }
    let key = wit_trim_key(line.slice(0, eq_pos))
    if !is_wit_package_id(key.clone()) {
        return
    }
    let vendor_rel = wit_vendor_rel_from_line(line.clone())
    if vendor_rel.len() == 0 {
        return
    }
    let vendor_dir = wit_resolve_relative_path(package_root.clone(), vendor_rel)
    let wit_path = wit_vendor_wit_file(vendor_dir.clone())
    if wit_path.len() == 0 {
        return
    }
    wit_push_unique(paths, wit_path)
}

fn wit_vendor_rel_from_line(line: String) -> String {
    let path_marker = String_from("path = \"")
    let pos = line.clone().index_of(path_marker)
    if pos < 0 {
        return String_new()
    }
    let tail = line.slice(pos + path_marker.len(), line.len())
    let end = tail.clone().index_of(String_from("\""))
    if end < 0 {
        return String_new()
    }
    tail.slice(0, end)
}

fn wit_trim_key(key: String) -> String {
    let n = key.len()
    let mut start = 0
    while start < n && key.byte_at(start) == 32 {
        start = start + 1
    }
    let mut end = n
    while end > start && key.byte_at(end - 1) == 32 {
        end = end - 1
    }
    let trimmed = key.slice(start, end)
    if trimmed.len() >= 2 && trimmed.byte_at(0) == 34 && trimmed.byte_at(trimmed.len() - 1) == 34 {
        return trimmed.slice(1, trimmed.len() - 1)
    }
    trimmed
}

fn wit_join_path(base: String, rel: String) -> String {
    if base.len() == 0 {
        return rel
    }
    if base.clone().ends_with(String_from("/")) {
        return base.concat(rel)
    }
    base.concat(String_from("/")).concat(rel)
}

fn wit_resolve_relative_path(base: String, rel: String) -> String {
    if rel.len() == 0 {
        return base.clone()
    }
    if rel.clone().starts_with(String_from("../")) {
        let parent = module_paths::parent_dir(base.clone())
        return wit_resolve_relative_path(parent, rel.slice(3, rel.len()))
    }
    if rel.clone().starts_with(String_from("./")) {
        return wit_resolve_relative_path(base.clone(), rel.slice(2, rel.len()))
    }
    wit_join_path(base.clone(), rel)
}

fn wit_vendor_wit_file(vendor_dir: String) -> String {
    // Avoid the `Fs` read probe on wasm32-gc (GC String → i64 scratch validate fail).
    let mod_wit = wit_join_path(vendor_dir.clone(), String_from("mod.wit"))
    match Fs::read_to_string(mod_wit.clone()) {
        Result::Ok(_) => {
            mod_wit
        },
        Result::Err(_) => {
            let iface_wit = wit_join_path(vendor_dir.clone(), String_from("interface.wit"))
            match Fs::read_to_string(iface_wit.clone()) {
                Result::Ok(_) => {
                    iface_wit
                },
                Result::Err(_) => {
                    String_new()
                },
            }
        },
    }
}
