// Mono type signature helper utilities extracted from sections_types_sigs_mono.
use mir::module_gc_struct
use wasm::sections_types_gc
fn mono_method_receiver_name(return_type_name: String, mir: MirModule) -> String {
    if return_type_name.clone().starts_with("struct:") {
        let mut first_colon = 0 - 1
        let mut last_colon = 0 - 1
        let n = len(return_type_name)
        let mut i = 0
        while i < n {
            if return_type_name.byte_at(i) == 58 {
                if first_colon < 0 {
                    first_colon = i
                }
                last_colon = i
            }
            i = i + 1
        }
        if first_colon >= 0 && last_colon > first_colon {
            return return_type_name.slice(first_colon + 1, last_colon)
        }
        return String_new()
    }
    if len(return_type_name) > 0 && module_gc_struct::MirModule_gc_struct_slot(mir, return_type_name.clone()) >= 0 {
        return return_type_name
    }
    String_new()
}

// Map a mono type key string to a wasm type signature.
fn mono_type_key_to_sig(key: String) -> String {
    if key.clone().eq("i32") {
        return "i32"
    }
    if key.clone().eq("i64") {
        return "i64"
    }
    if key.clone().eq("f64") {
        return "f64"
    }
    if key.clone().eq("f32") {
        return "f32"
    }
    if key.clone().eq("bool") {
        return "i32"
    }
    if key.clone().eq("String") {
        return sections_types_gc::gc_string_type_sig()
    }
    if key.clone().eq("char") {
        return "i32"
    }
    String_new()
}
