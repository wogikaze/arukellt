use mir::block_inst_access
use mir::function_locals_view
use mir::function_param_view
use mir::inst_accessors_literals
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use mir::local_write_index
use mir::opcodes
use wasm::code_ref_locals_scan
use wasm::ctx_record
//
// Per-function caches for GC local inference during emit (#829).
// Without this, emit_local_decls calls local_is_direct_gc_struct_new_dest /
// infer_ref_local_gc_type once per local, each rescanning the whole body.

fn begin_function_local_gc_cache(mut ctx: SelfEmitCtx, f: MirFunction) {
    let local_count = function_locals_view::MirFunction_local_count(f)
    let mut infer = Vec::new<i32>()
    let mut struct_new = Vec::new<i32>()
    let mut has_ref = Vec::new<i32>()
    let mut scalar_vts = Vec::new<i32>()
    let mut scalar_flags = Vec::new<i32>()
    let mut strong_ref_flags = Vec::new<i32>()
    let mut vec_constructor_flags = Vec::new<i32>()
    let mut direct_storage = Vec::new<i32>()
    let mut copied_storage = Vec::new<i32>()
    let mut def_block = Vec::new<i32>()
    let mut def_inst = Vec::new<i32>()
    let mut struct_new_size_names = Vec::new<String>()
    let mut struct_new_sizes = Vec::new<i32>()
    let mut i = 0
    while i < local_count {
        // Private encoding: -2 = not yet inferred (see cached_infer_*).
        push(infer, 0 - 2)
        push(struct_new, 0)
        push(has_ref, 0)
        push(vec_constructor_flags, 0)
        push(direct_storage, 0 - 2)
        push(copied_storage, 0 - 2)
        push(def_block, 0 - 1)
        push(def_inst, 0 - 1)
        i = i + 1
    }
    seed_has_ref_from_params(f, has_ref)
    let block_count = f.blocks.len()
    let mut bi = 0
    while bi < block_count {
        let block = f.blocks.get_unchecked(bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            let dest = inst_accessors_operands::MirInst_dest(inst)
            if dest >= 0 && dest < local_count && op == opcodes::MIR_CALL() &&
            code_ref_locals_scan::is_vec_constructor_name(inst_accessors_literals::MirInst_str_val(inst)) {
                // The callee suffix may encode an element type, but the
                // result is still the Vec header stored in this local.
                set(vec_constructor_flags, dest, 1)
            }
            if op == opcodes::MIR_GC_STRUCT_NEW() ||
            op == opcodes::MIR_STRUCT_NEW() {
                if dest >= 0 && dest < local_count {
                    set(struct_new, dest, 1)
                }
            }
            if op == opcodes::MIR_STRUCT_NEW() {
                record_struct_new_size(
                    struct_new_size_names,
                    struct_new_sizes,
                    inst_accessors_literals::MirInst_str_val(inst),
                    inst_accessors_literals::MirInst_int_val(inst)
                )
            }
            record_local_def_site(def_block, def_inst, local_count, dest, bi, ii, op)
            let arg0 = inst_accessors_operands::MirInst_arg0(inst)
            if op == opcodes::MIR_LOCAL_SET() {
                record_local_def_site(def_block, def_inst, local_count, arg0, bi, ii, op)
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    propagate_has_ref_assignments(f, has_ref, 4)
    code_ref_locals_scan::build_local_producer_flags(
        f,
        local_count,
        scalar_vts,
        scalar_flags,
        strong_ref_flags
    )
    ctx_record::SelfEmitCtx_set_local_write_index(ctx, local_write_index::LocalWriteIndex_build(f, local_count))
    ctx_record::SelfEmitCtx_set_local_i64_stack_set_cache(
        ctx,
        code_ref_locals_scan::local_body_i64_stack_set_flags(f, local_count)
    )
    ctx_record::SelfEmitCtx_set_local_feeds_return_cache(
        ctx,
        code_ref_locals_scan::local_feeds_return_flags(f, local_count)
    )
    ctx_record::SelfEmitCtx_set_local_gc_infer_cache(ctx, infer)
    ctx_record::SelfEmitCtx_set_local_struct_new_cache(ctx, struct_new)
    ctx_record::SelfEmitCtx_set_local_has_ref_cache(ctx, has_ref)
    ctx_record::SelfEmitCtx_set_local_scalar_producer_vt_cache(ctx, scalar_vts)
    ctx_record::SelfEmitCtx_set_local_has_scalar_producer_cache(ctx, scalar_flags)
    ctx_record::SelfEmitCtx_set_local_strong_ref_producer_cache(ctx, strong_ref_flags)
    ctx_record::SelfEmitCtx_set_local_vec_constructor_cache(ctx, vec_constructor_flags)
    ctx_record::SelfEmitCtx_set_local_direct_producer_storage_cache(ctx, direct_storage)
    ctx_record::SelfEmitCtx_set_local_copied_storage_cache(ctx, copied_storage)
    ctx_record::SelfEmitCtx_set_local_def_block_cache(ctx, def_block)
    ctx_record::SelfEmitCtx_set_local_def_inst_cache(ctx, def_inst)
    ctx_record::SelfEmitCtx_set_struct_new_size_table(ctx, struct_new_size_names, struct_new_sizes)
}

// Keeps the first size seen per name so lookups match the body-order scan
// they replace.
fn record_struct_new_size(mut names: Vec<String>, mut sizes: Vec<i32>, struct_name: String, byte_size: i32) {
    if struct_new_size_index(names, struct_name.clone()) >= 0 {
        return
    }
    push(names, struct_name)
    push(sizes, byte_size)
}

fn struct_new_size_index(names: Vec<String>, struct_name: String) -> i32 {
    let count = names.len()
    let mut i = 0
    while i < count {
        if names.get_unchecked(i).eq(struct_name.clone()) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// Byte size of the first MIR_STRUCT_NEW for `struct_name` in the cached body;
// 0 when the body has none. Only valid inside the begin/end window.
fn cached_struct_new_byte_size(ctx: SelfEmitCtx, struct_name: String) -> i32 {
    let names = ctx_record::SelfEmitCtx_struct_new_size_names(ctx)
    let idx = struct_new_size_index(names, struct_name)
    if idx < 0 {
        return 0
    }
    ctx_record::SelfEmitCtx_struct_new_sizes(ctx).get_unchecked(idx)
}

fn seed_has_ref_from_params(f: MirFunction, mut has_ref: Vec<i32>) {
    let param_count = function_param_view::MirFunction_param_count(f)
    let mut pi = 0
    while pi < param_count {
        let param_type_name = function_param_view::MirFunction_param_type_name(f, pi)
        if param_type_name.len() > 0 && code_ref_locals_scan::type_name_is_ref(param_type_name) {
            set(has_ref, pi, 1)
        }
        pi = pi + 1
    }
}

fn record_local_def_site(
    mut def_block: Vec<i32>,
    mut def_inst: Vec<i32>,
    local_count: i32,
    local_idx: i32,
    block_idx: i32,
    inst_idx: i32,
    op: i32
) {
    if local_idx < 0 || local_idx >= local_count {
        return
    }
    if op == opcodes::MIR_GC_STRUCT_SET() || op == opcodes::MIR_STRUCT_SET() {
        return
    }
    if def_block.get_unchecked(local_idx) >= 0 {
        return
    }
    set(def_block, local_idx, block_idx)
    set(def_inst, local_idx, inst_idx)
}

fn propagate_has_ref_assignments(f: MirFunction, mut has_ref: Vec<i32>, max_passes: i32) {
    let mut pass = 0
    while pass < max_passes {
        let mut changed = 0
        let block_count = f.blocks.len()
        let mut bi = 0
        while bi < block_count {
            let block = f.blocks.get_unchecked(bi)
            let inst_count = block_inst_access::MirBlock_inst_count(block)
            let mut ii = 0
            while ii < inst_count {
                let inst = block_inst_access::MirBlock_inst_at(block, ii)
                if local_inst_marks_ref(f, inst, has_ref) {
                    changed = 1
                }
                ii = ii + 1
            }
            bi = bi + 1
        }
        if changed == 0 {
            return
        }
        pass = pass + 1
    }
}

fn local_inst_marks_ref(f: MirFunction, inst: MirInst, mut has_ref: Vec<i32>) -> bool {
    let op = inst_accessors_shape::MirInst_op(inst)
    let dest = inst_accessors_operands::MirInst_dest(inst)
    let arg0 = inst_accessors_operands::MirInst_arg0(inst)
    if dest >= 0 && dest < has_ref.len() {
        if op == opcodes::MIR_GC_STRUCT_NEW() ||
        op == opcodes::MIR_STRUCT_NEW() ||
        op == opcodes::MIR_ARRAY_NEW() ||
        op == opcodes::MIR_CONST_STRING() ||
        op == opcodes::MIR_CALL() ||
        op == opcodes::MIR_REF_CAST() ||
        op == opcodes::MIR_REF_TEST() {
            if has_ref.get_unchecked(dest) == 0 {
                set(has_ref, dest, 1)
                return true
            }
        }
        if op == opcodes::MIR_GC_STRUCT_GET() && code_ref_locals_scan::local_has_ref_type_name(f, dest) {
            if has_ref.get_unchecked(dest) == 0 {
                set(has_ref, dest, 1)
                return true
            }
        }
        if op == opcodes::MIR_LOCAL_GET() {
            let src = inst_accessors_operands::MirInst_arg0(inst)
            if src >= 0 && src < has_ref.len() && has_ref.get_unchecked(src) == 1 {
                if has_ref.get_unchecked(dest) == 0 {
                    set(has_ref, dest, 1)
                    return true
                }
            }
        }
    }
    if op == opcodes::MIR_LOCAL_SET() && arg0 >= 0 && arg0 < has_ref.len() {
        let source = inst_accessors_operands::MirInst_arg1(inst)
        if source >= 0 && source < has_ref.len() && has_ref.get_unchecked(source) == 1 {
            if has_ref.get_unchecked(arg0) == 0 {
                set(has_ref, arg0, 1)
                return true
            }
        }
    }
    false
}

// Write index for `f`: the cached one inside the begin/end window, else a
// fresh build (same O(body) cost as the scan it replaces).
fn function_local_write_index(f: MirFunction, ctx: SelfEmitCtx) -> LocalWriteIndex {
    let cached = ctx_record::SelfEmitCtx_local_write_index(ctx)
    if local_write_index::local_write_index_is_active(cached) {
        return cached
    }
    local_write_index::LocalWriteIndex_build(f, function_locals_view::MirFunction_local_count(f))
}

fn end_function_local_gc_cache(mut ctx: SelfEmitCtx) {
    ctx_record::SelfEmitCtx_set_local_gc_infer_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_struct_new_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_has_ref_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_scalar_producer_vt_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_has_scalar_producer_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_strong_ref_producer_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_vec_constructor_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_direct_producer_storage_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_copied_storage_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_def_block_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_def_inst_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_i64_stack_set_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_feeds_return_cache(ctx, Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_struct_new_size_table(ctx, Vec::new<String>(), Vec::new<i32>())
    ctx_record::SelfEmitCtx_set_local_write_index(ctx, local_write_index::LocalWriteIndex_empty())
}

fn cached_body_has_i64_stack_set(ctx: SelfEmitCtx, local_idx: i32) -> bool {
    let flags = ctx_record::SelfEmitCtx_local_i64_stack_set_cache(ctx)
    if local_idx < 0 || local_idx >= flags.len() {
        return false
    }
    flags.get_unchecked(local_idx) == 1
}

fn cached_def_block(ctx: SelfEmitCtx, local_idx: i32) -> i32 {
    let blocks = ctx_record::SelfEmitCtx_local_def_block_cache(ctx)
    if local_idx < 0 || local_idx >= blocks.len() {
        return 0 - 1
    }
    blocks.get_unchecked(local_idx)
}

fn cached_def_inst(ctx: SelfEmitCtx, local_idx: i32) -> i32 {
    let insts = ctx_record::SelfEmitCtx_local_def_inst_cache(ctx)
    if local_idx < 0 || local_idx >= insts.len() {
        return 0 - 1
    }
    insts.get_unchecked(local_idx)
}

// Encoded Option<i32> for local_direct_producer_storage_type. -3 means the
// per-function cache is inactive or the local index is outside the cache.
fn cached_direct_producer_storage(ctx: SelfEmitCtx, local_idx: i32) -> i32 {
    let cache = ctx_record::SelfEmitCtx_local_direct_producer_storage_cache(ctx)
    if local_idx < 0 || local_idx >= cache.len() {
        return 0 - 3
    }
    cache.get_unchecked(local_idx)
}

fn set_cached_direct_producer_storage(ctx: SelfEmitCtx, local_idx: i32, value: Option<i32>) {
    let mut cache = ctx_record::SelfEmitCtx_local_direct_producer_storage_cache(ctx)
    if local_idx < 0 || local_idx >= cache.len() {
        return
    }
    match value {
        Option::Some(type_idx) => set(cache, local_idx, type_idx),
        Option::None => set(cache, local_idx, 0 - 1),
    }
}

// Encoded Option<i32> for copied_non_string_storage_type at depth 0.
// -3 means the per-function cache is inactive or the local index is
// outside the cache; -2 uncomputed, -1 miss, >=0 hit.
fn cached_copied_storage(ctx: SelfEmitCtx, local_idx: i32) -> i32 {
    let cache = ctx_record::SelfEmitCtx_local_copied_storage_cache(ctx)
    if local_idx < 0 || local_idx >= cache.len() {
        return 0 - 3
    }
    cache.get_unchecked(local_idx)
}

fn set_cached_copied_storage(ctx: SelfEmitCtx, local_idx: i32, value: Option<i32>) {
    let mut cache = ctx_record::SelfEmitCtx_local_copied_storage_cache(ctx)
    if local_idx < 0 || local_idx >= cache.len() {
        return
    }
    match value {
        Option::Some(type_idx) => set(cache, local_idx, type_idx),
        Option::None => set(cache, local_idx, 0 - 1),
    }
}

// Private Vec<i32> encoding: -2 uncomputed, -1 miss, >=0 hit.
// Public infer_* returns Option; convert with cached_infer_as_option.
// See docs/research/infer-local-gc-type-option.md.
fn infer_cache_uncomputed() -> i32 {
    0 - 2
}

fn infer_cache_miss() -> i32 {
    0 - 1
}

fn cached_infer_get(ctx: SelfEmitCtx, local_idx: i32) -> i32 {
    let cache = ctx_record::SelfEmitCtx_local_gc_infer_cache(ctx)
    if local_idx < 0 || local_idx >= cache.len() {
        return infer_cache_uncomputed()
    }
    cache.get_unchecked(local_idx)
}

fn cached_infer_is_computed(ctx: SelfEmitCtx, local_idx: i32) -> bool {
    cached_infer_get(ctx, local_idx) != infer_cache_uncomputed()
}

fn cached_infer_as_option(ctx: SelfEmitCtx, local_idx: i32) -> Option<i32> {
    let encoded = cached_infer_get(ctx, local_idx)
    if encoded == infer_cache_uncomputed() || encoded == infer_cache_miss() {
        return Option::None
    }
    Option::Some(encoded)
}

fn cached_infer_set(ctx: SelfEmitCtx, local_idx: i32, value: Option<i32>) {
    let mut cache = ctx_record::SelfEmitCtx_local_gc_infer_cache(ctx)
    if local_idx < 0 || local_idx >= cache.len() {
        return
    }
    match value {
        Option::Some(v) => {
            set(cache, local_idx, v)
        }
        Option::None => {
            set(cache, local_idx, infer_cache_miss())
        }
    }
}
