use wasm::call_runtime_assert
use wasm::call_runtime_convert
use wasm::call_runtime_io
use wasm::call_runtime_network
use wasm::call_runtime_time
fn try_emit_host_call(
    w: WasmWriter,
    handler_id: i32,
    inst: MirInst,
    ctx: SelfEmitCtx,
    prev_op: i32,
    prev_arg0: i32,
    prev_arg1: i32,
    prev_handler_id: i32,
    next_op: i32,
    next_arg0: i32,
    next_arg1: i32,
    next2_op: i32
) -> bool {
    if call_runtime_time::try_emit_clock_random_call(w, handler_id, inst, ctx, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    if call_runtime_network::try_emit_network_call(w, handler_id, inst, ctx, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    if call_runtime_io::try_emit_stdio_call(w, handler_id, inst, ctx, prev_op, prev_arg0, prev_arg1, prev_handler_id, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    if call_runtime_io::try_emit_fs_call(w, handler_id, inst, ctx, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    if call_runtime_io::try_emit_env_call(w, handler_id, inst, ctx, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    if call_runtime_assert::try_emit_option_assert_call(w, handler_id, inst, ctx, prev_op, prev_arg0, prev_arg1, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    if call_runtime_convert::try_emit_host_convert_call(w, handler_id, inst, ctx, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    false
}
