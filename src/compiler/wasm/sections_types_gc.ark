//
// Type sig format:
//   A_{elem}        - array type with element type {elem}
//   S_f{N}_{T}...   - struct type with fields at offsets {N} of types {T}
//   Sub{N}_S_...    - subtype of type at index {N} with struct body S_...
//   SubF{N}_S_...   - final subtype of type at index {N} with struct body S_...
//   SubF_GS_f...    - final struct with no supertype (user-defined structs)

use std::prelude::{byte_at, clone, eq, starts_with, substring}
use std::text
use mir::module_gc_enum
use mir::module_gc_order
use mir::module_gc_struct
use wasm::constants
use wasm::opcodes
use wasm::writer_core
use wasm::sections_type_plan
fn emit_struct_type_entry(type_sec: WasmWriter, sig: String, gc_type_base: i32) {
    writer_core::emit_byte(type_sec, opcodes::SEC_TYPE_STRUCT())
    let field_sigs = struct_field_sigs(sig)
    writer_core::emit_leb128_u(type_sec, len(field_sigs))
    for fi in 0..len(field_sigs) {
        emit_struct_field_type(type_sec, get_unchecked(field_sigs, fi), gc_type_base)
    }
}

fn emit_struct_field_type(type_sec: WasmWriter, ft: String, gc_type_base: i32) {
    if starts_with(clone(ft), "gcsref") {
        // gcsref<slot> is handled by the caller (sections_types_emit)
        // which has access to gc_struct_type_map.  Fall through to ref handling.
        let _slot = parse_type_sig_int(substring(ft, 6, len(ft)))
        // Without gc_struct_type_map, we cannot resolve the slot.
        // Use ref14 as fallback (should not happen in practice).
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(type_sec, gc_type_base + 14)
        writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
        return
    }
    if starts_with(clone(ft), "ref") {
        let offset_str = substring(ft, 3, len(ft))
        let offset = parse_type_sig_int(offset_str)
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(type_sec, gc_type_base + offset)
        writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
        return
    }
    writer_core::emit_byte(type_sec, sections_type_plan::sig_to_wasm_type(ft))
    writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
}

fn parse_type_sig_int(s: String) -> i32 {
    let n = len(s)
    let mut val = 0
    let mut i = 0
    while i < n {
        let c = byte_at(clone(s), i)
        if c >= 48 && c <= 57 {
            val = val * 10 + (c - 48)
        }
        i = i + 1
    }
    val
}

fn emit_array_type_entry(type_sec: WasmWriter, sig: String, gc_type_base: i32, gc_struct_type_map: Vec<i32>) {
    writer_core::emit_byte(type_sec, opcodes::SEC_TYPE_ARRAY())
    emit_array_elem_type(type_sec, array_elem_type(sig), gc_type_base, gc_struct_type_map)
    writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
}

fn emit_array_elem_type(type_sec: WasmWriter, elem_type: String, gc_type_base: i32, gc_struct_type_map: Vec<i32>) {
    if eq(clone(elem_type), "structref") {
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_byte(type_sec, constants::WASM_STRUCTREF())
        return
    }
    if starts_with(clone(elem_type), "gcsref") {
        let slot = parse_type_sig_int(substring(elem_type, 6, len(elem_type)))
        if slot < len(gc_struct_type_map) {
            let type_idx = get_unchecked(gc_struct_type_map, slot)
            writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(type_sec, type_idx)
            return
        }
    }
    if starts_with(clone(elem_type), "ref") {
        let offset_str = substring(elem_type, 3, len(elem_type))
        let offset = parse_type_sig_int(offset_str)
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(type_sec, gc_type_base + offset)
        return
    }
    writer_core::emit_byte(type_sec, sections_type_plan::sig_to_wasm_type(elem_type))
}

fn struct_field_sigs(sig: String) -> Vec<String> {
    let mut fields = Vec::new<String>()
    let sig_len = len(sig)
    let mut si = 0
    while si < sig_len {
        if byte_at(clone(sig), si) == 95 && si + 1 < sig_len && byte_at(clone(sig), si + 1) == 102 {
            let mut pi = si + 2
            while pi < sig_len && byte_at(clone(sig), pi) != 95 {
                pi = pi + 1
            }
            if pi < sig_len {
                let type_start = pi + 1
                let mut type_end = type_start
                while type_end < sig_len && byte_at(clone(sig), type_end) != 95 {
                    type_end = type_end + 1
                }
                push(fields, substring(clone(sig), type_start, type_end))
                si = type_end
            } else {
                si = si + 2
            }
        } else {
            si = si + 1
        }
    }
    fields
}

fn array_elem_type(sig: String) -> String {
    substring(sig, 2, len(sig))
}

fn find_type_sig_char(s: String, c: i32) -> i32 {
    let n = len(s)
    let mut i = 0
    while i < n {
        if byte_at(clone(s), i) == c { return i }
        i = i + 1
    }
    0 - 1
}

fn append_gc_type_sigs(type_sigs: Vec<String>) {
    push(type_sigs, "A_i8")
    push(type_sigs, "A_i32")
    push(type_sigs, "SubF_GS_f0_i32")
    push(type_sigs, "SubF_GS_f0_i32_f1_i32")
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_i32")
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_i32_f3_i32")
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_i32_f3_i32_f4_i32")
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_i32_f3_i32_f4_i32_f5_i32")
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_i32_f3_i32_f4_i32_f5_i32_f6_i32")
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_i32_f3_i32_f4_i32_f5_i32_f6_i32_f7_i32")
    push(type_sigs, "SubF_GS_f0_ref1_f1_i32")
    push(type_sigs, "A_i64")
    push(type_sigs, "A_f64")
    push(type_sigs, "SubF_GS_f0_i64")
    push(type_sigs, "Sub0_GS_f0_i32")
    push(type_sigs, "A_ref0")
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_ref15_f3_ref1_f4_ref1")
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_ref1_f3_ref15_f4_ref1")
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_ref15_f3_ref15_f4_ref1")
    push(type_sigs, "SubF_GS_f0_ref15_f1_i32")
    push(type_sigs, "A_v128")
    push(type_sigs, "SubF_GS_f0_ref20_f1_i32")
    push(type_sigs, "SubF_GS_f0_ref11_f1_i32")
    push(type_sigs, "SubF_GS_f0_ref12_f1_i32")
    push(type_sigs, "A_structref")
    push(type_sigs, "SubF_GS_f0_ref24_f1_i32")
    // Shared fn-pair record {fnptr, env} for the managed closure ABI
    // (#872). Fixed before A_fnref so the element type is a backward
    // reference; named-struct registration dedups to this entry.
    push(type_sigs, "SubF_GS_f0_funcref_f1_structref")
    // Vec<fn>: nullable __fnpair array + vec header (#832/#872).
    push(type_sigs, "A_fnref")
    push(type_sigs, "SubF_GS_f0_ref27_f1_i32")
    // Vec<Option/Result>: nullable open-enum array + vec header (#832).
    push(type_sigs, "A_ref14")
    push(type_sigs, "SubF_GS_f0_ref29_f1_i32")
    // HashMap<i32, fn>: keys A_i32, vals A_fnref (offset 27), flags A_i32 (#833).
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_ref1_f3_ref27_f4_ref1")
    // HashMap<String, fn>: keys A_ref0 (offset 15), vals A_fnref (offset 27) (#838).
    push(type_sigs, "SubF_GS_f0_i32_f1_i32_f2_ref15_f3_ref27_f4_ref1")
}

fn gc_type_sig_count() -> i32 {
    33
}

fn gc_enum_open_type_offset() -> i32 {
    14
}

fn gc_fnpair_offset() -> i32 {
    26
}

fn gc_enum_open_type_sig() -> String {
    "gcref14"
}

fn gc_struct_type_sig_from_byte_size(byte_size: i32) -> String {
    // Struct types are indexed by field count (each i32 field = 4 bytes).
    // Offset 2 = 1 field, offset 3 = 2 fields, ..., offset 9 = 8+ fields.
    let field_count = (byte_size + 3) / 4
    let offset = if field_count <= 1 {
        2
    } else {
        if field_count > 8 {
            9
        } else {
            field_count + 1
        }
    }
    text::concat("gcref", (offset).to_string())
}

fn gc_vec_type_sig() -> String {
    "gcref10"
}

fn gc_vec_string_type_sig() -> String {
    "gcref19"
}

fn gc_vec_v128_type_sig() -> String {
    "gcref21"
}

fn gc_vec_i64_type_sig() -> String {
    "gcref22"
}

fn gc_vec_f64_type_sig() -> String {
    "gcref23"
}

fn gc_vec_fnref_type_sig() -> String {
    "gcref28"
}

fn gc_vec_enum_ref_type_sig() -> String {
    "gcref30"
}

fn gc_string_type_sig() -> String {
    "gcref0"
}

fn gc_hashmap_str_i32_type_sig() -> String {
    "gcref16"
}

fn gc_hashmap_i32_str_type_sig() -> String {
    "gcref17"
}

fn gc_hashmap_str_str_type_sig() -> String {
    "gcref18"
}

fn gc_hashmap_i32_fn_type_sig() -> String {
    "gcref31"
}

fn gc_hashmap_str_fn_type_sig() -> String {
    "gcref32"
}

fn gc_struct_sig_as_final(sig: String) -> String {
    if starts_with(clone(sig), "GS_f") {
        return text::concat("SubF_", sig)
    }
    sig
}

// Emission order of the module GC type region, packed slot*2+kind
// (kind 0 = struct, 1 = enum variant). Sealed slots keep slot order, then
// late slots follow late_gc_order so every type is emitted before its
// referencers — a forward type index is invalid outside a rec group
// (#851 Phase 3). Late slots missing from the order list still emit at
// the tail, grouped by kind, so a missed recording cannot silently drop
// a type.
fn gc_module_emit_slots(mir: MirModule) -> Vec<i32> {
    let struct_total = module_gc_struct::MirModule_gc_struct_sig_count(mir)
    let enum_total = module_gc_enum::MirModule_gc_enum_variant_sig_count(mir)
    let mut sealed_structs = module_gc_order::MirModule_sealed_gc_struct_count(mir)
    let mut sealed_enums = module_gc_order::MirModule_sealed_gc_enum_count(mir)
    if sealed_structs < 0 || sealed_structs > struct_total {
        sealed_structs = struct_total
    }
    if sealed_enums < 0 || sealed_enums > enum_total {
        sealed_enums = enum_total
    }
    let emit_slots = Vec::new<i32>()
    let mut i = 0
    while i < sealed_structs {
        push(emit_slots, i * 2)
        i = i + 1
    }
    i = 0
    while i < sealed_enums {
        push(emit_slots, i * 2 + 1)
        i = i + 1
    }
    let mut seen_struct = Vec::new<i32>()
    let mut seen_enum = Vec::new<i32>()
    i = 0
    while i < struct_total {
        push(seen_struct, 0)
        i = i + 1
    }
    i = 0
    while i < enum_total {
        push(seen_enum, 0)
        i = i + 1
    }
    i = 0
    let order = module_gc_order::MirModule_late_gc_order(mir)
    while i < len(order) {
        let packed = get_unchecked(order, i)
        let slot = packed / 2
        if packed % 2 == 0 {
            if slot >= sealed_structs && slot < struct_total &&
            get_unchecked(seen_struct, slot) == 0 {
                set(seen_struct, slot, 1)
                push(emit_slots, packed)
            }
        } else {
            if slot >= sealed_enums && slot < enum_total &&
            get_unchecked(seen_enum, slot) == 0 {
                set(seen_enum, slot, 1)
                push(emit_slots, packed)
            }
        }
        i = i + 1
    }
    i = sealed_structs
    while i < struct_total {
        if get_unchecked(seen_struct, i) == 0 {
            push(emit_slots, i * 2)
        }
        i = i + 1
    }
    i = sealed_enums
    while i < enum_total {
        if get_unchecked(seen_enum, i) == 0 {
            push(emit_slots, i * 2 + 1)
        }
        i = i + 1
    }
    emit_slots
}

fn append_module_gc_type_sigs(type_sigs: Vec<String>, mir: MirModule) {
    let emit_slots = gc_module_emit_slots(mir)
    let mut i = 0
    while i < len(emit_slots) {
        let packed = get_unchecked(emit_slots, i)
        let slot = packed / 2
        if packed % 2 == 0 {
            let sig = module_gc_struct::MirModule_gc_struct_sig_at(mir, slot)
            push(type_sigs, gc_struct_sig_as_final(sig))
        } else {
            push(type_sigs, module_gc_enum::MirModule_gc_enum_variant_sig_at(mir, slot))
        }
        i = i + 1
    }
}
