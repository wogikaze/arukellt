use mir::function_param_view
use mir::function_return_view
use mir::local_access
use mir::module_canon
use mir::block_inst_access
use mir::inst_accessors_literals
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use mir::value_types
use wasm::ctx_record
use wasm::ctx_gc_layout_lookup
use wasm::ctx_reloc
use wasm::emit_target
use wasm::inst_store
use wasm::intrinsics::helpers_numeric_i32_convert
use wasm::opcodes
use wasm::sections_types_gc
use wasm::sections_type_plan
use wasm::sections_types_gc_phase7
use wasm::sections_types_sigs_detail
use wasm::writer_core
use mir::opcodes as mir_opcodes

// Hint segments 3/4 written by closure_pair_call_hint: the nk/vk signature
// keys that identify the trampoline carrying this call's exact wasm type.
use std::prelude::{eq}
use std::text
fn call_ref_hint_seg3(hint: String) -> String {
    let first = hint.clone().index_of(String_from("|"))
    if first < 0 {
        return String_new()
    }
    let rest = hint.clone().slice(first + 1, len(hint))
    let second = rest.clone().index_of(String_from("|"))
    if second < 0 {
        return String_new()
    }
    let seg = rest.clone().slice(second + 1, len(rest))
    let third = seg.clone().index_of(String_from("|"))
    if third < 0 {
        return seg
    }
    seg.clone().slice(0, third)
}

fn call_ref_hint_seg4(hint: String) -> String {
    let first = hint.clone().index_of(String_from("|"))
    if first < 0 {
        return String_new()
    }
    let rest = hint.clone().slice(first + 1, len(hint))
    let second = rest.clone().index_of(String_from("|"))
    if second < 0 {
        return String_new()
    }
    let seg = rest.clone().slice(second + 1, len(rest))
    let third = seg.clone().index_of(String_from("|"))
    if third < 0 {
        return String_new()
    }
    seg.clone().slice(third + 1, len(seg))
}

// A pair-ABI trampoline is a generated function whose first param is the
// uniform env slot, marked by the internal "structref" type name that no
// user function can declare.
fn fn_is_pair_trampoline(f: MirFunction) -> bool {
    if function_param_view::MirFunction_param_count(f) == 0 {
        return false
    }
    eq(
        local_access::MirLocal_type_name(function_param_view::MirFunction_param_at(f, 0)),
        String_from("structref")
    )
}

// Same normalization as closure_pair_seg_norm so producer/call-site keys
// agree on container spellings.
fn pair_seg_norm(name: String, vt: i32) -> String {
    if len(name) == 0 {
        return "~".concat((vt).to_string())
    }
    if name.clone().starts_with("Vec<") && name.clone().ends_with(">") {
        return "vec:".concat(name.slice(4, len(name) - 1))
    }
    if name.clone().starts_with("Option<") && name.clone().ends_with(">") {
        return "option:".concat(name.slice(7, len(name) - 1))
    }
    name
}

// "nk:<segs>;<ret>" (use_names) or "vk:<vts>;<vt>" over params[1..] + ret
// — param 0 is the env slot and never part of the user-visible signature.
fn pair_tramp_sig_key(f: MirFunction, use_names: bool) -> String {
    let mut key = if use_names {
        String_from("nk:")
    } else {
        String_from("vk:")
    }
    let pc = function_param_view::MirFunction_param_count(f)
    let mut i = 1
    while i < pc {
        if i > 1 {
            key = key.concat(",")
        }
        let p = function_param_view::MirFunction_param_at(f, i)
        let pvt = local_access::MirLocal_val_type(p)
        if use_names {
            key = key.concat(pair_seg_norm(local_access::MirLocal_type_name(p), pvt))
        } else {
            key = key.concat((pvt).to_string())
        }
        i = i + 1
    }
    key = key.concat(";")
    let rvt = function_return_view::MirFunction_return_type(f)
    if use_names {
        key = key.concat(pair_seg_norm(function_return_view::MirFunction_return_type_name(f), rvt))
    } else {
        key = key.concat((rvt).to_string())
    }
    key
}

// Param segments must match exactly; an empty call-site return segment is
// a wildcard for ignored results.
fn pair_key_matches(hint_key: String, cand_key: String) -> bool {
    if len(hint_key) == 0 || len(cand_key) == 0 {
        return false
    }
    let hp = hint_key.clone().index_of(String_from(";"))
    let cp = cand_key.clone().index_of(String_from(";"))
    if hp < 0 || cp < 0 {
        return eq(hint_key, cand_key)
    }
    if !eq(hint_key.clone().slice(0, hp), cand_key.clone().slice(0, cp)) {
        return false
    }
    let hret = hint_key.clone().slice(hp + 1, len(hint_key))
    if len(hret) == 0 {
        return true
    }
    eq(hret, cand_key.clone().slice(cp + 1, len(cand_key)))
}

// Resolve the wasm type index of the (env, params...) -> ret trampoline
// matching this call. Pass 1 uses the precise name key, pass 2 the
// value-type key; -1 defers to the legacy arity scan.
fn call_ref_pair_key_type_idx(ctx: SelfEmitCtx, hint: String) -> i32 {
    let nk = call_ref_hint_seg3(hint.clone())
    let vk = call_ref_hint_seg4(hint.clone())
    if len(nk) == 0 && len(vk) == 0 {
        return 0 - 1
    }
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    let n = len(functions)
    if len(nk) > 0 {
        let mut fi = 0
        while fi < n {
            let f = get_unchecked(functions, fi)
            if fn_is_pair_trampoline(f) {
                if pair_key_matches(nk.clone(), pair_tramp_sig_key(f, true)) {
                    return emit_fn_type_idx(ctx, fi)
                }
            }
            fi = fi + 1
        }
    }
    if len(vk) > 0 {
        let mut fi = 0
        while fi < n {
            let f = get_unchecked(functions, fi)
            if fn_is_pair_trampoline(f) {
                if pair_key_matches(vk.clone(), pair_tramp_sig_key(f, false)) {
                    return emit_fn_type_idx(ctx, fi)
                }
            }
            fi = fi + 1
        }
    }
    0 - 1
}

fn emit_call_indirect_inst(mut w: WasmWriter, inst: MirInst, mut ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    let arg_count = inst_accessors_literals::MirInst_int_val(inst)
    let dest_vt = inst_accessors_shape::MirInst_val_type(inst)
    let first_arg_vt = parse_first_arg_vt_hint(inst_accessors_literals::MirInst_str_val(inst))
    // Pair ABI (#872): the nk/vk hint keys pin the exact (env, args...)
    // signature; the fnptr table index is already on the stack.
    let mut type_idx = call_ref_pair_key_type_idx(ctx, inst_accessors_literals::MirInst_str_val(inst))
    // #851 Phase 3: the type operand is a reloc placeholder patched at
    // code-section assembly — the resolver inputs are recorded so apply
    // re-runs the same resolution once every table is final (in-loop emit
    // has no type_plan yet). A MIR-provided arg1 index is already final
    // and emits directly.
    let mut reloc_kind = 0 - 1
    if type_idx >= 0 {
        reloc_kind = ctx_reloc::RELOC_KIND_PAIR_KEY()
    } else {
        if inst_accessors_operands::MirInst_arg1(inst) < 0 {
            reloc_kind = ctx_reloc::RELOC_KIND_INDIRECT_SCAN()
        }
        type_idx = resolve_indirect_type_idx(ctx, inst_accessors_operands::MirInst_arg1(inst), arg_count, dest_vt, first_arg_vt)
    }
    // Under Memory64, the funcref table index is stored as a widened i64
    // scalar but the call_indirect instruction requires an i32 index.
    helpers_numeric_i32_convert::emit_narrow_i64_operand(w)
    writer_core::emit_byte(w, opcodes::OP_CALL_INDIRECT())
    if reloc_kind >= 0 {
        ctx_reloc::SelfEmitCtx_emit_leb_u_reloc(
            w,
            ctx,
            reloc_kind,
            arg_count,
            dest_vt,
            first_arg_vt,
            inst_accessors_literals::MirInst_str_val(inst),
            String_new()
        )
    } else {
        writer_core::emit_leb128_u(w, type_idx)
    }
    writer_core::emit_leb128_u(w, 0)
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, indirect_type_returns_value(ctx, type_idx, dest_vt))
}

// Re-run one recorded call_indirect resolution at reloc-apply time. The
// inputs captured at emit are regime-independent, and every table the
// resolvers read is final at assembly — the patched operand therefore
// equals the value direct resolution produced.
fn resolve_indirect_reloc(ctx: SelfEmitCtx, kind: i32, ikey: i32, ikey2: i32, ikey3: i32, skey: String) -> i32 {
    if kind == ctx_reloc::RELOC_KIND_PAIR_KEY() {
        return call_ref_pair_key_type_idx(ctx, skey)
    }
    if kind == ctx_reloc::RELOC_KIND_INDIRECT_SCAN() {
        return resolve_indirect_type_idx(ctx, 0 - 1, ikey, ikey2, ikey3)
    }
    0 - 1
}

// ---- pair-call signature registration (#872) ----
// When no __fnthunk exists for a call site's declared signature (e.g. a
// retained-but-never-invoked helper like any_i32 whose fn-typed param is
// only called, never produced), the nk/vk key search cannot resolve the
// (env, args...) -> ret type index. The type section therefore registers
// one func type per scalar pair-call signature found in the module so the
// emitter can resolve the exact cast target instead of arity-guessing a
// program function.

fn pair_sig_parse_vt(seg: String) -> i32 {
    let n = len(seg)
    if n == 0 {
        return 0 - 1
    }
    let mut value = 0
    let mut i = 0
    while i < n {
        let d = seg.byte_at(i)
        if d < 48 || d > 57 {
            return 0 - 1
        }
        value = value * 10 + (d - 48)
        i = i + 1
    }
    value
}

// Scalar argument kinds that can be pinned to a canonical wasm sig without
// knowing the concrete ref type. Ref-family args (4/5/8) and v128 (7) keep
// the existing name/trampoline resolution because their cast type needs the
// exact declared shape.
fn pair_call_sig_vt_is_scalar(vt: i32) -> bool {
    vt == value_types::VT_I32() ||
    vt == value_types::VT_I64() ||
    vt == value_types::VT_F64() ||
    vt == value_types::VT_F32() ||
    vt == 30
}

// "<structref, args...> -> ret" func-sig for a pair-ABI call site, or "" when
// the hint has no vk key or a segment cannot be pinned to a concrete type.
// The env slot is always structref under the uniform pair ABI. Scalar
// segments come from the vk value types; ref-family segments resolve their
// exact type from the parallel nk name segment so producer-free call sites
// still get a valid ref.cast target (#872).
fn pair_call_sig_from_hint(hint: String, dest_vt: i32, memory64: bool, gc_struct_names: Vec<String>) -> String {
    let vk = call_ref_hint_seg4(hint.clone())
    if !vk.clone().starts_with(String_from("vk:")) {
        return String_new()
    }
    let nk = call_ref_hint_seg3(hint.clone())
    let mut nk_params = String_new()
    let mut nk_ret = String_new()
    if nk.clone().starts_with(String_from("nk:")) {
        let nk_body = nk.clone().slice(3, len(nk))
        let nk_sep = nk_body.clone().index_of(String_from(";"))
        if nk_sep >= 0 {
            nk_params = nk_body.clone().slice(0, nk_sep)
            nk_ret = nk_body.clone().slice(nk_sep + 1, len(nk_body))
        }
    }
    let body = vk.clone().slice(3, len(vk))
    let sep = body.clone().index_of(String_from(";"))
    if sep < 0 {
        return String_new()
    }
    let params_part = body.clone().slice(0, sep)
    let ret_part = body.clone().slice(sep + 1, len(body))
    let mut sig = String_from("structref")
    let n = len(params_part)
    if n > 0 {
        let mut seg_start = 0
        let mut i = 0
        let mut pi = 0
        while i <= n {
            if i == n || params_part.byte_at(i) == 44 {
                let seg = params_part.clone().slice(seg_start, i)
                let vt = pair_sig_parse_vt(seg)
                if vt >= 0 && pair_call_sig_vt_is_scalar(vt) {
                    sig = sig.concat(String_from("_"))
                    sig = sig.concat(sections_type_plan::val_type_to_target_sig(vt, true, memory64))
                } else {
                    let name_tok = pair_sig_named_sig_token(
                        pair_key_param_seg(nk_params.clone(), pi),
                        gc_struct_names.clone(),
                        memory64
                    )
                    if len(name_tok) == 0 {
                        return String_new()
                    }
                    sig = sig.concat(String_from("_"))
                    sig = sig.concat(name_tok)
                }
                seg_start = i + 1
                pi = pi + 1
            }
            i = i + 1
        }
    }
    let mut ret_vt = 0 - 1
    if len(ret_part) > 0 {
        ret_vt = pair_sig_parse_vt(ret_part)
    }
    if ret_vt < 0 {
        ret_vt = dest_vt
    }
    if ret_vt == value_types::VT_VOID() {
        return sig.concat(String_from("_0"))
    }
    if pair_call_sig_vt_is_scalar(ret_vt) {
        return sig.clone().concat(String_from("_1").concat(sections_type_plan::val_type_to_target_sig(ret_vt, true, memory64)))
    }
    // Ref-family return: the nk return name carries the declared type, so
    // resolve the exact ref token instead of dropping to the arity scan.
    let ret_tok = pair_sig_named_sig_token(nk_ret.clone(), gc_struct_names, memory64)
    if len(ret_tok) == 0 {
        return String_new()
    }
    sig.concat(String_from("_1").concat(ret_tok))
}

// Segment at position idx inside a comma-separated pair-key params part
// ("a,b,c"), or "" when idx is out of range.
fn pair_key_param_seg(params: String, idx: i32) -> String {
    let n = len(params)
    let mut seg_start = 0
    let mut seen = 0
    let mut i = 0
    while i <= n {
        if i == n || params.clone().byte_at(i) == 44 {
            if seen == idx {
                return params.clone().slice(seg_start, i)
            }
            seen = seen + 1
            seg_start = i + 1
        }
        i = i + 1
    }
    String_new()
}

// Func-sig token for a named pair-call segment. Scalar names map to their
// canonical value-type sig (with the same Memory64 widening the trampoline
// signatures use); ref names resolve through pair_sig_ref_name_token so a
// String return pins gcref0 rather than an arity-guessed fallback (#872).
fn pair_sig_named_sig_token(name: String, gc_struct_names: Vec<String>, memory64: bool) -> String {
    if len(name) == 0 {
        return String_new()
    }
    let vt = fnsig_segment_value_type(name.clone())
    if vt != value_types::VT_GC_REF() && vt != value_types::VT_REF() {
        return sections_type_plan::val_type_to_target_sig(vt, true, memory64)
    }
    pair_sig_ref_name_token(name, gc_struct_names)
}

// Exact ref-type func-sig token for a ref-valued pair-call segment name.
// Mirrors fnsig_segment_sig_for_mir spelling rules but resolves user
// struct slots from the gc_struct_names list, which is available to both
// the type-section collector and the emit-side lookup (#872).
fn pair_sig_ref_name_token(name: String, gc_struct_names: Vec<String>) -> String {
    if eq(name.clone(), String_from("String")) || eq(name.clone(), String_from("string")) {
        return sections_types_gc::gc_string_type_sig()
    }
    if name.clone().starts_with(String_from("vec:")) ||
    name.clone().starts_with(String_from("hashmap:")) {
        return pair_sig_collection_name_token(name, gc_struct_names)
    }
    if name.clone().starts_with(String_from("option:")) ||
    name.clone().starts_with(String_from("result:")) ||
    name.clone().starts_with(String_from("enum:")) ||
    name.clone().starts_with(String_from("Option")) ||
    name.clone().starts_with(String_from("Result")) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if eq(name.clone(), String_from("fn")) ||
    name.clone().starts_with(String_from("fnref")) ||
    name.clone().starts_with(String_from("fnsig:")) ||
    name.clone().starts_with(String_from("fn(")) {
        // fn values are __fnpair records under the pair ABI.
        let pair_slot = pair_sig_struct_slot(gc_struct_names, String_from("__fnpair"))
        if pair_slot >= 0 {
            return String_from("gcsref").concat((pair_slot).to_string())
        }
        return String_new()
    }
    let slot = pair_sig_struct_slot(gc_struct_names, name.clone())
    if slot >= 0 {
        return String_from("gcsref").concat((slot).to_string())
    }
    String_new()
}

fn pair_sig_struct_slot(gc_struct_names: Vec<String>, name: String) -> i32 {
    let mut i = 0
    while i < len(gc_struct_names) {
        if eq(get_unchecked(gc_struct_names, i), name.clone()) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// vec:/hashmap: segment names -> their fixed collection type sigs. Mirrors
// collection_type_sig but needs no MirModule: the only module-dependent
// branch (Vec of user structs) resolves through gc_struct_names (#872).
fn pair_sig_collection_name_token(name: String, gc_struct_names: Vec<String>) -> String {
    if name.clone().starts_with(String_from("vec:")) {
        if eq(name.clone(), String_from("vec:String")) || eq(name.clone(), String_from("vec:string")) {
            return sections_types_gc::gc_vec_string_type_sig()
        }
        if eq(name.clone(), String_from("vec:i64")) || eq(name.clone(), String_from("vec:I64")) {
            return sections_types_gc::gc_vec_i64_type_sig()
        }
        if eq(name.clone(), String_from("vec:f64")) || eq(name.clone(), String_from("vec:F64")) {
            return sections_types_gc::gc_vec_f64_type_sig()
        }
        if eq(name.clone(), String_from("vec:v128")) || eq(name.clone(), String_from("vec:V128")) {
            return sections_types_gc::gc_vec_v128_type_sig()
        }
        if eq(name.clone(), String_from("vec:fnref")) || eq(name.clone(), String_from("vec:fn")) {
            return sections_types_gc::gc_vec_fnref_type_sig()
        }
        let elem = name.clone().slice(4, len(name))
        if sections_types_gc_phase7::gc_vec_elem_name_is_fnref(elem.clone()) {
            return sections_types_gc::gc_vec_fnref_type_sig()
        }
        if sections_types_gc_phase7::gc_vec_elem_name_is_enum_like(elem.clone()) {
            return sections_types_gc::gc_vec_enum_ref_type_sig()
        }
        if sections_types_gc_phase7::gc_vec_elem_name_is_struct_ref(elem.clone()) ||
        eq(elem.clone(), String_from("Vec")) ||
        elem.clone().starts_with(String_from("vec:")) ||
        pair_sig_struct_slot(gc_struct_names.clone(), elem.clone()) >= 0 {
            return sections_types_gc_phase7::gc_vec_struct_ref_type_sig()
        }
        return sections_types_gc::gc_vec_type_sig()
    }
    if name.clone().starts_with(String_from("hashmap:i32str")) {
        return sections_types_gc::gc_hashmap_i32_str_type_sig()
    }
    if name.clone().starts_with(String_from("hashmap:i32fn")) {
        return sections_types_gc::gc_hashmap_i32_fn_type_sig()
    }
    if name.clone().starts_with(String_from("hashmap:strfn")) {
        return sections_types_gc::gc_hashmap_str_fn_type_sig()
    }
    if name.clone().starts_with(String_from("hashmap:strstr")) {
        return sections_types_gc::gc_hashmap_str_str_type_sig()
    }
    if name.clone().starts_with(String_from("hashmap:i32i32")) {
        return sections_types_gc::gc_vec_type_sig()
    }
    sections_types_gc::gc_hashmap_str_i32_type_sig()
}

// fn's canon type index via the module append-only signature table (#851
// Phase 3): identical to the type_plan fn_type_map entry — canon order is
// registration order — but readable before the type plan exists.
fn emit_fn_type_idx(ctx: SelfEmitCtx, fi: i32) -> i32 {
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    if fi < 0 || fi >= len(functions) {
        return 0 - 1
    }
    module_canon::MirModule_canon_index_of(
        ctx.mir,
        sections_types_sigs_detail::build_function_type_sig(
            get_unchecked(functions, fi),
            ctx_record::SelfEmitCtx_target(ctx),
            ctx_record::SelfEmitCtx_wasi_version(ctx),
            ctx_record::SelfEmitCtx_memory64(ctx),
            ctx.mir
        )
    )
}

// Emit-side lookup for the registered pair-call signatures: membership is
// the collected pair-sig list, the index is the module canon table.
fn call_ref_pair_sig_type_idx(ctx: SelfEmitCtx, sig: String) -> i32 {
    let sigs = ctx_record::SelfEmitCtx_pair_call_sigs(ctx)
    let n = len(sigs)
    let mut i = 0
    while i < n {
        if eq(sig.clone(), get_unchecked(sigs, i).clone()) {
            return module_canon::MirModule_canon_index_of(ctx.mir, sig)
        }
        i = i + 1
    }
    0 - 1
}

fn parse_first_arg_vt_hint(hint: String) -> i32 {
    if len(hint) == 0 {
        return 0 - 1
    }
    let n = len(hint)
    let mut value = 0
    let mut i = 0
    while i < n {
        let d = hint.byte_at(i)
        if d == 124 {
            if i == 0 {
                return 0 - 1
            }
            return value
        }
        if d >= 48 && d <= 57 {
            value = value * 10 + (d - 48)
        } else {
            return 0 - 1
        }
        i = i + 1
    }
    value
}

fn parse_call_ref_type_name_hint(hint: String) -> String {
    let n = len(hint)
    let mut i = 0
    while i < n {
        if hint.byte_at(i) == 124 {
            let rest = hint.clone().slice(i + 1, n)
            // Pair-ABI hints append |nk:...|vk:... after the type name
            // (#872); the type-name segment ends at the next '|'.
            let second = rest.clone().index_of(String_from("|"))
            if second < 0 {
                return rest
            }
            return rest.clone().slice(0, second)
        }
        i = i + 1
    }
    String_new()
}

fn resolve_indirect_type_idx(ctx: SelfEmitCtx, type_idx: i32, arg_count: i32, dest_vt: i32, first_arg_vt: i32) -> i32 {
    if type_idx >= 0 {
        return type_idx
    }
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    let fn_count = len(functions)
    let memory64 = ctx_record::SelfEmitCtx_memory64(ctx)
    // Unary HOF (map/filter): on wasm32 use stable WASI i32_1i32 (type 3).
    // Under Memory64, use only the explicit MIR parameter/return value types;
    // backend type names are not an admissible layout or ABI signal.
    if arg_count == 1 {
        if dest_vt == value_types::VT_I32() && (first_arg_vt < 0 || first_arg_vt == value_types::VT_I32()) {
            if memory64 {
                let named_m64 = find_unary_i32_callback_type_memory64(ctx, fn_count)
                if named_m64 >= 0 {
                    return named_m64
                }
            } else {
                let named = find_unary_i32_callback_type()
                if named >= 0 {
                    return named
                }
            }
        }
    }
    if arg_count == 2 {
        if memory64 {
            let named2_m64 = find_binary_i32_callback_type_memory64(ctx, fn_count)
            if named2_m64 >= 0 {
                return named2_m64
            }
        } else {
            let named2 = find_binary_i32_callback_type()
            if named2 >= 0 {
                return named2
            }
        }
    }
    let mut fi = 0
    while fi < fn_count {
        let f = get_unchecked(functions, fi)
        let pc = function_param_view::MirFunction_param_count(f)
        if pc == arg_count {
            let effective_rt = effective_return_vt(f)
            if match_matches_return(effective_rt, dest_vt) {
                if first_arg_vt >= 0 && pc > 0 {
                    let p0 = function_param_view::MirFunction_param_val_type(f, 0)
                    if match_matches_param0(p0, first_arg_vt) {
                        let fi_type = emit_fn_type_idx(ctx, fi)
                        if fi_type >= 0 {
                            return fi_type
                        }
                    }
                } else {
                    let fi_type = emit_fn_type_idx(ctx, fi)
                    if fi_type >= 0 {
                        return fi_type
                    }
                }
            }
        }
        fi = fi + 1
    }
    let first = emit_fn_type_idx(ctx, 0)
    if first >= 0 {
        return first
    }
    0
}

// call_ref resolution minus the func-scoped local-type probe. Callers emit-
// side probe typed_string_callback_type_idx_for_local first (its result
// doubles as the reloc-safety gate); reloc apply re-runs this tail directly
// because func-local state no longer exists at section assembly.
fn resolve_call_ref_type_idx_after_local(
    ctx: SelfEmitCtx,
    type_name: String,
    arg_count: i32,
    dest_vt: i32,
    first_arg_vt: i32
) -> i32 {
    let typed_value_idx = typed_string_callback_type_idx_for_value_types(
        ctx,
        arg_count,
        dest_vt,
        first_arg_vt
    )
    if typed_value_idx >= 0 {
        return typed_value_idx
    }
    let typed_idx = typed_string_callback_type_idx(ctx, type_name.clone())
    if typed_idx >= 0 {
        return typed_idx
    }
    resolve_indirect_type_idx(ctx, 0 - 1, arg_count, dest_vt, first_arg_vt)
}

// A struct.get result may retain the exact callback reference type in the GC
// layout spine even when its MIR type-name marker is generalized. Reuse that
// exact index only when it belongs to the reserved typed callback range.
fn typed_string_callback_type_idx_for_local(ctx: SelfEmitCtx, local_idx: i32) -> i32 {
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return 0 - 1
    }
    let base = ctx_record::SelfEmitCtx_gc_type_base(ctx)
    if base < 0 {
        return 0 - 1
    }
    let callback_base = base + sections_types_gc::gc_type_sig_count()
    let producer_idx = typed_string_callback_type_idx_from_struct_get(
        ctx,
        local_idx,
        callback_base
    )
    if producer_idx >= 0 {
        return producer_idx
    }
    let local_type_idx = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
    if local_type_idx >= callback_base && local_type_idx < callback_base + 3 {
        return local_type_idx
    }
    0 - 1
}

fn typed_string_callback_type_idx_from_struct_get(
    ctx: SelfEmitCtx,
    local_idx: i32,
    callback_base: i32
) -> i32 {
    let f = ctx_record::SelfEmitCtx_function_at(
        ctx,
        ctx_record::SelfEmitCtx_current_func_idx(ctx)
    )
    let mut bi = 0
    while bi < len(f.blocks) {
        let block = get_unchecked(f.blocks, bi)
        let mut ii = 0
        while ii < block_inst_access::MirBlock_inst_count(block) {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(inst) == mir_opcodes::MIR_STRUCT_GET() &&
            inst_accessors_operands::MirInst_dest(inst) == local_idx {
                let base_local = inst_accessors_operands::MirInst_arg0(inst)
                let base_type_idx = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(
                    ctx,
                    base_local
                )
                let encoded_field = inst_accessors_operands::MirInst_arg1(inst)
                let field_idx = if encoded_field >= 100000 {
                    encoded_field / 100000
                } else {
                    inst_accessors_literals::MirInst_int_val(inst) / 4
                }
                let field_type_idx = typed_string_callback_type_idx_from_struct_field(
                    ctx,
                    base_type_idx,
                    field_idx,
                    callback_base
                )
                if field_type_idx >= 0 {
                    return field_type_idx
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    0 - 1
}

fn typed_string_callback_type_idx_from_struct_field(
    ctx: SelfEmitCtx,
    struct_type_idx: i32,
    field_idx: i32,
    callback_base: i32
) -> i32 {
    if struct_type_idx < 0 || field_idx < 0 {
        return 0 - 1
    }
    let type_map = module_gc_struct::MirModule_gc_struct_canon_idxs(ctx.mir)
    let sigs = ctx_record::SelfEmitCtx_gc_struct_sigs(ctx)
    let mut i = 0
    while i < len(type_map) {
        if get_unchecked(type_map, i) != struct_type_idx || i >= len(sigs) {
            i = i + 1
            continue
        }
        let fields = sections_types_gc::struct_field_sigs(get_unchecked(sigs, i))
        if field_idx >= len(fields) {
            return 0 - 1
        }
        let field_sig = get_unchecked(fields, field_idx)
        if eq(field_sig.clone(), String_from("fnrefss")) {
            return callback_base
        }
        if eq(field_sig.clone(), String_from("fnrefsb")) {
            if ctx_record::SelfEmitCtx_memory64(ctx) {
                return callback_base + 2
            }
            return callback_base + 1
        }
        // fnsig field sigs carry func-sig tokens; String params reuse the
        // reserved typed callback range (#860).
        if field_sig.clone().starts_with(String_from("fnsig:")) {
            return fnsig_string_callback_type_idx(ctx, field_sig.clone(), callback_base)
        }
        return 0 - 1
    }
    0 - 1
}

// String callback fields carry a precise reference/value ABI in the GC type
// section, while MIR temporaries may lose the field's type-name marker after
// struct.get. The value types at call_ref still identify these two supported
// callback shapes without relying on a local-name reconstruction.
fn typed_string_callback_type_idx_for_value_types(
    ctx: SelfEmitCtx,
    arg_count: i32,
    dest_vt: i32,
    first_arg_vt: i32
) -> i32 {
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) || arg_count != 1 {
        return 0 - 1
    }
    if first_arg_vt != value_types::VT_GC_REF() && first_arg_vt != value_types::VT_REF() {
        return 0 - 1
    }
    let base = ctx_record::SelfEmitCtx_gc_type_base(ctx)
    if base < 0 {
        return 0 - 1
    }
    let callback_base = base + sections_types_gc::gc_type_sig_count()
    if dest_vt == value_types::VT_GC_REF() || dest_vt == value_types::VT_REF() {
        return callback_base
    }
    if dest_vt == value_types::VT_I32() {
        return callback_base + 1
    }
    if dest_vt == value_types::VT_I64() && ctx_record::SelfEmitCtx_memory64(ctx) {
        return callback_base + 2
    }
    0 - 1
}

fn typed_string_callback_type_idx(ctx: SelfEmitCtx, type_name: String) -> i32 {
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return 0 - 1
    }
    let base = ctx_record::SelfEmitCtx_gc_type_base(ctx)
    if base < 0 {
        return 0 - 1
    }
    let callback_base = base + sections_types_gc::gc_type_sig_count()
    // `fnsig:<param>;<return>` names carry the concrete signature. String
    // params map onto the reserved typed-callback slots; other signatures
    // resolve through the MirFunction search below (#860).
    if type_name.clone().starts_with(String_from("fnsig:")) {
        return fnsig_string_callback_type_idx(ctx, type_name.clone(), callback_base)
    }
    if eq(type_name.clone(), String_from("fnrefss")) {
        return callback_base
    }
    if eq(type_name.clone(), String_from("fnrefsb")) {
        if ctx_record::SelfEmitCtx_memory64(ctx) {
            return callback_base + 2
        }
        return callback_base + 1
    }
    0 - 1
}

// Callback type index for `fnsig:<param>;<return>` spellings whose param
// is the String byte-array (gcref0). Return segments map to the reserved
// typed-callback slots: ref returns use gcref0_1gcref0, i64 returns
// gcref0_1i64, and i32-family returns gcref0_1i32 / gcref0_1i64 by memory
// width — the same widening build_function_type_sig applies (#860).
// Non-String params return -1 so callers fall through to the value-type
// or MirFunction signature search.
fn fnsig_string_callback_type_idx(ctx: SelfEmitCtx, type_name: String, callback_base: i32) -> i32 {
    let rest = type_name.clone().slice(6, len(type_name))
    let sep = rest.clone().index_of(String_from(";"))
    if sep < 0 {
        return 0 - 1
    }
    let param_seg = rest.clone().slice(0, sep)
    if !fnsig_segment_is_string(param_seg.clone()) {
        return 0 - 1
    }
    let ret_seg = rest.clone().slice(sep + 1, len(rest))
    if ret_seg.clone().contains(String_from(";")) {
        return 0 - 1
    }
    if fnsig_segment_is_string(ret_seg.clone()) {
        return callback_base
    }
    if eq(ret_seg.clone(), String_from("i64")) || eq(ret_seg.clone(), String_from("u64")) {
        return callback_base + 2
    }
    if ctx_record::SelfEmitCtx_memory64(ctx) {
        return callback_base + 2
    }
    callback_base + 1
}

fn fnsig_segment_is_string(seg: String) -> bool {
    eq(seg.clone(), String_from("String")) ||
    eq(seg.clone(), String_from("string")) ||
    eq(seg.clone(), String_from("gcref0"))
}

// Local-declaration type index for `fnsig:<param>;<return>` locals. String
// params reuse the typed-callback slots; other unary signatures find the
// program function with the matching value-type signature so the stored
// ref.func and the declared local agree on the func type (#860).
fn resolve_fnsig_local_type_idx(ctx: SelfEmitCtx, type_name: String) -> i32 {
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return resolve_indirect_type_idx(ctx, 0 - 1, 1, value_types::VT_I32(), value_types::VT_I32())
    }
    let base = ctx_record::SelfEmitCtx_gc_type_base(ctx)
    if base >= 0 {
        let callback_base = base + sections_types_gc::gc_type_sig_count()
        let typed = fnsig_string_callback_type_idx(ctx, type_name.clone(), callback_base)
        if typed >= 0 {
            return typed
        }
    }
    let rest = type_name.clone().slice(6, len(type_name))
    let sep = rest.clone().index_of(String_from(";"))
    if sep < 0 {
        return 0 - 1
    }
    let param_vt = fnsig_segment_value_type(rest.clone().slice(0, sep))
    let ret_vt = fnsig_segment_value_type(rest.clone().slice(sep + 1, len(rest)))
    if param_vt < 0 || ret_vt < 0 {
        return 0 - 1
    }
    find_fnsig_fn_type_idx(ctx, param_vt, ret_vt)
}

fn fnsig_segment_value_type(seg: String) -> i32 {
    if eq(seg.clone(), String_from("i32")) || eq(seg.clone(), String_from("I32")) ||
    eq(seg.clone(), String_from("bool")) || eq(seg.clone(), String_from("Bool")) ||
    eq(seg.clone(), String_from("char")) || eq(seg.clone(), String_from("u8")) ||
    eq(seg.clone(), String_from("i8")) || eq(seg.clone(), String_from("u16")) ||
    eq(seg.clone(), String_from("i16")) || eq(seg.clone(), String_from("u32")) {
        return value_types::VT_I32()
    }
    if eq(seg.clone(), String_from("i64")) || eq(seg.clone(), String_from("I64")) ||
    eq(seg.clone(), String_from("u64")) {
        return value_types::VT_I64()
    }
    if eq(seg.clone(), String_from("f64")) || eq(seg.clone(), String_from("F64")) {
        return value_types::VT_F64()
    }
    if eq(seg.clone(), String_from("f32")) || eq(seg.clone(), String_from("F32")) {
        return value_types::VT_F32()
    }
    // String, containers, user structs, and enum payloads are all GC
    // references at the value-type level.
    value_types::VT_GC_REF()
}

// Find a program function whose unary signature matches (param_vt ->
// ret_vt) and return its canon type index. Reference params accept either
// ref flavour so `fnsig:VecIter;i32` finds `fn(VecIter) -> i32` (#860).
fn find_fnsig_fn_type_idx(ctx: SelfEmitCtx, param_vt: i32, ret_vt: i32) -> i32 {
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    let fn_count = len(functions)
    let mut fi = 0
    while fi < fn_count {
        let f = get_unchecked(functions, fi)
        if function_param_view::MirFunction_param_count(f) == 1 {
            let p0 = function_param_view::MirFunction_param_val_type(f, 0)
            let rt = effective_return_vt(f)
            if fnsig_vt_matches(p0, param_vt) && fnsig_vt_matches(rt, ret_vt) {
                return emit_fn_type_idx(ctx, fi)
            }
        }
        fi = fi + 1
    }
    0 - 1
}

fn fnsig_vt_matches(actual: i32, want: i32) -> bool {
    if actual == want {
        return true
    }
    if want == value_types::VT_GC_REF() || want == value_types::VT_REF() {
        return actual == value_types::VT_GC_REF() || actual == value_types::VT_REF()
    }
    false
}

fn find_unary_i32_callback_type() -> i32 {
    // Map/filter callbacks are funcref params. Searching MirFunctions can
    // falsely match Vec→Iter helpers whose wasm type is GC-ref based.
    // WASI host type sigs always include i32_1i32 as type index 3
    // (see sections_types_sigs::append_wasi_type_sigs).
    3
}

fn find_binary_i32_callback_type() -> i32 {
    // Fold callbacks are funcref params. Do not search MirFunctions — that
    // falsely matches map_i32_i32 when fnref locals are typed VT_I32.
    // WASI host type sigs always include i32_i32_1i32 as type index 1.
    1
}

fn find_unary_i32_callback_type_memory64(ctx: SelfEmitCtx, fn_count: i32) -> i32 {
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    let mut fi = 0
    while fi < fn_count {
        let f = get_unchecked(functions, fi)
        if function_param_view::MirFunction_param_count(f) == 1 {
            if function_param_view::MirFunction_param_val_type(f, 0) == value_types::VT_I32() {
                if function_return_view::MirFunction_return_type(f) == value_types::VT_I32() {
                    let fi_type = emit_fn_type_idx(ctx, fi)
                    if fi_type >= 0 {
                        return fi_type
                    }
                }
            }
        }
        fi = fi + 1
    }
    0 - 1
}

fn find_binary_i32_callback_type_memory64(ctx: SelfEmitCtx, fn_count: i32) -> i32 {
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    let mut fi = 0
    while fi < fn_count {
        let f = get_unchecked(functions, fi)
        if function_param_view::MirFunction_param_count(f) == 2 {
            if function_param_view::MirFunction_param_val_type(f, 0) == value_types::VT_I32() {
                if function_param_view::MirFunction_param_val_type(f, 1) == value_types::VT_I32() {
                    if function_return_view::MirFunction_return_type(f) == value_types::VT_I32() {
                        let fi_type = emit_fn_type_idx(ctx, fi)
                        if fi_type >= 0 {
                            return fi_type
                        }
                    }
                }
            }
        }
        fi = fi + 1
    }
    0 - 1
}

// The typed-MIR synchronization boundary is authoritative. Wasm emission does
// not reinterpret return type names to reconstruct ABI or layout identity.
fn effective_return_vt(f: MirFunction) -> i32 {
    function_return_view::MirFunction_return_type(f)
}

fn match_matches_param0(p0: i32, first_arg_vt: i32) -> bool {
    if first_arg_vt == value_types::VT_I32() {
        return p0 == value_types::VT_I32()
    }
    if first_arg_vt == value_types::VT_I64() {
        return p0 == value_types::VT_I64()
    }
    if first_arg_vt == value_types::VT_F64() {
        return p0 == value_types::VT_F64()
    }
    if first_arg_vt == value_types::VT_F32() {
        return p0 == value_types::VT_F32()
    }
    if first_arg_vt == value_types::VT_GC_REF() || first_arg_vt == value_types::VT_REF() {
        return p0 == value_types::VT_GC_REF() || p0 == value_types::VT_REF()
    }
    p0 == first_arg_vt
}

// type_idx is a canon index into the module's append-only signature table
// (#851 Phase 3). The sig text's last '_' segment encodes return arity —
// '0' void, '1<tok>' one value — so the arity reads straight from module
// SSOT instead of scanning the plan-built fn_type_map (unavailable at
// in-loop emit). A non-fn canon sig falls through to the dest_vt
// fallback, matching the old scan's no-match path.
fn indirect_type_returns_value(ctx: SelfEmitCtx, type_idx: i32, dest_vt: i32) -> bool {
    let canon_sigs = module_canon::MirModule_canon_sigs(ctx.mir)
    if type_idx >= 0 && type_idx < len(canon_sigs) {
        let sig = get_unchecked(canon_sigs, type_idx)
        let n = len(sig)
        let mut i = n - 1
        while i > 0 && sig.byte_at(i) != 95 {
            i = i - 1
        }
        let mut ret_head = sig.byte_at(i)
        if ret_head == 95 && i + 1 < n {
            ret_head = sig.byte_at(i + 1)
        }
        if ret_head == 48 {
            return false
        }
        if ret_head == 49 {
            return true
        }
    }
    dest_vt != value_types::VT_VOID()
}

fn match_matches_return(rt: i32, dest_vt: i32) -> bool {
    if rt == 0 && dest_vt == value_types::VT_VOID() {
        return true
    }
    if rt == 1 && dest_vt == value_types::VT_I32() {
        return true
    }
    if rt == 2 && dest_vt == value_types::VT_I64() {
        return true
    }
    if rt == 3 && dest_vt == value_types::VT_F64() {
        return true
    }
    if rt == 6 && dest_vt == value_types::VT_F32() {
        return true
    }
    if rt == 7 && dest_vt == value_types::VT_V128() {
        return true
    }
    if rt == 8 && dest_vt == value_types::VT_FUNCREF() {
        return true
    }
    if rt == 4 || rt == 5 {
        if dest_vt == value_types::VT_REF() || dest_vt == value_types::VT_GC_REF() {
            return true
        }
    }
    false
}
use mir::module_gc_struct
