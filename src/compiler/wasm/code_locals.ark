use wasm::constants
use wasm::ctx_record
use wasm::call_indirect
use wasm::code_ref_locals
use wasm::code_ref_locals_block_scan
use wasm::code_scratch_locals
use wasm::code_locals_val_type
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::ctx_gc_layout_lookup
use wasm::emit_target
use wasm::code_locals_struct
use mir::function_identity
use mir::function_locals_view
use mir::local_access
use mir::value_types
use wasm::writer_core
use wasm::sections_types_gc_phase7

fn resolve_fnref_local_type_idx(ctx: SelfEmitCtx, type_name: String) -> i32 {
    // Binary fold callbacks: fn(i32, i32) -> i32 → type index for (i32,i32)->i32.
    if contains(clone(type_name), String_from(",")) || eq(clone(type_name), String_from("fnref2")) {
        return call_indirect::resolve_indirect_type_idx(ctx, 0 - 1, 2, value_types::VT_I32(), value_types::VT_I32())
    }
    call_indirect::resolve_indirect_type_idx(ctx, 0 - 1, 1, value_types::VT_I32(), value_types::VT_I32())
}

fn is_string_byte_vec_fn(f: MirFunction) -> bool {
    let name = function_identity::MirFunction_name(f)
    eq(clone(name), String_from("__core_string_push_range")) ||
    eq(clone(name), String_from("__core_string_push_byte")) ||
    eq(clone(name), String_from("__core_string_ascii_case_impl"))
}

fn emit_local_decls(body: WasmWriter, f: MirFunction, local_count: i32, param_count: i32, ctx: SelfEmitCtx) {
    let body_local_count = local_count - param_count
    // The header is the NUMBER OF LOCAL GROUPS (each group = count + type),
    // not the total number of locals.
    let sgc = code_scratch_locals::scratch_group_count(ctx)
    writer_core::emit_leb128_u(body, body_local_count + sgc)
    let mut li = param_count
    while li < local_count {
        let loc = function_locals_view::MirFunction_local_at(f, li)
        writer_core::emit_leb128_u(body, 1)
        emit_local_val_type(body, f, li, local_access::MirLocal_val_type(loc), ctx)
        li = li + 1
    }
    code_scratch_locals::emit_scratch_local_decls(body, ctx)
}

fn emit_local_val_type(body: WasmWriter, f: MirFunction, local_idx: i32, vt: i32, ctx: SelfEmitCtx) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        if emit_gc_local_val_type(body, f, local_idx, vt, ctx) {
            return
        }
    }
    writer_core::emit_byte(body, code_locals_val_type::val_type_to_wasm_width(
            vt,
            writer_core::writer_memory64(body)
        ))
}

// GC-target local val type emission. Returns true if emitted as a GC ref.
fn emit_gc_local_val_type(body: WasmWriter, f: MirFunction, local_idx: i32, vt: i32, ctx: SelfEmitCtx) -> bool {
    let loc = function_locals_view::MirFunction_local_at(f, local_idx)
    let type_name = local_access::MirLocal_type_name(loc)
    let variant_slot = local_access::MirLocal_variant_slot(loc)
    // #835 / #843: Result/Option payload extract field ABI wins over sticky
    // String type_name. Uses STRUCT_GET / GC_STRUCT_GET field typing — not
    // body-scan infer. i32 tag fields return None here.
    if !code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let extract_ty = code_ref_locals_block_scan::local_payload_extract_storage_type(f, local_idx, ctx)
        match extract_ty {
            Option::Some(extract_v) => {
                writer_core::emit_byte(body, constants::WASM_REF_NULL())
                writer_core::emit_leb128_s(body, extract_v)
                return true
            }
            Option::None => {}
        }
    }
    // Typed funcref locals: non-null `(ref $callback)` — unary map/filter or
    // binary fold from the local's fn(...) type name (#807).
    if vt == value_types::VT_FUNCREF() ||
    eq(clone(type_name), String_from("fnref")) ||
    eq(clone(type_name), String_from("fnref2")) ||
    starts_with(clone(type_name), String_from("fnref")) ||
    starts_with(clone(type_name), String_from("fn(")) {
        let type_idx = resolve_fnref_local_type_idx(ctx, clone(type_name))
        writer_core::emit_byte(body, constants::WASM_REF())
        writer_core::emit_leb128_s(body, type_idx)
        return true
    }
    // Assert/loop temps may keep an open-enum type_name after local reuse while
    // the body only stores i64. Demote those; real array/string refs are skipped
    // inside the scan helper. Never demote Result/Option/enum container locals —
    // MIR_CALL producers are not counted as ref ops by the i64 scan, so fs
    // write_string/read_to_string dests were collapsing to i32 (#834 cmd_init).
    if code_ref_locals::local_body_has_i64_stack_set(f, local_idx) &&
    !code_locals_struct::local_has_result_option_enum_type_name(clone(type_name)) {
        let mut scalar_vt = vt
        if scalar_vt == value_types::VT_GC_REF() ||
        scalar_vt == value_types::VT_REF() ||
        scalar_vt == value_types::VT_VOID() {
            scalar_vt = value_types::VT_I64()
        }
        writer_core::emit_byte(body, code_locals_val_type::val_type_to_wasm_width(
                scalar_vt,
                writer_core::writer_memory64(body)
            ))
        return true
    }
    // Prefer spine string storage before enum-variant typing (#843).
    // Only when spine says String — sticky type_name alone must not beat
    // open-enum extracts (#835).
    if !code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let spine_early = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
        if spine_early == ctx_gc_type::SelfEmitCtx_string_type(ctx) {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, spine_early)
            return true
        }
    }
    if code_locals_struct::emit_gc_local_enum_like(body, f, local_idx, clone(type_name), variant_slot, ctx) {
        return true
    }
    if starts_with(clone(type_name), String_from("vec:")) {
        // String byte-buffer helpers must keep Vec<i32> even if MIR type_name
        // was mis-resolved to a structref-element vec.
        if is_string_byte_vec_fn(f) {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
            return true
        }
        if emit_explicit_vec_gc_type(body, clone(type_name), ctx) {
            return true
        }
        if emit_vec_struct_ref_gc_type(body, clone(type_name), ctx) {
            return true
        }
        let spine_vec = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
        if vt == value_types::VT_I32() {
            if spine_vec >= 0 {
                writer_core::emit_byte(body, constants::WASM_REF_NULL())
                writer_core::emit_leb128_s(body, spine_vec)
                return true
            }
            // Spine miss with VT_I32 — local is reused for scalar i32.
        } else {
            if spine_vec >= 0 &&
            !vec_inferred_type_conflicts_with_type_name(clone(type_name), spine_vec, ctx) {
                writer_core::emit_byte(body, constants::WASM_REF_NULL())
                writer_core::emit_leb128_s(body, spine_vec)
                return true
            }
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            let elem_name = substring(clone(type_name), 4, len(type_name))
            if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) {
                writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx))
            } else {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
            }
            return true
        }
    }
    if code_locals_struct::emit_gc_local_named_type(body, type_name, vt, f, local_idx, ctx) {
        return true
    }
    // Prefer spine string over a stray variant_slot on payload locals (#843).
    if !code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let spine_late = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
        if spine_late == ctx_gc_type::SelfEmitCtx_string_type(ctx) {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, spine_late)
            return true
        }
    }
    if variant_slot >= 0 &&
    !code_locals_struct::local_has_container_type_name(clone(type_name)) &&
    code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let variant_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_variant_slot(ctx, variant_slot)
        if variant_gc >= 0 {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, variant_gc)
            return true
        }
    }
    false
}

fn vec_elem_is_nested_container_name(elem_name: String) -> bool {
    // HashMap/HashSet remain i32-vec-backed containers. Nested Vec elements
    // use the structref-array layout so push/get can store GC vec refs.
    if eq(clone(elem_name), String_from("HashMap")) || eq(clone(elem_name), String_from("HashSet")) {
        return true
    }
    if starts_with(clone(elem_name), String_from("hashmap:")) || starts_with(clone(elem_name), String_from("hashset:")) {
        return true
    }
    false
}

fn emit_vec_struct_ref_gc_type(body: WasmWriter, type_name: String, ctx: SelfEmitCtx) -> bool {
    if !starts_with(clone(type_name), String_from("vec:")) {
        return false
    }
    let elem_name = substring(clone(type_name), 4, len(type_name))
    if vec_elem_is_nested_container_name(clone(elem_name)) {
        return false
    }
    if !ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) {
        return false
    }
    writer_core::emit_byte(body, constants::WASM_REF_NULL())
    writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx))
    true
}

fn vec_inferred_type_conflicts_with_type_name(type_name: String, inferred_gc: i32, ctx: SelfEmitCtx) -> bool {
    if !starts_with(clone(type_name), String_from("vec:")) {
        return false
    }
    let elem_name = substring(clone(type_name), 4, len(type_name))
    if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) {
        return inferred_gc != ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx)
    }
    false
}

fn emit_explicit_vec_gc_type(body: WasmWriter, type_name: String, ctx: SelfEmitCtx) -> bool {
    if eq(clone(type_name), String_from("vec:String")) || eq(clone(type_name), String_from("vec:string")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_string_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:v128")) || eq(clone(type_name), String_from("vec:V128")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_v128_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:i64")) || eq(clone(type_name), String_from("vec:I64")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:f64")) || eq(clone(type_name), String_from("vec:F64")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:fnref")) || eq(clone(type_name), String_from("vec:fn")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx))
        return true
    }
    if starts_with(clone(type_name), String_from("vec:")) {
        let elem = substring(clone(type_name), 4, len(type_name))
        if sections_types_gc_phase7::gc_vec_elem_name_is_fnref(clone(elem)) {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx))
            return true
        }
        if sections_types_gc_phase7::gc_vec_elem_name_is_enum_like(clone(elem)) {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_enum_ref_type(ctx))
            return true
        }
    }
    false
}

fn val_type_to_wasm(vt: i32) -> i32 {
    if vt == value_types::VT_I32() {
        return constants::WASM_I32()
    }
    if vt == value_types::VT_I64() {
        return constants::WASM_I64()
    }
    if vt == value_types::VT_F64() {
        return constants::WASM_F64()
    }
    if vt == value_types::VT_F32() {
        return constants::WASM_F32()
    }
    if vt == value_types::VT_V128() {
        return constants::WASM_V128()
    }
    if vt == value_types::VT_FUNCREF() {
        return constants::WASM_FUNCREF()
    }
    if vt == value_types::VT_REF() {
        return constants::WASM_I32()
    }
    if vt == value_types::VT_GC_REF() {
        return constants::WASM_I32()
    }
    constants::WASM_I32()
}
