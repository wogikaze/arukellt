use std::prelude::{clone, eq, starts_with, substring}
use wasm::constants
use wasm::ctx_record
use wasm::code_ref_locals
use wasm::code_ref_locals_block_scan
use wasm::code_ref_locals_fn_cache
use wasm::code_ref_locals_scan
use wasm::code_scratch_locals
use wasm::code_locals_val_type
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::ctx_gc_layout_lookup
use wasm::emit_target
use wasm::emit_rung_census
use wasm::code_locals_struct
use wasm::ctx_fn_type_refs
use wasm::sections_types_gc
use mir::function_identity
use mir::function_locals_view
use mir::function_return_view
use mir::block_inst_access
use mir::inst_accessors_literals
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use mir::local_access
use mir::opcodes
use mir::value_types
use wasm::writer_core
use wasm::sections_types_gc_phase7
use wasm::intrinsic_vec_type
use wasm::intrinsic_vec_access_gc
use wasm::inst_ctx
fn current_local_type_name(ctx: SelfEmitCtx, local_idx: i32) -> String {
    let f = ctx_record::SelfEmitCtx_function_at(
        ctx,
        ctx_record::SelfEmitCtx_current_func_idx(ctx)
    )
    if local_idx < 0 || local_idx >= function_locals_view::MirFunction_local_count(f) {
        return String_new()
    }
    local_access::MirLocal_type_name(
        function_locals_view::MirFunction_local_at(f, local_idx)
    )
}

fn is_string_byte_vec_fn(f: MirFunction) -> bool {
    let name = function_identity::MirFunction_name(f)
    eq(clone(name), String_from("__core_string_push_range")) ||
    eq(clone(name), String_from("__core_string_push_byte")) ||
    eq(clone(name), String_from("__core_string_ascii_case_impl"))
}

fn emit_local_decls(body: WasmWriter, f: MirFunction, local_count: i32, param_count: i32, ctx: SelfEmitCtx) {
    let body_local_count = local_count - param_count
    // The header is the NUMBER OF LOCAL GROUPS (each group = count + type),
    // not the total number of locals.
    let sgc = code_scratch_locals::scratch_group_count(ctx)
    writer_core::emit_leb128_u(body, body_local_count + sgc)
    // Params are typed by the function's type-section entry, recorded while
    // that section was emitted; -1 for anything that is not a concrete ref null.
    let local_ref_types = Vec::new<i32>()
    // Symbolic sig parse: the canon table is not sealed while the decl
    // loop emits bodies, so the fn-type index is unavailable. The sig
    // text yields the same param ref types the canon reader parsed.
    let param_ref_types = ctx_fn_type_refs::SelfEmitCtx_fn_sig_param_ref_types(ctx, f)
    let mut pi = 0
    while pi < param_count {
        let mut param_ref = 0 - 1
        if pi < len(param_ref_types) {
            param_ref = get_unchecked(param_ref_types, pi)
        }
        push(local_ref_types, param_ref)
        pi = pi + 1
    }
    // get_unchecked(...).field dests: the field use carries the concrete
    // struct type, which the call-result spine can still spell as String.
    // Declare those temps with the field's struct layout (#695).
    let get_unchecked_types = intrinsic_vec_access_gc::build_get_unchecked_field_types(ctx, f)
    let mut li = param_count
    while li < local_count {
        let loc = function_locals_view::MirFunction_local_at(f, li)
        writer_core::emit_leb128_u(body, 1)
        let val_type_pos = writer_core::writer_size(body)
        let field_type = intrinsic_vec_access_gc::get_unchecked_field_type_at(get_unchecked_types, li)
        if field_type >= 0 {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_GET_UNCHECKED_FIELD())
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, field_type)
        } else {
            emit_local_val_type(body, f, li, local_access::MirLocal_val_type(loc), ctx)
        }
        push(local_ref_types, writer_core::writer_ref_null_type_at(body, val_type_pos))
        li = li + 1
    }
    code_scratch_locals::emit_scratch_local_decls(body, ctx)
    writer_core::writer_begin_function_locals(body, local_ref_types)
}

fn gc_local_type_name_is_string_or_empty(type_name: String) -> bool {
    len(type_name) == 0 ||
    eq(clone(type_name), String_from("String")) ||
    eq(clone(type_name), String_from("string"))
}

fn emit_local_val_type(body: WasmWriter, f: MirFunction, local_idx: i32, vt: i32, ctx: SelfEmitCtx) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        if emit_gc_local_val_type(body, f, local_idx, vt, ctx) {
            return
        }
        ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_SCALAR_WIDTH_FALLBACK())
    }
    if vt == value_types::VT_FUNCREF() &&
    !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        // The linear fallback stores a callback as an i32 table index. The
        // GC primary path uses a typed `(ref $sig)` local instead.
        writer_core::emit_byte(body, constants::WASM_I32())
        return
    }
    writer_core::emit_byte(body, code_locals_val_type::val_type_to_wasm_width(
            vt,
            writer_core::writer_memory64(body)
        ))
}

// GC-target local val type emission. Returns true if this function emitted the
// declaration, including the scalar override for stale GC metadata.
fn emit_gc_local_val_type(body: WasmWriter, f: MirFunction, local_idx: i32, vt: i32, ctx: SelfEmitCtx) -> bool {
    let loc = function_locals_view::MirFunction_local_at(f, local_idx)
    let type_name = sections_types_gc_phase7::gc_normalize_vec_type_name(
        local_access::MirLocal_type_name(loc)
    )
    let variant_slot = local_access::MirLocal_variant_slot(loc)
    let scalar_vt = code_ref_locals::local_scalar_producer_vt(f, local_idx, ctx)
    if scalar_vt >= 0 &&
    !code_ref_locals::local_has_strong_ref_producer(f, local_idx, ctx) &&
    !code_locals_struct::local_has_result_option_enum_type_name(clone(type_name)) {
        ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_SCALAR_OVERRIDE())
        writer_core::emit_byte(body, code_locals_val_type::val_type_to_wasm_width(
                scalar_vt,
                writer_core::writer_memory64(body)
            ))
        return true
    }
    // A join temp can be LOCAL_SET from differently-typed sources on
    // different branches (a unit-typed if still copies each branch's last
    // stack ref). No concrete decl accepts both stores, so resolve the
    // shared storage first: enum_open for enum-family conflicts, `(ref null
    // any)` for unrelated types. Typed reads ref.cast at the access site.
    let join_storage =
    code_ref_locals_block_scan::local_set_conflict_storage_type(f, local_idx, ctx)
    match join_storage {
        Option::Some(join_type) => {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_BRANCH_JOIN())
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, join_type)
            return true
        }
        Option::None => {}
    }
    if starts_with(clone(type_name), String_from("array:")) {
        // Array literals hold the backing GC array directly. They use an
        // `array:` marker so the same element metadata cannot be mistaken for
        // a Vec header by local declaration emission.
        ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_ARRAY_LITERAL())
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(
            body,
            intrinsic_vec_type::resolve_array_type_for_local(ctx, local_idx)
        )
        return true
    }
    if local_is_vec_constructor_dest(f, local_idx, ctx) {
        ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_VEC_CONSTRUCTOR_DEST())
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, intrinsic_vec_type::resolve_vec_type_for_new_dest(ctx, local_idx))
        return true
    }
    // #835 / #843: Result/Option payload extract field ABI wins over sticky
    // String type_name. Uses STRUCT_GET / GC_STRUCT_GET field typing — not
    // body-scan infer. i32 tag fields return None here.
    if !code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let extract_ty = code_ref_locals_block_scan::local_payload_extract_storage_type(f, local_idx, ctx)
        match extract_ty {
            Option::Some(extract_v) => {
                ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_PAYLOAD_EXTRACT())
                writer_core::emit_byte(body, constants::WASM_REF_NULL())
                writer_core::emit_leb128_s(body, extract_v)
                return true
            }
            Option::None => {}
        }
    }
    let vec_access_storage =
    code_ref_locals_block_scan::local_vec_access_storage_type(f, local_idx, ctx)
    match vec_access_storage {
        Option::Some(element_type) => {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_VEC_ACCESS())
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, element_type)
            return true
        }
        Option::None => {}
    }
    let copied_storage =
    code_ref_locals_block_scan::local_set_non_string_storage_type(f, local_idx, ctx)
    match copied_storage {
        Option::Some(copied_type) => {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_COPIED_LOCAL_SET())
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, copied_type)
            return true
        }
        Option::None => {}
    }
    let direct_producer_storage =
    code_ref_locals_block_scan::local_direct_producer_storage_type(f, local_idx, ctx)
    match direct_producer_storage {
        Option::Some(direct_type) => {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_DIRECT_PRODUCER())
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, direct_type)
            return true
        }
        Option::None => {}
    }
    // rawfnref temps hold a bare funcref: the ref.func result before it is
    // stored into a __fnpair record (#872).
    if eq(clone(type_name), String_from("rawfnref")) {
        ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_FUNCREF())
        writer_core::emit_byte(body, constants::WASM_FUNCREF())
        return true
    }
    // fn values are {fnptr, env} pairs under the managed closure ABI
    // (#872): nullable __fnpair refs. The pair record is a fixed GC type
    // (gc_fnpair_offset), so it is always in scope on GC targets.
    if vt == value_types::VT_FUNCREF() ||
    eq(clone(type_name), String_from("fnref")) ||
    eq(clone(type_name), String_from("fnref2")) ||
    starts_with(clone(type_name), String_from("fnref")) ||
    starts_with(clone(type_name), String_from("fnsig:")) ||
    starts_with(clone(type_name), String_from("fn(")) {
        ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_FUNCREF())
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_record::SelfEmitCtx_gc_type_base(ctx) + sections_types_gc::gc_fnpair_offset())
        return true
    }
    // Assert/loop temps may keep an open-enum type_name after local reuse while
    // the body only stores i64. Demote those; real array/string refs are skipped
    // inside the scan helper. Never demote Result/Option/enum container locals —
    // MIR_CALL producers are not counted as ref ops by the i64 scan, so fs
    // write_string/read_to_string dests were collapsing to i32 (#834 cmd_init).
    if code_ref_locals_fn_cache::cached_body_has_i64_stack_set(ctx, local_idx) &&
    !code_locals_struct::local_has_result_option_enum_type_name(clone(type_name)) {
        let mut scalar_vt = vt
        if scalar_vt == value_types::VT_GC_REF() ||
        scalar_vt == value_types::VT_REF() ||
        scalar_vt == value_types::VT_VOID() {
            scalar_vt = value_types::VT_I64()
        }
        ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_I64_DEMOTION())
        writer_core::emit_byte(body, code_locals_val_type::val_type_to_wasm_width(
                scalar_vt,
                writer_core::writer_memory64(body)
            ))
        return true
    }
    // Return temp of `-> Vec<T>` must be the vec header, not T. Vec::new<T>
    // inlines to struct.new of the header while dest type_name stays T
    // (json_obj_new / json_arr_new).
    if code_ref_locals_scan::local_feeds_return(f, local_idx, ctx) {
        let ret_name = function_return_view::MirFunction_return_type_name(f)
        if starts_with(clone(ret_name), String_from("vec:")) {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_RETURN_VEC())
            if is_string_byte_vec_fn(f) {
                writer_core::emit_byte(body, constants::WASM_REF_NULL())
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
                return true
            }
            if emit_explicit_vec_gc_type(body, clone(ret_name), ctx) {
                return true
            }
            if emit_vec_struct_ref_gc_type(body, clone(ret_name), ctx) {
                return true
            }
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            let elem_name = substring(clone(ret_name), 4, len(ret_name))
            if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) {
                writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx))
            } else {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
            }
            return true
        }
    }
    // CALL dests can keep a sticky String TypeId while the callee returns a
    // named struct (WitParsedInterface). Producer type wins over spine String.
    if !code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let producer_storage =
        code_ref_locals_block_scan::local_direct_producer_storage_type(f, local_idx, ctx)
        match producer_storage {
            Option::Some(producer_type) => {
                if producer_type != ctx_gc_type::SelfEmitCtx_string_type(ctx) {
                    ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_DIRECT_PRODUCER_LATE())
                    writer_core::emit_byte(body, constants::WASM_REF_NULL())
                    writer_core::emit_leb128_s(body, producer_type)
                    return true
                }
            }
            Option::None => {}
        }
    }
    // Prefer spine string storage before enum-variant typing (#843).
    // Only when spine says String — sticky type_name alone must not beat
    // open-enum extracts (#835). Do not collapse a named struct local.
    if !code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let spine_early = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
        if spine_early == ctx_gc_type::SelfEmitCtx_string_type(ctx) &&
        gc_local_type_name_is_string_or_empty(clone(type_name)) {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_SPINE_STRING_EARLY())
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, spine_early)
            return true
        }
    }
    if code_locals_struct::emit_gc_local_enum_like(body, f, local_idx, clone(type_name), variant_slot, ctx) {
        ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_ENUM_LIKE())
        return true
    }
    if starts_with(clone(type_name), String_from("vec:")) {
        // String byte-buffer helpers must keep Vec<i32> even if MIR type_name
        // was mis-resolved to a structref-element vec.
        if is_string_byte_vec_fn(f) {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_VEC_TYPE_NAME())
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
            return true
        }
        if emit_explicit_vec_gc_type(body, clone(type_name), ctx) {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_VEC_TYPE_NAME())
            return true
        }
        if emit_vec_struct_ref_gc_type(body, clone(type_name), ctx) {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_VEC_TYPE_NAME())
            return true
        }
        let spine_vec = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
        if vt == value_types::VT_I32() {
            if spine_vec >= 0 {
                ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_VEC_TYPE_NAME())
                writer_core::emit_byte(body, constants::WASM_REF_NULL())
                writer_core::emit_leb128_s(body, spine_vec)
                return true
            }
            // Spine miss with VT_I32 — local is reused for scalar i32.
        } else {
            if spine_vec >= 0 &&
            !vec_inferred_type_conflicts_with_type_name(clone(type_name), spine_vec, ctx) {
                ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_VEC_TYPE_NAME())
                writer_core::emit_byte(body, constants::WASM_REF_NULL())
                writer_core::emit_leb128_s(body, spine_vec)
                return true
            }
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_VEC_TYPE_NAME())
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            let elem_name = substring(clone(type_name), 4, len(type_name))
            if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) ||
            ctx_gc_type_vec_ref::gc_vec_elem_is_registered_struct(ctx, clone(elem_name)) {
                writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx))
            } else {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
            }
            return true
        }
    }
    if code_locals_struct::emit_gc_local_named_type(body, type_name, vt, f, local_idx, ctx) {
        ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_NAMED_TYPE())
        return true
    }
    // Prefer spine string over a stray variant_slot on payload locals (#843).
    if !code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let spine_late = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
        if spine_late == ctx_gc_type::SelfEmitCtx_string_type(ctx) &&
        gc_local_type_name_is_string_or_empty(clone(type_name)) {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_SPINE_STRING_LATE())
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, spine_late)
            return true
        }
    }
    if variant_slot >= 0 &&
    !code_locals_struct::local_has_container_type_name(clone(type_name)) &&
    code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let variant_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_variant_slot(ctx, variant_slot)
        if variant_gc >= 0 {
            ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_VARIANT_SLOT())
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, variant_gc)
            return true
        }
    }
    // A GC ref whose named layout did not resolve still needs a ref local;
    // the typed cast at the use site recovers the concrete type (#708).
    // The legacy vt can lag behind the annotated Result/Option name, so the
    // type name is also a signal for the base-ref fallback.
    if vt == value_types::VT_GC_REF() ||
    code_locals_struct::local_has_result_option_enum_type_name(clone(type_name)) {
        ctx_record::SelfEmitCtx_note_emit_census(ctx, emit_rung_census::RUNG_OPEN_REF_FALLBACK())
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_byte(body, constants::WASM_STRUCTREF())
        return true
    }
    false
}

fn local_is_vec_constructor_dest(f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> bool {
    let cached = code_ref_locals_scan::cached_local_is_vec_constructor_dest(ctx, local_idx)
    if cached >= 0 {
        return cached != 0
    }
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_CALL() &&
            inst_accessors_operands::MirInst_dest(inst) == local_idx {
                let callee = inst_accessors_literals::MirInst_str_val(inst)
                if code_ref_locals_scan::is_vec_constructor_name(callee) {
                    return true
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

fn vec_elem_is_nested_container_name(elem_name: String) -> bool {
    // HashMap/HashSet remain i32-vec-backed containers. Nested Vec elements
    // use the structref-array layout so push/get can store GC vec refs.
    if eq(clone(elem_name), String_from("HashMap")) || eq(clone(elem_name), String_from("HashSet")) {
        return true
    }
    if starts_with(clone(elem_name), String_from("hashmap:")) || starts_with(clone(elem_name), String_from("hashset:")) {
        return true
    }
    false
}

fn emit_vec_struct_ref_gc_type(body: WasmWriter, type_name: String, ctx: SelfEmitCtx) -> bool {
    if !starts_with(clone(type_name), String_from("vec:")) {
        return false
    }
    let elem_name = substring(clone(type_name), 4, len(type_name))
    if vec_elem_is_nested_container_name(clone(elem_name)) {
        return false
    }
    if !ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) &&
    !ctx_gc_type_vec_ref::gc_vec_elem_is_registered_struct(ctx, clone(elem_name)) {
        return false
    }
    writer_core::emit_byte(body, constants::WASM_REF_NULL())
    writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx))
    true
}

fn vec_inferred_type_conflicts_with_type_name(type_name: String, inferred_gc: i32, ctx: SelfEmitCtx) -> bool {
    if !starts_with(clone(type_name), String_from("vec:")) {
        return false
    }
    let elem_name = substring(clone(type_name), 4, len(type_name))
    if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) ||
    ctx_gc_type_vec_ref::gc_vec_elem_is_registered_struct(ctx, clone(elem_name)) {
        return inferred_gc != ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx)
    }
    false
}

fn emit_explicit_vec_gc_type(body: WasmWriter, type_name: String, ctx: SelfEmitCtx) -> bool {
    if eq(clone(type_name), String_from("vec:String")) || eq(clone(type_name), String_from("vec:string")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_string_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:v128")) || eq(clone(type_name), String_from("vec:V128")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_v128_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:i64")) || eq(clone(type_name), String_from("vec:I64")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:f64")) || eq(clone(type_name), String_from("vec:F64")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:fnref")) || eq(clone(type_name), String_from("vec:fn")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx))
        return true
    }
    if starts_with(clone(type_name), String_from("vec:")) {
        let elem = substring(clone(type_name), 4, len(type_name))
        if sections_types_gc_phase7::gc_vec_elem_name_is_fnref(clone(elem)) {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx))
            return true
        }
        if sections_types_gc_phase7::gc_vec_elem_name_is_enum_like(clone(elem)) {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_enum_ref_type(ctx))
            return true
        }
    }
    false
}

fn val_type_to_wasm(vt: i32) -> i32 {
    if vt == value_types::VT_I32() {
        return constants::WASM_I32()
    }
    if vt == value_types::VT_I64() {
        return constants::WASM_I64()
    }
    if vt == value_types::VT_F64() {
        return constants::WASM_F64()
    }
    if vt == value_types::VT_F32() {
        return constants::WASM_F32()
    }
    if vt == value_types::VT_V128() {
        return constants::WASM_V128()
    }
    if vt == value_types::VT_FUNCREF() {
        return constants::WASM_FUNCREF()
    }
    if vt == value_types::VT_REF() {
        return constants::WASM_I32()
    }
    if vt == value_types::VT_GC_REF() {
        return constants::WASM_I32()
    }
    constants::WASM_I32()
}
