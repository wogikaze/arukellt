use wasm::constants
use wasm::ctx_record
use wasm::code_ref_locals
use wasm::code_scratch_locals
use wasm::code_locals_val_type
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::ctx_gc_layout_lookup
use wasm::emit_target
use wasm::code_locals_struct
use mir::block_inst_access
use mir::function_identity
use mir::function_locals_view
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use mir::local_access
use mir::opcodes
use mir::value_types
use wasm::writer_core

fn is_string_byte_vec_fn(f: MirFunction) -> bool {
    let name = function_identity::MirFunction_name(f)
    eq(clone(name), String_from("__core_string_push_range")) ||
    eq(clone(name), String_from("__core_string_push_byte")) ||
    eq(clone(name), String_from("__core_string_ascii_case_impl"))
}

fn local_has_int_const_def(f: MirFunction, local_idx: i32) -> bool {
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            if (op == opcodes::MIR_CONST_I32() || op == opcodes::MIR_CONST_I64()) &&
            inst_accessors_operands::MirInst_dest(inst) == local_idx {
                return true
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

// Numeric comparisons only. MIR_ADD is string concat; MIR_EQ/NEQ also compare
// strings (clock_random), so EQ/NEQ count only against an int const (#808).
fn local_used_as_i64_binop_operand(f: MirFunction, local_idx: i32) -> bool {
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            let arg0 = inst_accessors_operands::MirInst_arg0(inst)
            let arg1 = inst_accessors_operands::MirInst_arg1(inst)
            if arg0 == local_idx || arg1 == local_idx {
                if op == opcodes::MIR_LT() || op == opcodes::MIR_LTEQ() ||
                op == opcodes::MIR_GT() || op == opcodes::MIR_GTEQ() {
                    return true
                }
                if op == opcodes::MIR_EQ() || op == opcodes::MIR_NEQ() {
                    let mut other = arg1
                    if arg1 == local_idx {
                        other = arg0
                    }
                    if other >= 0 && local_has_int_const_def(f, other) {
                        return true
                    }
                    if other < 0 && ii > 0 {
                        let prev_op = inst_accessors_shape::MirInst_op(block_inst_access::MirBlock_inst_at(block, ii - 1))
                        if prev_op == opcodes::MIR_CONST_I32() || prev_op == opcodes::MIR_CONST_I64() {
                            return true
                        }
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

fn inst_is_scalar_arith_op(op: i32, inst: MirInst) -> bool {
    if op != opcodes::MIR_ADD() && op != opcodes::MIR_SUB() && op != opcodes::MIR_MUL() {
        return false
    }
    // String concat lowers as MIR_ADD with a ref result type.
    let vt = inst_accessors_shape::MirInst_val_type(inst)
    vt != value_types::VT_GC_REF() && vt != value_types::VT_REF()
}

fn inst_op_is_ref_value_producer(op: i32) -> bool {
    op == opcodes::MIR_REF_CAST() || op == opcodes::MIR_ARRAY_NEW() ||
    op == opcodes::MIR_GC_STRUCT_NEW() || op == opcodes::MIR_STRUCT_NEW() ||
    op == opcodes::MIR_CONST_STRING()
}

// True when this local is defined by a real ref value (cast/array/struct/string).
// Blocks i64 demotion on locals that are later reused for scalars (#808).
fn local_has_ref_value_producer(f: MirFunction, local_idx: i32) -> bool {
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            let dest = inst_accessors_operands::MirInst_dest(inst)
            if dest == local_idx && inst_op_is_ref_value_producer(op) {
                return true
            }
            if op == opcodes::MIR_LOCAL_SET() &&
            inst_accessors_operands::MirInst_arg0(inst) == local_idx &&
            ii > 0 {
                let prev_op = inst_accessors_shape::MirInst_op(block_inst_access::MirBlock_inst_at(block, ii - 1))
                if inst_op_is_ref_value_producer(prev_op) {
                    return true
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

// True when the local is used as an array/struct/ref operand. Distinguishes
// real GC refs (format/string helpers) from assert temps that only feed i64
// compares after a CALL with a stale GC_REF val_type (#808).
fn local_used_as_ref_op_base(f: MirFunction, local_idx: i32) -> bool {
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            let dest = inst_accessors_operands::MirInst_dest(inst)
            let arg0 = inst_accessors_operands::MirInst_arg0(inst)
            let arg1 = inst_accessors_operands::MirInst_arg1(inst)
            if op == opcodes::MIR_ARRAY_GET() || op == opcodes::MIR_ARRAY_LEN() ||
            op == opcodes::MIR_ARRAY_SET() {
                if arg0 == local_idx || arg1 == local_idx {
                    return true
                }
            }
            if op == opcodes::MIR_GC_STRUCT_GET() || op == opcodes::MIR_GC_STRUCT_SET() ||
            op == opcodes::MIR_STRUCT_GET() || op == opcodes::MIR_STRUCT_SET() {
                if arg0 == local_idx || arg1 == local_idx || dest == local_idx {
                    return true
                }
            }
            if op == opcodes::MIR_REF_CAST() && (dest == local_idx || arg0 == local_idx) {
                return true
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

// Detect loop-index / assert-temp defs that must be i64 storage even when the
// MIR local still carries an open-enum type_name. Inlined here so emit does
// not depend on cross-module forwarders for this validate gate (#808).
fn local_body_has_i64_stack_set(f: MirFunction, local_idx: i32) -> bool {
    // Ref-valued locals may share an index with later scalar reuse. Demoting
    // them to i64 breaks ref.cast / array stores (string_gc, clock_random).
    if local_has_ref_value_producer(f, local_idx) || local_used_as_ref_op_base(f, local_idx) {
        return false
    }
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            let dest = inst_accessors_operands::MirInst_dest(inst)
            let arg0 = inst_accessors_operands::MirInst_arg0(inst)
            let arg1 = inst_accessors_operands::MirInst_arg1(inst)
            // Defined by integer const / scalar arithmetic / extend.
            if dest == local_idx {
                if op == opcodes::MIR_CONST_I64() || op == opcodes::MIR_CONST_I32() ||
                op == opcodes::MIR_EXTEND_I32_TO_I64() ||
                inst_is_scalar_arith_op(op, inst) {
                    return true
                }
                // CALL dest forwarded by the next stack LOCAL_SET to a local
                // compared as i64. Wasm emit stores only the forward target;
                // the CALL dest can remain an open-enum ghost (#808).
                if op == opcodes::MIR_CALL() && ii + 1 < inst_count {
                    let next = block_inst_access::MirBlock_inst_at(block, ii + 1)
                    if inst_accessors_shape::MirInst_op(next) == opcodes::MIR_LOCAL_SET() {
                        let set_dst = inst_accessors_operands::MirInst_arg0(next)
                        let set_src = inst_accessors_operands::MirInst_arg1(next)
                        if set_dst >= 0 && set_dst != local_idx &&
                        (set_src < 0 || set_src == local_idx) &&
                        local_used_as_i64_binop_operand(f, set_dst) {
                            return true
                        }
                    }
                }
            }
            // Stack LOCAL_SET after const/scalar-add/call, or LOCAL_SET_FROM
            // a temp defined by CONST/scalar ADD (#808).
            if op == opcodes::MIR_LOCAL_SET() && arg0 == local_idx {
                if arg1 >= 0 {
                    let mut sj = 0
                    while sj < inst_count {
                        let src_inst = block_inst_access::MirBlock_inst_at(block, sj)
                        let src_op = inst_accessors_shape::MirInst_op(src_inst)
                        if inst_accessors_operands::MirInst_dest(src_inst) == arg1 {
                            if src_op == opcodes::MIR_CONST_I64() || src_op == opcodes::MIR_CONST_I32() ||
                            src_op == opcodes::MIR_EXTEND_I32_TO_I64() ||
                            inst_is_scalar_arith_op(src_op, src_inst) {
                                return true
                            }
                        }
                        sj = sj + 1
                    }
                }
                if ii > 0 {
                    let prev = block_inst_access::MirBlock_inst_at(block, ii - 1)
                    let prev_op = inst_accessors_shape::MirInst_op(prev)
                    if prev_op == opcodes::MIR_CONST_I64() || prev_op == opcodes::MIR_CONST_I32() ||
                    prev_op == opcodes::MIR_EXTEND_I32_TO_I64() ||
                    inst_is_scalar_arith_op(prev_op, prev) ||
                    prev_op == opcodes::MIR_LT() || prev_op == opcodes::MIR_EQ() {
                        return true
                    }
                    // Assert temps: CALL result LOCAL_SET then compared as i64.
                    if prev_op == opcodes::MIR_CALL() && local_used_as_i64_binop_operand(f, local_idx) {
                        return true
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

fn emit_local_decls(body: WasmWriter, f: MirFunction, local_count: i32, param_count: i32, ctx: SelfEmitCtx) {
    let body_local_count = local_count - param_count
    // The header is the NUMBER OF LOCAL GROUPS (each group = count + type),
    // not the total number of locals.
    let sgc = code_scratch_locals::scratch_group_count(ctx)
    writer_core::emit_leb128_u(body, body_local_count + sgc)
    let mut li = param_count
    while li < local_count {
        let loc = function_locals_view::MirFunction_local_at(f, li)
        writer_core::emit_leb128_u(body, 1)
        emit_local_val_type(body, f, li, local_access::MirLocal_val_type(loc), ctx)
        li = li + 1
    }
    code_scratch_locals::emit_scratch_local_decls(body, ctx)
}

fn emit_local_val_type(body: WasmWriter, f: MirFunction, local_idx: i32, vt: i32, ctx: SelfEmitCtx) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        if emit_gc_local_val_type(body, f, local_idx, vt, ctx) {
            return
        }
    }
    writer_core::emit_byte(body, code_locals_val_type::val_type_to_wasm_width(
            vt,
            writer_core::writer_memory64(body)
        ))
}

// GC-target local val type emission. Returns true if emitted as a GC ref.
fn emit_gc_local_val_type(body: WasmWriter, f: MirFunction, local_idx: i32, vt: i32, ctx: SelfEmitCtx) -> bool {
    let loc = function_locals_view::MirFunction_local_at(f, local_idx)
    let type_name = local_access::MirLocal_type_name(loc)
    let variant_slot = local_access::MirLocal_variant_slot(loc)
    // Loop indices / assert temps with stale open-enum type_name: demote when
    // body evidence shows i64 producers. CALL/array ref locals are excluded
    // inside local_body_has_i64_stack_set (#808).
    if local_body_has_i64_stack_set(f, local_idx) {
        let mut scalar_vt = vt
        if scalar_vt == value_types::VT_GC_REF() ||
        scalar_vt == value_types::VT_REF() ||
        scalar_vt == value_types::VT_VOID() {
            scalar_vt = value_types::VT_I64()
        }
        writer_core::emit_byte(body, code_locals_val_type::val_type_to_wasm_width(
                scalar_vt,
                writer_core::writer_memory64(body)
            ))
        return true
    }
    // Prefer producer-inferred string storage before enum-variant typing.
    // Payload locals used in GC_STRUCT_SET can keep a stray variant_slot while
    // still being defined by string-producing calls.
    if !code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let inferred_early = code_ref_locals::infer_ref_local_gc_type(f, local_idx, ctx)
        if inferred_early >= 0 && inferred_early == ctx_gc_type::SelfEmitCtx_string_type(ctx) {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, inferred_early)
            return true
        }
    }
    if code_locals_struct::emit_gc_local_enum_like(body, f, local_idx, clone(type_name), variant_slot, ctx) {
        return true
    }
    if starts_with(clone(type_name), String_from("vec:")) {
        // String byte-buffer helpers must keep Vec<i32> even if MIR type_name
        // was mis-resolved to a structref-element vec.
        if is_string_byte_vec_fn(f) {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
            return true
        }
        if emit_explicit_vec_gc_type(body, clone(type_name), ctx) {
            return true
        }
        if emit_vec_struct_ref_gc_type(body, clone(type_name), ctx) {
            return true
        }
        if vt == value_types::VT_I32() {
            let gc_type = code_ref_locals::infer_ref_local_gc_type(f, local_idx, ctx)
            if gc_type < 0 {
                // Type inference found no vec assignment — local is reused for i32.
            } else {
                writer_core::emit_byte(body, constants::WASM_REF_NULL())
                writer_core::emit_leb128_s(body, gc_type)
                return true
            }
        } else {
            let inferred_vec = code_ref_locals::infer_ref_local_gc_type(f, local_idx, ctx)
            if inferred_vec >= 0 && !vec_inferred_type_conflicts_with_type_name(clone(type_name), inferred_vec, ctx) {
                writer_core::emit_byte(body, constants::WASM_REF_NULL())
                writer_core::emit_leb128_s(body, inferred_vec)
                return true
            }
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            let elem_name = substring(clone(type_name), 4, len(type_name))
            if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) {
                writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx))
            } else {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
            }
            return true
        }
    }
    if code_locals_struct::emit_gc_local_named_type(body, type_name, vt, f, local_idx, ctx) {
        return true
    }
    // Prefer producer inference (string/call result) over a stray variant_slot
    // on payload locals that are not themselves GC_STRUCT_NEW destinations.
    let inferred = code_ref_locals::infer_ref_local_gc_type(f, local_idx, ctx)
    if inferred >= 0 && inferred == ctx_gc_type::SelfEmitCtx_string_type(ctx) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, inferred)
        return true
    }
    if variant_slot >= 0 &&
    !code_locals_struct::local_has_container_type_name(clone(type_name)) &&
    code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx) {
        let variant_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_variant_slot(ctx, variant_slot)
        if variant_gc >= 0 {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, variant_gc)
            return true
        }
    }
    false
}

fn vec_elem_is_nested_container_name(elem_name: String) -> bool {
    // HashMap/HashSet remain i32-vec-backed containers. Nested Vec elements
    // use the structref-array layout so push/get can store GC vec refs.
    if eq(clone(elem_name), String_from("HashMap")) || eq(clone(elem_name), String_from("HashSet")) {
        return true
    }
    if starts_with(clone(elem_name), String_from("hashmap:")) || starts_with(clone(elem_name), String_from("hashset:")) {
        return true
    }
    false
}

fn emit_vec_struct_ref_gc_type(body: WasmWriter, type_name: String, ctx: SelfEmitCtx) -> bool {
    if !starts_with(clone(type_name), String_from("vec:")) {
        return false
    }
    let elem_name = substring(clone(type_name), 4, len(type_name))
    if vec_elem_is_nested_container_name(clone(elem_name)) {
        return false
    }
    if !ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) {
        return false
    }
    writer_core::emit_byte(body, constants::WASM_REF_NULL())
    writer_core::emit_leb128_s(body, ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx))
    true
}

fn vec_inferred_type_conflicts_with_type_name(type_name: String, inferred_gc: i32, ctx: SelfEmitCtx) -> bool {
    if !starts_with(clone(type_name), String_from("vec:")) {
        return false
    }
    let elem_name = substring(clone(type_name), 4, len(type_name))
    if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) {
        return inferred_gc != ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx)
    }
    false
}

fn emit_explicit_vec_gc_type(body: WasmWriter, type_name: String, ctx: SelfEmitCtx) -> bool {
    if eq(clone(type_name), String_from("vec:String")) || eq(clone(type_name), String_from("vec:string")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_string_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:v128")) || eq(clone(type_name), String_from("vec:V128")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_v128_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:i64")) || eq(clone(type_name), String_from("vec:I64")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx))
        return true
    }
    if eq(clone(type_name), String_from("vec:f64")) || eq(clone(type_name), String_from("vec:F64")) {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx))
        return true
    }
    false
}

fn val_type_to_wasm(vt: i32) -> i32 {
    if vt == value_types::VT_I32() {
        return constants::WASM_I32()
    }
    if vt == value_types::VT_I64() {
        return constants::WASM_I64()
    }
    if vt == value_types::VT_F64() {
        return constants::WASM_F64()
    }
    if vt == value_types::VT_F32() {
        return constants::WASM_F32()
    }
    if vt == value_types::VT_V128() {
        return constants::WASM_V128()
    }
    if vt == value_types::VT_FUNCREF() {
        return constants::WASM_FUNCREF()
    }
    if vt == value_types::VT_REF() {
        return constants::WASM_I32()
    }
    if vt == value_types::VT_GC_REF() {
        return constants::WASM_I32()
    }
    constants::WASM_I32()
}
