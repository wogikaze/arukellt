use wasm::wasm

pub fn emit_wasm(
    mir: MirModule,
    target: String,
    wasi_version: String,
    memory_width: String,
    opt_level: i32,
    strip_debug: bool,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    source_file: String,
    report_timing: i32
) -> Vec<i32> {
    wasm::emit_wasm_module(
        mir, target, wasi_version, memory_width, opt_level, strip_debug, bindings, source_file, report_timing
    )
}
