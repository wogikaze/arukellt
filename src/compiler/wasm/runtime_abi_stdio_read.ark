use wasm::constants
use wasm::ctx_record
use wasm::emit_target
use wasm::import_indices
use wasm::runtime_abi_stdio_read_buffer
use wasm::runtime_abi_stdio_read_gc
use wasm::intrinsics::helpers_control
use wasm::intrinsics::helpers_core
use wasm::intrinsics::helpers_io_const
use wasm::intrinsics::helpers_io_layout
use wasm::intrinsics::helpers_memory
use wasm::intrinsics::helpers_numeric_i32
use wasm::intrinsics::helpers_numeric_i64_const

fn emit_read_stdin_to_string(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) && emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        runtime_abi_stdio_read_gc::emit_gc_wasi_read_stdin_to_string(w, ctx)
    } else {
        emit_wasi_read_stdin_string(w, ctx)
    }
    return true
}

fn emit_finish_stdin_string_buffer(w: WasmWriter) {
    runtime_abi_stdio_read_buffer::emit_finalize_stdin_string_buffer(w)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_FS_STRPTR())
    helpers_memory::emit_i32_load_default(w)
}

fn emit_wasi_read_stdin_string(w: WasmWriter, ctx: SelfEmitCtx) {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        emit_p2_read_stdin_string(w, ctx)
        return
    }
    runtime_abi_stdio_read_buffer::emit_begin_stdin_string_buffer(w)
    helpers_control::emit_block_loop_header(w)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_IOV())
    helpers_core::emit_heap_get(w)
    helpers_memory::emit_i32_store_default(w)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_IOV() + 4)
    helpers_numeric_i32::emit_i32_const(w, constants::FS_BUF_SIZE())
    helpers_memory::emit_i32_store_default(w)
    // WASI stdin.read keeps true i32 operands under Memory64.
    helpers_io_const::emit_i32_const(w, 0)
    helpers_io_layout::emit_scratch_addr_wasi(w, constants::SCRATCH_IOV())
    helpers_io_const::emit_i32_const(w, 1)
    helpers_io_layout::emit_scratch_addr_wasi(w, constants::SCRATCH_FS_NREAD())
    helpers_core::emit_call(w, import_indices::stdin_read_import_idx(ctx))
    helpers_core::emit_drop(w)
    runtime_abi_stdio_read_buffer::emit_advance_stdin_buffer_or_break(w)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
    emit_finish_stdin_string_buffer(w)
}

fn emit_p2_read_stdin_string(w: WasmWriter, ctx: SelfEmitCtx) {
    let s_src = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 3)
    runtime_abi_stdio_read_buffer::emit_begin_stdin_string_buffer(w)
    helpers_control::emit_block_loop_header(w)
    helpers_core::emit_call(w, constants::P2_IMPORT_GET_STDIN())
    helpers_numeric_i64_const::emit_i64_const(w, 4096i64)
    helpers_io_layout::emit_scratch_addr_wasi(w, constants::SCRATCH_CLOCK_RESULT())
    helpers_core::emit_call(w, import_indices::stdin_read_import_idx(ctx))
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_CLOCK_RESULT())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_ne(w)
    helpers_control::emit_br_if(w, 1)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_CLOCK_RESULT() + 8)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_FS_NREAD())
    helpers_memory::emit_i32_store_default(w)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_CLOCK_RESULT() + 4)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_src)
    helpers_core::emit_heap_get(w)
    helpers_core::emit_local_get(w, s_src)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_FS_NREAD())
    helpers_memory::emit_i32_load_default(w)
    helpers_memory::emit_memory_copy(w)
    runtime_abi_stdio_read_buffer::emit_advance_stdin_buffer_or_break(w)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
    emit_finish_stdin_string_buffer(w)
}
