use mir::inst_accessors_operands
use wasm::inst_store
use wasm::intrinsics::helpers_numeric_i32
use wasm::constants
use wasm::opcodes
use wasm::writer_core

// Emit a SIMD prefix byte + sub-opcode (LEB128-encoded)
fn emit_simd_prefix(mut w: WasmWriter, sub_opcode: i32) {
    writer_core::emit_byte(w, opcodes::SIMD_PREFIX())
    writer_core::emit_leb128_u(w, sub_opcode)
}

// Narrow the carried scalar on stack top to a raw i32 lane operand. No-op
// for non-i32 lane kinds; emit_narrow_i64_operand itself no-ops on memory32.
fn emit_simd_lane_demote(mut w: WasmWriter, lane_kind: i32) {
    if lane_kind == constants::SIMD_LANE_I32() {
        helpers_numeric_i32::emit_narrow_i64_operand(w)
    }
}

// Widen a raw i32 lane result back to the carried scalar width. Same gating
// as demote: i32-width lanes only, memory64-only emission.
fn emit_simd_lane_promote(mut w: WasmWriter, lane_kind: i32) {
    if lane_kind == constants::SIMD_LANE_I32() {
        helpers_numeric_i32::emit_widen_i32_result(w)
    }
}

// Splat: one lane-scalar operand on stack, result v128
fn emit_simd_splat(mut w: WasmWriter, inst: MirInst, sub_opcode: i32, lane_kind: i32, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    emit_simd_lane_demote(w, lane_kind)
    emit_simd_prefix(w, sub_opcode)
    emit_store_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
}

// i32-producing reduction (bitmask / all_true / any_true): the raw i32 result
// must widen back to the carried scalar width under Memory64.
fn emit_simd_reduce_i32(mut w: WasmWriter, inst: MirInst, sub_opcode: i32, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    emit_simd_prefix(w, sub_opcode)
    helpers_numeric_i32::emit_widen_i32_result(w)
    emit_store_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
}

// Binary SIMD op: two v128 operands on stack, result v128 on stack
fn emit_simd_binary(mut w: WasmWriter, inst: MirInst, sub_opcode: i32, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    emit_simd_prefix(w, sub_opcode)
    emit_store_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
}

// Unary SIMD op: one v128 operand on stack, result on stack
fn emit_simd_unary(mut w: WasmWriter, inst: MirInst, sub_opcode: i32, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    emit_simd_prefix(w, sub_opcode)
    emit_store_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
}

// Ternary SIMD op: three v128 operands on stack (a, b, c), result on stack
fn emit_simd_ternary(mut w: WasmWriter, inst: MirInst, sub_opcode: i32, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    emit_simd_prefix(w, sub_opcode)
    emit_store_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
}

// Extract lane: v128 + lane index (immediate) on stack, scalar result
fn emit_simd_extract_lane(mut w: WasmWriter, inst: MirInst, sub_opcode: i32, lane_kind: i32, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    emit_simd_prefix(w, sub_opcode)
    // Lane index is an immediate byte (0..N-1)
    let lane = inst_accessors_operands::MirInst_arg1(inst)
    writer_core::emit_byte(w, lane)
    emit_simd_lane_promote(w, lane_kind)
    emit_store_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
}

// Replace lane: v128 + scalar value on stack, lane index is immediate
fn emit_simd_replace_lane(mut w: WasmWriter, inst: MirInst, sub_opcode: i32, lane_kind: i32, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    emit_simd_lane_demote(w, lane_kind)
    emit_simd_prefix(w, sub_opcode)
    let lane = inst_accessors_operands::MirInst_arg1(inst)
    writer_core::emit_byte(w, lane)
    emit_store_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
}

// Shift: v128 + scalar i32 shift amount on stack, result v128 on stack
fn emit_simd_shift(mut w: WasmWriter, inst: MirInst, sub_opcode: i32, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    helpers_numeric_i32::emit_narrow_i64_operand(w)
    emit_simd_prefix(w, sub_opcode)
    emit_store_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
}

// Store result to dest local if needed
fn emit_store_result(mut w: WasmWriter, inst: MirInst, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
}
