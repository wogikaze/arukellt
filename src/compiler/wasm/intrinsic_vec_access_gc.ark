use wasm::opcodes
use wasm::ctx_scratch
use wasm::ctx_record
use wasm::writer_gc
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::ctx_gc_layout_lookup
use wasm::emit_target
use wasm::intrinsic_vec_type
use wasm::intrinsics::helpers_core
use wasm::inst_ctx
use wasm::inst_struct_record
use mir::function_return_view
use mir::function_param_view
use mir::function_block_queries
use mir::function_locals_view
use mir::inst_accessors_literals
use mir::inst_accessors_shape
use mir::inst_accessors_operands
use mir::block_inst_access
use wasm::sections_types_gc_phase7
use mir::lower::ctx_gc_struct
use mir::opcodes as mir_opcodes

// Resolve a concrete GC struct type from a struct type name (e.g. "Point").
// Checks gc_struct_names first, then falls back to byte_size-based lookup.
// Container element names (vec:String, Vec, ...) resolve via fixed GC slots
// so structref-array gets cast before calls (#726 csv_perf).
use std::text
fn resolve_concrete_struct_type(ctx: SelfEmitCtx, struct_name: String) -> i32 {
    if struct_name.clone().starts_with("enum:") {
        return ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    }
    // Accept "struct:Name:byte_size" / module::Name / bare Name.
    let mut bare = strip_module_prefix_type_name(struct_name.clone())
    if bare.clone().starts_with("struct:") {
        bare = parse_struct_name_from_encoding(bare.clone())
    }
    if bare.len() == 0 {
        bare = struct_name.clone()
    }
    let container = intrinsic_vec_type::resolve_container_elem_gc_type(ctx, bare.clone())
    if container >= 0 {
        return container
    }
    if ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, bare.clone()) {
        return ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, bare.clone())
    }
    if ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, struct_name.clone()) {
        return ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, struct_name.clone())
    }
    // Registered enum type names (TomlValue, JsonValue) without enum: prefix
    // still need enum-open casts after structref array.get (#726 toml/json).
    let ev_names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let ev_count = ev_names.len()
    let mut ei = 0
    let prefix = bare.clone().concat("::")
    while ei < ev_count {
        let nm = get_unchecked(ev_names, ei).clone()
        if nm.clone().starts_with(prefix.clone()) {
            return ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
        }
        ei = ei + 1
    }
    // Look up byte_size from the current function's MIR_STRUCT_NEW instructions.
    let func_idx = ctx_record::SelfEmitCtx_current_func_idx(ctx)
    let f = ctx_record::SelfEmitCtx_function_at(ctx, func_idx)
    let byte_size = lookup_struct_byte_size_in_func(f, bare.clone())
    if byte_size > 0 {
        return ctx_gc_type::SelfEmitCtx_struct_type(ctx, byte_size)
    }
    0 - 1
}

fn strip_module_prefix_type_name(type_name: String) -> String {
    let n = type_name.len()
    let mut i = n - 2
    while i >= 0 {
        if type_name.byte_at(i) == 58 && type_name.byte_at(i + 1) == 58 {
            return type_name.slice(i + 2, n)
        }
        i = i - 1
    }
    type_name
}

// "struct:TypeName:byte_size" → TypeName
fn parse_struct_name_from_encoding(type_name: String) -> String {
    let n = type_name.len()
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if type_name.byte_at(i) == 58 {
            if first_colon < 0 {
                first_colon = i
            }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon < 0 || first_colon == last_colon {
        return String_new()
    }
    type_name.slice(first_colon + 1, last_colon)
}

// Scan function instructions for MIR_STRUCT_NEW with matching struct name.
fn lookup_struct_byte_size_in_func(f: MirFunction, struct_name: String) -> i32 {
    let block_count = f.blocks.len()
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_STRUCT_NEW() {
                let name = inst_accessors_literals::MirInst_str_val(inst)
                if name.clone().eq(struct_name.clone()) {
                    return inst_accessors_literals::MirInst_int_val(inst)
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    0
}

fn emit_get_unchecked_gc(mut w: WasmWriter, ctx: SelfEmitCtx, inst: MirInst) -> bool {
    let s_idx = ctx_scratch::SelfEmitCtx_scratch_base(ctx)
    let callee = inst_accessors_literals::MirInst_str_val(inst)
    let array_type = intrinsic_vec_type::resolve_array_type_for_call(ctx, callee, inst)
    let vec_type = intrinsic_vec_type::resolve_vec_type_for_call(ctx, callee, inst)
    // Array literals are raw GC arrays, not Vec structs. Casting them to the
    // Vec layout traps on `get_unchecked(values, i)` (#807 core/property).
    let raw_array_type = raw_gc_array_type(ctx, callee.clone(), inst, array_type)
    if raw_array_type >= 0 {
        helpers_core::emit_local_set(w, s_idx)
        writer_gc::emit_gc_ref_cast(w, raw_array_type)
        helpers_core::emit_local_get(w, s_idx)
        if raw_array_type == ctx_gc_type::SelfEmitCtx_i32_array_type(ctx) {
            writer_gc::emit_gc_array_get_i32(w, raw_array_type)
        } else {
            writer_gc::emit_gc_array_get(w, raw_array_type)
        }
        return true
    }
    helpers_core::emit_local_set(w, s_idx)
    writer_gc::emit_gc_ref_cast(w, vec_type)
    writer_gc::emit_gc_struct_get(w, vec_type, 0)
    helpers_core::emit_local_get(w, s_idx)
    if array_type == ctx_gc_type::SelfEmitCtx_i32_array_type(ctx) {
        writer_gc::emit_gc_array_get_i32(w, array_type)
    } else {
        writer_gc::emit_gc_array_get(w, array_type)
    }
    // Funcref arrays store nullable refs; callers/locals expect non-null (#832).
    if array_type == ctx_gc_type_vec_ref::SelfEmitCtx_fnref_array_type(ctx) {
        writer_gc::emit_gc_ref_as_non_null(w)
    }
    // If array element type is abstract structref, cast to concrete struct type.
    // Prefer dest local's type (vec:String) over bare "Vec" (#726 csv_perf).
    let struct_ref_array_type = ctx_gc_type_vec_ref::SelfEmitCtx_struct_ref_array_type(ctx)
    if array_type == struct_ref_array_type {
        let mut elem_gc_type = 0 - 1
        let dest = inst_accessors_operands::MirInst_dest(inst)
        if dest >= 0 {
            let dest_tname = intrinsic_vec_type::local_type_name(ctx, dest)
            if dest_tname.len() > 0 {
                elem_gc_type = resolve_concrete_struct_type(ctx, dest_tname.clone())
                // Mis-typed dest locals (e.g. String) must not steal the cast;
                // structref elems need the vec's element struct type.
                if elem_gc_type == ctx_gc_type::SelfEmitCtx_string_type(ctx) ||
                elem_gc_type == ctx_gc_type::SelfEmitCtx_i32_array_type(ctx) {
                    elem_gc_type = 0 - 1
                }
            }
        }
        if elem_gc_type < 0 {
            let elem_name = intrinsic_vec_type::vec_element_type_name_for_call(ctx, callee.clone(), inst)
            if elem_name.len() > 0 {
                elem_gc_type = resolve_concrete_struct_type(ctx, elem_name.clone())
            }
        }
        // structref arrays never store String / i32-array elems; a poisoned
        // vec:String type_name must not produce a string cast (or skip cast).
        if elem_gc_type == ctx_gc_type::SelfEmitCtx_string_type(ctx) ||
        elem_gc_type == ctx_gc_type::SelfEmitCtx_i32_array_type(ctx) {
            elem_gc_type = 0 - 1
        }
        if elem_gc_type < 0 && dest >= 0 {
            elem_gc_type = resolve_get_unchecked_elem_from_dest_uses(ctx, dest)
        }
        // `get_unchecked(v, i).field`: the field access is the only use that
        // knows the concrete struct layout, so cast before the dest store.
        if elem_gc_type < 0 && dest >= 0 {
            elem_gc_type = resolve_get_unchecked_elem_from_field_use(ctx, dest)
        }
        // Nested call args: `typed_fn(get_unchecked(vec, i))` leaves dest=-1 and
        // feeds the structref straight into the next CALL (#730).
        if elem_gc_type < 0 {
            elem_gc_type = resolve_get_unchecked_elem_from_next_call(ctx, inst)
        }
        if elem_gc_type < 0 {
            elem_gc_type = resolve_get_unchecked_elem_from_func_return(ctx)
        }
        if elem_gc_type >= 0 {
            writer_gc::emit_gc_ref_cast(w, elem_gc_type)
        }
    }
    return true
}

fn raw_gc_array_type(ctx: SelfEmitCtx, callee: String, inst: MirInst, array_type: i32) -> i32 {
    let src_local = intrinsic_vec_type::find_call_source_local(ctx, callee.clone(), inst)
    if src_local < 0 {
        return 0 - 1
    }
    if intrinsic_vec_type::local_is_raw_array(ctx, src_local) {
        return array_type
    }
    let idx = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, src_local)
    if idx < 0 {
        return 0 - 1
    }
    if idx == array_type || idx == ctx_gc_type::SelfEmitCtx_i32_array_type(ctx) ||
    idx == ctx_gc_type::SelfEmitCtx_string_array_type(ctx) ||
    idx == ctx_gc_type::SelfEmitCtx_i64_array_type(ctx) ||
    idx == ctx_gc_type::SelfEmitCtx_f64_array_type(ctx) ||
    idx == ctx_gc_type::SelfEmitCtx_v128_array_type(ctx) ||
    idx == ctx_gc_type_vec_ref::SelfEmitCtx_fnref_array_type(ctx) ||
    idx == ctx_gc_type_vec_ref::SelfEmitCtx_struct_ref_array_type(ctx) ||
    idx == ctx_gc_type_vec_ref::SelfEmitCtx_enum_ref_array_type(ctx) {
        return idx
    }
    0 - 1
}

fn resolve_get_unchecked_elem_from_next_call(ctx: SelfEmitCtx, inst: MirInst) -> i32 {
    let dest = inst_accessors_operands::MirInst_dest(inst)
    let callee = inst_accessors_literals::MirInst_str_val(inst)
    let func_idx = ctx_record::SelfEmitCtx_current_func_idx(ctx)
    let f = ctx_record::SelfEmitCtx_function_at(ctx, func_idx)
    let block_count = function_block_queries::MirFunction_block_count(f)
    let mut bi = 0
    while bi < block_count {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let cur = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(cur) == mir_opcodes::MIR_CALL() {
                let cur_callee = inst_accessors_literals::MirInst_str_val(cur)
                let same_get = cur_callee.clone().eq(callee.clone()) &&
                inst_accessors_operands::MirInst_dest(cur) == dest
                if same_get {
                    let mut look = ii + 1
                    while look < inst_count {
                        let next = block_inst_access::MirBlock_inst_at(block, look)
                        let nop = inst_accessors_shape::MirInst_op(next)
                        if nop == mir_opcodes::MIR_CALL() {
                            let next_callee = inst_accessors_literals::MirInst_str_val(next)
                            let fn_idx = inst_ctx::resolve_fn_index(ctx, next_callee.clone())
                            if fn_idx >= 0 {
                                let called = ctx_record::SelfEmitCtx_function_at(ctx, fn_idx)
                                let pc = function_param_view::MirFunction_param_count(called)
                                // get_unchecked result is stack-top → last call argument.
                                // Using param 0 wrongly picks the Vec receiver for push(vec, elem).
                                if pc > 0 {
                                    let pname = function_param_view::MirFunction_param_type_name(called, pc - 1)
                                    let resolved = resolve_concrete_struct_type(ctx, pname.clone())
                                    if resolved >= 0 &&
                                    resolved != ctx_gc_type::SelfEmitCtx_string_type(ctx) &&
                                    resolved != ctx_gc_type::SelfEmitCtx_i32_array_type(ctx) &&
                                    !pname.clone().starts_with("vec:") &&
                                    !pname.clone().starts_with("Vec") {
                                        return resolved
                                    }
                                }
                            }
                            look = inst_count
                        } else if nop == mir_opcodes::MIR_LOCAL_SET() || nop == mir_opcodes::MIR_LOCAL_GET() {
                            look = look + 1
                        } else {
                            look = inst_count
                        }
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    0 - 1
}

// When dest type_name is poisoned (String) but the value is immediately passed
// to a typed call (e.g. indexed_symbol_uri(IndexedSymbol)), recover the concrete
// GC struct from that callee's first parameter (#730 symbol_index_remove_uri).
fn resolve_get_unchecked_elem_from_dest_uses(ctx: SelfEmitCtx, dest: i32) -> i32 {
    if dest < 0 {
        return 0 - 1
    }
    let func_idx = ctx_record::SelfEmitCtx_current_func_idx(ctx)
    let f = ctx_record::SelfEmitCtx_function_at(ctx, func_idx)
    let block_count = function_block_queries::MirFunction_block_count(f)
    let mut bi = 0
    while bi < block_count {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let cur = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(cur) == mir_opcodes::MIR_CALL() {
                let feeds = call_arg_local_gets_include(block, ii, dest)
                if feeds {
                    let call_callee = inst_accessors_literals::MirInst_str_val(cur)
                    let fn_idx = inst_ctx::resolve_fn_index(ctx, call_callee.clone())
                    if fn_idx >= 0 {
                        let called = ctx_record::SelfEmitCtx_function_at(ctx, fn_idx)
                        if function_param_view::MirFunction_param_count(called) > 0 {
                            let pname = function_param_view::MirFunction_param_type_name(called, 0)
                            let resolved = resolve_concrete_struct_type(ctx, pname.clone())
                            if resolved >= 0 &&
                            resolved != ctx_gc_type::SelfEmitCtx_string_type(ctx) &&
                            resolved != ctx_gc_type::SelfEmitCtx_i32_array_type(ctx) {
                                return resolved
                            }
                        }
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    0 - 1
}

// The field access on a get_unchecked result carries the concrete struct
// type. Resolve it so the structref array element is cast before the dest
// local (declared as that struct) is stored (#695).
fn resolve_get_unchecked_elem_from_field_use(ctx: SelfEmitCtx, dest: i32) -> i32 {
    if dest < 0 {
        return 0 - 1
    }
    let func_idx = ctx_record::SelfEmitCtx_current_func_idx(ctx)
    let f = ctx_record::SelfEmitCtx_function_at(ctx, func_idx)
    let block_count = function_block_queries::MirFunction_block_count(f)
    let mut bi = 0
    while bi < block_count {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let cur = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(cur)
            if op == mir_opcodes::MIR_STRUCT_GET() || op == mir_opcodes::MIR_GC_STRUCT_GET() {
                let base = inst_accessors_operands::MirInst_arg0(cur)
                if base == dest || (base >= 0 && local_is_copy_of(block, ii, base, dest)) {
                    let byte_offset = inst_accessors_literals::MirInst_int_val(cur)
                    let size_hint = inst_accessors_operands::MirInst_arg1(cur)
                    let resolved = inst_struct_record::resolve_gc_struct_type_idx(
                        cur,
                        ctx,
                        0 - 1,
                        0 - 1,
                        byte_offset,
                        size_hint
                    )
                    if resolved >= 0 {
                        return resolved
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    0 - 1
}

fn is_get_unchecked_callee_name(name: String) -> bool {
    name.clone().contains("get_unchecked")
}

// Local declarations are emitted before body instructions, so a get_unchecked
// dest cannot be retyped from the field-use cast at that point. Build the
// dest -> concrete struct map in one function pass and let emit_local_decls
// declare those temps with the struct layout the store/field access uses.
fn build_get_unchecked_field_types(ctx: SelfEmitCtx, f: MirFunction) -> Vec<i32> {
    // A resolved field type is a GC layout index. The linear target has no GC
    // type region, so such an index names a func type and a local declared with
    // it cannot hold the i32 the linear store emits (invalid wasm32 module).
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return Vec::new<i32>()
    }
    let local_count = function_locals_view::MirFunction_local_count(f)
    let mut types = Vec::new<i32>()
    let mut i = 0
    while i < local_count {
        types.push(0 - 1)
        i = i + 1
    }
    let block_count = function_block_queries::MirFunction_block_count(f)
    let mut bi = 0
    while bi < block_count {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let cur = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(cur) == mir_opcodes::MIR_CALL() {
                let dest = inst_accessors_operands::MirInst_dest(cur)
                if dest >= 0 && dest < local_count &&
                is_get_unchecked_callee_name(inst_accessors_literals::MirInst_str_val(cur)) {
                    types.set(dest, 0 - 2)
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    bi = 0
    while bi < block_count {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let cur = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(cur)
            if op == mir_opcodes::MIR_STRUCT_GET() || op == mir_opcodes::MIR_GC_STRUCT_GET() {
                let base = inst_accessors_operands::MirInst_arg0(cur)
                if base >= 0 && base < local_count && get_unchecked(types, base) == 0 - 2 {
                    let byte_offset = inst_accessors_literals::MirInst_int_val(cur)
                    let size_hint = inst_accessors_operands::MirInst_arg1(cur)
                    let resolved = inst_struct_record::resolve_gc_struct_type_idx(
                        cur,
                        ctx,
                        0 - 1,
                        0 - 1,
                        byte_offset,
                        size_hint
                    )
                    if resolved >= 0 {
                        types.set(base, resolved)
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    types
}

fn get_unchecked_field_type_at(types: Vec<i32>, local_idx: i32) -> i32 {
    if local_idx < 0 || local_idx >= types.len() {
        return 0 - 1
    }
    get_unchecked(types, local_idx)
}

fn call_arg_local_gets_include(block: MirBlock, call_ii: i32, local_idx: i32) -> bool {
    let call = block_inst_access::MirBlock_inst_at(block, call_ii)
    let arg_count = inst_accessors_operands::MirInst_int_val(call)
    if arg_count <= 0 {
        return false
    }
    let mut gets_seen = 0
    let mut look = 1
    while gets_seen < arg_count && call_ii - look >= 0 {
        let prev = block_inst_access::MirBlock_inst_at(block, call_ii - look)
        if inst_accessors_shape::MirInst_op(prev) == mir_opcodes::MIR_LOCAL_GET() {
            let src = inst_accessors_operands::MirInst_arg0(prev)
            if src == local_idx || local_is_copy_of(block, call_ii, src, local_idx) {
                return true
            }
            gets_seen = gets_seen + 1
        }
        look = look + 1
    }
    false
}

// True when `alias` was defined by copying `local_idx` earlier in the block
// (local.get local_idx; local.set alias), as get_unchecked results often are.
fn local_is_copy_of(block: MirBlock, before_ii: i32, alias: i32, local_idx: i32) -> bool {
    if alias == local_idx {
        return true
    }
    let mut ii = 0
    while ii < before_ii {
        let cur = block_inst_access::MirBlock_inst_at(block, ii)
        if inst_accessors_shape::MirInst_op(cur) == mir_opcodes::MIR_LOCAL_SET() {
            // LOCAL_SET encodes the target local in arg0 (dest is unused).
            if inst_accessors_operands::MirInst_arg0(cur) == alias && ii > 0 {
                let prev = block_inst_access::MirBlock_inst_at(block, ii - 1)
                if inst_accessors_shape::MirInst_op(prev) == mir_opcodes::MIR_LOCAL_GET() {
                    if inst_accessors_operands::MirInst_arg0(prev) == local_idx {
                        return true
                    }
                }
            }
        }
        ii = ii + 1
    }
    false
}

// When vec elem typing was poisoned (vec:String) but the array is structref,
// the enclosing function return is often the concrete struct (wit_find).
fn resolve_get_unchecked_elem_from_func_return(ctx: SelfEmitCtx) -> i32 {
    let func_idx = ctx_record::SelfEmitCtx_current_func_idx(ctx)
    let f = ctx_record::SelfEmitCtx_function_at(ctx, func_idx)
    let ret_name = function_return_view::MirFunction_return_type_name(f)
    if ret_name.len() == 0 {
        return 0 - 1
    }
    let resolved = resolve_concrete_struct_type(ctx, ret_name.clone())
    if resolved >= 0 &&
    resolved != ctx_gc_type::SelfEmitCtx_string_type(ctx) &&
    resolved != ctx_gc_type::SelfEmitCtx_i32_array_type(ctx) {
        return resolved
    }
    0 - 1
}

// Option::Some field suffix for Vec/HashMap element types.
// Shares the MIR container slot map so outer get on Vec<Vec<T>> does not
// fall through to string _f1_ref0 (#836).
fn option_some_suffix_for_container_elem(elem_name: String) -> String {
    if !ctx_gc_struct::gc_struct_field_type_is_container(elem_name.clone()) {
        return String_new()
    }
    "_f1".concat(ctx_gc_struct::gc_struct_container_ref_suffix(elem_name.clone()))
}

// Map a named GC struct to `_f1_gcsref<slot>` for Option::Some payloads.
fn find_gcsref_suffix_for_struct(ctx: SelfEmitCtx, struct_name: String) -> String {
    let names = ctx_record::SelfEmitCtx_gc_struct_names(ctx)
    let count = names.len()
    let mut i = 0
    while i < count {
        if get_unchecked(names, i).clone().eq(struct_name.clone()) {
            return "_f1_gcsref".concat((i).to_string())
        }
        i = i + 1
    }
    String_new()
}

fn elem_name_looks_like_enum(ctx: SelfEmitCtx, struct_name: String) -> bool {
    let bare = if struct_name.clone().starts_with("enum:") {
        struct_name.clone().slice(5, struct_name.len())
    } else {
        struct_name.clone()
    }
    let ev_names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let ev_count = ev_names.len()
    let mut ei = 0
    let prefix = bare.clone().concat("::")
    while ei < ev_count {
        let nm = get_unchecked(ev_names, ei).clone()
        if nm.clone().starts_with(prefix.clone()) {
            return true
        }
        ei = ei + 1
    }
    false
}

// Prefer Option::Some with the requested payload suffix (_f1_i32 / _f1_i64 /
// _f1_ref0 / _f1_gcsrefN / ...) over the first name-only match (#726).
fn find_option_some_variant_type(ctx: SelfEmitCtx, field_suffix: String, enum_type: i32) -> i32 {
    let names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    let type_map = module_gc_enum::MirModule_gc_enum_variant_canon_idxs(ctx.mir)
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let count = names.len()
    let mut fallback = 0 - 1
    let mut i = 0
    while i < count {
        let name = get_unchecked(names, i).clone()
        if name.clone().eq("Option::Some") || name.clone().eq("Some") {
            if i < type_map.len() {
                let variant_type = get_unchecked(type_map, i)
                if variant_type != open_type {
                    if i < sigs.len() && get_unchecked(sigs, i).clone().ends_with(field_suffix.clone()) {
                        return variant_type
                    }
                    if fallback < 0 {
                        fallback = variant_type
                    }
                }
            }
        }
        i = i + 1
    }
    if fallback >= 0 {
        return fallback
    }
    let named = ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, "Option::Some")
    if named >= 0 {
        return named
    }
    enum_type
}
use mir::module_gc_enum
