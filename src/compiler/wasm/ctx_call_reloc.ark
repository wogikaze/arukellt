use corehir::function_id
use corehir::signature_entry
use corehir::signature_registry
use wasm::ctx_record
use wasm::ctx_reloc
use wasm::function_indices
use wasm::inst_ctx
use wasm::writer_core

fn SelfEmitCtx_push_call_reloc(mut ctx: SelfEmitCtx, off: i32, fid_raw: i32) {
    push(ctx.call_reloc_offs, off)
    push(ctx.call_reloc_fids, fid_raw)
    push(ctx.call_reloc_funcs, ctx_record::SelfEmitCtx_current_func_idx(ctx))
    push(ctx.call_reloc_names, String_new())
}

// #851 Phase 3 fused emit: a resolved call whose callee has no FunctionId
// is patched by name. In-loop emit still sees pre-prune function indices,
// so the target name defers into the reloc stream and resolves at apply
// time on the post-prune index — identical result to the legacy immediate
// patch.
fn SelfEmitCtx_push_call_reloc_name(mut ctx: SelfEmitCtx, off: i32, name: String) {
    push(ctx.call_reloc_offs, off)
    push(ctx.call_reloc_fids, 0 - 1)
    push(ctx.call_reloc_funcs, ctx_record::SelfEmitCtx_current_func_idx(ctx))
    push(ctx.call_reloc_names, name)
}

fn SelfEmitCtx_apply_call_relocs(
    mut ctx: SelfEmitCtx,
    wit_import_count: i32
) {
    let n = ctx.call_reloc_offs.len()
    let registry = ctx_record::SelfEmitCtx_signature_registry(ctx)
    let mut i = 0
    while i < n {
        let off = ctx.call_reloc_offs.get_unchecked(i)
        let fid_raw = ctx.call_reloc_fids.get_unchecked(i)
        let func_idx = ctx.call_reloc_funcs.get_unchecked(i)
        let mut name = ctx.call_reloc_names.get_unchecked(i)
        if fid_raw >= 0 {
            let signature = signature_registry::signature_registry_lookup_by_id(
                registry,
                function_id::FunctionId_new(fid_raw)
            )
            name = signature_entry::signature_entry_base_name(signature)
        }
        let fn_idx = inst_ctx::resolve_fn_index_for_call(ctx, name, fid_raw)
        if fn_idx >= 0 {
            let mut body = ctx.body_bytes.get_unchecked(func_idx)
            ctx_reloc::reloc_patch_leb_u_fixed(
                body,
                off,
                function_indices::defined_function_index(
                    fn_idx,
                    ctx_record::SelfEmitCtx_target(ctx),
                    ctx_record::SelfEmitCtx_wasi_version(ctx),
                    wit_import_count
                )
            )
        }
        i = i + 1
    }
    ctx.call_reloc_offs = Vec::new<i32>()
    ctx.call_reloc_fids = Vec::new<i32>()
    ctx.call_reloc_funcs = Vec::new<i32>()
    ctx.call_reloc_names = Vec::new<String>()
}
