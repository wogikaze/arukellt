use std::text
fn gc_struct_ref_array_offset() -> i32 {
    24
}

fn gc_vec_struct_ref_offset() -> i32 {
    25
}

fn gc_vec_struct_ref_type_sig() -> String {
    "gcref25"
}

fn gc_fnref_array_offset() -> i32 {
    27
}

fn gc_vec_fnref_offset() -> i32 {
    28
}

fn gc_vec_fnref_type_sig() -> String {
    "gcref28"
}

fn gc_enum_ref_array_offset() -> i32 {
    29
}

fn gc_vec_enum_ref_offset() -> i32 {
    30
}

fn gc_vec_enum_ref_type_sig() -> String {
    "gcref30"
}

fn gc_vec_elem_name_is_fnref(elem: String) -> bool {
    elem.clone().eq("fnref") ||
    elem.clone().eq("fn") ||
    elem.clone().starts_with("fn(")
}

fn gc_vec_elem_name_is_struct_ref(elem: String) -> bool {
    if elem.len() == 0 {
        return false
    }
    if elem.clone().eq("i32") ||
    elem.clone().eq("I32") ||
    elem.clone().eq("bool") ||
    elem.clone().eq("char") ||
    elem.clone().eq("u8") ||
    elem.clone().eq("i8") ||
    elem.clone().eq("u16") ||
    elem.clone().eq("u32") ||
    elem.clone().eq("u64") ||
    elem.clone().eq("i16") {
        return false
    }
    if elem.clone().eq("i64") ||
    elem.clone().eq("I64") ||
    elem.clone().eq("f64") ||
    elem.clone().eq("F64") ||
    elem.clone().eq("f32") ||
    elem.clone().eq("F32") {
        return false
    }
    if elem.clone().eq("String") || elem.clone().eq("string") || elem.clone().eq("str") {
        return false
    }
    if elem.clone().eq("v128") || elem.clone().eq("V128") {
        return false
    }
    // Funcref elems use a dedicated (array (mut (ref null $sig))) layout (#832).
    if elem.clone().eq("fnref") ||
    elem.clone().eq("fn") ||
    elem.clone().starts_with("fn(") {
        return false
    }
    // Option/Result/enum payloads are GC enum refs (or scalar-backed), not
    // structref array elements. Treating them as structref breaks Vec::new<i32>()
    // locals annotated as Vec<Option<T>> (nested_option / no_nested_generics).
    if gc_vec_elem_name_is_enum_like(elem.clone()) {
        return false
    }
    // Unsubstituted type parameters (generic shells like min_by / max_by
    // that were not monomorphized) must not select the structref array
    // layout — that mismatches the i32-vec signature used for dead shells.
    if gc_vec_elem_name_is_type_param(elem.clone()) {
        return false
    }
    true
}

fn gc_vec_elem_name_is_enum_like(elem: String) -> bool {
    // `mono_safe_name` encodes Option<T> as `?_T_` because the type tag for
    // Option is currently `?`.  Normalize-aware callers usually decode this
    // first, but keep the raw spelling classified correctly at this boundary.
    if elem.clone().starts_with("?_") {
        return true
    }
    if elem.clone().eq("Option") || elem.clone().eq("Result") {
        return true
    }
    if elem.clone().starts_with("Option") ||
    elem.clone().starts_with("option:") ||
    elem.clone().starts_with("Option:") ||
    elem.clone().starts_with("Option_") ||
    elem.clone().starts_with("Option<") {
        return true
    }
    if elem.clone().starts_with("Result") ||
    elem.clone().starts_with("result:") ||
    elem.clone().starts_with("Result:") ||
    elem.clone().starts_with("Result_") ||
    elem.clone().starts_with("Result<") {
        return true
    }
    if elem.clone().starts_with("enum:") {
        return true
    }
    false
}

// Decode the small amount of punctuation that mono_safe_name leaves in
// generic Vec element names.  The wasm layout code needs semantic names such
// as `String` and `Option_i32`, while call names may still contain
// `Vec_String_` or `?_i32_`.
fn gc_normalize_vec_element_name(elem: String) -> String {
    let mut normalized = elem.clone()
    while normalized.len() > 0 && normalized.byte_at(normalized.len() - 1) == 95 {
        normalized = normalized.slice(0, normalized.len() - 1)
    }
    if normalized.clone().starts_with("?_") {
        return "Option_".concat(normalized.slice(2, normalized.len()))
    }
    normalized
}

fn gc_normalize_vec_type_name(type_name: String) -> String {
    if type_name.clone().starts_with("vec:") {
        let elem = type_name.clone().slice(4, type_name.len())
        return "vec:".concat(gc_normalize_vec_element_name(elem))
    }
    if type_name.clone().starts_with("Vec<") && type_name.clone().ends_with(">") {
        let elem = type_name.clone().slice(4, type_name.len() - 1)
        return "vec:".concat(gc_normalize_vec_element_name(elem))
    }
    if type_name.clone().starts_with("Vec_") {
        let elem = type_name.clone().slice(4, type_name.len())
        return "vec:".concat(gc_normalize_vec_element_name(elem))
    }
    if type_name.clone().eq("Vec") {
        return "vec:i32"
    }
    type_name
}

fn gc_vec_elem_name_is_type_param(elem: String) -> bool {
    // Single-letter type vars: T, U, K, E, R, A, B, V, ...
    if elem.len() == 1 {
        let c = elem.byte_at(0)
        if c >= 65 && c <= 90 {
            return true
        }
    }
    // Ordinal mono placeholders: t0, t1, ?t0, T0, ...
    if elem.clone().starts_with("?") {
        return gc_vec_elem_name_is_type_param(elem.slice(1, elem.len()))
    }
    if elem.len() >= 2 {
        let c0 = elem.byte_at(0)
        if (c0 == 116 || c0 == 84) {
            let mut i = 1
            let mut all_digit = true
            while i < elem.len() {
                let c = elem.byte_at(i)
                if c < 48 || c > 57 {
                    all_digit = false
                }
                i = i + 1
            }
            if all_digit {
                return true
            }
        }
    }
    false
}
