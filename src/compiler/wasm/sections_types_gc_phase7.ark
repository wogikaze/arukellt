fn gc_struct_ref_array_offset() -> i32 {
    24
}

fn gc_vec_struct_ref_offset() -> i32 {
    25
}

fn gc_vec_struct_ref_type_sig() -> String {
    "gcref25"
}

fn gc_fnref_array_offset() -> i32 {
    26
}

fn gc_vec_fnref_offset() -> i32 {
    27
}

fn gc_vec_fnref_type_sig() -> String {
    "gcref27"
}

fn gc_enum_ref_array_offset() -> i32 {
    28
}

fn gc_vec_enum_ref_offset() -> i32 {
    29
}

fn gc_vec_enum_ref_type_sig() -> String {
    "gcref29"
}

fn gc_vec_elem_name_is_fnref(elem: String) -> bool {
    eq(clone(elem), "fnref") ||
    eq(clone(elem), "fn") ||
    starts_with(clone(elem), "fn(")
}

fn gc_vec_elem_name_is_struct_ref(elem: String) -> bool {
    if len(elem) == 0 {
        return false
    }
    if eq(clone(elem), "i32") ||
    eq(clone(elem), "I32") ||
    eq(clone(elem), "bool") ||
    eq(clone(elem), "char") ||
    eq(clone(elem), "u8") ||
    eq(clone(elem), "u16") ||
    eq(clone(elem), "u32") ||
    eq(clone(elem), "u64") ||
    eq(clone(elem), "i16") {
        return false
    }
    if eq(clone(elem), "i64") ||
    eq(clone(elem), "I64") ||
    eq(clone(elem), "f64") ||
    eq(clone(elem), "F64") ||
    eq(clone(elem), "f32") ||
    eq(clone(elem), "F32") {
        return false
    }
    if eq(clone(elem), "String") || eq(clone(elem), "string") || eq(clone(elem), "str") {
        return false
    }
    if eq(clone(elem), "v128") || eq(clone(elem), "V128") {
        return false
    }
    // Funcref elems use a dedicated (array (mut (ref null $sig))) layout (#832).
    if eq(clone(elem), "fnref") ||
    eq(clone(elem), "fn") ||
    starts_with(clone(elem), "fn(") {
        return false
    }
    // Option/Result/enum payloads are GC enum refs (or scalar-backed), not
    // structref array elements. Treating them as structref breaks Vec::new<i32>()
    // locals annotated as Vec<Option<T>> (nested_option / no_nested_generics).
    if gc_vec_elem_name_is_enum_like(clone(elem)) {
        return false
    }
    // Unsubstituted type parameters (generic shells like min_by / max_by
    // that were not monomorphized) must not select the structref array
    // layout — that mismatches the i32-vec signature used for dead shells.
    if gc_vec_elem_name_is_type_param(clone(elem)) {
        return false
    }
    true
}

fn gc_vec_elem_name_is_enum_like(elem: String) -> bool {
    // `mono_safe_name` encodes Option<T> as `?_T_` because the type tag for
    // Option is currently `?`.  Normalize-aware callers usually decode this
    // first, but keep the raw spelling classified correctly at this boundary.
    if starts_with(clone(elem), "?_") {
        return true
    }
    if eq(clone(elem), "Option") || eq(clone(elem), "Result") {
        return true
    }
    if starts_with(clone(elem), "Option") ||
    starts_with(clone(elem), "option:") ||
    starts_with(clone(elem), "Option:") ||
    starts_with(clone(elem), "Option_") ||
    starts_with(clone(elem), "Option<") {
        return true
    }
    if starts_with(clone(elem), "Result") ||
    starts_with(clone(elem), "result:") ||
    starts_with(clone(elem), "Result:") ||
    starts_with(clone(elem), "Result_") ||
    starts_with(clone(elem), "Result<") {
        return true
    }
    if starts_with(clone(elem), "enum:") {
        return true
    }
    false
}

// Decode the small amount of punctuation that mono_safe_name leaves in
// generic Vec element names.  The wasm layout code needs semantic names such
// as `String` and `Option_i32`, while call names may still contain
// `Vec_String_` or `?_i32_`.
fn gc_normalize_vec_element_name(elem: String) -> String {
    let mut normalized = clone(elem)
    while len(normalized) > 0 && char_at(normalized, len(normalized) - 1) == 95 {
        normalized = substring(normalized, 0, len(normalized) - 1)
    }
    if starts_with(clone(normalized), "?_") {
        return concat("Option_", substring(normalized, 2, len(normalized)))
    }
    normalized
}

fn gc_normalize_vec_type_name(type_name: String) -> String {
    if starts_with(clone(type_name), "vec:") {
        let elem = substring(clone(type_name), 4, len(type_name))
        return concat("vec:", gc_normalize_vec_element_name(elem))
    }
    if starts_with(clone(type_name), "Vec<") && ends_with(clone(type_name), ">") {
        let elem = substring(clone(type_name), 4, len(type_name) - 1)
        return concat("vec:", gc_normalize_vec_element_name(elem))
    }
    if starts_with(clone(type_name), "Vec_") {
        let elem = substring(clone(type_name), 4, len(type_name))
        return concat("vec:", gc_normalize_vec_element_name(elem))
    }
    if eq(clone(type_name), "Vec") {
        return "vec:i32"
    }
    type_name
}

fn gc_vec_elem_name_is_type_param(elem: String) -> bool {
    // Single-letter type vars: T, U, K, E, R, A, B, V, ...
    if len(elem) == 1 {
        let c = char_at(elem, 0)
        if c >= 65 && c <= 90 {
            return true
        }
    }
    // Ordinal mono placeholders: t0, t1, ?t0, T0, ...
    if starts_with(clone(elem), "?") {
        return gc_vec_elem_name_is_type_param(substring(elem, 1, len(elem)))
    }
    if len(elem) >= 2 {
        let c0 = char_at(elem, 0)
        if (c0 == 116 || c0 == 84) {
            let mut i = 1
            let mut all_digit = true
            while i < len(elem) {
                let c = char_at(elem, i)
                if c < 48 || c > 57 {
                    all_digit = false
                }
                i = i + 1
            }
            if all_digit {
                return true
            }
        }
    }
    false
}
