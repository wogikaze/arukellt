use wasm::constants
use wasm::ctx_gc_type
use wasm::ctx_record
use wasm::ctx_scratch
use wasm::runtime_abi_http_result
use wasm::runtime_abi_sockets_vec
use wasm::intrinsics::helpers_control
use wasm::intrinsics::helpers_core
use wasm::intrinsics::helpers_io_const
use wasm::intrinsics::helpers_io_layout
use wasm::intrinsics::helpers_memory
use wasm::intrinsics::helpers_numeric_i32
use wasm::opcodes
use wasm::writer_core
use wasm::writer_gc

fn emit_sockets_finalize_i32_result(w: WasmWriter) {
    runtime_abi_http_result::emit_http_store_abs_len(w, constants::SCRATCH_SOCK_RET(), constants::SCRATCH_SOCK_ABSLEN())
    emit_sockets_write_err_len_prefix(w)
    emit_sockets_bump_heap_for_err(w)
    emit_sockets_build_result_enum(w)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_ENUMPTR())
    helpers_memory::emit_i32_load_default(w)
}

fn emit_sockets_write_err_len_prefix(w: WasmWriter) {
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_RET())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    runtime_abi_http_result::emit_http_write_len_prefix(w, constants::SCRATCH_SOCK_RESPPTR(), constants::SCRATCH_SOCK_ABSLEN())
    helpers_control::emit_end(w)
}

fn emit_sockets_bump_heap_for_err(w: WasmWriter) {
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_RET())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    runtime_abi_http_result::emit_http_bump_heap_by_abs_len(w, constants::SCRATCH_SOCK_ABSLEN())
    helpers_control::emit_end(w)
}

fn emit_sockets_build_result_enum(w: WasmWriter) {
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_ENUMPTR())
    helpers_core::emit_heap_get(w)
    helpers_memory::emit_i32_store_default(w)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_ENUMPTR())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_RET())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    writer_core::emit_byte(w, opcodes::OP_SELECT())
    helpers_memory::emit_i32_store_default(w)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_ENUMPTR())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_RET())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_i32(w)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_RESPPTR())
    helpers_memory::emit_i32_load_default(w)
    helpers_control::emit_else(w)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_RET())
    helpers_memory::emit_i32_load_default(w)
    helpers_control::emit_end(w)
    helpers_memory::emit_i32_store_default(w)
    helpers_core::emit_heap_get(w)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_heap_set(w)
}

fn emit_sockets_finalize_read_result(w: WasmWriter, ctx: SelfEmitCtx) {
    runtime_abi_http_result::emit_http_store_abs_len(w, constants::SCRATCH_SOCK_RET(), constants::SCRATCH_SOCK_ABSLEN())
    emit_sockets_write_err_len_prefix(w)
    emit_sockets_bump_heap_for_err(w)
    emit_sockets_finalize_read_branch(w, ctx)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_ENUMPTR())
    helpers_memory::emit_i32_load_default(w)
}

fn emit_sockets_finalize_read_branch(w: WasmWriter, ctx: SelfEmitCtx) {
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_RET())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    emit_sockets_build_read_err_enum(w)
    helpers_control::emit_else(w)
    runtime_abi_sockets_vec::emit_sockets_build_read_vec(w, ctx)
    runtime_abi_sockets_vec::emit_sockets_build_vec_ok_enum(w, ctx)
    helpers_control::emit_end(w)
}

fn emit_sockets_build_read_err_enum(w: WasmWriter) {
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_ENUMPTR())
    helpers_core::emit_heap_get(w)
    helpers_memory::emit_i32_store_default(w)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_ENUMPTR())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_memory::emit_i32_store_default(w)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_ENUMPTR())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_io_layout::emit_scratch_addr(w, constants::SCRATCH_SOCK_RESPPTR())
    helpers_memory::emit_i32_load_default(w)
    helpers_memory::emit_i32_store_default(w)
    helpers_core::emit_heap_get(w)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_heap_set(w)
}

fn find_result_variant_type_by_suffix(ctx: SelfEmitCtx, variant_name: String, suffix: String) -> i32 {
    let names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    let type_map = ctx_record::SelfEmitCtx_gc_enum_variant_type_map(ctx)
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let count = len(names)
    let mut fallback = 0 - 1
    let mut i = 0
    while i < count {
        if eq(clone(get_unchecked(names, i)), clone(variant_name)) {
            if i < len(type_map) {
                let variant_type = get_unchecked(type_map, i)
                if variant_type != open_type {
                    if i < len(sigs) && ends_with(clone(get_unchecked(sigs, i)), clone(suffix)) {
                        return variant_type
                    }
                    if fallback < 0 {
                        fallback = variant_type
                    }
                }
            }
        }
        i = i + 1
    }
    if fallback >= 0 {
        return fallback
    }
    ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(variant_name))
}

fn emit_sockets_gc_result_i32_ok(w: WasmWriter, ctx: SelfEmitCtx, ret_slot: i32) {
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let ok_type = find_result_variant_type_by_suffix(ctx, "Result::Ok", "_f1_i32")
    let type_idx = if ok_type >= 0 { ok_type } else { open_type }
    helpers_io_const::emit_i32_const(w, 0)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    writer_gc::emit_gc_struct_new(w, type_idx)
    writer_gc::emit_gc_ref_cast(w, open_type)
}

fn emit_sockets_gc_result_vec_ok(w: WasmWriter, ctx: SelfEmitCtx, s_vec: i32) {
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let vec_type = ctx_gc_type::SelfEmitCtx_vec_type(ctx)
    let ok_type = find_result_variant_type_by_suffix(ctx, "Result::Ok", "_f1_ref10")
    let type_idx = if ok_type >= 0 { ok_type } else { open_type }
    helpers_io_const::emit_i32_const(w, 0)
    // scratch_gc_vec_local is typed structref; cast to Vec before Result::Ok.
    helpers_core::emit_local_get(w, s_vec)
    writer_gc::emit_gc_ref_cast(w, vec_type)
    writer_gc::emit_gc_struct_new(w, type_idx)
    writer_gc::emit_gc_ref_cast(w, open_type)
}

// Result<i32, String> from host ret (>=0 Ok(i32) / <0 Err(String from resp)).
fn emit_sockets_finalize_i32_result_gc(w: WasmWriter, ctx: SelfEmitCtx) {
    let s_str = ctx_scratch::SelfEmitCtx_scratch_gc_local(ctx, 0)
    let s_result = ctx_scratch::SelfEmitCtx_scratch_gc_enum_local(ctx, 0)
    let s_i = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    let s_len = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    let string_type = ctx_record::SelfEmitCtx_gc_type_base(ctx)
    let ret_slot = constants::SCRATCH_SOCK_RET()
    let resp_slot = constants::SCRATCH_SOCK_RESPPTR()
    let abs_slot = constants::SCRATCH_SOCK_ABSLEN()
    runtime_abi_http_result::emit_http_store_abs_len(w, ret_slot, abs_slot)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    runtime_abi_http_result::emit_http_bump_heap_by_abs_len(w, abs_slot)
    runtime_abi_http_result::emit_http_gc_string_from_linear(w, s_str, s_i, s_len, resp_slot, abs_slot, string_type)
    runtime_abi_http_result::emit_http_gc_result_string_variant(w, ctx, s_str, 1)
    helpers_core::emit_local_set(w, s_result)
    helpers_control::emit_else(w)
    emit_sockets_gc_result_i32_ok(w, ctx, ret_slot)
    helpers_core::emit_local_set(w, s_result)
    helpers_control::emit_end(w)
    helpers_core::emit_local_get(w, s_result)
}

// Result<Vec<i32>, String> from host ret (>=0 Ok(bytes→Vec) / <0 Err(String)).
fn emit_sockets_finalize_read_result_gc(w: WasmWriter, ctx: SelfEmitCtx) {
    let s_str = ctx_scratch::SelfEmitCtx_scratch_gc_local(ctx, 0)
    let s_vec = ctx_scratch::SelfEmitCtx_scratch_gc_vec_local(ctx, 0)
    let s_result = ctx_scratch::SelfEmitCtx_scratch_gc_enum_local(ctx, 0)
    let s_i = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    let s_len = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    let string_type = ctx_record::SelfEmitCtx_gc_type_base(ctx)
    let ret_slot = constants::SCRATCH_SOCK_RET()
    let resp_slot = constants::SCRATCH_SOCK_RESPPTR()
    let abs_slot = constants::SCRATCH_SOCK_ABSLEN()
    runtime_abi_http_result::emit_http_store_abs_len(w, ret_slot, abs_slot)
    runtime_abi_http_result::emit_http_bump_heap_by_abs_len(w, abs_slot)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    runtime_abi_http_result::emit_http_gc_string_from_linear(w, s_str, s_i, s_len, resp_slot, abs_slot, string_type)
    runtime_abi_http_result::emit_http_gc_result_string_variant(w, ctx, s_str, 1)
    helpers_core::emit_local_set(w, s_result)
    helpers_control::emit_else(w)
    runtime_abi_sockets_vec::emit_sockets_build_read_vec_gc(w, ctx, s_vec, s_i, s_len)
    emit_sockets_gc_result_vec_ok(w, ctx, s_vec)
    helpers_core::emit_local_set(w, s_result)
    helpers_control::emit_end(w)
    helpers_core::emit_local_get(w, s_result)
}
