use wasm::ctx_gc_type
use wasm::ctx_record

// Prefer `_f1_ref0` (String payload) over name-only first match (`_f1_i32`).
fn find_result_string_variant_type(ctx: SelfEmitCtx, variant_name: String) -> i32 {
    let names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    let type_map = module_gc_enum::MirModule_gc_enum_variant_canon_idxs(ctx.mir)
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let count = len(names)
    let mut fallback = 0 - 1
    let mut i = 0
    while i < count {
        if get_unchecked(names, i).clone().eq(variant_name.clone()) {
            if i < len(type_map) {
                let variant_type = get_unchecked(type_map, i)
                if variant_type != open_type {
                    if i < len(sigs) && get_unchecked(sigs, i).clone().ends_with("_f1_ref0") {
                        return variant_type
                    }
                    if fallback < 0 {
                        fallback = variant_type
                    }
                }
            }
        }
        i = i + 1
    }
    if fallback >= 0 {
        return fallback
    }
    ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, variant_name.clone())
}

fn find_result_variant_type_by_suffix(ctx: SelfEmitCtx, variant_name: String, suffix: String) -> i32 {
    let names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    let type_map = module_gc_enum::MirModule_gc_enum_variant_canon_idxs(ctx.mir)
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let count = len(names)
    let mut fallback = 0 - 1
    let mut i = 0
    while i < count {
        if get_unchecked(names, i).clone().eq(variant_name.clone()) {
            if i < len(type_map) {
                let variant_type = get_unchecked(type_map, i)
                if variant_type != open_type {
                    if i < len(sigs) && get_unchecked(sigs, i).clone().ends_with(suffix.clone()) {
                        return variant_type
                    }
                    if fallback < 0 {
                        fallback = variant_type
                    }
                }
            }
        }
        i = i + 1
    }
    if fallback >= 0 {
        return fallback
    }
    ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, variant_name.clone())
}
use mir::module_gc_enum
