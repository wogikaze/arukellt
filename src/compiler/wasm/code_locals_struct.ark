use std::text
use wasm::constants
use wasm::ctx_record
use wasm::code_ref_locals
use wasm::code_ref_locals_fn_cache
use wasm::code_ref_locals_scan
use wasm::code_ref_locals_infer_dest
use wasm::ctx_gc_type
use wasm::ctx_gc_layout_lookup
use wasm::sections_types_gc
use mir::block_inst_access
use mir::function_locals_view
use mir::inst_accessors_shape
use mir::inst_accessors_literals
use mir::local_access
use mir::opcodes
use mir::value_types
use wasm::writer_core
fn emit_gc_enum_open_local(mut body: WasmWriter, ctx: SelfEmitCtx) {
    writer_core::emit_byte(body, constants::WASM_REF_NULL())
    writer_core::emit_leb128_s(body, ctx_record::SelfEmitCtx_gc_type_base(ctx) + sections_types_gc::gc_enum_open_type_offset())
}
// Enum/option/result/return-temp open-enum local typing.
fn emit_gc_local_enum_like(mut body: WasmWriter, f: MirFunction, local_idx: i32, type_name: String, variant_slot: i32, ctx: SelfEmitCtx) -> bool {
    if code_ref_locals_scan::local_feeds_return(f, local_idx, ctx) && code_ref_locals::mir_function_returns_enum_open(f) {
        emit_gc_enum_open_local(body, ctx)
        return true
    }
    // Only the GC_STRUCT_NEW destination is the variant object. Payload field
    // locals may still carry a stray variant_slot / enum: type_name from
    // lowering; typing them as the variant makes struct.set field stores fail
    // (expected string/ref, found variant).
    let is_variant_constructor_dest = code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx)
    if variant_slot >= 0 &&
    is_variant_constructor_dest &&
    !local_has_container_type_name(type_name.clone()) {
        let variant_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_variant_slot(ctx, variant_slot)
        if variant_gc >= 0 {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, variant_gc)
            return true
        }
    }
    if type_name.clone().starts_with("enum:") ||
    type_name.clone().starts_with("option:") ||
    type_name.clone().starts_with("Option_") ||
    type_name.clone().starts_with("Option:") ||
    type_name.clone().starts_with("Option<") ||
    type_name.clone().starts_with("result:") ||
    type_name.clone().starts_with("Result_") ||
    type_name.clone().starts_with("Result:") ||
    type_name.clone().starts_with("Result<") {
        emit_gc_enum_open_local(body, ctx)
        return true
    }
    // 'Head<Args>' enum instantiations (e.g. Box<WitType>): the head names a
    // registered enum so the local is the open-enum ref, not the VT_GC_REF
    // fallback's i8-array default (#860).
    if local_type_name_is_enum_instance(type_name.clone(), ctx) {
        emit_gc_enum_open_local(body, ctx)
        return true
    }
    if code_ref_locals_infer_dest::local_has_multiple_enum_variant_types(f, local_idx, ctx) {
        emit_gc_enum_open_local(body, ctx)
        return true
    }
    false
}

// True for 'Head<Args>' local type names whose head registers enum variants
// (e.g. Box<WitType> has the Box::Owned variant in this module).
fn local_type_name_is_enum_instance(type_name: String, ctx: SelfEmitCtx) -> bool {
    let n = type_name.len()
    let mut head_end = 0 - 1
    let mut i = 0
    while i < n {
        if type_name.byte_at(i) == 60 {
            head_end = i
            i = n
        }
        i = i + 1
    }
    if head_end <= 0 {
        return false
    }
    let head = type_name.slice(0, head_end)
    let names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let mut vi = 0
    while vi < names.len() {
        let variant = names.get_unchecked(vi)
        if variant.clone().starts_with(head.clone().concat(String_from("::"))) ||
        variant.clone().contains(String_from("::").concat(head.clone().concat(String_from("::")))) {
            return true
        }
        vi = vi + 1
    }
    false
}
fn enum_payload_type_name(type_name: String) -> bool {
    if type_name.len() <= 5 {
        return false
    }
    if !type_name.clone().starts_with("enum:") {
        return false
    }
    if type_name.clone().eq("enum:open") {
        return false
    }
    true
}
fn local_has_result_option_enum_type_name(type_name: String) -> bool {
    type_name.clone().eq("Option") ||
    type_name.clone().eq("Result") ||
    type_name.clone().starts_with(String_from("enum:")) ||
    type_name.clone().starts_with(String_from("option:")) ||
    type_name.clone().starts_with(String_from("Option_")) ||
    type_name.clone().starts_with(String_from("Option:")) ||
    type_name.clone().starts_with(String_from("Option<")) ||
    type_name.clone().starts_with(String_from("result:")) ||
    type_name.clone().starts_with(String_from("Result_")) ||
    type_name.clone().starts_with(String_from("Result:")) ||
    type_name.clone().starts_with(String_from("Result<"))
}

fn local_has_container_type_name(type_name: String) -> bool {
    if type_name.len() == 0 {
        return false
    }
    if type_name.clone().starts_with("vec:") || type_name.clone().starts_with("hashmap:") || type_name.clone().starts_with("struct:") {
        return true
    }
    if type_name.clone().eq("string") || type_name.clone().eq("String") {
        return true
    }
    false
}
// GC-target local val type for hashmap/string/inferred types.
fn emit_gc_local_named_type(mut body: WasmWriter, type_name: String, vt: i32, f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> bool {
    if type_name.clone().starts_with("hashmap:") {
        if vt == value_types::VT_I32() && !code_ref_locals::local_has_any_ref_assignment(f, local_idx, ctx) {
            // Local is reused for i32 — skip ref type, try inference fallback.
        } else {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            if type_name.clone().starts_with("hashmap:i32str") {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_hashmap_i32_str_type(ctx))
            } else if type_name.clone().starts_with("hashmap:i32fn") {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_hashmap_i32_fn_type(ctx))
            } else if type_name.clone().starts_with("hashmap:strfn") {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_hashmap_str_fn_type(ctx))
            } else if type_name.clone().starts_with("hashmap:strstr") {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_hashmap_str_str_type(ctx))
            } else if type_name.clone().starts_with("hashmap:i32i32") {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
            } else {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_hashmap_str_i32_type(ctx))
            }
            return true
        }
    }
    if type_name.clone().eq("string") || type_name.clone().eq("String") {
        if vt == value_types::VT_I32() && !code_ref_locals::local_has_any_ref_assignment(f, local_idx, ctx) {
            // Local is reused for i32 — skip ref type, try inference fallback.
        } else {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_string_type(ctx))
            return true
        }
    }
    // Every Option spelling was already declared by emit_gc_local_enum_like
    // (called unconditionally before this rung); keeping a second enum-open
    // spelling here would let the two rungs drift.
    emit_gc_local_struct_type(body, type_name, vt, f, local_idx, ctx)
}
// GC-target local val type for struct:/raw struct names, with inference fallback.
fn emit_gc_local_struct_type(mut body: WasmWriter, type_name: String, vt: i32, f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> bool {
    if type_name.clone().eq("HashMap") ||
    type_name.clone().eq("HashSet") ||
    type_name.clone().starts_with("struct:HashMap:") ||
    type_name.clone().starts_with("struct:HashSet:") {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
        return true
    }
    if type_name.clone().starts_with("struct:") {
        let struct_name = extract_struct_name_from_type_name(type_name.clone())
        if struct_name.len() > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, struct_name.clone()) {
            let named_gc = ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, struct_name.clone())
            // Declared type_name / value_type is authoritative (#843). Stale
            // reuse must be fixed in post_pass, not by emit-time infer (#808).
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, named_gc)
            return true
        }
        // Fallback for structs without ref fields: extract byte_size and map to GC struct type index.
        let byte_size = extract_struct_byte_size(type_name.clone())
        if byte_size > 0 {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_struct_type(ctx, byte_size))
            return true
        }
    }
    // Check raw struct name (without "struct:" prefix) as gc_struct.
    if type_name.len() > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, type_name.clone()) {
        let struct_gc = ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, type_name.clone())
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, struct_gc)
        return true
    }
    // Raw-name layout-table reconstruction is forbidden. Typed local TypeId
    // lookup below is authoritative; the remaining name handling is limited to
    // fixed compatibility classes and struct byte-size diagnostics.
    if type_name.len() > 0 {
        let byte_size = lookup_struct_byte_size(f, type_name.clone(), ctx)
        if byte_size > 0 {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_struct_type(ctx, byte_size))
            return true
        }
    }
    emit_gc_local_inferred_type(body, f, local_idx, vt, ctx)
}
// Byte size of the first MIR_STRUCT_NEW for `struct_name` in the body. Inside
// the per-function cache window this is a table lookup; the body scan remains
// for callers outside it.
fn lookup_struct_byte_size(f: MirFunction, struct_name: String, ctx: SelfEmitCtx) -> i32 {
    if code_ref_locals_scan::is_function_local_gc_cache_active(ctx) {
        return code_ref_locals_fn_cache::cached_struct_new_byte_size(ctx, struct_name)
    }
    let block_count = f.blocks.len()
    let mut bi = 0
    while bi < block_count {
        let block = f.blocks.get_unchecked(bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_STRUCT_NEW() {
                let name = inst_accessors_literals::MirInst_str_val(inst)
                if name.clone().eq(struct_name.clone()) {
                    return inst_accessors_literals::MirInst_int_val(inst)
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    0
}
// Extract struct name from "struct:TypeName:byte_size" format.
fn extract_struct_name_from_type_name(type_name: String) -> String {
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let n = type_name.len()
    let mut i = 0
    while i < n {
        if type_name.byte_at(i) == ':' {
            if first_colon < 0 {
                first_colon = i
            }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon < 0 || first_colon == last_colon {
        return String_new()
    }
    type_name.slice(first_colon + 1, last_colon)
}
// Extract byte_size from "struct:TypeName:byte_size" format.
fn extract_struct_byte_size(type_name: String) -> i32 {
    let n = type_name.len()
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if type_name.byte_at(i) == ':' {
            last_colon = i
        }
        i = i + 1
    }
    if last_colon < 0 {
        return 0
    }
    let mut byte_size = 0
    let mut j = last_colon + 1
    while j < n {
        let d = type_name.byte_at(j)
        if d >= 48 && d <= 57 {
            byte_size = byte_size * 10 + (d - 48)
        } else {
            j = n
        }
        j = j + 1
    }
    byte_size
}
// Spine-only local GC type (#843). Body-scan infer removed.
fn emit_gc_local_inferred_type(mut body: WasmWriter, f: MirFunction, local_idx: i32, vt: i32, ctx: SelfEmitCtx) -> bool {
    // A stale GC spine entry must not turn a scalar temporary into a ref local.
    // This is common for a direct f64 constant such as `signal::pi`: the MIR
    // producer is scalar even though an earlier type pass left a reference
    // layout attached to the reused local. A real reference producer wins.
    if code_ref_locals::local_has_scalar_producer(f, local_idx, ctx) &&
    !code_ref_locals::local_has_strong_ref_producer(f, local_idx, ctx) {
        return false
    }
    let spine_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
    if spine_gc >= 0 {
        let loc = function_locals_view::MirFunction_local_at(f, local_idx)
        let type_name = local_access::MirLocal_type_name(loc)
        if code_ref_locals_infer_dest::is_scalar_get_unchecked_result(type_name.clone(), vt) &&
        !code_ref_locals::local_has_any_ref_assignment(f, local_idx, ctx) {
            return false
        }
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, spine_gc)
        return true
    }
    if vt == value_types::VT_REF() || vt == value_types::VT_GC_REF() {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_record::SelfEmitCtx_gc_type_base(ctx))
        return true
    }
    false
}
