use wasm::constants
use wasm::ctx_record
use wasm::code_ref_locals
use wasm::code_ref_locals_infer_dest
use wasm::ctx_gc_type
use wasm::ctx_gc_layout_lookup
use mir::block_inst_access
use mir::function_locals_view
use mir::inst_accessors_shape
use mir::inst_accessors_literals
use mir::local_access
use mir::opcodes
use mir::value_types
use wasm::writer_core
fn emit_gc_enum_open_local(body: WasmWriter, ctx: SelfEmitCtx) {
    writer_core::emit_byte(body, constants::WASM_REF_NULL())
    writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
}
fn emit_gc_local_enum_like(body: WasmWriter, f: MirFunction, local_idx: i32, type_name: String, variant_slot: i32, ctx: SelfEmitCtx) -> bool {
    if code_ref_locals::local_feeds_return(f, local_idx) && code_ref_locals::mir_function_returns_enum_open(f) {
        emit_gc_enum_open_local(body, ctx)
        return true
    }
    let is_variant_constructor_dest = code_ref_locals::local_is_direct_gc_struct_new_dest(f, local_idx, ctx)
    if variant_slot >= 0 &&
    is_variant_constructor_dest &&
    !local_has_container_type_name(clone(type_name)) {
        let variant_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_variant_slot(ctx, variant_slot)
        if variant_gc >= 0 {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, variant_gc)
            return true
        }
    }
    if starts_with(clone(type_name), "enum:") ||
    starts_with(clone(type_name), "option:") ||
    starts_with(clone(type_name), "Option_") ||
    starts_with(clone(type_name), "Option:") ||
    starts_with(clone(type_name), "Option<") ||
    starts_with(clone(type_name), "result:") ||
    starts_with(clone(type_name), "Result_") ||
    starts_with(clone(type_name), "Result:") ||
    starts_with(clone(type_name), "Result<") {
        emit_gc_enum_open_local(body, ctx)
        return true
    }
    if code_ref_locals_infer_dest::local_has_multiple_enum_variant_types(f, local_idx) {
        emit_gc_enum_open_local(body, ctx)
        return true
    }
    false
}
fn enum_payload_type_name(type_name: String) -> bool {
    if len(type_name) <= 5 { return false }
    if !starts_with(clone(type_name), "enum:") { return false }
    if eq(clone(type_name), "enum:open") { return false }
    true
}
fn local_has_result_option_enum_type_name(type_name: String) -> bool {
    starts_with(clone(type_name), String_from("enum:")) ||
    starts_with(clone(type_name), String_from("option:")) ||
    starts_with(clone(type_name), String_from("Option_")) ||
    starts_with(clone(type_name), String_from("Option:")) ||
    starts_with(clone(type_name), String_from("Option<")) ||
    starts_with(clone(type_name), String_from("result:")) ||
    starts_with(clone(type_name), String_from("Result_")) ||
    starts_with(clone(type_name), String_from("Result:")) ||
    starts_with(clone(type_name), String_from("Result<"))
}

fn local_has_container_type_name(type_name: String) -> bool {
    if len(type_name) == 0 { return false }
    if starts_with(clone(type_name), "vec:") || starts_with(clone(type_name), "hashmap:") || starts_with(clone(type_name), "struct:") { return true }
    if eq(clone(type_name), "string") || eq(clone(type_name), "String") { return true }
    false
}
fn emit_gc_local_named_type(body: WasmWriter, type_name: String, vt: i32, f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> bool {
    if starts_with(clone(type_name), "hashmap:") {
        if vt == value_types::VT_I32() && !code_ref_locals::local_has_any_ref_assignment(f, local_idx, ctx) {
        } else {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            if starts_with(clone(type_name), "hashmap:i32str") {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_hashmap_i32_str_type(ctx))
            } else if starts_with(clone(type_name), "hashmap:i32fn") {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_hashmap_i32_fn_type(ctx))
            } else if starts_with(clone(type_name), "hashmap:strfn") {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_hashmap_str_fn_type(ctx))
            } else if starts_with(clone(type_name), "hashmap:strstr") {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_hashmap_str_str_type(ctx))
            } else if starts_with(clone(type_name), "hashmap:i32i32") {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
            } else {
                writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_hashmap_str_i32_type(ctx))
            }
            return true
        }
    }
    if eq(clone(type_name), "string") || eq(clone(type_name), "String") {
        if vt == value_types::VT_I32() && !code_ref_locals::local_has_any_ref_assignment(f, local_idx, ctx) {
        } else {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_string_type(ctx))
            return true
        }
    }
    if starts_with(clone(type_name), "Option_") ||
    starts_with(clone(type_name), "option:") ||
    starts_with(clone(type_name), "Option:") ||
    starts_with(clone(type_name), "Option<") {
        if vt == value_types::VT_I32() && !code_ref_locals::local_has_any_ref_assignment(f, local_idx, ctx) {
        } else {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
            return true
        }
    }
    emit_gc_local_struct_type(body, type_name, vt, f, local_idx, ctx)
}
fn emit_gc_local_struct_type(body: WasmWriter, type_name: String, vt: i32, f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> bool {
    if eq(clone(type_name), "HashMap") ||
    eq(clone(type_name), "HashSet") ||
    starts_with(clone(type_name), "struct:HashMap:") ||
    starts_with(clone(type_name), "struct:HashSet:") {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_vec_type(ctx))
        return true
    }
    if starts_with(clone(type_name), "struct:") {
        let struct_name = extract_struct_name_from_type_name(clone(type_name))
        if len(struct_name) > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(struct_name)) {
            let named_gc = ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(struct_name))
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, named_gc)
            return true
        }
        let byte_size = extract_struct_byte_size(clone(type_name))
        if byte_size > 0 {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_struct_type(ctx, byte_size))
            return true
        }
    }
    if len(type_name) > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(type_name)) {
        let struct_gc = ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(type_name))
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, struct_gc)
        return true
    }
    if len(type_name) > 0 {
        let byte_size = lookup_struct_byte_size(f, clone(type_name), ctx)
        if byte_size > 0 {
            writer_core::emit_byte(body, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(body, ctx_gc_type::SelfEmitCtx_struct_type(ctx, byte_size))
            return true
        }
    }
    emit_gc_local_inferred_type(body, f, local_idx, vt, ctx)
}
fn lookup_struct_byte_size(f: MirFunction, struct_name: String, ctx: SelfEmitCtx) -> i32 {
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_STRUCT_NEW() {
                let name = inst_accessors_literals::MirInst_str_val(inst)
                if eq(clone(name), clone(struct_name)) { return inst_accessors_literals::MirInst_int_val(inst) }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    0
}
fn extract_struct_name_from_type_name(type_name: String) -> String {
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let n = len(type_name)
    let mut i = 0
    while i < n {
        if char_at(type_name, i) == ':' {
            if first_colon < 0 { first_colon = i }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon < 0 || first_colon == last_colon { return String_new() }
    substring(type_name, first_colon + 1, last_colon)
}
fn extract_struct_byte_size(type_name: String) -> i32 {
    let n = len(type_name)
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if char_at(type_name, i) == ':' { last_colon = i }
        i = i + 1
    }
    if last_colon < 0 { return 0 }
    let mut byte_size = 0
    let mut j = last_colon + 1
    while j < n {
        let d = char_at(type_name, j)
        if d >= 48 && d <= 57 {
            byte_size = byte_size * 10 + (d - 48)
        } else {
            j = n
        }
        j = j + 1
    }
    byte_size
}
fn emit_gc_local_inferred_type(body: WasmWriter, f: MirFunction, local_idx: i32, vt: i32, ctx: SelfEmitCtx) -> bool {
    let spine_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
    if spine_gc >= 0 {
        let loc = function_locals_view::MirFunction_local_at(f, local_idx)
        let type_name = local_access::MirLocal_type_name(loc)
        if code_ref_locals_infer_dest::is_scalar_get_unchecked_result(clone(type_name), vt) &&
        !code_ref_locals::local_has_any_ref_assignment(f, local_idx, ctx) {
            return false
        }
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, spine_gc)
        return true
    }
    if vt == value_types::VT_REF() || vt == value_types::VT_GC_REF() {
        writer_core::emit_byte(body, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(body, ctx_record::SelfEmitCtx_gc_type_base(ctx))
        return true
    }
    false
}
