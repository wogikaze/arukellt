fn try_emit_simd_native_alltrue_bitmask(mut w: WasmWriter, handler_id: i32, inst: MirInst, dest: i32, arg0: i32, arg1: i32, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) -> bool {
    if handler_id == corehir::core_op_registry_generated::core_op_handler_simd_i8x16_all_true() {
        call_simd_emit::emit_simd_reduce_i32(w, inst, opcodes::SIMD_I8X16_ALL_TRUE(), next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    if handler_id == corehir::core_op_registry_generated::core_op_handler_simd_i8x16_bitmask() {
        call_simd_emit::emit_simd_reduce_i32(w, inst, opcodes::SIMD_I8X16_BITMASK(), next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    if handler_id == corehir::core_op_registry_generated::core_op_handler_simd_i16x8_all_true() {
        call_simd_emit::emit_simd_reduce_i32(w, inst, opcodes::SIMD_I16X8_ALL_TRUE(), next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    if handler_id == corehir::core_op_registry_generated::core_op_handler_simd_i16x8_bitmask() {
        call_simd_emit::emit_simd_reduce_i32(w, inst, opcodes::SIMD_I16X8_BITMASK(), next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    if handler_id == corehir::core_op_registry_generated::core_op_handler_simd_i32x4_all_true() {
        call_simd_emit::emit_simd_reduce_i32(w, inst, opcodes::SIMD_I32X4_ALL_TRUE(), next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    if handler_id == corehir::core_op_registry_generated::core_op_handler_simd_i32x4_bitmask() {
        call_simd_emit::emit_simd_reduce_i32(w, inst, opcodes::SIMD_I32X4_BITMASK(), next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    if handler_id == corehir::core_op_registry_generated::core_op_handler_simd_i64x2_all_true() {
        call_simd_emit::emit_simd_reduce_i32(w, inst, opcodes::SIMD_I64X2_ALL_TRUE(), next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    if handler_id == corehir::core_op_registry_generated::core_op_handler_simd_i64x2_bitmask() {
        call_simd_emit::emit_simd_reduce_i32(w, inst, opcodes::SIMD_I64X2_BITMASK(), next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    false
}

fn emit_simd_local_set(mut w: WasmWriter, local: i32) {
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, local)
}

// i8x16.mul has no Wasm instruction. Multiply the low and high 8-bit halves
// as 16-bit products, mask each to its low byte, then pack with unsigned
// narrowing (the masked values are already <= 0xff, so saturation is exact).
fn emit_simd_i8x16_mul(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    let scratch_a = ctx_scratch::SelfEmitCtx_scratch_v128_local(ctx, 0)
    let scratch_b = ctx_scratch::SelfEmitCtx_scratch_v128_local(ctx, 1)
    // Staged operands are [a b].
    emit_simd_local_set(w, scratch_b)
    emit_simd_local_set(w, scratch_a)
    writer_core::emit_local_get(w, scratch_a)
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_I16X8_EXTEND_LOW_I8X16_S())
    writer_core::emit_local_get(w, scratch_b)
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_I16X8_EXTEND_LOW_I8X16_S())
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_I16X8_MUL())
    emit_simd_i16x8_low_byte_mask(w)
    writer_core::emit_local_get(w, scratch_a)
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_I16X8_EXTEND_HIGH_I8X16_S())
    writer_core::emit_local_get(w, scratch_b)
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_I16X8_EXTEND_HIGH_I8X16_S())
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_I16X8_MUL())
    emit_simd_i16x8_low_byte_mask(w)
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_I8X16_NARROW_I16X8_U())
    call_simd_emit::emit_store_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
}

fn emit_simd_i16x8_low_byte_mask(mut w: WasmWriter) {
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_V128_CONST())
    let mut lane = 0
    while lane < 8 {
        writer_core::emit_byte(w, 0xff)
        writer_core::emit_byte(w, 0)
        lane = lane + 1
    }
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_V128_AND())
}

// Wasm SIMD has no unsigned i64x2 comparison. Flipping each lane's sign bit
// maps unsigned order onto the signed instruction's order; the caller then
// emits the matching signed compare.
fn emit_simd_u64x2_unsigned_operands(mut w: WasmWriter, ctx: SelfEmitCtx) {
    let scratch = ctx_scratch::SelfEmitCtx_scratch_v128_local(ctx, 0)
    // Staged operands are [a b].
    emit_simd_u64x2_sign_mask(w)
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_V128_XOR())
    emit_simd_local_set(w, scratch)
    emit_simd_u64x2_sign_mask(w)
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_V128_XOR())
    writer_core::emit_local_get(w, scratch)
}

fn emit_simd_u64x2_sign_mask(mut w: WasmWriter) {
    call_simd_emit::emit_simd_prefix(w, opcodes::SIMD_V128_CONST())
    let mut byte = 0
    while byte < 16 {
        if byte == 7 || byte == 15 {
            writer_core::emit_byte(w, 0x80)
        } else {
            writer_core::emit_byte(w, 0)
        }
        byte = byte + 1
    }
}
