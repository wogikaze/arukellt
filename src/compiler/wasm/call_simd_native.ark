    if handler_id == corehir::core_op_registry_generated::core_op_handler_simd_f64x2_sub() {
        call_simd_emit::emit_simd_binary(w, inst, opcodes::SIMD_F64X2_SUB(), next_op, next_arg0, next_arg1, next2_op)
