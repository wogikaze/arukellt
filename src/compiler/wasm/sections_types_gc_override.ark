use wasm::emit_target
use wasm::sections_types_gc
fn gc_param_is_scalar_type_name(type_name: String) -> bool {
    type_name.clone().eq("i32") ||
    type_name.clone().eq("i64") ||
    type_name.clone().eq("f64") ||
    type_name.clone().eq("f32") ||
    type_name.clone().eq("bool") ||
    type_name.clone().eq("char") ||
    type_name.clone().eq("u32")
}

// The String set-algebra helpers take a second String-keyed map operand
// (the set's bucket store). Their "hashset_str_" prefix only restates param 0,
// so the second operand would otherwise fall through to the scalar signature.
// `insert` / `remove` take a String second param and must not match.
fn gc_is_hashset_str_pair_store(fn_name: String) -> bool {
    fn_name.clone().ends_with(String_from("hashset_str_union")) ||
    fn_name.clone().ends_with(String_from("hashset_str_intersection")) ||
    fn_name.clone().ends_with(String_from("hashset_str_difference")) ||
    fn_name.clone().ends_with(String_from("hashset_str_extend"))
}

// Typed HashMap<i32,i32> / HashSet<i32> wrappers pass container refs in params
// 0/1; HashSet<String> passes the hashmap:si32 bucket store.
fn gc_typed_hash_container_param_sig(fn_name: String, param_idx: i32, type_name: String) -> String {
    if param_idx < 0 || param_idx > 1 {
        return String_new()
    }
    if gc_param_is_scalar_type_name(type_name.clone()) {
        return String_new()
    }
    if gc_is_hashset_str_pair_store(fn_name.clone()) {
        return sections_types_gc::gc_hashmap_str_i32_type_sig()
    }
    if fn_name.clone().contains("hashset_i32_") ||
    fn_name.clone().contains("hashmap_i32_i32_") ||
    fn_name.clone().ends_with("hashset_i32_extend") ||
    fn_name.clone().ends_with("hashmap_i32_i32_extend") {
        return sections_types_gc::gc_vec_type_sig()
    }
    if fn_name.clone().eq("hash::hashset_extend") || fn_name.clone().eq("hashset_extend") {
        return sections_types_gc::gc_vec_type_sig()
    }
    String_new()
}

fn gc_param_type_sig_override(fn_name: String, param_idx: i32, type_name: String, target: String) -> String {
    if !emit_target::is_gc_target(target.clone()) {
        return String_new()
    }
    // Generic monomorphizations: function names ending with __String have
    // String-typed params that the MIR may still represent as i32.
    // Only override params that lack concrete type info (empty or type
    // variable "?..."). Params with concrete types (enum:, struct:, vec:,
    // string, i32, etc.) keep their proper GC type.
    if fn_name.clone().ends_with("__String") {
        if len(type_name) == 0 || type_name.clone().starts_with("?") {
            return sections_types_gc::gc_string_type_sig()
        }
    }
    let typed_container_sig = gc_typed_hash_container_param_sig(fn_name.clone(), param_idx, type_name.clone())
    if len(typed_container_sig) > 0 {
        return typed_container_sig
    }
    if param_idx != 0 {
        return String_new()
    }
    // A param0 declared with a concrete non-container type is not a storage
    // receiver: compiler-side helpers share the hashmap_/hashset_ prefixes
    // (typechecker_hashmap_api::hashmap_type_name takes TypeInfo). Those keep
    // their declared GC type; only container or empty type names continue to
    // the storage sigs below.
    if len(type_name) > 0 &&
    !type_name.clone().starts_with("vec:") &&
    !type_name.clone().starts_with("hashmap:") &&
    !type_name.clone().starts_with("hashset:") &&
    !type_name.clone().starts_with("Vec") &&
    !type_name.clone().starts_with("HashMap") &&
    !type_name.clone().starts_with("HashSet") {
        return String_new()
    }
    // Check function name before type_name: hashmap functions may have "vec:..."
    // type names (from their linear-memory representation) but need their proper
    // GC struct type assigned on GC targets.
    if fn_name.clone().starts_with("hash_string::hashmap_str_str_") || fn_name.clone().starts_with("hashmap_str_str_") {
        return sections_types_gc::gc_hashmap_str_str_type_sig()
    }
    if fn_name.clone().starts_with("hash_string::hashmap_i32_str_") || fn_name.clone().starts_with("hashmap_i32_str_") {
        return sections_types_gc::gc_hashmap_i32_str_type_sig()
    }
    if fn_name.clone().starts_with("hash_fn::hashmap_i32_fn_") || fn_name.clone().starts_with("hashmap_i32_fn_") {
        return sections_types_gc::gc_hashmap_i32_fn_type_sig()
    }
    // Before hashmap_str_*: hashmap_str_fn_* shares that prefix (#838).
    if fn_name.clone().starts_with("hash_str_fn::hashmap_str_fn_") ||
    fn_name.clone().starts_with("hashmap_str_fn_") {
        return sections_types_gc::gc_hashmap_str_fn_type_sig()
    }
    if fn_name.clone().starts_with("hashmap_str_") || fn_name.clone().eq("hashmap_str_i32_new") || fn_name.clone().starts_with("hash_string::hashmap_str_") {
        return sections_types_gc::gc_hashmap_str_i32_type_sig()
    }
    if fn_name.clone().starts_with("hashmap_") ||
    fn_name.clone().starts_with("hashset_") ||
    fn_name.clone().starts_with("hash::hashmap_") ||
    fn_name.clone().starts_with("hash::hashset_") {
        // Exclude helper functions whose first parameter is i32, not Vec.
        if fn_name.clone().eq("hashmap_key_index") ||
        fn_name.clone().eq("hashmap_value_index") ||
        fn_name.clone().eq("hashmap_flag_index") ||
        fn_name.clone().eq("hashmap_required_vec_len") ||
        fn_name.clone().eq("hashmap_min_capacity_for_entries") ||
        fn_name.clone().eq("hashmap_with_capacity") {
            return String_new()
        }
        // HashSet<String> operates on the hashmap:si32 bucket store. The
        // Vec<String> snapshot helpers keep the vec:string signature.
        if fn_name.clone().starts_with("hashset_str_") ||
        fn_name.clone().starts_with("hash_string::hashset_str_") {
            return sections_types_gc::gc_hashmap_str_i32_type_sig()
        }
        if fn_name.clone().starts_with("hash_vec_string_") ||
        fn_name.clone().starts_with("hash_string::hash_vec_string_") {
            return sections_types_gc::gc_vec_string_type_sig()
        }
        return sections_types_gc::gc_vec_type_sig()
    }
    if len(type_name) > 0 {
        return String_new()
    }
    String_new()
}

fn gc_enum_return_type_sig(type_name: String, target: String) -> String {
    if !emit_target::is_gc_target(target.clone()) {
        return String_new()
    }
    if type_name.clone().starts_with("enum:") {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if type_name.clone().starts_with("option:") || type_name.clone().starts_with("Option:") {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if type_name.clone().starts_with("Option_") {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if type_name.clone().starts_with("Result_") || type_name.clone().starts_with("result:") || type_name.clone().starts_with("Result:") {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if type_name.clone().eq("Option") || type_name.clone().eq("Result") {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    String_new()
}

fn gc_return_type_sig_override(fn_name: String, type_name: String, target: String) -> String {
    if !emit_target::is_gc_target(target.clone()) {
        return String_new()
    }
    if gc_fn_returns_option(fn_name.clone()) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    // Only real constructors — not helpers like `hashmap_new_return_type`
    // or predicates like `is_hashset_i32_new` (suffix/prefix false friends).
    if fn_name.clone().starts_with("is_") {
        return String_new()
    }
    // ADR-086 HashSet trait impls return the source set type, whose storage
    // is vec:i32 or hashmap:si32; emit the store ref so the body value matches
    // the declared return (#917). The two families use different GC ref types.
    if fn_name.clone().eq("HashSet_i32::clone") ||
    fn_name.clone().eq("HashSet_i32::union") ||
    fn_name.clone().eq("HashSet_i32::intersection") ||
    fn_name.clone().eq("HashSet_i32::difference") ||
    fn_name.clone().starts_with("HashSet_i32::from_iter__") {
        return sections_types_gc::gc_vec_type_sig()
    }
    if fn_name.clone().eq("HashSet_String::clone") ||
    fn_name.clone().eq("HashSet_String::union") ||
    fn_name.clone().eq("HashSet_String::intersection") ||
    fn_name.clone().eq("HashSet_String::difference") ||
    fn_name.clone().starts_with("HashSet_String::from_iter__") {
        return sections_types_gc::gc_hashmap_str_i32_type_sig()
    }
    if fn_name.clone().eq("hashmap_new") ||
    fn_name.clone().starts_with("hashmap_new__") ||
    fn_name.clone().eq("hash::hashmap_new") ||
    fn_name.clone().ends_with("::hashmap_new") ||
    fn_name.clone().eq("hashmap_with_capacity") ||
    fn_name.clone().starts_with("hashmap_with_capacity__") ||
    fn_name.clone().eq("hash::hashmap_with_capacity") ||
    fn_name.clone().eq("hashset_new") ||
    fn_name.clone().starts_with("hashset_new__") ||
    fn_name.clone().eq("hash::hashset_new") ||
    fn_name.clone().ends_with("::hashset_new") ||
    fn_name.clone().eq("hashset_i32_new") ||
    fn_name.clone().starts_with("hashset_i32_new__") ||
    fn_name.clone().ends_with("::hashset_i32_new") {
        return sections_types_gc::gc_vec_type_sig()
    }
    let enum_sig = gc_enum_return_type_sig(type_name.clone(), target.clone())
    if len(enum_sig) > 0 {
        return enum_sig
    }
    if len(type_name) > 0 {
        return String_new()
    }
    if fn_name.clone().eq("hashmap_str_i32_new") ||
    fn_name.clone().starts_with("hashmap_str_i32_new__") ||
    fn_name.clone().ends_with("::hashmap_str_i32_new") {
        return sections_types_gc::gc_hashmap_str_i32_type_sig()
    }
    if fn_name.clone().eq("hash_string::hashmap_i32_str_new") ||
    fn_name.clone().starts_with("hash_string::hashmap_i32_str_new__") {
        return sections_types_gc::gc_hashmap_i32_str_type_sig()
    }
    if fn_name.clone().eq("hash_fn::hashmap_i32_fn_new") ||
    fn_name.clone().starts_with("hash_fn::hashmap_i32_fn_new__") {
        return sections_types_gc::gc_hashmap_i32_fn_type_sig()
    }
    if fn_name.clone().eq("hashmap_str_fn_new") ||
    fn_name.clone().starts_with("hashmap_str_fn_new__") ||
    fn_name.clone().ends_with("::hashmap_str_fn_new") ||
    fn_name.clone().eq("hash_str_fn::hashmap_str_fn_new") ||
    fn_name.clone().starts_with("hash_str_fn::hashmap_str_fn_new__") {
        return sections_types_gc::gc_hashmap_str_fn_type_sig()
    }
    if fn_name.clone().eq("hash_string::hashmap_str_str_new") ||
    fn_name.clone().starts_with("hash_string::hashmap_str_str_new__") {
        return sections_types_gc::gc_hashmap_str_str_type_sig()
    }
    String_new()
}

fn gc_fn_returns_option(fn_name: String) -> bool {
    if fn_name.clone().eq("hashmap_get_option") ||
    fn_name.clone().eq("hash::hashmap_get_option") ||
    fn_name.clone().ends_with("hashmap_i32_i32_get") {
        return true
    }
    if fn_name.clone().eq("hashmap_remove") ||
    fn_name.clone().eq("hash::hashmap_remove") ||
    fn_name.clone().ends_with("hashmap_i32_i32_remove") {
        return true
    }
    if fn_name.clone().eq("hashmap_remove_entry_pair") ||
    fn_name.clone().eq("hash::hashmap_remove_entry_pair") {
        return true
    }
    if fn_name.clone().eq("hash_string::hashmap_str_get") ||
    fn_name.clone().eq("hashmap_str_get") ||
    fn_name.clone().eq("hash::hashmap_str_get") {
        return true
    }
    if fn_name.clone().eq("hash_string::hashmap_str_remove") ||
    fn_name.clone().eq("hashmap_str_remove") ||
    fn_name.clone().eq("hash::hashmap_str_remove") {
        return true
    }
    if fn_name.clone().eq("hash_string::hashmap_i32_str_get") ||
    fn_name.clone().eq("hash_string::hashmap_str_str_get") {
        return true
    }
    if fn_name.clone().eq("hash_string::hashmap_str_insert") ||
    fn_name.clone().eq("hash_string::hashmap_i32_str_insert") ||
    fn_name.clone().eq("hash_string::hashmap_str_str_insert") ||
    fn_name.clone().eq("hash_fn::hashmap_i32_fn_insert") ||
    fn_name.clone().eq("hash_str_fn::hashmap_str_fn_insert") {
        return true
    }
    if fn_name.clone().eq("hash_fn::hashmap_i32_fn_get") {
        return true
    }
    if fn_name.clone().eq("hash_fn::hashmap_i32_fn_remove") {
        return true
    }
    if fn_name.clone().eq("hash_str_fn::hashmap_str_fn_get") {
        return true
    }
    if fn_name.clone().eq("hash_str_fn::hashmap_str_fn_remove") {
        return true
    }
    if fn_name.clone().eq("hashmap_str_str_get") || fn_name.clone().eq("hash_string::hashmap_str_str_get") {
        return true
    }
    if fn_name.clone().eq("hashmap_str_str_remove") ||
    fn_name.clone().eq("hash_string::hashmap_str_str_remove") {
        return true
    }
    false
}
