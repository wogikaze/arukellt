// Extracted from sections_types_sigs.ark

use mir::function_param_view
use mir::function_return_view
use mir::local_access
use mir::module_gc_enum
use mir::module_gc_struct
use mir::value_types
use wasm::emit_target
use wasm::sections_type_plan
use wasm::sections_types_gc
use wasm::sections_types_gc_override
use wasm::sections_types_gc_phase7
use wasm::sections_types_gc_plan
use wasm::sections_types_sigs_mono

fn is_hash_container_type_name(type_name: String) -> bool {
    if eq(clone(type_name), String_from("HashMap")) || eq(clone(type_name), String_from("HashSet")) || eq(clone(type_name), String_from("Vec")) {
        return true
    }
    if eq(clone(type_name), String_from("?HashMap")) || eq(clone(type_name), String_from("?HashSet")) || eq(clone(type_name), String_from("?Vec")) {
        return true
    }
    if starts_with(clone(type_name), String_from("struct:HashMap:")) || starts_with(clone(type_name), String_from("struct:HashSet:")) {
        return true
    }
    false
}

// fn(i32, i32) -> i32 fold callbacks — comma inside the param list.
fn funcref_type_name_is_binary_i32(type_name: String) -> bool {
    if eq(clone(type_name), String_from("fnref2")) {
        return true
    }
    if !starts_with(clone(type_name), String_from("fn(")) {
        return false
    }
    let close = index_of(clone(type_name), String_from(")"))
    if close <= 0 {
        return false
    }
    let params = substring(clone(type_name), 3, close)
    contains(params, String_from(","))
}

fn build_function_type_sig(uf: MirFunction, target: String, wasi_version: String, mir: MirModule) -> String {
    let mut sig = String_new()
    let pc = function_param_view::MirFunction_param_count(uf)
    let mut pi = 0
    while pi < pc {
        let p = function_param_view::MirFunction_param_at(uf, pi)
        sig = text::builder_append(sig, build_param_type_sig(uf, p, pi, clone(target), clone(wasi_version), mir))
        sig = text::builder_append(sig, String_from("_"))
        pi = pi + 1
    }
    let return_type = function_return_view::MirFunction_return_type(uf)
    let return_type_name = function_return_view::MirFunction_return_type_name(uf)
    sig = text::builder_append(sig, build_return_type_sig(uf, return_type, return_type_name, target, wasi_version, mir))
    text::builder_build(sig)
}

fn p2_is_string_type_name(type_name: String) -> bool {
    eq(clone(type_name), String_from("string")) ||
    eq(clone(type_name), String_from("String"))
}

fn p2_is_supported_scalar_type(value_type: i32) -> bool {
    value_type == value_types::VT_I32() ||
    value_type == value_types::VT_I64() ||
    value_type == value_types::VT_F32() ||
    value_type == value_types::VT_F64()
}

fn p2_return_type_is_compound(type_name: String) -> bool {
    starts_with(clone(type_name), String_from("tuple:")) ||
    starts_with(clone(type_name), String_from("struct:")) ||
    starts_with(clone(type_name), String_from("vec:")) ||
    starts_with(clone(type_name), String_from("hashmap:")) ||
    starts_with(clone(type_name), String_from("HashMap")) ||
    starts_with(clone(type_name), String_from("HashSet")) ||
    starts_with(clone(type_name), String_from("Option")) ||
    starts_with(clone(type_name), String_from("option:")) ||
    starts_with(clone(type_name), String_from("Result")) ||
    starts_with(clone(type_name), String_from("result:")) ||
    starts_with(clone(type_name), String_from("enum:")) ||
    contains(clone(type_name), String_from(","))
}

fn p2_is_option_type_name(type_name: String) -> bool {
    eq(clone(type_name), String_from("Option")) ||
    starts_with(clone(type_name), String_from("Option:")) ||
    starts_with(clone(type_name), String_from("Option_")) ||
    starts_with(clone(type_name), String_from("Option<")) ||
    starts_with(clone(type_name), String_from("option:")) ||
    starts_with(clone(type_name), String_from("option<"))
}

fn p2_is_result_type_name(type_name: String) -> bool {
    eq(clone(type_name), String_from("Result")) ||
    starts_with(clone(type_name), String_from("Result:")) ||
    starts_with(clone(type_name), String_from("Result_")) ||
    starts_with(clone(type_name), String_from("Result<")) ||
    starts_with(clone(type_name), String_from("result:")) ||
    starts_with(clone(type_name), String_from("result<"))
}

fn p2_is_list_type_name(type_name: String) -> bool {
    eq(clone(type_name), String_from("Vec")) ||
    starts_with(clone(type_name), String_from("Vec:")) ||
    starts_with(clone(type_name), String_from("Vec_")) ||
    starts_with(clone(type_name), String_from("Vec<")) ||
    starts_with(clone(type_name), String_from("vec:")) ||
    starts_with(clone(type_name), String_from("vec<"))
}

fn p2_is_tuple_type_name(type_name: String) -> bool {
    starts_with(clone(type_name), String_from("Tuple:")) ||
    starts_with(clone(type_name), String_from("Tuple_")) ||
    starts_with(clone(type_name), String_from("Tuple<")) ||
    starts_with(clone(type_name), String_from("tuple:")) ||
    starts_with(clone(type_name), String_from("tuple<"))
}

fn p2_type_argument(type_name: String, index: i32) -> String {
    let mut body = clone(type_name)
    let angle = index_of(clone(body), String_from("<"))
    let underscore_form = angle < 0 && index_of(clone(body), String_from(":")) < 0 &&
    (starts_with(clone(body), String_from("Option_")) ||
        starts_with(clone(body), String_from("Result_")) ||
        starts_with(clone(body), String_from("Vec_")) ||
        starts_with(clone(body), String_from("Tuple_")))
    if angle >= 0 {
        let rest = substring(clone(body), angle + 1, len(body))
        let close = index_of(clone(rest), String_from(">"))
        if close >= 0 {
            body = substring(rest, 0, close)
        }
    } else {
        let colon = index_of(clone(body), String_from(":"))
        if colon < 0 {
            let underscore = index_of(clone(body), String_from("_"))
            if underscore >= 0 && (p2_is_option_type_name(clone(type_name)) ||
                p2_is_result_type_name(clone(type_name)) ||
                p2_is_list_type_name(clone(type_name)) ||
                p2_is_tuple_type_name(clone(type_name))) {
                body = substring(body, underscore + 1, len(body))
            } else {
                if p2_is_option_type_name(clone(type_name)) && index == 0 {
                    return String_from("i32")
                }
                if p2_is_result_type_name(clone(type_name)) {
                    return String_from("i32")
                }
                return String_new()
            }
        } else {
            body = substring(body, colon + 1, len(body))
        }
    }
    let mut current = 0
    let mut start = 0
    let mut i = 0
    let mut depth = 0
    while i <= len(body) {
        let at_end = i == len(body)
        let c = if at_end { 44 } else { char_at(clone(body), i) }
        if c == 60 {
            depth = depth + 1
        } else if c == 62 {
            depth = depth - 1
        }
        if ((c == 44 || c == 58 || (underscore_form && c == 95)) && depth == 0) || at_end {
            if current == index {
                return substring(clone(body), start, i)
            }
            current = current + 1
            start = i + 1
        }
        i = i + 1
    }
    String_new()
}

fn p2_enum_type_name(type_name: String) -> String {
    if starts_with(clone(type_name), String_from("enum:")) {
        return substring(type_name, 5, len(type_name))
    }
    type_name
}

fn p2_enum_variant_matches(enum_name: String, variant_name: String) -> bool {
    let enum_name = p2_enum_type_name(clone(enum_name))
    starts_with(clone(variant_name), concat(clone(enum_name), String_from("::"))) ||
    contains(
        clone(variant_name),
        concat(String_from("::"), concat(clone(enum_name), String_from("::")))
    )
}

fn p2_enum_has_variants(type_name: String, mir: MirModule) -> bool {
    let names = module_gc_enum::MirModule_gc_enum_variant_names(mir)
    let mut i = 0
    while i < len(names) {
        if p2_enum_variant_matches(clone(type_name), get_unchecked(names, i)) {
            return true
        }
        i = i + 1
    }
    false
}

fn p2_enum_payload_sigs(type_name: String, mir: MirModule) -> Vec<String> {
    let names = module_gc_enum::MirModule_gc_enum_variant_names(mir)
    let sigs = module_gc_enum::MirModule_gc_enum_variant_sigs(mir)
    let payload = Vec::new<String>()
    let mut i = 0
    while i < len(names) {
        if i < len(sigs) && p2_enum_variant_matches(clone(type_name), get_unchecked(names, i)) {
            let fields = sections_types_gc::struct_field_sigs(get_unchecked(sigs, i))
            let mut fi = 1
            while fi < len(fields) {
                let field = get_unchecked(fields, fi)
                if len(payload) == 0 {
                    push(payload, clone(field))
                } else if !eq(clone(get_unchecked(payload, 0)), clone(field)) {
                    // Current WIT variants have one payload slot. Keep the
                    // widest scalar when a family uses different payloads.
                    if eq(clone(field), String_from("f64")) ||
                    eq(clone(field), String_from("i64")) ||
                    eq(clone(get_unchecked(payload, 0)), String_from("i32")) {
                        set(payload, 0, clone(field))
                    }
                }
                fi = fi + 1
            }
        }
        i = i + 1
    }
    payload
}

fn p2_struct_name_from_type(type_name: String) -> String {
    if starts_with(clone(type_name), String_from("struct:")) {
        let first = index_of(clone(type_name), String_from(":"))
        let mut last = first
        let mut i = first + 1
        while i < len(type_name) {
            if char_at(clone(type_name), i) == 58 {
                last = i
            }
            i = i + 1
        }
        if first >= 0 && last > first {
            return substring(type_name, first + 1, last)
        }
    }
    type_name
}

fn p2_struct_field_sigs(type_name: String, mir: MirModule) -> Vec<String> {
    let name = p2_struct_name_from_type(clone(type_name))
    let mut slot = module_gc_struct::MirModule_gc_struct_slot(mir, clone(name))
    if slot < 0 {
        let mut last = 0 - 1
        let mut i = len(name) - 1
        while i >= 0 {
            if char_at(clone(name), i) == 58 {
                last = i
                i = 0 - 1
            }
            i = i - 1
        }
        if last >= 0 {
            slot = module_gc_struct::MirModule_gc_struct_slot(
                mir,
                substring(clone(name), last + 1, len(name))
            )
        }
    }
    if slot < 0 {
        return Vec::new<String>()
    }
    sections_types_gc::struct_field_sigs(
        module_gc_struct::MirModule_gc_struct_sig_at(mir, slot)
    )
}

fn p2_field_flat_count(field_sig: String) -> i32 {
    if eq(clone(field_sig), String_from("ref0")) ||
    eq(clone(field_sig), String_from("string")) {
        return 2
    }
    1
}

fn p2_field_canonical_sig(field_sig: String) -> String {
    if eq(clone(field_sig), String_from("i64")) {
        return String_from("i64")
    }
    if eq(clone(field_sig), String_from("f64")) {
        return String_from("f64")
    }
    if eq(clone(field_sig), String_from("f32")) {
        return String_from("f32")
    }
    if eq(clone(field_sig), String_from("ref0")) {
        return String_from("i32_i32")
    }
    String_from("i32")
}

fn p2_value_canonical_sig(type_name: String, value_type: i32, mir: MirModule) -> String {
    if p2_is_string_type_name(clone(type_name)) {
        return String_from("i32_i32")
    }
    if eq(clone(type_name), String_from("bool")) || eq(clone(type_name), String_from("char")) ||
    eq(clone(type_name), String_from("u8")) || eq(clone(type_name), String_from("u16")) ||
    eq(clone(type_name), String_from("u32")) || eq(clone(type_name), String_from("i8")) ||
    eq(clone(type_name), String_from("i16")) || eq(clone(type_name), String_from("i32")) {
        return String_from("i32")
    }
    if eq(clone(type_name), String_from("i64")) || eq(clone(type_name), String_from("u64")) {
        return String_from("i64")
    }
    if eq(clone(type_name), String_from("f32")) {
        return String_from("f32")
    }
    if eq(clone(type_name), String_from("f64")) {
        return String_from("f64")
    }
    if p2_is_list_type_name(clone(type_name)) || p2_is_tuple_type_name(clone(type_name)) ||
    p2_is_option_type_name(clone(type_name)) || p2_is_result_type_name(clone(type_name)) ||
    p2_return_type_is_compound(clone(type_name)) || p2_enum_has_variants(clone(type_name), mir) ||
    value_type == value_types::VT_GC_REF() || value_type == value_types::VT_REF() {
        return String_from("i32")
    }
    p2_scalar_type_sig(value_type)
}

fn p2_flat_value_count(type_name: String, value_type: i32, mir: MirModule) -> i32 {
    if p2_is_string_type_name(clone(type_name)) {
        return 2
    }
    if p2_is_list_type_name(clone(type_name)) || p2_is_tuple_type_name(clone(type_name)) ||
    p2_is_option_type_name(clone(type_name)) || p2_is_result_type_name(clone(type_name)) ||
    p2_return_type_is_compound(clone(type_name)) || p2_enum_has_variants(clone(type_name), mir) {
        return 1
    }
    1
}

fn p2_type_is_aggregate(type_name: String, value_type: i32, mir: MirModule) -> bool {
    p2_is_string_type_name(clone(type_name)) ||
    p2_is_list_type_name(clone(type_name)) ||
    p2_is_tuple_type_name(clone(type_name)) ||
    p2_is_option_type_name(clone(type_name)) ||
    p2_is_result_type_name(clone(type_name)) ||
    p2_return_type_is_compound(clone(type_name)) ||
    p2_enum_has_variants(clone(type_name), mir) ||
    value_type == value_types::VT_GC_REF() || value_type == value_types::VT_REF()
}

fn p2_canonical_param_count_for_type(type_name: String, value_type: i32, mir: MirModule) -> i32 {
    if p2_is_string_type_name(clone(type_name)) || p2_is_list_type_name(clone(type_name)) {
        return 2
    }
    if p2_is_option_type_name(clone(type_name)) {
        let inner = p2_type_argument(clone(type_name), 0)
        if eq(clone(inner), String_from("bool")) {
            return 1
        }
        return 1 + p2_flat_value_count(clone(inner), value_type, mir)
    }
    if p2_is_result_type_name(clone(type_name)) {
        let ok = p2_flat_value_count(p2_type_argument(clone(type_name), 0), value_type, mir)
        let err = p2_flat_value_count(p2_type_argument(clone(type_name), 1), value_type, mir)
        let mut payload_count = ok
        if err > ok {
            payload_count = err
        }
        return 1 + payload_count
    }
    if p2_is_tuple_type_name(clone(type_name)) {
        let mut count = 0
        let mut i = 0
        while len(p2_type_argument(clone(type_name), i)) > 0 {
            count = count + p2_flat_value_count(p2_type_argument(clone(type_name), i), value_type, mir)
            i = i + 1
        }
        return count
    }
    let fields = p2_struct_field_sigs(clone(type_name), mir)
    if len(fields) > 0 && !p2_enum_has_variants(clone(type_name), mir) {
        let mut count = 0
        let mut i = 0
        while i < len(fields) {
            count = count + p2_field_flat_count(get_unchecked(fields, i))
            i = i + 1
        }
        return count
    }
    let payload = p2_enum_payload_sigs(clone(type_name), mir)
    if len(payload) > 0 {
        return 1 + p2_field_flat_count(get_unchecked(payload, 0))
    }
    1
}

fn p2_canonical_param_type_sig(param: MirLocal, mir: MirModule) -> String {
    let type_name = local_access::MirLocal_type_name(param)
    let value_type = local_access::MirLocal_val_type(param)
    if p2_is_string_type_name(clone(type_name)) || p2_is_list_type_name(clone(type_name)) {
        return if p2_is_string_type_name(clone(type_name)) { String_from("i32_i32") } else { String_from("i32_i32") }
    }
    if p2_is_option_type_name(clone(type_name)) {
        let inner = p2_type_argument(clone(type_name), 0)
        if eq(clone(inner), String_from("bool")) {
            return String_from("i32")
        }
        return concat(String_from("i32_"), p2_value_canonical_sig(clone(inner), value_type, mir))
    }
    if p2_is_result_type_name(clone(type_name)) {
        let ok = p2_value_canonical_sig(p2_type_argument(clone(type_name), 0), value_type, mir)
        let err = p2_value_canonical_sig(p2_type_argument(clone(type_name), 1), value_type, mir)
        if eq(clone(ok), clone(err)) {
            return concat(String_from("i32_"), ok)
        }
        if eq(clone(ok), String_from("i32_i32")) || eq(clone(err), String_from("i32_i32")) {
            return String_from("i32_i32_i32")
        }
        return concat(String_from("i32_"), ok)
    }
    if p2_is_tuple_type_name(clone(type_name)) {
        let sig = String_new()
        let mut i = 0
        while len(p2_type_argument(clone(type_name), i)) > 0 {
            sig = concat(
                clone(sig),
                concat(p2_value_canonical_sig(p2_type_argument(clone(type_name), i), value_type, mir), "_")
            )
            i = i + 1
        }
        if len(sig) > 0 {
            return substring(sig, 0, len(sig) - 1)
        }
    }
    let fields = p2_struct_field_sigs(clone(type_name), mir)
    if len(fields) > 0 && !p2_enum_has_variants(clone(type_name), mir) {
        let sig = String_new()
        let mut i = 0
        while i < len(fields) {
            sig = concat(clone(sig), concat(p2_field_canonical_sig(get_unchecked(fields, i)), "_"))
            i = i + 1
        }
        return substring(sig, 0, len(sig) - 1)
    }
    let payload = p2_enum_payload_sigs(clone(type_name), mir)
    if len(payload) > 0 {
        return concat(String_from("i32_"), p2_field_canonical_sig(get_unchecked(payload, 0)))
    }
    p2_value_canonical_sig(clone(type_name), value_type, mir)
}

fn p2_scalar_type_sig(value_type: i32) -> String {
    if value_type == value_types::VT_I32() {
        return String_from("i32")
    }
    if value_type == value_types::VT_I64() {
        return String_from("i64")
    }
    if value_type == value_types::VT_F32() {
        return String_from("f32")
    }
    if value_type == value_types::VT_F64() {
        return String_from("f64")
    }
    String_new()
}

fn p2_is_supported_scalar_name(type_name: String) -> bool {
    p2_is_string_type_name(clone(type_name)) ||
    eq(clone(type_name), String_from("bool")) ||
    eq(clone(type_name), String_from("char")) ||
    eq(clone(type_name), String_from("u8")) ||
    eq(clone(type_name), String_from("u16")) ||
    eq(clone(type_name), String_from("u32")) ||
    eq(clone(type_name), String_from("u64")) ||
    eq(clone(type_name), String_from("i8")) ||
    eq(clone(type_name), String_from("i16")) ||
    eq(clone(type_name), String_from("i32")) ||
    eq(clone(type_name), String_from("i64")) ||
    eq(clone(type_name), String_from("f32")) ||
    eq(clone(type_name), String_from("f64"))
}

fn p2_is_supported_storage_field(field_sig: String) -> bool {
    eq(clone(field_sig), String_from("i32")) ||
    eq(clone(field_sig), String_from("i64")) ||
    eq(clone(field_sig), String_from("f32")) ||
    eq(clone(field_sig), String_from("f64"))
}

fn p2_supported_list_element(type_name: String) -> bool {
    let element = p2_type_argument(clone(type_name), 0)
    if len(element) == 0 || !p2_is_supported_scalar_name(clone(element)) {
        return false
    }
    // The current adapter copies list elements through i32 loads/stores. It
    // must not claim support for a GC array whose element is a reference or a
    // wider floating/integer value.
    eq(clone(element), String_from("bool")) ||
    eq(clone(element), String_from("char")) ||
    eq(clone(element), String_from("u8")) ||
    eq(clone(element), String_from("u16")) ||
    eq(clone(element), String_from("u32")) ||
    eq(clone(element), String_from("i8")) ||
    eq(clone(element), String_from("i16")) ||
    eq(clone(element), String_from("i32"))
}

fn p2_supported_record_fields(type_name: String, mir: MirModule) -> bool {
    let fields = p2_struct_field_sigs(clone(type_name), mir)
    if len(fields) == 0 {
        return false
    }
    let mut i = 0
    while i < len(fields) {
        if !p2_is_supported_storage_field(get_unchecked(fields, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn p2_supported_tuple_arguments(type_name: String) -> bool {
    let first = p2_type_argument(clone(type_name), 0)
    if len(first) == 0 {
        return false
    }
    let mut i = 0
    while len(p2_type_argument(clone(type_name), i)) > 0 {
        let element = p2_type_argument(clone(type_name), i)
        if !p2_is_supported_scalar_name(clone(element)) ||
        p2_is_string_type_name(clone(element)) {
            return false
        }
        i = i + 1
    }
    true
}

fn p2_supported_option_or_result(type_name: String) -> bool {
    if eq(clone(type_name), String_from("Option")) ||
    eq(clone(type_name), String_from("Result")) {
        return false
    }
    let first = p2_type_argument(clone(type_name), 0)
    if len(first) == 0 {
        return false
    }
    if p2_is_option_type_name(clone(type_name)) {
        return p2_is_supported_scalar_name(clone(first))
    }
    let second = p2_type_argument(clone(type_name), 1)
    if len(second) == 0 {
        return false
    }
    p2_is_supported_scalar_name(clone(first)) && p2_is_supported_scalar_name(clone(second))
}

fn p2_supported_enum_payloads(type_name: String, mir: MirModule) -> bool {
    if !p2_enum_has_variants(clone(type_name), mir) {
        return false
    }
    let names = module_gc_enum::MirModule_gc_enum_variant_names(mir)
    let sigs = module_gc_enum::MirModule_gc_enum_variant_sigs(mir)
    let mut payload_sig = String_new()
    let mut i = 0
    while i < len(names) {
        if i < len(sigs) && p2_enum_variant_matches(clone(type_name), get_unchecked(names, i)) {
            let fields = sections_types_gc::struct_field_sigs(get_unchecked(sigs, i))
            if len(fields) > 2 {
                return false
            }
            if len(fields) == 2 {
                let field = get_unchecked(fields, 1)
                if !p2_is_supported_storage_field(clone(field)) {
                    return false
                }
                if len(payload_sig) == 0 {
                    payload_sig = clone(field)
                } else if !eq(clone(payload_sig), clone(field)) {
                    return false
                }
            }
        }
        i = i + 1
    }
    true
}

fn p2_wrapper_type_is_supported(
    type_name: String,
    value_type: i32,
    mir: MirModule
) -> bool {
    if p2_is_string_type_name(clone(type_name)) {
        return true
    }
    if p2_is_supported_scalar_type(value_type) &&
    (len(type_name) == 0 || p2_is_supported_scalar_name(clone(type_name))) {
        return true
    }
    if p2_is_list_type_name(clone(type_name)) {
        return p2_supported_list_element(clone(type_name))
    }
    if p2_is_option_type_name(clone(type_name)) ||
    p2_is_result_type_name(clone(type_name)) {
        return p2_supported_option_or_result(clone(type_name))
    }
    if p2_is_tuple_type_name(clone(type_name)) {
        return p2_supported_tuple_arguments(clone(type_name))
    }
    if p2_enum_has_variants(clone(type_name), mir) {
        return p2_supported_enum_payloads(clone(type_name), mir)
    }
    if p2_return_type_is_compound(clone(type_name)) {
        return p2_supported_record_fields(clone(type_name), mir)
    }
    false
}

// The raw GC ABI is private to the core module. A P2 library export needs a
// core-module wrapper whenever a public WIT value crosses that boundary in a
// representation different from the scalar standard32 ABI.
fn p2_function_needs_string_wrapper(
    f: MirFunction,
    target: String,
    wasi_version: String,
    mir: MirModule
) -> bool {
    if !emit_target::is_gc_target(clone(target)) || !emit_target::is_p2_wasi(clone(wasi_version)) {
        return false
    }
    let mut needs_wrapper = false
    let param_count = function_param_view::MirFunction_param_count(f)
    let mut pi = 0
    while pi < param_count {
        let param = function_param_view::MirFunction_param_at(f, pi)
        let type_name = local_access::MirLocal_type_name(param)
        if !p2_wrapper_type_is_supported(
            clone(type_name),
            local_access::MirLocal_val_type(param),
            mir
        ) {
            return false
        }
        if p2_is_string_type_name(clone(type_name)) {
            needs_wrapper = true
        } else if !p2_is_supported_scalar_type(local_access::MirLocal_val_type(param)) {
            if local_access::MirLocal_val_type(param) == value_types::VT_FUNCREF() {
                return false
            }
            needs_wrapper = true
        } else if p2_return_type_is_compound(clone(type_name)) {
            needs_wrapper = true
        }
        pi = pi + 1
    }
    let return_type = function_return_view::MirFunction_return_type(f)
    let return_type_name = function_return_view::MirFunction_return_type_name(f)
    if return_type == value_types::VT_VOID() {
        return needs_wrapper
    }
    if !p2_wrapper_type_is_supported(clone(return_type_name), return_type, mir) {
        return false
    }
    if p2_is_string_type_name(clone(return_type_name)) {
        return true
    }
    if !p2_is_supported_scalar_type(return_type) {
        return return_type != value_types::VT_FUNCREF()
    }
    p2_return_type_is_compound(clone(return_type_name)) || needs_wrapper
}

fn p2_canonical_function_type_sig(f: MirFunction, mir: MirModule) -> String {
    let mut sig = String_new()
    let param_count = function_param_view::MirFunction_param_count(f)
    let mut pi = 0
    while pi < param_count {
        let param = function_param_view::MirFunction_param_at(f, pi)
        sig = concat(
            clone(sig),
            concat(p2_canonical_param_type_sig(param, mir), "_")
        )
        pi = pi + 1
    }
    let return_type = function_return_view::MirFunction_return_type(f)
    if return_type == value_types::VT_VOID() {
        return concat(clone(sig), "0")
    }
    let return_type_name = function_return_view::MirFunction_return_type_name(f)
    if p2_is_string_type_name(clone(return_type_name)) ||
    p2_return_type_is_compound(clone(return_type_name)) ||
    !p2_is_supported_scalar_type(return_type) {
        return concat(clone(sig), "1i32")
    }
    concat(clone(sig), concat("1", p2_scalar_type_sig(return_type)))
}

fn p2_post_type_sig_for_function(f: MirFunction, function_sig: String) -> String {
    let return_type_name = function_return_view::MirFunction_return_type_name(f)
    let return_type = function_return_view::MirFunction_return_type(f)
    if return_type == value_types::VT_VOID() {
        return String_from("0")
    }
    if p2_is_string_type_name(clone(return_type_name)) {
        return String_from("i32_0")
    }
    if p2_return_type_is_compound(clone(return_type_name)) ||
    !p2_is_supported_scalar_type(return_type) {
        return String_from("i32_0")
    }
    let mut result_start = 0
    let mut i = 0
    while i < len(function_sig) {
        if char_at(function_sig, i) == 95 {
            result_start = i + 1
        }
        i = i + 1
    }
    let result_sig = substring(function_sig, result_start, len(function_sig))
    if eq(clone(result_sig), "0") {
        return "0"
    }
    concat(substring(clone(result_sig), 1, len(result_sig)), "_0")
}

fn build_return_type_sig(
    uf: MirFunction,
    return_type: i32,
    return_type_name: String,
    target: String,
    wasi_version: String,
    mir: MirModule
) -> String {
    if return_type == 0 {
        return String_from("0")
    }
    concat(String_from("1"), build_return_type_value_sig(uf, return_type, return_type_name, target, wasi_version, mir))
}

fn is_string_byte_vec_param_fn(fn_name: String) -> bool {
    // Only byte-buffer helpers whose first parameter is actually Vec<i32>
    // should be forced to the vec structref type. ascii_case_impl takes a
    // String (an i8 array) as its source parameter, so it must keep the
    // string GC array signature.
    eq(clone(fn_name), String_from("__core_string_push_range")) ||
    eq(clone(fn_name), String_from("__core_string_push_byte"))
}

fn build_param_type_sig(
    uf: MirFunction,
    p: MirLocal,
    pi: i32,
    target: String,
    wasi_version: String,
    mir: MirModule
) -> String {
    let p_type_name = local_access::MirLocal_type_name(p)
    // Typed funcref params encode as atomic segments (no underscores) so
    // type_sig_param_segments keeps them intact (#831). Binary fold callbacks
    // use fnref2 → WASI i32_i32_1i32; unary map/filter keep fnref (#807).
    if eq(clone(p_type_name), String_from("fnref")) ||
    starts_with(clone(p_type_name), String_from("fnref")) ||
    local_access::MirLocal_val_type(p) == value_types::VT_FUNCREF() ||
    starts_with(clone(p_type_name), String_from("fn(")) {
        if funcref_type_name_is_binary_i32(clone(p_type_name)) {
            return String_from("fnref2")
        }
        return String_from("fnref")
    }
    // String byte-buffer helpers are always Vec<i32>; a mis-resolved vec:T
    // (structref layout) makes push store i64 chars into structref slots.
    if emit_target::is_gc_target(clone(target)) && pi == 0 && is_string_byte_vec_param_fn(clone(uf.name)) {
        return sections_types_gc::gc_vec_type_sig()
    }
    // Nested Vec mono params (vec:Vec_i32, vec:vec:i32): MIR type_name selects
    // the structref-array vec layout. Typed spine often still has the flat
    // Vec<i32> alias, which makes count__Vec_i32_ take the wrong param (#808).
    if emit_target::is_gc_target(clone(target)) && starts_with(clone(p_type_name), String_from("vec:")) {
        let nested_coll = sections_types_gc_plan::collection_type_sig(clone(p_type_name), clone(target))
        if eq(clone(nested_coll), sections_types_gc_phase7::gc_vec_struct_ref_type_sig()) {
            return nested_coll
        }
    }
    let typed_sig = sections_types_gc_plan::typed_function_param_sig(
        mir,
        clone(uf.name),
        pi,
        clone(target)
    )
    if len(typed_sig) > 0 {
        return typed_sig
    }
    if starts_with(clone(p_type_name), String_from("enum:")) && emit_target::is_gc_target(clone(target)) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    // Check vec:/hashmap: before the override: the __String override would
    // incorrectly type Vec<String> and HashMap params as plain String.
    let coll_sig = sections_types_gc_plan::collection_type_sig(clone(p_type_name), clone(target))
    if len(coll_sig) > 0 {
        return coll_sig
    }
    if emit_target::is_gc_target(clone(target)) && is_hash_container_type_name(clone(p_type_name)) {
        return sections_types_gc::gc_vec_type_sig()
    }
    let gc_param_sig = sections_types_gc_override::gc_param_type_sig_override(clone(uf.name), pi, clone(p_type_name), clone(target))
    if len(gc_param_sig) > 0 {
        return gc_param_sig
    }
    if emit_target::is_gc_target(clone(target)) &&
    (starts_with(clone(p_type_name), String_from("Option_")) ||
        starts_with(clone(p_type_name), String_from("option:")) ||
        starts_with(clone(p_type_name), String_from("Option:")) ||
        starts_with(clone(p_type_name), String_from("Option<"))) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if emit_target::is_gc_target(clone(target)) &&
    (starts_with(clone(p_type_name), String_from("Result_")) ||
        starts_with(clone(p_type_name), String_from("result:")) ||
        starts_with(clone(p_type_name), String_from("Result:")) ||
        starts_with(clone(p_type_name), String_from("Result<")) ||
        eq(clone(p_type_name), String_from("Result"))) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if emit_target::is_gc_target(clone(target)) && starts_with(clone(p_type_name), String_from("struct:")) {
        return gc_struct_return_sig_from_name(clone(p_type_name), mir)
    }
    // Check if the param type name is a registered gc_struct (raw name without "struct:" prefix).
    if emit_target::is_gc_target(clone(target)) && len(p_type_name) > 0 {
        let slot = module_gc_struct::MirModule_gc_struct_slot(mir, clone(p_type_name))
        if slot >= 0 {
            return concat(String_from("gcsref"), i32_to_string(slot))
        }
    }
    if emit_target::is_gc_target(clone(target)) && (eq(clone(p_type_name), String_from("string")) || eq(clone(p_type_name), String_from("String"))) {
        return sections_types_gc::gc_string_type_sig()
    }
    let generic_sig = build_generic_type_var_sig(clone(uf.name), clone(p_type_name), pi, clone(target), clone(wasi_version), mir)
    if len(generic_sig) > 0 {
        return generic_sig
    }
    sections_type_plan::val_type_to_target_sig(
        local_access::MirLocal_val_type(p),
        emit_target::is_gc_target(clone(target)),
        emit_target::uses_memory64(clone(target), clone(wasi_version))
    )
}

// Type-variable ("?...") signature resolution shared by params and returns.
// Returns empty when the type name is not a type variable on a GC target.
fn build_generic_type_var_sig(
    fn_name: String,
    type_name: String,
    pi: i32,
    target: String,
    wasi_version: String,
    mir: MirModule
) -> String {
    if !emit_target::is_gc_target(clone(target)) {
        return String_new()
    }
    // Composite generic type with type variable (e.g. "?Option:T") — emit
    // as enum open type ref on GC targets.
    if starts_with(clone(type_name), String_from("?Option:")) || starts_with(clone(type_name), String_from("?Result:")) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    // Generic type variable (e.g. "?T") — emit as anyref on GC targets.
    // For specialized mono functions (name contains "__"), try to extract
    // the concrete type from the function name suffix.
    if starts_with(clone(type_name), String_from("?")) {
        let mono_type = sections_types_sigs_mono::resolve_mono_param_type_from_fn_name(clone(fn_name), clone(type_name), pi)
        if len(mono_type) > 0 {
            return widen_i32_sig_for_memory64(
                mono_type,
                emit_target::uses_memory64(clone(target), clone(wasi_version))
            )
        }
        // Fallback: check if the mono type key from the function name is a
        // registered gc_struct (e.g. "Point" in "show__Point").  This handles
        // struct types that mono_type_key_to_sig doesn't know about.
        let gc_struct_sig = sections_types_sigs_mono::try_mono_gc_struct_param_sig(clone(fn_name), clone(type_name), pi, mir)
        if len(gc_struct_sig) > 0 {
            return gc_struct_sig
        }
        return String_from("structref")
    }
    String_new()
}

// Memory64: i32/bool/char scalar values are stored and passed as i64 in wasm.
// Generic-mono type-key resolution currently returns "i32" for those keys, so
// widen only when Memory64 is active (not WASI P2 i32 linear memory, #714).
fn widen_i32_sig_for_memory64(sig: String, memory64: bool) -> String {
    if memory64 && eq(clone(sig), String_from("i32")) {
        return String_from("i64")
    }
    sig
}

// Extract the mono type suffix from a function name.
// For method names like "Picker__echo__i32", the base name contains "__"
// (from "::" → "__"). We try all "__" positions from right to left and
// check if all suffix parts are valid type keys. The rightmost valid
// position is the correct separator.

fn build_return_type_value_sig(
    uf: MirFunction,
    return_type: i32,
    return_type_name: String,
    target: String,
    wasi_version: String,
    mir: MirModule
) -> String {
    // Funcref returns must stay (ref $sig), not GC structref (#832).
    if eq(clone(return_type_name), String_from("fnref")) ||
    starts_with(clone(return_type_name), String_from("fnref")) ||
    eq(clone(return_type_name), String_from("fn")) ||
    starts_with(clone(return_type_name), String_from("fn(")) ||
    return_type == value_types::VT_FUNCREF() {
        return String_from("fnref")
    }
    let typed_sig = sections_types_gc_plan::typed_function_return_sig(mir, clone(uf.name), clone(target))
    if len(typed_sig) > 0 {
        // Typed spine may classify a registered user struct as ENUM/RESULT open
        // (e.g. WitParsedInterface on some return paths). Prefer the concrete
        // gc_struct slot when the MIR return type name names that struct.
        if emit_target::is_gc_target(clone(target)) &&
        eq(clone(typed_sig), sections_types_gc::gc_enum_open_type_sig()) {
            // Prefer a concrete gc_struct only for true user structs. Enum
            // names that were wrongly registered as GS_f0_ref14 boxes must
            // keep open-enum returns (toml_get / JsonValue) (#808).
            let concrete = gc_struct_sig_from_return_type_name(clone(return_type_name), mir)
            if len(concrete) > 0 && !gc_struct_sig_is_enum_open_box(clone(concrete), mir) {
                return concrete
            }
        } else {
            return typed_sig
        }
        return typed_sig
    }
    // vec:/hashmap: return types use the same mapping as params.
    let coll_sig = sections_types_gc_plan::collection_type_sig(clone(return_type_name), clone(target))
    if len(coll_sig) > 0 {
        return coll_sig
    }
    if emit_target::is_gc_target(clone(target)) && is_hash_container_type_name(clone(return_type_name)) {
        return sections_types_gc::gc_vec_type_sig()
    }
    if emit_target::is_gc_target(clone(target)) {
        let mono_method_ret = sections_types_sigs_mono::resolve_mono_method_return_value_sig(clone(uf.name), clone(return_type_name), mir)
        if len(mono_method_ret) > 0 {
            return widen_i32_sig_for_memory64(
                mono_method_ret,
                emit_target::uses_memory64(clone(target), clone(wasi_version))
            )
        }
    }
    if emit_target::is_gc_target(clone(target)) && (eq(clone(return_type_name), String_from("string")) || eq(clone(return_type_name), String_from("String"))) {
        return sections_types_gc::gc_string_type_sig()
    }
    let gc_enum_ret_sig = sections_types_gc_override::gc_enum_return_type_sig(clone(return_type_name), clone(target))
    if len(gc_enum_ret_sig) > 0 {
        return gc_enum_ret_sig
    }
    let gc_ret_sig = sections_types_gc_override::gc_return_type_sig_override(clone(uf.name), clone(return_type_name), clone(target))
    if len(gc_ret_sig) > 0 {
        return gc_ret_sig
    }
    if emit_target::is_gc_target(clone(target)) && starts_with(clone(return_type_name), String_from("struct:")) {
        return gc_struct_return_sig_from_name(clone(return_type_name), mir)
    }
    let registered = gc_struct_sig_from_return_type_name(clone(return_type_name), mir)
    if len(registered) > 0 {
        return registered
    }
    let generic_ret_sig = build_generic_type_var_sig(
        clone(uf.name),
        clone(return_type_name),
        0 - 1,
        clone(target),
        clone(wasi_version),
        mir
    )
    if len(generic_ret_sig) > 0 {
        return widen_i32_sig_for_memory64(
            generic_ret_sig,
            emit_target::uses_memory64(clone(target), clone(wasi_version))
        )
    }
    sections_type_plan::val_type_to_target_sig(
        return_type,
        emit_target::is_gc_target(clone(target)),
        emit_target::uses_memory64(clone(target), clone(wasi_version))
    )
}

// True when a gcsref slot is the single-field open-enum box (GS_f0_ref14)
// produced by wrongly registering an enum layout as a gc_struct.
fn gc_struct_sig_is_enum_open_box(sig_or_gcsref: String, mir: MirModule) -> bool {
    let mut sig = clone(sig_or_gcsref)
    if starts_with(clone(sig), String_from("gcsref")) {
        let slot_str = substring(clone(sig), 6, len(sig))
        let slot = sections_types_gc::parse_type_sig_int(slot_str)
        if slot < 0 || slot >= module_gc_struct::MirModule_gc_struct_sig_count(mir) {
            return false
        }
        sig = module_gc_struct::MirModule_gc_struct_sig_at(mir, slot)
    }
    eq(clone(sig), String_from("GS_f0_ref14"))
}

// Resolve a registered gc_struct for a return type name. Accepts raw names,
// module::Name, and struct:Name:size (slot hit only — not size fallback).
fn gc_struct_sig_from_return_type_name(return_type_name: String, mir: MirModule) -> String {
    if len(return_type_name) == 0 {
        return String_new()
    }
    if starts_with(clone(return_type_name), String_from("struct:")) {
        let from_struct = gc_struct_return_sig_from_name(clone(return_type_name), mir)
        if starts_with(clone(from_struct), String_from("gcsref")) {
            if gc_struct_sig_is_enum_open_box(clone(from_struct), mir) {
                return String_new()
            }
            return from_struct
        }
        return String_new()
    }
    let slot = module_gc_struct::MirModule_gc_struct_slot(mir, clone(return_type_name))
    if slot >= 0 {
        let gcsref = concat(String_from("gcsref"), i32_to_string(slot))
        if gc_struct_sig_is_enum_open_box(clone(gcsref), mir) {
            return String_new()
        }
        return gcsref
    }
    let name_len = len(return_type_name)
    let mut colon_pos = 0 - 1
    let mut ci = name_len - 1
    while ci >= 0 {
        if char_at(return_type_name, ci) == 58 {
            colon_pos = ci
            ci = 0 - 1
        }
        ci = ci - 1
    }
    if colon_pos >= 0 {
        let bare = substring(return_type_name, colon_pos + 1, name_len)
        let bare_slot = module_gc_struct::MirModule_gc_struct_slot(mir, bare)
        if bare_slot >= 0 {
            let gcsref = concat(String_from("gcsref"), i32_to_string(bare_slot))
            if gc_struct_sig_is_enum_open_box(clone(gcsref), mir) {
                return String_new()
            }
            return gcsref
        }
    }
    String_new()
}

fn gc_struct_return_sig_from_name(type_name: String, mir: MirModule) -> String {
    // Format: "struct:TypeName:byte_size"
    // Extract TypeName (between first and last colon).
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let n = len(type_name)
    let mut i = 0
    while i < n {
        if char_at(type_name, i) == ':' {
            if first_colon < 0 {
                first_colon = i
            }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon < 0 {
        return sections_types_gc::gc_struct_type_sig_from_byte_size(4)
    }
    // Extract struct name between first and last colon.
    let struct_name = substring(type_name, first_colon + 1, last_colon)
    // Look up in MIR module's gc_struct list.
    let slot = module_gc_struct::MirModule_gc_struct_slot(mir, clone(struct_name))
    if slot >= 0 {
        // Use "gcsref" + slot as placeholder; resolved during emission via gc_struct_type_map.
        return concat(String_from("gcsref"), i32_to_string(slot))
    }
    // Fallback: extract byte_size and use size-based heuristic.
    let mut byte_size = 0
    let mut j = last_colon + 1
    while j < n {
        let d = char_at(type_name, j)
        if d >= 48 && d <= 57 {
            byte_size = byte_size * 10 + (d - 48)
        } else {
            j = n
        }
        j = j + 1
    }
    sections_types_gc::gc_struct_type_sig_from_byte_size(byte_size)
}
