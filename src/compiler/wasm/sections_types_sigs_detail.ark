fn is_hash_container_type_name(type_name: String) -> bool {
    if type_name.clone().eq(String_from("HashMap")) || type_name.clone().eq(String_from("HashSet")) || type_name.clone().eq(String_from("Vec")) {
        return true
    }
    if type_name.clone().eq(String_from("?HashMap")) || type_name.clone().eq(String_from("?HashSet")) || type_name.clone().eq(String_from("?Vec")) {
        return true
    }
    if type_name.clone().starts_with(String_from("struct:HashMap:")) || type_name.clone().starts_with(String_from("struct:HashSet:")) {
        return true
    }
    false
}

// fn(i32, i32) -> i32 fold callbacks — comma inside the param list.
fn funcref_type_name_is_binary_i32(type_name: String) -> bool {
    if type_name.clone().eq(String_from("fnref2")) {
        return true
    }
    if !type_name.clone().starts_with(String_from("fn(")) {
        return false
    }
    let close = type_name.clone().index_of(String_from(")"))
    if close <= 0 {
        return false
    }
    let params = type_name.clone().slice(3, close)
    params.contains(String_from(","))
}

fn funcref_type_name_is_typed_string_callback(type_name: String) -> bool {
    type_name.clone().eq(String_from("fnrefss")) ||
    type_name.clone().eq(String_from("fnrefsb"))
}

fn typed_string_callback_type_sig(type_name: String, memory64: bool) -> String {
    if type_name.clone().eq(String_from("fnrefss")) {
        return String_from("gcref0_1gcref0")
    }
    if type_name.clone().eq(String_from("fnrefsb")) {
        if memory64 {
            return String_from("gcref0_1i64")
        }
        return String_from("gcref0_1i32")
    }
    String_new()
}

fn funcref_param_sig_for_target(type_name: String, target: String, memory64: bool) -> String {
    if !emit_target::is_gc_target(target.clone()) {
        return String_from("i32")
    }
    if funcref_type_name_is_typed_string_callback(type_name.clone()) {
        return type_name.clone()
    }
    if funcref_type_name_is_binary_i32(type_name.clone()) {
        if memory64 {
            return String_from("fnref2m64")
        }
        return String_from("fnref2")
    }
    if memory64 {
        return String_from("fnrefm64")
    }
    String_from("fnref")
}

fn funcref_return_sig_for_target(target: String, memory64: bool) -> String {
    if emit_target::is_gc_target(target.clone()) {
        if memory64 {
            return String_from("fnrefm64")
        }
        return String_from("fnref")
    }
    String_from("i32")
}

// `fnsig:<param>;<return>` -> `fnsig:<tokP>;<tokR>` where each segment is
// rewritten to a func-sig token (gcrefN/gcsrefN/scalars). Returns empty
// when a segment cannot be represented so callers can fall back to the
// legacy fnref slot (#860).
fn fnsig_param_sig_from_mir(type_name: String, target: String, mir: MirModule) -> String {
    let rest = type_name.clone().slice(6, type_name.len())
    let sep = rest.clone().index_of(String_from(";"))
    if sep < 0 {
        return String_new()
    }
    let param_seg = rest.clone().slice(0, sep)
    let ret_seg = rest.clone().slice(sep + 1, rest.len())
    if ret_seg.clone().contains(String_from(";")) {
        return String_new()
    }
    let param_tok = fnsig_segment_sig_for_mir(param_seg, target.clone(), mir)
    let ret_tok = fnsig_segment_sig_for_mir(ret_seg, target.clone(), mir)
    if param_tok.len() == 0 || ret_tok.len() == 0 {
        return String_new()
    }
    String_from("fnsig:").concat(param_tok.concat(String_from(";").concat(ret_tok)))
}

// One fnsig segment -> func-sig token. Mirrors the field-suffix mapping
// used for GC struct layouts: scalars stay scalar (emit widens i32 under
// Memory64), String is the byte-array gcref0, containers use their fixed
// vec/map offsets, Option/Result/enum land on the open-enum box, and
// registered user structs become gcsref<slot>.
fn fnsig_segment_sig_for_mir(seg: String, target: String, mir: MirModule) -> String {
    if seg.len() == 0 || seg.clone().starts_with(String_from("fnsig:")) {
        return String_new()
    }
    if seg.clone().eq(String_from("i32")) || seg.clone().eq(String_from("I32")) ||
    seg.clone().eq(String_from("bool")) || seg.clone().eq(String_from("Bool")) ||
    seg.clone().eq(String_from("char")) || seg.clone().eq(String_from("u8")) ||
    seg.clone().eq(String_from("i8")) || seg.clone().eq(String_from("u16")) ||
    seg.clone().eq(String_from("i16")) || seg.clone().eq(String_from("u32")) {
        return String_from("i32")
    }
    if seg.clone().eq(String_from("i64")) || seg.clone().eq(String_from("I64")) ||
    seg.clone().eq(String_from("u64")) {
        return String_from("i64")
    }
    if seg.clone().eq(String_from("f64")) || seg.clone().eq(String_from("F64")) {
        return String_from("f64")
    }
    if seg.clone().eq(String_from("f32")) || seg.clone().eq(String_from("F32")) {
        return String_from("f32")
    }
    if seg.clone().eq(String_from("v128")) || seg.clone().eq(String_from("V128")) {
        return String_from("v128")
    }
    if seg.clone().eq(String_from("fnref")) || seg.clone().starts_with(String_from("fnref")) {
        return String_from("fnref")
    }
    if seg.clone().eq(String_from("String")) || seg.clone().eq(String_from("string")) {
        return sections_types_gc::gc_string_type_sig()
    }
    let coll = sections_types_gc_plan::collection_type_sig(mir, seg.clone(), target.clone())
    if coll.len() > 0 {
        return coll
    }
    if seg.clone().starts_with(String_from("option:")) ||
    seg.clone().starts_with(String_from("result:")) ||
    seg.clone().starts_with(String_from("enum:")) ||
    seg.clone().starts_with(String_from("Option")) ||
    seg.clone().starts_with(String_from("Result")) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    let slot = module_gc_struct::MirModule_gc_struct_slot(mir, seg.clone())
    if slot >= 0 {
        return String_from("gcsref").concat((slot).to_string())
    }
    String_new()
}

fn build_function_type_sig(uf: MirFunction, target: String, wasi_version: String, memory64: bool, mir: MirModule) -> String {
    let mut sig = String_new()
    let pc = function_param_view::MirFunction_param_count(uf)
    let mut pi = 0
    while pi < pc {
        let p = function_param_view::MirFunction_param_at(uf, pi)
        sig = sig.concat(build_param_type_sig(uf, p, pi, target.clone(), wasi_version.clone(), memory64, mir))
        sig = sig.concat(String_from("_"))
        pi = pi + 1
    }
    let return_type = function_return_view::MirFunction_return_type(uf)
    let return_type_name = function_return_view::MirFunction_return_type_name(uf)
    sig = sig.concat(build_return_type_sig(uf, return_type, return_type_name, target, wasi_version, memory64, mir))
    sig
}

fn p2_is_string_type_name(type_name: String) -> bool {
    type_name.clone().eq(String_from("string")) ||
    type_name.clone().eq(String_from("String"))
}

fn p2_is_supported_scalar_type(value_type: i32) -> bool {
    value_type == value_types::VT_I32() ||
    value_type == value_types::VT_I64() ||
    value_type == value_types::VT_F32() ||
    value_type == value_types::VT_F64()
}

fn p2_return_type_is_compound(type_name: String) -> bool {
    type_name.clone().starts_with(String_from("tuple:")) ||
    type_name.clone().starts_with(String_from("struct:")) ||
    type_name.clone().starts_with(String_from("vec:")) ||
    type_name.clone().starts_with(String_from("hashmap:")) ||
    type_name.clone().starts_with(String_from("HashMap")) ||
    type_name.clone().starts_with(String_from("HashSet")) ||
    type_name.clone().starts_with(String_from("Option")) ||
    type_name.clone().starts_with(String_from("option:")) ||
    type_name.clone().starts_with(String_from("Result")) ||
    type_name.clone().starts_with(String_from("result:")) ||
    type_name.clone().starts_with(String_from("enum:")) ||
    type_name.clone().contains(String_from(","))
}

fn p2_is_option_type_name(type_name: String) -> bool {
    type_name.clone().eq(String_from("Option")) ||
    type_name.clone().starts_with(String_from("Option:")) ||
    type_name.clone().starts_with(String_from("Option_")) ||
    type_name.clone().starts_with(String_from("Option<")) ||
    type_name.clone().starts_with(String_from("option:")) ||
    type_name.clone().starts_with(String_from("option<"))
}

fn p2_is_result_type_name(type_name: String) -> bool {
    type_name.clone().eq(String_from("Result")) ||
    type_name.clone().starts_with(String_from("Result:")) ||
    type_name.clone().starts_with(String_from("Result_")) ||
    type_name.clone().starts_with(String_from("Result<")) ||
    type_name.clone().starts_with(String_from("result:")) ||
    type_name.clone().starts_with(String_from("result<"))
}

fn p2_is_list_type_name(type_name: String) -> bool {
    type_name.clone().eq(String_from("Vec")) ||
    type_name.clone().starts_with(String_from("Vec:")) ||
    type_name.clone().starts_with(String_from("Vec_")) ||
    type_name.clone().starts_with(String_from("Vec<")) ||
    type_name.clone().starts_with(String_from("vec:")) ||
    type_name.clone().starts_with(String_from("vec<"))
}

fn p2_is_tuple_type_name(type_name: String) -> bool {
    type_name.clone().starts_with(String_from("Tuple:")) ||
    type_name.clone().starts_with(String_from("Tuple_")) ||
    type_name.clone().starts_with(String_from("Tuple<")) ||
    type_name.clone().starts_with(String_from("tuple:")) ||
    type_name.clone().starts_with(String_from("tuple<"))
}

fn p2_type_argument(type_name: String, index: i32) -> String {
    let mut body = type_name.clone()
    let angle = body.clone().index_of(String_from("<"))
    let underscore_form = angle < 0 && body.clone().index_of(String_from(":")) < 0 &&
    (body.clone().starts_with(String_from("Option_")) ||
        body.clone().starts_with(String_from("Result_")) ||
        body.clone().starts_with(String_from("Vec_")) ||
        body.clone().starts_with(String_from("Tuple_")))
    if angle >= 0 {
        let rest = body.clone().slice(angle + 1, body.len())
        let close = rest.clone().index_of(String_from(">"))
        if close >= 0 {
            body = rest.slice(0, close)
        }
    } else {
        let colon = body.clone().index_of(String_from(":"))
        if colon < 0 {
            let underscore = body.clone().index_of(String_from("_"))
            if underscore >= 0 && (p2_is_option_type_name(type_name.clone()) ||
                p2_is_result_type_name(type_name.clone()) ||
                p2_is_list_type_name(type_name.clone()) ||
                p2_is_tuple_type_name(type_name.clone())) {
                body = body.slice(underscore + 1, body.len())
            } else {
                if p2_is_option_type_name(type_name.clone()) && index == 0 {
                    return String_from("i32")
                }
                if p2_is_result_type_name(type_name.clone()) {
                    return String_from("i32")
                }
                return String_new()
            }
        } else {
            body = body.slice(colon + 1, body.len())
        }
    }
    let mut current = 0
    let mut start = 0
    let mut i = 0
    let mut depth = 0
    while i <= body.len() {
        let at_end = i == body.len()
        let c = if at_end { 44 } else { body.clone().byte_at(i) }
        if c == 60 {
            depth = depth + 1
        } else if c == 62 {
            depth = depth - 1
        }
        if ((c == 44 || c == 58 || (underscore_form && c == 95)) && depth == 0) || at_end {
            if current == index {
                return body.clone().slice(start, i)
            }
            current = current + 1
            start = i + 1
        }
        i = i + 1
    }
    String_new()
}

fn p2_enum_type_name(type_name: String) -> String {
    if type_name.clone().starts_with(String_from("enum:")) {
        return type_name.slice(5, type_name.len())
    }
    type_name
}

fn p2_enum_variant_matches(enum_name: String, variant_name: String) -> bool {
    module_gc_enum::MirModule_gc_enum_variant_matches(enum_name.clone(), variant_name)
}

fn p2_enum_has_variants(type_name: String, mir: MirModule) -> bool {
    module_gc_enum::MirModule_gc_enum_base_has_variants(mir, type_name)
}

fn p2_merge_enum_payload(mut payload: Vec<String>, field: String) {
    if payload.len() == 0 {
        payload.push(field.clone())
        return
    }
    let current = get_unchecked(payload, 0)
    if current.clone().eq(field.clone()) {
        return
    }
    if field.clone().eq(String_from("f64")) ||
    field.clone().eq(String_from("i64")) ||
    current.clone().eq(String_from("i32")) {
        payload.set(0, field.clone())
    }
}

fn p2_enum_payload_sigs(type_name: String, mir: MirModule) -> Vec<String> {
    let names = module_gc_enum::MirModule_gc_enum_variant_names(mir)
    let sigs = module_gc_enum::MirModule_gc_enum_variant_sigs(mir)
    let mut payload = Vec::new<String>()
    let mut i = 0
    while i < names.len() {
        if i < sigs.len() && p2_enum_variant_matches(type_name.clone(), get_unchecked(names, i)) {
            let fields = sections_types_gc::struct_field_sigs(get_unchecked(sigs, i))
            let mut fi = 1
            while fi < fields.len() {
                let field = get_unchecked(fields, fi)
                p2_merge_enum_payload(payload, field)
                fi = fi + 1
            }
        }
        i = i + 1
    }
    payload
}

fn p2_struct_name_from_type(type_name: String) -> String {
    if type_name.clone().starts_with(String_from("struct:")) {
        let first: i32 = type_name.clone().index_of(String_from(":"))
        let mut last = first
        let mut i = first + 1
        while i < type_name.len() {
            if type_name.clone().byte_at(i) == 58 {
                last = i
            }
            i = i + 1
        }
        if first >= 0 && last > first {
            return type_name.slice(first + 1, last)
        }
    }
    type_name
}

fn p2_struct_field_sigs(type_name: String, mir: MirModule) -> Vec<String> {
    let name = p2_struct_name_from_type(type_name.clone())
    let mut slot = module_gc_struct::MirModule_gc_struct_slot(mir, name.clone())
    if slot < 0 {
        let mut last = 0 - 1
        let mut i = name.len() - 1
        while i >= 0 {
            if name.clone().byte_at(i) == 58 {
                last = i
                i = 0 - 1
            }
            i = i - 1
        }
        if last >= 0 {
            slot = module_gc_struct::MirModule_gc_struct_slot(
                mir,
                name.clone().slice(last + 1, name.len())
            )
        }
    }
    if slot < 0 {
        return Vec::new<String>()
    }
    sections_types_gc::struct_field_sigs(
        module_gc_struct::MirModule_gc_struct_sig_at(mir, slot)
    )
}

fn p2_field_flat_count(field_sig: String) -> i32 {
    if field_sig.clone().eq(String_from("ref0")) ||
    field_sig.clone().eq(String_from("string")) {
        return 2
    }
    1
}

fn p2_field_canonical_sig(field_sig: String) -> String {
    if field_sig.clone().eq(String_from("i64")) {
        return String_from("i64")
    }
    if field_sig.clone().eq(String_from("f64")) {
        return String_from("f64")
    }
    if field_sig.clone().eq(String_from("f32")) {
        return String_from("f32")
    }
    if field_sig.clone().eq(String_from("ref0")) {
        return String_from("i32_i32")
    }
    String_from("i32")
}

fn p2_value_canonical_sig(type_name: String, value_type: i32, mir: MirModule) -> String {
    if p2_is_string_type_name(type_name.clone()) {
        return String_from("i32_i32")
    }
    if type_name.clone().eq(String_from("bool")) || type_name.clone().eq(String_from("char")) ||
    type_name.clone().eq(String_from("u8")) || type_name.clone().eq(String_from("u16")) ||
    type_name.clone().eq(String_from("u32")) || type_name.clone().eq(String_from("i8")) ||
    type_name.clone().eq(String_from("i16")) || type_name.clone().eq(String_from("i32")) {
        return String_from("i32")
    }
    if type_name.clone().eq(String_from("i64")) || type_name.clone().eq(String_from("u64")) {
        return String_from("i64")
    }
    if type_name.clone().eq(String_from("f32")) {
        return String_from("f32")
    }
    if type_name.clone().eq(String_from("f64")) {
        return String_from("f64")
    }
    if p2_is_list_type_name(type_name.clone()) || p2_is_tuple_type_name(type_name.clone()) ||
    p2_is_option_type_name(type_name.clone()) || p2_is_result_type_name(type_name.clone()) ||
    p2_return_type_is_compound(type_name.clone()) || p2_enum_has_variants(type_name.clone(), mir) ||
    value_type == value_types::VT_GC_REF() || value_type == value_types::VT_REF() {
        return String_from("i32")
    }
    p2_scalar_type_sig(value_type)
}

fn p2_flat_value_count(type_name: String, value_type: i32, mir: MirModule) -> i32 {
    if p2_is_string_type_name(type_name.clone()) {
        return 2
    }
    if p2_is_list_type_name(type_name.clone()) || p2_is_tuple_type_name(type_name.clone()) ||
    p2_is_option_type_name(type_name.clone()) || p2_is_result_type_name(type_name.clone()) ||
    p2_return_type_is_compound(type_name.clone()) || p2_enum_has_variants(type_name.clone(), mir) {
        return 1
    }
    1
}

fn p2_type_is_aggregate(type_name: String, value_type: i32, mir: MirModule) -> bool {
    p2_is_string_type_name(type_name.clone()) ||
    p2_is_list_type_name(type_name.clone()) ||
    p2_is_tuple_type_name(type_name.clone()) ||
    p2_is_option_type_name(type_name.clone()) ||
    p2_is_result_type_name(type_name.clone()) ||
    p2_return_type_is_compound(type_name.clone()) ||
    p2_enum_has_variants(type_name.clone(), mir) ||
    value_type == value_types::VT_GC_REF() || value_type == value_types::VT_REF()
}

fn p2_canonical_param_count_for_type(type_name: String, value_type: i32, mir: MirModule) -> i32 {
    if p2_is_string_type_name(type_name.clone()) || p2_is_list_type_name(type_name.clone()) {
        return 2
    }
    if p2_is_option_type_name(type_name.clone()) {
        let inner = p2_type_argument(type_name.clone(), 0)
        if inner.clone().eq(String_from("bool")) {
            return 1
        }
        return 1 + p2_flat_value_count(inner.clone(), value_type, mir)
    }
    if p2_is_result_type_name(type_name.clone()) {
        let ok = p2_flat_value_count(p2_type_argument(type_name.clone(), 0), value_type, mir)
        let err = p2_flat_value_count(p2_type_argument(type_name.clone(), 1), value_type, mir)
        let mut payload_count = ok
        if err > ok {
            payload_count = err
        }
        return 1 + payload_count
    }
    if p2_is_tuple_type_name(type_name.clone()) {
        let mut count = 0
        let mut i = 0
        while p2_type_argument(type_name.clone(), i).len() > 0 {
            count = count + p2_flat_value_count(p2_type_argument(type_name.clone(), i), value_type, mir)
            i = i + 1
        }
        return count
    }
    let fields = p2_struct_field_sigs(type_name.clone(), mir)
    if fields.len() > 0 && !p2_enum_has_variants(type_name.clone(), mir) {
        let mut count = 0
        let mut i = 0
        while i < fields.len() {
            count = count + p2_field_flat_count(get_unchecked(fields, i))
            i = i + 1
        }
        return count
    }
    let payload = p2_enum_payload_sigs(type_name.clone(), mir)
    if payload.len() > 0 {
        return 1 + p2_field_flat_count(get_unchecked(payload, 0))
    }
    1
}

fn p2_canonical_param_type_sig(param: MirLocal, mir: MirModule) -> String {
    let type_name = local_access::MirLocal_type_name(param)
    let value_type = local_access::MirLocal_val_type(param)
    if p2_is_string_type_name(type_name.clone()) || p2_is_list_type_name(type_name.clone()) {
        return if p2_is_string_type_name(type_name.clone()) { String_from("i32_i32") } else { String_from("i32_i32") }
    }
    if p2_is_option_type_name(type_name.clone()) {
        let inner = p2_type_argument(type_name.clone(), 0)
        if inner.clone().eq(String_from("bool")) {
            return String_from("i32")
        }
        return String_from("i32_").concat(p2_value_canonical_sig(inner.clone(), value_type, mir))
    }
    if p2_is_result_type_name(type_name.clone()) {
        let ok = p2_value_canonical_sig(p2_type_argument(type_name.clone(), 0), value_type, mir)
        let err = p2_value_canonical_sig(p2_type_argument(type_name.clone(), 1), value_type, mir)
        if ok.clone().eq(err.clone()) {
            return String_from("i32_").concat(ok)
        }
        if ok.clone().eq(String_from("i32_i32")) || err.clone().eq(String_from("i32_i32")) {
            return String_from("i32_i32_i32")
        }
        return String_from("i32_").concat(ok)
    }
    if p2_is_tuple_type_name(type_name.clone()) {
        let mut sig = String_new()
        let mut i = 0
        while p2_type_argument(type_name.clone(), i).len() > 0 {
            sig = sig.clone().concat(p2_value_canonical_sig(p2_type_argument(type_name.clone(), i), value_type, mir).concat("_"))
            i = i + 1
        }
        if sig.len() > 0 {
            return sig.slice(0, sig.len() - 1)
        }
    }
    let fields = p2_struct_field_sigs(type_name.clone(), mir)
    if fields.len() > 0 && !p2_enum_has_variants(type_name.clone(), mir) {
        let mut sig = String_new()
        let mut i = 0
        while i < fields.len() {
            sig = sig.clone().concat(p2_field_canonical_sig(get_unchecked(fields, i)).concat("_"))
            i = i + 1
        }
        return sig.slice(0, sig.len() - 1)
    }
    let payload = p2_enum_payload_sigs(type_name.clone(), mir)
    if payload.len() > 0 {
        return String_from("i32_").concat(p2_field_canonical_sig(get_unchecked(payload, 0)))
    }
    p2_value_canonical_sig(type_name.clone(), value_type, mir)
}

fn p2_scalar_type_sig(value_type: i32) -> String {
    if value_type == value_types::VT_I32() {
        return String_from("i32")
    }
    if value_type == value_types::VT_I64() {
        return String_from("i64")
    }
    if value_type == value_types::VT_F32() {
        return String_from("f32")
    }
    if value_type == value_types::VT_F64() {
        return String_from("f64")
    }
    String_new()
}

fn p2_is_supported_scalar_name(type_name: String) -> bool {
    p2_is_string_type_name(type_name.clone()) ||
    type_name.clone().eq(String_from("bool")) ||
    type_name.clone().eq(String_from("char")) ||
    type_name.clone().eq(String_from("u8")) ||
    type_name.clone().eq(String_from("u16")) ||
    type_name.clone().eq(String_from("u32")) ||
    type_name.clone().eq(String_from("u64")) ||
    type_name.clone().eq(String_from("i8")) ||
    type_name.clone().eq(String_from("i16")) ||
    type_name.clone().eq(String_from("i32")) ||
    type_name.clone().eq(String_from("i64")) ||
    type_name.clone().eq(String_from("f32")) ||
    type_name.clone().eq(String_from("f64"))
}

fn p2_is_supported_storage_field(field_sig: String) -> bool {
    field_sig.clone().eq(String_from("i32")) ||
    field_sig.clone().eq(String_from("i64")) ||
    field_sig.clone().eq(String_from("f32")) ||
    field_sig.clone().eq(String_from("f64"))
}

fn p2_supported_list_element(type_name: String) -> bool {
    let element = p2_type_argument(type_name.clone(), 0)
    if element.len() == 0 || !p2_is_supported_scalar_name(element.clone()) {
        return false
    }
    // The current adapter copies list elements through i32 loads/stores. It
    // must not claim support for a GC array whose element is a reference or a
    // wider floating/integer value.
    element.clone().eq(String_from("bool")) ||
    element.clone().eq(String_from("char")) ||
    element.clone().eq(String_from("u8")) ||
    element.clone().eq(String_from("u16")) ||
    element.clone().eq(String_from("u32")) ||
    element.clone().eq(String_from("i8")) ||
    element.clone().eq(String_from("i16")) ||
    element.clone().eq(String_from("i32"))
}

fn p2_supported_record_fields(type_name: String, mir: MirModule) -> bool {
    let fields = p2_struct_field_sigs(type_name.clone(), mir)
    if fields.len() == 0 {
        return false
    }
    let mut i = 0
    while i < fields.len() {
        if !p2_is_supported_storage_field(get_unchecked(fields, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn p2_supported_tuple_arguments(type_name: String) -> bool {
    let first = p2_type_argument(type_name.clone(), 0)
    if first.len() == 0 {
        return false
    }
    let mut i = 0
    while p2_type_argument(type_name.clone(), i).len() > 0 {
        let element = p2_type_argument(type_name.clone(), i)
        if !p2_is_supported_scalar_name(element.clone()) ||
        p2_is_string_type_name(element.clone()) {
            return false
        }
        i = i + 1
    }
    true
}

fn p2_supported_option_or_result(type_name: String) -> bool {
    if type_name.clone().eq(String_from("Option")) ||
    type_name.clone().eq(String_from("Result")) {
        return false
    }
    let first = p2_type_argument(type_name.clone(), 0)
    if first.len() == 0 {
        return false
    }
    if p2_is_option_type_name(type_name.clone()) {
        return p2_is_supported_scalar_name(first.clone())
    }
    let second = p2_type_argument(type_name.clone(), 1)
    if second.len() == 0 {
        return false
    }
    p2_is_supported_scalar_name(first.clone()) && p2_is_supported_scalar_name(second.clone())
}

fn p2_supported_enum_payloads(type_name: String, mir: MirModule) -> bool {
    if !p2_enum_has_variants(type_name.clone(), mir) {
        return false
    }
    let names = module_gc_enum::MirModule_gc_enum_variant_names(mir)
    let sigs = module_gc_enum::MirModule_gc_enum_variant_sigs(mir)
    let mut payload_sig = String_new()
    let mut i = 0
    while i < names.len() {
        if i < sigs.len() && p2_enum_variant_matches(type_name.clone(), get_unchecked(names, i)) {
            let fields = sections_types_gc::struct_field_sigs(get_unchecked(sigs, i))
            if fields.len() > 2 {
                return false
            }
            if fields.len() == 2 {
                let field = get_unchecked(fields, 1)
                if !p2_is_supported_storage_field(field.clone()) {
                    return false
                }
                if payload_sig.len() == 0 {
                    payload_sig = field.clone()
                } else if !payload_sig.clone().eq(field.clone()) {
                    return false
                }
            }
        }
        i = i + 1
    }
    true
}

fn p2_wrapper_type_is_supported(
    type_name: String,
    value_type: i32,
    mir: MirModule
) -> bool {
    if p2_is_string_type_name(type_name.clone()) {
        return true
    }
    if p2_is_supported_scalar_type(value_type) &&
    (type_name.len() == 0 || p2_is_supported_scalar_name(type_name.clone())) {
        return true
    }
    if p2_is_list_type_name(type_name.clone()) {
        return p2_supported_list_element(type_name.clone())
    }
    if p2_is_option_type_name(type_name.clone()) ||
    p2_is_result_type_name(type_name.clone()) {
        return p2_supported_option_or_result(type_name.clone())
    }
    if p2_is_tuple_type_name(type_name.clone()) {
        return p2_supported_tuple_arguments(type_name.clone())
    }
    if p2_enum_has_variants(type_name.clone(), mir) {
        return p2_supported_enum_payloads(type_name.clone(), mir)
    }
    if p2_return_type_is_compound(type_name.clone()) {
        return p2_supported_record_fields(type_name.clone(), mir)
    }
    false
}

// The raw GC ABI is private to the core module. A P2 library export needs a
// core-module wrapper whenever a public WIT value crosses that boundary in a
// representation different from the scalar standard32 ABI.
fn p2_function_needs_string_wrapper(
    f: MirFunction,
    target: String,
    wasi_version: String,
    mir: MirModule
) -> bool {
    if !emit_target::is_gc_target(target.clone()) || !emit_target::is_p2_wasi(wasi_version.clone()) {
        return false
    }
    let mut needs_wrapper = false
    let param_count = function_param_view::MirFunction_param_count(f)
    let mut pi = 0
    while pi < param_count {
        let param = function_param_view::MirFunction_param_at(f, pi)
        let type_name = local_access::MirLocal_type_name(param)
        if !p2_wrapper_type_is_supported(
            type_name.clone(),
            local_access::MirLocal_val_type(param),
            mir
        ) {
            return false
        }
        if p2_is_string_type_name(type_name.clone()) {
            needs_wrapper = true
        } else if !p2_is_supported_scalar_type(local_access::MirLocal_val_type(param)) {
            if local_access::MirLocal_val_type(param) == value_types::VT_FUNCREF() {
                return false
            }
            needs_wrapper = true
        } else if p2_return_type_is_compound(type_name.clone()) {
            needs_wrapper = true
        }
        pi = pi + 1
    }
    let return_type = function_return_view::MirFunction_return_type(f)
    let return_type_name = function_return_view::MirFunction_return_type_name(f)
    if return_type == value_types::VT_VOID() {
        return needs_wrapper
    }
    if !p2_wrapper_type_is_supported(return_type_name.clone(), return_type, mir) {
        return false
    }
    if p2_is_string_type_name(return_type_name.clone()) {
        return true
    }
    if !p2_is_supported_scalar_type(return_type) {
        return return_type != value_types::VT_FUNCREF()
    }
    p2_return_type_is_compound(return_type_name.clone()) || needs_wrapper
}

fn p2_canonical_function_type_sig(f: MirFunction, mir: MirModule) -> String {
    let mut sig = String_new()
    let param_count = function_param_view::MirFunction_param_count(f)
    let mut pi = 0
    while pi < param_count {
        let param = function_param_view::MirFunction_param_at(f, pi)
        sig = sig.clone().concat(p2_canonical_param_type_sig(param, mir).concat("_"))
        pi = pi + 1
    }
    let return_type = function_return_view::MirFunction_return_type(f)
    if return_type == value_types::VT_VOID() {
        return sig.clone().concat("0")
    }
    let return_type_name = function_return_view::MirFunction_return_type_name(f)
    if p2_is_string_type_name(return_type_name.clone()) ||
    p2_return_type_is_compound(return_type_name.clone()) ||
    !p2_is_supported_scalar_type(return_type) {
        return sig.clone().concat("1i32")
    }
    sig.clone().concat("1".concat(p2_scalar_type_sig(return_type)))
}

fn p2_post_type_sig_for_function(f: MirFunction, function_sig: String) -> String {
    let return_type_name = function_return_view::MirFunction_return_type_name(f)
    let return_type = function_return_view::MirFunction_return_type(f)
    if return_type == value_types::VT_VOID() {
        return String_from("0")
    }
    if p2_is_string_type_name(return_type_name.clone()) {
        return String_from("i32_0")
    }
    if p2_return_type_is_compound(return_type_name.clone()) ||
    !p2_is_supported_scalar_type(return_type) {
        return String_from("i32_0")
    }
    let mut result_start = 0
    let mut i = 0
    while i < function_sig.len() {
        if function_sig.byte_at(i) == 95 {
            result_start = i + 1
        }
        i = i + 1
    }
    let result_sig = function_sig.slice(result_start, function_sig.len())
    if result_sig.clone().eq("0") {
        return "0"
    }
    result_sig.clone().slice(1, result_sig.len()).concat("_0")
}

fn build_return_type_sig(
    uf: MirFunction,
    return_type: i32,
    return_type_name: String,
    target: String,
    wasi_version: String,
    memory64: bool,
    mir: MirModule
) -> String {
    if return_type == 0 {
        return String_from("0")
    }
    String_from("1").concat(build_return_type_value_sig(uf, return_type, return_type_name, target, wasi_version, memory64, mir))
}

fn is_string_byte_vec_param_fn(fn_name: String) -> bool {
    // Only byte-buffer helpers whose first parameter is actually Vec<i32>
    // should be forced to the vec structref type. ascii_case_impl takes a
    // String (an i8 array) as its source parameter, so it must keep the
    // string GC array signature.
    fn_name.clone().eq(String_from("__core_string_push_range")) ||
    fn_name.clone().eq(String_from("__core_string_push_byte"))
}

fn build_param_type_sig(
    uf: MirFunction,
    p: MirLocal,
    pi: i32,
    target: String,
    wasi_version: String,
    memory64: bool,
    mir: MirModule
) -> String {
    build_param_type_sig_named(
        uf.name.clone(),
        local_access::MirLocal_type_name(p),
        local_access::MirLocal_val_type(p),
        pi,
        target,
        wasi_version,
        memory64,
        mir
    )
}

// Spine-safe form used by the fused in-loop emit (#851): identical
// segment selection to build_param_type_sig, taking the fields the
// MirLocal read supplied so forward callees resolve from the
// signature registry before their MirFunction exists.
fn build_param_type_sig_named(
    fn_name: String,
    p_type_name: String,
    p_val_type: i32,
    pi: i32,
    target: String,
    wasi_version: String,
    memory64: bool,
    mir: MirModule
) -> String {
    // Uniform env param of pair-ABI trampolines/thunks (#872). On GC it is
    // a plain structref so every closure env type fits one call signature;
    // on linear it is an i32 record pointer.
    if p_type_name.clone().eq(String_from("structref")) {
        if emit_target::is_gc_target(target.clone()) {
            return String_from("structref")
        }
        return String_from("i32")
    }
    // fn values are {fnptr, env} pairs under the managed closure ABI
    // (#872): one shared __fnpair struct type covers every callback
    // signature, replacing the per-signature funcref slots. The legacy
    // paths below remain as fallbacks when no pair record exists.
    if p_type_name.clone().starts_with(String_from("fnsig:")) ||
    p_type_name.clone().eq(String_from("fnref")) ||
    p_type_name.clone().starts_with(String_from("fnref")) ||
    p_val_type == value_types::VT_FUNCREF() ||
    p_type_name.clone().starts_with(String_from("fn(")) {
        if emit_target::is_gc_target(target.clone()) {
            let pair_slot = module_gc_struct::MirModule_gc_struct_slot(mir, "__fnpair")
            if pair_slot >= 0 {
                return String_from("gcsref").concat((pair_slot).to_string())
            }
        }
        if p_type_name.clone().starts_with(String_from("fnsig:")) {
            if !emit_target::is_gc_target(target.clone()) {
                return String_from("i32")
            }
            let fnsig_sig = fnsig_param_sig_from_mir(p_type_name.clone(), target.clone(), mir)
            if fnsig_sig.len() > 0 {
                return fnsig_sig
            }
            return funcref_param_sig_for_target(String_from("fnref"), target.clone(), memory64)
        }
        return funcref_param_sig_for_target(p_type_name.clone(), target.clone(), memory64)
    }
    // `fnsig:<param>;<return>` callback params embed a concrete signature.
    // Segments resolve to func-sig tokens here (mir is available) so the
    // emitted type section can reference the exact callback type (#860).
    // String byte-buffer helpers are always Vec<i32>; a mis-resolved vec:T
    // (structref layout) makes push store i64 chars into structref slots.
    if emit_target::is_gc_target(target.clone()) && pi == 0 && is_string_byte_vec_param_fn(fn_name.clone()) {
        return sections_types_gc::gc_vec_type_sig()
    }
    // Nested Vec mono params (vec:Vec_i32, vec:vec:i32): MIR type_name selects
    // the structref-array vec layout. Typed spine often still has the flat
    // Vec<i32> alias, which makes count__Vec_i32_ take the wrong param (#808).
    if emit_target::is_gc_target(target.clone()) && p_type_name.clone().starts_with(String_from("vec:")) {
        let nested_coll = sections_types_gc_plan::collection_type_sig(mir, p_type_name.clone(), target.clone())
        if nested_coll.clone().eq(sections_types_gc_phase7::gc_vec_struct_ref_type_sig()) {
            return nested_coll
        }
    }
    let typed_sig = sections_types_gc_plan::typed_function_param_sig(
        mir,
        fn_name.clone(),
        pi,
        target.clone()
    )
    if typed_sig.len() > 0 {
        return typed_sig
    }
    if p_type_name.clone().starts_with(String_from("enum:")) && emit_target::is_gc_target(target.clone()) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    // Check vec:/hashmap: before the override: the __String override would
    // incorrectly type Vec<String> and HashMap params as plain String.
    let coll_sig = sections_types_gc_plan::collection_type_sig(mir, p_type_name.clone(), target.clone())
    if coll_sig.len() > 0 {
        return coll_sig
    }
    if emit_target::is_gc_target(target.clone()) && is_hash_container_type_name(p_type_name.clone()) {
        return sections_types_gc::gc_vec_type_sig()
    }
    let gc_param_sig = sections_types_gc_override::gc_param_type_sig_override(fn_name.clone(), pi, p_type_name.clone(), target.clone())
    if gc_param_sig.len() > 0 {
        return gc_param_sig
    }
    if emit_target::is_gc_target(target.clone()) &&
    (p_type_name.clone().starts_with(String_from("Option_")) ||
        p_type_name.clone().starts_with(String_from("option:")) ||
        p_type_name.clone().starts_with(String_from("Option:")) ||
        p_type_name.clone().starts_with(String_from("Option<"))) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if emit_target::is_gc_target(target.clone()) &&
    (p_type_name.clone().starts_with(String_from("Result_")) ||
        p_type_name.clone().starts_with(String_from("result:")) ||
        p_type_name.clone().starts_with(String_from("Result:")) ||
        p_type_name.clone().starts_with(String_from("Result<")) ||
        p_type_name.clone().eq(String_from("Result"))) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if emit_target::is_gc_target(target.clone()) && p_type_name.clone().starts_with(String_from("struct:")) {
        return gc_struct_return_sig_from_name(p_type_name.clone(), mir)
    }
    // Check if the param type name is a registered gc_struct (raw name without "struct:" prefix).
    if emit_target::is_gc_target(target.clone()) && p_type_name.len() > 0 {
        let slot = module_gc_struct::MirModule_gc_struct_slot(mir, p_type_name.clone())
        if slot >= 0 {
            return String_from("gcsref").concat((slot).to_string())
        }
    }
    // 'Head<Args>' enum instantiations (e.g. Box<WitType>): same open-enum
    // arm as the return path; without it a generic enum param falls to the
    // VT_GC_REF single-field-struct fallback (#860).
    if emit_target::is_gc_target(target.clone()) &&
    p2_return_type_name_is_enum_instance(p_type_name.clone(), mir) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if emit_target::is_gc_target(target.clone()) && (p_type_name.clone().eq(String_from("string")) || p_type_name.clone().eq(String_from("String"))) {
        return sections_types_gc::gc_string_type_sig()
    }
    let generic_sig = build_generic_type_var_sig(fn_name.clone(), p_type_name.clone(), pi, target.clone(), wasi_version.clone(), memory64, mir)
    if generic_sig.len() > 0 {
        return generic_sig
    }
    sections_type_plan::val_type_to_target_sig(
        p_val_type,
        emit_target::is_gc_target(target.clone()),
        memory64
    )
}

// Type-variable ("?...") signature resolution shared by params and returns.
// Returns empty when the type name is not a type variable on a GC target.
fn build_generic_type_var_sig(
    fn_name: String,
    type_name: String,
    pi: i32,
    target: String,
    wasi_version: String,
    memory64: bool,
    mir: MirModule
) -> String {
    if !emit_target::is_gc_target(target.clone()) {
        return String_new()
    }
    // Composite generic type with type variable (e.g. "?Option:T") — emit
    // as enum open type ref on GC targets.
    if type_name.clone().starts_with(String_from("?Option:")) || type_name.clone().starts_with(String_from("?Result:")) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    // Generic type variable (e.g. "?T") — emit as anyref on GC targets.
    // For specialized mono functions (name contains "__"), try to extract
    // the concrete type from the function name suffix.
    if type_name.clone().starts_with(String_from("?")) {
        let mono_type = sections_types_sigs_mono::resolve_mono_param_type_from_fn_name(fn_name.clone(), type_name.clone(), pi)
        if mono_type.len() > 0 {
            return widen_i32_sig_for_memory64(
                mono_type,
                memory64
            )
        }
        // Fallback: check if the mono type key from the function name is a
        // registered gc_struct (e.g. "Point" in "show__Point").  This handles
        // struct types that mono_type_key_to_sig doesn't know about.
        let gc_struct_sig = sections_types_sigs_mono::try_mono_gc_struct_param_sig(fn_name.clone(), type_name.clone(), pi, mir)
        if gc_struct_sig.len() > 0 {
            return gc_struct_sig
        }
        return String_from("structref")
    }
    String_new()
}

// Memory64: i32/bool/char scalar values are stored and passed as i64 in wasm.
// Generic-mono type-key resolution currently returns "i32" for those keys, so
// widen only when Memory64 is active (not WASI P2 i32 linear memory, #714).
fn widen_i32_sig_for_memory64(sig: String, memory64: bool) -> String {
    if memory64 && sig.clone().eq(String_from("i32")) {
        return String_from("i64")
    }
    sig
}

// Extract the mono type suffix from a function name.
// For method names like "Picker__echo__i32", the base name contains "__"
// (from "::" → "__"). We try all "__" positions from right to left and
// check if all suffix parts are valid type keys. The rightmost valid
// position is the correct separator.

fn build_return_type_value_sig(
    uf: MirFunction,
    return_type: i32,
    return_type_name: String,
    target: String,
    wasi_version: String,
    memory64: bool,
    mir: MirModule
) -> String {
    build_return_type_value_sig_named(
        uf.name.clone(),
        return_type,
        return_type_name.clone(),
        target,
        wasi_version,
        memory64,
        mir
    )
}

// Spine-safe form used by the fused in-loop emit (#851): identical
// segment selection for a callee whose MirFunction is not pushed yet.
fn build_return_type_value_sig_named(
    fn_name: String,
    return_type: i32,
    return_type_name: String,
    target: String,
    wasi_version: String,
    memory64: bool,
    mir: MirModule
) -> String {
    // fn returns carry the same {fnptr, env} pair as params (#872).
    if return_type_name.clone().eq(String_from("fnref")) ||
    return_type_name.clone().starts_with(String_from("fnref")) ||
    return_type_name.clone().starts_with(String_from("fnsig:")) ||
    return_type_name.clone().eq(String_from("fn")) ||
    return_type_name.clone().starts_with(String_from("fn(")) ||
    return_type == value_types::VT_FUNCREF() {
        if emit_target::is_gc_target(target.clone()) {
            let pair_slot = module_gc_struct::MirModule_gc_struct_slot(mir, "__fnpair")
            if pair_slot >= 0 {
                return String_from("gcsref").concat((pair_slot).to_string())
            }
        }
        return funcref_return_sig_for_target(target.clone(), memory64)
    }
    let typed_sig = sections_types_gc_plan::typed_function_return_sig(mir, fn_name.clone(), target.clone())
    if typed_sig.len() > 0 {
        // Typed spine may classify a registered user struct as ENUM/RESULT open
        // (e.g. WitParsedInterface on some return paths). Prefer the concrete
        // gc_struct slot when the MIR return type name names that struct.
        if emit_target::is_gc_target(target.clone()) &&
        typed_sig.clone().eq(sections_types_gc::gc_enum_open_type_sig()) {
            // Prefer a concrete gc_struct only for true user structs. Enum
            // names that were wrongly registered as GS_f0_ref14 boxes must
            // keep open-enum returns (toml_get / JsonValue) (#808).
            // Option/Result/enum-spelled returns are genuinely enum-open:
            // stripping the wrapper to the payload's struct slot produces a
            // signature that cannot hold the variant value (#860).
            if !return_type_name_is_enum_family(return_type_name.clone()) {
                let concrete = gc_struct_sig_from_return_type_name(return_type_name.clone(), mir)
                if concrete.len() > 0 && !gc_struct_sig_is_enum_open_box(concrete.clone(), mir) {
                    return concrete
                }
            }
        } else {
            return typed_sig
        }
        return typed_sig
    }
    // vec:/hashmap: return types use the same mapping as params.
    let coll_sig = sections_types_gc_plan::collection_type_sig(mir, return_type_name.clone(), target.clone())
    if coll_sig.len() > 0 {
        return coll_sig
    }
    if emit_target::is_gc_target(target.clone()) && is_hash_container_type_name(return_type_name.clone()) {
        return sections_types_gc::gc_vec_type_sig()
    }
    if emit_target::is_gc_target(target.clone()) {
        let mono_method_ret = sections_types_sigs_mono::resolve_mono_method_return_value_sig(fn_name.clone(), return_type_name.clone(), mir)
        if mono_method_ret.len() > 0 {
            return widen_i32_sig_for_memory64(
                mono_method_ret,
                memory64
            )
        }
    }
    if emit_target::is_gc_target(target.clone()) && (return_type_name.clone().eq(String_from("string")) || return_type_name.clone().eq(String_from("String"))) {
        return sections_types_gc::gc_string_type_sig()
    }
    let gc_enum_ret_sig = sections_types_gc_override::gc_enum_return_type_sig(return_type_name.clone(), target.clone())
    if gc_enum_ret_sig.len() > 0 {
        return gc_enum_ret_sig
    }
    let gc_ret_sig = sections_types_gc_override::gc_return_type_sig_override(fn_name.clone(), return_type_name.clone(), target.clone())
    if gc_ret_sig.len() > 0 {
        return gc_ret_sig
    }
    if emit_target::is_gc_target(target.clone()) && return_type_name.clone().starts_with(String_from("struct:")) {
        return gc_struct_return_sig_from_name(return_type_name.clone(), mir)
    }
    let registered = gc_struct_sig_from_return_type_name(return_type_name.clone(), mir)
    if registered.len() > 0 {
        return registered
    }
    // 'Head<Args>' enum instantiations (e.g. Box<WitType>): the head names a
    // registered enum, so the value is an open-enum ref. Without this arm the
    // name falls to the VT_GC_REF fallback, which emits the single-i32-field
    // struct that cannot hold the variant value (#860).
    if emit_target::is_gc_target(target.clone()) &&
    p2_return_type_name_is_enum_instance(return_type_name.clone(), mir) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    let generic_ret_sig = build_generic_type_var_sig(
        fn_name.clone(),
        return_type_name.clone(),
        0 - 1,
        target.clone(),
        wasi_version.clone(),
        memory64,
        mir
    )
    if generic_ret_sig.len() > 0 {
        return widen_i32_sig_for_memory64(
            generic_ret_sig,
            memory64
        )
    }
    sections_type_plan::val_type_to_target_sig(
        return_type,
        emit_target::is_gc_target(target.clone()),
        memory64
    )
}

// True when a gcsref slot is the single-field open-enum box (GS_f0_ref14)
// produced by wrongly registering an enum layout as a gc_struct.
// Option/Result/enum-spelled return names are genuinely enum-open. The
// concrete-struct preference must not unwrap option:Pair<i32,i32> to the
// payload struct slot — the variant value cannot fit in it (#860).
fn return_type_name_is_enum_family(type_name: String) -> bool {
    if type_name.clone().starts_with(String_from("enum:")) {
        return true
    }
    if p2_is_option_type_name(type_name.clone()) {
        return true
    }
    p2_is_result_type_name(type_name)
}

// True for 'Head<Args>' return names whose head registers enum variants
// (e.g. Box<WitType> has the Box::Owned variant). Concrete gc_struct slots
// are checked first and cannot be enum types, so this arm only sees names
// that would otherwise reach the generic-VT fallback.
fn p2_return_type_name_is_enum_instance(type_name: String, mir: MirModule) -> bool {
    let n = type_name.len()
    let mut i = 0
    while i < n {
        if type_name.byte_at(i) == 60 {
            if i == 0 {
                return false
            }
            return p2_enum_has_variants(type_name.slice(0, i), mir)
        }
        i = i + 1
    }
    false
}

fn gc_struct_sig_is_enum_open_box(sig_or_gcsref: String, mir: MirModule) -> bool {
    let mut sig = sig_or_gcsref.clone()
    if sig.clone().starts_with(String_from("gcsref")) {
        let slot_str = sig.clone().slice(6, sig.len())
        let slot = sections_types_gc::parse_type_sig_int(slot_str)
        if slot < 0 || slot >= module_gc_struct::MirModule_gc_struct_sig_count(mir) {
            return false
        }
        sig = module_gc_struct::MirModule_gc_struct_sig_at(mir, slot)
    }
    sig.clone().eq(String_from("GS_f0_ref14"))
}

// Resolve a registered gc_struct for a return type name. Accepts raw names,
// module::Name, and struct:Name:size (slot hit only — not size fallback).
fn gc_struct_sig_from_return_type_name(return_type_name: String, mir: MirModule) -> String {
    if return_type_name.len() == 0 {
        return String_new()
    }
    if return_type_name.clone().starts_with(String_from("struct:")) {
        let from_struct = gc_struct_return_sig_from_name(return_type_name.clone(), mir)
        if from_struct.clone().starts_with(String_from("gcsref")) {
            if gc_struct_sig_is_enum_open_box(from_struct.clone(), mir) {
                return String_new()
            }
            return from_struct
        }
        return String_new()
    }
    let slot = module_gc_struct::MirModule_gc_struct_slot(mir, return_type_name.clone())
    if slot >= 0 {
        let gcsref = String_from("gcsref").concat((slot).to_string())
        if gc_struct_sig_is_enum_open_box(gcsref.clone(), mir) {
            return String_new()
        }
        return gcsref
    }
    let name_len = return_type_name.len()
    let mut colon_pos = 0 - 1
    let mut ci = name_len - 1
    while ci >= 0 {
        if return_type_name.byte_at(ci) == 58 {
            colon_pos = ci
            ci = 0 - 1
        }
        ci = ci - 1
    }
    if colon_pos >= 0 {
        let bare = return_type_name.slice(colon_pos + 1, name_len)
        let bare_slot = module_gc_struct::MirModule_gc_struct_slot(mir, bare)
        if bare_slot >= 0 {
            let gcsref = String_from("gcsref").concat((bare_slot).to_string())
            if gc_struct_sig_is_enum_open_box(gcsref.clone(), mir) {
                return String_new()
            }
            return gcsref
        }
    }
    String_new()
}

fn gc_struct_return_sig_from_name(type_name: String, mir: MirModule) -> String {
    // Format: "struct:TypeName:byte_size"
    // Extract TypeName (between first and last colon).
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let n = type_name.len()
    let mut i = 0
    while i < n {
        if type_name.byte_at(i) == ':' {
            if first_colon < 0 {
                first_colon = i
            }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon < 0 {
        return sections_types_gc::gc_struct_type_sig_from_byte_size(4)
    }
    // Extract struct name between first and last colon.
    let struct_name = type_name.slice(first_colon + 1, last_colon)
    // Look up in MIR module's gc_struct list.
    let slot = module_gc_struct::MirModule_gc_struct_slot(mir, struct_name.clone())
    if slot >= 0 {
        // Use "gcsref" + slot as placeholder; resolved during emission via gc_struct_type_map.
        return String_from("gcsref").concat((slot).to_string())
    }
    // Fallback: extract byte_size and use size-based heuristic.
    let mut byte_size = 0
    let mut j = last_colon + 1
    while j < n {
        let d = type_name.byte_at(j)
        if d >= 48 && d <= 57 {
            byte_size = byte_size * 10 + (d - 48)
        } else {
            j = n
        }
        j = j + 1
    }
    sections_types_gc::gc_struct_type_sig_from_byte_size(byte_size)
}
