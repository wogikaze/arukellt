// Type-section index of defined function `fn_idx`, or -1 when unknown.
fn SelfEmitCtx_fn_type_index(ctx: SelfEmitCtx, fn_idx: i32) -> i32 {
    if fn_idx < 0 || fn_idx >= len(ctx.fn_type_map) {
        return 0 - 1
    }
    get_unchecked(ctx.fn_type_map, fn_idx)
}

