fn SelfEmitCtx_mir_index_for_func_id(ctx: SelfEmitCtx, func_id_raw: i32) -> i32 {
    if func_id_raw < 0 || func_id_raw >= len(ctx.fid_to_mir) {
        return 0 - 1
    }
    get_unchecked(ctx.fid_to_mir, func_id_raw)
}
