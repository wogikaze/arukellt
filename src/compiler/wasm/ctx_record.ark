fn SelfEmitCtx_set_gc_enum_variant_names(ctx: SelfEmitCtx, gc_enum_variant_names: Vec<String>) {
    ctx.gc_enum_variant_names = gc_enum_variant_names
    SelfEmitCtx_rebuild_gc_enum_variant_name_index(ctx)
}

fn SelfEmitCtx_gc_enum_variant_name_index(ctx: SelfEmitCtx) -> NameIndex {
    ctx.gc_enum_variant_name_index
}

fn SelfEmitCtx_rebuild_gc_enum_variant_name_index(ctx: SelfEmitCtx) {
    let names = ctx.gc_enum_variant_names
    let map = ctx.gc_enum_variant_type_map
    let count = len(names)
    let index = name_index::NameIndex_new(count)
    let mut i = 0
    while i < count {
        let type_idx = if i < len(map) {
            get_unchecked(map, i)
        } else {
            0 - 1
        }
        if type_idx >= 0 {
            name_index::name_index_insert_first(index, clone(get_unchecked(names, i)), type_idx)
        }
        i = i + 1
    }
    ctx.gc_enum_variant_name_index = index
}

