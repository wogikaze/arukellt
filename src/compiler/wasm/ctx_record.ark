    ctx.gc_enum_variant_type_map = gc_enum_variant_type_map
    if len(ctx.gc_enum_variant_names) > 0 {
        SelfEmitCtx_rebuild_gc_enum_variant_name_index(ctx)
    }
}

fn SelfEmitCtx_gc_enum_variant_names(ctx: SelfEmitCtx) -> Vec<String> {
