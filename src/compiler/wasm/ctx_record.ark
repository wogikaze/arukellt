    ctx.core_op_shadow_mismatch_budget = ctx.core_op_shadow_mismatch_budget - 1
}

fn SelfEmitCtx_gc_layout_table(ctx: SelfEmitCtx) -> GcLayoutTable {
    ctx.gc_layout_table
}

fn SelfEmitCtx_set_gc_layout_table(ctx: SelfEmitCtx, gc_layout_table: GcLayoutTable) {
    ctx.gc_layout_table = gc_layout_table
}

fn SelfEmitCtx_fid_to_mir(ctx: SelfEmitCtx) -> Vec<i32> {
    ctx.fid_to_mir
}

fn SelfEmitCtx_set_fid_to_mir(ctx: SelfEmitCtx, fid_to_mir: Vec<i32>) {
    ctx.fid_to_mir = fid_to_mir
}

fn SelfEmitCtx_mir_index_for_func_id(ctx: SelfEmitCtx, func_id_raw: i32) -> i32 {
    if func_id_raw < 0 || func_id_raw >= len(ctx.fid_to_mir) {
        return 0 - 1
    }
    get_unchecked(ctx.fid_to_mir, func_id_raw)
}
