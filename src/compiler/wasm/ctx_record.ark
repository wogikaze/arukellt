    ctx.gc_enum_variant_type_flags
}

fn SelfEmitCtx_rebuild_gc_enum_variant_type_flags(ctx: SelfEmitCtx) {
    let map = module_gc_enum::MirModule_gc_enum_variant_canon_idxs(ctx.mir)
    let mut max_type_idx = 0 - 1
    let mut i = 0
    while i < len(map) {
        let type_idx = get_unchecked(map, i)
        if type_idx > max_type_idx {
            max_type_idx = type_idx
        }
        i = i + 1
    }
    let flags = Vec::new<i32>()
    let mut fi = 0
    while fi <= max_type_idx {
        push(flags, 0)
        fi = fi + 1
    }
    i = 0
    while i < len(map) {
        let type_idx = get_unchecked(map, i)
        if type_idx >= 0 && type_idx < len(flags) {
            set(flags, type_idx, 1)
        }
        i = i + 1
    }
    ctx.gc_enum_variant_type_flags = flags
}

fn SelfEmitCtx_gc_enum_variant_names(ctx: SelfEmitCtx) -> Vec<String> {
    ctx.gc_enum_variant_names
}

