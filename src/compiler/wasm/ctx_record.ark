// Wasm emitter context data record.
use std::prelude::{byte_at, clone, eq, substring}
use corehir::signature_registry
use mir::local_write_index
use corehir::type_table
use mir::function_identity
use mir::module_record
use mir::lower::mono_instance_table
use wasm::call_resolve
use wasm::gc_layout_table
use collections::name_index
pub struct SelfEmitCtx {
    functions: Vec<MirFunction>,
    function_name_lengths: Vec<i32>,
    function_name_index: NameIndex,
    function_name_counts: NameIndex,
    // Module SSOT; emit readers migrate off plan-built snapshots (#851).
    mir: MirModule,
    scratch_base: i32,
    true_str_idx: i32,
    false_str_idx: i32,
    vec_locals: Vec<i32>,
    target: String,
    wasi_version: String,
    memory64: bool,
    gc_hint_offsets: Vec<i32>,
    source_file: String,
    code_section_offsets: Vec<i32>,
    gc_type_base: i32,
    gc_enum_variant_base: i32,
    // O(1) membership for the wasm type indices occupied by enum variants.
    gc_enum_variant_type_flags: Vec<i32>,
    gc_enum_variant_names: Vec<String>,
    gc_enum_variant_sigs: Vec<String>,
    gc_enum_variant_name_index: NameIndex,
    gc_struct_base: i32,
    gc_struct_names: Vec<String>,
    gc_struct_sigs: Vec<String>,
    gc_struct_name_index: NameIndex,
    // `a::b::Name` -> gc_struct_names index, keyed by the `::`-stripped name.
    gc_struct_module_stripped_index: NameIndex,
    current_func_idx: i32,
    signature_registry: SignatureRegistry,
    type_table: TypeTable,
    mono_instance_table: MonoInstanceTable,
    spine_populated: bool,
    registry_audit_candidates: i32,
    registry_audit_matched: i32,
    registry_audit_mismatched: i32,
    registry_audit_mismatch_budget: i32,
    core_op_shadow_candidates: i32,
    core_op_shadow_matched: i32,
    core_op_shadow_mismatched: i32,
    core_op_shadow_unresolved: i32,
    core_op_shadow_mismatch_budget: i32,
    gc_layout_table: GcLayoutTable,
    // Per-function emit caches (#829). Empty = inactive.
    local_gc_infer_cache: Vec<i32>,
    local_struct_new_cache: Vec<i32>,
    // 0/1 ref-assignment flags; parallel to struct_new cache when active.
    local_has_ref_cache: Vec<i32>,
    // First defining MIR site per local (-1 = none); speeds block_scan.
    local_def_block_cache: Vec<i32>,
    local_def_inst_cache: Vec<i32>,
    // 0/1 per local: body has only scalar i64 producers/uses (see
    // code_ref_locals_scan::local_body_i64_stack_set_flags).
    local_i64_stack_set_cache: Vec<i32>,
    // 0/1 per local: a RETURN hands this local back (code_ref_locals_scan).
    local_feeds_return_cache: Vec<i32>,
    // Scalar producer value type per local; -1 means no concrete scalar
    // producer. Empty outside the begin/end_function_local_gc_cache window.
    local_scalar_producer_vt_cache: Vec<i32>,
    // 0/1 scalar-producer flags and strong-reference-producer flags. These are
    // separate because a scalar producer may not expose a concrete value type.
    local_has_scalar_producer_cache: Vec<i32>,
    local_strong_ref_producer_cache: Vec<i32>,
    // 0/1 per local: a Vec constructor call writes the local.
    local_vec_constructor_cache: Vec<i32>,
    // Encoded Option<i32> for direct producer storage: -2 = uncomputed,
    // -1 = no storage type, >=0 = wasm type index.
    local_direct_producer_storage_cache: Vec<i32>,
    // Encoded Option<i32> for the copied-source storage walk: -2 =
    // uncomputed, -1 = no storage type, >=0 = wasm type index.
    local_copied_storage_cache: Vec<i32>,
    // First MIR_STRUCT_NEW byte size per struct name in the current body, in
    // body order; replaces a per-local body rescan in local decl typing.
    struct_new_size_names: Vec<String>,
    struct_new_sizes: Vec<i32>,
    // Per-function write sites per local (mir::local_write_index); empty
    // outside the begin/end_function_local_gc_cache window.
    local_write_index: LocalWriteIndex,
    // type_name → wasm ref type idx (+2 encoded; 1 = known miss).
    type_name_ref_index: NameIndex,
    // FunctionId.raw → MirFunction index. -1 = no body (core-op alias).
    // Reloc key for CALL; never assume raw == mir index (#823).
    fid_to_mir: Vec<i32>,
    // Module-level CALL slots (#851 Phase 3): (func_idx into body_bytes,
    // body_rel_off, FunctionId.raw), patched at section assembly once the
    // function index space is final — supports forward refs to fids
    // registered mid-loop in the fused design.
    call_reloc_offs: Vec<i32>,
    call_reloc_fids: Vec<i32>,
    call_reloc_funcs: Vec<i32>,
    // #851 Phase 3: name key for call relocs whose callee carried no
    // FunctionId — resolved by name at reloc-apply time (post-prune), so
    // the in-loop drain can defer them the same way fid relocs are.
    call_reloc_names: Vec<String>,
    // Registered pair-ABI call-site signatures (#872); their canon type
    // indices resolve through MirModule.canon_sigs — no parallel map is
    // kept (#851 Phase 3). Empty outside GC targets.
    pair_call_sigs: Vec<String>,
    // Per-fn sized body bytes, indexed by module func_idx. Declared bodies
    // emit into a scratch writer and land here so the code section can be
    // assembled in func_idx order regardless of emit order (#851 Phase 3).
    body_bytes: Vec<Vec<i32>>,
    // Deferred-resolution relocs against body_bytes (#851 Phase 3): each
    // entry is (func_idx, body_rel_off, kind, ikey, skey) patched at
    // section assembly — see wasm::ctx_reloc.
    reloc_func: Vec<i32>,
    reloc_off: Vec<i32>,
    reloc_kind: Vec<i32>,
    reloc_ikey: Vec<i32>,
    reloc_ikey2: Vec<i32>,
    reloc_ikey3: Vec<i32>,
    reloc_skey: Vec<String>,
    reloc_skey2: Vec<String>,
    // Incremental name-index state (#851 Phase 3 in-loop emit): number of
    // ctx.functions already folded into function_name_index/counts. The
    // emit-phase ctx is built on the complete module so the watermark
    // starts at fn_count; an in-loop ctx drains as functions push.
    fn_index_watermark: i32,
    // #851 Phase 3: bodies were emitted inside the lowering drain into
    // body_bytes; emit_code_section skips its emit loop when this is set.
    in_loop_emitted: bool,
    // Incremental fid->mir state (#851 Phase 3 push-time emit): the
    // same-name consumption chains built over the signature registry stay
    // live so fn_index_drain can fold each pushed fn in registry-ordinal
    // order — identical to SelfEmitCtx_build_fid_to_mir's one-shot pass.
    fid_chain_heads: NameIndex,
    fid_chain_next: Vec<i32>,
    fid_chains_live: bool,
}

fn SelfEmitCtx_new(
    mir: MirModule,
    functions: Vec<MirFunction>,
    true_str_idx: i32,
    false_str_idx: i32,
    target: String,
    wasi_version: String,
    memory64: bool,
    source_file: String
) -> SelfEmitCtx {
    let fn_count = len(functions)
    let mut name_lengths = Vec::new<i32>()
    let function_name_index = name_index::NameIndex_new(fn_count)
    let function_name_counts = name_index::NameIndex_new(fn_count)
    let mut fi = 0
    while fi < fn_count {
        let fname = function_identity::MirFunction_name(get_unchecked(functions, fi))
        push(name_lengths, len(clone(fname)))
        name_index::name_index_insert_first(function_name_index, clone(fname), fi)
        name_index::name_index_increment(function_name_counts, fname)
        fi = fi + 1
    }
    call_resolve::call_resolve_remap_colliding_short_names(
        functions,
        function_name_index,
        function_name_counts
    )
    let empty_i32 = Vec::new<i32>()
    let empty_string = Vec::new<String>()
    let empty_i32_b = Vec::new<i32>()
    let empty_string_b = Vec::new<String>()
    let empty_string_c = Vec::new<String>()
    let empty_string_d = Vec::new<String>()
    let empty_string_e = Vec::new<String>()
    let sig = signature_registry::SignatureRegistry_new()
    let types = type_table::TypeTable_new()
    let mono = mono_instance_table::MonoInstanceTable_new()
    let layout = gc_layout_table::GcLayoutTable_new()
    SelfEmitCtx {
        functions: functions,
        function_name_lengths: name_lengths,
        function_name_index: function_name_index,
        function_name_counts: function_name_counts,
        mir: mir,
        scratch_base: 0,
        true_str_idx: true_str_idx,
        false_str_idx: false_str_idx,
        vec_locals: empty_i32,
        target: target,
        wasi_version: wasi_version,
        memory64: memory64,
        gc_hint_offsets: empty_i32_b,
        source_file: source_file,
        code_section_offsets: Vec::new<i32>(),
        gc_type_base: 0,
        gc_enum_variant_base: 0 - 1,
        gc_enum_variant_type_flags: Vec::new<i32>(),
        gc_enum_variant_names: empty_string_b,
        gc_enum_variant_sigs: empty_string_c,
        gc_enum_variant_name_index: name_index::NameIndex_new(0),
        gc_struct_base: 0 - 1,
        gc_struct_names: empty_string_d,
        gc_struct_sigs: empty_string_e,
        gc_struct_name_index: name_index::NameIndex_new(0),
        gc_struct_module_stripped_index: name_index::NameIndex_new(0),
        current_func_idx: 0,
        signature_registry: sig,
        type_table: types,
        mono_instance_table: mono,
        spine_populated: false,
        registry_audit_candidates: 0,
        registry_audit_matched: 0,
        registry_audit_mismatched: 0,
        registry_audit_mismatch_budget: 128,
        core_op_shadow_candidates: 0,
        core_op_shadow_matched: 0,
        core_op_shadow_mismatched: 0,
        core_op_shadow_unresolved: 0,
        core_op_shadow_mismatch_budget: 128,
        gc_layout_table: layout,
        local_gc_infer_cache: Vec::new<i32>(),
        local_struct_new_cache: Vec::new<i32>(),
        local_has_ref_cache: Vec::new<i32>(),
        local_def_block_cache: Vec::new<i32>(),
        local_def_inst_cache: Vec::new<i32>(),
        local_i64_stack_set_cache: Vec::new<i32>(),
        local_feeds_return_cache: Vec::new<i32>(),
        local_scalar_producer_vt_cache: Vec::new<i32>(),
        local_has_scalar_producer_cache: Vec::new<i32>(),
        local_strong_ref_producer_cache: Vec::new<i32>(),
        local_vec_constructor_cache: Vec::new<i32>(),
        local_direct_producer_storage_cache: Vec::new<i32>(),
        local_copied_storage_cache: Vec::new<i32>(),
        struct_new_size_names: Vec::new<String>(),
        struct_new_sizes: Vec::new<i32>(),
        local_write_index: local_write_index::LocalWriteIndex_empty(),
        type_name_ref_index: name_index::NameIndex_new(4096),
        fid_to_mir: Vec::new<i32>(),
        call_reloc_offs: Vec::new<i32>(),
        call_reloc_fids: Vec::new<i32>(),
        call_reloc_funcs: Vec::new<i32>(),
        call_reloc_names: Vec::new<String>(),
        pair_call_sigs: Vec::new<String>(),
        body_bytes: Vec::new<Vec<i32>>(),
        reloc_func: Vec::new<i32>(),
        reloc_off: Vec::new<i32>(),
        reloc_kind: Vec::new<i32>(),
        reloc_ikey: Vec::new<i32>(),
        reloc_ikey2: Vec::new<i32>(),
        reloc_ikey3: Vec::new<i32>(),
        reloc_skey: Vec::new<String>(),
        reloc_skey2: Vec::new<String>(),
        fn_index_watermark: fn_count,
        in_loop_emitted: false,
        fid_chain_heads: name_index::NameIndex_new(0),
        fid_chain_next: Vec::new<i32>(),
        fid_chains_live: false,
    }
}

// Fold newly pushed functions into the name index/counts (and the live
// fid->mir chains when bound incrementally). Idempotent and incremental:
// identical result to the constructor's one-shot build when the module is
// complete, and correct for a still-growing functions vec.
fn SelfEmitCtx_fn_index_drain(ctx: SelfEmitCtx) {
    let functions = ctx.functions
    let n = len(functions)
    let fid_live = ctx.fid_chains_live
    while ctx.fn_index_watermark < n {
        let fi = ctx.fn_index_watermark
        let fname = function_identity::MirFunction_name(get_unchecked(functions, fi))
        push(ctx.function_name_lengths, len(clone(fname)))
        name_index::name_index_insert_first(
            ctx.function_name_index, clone(fname), fi)
        name_index::name_index_increment(ctx.function_name_counts, fname)
        if fid_live {
            // Consume one same-name registry entry per pushed fn, matching
            // ctx_fid_map's ordinal rule. Entries beyond the map (registry
            // growth after bind) simply stay unmapped — a deferred-emit
            // decision, never a wrong resolution.
            let raw = name_index::name_index_get(
                ctx.fid_chain_heads, clone(fname))
            if raw >= 0 {
                if raw < len(ctx.fid_to_mir) {
                    if get_unchecked(ctx.fid_to_mir, raw) < 0 {
                        set(ctx.fid_to_mir, raw, fi)
                    }
                }
                name_index::name_index_set(
                    ctx.fid_chain_heads, fname,
                    get_unchecked(ctx.fid_chain_next, raw))
            }
        }
        ctx.fn_index_watermark = fi + 1
    }
}

