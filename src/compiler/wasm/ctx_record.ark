fn SelfEmitCtx_set_gc_struct_names(ctx: SelfEmitCtx, gc_struct_names: Vec<String>) {
    ctx.gc_struct_names = gc_struct_names
    SelfEmitCtx_rebuild_gc_struct_name_index(ctx)
}

fn SelfEmitCtx_gc_struct_name_index(ctx: SelfEmitCtx) -> NameIndex {
    ctx.gc_struct_name_index
}

fn SelfEmitCtx_bare_suffix(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if char_at(name, i) == 58 {
            if i + 1 < n {
                return substring(name, i + 1, n)
            }
            return String_new()
        }
        i = i - 1
    }
    name
}

// Name after the last `::`; the name itself when it has no module path.
fn SelfEmitCtx_module_stripped_name(name: String) -> String {
    let name_len = len(name)
    let mut index = name_len - 2
    while index >= 0 {
        if char_at(name, index) == 58 && char_at(name, index + 1) == 58 {
            return substring(name, index + 2, name_len)
        }
        index = index - 1
    }
    name
}

// First gc_struct_names entry whose `::`-stripped name equals `stripped`, or -1.
fn SelfEmitCtx_gc_struct_index_by_module_stripped_name(ctx: SelfEmitCtx, stripped: String) -> i32 {
    name_index::name_index_get(ctx.gc_struct_module_stripped_index, stripped)
}

fn SelfEmitCtx_rebuild_gc_struct_name_index(ctx: SelfEmitCtx) {
    let names = ctx.gc_struct_names
    let map = ctx.gc_struct_type_map
    let count = len(names)
    let index = name_index::NameIndex_new(count)
    let stripped_index = name_index::NameIndex_new(count)
    let mut i = 0
    while i < count {
        name_index::name_index_insert_first(
            stripped_index,
            SelfEmitCtx_module_stripped_name(clone(get_unchecked(names, i))),
            i
        )
        let type_idx = if i < len(map) {
            get_unchecked(map, i)
        } else {
            0 - 1
        }
        if type_idx >= 0 {
            let full_name = clone(get_unchecked(names, i))
            name_index::name_index_insert_first(index, full_name, type_idx)
            let bare = SelfEmitCtx_bare_suffix(full_name)
            if len(bare) > 0 && !eq(clone(bare), clone(full_name)) {
                name_index::name_index_insert_first(index, bare, type_idx)
            }
        }
        i = i + 1
    }
    ctx.gc_struct_name_index = index
    ctx.gc_struct_module_stripped_index = stripped_index
}

