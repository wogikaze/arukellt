fn SelfEmitCtx_code_section_offset_at(ctx: SelfEmitCtx, func_idx: i32) -> i32 {
    let offsets = ctx.code_section_offsets
    if func_idx < 0 || func_idx >= len(offsets) {
        return 0 - 1
    }
    get_unchecked(offsets, func_idx)
}

