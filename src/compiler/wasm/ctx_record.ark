// Wasm emitter context data record.
use corehir::signature_registry
use mir::local_write_index
use corehir::type_table
use mir::function_identity
use mir::lower::mono_instance_table
use wasm::call_resolve
use wasm::gc_layout_table
use wasm::sections_type_plan
use collections::name_index

pub struct SelfEmitCtx {
    functions: Vec<MirFunction>,
    function_name_lengths: Vec<i32>,
    function_name_index: NameIndex,
    function_name_counts: NameIndex,
    string_offsets: Vec<i32>,
    string_lengths: Vec<i32>,
    string_values: Vec<String>,
    scratch_base: i32,
    true_str_idx: i32,
    false_str_idx: i32,
    vec_locals: Vec<i32>,
    target: String,
    wasi_version: String,
    gc_hint_offsets: Vec<i32>,
    source_file: String,
    code_section_offsets: Vec<i32>,
    gc_type_base: i32,
    gc_enum_variant_base: i32,
    gc_enum_variant_type_map: Vec<i32>,
    gc_enum_variant_names: Vec<String>,
    gc_enum_variant_sigs: Vec<String>,
    gc_enum_variant_name_index: NameIndex,
    gc_struct_base: i32,
    gc_struct_type_map: Vec<i32>,
    gc_struct_names: Vec<String>,
    gc_struct_sigs: Vec<String>,
    gc_struct_name_index: NameIndex,
    // `a::b::Name` -> gc_struct_names index, keyed by the `::`-stripped name.
    gc_struct_module_stripped_index: NameIndex,
    current_func_idx: i32,
    fn_type_map: Vec<i32>,
    fn_type_refs: FuncTypeRefs,
    signature_registry: SignatureRegistry,
    type_table: TypeTable,
    mono_instance_table: MonoInstanceTable,
    spine_populated: bool,
    registry_audit_candidates: i32,
    registry_audit_matched: i32,
    registry_audit_mismatched: i32,
    registry_audit_mismatch_budget: i32,
    core_op_shadow_candidates: i32,
    core_op_shadow_matched: i32,
    core_op_shadow_mismatched: i32,
    core_op_shadow_unresolved: i32,
    core_op_shadow_mismatch_budget: i32,
    gc_layout_table: GcLayoutTable,
    // Per-function emit caches (#829). Empty = inactive.
    local_gc_infer_cache: Vec<i32>,
    local_struct_new_cache: Vec<i32>,
    // 0/1 ref-assignment flags; parallel to struct_new cache when active.
    local_has_ref_cache: Vec<i32>,
    // First defining MIR site per local (-1 = none); speeds block_scan.
    local_def_block_cache: Vec<i32>,
    local_def_inst_cache: Vec<i32>,
    // 0/1 per local: body has only scalar i64 producers/uses (see
    // code_ref_locals_scan::local_body_i64_stack_set_flags).
    local_i64_stack_set_cache: Vec<i32>,
    // 0/1 per local: a RETURN hands this local back (code_ref_locals_scan).
    local_feeds_return_cache: Vec<i32>,
    // First MIR_STRUCT_NEW byte size per struct name in the current body, in
    // body order; replaces a per-local body rescan in local decl typing.
    struct_new_size_names: Vec<String>,
    struct_new_sizes: Vec<i32>,
    // Per-function write sites per local (mir::local_write_index); empty
    // outside the begin/end_function_local_gc_cache window.
    local_write_index: LocalWriteIndex,
    // type_name → wasm ref type idx (+2 encoded; 1 = known miss).
    type_name_ref_index: NameIndex,
    // FunctionId.raw → MirFunction index. -1 = no body (core-op alias).
    // Reloc key for CALL; never assume raw == mir index (#823).
    fid_to_mir: Vec<i32>,
    // Per-body CALL slots: offset into the module code writer, FunctionId.raw.
    call_reloc_offs: Vec<i32>,
    call_reloc_fids: Vec<i32>,
    call_reloc_used: i32,
}

fn SelfEmitCtx_new(
    functions: Vec<MirFunction>,
    string_offsets: Vec<i32>,
    string_lengths: Vec<i32>,
    string_values: Vec<String>,
    true_str_idx: i32,
    false_str_idx: i32,
    target: String,
    wasi_version: String,
    source_file: String
) -> SelfEmitCtx {
    let fn_count = len(functions)
    let mut name_lengths = Vec::new<i32>()
    let function_name_index = name_index::NameIndex_new(fn_count)
    let function_name_counts = name_index::NameIndex_new(fn_count)
    let mut fi = 0
    while fi < fn_count {
        let fname = function_identity::MirFunction_name(get_unchecked(functions, fi))
        push(name_lengths, len(clone(fname)))
        name_index::name_index_insert_first(function_name_index, clone(fname), fi)
        name_index::name_index_increment(function_name_counts, fname)
        fi = fi + 1
    }
    call_resolve::call_resolve_remap_colliding_short_names(
        functions,
        function_name_index,
        function_name_counts
    )
    let empty_i32 = Vec::new<i32>()
    let empty_string = Vec::new<String>()
    let empty_i32_b = Vec::new<i32>()
    let empty_i32_c = Vec::new<i32>()
    let empty_string_b = Vec::new<String>()
    let empty_string_c = Vec::new<String>()
    let empty_i32_d = Vec::new<i32>()
    let empty_string_d = Vec::new<String>()
    let empty_string_e = Vec::new<String>()
    let empty_i32_e = Vec::new<i32>()
    let sig = signature_registry::SignatureRegistry_new()
    let types = type_table::TypeTable_new()
    let mono = mono_instance_table::MonoInstanceTable_new()
    let layout = gc_layout_table::GcLayoutTable_new()
    SelfEmitCtx {
        functions: functions,
        function_name_lengths: name_lengths,
        function_name_index: function_name_index,
        function_name_counts: function_name_counts,
        string_offsets: string_offsets,
        string_lengths: string_lengths,
        string_values: string_values,
        scratch_base: 0,
        true_str_idx: true_str_idx,
        false_str_idx: false_str_idx,
        vec_locals: empty_i32,
        target: target,
        wasi_version: wasi_version,
        gc_hint_offsets: empty_i32_b,
        source_file: source_file,
        code_section_offsets: Vec::new<i32>(),
        gc_type_base: 0,
        gc_enum_variant_base: 0 - 1,
        gc_enum_variant_type_map: empty_i32_c,
        gc_enum_variant_names: empty_string_b,
        gc_enum_variant_sigs: empty_string_c,
        gc_enum_variant_name_index: name_index::NameIndex_new(0),
        gc_struct_base: 0 - 1,
        gc_struct_type_map: empty_i32_d,
        gc_struct_names: empty_string_d,
        gc_struct_sigs: empty_string_e,
        gc_struct_name_index: name_index::NameIndex_new(0),
        gc_struct_module_stripped_index: name_index::NameIndex_new(0),
        current_func_idx: 0,
        fn_type_map: empty_i32_e,
        fn_type_refs: sections_type_plan::FuncTypeRefs_new(),
        signature_registry: sig,
        type_table: types,
        mono_instance_table: mono,
        spine_populated: false,
        registry_audit_candidates: 0,
        registry_audit_matched: 0,
        registry_audit_mismatched: 0,
        registry_audit_mismatch_budget: 128,
        core_op_shadow_candidates: 0,
        core_op_shadow_matched: 0,
        core_op_shadow_mismatched: 0,
        core_op_shadow_unresolved: 0,
        core_op_shadow_mismatch_budget: 128,
        gc_layout_table: layout,
        local_gc_infer_cache: Vec::new<i32>(),
        local_struct_new_cache: Vec::new<i32>(),
        local_has_ref_cache: Vec::new<i32>(),
        local_def_block_cache: Vec::new<i32>(),
        local_def_inst_cache: Vec::new<i32>(),
        local_i64_stack_set_cache: Vec::new<i32>(),
        local_feeds_return_cache: Vec::new<i32>(),
        struct_new_size_names: Vec::new<String>(),
        struct_new_sizes: Vec::new<i32>(),
        local_write_index: local_write_index::LocalWriteIndex_empty(),
        type_name_ref_index: name_index::NameIndex_new(4096),
        fid_to_mir: Vec::new<i32>(),
        call_reloc_offs: Vec::new<i32>(),
        call_reloc_fids: Vec::new<i32>(),
        call_reloc_used: 0,
    }
}

