use wasm::constants

fn is_gc_target(target: String) -> bool {
    eq(clone(target), "wasm32-gc")
}

// ADR-007: Memory64 is default emit OK for wasm32-gc only (not wasm32/iwasm).
// WASI P2 command/component path keeps i32 linear memory for the official
// canonical ABI boundary.
fn uses_memory64(target: String, wasi_version: String) -> bool {
    if is_p2_wasi(clone(wasi_version)) {
        return false
    }
    is_gc_target(clone(target))
}

fn is_simd_target(target: String) -> bool {
    // SIMD is available on both canonical Wasm targets; host profile does not
    // change the value representation.
    true
}

fn is_p2_wasi(wasi_version: String) -> bool {
    eq(clone(wasi_version), "wasi-p2")
}

// Canonical wasm32 modules use the same fixed Preview 1 import surface as the
// pinned bootstrap and component stubs (ADR-029 parity).
fn is_minimal_p1_wasi(wasi_version: String) -> bool {
    !is_p2_wasi(clone(wasi_version))
}

fn p2_host_import_count() -> i32 {
    constants::NUM_P2_IMPORTS_BASE()
}

fn p2_host_type_count() -> i32 {
    // The first five entries are retained for the Preview 1 target table.
    // P2 then adds the canonical clock, stream, and filesystem signatures.
    13
}

fn host_import_count(_target: String, wasi_version: String) -> i32 {
    if is_p2_wasi(clone(wasi_version)) {
        return p2_host_import_count()
    }
    if is_minimal_p1_wasi(clone(wasi_version)) {
        return constants::NUM_WASI_IMPORTS_COMPONENT()
    }
    constants::NUM_WASI_IMPORTS_BASE()
}

fn host_type_count(_target: String, wasi_version: String) -> i32 {
    if is_p2_wasi(clone(wasi_version)) {
        return p2_host_type_count()
    }
    if is_minimal_p1_wasi(clone(wasi_version)) {
        return constants::NUM_WASI_TYPES_COMPONENT()
    }
    constants::NUM_WASI_TYPES_BASE()
}

fn total_import_count(target: String, wasi_version: String, wit_import_count: i32) -> i32 {
    host_import_count(clone(target), clone(wasi_version)) + wit_import_count
}
