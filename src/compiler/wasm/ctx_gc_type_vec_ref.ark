use wasm::ctx_record
use wasm::gc_layout_table
use wasm::sections_types_gc_phase7

fn SelfEmitCtx_ref_fixed_type(ctx: SelfEmitCtx, slot: i32) -> i32 {
    gc_layout_table::gc_layout_table_fixed_type_index(
        ctx_record::SelfEmitCtx_gc_layout_table(ctx),
        slot
    )
}

fn SelfEmitCtx_struct_ref_array_type(ctx: SelfEmitCtx) -> i32 {
    SelfEmitCtx_ref_fixed_type(ctx, sections_types_gc_phase7::gc_struct_ref_array_offset())
}

fn SelfEmitCtx_vec_struct_ref_type(ctx: SelfEmitCtx) -> i32 {
    SelfEmitCtx_ref_fixed_type(ctx, sections_types_gc_phase7::gc_vec_struct_ref_offset())
}

fn SelfEmitCtx_fnref_array_type(ctx: SelfEmitCtx) -> i32 {
    SelfEmitCtx_ref_fixed_type(ctx, sections_types_gc_phase7::gc_fnref_array_offset())
}

fn SelfEmitCtx_vec_fnref_type(ctx: SelfEmitCtx) -> i32 {
    SelfEmitCtx_ref_fixed_type(ctx, sections_types_gc_phase7::gc_vec_fnref_offset())
}

fn SelfEmitCtx_enum_ref_array_type(ctx: SelfEmitCtx) -> i32 {
    SelfEmitCtx_ref_fixed_type(ctx, sections_types_gc_phase7::gc_enum_ref_array_offset())
}

fn SelfEmitCtx_vec_enum_ref_type(ctx: SelfEmitCtx) -> i32 {
    SelfEmitCtx_ref_fixed_type(ctx, sections_types_gc_phase7::gc_vec_enum_ref_offset())
}

fn gc_vec_elem_is_struct_ref(elem: String) -> bool {
    sections_types_gc_phase7::gc_vec_elem_name_is_struct_ref(elem)
}
