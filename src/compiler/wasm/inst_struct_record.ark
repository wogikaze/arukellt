//
// GC target: emit_struct_new uses GC struct.new only when dest is VT_GC_REF.
//            emit_struct_get/set always use linear-memory path (struct type
//            cannot be determined from MIR instruction alone; GC-typed structs
//            like Vec use explicit writer_gc calls in intrinsic files).

use mir::inst_accessors_shape
use mir::inst_accessors_operands
use mir::inst_accessors_literals
use wasm::opcodes
use wasm::writer_core
use wasm::writer_gc
use wasm::ctx_gc_type
use wasm::ctx_record
use wasm::ctx_gc_layout_lookup
use wasm::emit_target
use wasm::code_ref_locals
use wasm::code_ref_locals_block_scan
use wasm::intrinsics::helpers_core
use wasm::intrinsics::helpers_numeric_i32_convert
use mir::function_local_queries
use mir::value_types
use wasm::sections_types_gc

fn memory64_struct_local_is_i32_field(w: WasmWriter, ctx: SelfEmitCtx, val_type: i32, local_idx: i32) -> bool {
    if !writer_core::writer_memory64(w) {
        return false
    }
    if local_idx < 0 {
        // Unknown dest: only VT_I32 is a definite scalar. VT_VOID must not
        // imply i32 — many string/struct/enum payload fields still use VT_VOID
        // and must stay structref on the stack (structref<-i64 otherwise).
        return val_type == value_types::VT_I32()
    }
    let f = ctx_record::SelfEmitCtx_function_at(ctx, ctx_record::SelfEmitCtx_current_func_idx(ctx))
    let local_vt = function_local_queries::mir_local_vt_for_function(f, local_idx)
    let local_is_ref = code_ref_locals::local_has_any_ref_assignment(f, local_idx, ctx)
    helpers_numeric_i32_convert::is_memory64_i32_field_scalar(val_type, local_vt, local_is_ref)
}

fn fixed_gc_struct_field_is_i32(ctx: SelfEmitCtx, type_idx: i32, field_idx: i32) -> bool {
    if type_idx == ctx_gc_type::SelfEmitCtx_vec_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_vec_string_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_vec_v128_type(ctx) {
        return field_idx == 1
    }
    if type_idx == ctx_gc_type::SelfEmitCtx_hashmap_str_i32_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_hashmap_i32_str_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_hashmap_i32_fn_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_hashmap_str_str_type(ctx) {
        return field_idx == 0 || field_idx == 1
    }
    let user_sig = user_gc_struct_field_sig(ctx, type_idx, field_idx)
    if len(user_sig) > 0 {
        return gc_struct_field_sig_is_i32_scalar(user_sig)
    }
    let variant_types = ctx_record::SelfEmitCtx_gc_enum_variant_type_map(ctx)
    let variant_sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    let count = len(variant_types)
    let mut variant_id = 0
    while variant_id < count {
        if get_unchecked(variant_types, variant_id) == type_idx && variant_id < len(variant_sigs) {
            let fields = sections_types_gc::struct_field_sigs(get_unchecked(variant_sigs, variant_id))
            if field_idx >= 0 && field_idx < len(fields) {
                return eq(get_unchecked(fields, field_idx), String_from("i32"))
            }
            return false
        }
        variant_id = variant_id + 1
    }
    false
}

// Field type from a registered user gc_struct (by wasm type index). Empty when
// the type is not a registered struct or the field is out of range.
fn user_gc_struct_field_sig(ctx: SelfEmitCtx, type_idx: i32, field_idx: i32) -> String {
    let map = ctx_record::SelfEmitCtx_gc_struct_type_map(ctx)
    let sigs = ctx_record::SelfEmitCtx_gc_struct_sigs(ctx)
    let mut i = 0
    while i < len(map) {
        if get_unchecked(map, i) == type_idx && i < len(sigs) {
            let fields = sections_types_gc::struct_field_sigs(get_unchecked(sigs, i))
            if field_idx >= 0 && field_idx < len(fields) {
                return get_unchecked(fields, field_idx)
            }
            return String_new()
        }
        i = i + 1
    }
    String_new()
}

fn gc_struct_field_sig_is_i32_scalar(field_sig: String) -> bool {
    eq(clone(field_sig), String_from("i32")) ||
    eq(clone(field_sig), String_from("bool")) ||
    eq(clone(field_sig), String_from("char"))
}

// Prefer declared field sigs for user structs over dest-local heuristics
// (reused i64 scratches would otherwise widen String/ref fields).
fn memory64_gc_struct_get_uses_i32(w: WasmWriter, ctx: SelfEmitCtx, type_idx: i32, field_idx: i32, val_type: i32, dest: i32) -> bool {
    let user_sig = user_gc_struct_field_sig(ctx, type_idx, field_idx)
    if len(user_sig) > 0 {
        return gc_struct_field_sig_is_i32_scalar(user_sig)
    }
    fixed_gc_struct_field_is_i32(ctx, type_idx, field_idx) ||
    memory64_struct_local_is_i32_field(w, ctx, val_type, dest)
}

fn emit_struct_new(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, prev_op: i32) {
    let dest = inst_accessors_operands::MirInst_dest(inst)
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        let struct_name = inst_accessors_literals::MirInst_str_val(inst)
        let gc_type_idx = if len(struct_name) > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(struct_name)) {
            ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(struct_name))
        } else {
            ctx_gc_type::SelfEmitCtx_struct_type(ctx, inst_accessors_literals::MirInst_int_val(inst))
        }
        writer_gc::emit_gc_struct_new_default(w, gc_type_idx)
        writer_gc::emit_gc_ref_cast(w, gc_type_idx)
        writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
        writer_core::emit_leb128_u(w, dest)
        return
    }
    writer_core::emit_byte(w, opcodes::OP_GLOBAL_GET())
    writer_core::emit_leb128_u(w, 0)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, dest)
    writer_core::emit_byte(w, opcodes::OP_GLOBAL_GET())
    writer_core::emit_leb128_u(w, 0)
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, inst_accessors_literals::MirInst_int_val(inst))
    writer_core::emit_byte(w, opcodes::OP_I32_ADD())
    helpers_core::emit_heap_set(w)
}

fn emit_linear_struct_get_base(w: WasmWriter, inst: MirInst, prev_op: i32, prev_arg0: i32) {
    let base_local = inst_accessors_operands::MirInst_arg0(inst)
    if base_local < 0 {
        return
    }
    if prev_op == mir::opcodes::MIR_LOCAL_GET() && prev_arg0 == base_local {
        return
    }
    writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
    writer_core::emit_leb128_u(w, base_local)
}

fn emit_struct_get(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, prev_op: i32, prev_arg0: i32) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        let byte_offset = inst_accessors_literals::MirInst_int_val(inst)
        let gc_type_idx = resolve_gc_struct_type_idx(inst, ctx, prev_op, prev_arg0, byte_offset, inst_accessors_operands::MirInst_arg1(inst))
        let field_idx = compute_field_idx_get(inst, byte_offset)
        if prev_op == mir::opcodes::MIR_STRUCT_SET() {
            writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
            writer_core::emit_leb128_u(w, prev_arg0)
        } else if ((prev_op == mir::opcodes::MIR_STRUCT_GET() ||
            prev_op == mir::opcodes::MIR_GC_STRUCT_GET() ||
            prev_op == mir::opcodes::MIR_CALL() ||
            prev_op == mir::opcodes::MIR_WIT_CALL()) &&
        inst_accessors_operands::MirInst_arg0(inst) < 0) {
        // Nested field / `get_unchecked(...).field`: store policy leaves the
        // previous ref on the stack. Reloading MirInst_arg0 reads an unset
        // temp (#834 node.span.start, fn_info_qualified_name_at).
    } else if prev_op != mir::opcodes::MIR_LOCAL_GET() {
        let base_local = inst_accessors_operands::MirInst_arg0(inst)
        if base_local >= 0 {
            writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
            writer_core::emit_leb128_u(w, base_local)
        }
    }
    writer_gc::emit_gc_ref_cast(w, gc_type_idx)
    let val_type = inst_accessors_shape::MirInst_val_type(inst)
    // Prefer MirInst_dest when set (field gets / get_to). Fall back to
    // val_type-only gating when dest is absent (true stack-leave).
    let dest = inst_accessors_operands::MirInst_dest(inst)
    if memory64_gc_struct_get_uses_i32(w, ctx, gc_type_idx, field_idx, val_type, dest) {
        writer_gc::emit_gc_struct_get_i32(w, gc_type_idx, field_idx)
    } else {
        writer_gc::emit_gc_struct_get(w, gc_type_idx, field_idx)
    }
    // Funcref struct fields are nullable; typed fn locals / call_ref params
    // are non-null `(ref $sig)`. Narrow before local.set (same as GC_STRUCT_GET).
    if val_type == value_types::VT_FUNCREF() {
        writer_gc::emit_gc_ref_as_non_null(w)
    }
    return
}
// Linear STRUCT_GET never had a base load. After a nested field SET
// (`r.max` then `.x`) the pointer is only in dest, so i32.load saw
// an empty stack (rect_area / toml_find_field_index / data_pipeline).
emit_linear_struct_get_base(w, inst, prev_op, prev_arg0)
if inst_accessors_literals::MirInst_int_val(inst) > 0 {
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, inst_accessors_literals::MirInst_int_val(inst))
    writer_core::emit_byte(w, opcodes::OP_I32_ADD())
}
let val_type = inst_accessors_shape::MirInst_val_type(inst)
if val_type == value_types::VT_F64() {
    writer_core::emit_byte(w, opcodes::OP_F64_LOAD())
    writer_core::emit_byte(w, 3)
    writer_core::emit_byte(w, 0)
} else {
    if val_type == value_types::VT_F32() {
        writer_core::emit_byte(w, opcodes::OP_F32_LOAD())
        writer_core::emit_byte(w, 2)
        writer_core::emit_byte(w, 0)
    } else {
        if val_type == value_types::VT_I64() {
            writer_core::emit_byte(w, opcodes::OP_I64_LOAD())
            writer_core::emit_byte(w, 2)
            writer_core::emit_byte(w, 0)
        } else {
            writer_core::emit_byte(w, opcodes::OP_I32_LOAD())
            writer_core::emit_byte(w, 2)
            writer_core::emit_byte(w, 0)
        }
    }
}
}

fn emit_struct_set(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        let byte_offset = inst_accessors_literals::MirInst_int_val(inst)
        let gc_type_idx = resolve_gc_struct_type_idx(inst, ctx, 0 - 1, 0 - 1, byte_offset, inst_accessors_operands::MirInst_dest(inst))
        let field_idx = compute_field_idx_set(inst, byte_offset)
        let base_local = inst_accessors_operands::MirInst_arg0(inst)
        writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
        writer_core::emit_leb128_u(w, base_local)
        writer_gc::emit_gc_ref_cast(w, gc_type_idx)
        // Discriminant sets cast to the open enum type. Teeing that ref
        // back into a final variant local (Circle/Rect) is invalid Wasm.
        if gc_struct_set_cast_fits_local(ctx, base_local, gc_type_idx) {
            writer_core::emit_byte(w, opcodes::OP_LOCAL_TEE())
            writer_core::emit_leb128_u(w, base_local)
        }
        let value_local = inst_accessors_operands::MirInst_arg1(inst)
        writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
        writer_core::emit_leb128_u(w, value_local)
        let val_type = inst_accessors_shape::MirInst_val_type(inst)
        if memory64_gc_struct_get_uses_i32(w, ctx, gc_type_idx, field_idx, val_type, value_local) {
            writer_gc::emit_gc_struct_set_i32(w, gc_type_idx, field_idx)
        } else {
            writer_gc::emit_gc_struct_set(w, gc_type_idx, field_idx)
        }
        return
    }
    let val_type = inst_accessors_shape::MirInst_val_type(inst)
    if val_type == value_types::VT_F64() {
        emit_struct_store_value(w, inst, inst_accessors_operands::MirInst_arg1(inst), opcodes::OP_F64_STORE(), 3)
    } else {
        if val_type == value_types::VT_F32() {
            emit_struct_store_value(w, inst, inst_accessors_operands::MirInst_arg1(inst), opcodes::OP_F32_STORE(), 2)
        } else {
            if val_type == value_types::VT_I64() {
                emit_struct_store_value(w, inst, inst_accessors_operands::MirInst_arg1(inst), opcodes::OP_I64_STORE(), 2)
            } else {
                emit_struct_store_value(w, inst, inst_accessors_operands::MirInst_arg1(inst), opcodes::OP_I32_STORE(), 2)
            }
        }
    }
}

fn emit_struct_store_value(w: WasmWriter, inst: MirInst, value_local: i32, store_opcode: i32, align: i32) {
    writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
    writer_core::emit_leb128_u(w, inst_accessors_operands::MirInst_arg0(inst))
    if inst_accessors_literals::MirInst_int_val(inst) > 0 {
        writer_core::emit_byte(w, opcodes::OP_I32_CONST())
        writer_core::emit_leb128_s(w, inst_accessors_literals::MirInst_int_val(inst))
        writer_core::emit_byte(w, opcodes::OP_I32_ADD())
    }
    writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
    writer_core::emit_leb128_u(w, value_local)
    writer_core::emit_byte(w, store_opcode)
    writer_core::emit_byte(w, align)
    writer_core::emit_byte(w, 0)
}

fn compute_field_idx_set(inst: MirInst, byte_offset: i32) -> i32 {
    let dest = inst_accessors_operands::MirInst_dest(inst)
    if dest >= 100000 {
        return dest / 100000
    }
    byte_offset / 4
}

fn compute_field_idx_get(inst: MirInst, byte_offset: i32) -> i32 {
    let arg1 = inst_accessors_operands::MirInst_arg1(inst)
    if arg1 >= 100000 {
        return arg1 / 100000
    }
    byte_offset / 4
}

fn gc_struct_set_cast_fits_local(ctx: SelfEmitCtx, base_local: i32, gc_type_idx: i32) -> bool {
    if base_local < 0 || gc_type_idx < 0 {
        return false
    }
    let local_ty = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, base_local)
    if local_ty == gc_type_idx {
        return true
    }
    let f = ctx_record::SelfEmitCtx_function_at(ctx, ctx_record::SelfEmitCtx_current_func_idx(ctx))
    match code_ref_locals_block_scan::local_set_non_string_storage_type(f, base_local, ctx) {
        Option::Some(copied_type) => copied_type == gc_type_idx
        Option::None => false
    }
}

fn enum_discriminant_open_type(ctx: SelfEmitCtx, type_idx: i32, field_idx: i32) -> i32 {
    // Discriminant (field 0) lives on the open enum type. Casting a Some/Ok
    // value to the None/Err variant before struct.get traps (for-in Option).
    if field_idx == 0 && ctx_gc_layout_lookup::SelfEmitCtx_wasm_type_is_enum_variant(ctx, type_idx) {
        let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
        if open_type >= 0 {
            return open_type
        }
    }
    type_idx
}

fn resolve_gc_struct_type_idx(inst: MirInst, ctx: SelfEmitCtx, prev_op: i32, prev_arg0: i32, byte_offset: i32, size_hint: i32) -> i32 {
    // Prefer MirLocal.value_type / spine over MIR str_val. Tuple destructure
    // may stamp size-only names like `tuple:i32,i32` while the base local
    // already carries the concrete mono layout (e.g. pair i32+String).
    let field_idx = compute_field_idx_get(inst, byte_offset)
    let mut base_local = inst_accessors_operands::MirInst_arg0(inst)
    if base_local < 0 && prev_arg0 >= 0 && (prev_op == mir::opcodes::MIR_LOCAL_GET() || prev_op == mir::opcodes::MIR_STRUCT_SET()) {
        base_local = prev_arg0
    }
    if base_local >= 0 {
        let f =
        ctx_record::SelfEmitCtx_function_at(ctx, ctx_record::SelfEmitCtx_current_func_idx(ctx))
        let copied_storage =
        code_ref_locals_block_scan::local_set_non_string_storage_type(f, base_local, ctx)
        match copied_storage {
            Option::Some(copied_type) => {
                return enum_discriminant_open_type(ctx, copied_type, field_idx)
            }
            Option::None => {}
        }
        let spine_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, base_local)
        if spine_gc >= 0 {
            return enum_discriminant_open_type(ctx, spine_gc, field_idx)
        }
        let open_storage = code_ref_locals_block_scan::local_enum_open_storage_type(f, base_local, ctx)
        match open_storage {
            Option::Some(open_type) => {
                if field_idx == 0 {
                    return open_type
                }
            }
            Option::None => {}
        }
    }
    let struct_name = inst_accessors_literals::MirInst_str_val(inst)
    if len(struct_name) > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(struct_name)) {
        return enum_discriminant_open_type(
            ctx,
            ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(struct_name)),
            field_idx
        )
    }
    let size_hint_val = size_hint
    let struct_size_est = if size_hint_val >= 100000 {
        size_hint_val % 100000
    } else if size_hint_val > 0 {
        size_hint_val
    } else {
        byte_offset + 4
    }
    enum_discriminant_open_type(ctx, ctx_gc_type::SelfEmitCtx_struct_type(ctx, struct_size_est), field_idx)
}
