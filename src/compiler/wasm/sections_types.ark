use std::prelude::{byte_at, clone, starts_with}
use mir::module_wit_imports
use mir::module_gc_enum
use mir::module_gc_struct
use wasm::emit_target
use wasm::opcodes
use wasm::sections_type_plan
use wasm::sections_types_gc
use wasm::sections_types_emit
use wasm::sections_types_sigs
use wasm::sections_exports
use wasm::writer_core
use wasm::writer_sections
use mir::module_canon
struct TypeCanonPlan { canon_types: Vec<String>, type_map: Vec<i32> }

fn emit_type_section(
    out: WasmWriter,
    mir: MirModule,
    functions: Vec<MirFunction>,
    fn_count: i32,
    needs_wrapper: i32,
    target: String,
    wasi_version: String,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>
) -> TypeSectionPlan {
    let memory64 = writer_core::writer_memory64(out)
    let num_host_types = emit_target::host_type_count(clone(target), clone(wasi_version))
    let wit_import_count = module_wit_imports::wit_import_count(bindings)
    let mut gc_fixed_count = 0
    let mut enum_variant_count = 0
    let mut gc_struct_count = 0
    let mut gc_callback_count = 0
    if emit_target::is_gc_target(clone(target)) {
        gc_fixed_count = sections_types_gc::gc_type_sig_count()
        enum_variant_count = module_gc_enum::MirModule_gc_enum_variant_sig_count(mir)
        gc_struct_count = module_gc_struct::MirModule_gc_struct_sig_count(mir)
        gc_callback_count = sections_types_sigs::gc_typed_callback_type_sig_count()
    }
    let gc_type_count = gc_fixed_count + enum_variant_count + gc_struct_count + gc_callback_count
    let p2_library_post_count = if emit_target::is_p2_wasi(clone(wasi_version)) {
        sections_exports::p2_library_export_count(mir, fn_count)
    } else {
        0
    }
    let p2_library_wrapper_count = if emit_target::is_p2_wasi(clone(wasi_version)) {
        sections_exports::p2_library_wrapper_count(mir, fn_count, clone(target), clone(wasi_version))
    } else {
        0
    }
    let pair_sigs = sections_types_sigs::collect_pair_call_type_sigs(
        functions,
        fn_count,
        clone(target),
        memory64,
        module_gc_struct::MirModule_gc_struct_names(mir)
    )
    let pair_sig_count = len(pair_sigs)
    let type_sigs = build_type_sigs(
        mir,
        functions,
        fn_count,
        needs_wrapper,
        clone(target),
        clone(wasi_version),
        memory64,
        bindings,
        pair_sigs
    )
    let canon_plan = canonicalize_type_sigs(mir, type_sigs)
    let canon_types = TypeCanonPlan_canon_types(canon_plan)
    let type_map = TypeCanonPlan_type_map(canon_plan)
    let linear_gc_enabled = emit_target::is_linear_memory_target(clone(target))
    let linear_gc_sig_count = if linear_gc_enabled { 8 } else { 0 }
    let p2_runtime_start = len(type_map) - 2 - linear_gc_sig_count - pair_sig_count
    let p2_realloc_type_idx = if emit_target::is_p2_wasi(clone(wasi_version)) {
        get_unchecked(type_map, p2_runtime_start)
    } else {
        0 - 1
    }
    let p2_initialize_type_idx = if emit_target::is_p2_wasi(clone(wasi_version)) {
        get_unchecked(type_map, p2_runtime_start + 1)
    } else {
        0 - 1
    }
    let linear_gc_type_map = build_linear_gc_type_map(
        type_map,
        num_host_types,
        wit_import_count,
        gc_type_count,
        fn_count,
        needs_wrapper,
        p2_library_post_count,
        p2_library_wrapper_count,
        emit_target::is_p2_wasi(clone(wasi_version)),
        linear_gc_enabled
    )
    let gc_type_base = first_gc_type_index(canon_types)
    // Module GC canon indices are assigned at registration and stored on
    // the module (#851 Phase 3): the stored per-slot vectors are the
    // slot→canon maps emit reads — no section-position arithmetic needed.
    let gc_struct_type_map = module_gc_struct::MirModule_gc_struct_canon_idxs(mir)
    let gc_enum_variant_type_map = module_gc_enum::MirModule_gc_enum_variant_canon_idxs(mir)
    let mut gc_struct_base = 0 - 1
    if gc_struct_count > 0 {
        gc_struct_base = get_unchecked(gc_struct_type_map, 0)
    }
    let mut gc_enum_variant_base = 0 - 1
    if enum_variant_count > 0 {
        gc_enum_variant_base = get_unchecked(gc_enum_variant_type_map, 0)
    }
    // Pair-call signatures occupy the last pair_sig_count type_map slots.
    let pair_call_type_map = Vec::new<i32>()
    let mut pci = len(type_map) - pair_sig_count
    while pci < len(type_map) {
        push(pair_call_type_map, get_unchecked(type_map, pci))
        pci = pci + 1
    }
    let plan = sections_type_plan::build_type_section_plan(
        type_map,
        num_host_types,
        wit_import_count,
        gc_type_count,
        fn_count,
        needs_wrapper,
        gc_type_base,
        gc_enum_variant_base,
        gc_enum_variant_type_map,
        gc_struct_base,
        gc_struct_type_map,
        emit_target::is_p2_wasi(clone(wasi_version)),
        p2_library_post_count,
        p2_library_wrapper_count,
        p2_realloc_type_idx,
        p2_initialize_type_idx,
        linear_gc_type_map,
        pair_sigs,
        pair_call_type_map
    )
    let type_sec = writer_core::WasmWriter_with_memory64(writer_core::writer_memory64(out))
    writer_core::emit_leb128_u(type_sec, len(canon_types))
    let fn_type_refs =
    sections_types_emit::emit_canon_type_entries(type_sec, canon_types, gc_type_base, gc_struct_type_map, memory64)
    sections_type_plan::TypeSectionPlan_set_fn_type_refs(plan, fn_type_refs)
    writer_sections::emit_section(out, opcodes::SEC_TYPE(), type_sec)
    plan
}

fn build_linear_gc_type_map(
    type_map: Vec<i32>,
    num_host_types: i32,
    wit_import_count: i32,
    gc_type_count: i32,
    fn_count: i32,
    needs_wrapper: i32,
    p2_library_post_count: i32,
    p2_library_wrapper_count: i32,
    p2_enabled: bool,
    linear_gc_enabled: bool
) -> Vec<i32> {
    let linear_map = Vec::new<i32>()
    if !linear_gc_enabled {
        return linear_map
    }
    let command_extra = if p2_enabled {
        if needs_wrapper == 1 { 2 } else { 0 }
    } else {
        needs_wrapper
    }
    let p2_runtime_extra = if p2_enabled { 2 } else { 0 }
    let start = num_host_types + wit_import_count + gc_type_count + fn_count +
    command_extra + p2_library_post_count + p2_library_wrapper_count + p2_runtime_extra
    let count = 8
    let mut i = 0
    while i < count {
        push(linear_map, get_unchecked(type_map, start + i))
        i = i + 1
    }
    linear_map
}

fn TypeCanonPlan_new(canon_types: Vec<String>, type_map: Vec<i32>) -> TypeCanonPlan {
    TypeCanonPlan { canon_types: canon_types, type_map: type_map }
}

fn TypeCanonPlan_canon_types(plan: TypeCanonPlan) -> Vec<String> {
    plan.canon_types
}

fn TypeCanonPlan_type_map(plan: TypeCanonPlan) -> Vec<i32> {
    plan.type_map
}

fn build_type_sigs(
    mir: MirModule,
    functions: Vec<MirFunction>,
    fn_count: i32,
    needs_wrapper: i32,
    target: String,
    wasi_version: String,
    memory64: bool,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    pair_sigs: Vec<String>
) -> Vec<String> {
    let type_sigs = Vec::new<String>()
    sections_types_sigs::append_wasi_type_sigs(type_sigs, clone(wasi_version))
    sections_types_sigs::append_wit_type_sigs(type_sigs, bindings)
    if emit_target::is_gc_target(clone(target)) {
        sections_types_gc::append_gc_type_sigs(type_sigs)
        sections_types_sigs::append_gc_typed_callback_type_sigs(type_sigs)
        // Module GC types: sealed slots first, then late registrations in
        // recorded order so no type references a later index (#851
        // Phase 3 — forward refs are invalid outside a rec group).
        sections_types_gc::append_module_gc_type_sigs(type_sigs, mir)
    }
    sections_types_sigs::append_function_type_sigs(
        type_sigs,
        functions,
        fn_count,
        clone(target),
        clone(wasi_version),
        memory64,
        mir
    )
    sections_types_sigs::append_wrapper_type_sig(type_sigs, needs_wrapper, clone(wasi_version))
    if emit_target::is_p2_wasi(clone(wasi_version)) {
        sections_types_sigs::append_p2_library_post_type_sigs(
            type_sigs,
            functions,
            fn_count,
            clone(target),
            clone(wasi_version),
            memory64,
            mir
        )
        sections_types_sigs::append_p2_library_wrapper_type_sigs(
            type_sigs,
            functions,
            fn_count,
            clone(target),
            clone(wasi_version),
            mir
        )
    }
    sections_types_sigs::append_p2_runtime_type_sigs(type_sigs, clone(wasi_version))
    sections_types_sigs::append_linear_gc_type_sigs(type_sigs, clone(target))
    // Pair-ABI call-site signatures (#872): registered last so their canon
    // indices never shift host/GC/function regions; dedup maps them onto an
    // existing canon type whenever a program function already carries the
    // same (env, args...) -> ret signature.
    let mut psi = 0
    while psi < len(pair_sigs) {
        push(type_sigs, get_unchecked(pair_sigs, psi))
        psi = psi + 1
    }
    type_sigs
}

// Dedup the collected type sigs through the module's append-only canon
// table (#851 Phase 3). The table preserves first-occurrence order, so the
// resulting canon_types/type_map are identical to a fresh local index —
// the difference is that registrations outside this path may also append,
// keeping every canon index stable for earlier body emit.
fn canonicalize_type_sigs(mir: MirModule, type_sigs: Vec<String>) -> TypeCanonPlan {
    let mut type_map = Vec::new<i32>()
    let ts_count = len(type_sigs)
    let mut tsi = 0
    while tsi < ts_count {
        push(type_map, module_canon::MirModule_canon_ensure(mir, clone(get_unchecked(type_sigs, tsi))))
        tsi = tsi + 1
    }
    TypeCanonPlan_new(module_canon::MirModule_canon_sigs(mir), type_map)
}

fn first_gc_type_index(canon_types: Vec<String>) -> i32 {
    for i in 0..len(canon_types) {
        let sig = get_unchecked(canon_types, i)
        if byte_at(clone(sig), 0) == 65 {
            return i
        }
        if starts_with(clone(sig), "GS_f") {
            return i
        }
        if starts_with(clone(sig), "Sub") {
            return i
        }
    }
    0 - 1
}
