use mir::module_wit_imports
use mir::module_gc_enum
use mir::module_gc_struct
use wasm::emit_target
use wasm::gc_layout_table_build
use wasm::opcodes
use wasm::sections_type_plan
use wasm::sections_types_gc
use wasm::sections_types_emit
use wasm::sections_types_sig_parse
use wasm::sections_types_sigs
use wasm::writer_core
use wasm::writer_sections

struct TypeCanonPlan { canon_types: Vec<String>, type_map: Vec<i32> }

fn emit_type_section(
    out: WasmWriter,
    mir: MirModule,
    functions: Vec<MirFunction>,
    fn_count: i32,
    needs_wrapper: i32,
    target: String,
    wasi_version: String,
    needs_runtime_host: i32,
    needs_wasi_http_outgoing: i32,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    gc_layout: GcLayoutTable
) -> TypeSectionPlan {
    let num_host_types = emit_target::host_type_count(clone(target), clone(wasi_version), needs_runtime_host, needs_wasi_http_outgoing)
    let wit_import_count = module_wit_imports::wit_import_count(bindings)
    let mut gc_fixed_count = 0
    let mut enum_variant_count = 0
    let mut gc_struct_count = 0
    if emit_target::is_gc_target(clone(target)) {
        gc_fixed_count = sections_types_gc::gc_type_sig_count()
        enum_variant_count = module_gc_enum::MirModule_gc_enum_variant_sig_count(mir)
        gc_struct_count = module_gc_struct::MirModule_gc_struct_sig_count(mir)
    }
    let type_sigs = build_type_sigs(mir, functions, fn_count, needs_wrapper, clone(target), clone(wasi_version), needs_runtime_host, needs_wasi_http_outgoing, bindings)
    let canon_plan = canonicalize_type_sigs(type_sigs)
    let canon_types = TypeCanonPlan_canon_types(canon_plan)
    let type_map = TypeCanonPlan_type_map(canon_plan)
    let plan = sections_type_plan::build_type_section_plan(
        type_map,
        num_host_types,
        wit_import_count,
        gc_fixed_count,
        gc_struct_count,
        enum_variant_count,
        fn_count,
        needs_wrapper
    )
    let gc_fixed_type_map = sections_type_plan::TypeSectionPlan_gc_fixed_type_map(plan)
    let gc_struct_type_map = sections_type_plan::TypeSectionPlan_gc_struct_type_map(plan)
    sections_type_plan::TypeSectionPlan_set_fn_result_gc_map(
        plan,
        build_fn_result_gc_map(
            type_sigs,
            num_host_types,
            wit_import_count,
            gc_fixed_count + gc_struct_count + enum_variant_count,
            fn_count,
            gc_fixed_type_map,
            gc_struct_type_map
        )
    )
    if emit_target::is_gc_target(clone(target)) {
        gc_layout_table_build::populate_gc_layout_table_for_emit(
            gc_layout,
            mir,
            gc_fixed_type_map,
            sections_type_plan::TypeSectionPlan_gc_enum_variant_type_map(plan),
            gc_struct_type_map
        )
    }
    let type_sec = writer_core::WasmWriter_with_memory64(writer_core::writer_memory64(out))
    writer_core::emit_leb128_u(type_sec, len(canon_types))
    sections_types_emit::emit_canon_type_entries(type_sec, canon_types, gc_fixed_type_map, gc_struct_type_map)
    writer_sections::emit_section(out, opcodes::SEC_TYPE(), type_sec)
    plan
}

fn TypeCanonPlan_new(canon_types: Vec<String>, type_map: Vec<i32>) -> TypeCanonPlan {
    TypeCanonPlan { canon_types: canon_types, type_map: type_map }
}

fn TypeCanonPlan_canon_types(plan: TypeCanonPlan) -> Vec<String> {
    plan.canon_types
}

fn TypeCanonPlan_type_map(plan: TypeCanonPlan) -> Vec<i32> {
    plan.type_map
}

fn build_type_sigs(
    mir: MirModule,
    functions: Vec<MirFunction>,
    fn_count: i32,
    needs_wrapper: i32,
    target: String,
    wasi_version: String,
    needs_runtime_host: i32,
    needs_wasi_http_outgoing: i32,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>
) -> Vec<String> {
    let type_sigs = Vec::new<String>()
    sections_types_sigs::append_wasi_type_sigs(type_sigs, clone(wasi_version), needs_runtime_host, needs_wasi_http_outgoing)
    sections_types_sigs::append_wit_type_sigs(type_sigs, bindings)
    if emit_target::is_gc_target(clone(target)) {
        sections_types_gc::append_gc_type_sigs(type_sigs)
        // Structs before enum variants so gcsref fields resolve (#726).
        sections_types_gc::append_gc_struct_sigs(type_sigs, mir)
        sections_types_gc::append_enum_variant_sigs(type_sigs, mir)
    }
    sections_types_sigs::append_function_type_sigs(
        type_sigs,
        functions,
        fn_count,
        clone(target),
        clone(wasi_version),
        mir
    )
    sections_types_sigs::append_wrapper_type_sig(type_sigs, needs_wrapper)
    type_sigs
}

fn canonicalize_type_sigs(type_sigs: Vec<String>) -> TypeCanonPlan {
    let canon_types = Vec::new<String>()
    let mut type_map = Vec::new<i32>()
    let ts_count = len(type_sigs)
    let mut tsi = 0
    while tsi < ts_count {
        let sig = get_unchecked(type_sigs, tsi)
        let found = find_canon_type_index(canon_types, sig)
        if found >= 0 {
            push(type_map, found)
        } else {
            push(type_map, len(canon_types))
            push(canon_types, sig)
        }
        tsi = tsi + 1
    }
    TypeCanonPlan_new(canon_types, type_map)
}

// Per-function wasm result type index already used in the type section.
// Scalar / void / funcref results are -1. Dest infer must read this map
// instead of re-guessing from leftover MIR return names.
fn build_fn_result_gc_map(
    type_sigs: Vec<String>,
    num_host_types: i32,
    wit_import_count: i32,
    gc_type_count: i32,
    fn_count: i32,
    gc_fixed_type_map: Vec<i32>,
    gc_struct_type_map: Vec<i32>
) -> Vec<i32> {
    let mut result_map = Vec::new<i32>()
    let base_idx = num_host_types + wit_import_count + gc_type_count
    let mut fi = 0
    while fi < fn_count {
        push(
            result_map,
            result_sig_gc_type_idx(
                get_unchecked(type_sigs, base_idx + fi),
                gc_fixed_type_map,
                gc_struct_type_map
            )
        )
        fi = fi + 1
    }
    result_map
}

fn result_sig_gc_type_idx(
    csig: String,
    gc_fixed_type_map: Vec<i32>,
    gc_struct_type_map: Vec<i32>
) -> i32 {
    let result_seg = sections_type_plan::type_sig_result_segment(csig)
    if eq(clone(result_seg), "0") || len(result_seg) < 2 {
        return 0 - 1
    }
    result_val_sig_gc_type_idx(
        substring(result_seg, 1, len(result_seg)),
        gc_fixed_type_map,
        gc_struct_type_map
    )
}

fn result_val_sig_gc_type_idx(
    rt: String,
    gc_fixed_type_map: Vec<i32>,
    gc_struct_type_map: Vec<i32>
) -> i32 {
    if starts_with(clone(rt), "gcsref") {
        let slot = sections_types_sig_parse::parse_type_sig_int(substring(rt, 6, len(rt)))
        if slot >= 0 && slot < len(gc_struct_type_map) {
            return get_unchecked(gc_struct_type_map, slot)
        }
        return 0 - 1
    }
    if starts_with(clone(rt), "gcref") {
        let slot = sections_types_sig_parse::parse_gcref_offset(rt)
        if slot >= 0 && slot < len(gc_fixed_type_map) {
            return get_unchecked(gc_fixed_type_map, slot)
        }
        return 0 - 1
    }
    if eq(clone(rt), "ref") && len(gc_fixed_type_map) > 0 {
        return get_unchecked(gc_fixed_type_map, 0)
    }
    0 - 1
}

fn find_canon_type_index(canon_types: Vec<String>, sig: String) -> i32 {
    let mut found = 0 - 1
    let mut cti = 0
    while cti < len(canon_types) {
        if eq(clone(get_unchecked(canon_types, cti)), clone(sig)) {
            found = cti
        }
        cti = cti + 1
    }
    found
}
