use wasm::constants
use wasm::ctx_scratch
use wasm::runtime_abi_env_arg_at_body
use wasm::runtime_abi_env_arg_list_populate
use wasm::runtime_abi_env_args_gc
use wasm::runtime_abi_env_has_flag_body
use wasm::runtime_abi_env_var
use wasm::runtime_abi_env_var_gc
use wasm::emit_target
use wasm::ctx_record
use wasm::import_indices
use wasm::intrinsics::helpers_control
use wasm::intrinsics::helpers_core
use wasm::intrinsics::helpers_core_heap
use wasm::intrinsics::helpers_io_layout
use wasm::intrinsics::helpers_memory
use wasm::intrinsics::helpers_numeric_i32
use wasm::host_intrinsic_adapter

fn emit_env_arg_count(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        helpers_io_layout::emit_scratch_addr_wasi(w, constants::SCRATCH_ARGC())
        helpers_core::emit_call(w, import_indices::arguments_import_idx(ctx))
        helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_ARGC() + 4)
        helpers_memory::emit_i32_load_default(w)
        helpers_numeric_i32::emit_i32_const(w, 1)
        helpers_numeric_i32::emit_i32_sub(w)
        return true
    }
    host_intrinsic_adapter::emit_canonical_memory32_static_address(w, constants::SCRATCH_ARGC())
    host_intrinsic_adapter::emit_canonical_memory32_static_address(w, constants::SCRATCH_ARGV_SIZE())
    helpers_core::emit_call(w, import_indices::args_sizes_import_idx(ctx))
    helpers_core::emit_drop(w)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_ARGC())
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_sub(w)
    return true
}

fn emit_env_args(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return runtime_abi_env_args_gc::emit_env_args_gc(w, ctx)
    }
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        emit_env_args_prepare_vec_p2(w, ctx)
        emit_env_args_populate_p2(w, ctx)
    } else {
        emit_env_args_prepare_vec(w, ctx)
        runtime_abi_env_arg_list_populate::emit_env_args_populate(w, ctx)
    }
    helpers_core::emit_local_get(w, ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1))
    return true
}

fn emit_env_has_flag(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    runtime_abi_env_has_flag_body::emit_has_flag(w, inst, ctx)
}

fn emit_env_arg_at(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return runtime_abi_env_args_gc::emit_env_arg_at_gc(w, ctx)
    }
    runtime_abi_env_arg_at_body::emit_arg_at(w, ctx)
}

fn emit_env_var(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    runtime_abi_env_var::emit_env_var(w, inst, ctx)
}

fn emit_env_get_var(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    runtime_abi_env_var::emit_env_get_var(w, inst, ctx)
}

fn emit_env_var_or_default(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return runtime_abi_env_var_gc::emit_env_var_or_default_gc(w, inst, ctx)
    }
    emit_env_var_default_fallback(w, ctx_scratch::SelfEmitCtx_scratch_base(ctx))
    return true
}

fn emit_env_args_prepare_vec(mut w: WasmWriter, ctx: SelfEmitCtx) {
    emit_env_args_load_argc(w, ctx)
    emit_env_args_alloc_vec_header(w, ctx)
    emit_env_args_alloc_data_slots(w, ctx)
}

fn emit_env_args_prepare_vec_p2(mut w: WasmWriter, ctx: SelfEmitCtx) {
    let s_argc = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    let s_argv = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 4)
    helpers_io_layout::emit_scratch_addr_wasi(w, constants::SCRATCH_ARGC())
    helpers_core::emit_call(w, import_indices::arguments_import_idx(ctx))
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_ARGC())
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_argv)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_ARGC() + 4)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_argc)
    emit_env_args_alloc_vec_header(w, ctx)
    emit_env_args_alloc_data_slots_p2(w, ctx)
}

fn emit_env_args_alloc_data_slots_p2(mut w: WasmWriter, ctx: SelfEmitCtx) {
    let s_argc = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    let s_vec = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    let s_data = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    helpers_core::emit_local_get(w, s_argc)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_sub(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_const(w, 3)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_numeric_i32::emit_i32_const(w, -4)
    helpers_numeric_i32::emit_i32_and(w)
    helpers_core_heap::emit_heap_alloc_from_stack(w)
    helpers_core::emit_local_set(w, s_data)
    helpers_core::emit_local_get(w, s_vec)
    helpers_core::emit_local_get(w, s_data)
    helpers_memory::emit_i32_store(w, 8)
}

fn emit_env_args_populate_p2(mut w: WasmWriter, ctx: SelfEmitCtx) {
    let s_argc = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    let s_data = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    let s_li = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 3)
    let s_argv = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 4)
    let s_cstr = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 7)
    let s_slen = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 5)
    let s_str = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 6)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_core::emit_local_set(w, s_li)
    helpers_control::emit_block_loop_header(w)
    helpers_core::emit_local_get(w, s_li)
    helpers_core::emit_local_get(w, s_argc)
    helpers_numeric_i32::emit_i32_ge_s(w)
    helpers_control::emit_br_if(w, 1)
    emit_env_args_load_p2_string(w, s_argv, s_li, s_cstr, s_slen)
    runtime_abi_env_arg_list_populate::emit_env_args_copy_cstr_to_string(w, ctx, s_cstr, s_slen, s_str)
    runtime_abi_env_arg_list_populate::emit_env_args_store_string_slot(w, s_data, s_li, s_str)
    helpers_core::emit_local_get(w, s_li)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, s_li)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_block_loop_footer(w)
}

fn emit_env_args_load_p2_string(mut w: WasmWriter, s_argv: i32, s_li: i32, s_ptr: i32, s_len: i32) {
    helpers_core::emit_local_get(w, s_argv)
    helpers_core::emit_local_get(w, s_li)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_tee(w, s_ptr)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_ptr)
    helpers_core::emit_local_get(w, s_argv)
    helpers_core::emit_local_get(w, s_li)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_len)
}

fn emit_env_args_load_argc(mut w: WasmWriter, ctx: SelfEmitCtx) {
    host_intrinsic_adapter::emit_canonical_memory32_static_address(w, constants::SCRATCH_ARGC())
    host_intrinsic_adapter::emit_canonical_memory32_static_address(w, constants::SCRATCH_ARGV_SIZE())
    helpers_core::emit_call(w, import_indices::args_sizes_import_idx(ctx))
    helpers_core::emit_drop(w)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_ARGC())
    helpers_memory::emit_i32_load_default(w)
    let s_argc = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    helpers_core::emit_local_set(w, s_argc)
}

fn emit_env_args_alloc_vec_header(mut w: WasmWriter, ctx: SelfEmitCtx) {
    let s_vec = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    helpers_numeric_i32::emit_i32_const(w, 12)
    helpers_core_heap::emit_heap_alloc_from_stack(w)
    helpers_core::emit_local_set(w, s_vec)
    helpers_core::emit_local_get(w, s_vec)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_memory::emit_i32_store(w, 0)
    helpers_core::emit_local_get(w, s_vec)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_memory::emit_i32_store(w, 8)
}

fn emit_env_args_alloc_data_slots(mut w: WasmWriter, ctx: SelfEmitCtx) {
    let s_data = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    helpers_numeric_i32::emit_i32_const(w, 32)
    helpers_core_heap::emit_heap_alloc_from_stack(w)
    helpers_core::emit_local_set(w, s_data)
    let s_vec = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    helpers_core::emit_local_get(w, s_vec)
    helpers_core::emit_local_get(w, s_data)
    helpers_memory::emit_i32_store(w, 8)
}

fn emit_env_var_default_fallback(mut w: WasmWriter, default_local: i32) {
    helpers_core::emit_local_set(w, default_local)
    helpers_core::emit_drop(w)
    helpers_core::emit_local_get(w, default_local)
}
