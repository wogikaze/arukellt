use wasm::sections_tail
use wasm::sections_exports
use wasm::sections_functions
use wasm::sections_imports
use wasm::sections_memory
use wasm::sections_table
use wasm::sections_type_plan
use wasm::sections_types

fn emit_type_section(
    out: WasmWriter,
    mir: MirModule,
    functions: Vec<MirFunction>,
    fn_count: i32,
    needs_wrapper: i32,
    target: String,
    wasi_version: String,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    gc_layout: GcLayoutTable
) -> TypeSectionPlan {
    sections_types::emit_type_section(
        out,
        mir,
        functions,
        fn_count,
        needs_wrapper,
        target,
        wasi_version,
        bindings,
        gc_layout
    )
}

fn emit_import_section(
    out: WasmWriter,
    host_type_map: Vec<i32>,
    target: String,
    wasi_version: String,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    wit_type_map: Vec<i32>
) {
    sections_imports::emit_import_section(out, host_type_map, target, wasi_version, bindings, wit_type_map)
}

fn emit_function_section(
    out: WasmWriter,
    fn_count: i32,
    fn_type_map: Vec<i32>,
    needs_wrapper: i32,
    wrapper_type_idx: i32,
    p2_post_type_idx: i32,
    p2_library_post_type_map: Vec<i32>,
    p2_library_wrapper_type_map: Vec<i32>,
    p2_realloc_type_idx: i32,
    p2_initialize_type_idx: i32
) {
    sections_functions::emit_function_section(
        out,
        fn_count,
        fn_type_map,
        needs_wrapper,
        wrapper_type_idx,
        p2_post_type_idx,
        p2_library_post_type_map,
        p2_library_wrapper_type_map,
        p2_realloc_type_idx,
        p2_initialize_type_idx
    )
}

fn emit_table_section(out: WasmWriter, mir: MirModule) {
    sections_table::emit_table_section(out, mir)
}

fn emit_memory_section(out: WasmWriter, target: String) {
    sections_memory::emit_memory_section(out, target)
}

fn emit_global_section(out: WasmWriter, data_offset: i32, literal_cache: GcStringLiteralCacheGlobal) {
    sections_memory::emit_global_section(out, data_offset, literal_cache)
}

fn emit_export_section(
    out: WasmWriter,
    mir: MirModule,
    fn_count: i32,
    needs_wrapper: i32,
    target: String,
    wasi_version: String,
    wit_import_count: i32
) {
    sections_exports::emit_export_section(out, mir, fn_count, needs_wrapper, target, wasi_version, wit_import_count)
}

fn emit_element_section(out: WasmWriter, mir: MirModule, target: String, wasi_version: String, wit_import_count: i32) {
    sections_table::emit_element_section(out, mir, target, wasi_version, wit_import_count)
}

fn emit_tail_sections(out: WasmWriter, ctx: SelfEmitCtx, strings: EmitStringTablePlan, opt_level: i32, import_count: i32, strip_debug: bool, source_file: String) {
    sections_tail::emit_tail_sections(out, ctx, strings, opt_level, import_count, strip_debug, source_file)
}

