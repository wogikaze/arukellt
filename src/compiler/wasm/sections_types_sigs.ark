use mir::emit_artifacts
use mir::module_emit_artifacts
use mir::module_gc_struct
use mir::module_wit_imports
use mir::function_block_queries
use mir::block_inst_access
use mir::inst_accessors_literals
use mir::inst_accessors_shape
use wasm::call_indirect
use wasm::emit_target
use wasm::sections_types_sigs_detail
use wasm::sections_exports
use mir::opcodes as mir_opcodes
fn append_wit_type_sigs(mut type_sigs: Vec<String>, bindings: Vec<resolver::wit_import_bind::WitImportBinding>) {
    let mut i = 0
    while i < module_wit_imports::wit_import_count(bindings) {
        push(type_sigs, module_wit_imports::wit_import_type_sig(bindings, i))
        i = i + 1
    }
}

fn append_wasi_type_sigs(mut type_sigs: Vec<String>, wasi_version: String) {
    push(type_sigs, "i32_i32_i32_i32_1i32")
    push(type_sigs, "i32_i32_1i32")
    push(type_sigs, "i32_i32_i32_i32_i32_i64_i64_i32_i32_1i32")
    push(type_sigs, "i32_1i32")
    push(type_sigs, "i32_0")
    if emit_target::is_minimal_p1_wasi(wasi_version.clone()) {
        push(type_sigs, "i32_i64_i32_1i32")
    } else if emit_target::is_p2_wasi(wasi_version.clone()) {
        push(type_sigs, "1i64")
        // Official P2 signatures, in the same order as the host type map.
        push(type_sigs, "i32_0")
        push(type_sigs, "1i32")
        push(type_sigs, "i32_i32_i32_i32_0")
        push(type_sigs, "i32_i64_i32_0")
        push(type_sigs, "i32_i64_i64_i32_0")
        push(type_sigs, "i32_i32_i32_i64_i32_0")
        push(type_sigs, "i32_i32_i32_i32_i32_i32_i32_0")
    } else {
        push(type_sigs, "i32_i64_i32_1i32")
    }
    // Memory64 GC callbacks use widened scalar parameters. Keep these
    // function types before user function signatures so typed funcref params
    // can reference them without a forward type index.
    push(type_sigs, "i64_1i64")
    push(type_sigs, "i64_i64_1i64")
}

fn append_t2_type_sigs(mut type_sigs: Vec<String>) {
    push(type_sigs, "i32_i32_0")
    push(type_sigs, "0")
    push(type_sigs, "i32_i32_1i32")
}

fn gc_typed_callback_type_sig_count() -> i32 {
    3
}

fn append_gc_typed_callback_type_sigs(mut type_sigs: Vec<String>) {
    // These signatures are placed after the fixed GC layouts and before user
    // functions. Struct fields may refer to them, while the type-section
    // planner still treats the complete range as pre-function types.
    push(type_sigs, "gcref0_1gcref0")
    push(type_sigs, "gcref0_1i32")
    push(type_sigs, "gcref0_1i64")
}

fn append_function_type_sigs(
    mut type_sigs: Vec<String>,
    functions: Vec<MirFunction>,
    fn_count: i32,
    target: String,
    wasi_version: String,
    memory64: bool,
    mir: MirModule
) {
    let mut ui = 0
    while ui < fn_count {
        let uf = get_unchecked(functions, ui)
        push(
            type_sigs,
            sections_types_sigs_detail::build_function_type_sig(uf, target.clone(), wasi_version.clone(), memory64, mir)
        )
        ui = ui + 1
    }
}

// Pair-ABI call-site signatures (#872). A signature-typed param call whose
// declared (env, args...) -> ret shape has no __fnthunk trampoline still
// needs a valid ref.cast target: emit resolves these registered types by
// exact sig instead of arity-guessing a program function. Collected only
// for the GC target; ref segments resolve through gc_struct_names per
// pair_call_sig_from_hint.
fn collect_pair_call_type_sigs(
    functions: Vec<MirFunction>,
    fn_count: i32,
    target: String,
    memory64: bool,
    gc_struct_names: Vec<String>
) -> Vec<String> {
    let mut sigs = Vec::new<String>()
    if !emit_target::is_gc_target(target.clone()) {
        return sigs
    }
    let mut fi = 0
    while fi < fn_count {
        let f = get_unchecked(functions, fi)
        let bc = function_block_queries::MirFunction_block_count(f)
        let mut bi = 0
        while bi < bc {
            let block = function_block_queries::MirFunction_block_at(f, bi)
            let ic = block_inst_access::MirBlock_inst_count(block)
            let mut ii = 0
            while ii < ic {
                let inst = block_inst_access::MirBlock_inst_at(block, ii)
                if inst_accessors_shape::MirInst_op(inst) == mir_opcodes::MIR_CALL_REF() {
                    let sig = call_indirect::pair_call_sig_from_hint(
                        inst_accessors_literals::MirInst_str_val(inst),
                        inst_accessors_shape::MirInst_val_type(inst),
                        memory64,
                        gc_struct_names.clone()
                    )
                    if len(sig) > 0 {
                        let mut seen = false
                        let mut si = 0
                        while si < len(sigs) {
                            if sig.clone().eq(get_unchecked(sigs, si).clone()) {
                                seen = true
                            }
                            si = si + 1
                        }
                        if !seen {
                            push(sigs, sig.clone())
                        }
                    }
                }
                ii = ii + 1
            }
            bi = bi + 1
        }
        fi = fi + 1
    }
    sigs
}

// #851 Phase 3: pair sigs come from the drain-sealed artifact list when
// the fused emit path ran — emitted bodies detach at push/drain, so the
// batch body scan cannot re-derive them. The sealed list already unions
// recorded CALL_REF tuples with late-fn body evidence, identical to what
// this scan returns over the kept functions.
fn pair_call_sigs_for_emit(
    mir: MirModule,
    functions: Vec<MirFunction>,
    fn_count: i32,
    target: String,
    memory64: bool
) -> Vec<String> {
    let art = module_emit_artifacts::MirModule_emit_artifacts(mir)
    if emit_artifacts::MirEmitArtifacts_enabled(art) && art.pair_call_sigs_final {
        return art.pair_call_sigs
    }
    collect_pair_call_type_sigs(
        functions,
        fn_count,
        target.clone(),
        memory64,
        module_gc_struct::MirModule_gc_struct_names(mir)
    )
}

fn append_wrapper_type_sig(mut type_sigs: Vec<String>, needs_wrapper: i32, wasi_version: String) {
    if needs_wrapper == 1 {
        if emit_target::is_p2_wasi(wasi_version.clone()) {
            push(type_sigs, "1i32")
            // P2 command post-return for the unit result of wasi:cli/run.
            push(type_sigs, "i32_0")
        } else {
            push(type_sigs, "0")
        }
    }
}

fn append_p2_library_post_type_sigs(
    mut type_sigs: Vec<String>,
    functions: Vec<MirFunction>,
    fn_count: i32,
    target: String,
    wasi_version: String,
    memory64: bool,
    mir: MirModule
) {
    let mut i = 0
    while i < fn_count {
        let f = get_unchecked(functions, i)
        if sections_exports::is_p2_library_export_function(mir, f) {
            let function_sig = sections_types_sigs_detail::build_function_type_sig(
                f,
                target.clone(),
                wasi_version.clone(),
                memory64,
                mir
            )
            push(
                type_sigs,
                sections_types_sigs_detail::p2_post_type_sig_for_function(f, function_sig)
            )
        }
        i = i + 1
    }
}

fn append_p2_library_wrapper_type_sigs(
    mut type_sigs: Vec<String>,
    functions: Vec<MirFunction>,
    fn_count: i32,
    target: String,
    wasi_version: String,
    mir: MirModule
) {
    let mut i = 0
    while i < fn_count {
        let f = get_unchecked(functions, i)
        if sections_exports::is_p2_library_export_function(mir, f) &&
        sections_types_sigs_detail::p2_function_needs_string_wrapper(
            f,
            target.clone(),
            wasi_version.clone(),
            mir
        ) {
            push(type_sigs, sections_types_sigs_detail::p2_canonical_function_type_sig(f, mir))
        }
        i = i + 1
    }
}

fn append_p2_runtime_type_sigs(mut type_sigs: Vec<String>, wasi_version: String) {
    if !emit_target::is_p2_wasi(wasi_version.clone()) {
        return
    }
    // These are the standard32 component runtime exports consumed by
    // `wasm-tools component new`. The realloc body is intentionally supplied
    // by the component linker when --realloc-via-memory-grow is selected.
    push(type_sigs, "i32_i32_i32_i32_1i32")
    push(type_sigs, "0")
}

fn append_linear_gc_type_sigs(mut type_sigs: Vec<String>, target: String) {
    if !emit_target::is_linear_memory_target(target.clone()) {
        return
    }
    push(type_sigs, "1i32")
    push(type_sigs, "i32_1i32")
    push(type_sigs, "i32_i32_0")
    push(type_sigs, "i32_0")
    push(type_sigs, "i32_0")
    push(type_sigs, "i32_1i32")
    push(type_sigs, "0")
    push(type_sigs, "i32_1i32")
}
