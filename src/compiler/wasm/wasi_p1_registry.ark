fn wasi_p1_syscall_names() -> Vec<String> {
    let mut names = Vec_new()
    names.push("args_get")
    names.push("args_sizes_get")
    names.push("clock_res_get")
    names.push("clock_time_get")
    names.push("environ_get")
    names.push("environ_sizes_get")
    names.push("fd_close")
    names.push("fd_fdstat_get")
    names.push("fd_read")
    names.push("fd_seek")
    names.push("fd_tell")
    names.push("fd_write")
    names.push("path_open")
    names.push("proc_exit")
    names.push("random_get")
    names
}
