fn wasi_p1_syscall_names() -> Vec<String> {
    let mut names = Vec_new()
    push(names, "args_get")
    push(names, "args_sizes_get")
    push(names, "clock_res_get")
    push(names, "clock_time_get")
    push(names, "environ_get")
    push(names, "environ_sizes_get")
    push(names, "fd_close")
    push(names, "fd_fdstat_get")
    push(names, "fd_read")
    push(names, "fd_seek")
    push(names, "fd_tell")
    push(names, "fd_write")
    push(names, "path_open")
    push(names, "proc_exit")
    push(names, "random_get")
    names
}
