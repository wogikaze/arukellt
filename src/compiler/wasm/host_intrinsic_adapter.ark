//
// Maps host intrinsic names to HostIntrinsicSpec entries and provides
// ABI-aware classification for GC targets. LinearMemoryPtr stubs that
// have GC emitters are synthesized in `host_intrinsic_gc_body.ark`
// (i32 / linear boundary → GC ref). Remaining network/HTTP stubs still
// emit unreachable until #819 / #727 land runtime ABI bodies.

use corehir::kinds
use corehir::host_intrinsic_spec
use corehir::mir_value_type
use corehir::type_id
use mir::host_intrinsic_stub_names
use mir::function_identity
use wasm::ctx_record
use wasm::emit_target
use wasm::opcodes
use wasm::writer_core

// Classify a host intrinsic name by its ABI sub-kind.
// Returns HOST_ABI_SCALAR for intrinsics that return plain i32/i64/f64,
// HOST_ABI_GC_REF for intrinsics that return a GC reference directly,
// and HOST_ABI_LINEAR_MEMORY_PTR for intrinsics that return an i32
// pointer into linear memory which must be converted to a GC ref.
fn host_intrinsic_abi_kind(name: String) -> i32 {
    // Scalar intrinsics: return plain numeric values, no GC ref needed.
    if eq(clone(name), String_from("clock_now")) {
        return kinds::HOST_ABI_SCALAR()
    }
    if eq(clone(name), String_from("exists")) {
        return kinds::HOST_ABI_SCALAR()
    }
    if eq(clone(name), String_from("is_file")) {
        return kinds::HOST_ABI_SCALAR()
    }
    if eq(clone(name), String_from("is_dir")) {
        return kinds::HOST_ABI_SCALAR()
    }
    if eq(clone(name), String_from("is_readable_file")) {
        return kinds::HOST_ABI_SCALAR()
    }
    // All other host intrinsics return i32 pointers (string handles,
    // vec handles, etc.) that need adapter conversion to GC refs.
    kinds::HOST_ABI_LINEAR_MEMORY_PTR()
}

// Check whether a host intrinsic can emit a real body on GC targets
// without an adapter (i.e. it is Scalar or GcRef).
fn host_intrinsic_can_emit_gc_body(name: String) -> bool {
    let abi = host_intrinsic_abi_kind(clone(name))
    abi == kinds::HOST_ABI_SCALAR() || abi == kinds::HOST_ABI_GC_REF()
}

// LinearMemoryPtr stubs that `host_intrinsic_gc_body` can synthesize today.
fn host_intrinsic_needs_gc_adapter(name: String) -> bool {
    if host_intrinsic_abi_kind(clone(name)) != kinds::HOST_ABI_LINEAR_MEMORY_PTR() {
        return false
    }
    if eq(clone(name), String_from("args")) {
        return true
    }
    if eq(clone(name), String_from("arg_at")) {
        return true
    }
    if eq(clone(name), String_from("var")) || eq(clone(name), String_from("get_var")) {
        return true
    }
    if eq(clone(name), String_from("var_or_default")) {
        return true
    }
    if eq(clone(name), String_from("read_stdin")) {
        return true
    }
    if host_intrinsic_is_network_adapter_name(clone(name)) {
        return true
    }
    false
}

fn host_intrinsic_is_network_adapter_name(name: String) -> bool {
    if eq(clone(name), String_from("connect")) {
        return true
    }
    if eq(clone(name), String_from("read")) {
        return true
    }
    if eq(clone(name), String_from("write")) {
        return true
    }
    if eq(clone(name), String_from("listen")) {
        return true
    }
    if eq(clone(name), String_from("accept")) {
        return true
    }
    if eq(clone(name), String_from("get")) {
        return true
    }
    if eq(clone(name), String_from("request")) {
        return true
    }
    if eq(clone(name), String_from("serve")) {
        return true
    }
    false
}

// Build a HostIntrinsicSpec for the given name.
// Currently returns a placeholder spec with the correct ABI kind;
// full param/return type population will be added as adapters are
// implemented.
fn host_intrinsic_spec_for(name: String) -> HostIntrinsicSpec {
    let abi = host_intrinsic_abi_kind(clone(name))
    let returns = Vec::new<MirValueType>()
    let boundary_returns = Vec::new<MirValueType>()
    let i32_mvt = mir_value_type::MirValueType_new(type_id::TYPE_ID_INVALID(), kinds::VALUE_REPR_SCALAR(), kinds::NULLABILITY_NOT_REF())
    if abi == kinds::HOST_ABI_GC_REF() || abi == kinds::HOST_ABI_LINEAR_MEMORY_PTR() {
        let string_mvt = mir_value_type::MirValueType_new(type_id::TYPE_ID_INVALID(), kinds::VALUE_REPR_GC_REF(), kinds::NULLABILITY_NULLABLE())
        push(returns, string_mvt)
        // Canonical memory32 boundary: ptr (+ optional len) as i32 scalars.
        push(boundary_returns, i32_mvt)
        push(boundary_returns, i32_mvt)
    } else {
        push(returns, i32_mvt)
        push(boundary_returns, i32_mvt)
    }
    // Pointer width comes from the adapter's canonical memory index type (memory32),
    // not from the guest target name.
    host_intrinsic_spec::HostIntrinsicSpec_new(
        name,
        abi,
        Vec::new<MirValueType>(),
        returns,
        Vec::new<MirValueType>(),
        boundary_returns,
        32,
        0 - 1,
        0 - 1
    )
}

// Canonical memory32 addresses are boundary values even when the guest uses
// Memory64. Known static scratch addresses are emitted directly as i32 so the
// ordinary Memory64 scalar lowering never owns this width conversion.
fn emit_canonical_memory32_static_address(w: WasmWriter, address: i32) {
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, address)
}

fn host_intrinsic_should_emit_unreachable_gc_stub(f: MirFunction, ctx: SelfEmitCtx) -> bool {
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return false
    }
    let name = function_identity::MirFunction_name(f)
    if !host_intrinsic_stub_names::host_intrinsic_stub_is_known(name) {
        return false
    }
    if host_intrinsic_can_emit_gc_body(clone(name)) {
        return false
    }
    // Adapter-capable LinearMemoryPtr stubs synthesize a GC body instead.
    if host_intrinsic_needs_gc_adapter(clone(name)) {
        return false
    }
    true
}

fn host_intrinsic_should_emit_gc_adapter_body(f: MirFunction, ctx: SelfEmitCtx) -> bool {
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return false
    }
    let name = function_identity::MirFunction_name(f)
    if !host_intrinsic_stub_names::host_intrinsic_stub_is_known(name) {
        return false
    }
    host_intrinsic_needs_gc_adapter(clone(name))
}
