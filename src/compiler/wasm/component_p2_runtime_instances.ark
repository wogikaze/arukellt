use wasm::writer_core
use wasm::writer_string

// Final core instances after the runtime bridge:
//   11 = guest module 10
//   12 = wrapper module 7, importing guest instance 11.
fn p2_runtime_emit_guest_wrapper_instances(out: WasmWriter) {
    let sec = writer_core::WasmWriter_new()
    writer_core::emit_leb128_u(sec, 2)

    // Guest module 10. The transformed guest imports memory from `shared` and
    // unused runtime ABI calls from the versioned runtime bridge instance 10
    // (backed by the core stub host, not the WASI adapter).
    writer_core::emit_byte(sec, 0x00)
    writer_core::emit_leb128_u(sec, 10)
    writer_core::emit_leb128_u(sec, 8)
    p2_runtime_emit_core_instance_arg(sec, String_from("shared"), 0)
    p2_runtime_emit_core_instance_arg(sec, String_from("wasi:cli/stdout@0.2.0"), 6)
    p2_runtime_emit_core_instance_arg(sec, String_from("wasi:io/streams@0.2.0"), 6)
    p2_runtime_emit_core_instance_arg(sec, String_from("wasi:cli/environment@0.2.0"), 8)
    p2_runtime_emit_core_instance_arg(sec, String_from("arukellt:runtime/host@0.1.0"), 10)
    p2_runtime_emit_core_instance_arg(sec, String_from("wasi:cli/stdin@0.2.0"), 4)
    p2_runtime_emit_core_instance_arg(sec, String_from("wasi:cli/exit@0.2.0"), 5)
    p2_runtime_emit_core_instance_arg(sec, String_from("wasi:cli/stderr@0.2.0"), 6)

    // Wrapper module 7 imports the guest's `_start` through instance 11.
    writer_core::emit_byte(sec, 0x00)
    writer_core::emit_leb128_u(sec, 7)
    writer_core::emit_leb128_u(sec, 1)
    p2_runtime_emit_core_instance_arg(sec, String_from("guest"), 11)

    p2_runtime_emit_section(out, 2, sec)
}

fn p2_runtime_emit_core_instance_arg(sec: WasmWriter, name: String, instance_index: i32) {
    writer_string::emit_string(sec, name)
    writer_core::emit_byte(sec, 0x12)
    writer_core::emit_leb128_u(sec, instance_index)
}

fn p2_runtime_emit_section(out: WasmWriter, section_id: i32, contents: WasmWriter) {
    writer_core::emit_byte(out, section_id)
    writer_core::emit_leb128_u(out, writer_core::writer_size(contents))
    writer_core::emit_bytes(out, writer_core::writer_bytes(contents))
}
