use corehir::callee_spelling
use mir::function_identity
use wasm::call_resolve
use wasm::ctx_record
use wasm::ctx_vec_locals
use wasm::hash_aliases
use collections::name_index
fn ctx_mark_vec_local(mut ctx: SelfEmitCtx, local_idx: i32) {
    let count = ctx_vec_locals::SelfEmitCtx_vec_local_count(ctx)
    let mut i = 0
    while i < count {
        if ctx_vec_locals::SelfEmitCtx_vec_local_at(ctx, i) == local_idx {
            return
        }
        i = i + 1
    }
    ctx_vec_locals::SelfEmitCtx_push_vec_local(ctx, local_idx)
}

fn ctx_is_vec_local(ctx: SelfEmitCtx, local_idx: i32) -> bool {
    let count = ctx_vec_locals::SelfEmitCtx_vec_local_count(ctx)
    let mut i = 0
    while i < count {
        if ctx_vec_locals::SelfEmitCtx_vec_local_at(ctx, i) == local_idx {
            return true
        }
        i = i + 1
    }
    false
}

fn strip_module_prefix(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    name.clone()
}

fn resolve_fn_index_for_call(ctx: SelfEmitCtx, name: String, func_id_raw: i32) -> i32 {
    if func_id_raw >= 0 {
        let mapped = ctx_record::SelfEmitCtx_mir_index_for_func_id(ctx, func_id_raw)
        let function_count = ctx_record::SelfEmitCtx_function_count(ctx)
        if mapped >= 0 && mapped < function_count {
            // FunctionId is the typed identity assigned by the signature
            // spine. Once it has been mapped to a MIR body, do not run the
            // legacy bare-name collision heuristic: two module functions can
            // intentionally share that bare name (for example `json::parse`
            // and `parser::parse`).
            return mapped
        }
    }
    resolve_fn_index(ctx, name)
}

fn resolve_fn_index(ctx: SelfEmitCtx, name: String) -> i32 {
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    let exact_idx = resolve_fn_index_by_name(ctx, name.clone())
    if exact_idx >= 0 {
        return call_resolve::mir_resolve_self_delegate_collision(
            functions,
            ctx.function_name_counts,
            exact_idx,
            name.clone()
        )
    }
    // A loaded-module call keeps `module::Type::method`; try the registered
    // `Type::method` (and after-first-segment) spellings before the last
    // segment fallback so the drain can patch fid<0 calls by name.
    let variants = callee_spelling::callee_spelling_variants(name.clone())
    let mut vi = 0
    while vi < len(variants) {
        let variant_idx = resolve_fn_index_by_name(ctx, get_unchecked(variants, vi).clone())
        if variant_idx >= 0 {
            return call_resolve::mir_resolve_self_delegate_collision(
                functions,
                ctx.function_name_counts,
                variant_idx,
                name.clone()
            )
        }
        vi = vi + 1
    }
    let short_name = strip_module_prefix(name.clone())
    if !short_name.clone().eq(name.clone()) {
        let short_idx = resolve_fn_index_by_name(ctx, short_name)
        if short_idx >= 0 {
            return call_resolve::mir_resolve_self_delegate_collision(
                functions,
                ctx.function_name_counts,
                short_idx,
                name.clone()
            )
        }
    }
    let alias = hash_aliases::hashmap_builtin_alias(name.clone())
    if !alias.clone().eq(name.clone()) {
        let alias_idx = resolve_fn_index_by_name(ctx, alias.clone())
        if alias_idx >= 0 {
            return call_resolve::mir_resolve_self_delegate_collision(
                functions,
                ctx.function_name_counts,
                alias_idx,
                name.clone()
            )
        }
        let alias_short = strip_module_prefix(alias.clone())
        if !alias_short.clone().eq(alias.clone()) {
            let alias_short_idx = resolve_fn_index_by_name(ctx, alias_short.clone())
            if alias_short_idx >= 0 {
                return call_resolve::mir_resolve_self_delegate_collision(
                    functions,
                    ctx.function_name_counts,
                    alias_short_idx,
                    name.clone()
                )
            }
        }
    }
    0 - 1
}

fn hashmap_builtin_alias(name: String) -> String {
    hash_aliases::hashmap_builtin_alias(name)
}

fn resolve_fn_index_by_name(ctx: SelfEmitCtx, name: String) -> i32 {
    name_index::name_index_get(ctx.function_name_index, name)
}
