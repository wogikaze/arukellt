// GC ref local scan helpers.
use mir::block_inst_access
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use mir::function_param_view
use mir::function_locals_view
use mir::local_access
use mir::opcodes
use mir::value_types
use wasm::ctx_record

fn is_function_local_gc_cache_active(ctx: SelfEmitCtx) -> bool {
    len(ctx_record::SelfEmitCtx_local_struct_new_cache(ctx)) > 0
}

fn cached_is_direct_gc_struct_new_dest(ctx: SelfEmitCtx, local_idx: i32) -> i32 {
    let flags = ctx_record::SelfEmitCtx_local_struct_new_cache(ctx)
    if local_idx < 0 || local_idx >= len(flags) {
        return 0 - 1
    }
    get_unchecked(flags, local_idx)
}

fn cached_has_ref_assignment(ctx: SelfEmitCtx, local_idx: i32) -> i32 {
    let flags = ctx_record::SelfEmitCtx_local_has_ref_cache(ctx)
    if local_idx < 0 || local_idx >= len(flags) {
        return 0 - 1
    }
    get_unchecked(flags, local_idx)
}

// True when a RETURN hands back `local_idx`, directly or via the LOCAL_GET
// right before it. Reads the per-function flags inside the GC local cache
// window; otherwise scans the body.
fn local_feeds_return(f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> bool {
    let flags = ctx_record::SelfEmitCtx_local_feeds_return_cache(ctx)
    if len(flags) > 0 {
        return local_idx >= 0 && local_idx < len(flags) && get_unchecked(flags, local_idx) != 0
    }
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            if return_operand_local(block, ii) == local_idx {
                return true
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

// Local returned by the RETURN at `ii`, or -1 when not a RETURN / no local.
fn return_operand_local(block: MirBlock, ii: i32) -> i32 {
    let inst = block_inst_access::MirBlock_inst_at(block, ii)
    if inst_accessors_shape::MirInst_op(inst) != opcodes::MIR_RETURN() {
        return 0 - 1
    }
    let ret_local = inst_accessors_operands::MirInst_arg0(inst)
    if ret_local >= 0 || ii <= 0 {
        return ret_local
    }
    let prev = block_inst_access::MirBlock_inst_at(block, ii - 1)
    if inst_accessors_shape::MirInst_op(prev) == opcodes::MIR_LOCAL_GET() {
        return inst_accessors_operands::MirInst_arg0(prev)
    }
    0 - 1
}

// One pass over the body: 0/1 per local for `local_feeds_return`.
fn local_feeds_return_flags(f: MirFunction, local_count: i32) -> Vec<i32> {
    let flags = Vec::new<i32>()
    let mut li = 0
    while li < local_count {
        push(flags, 0)
        li = li + 1
    }
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let ret_local = return_operand_local(block, ii)
            if ret_local >= 0 && ret_local < local_count {
                set(flags, ret_local, 1)
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    flags
}

// Prefer the per-function cache when emit has activated it (#829).
fn local_is_direct_gc_struct_new_dest(f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> bool {
    if is_function_local_gc_cache_active(ctx) {
        let cached = cached_is_direct_gc_struct_new_dest(ctx, local_idx)
        if cached >= 0 {
            return cached != 0
        }
    }
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_GC_STRUCT_NEW() ||
            inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_STRUCT_NEW() {
                if inst_accessors_operands::MirInst_dest(inst) == local_idx {
                    return true
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

// Check if a type_name string indicates a GC reference type.
fn type_name_is_ref(type_name: String) -> bool {
    if starts_with(clone(type_name), "hashmap:") {
        return true
    }
    if eq(clone(type_name), "string") || eq(clone(type_name), "String") {
        return true
    }
    if starts_with(clone(type_name), "vec:") {
        return true
    }
    if starts_with(clone(type_name), "Option_") ||
    starts_with(clone(type_name), "option:") ||
    starts_with(clone(type_name), "Option:") ||
    starts_with(clone(type_name), "Option<") {
        return true
    }
    if starts_with(clone(type_name), "Result_") ||
    starts_with(clone(type_name), "result:") ||
    starts_with(clone(type_name), "Result:") ||
    starts_with(clone(type_name), "Result<") {
        return true
    }
    if starts_with(clone(type_name), "enum:") {
        return true
    }
    if starts_with(clone(type_name), "struct:") {
        return true
    }
    false
}

// Check if a local has a type_name that indicates a GC reference type.
fn local_has_ref_type_name(f: MirFunction, local_idx: i32) -> bool {
    if local_idx >= 0 && local_idx < function_locals_view::MirFunction_local_count(f) {
        let loc = function_locals_view::MirFunction_local_at(f, local_idx)
        let type_name = local_access::MirLocal_type_name(loc)
        if len(type_name) > 0 {
            return type_name_is_ref(type_name)
        }
    }
    false
}

// Check if a local has ANY assignment that produces a reference value.
// This guards against sticky type_names on reused locals that only receive
// i32 values in the current MIR. Returns true if there is evidence the local
// holds a ref value (direct ref-producing op, LOCAL_SET/LOCAL_GET from a ref
// source, or a function parameter with a ref type_name).
fn local_has_any_ref_assignment(f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> bool {
    if is_function_local_gc_cache_active(ctx) {
        let cached = cached_has_ref_assignment(ctx, local_idx)
        if cached == 1 {
            return true
        }
    }
    local_has_any_ref_assignment_depth(f, local_idx, 0)
}

fn local_has_any_ref_assignment_depth(f: MirFunction, local_idx: i32, depth: i32) -> bool {
    if depth > 3 {
        return false
    }
    let param_count = function_param_view::MirFunction_param_count(f)
    if local_idx >= 0 && local_idx < param_count {
        let param_type_name = function_param_view::MirFunction_param_type_name(f, local_idx)
        if len(param_type_name) > 0 && type_name_is_ref(param_type_name) {
            return true
        }
    }
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if local_inst_assigns_ref(f, inst, local_idx, depth) {
                return true
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

// Check if a local receives its value via MIR_LOCAL_SET or MIR_GC_STRUCT_GET
// (from another local or from a struct field extraction). Used to detect stale
// type_name from local reuse (#808).
fn local_has_local_set_source(f: MirFunction, local_idx: i32) -> bool {
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            if op == opcodes::MIR_LOCAL_SET() {
                if inst_accessors_operands::MirInst_arg0(inst) == local_idx {
                    return true
                }
            }
            if op == opcodes::MIR_GC_STRUCT_GET() {
                if inst_accessors_shape::MirInst_dest(inst) == local_idx {
                    return true
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

fn local_inst_assigns_ref(f: MirFunction, inst: MirInst, local_idx: i32, depth: i32) -> bool {
    let op = inst_accessors_shape::MirInst_op(inst)
    let dest = inst_accessors_operands::MirInst_dest(inst)
    let arg0 = inst_accessors_operands::MirInst_arg0(inst)
    if dest == local_idx {
        if op == opcodes::MIR_GC_STRUCT_NEW() ||
        op == opcodes::MIR_STRUCT_NEW() ||
        op == opcodes::MIR_ARRAY_NEW() ||
        op == opcodes::MIR_CONST_STRING() ||
        op == opcodes::MIR_CALL() ||
        op == opcodes::MIR_REF_CAST() ||
        op == opcodes::MIR_REF_TEST() {
            return true
        }
        if op == opcodes::MIR_GC_STRUCT_GET() && local_has_ref_type_name(f, local_idx) {
            return true
        }
        if op == opcodes::MIR_LOCAL_GET() {
            let src = inst_accessors_operands::MirInst_arg0(inst)
            if src >= 0 && (local_has_ref_type_name(f, src) || local_has_any_ref_assignment_depth(f, src, depth + 1)) {
                return true
            }
        }
    }
    if op == opcodes::MIR_LOCAL_SET() && arg0 == local_idx {
        let source = inst_accessors_operands::MirInst_arg1(inst)
        if source >= 0 && (local_has_ref_type_name(f, source) || local_has_any_ref_assignment_depth(f, source, depth + 1)) {
            return true
        }
    }
    false
}

// Check if a local is the dest of any instruction that produces a scalar
// (non-ref) value. On Memory64, scalar i32 results are widened to i64 via
// emit_widen_i32_result. If a local receives both ref and scalar values
// (local reuse), declaring it as a GC ref causes validation failures because
// the widened i64 cannot be stored in a ref local.
fn local_has_scalar_producer(f: MirFunction, local_idx: i32) -> bool {
    local_has_scalar_producer_depth(f, local_idx, 0)
}

// Return the concrete scalar value type produced for a local, or -1 when the
// body does not provide one.  Local metadata can retain a GC type after a
// temporary is reused, so the declaration pass needs the producer's actual
// type before consulting names or GC layout spines.
fn local_scalar_producer_vt(f: MirFunction, local_idx: i32) -> i32 {
    local_scalar_producer_vt_depth(f, local_idx, 0)
}

fn local_scalar_producer_vt_depth(f: MirFunction, local_idx: i32, depth: i32) -> i32 {
    if depth > 8 {
        return 0 - 1
    }
    // A staged call argument can copy a scalar parameter into a temporary
    // local before the call. Treat the parameter as the source of its declared
    // scalar type; otherwise the GC layout scan sees only the temporary's
    // stale reference metadata and declares it as a ref local.
    let param_count = function_param_view::MirFunction_param_count(f)
    if local_idx >= 0 && local_idx < param_count {
        let param_vt = function_param_view::MirFunction_param_val_type(f, local_idx)
        if param_vt == value_types::VT_I32() ||
        param_vt == value_types::VT_I64() ||
        param_vt == value_types::VT_F64() ||
        param_vt == value_types::VT_F32() ||
        param_vt == value_types::VT_V128() {
            return param_vt
        }
        return 0 - 1
    }
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            if inst_accessors_operands::MirInst_dest(inst) == local_idx {
                let producer_vt = inst_scalar_producer_vt(op, inst)
                if producer_vt >= 0 {
                    return producer_vt
                }
            }
            if op == opcodes::MIR_LOCAL_SET() &&
            inst_accessors_operands::MirInst_arg0(inst) == local_idx {
                let source = inst_accessors_operands::MirInst_arg1(inst)
                if source >= 0 {
                    let source_vt = local_scalar_producer_vt_depth(f, source, depth + 1)
                    if source_vt >= 0 {
                        return source_vt
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    0 - 1
}

fn local_has_scalar_producer_depth(f: MirFunction, local_idx: i32, depth: i32) -> bool {
    if depth > 3 {
        return false
    }
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_is_scalar_producer_for(f, inst, local_idx, depth) {
                return true
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

fn inst_is_scalar_producer_for(f: MirFunction, inst: MirInst, local_idx: i32, depth: i32) -> bool {
    let op = inst_accessors_shape::MirInst_op(inst)
    let dest = inst_accessors_operands::MirInst_dest(inst)
    if dest == local_idx {
        if inst_op_is_scalar_producer(op, inst) {
            return true
        }
    }
    // LOCAL_SET from a scalar-producing source local also makes this local
    // receive a scalar value (local reuse chain).
    if op == opcodes::MIR_LOCAL_SET() {
        let target = inst_accessors_operands::MirInst_arg0(inst)
        if target == local_idx {
            let source = inst_accessors_operands::MirInst_arg1(inst)
            if source >= 0 && local_has_scalar_producer_depth(f, source, depth + 1) {
                return true
            }
        }
    }
    false
}

// Check if a local has a "strong" ref producer — an instruction that
// definitely produces a ref value (not just a MIR_CALL with stale val_type).
// Used to distinguish true local reuse (both ref and scalar) from stale
// val_type (only scalar, but val_type says ref).
fn local_has_strong_ref_producer(f: MirFunction, local_idx: i32) -> bool {
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            let dest = inst_accessors_operands::MirInst_dest(inst)
            if dest == local_idx {
                if op == opcodes::MIR_GC_STRUCT_NEW() ||
                op == opcodes::MIR_STRUCT_NEW() ||
                op == opcodes::MIR_ARRAY_NEW() ||
                op == opcodes::MIR_CONST_STRING() ||
                op == opcodes::MIR_REF_CAST() ||
                op == opcodes::MIR_REF_TEST() {
                    return true
                }
                // MIR_CALL with VT_GC_REF val_type is a ref producer
                if op == opcodes::MIR_CALL() {
                    let vt = inst_accessors_shape::MirInst_val_type(inst)
                    if vt == value_types::VT_GC_REF() || vt == value_types::VT_REF() {
                        return true
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    false
}

fn inst_op_is_scalar_producer(op: i32, inst: MirInst) -> bool {
    // Instructions that always produce scalar values.
    if op == opcodes::MIR_CONST_I32() || op == opcodes::MIR_CONST_I64() ||
    op == opcodes::MIR_CONST_F64() || op == opcodes::MIR_CONST_BOOL() ||
    op == opcodes::MIR_ADD() || op == opcodes::MIR_SUB() ||
    op == opcodes::MIR_MUL() || op == opcodes::MIR_DIV() ||
    op == opcodes::MIR_MOD() ||
    op == opcodes::MIR_EQ() || op == opcodes::MIR_NEQ() ||
    op == opcodes::MIR_LT() || op == opcodes::MIR_LTEQ() ||
    op == opcodes::MIR_GT() || op == opcodes::MIR_GTEQ() ||
    op == opcodes::MIR_AND() || op == opcodes::MIR_OR() ||
    op == opcodes::MIR_NEG() || op == opcodes::MIR_NOT() ||
    op == opcodes::MIR_SHL() || op == opcodes::MIR_SHR() ||
    op == opcodes::MIR_EQZ() {
        return true
    }
    // MIR_ARRAY_GET is intentionally not inferred here. Its MIR value type is
    // not reliable for GC arrays, and treating a struct element as i32 changes
    // the local declaration before the array element type is resolved.
    // MIR_STRUCT_GET and MIR_GC_STRUCT_GET produce scalar values when the
    // result val_type is VT_I32 (i32 field, widened to i64 on Memory64).
    // Ref field results have val_type VT_GC_REF and are not scalar.
    if op == opcodes::MIR_STRUCT_GET() || op == opcodes::MIR_GC_STRUCT_GET() {
        let vt = inst_accessors_shape::MirInst_val_type(inst)
        if vt == value_types::VT_I32() || vt == value_types::VT_I64() ||
        vt == value_types::VT_F64() || vt == value_types::VT_F32() {
            return true
        }
        // Do not treat VT_VOID as scalar: ref fields often keep VOID in MIR
        // and demoting those locals breaks later String/struct ref stores.
    }
    // MIR_CALL to intrinsics that emit array.get_i32 (e.g. vec_get_unchecked)
    // produce scalar i32 values widened to i64 on Memory64. The instruction
    // val_type indicates the result type: VT_I32 = scalar, VT_GC_REF = ref.
    if op == opcodes::MIR_CALL() {
        let vt = inst_accessors_shape::MirInst_val_type(inst)
        if vt == value_types::VT_I32() || vt == value_types::VT_I64() ||
        vt == value_types::VT_F64() || vt == value_types::VT_F32() {
            return true
        }
    }
    false
}

fn inst_scalar_producer_vt(op: i32, inst: MirInst) -> i32 {
    if op == opcodes::MIR_CONST_I32() || op == opcodes::MIR_CONST_BOOL() {
        return value_types::VT_I32()
    }
    if op == opcodes::MIR_CONST_I64() {
        return value_types::VT_I64()
    }
    if op == opcodes::MIR_CONST_F64() {
        let vt = inst_accessors_shape::MirInst_val_type(inst)
        if vt == value_types::VT_F32() {
            return vt
        }
        return value_types::VT_F64()
    }
    if op == opcodes::MIR_EQ() || op == opcodes::MIR_NEQ() ||
    op == opcodes::MIR_LT() || op == opcodes::MIR_LTEQ() ||
    op == opcodes::MIR_GT() || op == opcodes::MIR_GTEQ() ||
    op == opcodes::MIR_AND() || op == opcodes::MIR_OR() ||
    op == opcodes::MIR_NOT() || op == opcodes::MIR_EQZ() {
        return value_types::VT_I32()
    }
    if op == opcodes::MIR_STRUCT_GET() || op == opcodes::MIR_GC_STRUCT_GET() ||
    op == opcodes::MIR_CALL() {
        let vt = inst_accessors_shape::MirInst_val_type(inst)
        if vt == value_types::VT_I32() || vt == value_types::VT_I64() ||
        vt == value_types::VT_F64() || vt == value_types::VT_F32() {
            return vt
        }
        return 0 - 1
    }
    if inst_op_is_scalar_producer(op, inst) {
        let vt = inst_accessors_shape::MirInst_val_type(inst)
        if vt == value_types::VT_I32() || vt == value_types::VT_I64() ||
        vt == value_types::VT_F64() || vt == value_types::VT_F32() {
            return vt
        }
    }
    0 - 1
}

// --- Open-enum → i64 local demotion (assert/loop temps with stale type_name) ---

fn inst_is_scalar_arith_op(op: i32, inst: MirInst) -> bool {
    if op != opcodes::MIR_ADD() && op != opcodes::MIR_SUB() && op != opcodes::MIR_MUL() {
        return false
    }
    // String concat lowers as MIR_ADD with a ref result type.
    let vt = inst_accessors_shape::MirInst_val_type(inst)
    vt != value_types::VT_GC_REF() && vt != value_types::VT_REF()
}

fn inst_op_produces_ref_value(op: i32) -> bool {
    op == opcodes::MIR_REF_CAST() || op == opcodes::MIR_ARRAY_NEW() ||
    op == opcodes::MIR_GC_STRUCT_NEW() || op == opcodes::MIR_STRUCT_NEW() ||
    op == opcodes::MIR_CONST_STRING()
}

fn inst_uses_local_as_ref_op_base(inst: MirInst, local_idx: i32) -> bool {
    let op = inst_accessors_shape::MirInst_op(inst)
    let dest = inst_accessors_operands::MirInst_dest(inst)
    let arg0 = inst_accessors_operands::MirInst_arg0(inst)
    let arg1 = inst_accessors_operands::MirInst_arg1(inst)
    if op == opcodes::MIR_ARRAY_GET() || op == opcodes::MIR_ARRAY_LEN() ||
    op == opcodes::MIR_ARRAY_SET() {
        return arg0 == local_idx || arg1 == local_idx
    }
    if op == opcodes::MIR_GC_STRUCT_GET() || op == opcodes::MIR_GC_STRUCT_SET() ||
    op == opcodes::MIR_STRUCT_GET() || op == opcodes::MIR_STRUCT_SET() {
        return arg0 == local_idx || arg1 == local_idx || dest == local_idx
    }
    if op == opcodes::MIR_REF_CAST() {
        return dest == local_idx || arg0 == local_idx
    }
    false
}

fn inst_is_ordering_compare(op: i32) -> bool {
    op == opcodes::MIR_LT() || op == opcodes::MIR_LTEQ() ||
    op == opcodes::MIR_GT() || op == opcodes::MIR_GTEQ()
}

// Prefer i64 local storage when the body only has scalar producers/uses, even
// if the MIR local still carries an open-enum type_name from earlier reuse.
// One body pass answers this for every local of the function at once; the
// per-local scan (with nested compare/const scans) made local declaration
// emission quadratic in (locals x instructions). Flags are 0/1 per local.
fn local_body_i64_stack_set_flags(f: MirFunction, local_count: i32) -> Vec<i32> {
    let has_int_const_def = int_const_def_flags(f, local_count)
    let numeric_compare = numeric_compare_use_flags(f, local_count, has_int_const_def)
    let blocked_by_ref = zero_local_flags(local_count)
    let has_i64_evidence = zero_local_flags(local_count)
    // `block index + 1` of a block holding a scalar i64 definition of the local;
    // LOCAL_SET only looks for such a source inside its own block.
    let scalar_def_block_stamp = zero_local_flags(local_count)
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        stamp_scalar_i64_defs_in_block(block, inst_count, scalar_def_block_stamp, bi + 1)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            let dest = inst_accessors_operands::MirInst_dest(inst)
            if dest >= 0 && dest < local_count {
                if inst_op_produces_ref_value(op) || inst_is_ref_result_call(op, inst) {
                    set(blocked_by_ref, dest, 1)
                }
                if inst_defines_scalar_i64_for_local(inst, dest) {
                    set(has_i64_evidence, dest, 1)
                }
                if call_dest_forwarded_to_numeric_compare(block, ii, inst_count, dest, numeric_compare) {
                    set(has_i64_evidence, dest, 1)
                }
            }
            if op == opcodes::MIR_LOCAL_SET() {
                let set_dst = inst_accessors_operands::MirInst_arg0(inst)
                if set_dst >= 0 && set_dst < local_count {
                    if ii > 0 && inst_op_produces_ref_value(inst_accessors_shape::MirInst_op(
                            block_inst_access::MirBlock_inst_at(block, ii - 1)
                        )) {
                        set(blocked_by_ref, set_dst, 1)
                    }
                    if local_set_receives_scalar_i64(
                        block,
                        ii,
                        set_dst,
                        scalar_def_block_stamp,
                        bi + 1,
                        numeric_compare
                    ) {
                        set(has_i64_evidence, set_dst, 1)
                    }
                }
            }
            mark_ref_op_base_locals(inst, blocked_by_ref, local_count)
            ii = ii + 1
        }
        bi = bi + 1
    }
    let mut li = 0
    while li < local_count {
        if get_unchecked(blocked_by_ref, li) == 1 {
            set(has_i64_evidence, li, 0)
        }
        li = li + 1
    }
    has_i64_evidence
}

fn zero_local_flags(local_count: i32) -> Vec<i32> {
    let flags = Vec::new<i32>()
    let mut i = 0
    while i < local_count {
        push(flags, 0)
        i = i + 1
    }
    flags
}

fn mark_local_flag(flags: Vec<i32>, local_idx: i32) {
    if local_idx >= 0 && local_idx < len(flags) {
        set(flags, local_idx, 1)
    }
}

// fs::write_string / read_to_string lower as MIR_CALL with VT_GC_REF; without
// this, Result dest locals demote to i32 (#834).
fn inst_is_ref_result_call(op: i32, inst: MirInst) -> bool {
    if op != opcodes::MIR_CALL() {
        return false
    }
    let call_vt = inst_accessors_shape::MirInst_val_type(inst)
    call_vt == value_types::VT_GC_REF() || call_vt == value_types::VT_REF()
}

fn mark_ref_op_base_locals(inst: MirInst, blocked_by_ref: Vec<i32>, local_count: i32) {
    let op = inst_accessors_shape::MirInst_op(inst)
    let dest = inst_accessors_operands::MirInst_dest(inst)
    let arg0 = inst_accessors_operands::MirInst_arg0(inst)
    let arg1 = inst_accessors_operands::MirInst_arg1(inst)
    if op == opcodes::MIR_ARRAY_GET() || op == opcodes::MIR_ARRAY_LEN() ||
    op == opcodes::MIR_ARRAY_SET() {
        mark_local_flag(blocked_by_ref, arg0)
        mark_local_flag(blocked_by_ref, arg1)
        return
    }
    if op == opcodes::MIR_GC_STRUCT_GET() || op == opcodes::MIR_GC_STRUCT_SET() ||
    op == opcodes::MIR_STRUCT_GET() || op == opcodes::MIR_STRUCT_SET() {
        mark_local_flag(blocked_by_ref, arg0)
        mark_local_flag(blocked_by_ref, arg1)
        mark_local_flag(blocked_by_ref, dest)
        return
    }
    if op == opcodes::MIR_REF_CAST() {
        mark_local_flag(blocked_by_ref, dest)
        mark_local_flag(blocked_by_ref, arg0)
    }
}

fn int_const_def_flags(f: MirFunction, local_count: i32) -> Vec<i32> {
    let flags = zero_local_flags(local_count)
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            if op == opcodes::MIR_CONST_I32() || op == opcodes::MIR_CONST_I64() {
                mark_local_flag(flags, inst_accessors_operands::MirInst_dest(inst))
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    flags
}

// A local is a numeric-compare operand when it feeds an ordering compare, or an
// EQ/NEQ against an int const — string equality also uses those opcodes.
fn numeric_compare_use_flags(f: MirFunction, local_count: i32, has_int_const_def: Vec<i32>) -> Vec<i32> {
    let flags = zero_local_flags(local_count)
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            let op = inst_accessors_shape::MirInst_op(inst)
            let arg0 = inst_accessors_operands::MirInst_arg0(inst)
            let arg1 = inst_accessors_operands::MirInst_arg1(inst)
            if inst_is_ordering_compare(op) {
                mark_local_flag(flags, arg0)
                mark_local_flag(flags, arg1)
            } else if op == opcodes::MIR_EQ() || op == opcodes::MIR_NEQ() {
                let prev_is_int_const = ii > 0 && inst_is_int_const(block_inst_access::MirBlock_inst_at(block, ii - 1))
                // For operand arg1 the "other" side is arg0; for arg0 it is arg1.
                if arg1 >= 0 && eq_other_operand_is_int(arg0, has_int_const_def, prev_is_int_const) {
                    mark_local_flag(flags, arg1)
                }
                if arg0 >= 0 && arg0 != arg1 && eq_other_operand_is_int(arg1, has_int_const_def, prev_is_int_const) {
                    mark_local_flag(flags, arg0)
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    flags
}

fn inst_is_int_const(inst: MirInst) -> bool {
    let op = inst_accessors_shape::MirInst_op(inst)
    op == opcodes::MIR_CONST_I32() || op == opcodes::MIR_CONST_I64()
}

// `other < 0` means the other compare operand is the value left on the stack
// by the previous instruction, which counts only when that is an int const.
fn eq_other_operand_is_int(other: i32, has_int_const_def: Vec<i32>, prev_is_int_const: bool) -> bool {
    if other >= 0 {
        return other < len(has_int_const_def) && get_unchecked(has_int_const_def, other) == 1
    }
    prev_is_int_const
}

fn inst_defines_scalar_i64_for_local(inst: MirInst, local_idx: i32) -> bool {
    if inst_accessors_operands::MirInst_dest(inst) != local_idx {
        return false
    }
    let op = inst_accessors_shape::MirInst_op(inst)
    op == opcodes::MIR_CONST_I64() || op == opcodes::MIR_CONST_I32() ||
    op == opcodes::MIR_EXTEND_I32_TO_I64() || inst_is_scalar_arith_op(op, inst)
}

fn stamp_scalar_i64_defs_in_block(block: MirBlock, inst_count: i32, stamp: Vec<i32>, block_stamp: i32) {
    let mut ii = 0
    while ii < inst_count {
        let inst = block_inst_access::MirBlock_inst_at(block, ii)
        let dest = inst_accessors_operands::MirInst_dest(inst)
        if dest >= 0 && dest < len(stamp) && inst_defines_scalar_i64_for_local(inst, dest) {
            set(stamp, dest, block_stamp)
        }
        ii = ii + 1
    }
}

// CALL dest whose next LOCAL_SET copies it into a local that is later compared
// numerically. Wasm emit keeps the CALL result on the stack and stores only
// set_dst; the CALL dest local can stay typed as open-enum while dead copies use it.
fn call_dest_forwarded_to_numeric_compare(
    block: MirBlock,
    ii: i32,
    inst_count: i32,
    call_dest: i32,
    numeric_compare: Vec<i32>
) -> bool {
    let inst = block_inst_access::MirBlock_inst_at(block, ii)
    if inst_accessors_shape::MirInst_op(inst) != opcodes::MIR_CALL() {
        return false
    }
    if ii + 1 >= inst_count {
        return false
    }
    let next = block_inst_access::MirBlock_inst_at(block, ii + 1)
    if inst_accessors_shape::MirInst_op(next) != opcodes::MIR_LOCAL_SET() {
        return false
    }
    let set_dst = inst_accessors_operands::MirInst_arg0(next)
    let set_src = inst_accessors_operands::MirInst_arg1(next)
    if set_dst < 0 || set_dst == call_dest {
        return false
    }
    if set_src >= 0 && set_src != call_dest {
        return false
    }
    set_dst < len(numeric_compare) && get_unchecked(numeric_compare, set_dst) == 1
}

fn local_set_receives_scalar_i64(
    block: MirBlock,
    ii: i32,
    set_dst: i32,
    scalar_def_block_stamp: Vec<i32>,
    block_stamp: i32,
    numeric_compare: Vec<i32>
) -> bool {
    let inst = block_inst_access::MirBlock_inst_at(block, ii)
    let set_src = inst_accessors_operands::MirInst_arg1(inst)
    if set_src >= 0 {
        if set_src < len(scalar_def_block_stamp) &&
        get_unchecked(scalar_def_block_stamp, set_src) == block_stamp {
            return true
        }
        // An explicit source local is the value consumed by LOCAL_SET. The
        // previous MIR instruction is unrelated stack state in this form.
        return false
    }
    if ii <= 0 {
        return false
    }
    let prev = block_inst_access::MirBlock_inst_at(block, ii - 1)
    let prev_op = inst_accessors_shape::MirInst_op(prev)
    if prev_op == opcodes::MIR_CONST_I64() || prev_op == opcodes::MIR_CONST_I32() ||
    prev_op == opcodes::MIR_EXTEND_I32_TO_I64() ||
    inst_is_scalar_arith_op(prev_op, prev) ||
    prev_op == opcodes::MIR_LT() || prev_op == opcodes::MIR_EQ() {
        return true
    }
    // Assert temp: CALL result then compared as i64 (write_bytes == 3).
    prev_op == opcodes::MIR_CALL() && get_unchecked(numeric_compare, set_dst) == 1
}
