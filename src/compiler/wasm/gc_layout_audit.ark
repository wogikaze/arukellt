use std::host::stdio
use std::host::process
use wasm::ctx_record
use wasm::gc_layout_table

// GC layout resolution is TypeId-only. Name/fallback counters no longer exist;
// conflict remains a hard compiler ICE.
fn gc_layout_audit_print_summary(ctx: SelfEmitCtx) {
    let table = ctx_record::SelfEmitCtx_gc_layout_table(ctx)
    let typed_count = gc_layout_table::gc_layout_table_typed_lookup_count(table)
    let conflict_count = gc_layout_table::gc_layout_table_conflict_count(table)
    if typed_count <= 0 && conflict_count <= 0 {
        return
    }
    let line = concat(
        "gc-layout-audit: summary typed=",
        concat(
            i32_to_string(typed_count),
            concat(
                " name=0 fallback=0 conflict=",
                i32_to_string(conflict_count)
            )
        )
    )
    stdio::eprintln(line)
    if conflict_count > 0 {
        stdio::eprintln(String_from("compiler ICE: conflicting explicit backend GC layout plan"))
        process::exit(1)
    }
}
