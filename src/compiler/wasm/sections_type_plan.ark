pub struct TypeSectionPlan {
    host_type_map: Vec<i32>,
    fn_type_map: Vec<i32>,
    wrapper_type_idx: i32,
    p2_post_type_idx: i32,
    p2_library_post_type_map: Vec<i32>,
    p2_library_wrapper_type_map: Vec<i32>,
    p2_realloc_type_idx: i32,
    p2_initialize_type_idx: i32,
    linear_gc_type_map: Vec<i32>,
    wit_type_map: Vec<i32>,
    wit_import_count: i32,
    gc_type_base: i32,
    gc_enum_variant_base: i32,
    gc_enum_variant_type_map: Vec<i32>,
    gc_struct_base: i32,
    gc_struct_type_map: Vec<i32>,
    fn_type_refs: FuncTypeRefs,
    // Registered pair-ABI call-site signatures and their canon type
    // indices (#872). Parallel vectors: sig string -> canon type index.
    pair_call_sigs: Vec<String>,
    pair_call_type_map: Vec<i32>,
}

// For every type-section entry, the `(ref null T)` type index of each param
// and of the result (-1 when not a concrete nullable ref). Filled while the
// type section is emitted so body emission knows the static type of param
// locals and call results without re-deriving the signature heuristics.
pub struct FuncTypeRefs {
    // param_starts[type_idx] .. param_starts[type_idx + 1] index into param_refs.
    param_starts: Vec<i32>,
    param_refs: Vec<i32>,
    // One entry per type index.
    result_refs: Vec<i32>,
}

fn FuncTypeRefs_new() -> FuncTypeRefs {
    FuncTypeRefs {
        param_starts: Vec::new<i32>(),
        param_refs: Vec::new<i32>(),
        result_refs: Vec::new<i32>()
    }
}

fn FuncTypeRefs_begin_entry(mut table: FuncTypeRefs) {
    table.param_starts.push(table.param_refs.len())
    table.result_refs.push(0 - 1)
}

fn FuncTypeRefs_push_param(mut table: FuncTypeRefs, ref_type_idx: i32) {
    table.param_refs.push(ref_type_idx)
}

fn FuncTypeRefs_set_result(mut table: FuncTypeRefs, ref_type_idx: i32) {
    table.result_refs.set(table.result_refs.len() - 1, ref_type_idx)
}

fn FuncTypeRefs_finish(mut table: FuncTypeRefs) {
    table.param_starts.push(table.param_refs.len())
}

fn FuncTypeRefs_result_ref_type(table: FuncTypeRefs, type_idx: i32) -> i32 {
    if type_idx < 0 || type_idx >= table.result_refs.len() {
        return 0 - 1
    }
    get_unchecked(table.result_refs, type_idx)
}

fn FuncTypeRefs_param_ref_type(table: FuncTypeRefs, type_idx: i32, param_idx: i32) -> i32 {
    if type_idx < 0 || type_idx + 1 >= table.param_starts.len() {
        return 0 - 1
    }
    let start = get_unchecked(table.param_starts, type_idx)
    let end = get_unchecked(table.param_starts, type_idx + 1)
    if start + param_idx >= end {
        return 0 - 1
    }
    get_unchecked(table.param_refs, start + param_idx)
}

fn TypeSectionPlan_new(
    host_type_map: Vec<i32>,
    fn_type_map: Vec<i32>,
    wrapper_type_idx: i32,
    p2_post_type_idx: i32,
    p2_library_post_type_map: Vec<i32>,
    p2_library_wrapper_type_map: Vec<i32>,
    p2_realloc_type_idx: i32,
    p2_initialize_type_idx: i32,
    linear_gc_type_map: Vec<i32>,
    wit_type_map: Vec<i32>,
    wit_import_count: i32,
    gc_type_base: i32,
    gc_enum_variant_base: i32,
    gc_enum_variant_type_map: Vec<i32>,
    gc_struct_base: i32,
    gc_struct_type_map: Vec<i32>,
    pair_call_sigs: Vec<String>,
    pair_call_type_map: Vec<i32>
) -> TypeSectionPlan {
    TypeSectionPlan {
        host_type_map: host_type_map,
        fn_type_map: fn_type_map,
        wrapper_type_idx: wrapper_type_idx,
        p2_post_type_idx: p2_post_type_idx,
        p2_library_post_type_map: p2_library_post_type_map,
        p2_library_wrapper_type_map: p2_library_wrapper_type_map,
        p2_realloc_type_idx: p2_realloc_type_idx,
        p2_initialize_type_idx: p2_initialize_type_idx,
        linear_gc_type_map: linear_gc_type_map,
        wit_type_map: wit_type_map,
        wit_import_count: wit_import_count,
        gc_type_base: gc_type_base,
        gc_enum_variant_base: gc_enum_variant_base,
        gc_enum_variant_type_map: gc_enum_variant_type_map,
        gc_struct_base: gc_struct_base,
        gc_struct_type_map: gc_struct_type_map,
        fn_type_refs: FuncTypeRefs_new(),
        pair_call_sigs: pair_call_sigs,
        pair_call_type_map: pair_call_type_map
    }
}

fn TypeSectionPlan_fn_type_refs(plan: TypeSectionPlan) -> FuncTypeRefs {
    plan.fn_type_refs
}

fn TypeSectionPlan_set_fn_type_refs(mut plan: TypeSectionPlan, table: FuncTypeRefs) {
    plan.fn_type_refs = table
}

fn TypeSectionPlan_host_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.host_type_map
}

fn TypeSectionPlan_wit_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.wit_type_map
}

fn TypeSectionPlan_wit_import_count(plan: TypeSectionPlan) -> i32 {
    plan.wit_import_count
}

fn TypeSectionPlan_fn_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.fn_type_map
}

fn TypeSectionPlan_wrapper_type_idx(plan: TypeSectionPlan) -> i32 {
    plan.wrapper_type_idx
}

fn TypeSectionPlan_p2_post_type_idx(plan: TypeSectionPlan) -> i32 {
    plan.p2_post_type_idx
}

fn TypeSectionPlan_p2_library_post_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.p2_library_post_type_map
}

fn TypeSectionPlan_p2_library_wrapper_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.p2_library_wrapper_type_map
}

fn TypeSectionPlan_p2_realloc_type_idx(plan: TypeSectionPlan) -> i32 {
    plan.p2_realloc_type_idx
}

fn TypeSectionPlan_p2_initialize_type_idx(plan: TypeSectionPlan) -> i32 {
    plan.p2_initialize_type_idx
}

fn TypeSectionPlan_linear_gc_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.linear_gc_type_map
}

fn TypeSectionPlan_gc_type_base(plan: TypeSectionPlan) -> i32 {
    plan.gc_type_base
}

fn TypeSectionPlan_gc_enum_variant_base(plan: TypeSectionPlan) -> i32 {
    plan.gc_enum_variant_base
}

fn TypeSectionPlan_gc_enum_variant_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.gc_enum_variant_type_map
}

fn TypeSectionPlan_gc_struct_base(plan: TypeSectionPlan) -> i32 {
    plan.gc_struct_base
}

fn TypeSectionPlan_gc_struct_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.gc_struct_type_map
}

fn TypeSectionPlan_pair_call_sigs(plan: TypeSectionPlan) -> Vec<String> {
    plan.pair_call_sigs
}

fn TypeSectionPlan_pair_call_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.pair_call_type_map
}

fn build_type_section_plan(
    type_map: Vec<i32>,
    num_host_types: i32,
    wit_import_count: i32,
    gc_type_count: i32,
    fn_count: i32,
    needs_wrapper: i32,
    gc_type_base: i32,
    gc_enum_variant_base: i32,
    gc_enum_variant_type_map: Vec<i32>,
    gc_struct_base: i32,
    gc_struct_type_map: Vec<i32>,
    p2_enabled: bool,
    p2_library_post_count: i32,
    p2_library_wrapper_count: i32,
    p2_realloc_type_idx: i32,
    p2_initialize_type_idx: i32,
    linear_gc_type_map: Vec<i32>,
    pair_call_sigs: Vec<String>,
    pair_call_type_map: Vec<i32>
) -> TypeSectionPlan {
    let host_type_map = build_host_type_map(type_map, num_host_types)
    let wit_type_map = build_wit_type_map(type_map, num_host_types, wit_import_count)
    let fn_type_map = build_function_type_map(type_map, num_host_types, wit_import_count, gc_type_count, fn_count)
    let wrapper_type_idx = wrapper_type_index(type_map, num_host_types, wit_import_count, gc_type_count, fn_count, needs_wrapper)
    let p2_post_type_idx = p2_post_type_index(type_map, num_host_types, wit_import_count, gc_type_count, fn_count, needs_wrapper, p2_enabled)
    let p2_library_post_type_map = build_p2_library_post_type_map(
        type_map,
        num_host_types,
        wit_import_count,
        gc_type_count,
        fn_count,
        needs_wrapper,
        p2_enabled,
        p2_library_post_count
    )
    let p2_library_wrapper_type_map = build_p2_library_wrapper_type_map(
        type_map,
        num_host_types,
        wit_import_count,
        gc_type_count,
        fn_count,
        needs_wrapper,
        p2_enabled,
        p2_library_post_count,
        p2_library_wrapper_count
    )
    TypeSectionPlan_new(
        host_type_map,
        fn_type_map,
        wrapper_type_idx,
        p2_post_type_idx,
        p2_library_post_type_map,
        p2_library_wrapper_type_map,
        p2_realloc_type_idx,
        p2_initialize_type_idx,
        linear_gc_type_map,
        wit_type_map,
        wit_import_count,
        gc_type_base,
        gc_enum_variant_base,
        gc_enum_variant_type_map,
        gc_struct_base,
        gc_struct_type_map,
        pair_call_sigs,
        pair_call_type_map
    )
}

fn build_p2_library_wrapper_type_map(
    type_map: Vec<i32>,
    num_host_types: i32,
    wit_import_count: i32,
    gc_type_count: i32,
    fn_count: i32,
    needs_wrapper: i32,
    p2_enabled: bool,
    p2_library_post_count: i32,
    p2_library_wrapper_count: i32
) -> Vec<i32> {
    let mut wrapper_map = Vec::new<i32>()
    if !p2_enabled {
        return wrapper_map
    }
    let command_extra = if needs_wrapper == 1 { 2 } else { 0 }
    let start = num_host_types + wit_import_count + gc_type_count + fn_count +
    command_extra + p2_library_post_count
    let mut i = 0
    while i < p2_library_wrapper_count {
        wrapper_map.push(get_unchecked(type_map, start + i))
        i = i + 1
    }
    wrapper_map
}

fn build_p2_library_post_type_map(
    type_map: Vec<i32>,
    num_host_types: i32,
    wit_import_count: i32,
    gc_type_count: i32,
    fn_count: i32,
    needs_wrapper: i32,
    p2_enabled: bool,
    p2_library_post_count: i32
) -> Vec<i32> {
    let mut post_map = Vec::new<i32>()
    if !p2_enabled {
        return post_map
    }
    let command_extra = if needs_wrapper == 1 { 2 } else { 0 }
    let start = num_host_types + wit_import_count + gc_type_count + fn_count + command_extra
    let mut i = 0
    while i < p2_library_post_count {
        post_map.push(get_unchecked(type_map, start + i))
        i = i + 1
    }
    post_map
}

fn build_host_type_map(type_map: Vec<i32>, num_host_types: i32) -> Vec<i32> {
    let mut host_type_map = Vec::new<i32>()
    let mut wti = 0
    while wti < num_host_types {
        host_type_map.push(get_unchecked(type_map, wti))
        wti = wti + 1
    }
    host_type_map
}

fn build_function_type_map(type_map: Vec<i32>, num_host_types: i32, wit_import_count: i32, gc_type_count: i32, fn_count: i32) -> Vec<i32> {
    let mut fn_type_map = Vec::new<i32>()
    let mut fti = 0
    while fti < fn_count {
        fn_type_map.push(get_unchecked(type_map, fti + num_host_types + wit_import_count + gc_type_count))
        fti = fti + 1
    }
    fn_type_map
}

fn build_wit_type_map(type_map: Vec<i32>, num_host_types: i32, wit_import_count: i32) -> Vec<i32> {
    let mut wit_type_map = Vec::new<i32>()
    let mut wti = 0
    while wti < wit_import_count {
        wit_type_map.push(get_unchecked(type_map, num_host_types + wti))
        wti = wti + 1
    }
    wit_type_map
}

fn wrapper_type_index(type_map: Vec<i32>, num_host_types: i32, wit_import_count: i32, gc_type_count: i32, fn_count: i32, needs_wrapper: i32) -> i32 {
    if needs_wrapper == 1 {
        return get_unchecked(type_map, num_host_types + wit_import_count + gc_type_count + fn_count)
    }
    0 - 1
}

fn p2_post_type_index(type_map: Vec<i32>, num_host_types: i32, wit_import_count: i32, gc_type_count: i32, fn_count: i32, needs_wrapper: i32, p2_enabled: bool) -> i32 {
    if needs_wrapper == 0 || !p2_enabled {
        return 0 - 1
    }
    // The P2 post-return signature follows the command wrapper signature in
    // the type-signature list.
    get_unchecked(type_map, num_host_types + wit_import_count + gc_type_count + fn_count + 1)
}

fn type_sig_param_segments(csig: String) -> Vec<String> {
    let sig_len = csig.len()
    let mut param_segments = Vec::new<String>()
    let mut seg_start = 0
    let mut si = 0
    while si < sig_len {
        if csig.byte_at(si) == 95 {
            let seg = csig.slice(seg_start, si)
            param_segments.push(seg)
            seg_start = si + 1
        }
        si = si + 1
    }
    param_segments
}

fn type_sig_result_segment(csig: String) -> String {
    let sig_len = csig.len()
    let mut seg_start = 0
    let mut si = 0
    while si < sig_len {
        if csig.byte_at(si) == 95 {
            seg_start = si + 1
        }
        si = si + 1
    }
    csig.slice(seg_start, sig_len)
}

fn val_type_to_sig(vt: i32) -> String {
    match vt {
        1 => "i32",
        2 => "i64",
        3 => "f64",
        5 => "gcref",
        6 => "f32",
        7 => "v128",
        8 => "fnref",
        30 => "i32",
        _ => "ref",
    }
}

fn val_type_to_target_sig(vt: i32, is_gc_target: bool, memory64: bool) -> String {
    if vt == 5 && !is_gc_target {
        return "i32"
    }
    // GC uses typed function references; linear memory uses table indices.
    if vt == 8 {
        if is_gc_target {
            return "fnref"
        }
        return "i32"
    }
    // Memory64 (wasm32-gc default): widen former i32 Wasm values to i64.
    // WASI P2 command/component keeps i32 linear memory (#714), so skip widen.
    if memory64 && (vt == 1 || vt == 30) {
        return "i64"
    }
    val_type_to_sig(vt)
}

fn sig_to_wasm_type(sig: String) -> i32 {
    if sig.clone().eq("i32") {
        return constants::WASM_I32()
    }
    if sig.clone().eq("i64") {
        return constants::WASM_I64()
    }
    if sig.clone().eq("f64") {
        return constants::WASM_F64()
    }
    if sig.clone().eq("f32") {
        return constants::WASM_F32()
    }
    if sig.clone().eq("funcref") {
        return constants::WASM_FUNCREF()
    }
    if sig.clone().eq("v128") {
        return constants::WASM_V128()
    }
    if sig.clone().eq("i8") {
        return constants::WASM_I8()
    }
    constants::WASM_I32()
}
