use mir::value_types

pub struct TypeSectionPlan {
    host_type_map: Vec<i32>,
    fn_type_map: Vec<i32>,
    wrapper_type_idx: i32,
    wit_type_map: Vec<i32>,
    wit_import_count: i32,
    gc_fixed_type_map: Vec<i32>,
    gc_type_base: i32,
    gc_enum_variant_base: i32,
    gc_enum_variant_type_map: Vec<i32>,
    gc_struct_base: i32,
    gc_struct_type_map: Vec<i32>,
    fn_result_gc_map: Vec<i32>,
}

fn TypeSectionPlan_new(
    host_type_map: Vec<i32>,
    fn_type_map: Vec<i32>,
    wrapper_type_idx: i32,
    wit_type_map: Vec<i32>,
    wit_import_count: i32,
    gc_fixed_type_map: Vec<i32>,
    gc_type_base: i32,
    gc_enum_variant_base: i32,
    gc_enum_variant_type_map: Vec<i32>,
    gc_struct_base: i32,
    gc_struct_type_map: Vec<i32>
) -> TypeSectionPlan {
    TypeSectionPlan {
        host_type_map: host_type_map,
        fn_type_map: fn_type_map,
        wrapper_type_idx: wrapper_type_idx,
        wit_type_map: wit_type_map,
        wit_import_count: wit_import_count,
        gc_fixed_type_map: gc_fixed_type_map,
        gc_type_base: gc_type_base,
        gc_enum_variant_base: gc_enum_variant_base,
        gc_enum_variant_type_map: gc_enum_variant_type_map,
        gc_struct_base: gc_struct_base,
        gc_struct_type_map: gc_struct_type_map,
        fn_result_gc_map: Vec::new<i32>()
    }
}

fn TypeSectionPlan_host_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.host_type_map
}

fn TypeSectionPlan_wit_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.wit_type_map
}

fn TypeSectionPlan_wit_import_count(plan: TypeSectionPlan) -> i32 {
    plan.wit_import_count
}

fn TypeSectionPlan_fn_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.fn_type_map
}

fn TypeSectionPlan_wrapper_type_idx(plan: TypeSectionPlan) -> i32 {
    plan.wrapper_type_idx
}

fn TypeSectionPlan_gc_fixed_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.gc_fixed_type_map
}

fn TypeSectionPlan_gc_type_base(plan: TypeSectionPlan) -> i32 {
    plan.gc_type_base
}

fn TypeSectionPlan_gc_enum_variant_base(plan: TypeSectionPlan) -> i32 {
    plan.gc_enum_variant_base
}

fn TypeSectionPlan_gc_enum_variant_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.gc_enum_variant_type_map
}

fn TypeSectionPlan_gc_struct_base(plan: TypeSectionPlan) -> i32 {
    plan.gc_struct_base
}

fn TypeSectionPlan_gc_struct_type_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.gc_struct_type_map
}

fn TypeSectionPlan_fn_result_gc_map(plan: TypeSectionPlan) -> Vec<i32> {
    plan.fn_result_gc_map
}

fn TypeSectionPlan_set_fn_result_gc_map(plan: TypeSectionPlan, fn_result_gc_map: Vec<i32>) {
    plan.fn_result_gc_map = fn_result_gc_map
}

fn TypeSectionPlan_with_fn_result_gc_map(plan: TypeSectionPlan, fn_result_gc_map: Vec<i32>) -> TypeSectionPlan {
    TypeSectionPlan {
        host_type_map: plan.host_type_map,
        fn_type_map: plan.fn_type_map,
        wrapper_type_idx: plan.wrapper_type_idx,
        wit_type_map: plan.wit_type_map,
        wit_import_count: plan.wit_import_count,
        gc_fixed_type_map: plan.gc_fixed_type_map,
        gc_type_base: plan.gc_type_base,
        gc_enum_variant_base: plan.gc_enum_variant_base,
        gc_enum_variant_type_map: plan.gc_enum_variant_type_map,
        gc_struct_base: plan.gc_struct_base,
        gc_struct_type_map: plan.gc_struct_type_map,
        fn_result_gc_map: fn_result_gc_map
    }
}

fn build_type_section_plan(
    type_map: Vec<i32>,
    num_host_types: i32,
    wit_import_count: i32,
    gc_fixed_count: i32,
    gc_struct_count: i32,
    gc_enum_variant_count: i32,
    fn_count: i32,
    needs_wrapper: i32
) -> TypeSectionPlan {
    let gc_type_count = gc_fixed_count + gc_struct_count + gc_enum_variant_count
    let host_type_map = build_host_type_map(type_map, num_host_types)
    let wit_type_map = build_wit_type_map(type_map, num_host_types, wit_import_count)
    let fn_type_map = build_function_type_map(type_map, num_host_types, wit_import_count, gc_type_count, fn_count)
    let wrapper_type_idx = wrapper_type_index(type_map, num_host_types, wit_import_count, gc_type_count, fn_count, needs_wrapper)
    let gc_fixed_type_map = build_gc_fixed_type_map(type_map, num_host_types, wit_import_count, gc_fixed_count)
    let gc_type_base = first_mapped_type_index(gc_fixed_type_map)
    let gc_struct_type_map = build_gc_struct_type_map(type_map, num_host_types, wit_import_count, gc_fixed_count, gc_struct_count)
    let gc_enum_variant_type_map = build_gc_enum_variant_type_map(type_map, num_host_types, wit_import_count, gc_fixed_count, gc_struct_count, gc_enum_variant_count)
    let gc_struct_base = first_mapped_type_index(gc_struct_type_map)
    let gc_enum_variant_base = first_mapped_type_index(gc_enum_variant_type_map)
    TypeSectionPlan_new(
        host_type_map,
        fn_type_map,
        wrapper_type_idx,
        wit_type_map,
        wit_import_count,
        gc_fixed_type_map,
        gc_type_base,
        gc_enum_variant_base,
        gc_enum_variant_type_map,
        gc_struct_base,
        gc_struct_type_map
    )
}

fn first_mapped_type_index(type_map: Vec<i32>) -> i32 {
    if len(type_map) == 0 {
        return 0 - 1
    }
    get_unchecked(type_map, 0)
}

fn build_gc_fixed_type_map(type_map: Vec<i32>, num_host_types: i32, wit_import_count: i32, gc_fixed_count: i32) -> Vec<i32> {
    let mut fixed_map = Vec::new<i32>()
    let base_idx = num_host_types + wit_import_count
    let mut gi = 0
    while gi < gc_fixed_count {
        push(fixed_map, get_unchecked(type_map, base_idx + gi))
        gi = gi + 1
    }
    fixed_map
}

fn build_gc_struct_type_map(type_map: Vec<i32>, num_host_types: i32, wit_import_count: i32, gc_fixed_count: i32, gc_struct_count: i32) -> Vec<i32> {
    let mut struct_map = Vec::new<i32>()
    let base_idx = num_host_types + wit_import_count + gc_fixed_count
    let mut si = 0
    while si < gc_struct_count {
        push(struct_map, get_unchecked(type_map, base_idx + si))
        si = si + 1
    }
    struct_map
}

fn build_gc_enum_variant_type_map(type_map: Vec<i32>, num_host_types: i32, wit_import_count: i32, gc_fixed_count: i32, gc_struct_count: i32, enum_variant_count: i32) -> Vec<i32> {
    let mut variant_map = Vec::new<i32>()
    let base_idx = num_host_types + wit_import_count + gc_fixed_count + gc_struct_count
    let mut si = 0
    while si < enum_variant_count {
        push(variant_map, get_unchecked(type_map, base_idx + si))
        si = si + 1
    }
    variant_map
}

fn build_host_type_map(type_map: Vec<i32>, num_host_types: i32) -> Vec<i32> {
    let mut host_type_map = Vec::new<i32>()
    let mut wti = 0
    while wti < num_host_types {
        push(host_type_map, get_unchecked(type_map, wti))
        wti = wti + 1
    }
    host_type_map
}

fn build_function_type_map(type_map: Vec<i32>, num_host_types: i32, wit_import_count: i32, gc_type_count: i32, fn_count: i32) -> Vec<i32> {
    let mut fn_type_map = Vec::new<i32>()
    let mut fti = 0
    while fti < fn_count {
        push(fn_type_map, get_unchecked(type_map, fti + num_host_types + wit_import_count + gc_type_count))
        fti = fti + 1
    }
    fn_type_map
}

fn build_wit_type_map(type_map: Vec<i32>, num_host_types: i32, wit_import_count: i32) -> Vec<i32> {
    let mut wit_type_map = Vec::new<i32>()
    let mut wti = 0
    while wti < wit_import_count {
        push(wit_type_map, get_unchecked(type_map, num_host_types + wti))
        wti = wti + 1
    }
    wit_type_map
}

fn wrapper_type_index(type_map: Vec<i32>, num_host_types: i32, wit_import_count: i32, gc_type_count: i32, fn_count: i32, needs_wrapper: i32) -> i32 {
    if needs_wrapper == 1 {
        return get_unchecked(type_map, num_host_types + wit_import_count + gc_type_count + fn_count)
    }
    0 - 1
}

fn type_sig_param_segments(csig: String) -> Vec<String> {
    let sig_len = len(csig)
    let mut param_segments = Vec::new<String>()
    let mut seg_start = 0
    let mut si = 0
    while si < sig_len {
        if char_at(csig, si) == 95 {
            let seg = substring(csig, seg_start, si)
            push(param_segments, seg)
            seg_start = si + 1
        }
        si = si + 1
    }
    param_segments
}

fn type_sig_result_segment(csig: String) -> String {
    let sig_len = len(csig)
    let mut seg_start = 0
    let mut si = 0
    while si < sig_len {
        if char_at(csig, si) == 95 {
            seg_start = si + 1
        }
        si = si + 1
    }
    substring(csig, seg_start, sig_len)
}

fn val_type_to_sig(vt: i32) -> String {
    match vt {
        1 => "i32",
        2 => "i64",
        3 => "f64",
        5 => "gcref",
        6 => "f32",
        7 => "v128",
        8 => "fnref",
        30 => "i32",
        _ => "ref",
    }
}

fn val_type_to_target_sig(vt: i32, is_gc_target: bool, memory64: bool) -> String {
    // Linear wasm32 stores String/Vec as i32 pointers. Emitting the GC
    // "ref"/"gcref" sigs with an empty TypeSectionPlan map writes
    // `ref.null` + leb128(-1) = 0x63 0x7f, which is not a valid valtype.
    if !is_gc_target && (vt == value_types::VT_REF() || vt == value_types::VT_GC_REF()) {
        return "i32"
    }
    // Typed funcref stays a reference type under Memory64 (not an i64 index).
    if vt == value_types::VT_FUNCREF() {
        return "fnref"
    }
    // Memory64 (wasm32-gc default): widen former i32 Wasm values to i64.
    // WASI P2 command/component keeps i32 linear memory (#714), so skip widen.
    if memory64 && (vt == 1 || vt == 30) {
        return "i64"
    }
    val_type_to_sig(vt)
}

fn sig_to_wasm_type(sig: String) -> i32 {
    if eq(clone(sig), "i32") {
        return constants::WASM_I32()
    }
    if eq(clone(sig), "i64") {
        return constants::WASM_I64()
    }
    if eq(clone(sig), "f64") {
        return constants::WASM_F64()
    }
    if eq(clone(sig), "f32") {
        return constants::WASM_F32()
    }
    if eq(clone(sig), "funcref") {
        return constants::WASM_FUNCREF()
    }
    if eq(clone(sig), "v128") {
        return constants::WASM_V128()
    }
    if eq(clone(sig), "i8") {
        return constants::WASM_I8()
    }
    constants::WASM_I32()
}
