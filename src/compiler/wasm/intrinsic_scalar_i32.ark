use wasm::opcodes
use wasm::ctx_scratch
use wasm::writer_core
use wasm::intrinsics::helpers_numeric_i32

// The if result carries the i32 scalar: i32 on memory32, widened i64 on
// Memory64 where all i32 source values live in i64 lanes.
fn emit_scalar_i32_result_blocktype(mut w: WasmWriter) {
    if writer_core::writer_memory64(w) {
        writer_core::emit_byte(w, 126)
        return
    }
    writer_core::emit_byte(w, 127)
}

fn emit_abs(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    let s0 = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_TEE())
    writer_core::emit_leb128_u(w, s0)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    writer_core::emit_byte(w, opcodes::OP_IF())
    emit_scalar_i32_result_blocktype(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    writer_core::emit_local_get(w, s0)
    helpers_numeric_i32::emit_i32_sub(w)
    writer_core::emit_byte(w, opcodes::OP_ELSE())
    writer_core::emit_local_get(w, s0)
    writer_core::emit_byte(w, opcodes::OP_END())
    return true
}

fn emit_min(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    let s0 = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    let s1 = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s1)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s0)
    writer_core::emit_local_get(w, s0)
    writer_core::emit_local_get(w, s1)
    writer_core::emit_local_get(w, s0)
    writer_core::emit_local_get(w, s1)
    helpers_numeric_i32::emit_i32_le_s(w)
    writer_core::emit_byte(w, opcodes::OP_SELECT())
    return true
}

fn emit_max(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    let s0 = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    let s1 = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s1)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s0)
    writer_core::emit_local_get(w, s0)
    writer_core::emit_local_get(w, s1)
    writer_core::emit_local_get(w, s0)
    writer_core::emit_local_get(w, s1)
    helpers_numeric_i32::emit_i32_ge_s(w)
    writer_core::emit_byte(w, opcodes::OP_SELECT())
    return true
}

fn emit_clamp(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    let s0 = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    let s1 = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    let s2 = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s2)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s1)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s0)
    writer_core::emit_local_get(w, s0)
    writer_core::emit_local_get(w, s1)
    helpers_numeric_i32::emit_i32_lt_s(w)
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)
    writer_core::emit_local_get(w, s1)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s0)
    writer_core::emit_byte(w, opcodes::OP_END())
    writer_core::emit_local_get(w, s0)
    writer_core::emit_local_get(w, s2)
    helpers_numeric_i32::emit_i32_gt_s(w)
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)
    writer_core::emit_local_get(w, s2)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s0)
    writer_core::emit_byte(w, opcodes::OP_END())
    writer_core::emit_local_get(w, s0)
    return true
}
