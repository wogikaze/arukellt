// Mono type signature helpers.
use std::text
use mir::lower::mono_suffix_parse
use mir::module_gc_enum
use mir::module_gc_struct
use wasm::emit_target
use wasm::sections_types_gc
use wasm::sections_types_sigs_mono_helpers
fn extract_mono_suffix(fn_name: String) -> String {
    let name_len = fn_name.len()
    // Collect all "__" positions
    let mut sep_positions = Vec::new<i32>()
    let mut i = 0
    while i < name_len - 1 {
        if fn_name.byte_at(i) == 95 && fn_name.byte_at(i + 1) == 95 {
            push(sep_positions, i)
        }
        i = i + 1
    }
    let sep_count = sep_positions.len()
    if sep_count == 0 {
        return String_new()
    }
    // Try positions from left to right: the first position where all suffix
    // parts are valid type keys is the correct separator. This handles both
    // method names (e.g. "Picker__echo__i32" → "echo" is invalid, "i32" is valid)
    // and multi-param generics (e.g. "pair_first__i32__String" → "i32__String" all valid).
    let mut si = 0
    while si < sep_count {
        let sep_pos = sep_positions.get_unchecked(si)
        let suffix = fn_name.slice(sep_pos + 2, name_len)
        let type_keys = split_by_double_underscore(suffix)
        let key_count = type_keys.len()
        if key_count > 0 && all_valid_type_keys(type_keys, key_count) {
            return suffix
        }
        si = si + 1
    }
    // No valid mono type-key suffix (e.g. "__core_*" intrinsic names).
    String_new()
}

// Check if all type keys in a list are valid mono type keys.
// Valid keys: known primitives (i32, i64, f64, f32, bool, char),
// "String", or identifiers starting with an uppercase letter (struct/enum names).
fn all_valid_type_keys(type_keys: Vec<String>, key_count: i32) -> bool {
    let mut ki = 0
    while ki < key_count {
        let key = type_keys.get_unchecked(ki)
        if !is_valid_type_key(key) {
            return false
        }
        ki = ki + 1
    }
    true
}

fn is_valid_type_key(key: String) -> bool {
    if key.clone().eq("i32") ||
    key.clone().eq("i64") ||
    key.clone().eq("f64") ||
    key.clone().eq("f32") ||
    key.clone().eq("bool") ||
    key.clone().eq("char") ||
    key.clone().eq("String") ||
    key.clone().eq("string") {
        return true
    }
    // User-defined type names start with uppercase letter (A-Z = 65-90)
    if key.len() > 0 {
        let first = key.byte_at(0)
        if first >= 65 && first <= 90 {
            return true
        }
    }
    false
}

fn resolve_mono_param_type_from_fn_name(fn_name: String, type_var_name: String, _param_ordinal: i32) -> String {
    // For specialized mono functions (name contains "__"), extract the
    // concrete type from the function name suffix and map it to a wasm type sig.
    // The suffix may contain multiple type parameters separated by "__"
    // (e.g. "i32__String" for ok_or_default<i32, String>).
    //
    // For method names like "Picker__echo__i32", the base name itself contains
    // "__" (from "::" → "__"). We must find the correct "__" that separates the
    // base name from the mono suffix by trying positions from right to left and
    // checking if all suffix parts are valid type keys.
    let full_suffix = extract_mono_suffix(fn_name)
    if full_suffix.len() == 0 {
        return String_new()
    }
    // Split the suffix by "__" to get individual type parameter concrete types.
    let type_keys = split_by_double_underscore(full_suffix)
    let key_count = type_keys.len()
    if key_count == 0 {
        return String_new()
    }
    // Determine which type parameter index to use based on the type variable name.
    // The fallback table is centralized in mono_suffix_parse; declared
    // ordinals are bound by the signature registry before this path is hit.
    let type_idx = mono_suffix_parse::mono_type_var_to_index(type_var_name.clone())
    if type_idx < 0 || type_idx >= key_count {
        return sections_types_sigs_mono_helpers::mono_type_key_to_sig(type_keys.get_unchecked(0))
    }
    sections_types_sigs_mono_helpers::mono_type_key_to_sig(type_keys.get_unchecked(type_idx))
}

// Try to resolve a mono type variable parameter to a gc_struct type sig.
// Extracts the concrete type key from the function name suffix and checks
// if it's a registered gc_struct in the module.  Returns "gcsref<slot>" if
// found, empty otherwise.
fn try_mono_gc_struct_param_sig(fn_name: String, type_var_name: String, _param_ordinal: i32, mir: MirModule) -> String {
    let full_suffix = extract_mono_suffix(fn_name)
    if full_suffix.len() == 0 {
        return String_new()
    }
    let type_keys = split_by_double_underscore(full_suffix)
    let key_count = type_keys.len()
    if key_count == 0 {
        return String_new()
    }
    let type_idx = mono_suffix_parse::mono_type_var_to_index(type_var_name.clone())
    if type_idx < 0 || type_idx >= key_count {
        return String_new()
    }
    let key = type_keys.get_unchecked(type_idx)
    let slot = module_gc_struct::MirModule_gc_struct_slot(mir, key.clone())
    if slot >= 0 {
        return "gcsref".concat((slot).to_string())
    }
    String_new()
}

// Split a string by "__" separator into a Vec<String>.
fn split_by_double_underscore(s: String) -> Vec<String> {
    let mut result = Vec::new<String>()
    let slen = s.len()
    let mut start = 0
    let mut i = 0
    while i < slen - 1 {
        if s.byte_at(i) == 95 && s.byte_at(i + 1) == 95 {
            push(result, s.slice(start, i))
            start = i + 2
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if start <= slen {
        push(result, s.slice(start, slen))
    }
    result
}

// For mono method names like "Picker__echo__String", MIR may still carry the
// receiver struct name ("Picker" / "struct:Picker:…") as return_type_name.
// When the mono suffix names a different concrete type, use that for wasm return.
fn resolve_mono_method_return_value_sig(fn_name: String, return_type_name: String, mir: MirModule) -> String {
    let full_suffix = extract_mono_suffix(fn_name)
    if full_suffix.len() == 0 {
        return String_new()
    }
    let suffix_with_sep = "__".concat(full_suffix.clone())
    let fn_len = fn_name.len()
    let suffix_sep_len = suffix_with_sep.len()
    if fn_len <= suffix_sep_len || !fn_name.clone().ends_with(suffix_with_sep.clone()) {
        return String_new()
    }
    let base = fn_name.slice(0, fn_len - suffix_sep_len)
    let base_parts = split_by_double_underscore(base.clone())
    // Require Type__method base shape; plain mono functions like id__i32 must not match.
    if base_parts.len() < 2 {
        return String_new()
    }
    let mut receiver = sections_types_sigs_mono_helpers::mono_method_receiver_name(return_type_name.clone(), mir)
    if receiver.len() == 0 {
        receiver = base_parts.get_unchecked(0)
    }
    if receiver.len() == 0 {
        return String_new()
    }
    if !fn_name.clone().starts_with(receiver.clone().concat("__")) {
        return String_new()
    }
    // The suffix keys bind the method's type arguments; they double as the
    // return type only when the declared return is generic — a type variable,
    // or the receiver name MIR still carries for generic methods (e.g.
    // "Picker" on Picker__echo__String). A concrete declared return such as
    // enum:Ordering on Reverse__cmp__i32 names a different type and must
    // resolve through the normal return-type paths below.
    if return_type_name.len() > 0 {
        let mut var_probe = return_type_name.clone()
        if var_probe.clone().starts_with("?") {
            var_probe = var_probe.slice(1, var_probe.len())
        }
        let is_var_return = !mono_return_name_is_declared_nominal(mir, var_probe.clone()) &&
        mono_suffix_parse::is_mono_type_var_name(var_probe.clone())
        if !is_var_return && !mono_declared_return_is_receiver(return_type_name.clone(), receiver.clone()) {
            return String_new()
        }
    }
    let type_keys = split_by_double_underscore(full_suffix)
    let key_count = type_keys.len()
    if key_count <= 0 {
        return String_new()
    }
    let last_key = type_keys.get_unchecked(key_count - 1)
    if last_key.clone().eq(receiver.clone()) {
        return String_new()
    }
    let sig = sections_types_sigs_mono_helpers::mono_type_key_to_sig(last_key.clone())
    if sig.len() > 0 {
        return sig
    }
    let slot = module_gc_struct::MirModule_gc_struct_slot(mir, last_key.clone())
    if slot >= 0 {
        return "gcsref".concat((slot).to_string())
    }
    String_new()
}

// A declared nominal type named by the return position is concrete even
// when its name is one uppercase letter; only unresolved names keep the
// type-variable fallback (ADR-089). Registered struct and enum tables are
// the declaration evidence available at signature-emit time.
fn mono_return_name_is_declared_nominal(mir: MirModule, name: String) -> bool {
    if module_gc_struct::MirModule_gc_struct_slot(mir, name.clone()) >= 0 {
        return true
    }
    module_gc_enum::MirModule_gc_enum_base_has_variants(mir, name)
}

// True when the declared return type name is just the receiver type — the
// shape MIR produces for generic methods whose real return is a type
// variable. enum:Ordering, Pair<String>, and scalars are genuine returns.
fn mono_declared_return_is_receiver(return_type_name: String, receiver: String) -> bool {
    if receiver.len() == 0 {
        return false
    }
    let mut bare = return_type_name.clone()
    let n = bare.len()
    if bare.clone().starts_with("struct:") {
        // struct:Name:size — keep the middle segment.
        let mut first_colon = 0 - 1
        let mut last_colon = 0 - 1
        let mut i = 0
        while i < n {
            if bare.byte_at(i) == 58 {
                if first_colon < 0 {
                    first_colon = i
                }
                last_colon = i
            }
            i = i + 1
        }
        if first_colon >= 0 && last_colon > first_colon {
            bare = bare.slice(first_colon + 1, last_colon)
        }
    } else {
        // Strip enum:/option:/... prefixes and module qualifiers: keep the
        // segment after the last colon.
        let mut last_colon = 0 - 1
        let mut i = 0
        while i < n {
            if bare.byte_at(i) == 58 {
                last_colon = i
            }
            i = i + 1
        }
        if last_colon >= 0 {
            bare = bare.slice(last_colon + 1, n)
        }
    }
    bare.eq(receiver)
}
