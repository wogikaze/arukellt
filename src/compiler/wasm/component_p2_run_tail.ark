// Arukellt Selfhost - pre-encoded inner wasi:cli/run component for P2 command wrappers.
//
// Inner component with result type for the run export:
//   (component
//     (type (result))
//     (type (func (result 0)))
//     (import "import-func-run" (func (type 1)))
//     (type (result))
//     (type (func (result 2)))
//     (export "run" (func 0) (func (type 3))))

fn p2_run_inner_component_bytes() -> Vec<i32> {
    let mut hex = "0061736d0d0001000708026a0000400000000a1401000f696d706f72742d66756e632d72756e01010708026a0000400000020b0b01000372756e0100010103001a0e636f6d706f6e656e742d6e616d65"
    hex = concat(hex, "00090872756e5f636f6d70")
    p2_run_bytes_from_hex(hex)
}

fn p2_run_bytes_from_hex(hex: String) -> Vec<i32> {
    let out = Vec_new_i32()
    let n = len(hex)
    let mut i = 0
    while i + 1 < n {
        let hi = p2_run_hex_val(char_at(hex, i))
        let lo = p2_run_hex_val(char_at(hex, i + 1))
        push(out, hi * 16 + lo)
        i = i + 2
    }
    out
}

fn p2_run_hex_val(c: i32) -> i32 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    0
}
