use std::prelude::{byte_at, clone, ends_with, eq, starts_with, substring}
use std::text
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use mir::inst_accessors_literals
use mir::block_inst_access
use mir::function_block_queries
use mir::function_locals_view
use mir::function_return_view
use mir::local_access
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::ctx_record
use wasm::sections_types_gc_phase7
use mir::opcodes as mir_opcodes
fn local_type_name(ctx: SelfEmitCtx, local_idx: i32) -> String {
    if local_idx < 0 {
        return ""
    }
    let func_idx = ctx_record::SelfEmitCtx_current_func_idx(ctx)
    let f = ctx_record::SelfEmitCtx_function_at(ctx, func_idx)
    if local_idx >= function_locals_view::MirFunction_local_count(f) {
        return ""
    }
    let loc = function_locals_view::MirFunction_local_at(f, local_idx)
    local_access::MirLocal_type_name(loc)
}

fn resolve_vec_type_for_new_dest(ctx: SelfEmitCtx, dest_local: i32) -> i32 {
    let local_vt = ctx_gc_type::SelfEmitCtx_vec_type_for_local(ctx, dest_local)
    // Vec_new often writes a temp that is immediately stored into an annotated
    // let binding (e.g. `let outer: Vec<Vec<i32>> = Vec::new<i32>()`). Prefer the
    // store target's type when the temp itself is untyped / vec:i32.
    let store_vt = resolve_vec_type_from_immediate_store(ctx, dest_local)
    let default_vt = ctx_gc_type::SelfEmitCtx_vec_type(ctx)
    if store_vt >= 0 &&
    (local_vt < 0 || local_vt == default_vt) {
        return store_vt
    }
    // A constructor returned directly from a function has no following store
    // to carry its element type. The local metadata defaults to Vec<i32>, so
    // consult the monomorphized constructor before accepting that fallback.
    let constructor_vt = resolve_vec_type_from_constructor(ctx, dest_local)
    if constructor_vt >= 0 && (local_vt < 0 || local_vt == default_vt) {
        return constructor_vt
    }
    if local_vt >= 0 {
        return local_vt
    }
    if store_vt >= 0 {
        return store_vt
    }
    default_vt
}

fn resolve_array_type_for_new_dest(ctx: SelfEmitCtx, dest_local: i32) -> i32 {
    let local_type = sections_types_gc_phase7::gc_normalize_vec_type_name(local_type_name(ctx, dest_local))
    let store_type = sections_types_gc_phase7::gc_normalize_vec_type_name(find_immediate_store_target_type_name(ctx, dest_local))
    let mut type_name = clone(local_type)
    if len(store_type) > 0 &&
    vec_new_type_name_is_unresolved(clone(local_type)) {
        let store_array = resolve_array_type_from_type_name(ctx, clone(store_type))
        if store_array >= 0 {
            return store_array
        }
        type_name = store_type
    }
    let constructor_array = resolve_array_type_from_constructor(ctx, dest_local)
    if constructor_array >= 0 &&
    vec_new_type_name_is_unresolved(clone(local_type)) &&
    vec_new_type_name_is_unresolved(clone(store_type)) {
        return constructor_array
    }
    let resolved = resolve_array_type_from_type_name(ctx, clone(type_name))
    if resolved >= 0 {
        return resolved
    }
    if constructor_array >= 0 {
        return constructor_array
    }
    ctx_gc_type::SelfEmitCtx_i32_array_type(ctx)
}

fn resolve_vec_type_from_constructor(ctx: SelfEmitCtx, dest_local: i32) -> i32 {
    let func_idx = ctx_record::SelfEmitCtx_current_func_idx(ctx)
    let f = ctx_record::SelfEmitCtx_function_at(ctx, func_idx)
    let block_count = function_block_queries::MirFunction_block_count(f)
    let mut bi = 0
    while bi < block_count {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(inst) == mir_opcodes::MIR_CALL() &&
            inst_accessors_operands::MirInst_dest(inst) == dest_local {
                let callee = inst_accessors_literals::MirInst_str_val(inst)
                let elem = constructor_element_name(clone(callee))
                if len(elem) > 0 {
                    return resolve_vec_type_from_type_name(ctx, String_from("vec:").concat(elem))
                }
                if is_raw_array_new_call_name(clone(callee)) {
                    let fn_ret = raw_ctor_fn_return_vec_type_name(ctx)
                    if len(fn_ret) > 0 {
                        return resolve_vec_type_from_type_name(ctx, fn_ret)
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    0 - 1
}

fn resolve_array_type_from_constructor(ctx: SelfEmitCtx, dest_local: i32) -> i32 {
    let func_idx = ctx_record::SelfEmitCtx_current_func_idx(ctx)
    let f = ctx_record::SelfEmitCtx_function_at(ctx, func_idx)
    let block_count = function_block_queries::MirFunction_block_count(f)
    let mut bi = 0
    while bi < block_count {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(inst) == mir_opcodes::MIR_CALL() &&
            inst_accessors_operands::MirInst_dest(inst) == dest_local {
                let callee = inst_accessors_literals::MirInst_str_val(inst)
                let elem = constructor_element_name(clone(callee))
                if len(elem) > 0 {
                    return resolve_array_type_from_type_name(
                        ctx,
                        String_from("vec:").concat(elem)
                    )
                }
                if is_raw_array_new_call_name(clone(callee)) {
                    let fn_ret = raw_ctor_fn_return_vec_type_name(ctx)
                    if len(fn_ret) > 0 {
                        return resolve_array_type_from_type_name(ctx, fn_ret)
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    0 - 1
}

fn constructor_element_name(callee: String) -> String {
    if starts_with(clone(callee), String_from("Vec_new_")) {
        return substring(callee, 8, len(callee))
    }
    if starts_with(clone(callee), String_from("Vec_with_capacity_")) {
        return substring(callee, 18, len(callee))
    }
    if starts_with(clone(callee), String_from("Vec::new__")) ||
    starts_with(clone(callee), String_from("Vec__new__")) ||
    starts_with(clone(callee), String_from("Vec::with_capacity__")) ||
    starts_with(clone(callee), String_from("Vec__with_capacity__")) {
        let separator = last_index_of_double_underscore(clone(callee))
        if separator >= 0 {
            return substring(callee, separator + 2, len(callee))
        }
    }
    String_new()
}

// raw_array_new is a sealed raw Vec constructor: the call itself carries no
// element evidence, so its dest defaults to vec:i32 at lowering. When the
// enclosing function declares a Vec return, that element type is the only
// sound one (#872: __core_vec_new_f64_impl emitted an i32 vec as Vec<f64>).
// "vec:i32" is the raw-ctor default stamp, not evidence; an unsubstituted
// type-parameter name (vec:T / vec:t0) is equally unresolved. Both must let
// constructor or store-target evidence pick the concrete element type.
fn vec_new_type_name_is_unresolved(tname: String) -> bool {
    if len(tname) == 0 {
        return true
    }
    if eq(clone(tname), String_from("vec:i32")) {
        return true
    }
    if starts_with(clone(tname), String_from("vec:")) {
        return sections_types_gc_phase7::gc_vec_elem_name_is_type_param(
            substring(tname, 4, len(tname))
        )
    }
    false
}

fn is_raw_array_new_call_name(callee: String) -> bool {
    eq(clone(callee), String_from("raw_array_new")) ||
    eq(clone(callee), String_from("raw::raw_array_new")) ||
    ends_with(clone(callee), String_from("::raw_array_new"))
}

fn raw_ctor_fn_return_vec_type_name(ctx: SelfEmitCtx) -> String {
    let func_idx = ctx_record::SelfEmitCtx_current_func_idx(ctx)
    let f = ctx_record::SelfEmitCtx_function_at(ctx, func_idx)
    let tname = sections_types_gc_phase7::gc_normalize_vec_type_name(
        function_return_view::MirFunction_return_type_name(f)
    )
    if starts_with(clone(tname), String_from("vec:")) {
        return tname
    }
    String_new()
}

fn last_index_of_double_underscore(s: String) -> i32 {
    let mut i = len(s) - 2
    while i >= 0 {
        if byte_at(s, i) == 95 && byte_at(s, i + 1) == 95 {
            return i
        }
        i = i - 1
    }
    0 - 1
}

fn resolve_array_type_from_type_name(ctx: SelfEmitCtx, tname: String) -> i32 {
    let local_name = clone(tname)
    let mut tname = sections_types_gc_phase7::gc_normalize_vec_type_name(tname)
    if starts_with(clone(local_name), String_from("array:")) {
        tname = String_from("vec:").concat(substring(local_name, 6, len(local_name)))
    }
    if eq(clone(tname), "vec:String") {
        return ctx_gc_type::SelfEmitCtx_string_array_type(ctx)
    }
    if eq(clone(tname), "vec:v128") || eq(clone(tname), "vec:V128") {
        return ctx_gc_type::SelfEmitCtx_v128_array_type(ctx)
    }
    if eq(clone(tname), "vec:i64") || eq(clone(tname), "vec:I64") {
        return ctx_gc_type::SelfEmitCtx_i64_array_type(ctx)
    }
    if eq(clone(tname), "vec:f64") || eq(clone(tname), "vec:F64") {
        return ctx_gc_type::SelfEmitCtx_f64_array_type(ctx)
    }
    if eq(clone(tname), "vec:fnref") || eq(clone(tname), "vec:fn") {
        return ctx_gc_type_vec_ref::SelfEmitCtx_fnref_array_type(ctx)
    }
    if starts_with(clone(tname), "vec:") {
        let elem = substring(clone(tname), 4, len(tname))
        if sections_types_gc_phase7::gc_vec_elem_name_is_fnref(clone(elem)) {
            return ctx_gc_type_vec_ref::SelfEmitCtx_fnref_array_type(ctx)
        }
        if sections_types_gc_phase7::gc_vec_elem_name_is_enum_like(clone(elem)) {
            return ctx_gc_type_vec_ref::SelfEmitCtx_enum_ref_array_type(ctx)
        }
        if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem)) ||
        eq(clone(elem), "Vec") ||
        starts_with(clone(elem), "vec:") ||
        ctx_gc_type_vec_ref::gc_vec_elem_is_registered_struct(ctx, clone(elem)) {
            return ctx_gc_type_vec_ref::SelfEmitCtx_struct_ref_array_type(ctx)
        }
        return ctx_gc_type::SelfEmitCtx_i32_array_type(ctx)
    }
    0 - 1
}

fn resolve_vec_type_from_immediate_store(ctx: SelfEmitCtx, dest_local: i32) -> i32 {
    let tname = sections_types_gc_phase7::gc_normalize_vec_type_name(find_immediate_store_target_type_name(ctx, dest_local))
    if len(tname) == 0 {
        return 0 - 1
    }
    resolve_vec_type_from_type_name(ctx, tname)
}

fn resolve_vec_type_from_type_name(ctx: SelfEmitCtx, tname: String) -> i32 {
    let tname = sections_types_gc_phase7::gc_normalize_vec_type_name(tname)
    if eq(clone(tname), "vec:String") {
        return ctx_gc_type::SelfEmitCtx_vec_string_type(ctx)
    }
    if eq(clone(tname), "vec:v128") || eq(clone(tname), "vec:V128") {
        return ctx_gc_type::SelfEmitCtx_vec_v128_type(ctx)
    }
    if eq(clone(tname), "vec:i64") || eq(clone(tname), "vec:I64") {
        return ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx)
    }
    if eq(clone(tname), "vec:f64") || eq(clone(tname), "vec:F64") {
        return ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx)
    }
    if eq(clone(tname), "vec:fnref") || eq(clone(tname), "vec:fn") {
        return ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx)
    }
    if starts_with(clone(tname), "vec:") {
        let elem = substring(clone(tname), 4, len(tname))
        if sections_types_gc_phase7::gc_vec_elem_name_is_fnref(clone(elem)) {
            return ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx)
        }
        if sections_types_gc_phase7::gc_vec_elem_name_is_enum_like(clone(elem)) {
            return ctx_gc_type_vec_ref::SelfEmitCtx_vec_enum_ref_type(ctx)
        }
        if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem)) ||
        eq(clone(elem), "Vec") ||
        starts_with(clone(elem), "vec:") ||
        ctx_gc_type_vec_ref::gc_vec_elem_is_registered_struct(ctx, clone(elem)) {
            return ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx)
        }
        return ctx_gc_type::SelfEmitCtx_vec_type(ctx)
    }
    0 - 1
}

fn find_immediate_store_target_type_name(ctx: SelfEmitCtx, dest_local: i32) -> String {
    let func_idx = ctx_record::SelfEmitCtx_current_func_idx(ctx)
    let f = ctx_record::SelfEmitCtx_function_at(ctx, func_idx)
    let block_count = function_block_queries::MirFunction_block_count(f)
    let mut bi = 0
    while bi < block_count {
        let block = function_block_queries::MirFunction_block_at(f, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let cur = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_shape::MirInst_op(cur) == mir_opcodes::MIR_CALL() {
                if inst_accessors_operands::MirInst_dest(cur) == dest_local {
                    let mut ahead = 1
                    while ahead <= 4 && ii + ahead < inst_count {
                        let next = block_inst_access::MirBlock_inst_at(block, ii + ahead)
                        if inst_accessors_shape::MirInst_op(next) == mir_opcodes::MIR_LOCAL_SET() {
                            // MirInst_local_set_from(target, source): arg0=target, arg1=source
                            if inst_accessors_operands::MirInst_arg1(next) == dest_local {
                                let target = inst_accessors_operands::MirInst_arg0(next)
                                return local_type_name(ctx, target)
                            }
                        }
                        ahead = ahead + 1
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    String_new()
}
