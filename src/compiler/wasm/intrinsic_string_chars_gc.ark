// GC target: text::chars returns Vec<String>, matching the public std::text
// contract. It shares the empty-separator implementation with split so every
// element is a one-byte String rather than an i32 character code.

use wasm::intrinsic_string_split_gc

fn emit_text_chars_gc(w: WasmWriter, ctx: SelfEmitCtx) -> bool {
    intrinsic_string_split_gc::emit_split_chars_gc(w, ctx)
}
