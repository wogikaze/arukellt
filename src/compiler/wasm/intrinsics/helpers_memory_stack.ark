use wasm::opcodes
use wasm::writer_core
use wasm::writer_leb
use wasm::intrinsics::helpers_memory_access

fn emit_i32_const(mut w: WasmWriter, value: i32) {
    if writer_core::writer_memory64(w) {
        writer_core::emit_byte(w, opcodes::OP_I64_CONST())
        writer_leb::emit_leb128_s(w, value)
        return
    }
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_leb::emit_leb128_s(w, value)
}

fn emit_i32_sub(mut w: WasmWriter) {
    if writer_core::writer_memory64(w) {
        writer_core::emit_byte(w, opcodes::OP_I64_SUB())
        return
    }
    writer_core::emit_byte(w, opcodes::OP_I32_SUB())
}

fn emit_local_get(mut w: WasmWriter, local: i32) {
    writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
    writer_leb::emit_leb128_u(w, local)
}

fn emit_local_set(mut w: WasmWriter, local: i32) {
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_leb::emit_leb128_u(w, local)
}

fn emit_scratch_addr(mut w: WasmWriter, offset: i32) {
    emit_i32_const(w, offset)
}

fn emit_string_len_from_stack(mut w: WasmWriter) {
    emit_i32_const(w, 4)
    emit_i32_sub(w)
    helpers_memory_access::emit_i32_load_default(w)
}

fn emit_load_string_len_to_local(mut w: WasmWriter, string_local: i32, len_local: i32) {
    emit_local_get(w, string_local)
    emit_string_len_from_stack(w)
    emit_local_set(w, len_local)
}
