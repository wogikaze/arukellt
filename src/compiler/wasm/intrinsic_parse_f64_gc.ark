use wasm::constants
use wasm::ctx_gc_type
use wasm::ctx_record
use wasm::ctx_scratch
use wasm::intrinsic_parse_f64_finalize
use wasm::intrinsic_parse_f64_scan
use wasm::runtime_abi_sockets_result
use wasm::runtime_abi_stdio_gc
use wasm::opcodes
use wasm::writer_core
use wasm::writer_gc
use wasm::writer_numbers
use wasm::intrinsics::helpers_control
use wasm::intrinsics::helpers_core
use wasm::intrinsics::helpers_io_const

// Real GC parse_f64 for finish_decimal_number / float lex (#834).
// Copies the String into linear memory, reuses the LM digit scanner, then
// wraps SCRATCH_PF_RESULT as Result::Ok(_f1_f64) or Result::Err(String).

fn emit_parse_f64_gc(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    let s_str = runtime_abi_stdio_gc::emit_gc_string_to_heap_from_stack(w, inst, ctx)
    let s_len_local = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    helpers_core::emit_local_get(w, s_str)
    emit_parse_f64_gc_init_state(w, s_str, s_len_local)
    intrinsic_parse_f64_scan::emit_parse_f64_scan_loop(w, s_str, s_len_local)
    emit_parse_f64_finalize_gc(w, ctx)
    true
}

fn emit_parse_f64_gc_init_state(w: WasmWriter, s_str: i32, s_len_local: i32) {
    // Same layout as LM emit_parse_f64_source: data ptr on stack, length at ptr-4.
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s_str)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
    writer_core::emit_leb128_u(w, s_str)
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, 4)
    writer_core::emit_byte(w, opcodes::OP_I32_SUB())
    writer_core::emit_byte(w, opcodes::OP_I32_LOAD())
    writer_core::emit_byte(w, 2)
    writer_core::emit_byte(w, 0)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s_len_local)
    emit_parse_f64_gc_zero_result(w)
    emit_parse_f64_gc_zero_flags(w)
    emit_parse_f64_gc_prefix_validation(w, s_str, s_len_local)
}

fn emit_parse_f64_gc_zero_result(w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, constants::SCRATCH_PF_RESULT())
    writer_core::emit_byte(w, opcodes::OP_F64_CONST())
    writer_numbers::emit_f64(w, 0.0)
    writer_core::emit_byte(w, opcodes::OP_F64_STORE())
    writer_core::emit_byte(w, 3)
    writer_core::emit_byte(w, 0)
}

fn emit_parse_f64_gc_zero_flags(w: WasmWriter) {
    emit_parse_f64_gc_store_i32_flag(w, constants::SCRATCH_P_I(), 0)
    emit_parse_f64_gc_store_i32_flag(w, constants::SCRATCH_P_NEG(), 0)
    emit_parse_f64_gc_store_i32_flag(w, constants::SCRATCH_P_ERR(), 0)
    emit_parse_f64_gc_store_i32_flag(w, constants::SCRATCH_PF_SAWDOT(), 0)
    emit_parse_f64_gc_store_i32_flag(w, constants::SCRATCH_PF_DECCOUNT(), 0)
}

fn emit_parse_f64_gc_store_i32_flag(w: WasmWriter, addr: i32, value: i32) {
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, addr)
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, value)
    writer_core::emit_byte(w, opcodes::OP_I32_STORE())
    writer_core::emit_byte(w, 2)
    writer_core::emit_byte(w, 0)
}

fn emit_parse_f64_gc_prefix_validation(w: WasmWriter, s_str: i32, s_len_local: i32) {
    writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
    writer_core::emit_leb128_u(w, s_len_local)
    writer_core::emit_byte(w, opcodes::OP_I32_EQZ())
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)
    emit_parse_f64_gc_store_i32_flag(w, constants::SCRATCH_P_ERR(), 1)
    writer_core::emit_byte(w, opcodes::OP_END())
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, constants::SCRATCH_P_ERR())
    writer_core::emit_byte(w, opcodes::OP_I32_LOAD())
    writer_core::emit_byte(w, 2)
    writer_core::emit_byte(w, 0)
    writer_core::emit_byte(w, opcodes::OP_I32_EQZ())
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
    writer_core::emit_leb128_u(w, s_str)
    writer_core::emit_byte(w, opcodes::OP_I32_LOAD8_U())
    writer_core::emit_byte(w, 0)
    writer_core::emit_byte(w, 0)
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, 45)
    writer_core::emit_byte(w, opcodes::OP_I32_EQ())
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)
    emit_parse_f64_gc_store_i32_flag(w, constants::SCRATCH_P_NEG(), 1)
    emit_parse_f64_gc_store_i32_flag(w, constants::SCRATCH_P_I(), 1)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_GET())
    writer_core::emit_leb128_u(w, s_len_local)
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, 1)
    writer_core::emit_byte(w, opcodes::OP_I32_LE_U())
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)
    emit_parse_f64_gc_store_i32_flag(w, constants::SCRATCH_P_ERR(), 1)
    writer_core::emit_byte(w, opcodes::OP_END())
    writer_core::emit_byte(w, opcodes::OP_END())
    writer_core::emit_byte(w, opcodes::OP_END())
}

fn emit_parse_f64_finalize_gc(w: WasmWriter, ctx: SelfEmitCtx) {
    let s_result = ctx_scratch::SelfEmitCtx_scratch_gc_enum_local(ctx, 0)
    let s_gc = ctx_scratch::SelfEmitCtx_scratch_gc_local(ctx, 0)
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, constants::SCRATCH_P_ERR())
    writer_core::emit_byte(w, opcodes::OP_I32_LOAD())
    writer_core::emit_byte(w, 2)
    writer_core::emit_byte(w, 0)
    helpers_control::emit_if_empty(w)
    emit_parse_f64_gc_err(w, ctx, s_gc)
    helpers_core::emit_local_set(w, s_result)
    helpers_control::emit_else(w)
    intrinsic_parse_f64_finalize::emit_parse_f64_decimal_divisor(w)
    intrinsic_parse_f64_finalize::emit_parse_f64_apply_decimal_part(w)
    intrinsic_parse_f64_finalize::emit_parse_f64_apply_sign(w)
    emit_parse_f64_gc_ok(w, ctx)
    helpers_core::emit_local_set(w, s_result)
    helpers_control::emit_end(w)
    helpers_core::emit_local_get(w, s_result)
}

fn emit_parse_f64_gc_ok(w: WasmWriter, ctx: SelfEmitCtx) {
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let ok_name = String_from("Result::Ok")
    let ok_suffix = String_from("_f1_f64")
    let ok_type = runtime_abi_sockets_result::find_result_variant_type_by_suffix(ctx, ok_name, ok_suffix)
    let type_idx = if ok_type >= 0 { ok_type } else { open_type }
    helpers_io_const::emit_i32_const(w, 0)
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, constants::SCRATCH_PF_RESULT())
    writer_core::emit_byte(w, opcodes::OP_F64_LOAD())
    writer_core::emit_byte(w, 3)
    writer_core::emit_byte(w, 0)
    writer_gc::emit_gc_struct_new(w, type_idx)
    writer_gc::emit_gc_ref_cast(w, open_type)
}

fn emit_parse_f64_gc_err(w: WasmWriter, ctx: SelfEmitCtx, s_gc: i32) {
    // Prefer String-payload Err (_f1_ref0). Reuse the input GC string — match
    // in finish_decimal_number ignores the Err message and emits TK_ERROR.
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let err_name = String_from("Result::Err")
    let err_suffix = String_from("_f1_ref0")
    let err_type = runtime_abi_sockets_result::find_result_variant_type_by_suffix(ctx, err_name, err_suffix)
    let type_idx = if err_type >= 0 { err_type } else { open_type }
    let string_type = ctx_record::SelfEmitCtx_gc_type_base(ctx)
    helpers_io_const::emit_i32_const(w, 1)
    helpers_core::emit_local_get(w, s_gc)
    writer_gc::emit_gc_ref_cast(w, string_type)
    writer_gc::emit_gc_struct_new(w, type_idx)
    writer_gc::emit_gc_ref_cast(w, open_type)
}
