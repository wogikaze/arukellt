use wasm::ctx_record

// Hint entries are stored flat as (func_idx, code_section_offset) pairs so
// the custom section can map each hint back to the function body position.
fn SelfEmitCtx_push_gc_hint_offset(ctx: SelfEmitCtx, func_idx: i32, offset: i32) {
    push(ctx.gc_hint_offsets, func_idx)
    push(ctx.gc_hint_offsets, offset)
}

fn SelfEmitCtx_gc_hint_offsets(ctx: SelfEmitCtx) -> Vec<i32> {
    ctx.gc_hint_offsets
}

fn SelfEmitCtx_gc_hint_count(ctx: SelfEmitCtx) -> i32 {
    len(ctx.gc_hint_offsets) / 2
}
