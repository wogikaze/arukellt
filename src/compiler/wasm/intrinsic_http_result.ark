use wasm::constants
use wasm::ctx_gc_type
use wasm::ctx_record
use wasm::ctx_scratch
use wasm::intrinsics::helpers_control
use wasm::intrinsics::helpers_core
use wasm::intrinsics::helpers_io_const
use wasm::intrinsics::helpers_io_layout
use wasm::intrinsics::helpers_memory
use wasm::intrinsics::helpers_numeric_i32
use wasm::opcodes
use wasm::writer_core
use wasm::writer_gc

fn emit_http_alloc_resp_buffer(w: WasmWriter, resp_slot: i32) {
    helpers_io_layout::emit_scratch_addr(w, resp_slot)
    helpers_core::emit_heap_get(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_store_default(w)
    helpers_core::emit_heap_get(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_heap_set(w)
}

fn emit_http_store_abs_len(w: WasmWriter, ret_slot: i32, abs_slot: i32) {
    helpers_io_layout::emit_scratch_addr(w, abs_slot)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_sub(w)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    writer_core::emit_byte(w, opcodes::OP_SELECT())
    helpers_memory::emit_i32_store_default(w)
}

fn emit_http_write_len_prefix(w: WasmWriter, resp_slot: i32, abs_slot: i32) {
    helpers_io_layout::emit_scratch_addr(w, resp_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_sub(w)
    helpers_io_layout::emit_scratch_addr(w, abs_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_memory::emit_i32_store_default(w)
}

fn emit_http_bump_heap_by_abs_len(w: WasmWriter, abs_slot: i32) {
    helpers_core::emit_heap_get(w)
    helpers_io_layout::emit_scratch_addr(w, abs_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_heap_set(w)
}

fn emit_http_build_string_result_enum(w: WasmWriter, ret_slot: i32, resp_slot: i32, enum_slot: i32) {
    helpers_io_layout::emit_scratch_addr(w, enum_slot)
    helpers_core::emit_heap_get(w)
    helpers_memory::emit_i32_store_default(w)
    helpers_io_layout::emit_scratch_addr(w, enum_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    writer_core::emit_byte(w, opcodes::OP_SELECT())
    helpers_memory::emit_i32_store_default(w)
    helpers_io_layout::emit_scratch_addr(w, enum_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_io_layout::emit_scratch_addr(w, resp_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_memory::emit_i32_store_default(w)
    helpers_core::emit_heap_get(w)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_heap_set(w)
    helpers_io_layout::emit_scratch_addr(w, enum_slot)
    helpers_memory::emit_i32_load_default(w)
}

fn emit_http_finalize_string_result(w: WasmWriter, resp_slot: i32, ret_slot: i32, abs_slot: i32, enum_slot: i32) {
    emit_http_store_abs_len(w, ret_slot, abs_slot)
    emit_http_write_len_prefix(w, resp_slot, abs_slot)
    emit_http_bump_heap_by_abs_len(w, abs_slot)
    emit_http_build_string_result_enum(w, ret_slot, resp_slot, enum_slot)
}

fn emit_http_finalize_unit_result(w: WasmWriter, resp_slot: i32, ret_slot: i32, abs_slot: i32, enum_slot: i32) {
    emit_http_store_abs_len(w, ret_slot, abs_slot)
    emit_http_write_err_len_prefix(w, resp_slot, abs_slot, ret_slot)
    emit_http_bump_heap_for_err(w, abs_slot, ret_slot)
    emit_http_build_unit_result_enum(w, ret_slot, resp_slot, enum_slot)
}

fn emit_http_write_err_len_prefix(w: WasmWriter, resp_slot: i32, abs_slot: i32, ret_slot: i32) {
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    emit_http_write_len_prefix(w, resp_slot, abs_slot)
    helpers_control::emit_end(w)
}

fn emit_http_bump_heap_for_err(w: WasmWriter, abs_slot: i32, ret_slot: i32) {
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    emit_http_bump_heap_by_abs_len(w, abs_slot)
    helpers_control::emit_end(w)
}

fn emit_http_build_unit_result_enum(w: WasmWriter, ret_slot: i32, resp_slot: i32, enum_slot: i32) {
    helpers_io_layout::emit_scratch_addr(w, enum_slot)
    helpers_core::emit_heap_get(w)
    helpers_memory::emit_i32_store_default(w)
    helpers_io_layout::emit_scratch_addr(w, enum_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    writer_core::emit_byte(w, opcodes::OP_SELECT())
    helpers_memory::emit_i32_store_default(w)
    helpers_io_layout::emit_scratch_addr(w, enum_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_i32(w)
    helpers_io_layout::emit_scratch_addr(w, resp_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_control::emit_else(w)
    helpers_core::emit_heap_get(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_memory::emit_i32_store_default(w)
    helpers_control::emit_end(w)
    helpers_memory::emit_i32_store_default(w)
    helpers_core::emit_heap_get(w)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_heap_set(w)
    helpers_io_layout::emit_scratch_addr(w, enum_slot)
    helpers_memory::emit_i32_load_default(w)
}

// Prefer `_f1_ref0` (String payload) over name-only first match (`_f1_i32`).
fn find_result_string_variant_type(ctx: SelfEmitCtx, variant_name: String) -> i32 {
    let names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    let type_map = ctx_record::SelfEmitCtx_gc_enum_variant_type_map(ctx)
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let count = len(names)
    let mut fallback = 0 - 1
    let mut i = 0
    while i < count {
        if eq(clone(get_unchecked(names, i)), clone(variant_name)) {
            if i < len(type_map) {
                let variant_type = get_unchecked(type_map, i)
                if variant_type != open_type {
                    if i < len(sigs) && ends_with(clone(get_unchecked(sigs, i)), "_f1_ref0") {
                        return variant_type
                    }
                    if fallback < 0 {
                        fallback = variant_type
                    }
                }
            }
        }
        i = i + 1
    }
    if fallback >= 0 {
        return fallback
    }
    ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(variant_name))
}

// Copy linear memory [resp_ptr, resp_ptr + abs_len) into a GC String.
fn emit_http_gc_string_from_linear(
    w: WasmWriter,
    s_str: i32,
    s_i: i32,
    s_len: i32,
    resp_ptr_slot: i32,
    abs_slot: i32,
    string_type: i32
) {
    helpers_io_layout::emit_scratch_addr(w, abs_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_len)
    helpers_core::emit_local_get(w, s_len)
    writer_gc::emit_gc_array_new_from_widened(w, string_type)
    writer_gc::emit_gc_ref_cast(w, string_type)
    helpers_core::emit_local_set(w, s_str)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_core::emit_local_set(w, s_i)
    helpers_control::emit_block_loop_header(w)
    helpers_core::emit_local_get(w, s_i)
    helpers_core::emit_local_get(w, s_len)
    helpers_numeric_i32::emit_i32_ge_s(w)
    helpers_control::emit_br_if(w, 1)
    helpers_core::emit_local_get(w, s_str)
    helpers_core::emit_local_get(w, s_i)
    helpers_numeric_i32::emit_narrow_i64_operand(w)
    helpers_io_layout::emit_scratch_addr(w, resp_ptr_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_get(w, s_i)
    helpers_numeric_i32::emit_i32_add(w)
    writer_core::emit_byte(w, opcodes::OP_I32_LOAD8_U())
    writer_core::emit_byte(w, 0)
    writer_core::emit_byte(w, 0)
    if writer_core::writer_memory64(w) {
        writer_core::emit_byte(w, opcodes::OP_I64_EXTEND_I32_U())
    }
    writer_gc::emit_gc_array_set_i32(w, string_type)
    helpers_core::emit_local_get(w, s_i)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, s_i)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
}

fn emit_http_gc_result_string_variant(w: WasmWriter, ctx: SelfEmitCtx, s_str: i32, tag: i32) {
    let variant_name = if tag == 0 { "Result::Ok" } else { "Result::Err" }
    let variant_type = find_result_string_variant_type(ctx, clone(variant_name))
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let type_idx = if variant_type >= 0 { variant_type } else { open_type }
    // GC enum tag fields are true i32; Memory64 emit_i32_const widens to i64 (#730).
    helpers_io_const::emit_i32_const(w, tag)
    helpers_core::emit_local_get(w, s_str)
    writer_gc::emit_gc_struct_new(w, type_idx)
    writer_gc::emit_gc_ref_cast(w, open_type)
}

// Result<String, String> from host ret (>=0 Ok / <0 Err) + linear resp bytes.
fn emit_http_finalize_string_result_gc(w: WasmWriter, ctx: SelfEmitCtx, resp_ptr_slot: i32, ret_slot: i32, abs_slot: i32) {
    let s_str = ctx_scratch::SelfEmitCtx_scratch_gc_local(ctx, 0)
    let s_result = ctx_scratch::SelfEmitCtx_scratch_gc_enum_local(ctx, 0)
    let s_i = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    let s_len = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    let string_type = ctx_record::SelfEmitCtx_gc_type_base(ctx)
    emit_http_store_abs_len(w, ret_slot, abs_slot)
    emit_http_bump_heap_by_abs_len(w, abs_slot)
    emit_http_gc_string_from_linear(w, s_str, s_i, s_len, resp_ptr_slot, abs_slot, string_type)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    emit_http_gc_result_string_variant(w, ctx, s_str, 1)
    helpers_core::emit_local_set(w, s_result)
    helpers_control::emit_else(w)
    emit_http_gc_result_string_variant(w, ctx, s_str, 0)
    helpers_core::emit_local_set(w, s_result)
    helpers_control::emit_end(w)
    helpers_core::emit_local_get(w, s_result)
}

fn emit_http_unit_ok_gc(w: WasmWriter, ctx: SelfEmitCtx) {
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let ok_type = ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, "Result::Ok")
    let type_idx = if ok_type >= 0 { ok_type } else { open_type }
    // Result<(), String> Ok: tag=0 with i32 payload 0 (builtin _f1_i32 Ok).
    helpers_io_const::emit_i32_const(w, 0)
    helpers_io_const::emit_i32_const(w, 0)
    writer_gc::emit_gc_struct_new(w, type_idx)
    writer_gc::emit_gc_ref_cast(w, open_type)
}

// Result<(), String> from host ret (>=0 Ok / <0 Err(String from resp)).
fn emit_http_finalize_unit_result_gc(w: WasmWriter, ctx: SelfEmitCtx, resp_ptr_slot: i32, ret_slot: i32, abs_slot: i32) {
    let s_str = ctx_scratch::SelfEmitCtx_scratch_gc_local(ctx, 0)
    let s_result = ctx_scratch::SelfEmitCtx_scratch_gc_enum_local(ctx, 0)
    let s_i = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    let s_len = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    let string_type = ctx_record::SelfEmitCtx_gc_type_base(ctx)
    emit_http_store_abs_len(w, ret_slot, abs_slot)
    helpers_io_layout::emit_scratch_addr(w, ret_slot)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    emit_http_bump_heap_by_abs_len(w, abs_slot)
    emit_http_gc_string_from_linear(w, s_str, s_i, s_len, resp_ptr_slot, abs_slot, string_type)
    emit_http_gc_result_string_variant(w, ctx, s_str, 1)
    helpers_core::emit_local_set(w, s_result)
    helpers_control::emit_else(w)
    emit_http_unit_ok_gc(w, ctx)
    helpers_core::emit_local_set(w, s_result)
    helpers_control::emit_end(w)
    helpers_core::emit_local_get(w, s_result)
}
