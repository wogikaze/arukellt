// Extracted from call_fallback.ark to reduce import fan-out.
// Opcode constants inlined to avoid extra import (values from mir::opcodes).

use std::text
use mir::function_param_view
use corehir::function_id
use corehir::signature_entry
use corehir::signature_registry
use mir::inst_record
use wasm::opcodes
use wasm::ctx_record
use wasm::ctx_call_reloc
use wasm::ctx_gc_type
use wasm::emit_target
use wasm::inst_ctx
use wasm::inst_store
use wasm::writer_core
use wasm::writer_gc
use wasm::function_indices
use mir::inst_accessors_operands
use wasm::registry_return_audit
use wasm::registry_return_resolve
use wasm::inst_locals
use wasm::call_indirect
use wasm::ctx_fn_type_refs
fn try_emit_resolved_fallback_call(
    mut w: WasmWriter,
    callee: String,
    inst: MirInst,
    mut ctx: SelfEmitCtx,
    prev_op: i32,
    prev_arg0: i32,
    prev_arg1: i32,
    next_op: i32,
    next_arg0: i32,
    next_arg1: i32,
    next2_op: i32,
    wit_import_count: i32
) -> bool {
    let registry = ctx_record::SelfEmitCtx_signature_registry(ctx)
    let fid_raw = inst_record::mir_inst_func_id_raw(inst)
    let mut resolved_name = callee
    let mut has_signature = false
    if fid_raw >= 0 {
        let signature = signature_registry::signature_registry_lookup_by_id(
            registry,
            function_id::FunctionId_new(fid_raw)
        )
        resolved_name = signature_entry::signature_entry_base_name(signature)
        has_signature = true
    }
    let fn_idx = inst_ctx::resolve_fn_index_for_call(
        ctx,
        resolved_name.clone(),
        fid_raw
    )
    // Bodies are emitted after every MIR function exists, so a callee with no
    // function index here is an intrinsic (e.g. `Vec::new`), not a
    // not-yet-lowered function. It must reach the intrinsic fallback; a blind
    // `call 0` + FuncId reloc would never be patched and yields an invalid body.
    if fn_idx < 0 {
        return false
    }
    let called = ctx_record::SelfEmitCtx_function_at(ctx, fn_idx)
    let mut base_local = 0 - 1
    if prev_op == 62 {  // MIR_STRUCT_SET
        base_local = prev_arg0
    } else if prev_op == 88 {  // MIR_GC_STRUCT_SET
        base_local = prev_arg1
    }
    if base_local >= 0 {
        writer_core::emit_local_get(w, base_local)
        // Handle-based wasm32 must not emit ref.cast; type indices there are
        // often func types, which validate as "expected funcref, found i32".
        if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) &&
        function_param_view::MirFunction_param_count(called) > 0 {
            let param_type_name = function_param_view::MirFunction_param_type_name(called, 0)
            let gc_type_idx = resolve_call_param_gc_cast_type(ctx, param_type_name)
            if gc_type_idx >= 0 {
                writer_gc::emit_gc_ref_cast(w, gc_type_idx)
            }
        }
    }
    writer_core::emit_byte(w, opcodes::OP_CALL())
    let slot = writer_core::writer_size(w)
    writer_core::emit_leb128_u_fixed(w, 0)
    if fid_raw >= 0 {
        ctx_call_reloc::SelfEmitCtx_push_call_reloc(ctx, slot, fid_raw)
    } else {
        if ctx.in_loop_emitted {
            // In-loop emit runs before reachability compaction: fn_idx is a
            // pre-prune index, so the defined_function_index value would go
            // stale. Defer by name — the apply-time name index is post-prune
            // and yields the same target today's immediate patch wrote.
            ctx_call_reloc::SelfEmitCtx_push_call_reloc_name(ctx, slot, resolved_name.clone())
        } else {
            writer_core::patch_leb128_u_fixed(
                w,
                slot,
                function_indices::defined_function_index(
                    fn_idx,
                    ctx_record::SelfEmitCtx_target(ctx),
                    ctx_record::SelfEmitCtx_wasi_version(ctx),
                    wit_import_count
                )
            )
        }
    }
    // Symbolic sig parse: in-loop emit runs before the canon table seals,
    // so the callee's fn-type index is unavailable. fn_idx >= 0 here (the
    // forward-call path returns false earlier), so the callee MirFunction
    // exists and its sig text gives the same result ref type.
    writer_core::writer_note_ref_top(
        w,
        ctx_fn_type_refs::SelfEmitCtx_fn_sig_result_ref_type(ctx, called)
    )
    let fn_ret_vt = registry_return_resolve::resolve_call_fn_ret_vt(ctx, inst, called)
    if has_signature {
        let signature = signature_registry::signature_registry_lookup_by_id(
            registry,
            function_id::FunctionId_new(fid_raw)
        )
        registry_return_audit::registry_audit_observe_call(
            ctx,
            inst,
            signature_entry::signature_entry_base_name(signature),
            fn_ret_vt
        )
    }
    if !registry_return_audit::registry_switch_call_has_void_return(ctx, inst, fn_ret_vt) {
        if inst_accessors_operands::MirInst_dest(inst) >= 0 && should_force_call_dest_store(next_op, next_arg0) {
            let dest = inst_accessors_operands::MirInst_dest(inst)
            inst_locals::emit_gc_ref_cast_to_dest(w, ctx, dest)
            writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
            writer_core::emit_leb128_u(w, dest)
        } else {
            inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
        }
    }
    true
}

// Resolve GC cast target for a call param after GC_STRUCT_SET left the
// receiver in a local. Prefer enum-open for Option/Result/named enums;
// never fall back to byte-size struct types (that cast Option → type10).
fn resolve_call_param_gc_cast_type(ctx: SelfEmitCtx, param_type_name: String) -> i32 {
    if param_type_name.len() == 0 {
        return 0 - 1
    }
    if call_param_type_is_enum_like(ctx, param_type_name.clone()) {
        return ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    }
    let named = ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, param_type_name.clone())
    if named >= 0 {
        return named
    }
    0 - 1
}

fn call_param_type_is_enum_like(ctx: SelfEmitCtx, param_type_name: String) -> bool {
    if param_type_name.clone().starts_with("enum:") {
        return true
    }
    if param_type_name.clone().starts_with("Option") || param_type_name.clone().starts_with("option") {
        return true
    }
    if param_type_name.clone().starts_with("Result") || param_type_name.clone().starts_with("result") {
        return true
    }
    let bare = if param_type_name.clone().starts_with("enum:") {
        param_type_name.clone().slice(5, param_type_name.len())
    } else {
        param_type_name.clone()
    }
    let prefix = bare.clone().concat("::")
    let ev_names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let mut ei = 0
    while ei < ev_names.len() {
        if get_unchecked(ev_names, ei).clone().starts_with(prefix.clone()) {
            return true
        }
        ei = ei + 1
    }
    false
}

fn should_force_call_dest_store(next_op: i32, next_arg0: i32) -> bool {
    // An explicit local-to-local copy is often the staging of a later call
    // argument.  The call result may still be the left operand of a following
    // comparison, so let inst_store_policy choose SET versus TEE instead of
    // consuming the stack value unconditionally.
    if next_op == 40 && next_arg0 >= 0 {  // MIR_CALL
        return true
    }
    false
}
