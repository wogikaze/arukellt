// Call-result GC typing via SignatureRegistry return TypeId / MirValueType.
// Backend layout is never selected from a type name.

use corehir::function_id
use corehir::mir_value_type
use corehir::signature_entry
use corehir::signature_registry
use corehir::type_id
use corehir::type_table
use mir::function_return_view
use mir::post_pass_callee_lookup
use mir::value_types
use wasm::ctx_record
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::ctx_gc_layout_lookup
use wasm::code_ref_locals_infer_type_id
use wasm::code_ref_locals_types
use wasm::inst_ctx

// Fallback: infer GC type from the called function's return type signature.
fn infer_call_result_gc_type_from_fn(ctx: SelfEmitCtx, callee: String) -> Option<i32> {
    let fn_idx = inst_ctx::resolve_fn_index(ctx, clone(callee))
    if fn_idx < 0 {
        return Option::None
    }
    let called = ctx_record::SelfEmitCtx_function_at(ctx, fn_idx)
    let ret_type = function_return_view::MirFunction_return_type(called)
    let ret_name = function_return_view::MirFunction_return_type_name(called)
    // Prefer a registered gc_struct when the return type names one. Typed-spine
    // / layout lookup can still report enum-open for user structs
    // (WitParsedInterface), which then types call-result locals incorrectly.
    let named_struct = resolve_named_struct_gc_type(ctx, clone(ret_name))
    match named_struct {
        Option::Some(_opt_v) => {
            return named_struct
        }
        Option::None => {}
    }
    // Specialized pair/From functions often keep a leftover String return
    // name from a type parameter. Recover the tuple/enum from locals or the
    // mono suffix before TypeTable resolves that leftover to array 11.
    let from_callee = code_ref_locals_infer_type_id::infer_gc_type_from_callee_function(ctx, called)
    match from_callee {
        Option::Some(_opt_v) => {
            return from_callee
        }
        Option::None => {}
    }
    if eq(clone(ret_name), "String") || eq(clone(ret_name), "string") {
        return Option::None
    }
    let from_table = code_ref_locals_infer_type_id::infer_gc_type_from_type_table_name(
        ctx,
        clone(ret_name)
    )
    match from_table {
        Option::Some(_opt_v) => {
            return from_table
        }
        Option::None => {}
    }
    let from_struct = infer_gc_type_from_return_struct(ctx, ret_type, ret_name)
    match from_struct {
        Option::Some(_opt_v) => {
            return from_struct
        }
        Option::None => {}
    }
    // String / vec:Elem are fixed GC slots, not gc_struct_names entries.
    let from_name = resolve_gc_type_from_return_type_name(ctx, ret_name)
    match from_name {
        Option::Some(_opt_v) => {
            return from_name
        }
        Option::None => {}
    }
    code_ref_locals_infer_type_id::infer_gc_type_from_callee_function(ctx, called)
}

// Resolve call-result GC type from SignatureRegistry (host + builtin entries).
fn infer_call_result_gc_type_from_registry(ctx: SelfEmitCtx, callee: String) -> Option<i32> {
    let registry = ctx_record::SelfEmitCtx_signature_registry(ctx)
    let mut fid = signature_registry::signature_registry_lookup_by_mangled(registry, clone(callee))
    if !function_id::function_id_is_valid(fid) {
        let short_name = inst_ctx::strip_module_prefix(clone(callee))
        if !eq(clone(short_name), clone(callee)) {
            fid = signature_registry::signature_registry_lookup_by_mangled(registry, short_name)
        }
    }
    if !function_id::function_id_is_valid(fid) {
        return Option::None
    }
    let entry = signature_registry::signature_registry_lookup_by_id(registry, fid)
    if signature_entry::signature_entry_return_count(entry) <= 0 {
        return Option::None
    }
    let mvt = signature_entry::signature_entry_return_at(entry, 0)
    let from_tid = code_ref_locals_infer_type_id::infer_gc_type_from_type_id(
        ctx,
        mir_value_type::mir_value_type_type_id(mvt)
    )
    match from_tid {
        Option::Some(_opt_v) => {
            return from_tid
        }
        Option::None => {}
    }
    let by_mvt = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_mir_value_type(ctx, mvt)
    if by_mvt >= 0 {
        return Option::Some(by_mvt)
    }
    let tid = mir_value_type::mir_value_type_type_id(mvt)
    if !type_id::type_id_is_valid(tid) {
        return Option::None
    }
    let table = ctx_record::SelfEmitCtx_type_table(ctx)
    let ret_name = type_table::type_entry_name(type_table::TypeTable_lookup(table, tid))
    resolve_gc_type_from_return_type_name(ctx, ret_name)
}

fn resolve_gc_type_from_return_type_name(ctx: SelfEmitCtx, ret_name: String) -> Option<i32> {
    if len(ret_name) == 0 {
        return Option::None
    }
    if code_ref_locals_types::is_option_type_name(clone(ret_name)) ||
    starts_with(clone(ret_name), "enum:") ||
    starts_with(clone(ret_name), "Result_") ||
    starts_with(clone(ret_name), "Result:") ||
    starts_with(clone(ret_name), "Result<") ||
    starts_with(clone(ret_name), "result:") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if eq(clone(ret_name), "String") || eq(clone(ret_name), "string") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_string_type(ctx))
    }
    if eq(clone(ret_name), "vec:String") || eq(clone(ret_name), "vec:string") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_string_type(ctx))
    }
    if eq(clone(ret_name), "vec:i64") || eq(clone(ret_name), "vec:I64") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx))
    }
    if eq(clone(ret_name), "vec:f64") || eq(clone(ret_name), "vec:F64") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx))
    }
    if eq(clone(ret_name), "vec:v128") || eq(clone(ret_name), "vec:V128") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_v128_type(ctx))
    }
    if starts_with(clone(ret_name), "vec:") {
        let elem = substring(clone(ret_name), 4, len(ret_name))
        if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem)) {
            return Option::Some(ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx))
        }
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_type(ctx))
    }
    if starts_with(clone(ret_name), "Vec<") || starts_with(clone(ret_name), "Vec_") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_type_for_ctx(ctx))
    }
    Option::None
}

// Mono Vec::new__Elem / Vec__new__Elem names are not all
// pre-registered; derive vec:Elem and resolve through layout helpers (#842 / #845).
fn infer_vec_new_return_gc_type(ctx: SelfEmitCtx, callee: String) -> Option<i32> {
    if starts_with(clone(callee), "Vec::new__") ||
    starts_with(clone(callee), "Vec::with_capacity__") ||
    starts_with(clone(callee), "Vec__new__") ||
    starts_with(clone(callee), "Vec__with_capacity__") {
        let last_sep = last_index_of_double_underscore(clone(callee))
        if last_sep < 0 {
            return Option::None
        }
        let elem = substring(clone(callee), last_sep + 2, len(callee))
        if len(elem) == 0 {
            return Option::Some(ctx_gc_type::SelfEmitCtx_vec_type(ctx))
        }
        return resolve_gc_type_from_return_type_name(ctx, concat("vec:", elem))
    }
    if eq(clone(callee), "Vec::new") ||
    eq(clone(callee), "Vec::with_capacity") ||
    eq(clone(callee), "Vec__new") ||
    eq(clone(callee), "Vec__with_capacity") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_type(ctx))
    }
    Option::None
}

fn last_index_of_double_underscore(s: String) -> i32 {
    let n = len(s)
    let mut i = n - 2
    while i >= 0 {
        if char_at(s, i) == 95 && char_at(s, i + 1) == 95 {
            return i
        }
        i = i - 1
    }
    0 - 1
}

fn strip_module_double_colon(type_name: String) -> String {
    let type_name_len = len(type_name)
    let mut index = type_name_len - 2
    while index >= 0 {
        if char_at(type_name, index) == 58 && char_at(type_name, index + 1) == 58 {
            return substring(type_name, index + 2, type_name_len)
        }
        index = index - 1
    }
    type_name
}

fn resolve_named_struct_gc_type(ctx: SelfEmitCtx, ret_name: String) -> Option<i32> {
    if len(ret_name) == 0 {
        return Option::None
    }
    let bare_name = strip_module_double_colon(ret_name)
    if ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(bare_name)) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, bare_name))
    }
    if starts_with(clone(ret_name), "struct:") {
        let struct_name = parse_struct_name_from_ret_name(clone(ret_name))
        if len(struct_name) > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(struct_name)) {
            return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(struct_name)))
        }
        return Option::None
    }
    if ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(ret_name)) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(ret_name)))
    }
    let name_len = len(ret_name)
    let mut colon_pos = 0 - 1
    let mut ci = name_len - 1
    while ci >= 0 {
        if char_at(ret_name, ci) == 58 {
            colon_pos = ci
            ci = 0 - 1
        }
        ci = ci - 1
    }
    if colon_pos >= 0 {
        let bare = substring(ret_name, colon_pos + 1, name_len)
        if ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(bare)) {
            return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, bare))
        }
    }
    let bare = strip_module_double_colon(ret_name)
    if len(bare) > 0 {
        let names = ctx_record::SelfEmitCtx_gc_struct_names(ctx)
        let mut name_index = 0
        while name_index < len(names) {
            let candidate = get_unchecked(names, name_index)
            if eq(clone(bare), strip_module_double_colon(clone(candidate))) {
                return Option::Some(
                    ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(candidate))
                )
            }
            name_index = name_index + 1
        }
    }
    Option::None
}

// Struct/enum-oriented tail of infer_call_result_gc_type_from_fn.
fn infer_gc_type_from_return_struct(ctx: SelfEmitCtx, ret_type: i32, ret_name: String) -> Option<i32> {
    if starts_with(clone(ret_name), "struct:") {
        let struct_name = parse_struct_name_from_ret_name(clone(ret_name))
        if len(struct_name) > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(struct_name)) {
            return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(struct_name)))
        }
        // Mixed tuples share a byte size with i32 pairs. Size-class 14 is not
        // the TypeSectionPlan tuple (e.g. (i32, String)).
        if starts_with(clone(struct_name), "tuple:") {
            return Option::None
        }
        let byte_size = parse_struct_byte_size_from_ret_name(clone(ret_name))
        if byte_size > 0 {
            return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type(ctx, byte_size))
        }
    }
    if ret_type == value_types::mir_value_types__VT_GC_REF() {
        if code_ref_locals_types::is_option_type_name(clone(ret_name)) ||
        starts_with(clone(ret_name), "enum:") ||
        starts_with(clone(ret_name), "Result_") ||
        starts_with(clone(ret_name), "Result:") ||
        starts_with(clone(ret_name), "Result<") ||
        starts_with(clone(ret_name), "result:") {
            return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
        }
        let named = resolve_named_struct_gc_type(ctx, clone(ret_name))
        match named {
            Option::Some(_opt_v) => {
                return named
            }
            Option::None => {}
        }
        // Unknown GC ref without a registered struct name: do not guess the
        // 1-field size-class (collides with enum-open at base+2).
        return Option::None
    }
    resolve_named_struct_gc_type(ctx, ret_name)
}

fn parse_struct_name_from_ret_name(type_name: String) -> String {
    let n = len(type_name)
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if char_at(type_name, i) == 58 {
            if first_colon < 0 {
                first_colon = i
            }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon < 0 || first_colon == last_colon {
        return String_new()
    }
    substring(type_name, first_colon + 1, last_colon)
}

fn parse_struct_byte_size_from_ret_name(type_name: String) -> i32 {
    let n = len(type_name)
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if char_at(type_name, i) == 58 {
            last_colon = i
        }
        i = i + 1
    }
    if last_colon < 0 {
        return 0
    }
    let mut byte_size = 0
    let mut j = last_colon + 1
    while j < n {
        let d = char_at(type_name, j)
        if d >= 48 && d <= 57 {
            byte_size = byte_size * 10 + (d - 48)
        } else {
            j = n
        }
        j = j + 1
    }
    byte_size
}

fn infer_call_result_gc_type(ctx: SelfEmitCtx, callee: String) -> Option<i32> {
    // Defined internal functions are authoritative for their return type.
    // SignatureRegistry remains the fallback for host/builtin entries that
    // do not have a resolvable MirFunction (#725 / #842).
    let from_fn = infer_call_result_gc_type_from_fn(ctx, clone(callee))
    match from_fn {
        Option::Some(_opt_v) => {
            return from_fn
        }
        Option::None => {}
    }
    let from_mono = code_ref_locals_infer_type_id::infer_call_result_gc_type_from_mono(
        ctx,
        clone(callee)
    )
    match from_mono {
        Option::Some(_opt_v) => {
            return from_mono
        }
        Option::None => {}
    }
    let from_reg = infer_call_result_gc_type_from_registry(ctx, clone(callee))
    match from_reg {
        Option::Some(_opt_v) => {
            return from_reg
        }
        Option::None => {}
    }
    // String / split / chars / … → type_name then layout (post_pass table).
    let intrinsic_tn = post_pass_callee_lookup::lookup_intrinsic_return_type_name(clone(callee))
    if len(intrinsic_tn) > 0 {
        let from_tn = resolve_gc_type_from_return_type_name(ctx, intrinsic_tn)
        match from_tn {
            Option::Some(_opt_v) => {
                return from_tn
            }
            Option::None => {}
        }
    }
    let from_name = code_ref_locals_infer_type_id::infer_gc_type_from_callee_name(ctx, clone(callee))
    match from_name {
        Option::Some(_opt_v) => {
            return from_name
        }
        Option::None => {}
    }
    infer_vec_new_return_gc_type(ctx, callee)
}
