// Call-result GC typing. A call that resolves to a MIR body takes its result
// from that function's declared return; the SignatureRegistry return is used
// only when the function has no body, and the intrinsic/builtin table only
// when the func_id is invalid. The emitter never selects a MIR-body callee's
// layout from its name (INV-4).

use std::text
use corehir::function_id
use corehir::mir_value_type
use corehir::signature_entry
use corehir::signature_registry
use corehir::type_id
use corehir::type_table
use mir::function_return_view
use mir::post_pass_callee_lookup
use mir::value_types
use wasm::ctx_record
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::ctx_gc_layout_lookup
use wasm::sections_types_gc_phase7
use wasm::code_ref_locals_types
use wasm::inst_ctx

// A call with a MIR body takes its result from the callee's declared return.
// The emitted wasm signature is built from the same MirFunction, so a dest
// declared here can never disagree with the call ABI (INV-5).
fn infer_call_result_gc_type_from_mir_function(ctx: SelfEmitCtx, fn_idx: i32) -> Option<i32> {
    if fn_idx < 0 || fn_idx >= ctx_record::SelfEmitCtx_function_count(ctx) {
        return Option::None
    }
    let called = ctx_record::SelfEmitCtx_function_at(ctx, fn_idx)
    let ret_type = function_return_view::MirFunction_return_type(called)
    let ret_name = function_return_view::MirFunction_return_type_name(called)
    // Same order as build_return_type_value_sig: collection / typed-spine
    // first. A bare element name (Diagnostic) must not beat Vec<Diagnostic>.
    let from_name = resolve_gc_type_from_return_type_name(ctx, ret_name.clone())
    match from_name {
        Option::Some(_opt_v) => {
            return from_name
        }
        Option::None => {}
    }
    let named_struct = resolve_named_struct_gc_type(ctx, ret_name.clone())
    match named_struct {
        Option::Some(_opt_v) => {
            return named_struct
        }
        Option::None => {}
    }
    infer_gc_type_from_return_struct(ctx, ret_type, ret_name)
}

// Registry-by-name fallback for a call whose func_id is invalid (host and
// builtin entries). Never used for a call with a valid func_id (INV-4).
fn infer_call_result_gc_type_from_registry(ctx: SelfEmitCtx, callee: String) -> Option<i32> {
    let registry = ctx_record::SelfEmitCtx_signature_registry(ctx)
    let mut fid = signature_registry::signature_registry_lookup_by_mangled(registry, callee.clone())
    if !function_id::function_id_is_valid(fid) {
        let short_name = inst_ctx::strip_module_prefix(callee.clone())
        if !short_name.clone().eq(callee.clone()) {
            fid = signature_registry::signature_registry_lookup_by_mangled(registry, short_name)
        }
    }
    if !function_id::function_id_is_valid(fid) {
        return Option::None
    }
    let entry = signature_registry::signature_registry_lookup_by_id(registry, fid)
    if signature_entry::signature_entry_return_count(entry) <= 0 {
        return Option::None
    }
    let mvt = signature_entry::signature_entry_return_at(entry, 0)
    // Storage binding, not VALUE_REPR_GC_REF-only. Vec/String can stay
    // LINEAR_PTR in the MVT while wasm32-gc storage is a GC header.
    let by_mvt = ctx_gc_layout_lookup::SelfEmitCtx_wasm_storage_ref_type_idx_for_mir_value_type(ctx, mvt)
    if by_mvt >= 0 {
        return Option::Some(by_mvt)
    }
    let tid = mir_value_type::mir_value_type_type_id(mvt)
    if !type_id::type_id_is_valid(tid) {
        return Option::None
    }
    let table = ctx_record::SelfEmitCtx_type_table(ctx)
    let ret_name = type_table::type_entry_name(type_table::TypeTable_lookup(table, tid))
    resolve_gc_type_from_return_type_name(ctx, ret_name)
}

fn infer_call_result_gc_type_from_registry_id(ctx: SelfEmitCtx, fid_raw: i32) -> Option<i32> {
    if fid_raw < 0 {
        return Option::None
    }
    let registry = ctx_record::SelfEmitCtx_signature_registry(ctx)
    let fid = function_id::FunctionId_new(fid_raw)
    if !function_id::function_id_is_valid(fid) {
        return Option::None
    }
    let entry = signature_registry::signature_registry_lookup_by_id(registry, fid)
    if signature_entry::signature_entry_return_count(entry) <= 0 {
        return Option::None
    }
    let mvt = signature_entry::signature_entry_return_at(entry, 0)
    let by_mvt = ctx_gc_layout_lookup::SelfEmitCtx_wasm_storage_ref_type_idx_for_mir_value_type(ctx, mvt)
    if by_mvt >= 0 {
        return Option::Some(by_mvt)
    }
    let tid = mir_value_type::mir_value_type_type_id(mvt)
    if !type_id::type_id_is_valid(tid) {
        return Option::None
    }
    let table = ctx_record::SelfEmitCtx_type_table(ctx)
    let ret_name = type_table::type_entry_name(type_table::TypeTable_lookup(table, tid))
    resolve_gc_type_from_return_type_name(ctx, ret_name)
}

// func_id is invalid for host intrinsics, builtin shims, and Vec constructors.
// Those are the only calls whose result layout may still be selected by name
// (INV-4); the registry-by-name lookup below is part of that allowlist.
fn infer_intrinsic_call_result_gc_type_by_name(ctx: SelfEmitCtx, callee: String) -> Option<i32> {
    // Vec::new__T is a header constructor. A registry type that names only T
    // (JsonField) must not type the dest as that struct.
    let from_vec_new = infer_vec_new_return_gc_type(ctx, callee.clone())
    match from_vec_new {
        Option::Some(_opt_v) => {
            return from_vec_new
        }
        Option::None => {}
    }
    let from_registry = infer_call_result_gc_type_from_registry(ctx, callee.clone())
    match from_registry {
        Option::Some(_opt_v) => {
            return from_registry
        }
        Option::None => {}
    }
    let intrinsic_tn = post_pass_callee_lookup::lookup_intrinsic_return_type_name(callee)
    if intrinsic_tn.len() > 0 {
        return resolve_gc_type_from_return_type_name(ctx, intrinsic_tn)
    }
    Option::None
}

fn resolve_gc_type_from_return_type_name(ctx: SelfEmitCtx, ret_name: String) -> Option<i32> {
    if ret_name.len() == 0 {
        return Option::None
    }
    // Bare Option/Result is how a generic container return reaches MIR when
    // its payload spelling is not carried in the return name. The function
    // signature maps the same name to enum-open (gc_enum_return_type_sig), so
    // the dest must as well (INV-5).
    if code_ref_locals_types::is_option_type_name(ret_name.clone()) ||
    ret_name.clone().eq("Option") ||
    ret_name.clone().eq("Result") ||
    ret_name.clone().starts_with("Result_") ||
    ret_name.clone().starts_with("Result:") ||
    ret_name.clone().starts_with("Result<") ||
    ret_name.clone().starts_with("result:") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if ret_name.clone().starts_with("enum:") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if ret_name.clone().eq("String") || ret_name.clone().eq("string") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_string_type(ctx))
    }
    if ret_name.clone().eq("vec:String") || ret_name.clone().eq("vec:string") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_string_type(ctx))
    }
    if ret_name.clone().eq("vec:i64") || ret_name.clone().eq("vec:I64") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx))
    }
    if ret_name.clone().eq("vec:f64") || ret_name.clone().eq("vec:F64") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx))
    }
    if ret_name.clone().eq("vec:v128") || ret_name.clone().eq("vec:V128") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_v128_type(ctx))
    }
    if ret_name.clone().starts_with("vec:") {
        let elem = ret_name.clone().slice(4, ret_name.len())
        // Mirror emit_explicit_vec_gc_type: fnref elements live in the
        // dedicated fnpair array and enum-like elements in the enum-ref
        // array. The bare default below is the i32-element vec.
        if sections_types_gc_phase7::gc_vec_elem_name_is_fnref(elem.clone()) {
            return Option::Some(ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx))
        }
        if sections_types_gc_phase7::gc_vec_elem_name_is_enum_like(elem.clone()) {
            return Option::Some(ctx_gc_type_vec_ref::SelfEmitCtx_vec_enum_ref_type(ctx))
        }
        if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(elem.clone()) ||
        ctx_gc_type_vec_ref::gc_vec_elem_is_registered_struct(ctx, elem.clone()) {
            return Option::Some(ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx))
        }
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_type(ctx))
    }
    if ret_name.clone().starts_with("Vec<") || ret_name.clone().starts_with("Vec_") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_type_for_ctx(ctx))
    }
    Option::None
}

// Mono Vec::new__Elem / Vec__new__Elem names are not all
// pre-registered; derive vec:Elem and resolve through layout helpers (#842 / #845).
fn infer_vec_new_return_gc_type(ctx: SelfEmitCtx, callee: String) -> Option<i32> {
    if callee.clone().starts_with("Vec::new__") ||
    callee.clone().starts_with("Vec::with_capacity__") ||
    callee.clone().starts_with("Vec__new__") ||
    callee.clone().starts_with("Vec__with_capacity__") {
        let last_sep = last_index_of_double_underscore(callee.clone())
        if last_sep < 0 {
            return Option::None
        }
        let elem = callee.clone().slice(last_sep + 2, callee.len())
        if elem.len() == 0 {
            return Option::Some(ctx_gc_type::SelfEmitCtx_vec_type(ctx))
        }
        return resolve_gc_type_from_return_type_name(ctx, "vec:".concat(elem))
    }
    if callee.clone().eq("Vec::new") ||
    callee.clone().eq("Vec::with_capacity") ||
    callee.clone().eq("Vec__new") ||
    callee.clone().eq("Vec__with_capacity") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_type(ctx))
    }
    Option::None
}

fn last_index_of_double_underscore(s: String) -> i32 {
    let n = s.len()
    let mut i = n - 2
    while i >= 0 {
        if s.byte_at(i) == 95 && s.byte_at(i + 1) == 95 {
            return i
        }
        i = i - 1
    }
    0 - 1
}

// True when 'name' spells 'Head<args>' and 'Head' owns registered enum
// variants in this module. The enum instantiation stays enum-typed even when
// a non-generic user struct shadows the bare head name (#905).
fn named_ret_head_registers_enum_variants(ctx: SelfEmitCtx, name: String) -> bool {
    let n = name.len()
    let mut head_end = 0 - 1
    let mut i = 0
    while i < n {
        if name.byte_at(i) == 60 {
            head_end = i
            i = n
        }
        i = i + 1
    }
    if head_end <= 0 {
        return false
    }
    let head = name.slice(0, head_end)
    let variants = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let mut vi = 0
    while vi < variants.len() {
        let variant = variants.get_unchecked(vi)
        if variant.clone().starts_with(head.clone().concat(String_from("::"))) ||
        variant.clone().contains(String_from("::").concat(head.clone().concat(String_from("::")))) {
            return true
        }
        vi = vi + 1
    }
    false
}

fn resolve_named_struct_gc_type(ctx: SelfEmitCtx, ret_name: String) -> Option<i32> {
    if ret_name.len() == 0 {
        return Option::None
    }
    // An 'enum:Box' spelling names the enum base even when a user 'struct Box'
    // shadows the bare name (#905). The last-colon strip below would otherwise
    // leak 'Box' into struct resolution and retype an enum dest as the struct.
    if ret_name.clone().starts_with("enum:") {
        return Option::None
    }
    // 'Head<Args>' whose head owns enum variants spells the generic enum
    // instance (Box<i32>), not a shadowing non-generic user struct — matching
    // local_type_name_is_enum_instance on the local-decl path.
    if named_ret_head_registers_enum_variants(ctx, ret_name.clone()) {
        return Option::None
    }
    // `vec:Diagnostic` must not resolve as the Diagnostic gc_struct. The last
    // colon strip below would do that and type a Vec return as the element.
    if ret_name.clone().starts_with("vec:") ||
    ret_name.clone().starts_with("Vec<") ||
    ret_name.clone().starts_with("Vec_") ||
    ret_name.clone().starts_with("hashmap:") ||
    ret_name.clone().starts_with("HashMap") ||
    ret_name.clone().starts_with("hashset:") ||
    ret_name.clone().starts_with("HashSet") ||
    ret_name.clone().starts_with("option:") ||
    ret_name.clone().starts_with("Option") ||
    ret_name.clone().starts_with("result:") ||
    ret_name.clone().starts_with("Result") {
        return Option::None
    }
    let bare_name = ctx_record::SelfEmitCtx_module_stripped_name(ret_name)
    if ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, bare_name.clone()) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, bare_name))
    }
    if ret_name.clone().starts_with("struct:") {
        let struct_name = parse_struct_name_from_ret_name(ret_name.clone())
        if struct_name.len() > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, struct_name.clone()) {
            return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, struct_name.clone()))
        }
        return Option::None
    }
    if ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, ret_name.clone()) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, ret_name.clone()))
    }
    let name_len = ret_name.len()
    let mut colon_pos = 0 - 1
    let mut ci = name_len - 1
    while ci >= 0 {
        if ret_name.byte_at(ci) == 58 {
            colon_pos = ci
            ci = 0 - 1
        }
        ci = ci - 1
    }
    if colon_pos >= 0 {
        let bare = ret_name.slice(colon_pos + 1, name_len)
        if ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, bare.clone()) {
            return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, bare))
        }
    }
    let bare = ctx_record::SelfEmitCtx_module_stripped_name(ret_name)
    if bare.len() > 0 {
        let candidate_index = ctx_record::SelfEmitCtx_gc_struct_index_by_module_stripped_name(ctx, bare)
        if candidate_index >= 0 {
            let candidate = ctx_record::SelfEmitCtx_gc_struct_names(ctx).get_unchecked(candidate_index)
            return Option::Some(
                ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, candidate.clone())
            )
        }
    }
    Option::None
}

// Struct/enum-oriented fallback for a MIR function return whose name does not
// resolve through resolve_gc_type_from_return_type_name.
fn infer_gc_type_from_return_struct(ctx: SelfEmitCtx, ret_type: i32, ret_name: String) -> Option<i32> {
    if ret_name.clone().starts_with("struct:") {
        let struct_name = parse_struct_name_from_ret_name(ret_name.clone())
        if struct_name.len() > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, struct_name.clone()) {
            return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, struct_name.clone()))
        }
        let byte_size = parse_struct_byte_size_from_ret_name(ret_name.clone())
        if byte_size > 0 {
            return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type(ctx, byte_size))
        }
    }
    if ret_type == value_types::mir_value_types__VT_GC_REF() {
        if code_ref_locals_types::is_option_type_name(ret_name.clone()) ||
        ret_name.clone().starts_with("enum:") ||
        ret_name.clone().starts_with("Result_") ||
        ret_name.clone().starts_with("Result:") ||
        ret_name.clone().starts_with("Result<") ||
        ret_name.clone().starts_with("result:") {
            return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
        }
        let named = resolve_named_struct_gc_type(ctx, ret_name.clone())
        match named {
            Option::Some(_opt_v) => {
                return named
            }
            Option::None => {}
        }
        // Unknown GC ref without a registered struct name: do not guess the
        // 1-field size-class (collides with enum-open at base+2).
        return Option::None
    }
    resolve_named_struct_gc_type(ctx, ret_name)
}

fn parse_struct_name_from_ret_name(type_name: String) -> String {
    let n = type_name.len()
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if type_name.byte_at(i) == 58 {
            if first_colon < 0 {
                first_colon = i
            }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon < 0 || first_colon == last_colon {
        return String_new()
    }
    type_name.slice(first_colon + 1, last_colon)
}

fn parse_struct_byte_size_from_ret_name(type_name: String) -> i32 {
    let n = type_name.len()
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if type_name.byte_at(i) == 58 {
            last_colon = i
        }
        i = i + 1
    }
    if last_colon < 0 {
        return 0
    }
    let mut byte_size = 0
    let mut j = last_colon + 1
    while j < n {
        let d = type_name.byte_at(j)
        if d >= 48 && d <= 57 {
            byte_size = byte_size * 10 + (d - 48)
        } else {
            j = n
        }
        j = j + 1
    }
    byte_size
}
