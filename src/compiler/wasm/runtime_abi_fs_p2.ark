use wasm::constants
use wasm::ctx_record
use wasm::ctx_scratch
use wasm::import_indices
use wasm::intrinsics::helpers_control
use wasm::intrinsics::helpers_core
use wasm::intrinsics::helpers_io_const
use wasm::intrinsics::helpers_io_layout
use wasm::intrinsics::helpers_memory
use wasm::intrinsics::helpers_numeric_i32
use wasm::intrinsics::helpers_numeric_i64_const

// Open a path relative to the first official WASI preopened directory.
// Returns zero for success and one for a canonical result error, leaving the
// descriptor handle in the first scratch local on success.  P2 resource
// handles must stay in Wasm locals; storing one in linear memory turns it into
// an invalid handle when the canonical component adapter receives it back.
fn emit_p2_open_status(w: WasmWriter, ctx: SelfEmitCtx, open_flags: i32, descriptor_flags: i32) {
    let fd_local = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    let result_local = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 6)
    helpers_core::emit_heap_get(w)
    helpers_numeric_i32::emit_i32_const(w, 7)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_numeric_i32::emit_i32_const(w, 0 - 8)
    helpers_numeric_i32::emit_i32_and(w)
    helpers_core::emit_local_set(w, result_local)
    helpers_core::emit_local_get(w, result_local)
    helpers_numeric_i32::emit_i32_const(w, 16)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_heap_set(w)
    helpers_io_layout::emit_scratch_addr_wasi(w, constants::SCRATCH_CLOCK_RESULT())
    helpers_core::emit_call(w, import_indices::get_directories_import_idx(ctx))
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_CLOCK_RESULT() + 4)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_eqz(w)
    helpers_control::emit_if_i32(w)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_control::emit_else(w)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_CLOCK_RESULT())
    helpers_memory::emit_i32_load_default(w)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_widen_i32_result(w)
    helpers_core::emit_local_set(w, fd_local)
    helpers_io_layout::emit_wasi_i32_from_local(w, fd_local)
    helpers_io_const::emit_i32_const(w, constants::P2_PATH_FLAGS_NONE())
    helpers_io_layout::emit_load_scratch_wasi_i32(w, constants::SCRATCH_FS_PATHPTR())
    helpers_io_layout::emit_load_scratch_wasi_i32(w, constants::SCRATCH_FS_PATHLEN())
    helpers_io_const::emit_i32_const(w, open_flags)
    helpers_io_const::emit_i32_const(w, descriptor_flags)
    helpers_io_layout::emit_wasi_i32_from_local(w, result_local)
    helpers_core::emit_call(w, import_indices::path_open_import_idx(ctx))
    helpers_core::emit_local_get(w, result_local)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_i32_eqz(w)
    helpers_control::emit_if_i32(w)
    helpers_core::emit_local_get(w, result_local)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32::emit_widen_i32_result(w)
    helpers_core::emit_local_set(w, fd_local)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_control::emit_else(w)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
}

// P2 descriptor ownership is finalized by the component boundary.  Calling
// the raw resource destructor from the guest core invalidates the handle table
// entry used by the canonical adapter, so P2 paths leave the handle owned by
// the component runtime until command teardown.
fn emit_p2_close(_w: WasmWriter, _ctx: SelfEmitCtx) {
}

fn emit_p2_write_status(w: WasmWriter, ctx: SelfEmitCtx, data_ptr_local: i32, data_len_local: i32) {
    let fd_local = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    let result_local = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 6)
    helpers_io_layout::emit_wasi_i32_from_local(w, fd_local)
    helpers_io_layout::emit_wasi_i32_from_local(w, data_ptr_local)
    helpers_io_layout::emit_wasi_i32_from_local(w, data_len_local)
    helpers_numeric_i64_const::emit_i64_const(w, 0i64)
    helpers_io_layout::emit_wasi_i32_from_local(w, result_local)
    helpers_core::emit_call(w, import_indices::fd_write_import_idx(ctx))
    helpers_core::emit_local_get(w, result_local)
    helpers_memory::emit_i32_load_default(w)
}
