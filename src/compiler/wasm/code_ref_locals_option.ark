// Option helpers for GC infer paths.
//
// Matching prelude Option inside a function that also has SelfEmitCtx in
// scope currently traps at runtime in the selfhost wasm emitter. Keep all
// Option match arms in this module (no SelfEmitCtx parameters).

fn option_i32_is_some(value: Option<i32>) -> bool {
    match value {
        Option::Some(_) => true,
        Option::None => false,
    }
}

fn option_i32_unwrap(value: Option<i32>) -> i32 {
    match value {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn option_i32_unwrap_or(value: Option<i32>, default_value: i32) -> i32 {
    match value {
        Option::Some(v) => v,
        Option::None => default_value,
    }
}
