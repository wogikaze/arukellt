use mir::inst_accessors_literals
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use wasm::call_indirect
use wasm::ctx_record
use wasm::emit_target
use wasm::inst_store
use wasm::opcodes
use wasm::writer_core

fn emit_call_ref_inst(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    // Linear-memory Wasm keeps the ADR-033 table ABI. Typed call_ref is the
    // GC primary path; lowering it back to call_indirect here preserves the
    // same callback semantics without requiring reference-types features.
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        call_indirect::emit_call_indirect_inst(w, inst, ctx, next_op, next_arg0, next_arg1, next2_op)
        return
    }
    let arg_count = inst_accessors_literals::MirInst_int_val(inst)
    let dest_vt = inst_accessors_shape::MirInst_val_type(inst)
    let first_arg_vt = call_indirect::parse_first_arg_vt_hint(inst_accessors_literals::MirInst_str_val(inst))
    let type_idx = call_indirect::resolve_indirect_type_idx(
        ctx,
        inst_accessors_operands::MirInst_arg1(inst),
        arg_count,
        dest_vt,
        first_arg_vt
    )
    // Stack: args..., funcref. No Memory64 index narrowing (unlike call_indirect).
    writer_core::emit_byte(w, opcodes::OP_CALL_REF())
    writer_core::emit_leb128_u(w, type_idx)
    inst_store::emit_store_result_if_needed(
        w,
        inst,
        next_op,
        next_arg0,
        next_arg1,
        next2_op,
        call_indirect::indirect_type_returns_value(ctx, type_idx, dest_vt)
    )
}
