use mir::inst_accessors_literals
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use wasm::call_indirect
use wasm::code_locals
use wasm::ctx_record
use wasm::emit_target
use wasm::inst_store
use wasm::opcodes
use wasm::writer_core
use wasm::writer_gc

fn emit_call_ref_inst(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    // Linear-memory Wasm keeps the ADR-033 table ABI. Typed call_ref is the
    // GC primary path; lowering it back to call_indirect here preserves the
    // same callback semantics without requiring reference-types features.
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        call_indirect::emit_call_indirect_inst(w, inst, ctx, next_op, next_arg0, next_arg1, next2_op)
        return
    }
    let arg_count = inst_accessors_literals::MirInst_int_val(inst)
    let dest_vt = inst_accessors_shape::MirInst_val_type(inst)
    let raw_hint = inst_accessors_literals::MirInst_str_val(inst)
    let first_arg_vt = call_indirect::parse_first_arg_vt_hint(clone(raw_hint))
    let callee_local = inst_accessors_operands::MirInst_arg0(inst)
    let hint_type_name = call_indirect::parse_call_ref_type_name_hint(clone(raw_hint))
    let current_type_name = code_locals::current_local_type_name(ctx, callee_local)
    let callee_type_name = if len(hint_type_name) > 0 {
        hint_type_name
    } else {
        current_type_name
    }
    // Pair ABI (#872): the stack top is the raw funcref field of __fnpair;
    // the nk/vk hint keys pin the exact (env, args...) -> ret signature.
    let mut type_idx = call_indirect::call_ref_pair_key_type_idx(ctx, clone(raw_hint))
    if type_idx < 0 {
        // No trampoline carries this signature; fall back to the exact
        // pair-call signature registered in the type section instead of
        // arity-guessing a program function (#872).
        let pair_sig = call_indirect::pair_call_sig_from_hint(
            clone(raw_hint),
            dest_vt,
            ctx_record::SelfEmitCtx_memory64(ctx)
        )
        if len(pair_sig) > 0 {
            type_idx = call_indirect::call_ref_pair_sig_type_idx(ctx, pair_sig)
        }
    }
    if type_idx < 0 {
        type_idx = call_indirect::resolve_call_ref_type_idx(
            ctx,
            callee_type_name,
            callee_local,
            arg_count,
            dest_vt,
            first_arg_vt
        )
    }
    // Stack: env, args..., funcref. ref.cast narrows the generic funcref
    // field to the concrete trampoline signature for call_ref.
    writer_gc::emit_gc_ref_cast(w, type_idx)
    writer_core::emit_byte(w, opcodes::OP_CALL_REF())
    writer_core::emit_leb128_u(w, type_idx)
    inst_store::emit_store_result_if_needed(
        w,
        inst,
        next_op,
        next_arg0,
        next_arg1,
        next2_op,
        call_indirect::indirect_type_returns_value(ctx, type_idx, dest_vt)
    )
}
