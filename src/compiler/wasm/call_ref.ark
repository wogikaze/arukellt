use std::prelude::{clone}
use mir::inst_accessors_literals
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use wasm::call_indirect
use wasm::code_locals
use wasm::ctx_record
use wasm::ctx_reloc
use wasm::emit_target
use wasm::inst_store
use wasm::opcodes
use wasm::writer_core
use wasm::writer_gc
fn emit_call_ref_inst(mut w: WasmWriter, inst: MirInst, mut ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    // Linear-memory Wasm keeps the ADR-033 table ABI. Typed call_ref is the
    // GC primary path; lowering it back to call_indirect here preserves the
    // same callback semantics without requiring reference-types features.
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        call_indirect::emit_call_indirect_inst(w, inst, ctx, next_op, next_arg0, next_arg1, next2_op)
        return
    }
    let arg_count = inst_accessors_literals::MirInst_int_val(inst)
    let dest_vt = inst_accessors_shape::MirInst_val_type(inst)
    let raw_hint = inst_accessors_literals::MirInst_str_val(inst)
    let first_arg_vt = call_indirect::parse_first_arg_vt_hint(clone(raw_hint))
    let callee_local = inst_accessors_operands::MirInst_arg0(inst)
    let hint_type_name = call_indirect::parse_call_ref_type_name_hint(clone(raw_hint))
    let current_type_name = code_locals::current_local_type_name(ctx, callee_local)
    let callee_type_name = if len(hint_type_name) > 0 {
        hint_type_name
    } else {
        current_type_name
    }
    // Pair ABI (#872): the stack top is the raw funcref field of __fnpair;
    // the nk/vk hint keys pin the exact (env, args...) -> ret signature.
    let mut type_idx = call_indirect::call_ref_pair_key_type_idx(ctx, clone(raw_hint))
    if type_idx < 0 {
        // No trampoline carries this signature; fall back to the exact
        // pair-call signature registered in the type section instead of
        // arity-guessing a program function (#872).
        let pair_sig = call_indirect::pair_call_sig_from_hint(
            clone(raw_hint),
            dest_vt,
            ctx_record::SelfEmitCtx_memory64(ctx),
            ctx_record::SelfEmitCtx_gc_struct_names(ctx)
        )
        if len(pair_sig) > 0 {
            type_idx = call_indirect::call_ref_pair_sig_type_idx(ctx, pair_sig)
        }
    }
    // The func-scoped local-type probe cannot be reproduced at reloc apply
    // (current_func_idx has moved past this body), so it runs inline here in
    // its original chain position. A hit is final — the operands emit
    // directly; a miss (including pair-step hits that never reach it) sends
    // the operands to reloc placeholders re-resolved at section assembly.
    let mut local_typed_idx = 0 - 1
    if type_idx < 0 {
        local_typed_idx = call_indirect::typed_string_callback_type_idx_for_local(ctx, callee_local)
        if local_typed_idx >= 0 {
            type_idx = local_typed_idx
        }
    }
    if type_idx < 0 {
        type_idx = call_indirect::resolve_call_ref_type_idx_after_local(
            ctx,
            callee_type_name,
            arg_count,
            dest_vt,
            first_arg_vt
        )
    }
    // Stack: env, args..., funcref. ref.cast narrows the generic funcref
    // field to the concrete trampoline signature for call_ref.
    if local_typed_idx >= 0 {
        writer_gc::emit_gc_ref_cast(w, type_idx)
        writer_core::emit_byte(w, opcodes::OP_CALL_REF())
        writer_core::emit_leb128_u(w, type_idx)
    } else {
        // Cast elision and stack bookkeeping use the emit-time-resolved
        // index; only the emitted operands become reloc placeholders.
        if !writer_core::writer_ref_top_is(w, type_idx) {
            writer_gc::emit_gc_prefix(w)
            writer_core::emit_leb128_u(w, opcodes::GC_REF_CAST())
            ctx_reloc::SelfEmitCtx_emit_leb_s_reloc(
                w,
                ctx,
                ctx_reloc::RELOC_KIND_CALL_REF_CAST(),
                arg_count,
                dest_vt,
                callee_local,
                clone(raw_hint),
                clone(callee_type_name)
            )
            writer_core::writer_note_ref_top(w, type_idx)
        }
        writer_core::emit_byte(w, opcodes::OP_CALL_REF())
        ctx_reloc::SelfEmitCtx_emit_leb_u_reloc(
            w,
            ctx,
            ctx_reloc::RELOC_KIND_CALL_REF_TYPE(),
            arg_count,
            dest_vt,
            callee_local,
            clone(raw_hint),
            clone(callee_type_name)
        )
    }
    inst_store::emit_store_result_if_needed(
        w,
        inst,
        next_op,
        next_arg0,
        next_arg1,
        next2_op,
        call_indirect::indirect_type_returns_value(ctx, type_idx, dest_vt)
    )
}

// Re-run the recorded call_ref resolution at reloc-apply. The func-scoped
// local-type lookup is not re-run (the emit gate proved it returned -1);
// every remaining step reads tables that are final at assembly, so the
// patched operand equals the direct-resolution value.
//   ikey = arg_count, ikey2 = dest_vt, ikey3 = callee_local
//   skey = MirInst_str_val raw hint, skey2 = resolved callee_type_name
fn resolve_call_ref_reloc(ctx: SelfEmitCtx, ikey: i32, ikey2: i32, ikey3: i32, skey: String, skey2: String) -> i32 {
    let first_arg_vt = call_indirect::parse_first_arg_vt_hint(clone(skey))
    let mut type_idx = call_indirect::call_ref_pair_key_type_idx(ctx, clone(skey))
    if type_idx < 0 {
        let pair_sig = call_indirect::pair_call_sig_from_hint(
            clone(skey),
            ikey2,
            ctx_record::SelfEmitCtx_memory64(ctx),
            ctx_record::SelfEmitCtx_gc_struct_names(ctx)
        )
        if len(pair_sig) > 0 {
            type_idx = call_indirect::call_ref_pair_sig_type_idx(ctx, pair_sig)
        }
    }
    if type_idx < 0 {
        type_idx = call_indirect::resolve_call_ref_type_idx_after_local(
            ctx,
            skey2,
            ikey,
            ikey2,
            first_arg_vt
        )
    }
    type_idx
}
