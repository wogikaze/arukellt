use std::text
fn parse_sub_super_offset(sig: String) -> i32 {
    let plus = find_type_sig_char(sig, 43)
    if plus < 0 {
        return 0 - 1
    }
    let mut val = 0
    let mut i = plus + 1
    let n = len(sig)
    while i < n {
        let c = sig.clone().byte_at(i)
        if c >= 48 && c <= 57 {
            val = val * 10 + (c - 48)
            i = i + 1
        } else {
            break
        }
    }
    val
}

fn parse_sub_struct_sig(sig: String) -> String {
    // Zero-field user structs emit as `SubF_GS` and carry no `_GS_` field
    // marker; their body is the bare `GS` (zero fields).
    if sig.clone().eq(String_from("SubF_GS")) {
        return String_from("GS")
    }
    let marker = "_GS_"
    let start = find_type_sig_str(sig, marker)
    if start >= 0 {
        let body_start = start + 1
        let at = find_type_sig_char(sig, 64)
        if at >= body_start {
            return sig.clone().slice(body_start, at)
        }
        return sig.clone().slice(body_start, len(sig))
    }
    // Enum variant sigs use _S_ instead of _GS_ (e.g. SubF+14_S_f0_i32_f1_i32)
    let s_marker = "_S_"
    let s_start = find_type_sig_str(sig, s_marker)
    if s_start >= 0 {
        let body_start = s_start + 3
        let at = find_type_sig_char(sig, 64)
        if at >= body_start {
            return "GS_".concat(sig.clone().slice(body_start, at))
        }
        return "GS_".concat(sig.clone().slice(body_start, len(sig)))
    }
    "GS_f0_i32"
}

fn find_type_sig_char(s: String, c: i32) -> i32 {
    let n = len(s)
    let mut i = 0
    while i < n {
        if s.clone().byte_at(i) == c {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn find_type_sig_str(s: String, needle: String) -> i32 {
    let n = len(s)
    let nn = len(needle)
    if nn <= 0 || nn > n {
        return 0 - 1
    }
    let mut i = 0
    while i + nn <= n {
        let mut matched = 1
        let mut j = 0
        while j < nn {
            if s.clone().byte_at(i + j) != needle.clone().byte_at(j) {
                matched = 0
            }
            j = j + 1
        }
        if matched == 1 {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn parse_type_sig_int(s: String) -> i32 {
    let n = len(s)
    let mut val = 0
    let mut i = 0
    while i < n {
        let c = s.clone().byte_at(i)
        if c >= 48 && c <= 57 {
            val = val * 10 + (c - 48)
        }
        i = i + 1
    }
    val
}

fn parse_gcref_offset(sig: String) -> i32 {
    if sig.clone().eq("gcref") {
        return 2
    }
    if sig.clone().starts_with("gcref") {
        return parse_type_sig_int(sig.slice(5, len(sig)))
    }
    2
}
