use wasm::ctx_record
use wasm::opcodes
use wasm::writer_core
use wasm::writer_leb

// #851 Phase 3: deferred-resolution reloc records for body bytes.
// Operands whose value is only final after the post-loop tables exist
// (plan-appended string literals, call_indirect type-map indices) emit a
// placeholder, record (func_idx, body_rel_off, kind, key) here, and get
// splice-patched at section assembly once body_bytes holds every body.
// Splice (not fixed-width patch) keeps the minimal SLEB encoding the
// direct-resolution path produced, so output stays byte-identical.
fn RELOC_KIND_STR_TRUE() -> i32 {
    0
}

fn RELOC_KIND_STR_FALSE() -> i32 {
    1
}

fn RELOC_KIND_STR_VALUE() -> i32 {
    2
}

// call_indirect operand kinds: records the resolver inputs and re-runs the
// same resolution at apply (functions/type maps are final then), so the
// patched value equals direct resolution by construction.
//   ikey = arg_count, ikey2 = dest_vt, ikey3 = first_arg_vt
fn RELOC_KIND_INDIRECT_SCAN() -> i32 {
    3
}

// skey = MirInst_str_val pair-ABI hint (nk/vk segments).
fn RELOC_KIND_PAIR_KEY() -> i32 {
    4
}

// call_ref operand kinds: re-run the call_ref resolution chain minus the
// func-scoped local lookup (the emit gate guarantees it returned -1).
//   ikey = arg_count, ikey2 = dest_vt, ikey3 = callee_local
//   skey = MirInst_str_val raw hint, skey2 = resolved callee_type_name
// CALL_REF_CAST = ref.cast heap-type operand (signed LEB encoding).
// CALL_REF_TYPE = call_ref type operand (uleb).
fn RELOC_KIND_CALL_REF_CAST() -> i32 {
    5
}

fn RELOC_KIND_CALL_REF_TYPE() -> i32 {
    6
}

// MIR_REF_FUNC operand (uleb): skey = target function name. In-loop drain
// emits bodies before reachability compaction, so the module function index
// is resolved against the post-prune functions vec at apply time.
fn RELOC_KIND_REF_FUNC() -> i32 {
    7
}

// Operand byte class used by the splice: STR_* are sleb i32/i64 const
// operands, CALL_REF_CAST is a sleb GC heap-type operand; the call_indirect
// and CALL_REF_TYPE type operands are uleb.
fn reloc_kind_is_sleb(kind: i32) -> bool {
    kind == RELOC_KIND_STR_TRUE() ||
    kind == RELOC_KIND_STR_FALSE() ||
    kind == RELOC_KIND_STR_VALUE() ||
    kind == RELOC_KIND_CALL_REF_CAST()
}

fn SelfEmitCtx_push_reloc(
    mut ctx: SelfEmitCtx,
    body_off: i32,
    kind: i32,
    ikey: i32,
    ikey2: i32,
    ikey3: i32,
    skey: String,
    skey2: String
) {
    push(ctx.reloc_func, ctx_record::SelfEmitCtx_current_func_idx(ctx))
    push(ctx.reloc_off, body_off)
    push(ctx.reloc_kind, kind)
    push(ctx.reloc_ikey, ikey)
    push(ctx.reloc_ikey2, ikey2)
    push(ctx.reloc_ikey3, ikey3)
    push(ctx.reloc_skey, skey)
    push(ctx.reloc_skey2, skey2)
}

// Emit an i32/i64 const whose operand is a reloc placeholder: opcode first,
// then a 1-byte sleb(0) that apply replaces with the minimal sleb of the
// resolved value. Mirrors emit_i32_const's memory64 opcode dispatch so the
// non-operand bytes match the direct path exactly.
fn SelfEmitCtx_emit_i32_const_reloc(
    mut w: WasmWriter,
    mut ctx: SelfEmitCtx,
    kind: i32,
    ikey: i32,
    skey: String
) {
    if writer_core::writer_memory64(w) {
        writer_core::emit_byte(w, opcodes::OP_I64_CONST())
    } else {
        writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    }
    SelfEmitCtx_push_reloc(ctx, writer_core::writer_size(w), kind, ikey, 0, 0, skey, String_new())
    writer_leb::emit_leb128_s(w, 0)
}

// True-i32 variant for operands that stay i32 even under Memory64 (WASI
// iov/scratch pointer fields): always OP_I32_CONST like
// helpers_io_const::emit_i32_const, never the widened i64 form.
fn SelfEmitCtx_emit_i32_const_true_reloc(
    mut w: WasmWriter,
    mut ctx: SelfEmitCtx,
    kind: i32,
    ikey: i32,
    skey: String
) {
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    SelfEmitCtx_push_reloc(ctx, writer_core::writer_size(w), kind, ikey, 0, 0, skey, String_new())
    writer_leb::emit_leb128_s(w, 0)
}

// ULEB operand variant (call_indirect type index): record the operand
// position, write a 1-byte uleb(0) placeholder.
fn SelfEmitCtx_emit_leb_u_reloc(
    mut w: WasmWriter,
    mut ctx: SelfEmitCtx,
    kind: i32,
    ikey: i32,
    ikey2: i32,
    ikey3: i32,
    skey: String,
    skey2: String
) {
    SelfEmitCtx_push_reloc(ctx, writer_core::writer_size(w), kind, ikey, ikey2, ikey3, skey, skey2)
    writer_leb::emit_leb128_u(w, 0)
}

// SLEB operand variant (GC heap-type operands like ref.cast): record the
// operand position, write a 1-byte sleb(0) placeholder.
fn SelfEmitCtx_emit_leb_s_reloc(
    mut w: WasmWriter,
    mut ctx: SelfEmitCtx,
    kind: i32,
    ikey: i32,
    ikey2: i32,
    ikey3: i32,
    skey: String,
    skey2: String
) {
    SelfEmitCtx_push_reloc(ctx, writer_core::writer_size(w), kind, ikey, ikey2, ikey3, skey, skey2)
    writer_leb::emit_leb128_s(w, 0)
}

fn reloc_splice_i32(body: Vec<i32>, off: i32, value: i32) -> Vec<i32> {
    let mut out_v = Vec::new<i32>()
    let mut i = 0
    while i < off {
        push(out_v, body.get_unchecked(i))
        i = i + 1
    }
    let mut sw = writer_core::WasmWriter_new()
    writer_leb::emit_leb128_s(sw, value)
    let enc = writer_core::writer_bytes(sw)
    let mut j = 0
    while j < enc.len() {
        push(out_v, enc.get_unchecked(j))
        j = j + 1
    }
    // The placeholder operand is always the 1-byte sleb(0); skip exactly
    // one byte.
    let mut k = off + 1
    while k < body.len() {
        push(out_v, body.get_unchecked(k))
        k = k + 1
    }
    out_v
}

// ULEB variant: same 1-byte placeholder skip, minimal u-leb encoding.
fn reloc_splice_u32(body: Vec<i32>, off: i32, value: i32) -> Vec<i32> {
    let mut out_v = Vec::new<i32>()
    let mut i = 0
    while i < off {
        push(out_v, body.get_unchecked(i))
        i = i + 1
    }
    let mut sw = writer_core::WasmWriter_new()
    writer_leb::emit_leb128_u(sw, value)
    let enc = writer_core::writer_bytes(sw)
    let mut j = 0
    while j < enc.len() {
        push(out_v, enc.get_unchecked(j))
        j = j + 1
    }
    let mut k = off + 1
    while k < body.len() {
        push(out_v, body.get_unchecked(k))
        k = k + 1
    }
    out_v
}

// Fixed-width sibling of the splice helpers: CALL operands reserve a
// 5-byte uleb slot at emit (emit_leb128_u_fixed), so apply patches in
// place. No byte is inserted or removed, so surrounding reloc offsets
// stay valid regardless of patch order.
fn reloc_patch_leb_u_fixed(mut body: Vec<i32>, off: i32, v: i32) {
    let mut val = v
    if val < 0 {
        val = 0
    }
    let mut i = 0
    while i < 5 {
        let mut b = val % 128
        val = val / 128
        if i < 4 {
            b = b + 128
        }
        set(body, off + i, b)
        i = i + 1
    }
}
