use std::host::process
use std::host::stdio
use mir::gc_layout_plan
use mir::gc_layout_plan_validator
use mir::module_gc_layout_plan
use wasm::gc_layout_table

fn gc_layout_plan_type_index(
    binding: MirGcLayoutBinding,
    gc_fixed_type_map: Vec<i32>,
    gc_enum_variant_type_map: Vec<i32>,
    gc_struct_type_map: Vec<i32>
) -> i32 {
    let source_kind = gc_layout_plan::mir_gc_layout_binding_source_kind(binding)
    let source_value = gc_layout_plan::mir_gc_layout_binding_source_value(binding)
    if source_kind == gc_layout_plan::MIR_GC_LAYOUT_SOURCE_FIXED_OFFSET() {
        if source_value < 0 || source_value >= len(gc_fixed_type_map) {
            return 0 - 1
        }
        return get_unchecked(gc_fixed_type_map, source_value)
    }
    if source_kind == gc_layout_plan::MIR_GC_LAYOUT_SOURCE_STRUCT_SLOT() {
        if source_value < 0 || source_value >= len(gc_struct_type_map) {
            return 0 - 1
        }
        return get_unchecked(gc_struct_type_map, source_value)
    }
    if source_kind == gc_layout_plan::MIR_GC_LAYOUT_SOURCE_ENUM_VARIANT_SLOT() {
        if source_value < 0 || source_value >= len(gc_enum_variant_type_map) {
            return 0 - 1
        }
        return get_unchecked(gc_enum_variant_type_map, source_value)
    }
    0 - 1
}

fn gc_layout_plan_struct_type_index(binding: MirGcLayoutBinding, type_idx: i32) -> i32 {
    let source_kind = gc_layout_plan::mir_gc_layout_binding_source_kind(binding)
    if source_kind == gc_layout_plan::MIR_GC_LAYOUT_SOURCE_STRUCT_SLOT() ||
    source_kind == gc_layout_plan::MIR_GC_LAYOUT_SOURCE_ENUM_VARIANT_SLOT() {
        return type_idx
    }
    0 - 1
}

fn populate_gc_layout_table_for_emit(
    table: GcLayoutTable,
    mir: MirModule,
    gc_fixed_type_map: Vec<i32>,
    gc_enum_variant_type_map: Vec<i32>,
    gc_struct_type_map: Vec<i32>
) {
    let plan = module_gc_layout_plan::MirModule_gc_layout_plan(mir)
    if !gc_layout_plan_validator::mir_gc_layout_plan_valid(plan) {
        stdio::eprintln("compiler ICE: backend received invalid MIR GC layout plan")
        process::exit(1)
    }
    gc_layout_table::gc_layout_table_set_fixed_type_map(table, gc_fixed_type_map)
    let count = gc_layout_plan::mir_gc_layout_plan_binding_count(plan)
    let mut index = 0
    while index < count {
        let binding = gc_layout_plan::mir_gc_layout_plan_binding_at(plan, index)
        let type_idx = gc_layout_plan_type_index(
            binding,
            gc_fixed_type_map,
            gc_enum_variant_type_map,
            gc_struct_type_map
        )
        if type_idx < 0 {
            stdio::eprintln("compiler ICE: GC layout plan references an unavailable type-section slot")
            process::exit(1)
        }
        let layout_id = gc_layout_table::gc_layout_table_register_key(
            table,
            gc_layout_table::GcLayoutKey_new(
                gc_layout_plan::mir_gc_layout_binding_type_id(binding),
                gc_layout_table::GcMemberKey_aggregate()
            ),
            gc_layout_table::WasmRefType_new(type_idx, 1),
            gc_layout_plan_struct_type_index(binding, type_idx)
        )
        if !gc_layout_table::gc_layout_id_is_valid(layout_id) {
            stdio::eprintln("compiler ICE: conflicting explicit GC layout binding")
            process::exit(1)
        }
        index = index + 1
    }
}
