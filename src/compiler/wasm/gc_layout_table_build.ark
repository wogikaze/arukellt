use std::host::process::Process
use std::host::stdio::Stdio
use mir::gc_layout_plan
use mir::module_gc_layout_plan
use wasm::gc_layout_table

fn gc_layout_plan_type_index(
    binding: MirGcLayoutBinding,
    gc_type_base: i32,
    gc_enum_variant_type_map: Vec<i32>,
    gc_struct_type_map: Vec<i32>
) -> i32 {
    let source_kind = gc_layout_plan::mir_gc_layout_binding_source_kind(binding)
    let source_value = gc_layout_plan::mir_gc_layout_binding_source_value(binding)
    if source_kind == gc_layout_plan::MIR_GC_LAYOUT_SOURCE_FIXED_OFFSET() {
        if gc_type_base < 0 {
            return 0 - 1
        }
        return gc_type_base + source_value
    }
    if source_kind == gc_layout_plan::MIR_GC_LAYOUT_SOURCE_STRUCT_SLOT() {
        if source_value < 0 || source_value >= gc_struct_type_map.len() {
            return 0 - 1
        }
        return get_unchecked(gc_struct_type_map, source_value)
    }
    if source_kind == gc_layout_plan::MIR_GC_LAYOUT_SOURCE_ENUM_VARIANT_SLOT() {
        if source_value < 0 || source_value >= gc_enum_variant_type_map.len() {
            return 0 - 1
        }
        return get_unchecked(gc_enum_variant_type_map, source_value)
    }
    0 - 1
}

fn gc_layout_plan_struct_type_index(binding: MirGcLayoutBinding, type_idx: i32) -> i32 {
    let source_kind = gc_layout_plan::mir_gc_layout_binding_source_kind(binding)
    if source_kind == gc_layout_plan::MIR_GC_LAYOUT_SOURCE_STRUCT_SLOT() ||
    source_kind == gc_layout_plan::MIR_GC_LAYOUT_SOURCE_ENUM_VARIANT_SLOT() {
        return type_idx
    }
    0 - 1
}

fn populate_gc_layout_table_for_emit(
    mut table: GcLayoutTable,
    mir: MirModule,
    gc_type_base: i32,
    gc_enum_variant_type_map: Vec<i32>,
    gc_struct_type_map: Vec<i32>
) {
    gc_layout_table_drain_plan(
        table, mir, gc_type_base, gc_enum_variant_type_map,
        gc_struct_type_map, true)
}

// Resumable drain of the module GC layout plan into the emit table (#851
// Phase 3): new bindings are offered once; a binding whose type-section
// slot is not final yet stays pending instead of ICEing. final_pass=true
// restores the legacy all-or-ICE semantics (post-lower emit path).
fn gc_layout_table_drain_plan(
    mut table: GcLayoutTable,
    mir: MirModule,
    gc_type_base: i32,
    gc_enum_variant_type_map: Vec<i32>,
    gc_struct_type_map: Vec<i32>,
    final_pass: bool
) {
    let plan = module_gc_layout_plan::MirModule_gc_layout_plan(mir)
    let count = gc_layout_plan::mir_gc_layout_plan_binding_count(plan)
    // The drain runs once per pushed function (#851 Phase 3), so the old
    // whole-plan validation re-scanned every binding per push. Bindings
    // are append/replace-only via mir_gc_layout_plan_bind; validating
    // [plan_seen, count) checks each appended binding exactly once while
    // keeping identical ICE coverage for a fresh table (plan_seen = 0).
    if !gc_layout_plan::mir_gc_layout_plan_validate_range(plan, table.plan_seen) {
        Stdio::eprintln("compiler ICE: backend received invalid MIR GC layout plan")
        Process::exit(1)
    }
    while table.plan_seen < count {
        table.plan_pending.push(table.plan_seen)
        table.plan_seen = table.plan_seen + 1
    }
    // Rescan pending only when its outcome can change (#851): a new canon
    // assignment (module version bump), gc_type_base flipping to final,
    // or fresh bindings appended this drain. Without that the per-push
    // drain re-walked every stuck binding for every pushed function.
    let state_changed = mir.gc_canon_version != table.drain_version_seen ||
    gc_type_base != table.drain_base_seen ||
    table.plan_pending.len() != table.drain_pending_seen
    if table.plan_pending.len() > 0 && (final_pass || state_changed) {
        let mut still_pending = Vec::new<i32>()
        let pending_count = table.plan_pending.len()
        let mut p = 0
        while p < pending_count {
            let index = get_unchecked(table.plan_pending, p)
            let binding = gc_layout_plan::mir_gc_layout_plan_binding_at(plan, index)
            let type_idx = gc_layout_plan_type_index(
                binding,
                gc_type_base,
                gc_enum_variant_type_map,
                gc_struct_type_map
            )
            if type_idx < 0 {
                if final_pass {
                    Stdio::eprintln("compiler ICE: GC layout plan references an unavailable type-section slot")
                    Process::exit(1)
                }
                still_pending.push(index)
            } else {
                let layout_id = gc_layout_table::gc_layout_table_register_key(
                    table,
                    gc_layout_table::GcLayoutKey_new(
                        gc_layout_plan::mir_gc_layout_binding_type_id(binding),
                        gc_layout_table::GcMemberKey_aggregate()
                    ),
                    gc_layout_table::WasmRefType_new(type_idx, 1),
                    gc_layout_plan_struct_type_index(binding, type_idx)
                )
                if !gc_layout_table::gc_layout_id_is_valid(layout_id) {
                    Stdio::eprintln("compiler ICE: conflicting explicit GC layout binding")
                    Process::exit(1)
                }
            }
            p = p + 1
        }
        table.plan_pending = still_pending
    }
    table.drain_version_seen = mir.gc_canon_version
    table.drain_base_seen = gc_type_base
    table.drain_pending_seen = table.plan_pending.len()
}
