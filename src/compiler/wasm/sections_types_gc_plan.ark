use std::prelude::{eq}
use corehir::kinds
use corehir::mir_value_type
use corehir::type_id
use corehir::type_info_to_mir_value
use corehir::type_table
use mir::module_gc_enum
use mir::module_gc_struct
use mir::module_spine
use mir::spine_lookup
use wasm::emit_target
use wasm::sections_types_gc
use wasm::sections_types_gc_phase7
fn typed_function_param_sig(mir: MirModule, fn_name: String, param_idx: i32, target: String) -> String {
    if !emit_target::is_gc_target(target.clone()) {
        return String_new()
    }
    typed_mvt_sig(mir, spine_lookup::function_param_mvt(mir, fn_name, param_idx), target)
}

fn typed_function_return_sig(mir: MirModule, fn_name: String, target: String) -> String {
    if !emit_target::is_gc_target(target.clone()) {
        return String_new()
    }
    typed_mvt_sig(mir, spine_lookup::function_return_mvt(mir, fn_name), target)
}

fn typed_mvt_sig(mir: MirModule, mvt: MirValueType, target: String) -> String {
    let tid = mir_value_type::mir_value_type_type_id(mvt)
    if !type_id::type_id_is_valid(tid) {
        return String_new()
    }
    let table = module_spine::MirModule_type_table(mir)
    let entry = type_table::TypeTable_lookup(table, tid)
    let kind = type_table::type_entry_kind(entry)
    if kind == kinds::TYPE_KIND_TYPE_VAR() {
        return "structref"
    }
    if kind == kinds::TYPE_KIND_STRING() {
        return sections_types_gc::gc_string_type_sig()
    }
    if kind == kinds::TYPE_KIND_OPTION() || kind == kinds::TYPE_KIND_RESULT() || kind == kinds::TYPE_KIND_ENUM() {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    // A registered enum base is a declared nominal type even at one
    // uppercase letter; the open enum type holds the variant reference.
    if kind == kinds::TYPE_KIND_STRUCT() &&
    module_gc_enum::MirModule_gc_enum_base_has_variants(mir, type_table::type_entry_name(entry)) {
        return sections_types_gc::gc_enum_open_type_sig()
    }
    if kind == kinds::TYPE_KIND_STRUCT() &&
    is_legacy_generic_struct_name(mir, type_table::type_entry_name(entry)) {
        return "structref"
    }
    let alias = type_info_to_mir_value::mvt_gc_layout_alias(table, mvt)
    if len(alias) > 0 {
        return collection_type_sig(mir, alias, target)
    }
    String_new()
}

// A registered GC struct is a declared nominal type, even when its name is
// one uppercase letter. Only unresolved legacy generic spellings fall back
// to the shared open structref base.
fn is_legacy_generic_struct_name(mir: MirModule, name: String) -> bool {
    if module_gc_struct::MirModule_gc_struct_slot(mir, name.clone()) >= 0 {
        return false
    }
    if len(name) == 1 {
        let first = name.byte_at(0)
        return first >= 65 && first <= 90
    }
    if name.clone().starts_with("struct:") && len(name) >= 9 {
        let marker = name.byte_at(7)
        return marker >= 65 && marker <= 90 && name.byte_at(8) == 58
    }
    false
}

fn collection_type_sig(mir: MirModule, type_name: String, target: String) -> String {
    if !emit_target::is_gc_target(target.clone()) {
        return String_new()
    }
    if type_name.clone().starts_with("vec:") {
        if eq(type_name.clone(), "vec:String") || eq(type_name.clone(), "vec:string") {
            return sections_types_gc::gc_vec_string_type_sig()
        }
        if eq(type_name.clone(), "vec:i64") || eq(type_name.clone(), "vec:I64") {
            return sections_types_gc::gc_vec_i64_type_sig()
        }
        if eq(type_name.clone(), "vec:f64") || eq(type_name.clone(), "vec:F64") {
            return sections_types_gc::gc_vec_f64_type_sig()
        }
        if eq(type_name.clone(), "vec:v128") || eq(type_name.clone(), "vec:V128") {
            return sections_types_gc::gc_vec_v128_type_sig()
        }
        if eq(type_name.clone(), "vec:fnref") || eq(type_name.clone(), "vec:fn") {
            return sections_types_gc::gc_vec_fnref_type_sig()
        }
        let elem = type_name.clone().slice(4, len(type_name))
        if sections_types_gc_phase7::gc_vec_elem_name_is_fnref(elem.clone()) {
            return sections_types_gc::gc_vec_fnref_type_sig()
        }
        if sections_types_gc_phase7::gc_vec_elem_name_is_enum_like(elem.clone()) {
            return sections_types_gc::gc_vec_enum_ref_type_sig()
        }
        if sections_types_gc_phase7::gc_vec_elem_name_is_struct_ref(elem.clone()) ||
        eq(elem.clone(), "Vec") ||
        elem.clone().starts_with("vec:") ||
        module_gc_struct::MirModule_gc_struct_slot(mir, elem.clone()) >= 0 {
            return sections_types_gc_phase7::gc_vec_struct_ref_type_sig()
        }
        return sections_types_gc::gc_vec_type_sig()
    }
    if type_name.clone().starts_with("hashmap:") {
        if type_name.clone().starts_with("hashmap:i32str") {
            return sections_types_gc::gc_hashmap_i32_str_type_sig()
        }
        if type_name.clone().starts_with("hashmap:i32fn") {
            return sections_types_gc::gc_hashmap_i32_fn_type_sig()
        }
        if type_name.clone().starts_with("hashmap:strfn") {
            return sections_types_gc::gc_hashmap_str_fn_type_sig()
        }
        if type_name.clone().starts_with("hashmap:strstr") {
            return sections_types_gc::gc_hashmap_str_str_type_sig()
        }
        if type_name.clone().starts_with("hashmap:i32i32") {
            return sections_types_gc::gc_vec_type_sig()
        }
        return sections_types_gc::gc_hashmap_str_i32_type_sig()
    }
    String_new()
}
