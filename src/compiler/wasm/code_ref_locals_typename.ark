// GC type from type names.
// Contract: infer_* returns Option<i32> — Some(idx) = Wasm GC type, None = unknown.
// See docs/research/infer-local-gc-type-option.md.
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref

fn infer_gc_type_from_type_name(type_name: String, ctx: SelfEmitCtx) -> Option<i32> {
    let hm = infer_hashmap_gc_type_from_type_name(clone(type_name), ctx)
    match hm {
        Option::Some(_opt_v) => {
            return hm
        }
        Option::None => {}
    }
    let vec = infer_vec_gc_type_from_type_name(clone(type_name), ctx)
    match vec {
        Option::Some(_opt_v) => {
            return vec
        }
        Option::None => {}
    }
    if starts_with(clone(type_name), "Option_") ||
    starts_with(clone(type_name), "option:") ||
    starts_with(clone(type_name), "Option:") ||
    starts_with(clone(type_name), "Option<") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if starts_with(clone(type_name), "Result_") ||
    starts_with(clone(type_name), "result:") ||
    starts_with(clone(type_name), "Result:") ||
    starts_with(clone(type_name), "Result<") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if starts_with(clone(type_name), "enum:") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if starts_with(clone(type_name), "struct:") {
        let struct_name = extract_struct_name_from_type_name(clone(type_name))
        if len(struct_name) > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(struct_name)) {
            return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(struct_name)))
        }
        let byte_size = parse_struct_byte_size(clone(type_name))
        if byte_size > 0 {
            return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type(ctx, byte_size))
        }
    }
    if ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(type_name)) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, type_name))
    }
    Option::None
}

fn infer_hashmap_gc_type_from_type_name(type_name: String, ctx: SelfEmitCtx) -> Option<i32> {
    if !starts_with(clone(type_name), "hashmap:") {
        return Option::None
    }
    if starts_with(clone(type_name), "hashmap:i32str") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_hashmap_i32_str_type(ctx))
    }
    if starts_with(clone(type_name), "hashmap:i32fn") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_hashmap_i32_fn_type(ctx))
    }
    if starts_with(clone(type_name), "hashmap:si32") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_hashmap_str_i32_type(ctx))
    }
    if starts_with(clone(type_name), "hashmap:strstr") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_hashmap_str_str_type(ctx))
    }
    if starts_with(clone(type_name), "hashmap:i32i32") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_type(ctx))
    }
    Option::Some(ctx_gc_type::SelfEmitCtx_hashmap_str_i32_type(ctx))
}

fn infer_vec_gc_type_from_type_name(type_name: String, ctx: SelfEmitCtx) -> Option<i32> {
    if eq(clone(type_name), "string") || eq(clone(type_name), "String") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_string_type(ctx))
    }
    if !starts_with(clone(type_name), "vec:") {
        return Option::None
    }
    if eq(clone(type_name), "vec:String") || eq(clone(type_name), "vec:string") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_string_type(ctx))
    }
    if eq(clone(type_name), "vec:v128") || eq(clone(type_name), "vec:V128") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_v128_type(ctx))
    }
    if eq(clone(type_name), "vec:i64") || eq(clone(type_name), "vec:I64") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx))
    }
    if eq(clone(type_name), "vec:f64") || eq(clone(type_name), "vec:F64") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx))
    }
    let elem_name = substring(clone(type_name), 4, len(type_name))
    if ctx_gc_type_vec_ref::gc_vec_elem_is_struct_ref(clone(elem_name)) {
        return Option::Some(ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx))
    }
    Option::Some(ctx_gc_type::SelfEmitCtx_vec_type(ctx))
}

fn extract_struct_name_from_type_name(type_name: String) -> String {
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let n = len(type_name)
    let mut i = 0
    while i < n {
        if char_at(type_name, i) == 58 {
            if first_colon < 0 {
                first_colon = i
            }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon < 0 || first_colon == last_colon {
        return String_new()
    }
    substring(type_name, first_colon + 1, last_colon)
}

fn parse_struct_byte_size(type_name: String) -> i32 {
    let n = len(type_name)
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if char_at(type_name, i) == 58 {
            last_colon = i
        }
        i = i + 1
    }
    if last_colon < 0 {
        return 0
    }
    let mut byte_size = 0
    let mut j = last_colon + 1
    while j < n {
        let d = char_at(type_name, j)
        if d >= 48 && d <= 57 {
            byte_size = byte_size * 10 + (d - 48)
        } else {
            j = n
        }
        j = j + 1
    }
    byte_size
}
