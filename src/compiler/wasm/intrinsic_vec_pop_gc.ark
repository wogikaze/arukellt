//
// GC target: Vec<T> = (struct (field (mut (ref null (array (mut i32))))
//                              (field (mut i32)))
//   pop: struct.get 1 (len) → decrement → struct.set 1 → struct.get 0 (data) → array.get

use wasm::opcodes
use wasm::ctx_scratch
use wasm::ctx_record
use wasm::emit_target
use wasm::writer_core
use wasm::writer_gc
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::intrinsic_vec_type
use wasm::intrinsic_vec_access
use wasm::intrinsics::helpers_core
use wasm::intrinsics::helpers_numeric_i32
use mir::inst_accessors_literals

fn emit_vec_pop_gc(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    let s_newlen = ctx_scratch::SelfEmitCtx_scratch_base(ctx)
    let s_opt = ctx_scratch::SelfEmitCtx_scratch_gc_enum_local(ctx, 0)
    let s_vec = ctx_scratch::SelfEmitCtx_scratch_gc_vec_local(ctx, 0)
    let callee = inst_accessors_literals::MirInst_str_val(inst)
    let vec_type = intrinsic_vec_type::resolve_vec_type_for_call(ctx, callee, inst)
    let array_type = intrinsic_vec_type::resolve_array_type_for_call(ctx, callee, inst)
    let is_vec_string = vec_type == ctx_gc_type::SelfEmitCtx_vec_string_type(ctx)
    let enum_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)

    // Step 1: Store vec_ref from stack into scratch local
    helpers_core::emit_local_set(w, s_vec)

    // Step 2: Get len, save to s_newlen
    helpers_core::emit_local_get(w, s_vec)
    writer_gc::emit_gc_ref_cast(w, vec_type)
    writer_gc::emit_gc_struct_get_i32(w, vec_type, 1)
    helpers_core::emit_local_tee(w, s_newlen)

    // Step 3: Check if len > 0
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_gt_u(w)
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)  // void block
    emit_vec_pop_some_branch(
        w,
        ctx,
        s_vec,
        vec_type,
        array_type,
        s_newlen,
        s_opt,
        is_vec_string,
        enum_type,
        callee,
        inst
    )
    writer_core::emit_byte(w, opcodes::OP_ELSE())
    emit_gc_pop_none(w, s_opt, enum_type, ctx)
    writer_core::emit_byte(w, opcodes::OP_END())

    // Load result from scratch
    helpers_core::emit_local_get(w, s_opt)
    return true
}

// Some branch: len > 0 — decrement, read data[new_len], wrap in Option::Some.
// Element-kind dispatch mirrors vec_get so pop covers fnref / struct / String /
// i64 / f64 payloads identically on the GC backend (#874).
fn emit_vec_pop_some_branch(
    w: WasmWriter,
    ctx: SelfEmitCtx,
    vec_local: i32,
    vec_type: i32,
    array_type: i32,
    s_newlen: i32,
    s_opt: i32,
    is_vec_string: bool,
    enum_type: i32,
    callee: String,
    inst: MirInst
) {
    let struct_ref_array_type = ctx_gc_type_vec_ref::SelfEmitCtx_struct_ref_array_type(ctx)
    let is_struct_ref_elem = array_type == struct_ref_array_type
    let is_i64_elem = array_type == ctx_gc_type::SelfEmitCtx_i64_array_type(ctx)
    let is_f64_elem = array_type == ctx_gc_type::SelfEmitCtx_f64_array_type(ctx)
    let is_fnref_elem = array_type == ctx_gc_type_vec_ref::SelfEmitCtx_fnref_array_type(ctx)
    // len was saved in s_newlen by local.tee in the caller.
    // new_len = len - 1
    helpers_core::emit_local_get(w, s_newlen)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_sub(w)
    helpers_core::emit_local_set(w, s_newlen)

    // vec.len = new_len
    helpers_core::emit_local_get(w, vec_local)
    writer_gc::emit_gc_ref_cast(w, vec_type)
    helpers_core::emit_local_get(w, s_newlen)
    writer_gc::emit_gc_struct_set_i32(w, vec_type, 1)

    // Read last element: data[new_len]
    helpers_core::emit_local_get(w, vec_local)
    writer_gc::emit_gc_ref_cast(w, vec_type)
    writer_gc::emit_gc_struct_get(w, vec_type, 0)
    helpers_core::emit_local_get(w, s_newlen)
    if !is_vec_string && !is_struct_ref_elem && !is_i64_elem && !is_f64_elem && !is_fnref_elem {
        writer_gc::emit_gc_array_get_i32(w, array_type)
    } else {
        writer_gc::emit_gc_array_get(w, array_type)
    }
    if is_vec_string || is_struct_ref_elem || is_fnref_elem {
        intrinsic_vec_access::emit_vec_get_gc_some_ref(
            w,
            ctx,
            s_opt,
            is_struct_ref_elem,
            is_vec_string,
            is_fnref_elem,
            enum_type,
            callee,
            inst
        )
        return
    }
    if is_i64_elem {
        intrinsic_vec_access::emit_vec_get_gc_some_scalar(
            w,
            ctx,
            s_opt,
            ctx_scratch::SelfEmitCtx_scratch_local(ctx, 15),
            "_f1_i64",
            enum_type
        )
        return
    }
    if is_f64_elem {
        intrinsic_vec_access::emit_vec_get_gc_some_scalar(
            w,
            ctx,
            s_opt,
            ctx_scratch::SelfEmitCtx_scratch_local(ctx, 12),
            "_f1_f64",
            enum_type
        )
        return
    }
    intrinsic_vec_access::emit_vec_get_gc_some_scalar(w, ctx, s_opt, s_newlen, "_f1_i32", enum_type)
}

fn emit_gc_pop_none(w: WasmWriter, s_optptr: i32, enum_type: i32, ctx: SelfEmitCtx) {
    // Allocate Option::None. struct.new_default leaves tag=0, which match
    // treats as Some — store tag=1 explicitly (same as vec_get_gc_none, #832).
    let none_type = ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, String_from("Option::None"))
    let none_type_idx = if none_type >= 0 { none_type } else { enum_type }
    writer_gc::emit_gc_struct_new_default(w, none_type_idx)
    helpers_core::emit_local_set(w, s_optptr)
    helpers_core::emit_local_get(w, s_optptr)
    writer_gc::emit_gc_ref_cast(w, none_type_idx)
    helpers_numeric_i32::emit_i32_const(w, 1)
    writer_gc::emit_gc_struct_set_i32(w, none_type_idx, 0)
}
