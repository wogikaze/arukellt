// Name-based intrinsic fallback when a Call-kind core_op has no linked
// impl symbol (clone/len/Vec_new DCE'd in large GC modules).

use mir::inst_accessors_operands
use wasm::inst_ctx
use wasm::inst_store
use wasm::ctx_record
use wasm::emit_target
use wasm::intrinsic_assert
use wasm::intrinsic_cast
use wasm::intrinsic_clock
use wasm::intrinsic_math
use wasm::runtime_abi_random
use wasm::intrinsic_string_basic
use wasm::intrinsic_string_affix
use wasm::intrinsic_string_contains_bytes
use wasm::intrinsic_string_from_bytes
use wasm::intrinsic_string_collection
use wasm::intrinsic_string_format
use wasm::intrinsic_vec
use wasm::intrinsic_vec_numeric
use wasm::intrinsic_vec_new_layout
use wasm::intrinsic_memory
use wasm::intrinsic_parse_f64
use wasm::intrinsic_parse_i64
use wasm::intrinsic_string_extra
use wasm::intrinsic_string_index_of
use wasm::intrinsic_string_replace_all
use wasm::intrinsic_string_transform
use wasm::intrinsic_sort
use wasm::runtime_abi_env_args

fn try_emit_clone_intrinsic(
    w: WasmWriter,
    callee: String,
    inst: MirInst,
    ctx: SelfEmitCtx,
    next_op: i32,
    next_arg0: i32,
    next_arg1: i32,
    next2_op: i32
) -> bool {
    if !is_clone_callee(clone(callee)) {
        return false
    }
    let on_stack = intrinsic_string_basic::emit_clone(w, inst, ctx)
    finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
}

fn try_emit_name_intrinsic_fallback(
    w: WasmWriter,
    callee: String,
    inst: MirInst,
    ctx: SelfEmitCtx,
    next_op: i32,
    next_arg0: i32,
    next_arg1: i32,
    next2_op: i32
) -> bool {
    if try_emit_clone_intrinsic(w, clone(callee), inst, ctx, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    // String::eq / __intrinsic_string_eq miss core_op → drop+unreachable (#807).
    if is_string_eq_callee(clone(callee)) {
        let on_stack = intrinsic_math::emit_string_eq_intrinsic(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // i64 widen/narrow + assert_eq_i64 often miss core_op binding on GC (#807).
    if is_i32_to_i64_callee(clone(callee)) {
        let on_stack = intrinsic_cast::emit_i32_to_i64(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_i64_to_i32_callee(clone(callee)) {
        let on_stack = intrinsic_cast::emit_i64_to_i32(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_assert_eq_i64_callee(clone(callee)) {
        let on_stack = intrinsic_assert::emit_assert_eq_i64(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // Bare assert_eq / assert_ne miss core_op → drop+unreachable; most i32
    // fixture assertions take this path (#807 io/bytes/trait clusters).
    if is_assert_eq_callee(clone(callee)) {
        let on_stack = intrinsic_assert::emit_assert_eq(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_assert_ne_callee(clone(callee)) {
        let on_stack = intrinsic_assert::emit_assert_ne(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_assert_eq_str_callee(clone(callee)) {
        // Linear-memory assert_eq_str traps on GC strings; compare via
        // string_eq then assert the bool (#807).
        if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
            let _eq_on_stack = intrinsic_math::emit_string_eq_intrinsic(w, inst, ctx)
            let on_stack = intrinsic_assert::emit_assert(w, inst, ctx)
            return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
        }
        let on_stack = intrinsic_assert::emit_assert_eq_str(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_len_callee(clone(callee)) {
        let on_stack = intrinsic_string_basic::emit_len(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // Std builder_append / write_debug_to bodies call __intrinsic_concat; when
    // core_op rewrite misses, drop+unreachable traps (#807 text/debug clusters).
    if is_concat_callee(clone(callee)) {
        let on_stack = intrinsic_string_basic::emit_concat(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // text.string_from_bytes is normal_call→__core_string_from_bytes_impl, but
    // the impl is often DCE'd; emit the GC/linear intrinsic instead (#807).
    if is_string_from_bytes_callee(clone(callee)) {
        let on_stack = intrinsic_string_from_bytes::emit_string_from_bytes(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // Same class: i64 format Ark body deferred/DCE'd → use intrinsic (#807).
    if is_format_i64_callee(clone(callee)) {
        let on_stack = intrinsic_string_format::emit_i64_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // Display::to_string for bool/f64 inlines to __intrinsic_* and misses
    // core_op → drop+unreachable. json_parse / 0.001.to_string trap (#807).
    if is_format_bool_callee(clone(callee)) {
        let on_stack = intrinsic_string_basic::emit_bool_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_format_f64_callee(clone(callee)) {
        let on_stack = intrinsic_string_format::emit_f64_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // i32 field `.to_string()` (Point.x) misses core_op after struct.get and
    // becomes drop+unreachable. Keep i64's named fallback and the default
    // i32 formatter used by core_op_handler_text_to_string.
    if is_format_i32_callee(clone(callee)) {
        let on_stack = intrinsic_string_format::emit_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // path::normalize uses __intrinsic_split/join; core_op miss → unreachable (#807).
    if is_split_callee(clone(callee)) {
        let on_stack = intrinsic_string_collection::emit_split(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_string_join_callee(clone(callee)) {
        let on_stack = intrinsic_string_collection::emit_join(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_vec_pop_callee(clone(callee)) {
        let on_stack = intrinsic_vec::emit_vec_pop(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // Bare / rewritten `push` misses core_op and becomes drop+unreachable.
    // That traps NameIndex_new (and every unannotated Vec<i32> push) on s3.
    if is_vec_push_i64_callee(clone(callee)) {
        let on_stack = intrinsic_vec_numeric::emit_push_i64(w, inst, ctx, true)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_vec_push_f64_callee(clone(callee)) {
        let on_stack = intrinsic_vec_numeric::emit_push_f64(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_vec_push_callee(clone(callee)) {
        let on_stack = intrinsic_vec::emit_push(w, inst, ctx, true, next_op)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // Associated Vec::new / Vec::with_capacity fallback when MIR body is DCE'd (#845).
    if is_vec_new_callee(clone(callee)) {
        intrinsic_vec_new_layout::emit_vec_new_layout(w, 32, 44, inst, ctx)
        inst_ctx::ctx_mark_vec_local(ctx, inst_accessors_operands::MirInst_dest(inst))
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
    }
    // Same class of miss: string predicates used by loader / name helpers.
    if is_contains_callee(clone(callee)) {
        let on_stack = intrinsic_string_contains_bytes::emit_contains(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_starts_with_callee(clone(callee)) {
        let on_stack = intrinsic_string_affix::emit_starts_with(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_ends_with_callee(clone(callee)) {
        let on_stack = intrinsic_string_affix::emit_ends_with(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // KEEP_CLOCK / --time: when registry binding is missing, unresolved call
    // emit produced `unreachable` + `return` of an i32 local into an i64
    // result (mir_lower_phase_now validate fail). Emit the real clock body.
    if is_clock_now_callee(clone(callee)) {
        let on_stack = intrinsic_clock::emit_clock_now(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_clock_now_ms_callee(clone(callee)) {
        let on_stack = intrinsic_clock::emit_clock_now_ms(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // Same unresolved-intrinsic hole as clock: `__runtime_abi_random_i32` can
    // miss core_op and become `unreachable` (#807 wasi_random / clock_random).
    if is_random_i32_callee(clone(callee)) {
        let on_stack = runtime_abi_random::emit_random_i32(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // Bulk memory: mir_op binding is forbidden/missed → drop+unreachable (#807).
    // Args are already on the stack from CALL lowering.
    if is_memory_fill_callee(clone(callee)) {
        let on_stack = intrinsic_memory::emit_memory_fill(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_memory_copy_callee(clone(callee)) {
        let on_stack = intrinsic_memory::emit_memory_copy(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // CLI/env argv: core_op rewrite miss → unreachable (#807 cli_flag_check).
    if is_arg_count_callee(clone(callee)) {
        let on_stack = runtime_abi_env_args::emit_env_arg_count(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_args_callee(clone(callee)) {
        let on_stack = runtime_abi_env_args::emit_env_args(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_has_flag_callee(clone(callee)) {
        let on_stack = runtime_abi_env_args::emit_env_has_flag(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_arg_at_callee(clone(callee)) {
        let on_stack = runtime_abi_env_args::emit_env_arg_at(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // parse.parse_f64 is normal_call → __core_parse_f64_impl, but the impl is
    // often DCE'd and the CALL has no core_op_id. Unresolved fallback is
    // drop+unreachable, so JSON number parse traps in main.
    if is_parse_f64_callee(clone(callee)) {
        let on_stack = intrinsic_parse_f64::emit_parse_f64(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    // text / seq names miss core_op after DCE and become drop+unreachable
    // (file_io String_new, text_ops trim, template substring, sort_i32).
    if is_string_new_callee(clone(callee)) {
        let on_stack = intrinsic_string_format::emit_String_new(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_trim_callee(clone(callee)) {
        let on_stack = intrinsic_string_extra::emit_trim(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_substring_callee(clone(callee)) {
        let on_stack = intrinsic_string_collection::emit_slice(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_sort_i32_callee(clone(callee)) {
        let on_stack = intrinsic_sort::emit_sort_i32(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_replace_callee(clone(callee)) {
        let on_stack = intrinsic_string_replace_all::emit_replace(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_repeat_callee(clone(callee)) {
        let on_stack = intrinsic_string_transform::emit_repeat(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_to_upper_callee(clone(callee)) {
        let on_stack = intrinsic_string_transform::emit_to_upper(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_to_lower_callee(clone(callee)) {
        let on_stack = intrinsic_string_transform::emit_to_lower(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_index_of_callee(clone(callee)) {
        let on_stack = intrinsic_string_index_of::emit_index_of(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_char_to_string_callee(clone(callee)) {
        let on_stack = intrinsic_string_format::emit_char_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_parse_i64_callee(clone(callee)) {
        let on_stack = intrinsic_parse_i64::emit_parse_i64(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    false
}

fn is_has_flag_callee(callee: String) -> bool {
    eq(clone(callee), String_from("has_flag")) ||
    eq(clone(callee), String_from("__intrinsic_has_flag")) ||
    ends_with(clone(callee), String_from("::has_flag"))
}

fn is_string_new_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("String_new")) ||
    callee_name_is(clone(callee), String_from("string_new")) ||
    callee_name_is(clone(callee), String_from("__core_string_new_impl")) ||
    callee_name_is(clone(callee), String_from("__intrinsic_string_new")) ||
    ends_with(clone(callee), String_from("::String_new")) ||
    ends_with(clone(callee), String_from("::string_new"))
}

fn is_trim_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("trim")) ||
    callee_name_is(clone(callee), String_from("text::trim")) ||
    callee_name_is(clone(callee), String_from("__core_string_trim_impl")) ||
    ends_with(clone(callee), String_from("::trim"))
}

fn is_substring_callee(callee: String) -> bool {
    // Do not match Vec::slice / generic slice — those are not string views.
    callee_name_is(clone(callee), String_from("substring")) ||
    callee_name_is(clone(callee), String_from("text::substring")) ||
    callee_name_is(clone(callee), String_from("slice")) ||
    callee_name_is(clone(callee), String_from("text::slice")) ||
    callee_name_is(clone(callee), String_from("string::slice")) ||
    callee_name_is(clone(callee), String_from("__core_string_slice_impl")) ||
    ends_with(clone(callee), String_from("::substring"))
}

fn is_sort_i32_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("sort_i32")) ||
    callee_name_is(clone(callee), String_from("__core_sort_i32_impl")) ||
    callee_name_is(clone(callee), String_from("__core_seq_sort_i32_impl")) ||
    ends_with(clone(callee), String_from("::sort_i32"))
}

fn is_replace_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("replace")) ||
    callee_name_is(clone(callee), String_from("text::replace")) ||
    callee_name_is(clone(callee), String_from("__core_string_replace_impl")) ||
    ends_with(clone(callee), String_from("::replace"))
}

fn is_repeat_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("repeat")) ||
    callee_name_is(clone(callee), String_from("text::repeat")) ||
    callee_name_is(clone(callee), String_from("__core_string_repeat_impl")) ||
    ends_with(clone(callee), String_from("::repeat"))
}

fn is_to_upper_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("to_upper")) ||
    callee_name_is(clone(callee), String_from("to_uppercase")) ||
    callee_name_is(clone(callee), String_from("text::to_upper")) ||
    ends_with(clone(callee), String_from("::to_upper")) ||
    ends_with(clone(callee), String_from("::to_uppercase"))
}

fn is_to_lower_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("to_lower")) ||
    callee_name_is(clone(callee), String_from("to_lowercase")) ||
    callee_name_is(clone(callee), String_from("text::to_lower")) ||
    ends_with(clone(callee), String_from("::to_lower")) ||
    ends_with(clone(callee), String_from("::to_lowercase"))
}

fn is_index_of_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("index_of")) ||
    callee_name_is(clone(callee), String_from("text::index_of")) ||
    ends_with(clone(callee), String_from("::index_of"))
}

fn is_parse_i64_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("parse_i64")) ||
    callee_name_is(clone(callee), String_from("__core_parse_i64_impl")) ||
    callee_name_is(clone(callee), String_from("raw_parse_i64")) ||
    callee_name_is(clone(callee), String_from("raw::raw_parse_i64")) ||
    callee_name_is(clone(callee), String_from("__intrinsic_parse_i64")) ||
    ends_with(clone(callee), String_from("::parse_i64"))
}

fn is_char_to_string_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("char_to_string")) ||
    callee_name_is(clone(callee), String_from("text::char_to_string")) ||
    callee_name_is(clone(callee), String_from("__core_char_to_string_impl")) ||
    ends_with(clone(callee), String_from("::char_to_string"))
}

fn is_parse_f64_callee(callee: String) -> bool {
    // Result<f64, String> sealed parse only. Do not match convert::parse_f64
    // (Option<f64> wrapper with a real Ark body).
    callee_name_is(clone(callee), String_from("parse_f64")) ||
    callee_name_is(clone(callee), String_from("__core_parse_f64_impl")) ||
    callee_name_is(clone(callee), String_from("raw_parse_f64")) ||
    callee_name_is(clone(callee), String_from("raw::raw_parse_f64")) ||
    callee_name_is(clone(callee), String_from("__intrinsic_parse_f64")) ||
    callee_name_is(clone(callee), String_from("text::parse_f64"))
}

fn is_arg_at_callee(callee: String) -> bool {
    eq(clone(callee), String_from("arg_at")) ||
    eq(clone(callee), String_from("__intrinsic_arg_at")) ||
    ends_with(clone(callee), String_from("::arg_at"))
}

fn is_arg_count_callee(callee: String) -> bool {
    eq(clone(callee), String_from("arg_count")) ||
