// Intrinsic fallback for a Call-kind core_op whose implementation symbol was
// removed by DCE. Resolve the spelling to a CoreOp handler before emitting.

use corehir::core_op_binding
use corehir::core_op_id
use corehir::core_op_registry_generated
use mir::inst_accessors_operands
use wasm::inst_ctx
use wasm::inst_store
use wasm::ctx_record
use wasm::emit_target
use wasm::intrinsic_assert
use wasm::intrinsic_cast
use wasm::intrinsic_clock
use wasm::intrinsic_math
use wasm::runtime_abi_random
use wasm::intrinsic_string_basic
use wasm::intrinsic_string_access
use wasm::intrinsic_string_affix
use wasm::intrinsic_string_contains_bytes
use wasm::intrinsic_string_from_bytes
use wasm::intrinsic_string_collection
use wasm::intrinsic_string_format
use wasm::intrinsic_vec
use wasm::intrinsic_vec_numeric
use wasm::intrinsic_vec_new_layout
use wasm::intrinsic_memory
use wasm::runtime_abi_env_args

fn try_emit_clone_intrinsic(
    w: WasmWriter,
    callee: String,
    inst: MirInst,
    ctx: SelfEmitCtx,
    next_op: i32,
    next_arg0: i32,
    next_arg1: i32,
    next2_op: i32
) -> bool {
    let handler_id = resolve_intrinsic_fallback_handler_id(clone(callee))
    if !is_clone_handler(handler_id) {
        return false
    }
    let on_stack = intrinsic_string_basic::emit_clone(w, inst, ctx)
    finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
}

fn try_emit_name_intrinsic_fallback(
    w: WasmWriter,
    callee: String,
    inst: MirInst,
    ctx: SelfEmitCtx,
    next_op: i32,
    next_arg0: i32,
    next_arg1: i32,
    next2_op: i32
) -> bool {
    if try_emit_clone_intrinsic(w, clone(callee), inst, ctx, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    let handler_id = resolve_intrinsic_fallback_handler_id(clone(callee))
    // Vec::new has no CoreOp by design: ADR-040 removed the old constructor
    // operations. Keep its one backend-only fallback ID out of the registry.
    if is_vec_new_handler(handler_id) {
        intrinsic_vec_new_layout::emit_vec_new_layout(w, 32, 44, inst, ctx)
        inst_ctx::ctx_mark_vec_local(ctx, inst_accessors_operands::MirInst_dest(inst))
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
    }
    if handler_id < 0 {
        return false
    }
    if handler_id == core_op_registry_generated::core_op_handler_text_to_string() {
        let on_stack = intrinsic_string_format::emit_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_f64_to_string_handler(handler_id) {
        let on_stack = intrinsic_string_format::emit_f64_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_text_f32_to_string() {
        let on_stack = intrinsic_string_format::emit_f32_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_text_format_bool() {
        let on_stack = intrinsic_string_basic::emit_bool_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_text_char_to_string() {
        let on_stack = intrinsic_string_format::emit_char_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_string_new_handler(handler_id) {
        let on_stack = intrinsic_string_format::emit_String_new(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_text_string_eq() {
        let on_stack = intrinsic_math::emit_string_eq_intrinsic(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_i32_to_i64() {
        let on_stack = intrinsic_cast::emit_i32_to_i64(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_i64_to_i32() {
        let on_stack = intrinsic_cast::emit_i64_to_i32(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_assert_eq_i64() {
        let on_stack = intrinsic_assert::emit_assert_eq_i64(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_assert_eq() {
        let on_stack = intrinsic_assert::emit_assert_eq(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_assert_ne() {
        let on_stack = intrinsic_assert::emit_assert_ne(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_assert_eq_str() {
        // Linear-memory assert_eq_str cannot inspect GC strings directly. The
        // string comparison intrinsic produces the bool needed by assert.
        if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
            let _eq_on_stack = intrinsic_math::emit_string_eq_intrinsic(w, inst, ctx)
            let on_stack = intrinsic_assert::emit_assert(w, inst, ctx)
            return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
        }
        let on_stack = intrinsic_assert::emit_assert_eq_str(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_len_handler(handler_id) {
        let on_stack = intrinsic_string_basic::emit_len(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_byte_at_handler(handler_id) {
        let on_stack = intrinsic_string_access::emit_char_at(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_string_concat() {
        let on_stack = intrinsic_string_basic::emit_concat(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_string_from_bytes_handler(handler_id) {
        let on_stack = intrinsic_string_from_bytes::emit_string_from_bytes(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_text_format_i64() {
        let on_stack = intrinsic_string_format::emit_i64_to_string(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_string_split() {
        let on_stack = intrinsic_string_collection::emit_split(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_string_join() {
        let on_stack = intrinsic_string_collection::emit_join(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_vec_pop() {
        let on_stack = intrinsic_vec::emit_vec_pop(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_vec_push_i64() {
        let on_stack = intrinsic_vec_numeric::emit_push_i64(w, inst, ctx, true)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_vec_push_f64() {
        let on_stack = intrinsic_vec_numeric::emit_push_f64(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_vec_push() {
        let on_stack = intrinsic_vec::emit_push(w, inst, ctx, true, next_op)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_vec_get_unchecked_handler(handler_id) {
        let on_stack = intrinsic_vec::emit_get_unchecked(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_vec_get() {
        let on_stack = intrinsic_vec::emit_vec_get(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_vec_set_handler(handler_id) {
        let on_stack = intrinsic_vec::emit_vec_set(w, inst, ctx, true)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if is_vec_len_handler(handler_id) {
        let on_stack = intrinsic_vec::emit_vec_len(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_string_contains() {
        let on_stack = intrinsic_string_contains_bytes::emit_contains(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_string_starts_with() {
        let on_stack = intrinsic_string_affix::emit_starts_with(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_string_ends_with() {
        let on_stack = intrinsic_string_affix::emit_ends_with(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_clock_now() {
        let on_stack = intrinsic_clock::emit_clock_now(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_clock_now_ms() {
        let on_stack = intrinsic_clock::emit_clock_now_ms(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_random_i32() {
        let on_stack = runtime_abi_random::emit_random_i32(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_primitive_memory_fill() {
        let on_stack = intrinsic_memory::emit_memory_fill(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_primitive_memory_copy() {
        let on_stack = intrinsic_memory::emit_memory_copy(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_arg_count() {
        let on_stack = runtime_abi_env_args::emit_env_arg_count(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_args() {
        let on_stack = runtime_abi_env_args::emit_env_args(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_has_flag() {
        let on_stack = runtime_abi_env_args::emit_env_has_flag(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    if handler_id == core_op_registry_generated::core_op_handler_runtime_arg_at() {
        let on_stack = runtime_abi_env_args::emit_env_arg_at(w, inst, ctx)
        return finish_intrinsic_fallback(w, inst, next_op, next_arg0, next_arg1, next2_op, on_stack)
    }
    false
}

fn resolve_intrinsic_fallback_handler_id(callee: String) -> i32 {
    // Generated handler accessors are metadata, not callable intrinsics.
    if contains(clone(callee), String_from("core_op_handler_")) {
        return 0 - 1
    }
    let coid = core_op_binding::core_op_binding_lookup_for_callee(clone(callee))
    if core_op_id::core_op_id_is_some(coid) {
        return core_op_id::CoreOpId_raw(coid)
    }
    resolve_pattern_fallback_handler_id(clone(callee))
}

fn resolve_pattern_fallback_handler_id(callee: String) -> i32 {
    if is_vec_new_pattern(clone(callee)) {
        return fallback_vec_new_handler_id()
    }
    // Box has no distinct Wasm representation. Its constructor and extractor
    // are identity operations, so they share the normal clone handler.
    if starts_with(clone(callee), String_from("Box_new")) ||
    starts_with(clone(callee), String_from("unbox")) {
        return core_op_registry_generated::core_op_handler_text_clone()
    }
    if starts_with(clone(callee), String_from("__intrinsic_string_eq")) ||
    ends_with(clone(callee), String_from("String::eq")) ||
    ends_with(clone(callee), String_from("string_eq")) {
        return core_op_registry_generated::core_op_handler_text_string_eq()
    }
    if starts_with(clone(callee), String_from("format_i32")) ||
    starts_with(clone(callee), String_from("i32::to_string__")) ||
    ends_with(clone(callee), String_from("::i32_to_string")) ||
    ends_with(clone(callee), String_from("i32_to_string")) {
        return core_op_registry_generated::core_op_handler_text_to_string()
    }
    if starts_with(clone(callee), String_from("format_f64")) ||
    starts_with(clone(callee), String_from("f64::to_string")) ||
    ends_with(clone(callee), String_from("::f64_to_string")) {
        return core_op_registry_generated::core_op_handler_text_format_f64()
    }
    if starts_with(clone(callee), String_from("__intrinsic_f32_to_string")) ||
    starts_with(clone(callee), String_from("f32::to_string")) ||
    ends_with(clone(callee), String_from("::f32_to_string")) {
        return core_op_registry_generated::core_op_handler_text_f32_to_string()
    }
    if starts_with(clone(callee), String_from("bool::to_string")) ||
    ends_with(clone(callee), String_from("::bool_to_string")) {
        return core_op_registry_generated::core_op_handler_text_format_bool()
    }
    if starts_with(clone(callee), String_from("char::to_string")) ||
    ends_with(clone(callee), String_from("::char_to_string")) {
        return core_op_registry_generated::core_op_handler_text_char_to_string()
    }
    if starts_with(clone(callee), String_from("String_new")) {
        return core_op_registry_generated::core_op_handler_text_String_new()
    }
    if starts_with(clone(callee), String_from("__intrinsic_i32_to_i64")) ||
    ends_with(clone(callee), String_from("i32_to_i64")) {
        return core_op_registry_generated::core_op_handler_runtime_i32_to_i64()
    }
    if starts_with(clone(callee), String_from("__intrinsic_i64_to_i32")) ||
    ends_with(clone(callee), String_from("i64_to_i32")) {
        return core_op_registry_generated::core_op_handler_runtime_i64_to_i32()
    }
    if ends_with(clone(callee), String_from("assert_eq_i64")) {
        return core_op_registry_generated::core_op_handler_runtime_assert_eq_i64()
    }
    if ends_with(clone(callee), String_from("assert_eq_str")) {
        return core_op_registry_generated::core_op_handler_runtime_assert_eq_str()
    }
    if ends_with(clone(callee), String_from("assert_eq_i32")) ||
    ends_with(clone(callee), String_from("assert_eq")) {
        return core_op_registry_generated::core_op_handler_runtime_assert_eq()
    }
    if ends_with(clone(callee), String_from("assert_ne")) {
        return core_op_registry_generated::core_op_handler_runtime_assert_ne()
    }
    if starts_with(clone(callee), String_from("len_bytes")) ||
    ends_with(clone(callee), String_from("::len_bytes")) ||
    ends_with(clone(callee), String_from("__len_bytes")) {
        return core_op_registry_generated::core_op_handler_text_len_bytes()
    }
    if starts_with(clone(callee), String_from("byte_len")) ||
    ends_with(clone(callee), String_from("::byte_len")) {
        return core_op_registry_generated::core_op_handler_string_len()
    }
    if starts_with(clone(callee), String_from("__intrinsic_len")) ||
    ends_with(clone(callee), String_from("::len")) ||
    ends_with(clone(callee), String_from("__len")) {
        return core_op_registry_generated::core_op_handler_string_len()
    }
    if starts_with(clone(callee), String_from("byte_at")) ||
    starts_with(clone(callee), String_from("__intrinsic_byte_at")) ||
    ends_with(clone(callee), String_from("::byte_at")) {
        return core_op_registry_generated::core_op_handler_raw_string_byte_at_unchecked()
    }
    if starts_with(clone(callee), String_from("__intrinsic_concat")) ||
    ends_with(clone(callee), String_from("::concat")) {
        return core_op_registry_generated::core_op_handler_string_concat()
    }
    if ends_with(clone(callee), String_from("::string_from_bytes")) ||
    ends_with(clone(callee), String_from("::raw_string_from_bytes")) {
        return core_op_registry_generated::core_op_handler_raw_string_from_bytes()
    }
    if starts_with(clone(callee), String_from("format_i64")) ||
    ends_with(clone(callee), String_from("::format_i64")) ||
    ends_with(clone(callee), String_from("::i64_to_string")) {
        return core_op_registry_generated::core_op_handler_text_format_i64()
    }
    if ends_with(clone(callee), String_from("::split")) {
        return core_op_registry_generated::core_op_handler_string_split()
    }
    // path::join is a filesystem operation, not String.join.
    if ends_with(clone(callee), String_from("path::join")) {
        return 0 - 1
    }
    if ends_with(clone(callee), String_from("::join")) {
        return core_op_registry_generated::core_op_handler_string_join()
    }
    if starts_with(clone(callee), String_from("pop")) ||
    ends_with(clone(callee), String_from("::pop")) ||
    ends_with(clone(callee), String_from("::vec_pop")) {
        return core_op_registry_generated::core_op_handler_vec_pop()
    }
    if starts_with(clone(callee), String_from("vec_push_i64")) ||
    ends_with(clone(callee), String_from("::push_i64")) {
        return core_op_registry_generated::core_op_handler_vec_push_i64()
    }
    if starts_with(clone(callee), String_from("vec_push_f64")) ||
    ends_with(clone(callee), String_from("::push_f64")) {
        return core_op_registry_generated::core_op_handler_vec_push_f64()
    }
    if starts_with(clone(callee), String_from("Vec::push")) ||
    starts_with(clone(callee), String_from("Vec__push")) ||
    starts_with(clone(callee), String_from("push__")) ||
    starts_with(clone(callee), String_from("__core_vec_push_")) ||
    ends_with(clone(callee), String_from("::push")) {
        return core_op_registry_generated::core_op_handler_vec_push()
    }
    if ends_with(clone(callee), String_from("get_unchecked_i64")) {
        return core_op_registry_generated::core_op_handler_vec_get_unchecked_i64()
    }
    if ends_with(clone(callee), String_from("get_unchecked_f64")) {
        return core_op_registry_generated::core_op_handler_vec_get_unchecked_f64()
    }
    if starts_with(clone(callee), String_from("get_unchecked__")) ||
    ends_with(clone(callee), String_from("::get_unchecked")) {
        return core_op_registry_generated::core_op_handler_vec_get_unchecked()
    }
    if contains(clone(callee), String_from("get_var")) {
        return 0 - 1
    }
    if starts_with(clone(callee), String_from("__intrinsic_get")) ||
    starts_with(clone(callee), String_from("get__")) ||
    (len(callee) == 3 && starts_with(clone(callee), String_from("get"))) ||
    ends_with(clone(callee), String_from("::get")) {
        return core_op_registry_generated::core_op_handler_vec_get()
    }
    if starts_with(clone(callee), String_from("Vec::set")) ||
    starts_with(clone(callee), String_from("Vec__set")) ||
    starts_with(clone(callee), String_from("set__")) {
        return core_op_registry_generated::core_op_handler_vec_set()
    }
    if starts_with(clone(callee), String_from("Vec::len")) ||
    starts_with(clone(callee), String_from("Vec__len")) {
        return core_op_registry_generated::core_op_handler_vec_len()
    }
    if ends_with(clone(callee), String_from("::contains")) {
        return core_op_registry_generated::core_op_handler_string_contains()
    }
    if ends_with(clone(callee), String_from("::starts_with")) {
        return core_op_registry_generated::core_op_handler_string_starts_with()
    }
    if ends_with(clone(callee), String_from("::ends_with")) {
        return core_op_registry_generated::core_op_handler_string_ends_with()
    }
    if starts_with(clone(callee), String_from("monotonic_now")) ||
    ends_with(clone(callee), String_from("::monotonic_now")) ||
    ends_with(clone(callee), String_from("::clock_now")) {
        return core_op_registry_generated::core_op_handler_runtime_clock_now()
    }
    if starts_with(clone(callee), String_from("now_ms")) ||
    ends_with(clone(callee), String_from("::now_ms")) ||
    ends_with(clone(callee), String_from("::clock_now_ms")) {
        return core_op_registry_generated::core_op_handler_runtime_clock_now_ms()
    }
    if starts_with(clone(callee), String_from("__intrinsic_random_i32")) ||
    ends_with(clone(callee), String_from("::random_i32")) {
        return core_op_registry_generated::core_op_handler_runtime_random_i32()
    }
    if starts_with(clone(callee), String_from("memory_fill")) ||
    starts_with(clone(callee), String_from("__intrinsic_memory_fill")) ||
    ends_with(clone(callee), String_from("::memory_fill")) {
        return core_op_registry_generated::core_op_handler_primitive_memory_fill()
    }
    if starts_with(clone(callee), String_from("memory_copy")) ||
    starts_with(clone(callee), String_from("__intrinsic_memory_copy")) ||
    ends_with(clone(callee), String_from("::memory_copy")) {
        return core_op_registry_generated::core_op_handler_primitive_memory_copy()
    }
    if starts_with(clone(callee), String_from("arg_count")) ||
    starts_with(clone(callee), String_from("__intrinsic_arg_count")) ||
    ends_with(clone(callee), String_from("::arg_count")) {
        return core_op_registry_generated::core_op_handler_runtime_arg_count()
    }
    if starts_with(clone(callee), String_from("args")) ||
    starts_with(clone(callee), String_from("__intrinsic_args")) ||
    ends_with(clone(callee), String_from("::args")) {
        return core_op_registry_generated::core_op_handler_runtime_args()
    }
    if starts_with(clone(callee), String_from("has_flag")) ||
    starts_with(clone(callee), String_from("__intrinsic_has_flag")) ||
    ends_with(clone(callee), String_from("::has_flag")) {
        return core_op_registry_generated::core_op_handler_runtime_has_flag()
    }
    if starts_with(clone(callee), String_from("arg_at")) ||
    starts_with(clone(callee), String_from("__intrinsic_arg_at")) ||
    ends_with(clone(callee), String_from("::arg_at")) {
        return core_op_registry_generated::core_op_handler_runtime_arg_at()
    }
    0 - 1
}

fn fallback_vec_new_handler_id() -> i32 {
    0 - 2
}

fn is_vec_new_pattern(callee: String) -> bool {
    starts_with(clone(callee), String_from("Vec_new")) ||
    starts_with(clone(callee), String_from("Vec::new")) ||
    starts_with(clone(callee), String_from("Vec__new")) ||
    starts_with(clone(callee), String_from("Vec_with_capacity")) ||
    starts_with(clone(callee), String_from("Vec::with_capacity")) ||
    starts_with(clone(callee), String_from("Vec__with_capacity")) ||
    starts_with(clone(callee), String_from("__intrinsic_Vec_new_")) ||
    contains(clone(callee), String_from("::Vec_new_")) ||
    ends_with(clone(callee), String_from("Vec_new_fallback"))
}

fn is_clone_handler(handler_id: i32) -> bool {
    handler_id == core_op_registry_generated::core_op_handler_text_clone() ||
    handler_id == core_op_registry_generated::core_op_handler_raw_string_clone()
}

fn is_f64_to_string_handler(handler_id: i32) -> bool {
    handler_id == core_op_registry_generated::core_op_handler_text_format_f64() ||
    handler_id == core_op_registry_generated::core_op_handler_raw_f64_to_string()
}

fn is_string_new_handler(handler_id: i32) -> bool {
    handler_id == core_op_registry_generated::core_op_handler_text_String_new() ||
    handler_id == core_op_registry_generated::core_op_handler_raw_string_new()
}

fn is_len_handler(handler_id: i32) -> bool {
    handler_id == core_op_registry_generated::core_op_handler_string_len() ||
    handler_id == core_op_registry_generated::core_op_handler_text_len_bytes() ||
    handler_id == core_op_registry_generated::core_op_handler_raw_string_len_bytes()
}

fn is_byte_at_handler(handler_id: i32) -> bool {
    handler_id == core_op_registry_generated::core_op_handler_string_char_at() ||
    handler_id == core_op_registry_generated::core_op_handler_raw_string_byte_at_unchecked()
}

fn is_string_from_bytes_handler(handler_id: i32) -> bool {
    handler_id == core_op_registry_generated::core_op_handler_text_string_from_bytes() ||
    handler_id == core_op_registry_generated::core_op_handler_raw_string_from_bytes()
}

fn is_vec_new_handler(handler_id: i32) -> bool {
    handler_id == fallback_vec_new_handler_id()
}

fn is_vec_get_unchecked_handler(handler_id: i32) -> bool {
    handler_id == core_op_registry_generated::core_op_handler_raw_array_get_unchecked() ||
    handler_id == core_op_registry_generated::core_op_handler_vec_get_unchecked()
}

fn is_vec_set_handler(handler_id: i32) -> bool {
    handler_id == core_op_registry_generated::core_op_handler_raw_array_set_unchecked() ||
    handler_id == core_op_registry_generated::core_op_handler_vec_set()
}

fn is_vec_len_handler(handler_id: i32) -> bool {
    handler_id == core_op_registry_generated::core_op_handler_raw_array_len() ||
    handler_id == core_op_registry_generated::core_op_handler_vec_len()
}

fn finish_intrinsic_fallback(
    w: WasmWriter,
    inst: MirInst,
    next_op: i32,
    next_arg0: i32,
    next_arg1: i32,
    next2_op: i32,
    result_on_stack: bool
) -> bool {
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, result_on_stack)
    true
}
