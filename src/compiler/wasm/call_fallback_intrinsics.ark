}

fn is_vec_new_callee(callee: String) -> bool {
    // Associated Vec::new / Vec::new__T / with_capacity (#845).
    // mono_safe_name rewrites "::" to "_", so also match Vec__new__T.
    if eq(clone(callee), String_from("Vec::new")) ||
    starts_with(clone(callee), String_from("Vec::new__")) ||
    eq(clone(callee), String_from("Vec__new")) ||
    starts_with(clone(callee), String_from("Vec__new__")) {
        return true
    }
    if eq(clone(callee), String_from("Vec::with_capacity")) ||
    starts_with(clone(callee), String_from("Vec::with_capacity__")) ||
    eq(clone(callee), String_from("Vec__with_capacity")) ||
    starts_with(clone(callee), String_from("Vec__with_capacity__")) {
        return true
    }
    false
}

fn is_contains_callee(callee: String) -> bool {
    eq(clone(callee), String_from("contains")) ||
    eq(clone(callee), String_from("__intrinsic_contains")) ||
    eq(clone(callee), String_from("__core_string_contains_impl")) ||
    ends_with(clone(callee), String_from("::contains"))
}

fn is_starts_with_callee(callee: String) -> bool {
    eq(clone(callee), String_from("starts_with")) ||
    ends_with(clone(callee), String_from("::starts_with"))
}

