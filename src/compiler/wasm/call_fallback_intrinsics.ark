fn callee_name_is(callee: String, name: String) -> bool {
    let left = clone(callee)
    eq(left, clone(name))
}

fn is_format_bool_callee(callee: String) -> bool {
    callee_name_is(clone(callee), String_from("bool_to_string")) ||
    callee_name_is(clone(callee), String_from("__core_format_bool_impl")) ||
    callee_name_is(clone(callee), String_from("__intrinsic_bool_to_string")) ||
    callee_name_is(clone(callee), String_from("bool::to_string")) ||
    callee_name_is(clone(callee), String_from("convert::bool_to_string")) ||
    ends_with(clone(callee), String_from("::bool_to_string"))
}

