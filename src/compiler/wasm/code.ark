use wasm::linear_gc_runtime
fn emit_function_inst_count(f: MirFunction) -> i32 {
    let block_count = function_block_queries::MirFunction_block_count(f)
    let mut total = 0
    let mut bi = 0
    while bi < block_count {
        total = total + block_inst_access::MirBlock_inst_count(
            function_block_queries::MirFunction_block_at(f, bi)
        )
        bi = bi + 1
    }
    total
}

fn emit_slow_fn_note(enabled: i32, idx: i32, f: MirFunction, t_start: i64) -> bool {
    if enabled == 0 {
        return false
    }
    let diff = Clock::monotonic_now() - t_start
    let ms = if diff < 0i64 { 0 } else { i64_to_i32(diff / 1000000i64) }
    if ms < 200 {
        return false
    }
    stdio::eprintln(
        "[arukellt] emit.slow_fn: idx=".concat(
            to_string(idx).concat(" insts=".concat(to_string(emit_function_inst_count(f)).concat(" ms=".concat(to_string(ms).concat(" ".concat(function_identity::MirFunction_name(f)))))))
        )
    )
    true
}

// Configure a body writer with the linear-GC runtime function indices used
// when bodies emit runtime calls. Declared bodies emit into per-fn scratch
// writers (#851 Phase 3), so this is shared by the code-section writer
// (synthetic bodies) and every per-fn body writer.
fn code_configure_linear_gc_writer(
    mut w: WasmWriter,
    fn_count: i32,
    needs_wrapper: i32,
    p2_library_post_count: i32,
    p2_library_wrapper_count: i32,
    p2_runtime_function_count: i32,
    linear_gc_runtime_count: i32,
    target: String,
    wasi_version: String,
    wit_import_count: i32
) {
    if linear_gc_runtime_count <= 0 {
        return
    }
    writer_core::writer_set_linear_gc_commit_function_index(
        w,
        function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_COMMIT_TOP(),
            clone(target),
            clone(wasi_version),
            wit_import_count
        )
    )
    writer_core::writer_set_linear_gc_alloc_function_index(
        w,
        function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_ALLOC(),
            clone(target),
            clone(wasi_version),
            wit_import_count
        )
    )
    writer_core::writer_set_linear_gc_root_frame_enter_function_index(
        w,
        function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_ROOT_FRAME_ENTER(),
            clone(target),
            clone(wasi_version),
            wit_import_count
        )
    )
    writer_core::writer_set_linear_gc_root_push_function_index(
        w,
        function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_ROOT_PUSH(),
            clone(target),
            clone(wasi_version),
            wit_import_count
        )
    )
    writer_core::writer_set_linear_gc_root_update_function_index(
        w,
        function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_ROOT_UPDATE(),
            clone(target),
            clone(wasi_version),
            wit_import_count
        )
    )
    writer_core::writer_set_linear_gc_root_frame_leave_function_index(
        w,
        function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_ROOT_FRAME_LEAVE(),
            clone(target),
            clone(wasi_version),
            wit_import_count
        )
    )
    writer_core::writer_set_linear_gc_collect_function_index(
        w,
        function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_COLLECT(),
            clone(target),
            clone(wasi_version),
            wit_import_count
        )
    )
}

// Resolve every pending body reloc and splice its minimal encoding into
// the stored body vec. Iterates records in reverse: emit order is
// ascending offset within each body, so reverse applies higher offsets
// first and earlier splice-induced growth never shifts a site still to
// be patched.
fn code_apply_pending_relocs(mut ctx: SelfEmitCtx, wit_import_count: i32) {
    let mut i = len(ctx.reloc_func) - 1
    while i >= 0 {
        let fi = get_unchecked(ctx.reloc_func, i)
        let off = get_unchecked(ctx.reloc_off, i)
        let kind = get_unchecked(ctx.reloc_kind, i)
        let ikey = get_unchecked(ctx.reloc_ikey, i)
        let ikey2 = get_unchecked(ctx.reloc_ikey2, i)
        let ikey3 = get_unchecked(ctx.reloc_ikey3, i)
        let skey = clone(get_unchecked(ctx.reloc_skey, i))
        let skey2 = clone(get_unchecked(ctx.reloc_skey2, i))
        let mut value = 0 - 1
        if kind == ctx_reloc::RELOC_KIND_STR_TRUE() {
            value = ctx_string_view::SelfEmitCtx_true_string_offset(ctx)
        }
        if kind == ctx_reloc::RELOC_KIND_STR_FALSE() {
            value = ctx_string_view::SelfEmitCtx_false_string_offset(ctx)
        }
        if kind == ctx_reloc::RELOC_KIND_STR_VALUE() {
            value = ctx_string_view::SelfEmitCtx_string_offset_for_value(ctx, skey)
        }
        if kind == ctx_reloc::RELOC_KIND_PAIR_KEY() ||
        kind == ctx_reloc::RELOC_KIND_INDIRECT_SCAN() {
            value = call_indirect::resolve_indirect_reloc(ctx, kind, ikey, ikey2, ikey3, skey)
        }
        if kind == ctx_reloc::RELOC_KIND_CALL_REF_CAST() ||
        kind == ctx_reloc::RELOC_KIND_CALL_REF_TYPE() {
            value = call_ref::resolve_call_ref_reloc(ctx, ikey, ikey2, ikey3, skey, skey2)
        }
        if kind == ctx_reloc::RELOC_KIND_REF_FUNC() {
            value = resolve_ref_func_reloc(ctx, skey, wit_import_count)
        }
        if value < 0 {
            stdio::eprintln("compiler ICE: unresolved body reloc")
            Process::exit(1)
        }
        let body = get_unchecked(ctx.body_bytes, fi)
        if ctx_reloc::reloc_kind_is_sleb(kind) {
            set(ctx.body_bytes, fi, ctx_reloc::reloc_splice_i32(body, off, value))
        } else {
            set(ctx.body_bytes, fi, ctx_reloc::reloc_splice_u32(body, off, value))
        }
        i = i - 1
    }
    ctx.reloc_func = Vec::new<i32>()
    ctx.reloc_off = Vec::new<i32>()
    ctx.reloc_kind = Vec::new<i32>()
    ctx.reloc_ikey = Vec::new<i32>()
    ctx.reloc_ikey2 = Vec::new<i32>()
    ctx.reloc_ikey3 = Vec::new<i32>()
    ctx.reloc_skey = Vec::new<String>()
    ctx.reloc_skey2 = Vec::new<String>()
}

// RELOC_KIND_REF_FUNC apply: reproduce the emit-time name scan (exact
// equality, last match wins — MirInst_str_val is already the resolved name)
// on the post-prune functions vec, then map to the module function index.
// A missing target keeps the legacy fallback value 0 rather than an ICE.
fn resolve_ref_func_reloc(ctx: SelfEmitCtx, fn_name: String, wit_import_count: i32) -> i32 {
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    let fn_count = ctx_record::SelfEmitCtx_function_count(ctx)
    let mut mir_fn_idx = 0 - 1
    let mut i = 0
    while i < fn_count {
        if eq(function_identity::MirFunction_name(get_unchecked(functions, i)), clone(fn_name)) {
            mir_fn_idx = i
        }
        i = i + 1
    }
    if mir_fn_idx < 0 {
        return 0
    }
    function_indices::defined_function_index(
        mir_fn_idx,
        ctx_record::SelfEmitCtx_target(ctx),
        ctx_record::SelfEmitCtx_wasi_version(ctx),
        wit_import_count
    )
}

// #851 Phase 3 fused emit: adopt the lowering drain's artifact vecs onto
// this emit ctx. The drain runs pre-prune, so recorded reloc owners and
// body order are PRE-PRUNE function indices; prune_old_to_new compacts
// and remaps them. An empty map means prune never ran — indices are
// already final and adoption is a straight vec handoff.
fn emit_ctx_adopt_inloop_artifacts(mut ctx: SelfEmitCtx, art: MirEmitArtifacts) {
    let map = art.prune_old_to_new
    if len(map) == 0 {
        ctx.body_bytes = art.body_bytes
        ctx.reloc_func = art.reloc_func
        ctx.reloc_off = art.reloc_off
        ctx.reloc_kind = art.reloc_kind
        ctx.reloc_ikey = art.reloc_ikey
        ctx.reloc_ikey2 = art.reloc_ikey2
        ctx.reloc_ikey3 = art.reloc_ikey3
        ctx.reloc_skey = art.reloc_skey
        ctx.reloc_skey2 = art.reloc_skey2
        ctx.call_reloc_offs = art.call_reloc_offs
        ctx.call_reloc_fids = art.call_reloc_fids
        ctx.call_reloc_funcs = art.call_reloc_funcs
        ctx.call_reloc_names = art.call_reloc_names
    } else {
        let mut bodies = Vec::new<Vec<i32>>()
        let mut oi = 0
        while oi < len(map) {
            if get_unchecked(map, oi) >= 0 {
                push(bodies, get_unchecked(art.body_bytes, oi))
            }
            oi = oi + 1
        }
        ctx.body_bytes = bodies
        let mut rfunc = Vec::new<i32>()
        let mut roff = Vec::new<i32>()
        let mut rkind = Vec::new<i32>()
        let mut ri1 = Vec::new<i32>()
        let mut ri2 = Vec::new<i32>()
        let mut ri3 = Vec::new<i32>()
        let mut rs1 = Vec::new<String>()
        let mut rs2 = Vec::new<String>()
        let mut ri = 0
        while ri < len(art.reloc_func) {
            let mapped = get_unchecked(map, get_unchecked(art.reloc_func, ri))
            if mapped >= 0 {
                push(rfunc, mapped)
                push(roff, get_unchecked(art.reloc_off, ri))
                push(rkind, get_unchecked(art.reloc_kind, ri))
                push(ri1, get_unchecked(art.reloc_ikey, ri))
                push(ri2, get_unchecked(art.reloc_ikey2, ri))
                push(ri3, get_unchecked(art.reloc_ikey3, ri))
                push(rs1, clone(get_unchecked(art.reloc_skey, ri)))
                push(rs2, clone(get_unchecked(art.reloc_skey2, ri)))
            }
            ri = ri + 1
        }
        ctx.reloc_func = rfunc
        ctx.reloc_off = roff
        ctx.reloc_kind = rkind
        ctx.reloc_ikey = ri1
        ctx.reloc_ikey2 = ri2
        ctx.reloc_ikey3 = ri3
        ctx.reloc_skey = rs1
        ctx.reloc_skey2 = rs2
        let mut coffs = Vec::new<i32>()
        let mut cfids = Vec::new<i32>()
        let mut cfuncs = Vec::new<i32>()
        let mut cnames = Vec::new<String>()
        let mut cii = 0
        while cii < len(art.call_reloc_funcs) {
            let mapped = get_unchecked(map, get_unchecked(art.call_reloc_funcs, cii))
            if mapped >= 0 {
                push(coffs, get_unchecked(art.call_reloc_offs, cii))
                push(cfids, get_unchecked(art.call_reloc_fids, cii))
                push(cfuncs, mapped)
                push(cnames, clone(get_unchecked(art.call_reloc_names, cii)))
            }
            cii = cii + 1
        }
        ctx.call_reloc_offs = coffs
        ctx.call_reloc_fids = cfids
        ctx.call_reloc_funcs = cfuncs
        ctx.call_reloc_names = cnames
    }
    ctx.registry_audit_candidates = art.registry_audit_candidates
    ctx.registry_audit_matched = art.registry_audit_matched
    ctx.registry_audit_mismatched = art.registry_audit_mismatched
    ctx.registry_audit_mismatch_budget = art.registry_audit_mismatch_budget
    ctx.core_op_shadow_candidates = art.core_op_shadow_candidates
    ctx.core_op_shadow_matched = art.core_op_shadow_matched
    ctx.core_op_shadow_mismatched = art.core_op_shadow_mismatched
    ctx.core_op_shadow_unresolved = art.core_op_shadow_unresolved
    ctx.core_op_shadow_mismatch_budget = art.core_op_shadow_mismatch_budget
    let mut layout = ctx_record::SelfEmitCtx_gc_layout_table(ctx)
    layout.typed_lookup_count = layout.typed_lookup_count + art.gc_layout_typed_lookups
    layout.conflict_count = layout.conflict_count + art.gc_layout_conflicts
    ctx.in_loop_emitted = true
}

fn emit_code_section(
    mut out: WasmWriter,
    mut mir: MirModule,
    functions: Vec<MirFunction>,
    fn_count: i32,
    needs_wrapper: i32,
    main_idx: i32,
    p2_library_post_count: i32,
    p2_library_wrapper_count: i32,
    p2_runtime_function_count: i32,
    mut ctx: SelfEmitCtx,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    report_timing: i32
) {
    let mut code_sec = writer_core::WasmWriter_with_memory64(writer_core::writer_memory64(out))
    let target = ctx_record::SelfEmitCtx_target(ctx)
    let wasi_version = ctx_record::SelfEmitCtx_wasi_version(ctx)
    let linear_gc_runtime_count = function_indices::linear_gc_runtime_function_count(clone(target))
    if linear_gc_runtime_count > 0 {
        let commit_index = function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_COMMIT_TOP(),
            clone(target),
            clone(wasi_version),
            module_wit_imports::wit_import_count(bindings)
        )
        writer_core::writer_set_linear_gc_commit_function_index(code_sec, commit_index)
        let alloc_index = function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_ALLOC(),
            clone(target),
            clone(wasi_version),
            module_wit_imports::wit_import_count(bindings)
        )
        writer_core::writer_set_linear_gc_alloc_function_index(code_sec, alloc_index)
        let root_frame_enter_index = function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_ROOT_FRAME_ENTER(),
            clone(target),
            clone(wasi_version),
            module_wit_imports::wit_import_count(bindings)
        )
        writer_core::writer_set_linear_gc_root_frame_enter_function_index(code_sec, root_frame_enter_index)
        let root_push_index = function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_ROOT_PUSH(),
            clone(target),
            clone(wasi_version),
            module_wit_imports::wit_import_count(bindings)
        )
        writer_core::writer_set_linear_gc_root_push_function_index(code_sec, root_push_index)
        let root_update_index = function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_ROOT_UPDATE(),
            clone(target),
            clone(wasi_version),
            module_wit_imports::wit_import_count(bindings)
        )
        writer_core::writer_set_linear_gc_root_update_function_index(code_sec, root_update_index)
        let root_frame_leave_index = function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_ROOT_FRAME_LEAVE(),
            clone(target),
            clone(wasi_version),
            module_wit_imports::wit_import_count(bindings)
        )
        writer_core::writer_set_linear_gc_root_frame_leave_function_index(code_sec, root_frame_leave_index)
        let collect_index = function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            constants::LINEAR_GC_COLLECT(),
            clone(target),
            clone(wasi_version),
            module_wit_imports::wit_import_count(bindings)
        )
        writer_core::writer_set_linear_gc_collect_function_index(code_sec, collect_index)
    }
    code_configure_linear_gc_writer(
        code_sec,
        fn_count,
        needs_wrapper,
        p2_library_post_count,
        p2_library_wrapper_count,
        p2_runtime_function_count,
        linear_gc_runtime_count,
        clone(target),
        clone(wasi_version),
        module_wit_imports::wit_import_count(bindings)
    )
    let p2_command_extra = if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) && needs_wrapper == 1 {
        1
    } else {
        0
    }
    writer_core::emit_leb128_u(
        code_sec,
        fn_count + needs_wrapper + p2_command_extra + p2_library_post_count + p2_runtime_function_count
        + p2_library_wrapper_count + linear_gc_runtime_count
    )
    let mut offsets = Vec::new<i32>()
    let wit_import_count = module_wit_imports::wit_import_count(bindings)
    let mut ci = 0
    let mut slow_notes = 0
    if ctx.in_loop_emitted {
        // #851 Phase 3 fused emit: bodies already sit in ctx.body_bytes
        // (post-adoption, compacted to post-prune indices). Keep the detach
        // sweep so the MIR footprint after emit matches the legacy loop.
        while ci < fn_count {
            module_block_pool::mir_function_detach_blocks(get_unchecked(functions, ci), mir)
            ci = ci + 1
        }
    } else {
        while ci < fn_count {
            let mut f = get_unchecked(functions, ci)
            ctx_record::SelfEmitCtx_set_current_func_idx(ctx, ci)
            let t_fn = Clock::monotonic_now()
            // #851 Phase 3: declared bodies emit into a per-fn scratch writer so
            // the resulting byte vec is independently addressable by func_idx —
            // the same shape in-loop emit needs once bodies complete out of
            // code-section order.
            let mut body_w = writer_core::WasmWriter_with_memory64(writer_core::writer_memory64(out))
            code_configure_linear_gc_writer(
                body_w,
                fn_count,
                needs_wrapper,
                p2_library_post_count,
                p2_library_wrapper_count,
                p2_runtime_function_count,
                linear_gc_runtime_count,
                clone(target),
                clone(wasi_version),
                module_wit_imports::wit_import_count(bindings)
            )
            code_body::emit_function_body(body_w, f, ctx, bindings)
            push(ctx.body_bytes, writer_core::writer_bytes(body_w))
            if slow_notes < 32 {
                if emit_slow_fn_note(report_timing, ci, f, t_fn) {
                    slow_notes = slow_notes + 1
                }
            }
            module_block_pool::mir_function_detach_blocks(f, mir)
            ci = ci + 1
        }
    }
    // #851 Phase 3: deferred-resolution operands (call targets, plan-
    // appended string literals, call_indirect/call_ref type indices) are
    // final now that every declared body is emitted. CALL slots patch
    // first: they write a fixed 5-byte slot in place, so their emit-order
    // offsets stay valid; the variable-length splices then run in reverse
    // so each applied splice cannot shift the offsets of the ones ahead.
    ctx_call_reloc::SelfEmitCtx_apply_call_relocs(ctx, wit_import_count)
    code_apply_pending_relocs(ctx, wit_import_count)
    let mut bi2 = 0
    while bi2 < fn_count {
        push(offsets, writer_core::writer_size(code_sec))
        let size_off = emit_sized_code_body_begin(code_sec)
        writer_core::emit_bytes(code_sec, get_unchecked(ctx.body_bytes, bi2))
        emit_sized_code_body_end(code_sec, size_off)
        bi2 = bi2 + 1
    }
    if needs_wrapper == 1 {
        let size_off = emit_sized_code_body_begin(code_sec)
        emit_start_wrapper_body(code_sec, main_idx, mir, ctx, wit_import_count)
        emit_sized_code_body_end(code_sec, size_off)
    }
    if p2_command_extra == 1 {
        let size_off = emit_sized_code_body_begin(code_sec)
        emit_p2_post_return_body(code_sec)
        emit_sized_code_body_end(code_sec, size_off)
    }
    let mut library_post_idx = 0
    while library_post_idx < p2_library_post_count {
        let size_off = emit_sized_code_body_begin(code_sec)
        emit_p2_post_return_body(code_sec)
        emit_sized_code_body_end(code_sec, size_off)
        library_post_idx = library_post_idx + 1
    }
    emit_p2_library_wrapper_bodies(
        code_sec,
        mir,
        fn_count,
        needs_wrapper,
        p2_library_post_count,
        p2_library_wrapper_count,
        ctx,
        wit_import_count
    )
    if p2_runtime_function_count == 2 {
        let realloc_size_off = emit_sized_code_body_begin(code_sec)
        emit_p2_realloc_body(code_sec)
        emit_sized_code_body_end(code_sec, realloc_size_off)
        let initialize_size_off = emit_sized_code_body_begin(code_sec)
        emit_p2_initialize_body(code_sec)
        emit_sized_code_body_end(code_sec, initialize_size_off)
    }
    if linear_gc_runtime_count > 0 {
        let runtime_base = function_indices::linear_gc_runtime_function_index(
            fn_count,
            needs_wrapper,
            p2_library_post_count,
            p2_library_wrapper_count,
            p2_runtime_function_count,
            0,
            clone(target),
            clone(wasi_version),
            wit_import_count
        )
        let mut runtime_idx = 0
        while runtime_idx < linear_gc_runtime_count {
            let size_off = emit_sized_code_body_begin(code_sec)
            linear_gc_runtime::emit_runtime_body(
                code_sec,
                runtime_idx,
                runtime_base,
                import_indices::proc_exit_import_idx(ctx)
            )
            emit_sized_code_body_end(code_sec, size_off)
            runtime_idx = runtime_idx + 1
        }
    }
    ctx_record::SelfEmitCtx_set_code_section_offsets(ctx, offsets)
    writer_sections::emit_section(out, opcodes::SEC_CODE(), code_sec)
}

fn emit_p2_library_wrapper_bodies(
    mut code_sec: WasmWriter,
    mir: MirModule,
    fn_count: i32,
    needs_wrapper: i32,
    p2_library_post_count: i32,
    p2_library_wrapper_count: i32,
    ctx: SelfEmitCtx,
    wit_import_count: i32
) {
    if p2_library_wrapper_count <= 0 {
        return
    }
    let target = ctx_record::SelfEmitCtx_target(ctx)
    let wasi_version = ctx_record::SelfEmitCtx_wasi_version(ctx)
    let realloc_idx = function_indices::p2_runtime_realloc_function_index(
        fn_count,
        needs_wrapper,
        p2_library_post_count,
        p2_library_wrapper_count,
        clone(target),
        clone(wasi_version),
        wit_import_count
    )
    let mut function_idx = 0
    while function_idx < fn_count {
        let f = module_functions::MirModule_function_at(mir, function_idx)
        if sections_exports::is_p2_library_export_function(mir, f) &&
        sections_types_sigs_detail::p2_function_needs_string_wrapper(
            f,
            clone(target),
            clone(wasi_version),
            mir
        ) {
            let size_off = emit_sized_code_body_begin(code_sec)
            p2_canonical::emit_library_wrapper_body(
                code_sec,
                f,
                function_idx,
                realloc_idx,
                ctx,
                wit_import_count,
                mir
            )
            emit_sized_code_body_end(code_sec, size_off)
        }
        function_idx = function_idx + 1
    }
}

fn emit_p2_realloc_body(mut w: WasmWriter) {
    // `cabi_realloc` is part of the official standard32 core ABI. It owns a
    // bump-pointer region, grows linear memory on demand, and preserves the
    // requested prefix when the canonical ABI asks for a resize.
    writer_core::emit_leb128_u(w, 1)
    writer_core::emit_leb128_u(w, 2)
    if writer_core::writer_memory64(w) {
        writer_core::emit_byte(w, constants::WASM_I64())
    } else {
        writer_core::emit_byte(w, constants::WASM_I32())
    }
    emit_p2_realloc_align(w)
    emit_p2_realloc_end(w)
    if writer_core::writer_memory64(w) {
        emit_p2_realloc_memory64_overflow_guard(w)
    }
    writer_core::emit_local_get(w, 5)
    helpers_core_heap::emit_heap_set(w)
    emit_p2_realloc_copy(w)
    writer_core::emit_local_get(w, 4)
    if writer_core::writer_memory64(w) {
        // The guard above makes this an explicit checked ABI narrowing.
        writer_core::emit_byte(w, opcodes::OP_I32_WRAP_I64())
    }
    writer_core::emit_byte(w, opcodes::OP_END())
}

fn emit_p2_realloc_align(mut w: WasmWriter) {
    if writer_core::writer_memory64(w) {
        emit_p2_realloc_align_memory64(w)
        return
    }
    writer_core::emit_byte(w, opcodes::OP_GLOBAL_GET())
    writer_core::emit_leb128_u(w, 0)
    writer_core::emit_local_get(w, 2)
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, 1)
    writer_core::emit_byte(w, opcodes::OP_I32_SUB())
    writer_core::emit_byte(w, opcodes::OP_I32_ADD())
    writer_core::emit_local_get(w, 2)
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, 1)
    writer_core::emit_byte(w, opcodes::OP_I32_SUB())
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, 0 - 1)
    writer_core::emit_byte(w, opcodes::OP_I32_XOR())
    writer_core::emit_byte(w, opcodes::OP_I32_AND())
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, 4)
}

fn emit_p2_realloc_align_memory64(mut w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_GLOBAL_GET())
    writer_core::emit_leb128_u(w, 0)
    writer_core::emit_local_get(w, 2)
    writer_core::emit_byte(w, opcodes::OP_I64_EXTEND_I32_U())
    writer_core::emit_byte(w, opcodes::OP_I64_CONST())
    writer_core::emit_leb128_s_i64(w, 1i64)
    writer_core::emit_byte(w, opcodes::OP_I64_SUB())
    writer_core::emit_byte(w, opcodes::OP_I64_ADD())
    writer_core::emit_local_set(w, 4)
    writer_core::emit_local_get(w, 4)
    writer_core::emit_local_get(w, 2)
    writer_core::emit_byte(w, opcodes::OP_I64_EXTEND_I32_U())
    writer_core::emit_byte(w, opcodes::OP_I64_CONST())
    writer_core::emit_leb128_s_i64(w, 1i64)
    writer_core::emit_byte(w, opcodes::OP_I64_SUB())
    writer_core::emit_byte(w, opcodes::OP_I64_CONST())
    writer_core::emit_leb128_s_i64(w, 0i64 - 1i64)
    writer_core::emit_byte(w, opcodes::OP_I64_XOR())
    writer_core::emit_byte(w, opcodes::OP_I64_AND())
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, 4)
}

fn emit_p2_realloc_end(mut w: WasmWriter) {
    if writer_core::writer_memory64(w) {
        writer_core::emit_local_get(w, 4)
        writer_core::emit_local_get(w, 3)
        writer_core::emit_byte(w, opcodes::OP_I64_EXTEND_I32_U())
        writer_core::emit_byte(w, opcodes::OP_I64_ADD())
        writer_core::emit_local_set(w, 5)
        return
    }
    writer_core::emit_local_get(w, 4)
    writer_core::emit_local_get(w, 3)
    writer_core::emit_byte(w, opcodes::OP_I32_ADD())
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, 5)
}

fn emit_p2_realloc_memory64_overflow_guard(mut w: WasmWriter) {
    // `aligned == 2^32` is already outside the memory32 pointer domain, even
    // when a zero-sized allocation would leave the end at the same boundary.
    writer_core::emit_local_get(w, 4)
    helpers_numeric_i64_const::emit_i64_const(
        w,
        constants::P2_CANONICAL_MEMORY32_LIMIT()
    )
    writer_core::emit_byte(w, opcodes::OP_I64_GE_U())
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)
    writer_core::emit_byte(w, opcodes::OP_UNREACHABLE())
    writer_core::emit_byte(w, opcodes::OP_END())

    // An allocation may end exactly at 2^32, but it must not cross it.
    writer_core::emit_local_get(w, 5)
    helpers_numeric_i64_const::emit_i64_const(
        w,
        constants::P2_CANONICAL_MEMORY32_LIMIT()
    )
    writer_core::emit_byte(w, opcodes::OP_I64_GT_U())
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)
    writer_core::emit_byte(w, opcodes::OP_UNREACHABLE())
    writer_core::emit_byte(w, opcodes::OP_END())
}

fn emit_p2_realloc_copy(mut w: WasmWriter) {
    writer_core::emit_local_get(w, 4)
    if writer_core::writer_memory64(w) {
        writer_core::emit_local_get(w, 0)
        writer_core::emit_byte(w, opcodes::OP_I64_EXTEND_I32_U())
        writer_core::emit_local_get(w, 1)
        writer_core::emit_byte(w, opcodes::OP_I64_EXTEND_I32_U())
        helpers_memory::emit_memory_copy(w)
        return
    }
    writer_core::emit_local_get(w, 0)
    writer_core::emit_local_get(w, 1)
    helpers_memory::emit_memory_copy(w)
}

fn emit_p2_initialize_body(mut w: WasmWriter) {
    writer_core::emit_leb128_u(w, 0)
    writer_core::emit_byte(w, opcodes::OP_END())
}

fn emit_sized_code_body_begin(mut code_sec: WasmWriter) -> i32 {
    let size_off = writer_core::writer_size(code_sec)
    writer_core::emit_leb128_u_fixed(code_sec, 0)
    size_off
}

fn emit_sized_code_body_end(mut code_sec: WasmWriter, size_off: i32) {
    let width = writer_core::leb128_u_fixed_width()
    writer_core::patch_leb128_u_fixed(
        code_sec,
        size_off,
        writer_core::writer_size(code_sec) - size_off - width
    )
}

fn emit_start_wrapper_body(
    mut w: WasmWriter,
    main_idx: i32,
    mir: MirModule,
    ctx: SelfEmitCtx,
    wit_import_count: i32
) {
    writer_core::emit_leb128_u(w, 0)
    writer_core::emit_byte(w, opcodes::OP_CALL())
    writer_core::emit_leb128_u(
        w,
        function_indices::defined_function_index(
            main_idx,
            ctx_record::SelfEmitCtx_target(ctx),
            ctx_record::SelfEmitCtx_wasi_version(ctx),
            wit_import_count
        )
    )
    let main = module_functions::MirModule_function_at(mir, main_idx)
    if function_return_view::MirFunction_return_type(main) != 0 {
        writer_core::emit_byte(w, opcodes::OP_DROP())
    }
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        writer_core::emit_byte(w, opcodes::OP_I32_CONST())
        writer_core::emit_leb128_s(w, 0)
    }
    writer_core::emit_byte(w, opcodes::OP_END())
}

fn emit_p2_post_return_body(mut w: WasmWriter) {
    // Scalar P2 exports need no allocation cleanup after their result is lifted.
    writer_core::emit_leb128_u(w, 0)
    writer_core::emit_byte(w, opcodes::OP_END())
}
