fn p2_runtime_bridge_hex_to_bytes(hex: String) -> Vec<i32> {
    let out = Vec::new<i32>()
    let mut i = 0
    while i + 1 < len(hex) {
        let hi = p2_runtime_bridge_hex_val(char_at(hex, i))
        let lo = p2_runtime_bridge_hex_val(char_at(hex, i + 1))
        push(out, hi * 16 + lo)
        i = i + 2
    }
    out
}

fn p2_runtime_bridge_hex_val(c: i32) -> i32 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    0
}
