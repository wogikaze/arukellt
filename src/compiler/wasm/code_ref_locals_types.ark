use std::prelude::{clone, eq}
fn is_gc_container_type_name(type_name: String) -> bool {
    if clone(type_name).starts_with("vec:") || clone(type_name).starts_with("hashmap:") {
        return true
    }
    false
}

fn is_option_type_name(type_name: String) -> bool {
    if clone(type_name).starts_with("Option_") ||
    clone(type_name).starts_with("option:") ||
    clone(type_name).starts_with("Option:") ||
    clone(type_name).starts_with("Option<") ||
    eq(clone(type_name), "enum:Option") {
        return true
    }
    false
}

// Retired (#842): option-return detection uses MirFunction return type_name /
// SignatureRegistry, not callee-name lists.
