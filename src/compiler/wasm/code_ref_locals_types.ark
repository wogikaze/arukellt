fn is_gc_container_type_name(type_name: String) -> bool {
    if type_name.clone().starts_with("vec:") || type_name.clone().starts_with("hashmap:") {
        return true
    }
    false
}

fn is_option_type_name(type_name: String) -> bool {
    if type_name.clone().starts_with("Option_") ||
    type_name.clone().starts_with("option:") ||
    type_name.clone().starts_with("Option:") ||
    type_name.clone().starts_with("Option<") ||
    type_name.clone().eq("enum:Option") {
        return true
    }
    false
}

// Retired (#842): option-return detection uses MirFunction return type_name /
// SignatureRegistry, not callee-name lists.
