fn is_gc_container_type_name(type_name: String) -> bool {
    if starts_with(clone(type_name), "vec:") || starts_with(clone(type_name), "hashmap:") {
        return true
    }
    false
}

fn is_option_type_name(type_name: String) -> bool {
    if starts_with(clone(type_name), "Option_") ||
    starts_with(clone(type_name), "option:") ||
    starts_with(clone(type_name), "Option:") ||
    starts_with(clone(type_name), "Option<") ||
    eq(clone(type_name), "enum:Option") {
        return true
    }
    false
}

fn mir_fn_returns_option_by_name(fn_name: String) -> bool {
    if eq(clone(fn_name), "hashmap_get_option") ||
    eq(clone(fn_name), "hash::hashmap_get_option") ||
    eq(clone(fn_name), "HashMap_i32_i32_get") ||
    eq(clone(fn_name), "hashmap_i32_i32_get") ||
    eq(clone(fn_name), "hash_map::hashmap_i32_i32_get") {
        return true
    }
    if eq(clone(fn_name), "hashmap_remove") ||
    eq(clone(fn_name), "hash::hashmap_remove") ||
    eq(clone(fn_name), "HashMap_i32_i32_remove") ||
    eq(clone(fn_name), "hashmap_i32_i32_remove") ||
    eq(clone(fn_name), "hash_map::hashmap_i32_i32_remove") {
        return true
    }
    if eq(clone(fn_name), "hash_string::hashmap_str_get") ||
    eq(clone(fn_name), "hashmap_str_get") ||
    eq(clone(fn_name), "hash::hashmap_str_get") ||
    eq(clone(fn_name), "HashMap_String_i32_get") {
        return true
    }
    if eq(clone(fn_name), "hash_string::hashmap_str_remove") ||
    eq(clone(fn_name), "hashmap_str_remove") ||
    eq(clone(fn_name), "hash::hashmap_str_remove") ||
    eq(clone(fn_name), "HashMap_String_i32_remove") {
        return true
    }
    if eq(clone(fn_name), "hashmap_str_val_get") || eq(clone(fn_name), "HashMap_i32_String_get") {
        return true
    }
    if eq(clone(fn_name), "hashmap_str_str_get") || eq(clone(fn_name), "HashMap_String_String_get") {
        return true
    }
    if eq(clone(fn_name), "hashmap_str_str_remove") || eq(clone(fn_name), "HashMap_String_String_remove") {
        return true
    }
    if eq(clone(fn_name), "parse_i32") ||
    eq(clone(fn_name), "convert::parse_i32") ||
    eq(clone(fn_name), "parse_i64") ||
    eq(clone(fn_name), "convert::parse_i64") ||
    eq(clone(fn_name), "parse_f64") ||
    eq(clone(fn_name), "convert::parse_f64") {
        return true
    }
    false
}
