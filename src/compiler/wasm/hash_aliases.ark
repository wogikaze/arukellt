use std::prelude::{clone, eq}
// The user-reachable HashMap_<K>_<V>_* builtins were retired by #917, so this
// table now only maps the non-public __hm_* storage bridge. The two families
// lower differently on linear targets, so they keep separate tables.
fn hashmap_builtin_alias(name: String) -> String {
    let constructor = hashmap_new_builtin_alias(clone(name))
    if !eq(clone(constructor), clone(name)) {
        return constructor
    }
    hashmap_with_capacity_builtin_alias(name)
}

// The __hm_*_new builtins lower to an inline GC struct on wasm32-gc but to a
// call of the flat Vec<i32> hashmap_new constructor on linear targets.
// Reachability must retain that body: nothing in Ark source calls it by name,
// so without this edge the pruner drops it and the emitted call index
// resolves to an import.
fn hashmap_new_builtin_alias(name: String) -> String {
    if eq(clone(name), "__hm_si_new") ||
    eq(clone(name), "__hm_is_new") ||
    eq(clone(name), "__hm_if_new") ||
    eq(clone(name), "__hm_sf_new") ||
    eq(clone(name), "__hm_ss_new") {
        return "hashmap_new"
    }
    clone(name)
}

// __hm_*_new_with_cap lowers to the flat Vec<i32> constructor with a
// caller-supplied capacity on linear targets (#895 growth donor).
fn hashmap_with_capacity_builtin_alias(name: String) -> String {
    if eq(clone(name), "__hm_si_new_with_cap") ||
    eq(clone(name), "__hm_is_new_with_cap") ||
    eq(clone(name), "__hm_if_new_with_cap") ||
    eq(clone(name), "__hm_sf_new_with_cap") ||
    eq(clone(name), "__hm_ss_new_with_cap") {
        return "hashmap_with_capacity"
    }
    clone(name)
}
