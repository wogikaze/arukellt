// Arukellt Selfhost - P2 stub core modules for bootstrap component emission.

use wasm::writer_core
use wasm::writer_string

fn p2_stub_new_core_module_writer() -> WasmWriter {
    let out = writer_core::WasmWriter_new()
    writer_core::emit_byte(out, 0x00)
    writer_core::emit_byte(out, 0x61)
    writer_core::emit_byte(out, 0x73)
    writer_core::emit_byte(out, 0x6d)
    writer_core::emit_byte(out, 0x01)
    writer_core::emit_byte(out, 0x00)
    writer_core::emit_byte(out, 0x00)
    writer_core::emit_byte(out, 0x00)
    out
}

fn p2_stub_emit_wasm_section(out: WasmWriter, section_id: i32, contents: WasmWriter) {
    writer_core::emit_byte(out, section_id)
    writer_core::emit_leb128_u(out, writer_core::writer_size(contents))
    writer_core::emit_bytes(out, writer_core::writer_bytes(contents))
}

fn p2_stub_emit_core_func_type(type_sec: WasmWriter, params: Vec<i32>, results: Vec<i32>) {
    writer_core::emit_byte(type_sec, 0x60)
    writer_core::emit_leb128_u(type_sec, len(params))
    for i in 0..len(params) {
        writer_core::emit_byte(type_sec, get_unchecked(params, i))
    }
    writer_core::emit_leb128_u(type_sec, len(results))
    for i in 0..len(results) {
        writer_core::emit_byte(type_sec, get_unchecked(results, i))
    }
}

fn p2_stub_single_export(export_name: String, void_ret: i32) -> Vec<i32> {
    p2_stub_single_export_named(export_name, export_name, void_ret)
}

fn p2_stub_single_export_named(export_name: String, module_name: String, void_ret: i32) -> Vec<i32> {
    let out = p2_stub_new_core_module_writer()
    let type_sec = writer_core::WasmWriter_new()
    writer_core::emit_leb128_u(type_sec, 1)
    if void_ret == 1 {
        let p1 = Vec::new<i32>()
        push(p1, 0x7f)
        let r_void = Vec::new<i32>()
        p2_stub_emit_core_func_type(type_sec, p1, r_void)
    } else {
        let p4 = Vec::new<i32>()
        push(p4, 0x7f)
        push(p4, 0x7f)
        push(p4, 0x7f)
        push(p4, 0x7f)
        let r_i32 = Vec::new<i32>()
        push(r_i32, 0x7f)
        p2_stub_emit_core_func_type(type_sec, p4, r_i32)
    }
    p2_stub_emit_wasm_section(out, 1, type_sec)
    let func_sec = writer_core::WasmWriter_new()
    writer_core::emit_leb128_u(func_sec, 1)
    writer_core::emit_leb128_u(func_sec, 0)
    p2_stub_emit_wasm_section(out, 3, func_sec)
    p2_stub_emit_exports(out, export_name, 0, void_ret)
    p2_stub_emit_module_name(out, module_name)
    writer_core::writer_bytes(out)
}

fn p2_stub_env_module() -> Vec<i32> {
    let out = p2_stub_new_core_module_writer()
    let type_sec = writer_core::WasmWriter_new()
    writer_core::emit_leb128_u(type_sec, 1)
    let p2 = Vec::new<i32>()
    push(p2, 0x7f)
    push(p2, 0x7f)
    let r_i32 = Vec::new<i32>()
    push(r_i32, 0x7f)
    p2_stub_emit_core_func_type(type_sec, p2, r_i32)
    p2_stub_emit_wasm_section(out, 1, type_sec)
    let func_sec = writer_core::WasmWriter_new()
    writer_core::emit_leb128_u(func_sec, 2)
    writer_core::emit_leb128_u(func_sec, 0)
    writer_core::emit_leb128_u(func_sec, 0)
    p2_stub_emit_wasm_section(out, 3, func_sec)
    p2_stub_emit_core_exports(out, "args-sizes", "arguments", 2)
    p2_stub_emit_module_name(out, "stub_env")
    writer_core::writer_bytes(out)
}

fn p2_stub_fs_module() -> Vec<i32> {
    let out = p2_stub_new_core_module_writer()
    let type_sec = writer_core::WasmWriter_new()
    writer_core::emit_leb128_u(type_sec, 2)
    let p_path = Vec::new<i32>()
    push(p_path, 0x7f)
    push(p_path, 0x7f)
    push(p_path, 0x7f)
    push(p_path, 0x7f)
    push(p_path, 0x7f)
    push(p_path, 0x7e)
    push(p_path, 0x7e)
    push(p_path, 0x7f)
    push(p_path, 0x7f)
    let r_i32 = Vec::new<i32>()
    push(r_i32, 0x7f)
    p2_stub_emit_core_func_type(type_sec, p_path, r_i32)
    let p1 = Vec::new<i32>()
    push(p1, 0x7f)
    p2_stub_emit_core_func_type(type_sec, p1, r_i32)
    p2_stub_emit_wasm_section(out, 1, type_sec)
    let func_sec = writer_core::WasmWriter_new()
    writer_core::emit_leb128_u(func_sec, 2)
    writer_core::emit_leb128_u(func_sec, 0)
    writer_core::emit_leb128_u(func_sec, 1)
    p2_stub_emit_wasm_section(out, 3, func_sec)
    p2_stub_emit_core_exports(out, "open-at", "close", 2)
    p2_stub_emit_module_name(out, "stub_fs")
    writer_core::writer_bytes(out)
}

// Core stub that satisfies the generated runtime bridge's `host` imports.
// Command components use this instead of canon-lowering the WASI adapter, so
// wasmtime's default CLI linker can run hello without wasi:http leftovers.
fn p2_stub_runtime_host_module() -> Vec<i32> {
    let mut hex = "0061736d01000000012a076000017f60027f7f0060017f017f60027f7f017f60017f0060037f7f7f017f60067f7f7f7f7f7f017f0316150001020304"
    hex = concat(hex, "0000030303030305030605020505030307e103151272756e74696d652d6275666665722d6e657700001372756e74696d652d6275666665722d707573")
    hex = concat(hex, "6800011272756e74696d652d6275666665722d6c656e00021372756e74696d652d6275666665722d6279746500031472756e74696d652d6275666665")
    hex = concat(hex, "722d636c6f736500041772756e74696d652d656e762d63757272656e742d64697200051072756e74696d652d656e762d7661727300061972756e7469")
    hex = concat(hex, "6d652d66732d6372656174652d6469722d616c6c00071372756e74696d652d66732d6d6574616461746100081472756e74696d652d66732d72656164")
    hex = concat(hex, "2d66696c6500091372756e74696d652d66732d726561642d646972000a1672756e74696d652d66732d72656d6f76652d66696c65000b1672756e7469")
    hex = concat(hex, "6d652d66732d77726974652d6279746573000c1072756e74696d652d687474702d676574000d1472756e74696d652d687474702d7265717565737400")
    hex = concat(hex, "0e1272756e74696d652d687474702d7365727665000f1572756e74696d652d736f636b65742d61636365707400101672756e74696d652d736f636b65")
    hex = concat(hex, "742d636f6e6e65637400111572756e74696d652d736f636b65742d6c697374656e00121372756e74696d652d736f636b65742d726561640013147275")
    hex = concat(hex, "6e74696d652d736f636b65742d777269746500140a6615040041000b02000b040041000b040041000b02000b040041000b040041000b040041000b04")
    hex = concat(hex, "0041000b040041000b040041000b040041000b040041000b040041000b040041000b040041000b040041000b040041000b040041000b040041000b04")
    hex = concat(hex, "0041000b008601046e616d65016015000266300102663102026632030266330402663405026635060266360702663708026638090266390a03663130")
    hex = concat(hex, "0b036631310c036631320d036631330e036631340f0366313510036631361103663137120366313813036631391403663230041d0700027430010274")
    hex = concat(hex, "310202743203027433040274340502743506027436")
    p2_stub_hex_to_bytes(hex)
}

fn p2_stub_run_adapter_module() -> Vec<i32> {
    p2_stub_hex_to_bytes("0061736d010000000108026000006000017f021001000b67756573745f73746172740000030201010707010372756e00010a08010600100041000b")
}

fn p2_stub_guest_start_wrapper_module() -> Vec<i32> {
    p2_stub_hex_to_bytes("0061736d0100000001040160000003020100070f010b67756573745f737461727400000a040102000b")
}

fn p2_stub_hex_to_bytes(hex: String) -> Vec<i32> {
    let out = Vec::new<i32>()
    let n = len(hex)
    let mut i = 0
    while i + 1 < n {
        let hi = p2_stub_hex_val(char_at(hex, i))
        let lo = p2_stub_hex_val(char_at(hex, i + 1))
        push(out, hi * 16 + lo)
        i = i + 2
    }
    out
}

fn p2_stub_hex_val(c: i32) -> i32 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    0
}

fn p2_stub_emit_exports(out: WasmWriter, export_name: String, func_idx: i32, void_ret: i32) {
    let export_names = Vec::new<String>()
    push(export_names, clone(export_name))
    let func_idxs = Vec::new<i32>()
    push(func_idxs, func_idx)
    p2_stub_emit_core_exports_list(out, export_names, func_idxs)
    if void_ret == 1 {
        p2_stub_emit_void_body(out)
    } else {
        p2_stub_emit_return_zero_bodies(out, 1)
    }
}

fn p2_stub_emit_core_exports(out: WasmWriter, export_a: String, export_b: String, body_count: i32) {
    let export_names = Vec::new<String>()
    push(export_names, clone(export_a))
    push(export_names, clone(export_b))
    let func_idxs = Vec::new<i32>()
    push(func_idxs, 0)
    push(func_idxs, 1)
    p2_stub_emit_core_exports_list(out, export_names, func_idxs)
    p2_stub_emit_return_zero_bodies(out, body_count)
}

fn p2_stub_emit_core_exports_list(out: WasmWriter, export_names: Vec<String>, func_idxs: Vec<i32>) {
    let export_sec = writer_core::WasmWriter_new()
    writer_core::emit_leb128_u(export_sec, len(export_names))
    for i in 0..len(export_names) {
        writer_string::emit_string(export_sec, get_unchecked(export_names, i))
        writer_core::emit_byte(export_sec, 0x00)
        writer_core::emit_leb128_u(export_sec, get_unchecked(func_idxs, i))
    }
    p2_stub_emit_wasm_section(out, 7, export_sec)
}

fn p2_stub_emit_return_zero_bodies(out: WasmWriter, body_count: i32) {
    let code_sec = writer_core::WasmWriter_new()
    writer_core::emit_leb128_u(code_sec, body_count)
    for i in 0..body_count {
        writer_core::emit_leb128_u(code_sec, 4)
        writer_core::emit_leb128_u(code_sec, 0)
        writer_core::emit_byte(code_sec, 0x41)
        writer_core::emit_leb128_u(code_sec, 0)
        writer_core::emit_byte(code_sec, 0x0b)
    }
    p2_stub_emit_wasm_section(out, 10, code_sec)
}

fn p2_stub_emit_void_body(out: WasmWriter) {
    let code_sec = writer_core::WasmWriter_new()
    writer_core::emit_leb128_u(code_sec, 1)
    writer_core::emit_leb128_u(code_sec, 2)
    writer_core::emit_leb128_u(code_sec, 0)
    writer_core::emit_byte(code_sec, 0x0b)
    p2_stub_emit_wasm_section(out, 10, code_sec)
}

fn p2_stub_emit_module_name(out: WasmWriter, module_name: String) {
    let name_sec = writer_core::WasmWriter_new()
    writer_string::emit_string(name_sec, "name")
    writer_core::emit_byte(name_sec, 0x00)
    let name_body = writer_core::WasmWriter_new()
    writer_string::emit_string(name_body, module_name)
    writer_core::emit_leb128_u(name_sec, writer_core::writer_size(name_body))
    writer_core::emit_bytes(name_sec, writer_core::writer_bytes(name_body))
    p2_stub_emit_wasm_section(out, 0, name_sec)
}
