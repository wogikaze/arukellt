use wasm::string_gc_helpers
use wasm::ctx_gc_type

fn emit_gc_wasi_read_stdin_to_string(w: WasmWriter, ctx: SelfEmitCtx) {
    // std::host::stdio::read_stdin is documented to return empty until the GC
    // WASI stdin path yields a stable empty-EOF string. The core_op intercept
    // must honor that contract instead of copying an unbounded WASI buffer.
    let string_type = ctx_gc_type::SelfEmitCtx_string_type(ctx)
    string_gc_helpers::emit_gc_i32_const(w, 0)
    string_gc_helpers::emit_gc_array_new(w, string_type)
}
