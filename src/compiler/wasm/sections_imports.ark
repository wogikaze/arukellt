use wasm::opcodes
use wasm::constants
use wasm::writer_core
use wasm::writer_sections
use wasm::writer_string
use wasm::emit_target
use wasm::sections_wit_imports
use mir::module_wit_imports

fn emit_import_section(
    out: WasmWriter,
    host_type_map: Vec<i32>,
    target: String,
    wasi_version: String,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    wit_type_map: Vec<i32>
) {
    let import_sec = writer_core::WasmWriter_new()
    let wit_count = module_wit_imports::wit_import_count(bindings)
    writer_core::emit_leb128_u(import_sec, emit_target::total_import_count(clone(target), clone(wasi_version), wit_count))
    if emit_target::is_p2_wasi(clone(wasi_version)) {
        emit_p2_import_entries(import_sec, host_type_map)
    } else if emit_target::is_minimal_p1_wasi(clone(wasi_version)) {
        emit_wasi_component_stub_import_entries(import_sec, host_type_map)
    } else {
        emit_wasi_import_entries(import_sec, host_type_map)
    }
    sections_wit_imports::emit_wit_import_entries(import_sec, bindings, wit_type_map, clone(wasi_version))
    writer_sections::emit_section(out, opcodes::SEC_IMPORT(), import_sec)
}

fn wasi_snapshot_module_name() -> String {
    String_from("wasi_snapshot_preview1")
}

fn emit_wasi_component_stub_import_entries(import_sec: WasmWriter, host_type_map: Vec<i32>) {
    let wasi_module = wasi_snapshot_module_name()
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_write"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("args_sizes_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("args_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("path_open"), get_unchecked(host_type_map, 2))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_read"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_close"), get_unchecked(host_type_map, 3))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("proc_exit"), get_unchecked(host_type_map, 4))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("clock_time_get"), get_unchecked(host_type_map, 5))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("random_get"), get_unchecked(host_type_map, 1))
}

fn emit_wasi_import_entries(
    import_sec: WasmWriter,
    host_type_map: Vec<i32>
) {
    let wasi_module = wasi_snapshot_module_name()
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_write"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("args_sizes_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("args_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("path_open"), get_unchecked(host_type_map, 2))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_read"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_close"), get_unchecked(host_type_map, 3))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("proc_exit"), get_unchecked(host_type_map, 4))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("clock_time_get"), get_unchecked(host_type_map, 5))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("clock_res_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("random_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("environ_sizes_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("environ_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_seek"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_tell"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_fdstat_get"), get_unchecked(host_type_map, 3))
}

fn p2_module_name(interface_name: String) -> String {
    concat("cm32p2|wasi:", concat(interface_name, "@0.2"))
}

fn emit_p2_import_entries(import_sec: WasmWriter, host_type_map: Vec<i32>) {
    // Standard component-model core names are the official lowering contract.
    emit_host_func_import(
        import_sec,
        p2_module_name("cli/stdout"),
        String_from("get-stdout"),
        get_unchecked(host_type_map, constants::P2_HOST_TYPE_GET_STREAM())
    )
    emit_host_func_import(
        import_sec,
        p2_module_name("io/streams"),
        String_from("[method]output-stream.blocking-write-and-flush"),
        get_unchecked(host_type_map, constants::P2_HOST_TYPE_BWAF())
    )
    emit_host_func_import(import_sec, p2_module_name("cli/environment"), String_from("get-arguments"), get_unchecked(host_type_map, 4))
    emit_host_func_import(import_sec, p2_module_name("cli/environment"), String_from("get-environment"), get_unchecked(host_type_map, 4))
    emit_host_func_import(import_sec, p2_module_name("filesystem/types"), String_from("[method]descriptor.open-at"), get_unchecked(host_type_map, constants::P2_HOST_TYPE_OPEN_AT()))
    emit_host_func_import(import_sec, p2_module_name("filesystem/types"), String_from("[method]descriptor.read"), get_unchecked(host_type_map, constants::P2_HOST_TYPE_DESCRIPTOR_READ()))
    emit_host_func_import(import_sec, p2_module_name("filesystem/types"), String_from("[method]descriptor.write"), get_unchecked(host_type_map, constants::P2_HOST_TYPE_DESCRIPTOR_WRITE()))
    emit_host_func_import(import_sec, p2_module_name("cli/stdin"), String_from("get-stdin"), get_unchecked(host_type_map, constants::P2_HOST_TYPE_GET_STREAM()))
    emit_host_func_import(import_sec, p2_module_name("io/streams"), String_from("[method]input-stream.blocking-read"), get_unchecked(host_type_map, constants::P2_HOST_TYPE_INPUT_READ()))
    emit_host_func_import(import_sec, p2_module_name("filesystem/types"), String_from("descriptor_drop"), get_unchecked(host_type_map, 4))
    emit_host_func_import(import_sec, p2_module_name("cli/exit"), String_from("exit"), get_unchecked(host_type_map, 4))
    emit_host_func_import(
        import_sec,
        p2_module_name("cli/stderr"),
        String_from("get-stderr"),
        get_unchecked(host_type_map, constants::P2_HOST_TYPE_GET_STREAM())
    )
    emit_host_func_import(import_sec, p2_module_name("clocks/monotonic-clock"), String_from("now"), get_unchecked(host_type_map, 5))
    emit_host_func_import(import_sec, p2_module_name("clocks/wall-clock"), String_from("now"), get_unchecked(host_type_map, 4))
    emit_host_func_import(import_sec, p2_module_name("random/random"), String_from("get-random-u64"), get_unchecked(host_type_map, 5))
    emit_host_func_import(import_sec, p2_module_name("filesystem/preopens"), String_from("get-directories"), get_unchecked(host_type_map, 4))
}

fn emit_host_func_import(import_sec: WasmWriter, host_module: String, import_name: String, type_idx: i32) {
    writer_string::emit_string(import_sec, host_module)
    writer_string::emit_string(import_sec, import_name)
    writer_core::emit_byte(import_sec, 0)
    writer_core::emit_leb128_u(import_sec, type_idx)
}
