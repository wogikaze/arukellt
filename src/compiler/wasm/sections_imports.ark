use std::text
use wasm::opcodes
use wasm::constants
use wasm::writer_core
use wasm::writer_sections
use wasm::writer_string
use wasm::emit_target
use wasm::sections_wit_imports
use mir::module_wit_imports
fn emit_import_section(
    mut out: WasmWriter,
    host_type_map: Vec<i32>,
    target: String,
    wasi_version: String,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    wit_type_map: Vec<i32>
) {
    let mut import_sec = writer_core::WasmWriter_new()
    let wit_count = module_wit_imports::wit_import_count(bindings)
    writer_core::emit_leb128_u(import_sec, emit_target::total_import_count(target.clone(), wasi_version.clone(), wit_count))
    if emit_target::is_p2_wasi(wasi_version.clone()) {
        emit_p2_import_entries(import_sec, host_type_map)
    } else if emit_target::is_minimal_p1_wasi(wasi_version.clone()) {
        emit_wasi_component_stub_import_entries(import_sec, host_type_map)
    } else {
        emit_wasi_import_entries(import_sec, host_type_map)
    }
    sections_wit_imports::emit_wit_import_entries(import_sec, bindings, wit_type_map, wasi_version.clone())
    writer_sections::emit_section(out, opcodes::SEC_IMPORT(), import_sec)
}

fn wasi_snapshot_module_name() -> String {
    String_from("wasi_snapshot_preview1")
}

fn emit_wasi_component_stub_import_entries(mut import_sec: WasmWriter, host_type_map: Vec<i32>) {
    let wasi_module = wasi_snapshot_module_name()
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("fd_write"), host_type_map.get_unchecked(0))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("args_sizes_get"), host_type_map.get_unchecked(1))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("args_get"), host_type_map.get_unchecked(1))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("path_open"), host_type_map.get_unchecked(2))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("fd_read"), host_type_map.get_unchecked(0))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("fd_close"), host_type_map.get_unchecked(3))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("proc_exit"), host_type_map.get_unchecked(4))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("clock_time_get"), host_type_map.get_unchecked(5))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("random_get"), host_type_map.get_unchecked(1))
}

fn emit_wasi_import_entries(
    mut import_sec: WasmWriter,
    host_type_map: Vec<i32>
) {
    let wasi_module = wasi_snapshot_module_name()
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("fd_write"), host_type_map.get_unchecked(0))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("args_sizes_get"), host_type_map.get_unchecked(1))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("args_get"), host_type_map.get_unchecked(1))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("path_open"), host_type_map.get_unchecked(2))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("fd_read"), host_type_map.get_unchecked(0))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("fd_close"), host_type_map.get_unchecked(3))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("proc_exit"), host_type_map.get_unchecked(4))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("clock_time_get"), host_type_map.get_unchecked(5))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("clock_res_get"), host_type_map.get_unchecked(1))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("random_get"), host_type_map.get_unchecked(1))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("environ_sizes_get"), host_type_map.get_unchecked(1))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("environ_get"), host_type_map.get_unchecked(1))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("fd_seek"), host_type_map.get_unchecked(0))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("fd_tell"), host_type_map.get_unchecked(0))
    emit_host_func_import(import_sec, wasi_module.clone(), String_from("fd_fdstat_get"), host_type_map.get_unchecked(3))
}

fn p2_module_name(interface_name: String) -> String {
    "cm32p2|wasi:".concat(interface_name.concat("@0.2"))
}

fn emit_p2_import_entries(mut import_sec: WasmWriter, host_type_map: Vec<i32>) {
    // Standard component-model core names are the official lowering contract.
    emit_host_func_import(
        import_sec,
        p2_module_name("cli/stdout"),
        String_from("get-stdout"),
        host_type_map.get_unchecked(constants::P2_HOST_TYPE_GET_STREAM())
    )
    emit_host_func_import(
        import_sec,
        p2_module_name("io/streams"),
        String_from("[method]output-stream.blocking-write-and-flush"),
        host_type_map.get_unchecked(constants::P2_HOST_TYPE_BWAF())
    )
    emit_host_func_import(import_sec, p2_module_name("cli/environment"), String_from("get-arguments"), host_type_map.get_unchecked(4))
    emit_host_func_import(import_sec, p2_module_name("cli/environment"), String_from("get-environment"), host_type_map.get_unchecked(4))
    emit_host_func_import(import_sec, p2_module_name("filesystem/types"), String_from("[method]descriptor.open-at"), host_type_map.get_unchecked(constants::P2_HOST_TYPE_OPEN_AT()))
    emit_host_func_import(import_sec, p2_module_name("filesystem/types"), String_from("[method]descriptor.read"), host_type_map.get_unchecked(constants::P2_HOST_TYPE_DESCRIPTOR_READ()))
    emit_host_func_import(import_sec, p2_module_name("filesystem/types"), String_from("[method]descriptor.write"), host_type_map.get_unchecked(constants::P2_HOST_TYPE_DESCRIPTOR_WRITE()))
    emit_host_func_import(import_sec, p2_module_name("cli/stdin"), String_from("get-stdin"), host_type_map.get_unchecked(constants::P2_HOST_TYPE_GET_STREAM()))
    emit_host_func_import(import_sec, p2_module_name("io/streams"), String_from("[method]input-stream.blocking-read"), host_type_map.get_unchecked(constants::P2_HOST_TYPE_INPUT_READ()))
    emit_host_func_import(import_sec, p2_module_name("filesystem/types"), String_from("descriptor_drop"), host_type_map.get_unchecked(4))
    emit_host_func_import(import_sec, p2_module_name("cli/exit"), String_from("exit"), host_type_map.get_unchecked(4))
    emit_host_func_import(
        import_sec,
        p2_module_name("cli/stderr"),
        String_from("get-stderr"),
        host_type_map.get_unchecked(constants::P2_HOST_TYPE_GET_STREAM())
    )
    emit_host_func_import(import_sec, p2_module_name("clocks/monotonic-clock"), String_from("now"), host_type_map.get_unchecked(5))
    emit_host_func_import(import_sec, p2_module_name("clocks/wall-clock"), String_from("now"), host_type_map.get_unchecked(4))
    emit_host_func_import(import_sec, p2_module_name("random/random"), String_from("get-random-u64"), host_type_map.get_unchecked(5))
    emit_host_func_import(import_sec, p2_module_name("filesystem/preopens"), String_from("get-directories"), host_type_map.get_unchecked(4))
}

fn emit_host_func_import(mut import_sec: WasmWriter, host_module: String, import_name: String, type_idx: i32) {
    writer_string::emit_string(import_sec, host_module)
    writer_string::emit_string(import_sec, import_name)
    writer_core::emit_byte(import_sec, 0)
    writer_core::emit_leb128_u(import_sec, type_idx)
}
