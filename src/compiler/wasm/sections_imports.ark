use wasm::opcodes
use wasm::constants
use wasm::writer_core
use wasm::writer_sections
use wasm::writer_string
use wasm::emit_target
use wasm::sections_wit_imports
use mir::module_wit_imports

fn emit_import_section(
    out: WasmWriter,
    host_type_map: Vec<i32>,
    target: String,
    wasi_version: String,
    needs_arukellt_host: i32,
    needs_wasi_http_outgoing: i32,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    wit_type_map: Vec<i32>
) {
    let import_sec = writer_core::WasmWriter_new()
    let wit_count = module_wit_imports::wit_import_count(bindings)
    writer_core::emit_leb128_u(import_sec, emit_target::total_import_count(clone(target), clone(wasi_version), needs_arukellt_host, needs_wasi_http_outgoing, wit_count))
    if emit_target::is_p2_wasi(clone(wasi_version)) {
        emit_p2_import_entries(import_sec, host_type_map, clone(wasi_version), needs_arukellt_host, needs_wasi_http_outgoing)
    } else if emit_target::is_component_stub_wasi(clone(wasi_version)) || emit_target::is_minimal_p1_wasi(clone(wasi_version), needs_arukellt_host) {
        emit_wasi_component_stub_import_entries(import_sec, host_type_map)
    } else {
        emit_wasi_import_entries(import_sec, host_type_map, clone(wasi_version), needs_arukellt_host, needs_wasi_http_outgoing)
    }
    sections_wit_imports::emit_wit_import_entries(import_sec, bindings, wit_type_map)
    writer_sections::emit_section(out, opcodes::SEC_IMPORT(), import_sec)
}

fn wasi_snapshot_module_name() -> String {
    "wasi_snapshot_preview1"
}

fn arukellt_io_module_name() -> String {
    "arukellt_io"
}

// Guest-core import modules for HTTP/sockets (#727 Phase 2/3).
// Module names are WIT-shaped (no `arukellt_host`). Function names remain the
// legacy simplified ABI symbols until component bridges lower to real
// wasi:http / wasi:sockets methods (#714 bridged pattern).
fn wit_http_outgoing_module_name() -> String {
    "wasi:http/outgoing-handler@0.2.0"
}

fn wit_http_incoming_module_name() -> String {
    "wasi:http/incoming-handler@0.2.0"
}

fn wit_sockets_tcp_module_name() -> String {
    "wasi:sockets/tcp@0.2.0"
}

fn wit_io_streams_module_name() -> String {
    "wasi:io/streams@0.2.0"
}

// Bridged network types follow the WASI base host types.
// On wasi-p2 after #668 guest-native stdio, slots before network are:
//   5=monotonic(1i64), 6=wall(MR_i64_i32), 7=get-stream(1i32), 8=bwaf(..._0),
//   optional 9=outgoing-handler spacer, then network at 9/10+.
// So P2 needs +3 vs P1 (wall + get-stream + bwaf). `needs_wasi_http_outgoing`
// inserts one more spacer before network types.
fn network_host_type_offset(wasi_version: String, needs_wasi_http_outgoing: i32) -> i32 {
    let mut off = if needs_wasi_http_outgoing == 1 { 1 } else { 0 }
    if emit_target::is_p2_wasi(clone(wasi_version)) {
        off = off + 3
    }
    off
}

fn emit_network_wit_import_entries(
    import_sec: WasmWriter,
    host_type_map: Vec<i32>,
    wasi_version: String,
    needs_wasi_http_outgoing: i32
) {
    let host_type_off = network_host_type_offset(clone(wasi_version), needs_wasi_http_outgoing)
    let http_out = wit_http_outgoing_module_name()
    let http_in = wit_http_incoming_module_name()
    let tcp = wit_sockets_tcp_module_name()
    let streams = wit_io_streams_module_name()
    emit_host_func_import(import_sec, clone(http_out), "http_get", get_unchecked(host_type_map, constants::WASI_HOST_TYPE_HTTP_GET() + host_type_off))
    emit_host_func_import(import_sec, clone(http_out), "http_request", get_unchecked(host_type_map, constants::WASI_HOST_TYPE_HTTP_REQUEST() + host_type_off))
    emit_host_func_import(import_sec, clone(tcp), "sockets_connect", get_unchecked(host_type_map, constants::WASI_HOST_TYPE_SOCKETS_CONNECT() + host_type_off))
    emit_host_func_import(import_sec, clone(streams), "sockets_read", get_unchecked(host_type_map, constants::WASI_HOST_TYPE_HTTP_GET() + host_type_off))
    emit_host_func_import(import_sec, clone(streams), "sockets_write", get_unchecked(host_type_map, constants::WASI_HOST_TYPE_SOCKETS_CONNECT() + host_type_off))
    emit_host_func_import(import_sec, clone(tcp), "sockets_listen", get_unchecked(host_type_map, constants::WASI_HOST_TYPE_SOCKETS_CONNECT() + host_type_off))
    emit_host_func_import(import_sec, clone(tcp), "sockets_accept", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(http_in), "http_serve", get_unchecked(host_type_map, constants::WASI_HOST_TYPE_SOCKETS_CONNECT() + host_type_off))
}

fn emit_t2_import_entries(import_sec: WasmWriter, host_type_map: Vec<i32>) {
    let io_module = arukellt_io_module_name()
    emit_host_func_import(import_sec, clone(io_module), "write", get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(io_module), "write_err", get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(io_module), "flush", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(io_module), "flush_err", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(io_module), "read", get_unchecked(host_type_map, 2))
}

fn emit_wasi_component_stub_import_entries(import_sec: WasmWriter, host_type_map: Vec<i32>) {
    let wasi_module = wasi_snapshot_module_name()
    emit_host_func_import(import_sec, clone(wasi_module), "fd_write", get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), "args_sizes_get", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), "args_get", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), "path_open", get_unchecked(host_type_map, 2))
    emit_host_func_import(import_sec, clone(wasi_module), "fd_read", get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), "fd_close", get_unchecked(host_type_map, 3))
    emit_host_func_import(import_sec, clone(wasi_module), "proc_exit", get_unchecked(host_type_map, 4))
    emit_host_func_import(import_sec, clone(wasi_module), "clock_time_get", get_unchecked(host_type_map, 5))
    emit_host_func_import(import_sec, clone(wasi_module), "random_get", get_unchecked(host_type_map, 1))
}

fn emit_wasi_import_entries(
    import_sec: WasmWriter,
    host_type_map: Vec<i32>,
    wasi_version: String,
    needs_arukellt_host: i32,
    needs_wasi_http_outgoing: i32
) {
    let wasi_module = wasi_snapshot_module_name()
    emit_host_func_import(import_sec, clone(wasi_module), "fd_write", get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), "args_sizes_get", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), "args_get", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), "path_open", get_unchecked(host_type_map, 2))
    emit_host_func_import(import_sec, clone(wasi_module), "fd_read", get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), "fd_close", get_unchecked(host_type_map, 3))
    emit_host_func_import(import_sec, clone(wasi_module), "proc_exit", get_unchecked(host_type_map, 4))
    emit_host_func_import(import_sec, clone(wasi_module), "clock_time_get", get_unchecked(host_type_map, 5))
    emit_host_func_import(import_sec, clone(wasi_module), "clock_res_get", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), "random_get", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), "environ_sizes_get", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), "environ_get", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), "fd_seek", get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), "fd_tell", get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), "fd_fdstat_get", get_unchecked(host_type_map, 3))
    if needs_arukellt_host == 1 {
        emit_network_wit_import_entries(import_sec, host_type_map, clone(wasi_version), needs_wasi_http_outgoing)
    }
}

fn emit_p2_outgoing_handler_import(import_sec: WasmWriter, host_type_map: Vec<i32>) {
    emit_host_func_import(import_sec, wit_http_outgoing_module_name(), "handle", get_unchecked(host_type_map, constants::WASI_HOST_TYPE_HTTP_OUTGOING()))
}

fn emit_p2_incoming_handler_import(import_sec: WasmWriter, host_type_map: Vec<i32>) {
    emit_host_func_import(import_sec, wit_http_incoming_module_name(), "handle", get_unchecked(host_type_map, constants::WASI_HOST_TYPE_HTTP_OUTGOING()))
}

fn emit_p2_import_entries(
    import_sec: WasmWriter,
    host_type_map: Vec<i32>,
    wasi_version: String,
    needs_arukellt_host: i32,
    needs_wasi_http_outgoing: i32
) {
    // Guest-native stdio: get-stdout + streams.bwaf (+ get-stderr below).
    emit_host_func_import(
        import_sec,
        "wasi:cli/stdout@0.2.0",
        "get-stdout",
        get_unchecked(host_type_map, constants::P2_HOST_TYPE_GET_STREAM())
    )
    emit_host_func_import(
        import_sec,
        "wasi:io/streams@0.2.0",
        "blocking-write-and-flush",
        get_unchecked(host_type_map, constants::P2_HOST_TYPE_BWAF())
    )
    emit_host_func_import(import_sec, "wasi:cli/environment@0.2.0", "args-sizes", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, "wasi:cli/environment@0.2.0", "arguments", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, "wasi:filesystem/types@0.2.0", "open-at", get_unchecked(host_type_map, 2))
    emit_host_func_import(import_sec, "wasi:cli/stdin@0.2.0", "read", get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, "wasi:filesystem/types@0.2.0", "close", get_unchecked(host_type_map, 3))
    emit_host_func_import(import_sec, "wasi:cli/exit@0.2.0", "exit", get_unchecked(host_type_map, 4))
    // Stderr + environ sit before clocks/random so strip_wit_imports can still
    // treat clocks/random as a trailing suffix.
    emit_host_func_import(
        import_sec,
        "wasi:cli/stderr@0.2.0",
        "get-stderr",
        get_unchecked(host_type_map, constants::P2_HOST_TYPE_GET_STREAM())
    )
    emit_host_func_import(import_sec, "wasi:cli/environment@0.2.0", "environ-sizes", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, "wasi:cli/environment@0.2.0", "environ-get", get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, "wasi:clocks/monotonic-clock@0.2.0", "now", get_unchecked(host_type_map, 5))
    emit_host_func_import(import_sec, "wasi:clocks/wall-clock@0.2.0", "now", get_unchecked(host_type_map, 6))
    emit_host_func_import(import_sec, "wasi:random/random@0.2.0", "get-random-u64", get_unchecked(host_type_map, 5))
    if needs_wasi_http_outgoing == 1 {
        emit_p2_outgoing_handler_import(import_sec, host_type_map)
        emit_p2_incoming_handler_import(import_sec, host_type_map)
    }
    if needs_arukellt_host == 1 {
        emit_network_wit_import_entries(import_sec, host_type_map, clone(wasi_version), needs_wasi_http_outgoing)
    }
}

fn emit_host_func_import(import_sec: WasmWriter, host_module: String, import_name: String, type_idx: i32) {
    writer_string::emit_string(import_sec, host_module)
    writer_string::emit_string(import_sec, import_name)
    writer_core::emit_byte(import_sec, 0)
    writer_core::emit_leb128_u(import_sec, type_idx)
}
