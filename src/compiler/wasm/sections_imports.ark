use wasm::opcodes
use wasm::constants
use wasm::writer_core
use wasm::writer_sections
use wasm::writer_string
use wasm::emit_target
use wasm::sections_wit_imports
use mir::module_wit_imports

fn emit_import_section(
    out: WasmWriter,
    host_type_map: Vec<i32>,
    target: String,
    wasi_version: String,
    needs_runtime_host: i32,
    needs_wasi_http_outgoing: i32,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    wit_type_map: Vec<i32>
) {
    let import_sec = writer_core::WasmWriter_new()
    let wit_count = module_wit_imports::wit_import_count(bindings)
    writer_core::emit_leb128_u(import_sec, emit_target::total_import_count(clone(target), clone(wasi_version), needs_runtime_host, needs_wasi_http_outgoing, wit_count))
    if emit_target::is_p2_wasi(clone(wasi_version)) {
        emit_p2_import_entries(import_sec, host_type_map, clone(wasi_version), needs_runtime_host, needs_wasi_http_outgoing)
    } else if emit_target::is_component_stub_wasi(clone(wasi_version)) || emit_target::is_minimal_p1_wasi(clone(wasi_version), needs_runtime_host) {
        emit_wasi_component_stub_import_entries(import_sec, host_type_map)
    } else {
        emit_wasi_import_entries(import_sec, host_type_map, clone(wasi_version), needs_runtime_host, needs_wasi_http_outgoing)
    }
    sections_wit_imports::emit_wit_import_entries(import_sec, bindings, wit_type_map)
    writer_sections::emit_section(out, opcodes::SEC_IMPORT(), import_sec)
}

fn wasi_snapshot_module_name() -> String {
    String_from("wasi_snapshot_preview1")
}

fn arukellt_io_module_name() -> String {
    String_from("arukellt_io")
}

// Guest-core import modules for HTTP/sockets (#727 Phase 2/3).
// Module names are WIT-shaped (no `arukellt_host`). Function names remain the
// legacy simplified ABI symbols until component bridges lower to real
// wasi:http / wasi:sockets methods (#714 bridged pattern).
fn wit_http_outgoing_module_name() -> String {
    String_from("wasi:http/outgoing-handler@0.2.0")
}

fn wit_http_incoming_module_name() -> String {
    String_from("wasi:http/incoming-handler@0.2.0")
}

fn wit_sockets_tcp_module_name() -> String {
    String_from("wasi:sockets/tcp@0.2.0")
}

fn wit_io_streams_module_name() -> String {
    String_from("wasi:io/streams@0.2.0")
}

// Bridged network types follow the WASI base host types.
// On wasi-p2 after #668 guest-native stdio, slots before network are:
//   5=monotonic(1i64), 6=wall(MR_i64_i32), 7=get-stream(1i32), 8=bwaf(..._0),
//   optional 9=outgoing-handler spacer, then network at 9/10+.
// So P2 needs +3 vs P1 (wall + get-stream + bwaf). `needs_wasi_http_outgoing`
// inserts one more spacer before network types.
fn network_host_type_offset(wasi_version: String, needs_wasi_http_outgoing: i32) -> i32 {
    let mut off = if needs_wasi_http_outgoing == 1 { 1 } else { 0 }
    if emit_target::is_p2_wasi(clone(wasi_version)) {
        off = off + 3
    }
    off
}

fn emit_network_wit_import_entries(
    import_sec: WasmWriter,
    host_type_map: Vec<i32>,
    wasi_version: String,
    needs_wasi_http_outgoing: i32
) {
    let host_type_off = network_host_type_offset(clone(wasi_version), needs_wasi_http_outgoing)
    let http_out = wit_http_outgoing_module_name()
    let http_in = wit_http_incoming_module_name()
    let tcp = wit_sockets_tcp_module_name()
    let streams = wit_io_streams_module_name()
    emit_host_func_import(import_sec, clone(http_out), String_from("http_get"), get_unchecked(host_type_map, constants::WASI_HOST_TYPE_HTTP_GET() + host_type_off))
    emit_host_func_import(import_sec, clone(http_out), String_from("http_request"), get_unchecked(host_type_map, constants::WASI_HOST_TYPE_HTTP_REQUEST() + host_type_off))
    emit_host_func_import(import_sec, clone(tcp), String_from("sockets_connect"), get_unchecked(host_type_map, constants::WASI_HOST_TYPE_SOCKETS_CONNECT() + host_type_off))
    emit_host_func_import(import_sec, clone(streams), String_from("sockets_read"), get_unchecked(host_type_map, constants::WASI_HOST_TYPE_HTTP_GET() + host_type_off))
    emit_host_func_import(import_sec, clone(streams), String_from("sockets_write"), get_unchecked(host_type_map, constants::WASI_HOST_TYPE_SOCKETS_CONNECT() + host_type_off))
    emit_host_func_import(import_sec, clone(tcp), String_from("sockets_listen"), get_unchecked(host_type_map, constants::WASI_HOST_TYPE_SOCKETS_CONNECT() + host_type_off))
    emit_host_func_import(import_sec, clone(tcp), String_from("sockets_accept"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(http_in), String_from("http_serve"), get_unchecked(host_type_map, constants::WASI_HOST_TYPE_SOCKETS_CONNECT() + host_type_off))
}

fn emit_t2_import_entries(import_sec: WasmWriter, host_type_map: Vec<i32>) {
    let io_module = arukellt_io_module_name()
    emit_host_func_import(import_sec, clone(io_module), String_from("write"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(io_module), String_from("write_err"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(io_module), String_from("flush"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(io_module), String_from("flush_err"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(io_module), String_from("read"), get_unchecked(host_type_map, 2))
}

fn emit_wasi_component_stub_import_entries(import_sec: WasmWriter, host_type_map: Vec<i32>) {
    let wasi_module = wasi_snapshot_module_name()
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_write"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("args_sizes_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("args_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("path_open"), get_unchecked(host_type_map, 2))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_read"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_close"), get_unchecked(host_type_map, 3))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("proc_exit"), get_unchecked(host_type_map, 4))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("clock_time_get"), get_unchecked(host_type_map, 5))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("random_get"), get_unchecked(host_type_map, 1))
}

fn emit_wasi_import_entries(
    import_sec: WasmWriter,
    host_type_map: Vec<i32>,
    wasi_version: String,
    needs_runtime_host: i32,
    needs_wasi_http_outgoing: i32
) {
    let wasi_module = wasi_snapshot_module_name()
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_write"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("args_sizes_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("args_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("path_open"), get_unchecked(host_type_map, 2))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_read"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_close"), get_unchecked(host_type_map, 3))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("proc_exit"), get_unchecked(host_type_map, 4))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("clock_time_get"), get_unchecked(host_type_map, 5))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("clock_res_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("random_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("environ_sizes_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("environ_get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_seek"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_tell"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, clone(wasi_module), String_from("fd_fdstat_get"), get_unchecked(host_type_map, 3))
    if needs_runtime_host == 1 {
        emit_network_wit_import_entries(import_sec, host_type_map, clone(wasi_version), needs_wasi_http_outgoing)
    }
}

fn emit_p2_outgoing_handler_import(import_sec: WasmWriter, host_type_map: Vec<i32>) {
    emit_host_func_import(import_sec, wit_http_outgoing_module_name(), String_from("handle"), get_unchecked(host_type_map, constants::WASI_HOST_TYPE_HTTP_OUTGOING()))
}

fn emit_p2_incoming_handler_import(import_sec: WasmWriter, host_type_map: Vec<i32>) {
    emit_host_func_import(import_sec, wit_http_incoming_module_name(), String_from("handle"), get_unchecked(host_type_map, constants::WASI_HOST_TYPE_HTTP_OUTGOING()))
}

fn emit_p2_import_entries(
    import_sec: WasmWriter,
    host_type_map: Vec<i32>,
    wasi_version: String,
    needs_runtime_host: i32,
    needs_wasi_http_outgoing: i32
) {
    // Guest-native stdio: get-stdout + streams.bwaf (+ get-stderr below).
    emit_host_func_import(
        import_sec,
        String_from("wasi:cli/stdout@0.2.0"),
        String_from("get-stdout"),
        get_unchecked(host_type_map, constants::P2_HOST_TYPE_GET_STREAM())
    )
    emit_host_func_import(
        import_sec,
        String_from("wasi:io/streams@0.2.0"),
        String_from("blocking-write-and-flush"),
        get_unchecked(host_type_map, constants::P2_HOST_TYPE_BWAF())
    )
    emit_host_func_import(import_sec, String_from("wasi:cli/environment@0.2.0"), String_from("args-sizes"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, String_from("wasi:cli/environment@0.2.0"), String_from("arguments"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, String_from("wasi:filesystem/types@0.2.0"), String_from("open-at"), get_unchecked(host_type_map, 2))
    // Bridged P1 fd_read/fd_write ABI for bootstrap host-linker (#834).
    // Keep off wasi:filesystem/types — stock WASI validate rejects bare
    // `read`/`write` there and breaks component close-gates (#074/#510).
    emit_host_func_import(import_sec, String_from("arukellt:fs@0.1.0"), String_from("read"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, String_from("arukellt:fs@0.1.0"), String_from("write"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, String_from("wasi:cli/stdin@0.2.0"), String_from("read"), get_unchecked(host_type_map, 0))
    emit_host_func_import(import_sec, String_from("wasi:filesystem/types@0.2.0"), String_from("close"), get_unchecked(host_type_map, 3))
    emit_host_func_import(import_sec, String_from("wasi:cli/exit@0.2.0"), String_from("exit"), get_unchecked(host_type_map, 4))
    // Stderr + environ sit before clocks/random so strip_wit_imports can still
    // treat clocks/random as a trailing suffix.
    emit_host_func_import(
        import_sec,
        String_from("wasi:cli/stderr@0.2.0"),
        String_from("get-stderr"),
        get_unchecked(host_type_map, constants::P2_HOST_TYPE_GET_STREAM())
    )
    emit_host_func_import(import_sec, String_from("wasi:cli/environment@0.2.0"), String_from("environ-sizes"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, String_from("wasi:cli/environment@0.2.0"), String_from("environ-get"), get_unchecked(host_type_map, 1))
    emit_host_func_import(import_sec, String_from("wasi:clocks/monotonic-clock@0.2.0"), String_from("now"), get_unchecked(host_type_map, 5))
    emit_host_func_import(import_sec, String_from("wasi:clocks/wall-clock@0.2.0"), String_from("now"), get_unchecked(host_type_map, 6))
    emit_host_func_import(import_sec, String_from("wasi:random/random@0.2.0"), String_from("get-random-u64"), get_unchecked(host_type_map, 5))
    // fd_write is `arukellt:fs@0.1.0::write` above (#834). Do not also emit
    // wasi:filesystem/types write — that desyncs NUM_P2_IMPORTS_BASE and fails
    // stock WASI validate (#074/#510 / merge of #807+#834).
    if needs_wasi_http_outgoing == 1 {
        emit_p2_outgoing_handler_import(import_sec, host_type_map)
        emit_p2_incoming_handler_import(import_sec, host_type_map)
    }
    if needs_runtime_host == 1 {
        emit_network_wit_import_entries(import_sec, host_type_map, clone(wasi_version), needs_wasi_http_outgoing)
    }
}

fn emit_host_func_import(import_sec: WasmWriter, host_module: String, import_name: String, type_idx: i32) {
    writer_string::emit_string(import_sec, host_module)
    writer_string::emit_string(import_sec, import_name)
    writer_core::emit_byte(import_sec, 0)
    writer_core::emit_leb128_u(import_sec, type_idx)
}
