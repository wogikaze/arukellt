use mir::function_locals_view
use mir::local_access
use mir::value_types
use wasm::constants
use wasm::ctx_record
use wasm::ctx_scratch
use wasm::emit_target
use wasm::opcodes
use wasm::writer_core

// The fallback runtime receives i32 roots. All linear managed values currently
// use i32 storage, so tracking every i32/ref local is conservative: ordinary
// integers may look like pointers, but the collector's aligned-range check
// makes that harmless. GC collection remains disabled until all managed writes
// are covered by this boundary.
fn should_emit(w: WasmWriter, ctx: SelfEmitCtx) -> bool {
    emit_target::is_linear_memory_target(ctx_record::SelfEmitCtx_target(ctx)) &&
    !writer_core::writer_memory64(w) &&
    writer_core::writer_linear_gc_root_frame_enter_function_index(w) >= 0
}

fn is_root_local(f: MirFunction, local_idx: i32) -> bool {
    if local_idx < 0 || local_idx >= function_locals_view::MirFunction_local_count(f) {
        return false
    }
    let vt = local_access::MirLocal_val_type(
        function_locals_view::MirFunction_local_at(f, local_idx)
    )
    vt == value_types::VT_I32() ||
    vt == value_types::VT_REF() ||
    vt == value_types::VT_GC_REF()
}

fn root_local_rank(f: MirFunction, local_idx: i32) -> i32 {
    let mut rank = 0
    let mut i = 0
    while i < local_idx {
        if is_root_local(f, i) {
            rank = rank + 1
        }
        i = i + 1
    }
    rank
}

fn emit_call(w: WasmWriter, function_index: i32) {
    writer_core::emit_byte(w, opcodes::OP_CALL())
    writer_core::emit_leb128_u(w, function_index)
}

fn emit_i32_const(w: WasmWriter, value: i32) {
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, value)
}

fn emit_frame_enter_and_push(w: WasmWriter, f: MirFunction, ctx: SelfEmitCtx) {
    if !should_emit(w, ctx) {
        return
    }
    emit_call(
        w,
        writer_core::writer_linear_gc_root_frame_enter_function_index(w)
    )
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, ctx_scratch::SelfEmitCtx_linear_root_frame_local(ctx))

    let local_count = function_locals_view::MirFunction_local_count(f)
    let mut local_idx = 0
    while local_idx < local_count {
        if is_root_local(f, local_idx) {
            writer_core::emit_local_get(w, local_idx)
            emit_call(w, writer_core::writer_linear_gc_root_push_function_index(w))
            writer_core::emit_byte(w, opcodes::OP_DROP())
        }
        local_idx = local_idx + 1
    }
}

fn emit_update_after_local_set(w: WasmWriter, ctx: SelfEmitCtx, local_idx: i32) {
    if !should_emit(w, ctx) {
        return
    }
    let f = ctx_record::SelfEmitCtx_function_at(
        ctx,
        ctx_record::SelfEmitCtx_current_func_idx(ctx)
    )
    if !is_root_local(f, local_idx) {
        return
    }
    writer_core::emit_local_get(w, ctx_scratch::SelfEmitCtx_linear_root_frame_local(ctx))
    emit_i32_const(w, constants::LINEAR_GC_ROOT_SLOT_BYTES() * (root_local_rank(f, local_idx) + 1))
    writer_core::emit_byte(w, opcodes::OP_I32_SUB())
    writer_core::emit_local_get(w, local_idx)
    emit_call(w, writer_core::writer_linear_gc_root_update_function_index(w))
}

fn emit_frame_leave(w: WasmWriter, ctx: SelfEmitCtx) {
    if !should_emit(w, ctx) {
        return
    }
    writer_core::emit_local_get(w, ctx_scratch::SelfEmitCtx_linear_root_frame_local(ctx))
    emit_call(w, writer_core::writer_linear_gc_root_frame_leave_function_index(w))
}
