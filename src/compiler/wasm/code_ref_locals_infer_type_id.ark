// CALL-result GC types from TypeId / TypeTable / mono instances.
// Tuple and bare-enum returns are not size-classes and not leftover String.

use corehir::kinds
use corehir::mir_value_type
use corehir::type_id
use corehir::type_table
use mir::function_identity
use mir::function_locals_view
use mir::function_return_view
use mir::local_access
use mir::lower::mono_instance_table
use mir::value_types
use wasm::ctx_gc_layout_lookup
use wasm::ctx_gc_type
use wasm::ctx_record
use wasm::inst_ctx

fn infer_gc_type_from_type_id(ctx: SelfEmitCtx, tid: TypeId) -> Option<i32> {
    if !type_id::type_id_is_valid(tid) {
        return Option::None
    }
    let table = ctx_record::SelfEmitCtx_type_table(ctx)
    let entry = type_table::TypeTable_lookup(table, tid)
    let kind = type_table::type_entry_kind(entry)
    if type_kind_is_enum_open(kind) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    let by_layout = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_type_id(ctx, tid)
    if by_layout >= 0 {
        return Option::Some(by_layout)
    }
    Option::None
}

fn infer_gc_type_from_type_table_name(ctx: SelfEmitCtx, ret_name: String) -> Option<i32> {
    if len(ret_name) == 0 {
        return Option::None
    }
    let table = ctx_record::SelfEmitCtx_type_table(ctx)
    let count = type_table::TypeTable_entry_count(table)
    let mut index = 0
    while index < count {
        let entry = type_table::TypeTable_entry_at(table, index)
        if type_table_name_matches_return(type_table::type_entry_name(entry), clone(ret_name)) {
            let from_id = infer_gc_type_from_type_id(ctx, type_table::type_entry_id(entry))
            match from_id {
                Option::Some(_type_idx) => {
                    return from_id
                }
                Option::None => {}
            }
            if type_kind_is_enum_open(type_table::type_entry_kind(entry)) {
                return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
            }
        }
        index = index + 1
    }
    if starts_with(clone(ret_name), "enum:") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    Option::None
}

fn infer_call_result_gc_type_from_mono(ctx: SelfEmitCtx, callee: String) -> Option<i32> {
    let table = ctx_record::SelfEmitCtx_mono_instance_table(ctx)
    let mut found = mono_instance_table::mono_instance_table_find_by_mangled(table, clone(callee))
    if found < 0 {
        let short_name = inst_ctx::strip_module_prefix(clone(callee))
        if !eq(clone(short_name), clone(callee)) {
            found = mono_instance_table::mono_instance_table_find_by_mangled(table, short_name)
        }
    }
    if found < 0 {
        return Option::None
    }
    let entry = mono_instance_table::mono_instance_table_entry_at(table, found)
    if mono_instance_table::mono_instance_entry_return_count(entry) <= 0 {
        return Option::None
    }
    infer_gc_type_from_type_id(
        ctx,
        mir_value_type::mir_value_type_type_id(
            mono_instance_table::mono_instance_entry_return_at(entry, 0)
        )
    )
}

// When MIR return_type_name is empty, TypeSectionPlan still registered the
// tuple/enum from lowering. Recover that name from callee locals or mono suffix.
fn infer_gc_type_from_callee_function(ctx: SelfEmitCtx, called: MirFunction) -> Option<i32> {
    let ret_name = function_return_view::MirFunction_return_type_name(called)
    if !is_leftover_string_return_name(clone(ret_name)) {
        let from_name = infer_named_or_table_gc_type(ctx, clone(ret_name))
        match from_name {
            Option::Some(_type_idx) => {
                return from_name
            }
            Option::None => {}
        }
    }
    let from_locals = infer_gc_type_from_callee_locals(ctx, called)
    match from_locals {
        Option::Some(_type_idx) => {
            return from_locals
        }
        Option::None => {}
    }
    infer_gc_type_from_callee_name(ctx, function_identity::MirFunction_name(called))
}

fn is_leftover_string_return_name(type_name: String) -> bool {
    eq(clone(type_name), "String") || eq(clone(type_name), "string")
}

fn infer_named_or_table_gc_type(ctx: SelfEmitCtx, type_name: String) -> Option<i32> {
    if len(type_name) == 0 {
        return Option::None
    }
    let from_table = infer_gc_type_from_type_table_name(ctx, clone(type_name))
    match from_table {
        Option::Some(_type_idx) => {
            return from_table
        }
        Option::None => {}
    }
    infer_named_struct_or_tuple(ctx, type_name)
}

fn infer_gc_type_from_callee_locals(ctx: SelfEmitCtx, called: MirFunction) -> Option<i32> {
    let local_count = function_locals_view::MirFunction_local_count(called)
    let mut tuple_type = 0 - 1
    let mut tuple_hits = 0
    let mut saw_enum = false
    let mut local_index = 0
    while local_index < local_count {
        let type_name = local_access::MirLocal_type_name(
            function_locals_view::MirFunction_local_at(called, local_index)
        )
        if starts_with(clone(type_name), "enum:") ||
        starts_with(clone(type_name), "option:") ||
        starts_with(clone(type_name), "Option") ||
        starts_with(clone(type_name), "result:") ||
        starts_with(clone(type_name), "Result") {
            saw_enum = true
        }
        if starts_with(clone(type_name), "struct:tuple:") || starts_with(clone(type_name), "tuple:") {
            let named = infer_named_struct_or_tuple(ctx, clone(type_name))
            match named {
                Option::Some(type_idx) => {
                    if tuple_hits == 0 || tuple_type == type_idx {
                        tuple_type = type_idx
                        tuple_hits = tuple_hits + 1
                    } else {
                        return Option::None
                    }
                }
                Option::None => {}
            }
        }
        local_index = local_index + 1
    }
    if tuple_hits > 0 {
        return Option::Some(tuple_type)
    }
    if saw_enum {
        let ret_type = function_return_view::MirFunction_return_type(called)
        if ret_type == value_types::VT_GC_REF() || ret_type == value_types::VT_REF() {
            return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
        }
    }
    Option::None
}

fn infer_gc_type_from_callee_name(ctx: SelfEmitCtx, callee: String) -> Option<i32> {
    let tuple_name = tuple_gc_name_from_mono_callee(clone(callee))
    if len(tuple_name) > 0 {
        let named = infer_named_struct_or_tuple(ctx, tuple_name)
        match named {
            Option::Some(_type_idx) => {
                return named
            }
            Option::None => {}
        }
    }
    if ends_with(clone(callee), "::from") || ends_with(clone(callee), "__from") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    Option::None
}

fn infer_named_struct_or_tuple(ctx: SelfEmitCtx, type_name: String) -> Option<i32> {
    if len(type_name) == 0 {
        return Option::None
    }
    if ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(type_name)) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, type_name))
    }
    let tuple_name = tuple_plan_name_from_ret_name(type_name)
    if len(tuple_name) > 0 && ctx_gc_type::SelfEmitCtx_has_struct_type(ctx, clone(tuple_name)) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, tuple_name))
    }
    Option::None
}

fn tuple_gc_name_from_mono_callee(callee: String) -> String {
    let suffix = mono_type_key_suffix(callee)
    if len(suffix) == 0 {
        return String_new()
    }
    let mut name = String_from("tuple:")
    let n = len(suffix)
    let mut i = 0
    let mut key_count = 0
    let mut key_start = 0
    while i <= n {
        let at_sep = i == n || (i + 1 < n && char_at(suffix, i) == 95 && char_at(suffix, i + 1) == 95)
        if at_sep {
            if i > key_start {
                if key_count > 0 {
                    name = concat(name, ",")
                }
                name = concat(name, substring(suffix, key_start, i))
                key_count = key_count + 1
            }
            if i < n {
                i = i + 1
                key_start = i + 1
            }
        }
        i = i + 1
    }
    if key_count < 2 {
        return String_new()
    }
    name
}

fn mono_type_key_suffix(callee: String) -> String {
    let n = len(callee)
    let mut last_sep = 0 - 1
    let mut prev_sep = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if char_at(callee, i) == 95 && char_at(callee, i + 1) == 95 {
            prev_sep = last_sep
            last_sep = i
        }
        i = i + 1
    }
    if last_sep < 0 || prev_sep < 0 {
        return String_new()
    }
    substring(callee, prev_sep + 2, n)
}

fn type_kind_is_enum_open(kind: i32) -> bool {
    kind == kinds::TYPE_KIND_ENUM() ||
    kind == kinds::TYPE_KIND_OPTION() ||
    kind == kinds::TYPE_KIND_RESULT()
}

fn type_table_name_matches_return(entry_name: String, ret_name: String) -> bool {
    if eq(clone(entry_name), clone(ret_name)) {
        return true
    }
    let tuple_name = tuple_plan_name_from_ret_name(clone(ret_name))
    if len(tuple_name) > 0 && eq(clone(entry_name), clone(tuple_name)) {
        return true
    }
    if starts_with(clone(ret_name), "enum:") {
        let bare = substring(clone(ret_name), 5, len(ret_name))
        if eq(clone(entry_name), clone(bare)) || eq(clone(entry_name), clone(ret_name)) {
            return true
        }
    }
    if starts_with(clone(entry_name), "enum:") {
        let entry_bare = substring(clone(entry_name), 5, len(entry_name))
        if eq(clone(entry_bare), clone(ret_name)) {
            return true
        }
    }
    false
}

// `struct:tuple:i32,String:8` → `tuple:i32,String`. Size-class names stay empty.
fn tuple_plan_name_from_ret_name(ret_name: String) -> String {
    if !starts_with(clone(ret_name), "struct:") {
        if starts_with(clone(ret_name), "tuple:") {
            return ret_name
        }
        return String_new()
    }
    let n = len(ret_name)
    let mut first_colon = 0 - 1
    let mut last_colon = 0 - 1
    let mut i = 0
    while i < n {
        if char_at(ret_name, i) == 58 {
            if first_colon < 0 {
                first_colon = i
            }
            last_colon = i
        }
        i = i + 1
    }
    if first_colon < 0 || last_colon <= first_colon {
        return String_new()
    }
    let inner = substring(ret_name, first_colon + 1, last_colon)
    if starts_with(clone(inner), "tuple:") {
        return inner
    }
    String_new()
}
