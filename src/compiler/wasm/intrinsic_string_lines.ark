use wasm::ctx_gc_type
use wasm::ctx_record
use wasm::ctx_scratch
use wasm::emit_target
use wasm::intrinsic_string_replace_all_gc
use wasm::intrinsic_string_split_gc
use wasm::string_gc_helpers
use wasm::intrinsics::helpers_core

// GC implementation of String::lines. Normalize CRLF first, then reuse the
// exact delimiter splitting implementation so empty lines and trailing lines
// retain the same behavior as String::split.
fn emit_lines(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx) -> bool {
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return false
    }
    emit_static_string(w, ctx, "\r\n")
    emit_static_string(w, ctx, "\n")
    intrinsic_string_replace_all_gc::emit_replace_gc(w, inst, ctx)
    emit_static_string(w, ctx, "\n")
    intrinsic_string_split_gc::emit_split_gc(w, ctx)
    true
}

fn emit_static_string(w: WasmWriter, ctx: SelfEmitCtx, value: String) {
    let string_type = ctx_gc_type::SelfEmitCtx_string_type(ctx)
    let local = ctx_scratch::SelfEmitCtx_scratch_gc_local(ctx, 0)
    let length = len(clone(value))
    string_gc_helpers::emit_gc_i32_const(w, length)
    string_gc_helpers::emit_gc_array_new(w, string_type)
    helpers_core::emit_local_set(w, local)
    let mut index = 0
    while index < length {
        helpers_core::emit_local_get(w, local)
        string_gc_helpers::emit_gc_i32_const(w, index)
        string_gc_helpers::emit_gc_i32_const(w, string_byte_at(clone(value), index))
        string_gc_helpers::emit_gc_array_set(w, string_type)
        index = index + 1
    }
    helpers_core::emit_local_get(w, local)
}

fn string_byte_at(value: String, index: i32) -> i32 {
    let ch = char_at(clone(value), index)
    if ch == '\r' {
        return 13
    }
    if ch == '\n' {
        return 10
    }
    0
}
