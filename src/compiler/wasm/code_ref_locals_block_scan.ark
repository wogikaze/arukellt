// Result/Option payload-extract storage typing for local decls (#835 / #843).
// Replaces body-scan infer_local_storage_gc_type: field ABI and Result/Option
// base type_names decide storage, not producer rescans.

use corehir::kinds
use corehir::mir_value_type
use corehir::type_id
use corehir::type_table
use mir::block_inst_access
use mir::function_locals_view
use mir::inst_accessors_literals
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use mir::local_access
use mir::opcodes
use mir::value_types
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::ctx_gc_layout_lookup
use wasm::ctx_record
use wasm::code_ref_locals_infer_dest
use wasm::code_ref_locals_infer_callee
use wasm::gc_layout_table
use wasm::intrinsic_vec_type
use wasm::sections_types_gc

fn gc_struct_get_field_ref_type(inst: MirInst, ctx: SelfEmitCtx) -> Option<i32> {
    let type_slot = inst_accessors_operands::MirInst_arg0(inst)
    let field_idx = inst_accessors_literals::MirInst_int_val(inst)
    let sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    if type_slot < 0 || type_slot >= len(sigs) {
        return Option::None
    }
    let fields = sections_types_gc::wasm_sections_types_gc__struct_field_sigs(get_unchecked(sigs, type_slot))
    if field_idx < 0 || field_idx >= len(fields) {
        return Option::None
    }
    let field_sig = get_unchecked(fields, field_idx)
    if !starts_with(clone(field_sig), "ref") {
        return Option::None
    }
    let offset_str = substring(clone(field_sig), 3, len(field_sig))
    let offset = sections_types_gc::parse_type_sig_int(offset_str)
    let type_idx = gc_layout_table::gc_layout_table_fixed_type_index(
        ctx_record::SelfEmitCtx_gc_layout_table(ctx),
        offset
    )
    if type_idx < 0 {
        return Option::None
    }
    Option::Some(type_idx)
}

fn struct_get_result_payload_open_type(f: MirFunction, inst: MirInst, ctx: SelfEmitCtx) -> Option<i32> {
    let vt = inst_accessors_shape::MirInst_val_type(inst)
    if vt != value_types::VT_GC_REF() && vt != value_types::VT_REF() {
        return Option::None
    }
    let base = inst_accessors_operands::MirInst_arg0(inst)
    if base < 0 {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if base >= function_locals_view::MirFunction_local_count(f) {
        return Option::None
    }
    let base_tn = local_access::MirLocal_type_name(function_locals_view::MirFunction_local_at(f, base))
    if starts_with(clone(base_tn), "Result") ||
    starts_with(clone(base_tn), "result:") ||
    starts_with(clone(base_tn), "Option") ||
    starts_with(clone(base_tn), "option:") ||
    starts_with(clone(base_tn), "enum:") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    let base_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, base)
    let open = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    if base_gc == open || ctx_gc_layout_lookup::SelfEmitCtx_wasm_type_is_enum_variant(ctx, base_gc) {
        return Option::Some(open)
    }
    Option::None
}

// Storage type for Result/Option payload extracts written by STRUCT_GET /
// GC_STRUCT_GET. Uses field ABI / base type_name — not body-scan infer (#843).
// i32 tag fields return None so scalar decl path wins.
fn local_payload_extract_storage_type(f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> Option<i32> {
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_operands::MirInst_dest(inst) != local_idx {
                ii = ii + 1
                continue
            }
            let op = inst_accessors_shape::MirInst_op(inst)
            if op == opcodes::MIR_GC_STRUCT_GET() {
                let field_ty = gc_struct_get_field_ref_type(inst, ctx)
                match field_ty {
                    Option::Some(_ty) => {
                        return field_ty
                    }
                    Option::None => {}
                }
            }
            if op == opcodes::MIR_STRUCT_GET() {
                let open_ty = struct_get_result_payload_open_type(f, inst, ctx)
                match open_ty {
                    Option::Some(_ty) => {
                        return open_ty
                    }
                    Option::None => {}
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    Option::None
}

fn local_vec_access_storage_type(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    let block_count = len(f.blocks)
    let mut block_index = 0
    while block_index < block_count {
        let block = get_unchecked(f.blocks, block_index)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut inst_index = 0
        while inst_index < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, inst_index)
            let call_index = vec_access_call_index_for_local(block, inst_index, inst, local_idx)
            if call_index >= 0 {
                let call_inst = block_inst_access::MirBlock_inst_at(block, call_index)
                let from_call = vec_access_storage_from_call(
                    f,
                    block,
                    call_index,
                    call_inst,
                    local_idx,
                    ctx
                )
                match from_call {
                    Option::Some(_storage_type) => {
                        return from_call
                    }
                    Option::None => {}
                }
            }
            inst_index = inst_index + 1
        }
        block_index = block_index + 1
    }
    Option::None
}

fn vec_access_call_index_for_local(
    block: MirBlock,
    inst_index: i32,
    inst: MirInst,
    local_idx: i32
) -> i32 {
    if inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_CALL() &&
    inst_accessors_operands::MirInst_dest(inst) == local_idx &&
    is_vec_access_callee(inst_accessors_literals::MirInst_str_val(inst)) {
        return inst_index
    }
    if inst_index > 0 &&
    inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_LOCAL_SET() &&
    inst_accessors_operands::MirInst_arg0(inst) == local_idx {
        let prev = block_inst_access::MirBlock_inst_at(block, inst_index - 1)
        if inst_accessors_shape::MirInst_op(prev) == opcodes::MIR_CALL() &&
        inst_accessors_operands::MirInst_dest(prev) < 0 &&
        is_vec_access_callee(inst_accessors_literals::MirInst_str_val(prev)) {
            return inst_index - 1
        }
    }
    0 - 1
}

fn vec_access_storage_from_call(
    f: MirFunction,
    block: MirBlock,
    call_index: i32,
    call_inst: MirInst,
    dest_local: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    let inferred =
    code_ref_locals_infer_dest::infer_ref_local_from_producer(
        f,
        call_inst,
        opcodes::MIR_CALL(),
        ctx
    )
    match inferred {
        Option::Some(_storage_type) => {
            return inferred
        }
        Option::None => {}
    }
    let from_dest = vec_element_storage_from_local_binding(f, dest_local, ctx)
    match from_dest {
        Option::Some(_storage_type) => {
            return from_dest
        }
        Option::None => {}
    }
    let from_consumer = vec_element_storage_from_forward_copy(f, dest_local, ctx)
    match from_consumer {
        Option::Some(_storage_type) => {
            return from_consumer
        }
        Option::None => {}
    }
    let receiver = vec_access_receiver_local(block, call_index, call_inst)
    let from_type_id = vec_element_storage_type_from_receiver_chain(f, receiver, ctx, 0)
    match from_type_id {
        Option::Some(_storage_type) => {
            return from_type_id
        }
        Option::None => {}
    }
    vec_element_storage_from_resolved_array(
        ctx,
        intrinsic_vec_type::resolve_array_type_for_call(
            ctx,
            inst_accessors_literals::MirInst_str_val(call_inst),
            call_inst
        )
    )
}

fn vec_element_storage_from_local_binding(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    if local_idx < 0 || local_idx >= function_locals_view::MirFunction_local_count(f) {
        return Option::None
    }
    let loc = function_locals_view::MirFunction_local_at(f, local_idx)
    let type_name = local_access::MirLocal_type_name(loc)
    if starts_with(clone(type_name), "vec:") ||
    starts_with(clone(type_name), "Vec_") ||
    starts_with(clone(type_name), "Vec<") {
        let vec_type = ctx_gc_type::SelfEmitCtx_vec_type_for_local(ctx, local_idx)
        if vec_type >= 0 {
            return Option::Some(vec_type)
        }
    }
    let named = code_ref_locals_infer_callee::resolve_named_struct_gc_type(ctx, clone(type_name))
    match named {
        Option::Some(named_type) => {
            if named_type != ctx_gc_type::SelfEmitCtx_string_type(ctx) {
                return named
            }
        }
        Option::None => {}
    }
    let from_type_id = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
    if from_type_id >= 0 {
        return Option::Some(from_type_id)
    }
    Option::None
}

// Unmarked get dests (`$_t21`) are copied into the named result (`$p: Point`).
// CALL.dest is often -1, so producer inference never sees that binding.
fn vec_element_storage_from_forward_copy(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    let block_count = len(f.blocks)
    let mut block_index = 0
    while block_index < block_count {
        let block = get_unchecked(f.blocks, block_index)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut inst_index = 0
        while inst_index < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, inst_index)
            if inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_LOCAL_SET() {
                let target = inst_accessors_operands::MirInst_arg0(inst)
                if target != local_idx {
                    let source = local_set_source_local(block, inst_index, inst)
                    if source == local_idx {
                        let binding = vec_element_storage_from_local_binding(f, target, ctx)
                        match binding {
                            Option::Some(_storage_type) => {
                                return binding
                            }
                            Option::None => {}
                        }
                    }
                }
            }
            inst_index = inst_index + 1
        }
        block_index = block_index + 1
    }
    Option::None
}

fn vec_element_storage_from_resolved_array(ctx: SelfEmitCtx, array_type: i32) -> Option<i32> {
    if array_type < 0 {
        return Option::None
    }
    if array_type == ctx_gc_type::SelfEmitCtx_string_array_type(ctx) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_string_type(ctx))
    }
    if array_type == ctx_gc_type_vec_ref::SelfEmitCtx_enum_ref_array_type(ctx) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    Option::None
}

// Vec element storage comes from the receiver TypeId's type parameter, not
// from parsing a `vec:` type name in the backend.
fn vec_element_storage_type_from_receiver(
    f: MirFunction,
    receiver: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    if receiver < 0 || receiver >= function_locals_view::MirFunction_local_count(f) {
        return Option::None
    }
    let receiver_local = function_locals_view::MirFunction_local_at(f, receiver)
    let vec_tid = mir_value_type::mir_value_type_type_id(
        local_access::MirLocal_value_type(receiver_local)
    )
    if !type_id::type_id_is_valid(vec_tid) {
        return Option::None
    }
    let table = ctx_record::SelfEmitCtx_type_table(ctx)
    let entry = type_table::TypeTable_lookup(table, vec_tid)
    if type_table::type_entry_kind(entry) != kinds::TYPE_KIND_VEC() {
        return Option::None
    }
    if type_table::type_entry_type_param_count(entry) != 1 {
        return Option::None
    }
    let storage_type = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_type_id(
        ctx,
        type_table::type_entry_type_param_at(entry, 0)
    )
    if storage_type < 0 {
        return Option::None
    }
    Option::Some(storage_type)
}

fn vec_element_storage_type_from_receiver_chain(
    f: MirFunction,
    receiver: i32,
    ctx: SelfEmitCtx,
    depth: i32
) -> Option<i32> {
    let direct = vec_element_storage_type_from_receiver(f, receiver, ctx)
    match direct {
        Option::Some(_storage_type) => {
            return direct
        }
        Option::None => {}
    }
    if depth > 3 || receiver < 0 {
        return Option::None
    }
    let source = local_copy_source_for(f, receiver)
    if source < 0 || source == receiver {
        return Option::None
    }
    vec_element_storage_type_from_receiver_chain(f, source, ctx, depth + 1)
}

fn local_copy_source_for(f: MirFunction, local_idx: i32) -> i32 {
    let block_count = len(f.blocks)
    let mut block_index = 0
    while block_index < block_count {
        let block = get_unchecked(f.blocks, block_index)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut inst_index = 0
        while inst_index < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, inst_index)
            if inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_LOCAL_SET() &&
            inst_accessors_operands::MirInst_arg0(inst) == local_idx {
                let source = local_set_source_local(block, inst_index, inst)
                if source >= 0 && source != local_idx {
                    return source
                }
            }
            inst_index = inst_index + 1
        }
        block_index = block_index + 1
    }
    0 - 1
}

fn vec_access_receiver_local(
    block: MirBlock,
    inst_index: i32,
    inst: MirInst
) -> i32 {
    let recorded_receiver = inst_accessors_operands::MirInst_arg0(inst)
    if recorded_receiver >= 0 {
        return recorded_receiver
    }
    let argument_count = inst_accessors_literals::MirInst_int_val(inst)
    let receiver_index = inst_index - argument_count
    if receiver_index < 0 {
        return 0 - 1
    }
    let receiver_get =
    block_inst_access::MirBlock_inst_at(block, receiver_index)
    if inst_accessors_shape::MirInst_op(receiver_get) != opcodes::MIR_LOCAL_GET() {
        return 0 - 1
    }
    inst_accessors_operands::MirInst_arg0(receiver_get)
}

fn is_vec_access_callee(callee: String) -> bool {
    eq(clone(callee), "raw_array_get_unchecked") ||
    eq(clone(callee), "vec_get_unchecked") ||
    eq(clone(callee), "get_unchecked") ||
    starts_with(clone(callee), "get_unchecked__") ||
    starts_with(clone(callee), "vec_get_unchecked__")
}

fn vec_elem_name_from_type_name(type_name: String) -> String {
    if starts_with(clone(type_name), "vec:") {
        return substring(clone(type_name), 4, len(type_name))
    }
    if starts_with(clone(type_name), "Vec_") {
        return substring(clone(type_name), 4, len(type_name))
    }
    if starts_with(clone(type_name), "Vec<") {
        let n = len(type_name)
        if n > 4 && char_at(type_name, n - 1) == 62 {
            return substring(clone(type_name), 4, n - 1)
        }
    }
    String_new()
}

fn vec_receiver_elem_name(f: MirFunction, receiver: i32, ctx: SelfEmitCtx) -> String {
    if receiver < 0 || receiver >= function_locals_view::MirFunction_local_count(f) {
        return String_new()
    }
    let receiver_local = function_locals_view::MirFunction_local_at(f, receiver)
    let from_name = vec_elem_name_from_type_name(local_access::MirLocal_type_name(receiver_local))
    if len(from_name) > 0 {
        return from_name
    }
    let vec_tid = mir_value_type::mir_value_type_type_id(
        local_access::MirLocal_value_type(receiver_local)
    )
    if !type_id::type_id_is_valid(vec_tid) {
        return String_new()
    }
    let entry = type_table::TypeTable_lookup(ctx_record::SelfEmitCtx_type_table(ctx), vec_tid)
    if type_table::type_entry_kind(entry) != kinds::TYPE_KIND_VEC() {
        return String_new()
    }
    let from_entry = vec_elem_name_from_type_name(type_table::type_entry_name(entry))
    if len(from_entry) > 0 {
        return from_entry
    }
    if type_table::type_entry_type_param_count(entry) != 1 {
        return String_new()
    }
    type_table::type_entry_name(
        type_table::TypeTable_lookup(
            ctx_record::SelfEmitCtx_type_table(ctx),
            type_table::type_entry_type_param_at(entry, 0)
        )
    )
}

fn local_enum_open_storage_type(f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> Option<i32> {
    if local_idx < 0 || local_idx >= function_locals_view::MirFunction_local_count(f) {
        return Option::None
    }
    let loc = function_locals_view::MirFunction_local_at(f, local_idx)
    let type_name = local_access::MirLocal_type_name(loc)
    if starts_with(clone(type_name), "enum:") ||
    starts_with(clone(type_name), "option:") ||
    starts_with(clone(type_name), "Option") ||
    starts_with(clone(type_name), "result:") ||
    starts_with(clone(type_name), "Result") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    let tid = mir_value_type::mir_value_type_type_id(local_access::MirLocal_value_type(loc))
    if !type_id::type_id_is_valid(tid) {
        return Option::None
    }
    let kind = type_table::type_entry_kind(
        type_table::TypeTable_lookup(ctx_record::SelfEmitCtx_type_table(ctx), tid)
    )
    if kind == kinds::TYPE_KIND_ENUM() ||
    kind == kinds::TYPE_KIND_OPTION() ||
    kind == kinds::TYPE_KIND_RESULT() {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    Option::None
}

fn local_set_non_string_storage_type(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    if local_idx < 0 || local_idx >= function_locals_view::MirFunction_local_count(f) {
        return Option::None
    }
    let loc = function_locals_view::MirFunction_local_at(f, local_idx)
    let type_name = local_access::MirLocal_type_name(loc)
    let string_type = ctx_gc_type::SelfEmitCtx_string_type(ctx)
    let storage_type =
    ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
    let plan_storage = call_dest_plan_storage_type(f, local_idx, ctx)
    match plan_storage {
        Option::Some(plan_type) => {
            // TypeSectionPlan already chose the CALL result type. Unresolved
            // tuple placeholders (struct:tuple:v:A,B) and leftover String
            // dests must take that index, not a later leftover-String guess.
            if plan_type >= 0 &&
            !(plan_type == string_type &&
                is_vec_storage_binding(ctx, storage_type, clone(type_name))) {
                return plan_storage
            }
        }
        Option::None => {}
    }
    let direct_storage = local_direct_producer_storage_type(f, local_idx, ctx)
    match direct_storage {
        Option::Some(direct_type) => {
            // String CALL results win leftover dest names (echo<String>).
            // Do not replace a Vec TypeId — Vec::new<String> return names
            // can look like String and would collapse the dest to array 11.
            if direct_type == string_type &&
            !is_vec_storage_binding(ctx, storage_type, clone(type_name)) {
                return direct_storage
            }
            if leftover_string_yields_to_infer(ctx, storage_type, clone(type_name), direct_type) {
                return direct_storage
            }
            if leftover_i32_vec_yields_to_infer(ctx, storage_type, clone(type_name), direct_type) ||
            (direct_type != string_type && len(type_name) == 0) {
                let copied = copied_non_string_storage_type(f, local_idx, ctx, 0)
                match copied {
                    Option::Some(_copied_type) => {
                        return copied
                    }
                    Option::None => {}
                }
                return direct_storage
            }
        }
        Option::None => {}
    }
    if len(type_name) > 0 &&
    storage_type >= 0 &&
    storage_type != string_type {
        return Option::None
    }
    copied_non_string_storage_type(f, local_idx, ctx, 0)
}

fn leftover_string_yields_to_infer(
    ctx: SelfEmitCtx,
    leftover_type: i32,
    type_name: String,
    infer_type: i32
) -> bool {
    let string_type = ctx_gc_type::SelfEmitCtx_string_type(ctx)
    if infer_type < 0 || infer_type == leftover_type || infer_type == string_type {
        return false
    }
    // Leftover String dests may take a tuple/struct CALL result, but never
    // an enclosing enum variant (TomlValue::String payload stays array 11).
    if ctx_gc_layout_lookup::SelfEmitCtx_wasm_type_is_enum_variant(ctx, infer_type) {
        return false
    }
    leftover_type == string_type ||
    eq(clone(type_name), "String") ||
    eq(clone(type_name), "string")
}

fn leftover_i32_vec_yields_to_infer(
    ctx: SelfEmitCtx,
    leftover_type: i32,
    type_name: String,
    infer_type: i32
) -> bool {
    if infer_type < 0 || infer_type == leftover_type || !is_vec_storage_type_idx(ctx, infer_type) {
        return false
    }
    leftover_type == ctx_gc_type::SelfEmitCtx_vec_type(ctx) ||
    eq(clone(type_name), "vec:i32") ||
    eq(clone(type_name), "Vec<i32>") ||
    eq(clone(type_name), "Vec_i32") ||
    eq(clone(type_name), "Vec")
}

fn is_vec_storage_type_idx(ctx: SelfEmitCtx, type_idx: i32) -> bool {
    type_idx == ctx_gc_type::SelfEmitCtx_vec_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_vec_string_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx) ||
    type_idx == ctx_gc_type::SelfEmitCtx_vec_v128_type(ctx) ||
    type_idx == ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx) ||
    type_idx == ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx) ||
    type_idx == ctx_gc_type_vec_ref::SelfEmitCtx_vec_enum_ref_type(ctx)
}

fn is_vec_storage_binding(ctx: SelfEmitCtx, storage_type: i32, type_name: String) -> bool {
    if starts_with(clone(type_name), "vec:") ||
    starts_with(clone(type_name), "Vec_") ||
    starts_with(clone(type_name), "Vec<") ||
    eq(clone(type_name), "Vec") {
        return true
    }
    if storage_type < 0 {
        return false
    }
    storage_type == ctx_gc_type::SelfEmitCtx_vec_type(ctx) ||
    storage_type == ctx_gc_type::SelfEmitCtx_vec_string_type(ctx) ||
    storage_type == ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx) ||
    storage_type == ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx) ||
    storage_type == ctx_gc_type::SelfEmitCtx_vec_v128_type(ctx) ||
    storage_type == ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx) ||
    storage_type == ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx) ||
    storage_type == ctx_gc_type_vec_ref::SelfEmitCtx_vec_enum_ref_type(ctx)
}

fn copied_non_string_storage_type(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx,
    depth: i32
) -> Option<i32> {
    if depth > 3 {
        return Option::None
    }
    let block_count = len(f.blocks)
    let mut block_index = 0
    while block_index < block_count {
        let block = get_unchecked(f.blocks, block_index)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut inst_index = 0
        while inst_index < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, inst_index)
            if inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_LOCAL_SET() &&
            inst_accessors_operands::MirInst_arg0(inst) == local_idx {
                let source = local_set_source_local(block, inst_index, inst)
                if source >= 0 && source != local_idx {
                    let source_loc = function_locals_view::MirFunction_local_at(f, source)
                    let source_name = local_access::MirLocal_type_name(source_loc)
                    if !eq(clone(source_name), "String") &&
                    !eq(clone(source_name), "string") {
                        let source_named =
                        code_ref_locals_infer_callee::resolve_named_struct_gc_type(
                            ctx,
                            clone(source_name)
                        )
                        match source_named {
                            Option::Some(source_named_type) => {
                                if source_named_type != ctx_gc_type::SelfEmitCtx_string_type(ctx) &&
                                !ctx_gc_layout_lookup::SelfEmitCtx_wasm_type_is_enum_variant(
                                    ctx,
                                    source_named_type
                                ) {
                                    return Option::Some(source_named_type)
                                }
                            }
                            Option::None => {}
                        }
                    }
                    let source_enum = local_enum_open_storage_type(f, source, ctx)
                    match source_enum {
                        Option::Some(_enum_type) => {
                            return source_enum
                        }
                        Option::None => {}
                    }
                    let source_type =
                    ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, source)
                    if source_type >= 0 &&
                    source_type != ctx_gc_type::SelfEmitCtx_string_type(ctx) {
                        return Option::Some(source_type)
                    }
                    let source_vec_access_type =
                    local_vec_access_storage_type(f, source, ctx)
                    match source_vec_access_type {
                        Option::Some(_type) => {
                            return source_vec_access_type
                        }
                        Option::None => {}
                    }
                    let source_producer_type =
                    local_direct_producer_storage_type(f, source, ctx)
                    match source_producer_type {
                        Option::Some(_type) => {
                            return source_producer_type
                        }
                        Option::None => {}
                    }
                    let copied_source_type =
                    copied_non_string_storage_type(f, source, ctx, depth + 1)
                    match copied_source_type {
                        Option::Some(_type) => {
                            return copied_source_type
                        }
                        Option::None => {}
                    }
                }
            }
            inst_index = inst_index + 1
        }
        block_index = block_index + 1
    }
    Option::None
}

fn local_direct_producer_storage_type(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    let block_count = len(f.blocks)
    let mut block_index = 0
    while block_index < block_count {
        let block = get_unchecked(f.blocks, block_index)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut inst_index = 0
        while inst_index < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, inst_index)
            let producer = stack_call_or_direct_producer(block, inst_index, inst, local_idx)
            if producer >= 0 {
                let producer_inst = block_inst_access::MirBlock_inst_at(block, producer)
                let inferred =
                code_ref_locals_infer_dest::infer_ref_local_from_producer(
                    f,
                    producer_inst,
                    inst_accessors_shape::MirInst_op(producer_inst),
                    ctx
                )
                match inferred {
                    Option::Some(_storage_type) => {
                        return inferred
                    }
                    Option::None => {}
                }
            }
            inst_index = inst_index + 1
        }
        block_index = block_index + 1
    }
    Option::None
}

// CALL dest is often -1; the next LOCAL_SET is the real result local.
// Returning Option<MirInst> made the selfhost compiler wasm itself invalid.
fn stack_call_or_direct_producer(
    block: MirBlock,
    inst_index: i32,
    inst: MirInst,
    local_idx: i32
) -> i32 {
    if inst_index > 0 &&
    inst_accessors_shape::MirInst_op(inst) == opcodes::MIR_LOCAL_SET() &&
    inst_accessors_operands::MirInst_arg0(inst) == local_idx {
        let prev = block_inst_access::MirBlock_inst_at(block, inst_index - 1)
        if inst_accessors_shape::MirInst_op(prev) == opcodes::MIR_CALL() &&
        inst_accessors_operands::MirInst_dest(prev) < 0 {
            return inst_index - 1
        }
    }
    if inst_accessors_operands::MirInst_dest(inst) == local_idx {
        return inst_index
    }
    0 - 1
}

fn call_dest_plan_storage_type(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    let block_count = len(f.blocks)
    let mut block_index = 0
    while block_index < block_count {
        let block = get_unchecked(f.blocks, block_index)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut inst_index = 0
        while inst_index < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, inst_index)
            let producer = stack_call_or_direct_producer(block, inst_index, inst, local_idx)
            if producer >= 0 {
                let producer_inst = block_inst_access::MirBlock_inst_at(block, producer)
                if inst_accessors_shape::MirInst_op(producer_inst) == opcodes::MIR_CALL() {
                    let from_plan = code_ref_locals_infer_callee::infer_call_result_gc_type_from_plan(
                        ctx,
                        inst_accessors_literals::MirInst_str_val(producer_inst)
                    )
                    match from_plan {
                        Option::Some(_type_idx) => {
                            return from_plan
                        }
                        Option::None => {}
                    }
                }
            }
            inst_index = inst_index + 1
        }
        block_index = block_index + 1
    }
    Option::None
}

fn local_set_source_local(block: MirBlock, inst_index: i32, inst: MirInst) -> i32 {
    let direct_source = inst_accessors_operands::MirInst_arg1(inst)
    if direct_source >= 0 {
        return direct_source
    }
    if inst_index <= 0 {
        return 0 - 1
    }
    let producer = block_inst_access::MirBlock_inst_at(block, inst_index - 1)
    if inst_accessors_shape::MirInst_op(producer) == opcodes::MIR_LOCAL_GET() {
        return inst_accessors_operands::MirInst_arg0(producer)
    }
    inst_accessors_operands::MirInst_dest(producer)
}
