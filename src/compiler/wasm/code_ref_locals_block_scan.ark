// Result/Option payload-extract storage typing for local decls (#835 / #843).
// Replaces body-scan infer_local_storage_gc_type: field ABI and Result/Option
// base type_names decide storage, not producer rescans.

use corehir::kinds
use corehir::mir_value_type
use corehir::type_id
use corehir::type_table
use mir::block_inst_access
use mir::function_locals_view
use mir::inst_accessors_literals
use mir::inst_accessors_operands
use mir::inst_accessors_result_types
use mir::inst_accessors_shape
use mir::local_access
use mir::local_write_index
use mir::opcodes
use mir::value_types
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::ctx_gc_layout_lookup
use wasm::call_indirect
use wasm::ctx_record
use wasm::code_ref_locals_fn_cache
use wasm::code_ref_locals_infer_callee
use wasm::code_ref_locals_infer_dest
use wasm::sections_types_gc
use wasm::intrinsic_vec_type

fn gc_struct_get_field_ref_type(inst: MirInst, ctx: SelfEmitCtx) -> Option<i32> {
    let type_slot = inst_accessors_operands::MirInst_arg0(inst)
    let field_idx = inst_accessors_literals::MirInst_int_val(inst)
    let sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    if type_slot < 0 || type_slot >= len(sigs) {
        return Option::None
    }
    let fields = sections_types_gc::wasm_sections_types_gc__struct_field_sigs(get_unchecked(sigs, type_slot))
    if field_idx < 0 || field_idx >= len(fields) {
        return Option::None
    }
    let field_sig = get_unchecked(fields, field_idx)
    if !starts_with(clone(field_sig), "ref") {
        return Option::None
    }
    let offset_str = substring(clone(field_sig), 3, len(field_sig))
    let offset = sections_types_gc::parse_type_sig_int(offset_str)
    Option::Some(ctx_record::SelfEmitCtx_gc_type_base(ctx) + offset)
}

fn struct_get_result_payload_open_type(f: MirFunction, inst: MirInst, ctx: SelfEmitCtx) -> Option<i32> {
    let vt = inst_accessors_shape::MirInst_val_type(inst)
    if vt != value_types::VT_GC_REF() && vt != value_types::VT_REF() {
        return Option::None
    }
    let base = inst_accessors_operands::MirInst_arg0(inst)
    if base < 0 {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if base >= function_locals_view::MirFunction_local_count(f) {
        return Option::None
    }
    let base_tn = local_access::MirLocal_type_name(function_locals_view::MirFunction_local_at(f, base))
    if starts_with(clone(base_tn), "Result") ||
    starts_with(clone(base_tn), "result:") ||
    starts_with(clone(base_tn), "Option") ||
    starts_with(clone(base_tn), "option:") ||
    starts_with(clone(base_tn), "enum:") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    let base_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, base)
    // A named user struct can share a GC type index with the enum-variant
    // registry in the current layout plan. Its field access still has the
    // declared field ABI; treating every such index as an open-enum payload
    // makes `WitFunc.name` become WitType. Only use this fallback when the
    // base has no semantic type name at all.
    if len(base_tn) > 0 {
        return Option::None
    }
    let open = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    if base_gc == open || ctx_gc_layout_lookup::SelfEmitCtx_wasm_type_is_enum_variant(ctx, base_gc) {
        return Option::Some(open)
    }
    Option::None
}

// Storage type for Result/Option payload extracts written by STRUCT_GET /
// GC_STRUCT_GET. Uses field ABI / base type_name — not body-scan infer (#843).
// i32 tag fields return None so scalar decl path wins.
fn local_payload_extract_storage_type(f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> Option<i32> {
    let writes = code_ref_locals_fn_cache::function_local_write_index(f, ctx)
    let end = local_write_index::local_write_index_end(writes, local_idx)
    let mut wi = local_write_index::local_write_index_begin(writes, local_idx)
    while wi < end {
        let inst = write_site_inst(f, writes, wi)
        wi = wi + 1
        if inst_accessors_operands::MirInst_dest(inst) != local_idx {
            continue
        }
        let op = inst_accessors_shape::MirInst_op(inst)
        if op == opcodes::MIR_GC_STRUCT_GET() {
            let field_ty = gc_struct_get_field_ref_type(inst, ctx)
            match field_ty {
                Option::Some(_ty) => {
                    return field_ty
                }
                Option::None => {}
            }
        }
        if op == opcodes::MIR_STRUCT_GET() {
            let open_ty = struct_get_result_payload_open_type(f, inst, ctx)
            match open_ty {
                Option::Some(_ty) => {
                    return open_ty
                }
                Option::None => {}
            }
        }
    }
    Option::None
}

fn write_site_block(f: MirFunction, writes: LocalWriteIndex, write: i32) -> MirBlock {
    get_unchecked(f.blocks, local_write_index::local_write_index_block_at(writes, write))
}

fn write_site_inst(f: MirFunction, writes: LocalWriteIndex, write: i32) -> MirInst {
    block_inst_access::MirBlock_inst_at(
        write_site_block(f, writes, write),
        local_write_index::local_write_index_inst_at(writes, write)
    )
}

fn local_vec_access_storage_type(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    let writes = code_ref_locals_fn_cache::function_local_write_index(f, ctx)
    let end = local_write_index::local_write_index_end(writes, local_idx)
    let mut wi = local_write_index::local_write_index_begin(writes, local_idx)
    while wi < end {
        let block = write_site_block(f, writes, wi)
        let inst_index = local_write_index::local_write_index_inst_at(writes, wi)
        let inst = block_inst_access::MirBlock_inst_at(block, inst_index)
        wi = wi + 1
        if inst_accessors_shape::MirInst_op(inst) != opcodes::MIR_CALL() ||
        inst_accessors_operands::MirInst_dest(inst) != local_idx ||
        !is_vec_access_callee(inst_accessors_literals::MirInst_str_val(inst)) {
            continue
        }
        let result_storage = vec_access_result_storage_type(inst, ctx)
        match result_storage {
            Option::Some(_storage_type) => {
                return result_storage
            }
            Option::None => {}
        }
        let inferred =
        code_ref_locals_infer_dest::infer_ref_local_from_producer(
            f,
            inst,
            opcodes::MIR_CALL(),
            ctx
        )
        match inferred {
            Option::Some(_storage_type) => {
                return inferred
            }
            Option::None => {}
        }
        let receiver =
        vec_access_receiver_local(block, inst_index, inst)
        let from_receiver =
        vec_element_storage_type_from_receiver(f, local_idx, receiver, ctx)
        match from_receiver {
            Option::Some(_storage_type) => {
                return from_receiver
            }
            Option::None => {}
        }
    }
    Option::None
}

// Vec element storage comes from the receiver TypeId's type parameter, not
// from parsing a `vec:` type name in the backend.
fn vec_element_storage_type_from_receiver(
    f: MirFunction,
    dest: i32,
    receiver: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    if receiver < 0 || receiver >= function_locals_view::MirFunction_local_count(f) {
        return Option::None
    }
    let receiver_local = function_locals_view::MirFunction_local_at(f, receiver)
    let receiver_gc =
    ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, receiver)
    if receiver_gc == ctx_gc_type_vec_ref::SelfEmitCtx_vec_enum_ref_type(ctx) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if receiver_gc == ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx) {
        return Option::Some(call_indirect::resolve_indirect_type_idx(
                ctx,
                0 - 1,
                1,
                value_types::VT_I32(),
                value_types::VT_I32()
            ))
    }
    if receiver_gc == ctx_gc_type_vec_ref::SelfEmitCtx_vec_struct_ref_type(ctx) {
        let nested = nested_vec_element_storage_type(f, dest, ctx)
        match nested {
            Option::Some(_storage_type) => {
                return nested
            }
            Option::None => {}
        }
    }
    let vec_tid = mir_value_type::mir_value_type_type_id(
        local_access::MirLocal_value_type(receiver_local)
    )
    if !type_id::type_id_is_valid(vec_tid) {
        let receiver_tn = local_access::MirLocal_type_name(receiver_local)
        let receiver_elem = vec_element_name(clone(receiver_tn))
        if sections_types_gc_phase7::gc_vec_elem_name_is_enum_like(clone(receiver_elem)) {
            return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
        }
        if sections_types_gc_phase7::gc_vec_elem_name_is_fnref(clone(receiver_elem)) {
            return Option::Some(call_indirect::resolve_indirect_type_idx(
                    ctx,
                    0 - 1,
                    1,
                    value_types::VT_I32(),
                    value_types::VT_I32()
                ))
        }
        if is_nested_vec_element_name(clone(receiver_elem)) {
            let nested = nested_vec_element_storage_type(f, dest, ctx)
            match nested {
                Option::Some(_storage_type) => {
                    return nested
                }
                Option::None => {}
            }
        }
        if starts_with(clone(receiver_tn), String_from("vec:fn")) {
            return Option::Some(call_indirect::resolve_indirect_type_idx(
                    ctx,
                    0 - 1,
                    1,
                    value_types::VT_I32(),
                    value_types::VT_I32()
                ))
        }
        let copied_storage = copied_storage_type_from_source(f, receiver, ctx, 0)
        match copied_storage {
            Option::Some(copied_type) => {
                if copied_type == ctx_gc_type_vec_ref::SelfEmitCtx_vec_fnref_type(ctx) {
                    return Option::Some(call_indirect::resolve_indirect_type_idx(
                            ctx,
                            0 - 1,
                            1,
                            value_types::VT_I32(),
                            value_types::VT_I32()
                        ))
                }
            }
            Option::None => {}
        }
        return Option::None
    }
    let table = ctx_record::SelfEmitCtx_type_table(ctx)
    let entry = type_table::TypeTable_lookup(table, vec_tid)
    if type_table::type_entry_kind(entry) != kinds::TYPE_KIND_VEC() {
        return Option::None
    }
    if type_table::type_entry_type_param_count(entry) != 1 {
        return Option::None
    }
    let storage_type = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_type_id(
        ctx,
        type_table::type_entry_type_param_at(entry, 0)
    )
    if storage_type < 0 {
        return Option::None
    }
    Option::Some(storage_type)
}

fn vec_access_result_storage_type(inst: MirInst, ctx: SelfEmitCtx) -> Option<i32> {
    if inst_accessors_result_types::MirInst_result_type_count(inst) <= 0 {
        return Option::None
    }
    let result_type = inst_accessors_result_types::MirInst_result_type_at(inst, 0)
    let storage_type =
    ctx_gc_layout_lookup::SelfEmitCtx_wasm_storage_ref_type_idx_for_mir_value_type(
        ctx,
        result_type
    )
    if storage_type < 0 {
        return Option::None
    }
    Option::Some(storage_type)
}

fn vec_element_name(type_name: String) -> String {
    if starts_with(clone(type_name), String_from("vec:")) {
        return substring(type_name, 4, len(type_name))
    }
    if starts_with(clone(type_name), String_from("Vec_")) {
        return substring(type_name, 4, len(type_name))
    }
    String_new()
}

fn is_nested_vec_element_name(elem: String) -> bool {
    starts_with(clone(elem), String_from("Vec")) ||
    starts_with(clone(elem), String_from("vec:"))
}

fn nested_vec_element_storage_type(
    f: MirFunction,
    dest: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    if dest < 0 || dest >= function_locals_view::MirFunction_local_count(f) {
        return Option::None
    }
    let dest_name = local_access::MirLocal_type_name(
        function_locals_view::MirFunction_local_at(f, dest)
    )
    let elem_name = vec_element_name(clone(dest_name))
    if len(elem_name) == 0 {
        return Option::None
    }
    if sections_types_gc_phase7::gc_vec_elem_name_is_enum_like(clone(elem_name)) {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if sections_types_gc_phase7::gc_vec_elem_name_is_fnref(clone(elem_name)) {
        return Option::Some(call_indirect::resolve_indirect_type_idx(
                ctx,
                0 - 1,
                1,
                value_types::VT_I32(),
                value_types::VT_I32()
            ))
    }
    if starts_with(clone(dest_name), String_from("vec:")) ||
    starts_with(clone(dest_name), String_from("Vec_")) {
        return Option::Some(intrinsic_vec_type::resolve_vec_type_for_new_dest(ctx, dest))
    }
    Option::None
}

fn vec_access_receiver_local(
    block: MirBlock,
    inst_index: i32,
    inst: MirInst
) -> i32 {
    let recorded_receiver = inst_accessors_operands::MirInst_arg0(inst)
    if recorded_receiver >= 0 {
        return recorded_receiver
    }
    let argument_count = inst_accessors_literals::MirInst_int_val(inst)
    let receiver_index = inst_index - argument_count
    if receiver_index < 0 {
        return 0 - 1
    }
    let receiver_get =
    block_inst_access::MirBlock_inst_at(block, receiver_index)
    if inst_accessors_shape::MirInst_op(receiver_get) != opcodes::MIR_LOCAL_GET() {
        return 0 - 1
    }
    inst_accessors_operands::MirInst_arg0(receiver_get)
}

fn is_vec_access_callee(callee: String) -> bool {
    eq(clone(callee), "raw_array_get_unchecked") ||
    eq(clone(callee), "vec_get_unchecked") ||
    eq(clone(callee), "get_unchecked") ||
    starts_with(clone(callee), "get_unchecked__") ||
    starts_with(clone(callee), "vec_get_unchecked__")
}

fn local_set_non_string_storage_type(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    if local_idx < 0 || local_idx >= function_locals_view::MirFunction_local_count(f) {
        return Option::None
    }
    let storage_type =
    ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, local_idx)
    if storage_type >= 0 &&
    storage_type != ctx_gc_type::SelfEmitCtx_string_type(ctx) {
        return Option::None
    }
    copied_non_string_storage_type(f, local_idx, ctx, 0)
}

fn copied_non_string_storage_type(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx,
    depth: i32
) -> Option<i32> {
    if depth > 3 {
        return Option::None
    }
    let writes = code_ref_locals_fn_cache::function_local_write_index(f, ctx)
    let end = local_write_index::local_write_index_end(writes, local_idx)
    let mut wi = local_write_index::local_write_index_begin(writes, local_idx)
    while wi < end {
        let block = write_site_block(f, writes, wi)
        let inst_index = local_write_index::local_write_index_inst_at(writes, wi)
        let inst = block_inst_access::MirBlock_inst_at(block, inst_index)
        wi = wi + 1
        if inst_accessors_shape::MirInst_op(inst) != opcodes::MIR_LOCAL_SET() ||
        inst_accessors_operands::MirInst_arg0(inst) != local_idx {
            continue
        }
        let source = local_set_source_local(block, inst_index, inst)
        if source < 0 || source == local_idx {
            continue
        }
        let copied = copied_storage_type_from_source(f, source, ctx, depth)
        match copied {
            Option::Some(_type) => {
                return copied
            }
            Option::None => {}
        }
    }
    Option::None
}

// Storage type a LOCAL_SET copy inherits from `source`, in priority order:
// typed spine, named gc struct on the source type_name, Vec element access,
// direct producer, then the source's own copies (bounded by `depth`).
fn copied_storage_type_from_source(f: MirFunction, source: i32, ctx: SelfEmitCtx, depth: i32) -> Option<i32> {
    if source >= 0 && source < function_locals_view::MirFunction_local_count(f) {
        let source_local = function_locals_view::MirFunction_local_at(f, source)
        let source_vt = local_access::MirLocal_val_type(source_local)
        if source_vt == value_types::VT_I64() ||
        source_vt == value_types::VT_F64() ||
        source_vt == value_types::VT_F32() ||
        source_vt == value_types::VT_V128() {
            return Option::None
        }
    }
    let source_type =
    ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, source)
    if source_type >= 0 &&
    source_type != ctx_gc_type::SelfEmitCtx_string_type(ctx) {
        return Option::Some(source_type)
    }
    // Param / local type_name can name a gc_struct while the typed spine stays
    // String (WitParsedInterface). Use the struct so copies keep the
    // callee/param wasm type.
    if source < function_locals_view::MirFunction_local_count(f) {
        let source_tn = local_access::MirLocal_type_name(
            function_locals_view::MirFunction_local_at(f, source)
        )
        let named = code_ref_locals_infer_callee::resolve_named_struct_gc_type(ctx, source_tn)
        match named {
            Option::Some(named_v) => {
                if named_v != ctx_gc_type::SelfEmitCtx_string_type(ctx) {
                    return named
                }
            }
            Option::None => {}
        }
    }
    let source_vec_access_type = local_vec_access_storage_type(f, source, ctx)
    match source_vec_access_type {
        Option::Some(_type) => {
            return source_vec_access_type
        }
        Option::None => {}
    }
    let source_producer_type = local_direct_producer_storage_type(f, source, ctx)
    match source_producer_type {
        Option::Some(_type) => {
            return source_producer_type
        }
        Option::None => {}
    }
    copied_non_string_storage_type(f, source, ctx, depth + 1)
}

fn local_direct_producer_storage_type(
    f: MirFunction,
    local_idx: i32,
    ctx: SelfEmitCtx
) -> Option<i32> {
    let writes = code_ref_locals_fn_cache::function_local_write_index(f, ctx)
    let end = local_write_index::local_write_index_end(writes, local_idx)
    let mut wi = local_write_index::local_write_index_begin(writes, local_idx)
    while wi < end {
        let inst = write_site_inst(f, writes, wi)
        wi = wi + 1
        if inst_accessors_operands::MirInst_dest(inst) != local_idx {
            continue
        }
        let inferred =
        code_ref_locals_infer_dest::infer_ref_local_from_producer(
            f,
            inst,
            inst_accessors_shape::MirInst_op(inst),
            ctx
        )
        match inferred {
            Option::Some(_storage_type) => {
                return inferred
            }
            Option::None => {}
        }
    }
    Option::None
}

fn local_set_source_local(block: MirBlock, inst_index: i32, inst: MirInst) -> i32 {
    let direct_source = inst_accessors_operands::MirInst_arg1(inst)
    if direct_source >= 0 {
        return direct_source
    }
    if inst_index <= 0 {
        return 0 - 1
    }
    let producer = block_inst_access::MirBlock_inst_at(block, inst_index - 1)
    if inst_accessors_shape::MirInst_op(producer) == opcodes::MIR_LOCAL_GET() {
        return inst_accessors_operands::MirInst_arg0(producer)
    }
    inst_accessors_operands::MirInst_dest(producer)
}
