// Result/Option payload-extract storage typing for local decls (#835 / #843).
// Replaces body-scan infer_local_storage_gc_type: field ABI and Result/Option
// base type_names decide storage, not producer rescans.

use mir::block_inst_access
use mir::function_locals_view
use mir::inst_accessors_literals
use mir::inst_accessors_operands
use mir::inst_accessors_shape
use mir::local_access
use mir::opcodes
use mir::value_types
use wasm::ctx_gc_type
use wasm::ctx_gc_layout_lookup
use wasm::ctx_record
use wasm::sections_types_gc

fn gc_struct_get_field_ref_type(inst: MirInst, ctx: SelfEmitCtx) -> Option<i32> {
    let type_slot = inst_accessors_operands::MirInst_arg0(inst)
    let field_idx = inst_accessors_literals::MirInst_int_val(inst)
    let sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    if type_slot < 0 || type_slot >= len(sigs) {
        return Option::None
    }
    let fields = sections_types_gc::wasm_sections_types_gc__struct_field_sigs(get_unchecked(sigs, type_slot))
    if field_idx < 0 || field_idx >= len(fields) {
        return Option::None
    }
    let field_sig = get_unchecked(fields, field_idx)
    if !starts_with(clone(field_sig), "ref") {
        return Option::None
    }
    let offset_str = substring(clone(field_sig), 3, len(field_sig))
    let offset = sections_types_gc::parse_type_sig_int(offset_str)
    Option::Some(ctx_record::SelfEmitCtx_gc_type_base(ctx) + offset)
}

fn struct_get_result_payload_open_type(f: MirFunction, inst: MirInst, ctx: SelfEmitCtx) -> Option<i32> {
    let vt = inst_accessors_shape::MirInst_val_type(inst)
    if vt != value_types::VT_GC_REF() && vt != value_types::VT_REF() {
        return Option::None
    }
    let base = inst_accessors_operands::MirInst_arg0(inst)
    if base < 0 {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    if base >= function_locals_view::MirFunction_local_count(f) {
        return Option::None
    }
    let base_tn = local_access::MirLocal_type_name(function_locals_view::MirFunction_local_at(f, base))
    if starts_with(clone(base_tn), "Result") ||
    starts_with(clone(base_tn), "result:") ||
    starts_with(clone(base_tn), "Option") ||
    starts_with(clone(base_tn), "option:") ||
    starts_with(clone(base_tn), "enum:") {
        return Option::Some(ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    }
    let base_gc = ctx_gc_layout_lookup::SelfEmitCtx_wasm_ref_type_idx_for_local(ctx, base)
    let open = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    if base_gc == open || ctx_gc_layout_lookup::SelfEmitCtx_wasm_type_is_enum_variant(ctx, base_gc) {
        return Option::Some(open)
    }
    Option::None
}

// Storage type for Result/Option payload extracts written by STRUCT_GET /
// GC_STRUCT_GET. Uses field ABI / base type_name — not body-scan infer (#843).
// i32 tag fields return None so scalar decl path wins.
fn local_payload_extract_storage_type(f: MirFunction, local_idx: i32, ctx: SelfEmitCtx) -> Option<i32> {
    let block_count = len(f.blocks)
    let mut bi = 0
    while bi < block_count {
        let block = get_unchecked(f.blocks, bi)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut ii = 0
        while ii < inst_count {
            let inst = block_inst_access::MirBlock_inst_at(block, ii)
            if inst_accessors_operands::MirInst_dest(inst) != local_idx {
                ii = ii + 1
                continue
            }
            let op = inst_accessors_shape::MirInst_op(inst)
            if op == opcodes::MIR_GC_STRUCT_GET() {
                let field_ty = gc_struct_get_field_ref_type(inst, ctx)
                match field_ty {
                    Option::Some(_ty) => {
                        return field_ty
                    }
                    Option::None => {}
                }
            }
            if op == opcodes::MIR_STRUCT_GET() {
                let open_ty = struct_get_result_payload_open_type(f, inst, ctx)
                match open_ty {
                    Option::Some(_ty) => {
                        return open_ty
                    }
                    Option::None => {}
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    Option::None
}
