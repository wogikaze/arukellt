use wasm::constants
use wasm::opcodes
use wasm::writer_core

// The fallback runtime is emitted as ordinary wasm32 functions. It deliberately
// uses only linear-memory instructions; no function in this file may depend on
// the Wasm GC prefix. Allocation records describe ranges rather than source
// types so the bootstrap can track today's raw String/Vec layouts until #874
// supplies exact managed-value descriptors.

// exit_index is the WASI proc_exit/P2-exit import used to report genuine
// arena exhaustion as an identifiable exit status instead of a bare trap.
fn emit_runtime_body(mut w: WasmWriter, ordinal: i32, runtime_base: i32, exit_index: i32) {
    if ordinal == constants::LINEAR_GC_ROOT_FRAME_ENTER() {
        emit_linear_gc_runtime_root_frame_enter_body(w)
        return
    }
    if ordinal == constants::LINEAR_GC_ROOT_PUSH() {
        emit_linear_gc_runtime_root_push_body(w, exit_index)
        return
    }
    if ordinal == constants::LINEAR_GC_ROOT_UPDATE() {
        emit_linear_gc_runtime_root_update_body(w)
        return
    }
    if ordinal == constants::LINEAR_GC_ROOT_FRAME_LEAVE() {
        emit_linear_gc_runtime_root_frame_leave_body(w)
        return
    }
    if ordinal == constants::LINEAR_GC_COMMIT_TOP() {
        emit_linear_gc_runtime_commit_top_body(
            w,
            exit_index,
            runtime_base + constants::LINEAR_GC_COLLECT()
        )
        return
    }
    if ordinal == constants::LINEAR_GC_MARK_CANDIDATE() {
        emit_linear_gc_runtime_mark_candidate_body(w)
        return
    }
    if ordinal == constants::LINEAR_GC_COLLECT() {
        emit_linear_gc_runtime_collect_body(
            w,
            exit_index,
            runtime_base + constants::LINEAR_GC_MARK_CANDIDATE()
        )
        return
    }
    if ordinal == constants::LINEAR_GC_ALLOC() {
        emit_linear_gc_runtime_alloc_body(
            w,
            runtime_base + constants::LINEAR_GC_COMMIT_TOP()
        )
        return
    }
    emit_unreachable(w)
    emit_end(w)
}

fn emit_linear_gc_runtime_root_frame_enter_body(mut w: WasmWriter) {
    emit_local_decls(w, 0)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_end(w)
}

// Terminates the instance with a documented OOM status. proc_exit never
// returns; the trailing unreachable keeps the block well-typed regardless.
fn emit_linear_gc_oom(mut w: WasmWriter, exit_index: i32, code: i32) {
    emit_i32_const(w, code)
    emit_call(w, exit_index)
    emit_unreachable(w)
}

fn emit_linear_gc_runtime_root_push_body(mut w: WasmWriter, exit_index: i32) {
    emit_local_decls(w, 1)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_i32_const(w, constants::LINEAR_GC_ROOT_SLOT_BYTES())
    emit_i32_sub(w)
    emit_local_set(w, 1)

    emit_local_get(w, 1)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_METADATA_CURSOR())
    emit_i32_le_u(w)
    emit_if_empty(w)
    emit_linear_gc_oom(w, exit_index, constants::LINEAR_GC_OOM_EXIT_ROOTS())
    emit_end(w)

    emit_local_get(w, 1)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_local_get(w, 1)
    emit_local_get(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 1)
    emit_end(w)
}

fn emit_linear_gc_runtime_root_update_body(mut w: WasmWriter) {
    emit_local_decls(w, 0)
    emit_local_get(w, 0)
    emit_local_get(w, 1)
    emit_i32_store(w, 0)
    emit_end(w)
}

fn emit_linear_gc_runtime_root_frame_leave_body(mut w: WasmWriter) {
    emit_local_decls(w, 0)
    emit_local_get(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_end(w)
}

// Records the just-bumped [last_top, top) payload. When the free list holds a
// swept record it is reused in place: its old payload range becomes untracked
// (a bounded leak), which keeps the metadata cursor from growing on every
// commit. Only an empty free list bumps the cursor, and only a truly
// exhausted arena reaches the OOM exit.
fn emit_linear_gc_runtime_commit_top_body(mut w: WasmWriter, exit_index: i32, collect_index: i32) {
    emit_local_decls(w, 6)
    // The commit edge mirrors the whole fn-entry safepoint gate: intrinsic
    // inline allocations inside a single activation emit no fn-entry
    // safepoints, so a burst can outrun every trigger between fn entries —
    // payload watermark, metadata-arena pressure, and chain-arena pressure
    // all need to fire here (#922). The record being committed is not linked
    // into the live list yet, so this collection cannot sweep it. The chain
    // hysteresis term keeps a collect that cannot reclaim below the band
    // from refiring on every commit: the gate opens again only after a full
    // band-width of new chain nodes has accumulated, so a saturated live set
    // degrades to the hard overflow check instead of livelocking (#922).
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_WATERMARK())
    emit_i32_const(w, constants::LINEAR_GC_COLLECT_THRESHOLD_BYTES())
    emit_i32_ge_u(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_METADATA_CURSOR())
    emit_i32_sub(w)
    emit_i32_const(w, constants::LINEAR_GC_PRESSURE_FREE_BYTES())
    emit_i32_lt_u(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_FREE_SMALL_HEAD())
    emit_i32_eqz(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_FREE_MID_HEAD())
    emit_i32_eqz(w)
    emit_i32_and(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_FREE_HUGE_HEAD())
    emit_i32_eqz(w)
    emit_i32_and(w)
    emit_i32_and(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_METADATA_CURSOR())
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_METADATA_COLLECT_MARK())
    emit_i32_sub(w)
    emit_i32_const(w, constants::LINEAR_GC_META_RETRY_BYTES())
    emit_i32_ge_u(w)
    emit_i32_and(w)
    emit_i32_or(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_LIMIT())
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_CURSOR())
    emit_i32_sub(w)
    emit_i32_const(w, constants::LINEAR_GC_PRESSURE_FREE_BYTES())
    emit_i32_lt_u(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_CURSOR())
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_COLLECT_MARK())
    emit_i32_sub(w)
    emit_i32_const(w, constants::LINEAR_GC_PRESSURE_FREE_BYTES())
    emit_i32_ge_u(w)
    emit_i32_and(w)
    writer_core::emit_byte(w, opcodes::OP_I32_OR())
    emit_if_empty(w)
    emit_call(w, collect_index)
    emit_end(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_LAST_TOP())
    emit_local_set(w, 1)

    emit_void_block(w)
    emit_local_get(w, 0)
    emit_local_get(w, 1)
    emit_i32_le_u(w)
    emit_br_if(w, 0)

    // Reuse a free record slot for the new allocation record, smallest
    // bucket first: recycling slivers costs nothing, while a large free
    // span destroyed for its record is payload space no allocation can
    // ever reclaim (#922).
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_FREE_SMALL_HEAD())
    emit_local_set(w, 2)
    emit_local_get(w, 2)
    emit_if_empty(w)
    emit_local_get(w, 2)
    emit_i32_load(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_FREE_SMALL_HEAD())
    emit_else(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_FREE_MID_HEAD())
    emit_local_set(w, 2)
    emit_local_get(w, 2)
    emit_if_empty(w)
    emit_local_get(w, 2)
    emit_i32_load(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_FREE_MID_HEAD())
    emit_else(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_FREE_HUGE_HEAD())
    emit_local_set(w, 2)
    emit_local_get(w, 2)
    emit_if_empty(w)
    emit_local_get(w, 2)
    emit_i32_load(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_FREE_HUGE_HEAD())
    emit_else(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_METADATA_CURSOR())
    emit_local_set(w, 2)
    emit_local_get(w, 2)
    emit_i32_const(w, constants::LINEAR_GC_ALLOCATION_RECORD_BYTES())
    emit_i32_add(w)
    emit_local_set(w, 3)
    emit_local_get(w, 3)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_i32_gt_u(w)
    emit_if_empty(w)
    emit_linear_gc_oom(w, exit_index, constants::LINEAR_GC_OOM_EXIT_METADATA())
    emit_end(w)
    emit_local_get(w, 3)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_METADATA_CURSOR())
    emit_end(w)
    emit_end(w)
    emit_end(w)

    emit_local_get(w, 2)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_local_get(w, 1)
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_local_get(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_const(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_local_get(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_LAST_TOP())

    // Register the record on every page its range touches so mark_candidate
    // can jump straight to the covering chain instead of walking the arena.
    // local4 = first page, local5 = last page, local6 = new chain node.
    // The last page uses hi, not hi-1: header-prefixed handles can equal hi
    // (empty {len@-4} payloads), and when hi lands on a page boundary that
    // handle's page is otherwise unregistered and the record misses a mark.
    emit_local_get(w, 1)
    emit_i32_const(w, constants::LINEAR_GC_PAGE_SHIFT())
    emit_i32_shr_u(w)
    emit_local_set(w, 4)
    emit_local_get(w, 0)
    emit_i32_const(w, constants::LINEAR_GC_PAGE_SHIFT())
    emit_i32_shr_u(w)
    emit_local_set(w, 5)
    emit_local_get(w, 5)
    emit_local_get(w, 4)
    emit_i32_lt_u(w)
    emit_if_empty(w)
    emit_else(w)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 4)
    emit_local_get(w, 5)
    emit_i32_gt_u(w)
    emit_br_if(w, 1)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_CURSOR())
    emit_local_set(w, 6)
    emit_local_get(w, 6)
    emit_i32_const(w, constants::LINEAR_GC_CHAIN_NODE_BYTES())
    emit_i32_add(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_LIMIT())
    emit_i32_gt_u(w)
    emit_if_empty(w)
    emit_linear_gc_oom(w, exit_index, constants::LINEAR_GC_OOM_EXIT_CHAIN())
    emit_end(w)
    emit_local_get(w, 6)
    emit_i32_const(w, constants::LINEAR_GC_CHAIN_NODE_BYTES())
    emit_i32_add(w)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_CHAIN_CURSOR())
    emit_local_get(w, 6)
    emit_local_get(w, 2)
    emit_i32_store(w, 0)
    emit_local_get(w, 6)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_PAGE_TABLE_BASE())
    emit_local_get(w, 4)
    emit_i32_const(w, 2)
    emit_i32_shl(w)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_store(w, 0)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_PAGE_TABLE_BASE())
    emit_local_get(w, 4)
    emit_i32_const(w, 2)
    emit_i32_shl(w)
    emit_i32_add(w)
    emit_local_get(w, 6)
    emit_i32_store(w, 0)
    emit_local_get(w, 4)
    emit_i32_const(w, 1)
    emit_i32_add(w)
    emit_local_set(w, 4)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
    emit_end(w)

    emit_end(w)
    emit_end(w)
}

// Returns 1 exactly when the candidate newly marks an allocation record.
// Newly marked records are pushed onto the grey worklist: the mark field
// stores next_grey+1, so 0 stays unmarked and any pushed record is non-zero.
//
// A 64 KiB-page table maps the candidate's page to a chain of
// {record, next} nodes, one node per commit per covered page. The walk only
// touches records that actually span that page, so candidates cost
// O(records-per-page) instead of a full arena scan. Reuse and sweep leave
// stale nodes behind; the [lo,hi] range check against the record's current
// fields filters them, since disjoint ranges can never collide falsely.
//
// The interval is closed because header-prefixed handles can equal hi
// ({len@-4} records: a 4-byte minimal payload's handle is lo+4 == hi).
// That makes a boundary word ambiguous — cand == prev.hi == next.lo — so a
// match on a boundary (cand == lo or cand == hi) marks the record but keeps
// walking: the adjacent record may be the word's real owner. Only a strict
// interior hit (lo < cand < hi) may return early, since disjoint payloads
// give that word exactly one owner.
//
// Boundary hits are still ambiguous, so the walk always continues past
// them, but whether the record claims the word differs by edge. A cand
// equal to lo is a possible head pointer, so the record is always marked.
// A cand equal to hi is a valid handle only for minimal {len@-4} records
// (hi - lo == 4: the whole span is the header and the handle sits one
// byte past it). For any larger span the same word is really the next
// record's lo, and marking on the hi edge would retain a dead
// predecessor every time a head pointer is scanned — on bump-adjacent
// heaps that phantom retention dominates the live set.
fn emit_linear_gc_runtime_mark_candidate_body(mut w: WasmWriter) {
    emit_local_decls(w, 4)
    // local1 = page index, local2 = chain node, local3 = record,
    // local4 = found-boundary flag
    // Cheap reject before touching the page table: every payload lives in
    // [heap_start, heap_pointer), so values outside the live heap range can
    // never hit a record range. Most scanned words are ints, not pointers.
    emit_local_get(w, 0)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_LIMIT())
    emit_i32_lt_u(w)
    emit_if_empty(w)
    emit_i32_const(w, 0)
    emit_return(w)
    emit_end(w)
    emit_local_get(w, 0)
    emit_global_get(w, constants::GLOBAL_HEAP_POINTER())
    emit_i32_ge_u(w)
    emit_if_empty(w)
    emit_i32_const(w, 0)
    emit_return(w)
    emit_end(w)
    emit_local_get(w, 0)
    emit_i32_const(w, constants::LINEAR_GC_PAGE_SHIFT())
    emit_i32_shr_u(w)
    emit_local_set(w, 1)
    emit_local_get(w, 1)
    emit_i32_const(w, constants::LINEAR_GC_PAGE_TABLE_ENTRIES())
    emit_i32_ge_u(w)
    emit_if_empty(w)
    emit_i32_const(w, 0)
    emit_return(w)
    emit_end(w)

    emit_global_get(w, constants::GLOBAL_LINEAR_GC_PAGE_TABLE_BASE())
    emit_local_get(w, 1)
    emit_i32_const(w, 2)
    emit_i32_shl(w)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 2)

    emit_i32_const(w, 0)
    emit_local_set(w, 4)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 2)
    emit_i32_eqz(w)
    emit_br_if(w, 1)

    emit_local_get(w, 2)
    emit_i32_load(w, 0)
    emit_local_set(w, 3)
    emit_local_get(w, 0)
    emit_local_get(w, 3)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_ge_u(w)
    emit_local_get(w, 0)
    emit_local_get(w, 3)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_le_u(w)
    emit_i32_and(w)
    emit_if_empty(w)
    // Strict interior hit: the word's only possible owner, so return after
    // handling this record whether or not it was already marked.
    emit_local_get(w, 0)
    emit_local_get(w, 3)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_gt_u(w)
    emit_local_get(w, 0)
    emit_local_get(w, 3)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_lt_u(w)
    emit_i32_and(w)
    emit_if_empty(w)
    emit_local_get(w, 3)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_eqz(w)
    emit_if_empty(w)
    emit_linear_gc_grey_push(w)
    emit_i32_const(w, 1)
    emit_return(w)
    emit_end(w)
    emit_i32_const(w, 0)
    emit_return(w)
    emit_end(w)
    // Boundary hit. is_handle_boundary = cand == lo, or cand == hi on a
    // minimal {len@-4} record (hi - lo == 4). Either way the word may also
    // belong to the adjacent record, so the walk never returns here.
    emit_local_get(w, 0)
    emit_local_get(w, 3)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_eq(w)
    emit_local_get(w, 0)
    emit_local_get(w, 3)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_eq(w)
    emit_local_get(w, 3)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_get(w, 3)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_sub(w)
    emit_i32_const(w, 4)
    emit_i32_eq(w)
    emit_i32_and(w)
    emit_i32_or(w)
    emit_if_empty(w)
    emit_local_get(w, 3)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_eqz(w)
    emit_if_empty(w)
    emit_linear_gc_grey_push(w)
    emit_i32_const(w, 1)
    emit_local_set(w, 4)
    emit_end(w)
    emit_end(w)
    emit_end(w)

    emit_local_get(w, 2)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 2)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
    emit_local_get(w, 4)
    emit_end(w)
}

// Pushes the record in local3 onto the grey worklist. Caller guarantees the
// mark field is still 0; the stored value is next_grey+1 so 0 stays
// reserved for unmarked.
fn emit_linear_gc_grey_push(mut w: WasmWriter) {
    emit_local_get(w, 3)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_GREY_HEAD())
    emit_i32_const(w, 1)
    emit_i32_add(w)
    emit_i32_store(w, 0)
    emit_local_get(w, 3)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_GREY_HEAD())
}

// Rebuilds the page-table chains from the current allocation-record list.
// commit_top appends one {record, next} node per covered page and stale
// nodes are never reclaimed, so without this sweep the 32 MiB chain arena
// fills monotonically and any high-churn workload exits CHAIN OOM. Clearing
// the table, resetting the bump cursor, and re-registering live records
// bounds the arena to live + per-cycle churn instead of total commits.
// Runs inside collect before marking needs the chains; locals are the
// shared collect decls (0-4 free at this point).
fn emit_linear_gc_rebuild_chains(mut w: WasmWriter, exit_index: i32) {
    // local0 = cursor (table clear pass, then record walk),
    // local1 = page, local2 = last_page, local3 = chain node, local4 = slot.
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_PAGE_TABLE_BASE())
    emit_local_set(w, 0)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 0)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_PAGE_TABLE_BASE())
    emit_i32_const(w, constants::LINEAR_GC_PAGE_TABLE_BYTES())
    emit_i32_add(w)
    emit_i32_ge_u(w)
    emit_br_if(w, 1)
    emit_local_get(w, 0)
    emit_i32_const(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 0)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_local_set(w, 0)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
    // Cursor back to the chain-arena base: limit sits at the arena top.
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_LIMIT())
    emit_i32_const(w, constants::LINEAR_GC_CHAIN_BYTES())
    emit_i32_sub(w)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_CHAIN_CURSOR())
    // Re-register every committed record on the pages it currently spans.
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_local_set(w, 0)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 0)
    emit_i32_eqz(w)
    emit_br_if(w, 1)
    emit_local_get(w, 0)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_const(w, constants::LINEAR_GC_PAGE_SHIFT())
    emit_i32_shr_u(w)
    emit_local_set(w, 1)
    emit_local_get(w, 0)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_const(w, constants::LINEAR_GC_PAGE_SHIFT())
    emit_i32_shr_u(w)
    emit_local_set(w, 2)
    emit_local_get(w, 2)
    emit_local_get(w, 1)
    emit_i32_ge_u(w)
    emit_if_empty(w)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 1)
    emit_local_get(w, 2)
    emit_i32_gt_u(w)
    emit_br_if(w, 1)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_CURSOR())
    emit_local_set(w, 3)
    emit_local_get(w, 3)
    emit_i32_const(w, constants::LINEAR_GC_CHAIN_NODE_BYTES())
    emit_i32_add(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_LIMIT())
    emit_i32_gt_u(w)
    emit_if_empty(w)
    emit_linear_gc_oom(w, exit_index, constants::LINEAR_GC_OOM_EXIT_CHAIN())
    emit_end(w)
    emit_local_get(w, 3)
    emit_i32_const(w, constants::LINEAR_GC_CHAIN_NODE_BYTES())
    emit_i32_add(w)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_CHAIN_CURSOR())
    emit_local_get(w, 3)
    emit_local_get(w, 0)
    emit_i32_store(w, 0)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_PAGE_TABLE_BASE())
    emit_local_get(w, 1)
    emit_i32_const(w, 2)
    emit_i32_shl(w)
    emit_i32_add(w)
    emit_local_set(w, 4)
    emit_local_get(w, 3)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_local_get(w, 4)
    emit_i32_load(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 4)
    emit_local_get(w, 3)
    emit_i32_store(w, 0)
    emit_local_get(w, 1)
    emit_i32_const(w, 1)
    emit_i32_add(w)
    emit_local_set(w, 1)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
    emit_end(w)
    emit_local_get(w, 0)
    emit_i32_load(w, 0)
    emit_local_set(w, 0)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
    // Record the post-rebuild chain cursor as the hysteresis mark: the
    // pressure gates reopen only after a full pressure band-width of new
    // nodes accumulates on top of this position (#922).
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_CURSOR())
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_CHAIN_COLLECT_MARK())
}

fn emit_linear_gc_runtime_collect_body(mut w: WasmWriter, exit_index: i32, mark_index: i32) {
    emit_local_decls(w, 10)
    emit_i32_const(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_WATERMARK())
    emit_i32_const(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_GREY_HEAD())
    emit_linear_gc_rebuild_chains(w, exit_index)
    emit_linear_gc_clear_marks(w)
    emit_linear_gc_mark_roots(w, mark_index)
    emit_linear_gc_mark_transitive(w, mark_index)
    emit_linear_gc_sweep(w)
    // Same hysteresis contract as the chain mark: record the post-collect
    // metadata cursor so the pressure term stays suppressed until a full
    // band-width of new bump-committed records has accumulated (#922).
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_METADATA_CURSOR())
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_METADATA_COLLECT_MARK())
    emit_end(w)
}

fn emit_linear_gc_clear_marks(mut w: WasmWriter) {
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_local_set(w, 0)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 0)
    emit_i32_eqz(w)
    emit_br_if(w, 1)
    emit_local_get(w, 0)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_const(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 0)
    emit_i32_load(w, 0)
    emit_local_set(w, 0)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
}

fn emit_linear_gc_mark_roots(mut w: WasmWriter, mark_index: i32) {
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_local_set(w, 1)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 1)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_LIMIT())
    emit_i32_ge_u(w)
    emit_br_if(w, 1)
    emit_local_get(w, 1)
    emit_i32_load(w, 0)
    emit_call(w, mark_index)
    emit_drop(w)
    emit_local_get(w, 1)
    emit_i32_const(w, constants::LINEAR_GC_ROOT_SLOT_BYTES())
    emit_i32_add(w)
    emit_local_set(w, 1)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
}

// Drains the grey worklist once: every record pushed by mark_candidate is
// popped and scanned exactly once, so a collection costs O(marked words)
// instead of re-scanning every marked record until a fixpoint.
// local0 = popped record, local3 = next grey link, local4/5 = [lo,hi) cursor.
fn emit_linear_gc_mark_transitive(mut w: WasmWriter, mark_index: i32) {
    emit_void_block(w)
    emit_void_loop(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_GREY_HEAD())
    emit_local_set(w, 0)
    emit_local_get(w, 0)
    emit_i32_eqz(w)
    emit_br_if(w, 1)
    emit_local_get(w, 0)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_const(w, 1)
    emit_i32_sub(w)
    emit_local_set(w, 3)
    emit_local_get(w, 0)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_const(w, 1)
    emit_i32_store(w, 0)
    emit_local_get(w, 3)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_GREY_HEAD())
    emit_local_get(w, 0)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 4)
    emit_local_get(w, 0)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 5)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 4)
    emit_local_get(w, 5)
    emit_i32_ge_u(w)
    emit_br_if(w, 1)
    emit_local_get(w, 4)
    emit_i32_load(w, 0)
    emit_call(w, mark_index)
    emit_drop(w)
    emit_local_get(w, 4)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_local_set(w, 4)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
}

fn emit_linear_gc_sweep(mut w: WasmWriter) {
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_local_set(w, 0)
    emit_i32_const(w, 0)
    emit_local_set(w, 7)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 0)
    emit_i32_eqz(w)
    emit_br_if(w, 1)
    emit_local_get(w, 0)
    emit_i32_load(w, 0)
    emit_local_set(w, 6)
    emit_local_get(w, 0)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 8)
    emit_local_get(w, 8)
    emit_i32_eqz(w)
    emit_if_empty(w)
    emit_local_get(w, 7)
    emit_i32_eqz(w)
    emit_if_empty(w)
    emit_local_get(w, 6)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_else(w)
    emit_local_get(w, 7)
    emit_local_get(w, 6)
    emit_i32_store(w, 0)
    emit_end(w)
    // Classify the freed record by its span before pushing. Class
    // boundaries keep alloc's same-class scan honest: a larger bucket's
    // head is always a guaranteed fit, so escalation never walks (#922).
    emit_local_get(w, 0)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_get(w, 0)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_sub(w)
    emit_local_set(w, 9)
    emit_local_get(w, 9)
    emit_i32_const(w, constants::LINEAR_GC_FREE_SMALL_LIMIT_BYTES())
    emit_i32_le_u(w)
    emit_if_empty(w)
    emit_linear_gc_free_push(w, constants::GLOBAL_LINEAR_GC_FREE_SMALL_HEAD())
    emit_else(w)
    emit_local_get(w, 9)
    emit_i32_const(w, constants::LINEAR_GC_FREE_MID_LIMIT_BYTES())
    emit_i32_le_u(w)
    emit_if_empty(w)
    emit_linear_gc_free_push(w, constants::GLOBAL_LINEAR_GC_FREE_MID_HEAD())
    emit_else(w)
    emit_linear_gc_free_push(w, constants::GLOBAL_LINEAR_GC_FREE_HUGE_HEAD())
    emit_end(w)
    emit_end(w)
    emit_else(w)
    emit_local_get(w, 0)
    emit_local_set(w, 7)
    emit_end(w)
    emit_local_get(w, 6)
    emit_local_set(w, 0)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
}

// Push the node in local0 onto the given class bucket's free list.
fn emit_linear_gc_free_push(mut w: WasmWriter, head_global: i32) {
    emit_local_get(w, 0)
    emit_global_get(w, head_global)
    emit_i32_store(w, 0)
    emit_local_get(w, 0)
    emit_global_set(w, head_global)
}

// Bounded same-class first-fit scan. Walks at most
// LINEAR_GC_FREE_SCAN_LIMIT nodes of the bucket; a fitting node is unlinked,
// moved to ALLOC_HEAD with its full recorded span, and its lo returned. The
// span is deliberately not truncated to the request size: truncating would
// strand the tail outside every record, permanently leaking it (#922).
// Locals follow the alloc body's decls: 1 = size, 2 = cur, 3 = prev,
// 4 = lo, 5 = hi, 6 = next, 7 = scanned.
fn emit_linear_gc_try_free_bucket(mut w: WasmWriter, head_global: i32) {
    emit_global_get(w, head_global)
    emit_local_set(w, 2)
    emit_i32_const(w, 0)
    emit_local_set(w, 3)
    emit_i32_const(w, 0)
    emit_local_set(w, 7)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 2)
    emit_i32_eqz(w)
    emit_br_if(w, 1)
    emit_local_get(w, 7)
    emit_i32_const(w, constants::LINEAR_GC_FREE_SCAN_LIMIT())
    emit_i32_ge_u(w)
    emit_br_if(w, 1)
    emit_local_get(w, 2)
    emit_i32_load(w, 0)
    emit_local_set(w, 6)
    emit_local_get(w, 2)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 4)
    emit_local_get(w, 2)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 5)
    emit_local_get(w, 5)
    emit_local_get(w, 4)
    emit_i32_sub(w)
    emit_local_get(w, 1)
    emit_i32_ge_u(w)
    emit_if_empty(w)
    emit_local_get(w, 3)
    emit_i32_eqz(w)
    emit_if_empty(w)
    emit_local_get(w, 6)
    emit_global_set(w, head_global)
    emit_else(w)
    emit_local_get(w, 3)
    emit_local_get(w, 6)
    emit_i32_store(w, 0)
    emit_end(w)
    emit_local_get(w, 2)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_local_get(w, 2)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_const(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 4)
    emit_return(w)
    emit_end(w)
    emit_local_get(w, 2)
    emit_local_set(w, 3)
    emit_local_get(w, 6)
    emit_local_set(w, 2)
    emit_local_get(w, 7)
    emit_i32_const(w, 1)
    emit_i32_add(w)
    emit_local_set(w, 7)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
}

// Pop a larger class bucket's head as a guaranteed fit: every span the
// bucket holds exceeds the request's class limit, so no fit check or walk
// is needed. Falls through silently when the bucket is empty.
fn emit_linear_gc_pop_free_bucket(mut w: WasmWriter, head_global: i32) {
    emit_global_get(w, head_global)
    emit_local_set(w, 2)
    emit_local_get(w, 2)
    emit_if_empty(w)
    emit_local_get(w, 2)
    emit_i32_load(w, 0)
    emit_global_set(w, head_global)
    emit_local_get(w, 2)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_local_get(w, 2)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_const(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_return(w)
    emit_end(w)
}

fn emit_linear_gc_runtime_alloc_body(mut w: WasmWriter, commit_index: i32) {
    emit_local_decls(w, 7)
    emit_local_get(w, 0)
    emit_i32_const(w, 3)
    emit_i32_add(w)
    emit_i32_const(w, 0 - 4)
    emit_i32_and(w)
    emit_local_set(w, 1)
    emit_local_get(w, 1)
    emit_i32_const(w, 4)
    emit_i32_lt_u(w)
    emit_if_empty(w)
    emit_i32_const(w, 4)
    emit_local_set(w, 1)
    emit_end(w)

    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_WATERMARK())
    emit_local_get(w, 1)
    emit_i32_add(w)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_WATERMARK())

    // Reuse a free span from the request's own class, then escalate to
    // larger buckets whose heads are guaranteed fits. This is the only
    // part of the runtime that pays for fragmentation, and it is bounded
    // (#922).
    emit_local_get(w, 1)
    emit_i32_const(w, constants::LINEAR_GC_FREE_SMALL_LIMIT_BYTES())
    emit_i32_le_u(w)
    emit_if_empty(w)
    emit_linear_gc_try_free_bucket(w, constants::GLOBAL_LINEAR_GC_FREE_SMALL_HEAD())
    emit_linear_gc_pop_free_bucket(w, constants::GLOBAL_LINEAR_GC_FREE_MID_HEAD())
    emit_linear_gc_pop_free_bucket(w, constants::GLOBAL_LINEAR_GC_FREE_HUGE_HEAD())
    emit_else(w)
    emit_local_get(w, 1)
    emit_i32_const(w, constants::LINEAR_GC_FREE_MID_LIMIT_BYTES())
    emit_i32_le_u(w)
    emit_if_empty(w)
    emit_linear_gc_try_free_bucket(w, constants::GLOBAL_LINEAR_GC_FREE_MID_HEAD())
    emit_linear_gc_pop_free_bucket(w, constants::GLOBAL_LINEAR_GC_FREE_HUGE_HEAD())
    emit_else(w)
    emit_linear_gc_try_free_bucket(w, constants::GLOBAL_LINEAR_GC_FREE_HUGE_HEAD())
    emit_end(w)
    emit_end(w)

    emit_global_get(w, constants::GLOBAL_HEAP_POINTER())
    emit_local_set(w, 4)
    emit_local_get(w, 4)
    emit_local_get(w, 1)
    emit_i32_add(w)
    emit_local_set(w, 5)
    emit_linear_gc_ensure_memory(w, 5)
    emit_local_get(w, 5)
    emit_global_set(w, constants::GLOBAL_HEAP_POINTER())
    emit_local_get(w, 5)
    emit_call(w, commit_index)
    emit_local_get(w, 4)
    emit_end(w)
}

fn emit_linear_gc_ensure_memory(mut w: WasmWriter, end_local: i32) {
    emit_local_get(w, end_local)
    emit_memory_size_bytes(w)
    emit_i32_gt_u(w)
    emit_if_empty(w)
    emit_local_get(w, end_local)
    emit_memory_size_bytes(w)
    emit_i32_sub(w)
    emit_i32_const(w, 65535)
    emit_i32_add(w)
    emit_i32_const(w, 16)
    emit_i32_shr_u(w)
    emit_memory_grow(w)
    emit_drop(w)
    emit_end(w)
}

fn emit_memory_size_bytes(mut w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_MEMORY_SIZE())
    writer_core::emit_leb128_u(w, 0)
    emit_i32_const(w, 65536)
    emit_i32_mul(w)
}

fn emit_memory_grow(mut w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_MEMORY_GROW())
    writer_core::emit_leb128_u(w, 0)
}

fn emit_local_decls(mut w: WasmWriter, count: i32) {
    if count == 0 {
        writer_core::emit_leb128_u(w, 0)
        return
    }
    writer_core::emit_leb128_u(w, 1)
    writer_core::emit_leb128_u(w, count)
    writer_core::emit_byte(w, constants::WASM_I32())
}

fn emit_i32_const(mut w: WasmWriter, value: i32) {
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, value)
}

fn emit_local_get(mut w: WasmWriter, index: i32) {
    writer_core::emit_local_get(w, index)
}

fn emit_local_set(mut w: WasmWriter, index: i32) {
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, index)
}

fn emit_global_get(mut w: WasmWriter, index: i32) {
    writer_core::emit_byte(w, opcodes::OP_GLOBAL_GET())
    writer_core::emit_leb128_u(w, index)
}

fn emit_global_set(mut w: WasmWriter, index: i32) {
    writer_core::emit_byte(w, opcodes::OP_GLOBAL_SET())
    writer_core::emit_leb128_u(w, index)
}

fn emit_i32_load(mut w: WasmWriter, offset: i32) {
    writer_core::emit_byte(w, opcodes::OP_I32_LOAD())
    writer_core::emit_byte(w, 2)
    writer_core::emit_leb128_u(w, offset)
}

fn emit_i32_store(mut w: WasmWriter, offset: i32) {
    writer_core::emit_byte(w, opcodes::OP_I32_STORE())
    writer_core::emit_byte(w, 2)
    writer_core::emit_leb128_u(w, offset)
}

fn emit_i32_add(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_ADD()) }
fn emit_i32_sub(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_SUB()) }
fn emit_i32_mul(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_MUL()) }
fn emit_i32_and(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_AND()) }
fn emit_i32_eqz(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_EQZ()) }
fn emit_i32_eq(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_EQ()) }
fn emit_i32_le_u(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_LE_U()) }
fn emit_i32_lt_u(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_LT_U()) }
fn emit_i32_ge_u(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_GE_U()) }
fn emit_i32_gt_u(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_GT_U()) }
fn emit_i32_shr_u(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_SHR_U()) }
fn emit_i32_shl(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_SHL()) }

fn emit_call(mut w: WasmWriter, index: i32) {
    writer_core::emit_byte(w, opcodes::OP_CALL())
    writer_core::emit_leb128_u(w, index)
}

fn emit_drop(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_DROP()) }
fn emit_unreachable(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_UNREACHABLE()) }
fn emit_return(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_RETURN()) }

fn emit_void_block(mut w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_BLOCK())
    writer_core::emit_byte(w, 64)
}

fn emit_void_loop(mut w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_LOOP())
    writer_core::emit_byte(w, 64)
}

fn emit_if_empty(mut w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)
}

fn emit_else(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_ELSE()) }
fn emit_end(mut w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_END()) }
fn emit_br(mut w: WasmWriter, depth: i32) {
    writer_core::emit_byte(w, opcodes::OP_BR())
    writer_core::emit_leb128_u(w, depth)
}
fn emit_br_if(mut w: WasmWriter, depth: i32) {
    writer_core::emit_byte(w, opcodes::OP_BR_IF())
    writer_core::emit_leb128_u(w, depth)
}
