use wasm::constants
use wasm::opcodes
use wasm::writer_core

// The fallback runtime is emitted as ordinary wasm32 functions. It deliberately
// uses only linear-memory instructions; no function in this file may depend on
// the Wasm GC prefix. Allocation records describe ranges rather than source
// types so the bootstrap can track today's raw String/Vec layouts until #874
// supplies exact managed-value descriptors.

// exit_index is the WASI proc_exit/P2-exit import used to report genuine
// arena exhaustion as an identifiable exit status instead of a bare trap.
fn emit_runtime_body(w: WasmWriter, ordinal: i32, runtime_base: i32, exit_index: i32) {
    if ordinal == constants::LINEAR_GC_ROOT_FRAME_ENTER() {
        emit_linear_gc_runtime_root_frame_enter_body(w)
        return
    }
    if ordinal == constants::LINEAR_GC_ROOT_PUSH() {
        emit_linear_gc_runtime_root_push_body(w, exit_index)
        return
    }
    if ordinal == constants::LINEAR_GC_ROOT_UPDATE() {
        emit_linear_gc_runtime_root_update_body(w)
        return
    }
    if ordinal == constants::LINEAR_GC_ROOT_FRAME_LEAVE() {
        emit_linear_gc_runtime_root_frame_leave_body(w)
        return
    }
    if ordinal == constants::LINEAR_GC_COMMIT_TOP() {
        emit_linear_gc_runtime_commit_top_body(w, exit_index)
        return
    }
    if ordinal == constants::LINEAR_GC_MARK_CANDIDATE() {
        emit_linear_gc_runtime_mark_candidate_body(w)
        return
    }
    if ordinal == constants::LINEAR_GC_COLLECT() {
        emit_linear_gc_runtime_collect_body(
            w,
            runtime_base + constants::LINEAR_GC_MARK_CANDIDATE()
        )
        return
    }
    if ordinal == constants::LINEAR_GC_ALLOC() {
        emit_linear_gc_runtime_alloc_body(
            w,
            runtime_base + constants::LINEAR_GC_COMMIT_TOP()
        )
        return
    }
    emit_unreachable(w)
    emit_end(w)
}

fn emit_linear_gc_runtime_root_frame_enter_body(w: WasmWriter) {
    emit_local_decls(w, 0)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_end(w)
}

// Terminates the instance with a documented OOM status. proc_exit never
// returns; the trailing unreachable keeps the block well-typed regardless.
fn emit_linear_gc_oom(w: WasmWriter, exit_index: i32, code: i32) {
    emit_i32_const(w, code)
    emit_call(w, exit_index)
    emit_unreachable(w)
}

fn emit_linear_gc_runtime_root_push_body(w: WasmWriter, exit_index: i32) {
    emit_local_decls(w, 1)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_i32_const(w, constants::LINEAR_GC_ROOT_SLOT_BYTES())
    emit_i32_sub(w)
    emit_local_set(w, 1)

    emit_local_get(w, 1)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_METADATA_CURSOR())
    emit_i32_le_u(w)
    emit_if_empty(w)
    emit_linear_gc_oom(w, exit_index, constants::LINEAR_GC_OOM_EXIT_ROOTS())
    emit_end(w)

    emit_local_get(w, 1)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_local_get(w, 1)
    emit_local_get(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 1)
    emit_end(w)
}

fn emit_linear_gc_runtime_root_update_body(w: WasmWriter) {
    emit_local_decls(w, 0)
    emit_local_get(w, 0)
    emit_local_get(w, 1)
    emit_i32_store(w, 0)
    emit_end(w)
}

fn emit_linear_gc_runtime_root_frame_leave_body(w: WasmWriter) {
    emit_local_decls(w, 0)
    emit_local_get(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_end(w)
}

// Records the just-bumped [last_top, top) payload. When the free list holds a
// swept record it is reused in place: its old payload range becomes untracked
// (a bounded leak), which keeps the metadata cursor from growing on every
// commit. Only an empty free list bumps the cursor, and only a truly
// exhausted arena reaches the OOM exit.
fn emit_linear_gc_runtime_commit_top_body(w: WasmWriter, exit_index: i32) {
    emit_local_decls(w, 6)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_LAST_TOP())
    emit_local_set(w, 1)

    emit_void_block(w)
    emit_local_get(w, 0)
    emit_local_get(w, 1)
    emit_i32_le_u(w)
    emit_br_if(w, 0)

    emit_global_get(w, constants::GLOBAL_LINEAR_GC_FREE_HEAD())
    emit_local_set(w, 2)
    emit_local_get(w, 2)
    emit_i32_eqz(w)
    emit_if_empty(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_METADATA_CURSOR())
    emit_local_set(w, 2)
    emit_local_get(w, 2)
    emit_i32_const(w, constants::LINEAR_GC_ALLOCATION_RECORD_BYTES())
    emit_i32_add(w)
    emit_local_set(w, 3)
    emit_local_get(w, 3)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_i32_gt_u(w)
    emit_if_empty(w)
    emit_linear_gc_oom(w, exit_index, constants::LINEAR_GC_OOM_EXIT_METADATA())
    emit_end(w)
    emit_local_get(w, 3)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_METADATA_CURSOR())
    emit_else(w)
    emit_local_get(w, 2)
    emit_i32_load(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_FREE_HEAD())
    emit_end(w)

    emit_local_get(w, 2)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_local_get(w, 1)
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_local_get(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_const(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_local_get(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_LAST_TOP())

    // Register the record on every page its range touches so mark_candidate
    // can jump straight to the covering chain instead of walking the arena.
    // local4 = first page, local5 = last page, local6 = new chain node.
    emit_local_get(w, 1)
    emit_i32_const(w, constants::LINEAR_GC_PAGE_SHIFT())
    emit_i32_shr_u(w)
    emit_local_set(w, 4)
    emit_local_get(w, 0)
    emit_i32_const(w, 1)
    emit_i32_sub(w)
    emit_i32_const(w, constants::LINEAR_GC_PAGE_SHIFT())
    emit_i32_shr_u(w)
    emit_local_set(w, 5)
    emit_local_get(w, 5)
    emit_local_get(w, 4)
    emit_i32_lt_u(w)
    emit_if_empty(w)
    emit_else(w)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 4)
    emit_local_get(w, 5)
    emit_i32_gt_u(w)
    emit_br_if(w, 1)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_CURSOR())
    emit_local_set(w, 6)
    emit_local_get(w, 6)
    emit_i32_const(w, constants::LINEAR_GC_CHAIN_NODE_BYTES())
    emit_i32_add(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_CHAIN_LIMIT())
    emit_i32_gt_u(w)
    emit_if_empty(w)
    emit_linear_gc_oom(w, exit_index, constants::LINEAR_GC_OOM_EXIT_CHAIN())
    emit_end(w)
    emit_local_get(w, 6)
    emit_i32_const(w, constants::LINEAR_GC_CHAIN_NODE_BYTES())
    emit_i32_add(w)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_CHAIN_CURSOR())
    emit_local_get(w, 6)
    emit_local_get(w, 2)
    emit_i32_store(w, 0)
    emit_local_get(w, 6)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_PAGE_TABLE_BASE())
    emit_local_get(w, 4)
    emit_i32_const(w, 2)
    emit_i32_shl(w)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_store(w, 0)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_PAGE_TABLE_BASE())
    emit_local_get(w, 4)
    emit_i32_const(w, 2)
    emit_i32_shl(w)
    emit_i32_add(w)
    emit_local_get(w, 6)
    emit_i32_store(w, 0)
    emit_local_get(w, 4)
    emit_i32_const(w, 1)
    emit_i32_add(w)
    emit_local_set(w, 4)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
    emit_end(w)

    emit_end(w)
    emit_end(w)
}

// Returns 1 exactly when the candidate newly marks an allocation record.
// Newly marked records are pushed onto the grey worklist: the mark field
// stores next_grey+1, so 0 stays unmarked and any pushed record is non-zero.
//
// A 64 KiB-page table maps the candidate's page to a chain of
// {record, next} nodes, one node per commit per covered page. The walk only
// touches records that actually span that page, so candidates cost
// O(records-per-page) instead of a full arena scan. Reuse and sweep leave
// stale nodes behind; the [lo,hi) range check against the record's current
// fields filters them, since disjoint ranges can never collide falsely.
fn emit_linear_gc_runtime_mark_candidate_body(w: WasmWriter) {
    emit_local_decls(w, 3)
    // local1 = page index, local2 = chain node, local3 = record
    // Cheap reject before touching the page table: every payload lives in
    // [heap_start, heap_pointer), so values outside the live heap range can
    // never hit a record range. Most scanned words are ints, not pointers.
    emit_local_get(w, 0)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_LIMIT())
    emit_i32_lt_u(w)
    emit_if_empty(w)
    emit_i32_const(w, 0)
    emit_return(w)
    emit_end(w)
    emit_local_get(w, 0)
    emit_global_get(w, constants::GLOBAL_HEAP_POINTER())
    emit_i32_ge_u(w)
    emit_if_empty(w)
    emit_i32_const(w, 0)
    emit_return(w)
    emit_end(w)
    emit_local_get(w, 0)
    emit_i32_const(w, constants::LINEAR_GC_PAGE_SHIFT())
    emit_i32_shr_u(w)
    emit_local_set(w, 1)
    emit_local_get(w, 1)
    emit_i32_const(w, constants::LINEAR_GC_PAGE_TABLE_ENTRIES())
    emit_i32_ge_u(w)
    emit_if_empty(w)
    emit_i32_const(w, 0)
    emit_return(w)
    emit_end(w)

    emit_global_get(w, constants::GLOBAL_LINEAR_GC_PAGE_TABLE_BASE())
    emit_local_get(w, 1)
    emit_i32_const(w, 2)
    emit_i32_shl(w)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 2)

    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 2)
    emit_i32_eqz(w)
    emit_br_if(w, 1)

    emit_local_get(w, 2)
    emit_i32_load(w, 0)
    emit_local_set(w, 3)
    emit_local_get(w, 0)
    emit_local_get(w, 3)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_ge_u(w)
    emit_local_get(w, 0)
    emit_local_get(w, 3)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_lt_u(w)
    emit_i32_and(w)
    emit_if_empty(w)
    emit_local_get(w, 3)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_eqz(w)
    emit_if_empty(w)
    emit_local_get(w, 3)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_GREY_HEAD())
    emit_i32_const(w, 1)
    emit_i32_add(w)
    emit_i32_store(w, 0)
    emit_local_get(w, 3)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_GREY_HEAD())
    emit_i32_const(w, 1)
    emit_return(w)
    emit_end(w)
    emit_i32_const(w, 0)
    emit_return(w)
    emit_end(w)

    emit_local_get(w, 2)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 2)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
    emit_i32_const(w, 0)
    emit_end(w)
}

fn emit_linear_gc_runtime_collect_body(w: WasmWriter, mark_index: i32) {
    emit_local_decls(w, 10)
    emit_i32_const(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_WATERMARK())
    emit_i32_const(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_GREY_HEAD())
    emit_linear_gc_clear_marks(w)
    emit_linear_gc_mark_roots(w, mark_index)
    emit_linear_gc_mark_transitive(w, mark_index)
    emit_linear_gc_sweep(w)
    emit_end(w)
}

fn emit_linear_gc_clear_marks(w: WasmWriter) {
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_local_set(w, 0)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 0)
    emit_i32_eqz(w)
    emit_br_if(w, 1)
    emit_local_get(w, 0)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_const(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 0)
    emit_i32_load(w, 0)
    emit_local_set(w, 0)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
}

fn emit_linear_gc_mark_roots(w: WasmWriter, mark_index: i32) {
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_CURSOR())
    emit_local_set(w, 1)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 1)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ROOT_LIMIT())
    emit_i32_ge_u(w)
    emit_br_if(w, 1)
    emit_local_get(w, 1)
    emit_i32_load(w, 0)
    emit_call(w, mark_index)
    emit_drop(w)
    emit_local_get(w, 1)
    emit_i32_const(w, constants::LINEAR_GC_ROOT_SLOT_BYTES())
    emit_i32_add(w)
    emit_local_set(w, 1)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
}

// Drains the grey worklist once: every record pushed by mark_candidate is
// popped and scanned exactly once, so a collection costs O(marked words)
// instead of re-scanning every marked record until a fixpoint.
// local0 = popped record, local3 = next grey link, local4/5 = [lo,hi) cursor.
fn emit_linear_gc_mark_transitive(w: WasmWriter, mark_index: i32) {
    emit_void_block(w)
    emit_void_loop(w)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_GREY_HEAD())
    emit_local_set(w, 0)
    emit_local_get(w, 0)
    emit_i32_eqz(w)
    emit_br_if(w, 1)
    emit_local_get(w, 0)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_i32_const(w, 1)
    emit_i32_sub(w)
    emit_local_set(w, 3)
    emit_local_get(w, 0)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_const(w, 1)
    emit_i32_store(w, 0)
    emit_local_get(w, 3)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_GREY_HEAD())
    emit_local_get(w, 0)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 4)
    emit_local_get(w, 0)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 5)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 4)
    emit_local_get(w, 5)
    emit_i32_ge_u(w)
    emit_br_if(w, 1)
    emit_local_get(w, 4)
    emit_i32_load(w, 0)
    emit_call(w, mark_index)
    emit_drop(w)
    emit_local_get(w, 4)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_local_set(w, 4)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
}

fn emit_linear_gc_sweep(w: WasmWriter) {
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_local_set(w, 0)
    emit_i32_const(w, 0)
    emit_local_set(w, 7)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 0)
    emit_i32_eqz(w)
    emit_br_if(w, 1)
    emit_local_get(w, 0)
    emit_i32_load(w, 0)
    emit_local_set(w, 6)
    emit_local_get(w, 0)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 8)
    emit_local_get(w, 8)
    emit_i32_eqz(w)
    emit_if_empty(w)
    emit_local_get(w, 7)
    emit_i32_eqz(w)
    emit_if_empty(w)
    emit_local_get(w, 6)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_else(w)
    emit_local_get(w, 7)
    emit_local_get(w, 6)
    emit_i32_store(w, 0)
    emit_end(w)
    emit_local_get(w, 0)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_FREE_HEAD())
    emit_i32_store(w, 0)
    emit_local_get(w, 0)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_FREE_HEAD())
    emit_else(w)
    emit_local_get(w, 0)
    emit_local_set(w, 7)
    emit_end(w)
    emit_local_get(w, 6)
    emit_local_set(w, 0)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)
}

fn emit_linear_gc_runtime_alloc_body(w: WasmWriter, commit_index: i32) {
    emit_local_decls(w, 7)
    emit_local_get(w, 0)
    emit_i32_const(w, 3)
    emit_i32_add(w)
    emit_i32_const(w, 0 - 4)
    emit_i32_and(w)
    emit_local_set(w, 1)
    emit_local_get(w, 1)
    emit_i32_const(w, 4)
    emit_i32_lt_u(w)
    emit_if_empty(w)
    emit_i32_const(w, 4)
    emit_local_set(w, 1)
    emit_end(w)

    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_WATERMARK())
    emit_local_get(w, 1)
    emit_i32_add(w)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_WATERMARK())

    emit_global_get(w, constants::GLOBAL_LINEAR_GC_FREE_HEAD())
    emit_local_set(w, 2)
    emit_i32_const(w, 0)
    emit_local_set(w, 3)
    emit_void_block(w)
    emit_void_loop(w)
    emit_local_get(w, 2)
    emit_i32_eqz(w)
    emit_br_if(w, 1)
    emit_local_get(w, 2)
    emit_i32_load(w, 0)
    emit_local_set(w, 6)
    emit_local_get(w, 2)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 4)
    emit_local_get(w, 2)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_i32_load(w, 0)
    emit_local_set(w, 5)
    emit_local_get(w, 5)
    emit_local_get(w, 4)
    emit_i32_sub(w)
    emit_local_get(w, 1)
    emit_i32_ge_u(w)
    emit_if_empty(w)
    emit_local_get(w, 3)
    emit_i32_eqz(w)
    emit_if_empty(w)
    emit_local_get(w, 6)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_FREE_HEAD())
    emit_else(w)
    emit_local_get(w, 3)
    emit_local_get(w, 6)
    emit_i32_store(w, 0)
    emit_end(w)
    emit_local_get(w, 2)
    emit_global_get(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_global_set(w, constants::GLOBAL_LINEAR_GC_ALLOC_HEAD())
    emit_local_get(w, 2)
    emit_i32_const(w, 4)
    emit_i32_add(w)
    emit_local_get(w, 4)
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_i32_const(w, 8)
    emit_i32_add(w)
    emit_local_get(w, 4)
    emit_local_get(w, 1)
    emit_i32_add(w)
    emit_i32_store(w, 0)
    emit_local_get(w, 2)
    emit_i32_const(w, 12)
    emit_i32_add(w)
    emit_i32_const(w, 0)
    emit_i32_store(w, 0)
    emit_local_get(w, 4)
    emit_return(w)
    emit_end(w)
    emit_local_get(w, 2)
    emit_local_set(w, 3)
    emit_local_get(w, 6)
    emit_local_set(w, 2)
    emit_br(w, 0)
    emit_end(w)
    emit_end(w)

    emit_global_get(w, constants::GLOBAL_HEAP_POINTER())
    emit_local_set(w, 4)
    emit_local_get(w, 4)
    emit_local_get(w, 1)
    emit_i32_add(w)
    emit_local_set(w, 5)
    emit_linear_gc_ensure_memory(w, 5)
    emit_local_get(w, 5)
    emit_global_set(w, constants::GLOBAL_HEAP_POINTER())
    emit_local_get(w, 5)
    emit_call(w, commit_index)
    emit_local_get(w, 4)
    emit_end(w)
}

fn emit_linear_gc_ensure_memory(w: WasmWriter, end_local: i32) {
    emit_local_get(w, end_local)
    emit_memory_size_bytes(w)
    emit_i32_gt_u(w)
    emit_if_empty(w)
    emit_local_get(w, end_local)
    emit_memory_size_bytes(w)
    emit_i32_sub(w)
    emit_i32_const(w, 65535)
    emit_i32_add(w)
    emit_i32_const(w, 16)
    emit_i32_shr_u(w)
    emit_memory_grow(w)
    emit_drop(w)
    emit_end(w)
}

fn emit_memory_size_bytes(w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_MEMORY_SIZE())
    writer_core::emit_leb128_u(w, 0)
    emit_i32_const(w, 65536)
    emit_i32_mul(w)
}

fn emit_memory_grow(w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_MEMORY_GROW())
    writer_core::emit_leb128_u(w, 0)
}

fn emit_local_decls(w: WasmWriter, count: i32) {
    if count == 0 {
        writer_core::emit_leb128_u(w, 0)
        return
    }
    writer_core::emit_leb128_u(w, 1)
    writer_core::emit_leb128_u(w, count)
    writer_core::emit_byte(w, constants::WASM_I32())
}

fn emit_i32_const(w: WasmWriter, value: i32) {
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, value)
}

fn emit_local_get(w: WasmWriter, index: i32) {
    writer_core::emit_local_get(w, index)
}

fn emit_local_set(w: WasmWriter, index: i32) {
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, index)
}

fn emit_global_get(w: WasmWriter, index: i32) {
    writer_core::emit_byte(w, opcodes::OP_GLOBAL_GET())
    writer_core::emit_leb128_u(w, index)
}

fn emit_global_set(w: WasmWriter, index: i32) {
    writer_core::emit_byte(w, opcodes::OP_GLOBAL_SET())
    writer_core::emit_leb128_u(w, index)
}

fn emit_i32_load(w: WasmWriter, offset: i32) {
    writer_core::emit_byte(w, opcodes::OP_I32_LOAD())
    writer_core::emit_byte(w, 2)
    writer_core::emit_leb128_u(w, offset)
}

fn emit_i32_store(w: WasmWriter, offset: i32) {
    writer_core::emit_byte(w, opcodes::OP_I32_STORE())
    writer_core::emit_byte(w, 2)
    writer_core::emit_leb128_u(w, offset)
}

fn emit_i32_add(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_ADD()) }
fn emit_i32_sub(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_SUB()) }
fn emit_i32_mul(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_MUL()) }
fn emit_i32_and(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_AND()) }
fn emit_i32_eqz(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_EQZ()) }
fn emit_i32_le_u(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_LE_U()) }
fn emit_i32_lt_u(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_LT_U()) }
fn emit_i32_ge_u(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_GE_U()) }
fn emit_i32_gt_u(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_GT_U()) }
fn emit_i32_shr_u(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_SHR_U()) }
fn emit_i32_shl(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_I32_SHL()) }

fn emit_call(w: WasmWriter, index: i32) {
    writer_core::emit_byte(w, opcodes::OP_CALL())
    writer_core::emit_leb128_u(w, index)
}

fn emit_drop(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_DROP()) }
fn emit_unreachable(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_UNREACHABLE()) }
fn emit_return(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_RETURN()) }

fn emit_void_block(w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_BLOCK())
    writer_core::emit_byte(w, 64)
}

fn emit_void_loop(w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_LOOP())
    writer_core::emit_byte(w, 64)
}

fn emit_if_empty(w: WasmWriter) {
    writer_core::emit_byte(w, opcodes::OP_IF())
    writer_core::emit_byte(w, 64)
}

fn emit_else(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_ELSE()) }
fn emit_end(w: WasmWriter) { writer_core::emit_byte(w, opcodes::OP_END()) }
fn emit_br(w: WasmWriter, depth: i32) {
    writer_core::emit_byte(w, opcodes::OP_BR())
    writer_core::emit_leb128_u(w, depth)
}
fn emit_br_if(w: WasmWriter, depth: i32) {
    writer_core::emit_byte(w, opcodes::OP_BR_IF())
    writer_core::emit_leb128_u(w, depth)
}
