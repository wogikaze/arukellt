use mir::function_param_view
use mir::function_return_view
use mir::local_access
use mir::value_types
use wasm::ctx_gc_type
use wasm::ctx_record
use wasm::function_indices
use wasm::intrinsics::helpers_control
use wasm::intrinsics::helpers_memory
use wasm::intrinsics::helpers_numeric_i32_arith
use wasm::intrinsics::helpers_numeric_i32_compare
use wasm::intrinsics::helpers_numeric_i32_const
use wasm::opcodes
use wasm::sections_types_gc
use wasm::sections_types_sigs_detail
use wasm::writer_core
use wasm::writer_gc

// Convert the compiler's private GC string representation to standard32
// canonical ABI values at a core-module export boundary. The component linker
// consumes these exports directly; no component adapter module is involved.
fn emit_library_wrapper_body(
    w: WasmWriter,
    f: MirFunction,
    function_idx: i32,
    realloc_idx: i32,
    ctx: SelfEmitCtx,
    wit_import_count: i32,
    mir: MirModule
) {
    let canonical_count = canonical_param_count(f, mir)
    let ref_markers = wrapper_ref_markers(f, ctx, mir)
    let ref_count = len(ref_markers)
    let scalar_base = canonical_count + ref_count
    let loop_local = scalar_base
    let result_ptr_local = scalar_base + 1
    let aux_local = scalar_base + 2
    let return_ref_local = canonical_count + return_ref_offset(f, ctx, mir)
    let return_payload_ref_local = if return_has_string_payload(f, mir) {
        return_ref_local + 1
    } else {
        0 - 1
    }
    emit_wrapper_local_decls(w, canonical_count, ref_markers)
    emit_param_conversions(w, f, mir, ctx, canonical_count, loop_local)
    emit_raw_function_call(w, f, function_idx, canonical_count, mir, ctx, wit_import_count)
    if return_is_ref(f, mir) {
        writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
        writer_core::emit_leb128_u(w, return_ref_local)
    }
    emit_result_conversion(
        w,
        f,
        mir,
        ctx,
        return_ref_local,
        return_payload_ref_local,
        result_ptr_local,
        loop_local,
        aux_local,
        realloc_idx
    )
    writer_core::emit_byte(w, opcodes::OP_END())
}

fn emit_wrapper_local_decls(
    w: WasmWriter,
    canonical_param_count: i32,
    ref_markers: Vec<i32>
) {
    writer_core::emit_leb128_u(w, local_decl_group_count(ref_markers))
    emit_ref_decl_groups(w, ref_markers)
    writer_core::emit_leb128_u(w, 3)
    writer_core::emit_byte(w, 127)
    let local_refs = Vec::new<i32>()
    append_ref_markers(local_refs, canonical_param_count, 0 - 1)
    for i in 0..len(ref_markers) {
        push(local_refs, get_unchecked(ref_markers, i))
    }
    append_ref_markers(local_refs, 3, 0 - 1)
    writer_core::writer_begin_function_locals(w, local_refs)
}

fn local_decl_group_count(ref_markers: Vec<i32>) -> i32 {
    let mut count = 1
    let mut i = 0
    while i < len(ref_markers) {
        if i == 0 || get_unchecked(ref_markers, i) != get_unchecked(ref_markers, i - 1) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn emit_ref_decl_groups(w: WasmWriter, ref_markers: Vec<i32>) {
    let mut i = 0
    while i < len(ref_markers) {
        let marker = get_unchecked(ref_markers, i)
        let mut end = i + 1
        while end < len(ref_markers) && get_unchecked(ref_markers, end) == marker {
            end = end + 1
        }
        writer_core::emit_leb128_u(w, end - i)
        writer_core::emit_byte(w, 99)
        writer_core::emit_leb128_s(w, marker)
        i = end
    }
}

fn append_ref_markers(local_refs: Vec<i32>, count: i32, value: i32) {
    let mut i = 0
    while i < count {
        push(local_refs, value)
        i = i + 1
    }
}

fn emit_param_conversions(
    w: WasmWriter,
    f: MirFunction,
    mir: MirModule,
    ctx: SelfEmitCtx,
    canonical_param_count: i32,
    loop_local: i32
) {
    let param_count = function_param_view::MirFunction_param_count(f)
    let mut canonical_idx = 0
    let mut pi = 0
    while pi < param_count {
        let param = function_param_view::MirFunction_param_at(f, pi)
        let type_name = local_access::MirLocal_type_name(param)
        let kind = p2_type_kind(clone(type_name), local_access::MirLocal_val_type(param), mir)
        let ref_local = canonical_param_count + param_ref_offset(f, pi, ctx, mir)
        if kind == p2_kind_string() {
            let string_type = ctx_gc_type::SelfEmitCtx_string_type(ctx)
            emit_string_input_copy(
                w,
                canonical_idx,
                canonical_idx + 1,
                ref_local,
                loop_local,
                string_type
            )
            canonical_idx = canonical_idx + 2
        } else if kind == p2_kind_list() {
            emit_list_input_conversion(
                w,
                canonical_idx,
                canonical_idx + 1,
                ref_local,
                ref_local + 1,
                loop_local,
                clone(type_name),
                ctx
            )
            canonical_idx = canonical_idx + 2
        } else if kind == p2_kind_tuple() || kind == p2_kind_record() {
            emit_struct_input_conversion(
                w,
                clone(type_name),
                ref_local,
                canonical_idx,
                loop_local,
                ctx,
                mir
            )
            canonical_idx = canonical_idx + sections_types_sigs_detail::p2_canonical_param_count_for_type(
                clone(type_name),
                local_access::MirLocal_val_type(param),
                mir
            )
        } else if kind == p2_kind_option() || kind == p2_kind_result() || kind == p2_kind_enum() {
            emit_variant_input_conversion(
                w,
                clone(type_name),
                local_access::MirLocal_val_type(param),
                ref_local,
                canonical_idx,
                loop_local,
                ctx,
                mir
            )
            canonical_idx = canonical_idx + sections_types_sigs_detail::p2_canonical_param_count_for_type(
                clone(type_name),
                local_access::MirLocal_val_type(param),
                mir
            )
        } else {
            canonical_idx = canonical_idx + 1
        }
        pi = pi + 1
    }
}

fn emit_list_input_conversion(
    w: WasmWriter,
    pointer_local: i32,
    length_local: i32,
    vec_local: i32,
    array_local: i32,
    loop_local: i32,
    type_name: String,
    ctx: SelfEmitCtx
) {
    let array_type = p2_vec_array_type(ctx, clone(type_name))
    let vec_type = p2_vec_type(ctx, clone(type_name))
    writer_core::emit_local_get(w, length_local)
    writer_gc::emit_gc_array_new(w, array_type)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, array_local)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, loop_local)
    helpers_control::emit_block_loop_header(w)
    writer_core::emit_local_get(w, loop_local)
    writer_core::emit_local_get(w, length_local)
    helpers_numeric_i32_compare::emit_i32_ge_u(w)
    helpers_control::emit_br_if(w, 1)
    writer_core::emit_local_get(w, array_local)
    writer_core::emit_local_get(w, loop_local)
    writer_core::emit_local_get(w, pointer_local)
    writer_core::emit_local_get(w, loop_local)
    helpers_numeric_i32_const::emit_i32_const(w, 4)
    helpers_numeric_i32_arith::emit_i32_mul(w)
    helpers_numeric_i32_arith::emit_i32_add(w)
    helpers_memory::emit_i32_load_default(w)
    writer_gc::emit_gc_array_set_i32(w, array_type)
    writer_core::emit_local_get(w, loop_local)
    helpers_numeric_i32_const::emit_i32_const(w, 1)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, loop_local)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_block_loop_footer(w)
    writer_core::emit_local_get(w, array_local)
    writer_core::emit_local_get(w, length_local)
    writer_gc::emit_gc_struct_new(w, vec_type)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, vec_local)
}

fn p2_kind_scalar() -> i32 { 0 }
fn p2_kind_string() -> i32 { 1 }
fn p2_kind_list() -> i32 { 2 }
fn p2_kind_option() -> i32 { 3 }
fn p2_kind_result() -> i32 { 4 }
fn p2_kind_tuple() -> i32 { 5 }
fn p2_kind_record() -> i32 { 6 }
fn p2_kind_enum() -> i32 { 7 }
fn p2_kind_aggregate() -> i32 { 8 }

fn p2_type_kind(type_name: String, value_type: i32, mir: MirModule) -> i32 {
    if sections_types_sigs_detail::p2_is_string_type_name(clone(type_name)) {
        return p2_kind_string()
    }
    if sections_types_sigs_detail::p2_is_list_type_name(clone(type_name)) {
        return p2_kind_list()
    }
    if sections_types_sigs_detail::p2_is_option_type_name(clone(type_name)) {
        return p2_kind_option()
    }
    if sections_types_sigs_detail::p2_is_result_type_name(clone(type_name)) {
        return p2_kind_result()
    }
    if sections_types_sigs_detail::p2_is_tuple_type_name(clone(type_name)) {
        return p2_kind_tuple()
    }
    if sections_types_sigs_detail::p2_enum_has_variants(clone(type_name), mir) {
        return p2_kind_enum()
    }
    if len(sections_types_sigs_detail::p2_struct_field_sigs(clone(type_name), mir)) > 0 {
        return p2_kind_record()
    }
    if value_type == value_types::VT_VOID() || value_type == value_types::VT_I32() ||
    value_type == value_types::VT_I64() || value_type == value_types::VT_F64() ||
    value_type == value_types::VT_F32() {
        return p2_kind_scalar()
    }
    p2_kind_aggregate()
}

fn p2_field_storage_sig(type_name: String) -> String {
    if sections_types_sigs_detail::p2_is_string_type_name(clone(type_name)) {
        return String_from("ref0")
    }
    if eq(clone(type_name), String_from("i64")) || eq(clone(type_name), String_from("u64")) {
        return String_from("i64")
    }
    if eq(clone(type_name), String_from("f64")) {
        return String_from("f64")
    }
    if eq(clone(type_name), String_from("f32")) {
        return String_from("f32")
    }
    String_from("i32")
}

fn p2_field_width(field_sig: String) -> i32 {
    if eq(clone(field_sig), String_from("i64")) || eq(clone(field_sig), String_from("f64")) {
        return 8
    }
    4
}

fn p2_vec_type(ctx: SelfEmitCtx, type_name: String) -> i32 {
    let elem = sections_types_sigs_detail::p2_type_argument(clone(type_name), 0)
    if eq(clone(elem), String_from("i64")) || eq(clone(elem), String_from("u64")) {
        return ctx_gc_type::SelfEmitCtx_vec_i64_type(ctx)
    }
    if eq(clone(elem), String_from("f64")) {
        return ctx_gc_type::SelfEmitCtx_vec_f64_type(ctx)
    }
    if sections_types_sigs_detail::p2_is_string_type_name(clone(elem)) {
        return ctx_gc_type::SelfEmitCtx_vec_string_type(ctx)
    }
    ctx_gc_type::SelfEmitCtx_vec_type(ctx)
}

fn p2_vec_array_type(ctx: SelfEmitCtx, type_name: String) -> i32 {
    let elem = sections_types_sigs_detail::p2_type_argument(clone(type_name), 0)
    if eq(clone(elem), String_from("i64")) || eq(clone(elem), String_from("u64")) {
        return ctx_gc_type::SelfEmitCtx_i64_array_type(ctx)
    }
    if eq(clone(elem), String_from("f64")) {
        return ctx_gc_type::SelfEmitCtx_f64_array_type(ctx)
    }
    if sections_types_sigs_detail::p2_is_string_type_name(clone(elem)) {
        return ctx_gc_type::SelfEmitCtx_string_ref_array_type(ctx)
    }
    ctx_gc_type::SelfEmitCtx_i32_array_type(ctx)
}

fn p2_struct_type(ctx: SelfEmitCtx, type_name: String, mir: MirModule) -> i32 {
    let query = sections_types_sigs_detail::p2_struct_name_from_type(clone(type_name))
    let direct = ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, clone(query))
    if direct >= 0 {
        return direct
    }
    let names = ctx_record::SelfEmitCtx_gc_struct_names(ctx)
    let maps = ctx_record::SelfEmitCtx_gc_struct_type_map(ctx)
    let mut i = 0
    while i < len(names) && i < len(maps) {
        if eq(clone(get_unchecked(names, i)), clone(query)) ||
        eq(clone(get_unchecked(names, i)), clone(type_name)) {
            return get_unchecked(maps, i)
        }
        i = i + 1
    }
    let fields = p2_struct_fields(ctx, clone(type_name), mir)
    let mut size = 0
    let mut fi = 0
    while fi < len(fields) {
        let width = p2_field_width(get_unchecked(fields, fi))
        if width == 8 && size % 8 != 0 {
            size = size + (8 - size % 8)
        }
        size = size + width
        fi = fi + 1
    }
    if size == 0 {
        size = 4
    }
    ctx_gc_type::SelfEmitCtx_struct_type(ctx, size)
}

fn p2_struct_fields(ctx: SelfEmitCtx, type_name: String, mir: MirModule) -> Vec<String> {
    if sections_types_sigs_detail::p2_is_tuple_type_name(clone(type_name)) {
        let fields = Vec::new<String>()
        let mut i = 0
        while len(sections_types_sigs_detail::p2_type_argument(clone(type_name), i)) > 0 {
            push(
                fields,
                p2_field_storage_sig(sections_types_sigs_detail::p2_type_argument(clone(type_name), i))
            )
            i = i + 1
        }
        return fields
    }
    let from_mir = sections_types_sigs_detail::p2_struct_field_sigs(clone(type_name), mir)
    if len(from_mir) > 0 {
        return from_mir
    }
    let query = sections_types_sigs_detail::p2_struct_name_from_type(clone(type_name))
    let names = ctx_record::SelfEmitCtx_gc_struct_names(ctx)
    let sigs = ctx_record::SelfEmitCtx_gc_struct_sigs(ctx)
    let mut i = 0
    while i < len(names) && i < len(sigs) {
        if eq(clone(get_unchecked(names, i)), clone(query)) ||
        eq(clone(get_unchecked(names, i)), clone(type_name)) {
            return sections_types_gc::struct_field_sigs(get_unchecked(sigs, i))
        }
        i = i + 1
    }
    Vec::new<String>()
}

fn p2_raw_type_idx(
    ctx: SelfEmitCtx,
    type_name: String,
    value_type: i32,
    mir: MirModule
) -> i32 {
    let kind = p2_type_kind(clone(type_name), value_type, mir)
    if kind == p2_kind_string() {
        return ctx_gc_type::SelfEmitCtx_string_type(ctx)
    }
    if kind == p2_kind_list() {
        return p2_vec_type(ctx, clone(type_name))
    }
    if kind == p2_kind_tuple() || kind == p2_kind_record() {
        return p2_struct_type(ctx, clone(type_name), mir)
    }
    if kind == p2_kind_option() || kind == p2_kind_result() || kind == p2_kind_enum() ||
    kind == p2_kind_aggregate() {
        return ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    }
    ctx_gc_type::SelfEmitCtx_struct_type(ctx, 4)
}

fn p2_param_ref_extra_count(type_name: String, value_type: i32, ctx: SelfEmitCtx, mir: MirModule) -> i32 {
    let kind = p2_type_kind(clone(type_name), value_type, mir)
    if kind == p2_kind_list() {
        return 1
    }
    if kind == p2_kind_option() || kind == p2_kind_result() || kind == p2_kind_enum() {
        if return_has_string_payload_name(clone(type_name), mir) {
            return 1
        }
    }
    if kind == p2_kind_tuple() || kind == p2_kind_record() {
        let fields = p2_struct_fields(ctx, clone(type_name), mir)
        let mut count = 0
        let mut i = 0
        while i < len(fields) {
            if eq(clone(get_unchecked(fields, i)), String_from("ref0")) {
                count = count + 1
            }
            i = i + 1
        }
        return count
    }
    0
}

fn param_ref_count(type_name: String, value_type: i32, ctx: SelfEmitCtx, mir: MirModule) -> i32 {
    let kind = p2_type_kind(clone(type_name), value_type, mir)
    if kind == p2_kind_scalar() {
        return 0
    }
    1 + p2_param_ref_extra_count(clone(type_name), value_type, ctx, mir)
}

fn param_ref_offset(f: MirFunction, pi: i32, ctx: SelfEmitCtx, mir: MirModule) -> i32 {
    let mut offset = 0
    let mut i = 0
    while i < pi {
        let p = function_param_view::MirFunction_param_at(f, i)
        offset = offset + param_ref_count(
            local_access::MirLocal_type_name(p),
            local_access::MirLocal_val_type(p),
            ctx,
            mir
        )
        i = i + 1
    }
    offset
}

fn return_ref_offset(f: MirFunction, ctx: SelfEmitCtx, mir: MirModule) -> i32 {
    let count = function_param_view::MirFunction_param_count(f)
    param_ref_offset(f, count, ctx, mir)
}

fn return_is_ref(f: MirFunction, mir: MirModule) -> bool {
    let return_type = function_return_view::MirFunction_return_type(f)
    let return_name = function_return_view::MirFunction_return_type_name(f)
    sections_types_sigs_detail::p2_type_is_aggregate(clone(return_name), return_type, mir)
}

fn return_has_string_payload(f: MirFunction, mir: MirModule) -> bool {
    return_has_string_payload_name(
        function_return_view::MirFunction_return_type_name(f),
        mir
    )
}

fn return_has_string_payload_name(type_name: String, mir: MirModule) -> bool {
    let kind_is_option = sections_types_sigs_detail::p2_is_option_type_name(clone(type_name))
    let kind_is_result = sections_types_sigs_detail::p2_is_result_type_name(clone(type_name))
    if kind_is_option {
        return sections_types_sigs_detail::p2_is_string_type_name(
            sections_types_sigs_detail::p2_type_argument(clone(type_name), 0)
        )
    }
    if kind_is_result {
        return sections_types_sigs_detail::p2_is_string_type_name(
            sections_types_sigs_detail::p2_type_argument(clone(type_name), 0)
        ) || sections_types_sigs_detail::p2_is_string_type_name(
            sections_types_sigs_detail::p2_type_argument(clone(type_name), 1)
        )
    }
    let payload = sections_types_sigs_detail::p2_enum_payload_sigs(clone(type_name), mir)
    len(payload) > 0 && eq(clone(get_unchecked(payload, 0)), String_from("ref0"))
}

fn canonical_param_count(f: MirFunction, mir: MirModule) -> i32 {
    let mut count = 0
    let param_count = function_param_view::MirFunction_param_count(f)
    let mut i = 0
    while i < param_count {
        let param = function_param_view::MirFunction_param_at(f, i)
        count = count + sections_types_sigs_detail::p2_canonical_param_count_for_type(
            local_access::MirLocal_type_name(param),
            local_access::MirLocal_val_type(param),
            mir
        )
        i = i + 1
    }
    count
}

fn wrapper_ref_markers(f: MirFunction, ctx: SelfEmitCtx, mir: MirModule) -> Vec<i32> {
    let markers = Vec::new<i32>()
    let param_count = function_param_view::MirFunction_param_count(f)
    let mut i = 0
    while i < param_count {
        let param = function_param_view::MirFunction_param_at(f, i)
        let type_name = local_access::MirLocal_type_name(param)
        let value_type = local_access::MirLocal_val_type(param)
        let kind = p2_type_kind(clone(type_name), value_type, mir)
        if kind != p2_kind_scalar() {
            push(markers, p2_raw_type_idx(ctx, clone(type_name), value_type, mir))
            if kind == p2_kind_list() {
                push(markers, p2_vec_array_type(ctx, clone(type_name)))
            } else if return_has_string_payload_name(clone(type_name), mir) {
                push(markers, ctx_gc_type::SelfEmitCtx_string_type(ctx))
            } else if kind == p2_kind_tuple() || kind == p2_kind_record() {
                let fields = p2_struct_fields(ctx, clone(type_name), mir)
                let mut fi = 0
                while fi < len(fields) {
                    if eq(clone(get_unchecked(fields, fi)), String_from("ref0")) {
                        push(markers, ctx_gc_type::SelfEmitCtx_string_type(ctx))
                    }
                    fi = fi + 1
                }
            }
        }
        i = i + 1
    }
    if return_is_ref(f, mir) {
        let return_name = function_return_view::MirFunction_return_type_name(f)
        let return_type = function_return_view::MirFunction_return_type(f)
        push(markers, p2_raw_type_idx(ctx, clone(return_name), return_type, mir))
        if return_has_string_payload(f, mir) {
            push(markers, ctx_gc_type::SelfEmitCtx_string_type(ctx))
        }
    }
    markers
}

fn emit_struct_input_conversion(
    w: WasmWriter,
    type_name: String,
    struct_local: i32,
    canonical_idx: i32,
    loop_local: i32,
    ctx: SelfEmitCtx,
    mir: MirModule
) {
    let fields = p2_struct_fields(ctx, clone(type_name), mir)
    let struct_type = p2_struct_type(ctx, clone(type_name), mir)
    let mut field_idx = canonical_idx
    let mut string_local = struct_local + 1
    let string_type = ctx_gc_type::SelfEmitCtx_string_type(ctx)
    let mut fi = 0
    while fi < len(fields) {
        let field = get_unchecked(fields, fi)
        if eq(clone(field), String_from("ref0")) {
            emit_string_input_copy(
                w,
                field_idx,
                field_idx + 1,
                string_local,
                loop_local,
                string_type
            )
            writer_core::emit_local_get(w, string_local)
            field_idx = field_idx + 2
            string_local = string_local + 1
        } else {
            writer_core::emit_local_get(w, field_idx)
            field_idx = field_idx + 1
        }
        fi = fi + 1
    }
    writer_gc::emit_gc_struct_new(w, struct_type)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, struct_local)
}

fn p2_variant_family_matches(family: String, variant_name: String) -> bool {
    starts_with(clone(variant_name), concat(clone(family), String_from("::"))) ||
    contains(
        clone(variant_name),
        concat(String_from("::"), concat(clone(family), String_from("::")))
    )
}

fn p2_variant_name_matches(family: String, variant: String, name: String) -> bool {
    let wanted = concat(clone(family), concat(String_from("::"), clone(variant)))
    eq(clone(name), clone(wanted)) || contains(clone(name), concat(String_from("::"), clone(wanted)))
}

fn p2_variant_type_named(
    ctx: SelfEmitCtx,
    family: String,
    variant: String,
    payload_field: String
) -> i32 {
    let names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    let maps = ctx_record::SelfEmitCtx_gc_enum_variant_type_map(ctx)
    let mut i = 0
    while i < len(names) && i < len(sigs) && i < len(maps) {
        if p2_variant_name_matches(clone(family), clone(variant), get_unchecked(names, i)) {
            let fields = sections_types_gc::struct_field_sigs(get_unchecked(sigs, i))
            if len(payload_field) == 0 && len(fields) == 1 {
                return get_unchecked(maps, i)
            }
            if len(payload_field) > 0 && len(fields) > 1 &&
            eq(clone(get_unchecked(fields, 1)), clone(payload_field)) {
                return get_unchecked(maps, i)
            }
        }
        i = i + 1
    }
    0 - 1
}

fn p2_variant_type_at_ordinal(ctx: SelfEmitCtx, family: String, ordinal: i32) -> i32 {
    let names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let maps = ctx_record::SelfEmitCtx_gc_enum_variant_type_map(ctx)
    let mut seen = 0
    let mut i = 0
    while i < len(names) && i < len(maps) {
        if p2_variant_family_matches(clone(family), get_unchecked(names, i)) {
            if seen == ordinal {
                return get_unchecked(maps, i)
            }
            seen = seen + 1
        }
        i = i + 1
    }
    0 - 1
}

fn p2_variant_count(ctx: SelfEmitCtx, family: String) -> i32 {
    let names = ctx_record::SelfEmitCtx_gc_enum_variant_names(ctx)
    let mut count = 0
    let mut i = 0
    while i < len(names) {
        if p2_variant_family_matches(clone(family), get_unchecked(names, i)) {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn p2_variant_payload_field(ctx: SelfEmitCtx, type_idx: i32) -> String {
    let maps = ctx_record::SelfEmitCtx_gc_enum_variant_type_map(ctx)
    let sigs = ctx_record::SelfEmitCtx_gc_enum_variant_sigs(ctx)
    let mut i = 0
    while i < len(maps) && i < len(sigs) {
        if get_unchecked(maps, i) == type_idx {
            let fields = sections_types_gc::struct_field_sigs(get_unchecked(sigs, i))
            if len(fields) > 1 {
                return get_unchecked(fields, 1)
            }
            return String_new()
        }
        i = i + 1
    }
    String_new()
}

fn emit_variant_input_conversion(
    w: WasmWriter,
    type_name: String,
    value_type: i32,
    variant_local: i32,
    canonical_idx: i32,
    loop_local: i32,
    ctx: SelfEmitCtx,
    mir: MirModule
) {
    let kind = p2_type_kind(clone(type_name), value_type, mir)
    if kind == p2_kind_option() {
        emit_option_input_conversion(w, clone(type_name), variant_local, canonical_idx, loop_local, ctx, mir)
        return
    }
    if kind == p2_kind_result() {
        emit_result_input_conversion(w, clone(type_name), variant_local, canonical_idx, loop_local, ctx, mir)
        return
    }
    emit_enum_input_conversion(w, clone(type_name), variant_local, canonical_idx, ctx, mir)
}

fn emit_option_input_conversion(
    w: WasmWriter,
    type_name: String,
    variant_local: i32,
    canonical_idx: i32,
    loop_local: i32,
    ctx: SelfEmitCtx,
    mir: MirModule
) {
    let inner = sections_types_sigs_detail::p2_type_argument(clone(type_name), 0)
    let none_type = p2_variant_type_named(ctx, String_from("Option"), String_from("None"), String_new())
    let payload_field = if sections_types_sigs_detail::p2_is_string_type_name(clone(inner)) {
        String_from("ref0")
    } else if eq(clone(inner), String_from("i64")) || eq(clone(inner), String_from("u64")) {
        String_from("i64")
    } else if eq(clone(inner), String_from("f64")) {
        String_from("f64")
    } else {
        String_from("i32")
    }
    let some_type = p2_variant_type_named(ctx, String_from("Option"), String_from("Some"), clone(payload_field))
    if eq(clone(inner), String_from("bool")) {
        writer_core::emit_local_get(w, canonical_idx)
        helpers_numeric_i32_const::emit_i32_const(w, 0)
        helpers_numeric_i32_compare::emit_i32_eq(w)
        helpers_control::emit_if_empty(w)
        emit_variant_new(w, none_type, 1, String_new(), canonical_idx, variant_local, 0 - 1)
        helpers_control::emit_else(w)
        emit_variant_new_bool(w, some_type, 0, canonical_idx, variant_local)
        helpers_control::emit_end(w)
        return
    }
    writer_core::emit_local_get(w, canonical_idx)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_compare::emit_i32_eq(w)
    helpers_control::emit_if_empty(w)
    emit_variant_new(w, none_type, 1, String_new(), canonical_idx, variant_local, 0 - 1)
    helpers_control::emit_else(w)
    if eq(clone(payload_field), String_from("ref0")) {
        let string_local = variant_local + 1
        emit_string_input_copy(
            w,
            canonical_idx + 1,
            canonical_idx + 2,
            string_local,
            loop_local,
            ctx_gc_type::SelfEmitCtx_string_type(ctx)
        )
        emit_variant_new(w, some_type, 0, clone(payload_field), canonical_idx, variant_local, string_local)
    } else {
        emit_variant_new(w, some_type, 0, clone(payload_field), canonical_idx + 1, variant_local, 0 - 1)
    }
    helpers_control::emit_end(w)
}

fn emit_result_input_conversion(
    w: WasmWriter,
    type_name: String,
    variant_local: i32,
    canonical_idx: i32,
    loop_local: i32,
    ctx: SelfEmitCtx,
    mir: MirModule
) {
    let ok_name = sections_types_sigs_detail::p2_type_argument(clone(type_name), 0)
    let err_name = sections_types_sigs_detail::p2_type_argument(clone(type_name), 1)
    let ok_field = p2_input_payload_field(clone(ok_name))
    let err_field = p2_input_payload_field(clone(err_name))
    let ok_type = p2_variant_type_named(ctx, String_from("Result"), String_from("Ok"), clone(ok_field))
    let err_type = p2_variant_type_named(ctx, String_from("Result"), String_from("Err"), clone(err_field))
    writer_core::emit_local_get(w, canonical_idx)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_compare::emit_i32_eq(w)
    helpers_control::emit_if_empty(w)
    emit_variant_new(w, ok_type, 0, clone(ok_field), canonical_idx + 1, variant_local, 0 - 1)
    helpers_control::emit_else(w)
    if eq(clone(err_field), String_from("ref0")) {
        let string_local = variant_local + 1
        emit_string_input_copy(
            w,
            canonical_idx + 1,
            canonical_idx + 2,
            string_local,
            loop_local,
            ctx_gc_type::SelfEmitCtx_string_type(ctx)
        )
        emit_variant_new(w, err_type, 1, clone(err_field), canonical_idx, variant_local, string_local)
    } else {
        emit_variant_new(w, err_type, 1, clone(err_field), canonical_idx + 1, variant_local, 0 - 1)
    }
    helpers_control::emit_end(w)
}

fn p2_input_payload_field(type_name: String) -> String {
    if sections_types_sigs_detail::p2_is_string_type_name(clone(type_name)) {
        return String_from("ref0")
    }
    if eq(clone(type_name), String_from("i64")) || eq(clone(type_name), String_from("u64")) {
        return String_from("i64")
    }
    if eq(clone(type_name), String_from("f64")) {
        return String_from("f64")
    }
    String_from("i32")
}

fn emit_enum_input_conversion(
    w: WasmWriter,
    type_name: String,
    variant_local: i32,
    canonical_idx: i32,
    ctx: SelfEmitCtx,
    mir: MirModule
) {
    let family = sections_types_sigs_detail::p2_enum_type_name(clone(type_name))
    let count = p2_variant_count(ctx, clone(family))
    if count <= 0 {
        return
    }
    let mut i = 0
    while i < count - 1 {
        writer_core::emit_local_get(w, canonical_idx)
        helpers_numeric_i32_const::emit_i32_const(w, i)
        helpers_numeric_i32_compare::emit_i32_eq(w)
        helpers_control::emit_if_empty(w)
        let type_idx = p2_variant_type_at_ordinal(ctx, clone(family), i)
        let payload = p2_variant_payload_field(ctx, type_idx)
        emit_variant_new(w, type_idx, i, clone(payload), canonical_idx + 1, variant_local, 0 - 1)
        helpers_control::emit_else(w)
        i = i + 1
    }
    let last_type = p2_variant_type_at_ordinal(ctx, clone(family), count - 1)
    let last_payload = p2_variant_payload_field(ctx, last_type)
    emit_variant_new(w, last_type, count - 1, clone(last_payload), canonical_idx + 1, variant_local, 0 - 1)
    let mut close_count = 0
    while close_count < count - 1 {
        helpers_control::emit_end(w)
        close_count = close_count + 1
    }
}

fn emit_variant_new(
    w: WasmWriter,
    type_idx: i32,
    tag: i32,
    payload_field: String,
    payload_local: i32,
    dest_local: i32,
    string_local: i32
) {
    helpers_numeric_i32_const::emit_i32_const(w, tag)
    if len(payload_field) > 0 {
        if eq(clone(payload_field), String_from("ref0")) && string_local >= 0 {
            writer_core::emit_local_get(w, string_local)
        } else {
            writer_core::emit_local_get(w, payload_local)
        }
    }
    writer_gc::emit_gc_struct_new(w, type_idx)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, dest_local)
}

fn emit_variant_new_bool(w: WasmWriter, type_idx: i32, tag: i32, source_local: i32, dest_local: i32) {
    helpers_numeric_i32_const::emit_i32_const(w, tag)
    writer_core::emit_local_get(w, source_local)
    helpers_numeric_i32_const::emit_i32_const(w, 1)
    helpers_numeric_i32_arith::emit_i32_sub(w)
    writer_gc::emit_gc_struct_new(w, type_idx)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, dest_local)
}

fn emit_result_conversion(
    w: WasmWriter,
    f: MirFunction,
    mir: MirModule,
    ctx: SelfEmitCtx,
    raw_result_local: i32,
    payload_ref_local: i32,
    result_ptr_local: i32,
    loop_local: i32,
    aux_local: i32,
    realloc_idx: i32
) {
    let return_name = function_return_view::MirFunction_return_type_name(f)
    let return_type = function_return_view::MirFunction_return_type(f)
    let kind = p2_type_kind(clone(return_name), return_type, mir)
    if kind == p2_kind_scalar() {
        return
    }
    if kind == p2_kind_string() {
        emit_string_result_conversion(
            w,
            raw_result_local,
            result_ptr_local,
            loop_local,
            ctx_gc_type::SelfEmitCtx_string_type(ctx),
            realloc_idx
        )
        return
    }
    if kind == p2_kind_list() {
        emit_list_result_conversion(
            w,
            clone(return_name),
            raw_result_local,
            result_ptr_local,
            loop_local,
            aux_local,
            ctx,
            realloc_idx
        )
        return
    }
    if kind == p2_kind_tuple() || kind == p2_kind_record() {
        emit_struct_result_conversion(
            w,
            clone(return_name),
            raw_result_local,
            result_ptr_local,
            ctx,
            mir,
            realloc_idx
        )
        return
    }
    if kind == p2_kind_enum() &&
    len(sections_types_sigs_detail::p2_enum_payload_sigs(clone(return_name), mir)) == 0 {
        emit_enum_result_value(w, raw_result_local, ctx)
        return
    }
    if return_has_string_payload_name(clone(return_name), mir) {
        emit_string_variant_result_conversion(
            w,
            clone(return_name),
            raw_result_local,
            payload_ref_local,
            result_ptr_local,
            loop_local,
            aux_local,
            ctx,
            mir,
            realloc_idx
        )
        return
    }
    emit_fixed_variant_result_conversion(
        w,
        clone(return_name),
        raw_result_local,
        result_ptr_local,
        aux_local,
        ctx,
        mir,
        realloc_idx
    )
}

fn emit_enum_result_value(w: WasmWriter, raw_result_local: i32, ctx: SelfEmitCtx) {
    writer_core::emit_local_get(w, raw_result_local)
    writer_gc::emit_gc_ref_cast(w, ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    writer_gc::emit_gc_struct_get_i32(w, ctx_gc_type::SelfEmitCtx_enum_open_type(ctx), 0)
}

fn emit_p2_realloc_fixed(
    w: WasmWriter,
    result_ptr_local: i32,
    realloc_idx: i32,
    align: i32,
    size: i32
) {
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_const::emit_i32_const(w, align)
    helpers_numeric_i32_const::emit_i32_const(w, size)
    writer_core::emit_byte(w, opcodes::OP_CALL())
    writer_core::emit_leb128_u(w, realloc_idx)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, result_ptr_local)
}

fn emit_p2_realloc_dynamic(
    w: WasmWriter,
    result_ptr_local: i32,
    realloc_idx: i32,
    align: i32,
    size_local: i32,
    extra_size: i32
) {
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_const::emit_i32_const(w, align)
    writer_core::emit_local_get(w, size_local)
    helpers_numeric_i32_const::emit_i32_const(w, extra_size)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_byte(w, opcodes::OP_CALL())
    writer_core::emit_leb128_u(w, realloc_idx)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, result_ptr_local)
}

fn emit_p2_pointer_offset(w: WasmWriter, pointer_local: i32, offset: i32) {
    writer_core::emit_local_get(w, pointer_local)
    if offset > 0 {
        helpers_numeric_i32_const::emit_i32_const(w, offset)
        helpers_numeric_i32_arith::emit_i32_add(w)
    }
}

fn emit_p2_scalar_store(w: WasmWriter, field_sig: String, is_bool: bool) {
    if is_bool {
        helpers_memory::emit_i32_store8_default(w)
        return
    }
    if eq(clone(field_sig), String_from("i64")) {
        writer_core::emit_byte(w, opcodes::OP_I64_STORE())
        writer_core::emit_byte(w, 3)
        writer_core::emit_byte(w, 0)
        return
    }
    if eq(clone(field_sig), String_from("f64")) {
        writer_core::emit_byte(w, opcodes::OP_F64_STORE())
        writer_core::emit_byte(w, 3)
        writer_core::emit_byte(w, 0)
        return
    }
    if eq(clone(field_sig), String_from("f32")) {
        writer_core::emit_byte(w, opcodes::OP_F32_STORE())
        writer_core::emit_byte(w, 2)
        writer_core::emit_byte(w, 0)
        return
    }
    helpers_memory::emit_i32_store_default(w)
}

fn emit_struct_result_conversion(
    w: WasmWriter,
    type_name: String,
    raw_result_local: i32,
    result_ptr_local: i32,
    ctx: SelfEmitCtx,
    mir: MirModule,
    realloc_idx: i32
) {
    let fields = p2_struct_fields(ctx, clone(type_name), mir)
    let struct_type = p2_struct_type(ctx, clone(type_name), mir)
    let mut size = 0
    let mut align = 4
    let mut fi = 0
    while fi < len(fields) {
        let field_width = p2_field_width(get_unchecked(fields, fi))
        if field_width == 8 && size % 8 != 0 {
            size = size + (8 - size % 8)
        }
        if field_width == 8 {
            align = 8
        }
        size = size + field_width
        fi = fi + 1
    }
    if size == 0 {
        size = 4
    }
    emit_p2_realloc_fixed(w, result_ptr_local, realloc_idx, align, size)
    let mut offset = 0
    fi = 0
    while fi < len(fields) {
        let field = get_unchecked(fields, fi)
        let width = p2_field_width(clone(field))
        if width == 8 && offset % 8 != 0 {
            offset = offset + (8 - offset % 8)
        }
        emit_p2_pointer_offset(w, result_ptr_local, offset)
        writer_core::emit_local_get(w, raw_result_local)
        writer_gc::emit_gc_ref_cast(w, struct_type)
        if eq(clone(field), String_from("i64")) || eq(clone(field), String_from("f64")) ||
        eq(clone(field), String_from("f32")) {
            writer_gc::emit_gc_struct_get(w, struct_type, fi)
        } else {
            writer_gc::emit_gc_struct_get_i32(w, struct_type, fi)
        }
        emit_p2_scalar_store(w, clone(field), false)
        offset = offset + width
        fi = fi + 1
    }
    writer_core::emit_local_get(w, result_ptr_local)
}

fn emit_list_result_conversion(
    w: WasmWriter,
    type_name: String,
    raw_result_local: i32,
    result_ptr_local: i32,
    loop_local: i32,
    length_local: i32,
    ctx: SelfEmitCtx,
    realloc_idx: i32
) {
    let vec_type = p2_vec_type(ctx, clone(type_name))
    let array_type = p2_vec_array_type(ctx, clone(type_name))
    writer_core::emit_local_get(w, raw_result_local)
    writer_gc::emit_gc_ref_cast(w, vec_type)
    writer_gc::emit_gc_struct_get_i32(w, vec_type, 1)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, length_local)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_const::emit_i32_const(w, 4)
    writer_core::emit_local_get(w, length_local)
    helpers_numeric_i32_const::emit_i32_const(w, 4)
    helpers_numeric_i32_arith::emit_i32_mul(w)
    helpers_numeric_i32_const::emit_i32_const(w, 8)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_byte(w, opcodes::OP_CALL())
    writer_core::emit_leb128_u(w, realloc_idx)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, result_ptr_local)
    emit_p2_pointer_offset(w, result_ptr_local, 0)
    emit_p2_pointer_offset(w, result_ptr_local, 8)
    helpers_memory::emit_i32_store_default(w)
    emit_p2_pointer_offset(w, result_ptr_local, 4)
    writer_core::emit_local_get(w, length_local)
    helpers_memory::emit_i32_store_default(w)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, loop_local)
    helpers_control::emit_block_loop_header(w)
    writer_core::emit_local_get(w, loop_local)
    writer_core::emit_local_get(w, length_local)
    helpers_numeric_i32_compare::emit_i32_ge_u(w)
    helpers_control::emit_br_if(w, 1)
    emit_p2_pointer_offset(w, result_ptr_local, 8)
    writer_core::emit_local_get(w, loop_local)
    helpers_numeric_i32_const::emit_i32_const(w, 4)
    helpers_numeric_i32_arith::emit_i32_mul(w)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_local_get(w, raw_result_local)
    writer_gc::emit_gc_ref_cast(w, vec_type)
    writer_gc::emit_gc_struct_get(w, vec_type, 0)
    writer_core::emit_local_get(w, loop_local)
    writer_gc::emit_gc_array_get_i32(w, array_type)
    helpers_memory::emit_i32_store_default(w)
    writer_core::emit_local_get(w, loop_local)
    helpers_numeric_i32_const::emit_i32_const(w, 1)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, loop_local)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_block_loop_footer(w)
    writer_core::emit_local_get(w, result_ptr_local)
}

fn p2_payload_kind(type_name: String) -> i32 {
    if sections_types_sigs_detail::p2_is_string_type_name(clone(type_name)) {
        return 1
    }
    if eq(clone(type_name), String_from("bool")) {
        return 2
    }
    if eq(clone(type_name), String_from("i64")) || eq(clone(type_name), String_from("u64")) {
        return 3
    }
    if eq(clone(type_name), String_from("f64")) {
        return 4
    }
    if eq(clone(type_name), String_from("f32")) {
        return 5
    }
    6
}

fn p2_variant_output_payload_name(type_name: String, mir: MirModule) -> String {
    if sections_types_sigs_detail::p2_is_option_type_name(clone(type_name)) {
        return sections_types_sigs_detail::p2_type_argument(clone(type_name), 0)
    }
    if sections_types_sigs_detail::p2_is_result_type_name(clone(type_name)) {
        let ok = sections_types_sigs_detail::p2_type_argument(clone(type_name), 0)
        let err = sections_types_sigs_detail::p2_type_argument(clone(type_name), 1)
        if sections_types_sigs_detail::p2_is_string_type_name(clone(ok)) ||
        sections_types_sigs_detail::p2_is_string_type_name(clone(err)) {
            return String_from("String")
        }
        if eq(clone(ok), String_from("f64")) || eq(clone(err), String_from("f64")) {
            return String_from("f64")
        }
        if eq(clone(ok), String_from("i64")) || eq(clone(err), String_from("i64")) {
            return String_from("i64")
        }
        if eq(clone(ok), String_from("bool")) && eq(clone(err), String_from("bool")) {
            return String_from("bool")
        }
        return String_from("i32")
    }
    let payload = sections_types_sigs_detail::p2_enum_payload_sigs(clone(type_name), mir)
    if len(payload) == 0 {
        return String_new()
    }
    let field = get_unchecked(payload, 0)
    if eq(clone(field), String_from("ref0")) {
        return String_from("String")
    }
    field
}

fn p2_variant_result_size(payload_kind: i32) -> i32 {
    if payload_kind == 1 {
        return 12
    }
    if payload_kind == 2 {
        return 2
    }
    if payload_kind == 3 || payload_kind == 4 {
        return 16
    }
    8
}

fn p2_variant_result_align(payload_kind: i32) -> i32 {
    if payload_kind == 2 {
        return 1
    }
    if payload_kind == 3 || payload_kind == 4 {
        return 8
    }
    4
}

fn emit_variant_tag_store(
    w: WasmWriter,
    result_ptr_local: i32,
    tag_local: i32,
    invert: bool
) {
    emit_p2_pointer_offset(w, result_ptr_local, 0)
    if invert {
        writer_core::emit_local_get(w, tag_local)
        helpers_numeric_i32_const::emit_i32_const(w, 0)
        helpers_numeric_i32_compare::emit_i32_eq(w)
    } else {
        writer_core::emit_local_get(w, tag_local)
    }
    // All current WIT variants have fewer than 256 cases, so their canonical
    // discriminant is a single byte regardless of the payload alignment.
    helpers_memory::emit_i32_store8_default(w)
}

fn emit_raw_variant_payload_store(
    w: WasmWriter,
    raw_result_local: i32,
    variant_type: i32,
    field_sig: String,
    result_ptr_local: i32,
    offset: i32,
    payload_kind: i32
) {
    emit_p2_pointer_offset(w, result_ptr_local, offset)
    writer_core::emit_local_get(w, raw_result_local)
    writer_gc::emit_gc_ref_cast(w, variant_type)
    if eq(clone(field_sig), String_from("i64")) || eq(clone(field_sig), String_from("f64")) ||
    eq(clone(field_sig), String_from("f32")) {
        writer_gc::emit_gc_struct_get(w, variant_type, 1)
    } else {
        writer_gc::emit_gc_struct_get_i32(w, variant_type, 1)
    }
    emit_p2_scalar_store(w, clone(field_sig), payload_kind == 2)
}

fn emit_string_variant_result_conversion(
    w: WasmWriter,
    type_name: String,
    raw_result_local: i32,
    payload_ref_local: i32,
    result_ptr_local: i32,
    loop_local: i32,
    tag_local: i32,
    ctx: SelfEmitCtx,
    mir: MirModule,
    realloc_idx: i32
) {
    emit_raw_variant_tag(w, raw_result_local, tag_local, ctx)
    let is_option = sections_types_sigs_detail::p2_is_option_type_name(clone(type_name))
    if is_option {
        emit_string_option_result_conversion(
            w,
            raw_result_local,
            payload_ref_local,
            result_ptr_local,
            loop_local,
            tag_local,
            ctx,
            realloc_idx
        )
        return
    }
    let ok_name = sections_types_sigs_detail::p2_type_argument(clone(type_name), 0)
    let err_name = sections_types_sigs_detail::p2_type_argument(clone(type_name), 1)
    let ok_is_string = sections_types_sigs_detail::p2_is_string_type_name(clone(ok_name))
    let err_is_string = sections_types_sigs_detail::p2_is_string_type_name(clone(err_name))
    if ok_is_string && err_is_string {
        writer_core::emit_local_get(w, tag_local)
        helpers_numeric_i32_const::emit_i32_const(w, 0)
        helpers_numeric_i32_compare::emit_i32_eq(w)
        helpers_control::emit_if_empty(w)
        emit_string_variant_payload(
            w,
            raw_result_local,
            payload_ref_local,
            p2_variant_type_named(ctx, String_from("Result"), String_from("Ok"), String_from("ref0")),
            tag_local,
            0,
            result_ptr_local,
            loop_local,
            realloc_idx,
            ctx_gc_type::SelfEmitCtx_string_type(ctx)
        )
        helpers_control::emit_else(w)
        emit_string_variant_payload(
            w,
            raw_result_local,
            payload_ref_local,
            p2_variant_type_named(ctx, String_from("Result"), String_from("Err"), String_from("ref0")),
            tag_local,
            1,
            result_ptr_local,
            loop_local,
            realloc_idx,
            ctx_gc_type::SelfEmitCtx_string_type(ctx)
        )
        helpers_control::emit_end(w)
        writer_core::emit_local_get(w, result_ptr_local)
        return
    }
    let string_tag = if ok_is_string { 0 } else { 1 }
    writer_core::emit_local_get(w, tag_local)
    helpers_numeric_i32_const::emit_i32_const(w, string_tag)
    helpers_numeric_i32_compare::emit_i32_eq(w)
    helpers_control::emit_if_empty(w)
    let string_variant = if ok_is_string { String_from("Ok") } else { String_from("Err") }
    emit_string_variant_payload(
        w,
        raw_result_local,
        payload_ref_local,
        p2_variant_type_named(ctx, String_from("Result"), string_variant, String_from("ref0")),
        tag_local,
        string_tag,
        result_ptr_local,
        loop_local,
        realloc_idx,
        ctx_gc_type::SelfEmitCtx_string_type(ctx)
    )
    helpers_control::emit_else(w)
    let scalar_name = if ok_is_string { clone(err_name) } else { clone(ok_name) }
    let scalar_variant = if ok_is_string { String_from("Err") } else { String_from("Ok") }
    let scalar_type = p2_variant_type_named(
        ctx,
        String_from("Result"),
        scalar_variant,
        p2_input_payload_field(clone(scalar_name))
    )
    let scalar_kind = p2_payload_kind(clone(scalar_name))
    emit_p2_realloc_fixed(w, result_ptr_local, realloc_idx, 4, 12)
    emit_variant_tag_store(w, result_ptr_local, tag_local, false)
    emit_raw_variant_payload_store(
        w,
        raw_result_local,
        scalar_type,
        p2_variant_payload_field(ctx, scalar_type),
        result_ptr_local,
        4,
        scalar_kind
    )
    helpers_control::emit_end(w)
    writer_core::emit_local_get(w, result_ptr_local)
}

fn emit_raw_variant_tag(w: WasmWriter, raw_result_local: i32, tag_local: i32, ctx: SelfEmitCtx) {
    writer_core::emit_local_get(w, raw_result_local)
    writer_gc::emit_gc_ref_cast(w, ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    writer_gc::emit_gc_struct_get_i32(w, ctx_gc_type::SelfEmitCtx_enum_open_type(ctx), 0)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, tag_local)
}

fn emit_string_option_result_conversion(
    w: WasmWriter,
    raw_result_local: i32,
    payload_ref_local: i32,
    result_ptr_local: i32,
    loop_local: i32,
    tag_local: i32,
    ctx: SelfEmitCtx,
    realloc_idx: i32
) {
    writer_core::emit_local_get(w, tag_local)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_compare::emit_i32_eq(w)
    helpers_control::emit_if_empty(w)
    emit_string_variant_payload(
        w,
        raw_result_local,
        payload_ref_local,
        p2_variant_type_named(ctx, String_from("Option"), String_from("Some"), String_from("ref0")),
        tag_local,
        1,
        result_ptr_local,
        loop_local,
        realloc_idx,
        ctx_gc_type::SelfEmitCtx_string_type(ctx)
    )
    helpers_control::emit_else(w)
    emit_p2_realloc_fixed(w, result_ptr_local, realloc_idx, 4, 12)
    emit_variant_tag_store(w, result_ptr_local, tag_local, true)
    helpers_control::emit_end(w)
    writer_core::emit_local_get(w, result_ptr_local)
}

fn emit_string_variant_payload(
    w: WasmWriter,
    raw_result_local: i32,
    payload_ref_local: i32,
    variant_type: i32,
    tag_local: i32,
    canonical_tag: i32,
    result_ptr_local: i32,
    loop_local: i32,
    realloc_idx: i32,
    string_type: i32
) {
    writer_core::emit_local_get(w, raw_result_local)
    writer_gc::emit_gc_ref_cast(w, variant_type)
    writer_gc::emit_gc_struct_get(w, variant_type, 1)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, payload_ref_local)
    writer_core::emit_local_get(w, payload_ref_local)
    writer_gc::emit_gc_array_len(w)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, loop_local)
    emit_p2_realloc_dynamic(w, result_ptr_local, realloc_idx, 4, loop_local, 12)
    emit_p2_pointer_offset(w, result_ptr_local, 0)
    helpers_numeric_i32_const::emit_i32_const(w, canonical_tag)
    helpers_memory::emit_i32_store8_default(w)
    emit_p2_pointer_offset(w, result_ptr_local, 4)
    emit_p2_pointer_offset(w, result_ptr_local, 12)
    helpers_memory::emit_i32_store_default(w)
    emit_p2_pointer_offset(w, result_ptr_local, 8)
    writer_core::emit_local_get(w, loop_local)
    helpers_memory::emit_i32_store_default(w)
    emit_string_variant_bytes(w, result_ptr_local, loop_local, payload_ref_local, string_type)
}

fn emit_string_variant_bytes(
    w: WasmWriter,
    result_ptr_local: i32,
    loop_local: i32,
    source_array_local: i32,
    string_type: i32
) {
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, loop_local)
    helpers_control::emit_block_loop_header(w)
    writer_core::emit_local_get(w, loop_local)
    emit_p2_pointer_offset(w, result_ptr_local, 8)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32_compare::emit_i32_ge_u(w)
    helpers_control::emit_br_if(w, 1)
    emit_p2_pointer_offset(w, result_ptr_local, 12)
    writer_core::emit_local_get(w, loop_local)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_local_get(w, source_array_local)
    writer_core::emit_local_get(w, loop_local)
    writer_gc::emit_gc_array_get_u(w, string_type)
    helpers_memory::emit_i32_store8_default(w)
    writer_core::emit_local_get(w, loop_local)
    helpers_numeric_i32_const::emit_i32_const(w, 1)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, loop_local)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_block_loop_footer(w)
}

fn emit_fixed_variant_result_conversion(
    w: WasmWriter,
    type_name: String,
    raw_result_local: i32,
    result_ptr_local: i32,
    tag_local: i32,
    ctx: SelfEmitCtx,
    mir: MirModule,
    realloc_idx: i32
) {
    let payload_name = p2_variant_output_payload_name(clone(type_name), mir)
    let payload_kind = p2_payload_kind(clone(payload_name))
    let size = p2_variant_result_size(payload_kind)
    let align = p2_variant_result_align(payload_kind)
    writer_core::emit_local_get(w, raw_result_local)
    writer_gc::emit_gc_ref_cast(w, ctx_gc_type::SelfEmitCtx_enum_open_type(ctx))
    writer_gc::emit_gc_struct_get_i32(w, ctx_gc_type::SelfEmitCtx_enum_open_type(ctx), 0)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, tag_local)
    emit_p2_realloc_fixed(w, result_ptr_local, realloc_idx, align, size)
    let is_option = sections_types_sigs_detail::p2_is_option_type_name(clone(type_name))
    emit_variant_tag_store(w, result_ptr_local, tag_local, is_option)
    let payload_offset = if payload_kind == 2 { 1 } else if payload_kind == 3 || payload_kind == 4 { 8 } else { 4 }
    if is_option {
        writer_core::emit_local_get(w, tag_local)
        helpers_numeric_i32_const::emit_i32_const(w, 0)
        helpers_numeric_i32_compare::emit_i32_eq(w)
        helpers_control::emit_if_empty(w)
        let some_type = p2_variant_type_named(
            ctx,
            String_from("Option"),
            String_from("Some"),
            p2_input_payload_field(clone(payload_name))
        )
        emit_raw_variant_payload_store(
            w,
            raw_result_local,
            some_type,
            p2_variant_payload_field(ctx, some_type),
            result_ptr_local,
            payload_offset,
            payload_kind
        )
        helpers_control::emit_end(w)
        writer_core::emit_local_get(w, result_ptr_local)
        return
    }
    let kind = p2_type_kind(clone(type_name), 5, mir)
    if kind == p2_kind_result() {
        writer_core::emit_local_get(w, tag_local)
        helpers_numeric_i32_const::emit_i32_const(w, 0)
        helpers_numeric_i32_compare::emit_i32_eq(w)
        helpers_control::emit_if_empty(w)
        let ok_type = p2_variant_type_named(
            ctx,
            String_from("Result"),
            String_from("Ok"),
            p2_input_payload_field(sections_types_sigs_detail::p2_type_argument(clone(type_name), 0))
        )
        emit_raw_variant_payload_store(
            w,
            raw_result_local,
            ok_type,
            p2_variant_payload_field(ctx, ok_type),
            result_ptr_local,
            payload_offset,
            payload_kind
        )
        helpers_control::emit_else(w)
        let err_type = p2_variant_type_named(
            ctx,
            String_from("Result"),
            String_from("Err"),
            p2_input_payload_field(sections_types_sigs_detail::p2_type_argument(clone(type_name), 1))
        )
        emit_raw_variant_payload_store(
            w,
            raw_result_local,
            err_type,
            p2_variant_payload_field(ctx, err_type),
            result_ptr_local,
            payload_offset,
            payload_kind
        )
        helpers_control::emit_end(w)
        writer_core::emit_local_get(w, result_ptr_local)
        return
    }
    let family = sections_types_sigs_detail::p2_enum_type_name(clone(type_name))
    let count = p2_variant_count(ctx, clone(family))
    if count > 1 {
        writer_core::emit_local_get(w, tag_local)
        helpers_numeric_i32_const::emit_i32_const(w, 0)
        helpers_numeric_i32_compare::emit_i32_eq(w)
        helpers_control::emit_if_empty(w)
        emit_raw_variant_payload_store(
            w,
            raw_result_local,
            p2_variant_type_at_ordinal(ctx, clone(family), 0),
            p2_variant_payload_field(ctx, p2_variant_type_at_ordinal(ctx, clone(family), 0)),
            result_ptr_local,
            payload_offset,
            payload_kind
        )
        helpers_control::emit_else(w)
        emit_raw_variant_payload_store(
            w,
            raw_result_local,
            p2_variant_type_at_ordinal(ctx, clone(family), 1),
            p2_variant_payload_field(ctx, p2_variant_type_at_ordinal(ctx, clone(family), 1)),
            result_ptr_local,
            payload_offset,
            payload_kind
        )
        helpers_control::emit_end(w)
    }
    writer_core::emit_local_get(w, result_ptr_local)
}

fn emit_string_input_copy(
    w: WasmWriter,
    pointer_local: i32,
    length_local: i32,
    string_local: i32,
    loop_local: i32,
    string_type: i32
) {
    writer_core::emit_local_get(w, length_local)
    writer_gc::emit_gc_array_new(w, string_type)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, string_local)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, loop_local)
    helpers_control::emit_block_loop_header(w)
    writer_core::emit_local_get(w, loop_local)
    writer_core::emit_local_get(w, length_local)
    helpers_numeric_i32_compare::emit_i32_ge_u(w)
    helpers_control::emit_br_if(w, 1)
    writer_core::emit_local_get(w, string_local)
    writer_core::emit_local_get(w, loop_local)
    writer_core::emit_local_get(w, pointer_local)
    writer_core::emit_local_get(w, loop_local)
    helpers_numeric_i32_arith::emit_i32_add(w)
    helpers_memory::emit_i32_load8_u_default(w)
    writer_gc::emit_gc_array_set_i32(w, string_type)
    writer_core::emit_local_get(w, loop_local)
    helpers_numeric_i32_const::emit_i32_const(w, 1)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, loop_local)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_block_loop_footer(w)
}

fn emit_raw_function_call(
    w: WasmWriter,
    f: MirFunction,
    function_idx: i32,
    canonical_param_count: i32,
    mir: MirModule,
    ctx: SelfEmitCtx,
    wit_import_count: i32
) {
    let param_count = function_param_view::MirFunction_param_count(f)
    let mut canonical_idx = 0
    let mut pi = 0
    while pi < param_count {
        let param = function_param_view::MirFunction_param_at(f, pi)
        let type_name = local_access::MirLocal_type_name(param)
        let kind = p2_type_kind(clone(type_name), local_access::MirLocal_val_type(param), mir)
        if kind == p2_kind_scalar() {
            writer_core::emit_local_get(w, canonical_idx)
            canonical_idx = canonical_idx + 1
        } else {
            let ref_local = canonical_param_count + param_ref_offset(f, pi, ctx, mir)
            writer_core::emit_local_get(w, ref_local)
            canonical_idx = canonical_idx + sections_types_sigs_detail::p2_canonical_param_count_for_type(
                clone(type_name),
                local_access::MirLocal_val_type(param),
                mir
            )
        }
        pi = pi + 1
    }
    writer_core::emit_byte(w, opcodes::OP_CALL())
    writer_core::emit_leb128_u(
        w,
        function_indices::defined_function_index(
            function_idx,
            ctx_record::SelfEmitCtx_target(ctx),
            ctx_record::SelfEmitCtx_wasi_version(ctx),
            wit_import_count
        )
    )
}

fn emit_string_result_conversion(
    w: WasmWriter,
    result_array_local: i32,
    result_ptr_local: i32,
    loop_local: i32,
    string_type: i32,
    realloc_idx: i32
) {
    writer_core::emit_local_get(w, result_array_local)
    writer_gc::emit_gc_array_len(w)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, loop_local)
    emit_string_result_alloc(w, result_ptr_local, loop_local, realloc_idx)
    emit_string_result_header(w, result_ptr_local, loop_local)
    emit_string_result_bytes(w, result_ptr_local, loop_local, result_array_local, string_type)
    writer_core::emit_local_get(w, result_ptr_local)
}

fn emit_string_result_alloc(w: WasmWriter, result_ptr_local: i32, length_local: i32, realloc_idx: i32) {
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    helpers_numeric_i32_const::emit_i32_const(w, 4)
    writer_core::emit_local_get(w, length_local)
    helpers_numeric_i32_const::emit_i32_const(w, 8)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_byte(w, opcodes::OP_CALL())
    writer_core::emit_leb128_u(w, realloc_idx)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, result_ptr_local)
}

fn emit_string_result_header(w: WasmWriter, result_ptr_local: i32, length_local: i32) {
    writer_core::emit_local_get(w, result_ptr_local)
    writer_core::emit_local_get(w, result_ptr_local)
    helpers_numeric_i32_const::emit_i32_const(w, 8)
    helpers_numeric_i32_arith::emit_i32_add(w)
    helpers_memory::emit_i32_store_default(w)
    writer_core::emit_local_get(w, result_ptr_local)
    helpers_numeric_i32_const::emit_i32_const(w, 4)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_local_get(w, length_local)
    helpers_memory::emit_i32_store_default(w)
}

fn emit_string_result_bytes(
    w: WasmWriter,
    result_ptr_local: i32,
    length_local: i32,
    result_array_local: i32,
    string_type: i32
) {
    helpers_numeric_i32_const::emit_i32_const(w, 0)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, length_local)
    helpers_control::emit_block_loop_header(w)
    writer_core::emit_local_get(w, length_local)
    writer_core::emit_local_get(w, result_ptr_local)
    helpers_numeric_i32_const::emit_i32_const(w, 4)
    helpers_numeric_i32_arith::emit_i32_add(w)
    helpers_memory::emit_i32_load_default(w)
    helpers_numeric_i32_compare::emit_i32_ge_u(w)
    helpers_control::emit_br_if(w, 1)
    writer_core::emit_local_get(w, result_ptr_local)
    helpers_numeric_i32_const::emit_i32_const(w, 8)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_local_get(w, length_local)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_local_get(w, result_array_local)
    writer_core::emit_local_get(w, length_local)
    writer_gc::emit_gc_array_get_u(w, string_type)
    helpers_memory::emit_i32_store8_default(w)
    writer_core::emit_local_get(w, length_local)
    helpers_numeric_i32_const::emit_i32_const(w, 1)
    helpers_numeric_i32_arith::emit_i32_add(w)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, length_local)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_block_loop_footer(w)
}
