use std::host::process
use std::host::stdio
use std::prelude::{clone, eq}
use wasm::constants
use mir::module_strings
struct EmitStringTablePlan {
    string_offsets: Vec<i32>,
    string_values: Vec<String>,
    data_offset: i32,
    true_idx: i32,
    false_idx: i32,
}

struct EmitStringBoolLiteralPlan {
    data_offset: i32,
    true_idx: i32,
    false_idx: i32,
    assert_idx: i32,
}

fn EmitStringTablePlan_offsets(plan: EmitStringTablePlan) -> Vec<i32> {
    plan.string_offsets
}

fn EmitStringTablePlan_values(plan: EmitStringTablePlan) -> Vec<String> {
    plan.string_values
}

fn EmitStringTablePlan_data_offset(plan: EmitStringTablePlan) -> i32 {
    plan.data_offset
}

fn EmitStringTablePlan_true_idx(plan: EmitStringTablePlan) -> i32 {
    plan.true_idx
}

fn EmitStringTablePlan_false_idx(plan: EmitStringTablePlan) -> i32 {
    plan.false_idx
}

fn prepare_string_table(mut mir: MirModule) -> EmitStringTablePlan {
    let str_count = module_strings::MirModule_string_constant_count(mir)
    let mut string_offsets = Vec::new<i32>()
    let mut data_offset = emit_string_layout_existing_constants(mir, str_count, string_offsets)
    let bool_plan = emit_string_layout_ensure_bool_literals(mir, str_count, string_offsets, data_offset)
    data_offset = EmitStringBoolLiteralPlan_data_offset(bool_plan)
    let true_idx = EmitStringBoolLiteralPlan_true_idx(bool_plan)
    let false_idx = EmitStringBoolLiteralPlan_false_idx(bool_plan)
    let string_values = module_strings::MirModule_string_constants(mir)
    EmitStringTablePlan { string_offsets: string_offsets, string_values: string_values, data_offset: data_offset, true_idx: true_idx, false_idx: false_idx }
}

fn emit_string_layout_existing_constants(mir: MirModule, str_count: i32, mut string_offsets: Vec<i32>) -> i32 {
    let mut si = 0
    while si < str_count {
        let s = module_strings::MirModule_string_constant_at(mir, si)
        let slen = len(s)
        // #913: negative-length constants are producer-side corruption; see
        // module_strings::assert_string_constant_sane. Trap before offsets
        // and the emitted payload can diverge.
        if slen < 0 {
            stdio::eprintln("compiler ICE: negative string length in string table layout")
            process::exit(1)
        }
        // #851 Phase 3: offsets are final at intern (append-only packed
        // layout); the module-maintained rel table is the single source so
        // in-loop emit can resolve string operands before the plan exists.
        push(string_offsets, constants::DATA_START() + module_strings::MirModule_string_data_rel_at(mir, si))
        si = si + 1
    }
    constants::DATA_START() + module_strings::MirModule_string_data_next(mir)
}

fn EmitStringBoolLiteralPlan_new(data_offset: i32, true_idx: i32, false_idx: i32, assert_idx: i32) -> EmitStringBoolLiteralPlan {
    EmitStringBoolLiteralPlan { data_offset: data_offset, true_idx: true_idx, false_idx: false_idx, assert_idx: assert_idx }
}

fn EmitStringBoolLiteralPlan_data_offset(plan: EmitStringBoolLiteralPlan) -> i32 {
    plan.data_offset
}

fn EmitStringBoolLiteralPlan_true_idx(plan: EmitStringBoolLiteralPlan) -> i32 {
    plan.true_idx
}

fn EmitStringBoolLiteralPlan_false_idx(plan: EmitStringBoolLiteralPlan) -> i32 {
    plan.false_idx
}

fn EmitStringBoolLiteralPlan_assert_idx(plan: EmitStringBoolLiteralPlan) -> i32 {
    plan.assert_idx
}

fn emit_string_layout_ensure_bool_literals(mut mir: MirModule, str_count: i32, mut string_offsets: Vec<i32>, initial_data_offset: i32) -> EmitStringBoolLiteralPlan {
    let scan_plan = scan_string_layout_bool_literals(mir, str_count, initial_data_offset)
    append_missing_string_layout_bool_literals(mir, string_offsets, scan_plan)
}

fn scan_string_layout_bool_literals(mir: MirModule, str_count: i32, data_offset: i32) -> EmitStringBoolLiteralPlan {
    let mut true_idx = 0 - 1
    let mut false_idx = 0 - 1
    let mut assert_idx = 0 - 1
    let mut bi = 0
    while bi < str_count {
        let bs = module_strings::MirModule_string_constant_at(mir, bi)
        if eq(clone(bs), "true") {
            true_idx = bi
        }
        if eq(clone(bs), "false") {
            false_idx = bi
        }
        if eq(clone(bs), "assertion failed") {
            assert_idx = bi
        }
        bi = bi + 1
    }
    EmitStringBoolLiteralPlan_new(data_offset, true_idx, false_idx, assert_idx)
}

fn append_missing_string_layout_bool_literals(mut mir: MirModule, mut string_offsets: Vec<i32>, plan: EmitStringBoolLiteralPlan) -> EmitStringBoolLiteralPlan {
    let mut data_offset = EmitStringBoolLiteralPlan_data_offset(plan)
    let mut true_idx = EmitStringBoolLiteralPlan_true_idx(plan)
    let mut false_idx = EmitStringBoolLiteralPlan_false_idx(plan)
    let mut assert_idx = EmitStringBoolLiteralPlan_assert_idx(plan)
    if true_idx < 0 {
        true_idx = module_strings::MirModule_string_constant_count(mir)
        module_strings::MirModule_push_string_constant(mir, "true")
        push(string_offsets, constants::DATA_START() + module_strings::MirModule_string_data_rel_at(mir, true_idx))
        data_offset = constants::DATA_START() + module_strings::MirModule_string_data_next(mir)
    }
    if false_idx < 0 {
        false_idx = module_strings::MirModule_string_constant_count(mir)
        module_strings::MirModule_push_string_constant(mir, "false")
        push(string_offsets, constants::DATA_START() + module_strings::MirModule_string_data_rel_at(mir, false_idx))
        data_offset = constants::DATA_START() + module_strings::MirModule_string_data_next(mir)
    }
    if assert_idx < 0 {
        assert_idx = module_strings::MirModule_string_constant_count(mir)
        module_strings::MirModule_push_string_constant(mir, "assertion failed")
        push(string_offsets, constants::DATA_START() + module_strings::MirModule_string_data_rel_at(mir, assert_idx))
        data_offset = constants::DATA_START() + module_strings::MirModule_string_data_next(mir)
    }
    EmitStringBoolLiteralPlan_new(data_offset, true_idx, false_idx, assert_idx)
}
