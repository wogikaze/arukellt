use corehir::signature_registry
use mir::function_identity
use wasm::ctx_record
use collections::name_index

// Build same-name chains once. The registry can contain duplicate short names
// and synthetic aliases, so a plain NameIndex lookup is not enough; consuming
// one chain entry per MIR declaration preserves the old ordinal rule without
// rescanning either collection for every function.
fn ctx_fid_map_build_registry_chains(
    registry: SignatureRegistry,
    registry_heads: NameIndex,
    registry_tails: NameIndex,
    registry_next: Vec<i32>
) {
    let registry_count = signature_registry::signature_registry_entry_count(registry)
    let mut raw = 0
    while raw < registry_count {
        push(registry_next, 0 - 1)
        let name = signature_registry::signature_registry_mangled_at(registry, raw)
        let tail = name_index::name_index_get(registry_tails, clone(name))
        if tail < 0 {
            name_index::name_index_insert_first(registry_heads, clone(name), raw)
        } else {
            set(registry_next, tail, raw)
        }
        name_index::name_index_set(registry_tails, name, raw)
        raw = raw + 1
    }
}

fn SelfEmitCtx_build_fid_to_mir(ctx: SelfEmitCtx) {
    let registry = ctx_record::SelfEmitCtx_signature_registry(ctx)
    let registry_count = signature_registry::signature_registry_entry_count(registry)
    let fid_to_mir = Vec::new<i32>()
    let mut si = 0
    while si < registry_count {
        push(fid_to_mir, 0 - 1)
        si = si + 1
    }
    let registry_heads = name_index::NameIndex_new(registry_count)
    let registry_tails = name_index::NameIndex_new(registry_count)
    let registry_next = Vec::new<i32>()
    ctx_fid_map_build_registry_chains(registry, registry_heads, registry_tails, registry_next)
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    let fn_count = len(functions)
    let mut fi = 0
    while fi < fn_count {
        let fname = function_identity::MirFunction_name(get_unchecked(functions, fi))
        let raw = name_index::name_index_get(registry_heads, clone(fname))
        if raw >= 0 {
            if get_unchecked(fid_to_mir, raw) < 0 {
                set(fid_to_mir, raw, fi)
            }
            name_index::name_index_set(
                registry_heads,
                fname,
                get_unchecked(registry_next, raw)
            )
        }
        fi = fi + 1
    }
    ctx_record::SelfEmitCtx_set_fid_to_mir(ctx, fid_to_mir)
}
