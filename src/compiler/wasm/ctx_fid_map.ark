use corehir::function_id
use corehir::signature_registry
use mir::function_identity
use wasm::ctx_record

// Same bind rule as mir_reachability_index_bind_fid: first MirFunction wins.
// Nested set-in-if is avoided so the wasm32 flatten stays a statement.

fn ctx_fid_map_bind(fid_to_mir: Vec<i32>, registry: SignatureRegistry, fname: String, fi: i32) {
    let fid = signature_registry::signature_registry_lookup_by_mangled(registry, fname)
    if !function_id::function_id_is_valid(fid) {
        return
    }
    let raw = function_id::FunctionId_raw(fid)
    if raw < 0 || raw >= len(fid_to_mir) {
        return
    }
    if get_unchecked(fid_to_mir, raw) >= 0 {
        return
    }
    set(fid_to_mir, raw, fi)
}

fn SelfEmitCtx_build_fid_to_mir(ctx: SelfEmitCtx) {
    let registry = ctx_record::SelfEmitCtx_signature_registry(ctx)
    let registry_count = signature_registry::signature_registry_entry_count(registry)
    let fid_to_mir = Vec::new<i32>()
    let mut si = 0
    while si < registry_count {
        push(fid_to_mir, 0 - 1)
        si = si + 1
    }
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    let fn_count = len(functions)
    let mut fi = 0
    while fi < fn_count {
        let fname = function_identity::MirFunction_name(get_unchecked(functions, fi))
        ctx_fid_map_bind(fid_to_mir, registry, fname, fi)
        fi = fi + 1
    }
    ctx_record::SelfEmitCtx_set_fid_to_mir(ctx, fid_to_mir)
}
