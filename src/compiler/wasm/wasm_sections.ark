use std::host::clock
use std::host::stdio
use std::prelude::{clone, i64_to_i32, to_string}
use std::text
use wasm::code
use wasm::ctx_gc_type
use wasm::ctx_record
use wasm::emit_target
use wasm::sections_memory
use wasm::wasm_context
use wasm::wasm_start
use wasm::strings
use wasm::wasm_sections_facade
use wasm::gc_layout_table
use wasm::gc_layout_table_build
use wasm::gc_layout_audit
use wasm::emit_rung_census
use wasm::registry_return_audit
use wasm::core_op_shadow
use mir::module_functions
use mir::emit_artifacts
use mir::module_emit_artifacts
use mir::module_canon
use mir::module_wit_imports
use mir::module_gc_struct
use mir::module_gc_enum
use mir::module_spine
use wasm::sections_exports
use wasm::sections_type_plan
use wasm::sections_types
use wasm::sections_types_sigs
fn emit_section_note(enabled: i32, label: String, t_start: i64) -> i64 {
    let t_end = clock::monotonic_now()
    if enabled == 0 {
        return t_end
    }
    let diff = t_end - t_start
    let ms = if diff < 0i64 { 0 } else { i64_to_i32(diff / 1000000i64) }
    stdio::eprintln(
        text::concat(
            "[arukellt] emit.",
            text::concat(clone(label), text::concat(": ", text::concat(to_string(ms), "ms")))
        )
    )
    t_end
}

fn string_literal_cache_global(ctx: SelfEmitCtx, strings: EmitStringTablePlan) -> GcStringLiteralCacheGlobal {
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return sections_memory::gc_string_literal_cache_none()
    }
    sections_memory::gc_string_literal_cache(
        ctx_gc_type::SelfEmitCtx_string_array_type(ctx),
        len(strings::EmitStringTablePlan_offsets(strings))
    )
}

fn emit_wasm_module_sections(
    out: WasmWriter,
    mir: MirModule,
    target: String,
    wasi_version: String,
    opt_level: i32,
    strip_debug: bool,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>,
    source_file: String,
    report_timing: i32
) {
    let mut t_phase = clock::monotonic_now()
    let fn_count = module_functions::MirModule_function_count(mir)
    let functions = module_functions::MirModule_functions(mir)
    let main_idx = wasm_start::wasm_module_start_function_index(mir, fn_count)
    let library_export_count = if emit_target::is_p2_wasi(clone(wasi_version)) {
        sections_exports::p2_library_export_count(mir, fn_count)
    } else {
        0
    }
    let library_wrapper_count = if emit_target::is_p2_wasi(clone(wasi_version)) {
        sections_exports::p2_library_wrapper_count(mir, fn_count, clone(target), clone(wasi_version))
    } else {
        0
    }
    let strings = strings::prepare_string_table(mir)
    t_phase = emit_section_note(report_timing, "strings", t_phase)
    let gc_layout = gc_layout_table::GcLayoutTable_new()
    let needs_wrapper = if emit_target::is_p2_wasi(clone(wasi_version)) {
        if main_idx >= 0 { 1 } else { 0 }
    } else {
        wasm_start::wasm_module_needs_start_wrapper(mir, fn_count)
    }
    let wit_import_count = module_wit_imports::wit_import_count(bindings)
    // SelfEmitCtx is constructed before the type section: every field the
    // ctor and the module-derived setters need is already final here, and
    // the early handle is the anchor in-loop body emit will share (#851
    // Phase 3). Only the type_plan-derived setters stay post-section.
    let mut ctx = wasm_context::emit_wasm_context_new(
        mir,
        functions,
        strings,
        clone(target),
        clone(wasi_version),
        writer_core::writer_memory64(out),
        clone(source_file)
    )
    wasm_context::emit_wasm_context_set_gc_enum_variant_names(ctx, module_gc_enum::MirModule_gc_enum_variant_names(mir))
    wasm_context::emit_wasm_context_set_gc_enum_variant_sigs(ctx, module_gc_enum::MirModule_gc_enum_variant_sigs(mir))
    wasm_context::emit_wasm_context_set_gc_struct_names(ctx, module_gc_struct::MirModule_gc_struct_names(mir))
    wasm_context::emit_wasm_context_set_gc_struct_sigs(ctx, module_gc_struct::MirModule_gc_struct_sigs(mir))
    // GC base indices derive from the module canon table, already sealed
    // by lowering-time registration (#851 Phase 3): gc_type_base is the
    // first GC-prefixed canon sig, the struct/enum bases are each kind's
    // first canon idx. Same values the type_plan computes, without it.
    wasm_context::emit_wasm_context_set_gc_type_base(
        ctx,
        sections_types::first_gc_type_index(module_canon::MirModule_canon_sigs(mir))
    )
    let mut gc_struct_base = 0 - 1
    if module_gc_struct::MirModule_gc_struct_sig_count(mir) > 0 {
        gc_struct_base = get_unchecked(module_gc_struct::MirModule_gc_struct_canon_idxs(mir), 0)
    }
    wasm_context::emit_wasm_context_set_gc_struct_base(ctx, gc_struct_base)
    let mut gc_enum_variant_base = 0 - 1
    if module_gc_enum::MirModule_gc_enum_variant_sig_count(mir) > 0 {
        gc_enum_variant_base = get_unchecked(module_gc_enum::MirModule_gc_enum_variant_canon_idxs(mir), 0)
    }
    wasm_context::emit_wasm_context_set_gc_enum_variant_base(ctx, gc_enum_variant_base)
    wasm_context::emit_wasm_context_finalize_gc_indexes(ctx)
    wasm_context::emit_wasm_context_set_signature_spine(
        ctx,
        module_spine::MirModule_signature_registry(mir),
        module_spine::MirModule_type_table(mir),
        module_spine::MirModule_mono_instance_table(mir),
        module_spine::MirModule_signature_spine_populated(mir)
    )
    // Pair-call sigs depend only on MIR call hints + gc struct names — all
    // final before the type section. Their canon indices resolve lazily via
    // MirModule.canon_index_of, so no parallel type map is stored (#851).
    wasm_context::emit_wasm_context_set_pair_call_sigs(
        ctx,
        sections_types_sigs::pair_call_sigs_for_emit(
            mir,
            functions,
            fn_count,
            clone(target),
            writer_core::writer_memory64(out)
        )
    )
    wasm_context::emit_wasm_context_set_gc_layout_table(ctx, gc_layout)
    // The layout table needs only module data plus the gc base/canon vecs —
    // all final here, so it no longer rides inside emit_type_section.
    if emit_target::is_gc_target(clone(target)) {
        gc_layout_table_build::populate_gc_layout_table_for_emit(
            gc_layout,
            mir,
            ctx_record::SelfEmitCtx_gc_type_base(ctx),
            module_gc_enum::MirModule_gc_enum_variant_canon_idxs(mir),
            module_gc_struct::MirModule_gc_struct_canon_idxs(mir)
        )
    }
    let type_plan = wasm_sections_facade::emit_type_section(
        out,
        mir,
        functions,
        fn_count,
        needs_wrapper,
        clone(target),
        clone(wasi_version),
        bindings
    )
    t_phase = emit_section_note(report_timing, "types", t_phase)
    wasm_sections_facade::emit_import_section(
        out,
        wasm_sections_facade::type_plan_host_type_map(type_plan),
        clone(target),
        clone(wasi_version),
        bindings,
        wasm_sections_facade::type_plan_wit_type_map(type_plan)
    )
    wasm_sections_facade::emit_function_section(
        out,
        fn_count,
        wasm_sections_facade::type_plan_fn_type_map(type_plan),
        needs_wrapper,
        wasm_sections_facade::type_plan_wrapper_type_idx(type_plan),
        wasm_sections_facade::type_plan_p2_post_type_idx(type_plan),
        wasm_sections_facade::type_plan_p2_library_post_type_map(type_plan),
        wasm_sections_facade::type_plan_p2_library_wrapper_type_map(type_plan),
        wasm_sections_facade::type_plan_p2_realloc_type_idx(type_plan),
        wasm_sections_facade::type_plan_p2_initialize_type_idx(type_plan),
        sections_type_plan::TypeSectionPlan_linear_gc_type_map(type_plan)
    )
    wasm_sections_facade::emit_table_section(out, mir)
    wasm_sections_facade::emit_memory_section(
        out,
        clone(target),
        strings::EmitStringTablePlan_data_offset(strings)
    )
    wasm_sections_facade::emit_global_section(
        out,
        strings::EmitStringTablePlan_data_offset(strings),
        string_literal_cache_global(ctx, strings),
        clone(target)
    )
    wasm_sections_facade::emit_export_section(out, mir, fn_count, needs_wrapper, clone(target), clone(wasi_version), wit_import_count)
    wasm_sections_facade::emit_element_section(out, mir, clone(target), clone(wasi_version), wit_import_count)
    t_phase = emit_section_note(report_timing, "pre_code", t_phase)
    // #851 Phase 3 fused emit: when the lowering drain already emitted the
    // declared bodies into the module's artifact record, adopt them so the
    // code section only applies relocs and assembles sized bodies.
    let emit_arts = module_emit_artifacts::MirModule_emit_artifacts(mir)
    if emit_artifacts::MirEmitArtifacts_enabled(emit_arts) {
        code::emit_ctx_adopt_inloop_artifacts(ctx, emit_arts)
    }
    code::emit_code_section(
        out,
        mir,
        functions,
        fn_count,
        needs_wrapper,
        main_idx,
        library_export_count,
        library_wrapper_count,
        if wasm_sections_facade::type_plan_p2_realloc_type_idx(type_plan) >= 0 { 2 } else { 0 },
        ctx,
        bindings,
        report_timing
    )
    t_phase = emit_section_note(report_timing, "code", t_phase)
    let import_count = emit_target::total_import_count(clone(target), clone(wasi_version), wit_import_count)
    wasm_sections_facade::emit_tail_sections(out, ctx, strings, opt_level, import_count, strip_debug, source_file)
    emit_section_note(report_timing, "tail", t_phase)
    registry_return_audit::registry_audit_print_summary(ctx)
    core_op_shadow::core_op_shadow_print_summary(ctx)
    gc_layout_audit::gc_layout_audit_print_summary(ctx)
    // Phase 5.0 ladder census rides the existing --time config gate.
    if report_timing != 0 {
        emit_rung_census::emit_rung_census_print(ctx)
    }
}
