use std::prelude::{clone, eq}
use wasm::inst_accessors_facade
use mir::inst_accessors_operands
use mir::function_identity
use mir::value_types
use wasm::ctx_record
use wasm::ctx_reloc
use wasm::emit_target
use wasm::function_indices
use wasm::inst_const
use wasm::inst_dispatch_result
use wasm::inst_locals
use wasm::inst_store
use wasm::intrinsics::helpers_numeric_i32_const
use wasm::opcodes
use wasm::writer_core
fn try_emit_const_or_get_inst(
    w: WasmWriter,
    inst: MirInst,
    ctx: SelfEmitCtx,
    next_op: i32,
    next_arg0: i32,
    next_arg1: i32,
    next2_op: i32,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>
) -> bool {
    if try_emit_const_literal_inst(w, inst, ctx, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    if try_emit_ref_func_inst(w, inst, ctx, next_op, next_arg0, next_arg1, next2_op, bindings) {
        return true
    }
    if try_emit_local_get_inst(w, inst, ctx, next_op, next_arg0, next_arg1, next2_op) {
        return true
    }
    false
}

fn try_emit_ref_func_inst(
    w: WasmWriter,
    inst: MirInst,
    ctx: SelfEmitCtx,
    next_op: i32,
    next_arg0: i32,
    next_arg1: i32,
    next2_op: i32,
    bindings: Vec<resolver::wit_import_bind::WitImportBinding>
) -> bool {
    if inst_accessors_facade::MirInst_op(inst) != opcodes::MIR_REF_FUNC() {
        return false
    }
    let fn_name = inst_accessors_facade::MirInst_str_val(inst)
    let fn_count = ctx_record::SelfEmitCtx_function_count(ctx)
    let functions = ctx_record::SelfEmitCtx_functions(ctx)
    let mut mir_fn_idx = 0
    let mut found = 0
    let mut i = 0
    while i < fn_count {
        let f = functions.get_unchecked(i)
        if eq(function_identity::MirFunction_name(f), clone(fn_name)) {
            mir_fn_idx = i
            found = 1
        }
        i = i + 1
    }
    let defined_idx = if found == 0 {
        0
    } else {
        let defined_idx = function_indices::defined_function_index(
            mir_fn_idx,
            ctx_record::SelfEmitCtx_target(ctx),
            ctx_record::SelfEmitCtx_wasi_version(ctx),
            bindings.len()
        )
        defined_idx
    }
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        // Typed funcref: emit ref.func with the module function index. Active
        // table elem segments also declare referenced functions (#831/ADR-033).
        writer_core::emit_byte(w, opcodes::OP_REF_FUNC())
        if ctx.in_loop_emitted {
            // In-loop drain emits before reachability compaction: the name
            // scan above ran on the pre-prune vec, so defined_idx would go
            // stale. Defer by name — apply resolves the post-prune index.
            ctx_reloc::SelfEmitCtx_emit_leb_u_reloc(
                w,
                ctx,
                ctx_reloc::RELOC_KIND_REF_FUNC(),
                0,
                0,
                0,
                clone(fn_name),
                String_new()
            )
        } else {
            writer_core::emit_leb128_u(w, defined_idx)
        }
    } else {
        // The linear-memory fallback represents callbacks as table indices.
        // Its call_ref MIR is emitted as call_indirect by call_ref.ark. Table
        // slots use defined-function ordinals; imports are only included in
        // the module function index used by ref.func and element entries.
        helpers_numeric_i32_const::emit_i32_const(w, mir_fn_idx)
    }
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
    true
}

fn emit_const_literal_result(w: WasmWriter, inst: MirInst, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) {
    inst_dispatch_result::emit_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op)
}

fn try_emit_const_literal_inst(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) -> bool {
    let op = inst_accessors_facade::MirInst_op(inst)
    if op == opcodes::MIR_CONST_I32() {
        inst_const::emit_const_i32(w, inst, ctx)
        emit_const_literal_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    if op == opcodes::MIR_CONST_I64() {
        inst_const::emit_const_i64(w, inst, ctx)
        emit_const_literal_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    if op == opcodes::MIR_CONST_F64() {
        if inst_accessors_facade::MirInst_val_type(inst) == value_types::VT_F32() {
            inst_const::emit_const_f32(w, inst, ctx)
        } else {
            inst_const::emit_const_f64(w, inst, ctx)
        }
        emit_const_literal_result(w, inst, next_op, next_arg0, next_arg1, next2_op)
        return true
    }
    if op == opcodes::MIR_CONST_STRING() {
        inst_const::emit_const_string(w, inst, ctx)
        // Both linear and GC targets push the result onto the stack.
        // The store policy (SET/TEE/SKIP) handles storing to dest uniformly.
        inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
        return true
    }
    false
}

fn try_emit_local_get_inst(w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32) -> bool {
    if inst_accessors_facade::MirInst_op(inst) != opcodes::MIR_LOCAL_GET() {
        return false
    }
    if next_op == opcodes::MIR_STRUCT_SET() {
        return true
    }
    // GC_STRUCT_GET reloads its base from arg1.  A preceding LOCAL_GET of the
    // same local is therefore redundant and leaves an extra ref on the stack.
    if next_op == opcodes::MIR_GC_STRUCT_GET() &&
    next_arg1 == inst_accessors_operands::MirInst_arg0(inst) {
        return true
    }
    inst_locals::emit_local_get(w, inst, ctx)
    // Only a stack-valued LOCAL_SET consumes this local.get, so only then is
    // the stored value this one and the destination's ref type authoritative.
    // A local-to-local copy (arg1 >= 0) is lowered with its own source load,
    // so this value is an unrelated operand: casting it retypes e.g. a Vec
    // receiver to the copied String and breaks the call's operand stack.
    if next_op == opcodes::MIR_LOCAL_SET() && next_arg1 < 0 {
        inst_locals::emit_gc_ref_cast_to_dest(w, ctx, next_arg0)
    }
    inst_dispatch_result::emit_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op)
    true
}
