use wasm::ctx_record
use wasm::emit_target

fn SelfEmitCtx_scratch_base(ctx: SelfEmitCtx) -> i32 {
    ctx.scratch_base
}

fn SelfEmitCtx_scratch_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + offset
}

fn SelfEmitCtx_linear_root_frame_local(ctx: SelfEmitCtx) -> i32 {
    // The linear-only cursor follows 12 i32, 3 f64, and 1 i64 scratch local.
    ctx.scratch_base + 16
}

fn SelfEmitCtx_scratch_gc_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    // GC string slots: scratch_base+16 .. +19 (count 4).
    ctx.scratch_base + 16 + offset
}

fn SelfEmitCtx_scratch_gc_i32_array_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 20 + offset
}

fn SelfEmitCtx_scratch_gc_vec_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 22 + offset
}

fn SelfEmitCtx_scratch_gc_string_ref_array_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 23 + offset
}

fn SelfEmitCtx_scratch_gc_hashmap_str_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 25 + offset
}

fn SelfEmitCtx_scratch_gc_enum_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 26 + offset
}

fn SelfEmitCtx_scratch_gc_v128_array_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 27 + offset
}

// Linear frames append the v128 slots after the linear root cursor; GC frames
// keep the original group position.
fn SelfEmitCtx_scratch_v128_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    if !emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return ctx.scratch_base + 17 + offset
    }
    ctx.scratch_base + 29 + offset
}

fn SelfEmitCtx_scratch_gc_i64_array_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 31 + offset
}

fn SelfEmitCtx_scratch_gc_f64_array_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 33 + offset
}

fn SelfEmitCtx_scratch_gc_struct_ref_array_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 35 + offset
}

fn SelfEmitCtx_scratch_gc_struct_ref_val_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 37 + offset
}

fn SelfEmitCtx_scratch_gc_fnref_array_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 38 + offset
}

fn SelfEmitCtx_scratch_gc_fnref_val_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 40 + offset
}

fn SelfEmitCtx_scratch_gc_enum_ref_array_local(ctx: SelfEmitCtx, offset: i32) -> i32 {
    ctx.scratch_base + 41 + offset
}

fn SelfEmitCtx_set_scratch_base(ctx: SelfEmitCtx, scratch_base: i32) {
    ctx.scratch_base = scratch_base
}
