// Self-check for #654 — WIT import Wasm emit wiring.

use resolver::wit_import_bind
fn issue654_assert_wit_emit_sources() -> String {
    let mut bindings = Vec::new<WitImportBinding>()
    bindings.push(WitImportBinding_new("i32_i32_1i32", "test:host/math", "test:host/math", "test:host/math", "add", "host::add"))
    if bindings.len() != 1 {
        return "binding table empty"
    }
    if !wit_import_bind::wit_import_binding_interface_id(get_unchecked(bindings, 0)).eq("test:host/math") {
        return "interface id mismatch"
    }
    if !wit_import_bind::wit_import_binding_component_interface_id(get_unchecked(bindings, 0)).eq("test:host/math") {
        return "component interface id mismatch"
    }
    if !wit_import_bind::wit_import_binding_wit_import_id(get_unchecked(bindings, 0)).eq("test:host/math") {
        return "WIT import id mismatch"
    }
    if !wit_import_bind::wit_import_binding_wit_func_name(get_unchecked(bindings, 0)).eq("add") {
        return "wit func name mismatch"
    }
    String_new()
}
