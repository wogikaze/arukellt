// Self-check for #654 — WIT import Wasm emit wiring.

use resolver::wit_import_bind

fn issue654_assert_wit_emit_sources() -> String {
    let bindings = Vec::new<WitImportBinding>()
    push(bindings, WitImportBinding_new("i32_i32_1i32", "test:host/math", "add", "host::add"))
    if len(bindings) != 1 {
        return "binding table empty"
    }
    if !eq(wit_import_bind::wit_import_binding_interface_id(get_unchecked(bindings, 0)), "test:host/math") {
        return "interface id mismatch"
    }
    if !eq(wit_import_bind::wit_import_binding_wit_func_name(get_unchecked(bindings, 0)), "add") {
        return "wit func name mismatch"
    }
    String_new()
}
