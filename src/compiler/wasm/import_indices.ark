use wasm::constants
use wasm::ctx_record
use wasm::emit_target

fn args_sizes_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_ARGS_SIZES()
    }
    1
}

fn arguments_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_ARGUMENTS()
    }
    2
}

fn path_open_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_OPEN_AT()
    }
    constants::WASI_IMPORT_PATH_OPEN()
}

fn fd_read_import_idx(ctx: SelfEmitCtx) -> i32 {
    // File reads: P2 bridged filesystem.read (P1 fd_read ABI), not stdin (#834).
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_FS_READ()
    }
    constants::WASI_IMPORT_FD_READ()
}

fn fd_write_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_FS_WRITE()
    }
    constants::WASI_IMPORT_FD_WRITE()
}

fn stdin_read_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_STDIN_READ()
    }
    constants::WASI_IMPORT_FD_READ()
}

fn fd_close_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_CLOSE()
    }
    constants::WASI_IMPORT_FD_CLOSE()
}

fn proc_exit_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_EXIT()
    }
    constants::WASI_IMPORT_PROC_EXIT()
}

fn p2_outgoing_import_offset(ctx: SelfEmitCtx) -> i32 {
    constants::NUM_P2_IMPORTS_BASE()
}

fn arukellt_host_import_base(ctx: SelfEmitCtx) -> i32 {
    let wasi_version = ctx_record::SelfEmitCtx_wasi_version(ctx)
    if emit_target::is_p2_wasi(clone(wasi_version)) {
        if ctx_record::SelfEmitCtx_needs_wasi_http_outgoing(ctx) == 1 {
            return p2_outgoing_import_offset(ctx) + constants::NUM_P2_HTTP_OUTGOING_IMPORTS()
        }
        return p2_outgoing_import_offset(ctx)
    }
    constants::NUM_WASI_IMPORTS_BASE()
}

fn http_get_import_idx(ctx: SelfEmitCtx) -> i32 {
    if ctx_record::SelfEmitCtx_needs_arukellt_host(ctx) == 1 {
        return arukellt_host_import_base(ctx)
    }
    constants::WASI_IMPORT_HTTP_GET()
}

fn http_request_import_idx(ctx: SelfEmitCtx) -> i32 {
    if ctx_record::SelfEmitCtx_needs_arukellt_host(ctx) == 1 {
        return arukellt_host_import_base(ctx) + 1
    }
    constants::WASI_IMPORT_HTTP_REQUEST()
}

fn sockets_connect_import_idx(ctx: SelfEmitCtx) -> i32 {
    if ctx_record::SelfEmitCtx_needs_arukellt_host(ctx) == 1 {
        return arukellt_host_import_base(ctx) + 2
    }
    constants::WASI_IMPORT_SOCKETS_CONNECT()
}

fn sockets_read_import_idx(ctx: SelfEmitCtx) -> i32 {
    if ctx_record::SelfEmitCtx_needs_arukellt_host(ctx) == 1 {
        return arukellt_host_import_base(ctx) + 3
    }
    constants::WASI_IMPORT_SOCKETS_READ()
}

fn sockets_write_import_idx(ctx: SelfEmitCtx) -> i32 {
    if ctx_record::SelfEmitCtx_needs_arukellt_host(ctx) == 1 {
        return arukellt_host_import_base(ctx) + 4
    }
    constants::WASI_IMPORT_SOCKETS_WRITE()
}

fn sockets_listen_import_idx(ctx: SelfEmitCtx) -> i32 {
    if ctx_record::SelfEmitCtx_needs_arukellt_host(ctx) == 1 {
        return arukellt_host_import_base(ctx) + 5
    }
    constants::WASI_IMPORT_SOCKETS_LISTEN()
}

fn sockets_accept_import_idx(ctx: SelfEmitCtx) -> i32 {
    if ctx_record::SelfEmitCtx_needs_arukellt_host(ctx) == 1 {
        return arukellt_host_import_base(ctx) + 6
    }
    constants::WASI_IMPORT_SOCKETS_ACCEPT()
}

fn http_serve_import_idx(ctx: SelfEmitCtx) -> i32 {
    if ctx_record::SelfEmitCtx_needs_arukellt_host(ctx) == 1 {
        return arukellt_host_import_base(ctx) + 7
    }
    constants::WASI_IMPORT_SOCKETS_CONNECT()
}
