use wasm::constants
use wasm::ctx_record
use wasm::emit_target

fn args_sizes_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_ARGUMENTS()
    }
    1
}

fn arguments_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_ARGUMENTS()
    }
    2
}

fn path_open_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_OPEN_AT()
    }
    constants::WASI_IMPORT_PATH_OPEN()
}

fn fd_read_import_idx(ctx: SelfEmitCtx) -> i32 {
    // File reads use the P2 filesystem interface, not stdin.
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_FS_READ()
    }
    constants::WASI_IMPORT_FD_READ()
}

fn fd_write_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_FS_WRITE()
    }
    constants::WASI_IMPORT_FD_WRITE()
}

fn stdin_read_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_STDIN_READ()
    }
    constants::WASI_IMPORT_FD_READ()
}

fn fd_close_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_CLOSE()
    }
    constants::WASI_IMPORT_FD_CLOSE()
}

fn environment_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_ENVIRONMENT()
    }
    constants::WASI_IMPORT_ENVIRON_GET()
}

fn get_directories_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_GET_DIRECTORIES()
    }
    0 - 1
}

fn proc_exit_import_idx(ctx: SelfEmitCtx) -> i32 {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        return constants::P2_IMPORT_EXIT()
    }
    constants::WASI_IMPORT_PROC_EXIT()
}
