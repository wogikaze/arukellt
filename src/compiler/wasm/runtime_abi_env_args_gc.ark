// GC target: build Vec<String> from the canonical WASI P2 `list<string>`.
// Skips argv[0] so the result matches Env::arg_count / linear-memory args().

use wasm::constants
use wasm::ctx_gc_type
use wasm::ctx_record
use wasm::ctx_scratch
use wasm::emit_target
use wasm::host_intrinsic_adapter
use wasm::import_indices
use wasm::intrinsic_vec_access_gc
use wasm::intrinsics::helpers_control
use wasm::intrinsics::helpers_core
use wasm::intrinsics::helpers_io_layout
use wasm::intrinsics::helpers_memory
use wasm::intrinsics::helpers_numeric_i32
use wasm::intrinsics::helpers_numeric_i32_convert
use wasm::opcodes
use wasm::string_gc_helpers
use wasm::writer_core
use wasm::writer_gc

fn emit_env_args_gc(mut w: WasmWriter, ctx: SelfEmitCtx) -> bool {
    let s_argc = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    let s_user = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    let s_argv = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    let s_argv_buf = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 3)
    let s_bufsize = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 4)
    let s_li = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 5)
    let s_cstr = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 6)
    let s_slen = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 7)
    let s_slot = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 8)
    let s_k = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 9)
    let s_arr = ctx_scratch::SelfEmitCtx_scratch_gc_string_ref_array_local(ctx, 0)
    let s_vec = ctx_scratch::SelfEmitCtx_scratch_gc_vec_local(ctx, 0)
    let s_str = ctx_scratch::SelfEmitCtx_scratch_gc_local(ctx, 0)
    let vec_type = ctx_gc_type::SelfEmitCtx_vec_string_type(ctx)
    let arr_type = ctx_gc_type::SelfEmitCtx_string_ref_array_type(ctx)
    let string_type = ctx_gc_type::SelfEmitCtx_string_type(ctx)

    emit_env_args_gc_fetch(w, ctx, s_argc, s_argv, s_argv_buf, s_bufsize)
    helpers_core::emit_local_get(w, s_argc)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_sub(w)
    helpers_core::emit_local_set(w, s_user)
    helpers_core::emit_local_get(w, s_user)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_core::emit_local_set(w, s_user)
    helpers_control::emit_end(w)

    helpers_core::emit_local_get(w, s_user)
    string_gc_helpers::emit_gc_array_new(w, arr_type)
    helpers_core::emit_local_set(w, s_arr)
    helpers_core::emit_local_get(w, s_arr)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32_convert::emit_narrow_i64_operand(w)
    writer_gc::emit_gc_struct_new(w, vec_type)
    helpers_core::emit_local_set(w, s_vec)

    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_core::emit_local_set(w, s_li)
    helpers_control::emit_block_loop_header(w)
    helpers_core::emit_local_get(w, s_li)
    helpers_core::emit_local_get(w, s_argc)
    helpers_numeric_i32::emit_i32_ge_s(w)
    helpers_control::emit_br_if(w, 1)
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        emit_env_args_gc_store_one_p2(w, s_argv, s_li, s_cstr, s_slen, s_slot, s_k, s_arr, s_str, arr_type, string_type)
    } else {
        emit_env_args_gc_store_one(w, s_argv, s_li, s_cstr, s_slen, s_slot, s_k, s_arr, s_str, arr_type, string_type)
    }
    helpers_core::emit_local_get(w, s_li)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, s_li)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_block_loop_footer(w)

    helpers_core::emit_local_get(w, s_vec)
    writer_gc::emit_gc_ref_cast(w, vec_type)
    helpers_core::emit_local_get(w, s_user)
    writer_gc::emit_gc_struct_set_i32(w, vec_type, 1)
    helpers_core::emit_local_get(w, s_vec)
    writer_gc::emit_gc_ref_cast(w, vec_type)
    true
}

// GC target: return the user argument at `index` as Option<String>.
// `get-arguments` keeps argv[0], while the Ark surface counts user arguments
// from 0, so index N reads element N+1 and the bound is argc - 1.
fn emit_env_arg_at_gc(mut w: WasmWriter, ctx: SelfEmitCtx) -> bool {
    let s_argc = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 0)
    let s_idx = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    let s_argv = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    let s_argv_buf = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 3)
    let s_bufsize = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 4)
    let s_ptr = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 5)
    let s_len = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 6)
    let s_k = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 7)
    let s_str = ctx_scratch::SelfEmitCtx_scratch_gc_local(ctx, 0)
    let s_opt = ctx_scratch::SelfEmitCtx_scratch_gc_enum_local(ctx, 0)
    let string_type = ctx_gc_type::SelfEmitCtx_string_type(ctx)
    let open_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    let some_type = intrinsic_vec_access_gc::find_option_some_variant_type(ctx, "_f1_ref0", open_type)

    helpers_core::emit_local_set(w, s_idx)
    emit_env_args_gc_fetch(w, ctx, s_argc, s_argv, s_argv_buf, s_bufsize)
    emit_env_arg_at_gc_none(w, ctx, s_opt)
    emit_env_arg_at_gc_some(
        w,
        ctx,
        s_idx,
        s_argc,
        s_argv,
        s_ptr,
        s_len,
        s_k,
        s_str,
        s_opt,
        string_type,
        some_type
    )
    helpers_core::emit_local_get(w, s_opt)
    writer_gc::emit_gc_ref_cast(w, open_type)
    true
}

fn emit_env_arg_at_gc_none(mut w: WasmWriter, ctx: SelfEmitCtx, s_opt: i32) {
    let mut none_type = ctx_gc_type::SelfEmitCtx_struct_type_by_name(ctx, "Option::None")
    if none_type < 0 {
        none_type = ctx_gc_type::SelfEmitCtx_enum_open_type(ctx)
    }
    writer_gc::emit_gc_struct_new_default(w, none_type)
    helpers_core::emit_local_set(w, s_opt)
    helpers_core::emit_local_get(w, s_opt)
    writer_gc::emit_gc_ref_cast(w, none_type)
    helpers_numeric_i32::emit_i32_const(w, 1)
    writer_gc::emit_gc_struct_set_i32(w, none_type, 0)
}

fn emit_env_arg_at_gc_some(
    mut w: WasmWriter,
    ctx: SelfEmitCtx,
    s_idx: i32,
    s_argc: i32,
    s_argv: i32,
    s_ptr: i32,
    s_len: i32,
    s_k: i32,
    s_str: i32,
    s_opt: i32,
    string_type: i32,
    some_type: i32
) {
    helpers_control::emit_void_block(w)
    helpers_core::emit_local_get(w, s_idx)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_br_if(w, 0)
    helpers_core::emit_local_get(w, s_idx)
    helpers_core::emit_local_get(w, s_argc)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_sub(w)
    helpers_numeric_i32::emit_i32_ge_s(w)
    helpers_control::emit_br_if(w, 0)
    helpers_core::emit_local_get(w, s_idx)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, s_idx)
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        emit_env_arg_at_gc_load_p2(w, s_argv, s_idx, s_ptr, s_len)
    } else {
        emit_env_arg_at_gc_load_p1(w, s_argv, s_idx, s_ptr, s_len)
    }
    emit_env_arg_at_gc_build(w, s_ptr, s_len, s_k, s_str, s_opt, string_type, some_type)
    helpers_control::emit_end(w)
}

fn emit_env_arg_at_gc_load_p2(mut w: WasmWriter, s_argv: i32, s_idx: i32, s_ptr: i32, s_len: i32) {
    // Each canonical list element is a four-byte pointer plus a four-byte
    // length; `local.tee` keeps the element address for the length load.
    helpers_core::emit_local_get(w, s_argv)
    helpers_core::emit_local_get(w, s_idx)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_tee(w, s_ptr)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_ptr)
    helpers_core::emit_local_get(w, s_argv)
    helpers_core::emit_local_get(w, s_idx)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_len)
}

fn emit_env_arg_at_gc_load_p1(mut w: WasmWriter, s_argv: i32, s_idx: i32, s_ptr: i32, s_len: i32) {
    // Preview 1 argv is an i32 pointer table into NUL-terminated strings.
    helpers_core::emit_local_get(w, s_argv)
    helpers_core::emit_local_get(w, s_idx)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_ptr)
    emit_env_args_gc_cstr_len(w, s_ptr, s_len)
}

fn emit_env_arg_at_gc_build(
    mut w: WasmWriter,
    s_ptr: i32,
    s_len: i32,
    s_k: i32,
    s_str: i32,
    s_opt: i32,
    string_type: i32,
    some_type: i32
) {
    helpers_core::emit_local_get(w, s_len)
    string_gc_helpers::emit_gc_array_new(w, string_type)
    helpers_core::emit_local_set(w, s_str)
    emit_env_args_gc_copy_bytes(w, s_ptr, s_len, s_str, s_k, string_type)
    // Option::Some's discriminant is a true i32 field; under Memory64 the
    // i32 helper emits i64.const, which struct.new rejects as a field value.
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, 0)
    helpers_core::emit_local_get(w, s_str)
    writer_gc::emit_gc_ref_as_non_null(w)
    writer_gc::emit_gc_struct_new(w, some_type)
    helpers_core::emit_local_set(w, s_opt)
}

fn emit_env_args_gc_fetch(
    mut w: WasmWriter,
    ctx: SelfEmitCtx,
    s_argc: i32,
    s_argv: i32,
    s_argv_buf: i32,
    s_bufsize: i32
) {
    if emit_target::is_p2_wasi(ctx_record::SelfEmitCtx_wasi_version(ctx)) {
        emit_env_args_gc_fetch_p2(w, ctx, s_argc, s_argv)
        return
    }
    host_intrinsic_adapter::emit_canonical_memory32_static_address(w, constants::SCRATCH_ARGC())
    host_intrinsic_adapter::emit_canonical_memory32_static_address(w, constants::SCRATCH_ARGV_SIZE())
    helpers_core::emit_call(w, import_indices::args_sizes_import_idx(ctx))
    helpers_core::emit_drop(w)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_ARGC())
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_argc)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_ARGV_SIZE())
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_bufsize)

    helpers_core::emit_heap_get(w)
    helpers_core::emit_local_set(w, s_argv)
    helpers_core::emit_heap_get(w)
    helpers_core::emit_local_get(w, s_argc)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_heap_set(w)

    helpers_core::emit_heap_get(w)
    helpers_core::emit_local_set(w, s_argv_buf)
    helpers_core::emit_heap_get(w)
    helpers_core::emit_local_get(w, s_bufsize)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_heap_set(w)

    helpers_io_layout::emit_wasi_i32_from_local(w, s_argv)
    helpers_io_layout::emit_wasi_i32_from_local(w, s_argv_buf)
    helpers_core::emit_call(w, import_indices::arguments_import_idx(ctx))
    helpers_core::emit_drop(w)
}

fn emit_env_args_gc_fetch_p2(mut w: WasmWriter, ctx: SelfEmitCtx, s_argc: i32, s_argv: i32) {
    // `get-arguments` returns a canonical list through the result pointer:
    // pointer at +0 and element count at +4. Each element is a `(ptr, len)`
    // pair, so no NUL-terminated compatibility buffer is needed.
    helpers_io_layout::emit_scratch_addr_wasi(w, constants::SCRATCH_ARGC())
    helpers_core::emit_call(w, import_indices::arguments_import_idx(ctx))
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_ARGC())
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_argv)
    helpers_numeric_i32::emit_i32_const(w, constants::SCRATCH_ARGC() + 4)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_argc)
}

fn emit_env_args_gc_store_one_p2(
    mut w: WasmWriter,
    s_argv: i32,
    s_li: i32,
    s_cstr: i32,
    s_slen: i32,
    s_slot: i32,
    s_k: i32,
    s_arr: i32,
    s_str: i32,
    arr_type: i32,
    string_type: i32
) {
    helpers_core::emit_local_get(w, s_li)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_sub(w)
    helpers_core::emit_local_set(w, s_slot)

    helpers_core::emit_local_get(w, s_argv)
    helpers_core::emit_local_get(w, s_li)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, s_cstr)
    helpers_core::emit_local_get(w, s_cstr)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_cstr)
    helpers_core::emit_local_get(w, s_argv)
    helpers_core::emit_local_get(w, s_li)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_slen)

    helpers_core::emit_local_get(w, s_arr)
    helpers_core::emit_local_get(w, s_slot)
    helpers_numeric_i32::emit_narrow_i64_operand(w)
    helpers_core::emit_local_get(w, s_slen)
    string_gc_helpers::emit_gc_array_new(w, string_type)
    writer_gc::emit_gc_array_set(w, arr_type)

    helpers_core::emit_local_get(w, s_arr)
    helpers_core::emit_local_get(w, s_slot)
    writer_gc::emit_gc_array_get(w, arr_type)
    writer_gc::emit_gc_ref_cast(w, string_type)
    helpers_core::emit_local_set(w, s_str)
    emit_env_args_gc_copy_bytes(w, s_cstr, s_slen, s_str, s_k, string_type)
}

fn emit_env_args_gc_store_one(
    mut w: WasmWriter,
    s_argv: i32,
    s_li: i32,
    s_cstr: i32,
    s_slen: i32,
    s_slot: i32,
    s_k: i32,
    s_arr: i32,
    s_str: i32,
    arr_type: i32,
    string_type: i32
) {
    helpers_core::emit_local_get(w, s_li)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_sub(w)
    helpers_core::emit_local_set(w, s_slot)
    helpers_core::emit_local_get(w, s_argv)
    helpers_core::emit_local_get(w, s_li)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_set(w, s_cstr)
    emit_env_args_gc_cstr_len(w, s_cstr, s_slen)

    helpers_core::emit_local_get(w, s_arr)
    helpers_core::emit_local_get(w, s_slot)
    helpers_numeric_i32::emit_narrow_i64_operand(w)
    helpers_core::emit_local_get(w, s_slen)
    string_gc_helpers::emit_gc_array_new(w, string_type)
    writer_gc::emit_gc_array_set(w, arr_type)

    helpers_core::emit_local_get(w, s_arr)
    helpers_core::emit_local_get(w, s_slot)
    writer_gc::emit_gc_array_get(w, arr_type)
    writer_gc::emit_gc_ref_cast(w, string_type)
    helpers_core::emit_local_set(w, s_str)
    emit_env_args_gc_copy_bytes(w, s_cstr, s_slen, s_str, s_k, string_type)
}

fn emit_env_args_gc_cstr_len(mut w: WasmWriter, s_cstr: i32, s_slen: i32) {
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_core::emit_local_set(w, s_slen)
    helpers_control::emit_block_loop_header(w)
    helpers_core::emit_local_get(w, s_cstr)
    helpers_core::emit_local_get(w, s_slen)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load8_u_default(w)
    helpers_numeric_i32::emit_i32_eqz(w)
    helpers_control::emit_br_if(w, 1)
    helpers_core::emit_local_get(w, s_slen)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, s_slen)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_block_loop_footer(w)
}

fn emit_env_args_gc_copy_bytes(mut w: WasmWriter, s_cstr: i32, s_slen: i32, s_str: i32, s_k: i32, string_type: i32) {
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_core::emit_local_set(w, s_k)
    helpers_control::emit_block_loop_header(w)
    helpers_core::emit_local_get(w, s_k)
    helpers_core::emit_local_get(w, s_slen)
    helpers_numeric_i32::emit_i32_ge_s(w)
    helpers_control::emit_br_if(w, 1)
    helpers_core::emit_local_get(w, s_str)
    helpers_core::emit_local_get(w, s_k)
    helpers_numeric_i32::emit_narrow_i64_operand(w)
    helpers_core::emit_local_get(w, s_cstr)
    helpers_core::emit_local_get(w, s_k)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load8_u_default(w)
    string_gc_helpers::emit_gc_array_set(w, string_type)
    helpers_core::emit_local_get(w, s_k)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, s_k)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_block_loop_footer(w)
}
