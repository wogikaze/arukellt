use std::text
use wasm::constants
use wasm::opcodes
use wasm::sections_type_plan
use wasm::sections_types_gc
use wasm::sections_types_sig_parse
use wasm::sections_types_sigs_detail
use wasm::writer_core
fn emit_canon_type_entries(
    mut type_sec: WasmWriter,
    canon_types: Vec<String>,
    gc_type_base: i32,
    gc_struct_type_map: Vec<i32>,
    memory64: bool
) -> FuncTypeRefs {
    let mut type_refs = sections_type_plan::FuncTypeRefs_new()
    for cti2 in 0..canon_types.len() {
        let csig = get_unchecked(canon_types, cti2)
        sections_type_plan::FuncTypeRefs_begin_entry(type_refs)
        if csig.clone().starts_with(String_from("SubF")) {
            emit_sub_type_entry(type_sec, csig, gc_type_base, 1, gc_struct_type_map, canon_types, memory64)
        } else {
            if csig.clone().starts_with(String_from("Sub0_")) {
                emit_open_sub_type_entry(type_sec, csig, gc_type_base, gc_struct_type_map, canon_types, memory64)
            } else {
                if csig.clone().starts_with(String_from("Sub")) {
                    emit_sub_type_entry(type_sec, csig, gc_type_base, 0, gc_struct_type_map, canon_types, memory64)
                } else {
                    if csig.clone().starts_with(String_from("GS_f")) {
                        emit_struct_type_entry(type_sec, csig, gc_type_base, gc_struct_type_map, canon_types, memory64)
                    } else {
                        if csig.clone().eq(String_from("A_fnref")) {
                            // Vec<fn>/HashMap<_, fn> elements are nullable
                            // __fnpair refs under the managed closure ABI
                            // (#872). The pair record is the fixed type at
                            // gc_fnpair_offset, so this is a backward
                            // reference. Nullable so array.new_default works
                            // (#832).
                            writer_core::emit_byte(type_sec, opcodes::SEC_TYPE_ARRAY())
                            let type_idx = gc_type_base + sections_types_gc::gc_fnpair_offset()
                            writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
                            writer_core::emit_leb128_s(type_sec, type_idx)
                            writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
                        } else if csig.clone().byte_at(0) == 65 {
                            sections_types_gc::emit_array_type_entry(type_sec, csig, gc_type_base, gc_struct_type_map)
                        } else {
                            writer_core::emit_byte(type_sec, opcodes::SEC_TYPE_FUNCTYPE())
                            let param_segments = sections_type_plan::type_sig_param_segments(csig)
                            let result_seg = sections_type_plan::type_sig_result_segment(csig)
                            emit_type_param_entries(type_sec, param_segments, gc_type_base, gc_struct_type_map, canon_types, memory64)
                            emit_type_result_entry(type_sec, result_seg, gc_type_base, gc_struct_type_map, canon_types, memory64)
                            record_func_type_refs(
                                type_refs,
                                param_segments,
                                result_seg,
                                gc_type_base,
                                gc_struct_type_map
                            )
                        }
                    }
                }
            }
        }
    }
    sections_type_plan::FuncTypeRefs_finish(type_refs)
    type_refs
}

fn record_func_type_refs(
    mut type_refs: FuncTypeRefs,
    param_segments: Vec<String>,
    result_seg: String,
    gc_type_base: i32,
    gc_struct_type_map: Vec<i32>
) {
    let param_count = param_segments.len()
    let mut pi = 0
    while pi < param_count {
        let seg = get_unchecked(param_segments, pi)
        sections_type_plan::FuncTypeRefs_push_param(
            type_refs,
            sig_ref_null_type_index(seg, gc_type_base, gc_struct_type_map)
        )
        pi = pi + 1
    }
    if !result_seg.clone().eq("0") {
        let result_sig = result_seg.slice(1, result_seg.len())
        sections_type_plan::FuncTypeRefs_set_result(
            type_refs,
            sig_ref_null_type_index(result_sig, gc_type_base, gc_struct_type_map)
        )
    }
}

fn emit_open_sub_type_entry(
    mut type_sec: WasmWriter,
    sig: String,
    gc_type_base: i32,
    gc_struct_type_map: Vec<i32>,
    canon_types: Vec<String>,
    memory64: bool
) {
    writer_core::emit_byte(type_sec, opcodes::SEC_TYPE_SUB())
    writer_core::emit_leb128_u(type_sec, 0)
    emit_struct_type_entry(type_sec, sections_types_sig_parse::parse_sub_struct_sig(sig), gc_type_base, gc_struct_type_map, canon_types, memory64)
}

fn emit_sub_type_entry(
    mut type_sec: WasmWriter,
    sig: String,
    gc_type_base: i32,
    is_final: i32,
    gc_struct_type_map: Vec<i32>,
    canon_types: Vec<String>,
    memory64: bool
) {
    if is_final == 1 {
        writer_core::emit_byte(type_sec, opcodes::SEC_TYPE_FINAL_SUB())
    } else {
        writer_core::emit_byte(type_sec, opcodes::SEC_TYPE_SUB())
    }
    let super_off = sections_types_sig_parse::parse_sub_super_offset(sig)
    if super_off >= 0 {
        writer_core::emit_leb128_u(type_sec, 1)
        writer_core::emit_leb128_u(type_sec, gc_type_base + super_off)
    } else {
        writer_core::emit_leb128_u(type_sec, 0)
    }
    emit_struct_type_entry(type_sec, sections_types_sig_parse::parse_sub_struct_sig(sig), gc_type_base, gc_struct_type_map, canon_types, memory64)
}

fn emit_struct_type_entry(
    mut type_sec: WasmWriter,
    sig: String,
    gc_type_base: i32,
    gc_struct_type_map: Vec<i32>,
    canon_types: Vec<String>,
    memory64: bool
) {
    writer_core::emit_byte(type_sec, opcodes::SEC_TYPE_STRUCT())
    let field_sigs = struct_field_sigs(sig)
    writer_core::emit_leb128_u(type_sec, field_sigs.len())
    for fi in 0..field_sigs.len() {
        emit_struct_field_type(type_sec, get_unchecked(field_sigs, fi), gc_type_base, gc_struct_type_map, canon_types, memory64)
    }
}

fn emit_struct_field_type(
    mut type_sec: WasmWriter,
    ft: String,
    gc_type_base: i32,
    gc_struct_type_map: Vec<i32>,
    canon_types: Vec<String>,
    memory64: bool
) {
    if sections_types_sigs_detail::funcref_type_name_is_typed_string_callback(ft.clone()) {
        let type_idx = find_typed_callback_type_idx(canon_types, ft.clone(), memory64)
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(type_sec, type_idx)
        writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
        return
    }
    // `fnsig:<tokP>;<tokR>` fields reference the exact callback func type
    // (e.g. fn(String) -> i32 = gcref0_1i64 under Memory64) instead of the
    // legacy i32-ABI funcref slot (#860/#691).
    if ft.clone().starts_with(String_from("fnsig:")) {
        let type_idx = find_fnsig_type_idx(canon_types, ft.clone(), memory64)
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(type_sec, type_idx)
        writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
        return
    }
    if ft.clone().eq(String_from("fnref")) {
        // Enum/struct storage uses nullable funcref so struct.new_default works
        // (non-null `(ref $t)` is not defaultable). call_ref accepts null refs.
        let type_idx = find_unary_callback_type_idx_for_memory_width(canon_types, memory64)
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(type_sec, type_idx)
        writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
        return
    }
    if ft.clone().starts_with(String_from("gcsref")) {
        let slot = sections_types_sig_parse::parse_type_sig_int(ft.slice(6, ft.len()))
        if slot < gc_struct_type_map.len() {
            let type_idx = get_unchecked(gc_struct_type_map, slot)
            writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
            writer_core::emit_leb128_s(type_sec, type_idx)
            writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
            return
        }
    }
    // Nullable abstract structref field (the __fnpair env slot, #872).
    // Must stay nullable so struct.new_default can initialize it.
    if ft.clone().eq(String_from("structref")) {
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_byte(type_sec, constants::WASM_STRUCTREF())
        writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
        return
    }
    if ft.clone().starts_with(String_from("ref")) {
        let offset_str = ft.slice(3, ft.len())
        let offset = sections_types_sig_parse::parse_type_sig_int(offset_str)
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(type_sec, gc_type_base + offset)
        writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
        return
    }
    writer_core::emit_byte(type_sec, sections_type_plan::sig_to_wasm_type(ft))
    writer_core::emit_byte(type_sec, constants::WASM_MUTABLE())
}

fn struct_field_sigs(sig: String) -> Vec<String> {
    let mut fields = Vec::new<String>()
    let sig_len = sig.len()
    let mut si = 0
    while si < sig_len {
        if sig.clone().byte_at(si) == 95 && si + 1 < sig_len && sig.clone().byte_at(si + 1) == 102 {
            let mut pi = si + 2
            while pi < sig_len && sig.clone().byte_at(pi) != 95 {
                pi = pi + 1
            }
            if pi < sig_len {
                let type_start = pi + 1
                let mut type_end = type_start
                while type_end < sig_len && sig.clone().byte_at(type_end) != 95 {
                    type_end = type_end + 1
                }
                push(fields, sig.clone().slice(type_start, type_end))
                si = type_end
            } else {
                si = si + 2
            }
        } else {
            si = si + 1
        }
    }
    fields
}

fn emit_type_param_entries(
    mut type_sec: WasmWriter,
    param_segments: Vec<String>,
    gc_type_base: i32,
    gc_struct_type_map: Vec<i32>,
    canon_types: Vec<String>,
    memory64: bool
) {
    let param_count = param_segments.len()
    writer_core::emit_leb128_u(type_sec, param_count)
    let mut pi = 0
    while pi < param_count {
        let seg = get_unchecked(param_segments, pi)
        emit_sig_val_type(type_sec, seg, gc_type_base, gc_struct_type_map, canon_types, memory64)
        pi = pi + 1
    }
}

fn emit_type_result_entry(
    mut type_sec: WasmWriter,
    result_seg: String,
    gc_type_base: i32,
    gc_struct_type_map: Vec<i32>,
    canon_types: Vec<String>,
    memory64: bool
) {
    if result_seg.clone().eq("0") {
        writer_core::emit_leb128_u(type_sec, 0)
    } else {
        let rt = result_seg.slice(1, result_seg.len())
        writer_core::emit_leb128_u(type_sec, 1)
        emit_sig_val_type(type_sec, rt, gc_type_base, gc_struct_type_map, canon_types, memory64)
    }
}

fn find_unary_callback_type_idx(canon_types: Vec<String>) -> i32 {
    let n = canon_types.len()
    let mut i = 0
    while i < n {
        if get_unchecked(canon_types, i).eq(String_from("i32_1i32")) {
            return i
        }
        i = i + 1
    }
    i = 0
    while i < n {
        if get_unchecked(canon_types, i).eq(String_from("i64_1i64")) {
            return i
        }
        i = i + 1
    }
    3
}

fn find_unary_callback_type_idx_for_memory_width(canon_types: Vec<String>, memory64: bool) -> i32 {
    if memory64 {
        return find_unary_callback_type_idx_memory64(canon_types)
    }
    find_unary_callback_type_idx(canon_types)
}

fn find_unary_callback_type_idx_memory64(canon_types: Vec<String>) -> i32 {
    let n = canon_types.len()
    let mut i = 0
    while i < n {
        if get_unchecked(canon_types, i).eq(String_from("i64_1i64")) {
            return i
        }
        i = i + 1
    }
    find_unary_callback_type_idx(canon_types)
}

fn find_binary_callback_type_idx(canon_types: Vec<String>) -> i32 {
    let n = canon_types.len()
    let mut i = 0
    while i < n {
        if get_unchecked(canon_types, i).eq(String_from("i32_i32_1i32")) {
            return i
        }
        i = i + 1
    }
    1
}

fn find_binary_callback_type_idx_memory64(canon_types: Vec<String>) -> i32 {
    let n = canon_types.len()
    let mut i = 0
    while i < n {
        if get_unchecked(canon_types, i).eq(String_from("i64_i64_1i64")) {
            return i
        }
        i = i + 1
    }
    find_binary_callback_type_idx(canon_types)
}

fn emit_sig_val_type(
    mut type_sec: WasmWriter,
    sig: String,
    gc_type_base: i32,
    gc_struct_type_map: Vec<i32>,
    canon_types: Vec<String>,
    memory64: bool
) {
    if sections_types_sigs_detail::funcref_type_name_is_typed_string_callback(sig.clone()) {
        let type_idx = find_typed_callback_type_idx(canon_types, sig.clone(), memory64)
        writer_core::emit_byte(type_sec, constants::WASM_REF())
        writer_core::emit_leb128_s(type_sec, type_idx)
        return
    }
    if sig.clone().starts_with(String_from("fnsig:")) {
        let type_idx = find_fnsig_type_idx(canon_types, sig.clone(), memory64)
        writer_core::emit_byte(type_sec, constants::WASM_REF())
        writer_core::emit_leb128_s(type_sec, type_idx)
        return
    }
    if sig.clone().eq(String_from("fnref2")) {
        let type_idx = if memory64 {
            find_binary_callback_type_idx_memory64(canon_types)
        } else {
            find_binary_callback_type_idx(canon_types)
        }
        writer_core::emit_byte(type_sec, constants::WASM_REF())
        writer_core::emit_leb128_s(type_sec, type_idx)
        return
    }
    if sig.clone().eq(String_from("fnref2m64")) {
        let type_idx = find_binary_callback_type_idx_memory64(canon_types)
        writer_core::emit_byte(type_sec, constants::WASM_REF())
        writer_core::emit_leb128_s(type_sec, type_idx)
        return
    }
    if sig.clone().eq(String_from("fnref")) {
        let type_idx = find_unary_callback_type_idx_for_memory_width(canon_types, memory64)
        writer_core::emit_byte(type_sec, constants::WASM_REF())
        writer_core::emit_leb128_s(type_sec, type_idx)
        return
    }
    if sig.clone().eq(String_from("fnrefm64")) {
        let type_idx = find_unary_callback_type_idx_memory64(canon_types)
        writer_core::emit_byte(type_sec, constants::WASM_REF())
        writer_core::emit_leb128_s(type_sec, type_idx)
        return
    }
    if sig.clone().eq(String_from("structref")) {
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_byte(type_sec, constants::WASM_STRUCTREF())
        return
    }
    let ref_type_idx = sig_ref_null_type_index(sig.clone(), gc_type_base, gc_struct_type_map)
    if ref_type_idx >= 0 {
        writer_core::emit_byte(type_sec, constants::WASM_REF_NULL())
        writer_core::emit_leb128_s(type_sec, ref_type_idx)
        return
    }
    writer_core::emit_byte(type_sec, sections_type_plan::sig_to_wasm_type(sig))
}

fn find_typed_callback_type_idx(canon_types: Vec<String>, type_name: String, memory64: bool) -> i32 {
    let wanted = sections_types_sigs_detail::typed_string_callback_type_sig(type_name.clone(), memory64)
    let n = canon_types.len()
    let mut i = 0
    while i < n {
        if get_unchecked(canon_types, i).eq(wanted.clone()) {
            return i
        }
        i = i + 1
    }
    // The callback signatures are reserved by build_type_sigs. Keep a valid
    // fallback for old cached plans that predate the reservation.
    find_unary_callback_type_idx_for_memory_width(canon_types, memory64)
}

// Resolve a `fnsig:<tokP>;<tokR>` segment to the canon type index of the
// matching func signature `<tokP>_1<tokR>`. Scalar i32 segments widen to
// i64 under Memory64 — the same rule build_function_type_sig applies to
// the callback function itself, so the stored ref.func type matches the
// field/param slot (#860). Falls back to the unary i32-ABI callback when
// the signature is not representable in this module.
fn find_fnsig_type_idx(canon_types: Vec<String>, type_name: String, memory64: bool) -> i32 {
    let rest = type_name.clone().slice(6, type_name.len())
    let sep = rest.clone().index_of(String_from(";"))
    if sep < 0 {
        return find_unary_callback_type_idx_for_memory_width(canon_types, memory64)
    }
    let param_tok = fnsig_emit_segment_token(rest.clone().slice(0, sep), memory64)
    let ret_seg = rest.clone().slice(sep + 1, rest.len())
    if ret_seg.clone().contains(String_from(";")) {
        return find_unary_callback_type_idx_for_memory_width(canon_types, memory64)
    }
    let ret_tok = fnsig_emit_segment_token(ret_seg, memory64)
    if param_tok.len() == 0 || ret_tok.len() == 0 {
        return find_unary_callback_type_idx_for_memory_width(canon_types, memory64)
    }
    let wanted = param_tok.concat(String_from("_1").concat(ret_tok))
    let n = canon_types.len()
    let mut i = 0
    while i < n {
        if get_unchecked(canon_types, i).eq(wanted.clone()) {
            return i
        }
        i = i + 1
    }
    find_unary_callback_type_idx_for_memory_width(canon_types, memory64)
}

// One fnsig emit-segment -> func-sig token. Token segments produced at
// sig-build time (gcrefN/gcsrefN/fnref) pass through; plain names map to
// the same GC offsets used by build_param_type_sig so either dialect
// resolves (#860).
fn fnsig_emit_segment_token(seg: String, memory64: bool) -> String {
    if seg.len() == 0 || seg.clone().starts_with(String_from("fnsig:")) {
        return String_new()
    }
    if seg.clone().eq(String_from("i32")) || seg.clone().eq(String_from("I32")) ||
    seg.clone().eq(String_from("bool")) || seg.clone().eq(String_from("Bool")) ||
    seg.clone().eq(String_from("char")) || seg.clone().eq(String_from("u8")) ||
    seg.clone().eq(String_from("i8")) || seg.clone().eq(String_from("u16")) ||
    seg.clone().eq(String_from("i16")) || seg.clone().eq(String_from("u32")) {
        if memory64 {
            return String_from("i64")
        }
        return String_from("i32")
    }
    if seg.clone().eq(String_from("i64")) || seg.clone().eq(String_from("I64")) ||
    seg.clone().eq(String_from("u64")) {
        return String_from("i64")
    }
    if seg.clone().eq(String_from("f64")) || seg.clone().eq(String_from("F64")) {
        return String_from("f64")
    }
    if seg.clone().eq(String_from("f32")) || seg.clone().eq(String_from("F32")) {
        return String_from("f32")
    }
    if seg.clone().eq(String_from("v128")) || seg.clone().eq(String_from("V128")) {
        return String_from("v128")
    }
    if seg.clone().eq(String_from("String")) || seg.clone().eq(String_from("string")) {
        return String_from("gcref0")
    }
    if seg.clone().starts_with(String_from("gcref")) ||
    seg.clone().starts_with(String_from("gcsref")) ||
    seg.clone().starts_with(String_from("fnref")) ||
    seg.clone().starts_with(String_from("vec:")) ||
    seg.clone().starts_with(String_from("hashmap:")) ||
    seg.clone().starts_with(String_from("option:")) ||
    seg.clone().starts_with(String_from("result:")) ||
    seg.clone().starts_with(String_from("enum:")) {
        return seg
    }
    String_new()
}

// Concrete `(ref null <type_idx>)` index for a signature segment, or -1 when
// the segment is a scalar, an abstract heap type, or a non-null funcref.
fn sig_ref_null_type_index(sig: String, gc_type_base: i32, gc_struct_type_map: Vec<i32>) -> i32 {
    if gc_type_base < 0 {
        return 0 - 1
    }
    if sig.clone().starts_with(String_from("gcsref")) {
        let slot = sections_types_sig_parse::parse_type_sig_int(sig.slice(6, sig.len()))
        return get_unchecked(gc_struct_type_map, slot)
    }
    if sig.clone().starts_with(String_from("gcref")) {
        return gc_type_base + sections_types_sig_parse::parse_gcref_offset(sig)
    }
    if sig.clone().eq("ref") {
        return gc_type_base
    }
    0 - 1
}
