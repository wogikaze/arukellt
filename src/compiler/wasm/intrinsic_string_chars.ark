//
// GC target delegated to intrinsic_string_chars_gc.ark.

use wasm::ctx_scratch
use wasm::ctx_record
use wasm::emit_target
use wasm::intrinsic_string_chars_gc
use wasm::intrinsics::helpers_control
use wasm::intrinsics::helpers_core
use wasm::intrinsics::helpers_core_heap
use wasm::intrinsics::helpers_memory
use wasm::intrinsics::helpers_numeric_i32

// Handler for: text::chars
fn emit_text_chars(w: WasmWriter, _inst: MirInst, ctx: SelfEmitCtx) -> bool {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        return intrinsic_string_chars_gc::emit_text_chars_gc(w, ctx)
    }
    let s_src = ctx_scratch::SelfEmitCtx_scratch_base(ctx)
    let s_vec = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 1)
    let s_slen = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 2)
    let s_count = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 3)
    let s_pos = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 4)
    let s_width = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 5)
    let s_segidx = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 6)
    let s_copy = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 7)
    let s_byte = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 8)
    let s_str_base = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 9)
    let s_str_data = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 10)

    helpers_core::emit_local_set(w, s_src)
    helpers_core::emit_local_get(w, s_src)
    helpers_memory::emit_string_len_from_stack(w)
    helpers_core::emit_local_set(w, s_slen)
    emit_chars_count(w, s_src, s_slen, s_count, s_pos, s_width, s_byte)
    emit_chars_alloc_vec(w, s_count, s_vec)
    emit_chars_fill(
        w,
        s_src,
        s_slen,
        s_vec,
        s_pos,
        s_width,
        s_segidx,
        s_copy,
        s_byte,
        s_str_base,
        s_str_data
    )
    helpers_core::emit_local_get(w, s_vec)
    return true
}

fn emit_chars_count(w: WasmWriter, src_local: i32, slen_local: i32, count_local: i32, pos_local: i32, width_local: i32, byte_local: i32) {
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_core::emit_local_set(w, count_local)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_core::emit_local_set(w, pos_local)
    helpers_core::emit_local_get(w, slen_local)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_eq(w)
    helpers_control::emit_if_empty(w)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_core::emit_local_set(w, count_local)
    helpers_control::emit_else(w)
    helpers_control::emit_block_loop_header(w)
    helpers_core::emit_local_get(w, pos_local)
    helpers_core::emit_local_get(w, slen_local)
    helpers_numeric_i32::emit_i32_ge_s(w)
    helpers_control::emit_br_if(w, 1)
    emit_chars_load_byte(w, src_local, pos_local, byte_local)
    emit_chars_scalar_width(w, byte_local, pos_local, slen_local, width_local)
    helpers_core::emit_local_get(w, pos_local)
    helpers_core::emit_local_get(w, width_local)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, pos_local)
    helpers_core::emit_local_get(w, count_local)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, count_local)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
}

fn emit_chars_alloc_vec(w: WasmWriter, count_local: i32, vec_local: i32) {
    helpers_core::emit_local_get(w, count_local)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_const(w, 12)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core_heap::emit_heap_alloc_from_stack(w)
    helpers_core::emit_local_set(w, vec_local)

    helpers_core::emit_local_get(w, vec_local)
    helpers_core::emit_local_get(w, count_local)
    helpers_memory::emit_i32_store_default(w)
    helpers_core::emit_local_get(w, vec_local)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_get(w, count_local)
    helpers_memory::emit_i32_store_default(w)
    helpers_core::emit_local_get(w, vec_local)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_get(w, vec_local)
    helpers_numeric_i32::emit_i32_const(w, 12)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_store_default(w)
}

fn emit_chars_fill(
    w: WasmWriter,
    src_local: i32,
    slen_local: i32,
    vec_local: i32,
    pos_local: i32,
    width_local: i32,
    segidx_local: i32,
    copy_local: i32,
    byte_local: i32,
    str_base_local: i32,
    str_data_local: i32
) {
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_core::emit_local_set(w, segidx_local)
    helpers_core::emit_local_get(w, slen_local)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_numeric_i32::emit_i32_eq(w)
    helpers_control::emit_if_empty(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_core::emit_local_set(w, width_local)
    emit_chars_alloc_string(w, width_local, str_base_local, str_data_local)
    emit_chars_store_element(w, vec_local, segidx_local, str_data_local)
    helpers_control::emit_else(w)
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_core::emit_local_set(w, pos_local)
    helpers_control::emit_block_loop_header(w)
    helpers_core::emit_local_get(w, pos_local)
    helpers_core::emit_local_get(w, slen_local)
    helpers_numeric_i32::emit_i32_ge_s(w)
    helpers_control::emit_br_if(w, 1)
    emit_chars_load_byte(w, src_local, pos_local, byte_local)
    emit_chars_scalar_width(w, byte_local, pos_local, slen_local, width_local)
    emit_chars_alloc_string(w, width_local, str_base_local, str_data_local)
    emit_chars_copy_scalar(w, src_local, pos_local, str_data_local, width_local, copy_local)
    emit_chars_store_element(w, vec_local, segidx_local, str_data_local)
    helpers_core::emit_local_get(w, pos_local)
    helpers_core::emit_local_get(w, width_local)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, pos_local)
    helpers_core::emit_local_get(w, segidx_local)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, segidx_local)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
}

fn emit_chars_load_byte(w: WasmWriter, src_local: i32, pos_local: i32, byte_local: i32) {
    helpers_core::emit_local_get(w, src_local)
    helpers_core::emit_local_get(w, pos_local)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load8_u_default(w)
    helpers_core::emit_local_set(w, byte_local)
}

fn emit_chars_scalar_width(w: WasmWriter, byte_local: i32, pos_local: i32, slen_local: i32, width_local: i32) {
    helpers_core::emit_local_get(w, byte_local)
    helpers_numeric_i32::emit_i32_const(w, 128)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_core::emit_local_set(w, width_local)
    helpers_control::emit_else(w)
    helpers_core::emit_local_get(w, byte_local)
    helpers_numeric_i32::emit_i32_const(w, 224)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    helpers_numeric_i32::emit_i32_const(w, 2)
    helpers_core::emit_local_set(w, width_local)
    helpers_control::emit_else(w)
    helpers_core::emit_local_get(w, byte_local)
    helpers_numeric_i32::emit_i32_const(w, 240)
    helpers_numeric_i32::emit_i32_lt_s(w)
    helpers_control::emit_if_empty(w)
    helpers_numeric_i32::emit_i32_const(w, 3)
    helpers_core::emit_local_set(w, width_local)
    helpers_control::emit_else(w)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_core::emit_local_set(w, width_local)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
    helpers_core::emit_local_get(w, pos_local)
    helpers_core::emit_local_get(w, width_local)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_get(w, slen_local)
    helpers_numeric_i32::emit_i32_gt_s(w)
    helpers_control::emit_if_empty(w)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_core::emit_local_set(w, width_local)
    helpers_control::emit_end(w)
}

fn emit_chars_alloc_string(w: WasmWriter, width_local: i32, base_local: i32, data_local: i32) {
    helpers_core::emit_local_get(w, width_local)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core_heap::emit_heap_alloc_from_stack(w)
    helpers_core::emit_local_set(w, base_local)
    helpers_core::emit_local_get(w, base_local)
    helpers_core::emit_local_get(w, width_local)
    helpers_memory::emit_i32_store_default(w)
    helpers_core::emit_local_get(w, base_local)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, data_local)
}

fn emit_chars_copy_scalar(w: WasmWriter, src_local: i32, pos_local: i32, data_local: i32, width_local: i32, copy_local: i32) {
    helpers_numeric_i32::emit_i32_const(w, 0)
    helpers_core::emit_local_set(w, copy_local)
    helpers_control::emit_block_loop_header(w)
    helpers_core::emit_local_get(w, copy_local)
    helpers_core::emit_local_get(w, width_local)
    helpers_numeric_i32::emit_i32_ge_s(w)
    helpers_control::emit_br_if(w, 1)
    helpers_core::emit_local_get(w, data_local)
    helpers_core::emit_local_get(w, copy_local)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_get(w, src_local)
    helpers_core::emit_local_get(w, pos_local)
    helpers_core::emit_local_get(w, copy_local)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load8_u_default(w)
    helpers_memory::emit_i32_store8_default(w)
    helpers_core::emit_local_get(w, copy_local)
    helpers_numeric_i32::emit_i32_const(w, 1)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_set(w, copy_local)
    helpers_control::emit_br(w, 0)
    helpers_control::emit_end(w)
    helpers_control::emit_end(w)
}

fn emit_chars_store_element(w: WasmWriter, vec_local: i32, index_local: i32, data_local: i32) {
    helpers_core::emit_local_get(w, vec_local)
    helpers_numeric_i32::emit_i32_const(w, 8)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_memory::emit_i32_load_default(w)
    helpers_core::emit_local_get(w, index_local)
    helpers_numeric_i32::emit_i32_const(w, 4)
    helpers_numeric_i32::emit_i32_mul(w)
    helpers_numeric_i32::emit_i32_add(w)
    helpers_core::emit_local_get(w, data_local)
    helpers_memory::emit_i32_store_default(w)
}
