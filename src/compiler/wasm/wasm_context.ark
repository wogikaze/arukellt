use wasm::strings
use wasm::ctx_fid_map
use wasm::ctx_record

fn emit_wasm_context_new(
    mir: MirModule,
    functions: Vec<MirFunction>,
    strings: EmitStringTablePlan,
    target: String,
    wasi_version: String,
    memory64: bool,
    source_file: String
) -> SelfEmitCtx {
    ctx_record::SelfEmitCtx_new(
        mir,
        functions,
        strings::EmitStringTablePlan_true_idx(strings),
        strings::EmitStringTablePlan_false_idx(strings),
        target,
        wasi_version,
        memory64,
        source_file
    )
}

fn emit_wasm_context_set_gc_type_base(ctx: SelfEmitCtx, gc_type_base: i32) {
    ctx_record::SelfEmitCtx_set_gc_type_base(ctx, gc_type_base)
}

fn emit_wasm_context_set_gc_enum_variant_base(ctx: SelfEmitCtx, gc_enum_variant_base: i32) {
    ctx_record::SelfEmitCtx_set_gc_enum_variant_base(ctx, gc_enum_variant_base)
}

fn emit_wasm_context_set_gc_enum_variant_names(ctx: SelfEmitCtx, gc_enum_variant_names: Vec<String>) {
    ctx_record::SelfEmitCtx_set_gc_enum_variant_names(ctx, gc_enum_variant_names)
}

fn emit_wasm_context_set_gc_enum_variant_sigs(ctx: SelfEmitCtx, gc_enum_variant_sigs: Vec<String>) {
    ctx_record::SelfEmitCtx_set_gc_enum_variant_sigs(ctx, gc_enum_variant_sigs)
}

fn emit_wasm_context_set_gc_struct_base(ctx: SelfEmitCtx, gc_struct_base: i32) {
    ctx_record::SelfEmitCtx_set_gc_struct_base(ctx, gc_struct_base)
}

fn emit_wasm_context_set_gc_struct_names(ctx: SelfEmitCtx, gc_struct_names: Vec<String>) {
    ctx_record::SelfEmitCtx_set_gc_struct_names(ctx, gc_struct_names)
}

fn emit_wasm_context_set_gc_struct_sigs(ctx: SelfEmitCtx, gc_struct_sigs: Vec<String>) {
    ctx_record::SelfEmitCtx_set_gc_struct_sigs(ctx, gc_struct_sigs)
}

fn emit_wasm_context_finalize_gc_indexes(ctx: SelfEmitCtx) {
    ctx_record::SelfEmitCtx_finalize_gc_derived_indexes(ctx)
}

fn emit_wasm_context_set_pair_call_sigs(ctx: SelfEmitCtx, sigs: Vec<String>) {
    ctx_record::SelfEmitCtx_set_pair_call_sigs(ctx, sigs)
}

fn emit_wasm_context_set_signature_spine(ctx: SelfEmitCtx, registry: SignatureRegistry, table: TypeTable, mono_table: MonoInstanceTable, spine_populated: bool) {
    ctx_record::SelfEmitCtx_set_signature_registry(ctx, registry)
    ctx_record::SelfEmitCtx_set_type_table(ctx, table)
    ctx_record::SelfEmitCtx_set_mono_instance_table(ctx, mono_table)
    ctx_record::SelfEmitCtx_set_spine_populated(ctx, spine_populated)
    if spine_populated {
        ctx_fid_map::SelfEmitCtx_build_fid_to_mir(ctx)
    }
    // The rebuild consumes the full function vec wholesale; the live
    // consumption chains from bind_spine_incremental are now stale.
    ctx.fid_chains_live = false
}

fn emit_wasm_context_set_gc_layout_table(ctx: SelfEmitCtx, gc_layout_table: GcLayoutTable) {
    ctx_record::SelfEmitCtx_set_gc_layout_table(ctx, gc_layout_table)
}
