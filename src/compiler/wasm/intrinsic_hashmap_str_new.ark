use wasm::opcodes
use wasm::ctx_scratch
use wasm::ctx_record
use wasm::emit_target
use wasm::writer_core
use wasm::writer_gc
use wasm::ctx_gc_type
use wasm::ctx_gc_type_vec_ref
use wasm::intrinsic_hashmap_str_lm_helpers
use wasm::intrinsics::helpers_numeric_i32_convert
use wasm::inst_ctx
use wasm::inst_store
use wasm::function_indices

fn hm_default_table_capacity() -> i32 {
    16
}

fn emit_hm_call_flat_runtime(mut w: WasmWriter, ctx: SelfEmitCtx, fn_name: String, wit_import_count: i32) {
    let fn_idx = inst_ctx::resolve_fn_index(ctx, fn_name)
    writer_core::emit_byte(w, opcodes::OP_CALL())
    writer_core::emit_leb128_u(
        w,
        function_indices::defined_function_index(
            fn_idx,
            ctx_record::SelfEmitCtx_target(ctx),
            ctx_record::SelfEmitCtx_wasi_version(ctx),
            wit_import_count
        )
    )
}

fn emit_hm_si_new(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32, wit_import_count: i32) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        emit_hm_si_new_gc(w, ctx, 0 - 1)
    } else {
        emit_hm_call_flat_runtime(w, ctx, "hashmap_new", wit_import_count)
    }
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
}

// __hm_*_new_with_cap(cap): the caller's capacity replaces the baked-in
// default so Ark-side growth can allocate a larger donor table (#895).
fn emit_hm_si_new_with_cap(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32, wit_import_count: i32) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        let s_cap = ctx_scratch::SelfEmitCtx_scratch_base(ctx)
        writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
        writer_core::emit_leb128_u(w, s_cap)
        emit_hm_si_new_gc(w, ctx, s_cap)
    } else {
        // The cap arg is already on the stack for hashmap_with_capacity.
        emit_hm_call_flat_runtime(w, ctx, "hashmap_with_capacity", wit_import_count)
    }
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
}

fn emit_hm_si_new_gc(mut w: WasmWriter, ctx: SelfEmitCtx, cap_local: i32) {
    let hm_type = ctx_gc_type::SelfEmitCtx_hashmap_str_i32_type(ctx)
    let i32_array_type = ctx_gc_type::SelfEmitCtx_i32_array_type(ctx)
    let string_ref_array_type = ctx_gc_type::SelfEmitCtx_string_ref_array_type(ctx)
    let s_keys = ctx_scratch::SelfEmitCtx_scratch_gc_string_ref_array_local(ctx, 0)
    let s_vals = ctx_scratch::SelfEmitCtx_scratch_gc_i32_array_local(ctx, 0)
    let s_flags = ctx_scratch::SelfEmitCtx_scratch_gc_i32_array_local(ctx, 1)

    emit_hm_struct_new_gc(w, ctx, hm_type, string_ref_array_type, i32_array_type, i32_array_type, s_keys, s_vals, s_flags, cap_local)
}

fn emit_hm_struct_new_gc(
    mut w: WasmWriter,
    ctx: SelfEmitCtx,
    hm_type: i32,
    keys_array_type: i32,
    vals_array_type: i32,
    flags_array_type: i32,
    s_keys: i32,
    s_vals: i32,
    s_flags: i32,
    cap_local: i32
) {
    emit_hm_struct_new_gc_array(w, keys_array_type, s_keys, cap_local)
    emit_hm_struct_new_gc_array(w, vals_array_type, s_vals, cap_local)
    emit_hm_struct_new_gc_array(w, flags_array_type, s_flags, cap_local)
    emit_hm_struct_new_gc_final(w, hm_type, keys_array_type, vals_array_type, flags_array_type, s_keys, s_vals, s_flags, cap_local)
}

fn emit_hm_struct_new_gc_array(mut w: WasmWriter, array_type: i32, s_local: i32, cap_local: i32) {
    if cap_local >= 0 {
        writer_core::emit_local_get(w, cap_local)
        writer_gc::emit_gc_array_new_from_widened(w, array_type)
    } else {
        writer_core::emit_byte(w, opcodes::OP_I32_CONST())
        writer_core::emit_leb128_s(w, hm_default_table_capacity())
        writer_gc::emit_gc_array_new(w, array_type)
    }
    writer_gc::emit_gc_ref_cast(w, array_type)
    writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
    writer_core::emit_leb128_u(w, s_local)
}

fn emit_hm_struct_new_gc_final(mut w: WasmWriter, hm_type: i32, keys_array_type: i32, vals_array_type: i32, flags_array_type: i32, s_keys: i32, s_vals: i32, s_flags: i32, cap_local: i32) {
    if cap_local >= 0 {
        writer_core::emit_local_get(w, cap_local)
        helpers_numeric_i32_convert::emit_narrow_i64_operand(w)
    } else {
        writer_core::emit_byte(w, opcodes::OP_I32_CONST())
        writer_core::emit_leb128_s(w, hm_default_table_capacity())
    }
    writer_core::emit_byte(w, opcodes::OP_I32_CONST())
    writer_core::emit_leb128_s(w, 0)
    writer_core::emit_local_get(w, s_keys)
    writer_gc::emit_gc_ref_cast(w, keys_array_type)
    writer_core::emit_local_get(w, s_vals)
    writer_gc::emit_gc_ref_cast(w, vals_array_type)
    writer_core::emit_local_get(w, s_flags)
    writer_gc::emit_gc_ref_cast(w, flags_array_type)
    writer_gc::emit_gc_struct_new(w, hm_type)
}

fn emit_hm_is_new(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32, wit_import_count: i32) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        emit_hm_is_new_gc(w, ctx, 0 - 1)
    } else {
        emit_hm_call_flat_runtime(w, ctx, "hashmap_new", wit_import_count)
    }
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
}

fn emit_hm_is_new_with_cap(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32, wit_import_count: i32) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        let s_cap = ctx_scratch::SelfEmitCtx_scratch_base(ctx)
        writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
        writer_core::emit_leb128_u(w, s_cap)
        emit_hm_is_new_gc(w, ctx, s_cap)
    } else {
        emit_hm_call_flat_runtime(w, ctx, "hashmap_with_capacity", wit_import_count)
    }
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
}

fn emit_hm_is_new_gc(mut w: WasmWriter, ctx: SelfEmitCtx, cap_local: i32) {
    let hm_type = ctx_gc_type::SelfEmitCtx_hashmap_i32_str_type(ctx)
    let i32_array_type = ctx_gc_type::SelfEmitCtx_i32_array_type(ctx)
    let string_ref_array_type = ctx_gc_type::SelfEmitCtx_string_ref_array_type(ctx)
    let s_keys = ctx_scratch::SelfEmitCtx_scratch_gc_i32_array_local(ctx, 0)
    let s_vals = ctx_scratch::SelfEmitCtx_scratch_gc_string_ref_array_local(ctx, 0)
    let s_flags = ctx_scratch::SelfEmitCtx_scratch_gc_i32_array_local(ctx, 1)

    emit_hm_struct_new_gc(w, ctx, hm_type, i32_array_type, string_ref_array_type, i32_array_type, s_keys, s_vals, s_flags, cap_local)
}

fn emit_hm_if_new(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32, wit_import_count: i32) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        emit_hm_if_new_gc(w, ctx, 0 - 1)
    } else {
        // A fn value is a {fnptr, env} pair pointer under the managed
        // closure ABI (#872): one i32 slot on linear, so the shared flat
        // hashmap runtime works unchanged (#874).
        emit_hm_call_flat_runtime(w, ctx, "hashmap_new", wit_import_count)
    }
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
}

fn emit_hm_if_new_with_cap(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32, wit_import_count: i32) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        let s_cap = ctx_scratch::SelfEmitCtx_scratch_base(ctx)
        writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
        writer_core::emit_leb128_u(w, s_cap)
        emit_hm_if_new_gc(w, ctx, s_cap)
    } else {
        emit_hm_call_flat_runtime(w, ctx, "hashmap_with_capacity", wit_import_count)
    }
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
}

fn emit_hm_if_new_gc(mut w: WasmWriter, ctx: SelfEmitCtx, cap_local: i32) {
    let hm_type = ctx_gc_type::SelfEmitCtx_hashmap_i32_fn_type(ctx)
    let i32_array_type = ctx_gc_type::SelfEmitCtx_i32_array_type(ctx)
    let fnref_array_type = ctx_gc_type_vec_ref::SelfEmitCtx_fnref_array_type(ctx)
    let s_keys = ctx_scratch::SelfEmitCtx_scratch_gc_i32_array_local(ctx, 0)
    let s_vals = ctx_scratch::SelfEmitCtx_scratch_gc_fnref_array_local(ctx, 0)
    let s_flags = ctx_scratch::SelfEmitCtx_scratch_gc_i32_array_local(ctx, 1)

    emit_hm_struct_new_gc(w, ctx, hm_type, i32_array_type, fnref_array_type, i32_array_type, s_keys, s_vals, s_flags, cap_local)
}

fn emit_hm_sf_new(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32, wit_import_count: i32) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        emit_hm_sf_new_gc(w, ctx, 0 - 1)
    } else {
        // Same pair-pointer storage as HashMap<i32,fn> on linear (#874).
        emit_hm_call_flat_runtime(w, ctx, "hashmap_new", wit_import_count)
    }
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, true)
}

