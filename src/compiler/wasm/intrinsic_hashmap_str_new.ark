// __hm_*_adopt(dst, src): move src's backing storage onto dst so Ark-side
// growth can replace a live map's table without changing the map's
// identity for existing references (#895). The donor keeps stale refs to
// the same arrays and must not be used afterwards — the grow helper drops
// it immediately. GC copies the five struct fields; linear copies the
// three-word Vec header {len, cap, data}.
fn emit_hm_adopt(mut w: WasmWriter, inst: MirInst, ctx: SelfEmitCtx, next_op: i32, next_arg0: i32, next_arg1: i32, next2_op: i32, hm_type: i32) {
    if emit_target::is_gc_target(ctx_record::SelfEmitCtx_target(ctx)) {
        let s_src = ctx_scratch::SelfEmitCtx_scratch_gc_struct_ref_val_local(ctx, 0)
        writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
        writer_core::emit_leb128_u(w, s_src)
        let s_dst = ctx_scratch::SelfEmitCtx_scratch_gc_vec_local(ctx, 0)
        writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
        writer_core::emit_leb128_u(w, s_dst)
        emit_hm_adopt_fields_gc(w, hm_type, s_dst, s_src)
    } else {
        let s_src = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 8)
        writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
        writer_core::emit_leb128_u(w, s_src)
        let s_dst = ctx_scratch::SelfEmitCtx_scratch_local(ctx, 9)
        writer_core::emit_byte(w, opcodes::OP_LOCAL_SET())
        writer_core::emit_leb128_u(w, s_dst)
        intrinsic_hashmap_str_lm_helpers::emit_lm_header_adopt(w, s_dst, s_src)
    }
    inst_store::emit_store_result_if_needed(w, inst, next_op, next_arg0, next_arg1, next2_op, false)
}

fn emit_hm_adopt_fields_gc(mut w: WasmWriter, hm_type: i32, s_dst: i32, s_src: i32) {
    emit_hm_adopt_field_gc(w, hm_type, s_dst, s_src, 0, true)
    emit_hm_adopt_field_gc(w, hm_type, s_dst, s_src, 1, true)
    emit_hm_adopt_field_gc(w, hm_type, s_dst, s_src, 2, false)
    emit_hm_adopt_field_gc(w, hm_type, s_dst, s_src, 3, false)
    emit_hm_adopt_field_gc(w, hm_type, s_dst, s_src, 4, false)
}

fn emit_hm_adopt_field_gc(mut w: WasmWriter, hm_type: i32, s_dst: i32, s_src: i32, field_idx: i32, is_i32_field: bool) {
    writer_core::emit_local_get(w, s_dst)
    writer_gc::emit_gc_ref_cast(w, hm_type)
    writer_core::emit_local_get(w, s_src)
    writer_gc::emit_gc_ref_cast(w, hm_type)
    if is_i32_field {
        writer_gc::emit_gc_struct_get_i32(w, hm_type, field_idx)
        writer_gc::emit_gc_struct_set_i32(w, hm_type, field_idx)
    } else {
        writer_gc::emit_gc_struct_get(w, hm_type, field_idx)
        writer_gc::emit_gc_struct_set(w, hm_type, field_idx)
    }
}
