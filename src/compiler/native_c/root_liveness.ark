// CFG-complete reference-local liveness for native-cpp GC root clears.
// Phase 1: plan clears from emitter-recorded instruction effects; do not emit clears yet.
// enable_root_clears stays false until Phase 3 (#833).

use mir::block_inst_access
use mir::function_block_queries
use mir::function_locals_view
use mir::inst_accessors_shape
use mir::opcodes

pub struct NativeCRootClearPlan {
    // Parallel to emit order (all instructions); non-safepoint entries have count 0.
    clear_start: Vec<i32>,
    clear_count: Vec<i32>,
    clear_locals: Vec<i32>,
    instruction_count: i32,
    functions_analyzed: i32,
    functions_skipped: i32,
    reference_local_count: i32,
    // Assignments = individual local clears; sites = safepoints with ≥1 clear.
    cleared_root_count: i32,
    clear_site_count: i32,
    safepoint_count: i32,
    peak_live_slots: i32,
    planner_bytes_est: i32,
    converged: bool,
    reject_diagnostic: String,
}

pub struct NativeCInstructionEffects {
    // Flat parallel arrays, one entry per emitted instruction in order.
    block_ids: Vec<i32>,
    reachable: Vec<i32>,
    is_safepoint: Vec<i32>,
    use_start: Vec<i32>,
    use_count: Vec<i32>,
    use_locals: Vec<i32>,
    def_start: Vec<i32>,
    def_count: Vec<i32>,
    def_locals: Vec<i32>,
}

fn native_c_root_clear_plan_empty() -> NativeCRootClearPlan {
    NativeCRootClearPlan {
        clear_start: Vec_new_i32(),
        clear_count: Vec_new_i32(),
        clear_locals: Vec_new_i32(),
        instruction_count: 0,
        functions_analyzed: 0,
        functions_skipped: 0,
        reference_local_count: 0,
        cleared_root_count: 0,
        clear_site_count: 0,
        safepoint_count: 0,
        peak_live_slots: 0,
        planner_bytes_est: 0,
        converged: true,
        reject_diagnostic: String_new(),
    }
}

fn native_c_instruction_effects_new() -> NativeCInstructionEffects {
    NativeCInstructionEffects {
        block_ids: Vec_new_i32(),
        reachable: Vec_new_i32(),
        is_safepoint: Vec_new_i32(),
        use_start: Vec_new_i32(),
        use_count: Vec_new_i32(),
        use_locals: Vec_new_i32(),
        def_start: Vec_new_i32(),
        def_count: Vec_new_i32(),
        def_locals: Vec_new_i32(),
    }
}

/// SSOT: MIR opcodes that may allocate or collect during native-cpp lowering.
fn native_c_is_safepoint_op(op: i32) -> bool {
    if op == opcodes::MIR_CONST_STRING() { return true }
    if op == opcodes::MIR_STRUCT_NEW() { return true }
    if op == opcodes::MIR_GC_STRUCT_NEW() { return true }
    if op == opcodes::MIR_ARRAY_NEW() { return true }
    if op == opcodes::MIR_CALL() { return true }
    if op == opcodes::MIR_CALL_INDIRECT() { return true }
    if op == opcodes::MIR_WIT_CALL() { return true }
    false
}

fn native_c_bitset_new(width: i32) -> Vec<i32> {
    let bits = Vec_new_i32()
    let mut index = 0
    while index < width {
        push(bits, 0)
        index = index + 1
    }
    bits
}

fn native_c_bitset_clear(bits: Vec<i32>) {
    let mut index = 0
    while index < len(bits) {
        set(bits, index, 0)
        index = index + 1
    }
}

fn native_c_bitset_set_ref(bits: Vec<i32>, local: i32, reference_locals: Vec<i32>) {
    if local < 0 || local >= len(bits) { return }
    if local >= len(reference_locals) { return }
    if get_unchecked(reference_locals, local) == 0 { return }
    set(bits, local, 1)
}

fn native_c_effects_push(
    effects: NativeCInstructionEffects,
    block_id: i32,
    reachable: bool,
    is_safepoint: bool,
    uses: Vec<i32>,
    defs: Vec<i32>
) {
    push(effects.block_ids, block_id)
    if reachable { push(effects.reachable, 1) } else { push(effects.reachable, 0) }
    if is_safepoint { push(effects.is_safepoint, 1) } else { push(effects.is_safepoint, 0) }
    push(effects.use_start, len(effects.use_locals))
    push(effects.use_count, len(uses))
    let mut index = 0
    while index < len(uses) {
        push(effects.use_locals, get_unchecked(uses, index))
        index = index + 1
    }
    push(effects.def_start, len(effects.def_locals))
    push(effects.def_count, len(defs))
    index = 0
    while index < len(defs) {
        push(effects.def_locals, get_unchecked(defs, index))
        index = index + 1
    }
}

/// True when MIR uses structured control. ADR-024: lowering leaves succ0/succ1
/// unset, so block-CFG liveness is unsound; emit clears only for straight-line.
fn native_c_function_has_structured_control(function: MirFunction) -> bool {
    let block_count = function_block_queries::MirFunction_block_count(function)
    let mut block_index = 0
    while block_index < block_count {
        let block = function_block_queries::MirFunction_block_at(function, block_index)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut inst_index = 0
        while inst_index < inst_count {
            let op = inst_accessors_shape::MirInst_op(
                block_inst_access::MirBlock_inst_at(block, inst_index)
            )
            if op == opcodes::MIR_IF() || op == opcodes::MIR_ELSE() ||
            op == opcodes::MIR_LOOP() || op == opcodes::MIR_BLOCK() ||
            op == opcodes::MIR_BR() || op == opcodes::MIR_BR_IF() ||
            op == opcodes::MIR_END() {
                return true
            }
            if op == opcodes::MIR_PHI() {
                return true
            }
            inst_index = inst_index + 1
        }
        block_index = block_index + 1
    }
    false
}

fn native_c_plan_root_clears_from_effects(
    function: MirFunction,
    reference_locals: Vec<i32>,
    effects: NativeCInstructionEffects
) -> NativeCRootClearPlan {
    let plan = native_c_root_clear_plan_empty()
    plan.functions_analyzed = 1
    let block_count = function_block_queries::MirFunction_block_count(function)
    let mut phi_block = 0
    while phi_block < block_count {
        let block = function_block_queries::MirFunction_block_at(function, phi_block)
        let inst_count = block_inst_access::MirBlock_inst_count(block)
        let mut inst_index = 0
        while inst_index < inst_count {
            if inst_accessors_shape::MirInst_op(
                block_inst_access::MirBlock_inst_at(block, inst_index)
            ) == opcodes::MIR_PHI() {
                plan.functions_skipped = 1
                plan.converged = false
                plan.reject_diagnostic = String_from(
                    "compiler ICE: native-cpp root liveness rejects MIR_PHI"
                )
                return plan
            }
            inst_index = inst_index + 1
        }
        phi_block = phi_block + 1
    }
    let local_count = function_locals_view::MirFunction_local_count(function)
    let mut reference_count = 0
    let mut local_index = 0
    while local_index < local_count && local_index < len(reference_locals) {
        if get_unchecked(reference_locals, local_index) != 0 {
            reference_count = reference_count + 1
        }
        local_index = local_index + 1
    }
    plan.reference_local_count = reference_count
    let instruction_total = len(effects.block_ids)
    plan.instruction_count = instruction_total
    let mut pad = 0
    while pad < instruction_total {
        push(plan.clear_start, 0)
        push(plan.clear_count, 0)
        pad = pad + 1
    }
    if reference_count == 0 || instruction_total == 0 {
        return plan
    }

    // Straight-line reverse scan. Structured control is not emitted until CFG
    // successors exist (ADR-024); reverse-linear would mis-clear loop-carried refs.
    let has_control = native_c_function_has_structured_control(function)
    let store_clear_locals = !has_control &&
    native_c_root_clear_emit_allowed(block_count, reference_count)
    plan.planner_bytes_est = local_count * 12
    plan.converged = true

    let live = native_c_bitset_new(local_count)
    let use_bits = native_c_bitset_new(local_count)
    let def_bits = native_c_bitset_new(local_count)
    let mut absolute = instruction_total - 1
    while absolute >= 0 {
        native_c_bitset_clear(use_bits)
        native_c_bitset_clear(def_bits)
        let use_start = get_unchecked(effects.use_start, absolute)
        let use_n = get_unchecked(effects.use_count, absolute)
        let mut u = 0
        while u < use_n {
            native_c_bitset_set_ref(
                use_bits,
                get_unchecked(effects.use_locals, use_start + u),
                reference_locals
            )
            u = u + 1
        }
        let def_start = get_unchecked(effects.def_start, absolute)
        let def_n = get_unchecked(effects.def_count, absolute)
        let mut d = 0
        while d < def_n {
            native_c_bitset_set_ref(
                def_bits,
                get_unchecked(effects.def_locals, def_start + d),
                reference_locals
            )
            d = d + 1
        }
        // Plan clears from live_after ∪ uses (do not clear current operands or
        // values still needed later in straight-line order).
        if get_unchecked(effects.reachable, absolute) != 0 &&
        get_unchecked(effects.is_safepoint, absolute) != 0 {
            plan.safepoint_count = plan.safepoint_count + 1
            let clear_at = len(plan.clear_locals)
            set(plan.clear_start, absolute, clear_at)
            let mut clear_n = 0
            local_index = 0
            while local_index < local_count {
                if get_unchecked(reference_locals, local_index) != 0 &&
                get_unchecked(live, local_index) == 0 &&
                get_unchecked(use_bits, local_index) == 0 {
                    if store_clear_locals {
                        push(plan.clear_locals, local_index)
                    }
                    // Count planned clears for straight-line only; control-flow
                    // functions keep assigns_planned=0 so rollout stats stay honest.
                    if !has_control {
                        clear_n = clear_n + 1
                        plan.cleared_root_count = plan.cleared_root_count + 1
                    }
                }
                local_index = local_index + 1
            }
            set(plan.clear_count, absolute, clear_n)
            if clear_n > 0 {
                plan.clear_site_count = plan.clear_site_count + 1
            }
        }
        // live_before = (live_after - def) ∪ use
        local_index = 0
        while local_index < local_count {
            if get_unchecked(def_bits, local_index) != 0 {
                set(live, local_index, 0)
            }
            if get_unchecked(use_bits, local_index) != 0 {
                set(live, local_index, 1)
            }
            local_index = local_index + 1
        }
        let mut live_slots = 0
        local_index = 0
        while local_index < local_count {
            if get_unchecked(reference_locals, local_index) != 0 &&
            get_unchecked(live, local_index) != 0 {
                live_slots = live_slots + 1
            }
            local_index = local_index + 1
        }
        if live_slots > plan.peak_live_slots {
            plan.peak_live_slots = live_slots
        }
        absolute = absolute - 1
    }
    plan
}

// Compatibility wrapper: empty effects → no clears planned (legacy call sites).
fn native_c_plan_root_clears(
    function: MirFunction,
    reference_locals: Vec<i32>
) -> NativeCRootClearPlan {
    native_c_plan_root_clears_from_effects(
        function,
        reference_locals,
        native_c_instruction_effects_new()
    )
}

fn native_c_root_clear_plan_start(plan: NativeCRootClearPlan) -> Vec<i32> {
    plan.clear_start
}

fn native_c_root_clear_plan_counts(plan: NativeCRootClearPlan) -> Vec<i32> {
    plan.clear_count
}

fn native_c_root_clear_plan_locals(plan: NativeCRootClearPlan) -> Vec<i32> {
    plan.clear_locals
}

fn native_c_root_clear_plan_cleared_count(plan: NativeCRootClearPlan) -> i32 {
    plan.cleared_root_count
}

fn native_c_root_clear_plan_site_count(plan: NativeCRootClearPlan) -> i32 {
    plan.clear_site_count
}

fn native_c_root_clear_plan_safepoint_count(plan: NativeCRootClearPlan) -> i32 {
    plan.safepoint_count
}

fn native_c_root_clear_plan_functions_analyzed(plan: NativeCRootClearPlan) -> i32 {
    plan.functions_analyzed
}

fn native_c_root_clear_plan_functions_skipped(plan: NativeCRootClearPlan) -> i32 {
    plan.functions_skipped
}

fn native_c_root_clear_plan_converged(plan: NativeCRootClearPlan) -> bool {
    plan.converged
}

fn native_c_root_clear_plan_peak_slots(plan: NativeCRootClearPlan) -> i32 {
    plan.peak_live_slots
}

fn native_c_root_clear_plan_planner_bytes(plan: NativeCRootClearPlan) -> i32 {
    plan.planner_bytes_est
}

/// Emit rollout mode: 0=shadow only, 1=size-gated / full emit (Phase 3+).
fn native_c_root_clear_emit_mode() -> i32 {
    // ADR-024: MIR succ0/succ1 are unset. Straight-line emit still caused
    // String::clone(NULL) in compiler helpers — keep shadow-only until
    // structured-control CFG liveness is wired (Phase 3).
    0
}

/// 0 means unlimited. Stage A starts at 8 / 16; raised through Stages B–D.
fn native_c_root_clear_emit_max_blocks() -> i32 {
    8
}

fn native_c_root_clear_emit_max_refs() -> i32 {
    16
}

fn native_c_root_clear_emit_enabled() -> bool {
    native_c_root_clear_emit_mode() != 0
}

fn native_c_root_clear_emit_allowed(block_count: i32, reference_count: i32) -> bool {
    if !native_c_root_clear_emit_enabled() {
        return false
    }
    let max_blocks = native_c_root_clear_emit_max_blocks()
    let max_refs = native_c_root_clear_emit_max_refs()
    if max_blocks > 0 && block_count > max_blocks {
        return false
    }
    if max_refs > 0 && reference_count > max_refs {
        return false
    }
    true
}

test mod "native_c_root_liveness_safepoint_ssot" {
    test "const_string_is_safepoint" {
        assert(native_c_is_safepoint_op(opcodes::MIR_CONST_STRING()))
    }
    test "struct_new_is_safepoint" {
        assert(native_c_is_safepoint_op(opcodes::MIR_STRUCT_NEW()))
    }
    test "call_is_safepoint" {
        assert(native_c_is_safepoint_op(opcodes::MIR_CALL()))
    }
    test "local_get_is_not_safepoint" {
        assert(!native_c_is_safepoint_op(opcodes::MIR_LOCAL_GET()))
    }
    test "emit_mode_shadow_only_until_structured_cfg" {
        assert(!native_c_root_clear_emit_enabled())
        assert(!native_c_root_clear_emit_allowed(8, 16))
    }
}
