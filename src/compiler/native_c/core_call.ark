use corehir::core_op_registry_generated
use corehir::mir_value_type
use corehir::type_id
use mir::core_op_call
use mir::function_identity
use mir::function_locals_view
use mir::inst_accessors_literals
use mir::inst_accessors_operands
use mir::local_record
use mir::value_types
use native_c::abi
use native_c::enum_abi

struct NativeCCoreCall {
    handled: bool,
    expression: String,
    diagnostic: String,
}

fn native_c_core_call_not_handled() -> NativeCCoreCall {
    NativeCCoreCall { handled: false, expression: String_new(), diagnostic: String_new() }
}

fn native_c_core_call_expression(expression: String) -> NativeCCoreCall {
    NativeCCoreCall { handled: true, expression: expression, diagnostic: String_new() }
}

fn native_c_core_call_error(diagnostic: String) -> NativeCCoreCall {
    NativeCCoreCall { handled: true, expression: String_new(), diagnostic: diagnostic }
}

fn native_c_core_call_is_handled(call: NativeCCoreCall) -> bool { call.handled }
fn native_c_core_call_source(call: NativeCCoreCall) -> String { clone(call.expression) }
fn native_c_core_call_diagnostic(call: NativeCCoreCall) -> String { clone(call.diagnostic) }

fn native_c_core_call_result_is_receiver(mir_module: MirModule, instruction: MirInst) -> bool {
    // Native runtime mutators return ark_unit, but MIR/Wasm treat push as
    // returning the vector for field/init expressions. Re-materialize arg0.
    let handler = core_op_call::mir_call_core_op_index(mir_module, instruction)
    if handler < 0 { return false }
    if handler == core_op_registry_generated::core_op_handler_vec_push() { return true }
    if handler == core_op_registry_generated::core_op_handler_vec_push_f64() { return true }
    if handler == core_op_registry_generated::core_op_handler_vec_push_i64() { return true }
    false
}

fn native_c_core_call_result_is_reference(mir_module: MirModule, instruction: MirInst) -> bool {
    let handler = core_op_call::mir_call_core_op_index(mir_module, instruction)
    if handler < 0 { return false }
    if handler == core_op_registry_generated::core_op_handler_parse_parse_f64() { return true }
    if handler == core_op_registry_generated::core_op_handler_parse_parse_i32() { return true }
    if handler == core_op_registry_generated::core_op_handler_parse_parse_i64() { return true }
    if handler == core_op_registry_generated::core_op_handler_raw_string_clone() { return true }
    if handler == core_op_registry_generated::core_op_handler_raw_string_from_bytes() { return true }
    if handler == core_op_registry_generated::core_op_handler_raw_string_new() { return true }
    if handler == core_op_registry_generated::core_op_handler_runtime_args() { return true }
    if handler == core_op_registry_generated::core_op_handler_runtime_fs_read_file() { return true }
    if handler == core_op_registry_generated::core_op_handler_runtime_read_stdin() { return true }
    if handler == core_op_registry_generated::core_op_handler_runtime_write_bytes() { return true }
    if handler == core_op_registry_generated::core_op_handler_runtime_write_string() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_concat() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_slice() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_trim() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_trim_end() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_trim_start() { return true }
    if handler == core_op_registry_generated::core_op_handler_text_String_new() { return true }
    if handler == core_op_registry_generated::core_op_handler_text_char_to_string() { return true }
    if handler == core_op_registry_generated::core_op_handler_text_clone() { return true }
    if handler == core_op_registry_generated::core_op_handler_text_format_bool() { return true }
    if handler == core_op_registry_generated::core_op_handler_text_format_f64() { return true }
    if handler == core_op_registry_generated::core_op_handler_text_format_i64() { return true }
    if handler == core_op_registry_generated::core_op_handler_text_to_string() { return true }
    if handler == core_op_registry_generated::core_op_handler_vec_Vec_new_f64() ||
    handler == core_op_registry_generated::core_op_handler_vec_Vec_new_fallback() { return true }
    if handler == core_op_registry_generated::core_op_handler_vec_Vec_new_f64() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_replace() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_repeat() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_lines() { return true }
    if handler == core_op_registry_generated::core_op_handler_text_chars() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_split() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_to_lowercase() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_to_uppercase() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_reverse() { return true }
    if handler == core_op_registry_generated::core_op_handler_string_join() { return true }
    if handler == core_op_registry_generated::core_op_handler_text_string_from_bytes() { return true }
    if handler == core_op_registry_generated::core_op_handler_vec_get() { return true }
    // push returns the receiver vector in MIR field/init expressions.
    if handler == core_op_registry_generated::core_op_handler_vec_push() { return true }
    if handler == core_op_registry_generated::core_op_handler_vec_push_f64() { return true }
    if handler == core_op_registry_generated::core_op_handler_vec_push_i64() { return true }
    if handler == core_op_registry_generated::core_op_handler_hashmap_new() { return true }
    if handler == core_op_registry_generated::core_op_handler_hashmap_get() { return true }
    if handler == core_op_registry_generated::core_op_handler_hashmap_remove() { return true }
    false
}

fn native_c_core_arg(arguments: Vec<i32>, index: i32) -> String {
    concat(String_from("ark_v_"), i32_to_string(get_unchecked(arguments, index)))
}

fn native_c_core_ref_arg(arguments: Vec<i32>, index: i32, c_type: String) -> String {
    concat(String_from("("), concat(c_type, concat(String_from(" *)"), native_c_core_arg(arguments, index))))
}

fn native_c_core_value_member(function: MirFunction, local_id: i32) -> String {
    if local_id < 0 || local_id >= function_locals_view::MirFunction_local_count(function) {
        return String_from("i32")
    }
    let local = function_locals_view::MirFunction_local_at(function, local_id)
    let type_name = local_record::mir_local_type_name(local)
    if abi::native_c_type_name_is_funcref(clone(type_name)) {
        return String_from("i64")
    }
    // Named enum/struct payloads may keep VT_I32 while the C local is a heap pointer.
    // Prefer type_name so vec_push/get use .ref instead of .i32.
    if enum_abi::native_c_type_name_is_unit_tag_enum(clone(type_name)) ||
    enum_abi::native_c_type_name_is_unit_tag_enum(
        enum_abi::native_c_type_name_enum_basename(clone(type_name))
    ) {
        return String_from("i32")
    }
    if starts_with(clone(type_name), String_from("enum:")) ||
    starts_with(clone(type_name), String_from("struct:")) ||
    abi::native_c_type_name_is_heap_object(clone(type_name)) ||
    enum_abi::native_c_type_name_is_open_payload_enum(clone(type_name)) {
        return String_from("ref")
    }
    let value_type = local_record::mir_local_val_type(local)
    if value_type == value_types::VT_I64() || value_type == value_types::VT_FUNCREF() {
        return String_from("i64")
    }
    if value_type == value_types::VT_F32() { return String_from("f32") }
    if value_type == value_types::VT_F64() { return String_from("f64") }
    if value_type == value_types::VT_REF() || value_type == value_types::VT_GC_REF() {
        return String_from("ref")
    }
    String_from("i32")
}

fn native_c_core_vec_element_type_name(vec_type: String) -> String {
    if starts_with(clone(vec_type), String_from("vec:")) {
        return substring(vec_type, 4, len(vec_type))
    }
    if starts_with(clone(vec_type), String_from("Vec<")) && ends_with(clone(vec_type), String_from(">")) {
        return substring(vec_type, 4, len(vec_type) - 1)
    }
    String_new()
}

// Prefer Vec element type over stale VT_I32 on named enum/struct values.
fn native_c_core_member_for_vec_element(element_type: String) -> String {
    if len(element_type) == 0 {
        return String_new()
    }
    if abi::native_c_type_name_is_funcref(clone(element_type)) ||
    starts_with(clone(element_type), String_from("fn(")) {
        return String_from("i64")
    }
    if eq(clone(element_type), String_from("i64")) {
        return String_from("i64")
    }
    if eq(clone(element_type), String_from("f32")) {
        return String_from("f32")
    }
    if eq(clone(element_type), String_from("f64")) {
        return String_from("f64")
    }
    if eq(clone(element_type), String_from("i32")) ||
    eq(clone(element_type), String_from("bool")) ||
    eq(clone(element_type), String_from("char")) ||
    enum_abi::native_c_type_name_is_unit_tag_enum(clone(element_type)) ||
    enum_abi::native_c_type_name_is_unit_tag_enum(
        enum_abi::native_c_type_name_enum_basename(clone(element_type))
    ) {
        return String_from("i32")
    }
    String_from("ref")
}

fn native_c_core_override_member_from_vec_local(
    function: MirFunction,
    vec_local: i32,
    member: String
) -> String {
    if vec_local < 0 || vec_local >= function_locals_view::MirFunction_local_count(function) {
        return member
    }
    let vec_type = local_record::mir_local_type_name(
        function_locals_view::MirFunction_local_at(function, vec_local)
    )
    let element = native_c_core_vec_element_type_name(vec_type)
    let override_member = native_c_core_member_for_vec_element(element)
    if len(override_member) == 0 {
        return member
    }
    override_member
}

fn native_c_core_destination_type_id(function: MirFunction, instruction: MirInst) -> i32 {
    let destination = inst_accessors_operands::MirInst_dest(instruction)
    if destination < 0 || destination >= function_locals_view::MirFunction_local_count(function) {
        return 0
    }
    let local = function_locals_view::MirFunction_local_at(function, destination)
    type_id::TypeId_raw(mir_value_type::mir_value_type_type_id(local_record::mir_local_value_type(local)))
}

fn native_c_core_destination_type_name(function: MirFunction, instruction: MirInst) -> String {
    let destination = inst_accessors_operands::MirInst_dest(instruction)
    if destination < 0 || destination >= function_locals_view::MirFunction_local_count(function) {
        return String_new()
    }
    local_record::mir_local_type_name(
        function_locals_view::MirFunction_local_at(function, destination)
    )
}

fn native_c_core_local_type_name(function: MirFunction, local_id: i32) -> String {
    if local_id < 0 || local_id >= function_locals_view::MirFunction_local_count(function) {
        return String_new()
    }
    local_record::mir_local_type_name(
        function_locals_view::MirFunction_local_at(function, local_id)
    )
}

fn native_c_core_hashmap_family_supported(type_name: String) -> bool {
    if starts_with(clone(type_name), String_from("hashmap:i32i32")) {
        return true
    }
    if starts_with(clone(type_name), String_from("hashmap:si32")) {
        return true
    }
    if starts_with(clone(type_name), String_from("hashmap:i32str")) {
        return true
    }
    if starts_with(clone(type_name), String_from("hashmap:strstr")) {
        return true
    }
    false
}

fn native_c_core_hashmap_type_from_callee(callee: String) -> String {
    if eq(clone(callee), String_from("HashMap_i32_i32_new")) {
        return String_from("hashmap:i32i32")
    }
    if eq(clone(callee), String_from("HashMap_new_i32_i32")) {
        return String_from("hashmap:i32i32")
    }
    if eq(clone(callee), String_from("HashMap_new_String_i32")) {
        return String_from("hashmap:si32")
    }
    if eq(clone(callee), String_from("HashMap_String_i32_new")) {
        return String_from("hashmap:si32")
    }
    if eq(clone(callee), String_from("HashMap_new_i32_String")) {
        return String_from("hashmap:i32str")
    }
    if eq(clone(callee), String_from("HashMap_i32_String_new")) {
        return String_from("hashmap:i32str")
    }
    if eq(clone(callee), String_from("HashMap_new_String_String")) {
        return String_from("hashmap:strstr")
    }
    if eq(clone(callee), String_from("HashMap_String_String_new")) {
        return String_from("hashmap:strstr")
    }
    String_new()
}

/// kind: 0 = i32, 1 = String.
fn native_c_core_hashmap_key_kind(type_name: String) -> i32 {
    if starts_with(clone(type_name), String_from("hashmap:si32")) {
        return 1
    }
    if starts_with(clone(type_name), String_from("hashmap:strstr")) {
        return 1
    }
    0
}

/// kind: 0 = i32, 1 = String.
fn native_c_core_hashmap_value_kind(type_name: String) -> i32 {
    if starts_with(clone(type_name), String_from("hashmap:i32str")) {
        return 1
    }
    if starts_with(clone(type_name), String_from("hashmap:strstr")) {
        return 1
    }
    0
}

fn native_c_core_hashmap_value_expr(function: MirFunction, local_id: i32) -> String {
    let member = native_c_core_value_member(function, local_id)
    concat(
        String_from("(ark_value){ ."),
        concat(
            member,
            concat(
                String_from(" = "),
                concat(String_from("ark_v_"), concat(i32_to_string(local_id), String_from(" }")))
            )
        )
    )
}

fn native_c_core_binary_string_call(function_name: String, arguments: Vec<i32>) -> NativeCCoreCall {
    if len(arguments) != 2 {
        return native_c_core_call_error(String_from("compiler ICE: native-cpp String CoreOp argument mismatch"))
    }
    native_c_core_call_expression(
        concat(
            function_name,
            concat(
                String_from("("),
                concat(
                    native_c_core_ref_arg(arguments, 0, String_from("ark_string")),
                    concat(
                        String_from(", "),
                        concat(native_c_core_ref_arg(arguments, 1, String_from("ark_string")), String_from(")"))
                    )
                )
            )
        )
    )
}

fn native_c_core_expected_argument_count(handler: i32) -> i32 {
    if handler == core_op_registry_generated::core_op_handler_runtime_args() { return 0 }
    if handler == core_op_registry_generated::core_op_handler_runtime_clock_now_ms() { return 0 }
    if handler == core_op_registry_generated::core_op_handler_runtime_read_stdin() { return 0 }
    if handler == core_op_registry_generated::core_op_handler_raw_string_new() { return 0 }
    if handler == core_op_registry_generated::core_op_handler_text_String_new() { return 0 }
    if handler == core_op_registry_generated::core_op_handler_vec_Vec_new_f64() { return 0 }
    if handler == core_op_registry_generated::core_op_handler_hashmap_new() { return 0 }

    if handler == core_op_registry_generated::core_op_handler_parse_parse_f64() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_parse_parse_i32() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_parse_parse_i64() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_assert() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_panic() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_raw_string_clone() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_raw_string_from_bytes() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_raw_string_len_bytes() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_eprintln() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_fs_read_file() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_f32_to_f64() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_i32_to_i64() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_i64_to_i32() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_is_err() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_is_ok() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_print() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_println() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_process_exit() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_scalar_f64_bits_hi() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_scalar_f64_bits_lo() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_string_len() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_string_trim() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_string_trim_end() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_string_trim_start() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_text_char_to_string() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_text_clone() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_text_format_bool() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_text_format_f64() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_text_format_i64() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_text_is_empty() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_text_len_bytes() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_text_to_string() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_vec_len() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_vec_pop() { return 1 }

    if handler == core_op_registry_generated::core_op_handler_runtime_assert_eq() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_runtime_assert_eq_i64() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_runtime_assert_eq_str() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_runtime_write_bytes() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_runtime_write_string() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_raw_string_byte_at_unchecked() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_string_char_at() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_string_concat() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_string_contains() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_string_ends_with() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_string_index_of() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_string_starts_with() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_text_string_eq() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_vec_get() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_vec_get_unchecked() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_vec_get_unchecked_f64() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_vec_get_unchecked_i64() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_vec_push() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_vec_push_f64() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_vec_push_i64() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_runtime_arg_count() { return 0 }
    if handler == core_op_registry_generated::core_op_handler_text_push_char() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_seq_sort_i32() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_seq_sum_i32() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_seq_product_i32() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_vec_reverse_i32() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_vec_remove_i32() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_vec_contains_i32() { return 2 }

    if handler == core_op_registry_generated::core_op_handler_string_slice() { return 3 }
    if handler == core_op_registry_generated::core_op_handler_vec_set() { return 3 }
    if handler == core_op_registry_generated::core_op_handler_string_replace() { return 3 }
    if handler == core_op_registry_generated::core_op_handler_string_repeat() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_string_lines() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_text_chars() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_string_split() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_string_to_lowercase() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_string_to_uppercase() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_string_reverse() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_string_join() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_runtime_unwrap() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_runtime_unwrap_or() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_runtime_clock_now() { return 0 }
    if handler == core_op_registry_generated::core_op_handler_runtime_clock_now_ms() { return 0 }
    if handler == core_op_registry_generated::core_op_handler_math_abs() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_math_min() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_math_max() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_math_clamp() { return 3 }
    if handler == core_op_registry_generated::core_op_handler_math_gcd() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_math_pow_i32() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_math_sqrt() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_vec_is_empty() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_text_string_from_bytes() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_hashmap_len() { return 1 }
    if handler == core_op_registry_generated::core_op_handler_hashmap_get() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_hashmap_contains() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_hashmap_remove() { return 2 }
    if handler == core_op_registry_generated::core_op_handler_hashmap_insert() { return 3 }
    0 - 1
}

fn native_c_emit_core_call(
    mir_module: MirModule,
    function: MirFunction,
    instruction: MirInst,
    arguments: Vec<i32>
) -> NativeCCoreCall {
    let handler = core_op_call::mir_call_core_op_index(mir_module, instruction)
    if handler < 0 { return native_c_core_call_not_handled() }
    let expected_arguments = native_c_core_expected_argument_count(handler)
