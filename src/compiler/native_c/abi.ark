use std::text
use corehir::kinds
use corehir::mir_value_type
use corehir::signature_entry
use corehir::type_id
use corehir::type_table
use mir::local_record
use mir::value_types
use native_c::enum_abi
fn native_c_scalar_type_name(name: String) -> String {
    if name.clone().eq("i8") { return "int8_t" }
    if name.clone().eq("i16") { return "int16_t" }
    if name.clone().eq("i32") { return "int32_t" }
    if name.clone().eq("i64") { return "int64_t" }
    if name.clone().eq("u8") { return "uint8_t" }
    if name.clone().eq("u16") { return "uint16_t" }
    if name.clone().eq("u32") { return "uint32_t" }
    if name.clone().eq("u64") { return "uint64_t" }
    if name.clone().eq("f32") { return "float" }
    if name.clone().eq("f64") { return "double" }
    if name.clone().eq("bool") { return "uint8_t" }
    if name.clone().eq("char") { return "uint32_t" }
    if name.clone().eq("unit") || name.clone().eq("void") {
        return "ark_unit"
    }
    String_new()
}

fn native_c_type_name_is_funcref(name: String) -> bool {
    if name.clone().eq(String_from("fnref")) || name.clone().eq(String_from("fn")) {
        return true
    }
    name.clone().starts_with(String_from("fn("))
}

fn native_c_type_for_value(
    table: TypeTable,
    value_type: MirValueType,
    heap_enum_flags: Vec<i32>
) -> String {
    let raw_type_id = type_id::TypeId_raw(mir_value_type::mir_value_type_type_id(value_type))
    if raw_type_id < 0 || raw_type_id >= type_table::TypeTable_entry_count(table) {
        return String_new()
    }
    let entry = type_table::TypeTable_entry_at(table, raw_type_id)
    let name = type_table::type_entry_name(entry)
    // Zero-capture HOF stores a typed function pointer as intptr_t (LP64-safe).
    if native_c_type_name_is_funcref(name) {
        return String_from("intptr_t")
    }
    let scalar = native_c_scalar_type_name(name)
    if scalar.len() > 0 {
        return scalar
    }
    // Unit-tag enums (CONST_I32 lowering) must stay i32. Everything else that is
    // not a scalar keeps the legacy object* ABI so IoError/JSON/Option work even
    // when MIR STRUCT_SET omits `Enum::Variant` names.
    if enum_abi::native_c_type_name_is_unit_tag_enum(name.clone()) ||
    enum_abi::native_c_type_name_is_unit_tag_enum(
        enum_abi::native_c_type_name_enum_basename(name.clone())
    ) {
        return String_from("int32_t")
    }
    // heap_enum_flags reserved for future payload-vs-unit classification.
    if heap_enum_flags.len() < 0 {
        return String_new()
    }
    String_from("ark_object_header *")
}

fn native_c_type_names_enum_equal(left: String, right: String) -> bool {
    enum_abi::native_c_type_name_enum_basename(left).eq(enum_abi::native_c_type_name_enum_basename(right))
}

fn native_c_table_has_unit_enum_named(
    table: TypeTable,
    heap_enum_flags: Vec<i32>,
    name: String
) -> bool {
    enum_abi::native_c_table_has_unit_enum_named(table, heap_enum_flags, name)
}

fn native_c_type_name_is_heap_object(name: String) -> bool {
    if name.clone().eq(String_from("string")) || name.clone().eq(String_from("String")) {
        return true
    }
    if name.clone().starts_with(String_from("vec:")) || name.clone().starts_with(String_from("Vec<")) {
        return true
    }
    if name.clone().starts_with(String_from("option:")) || name.clone().starts_with(String_from("Option_")) {
        return true
    }
    if name.clone().starts_with(String_from("result:")) || name.clone().starts_with(String_from("Result_")) {
        return true
    }
    if name.clone().starts_with(String_from("hashmap:")) || name.clone().starts_with(String_from("hashset:")) {
        return true
    }
    false
}

fn native_c_type_for_local(
    table: TypeTable,
    local: MirLocal,
    heap_enum_flags: Vec<i32>
) -> String {
    let type_name = local_record::mir_local_type_name(local)
    if native_c_type_name_is_funcref(type_name.clone()) {
        return String_from("intptr_t")
    }
    // Match payload binds may keep VT_I32 while type_name is vec:/Option_/…
    if native_c_type_name_is_heap_object(type_name.clone()) {
        return String_from("ark_object_header *")
    }
    let typed = native_c_type_for_value(
        table,
        local_record::mir_local_value_type(local),
        heap_enum_flags
    )
    if typed.len() > 0 {
        return typed
    }
    let legacy = local_record::mir_local_val_type(local)
    if legacy == value_types::VT_I32() { return "int32_t" }
    if legacy == value_types::VT_I64() { return "int64_t" }
    if legacy == value_types::VT_F32() { return "float" }
    if legacy == value_types::VT_F64() { return "double" }
    if legacy == value_types::VT_REF() || legacy == value_types::VT_GC_REF() {
        return "ark_object_header *"
    }
    String_new()
}

fn native_c_funcref_typedef_name(table: TypeTable, signature: SignatureEntry) -> String {
    let parameters = native_c_signature_parameter_encoding(table, signature)
    let results = native_c_signature_result_encoding(table, signature)
    if parameters.len() == 0 || results.len() == 0 {
        return String_new()
    }
    String_from("ark_fnptr__P_").concat(parameters.concat(String_from("__R_").concat(results)))
}

fn native_c_funcref_typedef_decl(
    table: TypeTable,
    signature: SignatureEntry,
    heap_enum_flags: Vec<i32>
) -> String {
    let typedef_name = native_c_funcref_typedef_name(table, signature)
    if typedef_name.len() == 0 {
        return String_new()
    }
    let return_type = native_c_signature_return_type(table, signature, heap_enum_flags)
    if return_type.len() == 0 {
        return String_new()
    }
    let param_count = signature_entry::signature_entry_param_count(signature)
    let mut params = String_from("void")
    if param_count > 0 {
        params = String_new()
        let mut index = 0
        while index < param_count {
            if index > 0 { params = params.concat(String_from(", ")) }
            let param_type = native_c_type_for_value(
                table,
                signature_entry::signature_entry_param_at(signature, index),
                heap_enum_flags
            )
            if param_type.len() == 0 { return String_new() }
            params = params.concat(param_type)
            index = index + 1
        }
    }
    String_from("typedef ").concat(return_type.concat((String_from(" (*")).concat(typedef_name.concat(String_from(")(").concat(params.concat(String_from(");\n")))))))
}

fn native_c_type_encoding(table: TypeTable, value_type: MirValueType) -> String {
    let raw_type_id = type_id::TypeId_raw(mir_value_type::mir_value_type_type_id(value_type))
    if raw_type_id < 0 || raw_type_id >= type_table::TypeTable_entry_count(table) {
        return String_new()
    }
    let entry = type_table::TypeTable_entry_at(table, raw_type_id)
    let name = type_table::type_entry_name(entry)
    if name.clone().eq("i8") { return "i8" }
    if name.clone().eq("i16") { return "i16" }
    if name.clone().eq("i32") { return "i32" }
    if name.clone().eq("i64") { return "i64" }
    if name.clone().eq("u8") { return "u8" }
    if name.clone().eq("u16") { return "u16" }
    if name.clone().eq("u32") { return "u32" }
    if name.clone().eq("u64") { return "u64" }
    if name.clone().eq("f32") { return "f32" }
    if name.clone().eq("f64") { return "f64" }
    if name.clone().eq("bool") { return "b" }
    if name.clone().eq("char") { return "c" }
    if name.clone().eq("unit") || name.clone().eq("void") {
        return "v"
    }
    let prefix = if mir_value_type::mir_value_type_nullability(value_type) == kinds::NULLABILITY_NULLABLE() {
        "n"
    } else {
        "r"
    }
    prefix.concat((raw_type_id).to_string())
}

fn native_c_signature_parameter_encoding(table: TypeTable, signature: SignatureEntry) -> String {
    let count = signature_entry::signature_entry_param_count(signature)
    if count == 0 {
        return "v"
    }
    let mut encoding = String_new()
    let mut index = 0
    while index < count {
        if index > 0 { encoding = encoding.concat("_") }
        let part = native_c_type_encoding(table, signature_entry::signature_entry_param_at(signature, index))
        if part.len() == 0 { return String_new() }
        encoding = encoding.concat(part)
        index = index + 1
    }
    encoding
}

fn native_c_signature_result_encoding(table: TypeTable, signature: SignatureEntry) -> String {
    let count = signature_entry::signature_entry_return_count(signature)
    if count == 0 {
        return "v"
    }
    let mut encoding = String_new()
    let mut index = 0
    while index < count {
        if index > 0 { encoding = encoding.concat("_") }
        let part = native_c_type_encoding(table, signature_entry::signature_entry_return_at(signature, index))
        if part.len() == 0 { return String_new() }
        encoding = encoding.concat(part)
        index = index + 1
    }
    encoding
}

fn native_c_function_symbol(table: TypeTable, function_id_raw: i32, signature: SignatureEntry) -> String {
    let parameters = native_c_signature_parameter_encoding(table, signature)
    let results = native_c_signature_result_encoding(table, signature)
    if parameters.len() == 0 || results.len() == 0 {
        return String_new()
    }
    "ark_f_".concat((function_id_raw).to_string().concat("__P_".concat(parameters.concat("__R_".concat(results)))))
}

fn native_c_signature_return_type(
    table: TypeTable,
    signature: SignatureEntry,
    heap_enum_flags: Vec<i32>
) -> String {
    let count = signature_entry::signature_entry_return_count(signature)
    if count == 0 { return "void" }
    if count == 1 {
        let c_type = native_c_type_for_value(
            table,
            signature_entry::signature_entry_return_at(signature, 0),
            heap_enum_flags
        )
        if c_type.clone().eq("ark_unit") { return "void" }
        return c_type
    }
    String_new()
}

fn native_c_signature_parameters(
    table: TypeTable,
    signature: SignatureEntry,
    heap_enum_flags: Vec<i32>
) -> String {
    let count = signature_entry::signature_entry_param_count(signature)
    if count == 0 { return "void" }
    let mut parameters = String_new()
    let mut index = 0
    while index < count {
        let c_type = native_c_type_for_value(
            table,
            signature_entry::signature_entry_param_at(signature, index),
            heap_enum_flags
        )
        if c_type.len() == 0 { return String_new() }
        if index > 0 { parameters = parameters.concat(", ") }
        parameters = parameters.concat(c_type.concat(" ark_v_".concat((index).to_string())))
        index = index + 1
    }
    parameters
}
