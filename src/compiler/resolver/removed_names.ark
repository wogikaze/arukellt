        assert(len(removed_module_member_hint(String_from("clock"), String_from("monotonic_now"))) > 0)
        assert(len(removed_module_member_hint(String_from("host::clock"), String_from("now_ms"))) > 0)
        assert(len(removed_module_member_hint(String_from("std::host::clock"), String_from("monotonic_now"))) > 0)
        assert(len(removed_module_member_hint(String_from("std::host::clock"), String_from("now_ms"))) > 0)
        assert(len(removed_module_member_hint(String_from("clock"), String_from("Clock"))) == 0)
    }
