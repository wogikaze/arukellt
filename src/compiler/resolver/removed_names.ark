// Prelude decls outside the ADR-072 stable set: still public in
// std::prelude but no longer auto-imported. The hint keeps the call
// working through an explicit selective import.
fn removed_gated_prelude_hint(name: String) -> String {
    if !is_gated_prelude_name(clone(name)) {
        return String_new()
    }
    "no longer auto-imported; add `use std::prelude::{".concat(name.concat("}`"))
}

fn is_gated_prelude_name(name: String) -> bool {
    if eq(clone(name), "Box") || eq(clone(name), "Box_new") || eq(clone(name), "Slice") {
        return true
    }
    if eq(clone(name), "abs") || eq(clone(name), "args") || eq(clone(name), "as_slice") {
        return true
    }
    if eq(clone(name), "assert_eq") || eq(clone(name), "assert_eq_i64") || eq(clone(name), "assert_eq_str") {
        return true
    }
    if eq(clone(name), "assert_ne") || eq(clone(name), "byte_at") || eq(clone(name), "byte_len") {
        return true
    }
    if eq(clone(name), "clamp_i32") || eq(clone(name), "clone") || eq(clone(name), "contains") {
        return true
    }
    if eq(clone(name), "ends_with") || eq(clone(name), "eq") || eq(clone(name), "exit") {
        return true
    }
    if eq(clone(name), "f32_to_f64") || eq(clone(name), "f32_to_string") || eq(clone(name), "f64_bits_hi") {
        return true
    }
    if eq(clone(name), "f64_bits_lo") || eq(clone(name), "f64_to_f32") || eq(clone(name), "format_bool") {
        return true
    }
    if eq(clone(name), "format_i32") || eq(clone(name), "gcd") || eq(clone(name), "i16_to_i32") {
        return true
    }
    if eq(clone(name), "i32_to_i16") || eq(clone(name), "i32_to_i64") || eq(clone(name), "i32_to_i8") {
        return true
    }
    if eq(clone(name), "i32_to_u16") || eq(clone(name), "i32_to_u32") || eq(clone(name), "i32_to_u8") {
        return true
    }
    if eq(clone(name), "i64_to_i32") || eq(clone(name), "i8_to_i32") || eq(clone(name), "index_of") {
        return true
    }
    if eq(clone(name), "is_empty") || eq(clone(name), "is_err") || eq(clone(name), "is_none") {
        return true
    }
    if eq(clone(name), "is_ok") || eq(clone(name), "is_some") || eq(clone(name), "join") {
        return true
    }
    if eq(clone(name), "lines") || eq(clone(name), "max") || eq(clone(name), "min") {
        return true
    }
    if eq(clone(name), "pad_left") || eq(clone(name), "pad_right") || eq(clone(name), "parse_f64") {
        return true
    }
    if eq(clone(name), "parse_i32") || eq(clone(name), "parse_i64") || eq(clone(name), "push_char") {
        return true
    }
    if eq(clone(name), "repeat") || eq(clone(name), "replace") || eq(clone(name), "slice") {
        return true
    }
    if eq(clone(name), "slice_get") || eq(clone(name), "slice_len") || eq(clone(name), "split") {
        return true
    }
    if eq(clone(name), "sqrt") || eq(clone(name), "starts_with") || eq(clone(name), "substring") {
        return true
    }
    if eq(clone(name), "to_lower") || eq(clone(name), "to_lowercase") || eq(clone(name), "to_string") {
