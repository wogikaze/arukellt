// CSV row/document helpers moved onto the `Csv` namespace. The leaf name is
// the same, so one prefix rule covers the whole family.
fn removed_csv_member_hint(name: String) -> String {
    if !name.clone().starts_with(String_from("csv_")) {
        return String_new()
    }
    let leaf = name.clone().slice(4, len(name))
    "use `csv::Csv::".concat(
        leaf.clone()
    ).concat("(...)` via `use std::csv` instead")
}

