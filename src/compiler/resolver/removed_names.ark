fn is_retired_hash_free_module(module: String) -> bool {
    if module.clone().eq("hash") || module.clone().eq("collections::hash") {
        return true
    }
    module.clone().eq("std::collections::hash")
}

// A retired public name can stay in the symbol table as a non-public MIR
// lowering target. Report the removal with its replacement instead of the
// generic privacy error, matching the E0100 hint for a deleted declaration.
fn removed_private_member_hint(module: String, name: String) -> String {
    if (module.clone().eq("prelude") || module.clone().eq("std::prelude")) &&
    name.clone().eq("clone") {
        return String_from("use `x.clone()` on the value instead")
    }
    if (module.clone().eq("string") || module.clone().eq("collections::string") ||
        module.clone().eq("std::collections::string")) && name.clone().eq("eq") {
        return String_from("use `a.eq(b)` on the `String` receiver instead")
    }
    if is_retired_hash_free_module(module.clone()) && name.clone().starts_with("hashset_") {
        return hashset_free_replacement_hint()
    }
    if module.clone().eq("hash_string") && name.clone().starts_with("hashset_") {
        return hashset_free_replacement_hint()
    }
    if is_retired_hash_free_module(module.clone()) && name.clone().starts_with("hashmap_") {
        return hashmap_free_replacement_hint()
    }
    if is_retired_hashmap_module(module.clone()) && name.clone().starts_with("hashmap_") {
        return hashmap_method_replacement_hint()
    }
    String_new()
}

