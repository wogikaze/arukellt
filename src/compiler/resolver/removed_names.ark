    test "io shims" { assert(len(removed_name_hint("eprintln")) > 0) }
    test "deprecated prelude hints" {
        assert(len(removed_name_hint("concat")) > 0)
        assert(len(removed_name_hint("char_at")) > 0)
        assert(len(removed_name_hint("println")) > 0)
