    if name.clone().eq("split") { return String_from("use `s.split(sep)` on `String` instead") }
    if name.clone().eq("sqrt") { return String_from("use `x.sqrt()` on the `f64` value instead") }
    if name.clone().eq("to_lower") { return String_from("use `s.to_lower()` on `String` instead") }
    if name.clone().eq("to_lowercase") { return String_from("use `s.to_lower()` on `String` instead (ASCII case fold)") }
    if name.clone().eq("to_upper") { return String_from("use `s.to_upper()` on `String` instead") }
    if name.clone().eq("to_uppercase") { return String_from("use `s.to_upper()` on `String` instead (ASCII case fold)") }
    if name.clone().eq("trim") { return String_from("use `s.trim()` on `String` instead") }
    if name.clone().eq("trim_end") { return String_from("use `s.trim_end()` on `String` instead") }
    if name.clone().eq("trim_start") { return String_from("use `s.trim_start()` on `String` instead") }
    if name.clone().eq("values") { return String_from("removed identity helper; iterate the value directly (`for x in v`)") }
    if name.clone().eq("push_char") { return String_from("use `s.push_char(c)` on `String` instead") }
    if name.clone().eq("parse_i32") { return String_from("use `i32::try_from(s)` from `use std::core::convert` instead") }
    if name.clone().eq("parse_i64") { return String_from("use `i64::try_from(s)` from `use std::core::convert` instead") }
    if name.clone().eq("parse_f64") { return String_from("use `f64::try_from(s)` from `use std::core::convert` instead") }
    if name.clone().eq("unwrap") { return String_from("use `o.unwrap()` on `Option<i32>` or `r.unwrap()` on `Result<i32, i32>` instead") }
    if name.clone().eq("unwrap_or") { return String_from("use `o.unwrap_or(fallback)` on `Option<i32>` or `r.unwrap_or(fallback)` on `Result<i32, i32>` instead") }
    if name.clone().eq("is_some") { return String_from("use `o.is_some()` on `Option<i32>` instead") }
    if name.clone().eq("is_none") { return String_from("use `o.is_none()` on `Option<i32>` instead") }
    if name.clone().eq("is_ok") { return String_from("use `r.is_ok()` on `Result<i32, i32>` instead") }
    if name.clone().eq("is_err") { return String_from("use `r.is_err()` on `Result<i32, i32>` instead") }
    if name.clone().eq("f32_to_string") { return String_from("use `x.to_string()` on the `f32` value instead") }
    if name.clone().eq("byte_at") { return String_from("use `s.byte_at(i)` on `String` instead") }
    if name.clone().eq("slice") { return String_from("use `s.slice(start, end)` on `String` instead") }
    if name.clone().eq("substring") { return String_from("use `s.slice(start, end)` on `String` instead") }
    if name.clone().eq("to_string") { return String_from("use `x.to_string()` on the value instead") }
    if name.clone().eq("starts_with") { return String_from("use `s.starts_with(prefix)` on `String` instead") }
    if name.clone().eq("ends_with") { return String_from("use `s.ends_with(suffix)` on `String` instead") }
    if name.clone().eq("contains") { return String_from("use `s.contains(sub)` on `String` instead") }
    if name.clone().eq("index_of") { return String_from("use `s.index_of(sub)` on `String` instead") }
    String_new()
}

fn is_gated_prelude_name(name: String) -> bool {
    if name.clone().eq("Box") || name.clone().eq("Slice") {
        return true
    }
    if name.clone().eq("as_slice") || name.clone().eq("assert_eq") || name.clone().eq("assert_eq_i64") {
        return true
    }
    if name.clone().eq("assert_eq_str") || name.clone().eq("assert_ne") {
        return true
    }
    if name.clone().eq("f64_bits_hi") || name.clone().eq("f64_bits_lo") || name.clone().eq("f64_to_f32") {
        return true
    }
    if name.clone().eq("f32_to_f64") {
        return true
    }
    if name.clone().eq("i16_to_i32") || name.clone().eq("i32_to_i16") || name.clone().eq("i32_to_i64") {
        return true
    }
    if name.clone().eq("i32_to_i8") || name.clone().eq("i32_to_u16") || name.clone().eq("i32_to_u32") {
        return true
    }
    if name.clone().eq("i32_to_u8") || name.clone().eq("i64_to_i32") || name.clone().eq("i8_to_i32") {
        return true
    }
    if name.clone().eq("slice_get") || name.clone().eq("slice_len") || name.clone().eq("u16_to_i32") {
        return true
    }
    if name.clone().eq("u32_to_u64") || name.clone().eq("u64_to_u32") || name.clone().eq("u8_to_i32") {
        return true
    }
    false
}
// Shared replacement text for the retired typed hash adapters; the four
// module aliases all pointed at the old `hash_map::hashmap_*` family.
fn hashmap_method_replacement_hint() -> String {
    String_from("removed HashMap helper; ").concat(hashmap_free_replacement_hint())
}

// The std::simd lane modules became namespace types in #917. Map the module
// alias used at the call site to the namespace type so the E0100 hint names
// the associated-function spelling.
fn removed_simd_lane_type(module: String) -> String {
    if module.clone().eq("f32x4") { return String_from("F32x4") }
    if module.clone().eq("f64x2") { return String_from("F64x2") }
    if module.clone().eq("i8x16") { return String_from("I8x16") }
    if module.clone().eq("i16x8") { return String_from("I16x8") }
    if module.clone().eq("i32x4") { return String_from("I32x4") }
    if module.clone().eq("i64x2") { return String_from("I64x2") }
    if module.clone().eq("u8x16") { return String_from("U8x16") }
    if module.clone().eq("u16x8") { return String_from("U16x8") }
    if module.clone().eq("u32x4") { return String_from("U32x4") }
    if module.clone().eq("u64x2") { return String_from("U64x2") }
    if module.clone().eq("v128") { return String_from("V128") }
    String_new()
}

fn removed_path_member_hint(name: String) -> String {
    if name.clone().eq("join") { return String_from("use `Path::new(base).join(child)` from `use std::path::Path` instead") }
    if name.clone().eq("parent") { return String_from("use `Path::new(path).parent()` from `use std::path::Path` instead") }
    if name.clone().eq("file_name") { return String_from("use `Path::new(path).file_name()` from `use std::path::Path` instead") }
    if name.clone().eq("extension") { return String_from("use `Path::new(path).extension()` from `use std::path::Path` instead") }
    if name.clone().eq("with_extension") { return String_from("use `Path::new(path).with_extension(ext)` from `use std::path::Path` instead") }
    if name.clone().eq("is_absolute") { return String_from("use `Path::new(path).is_absolute()` from `use std::path::Path` instead") }
    if name.clone().eq("stem") { return String_from("use `Path::new(path).stem()` from `use std::path::Path` instead") }
    if name.clone().eq("normalize") { return String_from("use `Path::new(path).normalize()` from `use std::path::Path` instead") }
    if name.clone().eq("components") { return String_from("use `Path::new(path).components()` from `use std::path::Path` instead") }
    if name.clone().eq("last_index_of") {
        return text::concat(
            String_from("removed helper; use the `Path` methods (`file_name`, `extension`, "),
            String_from("`parent`, `stem`, `normalize`) or `String::index_of` for forward searches")
        )
    }
    String_new()
}

fn removed_time_member_hint(name: String) -> String {
    if name.clone().eq("duration_ms") { return String_from("use `Duration::between(start, end).as_ms()` from `use std::time::Duration` instead") }
    if name.clone().eq("duration_us") { return String_from("use `Duration::between(start, end).as_us()` from `use std::time::Duration` instead") }
    if name.clone().eq("duration_ns") { return String_from("use `Duration::between(start, end).as_ns()` from `use std::time::Duration` instead") }
    String_new()
}

fn removed_raw_member_hint(name: String) -> String {
    if name.clone().eq("raw_array_new") {
        return "the sealed raw bridge was retired; use `Vec::new<T>()` or `Vec::with_capacity<T>(cap)`"
    }
    if name.clone().eq("raw_array_len") {
        return "the sealed raw bridge was retired; use `v.len()`"
    }
    if name.clone().eq("raw_array_get_unchecked") {
        return "the sealed raw bridge was retired; use `v.get_unchecked(i)` via `use std::collections::vec`"
    }
    if name.clone().eq("raw_array_set_unchecked") {
        return "the sealed raw bridge was retired; use `v.set(i, value)` via `use std::collections::vec`"
    }
    if name.clone().eq("raw_array_grow") {
        return "the sealed raw bridge was retired; stdlib uses `RawArray::grow(values, new_len)` and has no public replacement"
    }
    if name.clone().eq("raw_array_set_len") {
        return "the sealed raw bridge was retired; stdlib uses `RawArray::set_len(values, new_len)` and has no public replacement"
    }
    if name.clone().eq("raw_string_new") {
        return "the sealed raw bridge was retired; use `String_new()` or `String::new()`"
    }
    if name.clone().eq("raw_string_from_bytes") {
        return "the sealed raw bridge was retired; use `String::from_utf8_lossy(bytes)` for validated UTF-8 input"
    }
    if name.clone().eq("raw_string_len_bytes") {
        return "the sealed raw bridge was retired; use `s.len_bytes()` via `use std::collections::string`"
    }
    if name.clone().eq("raw_string_byte_at_unchecked") {
        return "the sealed raw bridge was retired; use `s.byte_at(i)` via `use std::collections::string`"
    }
    if name.clone().eq("raw_string_clone") {
        return "the sealed raw bridge was retired; use `s.clone()`"
    }
    if name.clone().eq("raw_string_push_char") {
        return "the sealed raw bridge was retired; use `s.push_char(c)` on `String` instead"
    }
    if name.clone().eq("raw_parse_i32") {
        return "the sealed raw bridge was retired; use `i32::try_from(s)` instead"
    }
    if name.clone().eq("raw_parse_i64") {
        return "the sealed raw bridge was retired; use `i64::try_from(s)` instead"
    }
    if name.clone().eq("raw_parse_f64") {
        return "the sealed raw bridge was retired; use `f64::try_from(s)` instead"
    }
    if name.clone().eq("raw_f64_sqrt") {
        return "the sealed raw bridge was retired; use `x.sqrt()` via `use std::core::convert`"
    }
    if name.clone().eq("raw_f64_bits_lo") {
        return "the sealed raw bridge was retired; use `x.to_bits_lo()` via `use std::core::convert`"
    }
    if name.clone().eq("raw_f64_bits_hi") {
        return "the sealed raw bridge was retired; use `x.to_bits_hi()` via `use std::core::convert`"
    }
    if name.clone().eq("raw_f64_to_string") {
        return "the sealed raw bridge was retired; use `x.to_string()` instead"
    }
    if name.clone().eq("raw_f32_promote_f64") {
        return "the sealed raw bridge was retired; use `f32_to_f64(x)` or `x.to_f64()` instead"
    }
    String_new()
}

fn removed_io_free_hint(name: String) -> String {
    if name.clone().eq("io_error_message") { return String_from("use `e.message()` on the `IoError` value instead") }
