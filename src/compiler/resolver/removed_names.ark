// Names removed from the auto-imported prelude / compat surface, or
// gated behind explicit 'use std::prelude::{name}' imports by the v2
// prelude policy (ADR-072). resolve_unknown_name consults this table
// so pre-v2 sources get a migration hint instead of a bare
// undefined-name error. Keep aligned with std/manifest.toml
// deprecations and docs/stdlib/migration-guidance.md;
// scripts/check/check-compat-orphans.py verifies both directions.
use std::text

fn removed_name_hint(name: String) -> String {
    let specific = removed_name_specific_hint(name.clone())
    if len(specific.clone()) > 0 {
        return specific
    }
    let json_hint = removed_json_member_hint(name.clone())
    if len(json_hint.clone()) > 0 {
        return json_hint
    }
    let toml_hint = removed_toml_member_hint(name.clone())
    if len(toml_hint.clone()) > 0 {
        return toml_hint
    }
    let csv_hint = removed_csv_member_hint(name.clone())
    if len(csv_hint.clone()) > 0 {
        return csv_hint
    }
    return removed_gated_prelude_hint(name)
}

fn is_retired_hashmap_adapter_name(name: String) -> bool {
    if name.clone().starts_with(String_from("hashmap_str_")) {
        return true
    }
    if name.clone().starts_with(String_from("hashmap_i32_str_")) {
        return true
    }
    if name.clone().starts_with(String_from("hashmap_i32_fn_")) {
        return true
    }
    name.clone().starts_with(String_from("hashmap_str_fn_"))
}

fn is_retired_hashmap_module(module: String) -> bool {
    if module.clone().eq("hash_map") || module.clone().eq("hash_string") {
        return true
    }
    module.clone().eq("hash_fn") || module.clone().eq("hash_str_fn")
}

fn hashset_method_surface_text() -> String {
    String_from("`HashSet::new<i32>()` / `HashSet::new<String>()` plus receiver methods ").concat(
        String_from("(`s.insert(v)`, `s.contains(v)`, `s.remove(v)`, `s.len()`, `s.is_empty()`, `s.to_vec()`, ")
    ).concat(String_from("`s.union(t)`, `s.intersection(t)`, `s.difference(t)`, `s.capacity()`, `s.reserve(n)`, ")
        .concat(String_from("`s.shrink_to_fit()`, `s.clear()`, `s.extend(t)`)")))
}

fn hashset_method_replacement_hint() -> String {
    String_from("removed HashSet adapter; use ").concat(hashset_method_surface_text())
}

fn hashset_free_replacement_hint() -> String {
    String_from("use ").concat(hashset_method_surface_text())
}

// The capacity / bulk surface is `HashMap<i32, i32>`-only. Listing it here
// keeps the E0100 hint accurate for both the retired flat-store frees and the
// private declarations that remain as MIR lowering targets.
fn hashmap_free_replacement_hint() -> String {
    String_from("use `HashMap::new<i32, i32>()` / `HashMap::with_capacity<i32, i32>(n)` plus receiver methods ").concat(
        String_from("(`m.insert(k, v)`, `m.get(k)`, `m.contains_key(k)`, `m.remove(k)`, `m.len()`, `m.is_empty()`, ")
    ).concat(
        String_from("`m.keys()`, `m.values()`, `m.entries()`, `m.capacity()`, `m.reserve(n)`, `m.try_reserve(n)`, ")
    ).concat(String_from("`m.shrink_to_fit()`, `m.clear()`, `m.drain()`, `m.remove_entry(k)`, `m.extend(other)`)"))
}

fn is_retired_hashset_adapter_name(name: String) -> bool {
    if name.clone().starts_with("hashset_i32_") {
        return true
    }
    name.clone().starts_with("hashset_str_")
}

fn removed_name_specific_hint(name: String) -> String {
    let test_hint = removed_test_free_hint(name.clone())
    if len(test_hint.clone()) > 0 {
        return test_hint
    }
    let raw_hint = removed_raw_member_hint(name.clone())
    if len(raw_hint.clone()) > 0 {
        return raw_hint
    }
    let core_hint = removed_core_free_hint(name.clone())
    if len(core_hint.clone()) > 0 {
        return core_hint
    }
    let io_hint = removed_io_free_hint(name.clone())
    if len(io_hint.clone()) > 0 {
        return io_hint
    }
    let compiler_hint = removed_compiler_member_hint(name.clone())
    if len(compiler_hint.clone()) > 0 {
        return compiler_hint
    }
    let bimap_hint = removed_bimap_member_hint(name.clone())
    if len(bimap_hint.clone()) > 0 {
        return bimap_hint
    }
    let trie_hint = removed_trie_member_hint(name.clone())
    if len(trie_hint.clone()) > 0 {
        return trie_hint
    }
    let ordered_hint = removed_ordered_member_hint(name.clone())
    if len(ordered_hint.clone()) > 0 {
        return ordered_hint
    }
    let pq_hint = removed_pq_member_hint(name.clone())
    if len(pq_hint.clone()) > 0 {
        return pq_hint
    }
    if name.clone().eq("new_i32") {
        return "removed free Vec constructor; use `Vec::new<i32>()` instead"
    }
    if name.clone().starts_with(String_from("HashMap_")) {
        return hashmap_method_replacement_hint()
    }
    if is_retired_hashmap_adapter_name(name.clone()) {
        return hashmap_method_replacement_hint()
    }
    if is_retired_hashset_adapter_name(name.clone()) {
        return hashset_method_replacement_hint()
    }
    if name.clone().eq("concat") { return "removed prelude wrapper; call `text::concat(a, b)` via `use std::text`, or `a.text::concat(b)`" }
    if name.clone().eq("clear") { return "removed free function; use the Vec method `v.clear()`" }
    if name.clone().eq("panic") { return "removed prelude control function; use `Std::panic(message)` (auto-imported)" }
    if name.clone().eq("sort") || name.clone().eq("sort_unstable") {
        return "removed free sort algorithm; use `v.sort()` / `v.sort_unstable()` via `use std::collections::vec`"
    }
    if name.clone().eq("is_sorted") {
        return "removed free sort algorithm; use `v.is_sorted()` via `use std::collections::vec`"
    }
    if name.clone().eq("select_nth") {
        return "removed free sort algorithm; use `v.select_nth(k)` via `use std::collections::vec`"
    }
    if name.clone().eq("map_option_String_String") { return "removed free function; use `o.map(f)` via `use std::core::container`" }
    if name.clone().eq("map_result_i32_i32") { return "removed free function; use `r.map(f)` via `use std::core::container`" }
    if name.clone().eq("char_at") { return "removed prelude wrapper; use `s.byte_at(i)` on `String` instead" }
    if name.clone().eq("println") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::println(...)`" }
    if name.clone().eq("print") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::print(...)`" }
    if name.clone().eq("eprintln") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::eprintln(...)`" }
    if name.clone().eq("read_to_string") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::read_stdin()`" }
    if name.clone().eq("exists") { return "removed prelude binding; import `use std::host::fs::Fs` and call `Fs::is_readable_file(...)`" }
    if name.clone().eq("get_var") { return "removed module function; import `use std::host::env::Env` and call `Env::var(name)`" }
    if name.clone().eq("var_or_default") { return "removed module function; import `use std::host::env::Env` and call `Env::var_or_default(name, default)`" }
    if name.clone().eq("arg_at") { return "removed module function; import `use std::host::env::Env` and call `Env::arg_at(index)`" }
    if name.clone().eq("arg_count") { return "removed module function; import `use std::host::env::Env` and call `Env::arg_count()`" }
    if name.clone().eq("has_flag") { return "removed module function; import `use std::host::env::Env` and call `Env::has_flag(flag)`" }
    if name.clone().eq("sort_i32") || name.clone().eq("sort_i64") || name.clone().eq("sort_f64") || name.clone().eq("sort_String") {
        return "removed free function; use `v.sort()` via `use std::collections::vec`"
    }
    if name.clone().eq("map_i32_i32") || name.clone().eq("map_i64_i64") || name.clone().eq("map_f64_f64") || name.clone().eq("map_String_String") {
        return "removed free function; use `v.iter().map(f).collect()` via `use std::core::iter`"
    }
    if name.clone().eq("filter_i64") || name.clone().eq("filter_f64") || name.clone().eq("filter_String") {
        return "removed free function; use `v.iter().filter(f).collect()` via `use std::core::iter`"
    }
    if name.clone().eq("filter_i32") {
        return "provisional prelude helper; import `use std::prelude::{filter_i32}` or use `v.iter().filter(f).collect()` via `use std::core::iter`"
    }
    if name.clone().eq("fold_i32_i32") || name.clone().eq("fold_i64_i64") || name.clone().eq("fold_f64_f64") {
        return "removed free function; use `v.iter().fold(init, f)` via `use std::core::iter`"
    }
    if name.clone().eq("any_i32") || name.clone().eq("any_i64") || name.clone().eq("any_f64") || name.clone().eq("any_String") {
        return "removed free function; use `v.iter().any(f)` via `use std::core::iter`"
    }
    if name.clone().eq("find_i32") || name.clone().eq("find_i64") || name.clone().eq("find_f64") || name.clone().eq("find_String") {
        return "removed free function; use `v.iter().find(f)` via `use std::core::iter`"
    }
    if name.clone().eq("contains_i32") || name.clone().eq("contains_String") {
        return "removed free function; use `v.iter().contains(x)` via `use std::core::iter`"
    }
    if name.clone().eq("reverse_i32") || name.clone().eq("reverse_String") {
        return "removed free function; use `v.iter().rev().collect()` via `use std::core::iter`"
    }
    if name.clone().eq("remove_i32") {
        return "removed free function; use `v.drain(i, i + 1)` via `use std::collections::vec`"
    }
    if name.clone().eq("sum_i32") {
        return "removed free function; use `v.iter().sum()` via `use std::core::iter`"
    }
    if name.clone().eq("product_i32") {
        return "removed free function; use `v.iter().fold(1, mul)` via `use std::core::iter`"
    }
    if name.clone().eq("map_option_i32_i32") {
        return "removed free function; use `o.map(f)` via `use std::core::container`"
    }
    if name.clone().eq("contains_string") {
        return "removed free function; use the String method `s.contains(sub)`"
    }
    if name.clone().eq("take_i32") { return "removed free function; use `v.iter().take(n).collect()` via `use std::core::iter`" }
    if name.clone().eq("skip_i32") { return "removed free function; use `v.iter().skip(n).collect()` via `use std::core::iter`" }
    if name.clone().eq("seq_reverse") { return "removed free function; use `v.iter().rev().collect()` via `use std::core::iter`" }
    if name.clone().eq("seq_contains") { return "removed free function; use `v.iter().contains(x)` via `use std::core::iter`" }
    if name.clone().eq("unique") { return "removed free function; use `v.iter().unique().collect()` via `use std::core::iter`" }
    if name.clone().eq("count_eq") { return "removed free function; use `v.iter().count_eq(x)` via `use std::core::iter`" }
    if name.clone().eq("binary_search") { return "removed free function; use `v.binary_search(target)` via `use std::collections::vec`" }
    if name.clone().eq("min_i32") { return "removed free function; use `v.min()` via `use std::collections::vec`" }
    if name.clone().eq("max_i32") { return "removed free function; use `v.max()` via `use std::collections::vec`" }
    if name.clone().eq("i32_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if name.clone().eq("i64_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if name.clone().eq("f64_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if name.clone().eq("bool_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if name.clone().eq("Vec_new") { return "removed Vec constructor; use `Vec::new<T>()`" }
    if name.clone().eq("Vec_new_i32") { return "removed Vec constructor; use `Vec::new<i32>()`" }
    if name.clone().eq("Vec_new_String") { return "removed Vec constructor; use `Vec::new<String>()`" }
    if name.clone().eq("Vec_with_capacity") { return "removed Vec constructor; use `Vec::new<T>()`" }
    if name.clone().eq("Vec_with_capacity_i32") { return "removed Vec constructor; use `Vec::new<i32>()`" }
    if name.clone().eq("Vec_with_capacity_String") { return "removed Vec constructor; use `Vec::new<String>()`" }
    if name.clone().eq("ok") { return "removed free function; construct the variant directly with `Ok(...)`" }
    if name.clone().eq("err") { return "removed free function; construct the variant directly with `Err(...)`" }
    if name.clone().eq("expect") { return "removed free function; use `o.unwrap_or(fallback)` or match on the variant" }
    if name.clone().eq("unwrap_or_else") { return "removed free function; use `o.unwrap_or(fallback)`" }
    if name.clone().eq("ok_or") { return "removed free function; convert Option to Result explicitly with `Ok`/`Err` or `match`" }
    let prelude_hint = removed_prelude_free_hint(name.clone())
    if len(prelude_hint.clone()) > 0 {
        return prelude_hint
    }
    String_new()
}

// Module-qualified calls cannot use the bare-name table above: the resolver
// only knows the removed member name after the module head resolved. Keep the
// per-module entries here so ADR-085 Phase F removals still produce an E0100
// migration hint instead of a bare "undefined module member".
fn removed_wasm_member_hint(name: String) -> String {
    if name.clone().eq("module_new") { return String_from("removed free function; use the `WasmModuleBuilder` associated function from `use std::wasm` instead") }
    if name.clone().eq("wasm_magic") { return String_from("removed free function; use the `WasmModuleBuilder` associated function from `use std::wasm` instead") }
    if name.clone().eq("wasm_version") { return String_from("removed free function; use the `WasmModuleBuilder` associated function from `use std::wasm` instead") }
    if name.clone().eq("v128_load") { return String_from("removed free function; use `V128Memory::load(address, offset)` from `use std::wasm` instead") }
    if name.clone().eq("v128_store") { return String_from("removed free function; use `V128Memory::store(address, offset, value)` from `use std::wasm` instead") }
    if name.clone().eq("v128_load_splat") { return String_from("removed free function; use `V128Memory::load_splat(address, offset)` from `use std::wasm` instead") }
    if name.clone().eq("v128_load_lane") { return String_from("removed free function; use `V128Memory::load_lane(address, offset, value, lane)` from `use std::wasm` instead") }
    if name.clone().eq("v128_store_lane") { return String_from("removed free function; use `V128Memory::store_lane(address, offset, value, lane)` from `use std::wasm` instead") }
    String_from("removed free function; use the owning type from `use std::wasm` instead")
}

// The whole-path std::host::fs helpers and the legacy std::fs frees moved to
// the `Fs` namespace (ADR-046, #917). `read_dir` / `metadata` have no host
// intrinsic yet, so their hint states the unsupported capability instead of
// promising a replacement.
fn removed_host_fs_member_hint(name: String) -> String {
    if name.clone().eq("read_to_string") || name.clone().eq("read_string") {
        return String_from("use `Fs::read_to_string(path)` from `use std::host::fs::Fs` instead")
    }
    if name.clone().eq("read_bytes") {
        return String_from("use `Fs::read_bytes(path)` from `use std::host::fs::Fs` instead")
    }
    if name.clone().eq("write_string") {
        return String_from("use `Fs::write_string(path, contents)` from `use std::host::fs::Fs` instead")
    }
    if name.clone().eq("write_bytes") {
        return String_from("use `Fs::write_bytes(path, bytes)` from `use std::host::fs::Fs` instead")
    }
    if name.clone().eq("is_readable_file") || name.clone().eq("exists") {
        return String_from("use `Fs::is_readable_file(path)` from `use std::host::fs::Fs` instead")
    }
    if name.clone().eq("is_file") {
        return String_from("use `Fs::is_file(path)` from `use std::host::fs::Fs` instead")
    }
    if name.clone().eq("is_dir") {
        return String_from("use `Fs::is_dir(path)` from `use std::host::fs::Fs` instead")
    }
    if name.clone().eq("read_dir") {
        return String_from("directory listing is not supported by the current host intrinsic layer; no replacement")
    }
    if name.clone().eq("metadata") {
        return String_from("path metadata is not supported by the current host intrinsic layer; no replacement")
    }
    String_new()
}

// The stable host clock free reads moved to the `Clock` namespace (ADR-046,
// #917). Both names were deleted in the ADR-087 Wave 2 change, so a qualified
// old call states the replacement instead of a bare undefined-member error.
fn removed_host_clock_member_hint(name: String) -> String {
    if name.clone().eq("monotonic_now") {
        return String_from("use `Clock::monotonic_now()` from `use std::host::clock::Clock` instead")
    }
    if name.clone().eq("now_ms") {
        return String_from("use `Clock::now_ms()` from `use std::host::clock::Clock` instead")
    }
    String_new()
}

// The `std::env` module path and the `std::host::env` free functions were
// deleted in the ADR-087 Wave 2 env wave (2026-10-28). `Env` is the only env
// surface; each retired member names its method replacement (#917).
fn removed_host_env_member_hint(name: String) -> String {
    if name.clone().eq("get_var") || name.clone().eq("var") {
        return String_from("use `Env::var(name)` from `use std::host::env::Env` instead")
    }
    if name.clone().eq("args") {
        return String_from("use `Env::args()` from `use std::host::env::Env` instead")
    }
    if name.clone().eq("arg_count") {
        return String_from("use `Env::arg_count()` from `use std::host::env::Env` instead")
    }
    if name.clone().eq("arg_at") {
        return String_from("use `Env::arg_at(index)` from `use std::host::env::Env` instead")
    }
    if name.clone().eq("var_or_default") {
        return String_from("use `Env::var_or_default(name, default)` from `use std::host::env::Env` instead")
    }
    if name.clone().eq("has_flag") {
        return String_from("use `Env::has_flag(flag)` from `use std::host::env::Env` instead")
    }
    String_new()
}

// Process control moved to the `Process` namespace in the 2026-10-29
// host/core wave (#917, ADR-092). The legacy `std::process` facade dispatches
// here too, so both qualified old spellings name the same replacement.
fn removed_host_process_member_hint(name: String) -> String {
    if name.clone().eq("exit") {
        return String_from("use `Process::exit(code)` from `use std::host::process::Process` instead")
    }
    if name.clone().eq("abort") {
        return String_from("use `Process::abort()` from `use std::host::process::Process` instead")
    }
    if name.clone().eq("id") {
        return String_from("use `Process::id()` from `use std::host::process::Process` instead")
    }
    String_new()
}

// Host entropy moved to the `Random` namespace in the 2026-10-29 host/core
// wave (#917, ADR-092). The deterministic `std::random` module keeps its own
// Rng hints in removed_random_member_hint.
fn removed_host_random_member_hint(name: String) -> String {
    if name.clone().eq("random_i32") {
        return String_from("use `Random::random_i32()` from `use std::host::random::Random` instead")
    }
    if name.clone().eq("random_i32_range") {
        return String_from("use `Random::random_i32_range(lo, hi)` from `use std::host::random::Random` instead")
    }
    if name.clone().eq("random_bool") {
        return String_from("use `Random::random_bool()` from `use std::host::random::Random` instead")
    }
    if name.clone().eq("next_f64") {
        return String_from("use `Random::next_f64()` from `use std::host::random::Random` instead")
    }
    String_new()
}

// `std::cli` moved its argument-vector reads behind `Env` and its
// explicit-vector scanners behind `Cli` in the 2026-10-29 host/core wave
// (#917, ADR-092).
fn removed_cli_member_hint(name: String) -> String {
    if name.clone().eq("parse_args") {
        return String_from("use `Env::args()` from `use std::host::env::Env` instead")
    }
    if name.clone().eq("arg_count") {
        return String_from("use `Env::arg_count()` from `use std::host::env::Env` instead")
    }
    if name.clone().eq("arg_at") {
        return String_from("use `Env::arg_at(index)` from `use std::host::env::Env` instead")
    }
    if name.clone().eq("has_flag") {
        return String_from("use `Env::has_flag(flag)` from `use std::host::env::Env` instead")
    }
    if name.clone().eq("flag") {
        return String_from("use `Cli::flag(args, name)` from `use std::cli::Cli` instead")
    }
    if name.clone().eq("option") {
        return String_from("use `Cli::option(args, name)` from `use std::cli::Cli` instead")
    }
    String_new()
}

// The spectral helpers moved to the `Signal` namespace in the 2026-10-29
// host/core wave (#917, ADR-092).
fn removed_signal_member_hint(name: String) -> String {
    if name.clone().eq("pi") { return String_from("use `Signal::pi()` from `use std::signal::Signal` instead") }
    if name.clone().eq("tau") { return String_from("use `Signal::tau()` from `use std::signal::Signal` instead") }
    if name.clone().eq("sin_approx") { return String_from("use `Signal::sin_approx(x)` from `use std::signal::Signal` instead") }
    if name.clone().eq("cos_approx") { return String_from("use `Signal::cos_approx(x)` from `use std::signal::Signal` instead") }
    if name.clone().eq("clone_f64") { return String_from("use `Signal::clone_f64(v)` from `use std::signal::Signal` instead") }
    if name.clone().eq("zeros") { return String_from("use `Signal::zeros(n)` from `use std::signal::Signal` instead") }
    if name.clone().eq("fft") { return String_from("use `Signal::fft(real, imag)` from `use std::signal::Signal` instead") }
    if name.clone().eq("ifft") { return String_from("use `Signal::ifft(real, imag)` from `use std::signal::Signal` instead") }
    if name.clone().eq("magnitude") { return String_from("use `Signal::magnitude(real, imag)` from `use std::signal::Signal` instead") }
    if name.clone().eq("approx_eq") { return String_from("use `Signal::approx_eq(a, b, eps)` from `use std::signal::Signal` instead") }
    String_new()
}

/// Replacement hints for the `std::collections::compiler` free functions
/// retired by #917 (Arena / SlotMap / Interner type surface).
fn removed_compiler_member_hint(name: String) -> String {
    if name.clone().eq("arena_new") {
        return "use `Arena::new()` from `use std::collections::compiler::Arena` instead"
    }
    if name.clone().eq("arena_alloc") {
        return "use `a.alloc(value)` on `Arena` instead"
    }
    if name.clone().eq("arena_get") {
        return "use `a.get(idx)` on `Arena` instead"
    }
    if name.clone().eq("arena_len") {
        return "use `a.len()` on `Arena` instead"
    }
    if name.clone().eq("slotmap_new") {
        return "use `SlotMap::new()` from `use std::collections::compiler::SlotMap` instead"
    }
    if name.clone().eq("slotmap_insert") {
        return "use `m.insert(value)` on `SlotMap` instead"
    }
    if name.clone().eq("slotmap_get") {
        return "use `m.get(key)` on `SlotMap` instead"
    }
