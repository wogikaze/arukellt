fn removed_random_member_hint(name: String) -> String {
    if name.clone().eq("seeded_random") { return String_from("use `Rng::new(seed).next()` from `use std::random::Rng` instead") }
    if name.clone().eq("seeded_range") { return String_from("use `Rng::new(seed).range(lo, hi)` from `use std::random::Rng` instead") }
    if name.clone().eq("shuffle_i32") { return String_from("use `Rng::new(seed).shuffle(v)` from `use std::random::Rng` instead") }
    String_new()
}

test mod "removed_names" {
    test "to_string family" {
        assert(len(removed_name_hint("i32_to_string")) > 0)
        assert(len(removed_name_hint("bool_to_string")) > 0)
    }
    test "vec ctor" {
        assert(len(removed_name_hint("Vec_new_i32")) > 0)
        assert(len(removed_name_hint("new_i32")) > 0)
        assert(len(removed_module_member_hint("vec", "new_i32")) > 0)
        assert(len(removed_module_member_hint("std::collections::vec", "new_i32")) > 0)
        assert(len(removed_module_member_hint("vec", "unrelated")) == 0)
    }
    test "hashmap builtins" {
        assert(len(removed_name_hint("HashMap_i32_i32_new")) > 0)
        assert(len(removed_name_hint("HashMap_new_String_i32")) > 0)
        assert(len(removed_name_hint("HashMap_String_fn_get")) > 0)
    }
    test "io env fs" {
        assert(len(removed_name_hint("read_to_string")) > 0)
        assert(len(removed_name_hint("exists")) > 0)
        assert(len(removed_name_hint("get_var")) > 0)
    }
    test "removed env module member" {
        assert(len(removed_module_member_hint("std::env", "get_var")) > 0)
        assert(len(removed_module_member_hint("std::host::env", "get_var")) > 0)
    }
    test "removed host core namespace frees" {
        assert(len(removed_module_member_hint("std::host::process", "exit")) > 0)
        assert(len(removed_module_member_hint("std::process", "abort")) > 0)
        assert(len(removed_module_member_hint("process", "id")) > 0)
        assert(len(removed_module_member_hint("std::host::random", "random_i32")) > 0)
        assert(len(removed_module_member_hint("std::host::random", "next_f64")) > 0)
        // The bare `random` alias can be either module; both hint families
        // must be reachable through it.
        assert(len(removed_module_member_hint("random", "random_bool")) > 0)
        assert(len(removed_module_member_hint("random", "seeded_random")) > 0)
        assert(len(removed_module_member_hint("std::cli", "parse_args")) > 0)
        assert(len(removed_module_member_hint("std::cli", "option")) > 0)
        assert(len(removed_module_member_hint("std::signal", "fft")) > 0)
        assert(len(removed_module_member_hint("std::signal", "approx_eq")) > 0)
        // The deterministic std::random module keeps its own Rng hints, and the
        // experimental fd helpers stay callable.
        assert(len(removed_module_member_hint("std::random", "seeded_random")) > 0)
        assert(len(removed_module_member_hint("std::host::fs", "fd_seek")) == 0)
        assert(len(removed_module_member_hint("std::signal", "unrelated")) == 0)
    }
    test "removed compiler collections frees" {
        assert(len(removed_module_member_hint("compiler", "arena_new")) > 0)
        assert(len(removed_module_member_hint("collections::compiler", "slotmap_get")) > 0)
        assert(len(removed_module_member_hint("std::collections::compiler", "interner_lookup")) > 0)
        assert(len(removed_name_hint("arena_alloc")) > 0)
        assert(len(removed_name_hint("slotmap_contains")) > 0)
        assert(len(removed_name_hint("interner_intern")) > 0)
        assert(len(removed_module_member_hint("compiler", "unrelated")) == 0)
    }
    test "removed bimap trie frees" {
        assert(len(removed_module_member_hint("bimap", "bimap_i32_i32_new")) > 0)
        assert(len(removed_module_member_hint("collections::bimap", "bimap_i32_i32_get_by_key")) > 0)
        assert(len(removed_module_member_hint("std::collections::bimap", "bimap_i32_i32_remove_by_value")) > 0)
        assert(len(removed_name_hint("bimap_i32_i32_len")) > 0)
        assert(len(removed_module_member_hint("trie", "trie_new")) > 0)
        assert(len(removed_module_member_hint("collections::trie", "trie_count_with_prefix")) > 0)
        assert(len(removed_module_member_hint("std::collections::trie", "trie_has_prefix")) > 0)
        assert(len(removed_name_hint("trie_contains")) > 0)
        assert(len(removed_module_member_hint("bimap", "unrelated")) == 0)
        assert(len(removed_module_member_hint("trie", "unrelated")) == 0)
    }
    test "removed ordered frees" {
        assert(len(removed_module_member_hint("ordered", "btree_new")) > 0)
        assert(len(removed_module_member_hint("collections::ordered", "btree_range")) > 0)
        assert(len(removed_module_member_hint("std::collections::ordered", "index_map_insert")) > 0)
        assert(len(removed_name_hint("btree_set_insert")) > 0)
        assert(len(removed_name_hint("btree_set_find_idx")) > 0)
        assert(len(removed_name_hint("index_set_contains")) > 0)
        assert(len(removed_name_hint("bitset_union")) > 0)
        assert(len(removed_name_hint("bitset_intersection")) > 0)
        // The 10 stable frees completed their ADR-087 window and were deleted
        // in the 2026-10-29 Wave 2, so they now carry E0100 hints too.
        assert(len(removed_name_hint("sorted_map_new")) > 0)
        assert(len(removed_name_hint("bitset_new")) > 0)
        assert(len(removed_module_member_hint("ordered", "sorted_map_get")) > 0)
        assert(len(removed_module_member_hint("ordered", "bitset_test")) > 0)
        assert(len(removed_module_member_hint("ordered", "unrelated")) == 0)
    }
    test "removed priority queue frees" {
        assert(len(removed_module_member_hint("linear", "pq_new")) > 0)
        assert(len(removed_module_member_hint("collections::linear", "pq_push")) > 0)
        assert(len(removed_module_member_hint("std::collections::linear", "pq_pop")) > 0)
        assert(len(removed_name_hint("pq_new")) > 0)
        assert(len(removed_name_hint("pq_clear")) > 0)
        // The deque_* frees are still callable through their own ADR-014
        // window, so they must not gain a removal hint.
        assert(len(removed_module_member_hint("linear", "deque_new")) == 0)
        assert(len(removed_module_member_hint("linear", "unrelated")) == 0)
    }
    test "result option helpers" {
        assert(len(removed_name_hint("ok")) > 0)
        assert(len(removed_name_hint("err")) > 0)
        assert(len(removed_name_hint("expect")) > 0)
        assert(len(removed_name_hint("unwrap_or_else")) > 0)
        assert(len(removed_name_hint("ok_or")) > 0)
    }
    test "io shims" { assert(len(removed_name_hint("eprintln")) > 0) }
    test "deprecated prelude hints" {
        assert(len(removed_name_hint("concat")) > 0)
        assert(len(removed_name_hint("char_at")) > 0)
        assert(len(removed_name_hint("println")) > 0)
    }
    test "gated prelude hints" {
        assert(len(removed_name_hint("eq")) > 0)
        assert(len(removed_name_hint("substring")) > 0)
        assert(len(removed_name_hint("push_char")) > 0)
    }
    test "retired clone free has receiver and module hints" {
        assert(len(removed_name_hint("clone")) > 0)
        assert(len(removed_module_member_hint("string", "clone")) > 0)
        assert(len(removed_private_member_hint("prelude", "clone")) > 0)
    }
    test "retired string eq free has qualified member hints" {
        assert(len(removed_name_hint("eq")) > 0)
        assert(len(removed_module_member_hint("string", "eq")) > 0)
        assert(len(removed_module_member_hint("collections::string", "eq")) > 0)
        assert(len(removed_module_member_hint("std::collections::string", "eq")) > 0)
        assert(len(removed_private_member_hint("string", "eq")) > 0)
        assert(len(removed_private_member_hint("std::collections::string", "eq")) > 0)
    }
    test "retired io error message free has method hints" {
        assert(len(removed_name_hint("io_error_message")) > 0)
        assert(len(removed_module_member_hint("io", "io_error_message")) > 0)
    }
    test "retired text prelude frees have method hints" {
        assert(len(removed_name_hint("byte_at")) > 0)
        assert(len(removed_name_hint("slice")) > 0)
        assert(len(removed_name_hint("substring")) > 0)
        assert(len(removed_name_hint("to_string")) > 0)
        assert(len(removed_name_hint("starts_with")) > 0)
        assert(len(removed_name_hint("ends_with")) > 0)
        assert(len(removed_name_hint("contains")) > 0)
        assert(len(removed_name_hint("index_of")) > 0)
    }
    test "retired prelude frees have receiver hints" {
        assert(len(removed_name_hint("abs")) > 0)
        assert(len(removed_name_hint("args")) > 0)
        assert(len(removed_name_hint("byte_len")) > 0)
        assert(len(removed_name_hint("clamp_i32")) > 0)
        assert(len(removed_name_hint("exit")) > 0)
        assert(len(removed_name_hint("format_bool")) > 0)
        assert(len(removed_name_hint("format_i32")) > 0)
        assert(len(removed_name_hint("gcd")) > 0)
        assert(len(removed_name_hint("is_empty")) > 0)
        assert(len(removed_name_hint("join")) > 0)
        assert(len(removed_name_hint("lines")) > 0)
        assert(len(removed_name_hint("max")) > 0)
        assert(len(removed_name_hint("min")) > 0)
        assert(len(removed_name_hint("pad_left")) > 0)
        assert(len(removed_name_hint("pad_right")) > 0)
        assert(len(removed_name_hint("parse_f64")) > 0)
        assert(len(removed_name_hint("parse_i32")) > 0)
        assert(len(removed_name_hint("parse_i64")) > 0)
        assert(len(removed_name_hint("repeat")) > 0)
        assert(len(removed_name_hint("replace")) > 0)
        assert(len(removed_name_hint("split")) > 0)
        assert(len(removed_name_hint("sqrt")) > 0)
        assert(len(removed_name_hint("to_lower")) > 0)
        assert(len(removed_name_hint("to_lowercase")) > 0)
        assert(len(removed_name_hint("to_upper")) > 0)
