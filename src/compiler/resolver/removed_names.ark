        assert(len(removed_module_member_hint(String_from("io"), String_from("buffered_writer"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("write_all"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("write_string"))) > 0)
