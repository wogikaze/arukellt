    if name.clone().eq("count_eq") {
        return "removed free function; use `v.iter().count_eq(target)` via `use std::core::iter`"
    }
    if name.clone().eq("binary_search") {
        return "removed free function; use `v.binary_search(target)` via `use std::collections::vec`"
    }
    if name.clone().eq("min_i32") {
        return "removed free function; use `v.min()` via `use std::collections::vec`"
    }
    if name.clone().eq("max_i32") {
        return "removed free function; use `v.max()` via `use std::collections::vec`"
    }
    if name.clone().eq("sort_by") {
        return "removed free sort algorithm; use `v.sort()` via `use std::collections::vec`"
    }
    if name.clone().eq("binary_search_by") {
        return "removed free function; use `v.binary_search(target)` via `use std::collections::vec`"
    }
    if name.clone().eq("binary_search_by_key") {
        return "removed free function; use `v.binary_search_by_key(target_key, key)` via `use std::collections::vec`"
    }
    if name.clone().eq("lower_bound") {
        return "removed free function; use `v.lower_bound(target)` via `use std::collections::vec`"
    }
    if name.clone().eq("upper_bound") {
        return "removed free function; use `v.upper_bound(target)` via `use std::collections::vec`"
    }
    if name.clone().eq("min_by") {
        return "removed free function; use `v.min()` via `use std::collections::vec`"
    }
    if name.clone().eq("max_by") {
        return "removed free function; use `v.max()` via `use std::collections::vec`"
    }
    if name.clone().eq("min_by_key") {
        return "removed free function; use `v.min_by_key(key)` via `use std::collections::vec`"
    }
    if name.clone().eq("max_by_key") {
        return "removed free function; use `v.max_by_key(key)` via `use std::collections::vec`"
