// The 18 std::test assertion / expectation frees were deleted by #917 after
// the ADR-087 Wave 1 window (bench was experimental and retired directly).
// Both module-qualified and bare old calls name the Test replacement.
fn removed_test_free_hint(name: String) -> String {
    if name.clone().eq("assert_true") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_true(cond)` instead")
    }
    if name.clone().eq("assert_false") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_false(cond)` instead")
    }
    if name.clone().eq("assert_eq_debug") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_eq_debug(actual, expected)` instead")
    }
    if name.clone().eq("assert_eq_i32") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_eq_i32(actual, expected)` instead")
    }
    if name.clone().eq("assert_eq_i64") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_eq_i64(actual, expected)` instead")
    }
    if name.clone().eq("assert_eq_f64") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_eq_f64(actual, expected)` instead")
    }
    if name.clone().eq("assert_eq_string") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_eq_string(actual, expected)` instead")
    }
    if name.clone().eq("assert_eq_bool") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_eq_bool(actual, expected)` instead")
    }
    if name.clone().eq("assert_ne_i32") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_ne_i32(actual, unexpected)` instead")
    }
    if name.clone().eq("assert_ne_string") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_ne_string(actual, unexpected)` instead")
    }
    if name.clone().eq("expect_ok_i32") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::expect_ok_i32(result)` instead")
    }
    if name.clone().eq("expect_err_string") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::expect_err_string(result)` instead")
    }
    if name.clone().eq("expect_some_i32") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::expect_some_i32(option)` instead")
    }
    if name.clone().eq("expect_none_i32") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::expect_none_i32(option)` instead")
    }
    if name.clone().eq("assert_contains") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_contains(haystack, needle)` instead")
    }
    if name.clone().eq("assert_eq_snapshot") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_eq_snapshot(actual, expected)` instead")
    }
    if name.clone().eq("assert_msg") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::assert_msg(cond, message)` instead")
    }
    if name.clone().eq("bench") {
        return String_from("removed std::test free function; import `use std::test::Test` and call `Test::bench(name, iterations, f)` instead")
    }
    String_new()
}

fn removed_module_member_hint(module: String, name: String) -> String {
    if module.clone().eq("fs") || module.clone().eq("host::fs") || module.clone().eq("std::fs") || module.clone().eq("std::host::fs") {
        return removed_host_fs_member_hint(name)
    }
    if (module.clone().eq("string") || module.clone().eq("collections::string") ||
        module.clone().eq("std::collections::string")) && name.clone().eq("clone") {
        return String_from("removed free function; use `s.clone()` on the String receiver instead")
    }
    if module.clone().eq("seq") || module.clone().eq("std::seq") {
        return removed_seq_member_hint(name)
    }
    if module.clone().eq("test") || module.clone().eq("std::test") {
        return removed_test_free_hint(name)
    }
    if module.clone().eq("compiler") || module.clone().eq("collections::compiler") || module.clone().eq("std::collections::compiler") {
        return removed_compiler_member_hint(name)
    }
    if module.clone().eq("bimap") || module.clone().eq("collections::bimap") || module.clone().eq("std::collections::bimap") {
        return removed_bimap_member_hint(name)
    }
    if module.clone().eq("trie") || module.clone().eq("collections::trie") || module.clone().eq("std::collections::trie") {
        return removed_trie_member_hint(name)
    }
    if module.clone().eq("ordered") || module.clone().eq("collections::ordered") || module.clone().eq("std::collections::ordered") {
        return removed_ordered_member_hint(name)
    }
    if module.clone().eq("linear") || module.clone().eq("collections::linear") || module.clone().eq("std::collections::linear") {
        return removed_pq_member_hint(name)
    }
    if module.clone().eq("vec") || module.clone().eq("collections::vec") || module.clone().eq("std::collections::vec") {
        if name.clone().eq("new_i32") {
            return "removed free Vec constructor; use `Vec::new<i32>()` instead"
        }
        return String_new()
    }
    if module.clone().eq("clock") || module.clone().eq("host::clock") || module.clone().eq("std::host::clock") {
        return removed_host_clock_member_hint(name)
    }
    if module.clone().eq("env") || module.clone().eq("host::env") || module.clone().eq("std::env") || module.clone().eq("std::host::env") {
        return removed_host_env_member_hint(name)
    }
    if module.clone().eq("process") || module.clone().eq("host::process") || module.clone().eq("std::process") || module.clone().eq("std::host::process") {
        return removed_host_process_member_hint(name)
    }
    if module.clone().eq("host::random") || module.clone().eq("std::host::random") {
        return removed_host_random_member_hint(name)
    }
    if module.clone().eq("cli") || module.clone().eq("std::cli") {
        return removed_cli_member_hint(name)
    }
    if module.clone().eq("signal") || module.clone().eq("std::signal") {
        return removed_signal_member_hint(name)
    }
    if is_retired_hashmap_module(module.clone()) {
        return hashmap_method_replacement_hint()
    }
    if module.clone().eq("hash_set") || module.clone().eq("hashset") {
        return hashset_method_replacement_hint()
    }
    if module.clone().eq("wit") || module.clone().eq("types") {
        return removed_wit_type_member_hint(name)
    }
    if module.clone().eq("scan") {
        return removed_wit_scan_member_hint(name)
    }
    if module.clone().eq("names") {
        return removed_wit_name_member_hint(name)
    }
    if module.clone().eq("ast") {
        return removed_wit_ast_member_hint(name)
    }
    if module.clone().eq("parser") {
        let parser_json_hint = removed_json_member_hint(name.clone())
        if len(parser_json_hint.clone()) > 0 {
            return parser_json_hint
        }
        let parser_toml_hint = removed_toml_member_hint(name.clone())
        if len(parser_toml_hint.clone()) > 0 {
            return parser_toml_hint
        }
        return removed_wit_parser_member_hint(name)
    }
    if module.clone().eq("component") {
        return removed_component_member_hint(name)
    }
    if module.clone().eq("handle") {
        return removed_component_handle_member_hint(name)
    }
    if module.clone().eq("printer") && name.clone().eq("print_wit") {
        return String_from("use `w.to_wit()` on `World` instead")
    }
    if module.clone().eq("fmt") {
        return removed_fmt_member_hint(name)
    }
    if module.clone().eq("rope") {
        return removed_rope_member_hint(name)
    }
    if module.clone().eq("text") {
        return removed_text_member_hint(name)
    }
    if module.clone().eq("string") || module.clone().eq("collections::string") ||
    module.clone().eq("std::collections::string") {
        return removed_string_member_hint(name)
    }
    if module.clone().eq("iter") {
        return removed_iter_member_hint(name)
    }
    if module.clone().eq("wasm") {
        return removed_wasm_member_hint(name)
    }
    if module.clone().eq("bytes") {
        return removed_bytes_member_hint(name)
    }
    if module.clone().eq("path") {
        return removed_path_member_hint(name)
    }
    if module.clone().eq("time") {
        return removed_time_member_hint(name)
    }
    if module.clone().eq("random") || module.clone().eq("std::random") {
        // The alias `random` is shared by std::random (seeded Rng helpers) and
        // std::host::random (host entropy). The leaf names do not overlap, so
        // try the deterministic hints first and fall through to the host ones.
        let seeded_hint = removed_random_member_hint(name.clone())
        if len(seeded_hint.clone()) > 0 {
            return seeded_hint
        }
        return removed_host_random_member_hint(name)
    }
    if module.clone().eq("raw") {
        return removed_raw_member_hint(name)
    }
    if module.clone().eq("core") {
        return removed_core_free_hint(name)
    }
    if module.clone().eq("error") {
        return removed_error_member_hint(name)
    }
    if module.clone().eq("hash") {
        return removed_hash_member_hint(name)
    }
    if module.clone().eq("canonical") {
        return removed_canonical_member_hint(name)
    }
    if module.clone().eq("json") {
        return removed_json_member_hint(name)
    }
    if module.clone().eq("toml") {
        return removed_toml_member_hint(name)
    }
    if module.clone().eq("csv") {
        return removed_csv_member_hint(name)
    }
    let simd_type = removed_simd_lane_type(module.clone())
    if len(simd_type.clone()) > 0 {
        return "removed free function; call `"
        .concat(simd_type)
        .concat("::")
        .concat(name.clone())
        .concat("(...)` with the namespace type from `use std::simd::")
        .concat(module.clone())
        .concat("` instead")
    }
    if !module.clone().eq("io") {
        return String_new()
    }
    let io_free_hint = removed_io_free_hint(name.clone())
    if len(io_free_hint.clone()) > 0 {
        return io_free_hint
    }
    if name.clone().eq("reader_eof") { return "use `r.is_eof()` on `Reader` instead" }
    if name.clone().eq("reader_read") { return "use `r.read(n)` on `Reader` instead" }
    if name.clone().eq("reader_read_exact") { return "use `Io::read_exact(r, n)` from `use std::io::Io` instead" }
    if name.clone().eq("reader_read_all") { return "use `Io::read_to_end(r)` from `use std::io::Io` instead" }
    if name.clone().eq("reader_read_line") { return "use `r.read_line()` from `use std::io::BufRead` instead (`Option<String>`, `None` at EOF)" }
    if name.clone().eq("copy_bytes") { return "use `Io::copy(from, to)` from `use std::io::Io` instead" }
    if name.clone().eq("copy") { return "use `Io::copy(from, to)` from `use std::io::Io` instead" }
    if name.clone().eq("copy_trait") { return "use `Io::copy(from, to)` from `use std::io::Io` instead" }
    if name.clone().eq("new_memory_buffer") { return "use `Reader::new()` for a source or `Writer::new()` for a sink instead" }
    if name.clone().eq("write_bytes") { return "use `w.write(data)` on `Writer` instead" }
    if name.clone().eq("read_bytes") { return "use `r.read(n)` on `Reader` instead" }
    if name.clone().eq("seek_to") { return "use `r.seek(SeekFrom::Start(pos))` from `use std::io::{Seek, SeekFrom}` instead" }
    if name.clone().eq("buffer_position") { return "use `r.position()` from `use std::io::Seek` instead" }
    if name.clone().eq("buffer_len") { return "use `r.len()` on `Reader` instead" }
    if name.clone().eq("fill_buffer") { return "use `r.fill_buf()` from `use std::io::BufRead` instead" }
    if name.clone().eq("file_from_fd") { return "the experimental fd lane was retired; use `std::host::fs::File::open(path)` instead" }
    if name.clone().eq("file_read") { return "the experimental fd lane was retired; use `Read::read` on `std::host::fs::File` instead" }
    if name.clone().eq("file_write") { return "the experimental fd lane was retired; use `std::host::fs::File::create` and `Write::write` instead (write side open under #693)" }
    if name.clone().eq("reader_from_bytes") { return "use `Reader::from_bytes(data)` from `use std::io::Reader` instead" }
    if name.clone().eq("buf_reader_new") { return "use `BufReader::new(r, cap)` from `use std::io::BufReader` instead" }
    if name.clone().eq("buffered_reader") { return "use `BufReader::new(r, cap)` from `use std::io::BufReader` instead" }
    if name.clone().eq("buf_reader_read_line") { return "use `br.read_line()` from `use std::io::BufRead` instead (`Option<String>`, `None` at EOF)" }
    if name.clone().eq("buf_writer_new") { return "use `BufWriter::new(w, cap)` from `use std::io::BufWriter` instead" }
    if name.clone().eq("buffered_writer") { return "use `BufWriter::new(w, cap)` from `use std::io::BufWriter` instead" }
    if name.clone().eq("buf_writer_write_str") { return "use `bw.write_string(s)` on `BufWriter` instead" }
    if name.clone().eq("buf_writer_flush") { return "use `bw.flush()` on `BufWriter` instead" }
    if name.clone().eq("writer_new") { return "use `Writer::new()` from `use std::io::Writer` instead" }
    if name.clone().eq("write_all") { return "use `Io::write_all(w, data)` from `use std::io::Io` instead" }
    if name.clone().eq("write_string") { return "use `w.write_string(s)` on `Writer` instead" }
    if name.clone().eq("writer_flush") { return "use `w.flush()` on `Writer` instead" }
    if name.clone().eq("writer_to_bytes") { return "use `w.into_bytes()` on `Writer` instead" }
    if name.clone().eq("writer_write") { return "use `io::Stdout::new().write(data)` or `io::Stderr::new().write(data)` from `use std::io` instead" }
    if name.clone().eq("writer_write_str") { return "use `io::Stdout::new().write_string(s)` or `io::Stderr::new().write_string(s)` from `use std::io` instead" }
    String_new()
}

