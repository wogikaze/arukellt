        assert(len(removed_name_hint("eq")) > 0)
        assert(len(removed_name_hint("clone")) > 0)
        assert(len(removed_name_hint("substring")) > 0)
    }
    test "removed seq frees have E0100 hints" {
        assert(len(removed_name_hint("sort_i32")) > 0)
        assert(len(removed_name_hint("sort_String")) > 0)
        assert(len(removed_name_hint("map_i64_i64")) > 0)
        assert(len(removed_name_hint("filter_String")) > 0)
        assert(len(removed_name_hint("fold_f64_f64")) > 0)
        assert(len(removed_name_hint("any_i32")) > 0)
