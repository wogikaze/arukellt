    }
    test "removed host fs module members have hints" {
        assert(len(removed_module_member_hint(String_from("fs"), String_from("read_to_string"))) > 0)
        assert(len(removed_module_member_hint(String_from("host::fs"), String_from("read_bytes"))) > 0)
        assert(len(removed_module_member_hint(String_from("std::fs"), String_from("write_string"))) > 0)
        assert(len(removed_module_member_hint(String_from("std::host::fs"), String_from("write_bytes"))) > 0)
        assert(len(removed_module_member_hint(String_from("fs"), String_from("is_readable_file"))) > 0)
