        assert(len(removed_module_member_hint(String_from("hash_set"), String_from("hashset_i32_union"))) > 0)
        assert(len(removed_module_member_hint(String_from("hash_set"), String_from("hashset_str_insert"))) > 0)
        assert(len(removed_name_hint(String_from("hashset_i32_to_vec"))) > 0)
        assert(len(removed_name_hint(String_from("hashset_str_remove"))) > 0)
    }
    test "removed simd lane frees have associated-function hints" {
        assert(len(removed_module_member_hint(String_from("f32x4"), String_from("splat"))) > 0)
        assert(len(removed_module_member_hint(String_from("i32x4"), String_from("add"))) > 0)
        assert(len(removed_module_member_hint(String_from("i8x16"), String_from("extract_lane"))) > 0)
        assert(len(removed_module_member_hint(String_from("f64x2"), String_from("sqrt"))) > 0)
        assert(len(removed_module_member_hint(String_from("u64x2"), String_from("zero"))) > 0)
        assert(len(removed_module_member_hint(String_from("v128"), String_from("any_true"))) > 0)
    }
    test "non-simd modules keep no simd hint" {
        assert(len(removed_module_member_hint(String_from("f32x4x"), String_from("splat"))) == 0)
        assert(len(removed_module_member_hint(String_from("text"), String_from("splat"))) == 0)
    }
    test "removed json/toml value frees have method hints" {
        assert(len(removed_module_member_hint(String_from("json"), String_from("json_get"))) > 0)
        assert(len(removed_module_member_hint(String_from("json"), String_from("json_as_i32"))) > 0)
        assert(len(removed_module_member_hint(String_from("json"), String_from("quote_string"))) > 0)
        assert(len(removed_module_member_hint(String_from("json"), String_from("json_i32"))) > 0)
        assert(len(removed_module_member_hint(String_from("parser"), String_from("json_parse_string_at"))) > 0)
        assert(len(removed_module_member_hint(String_from("toml"), String_from("toml_find_value"))) > 0)
        assert(len(removed_module_member_hint(String_from("csv"), String_from("csv_parse_row"))) > 0)
        assert(len(removed_name_hint(String_from("csv_parse_row"))) > 0)
        assert(len(removed_module_member_hint(String_from("json"), String_from("stringify"))) > 0)
        assert(len(removed_module_member_hint(String_from("json"), String_from("parse_error_message"))) > 0)
        assert(len(removed_module_member_hint(String_from("toml"), String_from("toml_get"))) > 0)
        assert(len(removed_module_member_hint(String_from("toml"), String_from("toml_as_string"))) > 0)
    }
    test "removed path/time/random frees have receiver hints" {
        assert(len(removed_module_member_hint(String_from("path"), String_from("join"))) > 0)
        assert(len(removed_module_member_hint(String_from("path"), String_from("file_name"))) > 0)
        assert(len(removed_module_member_hint(String_from("path"), String_from("last_index_of"))) > 0)
        assert(len(removed_module_member_hint(String_from("time"), String_from("duration_ms"))) > 0)
        assert(len(removed_module_member_hint(String_from("time"), String_from("duration_ns"))) > 0)
        assert(len(removed_module_member_hint(String_from("random"), String_from("seeded_random"))) > 0)
        assert(len(removed_module_member_hint(String_from("random"), String_from("shuffle_i32"))) > 0)
    }
    test "removed core frees have receiver hints" {
        assert(len(removed_module_member_hint(String_from("core"), String_from("range_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("core"), String_from("range_contains"))) > 0)
        assert(len(removed_module_member_hint(String_from("core"), String_from("range_inclusive_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("core"), String_from("cmp_i32"))) > 0)
        assert(len(removed_module_member_hint(String_from("core"), String_from("identity"))) > 0)
        assert(len(removed_module_member_hint(String_from("error"), String_from("error_message"))) > 0)
        assert(len(removed_module_member_hint(String_from("hash"), String_from("combine"))) > 0)
        assert(len(removed_name_hint(String_from("range_new"))) > 0)
        assert(len(removed_name_hint(String_from("identity"))) > 0)
        assert(len(removed_name_hint(String_from("combine"))) > 0)
    }
    test "live path/time/random members keep no removal hint" {
        assert(len(removed_module_member_hint(String_from("path"), String_from("Path"))) == 0)
        assert(len(removed_module_member_hint(String_from("time"), String_from("Duration"))) == 0)
        assert(len(removed_module_member_hint(String_from("random"), String_from("Rng"))) == 0)
    }

}
