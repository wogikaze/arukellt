// The 44 eager iterator constructor / collector frees were retired (#917);
// the lazy adapter methods on `VecIter` and the `Iterator` capabilities are
// the only reachable spellings now.
fn removed_iter_member_hint(name: String) -> String {
    if eq(clone(name), "vec_iter") { return String_from("use `v.iter()` instead") }
    if eq(clone(name), "range_iter") { return String_from("use `r.into_iter()` instead") }
    if eq(clone(name), "range_inclusive_iter") { return String_from("use `r.into_iter()` instead") }
    if eq(clone(name), "map_iter") { return String_from("use `v.iter().map(f)` instead") }
    if eq(clone(name), "filter_iter") { return String_from("use `v.iter().filter(f)` instead") }
    if eq(clone(name), "take_iter") { return String_from("use `v.iter().take(n)` instead") }
    if eq(clone(name), "skip_iter") { return String_from("use `v.iter().skip(n)` instead") }
    if eq(clone(name), "chain_iter") { return String_from("use `a.iter().chain(b.iter())` instead") }
    if eq(clone(name), "enumerate_iter") { return String_from("use `v.iter().enumerate()` instead") }
    if eq(clone(name), "zip_iter") { return String_from("use `a.iter().zip(b.iter())` instead") }
    if eq(clone(name), "flat_map_iter") { return String_from("use `v.iter().flat_map(f)` instead") }
    if eq(clone(name), "peek_iter") { return String_from("use `v.iter().peekable()` instead") }
    if eq(clone(name), "step_by_iter") { return String_from("use `v.iter().step_by(n)` instead") }
    if eq(clone(name), "scan_iter") { return String_from("use `v.iter().scan(init, f)` instead") }
    if eq(clone(name), "unique_iter") { return String_from("use `v.iter().unique()` instead") }
    if eq(clone(name), "rev_iter") { return String_from("use `v.iter().rev()` instead") }
    if eq(clone(name), "collect_vec_iter") { return String_from("use `it.collect()` instead") }
    if eq(clone(name), "collect_map_iter") { return String_from("use `it.collect()` instead") }
    if eq(clone(name), "collect_filter_iter") { return String_from("use `it.collect()` instead") }
    if eq(clone(name), "collect_take_iter") { return String_from("use `it.collect()` instead") }
    if eq(clone(name), "collect_skip_iter") { return String_from("use `it.collect()` instead") }
