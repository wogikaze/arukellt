fn removed_component_handle_member_hint(name: String) -> String {
    if eq(clone(name), "handle_table_new") || eq(clone(name), "handle_table_i32_new") {
        return String_from("use `HandleTableI32::new()` instead")
    }
    if eq(clone(name), "handle_new") || eq(clone(name), "handle_table_i32_new_handle") {
        return String_from("use `t.insert(value)` on `HandleTableI32` instead")
    }
    if eq(clone(name), "handle_get") || eq(clone(name), "handle_table_i32_get") {
        return String_from("use `t.get(handle)` on `HandleTableI32` instead")
    }
    if eq(clone(name), "handle_drop") || eq(clone(name), "handle_table_i32_drop") {
        return String_from("use `t.remove(handle)` on `HandleTableI32` instead")
    }
    if eq(clone(name), "handle_len") || eq(clone(name), "handle_table_i32_len") {
        return String_from("use `t.len()` on `HandleTableI32` instead")
    }
    String_new()
}

// Prelude decls outside the ADR-072 stable set: still public in
// std::prelude but no longer auto-imported. The hint keeps the call
// working through an explicit selective import.
fn removed_gated_prelude_hint(name: String) -> String {
    if !is_gated_prelude_name(clone(name)) {
        return String_new()
    }
    "no longer auto-imported; add `use std::prelude::{".concat(name.concat("}`"))
}

fn is_gated_prelude_name(name: String) -> bool {
    if eq(clone(name), "Box") || eq(clone(name), "Box_new") || eq(clone(name), "Slice") {
        return true
    }
    if eq(clone(name), "abs") || eq(clone(name), "args") || eq(clone(name), "as_slice") {
        return true
    }
    if eq(clone(name), "assert_eq") || eq(clone(name), "assert_eq_i64") || eq(clone(name), "assert_eq_str") {
        return true
    }
    if eq(clone(name), "assert_ne") || eq(clone(name), "byte_at") || eq(clone(name), "byte_len") {
        return true
    }
    if eq(clone(name), "clamp_i32") || eq(clone(name), "clone") || eq(clone(name), "contains") {
        return true
    }
    if eq(clone(name), "ends_with") || eq(clone(name), "eq") || eq(clone(name), "exit") {
        return true
    }
    if eq(clone(name), "f32_to_f64") || eq(clone(name), "f32_to_string") || eq(clone(name), "f64_bits_hi") {
        return true
    }
    if eq(clone(name), "f64_bits_lo") || eq(clone(name), "f64_to_f32") || eq(clone(name), "format_bool") {
        return true
    }
    if eq(clone(name), "format_i32") || eq(clone(name), "gcd") || eq(clone(name), "i16_to_i32") {
        return true
    }
    if eq(clone(name), "i32_to_i16") || eq(clone(name), "i32_to_i64") || eq(clone(name), "i32_to_i8") {
        return true
    }
    if eq(clone(name), "i32_to_u16") || eq(clone(name), "i32_to_u32") || eq(clone(name), "i32_to_u8") {
        return true
    }
    if eq(clone(name), "i64_to_i32") || eq(clone(name), "i8_to_i32") || eq(clone(name), "index_of") {
        return true
    }
    if eq(clone(name), "is_empty") || eq(clone(name), "is_err") || eq(clone(name), "is_none") {
        return true
    }
    if eq(clone(name), "is_ok") || eq(clone(name), "is_some") || eq(clone(name), "join") {
        return true
    }
    if eq(clone(name), "lines") || eq(clone(name), "max") || eq(clone(name), "min") {
        return true
    }
    if eq(clone(name), "pad_left") || eq(clone(name), "pad_right") || eq(clone(name), "parse_f64") {
        return true
    }
    if eq(clone(name), "parse_i32") || eq(clone(name), "parse_i64") || eq(clone(name), "push_char") {
        return true
    }
    if eq(clone(name), "repeat") || eq(clone(name), "replace") || eq(clone(name), "slice") {
        return true
    }
    if eq(clone(name), "slice_get") || eq(clone(name), "slice_len") || eq(clone(name), "split") {
        return true
    }
    if eq(clone(name), "sqrt") || eq(clone(name), "starts_with") || eq(clone(name), "substring") {
        return true
    }
    if eq(clone(name), "to_lower") || eq(clone(name), "to_lowercase") || eq(clone(name), "to_string") {
        return true
    }
    if eq(clone(name), "to_upper") || eq(clone(name), "to_uppercase") || eq(clone(name), "trim") {
        return true
    }
    if eq(clone(name), "trim_end") || eq(clone(name), "trim_start") || eq(clone(name), "u16_to_i32") {
        return true
    }
    if eq(clone(name), "u32_to_u64") || eq(clone(name), "u64_to_u32") || eq(clone(name), "u8_to_i32") {
        return true
    }
    if eq(clone(name), "unbox") || eq(clone(name), "unwrap") || eq(clone(name), "unwrap_or") {
        return true
    }
    if eq(clone(name), "values") {
        return true
    }
    false
}
// Shared replacement text for the retired typed hash adapters; the four
// module aliases all pointed at the old `hash_map::hashmap_*` family.
fn hashmap_method_replacement_hint() -> String {
    text::concat(
        String_from("removed HashMap helper; use `HashMap::new<K, V>()` plus receiver methods "),
        text::concat(
            String_from("(`m.insert(k, v)`, `m.get(k)`, `m.contains_key(k)`, `m.remove(k)`, `m.len()`, "),
            String_from("`m.is_empty()`, `m.keys()`, `m.values()`, `m.entries()`)")
        )
    )
}

// The std::simd lane modules became namespace types in #917. Map the module
// alias used at the call site to the namespace type so the E0100 hint names
// the associated-function spelling.
fn removed_simd_lane_type(module: String) -> String {
    if eq(clone(module), "f32x4") { return String_from("F32x4") }
    if eq(clone(module), "f64x2") { return String_from("F64x2") }
    if eq(clone(module), "i8x16") { return String_from("I8x16") }
    if eq(clone(module), "i16x8") { return String_from("I16x8") }
    if eq(clone(module), "i32x4") { return String_from("I32x4") }
    if eq(clone(module), "i64x2") { return String_from("I64x2") }
    if eq(clone(module), "u8x16") { return String_from("U8x16") }
    if eq(clone(module), "u16x8") { return String_from("U16x8") }
    if eq(clone(module), "u32x4") { return String_from("U32x4") }
    if eq(clone(module), "u64x2") { return String_from("U64x2") }
    if eq(clone(module), "v128") { return String_from("V128") }
    String_new()
}

test mod "removed_names" {
    test "to_string family" {
        assert(len(removed_name_hint("i32_to_string")) > 0)
        assert(len(removed_name_hint("bool_to_string")) > 0)
    }
    test "vec ctor" { assert(len(removed_name_hint("Vec_new_i32")) > 0) }
    test "hashmap builtins" {
        assert(len(removed_name_hint("HashMap_i32_i32_new")) > 0)
        assert(len(removed_name_hint("HashMap_new_String_i32")) > 0)
        assert(len(removed_name_hint("HashMap_String_fn_get")) > 0)
    }
    test "io env fs" {
        assert(len(removed_name_hint("read_to_string")) > 0)
        assert(len(removed_name_hint("exists")) > 0)
        assert(len(removed_name_hint("get_var")) > 0)
    }
    test "result option helpers" {
        assert(len(removed_name_hint("ok")) > 0)
        assert(len(removed_name_hint("err")) > 0)
        assert(len(removed_name_hint("expect")) > 0)
        assert(len(removed_name_hint("unwrap_or_else")) > 0)
        assert(len(removed_name_hint("ok_or")) > 0)
    }
    test "io shims" { assert(len(removed_name_hint("eprintln")) > 0) }
    test "deprecated prelude hints" {
        assert(len(removed_name_hint("concat")) > 0)
        assert(len(removed_name_hint("char_at")) > 0)
        assert(len(removed_name_hint("println")) > 0)
    }
    test "gated prelude hints" {
        assert(len(removed_name_hint("eq")) > 0)
        assert(len(removed_name_hint("clone")) > 0)
        assert(len(removed_name_hint("substring")) > 0)
    }
    test "removed seq frees have E0100 hints" {
        assert(len(removed_name_hint("sort_i32")) > 0)
        assert(len(removed_name_hint("sort_String")) > 0)
        assert(len(removed_name_hint("map_i64_i64")) > 0)
        assert(len(removed_name_hint("filter_String")) > 0)
        assert(len(removed_name_hint("fold_f64_f64")) > 0)
        assert(len(removed_name_hint("any_i32")) > 0)
        assert(len(removed_name_hint("find_String")) > 0)
        assert(len(removed_name_hint("contains_i32")) > 0)
        assert(len(removed_name_hint("reverse_String")) > 0)
        assert(len(removed_name_hint("remove_i32")) > 0)
        assert(len(removed_name_hint("sum_i32")) > 0)
        assert(len(removed_name_hint("product_i32")) > 0)
        assert(len(removed_name_hint("map_option_i32_i32")) > 0)
        assert(len(removed_name_hint("contains_string")) > 0)
    }
    test "gated provisional filter_i32 has an import hint" {
        assert(len(removed_name_hint("filter_i32")) > 0)
    }
    test "live names have no hint" {
        assert(len(removed_name_hint("len")) == 0)
        assert(len(removed_name_hint("panic")) == 0)
    }
    test "removed io module members have hints" {
        assert(len(removed_module_member_hint(String_from("io"), String_from("reader_read"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("copy"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("seek_to"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("fill_buffer"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("file_read"))) > 0)
    }
    test "retired io compat wrappers have removal hints" {
        // ADR-085 Phase F retired the Vec-layout reader / buffered adapters and
        // the memory-writer wrappers; the tagged output pair stays callable.
        assert(len(removed_module_member_hint(String_from("io"), String_from("reader_from_bytes"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_reader_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_reader_read_line"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_writer_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_writer_write_str"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_writer_flush"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buffered_reader"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buffered_writer"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("write_all"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("write_string"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_flush"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_to_bytes"))) > 0)
    }
    test "live io tagged writers have no removal hint" {
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_write"))) == 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_write_str"))) == 0)
    }
    test "other modules do not get io hints" {
        assert(len(removed_module_member_hint(String_from("fs"), String_from("reader_read"))) == 0)
    }
    test "removed wit module members have hints" {
        assert(len(removed_module_member_hint(String_from("wit"), String_from("wit_type_u32"))) > 0)
        assert(len(removed_module_member_hint(String_from("types"), String_from("wit_type_from_ast"))) > 0)
        assert(len(removed_module_member_hint(String_from("types"), String_from("wit_type_name_from_ark"))) > 0)
        assert(len(removed_module_member_hint(String_from("scan"), String_from("wit_trim"))) > 0)
        assert(len(removed_module_member_hint(String_from("names"), String_from("kebab_name"))) > 0)
        assert(len(removed_module_member_hint(String_from("printer"), String_from("print_wit"))) > 0)
    }
    test "removed hash adapters have method hints" {
        assert(len(removed_name_hint("hashmap_str_i32_new")) > 0)
        assert(len(removed_name_hint("hashmap_i32_str_get")) > 0)
        assert(len(removed_module_member_hint(String_from("hash_map"), String_from("hashmap_str_i32_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("hash_string"), String_from("hashmap_str_get"))) > 0)
        assert(len(removed_module_member_hint(String_from("hash_fn"), String_from("hashmap_i32_fn_get"))) > 0)
        assert(len(removed_module_member_hint(String_from("hash_str_fn"), String_from("hashmap_str_fn_get"))) > 0)
    }
    test "removed iter module members have hints" {
        assert(len(removed_module_member_hint(String_from("iter"), String_from("vec_iter"))) > 0)
        assert(len(removed_module_member_hint(String_from("iter"), String_from("collect_map_i32"))) > 0)
        assert(len(removed_module_member_hint(String_from("iter"), String_from("iter_fold_i32"))) > 0)
    }
    test "live iter members keep no removal hint" {
        assert(len(removed_module_member_hint(String_from("iter"), String_from("Iterator"))) == 0)
        assert(len(removed_module_member_hint(String_from("iter"), String_from("VecIter"))) == 0)
    }
    test "unknown wit members keep no removal hint" {
        assert(len(removed_module_member_hint(String_from("parser"), String_from("WitNode"))) == 0)
        assert(len(removed_module_member_hint(String_from("types"), String_from("WitParam"))) == 0)
    }
    test "removed wit parser frees have replacement hints" {
        assert(len(removed_module_member_hint(String_from("parser"), String_from("parse_full"))) > 0)
        assert(len(removed_module_member_hint(String_from("parser"), String_from("parse_full_import_text"))) > 0)
        assert(len(removed_module_member_hint(String_from("parser"), String_from("parse_wit"))) > 0)
    }
    test "removed component frees have associated-function hints" {
        assert(len(removed_module_member_hint(String_from("component"), String_from("canonical_abi_version"))) > 0)
        assert(len(removed_module_member_hint(String_from("component"), String_from("component_model_version"))) > 0)
    }
    test "removed component handle frees have method hints" {
        assert(len(removed_module_member_hint(String_from("handle"), String_from("handle_table_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("handle"), String_from("handle_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("handle"), String_from("handle_get"))) > 0)
        assert(len(removed_module_member_hint(String_from("handle"), String_from("handle_drop"))) > 0)
        assert(len(removed_module_member_hint(String_from("handle"), String_from("handle_len"))) > 0)
        assert(len(removed_module_member_hint(String_from("handle"), String_from("handle_table_i32_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("handle"), String_from("handle_table_i32_get"))) > 0)
    }
    test "removed wit ast frees have method hints" {
        assert(len(removed_module_member_hint(String_from("ast"), String_from("ast_kind"))) > 0)
        assert(len(removed_module_member_hint(String_from("ast"), String_from("ast_child_at"))) > 0)
        assert(len(removed_module_member_hint(String_from("ast"), String_from("ast_field_name_at"))) > 0)
        assert(len(removed_module_member_hint(String_from("ast"), String_from("parse_import_text"))) > 0)
        assert(len(removed_module_member_hint(String_from("ast"), String_from("ast_import_serialized"))) > 0)
        assert(len(removed_module_member_hint(String_from("ast"), String_from("parse"))) > 0)
    }
    test "live wit ast members keep no removal hint" {
        assert(len(removed_module_member_hint(String_from("ast"), String_from("WitNode"))) == 0)
    }
    test "removed hashmap adapters have method hints" {
        assert(len(removed_module_member_hint(String_from("hash_map"), String_from("hashmap_str_i32_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("hash_fn"), String_from("hashmap_i32_i32_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("hash_string"), String_from("hashmap_String_i32_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("hash_str_fn"), String_from("hashmap_str_fn_get"))) > 0)
    }
    test "removed simd lane frees have associated-function hints" {
        assert(len(removed_module_member_hint(String_from("f32x4"), String_from("splat"))) > 0)
        assert(len(removed_module_member_hint(String_from("i32x4"), String_from("add"))) > 0)
        assert(len(removed_module_member_hint(String_from("i8x16"), String_from("extract_lane"))) > 0)
        assert(len(removed_module_member_hint(String_from("f64x2"), String_from("sqrt"))) > 0)
        assert(len(removed_module_member_hint(String_from("u64x2"), String_from("zero"))) > 0)
        assert(len(removed_module_member_hint(String_from("v128"), String_from("any_true"))) > 0)
    }
    test "non-simd modules keep no simd hint" {
        assert(len(removed_module_member_hint(String_from("f32x4x"), String_from("splat"))) == 0)
        assert(len(removed_module_member_hint(String_from("text"), String_from("splat"))) == 0)
    }
    test "removed json/toml value frees have method hints" {
        assert(len(removed_module_member_hint(String_from("json"), String_from("json_get"))) > 0)
        assert(len(removed_module_member_hint(String_from("json"), String_from("json_as_i32"))) > 0)
        assert(len(removed_module_member_hint(String_from("json"), String_from("stringify"))) > 0)
        assert(len(removed_module_member_hint(String_from("json"), String_from("parse_error_message"))) > 0)
        assert(len(removed_module_member_hint(String_from("toml"), String_from("toml_get"))) > 0)
        assert(len(removed_module_member_hint(String_from("toml"), String_from("toml_as_string"))) > 0)
    }

}
