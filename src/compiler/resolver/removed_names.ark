    if eq(clone(name), "values") {
        return true
    }
    false
}
// Shared replacement text for the retired typed hash adapters; the four
// module aliases all pointed at the old `hash_map::hashmap_*` family.
fn hashmap_method_replacement_hint() -> String {
    text::concat(
        String_from("removed HashMap helper; use `HashMap::new<K, V>()` plus receiver methods "),
        text::concat(
            String_from("(`m.insert(k, v)`, `m.get(k)`, `m.contains_key(k)`, `m.remove(k)`, `m.len()`, "),
            String_from("`m.is_empty()`, `m.keys()`, `m.values()`, `m.entries()`)")
        )
    )
}

// The std::simd lane modules became namespace types in #917. Map the module
// alias used at the call site to the namespace type so the E0100 hint names
// the associated-function spelling.
fn removed_simd_lane_type(module: String) -> String {
    if eq(clone(module), "f32x4") { return String_from("F32x4") }
    if eq(clone(module), "f64x2") { return String_from("F64x2") }
    if eq(clone(module), "i8x16") { return String_from("I8x16") }
    if eq(clone(module), "i16x8") { return String_from("I16x8") }
    if eq(clone(module), "i32x4") { return String_from("I32x4") }
    if eq(clone(module), "i64x2") { return String_from("I64x2") }
    if eq(clone(module), "u8x16") { return String_from("U8x16") }
    if eq(clone(module), "u16x8") { return String_from("U16x8") }
    if eq(clone(module), "u32x4") { return String_from("U32x4") }
    if eq(clone(module), "u64x2") { return String_from("U64x2") }
    if eq(clone(module), "v128") { return String_from("V128") }
    String_new()
}

fn removed_path_member_hint(name: String) -> String {
    if eq(clone(name), "join") { return String_from("use `Path::new(base).join(child)` from `use std::path::Path` instead") }
    if eq(clone(name), "parent") { return String_from("use `Path::new(path).parent()` from `use std::path::Path` instead") }
    if eq(clone(name), "file_name") { return String_from("use `Path::new(path).file_name()` from `use std::path::Path` instead") }
    if eq(clone(name), "extension") { return String_from("use `Path::new(path).extension()` from `use std::path::Path` instead") }
    if eq(clone(name), "with_extension") { return String_from("use `Path::new(path).with_extension(ext)` from `use std::path::Path` instead") }
    if eq(clone(name), "is_absolute") { return String_from("use `Path::new(path).is_absolute()` from `use std::path::Path` instead") }
    if eq(clone(name), "stem") { return String_from("use `Path::new(path).stem()` from `use std::path::Path` instead") }
    if eq(clone(name), "normalize") { return String_from("use `Path::new(path).normalize()` from `use std::path::Path` instead") }
    if eq(clone(name), "components") { return String_from("use `Path::new(path).components()` from `use std::path::Path` instead") }
    if eq(clone(name), "last_index_of") {
        return text::concat(
            String_from("removed helper; use the `Path` methods (`file_name`, `extension`, "),
            String_from("`parent`, `stem`, `normalize`) or `String::index_of` for forward searches")
        )
    }
    String_new()
}

fn removed_time_member_hint(name: String) -> String {
    if eq(clone(name), "duration_ms") { return String_from("use `Duration::between(start, end).as_ms()` from `use std::time::Duration` instead") }
    if eq(clone(name), "duration_us") { return String_from("use `Duration::between(start, end).as_us()` from `use std::time::Duration` instead") }
    if eq(clone(name), "duration_ns") { return String_from("use `Duration::between(start, end).as_ns()` from `use std::time::Duration` instead") }
    String_new()
}

fn removed_raw_member_hint(name: String) -> String {
    if eq(clone(name), "raw_array_new") {
        return "the sealed raw bridge was retired; use `Vec::new<T>()` or `Vec::with_capacity<T>(cap)`"
    }
    if eq(clone(name), "raw_array_len") {
        return "the sealed raw bridge was retired; use `v.len()`"
    }
    if eq(clone(name), "raw_array_get_unchecked") {
        return "the sealed raw bridge was retired; use `v.get_unchecked(i)` via `use std::collections::vec`"
    }
    if eq(clone(name), "raw_array_set_unchecked") {
        return "the sealed raw bridge was retired; use `v.set(i, value)` via `use std::collections::vec`"
    }
    if eq(clone(name), "raw_array_grow") {
        return "the sealed raw bridge was retired; stdlib uses `RawArray::grow(values, new_len)` and has no public replacement"
    }
    if eq(clone(name), "raw_array_set_len") {
        return "the sealed raw bridge was retired; stdlib uses `RawArray::set_len(values, new_len)` and has no public replacement"
    }
    if eq(clone(name), "raw_string_new") {
        return "the sealed raw bridge was retired; use `String_new()` or `String::new()`"
    }
    if eq(clone(name), "raw_string_from_bytes") {
        return "the sealed raw bridge was retired; use `String::from_utf8_lossy(bytes)` for validated UTF-8 input"
    }
    if eq(clone(name), "raw_string_len_bytes") {
        return "the sealed raw bridge was retired; use `s.len_bytes()` via `use std::collections::string`"
    }
    if eq(clone(name), "raw_string_byte_at_unchecked") {
        return "the sealed raw bridge was retired; use `s.byte_at(i)` via `use std::collections::string`"
    }
    if eq(clone(name), "raw_string_clone") {
        return "the sealed raw bridge was retired; use `s.clone()`"
    }
    if eq(clone(name), "raw_string_push_char") {
        return "the sealed raw bridge was retired; use `push_char(s, c)` via `use std::prelude::push_char`"
    }
    if eq(clone(name), "raw_parse_i32") {
        return "the sealed raw bridge was retired; use `i32::try_from(s)` instead"
    }
    if eq(clone(name), "raw_parse_i64") {
        return "the sealed raw bridge was retired; use `i64::try_from(s)` instead"
    }
    if eq(clone(name), "raw_parse_f64") {
        return "the sealed raw bridge was retired; use `f64::try_from(s)` instead"
    }
    if eq(clone(name), "raw_f64_sqrt") {
        return "the sealed raw bridge was retired; use `x.sqrt()` via `use std::core::convert`"
    }
    if eq(clone(name), "raw_f64_bits_lo") {
        return "the sealed raw bridge was retired; use `x.to_bits_lo()` via `use std::core::convert`"
    }
    if eq(clone(name), "raw_f64_bits_hi") {
        return "the sealed raw bridge was retired; use `x.to_bits_hi()` via `use std::core::convert`"
    }
    if eq(clone(name), "raw_f64_to_string") {
        return "the sealed raw bridge was retired; use `x.to_string()` instead"
    }
    if eq(clone(name), "raw_f32_promote_f64") {
        return "the sealed raw bridge was retired; use `f32_to_f64(x)` or `x.to_f64()` instead"
    }
    String_new()
}

fn removed_core_free_hint(name: String) -> String {
    if eq(clone(name), "range_new") { return String_from("use `Range::new(start, end)` from `use std::core::{Range}` instead") }
    if eq(clone(name), "range_contains") { return String_from("use `r.contains(value)` on the `Range` value instead") }
    if eq(clone(name), "range_len") { return String_from("use `r.len()` on the `Range` value instead") }
    if eq(clone(name), "range_inclusive_new") { return String_from("use `RangeInclusive::new(start, end)` from `use std::core::{RangeInclusive}` instead") }
    if eq(clone(name), "range_inclusive_contains") { return String_from("use `r.contains(value)` on the `RangeInclusive` value instead") }
    if eq(clone(name), "cmp_i32") { return String_from("use `a.cmp(b)` via `use std::core::cmp` instead") }
    if eq(clone(name), "error_message") { return String_from("use `e.message()` on the `Error` value instead") }
    if eq(clone(name), "combine") { return String_from("use `h1.combine_hash(h2)` on the first hash value instead") }
    if eq(clone(name), "identity") { return String_from("removed identity helper; delete the call (no replacement)") }
    String_new()
}

fn removed_error_member_hint(name: String) -> String {
    if eq(clone(name), "error_message") { return String_from("use `e.message()` on the `Error` value instead") }
    String_new()
}

fn removed_hash_member_hint(name: String) -> String {
    if eq(clone(name), "combine") { return String_from("use `h1.combine_hash(h2)` on the first hash value instead") }
    String_new()
}

fn removed_random_member_hint(name: String) -> String {
    if eq(clone(name), "seeded_random") { return String_from("use `Rng::new(seed).next()` from `use std::random::Rng` instead") }
    if eq(clone(name), "seeded_range") { return String_from("use `Rng::new(seed).range(lo, hi)` from `use std::random::Rng` instead") }
    if eq(clone(name), "shuffle_i32") { return String_from("use `Rng::new(seed).shuffle(v)` from `use std::random::Rng` instead") }
    String_new()
}

test mod "removed_names" {
    test "to_string family" {
        assert(len(removed_name_hint("i32_to_string")) > 0)
        assert(len(removed_name_hint("bool_to_string")) > 0)
    }
    test "vec ctor" { assert(len(removed_name_hint("Vec_new_i32")) > 0) }
    test "hashmap builtins" {
        assert(len(removed_name_hint("HashMap_i32_i32_new")) > 0)
        assert(len(removed_name_hint("HashMap_new_String_i32")) > 0)
        assert(len(removed_name_hint("HashMap_String_fn_get")) > 0)
    }
    test "io env fs" {
        assert(len(removed_name_hint("read_to_string")) > 0)
        assert(len(removed_name_hint("exists")) > 0)
        assert(len(removed_name_hint("get_var")) > 0)
    }
    test "removed env module member" {
        assert(len(removed_module_member_hint("std::env", "get_var")) > 0)
        assert(len(removed_module_member_hint("std::host::env", "get_var")) > 0)
    }
    test "removed compiler collections frees" {
        assert(len(removed_module_member_hint("compiler", "arena_new")) > 0)
        assert(len(removed_module_member_hint("collections::compiler", "slotmap_get")) > 0)
        assert(len(removed_module_member_hint("std::collections::compiler", "interner_lookup")) > 0)
        assert(len(removed_name_hint("arena_alloc")) > 0)
        assert(len(removed_name_hint("slotmap_contains")) > 0)
        assert(len(removed_name_hint("interner_intern")) > 0)
        assert(len(removed_module_member_hint("compiler", "unrelated")) == 0)
    }
    test "result option helpers" {
        assert(len(removed_name_hint("ok")) > 0)
        assert(len(removed_name_hint("err")) > 0)
        assert(len(removed_name_hint("expect")) > 0)
        assert(len(removed_name_hint("unwrap_or_else")) > 0)
        assert(len(removed_name_hint("ok_or")) > 0)
