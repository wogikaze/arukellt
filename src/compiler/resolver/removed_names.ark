    if name.clone().eq("collect_vec_iter") { return String_from("use `it.collect()` instead") }
    if name.clone().eq("collect_map_iter") { return String_from("use `it.collect()` instead") }
    if name.clone().eq("collect_filter_iter") { return String_from("use `it.collect()` instead") }
