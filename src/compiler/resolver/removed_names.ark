// Names removed from the auto-imported prelude / compat surface, or
// gated behind explicit 'use std::prelude::{name}' imports by the v2
// prelude policy (ADR-072). resolve_unknown_name consults this table
// so pre-v2 sources get a migration hint instead of a bare
// undefined-name error. Keep aligned with std/manifest.toml
// deprecations and docs/stdlib/migration-guidance.md;
// scripts/check/check-compat-orphans.py verifies both directions.
use std::prelude::{clone, eq, starts_with, substring}
use std::text

fn removed_name_hint(name: String) -> String {
    let specific = removed_name_specific_hint(clone(name))
    if len(clone(specific)) > 0 {
        return specific
    }
    let json_hint = removed_json_member_hint(clone(name))
    if len(clone(json_hint)) > 0 {
        return json_hint
    }
    let toml_hint = removed_toml_member_hint(clone(name))
    if len(clone(toml_hint)) > 0 {
        return toml_hint
    }
    let csv_hint = removed_csv_member_hint(clone(name))
    if len(clone(csv_hint)) > 0 {
        return csv_hint
    }
    return removed_gated_prelude_hint(name)
}

fn hashmap_method_replacement_hint() -> String {
    String_from("removed HashMap helper; use `HashMap::new<K, V>()` plus receiver methods ").concat(
        String_from("(`m.insert(k, v)`, `m.get(k)`, `m.contains_key(k)`, `m.remove(k)`, `m.len()`, ")
    ).concat(String_from("`m.is_empty()`, `m.keys()`, `m.values()`, `m.entries()`)"))
}

fn is_retired_hashmap_adapter_name(name: String) -> bool {
    if clone(name).starts_with(String_from("hashmap_str_")) {
        return true
    }
    if clone(name).starts_with(String_from("hashmap_i32_str_")) {
        return true
    }
    if clone(name).starts_with(String_from("hashmap_i32_fn_")) {
        return true
    }
    clone(name).starts_with(String_from("hashmap_str_fn_"))
}

fn is_retired_hashmap_module(module: String) -> bool {
    if eq(clone(module), "hash_map") || eq(clone(module), "hash_string") {
        return true
    }
    eq(clone(module), "hash_fn") || eq(clone(module), "hash_str_fn")
}

fn hashset_method_replacement_hint() -> String {
    String_from("removed HashSet adapter; use `HashSet::new<i32>()` / `HashSet::new<String>()` plus receiver methods ").concat(
        String_from("(`s.insert(v)`, `s.contains(v)`, `s.remove(v)`, `s.len()`, `s.is_empty()`, `s.to_vec()`, ")
    ).concat(String_from("`s.union(t)`, `s.intersection(t)`, `s.difference(t)`, `s.capacity()`, `s.reserve(n)`, ")
        .concat(String_from("`s.shrink_to_fit()`, `s.clear()`, `s.extend(t)`)")))
}

fn is_retired_hashset_adapter_name(name: String) -> bool {
    if starts_with(clone(name), "hashset_i32_") {
        return true
    }
    starts_with(clone(name), "hashset_str_")
}

fn removed_name_specific_hint(name: String) -> String {
    let raw_hint = removed_raw_member_hint(clone(name))
    if len(clone(raw_hint)) > 0 {
        return raw_hint
    }
    let core_hint = removed_core_free_hint(clone(name))
    if len(clone(core_hint)) > 0 {
        return core_hint
    }
    let compiler_hint = removed_compiler_member_hint(clone(name))
    if len(clone(compiler_hint)) > 0 {
        return compiler_hint
    }
    if clone(name).starts_with(String_from("HashMap_")) {
        return hashmap_method_replacement_hint()
    }
    if is_retired_hashmap_adapter_name(clone(name)) {
        return hashmap_method_replacement_hint()
    }
    if is_retired_hashset_adapter_name(clone(name)) {
        return hashset_method_replacement_hint()
    }
    if eq(clone(name), "concat") { return "removed prelude wrapper; call `text::concat(a, b)` via `use std::text`, or `a.text::concat(b)`" }
    if eq(clone(name), "clear") { return "removed free function; use the Vec method `v.clear()`" }
    if eq(clone(name), "map_option_String_String") { return "removed free function; use `o.map(f)` via `use std::core::container`" }
    if eq(clone(name), "map_result_i32_i32") { return "removed free function; use `r.map(f)` via `use std::core::container`" }
    if eq(clone(name), "char_at") { return "removed prelude wrapper; use `byte_at(s, i)` via `use std::prelude::{byte_at}`" }
    if eq(clone(name), "println") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::println(...)`" }
    if eq(clone(name), "print") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::print(...)`" }
    if eq(clone(name), "eprintln") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::eprintln(...)`" }
    if eq(clone(name), "read_to_string") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::read_stdin()`" }
    if eq(clone(name), "exists") { return "removed prelude binding; import `use std::host::fs::Fs` and call `Fs::is_readable_file(...)`" }
    if eq(clone(name), "get_var") { return "removed module function; import `use std::host::env::Env` and call `Env::var(name)`" }
    if eq(clone(name), "var_or_default") { return "removed module function; import `use std::host::env::Env` and call `Env::var_or_default(name, default)`" }
    if eq(clone(name), "arg_at") { return "removed module function; import `use std::host::env::Env` and call `Env::arg_at(index)`" }
    if eq(clone(name), "arg_count") { return "removed module function; import `use std::host::env::Env` and call `Env::arg_count()`" }
    if eq(clone(name), "has_flag") { return "removed module function; import `use std::host::env::Env` and call `Env::has_flag(flag)`" }
    if eq(clone(name), "sort_i32") || eq(clone(name), "sort_i64") || eq(clone(name), "sort_f64") || eq(clone(name), "sort_String") {
        return "removed free function; use `v.sort_by(cmp)` via `use std::collections::vec`"
    }
    if eq(clone(name), "map_i32_i32") || eq(clone(name), "map_i64_i64") || eq(clone(name), "map_f64_f64") || eq(clone(name), "map_String_String") {
        return "removed free function; use `v.iter().map(f).collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "filter_i64") || eq(clone(name), "filter_f64") || eq(clone(name), "filter_String") {
        return "removed free function; use `v.iter().filter(f).collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "filter_i32") {
        return "provisional prelude helper; import `use std::prelude::{filter_i32}` or use `v.iter().filter(f).collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "fold_i32_i32") || eq(clone(name), "fold_i64_i64") || eq(clone(name), "fold_f64_f64") {
        return "removed free function; use `v.iter().fold(init, f)` via `use std::core::iter`"
    }
    if eq(clone(name), "any_i32") || eq(clone(name), "any_i64") || eq(clone(name), "any_f64") || eq(clone(name), "any_String") {
        return "removed free function; use `v.iter().any(f)` via `use std::core::iter`"
    }
    if eq(clone(name), "find_i32") || eq(clone(name), "find_i64") || eq(clone(name), "find_f64") || eq(clone(name), "find_String") {
        return "removed free function; use `v.iter().find(f)` via `use std::core::iter`"
    }
    if eq(clone(name), "contains_i32") || eq(clone(name), "contains_String") {
        return "removed free function; use `v.iter().contains(x)` via `use std::core::iter`"
    }
    if eq(clone(name), "reverse_i32") || eq(clone(name), "reverse_String") {
        return "removed free function; use `v.iter().rev().collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "remove_i32") {
        return "removed free function; use `v.drain(i, i + 1)` via `use std::collections::vec`"
    }
    if eq(clone(name), "sum_i32") {
        return "removed free function; use `v.iter().sum()` via `use std::core::iter`"
    }
    if eq(clone(name), "product_i32") {
        return "removed free function; use `v.iter().fold(1, mul)` via `use std::core::iter`"
    }
    if eq(clone(name), "map_option_i32_i32") {
        return "removed free function; use `o.map(f)` via `use std::core::container`"
    }
    if eq(clone(name), "contains_string") {
        return "removed free function; use the String method `s.contains(sub)`"
    }
    if eq(clone(name), "take_i32") { return "removed free function; use `v.iter().take(n).collect()` via `use std::core::iter`" }
    if eq(clone(name), "skip_i32") { return "removed free function; use `v.iter().skip(n).collect()` via `use std::core::iter`" }
    if eq(clone(name), "seq_reverse") { return "removed free function; use `v.iter().rev().collect()` via `use std::core::iter`" }
    if eq(clone(name), "seq_contains") { return "removed free function; use `v.iter().contains(x)` via `use std::core::iter`" }
    if eq(clone(name), "unique") { return "removed free function; use `v.iter().unique().collect()` via `use std::core::iter`" }
    if eq(clone(name), "count_eq") { return "removed free function; use `v.iter().count_eq(x)` via `use std::core::iter`" }
    if eq(clone(name), "binary_search") { return "removed free function; import `use std::seq::{binary_search_by}`" }
    if eq(clone(name), "min_i32") { return "removed free function; import `use std::seq::{min_by}`" }
    if eq(clone(name), "max_i32") { return "removed free function; import `use std::seq::{max_by}`" }
    if eq(clone(name), "i32_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "i64_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "f64_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "bool_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "Vec_new") { return "removed Vec constructor; use `Vec::new<T>()`" }
    if eq(clone(name), "Vec_new_i32") { return "removed Vec constructor; use `Vec::new<i32>()`" }
    if eq(clone(name), "Vec_new_String") { return "removed Vec constructor; use `Vec::new<String>()`" }
    if eq(clone(name), "Vec_with_capacity") { return "removed Vec constructor; use `Vec::new<T>()`" }
    if eq(clone(name), "Vec_with_capacity_i32") { return "removed Vec constructor; use `Vec::new<i32>()`" }
    if eq(clone(name), "Vec_with_capacity_String") { return "removed Vec constructor; use `Vec::new<String>()`" }
    if eq(clone(name), "ok") { return "removed free function; construct the variant directly with `Ok(...)`" }
    if eq(clone(name), "err") { return "removed free function; construct the variant directly with `Err(...)`" }
    if eq(clone(name), "expect") { return "removed free function; use `unwrap_or(value, fallback)` or match on the variant" }
    if eq(clone(name), "unwrap_or_else") { return "removed free function; use `unwrap_or(value, fallback)`" }
    if eq(clone(name), "ok_or") { return "removed free function; convert Option to Result explicitly with `Ok`/`Err` or `match`" }
    String_new()
}

// Module-qualified calls cannot use the bare-name table above: the resolver
// only knows the removed member name after the module head resolved. Keep the
// per-module entries here so ADR-085 Phase F removals still produce an E0100
// migration hint instead of a bare "undefined module member".
fn removed_wasm_member_hint(name: String) -> String {
    if eq(clone(name), "module_new") { return String_from("removed free function; use the `WasmModuleBuilder` associated function from `use std::wasm` instead") }
    if eq(clone(name), "wasm_magic") { return String_from("removed free function; use the `WasmModuleBuilder` associated function from `use std::wasm` instead") }
    if eq(clone(name), "wasm_version") { return String_from("removed free function; use the `WasmModuleBuilder` associated function from `use std::wasm` instead") }
    if eq(clone(name), "v128_load") { return String_from("removed free function; use `V128Memory::load(address, offset)` from `use std::wasm` instead") }
    if eq(clone(name), "v128_store") { return String_from("removed free function; use `V128Memory::store(address, offset, value)` from `use std::wasm` instead") }
    if eq(clone(name), "v128_load_splat") { return String_from("removed free function; use `V128Memory::load_splat(address, offset)` from `use std::wasm` instead") }
    if eq(clone(name), "v128_load_lane") { return String_from("removed free function; use `V128Memory::load_lane(address, offset, value, lane)` from `use std::wasm` instead") }
    if eq(clone(name), "v128_store_lane") { return String_from("removed free function; use `V128Memory::store_lane(address, offset, value, lane)` from `use std::wasm` instead") }
    String_from("removed free function; use the owning type from `use std::wasm` instead")
}

// The whole-path std::host::fs helpers and the legacy std::fs frees moved to
// the `Fs` namespace (ADR-046, #917). `read_dir` / `metadata` have no host
// intrinsic yet, so their hint states the unsupported capability instead of
// promising a replacement.
fn removed_host_fs_member_hint(name: String) -> String {
    if eq(clone(name), "read_to_string") || eq(clone(name), "read_string") {
        return String_from("use `Fs::read_to_string(path)` from `use std::host::fs::Fs` instead")
    }
    if eq(clone(name), "read_bytes") {
        return String_from("use `Fs::read_bytes(path)` from `use std::host::fs::Fs` instead")
    }
    if eq(clone(name), "write_string") {
        return String_from("use `Fs::write_string(path, contents)` from `use std::host::fs::Fs` instead")
    }
    if eq(clone(name), "write_bytes") {
        return String_from("use `Fs::write_bytes(path, bytes)` from `use std::host::fs::Fs` instead")
    }
    if eq(clone(name), "is_readable_file") || eq(clone(name), "exists") {
        return String_from("use `Fs::is_readable_file(path)` from `use std::host::fs::Fs` instead")
    }
    if eq(clone(name), "is_file") {
        return String_from("use `Fs::is_file(path)` from `use std::host::fs::Fs` instead")
    }
    if eq(clone(name), "is_dir") {
        return String_from("use `Fs::is_dir(path)` from `use std::host::fs::Fs` instead")
    }
    if eq(clone(name), "read_dir") {
        return String_from("directory listing is not supported by the current host intrinsic layer; no replacement")
    }
    if eq(clone(name), "metadata") {
        return String_from("path metadata is not supported by the current host intrinsic layer; no replacement")
    }
    String_new()
}

// The stable host clock free reads moved to the `Clock` namespace (ADR-046,
// #917). Both names were deleted in the ADR-087 Wave 2 change, so a qualified
// old call states the replacement instead of a bare undefined-member error.
fn removed_host_clock_member_hint(name: String) -> String {
    if eq(clone(name), "monotonic_now") {
        return String_from("use `Clock::monotonic_now()` from `use std::host::clock::Clock` instead")
    }
    if eq(clone(name), "now_ms") {
        return String_from("use `Clock::now_ms()` from `use std::host::clock::Clock` instead")
    }
    String_new()
}

// The `std::env` module path and the `std::host::env` free functions were
// deleted in the ADR-087 Wave 2 env wave (2026-10-28). `Env` is the only env
// surface; each retired member names its method replacement (#917).
fn removed_host_env_member_hint(name: String) -> String {
    if eq(clone(name), "get_var") || eq(clone(name), "var") {
        return String_from("use `Env::var(name)` from `use std::host::env::Env` instead")
    }
    if eq(clone(name), "args") {
        return String_from("use `Env::args()` from `use std::host::env::Env` instead")
    }
    if eq(clone(name), "arg_count") {
        return String_from("use `Env::arg_count()` from `use std::host::env::Env` instead")
    }
    if eq(clone(name), "arg_at") {
        return String_from("use `Env::arg_at(index)` from `use std::host::env::Env` instead")
    }
    if eq(clone(name), "var_or_default") {
        return String_from("use `Env::var_or_default(name, default)` from `use std::host::env::Env` instead")
    }
    if eq(clone(name), "has_flag") {
        return String_from("use `Env::has_flag(flag)` from `use std::host::env::Env` instead")
    }
    String_new()
}

/// Replacement hints for the `std::collections::compiler` free functions
/// retired by #917 (Arena / SlotMap / Interner type surface).
fn removed_compiler_member_hint(name: String) -> String {
    if eq(clone(name), "arena_new") {
        return "use `Arena::new()` from `use std::collections::compiler::Arena` instead"
    }
    if eq(clone(name), "arena_alloc") {
        return "use `a.alloc(value)` on `Arena` instead"
    }
    if eq(clone(name), "arena_get") {
        return "use `a.get(idx)` on `Arena` instead"
    }
    if eq(clone(name), "arena_len") {
        return "use `a.len()` on `Arena` instead"
    }
    if eq(clone(name), "slotmap_new") {
        return "use `SlotMap::new()` from `use std::collections::compiler::SlotMap` instead"
    }
    if eq(clone(name), "slotmap_insert") {
        return "use `m.insert(value)` on `SlotMap` instead"
    }
    if eq(clone(name), "slotmap_get") {
        return "use `m.get(key)` on `SlotMap` instead"
    }
    if eq(clone(name), "slotmap_remove") {
        return "use `m.remove(key)` on `SlotMap` instead"
    }
    if eq(clone(name), "slotmap_contains") {
        return "use `m.contains(key)` on `SlotMap` instead"
    }
    if eq(clone(name), "slotmap_len") {
        return "use `m.len()` on `SlotMap` instead"
    }
    if eq(clone(name), "interner_new") {
        return "use `Interner::new()` from `use std::collections::compiler::Interner` instead"
    }
    if eq(clone(name), "interner_intern") {
        return "use `i.intern(value)` on `Interner` instead"
    }
    if eq(clone(name), "interner_lookup") {
        return "use `i.lookup(sym)` on `Interner` instead"
    }
    if eq(clone(name), "interner_len") {
        return "use `i.len()` on `Interner` instead"
    }
    String_new()
}

fn removed_module_member_hint(module: String, name: String) -> String {
    if eq(clone(module), "fs") || eq(clone(module), "host::fs") || eq(clone(module), "std::fs") || eq(clone(module), "std::host::fs") {
        return removed_host_fs_member_hint(name)
    }
    if eq(clone(module), "compiler") || eq(clone(module), "collections::compiler") || eq(clone(module), "std::collections::compiler") {
        return removed_compiler_member_hint(name)
    }
    if eq(clone(module), "clock") || eq(clone(module), "host::clock") || eq(clone(module), "std::host::clock") {
        return removed_host_clock_member_hint(name)
    }
    if eq(clone(module), "env") || eq(clone(module), "host::env") || eq(clone(module), "std::env") || eq(clone(module), "std::host::env") {
        return removed_host_env_member_hint(name)
    }
    if is_retired_hashmap_module(clone(module)) {
        return hashmap_method_replacement_hint()
    }
    if eq(clone(module), "hash_set") || eq(clone(module), "hashset") {
        return hashset_method_replacement_hint()
    }
    if eq(clone(module), "wit") || eq(clone(module), "types") {
        return removed_wit_type_member_hint(name)
    }
    if eq(clone(module), "scan") {
        return removed_wit_scan_member_hint(name)
    }
    if eq(clone(module), "names") {
        return removed_wit_name_member_hint(name)
    }
    if eq(clone(module), "ast") {
        return removed_wit_ast_member_hint(name)
    }
    if eq(clone(module), "parser") {
        let parser_json_hint = removed_json_member_hint(clone(name))
        if len(clone(parser_json_hint)) > 0 {
            return parser_json_hint
        }
        let parser_toml_hint = removed_toml_member_hint(clone(name))
        if len(clone(parser_toml_hint)) > 0 {
            return parser_toml_hint
        }
        return removed_wit_parser_member_hint(name)
    }
    if eq(clone(module), "component") {
        return removed_component_member_hint(name)
    }
    if eq(clone(module), "handle") {
        return removed_component_handle_member_hint(name)
    }
    if eq(clone(module), "printer") && eq(clone(name), "print_wit") {
        return String_from("use `w.to_wit()` on `World` instead")
    }
    if eq(clone(module), "fmt") {
        return removed_fmt_member_hint(name)
    }
    if eq(clone(module), "rope") {
        return removed_rope_member_hint(name)
    }
    if eq(clone(module), "text") {
        return removed_text_member_hint(name)
    }
    if eq(clone(module), "string") {
        return removed_string_member_hint(name)
    }
    if eq(clone(module), "iter") {
        return removed_iter_member_hint(name)
    }
    if eq(clone(module), "wasm") {
        return removed_wasm_member_hint(name)
    }
    if eq(clone(module), "bytes") {
        return removed_bytes_member_hint(name)
    }
    if eq(clone(module), "path") {
        return removed_path_member_hint(name)
    }
    if eq(clone(module), "time") {
        return removed_time_member_hint(name)
    }
    if eq(clone(module), "random") {
        return removed_random_member_hint(name)
    }
    if eq(clone(module), "raw") {
        return removed_raw_member_hint(name)
    }
    if eq(clone(module), "core") {
        return removed_core_free_hint(name)
    }
    if eq(clone(module), "error") {
        return removed_error_member_hint(name)
    }
    if eq(clone(module), "hash") {
        return removed_hash_member_hint(name)
    }
    if eq(clone(module), "canonical") {
        return removed_canonical_member_hint(name)
    }
    if eq(clone(module), "json") {
        return removed_json_member_hint(name)
    }
    if eq(clone(module), "toml") {
        return removed_toml_member_hint(name)
    }
    if eq(clone(module), "csv") {
        return removed_csv_member_hint(name)
    }
    let simd_type = removed_simd_lane_type(clone(module))
    if len(clone(simd_type)) > 0 {
        return "removed free function; call `"
        .concat(simd_type)
        .concat("::")
        .concat(clone(name))
        .concat("(...)` with the namespace type from `use std::simd::")
        .concat(clone(module))
        .concat("` instead")
    }
    if !eq(clone(module), "io") {
        return String_new()
    }
    if eq(clone(name), "reader_eof") { return "use `r.is_eof()` on `Reader` instead" }
    if eq(clone(name), "reader_read") { return "use `r.read(n)` on `Reader` instead" }
    if eq(clone(name), "reader_read_exact") { return "use `Io::read_exact(r, n)` from `use std::io::Io` instead" }
    if eq(clone(name), "reader_read_all") { return "use `Io::read_to_end(r)` from `use std::io::Io` instead" }
    if eq(clone(name), "reader_read_line") { return "use `r.read_line()` from `use std::io::BufRead` instead (`Option<String>`, `None` at EOF)" }
    if eq(clone(name), "copy_bytes") { return "use `Io::copy(from, to)` from `use std::io::Io` instead" }
