// Names removed from the auto-imported prelude / compat surface, or
// gated behind explicit 'use std::prelude::{name}' imports by the v2
// prelude policy (ADR-072). resolve_unknown_name consults this table
// so pre-v2 sources get a migration hint instead of a bare
// undefined-name error. Keep aligned with std/manifest.toml
// deprecations and docs/stdlib/migration-guidance.md;
// scripts/check/check-compat-orphans.py verifies both directions.
use std::prelude::{clone, eq}
use std::text

pub fn removed_name_hint(name: String) -> String {
    let specific = removed_name_specific_hint(clone(name))
    if len(clone(specific)) > 0 {
        return specific
    }
    return removed_gated_prelude_hint(name)
}

fn hashmap_method_replacement_hint() -> String {
    String_from("removed HashMap helper; use `HashMap::new<K, V>()` plus receiver methods ").concat(
        String_from("(`m.insert(k, v)`, `m.get(k)`, `m.contains_key(k)`, `m.remove(k)`, `m.len()`, ")
    ).concat(String_from("`m.is_empty()`, `m.keys()`, `m.values()`, `m.entries()`)"))
}

fn is_retired_hashmap_adapter_name(name: String) -> bool {
    if clone(name).starts_with(String_from("hashmap_str_")) {
        return true
    }
    if clone(name).starts_with(String_from("hashmap_i32_str_")) {
        return true
    }
    if clone(name).starts_with(String_from("hashmap_i32_fn_")) {
        return true
    }
    clone(name).starts_with(String_from("hashmap_str_fn_"))
}

fn is_retired_hashmap_module(module: String) -> bool {
    if eq(clone(module), "hash_map") || eq(clone(module), "hash_string") {
        return true
    }
    eq(clone(module), "hash_fn") || eq(clone(module), "hash_str_fn")
}

fn removed_name_specific_hint(name: String) -> String {
    if clone(name).starts_with(String_from("HashMap_")) {
        return hashmap_method_replacement_hint()
    }
    if is_retired_hashmap_adapter_name(clone(name)) {
        return hashmap_method_replacement_hint()
    }
    if eq(clone(name), "concat") { return "removed prelude wrapper; call `text::concat(a, b)` via `use std::text`, or `a.text::concat(b)`" }
    if eq(clone(name), "clear") { return "removed free function; use the Vec method `v.clear()`" }
    if eq(clone(name), "map_option_String_String") { return "removed free function; use `o.map(f)` via `use std::core::container`" }
    if eq(clone(name), "map_result_i32_i32") { return "removed free function; use `r.map(f)` via `use std::core::container`" }
    if eq(clone(name), "char_at") { return "removed prelude wrapper; use `byte_at(s, i)` via `use std::prelude::{byte_at}`" }
    if eq(clone(name), "println") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::println(...)`" }
    if eq(clone(name), "print") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::print(...)`" }
    if eq(clone(name), "eprintln") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::eprintln(...)`" }
    if eq(clone(name), "read_to_string") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::read_stdin()`" }
    if eq(clone(name), "exists") { return "removed prelude binding; import `use std::host::fs` and call `fs::is_readable_file(...)`" }
    if eq(clone(name), "get_var") { return "removed prelude binding; import `use std::host::env` and call `env::var(...)`" }
    if eq(clone(name), "sort_i32") || eq(clone(name), "sort_i64") || eq(clone(name), "sort_f64") || eq(clone(name), "sort_String") {
        return "removed free function; use `v.sort_by(cmp)` via `use std::collections::vec`"
    }
    if eq(clone(name), "map_i32_i32") || eq(clone(name), "map_i64_i64") || eq(clone(name), "map_f64_f64") || eq(clone(name), "map_String_String") {
        return "removed free function; use `v.iter().map(f).collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "filter_i64") || eq(clone(name), "filter_f64") || eq(clone(name), "filter_String") {
        return "removed free function; use `v.iter().filter(f).collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "filter_i32") {
        return "provisional prelude helper; import `use std::prelude::{filter_i32}` or use `v.iter().filter(f).collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "fold_i32_i32") || eq(clone(name), "fold_i64_i64") || eq(clone(name), "fold_f64_f64") {
        return "removed free function; use `v.iter().fold(init, f)` via `use std::core::iter`"
    }
    if eq(clone(name), "any_i32") || eq(clone(name), "any_i64") || eq(clone(name), "any_f64") || eq(clone(name), "any_String") {
        return "removed free function; use `v.iter().any(f)` via `use std::core::iter`"
    }
    if eq(clone(name), "find_i32") || eq(clone(name), "find_i64") || eq(clone(name), "find_f64") || eq(clone(name), "find_String") {
        return "removed free function; use `v.iter().find(f)` via `use std::core::iter`"
    }
    if eq(clone(name), "contains_i32") || eq(clone(name), "contains_String") {
        return "removed free function; use `v.iter().contains(x)` via `use std::core::iter`"
    }
    if eq(clone(name), "reverse_i32") || eq(clone(name), "reverse_String") {
        return "removed free function; use `v.iter().rev().collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "remove_i32") {
        return "removed free function; use `v.drain(i, i + 1)` via `use std::collections::vec`"
    }
    if eq(clone(name), "sum_i32") {
        return "removed free function; use `v.iter().sum()` via `use std::core::iter`"
    }
    if eq(clone(name), "product_i32") {
        return "removed free function; use `v.iter().fold(1, mul)` via `use std::core::iter`"
    }
    if eq(clone(name), "map_option_i32_i32") {
        return "removed free function; use `o.map(f)` via `use std::core::container`"
    }
    if eq(clone(name), "contains_string") {
        return "removed free function; use the String method `s.contains(sub)`"
    }
    if eq(clone(name), "take_i32") { return "removed free function; use `v.iter().take(n).collect()` via `use std::core::iter`" }
    if eq(clone(name), "skip_i32") { return "removed free function; use `v.iter().skip(n).collect()` via `use std::core::iter`" }
    if eq(clone(name), "seq_reverse") { return "removed free function; use `v.iter().rev().collect()` via `use std::core::iter`" }
    if eq(clone(name), "seq_contains") { return "removed free function; use `v.iter().contains(x)` via `use std::core::iter`" }
    if eq(clone(name), "unique") { return "removed free function; use `v.iter().unique().collect()` via `use std::core::iter`" }
    if eq(clone(name), "count_eq") { return "removed free function; use `v.iter().count_eq(x)` via `use std::core::iter`" }
    if eq(clone(name), "binary_search") { return "removed free function; import `use std::seq::{binary_search_by}`" }
    if eq(clone(name), "min_i32") { return "removed free function; import `use std::seq::{min_by}`" }
    if eq(clone(name), "max_i32") { return "removed free function; import `use std::seq::{max_by}`" }
    if eq(clone(name), "i32_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "i64_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "f64_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "bool_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "Vec_new") { return "removed Vec constructor; use `Vec::new<T>()`" }
    if eq(clone(name), "Vec_new_i32") { return "removed Vec constructor; use `Vec::new<i32>()`" }
    if eq(clone(name), "Vec_new_String") { return "removed Vec constructor; use `Vec::new<String>()`" }
    if eq(clone(name), "Vec_with_capacity") { return "removed Vec constructor; use `Vec::new<T>()`" }
    if eq(clone(name), "Vec_with_capacity_i32") { return "removed Vec constructor; use `Vec::new<i32>()`" }
    if eq(clone(name), "Vec_with_capacity_String") { return "removed Vec constructor; use `Vec::new<String>()`" }
    if eq(clone(name), "ok") { return "removed free function; construct the variant directly with `Ok(...)`" }
    if eq(clone(name), "err") { return "removed free function; construct the variant directly with `Err(...)`" }
    if eq(clone(name), "expect") { return "removed free function; use `unwrap_or(value, fallback)` or match on the variant" }
    if eq(clone(name), "unwrap_or_else") { return "removed free function; use `unwrap_or(value, fallback)`" }
    if eq(clone(name), "ok_or") { return "removed free function; convert Option to Result explicitly with `Ok`/`Err` or `match`" }
    String_new()
}

// Module-qualified calls cannot use the bare-name table above: the resolver
// only knows the removed member name after the module head resolved. Keep the
// per-module entries here so ADR-085 Phase F removals still produce an E0100
// migration hint instead of a bare "undefined module member".
pub fn removed_module_member_hint(module: String, name: String) -> String {
    if is_retired_hashmap_module(clone(module)) {
        return hashmap_method_replacement_hint()
    }
    if eq(clone(module), "wit") || eq(clone(module), "types") {
        return removed_wit_type_member_hint(name)
    }
    if eq(clone(module), "scan") {
        return removed_wit_scan_member_hint(name)
    }
    if eq(clone(module), "names") {
        return removed_wit_name_member_hint(name)
    }
    if eq(clone(module), "ast") {
        return removed_wit_ast_member_hint(name)
    }
    if eq(clone(module), "parser") {
        return removed_wit_parser_member_hint(name)
    }
    if eq(clone(module), "component") {
        return removed_component_member_hint(name)
    }
    if eq(clone(module), "handle") {
        return removed_component_handle_member_hint(name)
    }
    if eq(clone(module), "printer") && eq(clone(name), "print_wit") {
        return String_from("use `w.to_wit()` on `World` instead")
    }
    if eq(clone(module), "fmt") {
        return removed_fmt_member_hint(name)
    }
    if eq(clone(module), "rope") {
        return removed_rope_member_hint(name)
    }
    if eq(clone(module), "text") {
        return removed_text_member_hint(name)
    }
    if eq(clone(module), "string") {
        return removed_string_member_hint(name)
    }
    if eq(clone(module), "iter") {
        return removed_iter_member_hint(name)
    }
    if eq(clone(module), "bytes") {
        return removed_bytes_member_hint(name)
    }
    if eq(clone(module), "canonical") {
        return removed_canonical_member_hint(name)
    }
    if eq(clone(module), "json") {
        return removed_json_member_hint(name)
    }
    if eq(clone(module), "toml") {
        return removed_toml_member_hint(name)
    }
    let simd_type = removed_simd_lane_type(clone(module))
    if len(clone(simd_type)) > 0 {
        return "removed free function; call `"
        .concat(simd_type)
        .concat("::")
        .concat(clone(name))
        .concat("(...)` with the namespace type from `use std::simd::")
        .concat(clone(module))
        .concat("` instead")
    }
    if !eq(clone(module), "io") {
        return String_new()
    }
    if eq(clone(name), "reader_eof") { return "use `r.is_eof()` on `Reader` instead" }
    if eq(clone(name), "reader_read") { return "use `r.read(n)` on `Reader` instead" }
    if eq(clone(name), "reader_read_exact") { return "use `Io::read_exact(r, n)` from `use std::io::Io` instead" }
    if eq(clone(name), "reader_read_all") { return "use `Io::read_to_end(r)` from `use std::io::Io` instead" }
    if eq(clone(name), "reader_read_line") { return "use `r.read_line()` from `use std::io::BufRead` instead (`Option<String>`, `None` at EOF)" }
    if eq(clone(name), "copy_bytes") { return "use `Io::copy(from, to)` from `use std::io::Io` instead" }
    if eq(clone(name), "copy") { return "use `Io::copy(from, to)` from `use std::io::Io` instead" }
    if eq(clone(name), "copy_trait") { return "use `Io::copy(from, to)` from `use std::io::Io` instead" }
    if eq(clone(name), "new_memory_buffer") { return "use `Reader::new()` for a source or `Writer::new()` for a sink instead" }
    if eq(clone(name), "write_bytes") { return "use `w.write(data)` on `Writer` instead" }
    if eq(clone(name), "read_bytes") { return "use `r.read(n)` on `Reader` instead" }
    if eq(clone(name), "seek_to") { return "use `r.seek(SeekFrom::Start(pos))` from `use std::io::{Seek, SeekFrom}` instead" }
    if eq(clone(name), "buffer_position") { return "use `r.position()` from `use std::io::Seek` instead" }
    if eq(clone(name), "buffer_len") { return "use `r.len()` on `Reader` instead" }
    if eq(clone(name), "fill_buffer") { return "use `r.fill_buf()` from `use std::io::BufRead` instead" }
    if eq(clone(name), "file_from_fd") { return "the experimental fd lane was retired; use `std::host::fs::File::open(path)` instead" }
    if eq(clone(name), "file_read") { return "the experimental fd lane was retired; use `Read::read` on `std::host::fs::File` instead" }
    if eq(clone(name), "file_write") { return "the experimental fd lane was retired; use `std::host::fs::File::create` and `Write::write` instead (write side open under #693)" }
    if eq(clone(name), "reader_from_bytes") { return "use `Reader::from_bytes(data)` from `use std::io::Reader` instead" }
    if eq(clone(name), "buf_reader_new") { return "use `BufReader::new(r, cap)` from `use std::io::BufReader` instead" }
    if eq(clone(name), "buffered_reader") { return "use `BufReader::new(r, cap)` from `use std::io::BufReader` instead" }
    if eq(clone(name), "buf_reader_read_line") { return "use `br.read_line()` from `use std::io::BufRead` instead (`Option<String>`, `None` at EOF)" }
    if eq(clone(name), "buf_writer_new") { return "use `BufWriter::new(w, cap)` from `use std::io::BufWriter` instead" }
    if eq(clone(name), "buffered_writer") { return "use `BufWriter::new(w, cap)` from `use std::io::BufWriter` instead" }
    if eq(clone(name), "buf_writer_write_str") { return "use `bw.write_string(s)` on `BufWriter` instead" }
    if eq(clone(name), "buf_writer_flush") { return "use `bw.flush()` on `BufWriter` instead" }
    if eq(clone(name), "writer_new") { return "use `Writer::new()` from `use std::io::Writer` instead" }
    if eq(clone(name), "write_all") { return "use `Io::write_all(w, data)` from `use std::io::Io` instead" }
    if eq(clone(name), "write_string") { return "use `w.write_string(s)` on `Writer` instead" }
    if eq(clone(name), "writer_flush") { return "use `w.flush()` on `Writer` instead" }
    if eq(clone(name), "writer_to_bytes") { return "use `w.into_bytes()` on `Writer` instead" }
    String_new()
}

fn removed_bytes_member_hint(name: String) -> String {
    if eq(clone(name), "bytes_new") { return String_from("use `Vec::new<i32>()` instead") }
    if eq(clone(name), "bytes_len") { return String_from("use `b.len()` on the byte vector instead") }
    if eq(clone(name), "bytes_get") { return String_from("use `b.get_unchecked(i)` instead") }
    if eq(clone(name), "bytes_push") { return String_from("use `b.push_byte(x)` instead") }
    if eq(clone(name), "bytes_eq") { return String_from("use `a.equals_bytes(b)` instead") }
    if eq(clone(name), "bytes_from_string") { return String_from("use `s.to_utf8_bytes()` on the `String` instead") }
    if eq(clone(name), "string_from_bytes") { return String_from("use `String::from_utf8_lossy(b)` instead") }
    if eq(clone(name), "bytes_concat") { return String_from("use `a.concat_bytes(b)` instead") }
    if eq(clone(name), "bytes_slice") { return String_from("use `b.slice_bytes(start, end)` instead") }
    if eq(clone(name), "byte_length") { return String_from("use `s.len_bytes()` on the `String` instead") }
    if eq(clone(name), "hex_encode") { return String_from("use `b.to_hex()` instead") }
    if eq(clone(name), "hex_decode") { return String_from("use `Bytes::from_hex(s)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "leb128_encode_u32") { return String_from("use `Bytes::from_leb128_u32(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "leb128_encode_i32") { return String_from("use `Bytes::from_leb128_i32(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "u16_to_le_bytes") { return String_from("use `Bytes::from_u16_le(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "u16_from_le_bytes") { return String_from("use `b.to_u16_le()` instead") }
    if eq(clone(name), "u32_to_le_bytes") { return String_from("use `Bytes::from_u32_le(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "u32_from_le_bytes") { return String_from("use `b.to_u32_le()` instead") }
    if eq(clone(name), "u32_to_be_bytes") { return String_from("use `Bytes::from_u32_be(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "u32_from_be_bytes") { return String_from("use `b.to_u32_be()` instead") }
    if eq(clone(name), "bytes_from_array") { return String_from("use `Bytes::from_array(xs)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "buf_new") { return String_from("use `Vec::new<i32>()` instead") }
    if eq(clone(name), "buf_with_capacity") { return String_from("use `Vec::with_capacity<i32>(cap)` instead") }
    if eq(clone(name), "buf_push_u8") { return String_from("use `b.push_byte(x)` instead") }
    if eq(clone(name), "buf_push_u16_le") { return String_from("use `b.push_u16_le(x)` instead") }
    if eq(clone(name), "buf_push_u32_le") { return String_from("use `b.push_u32_le(x)` instead") }
    if eq(clone(name), "buf_push_u64_le") { return String_from("use `b.push_u64_le(x)` instead") }
    if eq(clone(name), "buf_extend") { return String_from("use `b.extend_bytes(other)` instead") }
    if eq(clone(name), "buf_freeze") { return String_from("use `b.freeze()` (identity; both layouts are `Vec<i32>`)") }
    if eq(clone(name), "buf_len") { return String_from("use `b.len()` on the byte vector instead") }
    if eq(clone(name), "cursor_new") { return String_from("use `data.byte_cursor()` instead") }
    if eq(clone(name), "cursor_pos") { return String_from("use `c.cursor_pos()` instead") }
    if eq(clone(name), "cursor_remaining") { return String_from("use `c.cursor_remaining()` instead") }
    if eq(clone(name), "read_u8") { return String_from("use `c.read_u8()` instead") }
    if eq(clone(name), "read_u16_le") { return String_from("use `c.read_u16_le()` instead") }
    if eq(clone(name), "read_u32_le") { return String_from("use `c.read_u32_le()` instead") }
    if eq(clone(name), "read_u64_le") { return String_from("use `c.read_u64_le()` instead") }
    if eq(clone(name), "read_u32_be") { return String_from("use `c.read_u32_be()` instead") }
    if eq(clone(name), "read_bytes") { return String_from("use `c.read_bytes(n)` instead") }
    if eq(clone(name), "base64_encode") { return String_from("use `b.to_base64()` instead") }
    if eq(clone(name), "base64_decode") { return String_from("use `Bytes::from_base64(s)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "leb128_decode_u32") { return String_from("use `c.read_leb128_u32()` instead") }
    if eq(clone(name), "leb128_decode_i32") { return String_from("use `c.read_leb128_i32()` instead") }
    if eq(clone(name), "leb128_encode_u64") { return String_from("use `Bytes::from_leb128_u64(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "leb128_decode_u64") { return String_from("use `c.read_leb128_u64()` instead") }
    if eq(clone(name), "hex_char") { return String_from("removed helper; use `b.to_hex()` instead") }
    if eq(clone(name), "hex_val_char") { return String_from("removed helper; use `Bytes::from_hex(s)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "try_hex_val_char") { return String_from("removed helper; use `Bytes::from_hex(s)` via `use std::bytes::Bytes` instead") }
    if eq(clone(name), "try_read_u8") { return String_from("removed free function; use `c.try_read_u8()` instead") }
    if eq(clone(name), "try_read_u16_le") { return String_from("removed free function; use `c.try_read_u16_le()` instead") }
    if eq(clone(name), "try_read_u32_le") { return String_from("removed free function; use `c.try_read_u32_le()` instead") }
    if eq(clone(name), "try_read_u32_be") { return String_from("removed free function; use `c.try_read_u32_be()` instead") }
    if eq(clone(name), "try_read_bytes") { return String_from("removed free function; use `c.try_read_bytes(n)` instead") }
    String_new()
}

fn removed_canonical_member_hint(name: String) -> String {
    if eq(clone(name), "canonical_scratch_new") {
        return String_from("use `Component::scratch_new()` from `use std::component::Component` instead")
    }
    if eq(clone(name), "canonical_lower_string") {
        return String_from("use `Component::lower_string(scratch, s)` from `use std::component::Component` instead")
    }
    if eq(clone(name), "canonical_lift_string") {
        return String_from("use `Component::lift_string(scratch, slice)` from `use std::component::Component` instead")
    }
    if eq(clone(name), "canonical_lift_string_at") {
        return String_from("use `Component::lift_string_at(scratch, ptr, len)` from `use std::component::Component` instead")
    }
    if eq(clone(name), "canonical_lower_list_i32") {
        return String_from("use `Component::lower_list_i32(scratch, items)` from `use std::component::Component` instead")
    }
    if eq(clone(name), "canonical_lift_list_i32") {
        return String_from("use `Component::lift_list_i32(scratch, slice)` from `use std::component::Component` instead")
    }
    if eq(clone(name), "canonical_lift_list_i32_at") {
        return String_from("use `Component::lift_list_i32_at(scratch, ptr, count)` from `use std::component::Component` instead")
    }
    String_new()
}

fn removed_json_member_hint(name: String) -> String {
    if eq(clone(name), "json_get") { return "use `v.get_field(key)` on `JsonValue` instead" }
    if eq(clone(name), "json_get_index") { return "use `v.get_index(index)` on `JsonValue` instead" }
    if eq(clone(name), "json_as_string") { return "use `v.as_string()` on `JsonValue` instead" }
    if eq(clone(name), "json_as_i32") { return "use `v.as_i32()` on `JsonValue` instead" }
