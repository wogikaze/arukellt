// Prelude decls outside the ADR-072 stable set: still public in
// std::prelude but no longer auto-imported. The hint keeps the call
// working through an explicit selective import.
fn removed_gated_prelude_hint(name: String) -> String {
    if !is_gated_prelude_name(name.clone()) {
        return String_new()
    }
    "no longer auto-imported; add `use std::prelude::{".concat(name.concat("}`"))
}

// Retired prelude free functions. Each hint names the exact receiver method
// or namespace associated function so a bare old call fails with E0100 and a
// usable migration target, not a request to import a name that no longer
