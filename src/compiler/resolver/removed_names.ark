        assert(len(removed_module_member_hint(String_from("io"), String_from("reader_read"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("copy"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("seek_to"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("fill_buffer"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("file_read"))) > 0)
    }
    test "retired io compat wrappers have removal hints" {
        // ADR-085 Phase F retired the Vec-layout reader / buffered adapters and
        // the memory-writer wrappers; the tagged output pair stays callable.
        assert(len(removed_module_member_hint(String_from("io"), String_from("reader_from_bytes"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_reader_new"))) > 0)
