// Names removed from the auto-imported prelude / compat surface, or
// gated behind explicit 'use std::prelude::{name}' imports by the v2
// prelude policy (ADR-072). resolve_unknown_name consults this table
// so pre-v2 sources get a migration hint instead of a bare
// undefined-name error. Keep aligned with std/manifest.toml
// deprecations and docs/stdlib/migration-guidance.md;
// scripts/check/check-compat-orphans.py verifies both directions.
use std::prelude::{clone, eq}
use std::text

pub fn removed_name_hint(name: String) -> String {
    let specific = removed_name_specific_hint(clone(name))
    if len(clone(specific)) > 0 {
        return specific
    }
    return removed_gated_prelude_hint(name)
}

fn removed_name_specific_hint(name: String) -> String {
    if text::starts_with(clone(name), String_from("HashMap_")) {
        return text::concat(
            String_from("removed HashMap builtin; use `HashMap::new<K, V>()` plus receiver methods "),
            String_from("(`m.insert(k, v)`, `m.get(k)`, `m.contains_key(k)`, `m.remove(k)`, `m.len()`, "),
            String_from("`m.is_empty()`, `m.keys()`, `m.values()`, `m.entries()`)")
        )
    }
    if eq(clone(name), "concat") { return "removed prelude wrapper; call `text::concat(a, b)` via `use std::text`, or `a.text::concat(b)`" }
    if eq(clone(name), "clear") { return "removed free function; use the Vec method `v.clear()`" }
    if eq(clone(name), "map_option_String_String") { return "removed free function; use `o.map(f)` via `use std::core::container`" }
    if eq(clone(name), "map_result_i32_i32") { return "removed free function; use `r.map(f)` via `use std::core::container`" }
    if eq(clone(name), "char_at") { return "removed prelude wrapper; use `byte_at(s, i)` via `use std::prelude::{byte_at}`" }
    if eq(clone(name), "println") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::println(...)`" }
    if eq(clone(name), "print") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::print(...)`" }
    if eq(clone(name), "eprintln") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::eprintln(...)`" }
    if eq(clone(name), "read_to_string") { return "removed prelude binding; import `use std::host::stdio` and call `stdio::read_stdin()`" }
    if eq(clone(name), "exists") { return "removed prelude binding; import `use std::host::fs` and call `fs::is_readable_file(...)`" }
    if eq(clone(name), "get_var") { return "removed prelude binding; import `use std::host::env` and call `env::var(...)`" }
    if eq(clone(name), "sort_i32") || eq(clone(name), "sort_i64") || eq(clone(name), "sort_f64") || eq(clone(name), "sort_String") {
        return "removed free function; use `v.sort_by(cmp)` via `use std::collections::vec`"
    }
    if eq(clone(name), "map_i32_i32") || eq(clone(name), "map_i64_i64") || eq(clone(name), "map_f64_f64") || eq(clone(name), "map_String_String") {
        return "removed free function; use `v.iter().map(f).collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "filter_i64") || eq(clone(name), "filter_f64") || eq(clone(name), "filter_String") {
        return "removed free function; use `v.iter().filter(f).collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "filter_i32") {
        return "provisional prelude helper; import `use std::prelude::{filter_i32}` or use `v.iter().filter(f).collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "fold_i32_i32") || eq(clone(name), "fold_i64_i64") || eq(clone(name), "fold_f64_f64") {
        return "removed free function; use `v.iter().fold(init, f)` via `use std::core::iter`"
    }
    if eq(clone(name), "any_i32") || eq(clone(name), "any_i64") || eq(clone(name), "any_f64") || eq(clone(name), "any_String") {
        return "removed free function; use `v.iter().any(f)` via `use std::core::iter`"
    }
    if eq(clone(name), "find_i32") || eq(clone(name), "find_i64") || eq(clone(name), "find_f64") || eq(clone(name), "find_String") {
        return "removed free function; use `v.iter().find(f)` via `use std::core::iter`"
    }
    if eq(clone(name), "contains_i32") || eq(clone(name), "contains_String") {
        return "removed free function; use `v.iter().contains(x)` via `use std::core::iter`"
    }
    if eq(clone(name), "reverse_i32") || eq(clone(name), "reverse_String") {
        return "removed free function; use `v.iter().rev().collect()` via `use std::core::iter`"
    }
    if eq(clone(name), "remove_i32") {
        return "removed free function; use `v.drain(i, i + 1)` via `use std::collections::vec`"
    }
    if eq(clone(name), "sum_i32") {
        return "removed free function; use `v.iter().sum()` via `use std::core::iter`"
    }
    if eq(clone(name), "product_i32") {
        return "removed free function; use `v.iter().fold(1, mul)` via `use std::core::iter`"
    }
    if eq(clone(name), "map_option_i32_i32") {
        return "removed free function; use `o.map(f)` via `use std::core::container`"
    }
    if eq(clone(name), "contains_string") {
        return "removed free function; use the String method `s.contains(sub)`"
    }
    if eq(clone(name), "take_i32") { return "removed free function; import `use std::core::iter::{collect_take_i32}`" }
    if eq(clone(name), "skip_i32") { return "removed free function; import `use std::core::iter::{collect_skip_i32}`" }
    if eq(clone(name), "seq_reverse") { return "removed free function; import `use std::core::iter::{iter_reverse_i32}`" }
    if eq(clone(name), "seq_contains") { return "removed free function; import `use std::core::iter::{iter_contains_i32}`" }
    if eq(clone(name), "unique") { return "removed free function; import `use std::core::iter::{iter_unique_i32}`" }
    if eq(clone(name), "count_eq") { return "removed free function; import `use std::core::iter::{iter_count_eq_i32}`" }
    if eq(clone(name), "binary_search") { return "removed free function; import `use std::seq::{binary_search_by}`" }
    if eq(clone(name), "min_i32") { return "removed free function; import `use std::seq::{min_by}`" }
    if eq(clone(name), "max_i32") { return "removed free function; import `use std::seq::{max_by}`" }
    if eq(clone(name), "i32_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "i64_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "f64_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "bool_to_string") { return "removed prelude free function; use `x.to_string()` (inherent method)" }
    if eq(clone(name), "Vec_new") { return "removed Vec constructor; use `Vec::new<T>()`" }
    if eq(clone(name), "Vec_new_i32") { return "removed Vec constructor; use `Vec::new<i32>()`" }
    if eq(clone(name), "Vec_new_String") { return "removed Vec constructor; use `Vec::new<String>()`" }
    if eq(clone(name), "Vec_with_capacity") { return "removed Vec constructor; use `Vec::new<T>()`" }
    if eq(clone(name), "Vec_with_capacity_i32") { return "removed Vec constructor; use `Vec::new<i32>()`" }
    if eq(clone(name), "Vec_with_capacity_String") { return "removed Vec constructor; use `Vec::new<String>()`" }
    if eq(clone(name), "ok") { return "removed free function; construct the variant directly with `Ok(...)`" }
    if eq(clone(name), "err") { return "removed free function; construct the variant directly with `Err(...)`" }
    if eq(clone(name), "expect") { return "removed free function; use `unwrap_or(value, fallback)` or match on the variant" }
    if eq(clone(name), "unwrap_or_else") { return "removed free function; use `unwrap_or(value, fallback)`" }
    if eq(clone(name), "ok_or") { return "removed free function; convert Option to Result explicitly with `Ok`/`Err` or `match`" }
    String_new()
}

// Module-qualified calls cannot use the bare-name table above: the resolver
// only knows the removed member name after the module head resolved. Keep the
// per-module entries here so ADR-085 Phase F removals still produce an E0100
// migration hint instead of a bare "undefined module member".
pub fn removed_module_member_hint(module: String, name: String) -> String {
    if eq(clone(module), "wit") || eq(clone(module), "types") {
        return removed_wit_type_member_hint(name)
    }
    if eq(clone(module), "scan") {
        return removed_wit_scan_member_hint(name)
    }
    if eq(clone(module), "names") {
        return removed_wit_name_member_hint(name)
    }
    if eq(clone(module), "printer") && eq(clone(name), "print_wit") {
        return String_from("use `w.to_wit()` on `World` instead")
    }
    if !eq(clone(module), "io") {
        return String_new()
    }
    if eq(clone(name), "reader_eof") { return "use `r.is_eof()` on `Reader` instead" }
    if eq(clone(name), "reader_read") { return "use `r.read(n)` on `Reader` instead" }
    if eq(clone(name), "reader_read_exact") { return "use `Io::read_exact(r, n)` from `use std::io::Io` instead" }
    if eq(clone(name), "reader_read_all") { return "use `Io::read_to_end(r)` from `use std::io::Io` instead" }
    if eq(clone(name), "reader_read_line") { return "use `r.read_line()` from `use std::io::BufRead` instead (`Option<String>`, `None` at EOF)" }
    if eq(clone(name), "copy_bytes") { return "use `Io::copy(from, to)` from `use std::io::Io` instead" }
    if eq(clone(name), "copy") { return "use `Io::copy(from, to)` from `use std::io::Io` instead" }
    if eq(clone(name), "copy_trait") { return "use `Io::copy(from, to)` from `use std::io::Io` instead" }
    if eq(clone(name), "new_memory_buffer") { return "use `Reader::new()` for a source or `Writer::new()` for a sink instead" }
    if eq(clone(name), "write_bytes") { return "use `w.write(data)` on `Writer` instead" }
    if eq(clone(name), "read_bytes") { return "use `r.read(n)` on `Reader` instead" }
    if eq(clone(name), "seek_to") { return "use `r.seek(SeekFrom::Start(pos))` from `use std::io::{Seek, SeekFrom}` instead" }
    if eq(clone(name), "buffer_position") { return "use `r.position()` from `use std::io::Seek` instead" }
    if eq(clone(name), "buffer_len") { return "use `r.len()` on `Reader` instead" }
    if eq(clone(name), "fill_buffer") { return "use `r.fill_buf()` from `use std::io::BufRead` instead" }
    if eq(clone(name), "file_from_fd") { return "the experimental fd lane was retired; use `std::host::fs::File::open(path)` instead" }
    if eq(clone(name), "file_read") { return "the experimental fd lane was retired; use `Read::read` on `std::host::fs::File` instead" }
    if eq(clone(name), "file_write") { return "the experimental fd lane was retired; use `std::host::fs::File::create` and `Write::write` instead (write side open under #693)" }
    if eq(clone(name), "reader_from_bytes") { return "use `Reader::from_bytes(data)` from `use std::io::Reader` instead" }
    if eq(clone(name), "buf_reader_new") { return "use `BufReader::new(r, cap)` from `use std::io::BufReader` instead" }
    if eq(clone(name), "buffered_reader") { return "use `BufReader::new(r, cap)` from `use std::io::BufReader` instead" }
    if eq(clone(name), "buf_reader_read_line") { return "use `br.read_line()` from `use std::io::BufRead` instead (`Option<String>`, `None` at EOF)" }
    if eq(clone(name), "buf_writer_new") { return "use `BufWriter::new(w, cap)` from `use std::io::BufWriter` instead" }
    if eq(clone(name), "buffered_writer") { return "use `BufWriter::new(w, cap)` from `use std::io::BufWriter` instead" }
    if eq(clone(name), "buf_writer_write_str") { return "use `bw.write_string(s)` on `BufWriter` instead" }
    if eq(clone(name), "buf_writer_flush") { return "use `bw.flush()` on `BufWriter` instead" }
    if eq(clone(name), "writer_new") { return "use `Writer::new()` from `use std::io::Writer` instead" }
    if eq(clone(name), "write_all") { return "use `Io::write_all(w, data)` from `use std::io::Io` instead" }
    if eq(clone(name), "write_string") { return "use `w.write_string(s)` on `Writer` instead" }
    if eq(clone(name), "writer_flush") { return "use `w.flush()` on `Writer` instead" }
    if eq(clone(name), "writer_to_bytes") { return "use `w.into_bytes()` on `Writer` instead" }
    String_new()
}

fn removed_wit_type_member_hint(name: String) -> String {
    if eq(clone(name), "wit_type_bool") { return String_from("use the `WitType::Bool` variant instead") }
    if eq(clone(name), "wit_type_u8") { return String_from("use the `WitType::U8` variant instead") }
    if eq(clone(name), "wit_type_u16") { return String_from("use the `WitType::U16` variant instead") }
    if eq(clone(name), "wit_type_u32") { return String_from("use the `WitType::U32` variant instead") }
    if eq(clone(name), "wit_type_u64") { return String_from("use the `WitType::U64` variant instead") }
    if eq(clone(name), "wit_type_s8") { return String_from("use the `WitType::S8` variant instead") }
    if eq(clone(name), "wit_type_s16") { return String_from("use the `WitType::S16` variant instead") }
    if eq(clone(name), "wit_type_s32") { return String_from("use the `WitType::S32` variant instead") }
    if eq(clone(name), "wit_type_s64") { return String_from("use the `WitType::S64` variant instead") }
    if eq(clone(name), "wit_type_f32") { return String_from("use the `WitType::F32` variant instead") }
    if eq(clone(name), "wit_type_f64") { return String_from("use the `WitType::F64` variant instead") }
    if eq(clone(name), "wit_type_char") { return String_from("use the `WitType::Char` variant instead") }
    if eq(clone(name), "wit_type_string") { return String_from("use the `WitType::String` variant instead") }
    if eq(clone(name), "wit_type_list") { return String_from("use `WitType::list(inner)` instead") }
    if eq(clone(name), "wit_type_option") { return String_from("use `WitType::option(inner)` instead") }
    if eq(clone(name), "wit_type_id") { return String_from("use `ty.id()` on `WitType` instead") }
    if eq(clone(name), "wit_type_from_id") { return String_from("use `WitType::from_id(id)` instead") }
    if eq(clone(name), "wit_type_name") { return String_from("use `ty.name()` on `WitType` instead") }
    if eq(clone(name), "wit_type_from_ast") { return String_from("use `ty.wit_text()` on `WitType` instead") }
    if eq(clone(name), "wit_type_name_from_ark") { return String_from("use `WitType::name_from_ark(name)` instead") }
    String_new()
}

fn removed_wit_scan_member_hint(name: String) -> String {
    if eq(clone(name), "wit_find_char") { return String_from("use `WitText::find_char(s, ch, from)` instead") }
    if eq(clone(name), "wit_trim") { return String_from("use `WitText::trim(s)` instead") }
    if eq(clone(name), "wit_strip_version") { return String_from("use `WitText::strip_version(pkg)` instead") }
    if eq(clone(name), "wit_before_colon") { return String_from("use `WitText::before_colon(s)` instead") }
    if eq(clone(name), "wit_split_param") { return String_from("use `WitText::split_param(param)` instead") }
    if eq(clone(name), "wit_split_csv_items") { return String_from("use `WitText::split_csv_items(inner)` instead") }
    if eq(clone(name), "wit_line_start") { return String_from("use `WitText::line_start(text, pos)` instead") }
    if eq(clone(name), "wit_line_end") { return String_from("use `WitText::line_end(text, pos)` instead") }
    String_new()
}

fn removed_wit_name_member_hint(name: String) -> String {
    if eq(clone(name), "kebab_name") { return String_from("use `WitName::to_kebab(name)` instead") }
    if eq(clone(name), "kebab_to_snake") { return String_from("use `WitName::to_snake(name)` instead") }
    if eq(clone(name), "pascal_case") { return String_from("use `WitName::to_pascal(name)` instead") }
    if eq(clone(name), "capitalize_first") { return String_from("use `WitName::capitalize(name)` instead") }
    String_new()
}

// Prelude decls outside the ADR-072 stable set: still public in
// std::prelude but no longer auto-imported. The hint keeps the call
// working through an explicit selective import.
fn removed_gated_prelude_hint(name: String) -> String {
    if !is_gated_prelude_name(clone(name)) {
        return String_new()
    }
    text::concat("no longer auto-imported; add `use std::prelude::{", text::concat(name, "}`"))
}

fn is_gated_prelude_name(name: String) -> bool {
    if eq(clone(name), "Box") || eq(clone(name), "Box_new") || eq(clone(name), "Slice") {
        return true
    }
    if eq(clone(name), "abs") || eq(clone(name), "args") || eq(clone(name), "as_slice") {
        return true
    }
    if eq(clone(name), "assert_eq") || eq(clone(name), "assert_eq_i64") || eq(clone(name), "assert_eq_str") {
        return true
    }
    if eq(clone(name), "assert_ne") || eq(clone(name), "byte_at") || eq(clone(name), "byte_len") {
        return true
    }
    if eq(clone(name), "clamp_i32") || eq(clone(name), "clone") || eq(clone(name), "contains") {
        return true
    }
    if eq(clone(name), "ends_with") || eq(clone(name), "eq") || eq(clone(name), "exit") {
        return true
    }
    if eq(clone(name), "f32_to_f64") || eq(clone(name), "f32_to_string") || eq(clone(name), "f64_bits_hi") {
        return true
    }
    if eq(clone(name), "f64_bits_lo") || eq(clone(name), "f64_to_f32") || eq(clone(name), "format_bool") {
        return true
    }
    if eq(clone(name), "format_i32") || eq(clone(name), "gcd") || eq(clone(name), "i16_to_i32") {
        return true
    }
    if eq(clone(name), "i32_to_i16") || eq(clone(name), "i32_to_i64") || eq(clone(name), "i32_to_i8") {
        return true
    }
    if eq(clone(name), "i32_to_u16") || eq(clone(name), "i32_to_u32") || eq(clone(name), "i32_to_u8") {
        return true
    }
    if eq(clone(name), "i64_to_i32") || eq(clone(name), "i8_to_i32") || eq(clone(name), "index_of") {
        return true
    }
    if eq(clone(name), "is_empty") || eq(clone(name), "is_err") || eq(clone(name), "is_none") {
        return true
    }
    if eq(clone(name), "is_ok") || eq(clone(name), "is_some") || eq(clone(name), "join") {
        return true
    }
    if eq(clone(name), "lines") || eq(clone(name), "max") || eq(clone(name), "min") {
        return true
    }
    if eq(clone(name), "pad_left") || eq(clone(name), "pad_right") || eq(clone(name), "parse_f64") {
        return true
    }
    if eq(clone(name), "parse_i32") || eq(clone(name), "parse_i64") || eq(clone(name), "push_char") {
        return true
    }
    if eq(clone(name), "repeat") || eq(clone(name), "replace") || eq(clone(name), "slice") {
        return true
    }
    if eq(clone(name), "slice_get") || eq(clone(name), "slice_len") || eq(clone(name), "split") {
        return true
    }
    if eq(clone(name), "sqrt") || eq(clone(name), "starts_with") || eq(clone(name), "substring") {
        return true
    }
    if eq(clone(name), "to_lower") || eq(clone(name), "to_lowercase") || eq(clone(name), "to_string") {
        return true
    }
    if eq(clone(name), "to_upper") || eq(clone(name), "to_uppercase") || eq(clone(name), "trim") {
        return true
    }
    if eq(clone(name), "trim_end") || eq(clone(name), "trim_start") || eq(clone(name), "u16_to_i32") {
        return true
    }
    if eq(clone(name), "u32_to_u64") || eq(clone(name), "u64_to_u32") || eq(clone(name), "u8_to_i32") {
        return true
    }
    if eq(clone(name), "unbox") || eq(clone(name), "unwrap") || eq(clone(name), "unwrap_or") {
        return true
    }
    if eq(clone(name), "values") {
        return true
    }
    false
}
test mod "removed_names" {
    test "to_string family" {
        assert(len(removed_name_hint("i32_to_string")) > 0)
        assert(len(removed_name_hint("bool_to_string")) > 0)
    }
    test "vec ctor" { assert(len(removed_name_hint("Vec_new_i32")) > 0) }
    test "hashmap builtins" {
        assert(len(removed_name_hint("HashMap_i32_i32_new")) > 0)
        assert(len(removed_name_hint("HashMap_new_String_i32")) > 0)
        assert(len(removed_name_hint("HashMap_String_fn_get")) > 0)
    }
    test "io env fs" {
        assert(len(removed_name_hint("read_to_string")) > 0)
        assert(len(removed_name_hint("exists")) > 0)
        assert(len(removed_name_hint("get_var")) > 0)
    }
    test "result option helpers" {
        assert(len(removed_name_hint("ok")) > 0)
        assert(len(removed_name_hint("err")) > 0)
        assert(len(removed_name_hint("expect")) > 0)
        assert(len(removed_name_hint("unwrap_or_else")) > 0)
        assert(len(removed_name_hint("ok_or")) > 0)
    }
    test "io shims" { assert(len(removed_name_hint("eprintln")) > 0) }
    test "deprecated prelude hints" {
        assert(len(removed_name_hint("concat")) > 0)
        assert(len(removed_name_hint("char_at")) > 0)
        assert(len(removed_name_hint("println")) > 0)
    }
    test "gated prelude hints" {
        assert(len(removed_name_hint("eq")) > 0)
        assert(len(removed_name_hint("clone")) > 0)
        assert(len(removed_name_hint("substring")) > 0)
    }
    test "removed seq frees have E0100 hints" {
        assert(len(removed_name_hint("sort_i32")) > 0)
        assert(len(removed_name_hint("sort_String")) > 0)
        assert(len(removed_name_hint("map_i64_i64")) > 0)
        assert(len(removed_name_hint("filter_String")) > 0)
        assert(len(removed_name_hint("fold_f64_f64")) > 0)
        assert(len(removed_name_hint("any_i32")) > 0)
        assert(len(removed_name_hint("find_String")) > 0)
        assert(len(removed_name_hint("contains_i32")) > 0)
        assert(len(removed_name_hint("reverse_String")) > 0)
        assert(len(removed_name_hint("remove_i32")) > 0)
        assert(len(removed_name_hint("sum_i32")) > 0)
        assert(len(removed_name_hint("product_i32")) > 0)
        assert(len(removed_name_hint("map_option_i32_i32")) > 0)
        assert(len(removed_name_hint("contains_string")) > 0)
    }
    test "gated provisional filter_i32 has an import hint" {
        assert(len(removed_name_hint("filter_i32")) > 0)
    }
    test "live names have no hint" {
        assert(len(removed_name_hint("len")) == 0)
        assert(len(removed_name_hint("panic")) == 0)
    }
    test "removed io module members have hints" {
        assert(len(removed_module_member_hint(String_from("io"), String_from("reader_read"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("copy"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("seek_to"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("fill_buffer"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("file_read"))) > 0)
    }
    test "retired io compat wrappers have removal hints" {
        // ADR-085 Phase F retired the Vec-layout reader / buffered adapters and
        // the memory-writer wrappers; the tagged output pair stays callable.
        assert(len(removed_module_member_hint(String_from("io"), String_from("reader_from_bytes"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_reader_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_reader_read_line"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_writer_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_writer_write_str"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buf_writer_flush"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buffered_reader"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("buffered_writer"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_new"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("write_all"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("write_string"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_flush"))) > 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_to_bytes"))) > 0)
    }
    test "live io tagged writers have no removal hint" {
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_write"))) == 0)
        assert(len(removed_module_member_hint(String_from("io"), String_from("writer_write_str"))) == 0)
    }
    test "other modules do not get io hints" {
        assert(len(removed_module_member_hint(String_from("fs"), String_from("reader_read"))) == 0)
    }
    test "removed wit module members have hints" {
        assert(len(removed_module_member_hint(String_from("wit"), String_from("wit_type_u32"))) > 0)
        assert(len(removed_module_member_hint(String_from("types"), String_from("wit_type_from_ast"))) > 0)
        assert(len(removed_module_member_hint(String_from("types"), String_from("wit_type_name_from_ark"))) > 0)
        assert(len(removed_module_member_hint(String_from("scan"), String_from("wit_trim"))) > 0)
        assert(len(removed_module_member_hint(String_from("names"), String_from("kebab_name"))) > 0)
        assert(len(removed_module_member_hint(String_from("printer"), String_from("print_wit"))) > 0)
    }
    test "live wit members keep no removal hint" {
        assert(len(removed_module_member_hint(String_from("parser"), String_from("parse_full"))) == 0)
        assert(len(removed_module_member_hint(String_from("types"), String_from("WitParam"))) == 0)
    }
}
