pub struct ModuleDecls {
    name: String,
    decls: Vec<AstNode>,
}

fn ModuleDecls_new(name: String, decls: Vec<AstNode>) -> ModuleDecls {
    ModuleDecls { name: name, decls: decls }
}

fn module_name(module: ModuleDecls) -> String {
    module.name.clone()
}

fn module_decl_count(module: ModuleDecls) -> i32 {
    len(module.decls)
}

fn module_decl_at(module: ModuleDecls, index: i32) -> AstNode {
    get_unchecked(module.decls, index)
}

// ModuleDecls entries register under their short name ("std::text::string" is
// stored as "string"), so a use-path leaf segment is a module reference iff it
// matches a registered module name.
fn module_registered(modules: Vec<ModuleDecls>, name: String) -> bool {
    let count = len(modules)
    let mut i = 0
    while i < count {
        if modules::module_name(get_unchecked(modules, i)).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}
