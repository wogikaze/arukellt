// The high-level HashMap_<K>_<V>_* builtins were compiler lowering targets
// until #917 retired them together with their adapters in
// std/collections/hash_map.ark. The user-visible spelling is now
// `HashMap::new<K, V>()` plus receiver methods, so only the non-public
// __hm_* storage bridge remains here.
fn push_hash_builtin_symbol_names(mut names: Vec<String>) {
    names.push("__hm_si_new")
    names.push("__hm_si_new_with_cap")
    names.push("__hm_si_adopt")
    names.push("__hm_si_cap")
    names.push("__hm_si_size")
    names.push("__hm_si_set_size")
    names.push("__hm_si_get_flag")
    names.push("__hm_si_get_val")
    names.push("__hm_si_set_flag")
    names.push("__hm_si_set_val")
    names.push("__hm_si_get_key")
    names.push("__hm_si_set_key")
    names.push("__hm_is_new")
    names.push("__hm_is_new_with_cap")
    names.push("__hm_is_adopt")
    names.push("__hm_is_cap")
    names.push("__hm_is_size")
    names.push("__hm_is_set_size")
    names.push("__hm_is_get_flag")
    names.push("__hm_is_get_val")
    names.push("__hm_is_set_flag")
    names.push("__hm_is_set_val")
    names.push("__hm_is_get_key")
    names.push("__hm_is_set_key")
    names.push("__hm_if_new")
    names.push("__hm_if_new_with_cap")
    names.push("__hm_if_adopt")
    names.push("__hm_if_cap")
    names.push("__hm_if_size")
    names.push("__hm_if_set_size")
    names.push("__hm_if_get_flag")
    names.push("__hm_if_get_val")
    names.push("__hm_if_set_flag")
    names.push("__hm_if_set_val")
    names.push("__hm_if_get_key")
    names.push("__hm_if_set_key")
    names.push("__hm_ss_new")
    names.push("__hm_ss_new_with_cap")
    names.push("__hm_ss_adopt")
    names.push("__hm_ss_cap")
    names.push("__hm_ss_size")
    names.push("__hm_ss_set_size")
    names.push("__hm_ss_get_flag")
    names.push("__hm_ss_get_val")
    names.push("__hm_ss_set_flag")
    names.push("__hm_ss_set_val")
    names.push("__hm_ss_get_key")
    names.push("__hm_ss_set_key")
    names.push("__hm_sf_new")
    names.push("__hm_sf_new_with_cap")
    names.push("__hm_sf_adopt")
    names.push("__hm_sf_cap")
    names.push("__hm_sf_size")
    names.push("__hm_sf_set_size")
    names.push("__hm_sf_get_flag")
    names.push("__hm_sf_get_val")
    names.push("__hm_sf_set_flag")
    names.push("__hm_sf_set_val")
    names.push("__hm_sf_get_key")
    names.push("__hm_sf_set_key")
    names.push("__intrinsic_i31_box")
    names.push("i31_box")
}
