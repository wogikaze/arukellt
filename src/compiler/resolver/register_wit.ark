// WIT import registration in resolver scope (#653, #663, #670).

use std::prelude::{eq}
use std::text
use resolver::scope_lookup
use resolver::scope_define
use resolver::scope_error
use resolver::register_exports
use resolver::ast_decl_predicates
use resolver::ast_access
use resolver::wit_register
fn wit_seen_name(items: Vec<String>, name: String) -> bool {
    for i in 0..len(items) {
        if eq(get_unchecked(items, i), name.clone()) {
            return true
        }
    }
    false
}

fn register_wit_imports(mut ctx: ResolveCtx, wit_paths: Vec<String>, decls: Vec<AstNode>) {
    let mut seen_aliases = Vec::new<String>()
    let mut seen_packages = Vec::new<String>()
    let count = len(decls)
    let mut i = 0
    while i < count {
        let d = get_unchecked(decls, i)
        if ast_decl_predicates::node_is_wit_import(d) {
            let package_id = ast_access::node_text(d)
            let alias = wit_import_alias(d)
            let span_start = ast_access::node_span_start(d)
            let span_end = ast_access::node_span_end(d)
            if len(alias) > 0 && wit_seen_name(seen_aliases, alias.clone()) {
                scope_error::resolve_duplicate_symbol(ctx, "WIT import alias `".concat(alias.clone().concat("`")), span_start, span_end)
            } else {
                if wit_seen_name(seen_packages, package_id.clone()) {
                    scope_error::resolve_duplicate_symbol(ctx, "WIT package `".concat(package_id.clone().concat("`")), span_start, span_end)
                } else {
                    if len(alias) > 0 {
                        push(seen_aliases, alias.clone())
                    }
                    push(seen_packages, package_id.clone())
                    register_one_wit_import(ctx, wit_paths, package_id, alias, span_start, span_end)
                }
            }
        }
        i = i + 1
    }
}

fn wit_import_alias(decl: AstNode) -> String {
    if ast_access::node_type_ann_count(decl) == 0 {
        return String_new()
    }
    ast_access::node_text(ast_access::node_type_ann_at(decl, 0))
}

fn register_wit_module_alias(mut ctx: ResolveCtx, alias: String) {
    wit_register::wit_ensure_module_alias(ctx, alias.clone())
}

fn register_one_wit_import(mut ctx: ResolveCtx, wit_paths: Vec<String>, package_id: String, alias: String, span_start: i32, span_end: i32) {
    if len(alias) == 0 {
        return
    }
    // Reserve the alias before registering exports. This catches collisions with
    // ordinary modules/local imports using the WIT declaration's real span.
    wit_register::wit_ensure_module_alias_at(ctx, alias.clone(), span_start, span_end)
    if scope_lookup::lookup_kind(ctx, alias.clone()) != commands::SYM_MODULE() {
        return
    }
    let doc = wit_register::wit_doc_from_import(wit_paths, package_id.clone())
    if wit_register::wit_doc_has_surface(doc) {
        wit_register::register_wit_doc(ctx, alias.clone(), doc)
        return
    }
    if eq(package_id.clone(), "test:host/math") {
        register_wit_host_math(ctx, alias.clone())
        return
    }
    if eq(package_id.clone(), "test:doc/parse") {
        register_wit_doc_parse(ctx, alias.clone())
        return
    }
    if eq(package_id.clone(), "test:host/host") {
        register_wit_host_flags(ctx, alias.clone())
        return
    }
    if eq(package_id.clone(), "test:host/handles") {
        register_wit_host_resource_handles(ctx, alias.clone())
    }
}

fn register_wit_host_math(mut ctx: ResolveCtx, alias: String) {
    register_wit_module_alias(ctx, alias.clone())
    register_exports::register_module_export(ctx, alias.clone(), "add", commands::SYM_FN(), true)
}

fn register_wit_doc_parse(mut ctx: ResolveCtx, alias: String) {
    register_wit_module_alias(ctx, alias.clone())
    register_exports::register_module_export(ctx, alias.clone(), "parse_markdown", commands::SYM_FN(), true)
    register_exports::register_module_export(ctx, alias.clone(), "Document", commands::SYM_STRUCT(), true)
}

fn register_wit_host_flags(mut ctx: ResolveCtx, alias: String) {
    register_wit_module_alias(ctx, alias.clone())
    register_exports::register_module_export(ctx, alias.clone(), "set_perms", commands::SYM_FN(), true)
}

fn register_wit_host_resource_handles(mut ctx: ResolveCtx, alias: String) {
    register_wit_module_alias(ctx, alias.clone())
    register_exports::register_module_export(ctx, alias.clone(), "take", commands::SYM_FN(), true)
    register_exports::register_module_export(ctx, alias.clone(), "peek", commands::SYM_FN(), true)
}
