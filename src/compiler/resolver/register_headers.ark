use resolver::ctx_record
use resolver::impl_target
use resolver::scope_define
use resolver::scope_lookup
use resolver::ast_decl_predicates
use resolver::ast_access
use resolver::register_use
use corehir::decl_impl_target
fn register_decl_headers(mut ctx: ResolveCtx, decls: Vec<AstNode>) {
    let count = decls.len()
    let mut i = 0
    while i < count {
        let d = get_unchecked(decls, i)
        if ast_decl_predicates::node_is_fn_decl(d) {
            scope_define::define_with_vis_span(
                ctx,
                ast_access::node_text(d),
                commands::SYM_FN(),
                ast_access::node_is_pub(d),
                ast_access::node_decl_name_span_start(d),
                ast_access::node_decl_name_span_end(d)
            )
        } else {
            if ast_decl_predicates::node_is_const_decl(d) {
                scope_define::define_with_vis(ctx, ast_access::node_text(d), commands::SYM_FN(), ast_access::node_is_pub(d))
            } else {
                if ast_decl_predicates::node_is_struct_decl(d) {
                    scope_define::define_with_vis(ctx, ast_access::node_text(d), commands::SYM_STRUCT(), ast_access::node_is_pub(d))
                } else {
                    if ast_decl_predicates::node_is_resource_decl(d) {
                        scope_define::define_with_vis(ctx, ast_access::node_text(d), commands::SYM_RESOURCE(), ast_access::node_is_pub(d))
                    } else {
                        if ast_decl_predicates::node_is_enum_decl(d) {
                            scope_define::define_with_vis(ctx, ast_access::node_text(d), commands::SYM_ENUM(), ast_access::node_is_pub(d))
                        } else {
                            register_non_type_decl_header(ctx, d)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
}

fn register_non_type_decl_header(mut ctx: ResolveCtx, d: AstNode) {
    if ast_decl_predicates::node_is_impl_decl(d) {
        register_impl_method_headers(ctx, d)
    } else if ast_decl_predicates::node_is_use(d) {
        register_use::register_use_decl(ctx, d)
    } else if ast_decl_predicates::node_is_import(d) && !ast_decl_predicates::node_is_wit_import(d) {
        register_use::register_local_import_decl(ctx, d)
    }
}

fn register_impl_method_headers(mut ctx: ResolveCtx, d: AstNode) {
    let known_type_names = ctx_record::resolve_ctx_declared_type_names(ctx)
    let struct_name = impl_target::impl_self_type_name(d, known_type_names.clone())
    let base_name = impl_target::impl_self_base_type_name(d)
    let trait_name = ast_access::node_text(d)
    let has_trait = impl_target::impl_head_count(d) >= 2
    // A concrete FromIterator impl is keyed by its source type, so the
    // mangled header is not a source-level spelling. Bind `Type::from_iter`
    // on the declared base type as well; the concrete impl is selected later
    // from the call's source argument (#917).
    let register_base_alias = has_trait &&
    trait_name.clone().eq(String_from("FromIterator")) &&
    !base_name.clone().eq(struct_name.clone())
    let mcount = ast_access::node_child_count(d)
    let mut mi = 0
    while mi < mcount {
        let method = ast_access::node_child_at(d, mi)
        let method_name = ast_access::node_text(method)
        let mangled = decl_impl_target::impl_method_mangled_name(
            d,
            method_name.clone(),
            known_type_names.clone()
        )
        let existing_mangled = scope_lookup::lookup(ctx, mangled.clone())
        if existing_mangled < 0 || !has_trait {
            scope_define::define_with_vis(ctx, mangled, commands::SYM_FN(), true)
        }
        if has_trait && !trait_name.clone().eq(struct_name.clone()) {
            let existing = scope_lookup::lookup(ctx, method_name.clone())
            if existing < 0 {
                scope_define::define_with_vis(ctx, method_name, commands::SYM_FN(), true)
            }
        }
        if register_base_alias {
            let alias_name = base_name.clone().concat(String_from("::".concat(method_name.clone())))
            let existing_alias = scope_lookup::lookup(ctx, alias_name.clone())
            if existing_alias < 0 {
                scope_define::define_with_vis(ctx, alias_name, commands::SYM_FN(), true)
            }
        }
        mi = mi + 1
    }
}
