use resolver::ref_index
use resolver::scope_record
use resolver::modules
struct ResolveCtx {
    scopes: Vec<Scope>,
    current_depth: i32,
    error_count: i32,
    errors: Vec<String>,
    diagnostics: Vec<Diagnostic>,
    next_decl_index: i32,
    target: String,
    host_profile: String,
    ref_index: RefIndex,
    use_alias_shorts: Vec<String>,
    use_alias_targets: Vec<String>,
    modules: Vec<ModuleDecls>,
    // Nominal type names declared by the program. ADR-089 owner keys treat a
    // single-uppercase impl head name on this list as concrete, and only
    // undeclared names as ADR-014 window parameters.
    declared_type_names: Vec<String>,
}

fn ResolveCtx_new_empty() -> ResolveCtx {
    ResolveCtx {
        scopes: Vec::new<Scope>(),
        current_depth: 0,
        error_count: 0,
        errors: Vec::new<String>(),
        diagnostics: Vec::new<Diagnostic>(),
        next_decl_index: 0,
        target: "wasm32-gc",
        host_profile: "wasi-p2",
        ref_index: ref_index::RefIndex_new(),
        use_alias_shorts: Vec::new<String>(),
        use_alias_targets: Vec::new<String>(),
        modules: Vec::new<ModuleDecls>(),
        declared_type_names: Vec::new<String>()
    }
}

// The typechecker needs each imported module's decl region to give function
// signatures module-qualified index keys (mod::f). resolve_program stores
// the same module list it registers so later phases can recover it.
fn resolve_ctx_set_modules(mut ctx: ResolveCtx, modules: Vec<ModuleDecls>) {
    ctx.modules = modules
}

fn resolve_ctx_modules(ctx: ResolveCtx) -> Vec<ModuleDecls> {
    ctx.modules
}

fn resolve_ctx_set_declared_type_names(mut ctx: ResolveCtx, names: Vec<String>) {
    ctx.declared_type_names = names
}

fn resolve_ctx_declared_type_names(ctx: ResolveCtx) -> Vec<String> {
    ctx.declared_type_names
}

fn resolve_ctx_ref_index(ctx: ResolveCtx) -> RefIndex {
    ctx.ref_index
}

fn resolve_ctx_scope_count(ctx: ResolveCtx) -> i32 {
    ctx.scopes.len()
}

fn resolve_ctx_scope_at(ctx: ResolveCtx, index: i32) -> Scope {
    ctx.scopes.get_unchecked(index)
}

fn resolve_ctx_push_scope_value(mut ctx: ResolveCtx, scope: Scope) {
    ctx.scopes.push(scope)
}

fn resolve_ctx_current_depth(ctx: ResolveCtx) -> i32 {
    ctx.current_depth
}

fn resolve_ctx_take_next_decl_index(mut ctx: ResolveCtx) -> i32 {
    let idx = ctx.next_decl_index
    ctx.next_decl_index = ctx.next_decl_index + 1
    idx
}

fn resolve_ctx_target(ctx: ResolveCtx) -> String {
    ctx.target.clone()
}

fn resolve_ctx_set_target(mut ctx: ResolveCtx, target: String) {
    ctx.target = target
}

fn resolve_ctx_has_target_and_host_profile(ctx: ResolveCtx, target: String, host_profile: String) -> bool {
    ctx.target.clone().eq(target) && ctx.host_profile.clone().eq(host_profile)
}

fn resolve_ctx_set_host_profile(mut ctx: ResolveCtx, host_profile: String) {
    ctx.host_profile = host_profile
}

fn resolve_ctx_push_depth(mut ctx: ResolveCtx) {
    ctx.current_depth = ctx.current_depth + 1
}

fn resolve_ctx_pop_depth(mut ctx: ResolveCtx) {
    ctx.current_depth = ctx.current_depth - 1
}

fn resolve_ctx_push_error(mut ctx: ResolveCtx, msg: String) {
    ctx.error_count = ctx.error_count + 1
    ctx.errors.push(msg)
}

fn resolve_ctx_push_diagnostic(mut ctx: ResolveCtx, diag: Diagnostic) {
    ctx.diagnostics.push(diag)
}

fn resolve_ctx_errors(ctx: ResolveCtx) -> Vec<String> {
    ctx.errors
}

fn resolve_ctx_diagnostics(ctx: ResolveCtx) -> Vec<Diagnostic> {
    ctx.diagnostics
}

fn resolve_ctx_error_message_count(ctx: ResolveCtx) -> i32 {
    ctx.errors.len()
}

fn resolve_ctx_reported_error_count(ctx: ResolveCtx) -> i32 {
    ctx.error_count
}

fn resolve_ctx_error_at(ctx: ResolveCtx, index: i32) -> String {
    ctx.errors.get_unchecked(index).clone()
}

fn resolve_ctx_add_use_alias(mut ctx: ResolveCtx, short_name: String, target: String) {
    let count = ctx.use_alias_shorts.len()
    let mut i = 0
    while i < count {
        if ctx.use_alias_shorts.get_unchecked(i).clone().eq(short_name.clone()) {
            ctx.use_alias_targets.set(i, target)
            return
        }
        i = i + 1
    }
    ctx.use_alias_shorts.push(short_name)
    ctx.use_alias_targets.push(target)
}

fn resolve_ctx_lookup_use_alias(ctx: ResolveCtx, short_name: String) -> String {
    let count = ctx.use_alias_shorts.len()
    let mut i = 0
    while i < count {
        if ctx.use_alias_shorts.get_unchecked(i).clone().eq(short_name.clone()) {
            return ctx.use_alias_targets.get_unchecked(i).clone()
        }
        i = i + 1
    }
    String_new()
}
