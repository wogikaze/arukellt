fn resolver_builtin_module_names() -> Vec<String> {
    let names = Vec::new<String>()
    push(names, "stdio")
    push(names, "fs")
    push(names, "process")
    push(names, "env")
    push(names, "text")
    push(names, "math")
    push(names, "core")
    push(names, "host")
    push(names, "clock")
    push(names, "random")
    push(names, "convert")
    push(names, "string")
    push(names, "collections")
    names
}
