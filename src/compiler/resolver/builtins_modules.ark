fn resolver_builtin_module_names() -> Vec<String> {
    let mut names = Vec::new<String>()
    names.push("stdio")
    names.push("fs")
    names.push("process")
    names.push("env")
    names.push("text")
    names.push("math")
    names.push("core")
    names.push("host")
    names.push("clock")
    names.push("random")
    names.push("convert")
    names.push("string")
    names.push("collections")
    names
}
