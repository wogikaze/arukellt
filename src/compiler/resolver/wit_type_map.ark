// WIT type mapping — WIT surface types to Arukellt type names (#653, #664, #671, #672).

use std::text
use component::wit_names_import
use component::wit_parse_flags
use component::wit_parse_text

fn wit_primitive_to_ark(wit_type: String) -> String {
    let t = wit_trim_type(wit_type)
    if wit_parse_flags::wit_is_flags_type(t.clone()) { return "i32" }
    if t.clone().starts_with("future<") || t.clone().starts_with("stream<") { return "i32" }
    if t.clone().eq("s32") || t.clone().eq("u32") { return "i32" }
    if t.clone().eq("s64") || t.clone().eq("u64") { return "i64" }
    if t.clone().eq("f32") { return "f32" }
    if t.clone().eq("f64") { return "f64" }
    if t.clone().eq("bool") { return "bool" }
    if t.clone().eq("char") { return "char" }
    if t.clone().eq("string") { return "String" }
    if t.clone().eq("s8") || t.clone().eq("u8") { return "i32" }
    if t.clone().eq("s16") || t.clone().eq("u16") { return "i32" }
    t.clone()
}

fn wit_trim_type(t: String) -> String {
    let n = len(t)
    let mut start = 0
    while start < n {
        let ch = t.byte_at(start)
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 { break }
        start = start + 1
    }
    let mut end = n
    while end > start {
        let ch = t.byte_at(end - 1)
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 { break }
        end = end - 1
    }
    t.slice(start, end)
}

fn wit_record_wit_names(doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    let records = wit_parse_text::WitParsedInterface_records(doc)
    let mut names = Vec::new<String>()
    for ri in 0..len(records) {
        let rec = get_unchecked(records, ri)
        push(names, rec.wit_name.clone())
    }
    names
}

fn wit_record_ark_names(doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    let records = wit_parse_text::WitParsedInterface_records(doc)
    let mut names = Vec::new<String>()
    for ri in 0..len(records) {
        let rec = get_unchecked(records, ri)
        push(names, rec.ark_name.clone())
    }
    names
}

fn wit_enum_wit_names(doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    let enums = wit_parse_text::WitParsedInterface_enums(doc)
    let mut names = Vec::new<String>()
    for ei in 0..len(enums) {
        let en = get_unchecked(enums, ei)
        push(names, en.wit_name.clone())
    }
    names
}

fn wit_enum_ark_names(doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    let enums = wit_parse_text::WitParsedInterface_enums(doc)
    let mut names = Vec::new<String>()
    for ei in 0..len(enums) {
        let en = get_unchecked(enums, ei)
        push(names, en.ark_name.clone())
    }
    names
}

fn wit_variant_wit_names(doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    let variants = wit_parse_text::WitParsedInterface_variants(doc)
    let mut names = Vec::new<String>()
    for vi in 0..len(variants) {
        let variant = get_unchecked(variants, vi)
        push(names, variant.wit_name.clone())
    }
    names
}

fn wit_variant_ark_names(doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    let variants = wit_parse_text::WitParsedInterface_variants(doc)
    let mut names = Vec::new<String>()
    for vi in 0..len(variants) {
        let variant = get_unchecked(variants, vi)
        push(names, variant.ark_name.clone())
    }
    names
}

fn wit_generic_args(t: String) -> Vec<String> {
    let mut args = Vec::new<String>()
    let open = t.index_of("<")
    if open < 0 { return args }
    let mut close = len(t) - 1
    while close > open && t.byte_at(close) != 62 { close = close - 1 }
    if close <= open { return args }
    let inner = t.slice(open + 1, close)
    let mut start = 0
    let mut depth = 0
    let mut i = 0
    while i < len(inner) {
        let ch = inner.byte_at(i)
        if ch == 60 { depth = depth + 1 }
        if ch == 62 { depth = depth - 1 }
        if ch == 44 && depth == 0 {
            push(args, wit_trim_type(inner.slice(start, i)))
            start = i + 1
        }
        i = i + 1
    }
    if start < len(inner) { push(args, wit_trim_type(inner.slice(start, len(inner)))) }
    args
}

fn wit_render_ark_generic(base: String, args: Vec<String>, alias: String, doc: wit_parse_text::WitParsedInterface) -> String {
    let mut out = base.concat("<")
    for i in 0..len(args) {
        if i > 0 { out = out.concat(",") }
        out = out.concat(wit_type_to_ark(get_unchecked(args, i), alias.clone(), doc))
    }
    out.concat(">")
}

fn wit_type_to_ark(wit_type: String, alias: String, doc: wit_parse_text::WitParsedInterface) -> String {
    let rec_wit = wit_record_wit_names(doc)
    let rec_ark = wit_record_ark_names(doc)
    let enum_wit = wit_enum_wit_names(doc)
    let enum_ark = wit_enum_ark_names(doc)
    let variant_wit = wit_variant_wit_names(doc)
    let variant_ark = wit_variant_ark_names(doc)
    let t = wit_trim_type(wit_type)
    if len(t) == 0 { return "()" }
    if t.clone().starts_with("list<") { return wit_render_ark_generic("Vec", wit_generic_args(t), alias, doc) }
    if t.clone().starts_with("option<") { return wit_render_ark_generic("Option", wit_generic_args(t), alias, doc) }
    if t.clone().starts_with("result<") { return wit_render_ark_generic("Result", wit_generic_args(t), alias, doc) }
    if t.clone().starts_with("tuple<") { return wit_render_ark_generic("Tuple", wit_generic_args(t), alias, doc) }
    if t.clone().starts_with("future<") { return wit_render_ark_generic("Future", wit_generic_args(t), alias, doc) }
    if t.clone().starts_with("stream<") { return wit_render_ark_generic("Stream", wit_generic_args(t), alias, doc) }
    let rec_idx = wit_record_index(rec_wit, t.clone())
    if rec_idx >= 0 { return alias.clone().concat("::".concat(get_unchecked(rec_ark, rec_idx).clone())) }
    let enum_idx = wit_enum_index(enum_wit, t.clone())
    if enum_idx >= 0 { return alias.clone().concat("::".concat(get_unchecked(enum_ark, enum_idx).clone())) }
    let variant_idx = wit_enum_index(variant_wit, t.clone())
    if variant_idx >= 0 { return alias.clone().concat("::".concat(get_unchecked(variant_ark, variant_idx).clone())) }
    let primitive = wit_primitive_to_ark(t.clone())
    if !primitive.clone().eq(t.clone()) { return primitive }
    // Named aliases/resources that are not primitives still need a stable module-qualified
    // binding name. The resolver can refine the symbol kind when a declaration exists.
    alias.clone().concat("::".concat(wit_names_import::wit_record_type_name(t)))
}

fn wit_generic_inner(t: String) -> String {
    let args = wit_generic_args(t)
    if len(args) == 0 { return String_new() }
    get_unchecked(args, 0)
}

fn wit_record_index(names: Vec<String>, wit_name: String) -> i32 {
    for i in 0..len(names) { if get_unchecked(names, i).eq(wit_name.clone()) { return i } }
    0 - 1
}

fn wit_enum_index(names: Vec<String>, wit_name: String) -> i32 {
    for i in 0..len(names) { if get_unchecked(names, i).eq(wit_name.clone()) { return i } }
    0 - 1
}

fn wit_type_is_composite(t: String) -> bool {
    t.clone().starts_with("list<") ||
    t.clone().starts_with("option<") ||
    t.clone().starts_with("result<") ||
    t.clone().starts_with("tuple<") ||
    t.clone().starts_with("future<") ||
    t.clone().starts_with("stream<")
}

fn wit_type_to_valtype(wit_type: String, doc: wit_parse_text::WitParsedInterface) -> String {
    if wit_parse_flags::wit_is_flags_type(wit_trim_type(wit_type)) { return "i32" }
    let t = wit_trim_type(wit_type)
    if wit_type_is_composite(t.clone()) { return "i32" }
    if wit_record_index(wit_record_wit_names(doc), t.clone()) >= 0 { return "i32" }
    if wit_enum_index(wit_enum_wit_names(doc), t.clone()) >= 0 { return "i32" }
    if wit_enum_index(wit_variant_wit_names(doc), t.clone()) >= 0 { return "i32" }
    let ark = wit_primitive_to_ark(wit_type)
    if ark.clone().eq("i64") { return "i64" }
    if ark.clone().eq("f64") { return "f64" }
    if ark.clone().eq("f32") { return "f32" }
    "i32"
}

fn wit_func_type_sig(param_wit_types: Vec<String>, ret_wit_type: String, doc: wit_parse_text::WitParsedInterface) -> String {
    let mut sig = String_new()
    for pi in 0..len(param_wit_types) {
        if pi > 0 { sig = sig.concat("_") }
        sig = sig.concat(wit_type_to_valtype(get_unchecked(param_wit_types, pi), doc))
    }
    let ret = wit_trim_type(ret_wit_type)
    if len(ret) == 0 {
        if len(sig) == 0 { return "0" }
        return sig.concat("_0")
    }
    if len(sig) > 0 { sig = sig.concat("_") }
    sig.concat("1".concat(wit_type_to_valtype(ret, doc)))
}
