use std::prelude::{clone}
use std::text
use resolver::scope_define
use resolver::scope_lookup
fn register_module_export(ctx: ResolveCtx, module_name: String, symbol_name: String, kind: i32, is_pub: bool) {
    let qualified = text::concat(clone(module_name), text::concat("::", clone(symbol_name)))
    if scope_lookup::lookup(ctx, clone(qualified)) >= 0 {
        return
    }
    scope_define::define_impl(ctx, qualified, kind, is_pub, 0, 0)
}
