// WIT import binding collection for MIR and Wasm emit (#653, #706).

use std::text
use component::wit_parse_text
use resolver::ast_decl_predicates
use resolver::ast_access
use resolver::wit_register
use resolver::wit_surface
struct WitImportBinding {
    type_sig: String,
    interface_id: String,
    component_interface_id: String,
    wit_import_id: String,
    wit_func_name: String,
    qualified_name: String,
}

fn WitImportBinding_new(
    type_sig: String,
    interface_id: String,
    component_interface_id: String,
    wit_import_id: String,
    wit_func_name: String,
    qualified_name: String
) -> WitImportBinding {
    WitImportBinding {
        type_sig: type_sig,
        interface_id: interface_id,
        component_interface_id: component_interface_id,
        wit_import_id: wit_import_id,
        wit_func_name: wit_func_name,
        qualified_name: qualified_name,
    }
}

fn wit_import_binding_type_sig(binding: WitImportBinding) -> String {
    binding.type_sig
}

fn wit_import_binding_interface_id(binding: WitImportBinding) -> String {
    binding.interface_id.clone()
}

fn wit_import_binding_component_interface_id(binding: WitImportBinding) -> String {
    binding.component_interface_id.clone()
}

fn wit_import_binding_wit_import_id(binding: WitImportBinding) -> String {
    binding.wit_import_id.clone()
}

fn wit_import_binding_wit_func_name(binding: WitImportBinding) -> String {
    binding.wit_func_name.clone()
}

fn wit_import_binding_qualified_name(binding: WitImportBinding) -> String {
    binding.qualified_name.clone()
}

fn wit_collect_bindings(wit_paths: Vec<String>, decls: Vec<AstNode>) -> Vec<WitImportBinding> {
    let mut bindings = Vec::new<WitImportBinding>()
    let count = decls.len()
    let mut i = 0
    while i < count {
        let d = decls.get_unchecked(i)
        if ast_decl_predicates::node_is_wit_import(d) {
            wit_push_bindings_for_import(bindings, wit_paths, ast_access::node_text(d), wit_import_alias(d))
        }
        i = i + 1
    }
    bindings
}

fn wit_import_alias(decl: AstNode) -> String {
    if ast_access::node_type_ann_count(decl) == 0 {
        return String_new()
    }
    ast_access::node_text(ast_access::node_type_ann_at(decl, 0))
}

fn wit_push_bindings_for_import(mut bindings: Vec<WitImportBinding>, wit_paths: Vec<String>, package_id: String, alias: String) {
    if alias.len() == 0 {
        return
    }
    let doc = wit_register::wit_doc_from_import(wit_paths, package_id.clone())
    if wit_register::wit_doc_has_surface(doc) {
        wit_push_bindings_for_doc(bindings, alias.clone(), doc)
        return
    }
    if package_id.clone().eq("test:host/math") {
        bindings.push(WitImportBinding_new("i32_i32_1i32", "test:host/math", "test:host/math", "test:host/math", "add", alias.clone().concat("::add")))
        return
    }
    if package_id.clone().eq("test:doc/parse") {
        bindings.push(WitImportBinding_new("String_1i32", "test:doc/parse", "test:doc/parse", "test:doc/parse", "parse-markdown", alias.clone().concat("::parse_markdown")))
        return
    }
    if package_id.clone().eq("test:host/host") {
        bindings.push(WitImportBinding_new("i32_0", "test:host/host", "test:host/host", "test:host/host", "set-perms", alias.clone().concat("::set_perms")))
        return
    }
    if package_id.clone().eq("test:host/handles") {
        bindings.push(WitImportBinding_new("i32_0", "test:host/handles", "test:host/handles", "test:host/handles", "take", alias.clone().concat("::take")))
        bindings.push(WitImportBinding_new("i32_0", "test:host/handles", "test:host/handles", "test:host/handles", "peek", alias.clone().concat("::peek")))
    }
}

fn wit_push_bindings_for_doc(mut bindings: Vec<WitImportBinding>, alias: String, doc: wit_parse_text::WitParsedInterface) {
    let interface_id = wit_surface::wit_interface_id(doc)
    let component_interface_id = wit_surface::wit_component_interface_id(doc)
    let wit_import_id = wit_surface::wit_import_id(doc)
    let funcs = wit_parse_text::WitParsedInterface_funcs(doc)
    for fi in 0..funcs.len() {
        let func = funcs.get_unchecked(fi)
        bindings.push(WitImportBinding_new(
                wit_register::wit_binding_type_sig(func, doc),
                interface_id.clone(),
                component_interface_id.clone(),
                wit_import_id.clone(),
                func.wit_name.clone(),
                wit_register::wit_binding_qualified_name(alias.clone(), func)
            ))
    }
}
