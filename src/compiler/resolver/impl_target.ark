use std::text
use corehir::decl_impl_target
use resolver::ast_access
use resolver::ast_decl_predicates
use parser::kinds

// Return the concrete type that owns methods in an impl block.
// The impl binder (`impl<T: Bound> ...`) is metadata after the heads, so a
// trait impl has two head annotations and an inherent impl has one.
fn impl_head_count(decl: AstNode) -> i32 {
    let count = ast_access::node_type_ann_count(decl)
    if count >= 2 &&
    !ast_access::node_kind_is(
        ast_access::node_type_ann_at(decl, 1),
        kinds::NK_IMPL_GENERICS()
    ) {
        return 2
    }
    if count >= 1 {
        return 1
    }
    0
}

fn impl_self_type_name(decl: AstNode, known_type_names: Vec<String>) -> String {
    let heads = impl_head_count(decl)
    let target = if heads >= 2 {
        ast_access::node_type_ann_at(decl, 1)
    } else if heads >= 1 {
        ast_access::node_type_ann_at(decl, 0)
    } else {
        return ast_access::node_text(decl)
    }
    impl_target_type_name(
        target,
        decl_impl_target::effective_impl_param_names(decl, known_type_names)
    )
}

// The resolver's owner keys must use the same declared-type set as the
// typechecker and CoreHIR: a single-uppercase name declared as a nominal type
// is concrete, and only an undeclared one is an ADR-014 window parameter.
fn push_declared_type_name(mut names: Vec<String>, node: AstNode) {
    if ast_decl_predicates::node_is_struct_decl(node) ||
    ast_decl_predicates::node_is_enum_decl(node) ||
    ast_decl_predicates::node_is_resource_decl(node) {
        names.push(ast_access::node_text(node))
    }
}

fn collect_declared_type_names(decls: Vec<AstNode>) -> Vec<String> {
    let mut names = Vec::new<String>()
    let decl_count = decls.len()
    let mut i = 0
    while i < decl_count {
        push_declared_type_name(names, get_unchecked(decls, i))
        i = i + 1
    }
    names
}

// Source-level owner shared by every concrete instantiation of a generic
// target: `impl ... for HashSet<i32>` and `impl ... for HashSet<String>` both
// answer "HashSet". The resolver exports conversion impls under this owner so
// `HashSet::from_iter(...)` has a module member to resolve, while the
// typechecker and lowering select the concrete `HashSet_<arg>` impl from the
// call's source argument.
fn impl_self_base_type_name(decl: AstNode) -> String {
    let heads = impl_head_count(decl)
    if heads >= 2 {
        return ast_access::node_text(ast_access::node_type_ann_at(decl, 1))
    }
    if heads >= 1 {
        return ast_access::node_text(ast_access::node_type_ann_at(decl, 0))
    }
    ast_access::node_text(decl)
}

fn impl_target_type_name(target: AstNode, declared: Vec<String>) -> String {
    let target_name = ast_access::node_text(target)
    if target_name.clone().eq(String_from("Vec")) &&
    ast_access::node_child_count(target) > 1 {
        let element = ast_access::node_child_at(target, 1)
        if ast_access::node_text(element).eq(String_from("String")) {
            return String_from("Vec_String")
        }
    }
    // Concrete HashMap<K, V> impls need a per-pair owner name so each impl
    // method registers a unique HashMap_K_V::method symbol. Generic impl
    // heads (HashMap<K, V> with type params) keep the bare HashMap owner.
    if target_name.clone().eq(String_from("HashMap")) &&
    ast_access::node_child_count(target) > 2 {
        let key_node = ast_access::node_child_at(target, 1)
        let value_node = ast_access::node_child_at(target, 2)
        let key_key = impl_inst_arg_key(key_node, declared.clone())
        let value_key = impl_inst_arg_key(value_node, declared.clone())
        if key_key.len() > 0 && value_key.len() > 0 {
            return String_from("HashMap_").concat(key_key.clone().concat(String_from("_").concat(value_key.clone())))
        }
    }
    // Concrete user-generic impl targets need a per-instantiation owner so
    // each impl method registers a unique Name_arg::method symbol (the same
    // collision rule as HashMap_K_V). Type-parameter args keep the bare
    // owner because the impl itself is generic (impl Pair<T> -> Pair).
    // Vec and HashMap keep their established owner spellings above.
    if ast_access::node_kind_is(target, kinds::NK_TYPE_GENERIC()) &&
    !target_name.clone().eq(String_from("Vec")) &&
    !target_name.clone().eq(String_from("HashMap")) {
        let inst_suffix = impl_inst_arg_suffix(target, declared.clone())
        if inst_suffix.len() > 0 {
            return target_name.clone().concat(String_from("_").concat(inst_suffix))
        }
    }
    target_name
}

fn is_declared_impl_param(name: String, declared: Vec<String>) -> bool {
    let count = declared.len()
    let mut i = 0
    while i < count {
        if get_unchecked(declared, i).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

// Underscore-joined concrete key for the type arguments of a generic impl
// target, or "" when any argument is a type parameter or has no owner-key
// spelling. Children[0] is the head name, so iteration starts at 1.
fn impl_inst_arg_suffix(target: AstNode, declared: Vec<String>) -> String {
    let child_count = ast_access::node_child_count(target)
    if child_count < 2 {
        return String_new()
    }
    let mut suffix = String_new()
    let mut i = 1
    while i < child_count {
        let key = impl_inst_arg_key(
            ast_access::node_child_at(target, i),
            declared.clone()
        )
        if key.len() == 0 {
            return String_new()
        }
        if suffix.len() > 0 {
            suffix = suffix.concat(String_from("_"))
        }
        suffix = suffix.concat(key)
        i = i + 1
    }
    suffix
}

fn impl_inst_arg_key(arg: AstNode, declared: Vec<String>) -> String {
    if ast_access::node_kind_is(arg, kinds::NK_TYPE_NAMED()) {
        let name = ast_access::node_text(arg)
        if is_declared_impl_param(name.clone(), declared) {
            return String_new()
        }
        return name
    }
    if ast_access::node_kind_is(arg, kinds::NK_TYPE_GENERIC()) {
        let base = ast_access::node_text(arg)
        let inner = impl_inst_arg_suffix(arg, declared)
        if inner.len() == 0 {
            return String_new()
        }
        return base.clone().concat(String_from("_").concat(inner))
    }
    if ast_access::node_kind_is(arg, kinds::NK_TYPE_FN()) {
        return String_from("fnref")
    }
    String_new()
}
