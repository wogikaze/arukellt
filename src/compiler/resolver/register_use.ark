use std::prelude::{clone, eq}
use std::text
use resolver::scope_lookup
use resolver::ast_decl_predicates
use resolver::ast_access
use resolver::scope_define
use resolver::paths
use resolver::ctx_record
use resolver::modules
use resolver::expr_path
fn register_use_decl(mut ctx: ResolveCtx, d: AstNode) {
    let use_path = ast_access::node_text(d)
    let existing_use = scope_lookup::lookup(ctx, clone(use_path))
    if existing_use < 0 {
        scope_define::define(ctx, use_path, commands::SYM_IMPORT())
    }
    register_use_module_alias(ctx, d)
    register_use_children(ctx, d)
    register_use_decl_func_alias(ctx, d)
}

fn register_use_decl_func_alias(mut ctx: ResolveCtx, d: AstNode) {
    let use_path = ast_access::node_text(d)
    if ast_access::node_child_count(d) == 0 {
        return
    }
    let child_short = paths::use_module_short_name(clone(use_path))
    register_use_func_alias(ctx, clone(use_path), clone(child_short))
}

fn register_use_module_alias(mut ctx: ResolveCtx, d: AstNode) {
    let full_path = ast_access::node_text(d)
    let default_name = paths::use_module_short_name(clone(full_path))
    let short_name = if ast_access::node_type_ann_count(d) > 0 {
        let alias_node = ast_access::node_type_ann_at(d, 0)
        ast_access::node_text(alias_node)
    } else {
        clone(default_name)
    }
    let existing_mod = scope_lookup::lookup(ctx, clone(short_name))
    let existing_kind = if existing_mod >= 0 {
        scope_lookup::lookup_kind(ctx, clone(short_name))
    } else {
        0 - 1
    }
    if existing_mod < 0 {
        scope_define::define(ctx, clone(short_name), commands::SYM_MODULE())
    }
    if !eq(clone(short_name), clone(default_name)) {
        ctx_record::resolve_ctx_add_use_alias(ctx, clone(short_name), clone(default_name))
    }
    register_type_use_alias(ctx, full_path, clone(short_name), existing_kind)
}

// `use std::io::Reader` binds the imported name as a module symbol so
// qualified paths stay spellable. Map it to the module-qualified form
// (`Reader` -> `io::Reader`) as well, so the resolver can canonicalize an
// associated-function call `Reader::from_bytes` into
// `io::Reader::from_bytes` and resolve it as a module member.
//
// The alias is only registered when the parent path names a loaded module:
// a type-only import does not pull the defining module's exports into the
// program, so canonicalizing without that check would turn a bare module
// name (`io`) into an unresolvable full path (`std::io`). Names that already
// exist as types/functions and builtin type names keep their existing paths.
fn register_type_use_alias(mut ctx: ResolveCtx, full_path: String, short_name: String, existing_kind: i32) {
    if existing_kind >= 0 && existing_kind != commands::SYM_MODULE() {
        return
    }
    if expr_path::is_builtin_type_name(clone(short_name)) {
        return
    }
    let loaded_modules = ctx_record::resolve_ctx_modules(ctx)
    if modules::module_registered(loaded_modules, clone(short_name)) {
        return
    }
    let parent_path = paths::use_module_parent_path(clone(full_path))
    if len(clone(parent_path)) == 0 {
        return
    }
    let parent_short = paths::use_module_short_name(clone(parent_path))
    if len(clone(parent_short)) == 0 {
        return
    }
    if !modules::module_registered(loaded_modules, clone(parent_short)) {
        return
    }
    let target = clone(parent_short).concat("::".concat(clone(short_name)))
    ctx_record::resolve_ctx_add_use_alias(ctx, clone(short_name), target)
}

fn register_local_import_decl(mut ctx: ResolveCtx, d: AstNode) {
    let path = ast_access::node_text(d)
    let default_name = paths::use_module_short_name(clone(path))
    let alias = if ast_access::node_type_ann_count(d) > 0 {
        ast_access::node_text(ast_access::node_type_ann_at(d, 0))
    } else {
        clone(default_name)
    }
    let existing_mod = scope_lookup::lookup(ctx, clone(alias))
    if existing_mod < 0 {
        scope_define::define(ctx, clone(alias), commands::SYM_MODULE())
    }
    if !eq(clone(alias), clone(default_name)) {
        ctx_record::resolve_ctx_add_use_alias(ctx, alias, default_name)
    }
}

fn register_use_children(mut ctx: ResolveCtx, d: AstNode) {
    let num_children = ast_access::node_child_count(d)
    let mut ci = 0
    while ci < num_children {
        let child = ast_access::node_child_at(d, ci)
        if ast_decl_predicates::node_is_use(child) {
            let child_path = ast_access::node_text(child)
            let existing_child = scope_lookup::lookup(ctx, clone(child_path))
            if existing_child < 0 {
                scope_define::define(ctx, clone(child_path), commands::SYM_IMPORT())
            }
            let child_short = paths::use_module_short_name(child_path)
            let existing_child_mod = scope_lookup::lookup(ctx, clone(child_short))
            let existing_child_kind = if existing_child_mod >= 0 {
                scope_lookup::lookup_kind(ctx, clone(child_short))
            } else {
                0 - 1
            }
            if existing_child_mod < 0 {
                scope_define::define(ctx, clone(child_short), commands::SYM_MODULE())
            }
            register_type_use_alias(ctx, clone(child_path), clone(child_short), existing_child_kind)
            register_use_func_alias(ctx, clone(child_path), clone(child_short))
        }
        ci = ci + 1
    }
}

fn register_use_func_alias(mut ctx: ResolveCtx, child_path: String, child_short: String) {
    // A destructure child that names a loaded module ("use std::text::{string}")
    // is already bound as SYM_MODULE; adding "string" -> "text::string" would
    // canonicalize "string::split" into the unresolvable "text::string::split".
    // Function children ("use std::text::string::{split}") still need the alias
    // so bare calls resolve to "string::split".
    if modules::module_registered(ctx_record::resolve_ctx_modules(ctx), clone(child_short)) {
        return
    }
    let parent_path = paths::use_module_parent_path(clone(child_path))
    if len(clone(parent_path)) == 0 {
        return
    }
    let parent_short = paths::use_module_short_name(clone(parent_path))
    if len(clone(parent_short)) == 0 {
        return
    }
    let alias_target = clone(parent_short).concat("::".concat(clone(child_short)))
    ctx_record::resolve_ctx_add_use_alias(ctx, child_short, alias_target)
}
