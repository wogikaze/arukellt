use std::text
use resolver::scope_error
use resolver::scope_lookup
use resolver::ast_decl_predicates
use resolver::ast_access
use resolver::scope_define
use resolver::paths
use resolver::ctx_record
use resolver::modules
use resolver::expr_path
fn register_use_decl(mut ctx: ResolveCtx, d: AstNode) {
    let use_path = ast_access::node_text(d)
    let existing_use = scope_lookup::lookup(ctx, use_path.clone())
    if existing_use < 0 {
        scope_define::define(ctx, use_path, commands::SYM_IMPORT())
    }
    register_use_module_alias(ctx, d)
    register_use_children(ctx, d)
    register_use_decl_func_alias(ctx, d)
    register_use_reject_retired_prelude(ctx, d)
}

// A path import (`use std::prelude::Box_new`, including the flattened form of
// a braced group) can name a retired prelude free. Reject the import instead
// of letting the alias resurrect a declaration that no longer exists.
fn register_use_reject_retired_prelude(ctx: ResolveCtx, d: AstNode) {
    let use_path = ast_access::node_text(d)
    let parent = paths::use_module_parent_path(use_path.clone())
    if !parent.clone().eq("std::prelude") && !parent.clone().eq("prelude") {
        return
    }
    let name = paths::use_module_short_name(use_path)
    // `clone` keeps a private prelude shim and is still imported by compiler
    // modules; only the Box free pair is fully retired here.
    let hint = if name.clone().eq("Box_new") {
        String_from("use `Box::new(value)` instead")
    } else if name.clone().eq("unbox") {
        String_from("use `boxed.take()` instead")
    } else {
        String_new()
    }
    if len(hint) > 0 {
        scope_error::resolve_error(
            ctx,
            String_from("removed prelude free function: ").concat(name.concat("; ".concat(hint)))
        )
    }
}

fn register_use_decl_func_alias(mut ctx: ResolveCtx, d: AstNode) {
    let use_path = ast_access::node_text(d)
    if ast_access::node_child_count(d) == 0 {
        return
    }
    let child_short = paths::use_module_short_name(use_path.clone())
    register_use_func_alias(ctx, use_path.clone(), child_short.clone())
}

fn register_use_module_alias(mut ctx: ResolveCtx, d: AstNode) {
    let full_path = ast_access::node_text(d)
    let default_name = paths::use_module_short_name(full_path.clone())
    let short_name = if ast_access::node_type_ann_count(d) > 0 {
        let alias_node = ast_access::node_type_ann_at(d, 0)
        ast_access::node_text(alias_node)
    } else {
        default_name.clone()
    }
    let existing_mod = scope_lookup::lookup(ctx, short_name.clone())
    let existing_kind = if existing_mod >= 0 {
        scope_lookup::lookup_kind(ctx, short_name.clone())
    } else {
        0 - 1
    }
    if existing_mod < 0 {
        scope_define::define(ctx, short_name.clone(), commands::SYM_MODULE())
    }
    if !short_name.clone().eq(default_name.clone()) {
        ctx_record::resolve_ctx_add_use_alias(ctx, short_name.clone(), default_name.clone())
    }
    register_type_use_alias(ctx, full_path, short_name.clone(), existing_kind)
}

// `use std::io::Reader` binds the imported name as a module symbol so
// qualified paths stay spellable. Map it to the module-qualified form
// (`Reader` -> `io::Reader`) as well, so the resolver can canonicalize an
// associated-function call `Reader::from_bytes` into
// `io::Reader::from_bytes` and resolve it as a module member.
//
// The alias is only registered when the parent path names a loaded module:
// a type-only import does not pull the defining module's exports into the
// program, so canonicalizing without that check would turn a bare module
// name (`io`) into an unresolvable full path (`std::io`). Names that already
// exist as types/functions and builtin type names keep their existing paths.
fn register_type_use_alias(mut ctx: ResolveCtx, full_path: String, short_name: String, existing_kind: i32) {
    if existing_kind >= 0 && existing_kind != commands::SYM_MODULE() {
        return
    }
    if expr_path::is_builtin_type_name(short_name.clone()) {
        return
    }
    let loaded_modules = ctx_record::resolve_ctx_modules(ctx)
    if modules::module_registered(loaded_modules, short_name.clone()) {
        return
    }
    let parent_path = paths::use_module_parent_path(full_path.clone())
    if len(parent_path.clone()) == 0 {
        return
    }
    let parent_short = paths::use_module_short_name(parent_path.clone())
    if len(parent_short.clone()) == 0 {
        return
    }
    if !modules::module_registered(loaded_modules, parent_short.clone()) {
        return
    }
    let target = parent_short.clone().concat("::".concat(short_name.clone()))
    ctx_record::resolve_ctx_add_use_alias(ctx, short_name.clone(), target)
}

fn register_local_import_decl(mut ctx: ResolveCtx, d: AstNode) {
    let path = ast_access::node_text(d)
    let default_name = paths::use_module_short_name(path.clone())
    let alias = if ast_access::node_type_ann_count(d) > 0 {
        ast_access::node_text(ast_access::node_type_ann_at(d, 0))
    } else {
        default_name.clone()
    }
    let existing_mod = scope_lookup::lookup(ctx, alias.clone())
    if existing_mod < 0 {
        scope_define::define(ctx, alias.clone(), commands::SYM_MODULE())
    }
    if !alias.clone().eq(default_name.clone()) {
        ctx_record::resolve_ctx_add_use_alias(ctx, alias, default_name)
    }
}

fn register_use_children(mut ctx: ResolveCtx, d: AstNode) {
    let num_children = ast_access::node_child_count(d)
    let mut ci = 0
    while ci < num_children {
        let child = ast_access::node_child_at(d, ci)
        if ast_decl_predicates::node_is_use(child) {
            let child_path = ast_access::node_text(child)
            let existing_child = scope_lookup::lookup(ctx, child_path.clone())
            if existing_child < 0 {
                scope_define::define(ctx, child_path.clone(), commands::SYM_IMPORT())
            }
            let child_short = paths::use_module_short_name(child_path)
            let existing_child_mod = scope_lookup::lookup(ctx, child_short.clone())
            let existing_child_kind = if existing_child_mod >= 0 {
                scope_lookup::lookup_kind(ctx, child_short.clone())
            } else {
                0 - 1
            }
            if existing_child_mod < 0 {
                scope_define::define(ctx, child_short.clone(), commands::SYM_MODULE())
            }
            register_type_use_alias(ctx, child_path.clone(), child_short.clone(), existing_child_kind)
            register_use_func_alias(ctx, child_path.clone(), child_short.clone())
        }
        ci = ci + 1
    }
}

fn register_use_func_alias(mut ctx: ResolveCtx, child_path: String, child_short: String) {
    // A destructure child that names a loaded module ("use std::text::{string}")
    // is already bound as SYM_MODULE; adding "string" -> "text::string" would
    // canonicalize "string::split" into the unresolvable "text::string::split".
    // Function children ("use std::text::string::{split}") still need the alias
    // so bare calls resolve to "string::split".
    if modules::module_registered(ctx_record::resolve_ctx_modules(ctx), child_short.clone()) {
        return
    }
    let parent_path = paths::use_module_parent_path(child_path.clone())
    if len(parent_path.clone()) == 0 {
        return
    }
    let parent_short = paths::use_module_short_name(parent_path.clone())
    if len(parent_short.clone()) == 0 {
        return
    }
    let alias_target = parent_short.clone().concat("::".concat(child_short.clone()))
    // `clone` stays in the prelude as a private method-resolution shim, but the
    // free itself is retired (ADR-091). The scope resolver would otherwise let
    // an explicit selective import resurrect it; reject the import instead of
    // silently binding a non-public lowering target.
    if child_short.clone().eq("clone") &&
    (parent_short.clone().eq("prelude") || parent_short.clone().eq("std::prelude")) {
        scope_error::resolve_error(
            ctx,
            String_from("removed prelude free function: clone; use `x.clone()` on the value instead")
        )
        return
    }
    ctx_record::resolve_ctx_add_use_alias(ctx, child_short, alias_target)
}
