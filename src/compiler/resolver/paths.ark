use std::prelude::{clone}
fn path_module_part(path: String) -> String {
    let pos = clone(path).index_of("::")
    if pos < 0 {
        return clone(path)
    }
    path.slice(0, pos)
}

fn path_symbol_part(path: String) -> String {
    let pos = clone(path).index_of("::")
    if pos < 0 {
        return String_new()
    }
    path.slice(pos + 2, len(path))
}

fn use_module_short_name(path: String) -> String {
    let n = len(path)
    let mut last_sep = 0 - 1
    let mut i = n - 2
    while i >= 0 {
        if path.byte_at(i) == 58 && path.byte_at(i + 1) == 58 {
            last_sep = i
            break
        }
        i = i - 1
    }
    if last_sep < 0 {
        clone(path)
    } else {
        path.slice(last_sep + 2, n)
    }
}

fn use_module_parent_path(path: String) -> String {
    let n = len(path)
    let mut last_sep = 0 - 1
    let mut i = n - 2
    while i >= 0 {
        if path.byte_at(i) == 58 && path.byte_at(i + 1) == 58 {
            last_sep = i
            break
        }
        i = i - 1
    }
    if last_sep < 0 {
        return String_new()
    }
    path.slice(0, last_sep)
}
