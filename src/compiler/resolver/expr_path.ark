use std::prelude::{clone, eq, index_of}
use std::text
use resolver::scope_lookup
use resolver::ast_access
use resolver::ref_sites
use resolver::scope_error
use resolver::kinds
use resolver::paths
use resolver::modules
use resolver::ctx_record

fn resolve_path(mut ctx: ResolveCtx, mut node: AstNode) {
    let path = ast_access::node_text(node)
    let module_part = paths::path_module_part(clone(path))
    let symbol_part = paths::path_symbol_part(clone(path))
    // When the parser rewrites associated function syntax (String::from →
    // String_from, i32::from → parse_i32), the NK_PATH node text no longer
    // contains "::". Treat it as a simple ident lookup — the prelude function
    // is already in the scope. Vec::new keeps "::" and resolves as builtin
    // associated path (#845).
    if eq(clone(module_part), clone(path)) {
        let idx = scope_lookup::lookup(ctx, clone(path))
        if idx < 0 {
            let alias_target = ctx_record::resolve_ctx_lookup_use_alias(ctx, clone(path))
            if len(clone(alias_target)) > 0 {
                ast_access::set_node_text(node, clone(alias_target))
                resolve_qualified_path(ctx, node, clone(alias_target))
                return
            }
        }
        ref_sites::record_use(ctx, idx, ast_access::node_span_start(node), ast_access::node_span_end(node))
        return
    }
    resolve_qualified_path(ctx, node, clone(path))
}

fn resolve_qualified_path(mut ctx: ResolveCtx, mut node: AstNode, path: String) {
    let module_part = paths::path_module_part(clone(path))
    let symbol_part = paths::path_symbol_part(clone(path))
    let module_alias = ctx_record::resolve_ctx_lookup_use_alias(ctx, clone(module_part))
    if len(clone(module_alias)) > 0 && !eq(clone(module_alias), clone(module_part)) {
        let canonical_path = clone(module_alias).concat("::".concat(clone(symbol_part)))
        ast_access::set_node_text(node, clone(canonical_path))
        resolve_qualified_path(ctx, node, canonical_path)
        return
    }
    // Associated function syntax on builtin types (Vec::new, String::from,
    // i32::from, ...) — the type is not a module, so skip module lookup.
    if is_builtin_type_name(clone(module_part)) {
        reject_unloaded_try_from(ctx, clone(path), clone(symbol_part))
        return
    }

    // Resolution order for `Head::Rest` / `module::Type::Variant`:
    // 1. lexical/module value lookup
    // 2. canonical type lookup (enum type head)
    // 3. enum variant lookup
    // 4. module-qualified function lookup
    // 5. unresolved diagnostic
    let head_idx = scope_lookup::lookup(ctx, clone(module_part))
    let head_kind = if head_idx >= 0 {
        scope_lookup::lookup_kind(ctx, clone(module_part))
    } else {
        0 - 1
    }
    let full_idx = scope_lookup::lookup(ctx, clone(path))
    let full_kind = if full_idx >= 0 {
        scope_lookup::lookup_kind(ctx, clone(path))
    } else {
        0 - 1
    }

    // Enum type as head: `Error::InvalidArgument` (not a module call).
    if head_idx >= 0 && head_kind == commands::SYM_ENUM() {
        if full_idx >= 0 {
            ref_sites::record_use(ctx, full_idx, ast_access::node_span_start(node), ast_access::node_span_end(node))
            return
        }
        scope_error::resolve_error(ctx, String_from("undefined variant: ").concat(clone(path)))
        return
    }

    // Module head: `io::IoError::Other` or `io::io_error_message`.
    if head_idx >= 0 && head_kind == commands::SYM_MODULE() {
        if path_has_nested_qualifier(clone(symbol_part)) {
            if resolve_module_qualified_enum_variant(ctx, node, clone(symbol_part), full_idx, full_kind) {
                return
            }
            if resolve_module_qualified_associated_fn(ctx, node, clone(path), clone(symbol_part), full_idx, full_kind) {
                return
            }
            scope_error::resolve_error(ctx, String_from("undefined variant: ").concat(clone(path)))
            return
        }
        if full_idx >= 0 {
            if full_kind != commands::SYM_VARIANT() {
                if !scope_lookup::lookup_is_pub(ctx, clone(path)) {
                    if !scope_error::resolve_retired_private_member(
                        ctx,
                        clone(module_part),
                        clone(symbol_part),
                        clone(path)
                    ) {
                        scope_error::resolve_error(
                            ctx,
                            String_from("visibility error: `").concat(
                                clone(symbol_part).concat(String_from("` is private and cannot be accessed from module `").concat(clone(module_part).concat(String_from("`"))))
                            )
                        )
                    }
                }
            }
            ref_sites::record_use(ctx, full_idx, ast_access::node_span_start(node), ast_access::node_span_end(node))
        } else {
            scope_error::resolve_unknown_member(ctx, clone(module_part), clone(symbol_part), clone(path))
        }
        return
    }

    // Canonical type lookup when the head is not a lexical module/enum: accept a
    // bound variant path (e.g. imported `Error::Timeout` without a bare type).
    if head_idx < 0 {
        if full_idx >= 0 && full_kind == commands::SYM_VARIANT() {
            ref_sites::record_use(ctx, full_idx, ast_access::node_span_start(node), ast_access::node_span_end(node))
            return
        }
        scope_error::resolve_error(ctx, String_from("undefined module: ").concat(clone(module_part)))
        return
    }

    // A local binding can shadow the module that a type import canonicalized
    // to (`let deque` hides module `deque` inside `Deque::with_capacity`), so
    // the head reaches here as SYM_LOCAL/SYM_PARAM and the module branch above
    // never rewrites the resolved associated function to its source-level
    // `Owner::method` spelling. Rewrite it from the resolved full path instead;
    // the typechecker signature index and MIR lowering key impl methods by that
    // spelling (#710 / #693).
    if (head_kind == commands::SYM_LOCAL() || head_kind == commands::SYM_PARAM()) &&
    path_has_nested_qualifier(clone(symbol_part)) &&
    resolve_module_qualified_associated_fn(ctx, node, clone(path), clone(symbol_part), full_idx, full_kind) {
        return
    }

    // Other bound heads (struct/resource/fn): keep legacy module-qualified
    // function visibility checks when the full path exists.
    if full_idx >= 0 {
        if head_kind != commands::SYM_ENUM() {
            if !scope_lookup::lookup_is_pub(ctx, clone(path)) {
                if !scope_error::resolve_retired_private_member(
                    ctx,
                    clone(module_part),
                    clone(symbol_part),
                    clone(path)
                ) {
                    scope_error::resolve_error(
                        ctx,
                        "visibility error: `".concat(clone(symbol_part).concat("` is private and cannot be accessed from module `".concat(clone(module_part).concat("`"))))
                    )
                }
            }
        }
        ref_sites::record_use(ctx, full_idx, ast_access::node_span_start(node), ast_access::node_span_end(node))
        return
    }
    scope_error::resolve_error(ctx, String_from("undefined module: ").concat(clone(module_part)))
}

fn resolve_module_qualified_enum_variant(
    ctx: ResolveCtx,
    mut node: AstNode,
    symbol_part: String,
    full_idx: i32,
    full_kind: i32
) -> bool {
    // Prefer the fully qualified binding when present (`io::IoError::Other`).
    if full_idx >= 0 && full_kind == commands::SYM_VARIANT() {
        // Rewrite to the enum-local constructor name so MIR variant layouts
        // (`IoError::Other`) match without dedicated runtime Error helpers.
        ast_access::set_node_text(node, clone(symbol_part))
        ref_sites::record_use(ctx, full_idx, ast_access::node_span_start(node), ast_access::node_span_end(node))
        return true
    }
    // Canonical type + variant: `IoError::Other` after stripping the module.
    let bare_idx = scope_lookup::lookup(ctx, clone(symbol_part))
    if bare_idx >= 0 && scope_lookup::lookup_kind(ctx, clone(symbol_part)) == commands::SYM_VARIANT() {
        ast_access::set_node_text(node, clone(symbol_part))
        ref_sites::record_use(ctx, bare_idx, ast_access::node_span_start(node), ast_access::node_span_end(node))
        return true
    }
    false
}

// `module::Type::method` for an associated function exported by that module
// (`io::Reader::from_bytes`). Rewrite to `Type::method`, the mangled impl
// method name that MIR lowering already resolves for same-file associated
// calls, instead of leaving the module prefix on the callee.
fn resolve_module_qualified_associated_fn(
    mut ctx: ResolveCtx,
    mut node: AstNode,
    path: String,
    symbol_part: String,
    full_idx: i32,
    full_kind: i32
) -> bool {
    if full_idx < 0 || full_kind != commands::SYM_FN() {
        return false
    }
    if !scope_lookup::lookup_is_pub(ctx, clone(path)) {
        scope_error::resolve_error(
            ctx,
            String_from("visibility error: `").concat(clone(symbol_part).concat(String_from("` is private and cannot be accessed")))
        )
        return true
    }
    ast_access::set_node_text(node, clone(symbol_part))
    ref_sites::record_use(ctx, full_idx, ast_access::node_span_start(node), ast_access::node_span_end(node))
    true
}

// `i32::try_from` and friends are associated functions provided by
// `std::core::convert`. Without that module the call has no signature and MIR
// emits its silent `drop; unreachable` unresolved-call fallback, so the
// program traps on first use instead of failing to compile. Report the missing
// import here. Impl methods are not bare scope symbols, so the loaded module
// registration is the signal that the `TryFrom` impls are available.
fn reject_unloaded_try_from(ctx: ResolveCtx, path: String, symbol_part: String) {
    if !eq(clone(symbol_part), String_from("try_from")) {
        return
    }
    if modules::module_registered(ctx_record::resolve_ctx_modules(ctx), String_from("convert")) {
        return
    }
    scope_error::resolve_error(
        ctx,
        String_from("undefined associated function `").concat(
            clone(path).concat(String_from("`; add `use std::core::convert` to load the `TryFrom` impls"))
        )
    )
}

fn path_has_nested_qualifier(symbol_part: String) -> bool {
    index_of(clone(symbol_part), String_from("::")) >= 0
}

// Builtin type names that support Type::method / Type::Variant syntax.
// These are not modules, so paths like `Vec::new` or `Result::Ok` must
// bypass module lookup (variants are handled by MIR builtin tags).
//
// `Std` is a prelude-declared namespace type, not a compiler builtin, but it
// has no module of its own either. Listing it here lets `Std::panic` reach the
// signature index the same way `Vec::new` does; the type is still declared in
// `std/prelude.ark` and registered as a stable prelude type (ADR-090).
fn is_builtin_type_name(name: String) -> bool {
    if eq(clone(name), String_from("Vec")) { return true }
    if eq(clone(name), String_from("String")) { return true }
    if eq(clone(name), String_from("Option")) { return true }
    if eq(clone(name), String_from("Result")) { return true }
    if eq(clone(name), String_from("HashMap")) { return true }
    if eq(clone(name), String_from("Std")) { return true }
    if eq(clone(name), String_from("i32")) { return true }
    if eq(clone(name), String_from("i64")) { return true }
    if eq(clone(name), String_from("f64")) { return true }
    if eq(clone(name), String_from("f32")) { return true }
    if eq(clone(name), String_from("bool")) { return true }
    if eq(clone(name), String_from("char")) { return true }
    false
}
