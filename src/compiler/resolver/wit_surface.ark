// WIT import document loading and lookup (#653, #664).

use std::text
use component::wit_parse_import
use component::wit_parse_text
use component::wit_parse_text_scan
use compiler::wit_identity
use resolver::wit_type_map
fn wit_load_interfaces(paths: Vec<String>) -> Vec<wit_parse_text::WitParsedInterface> {
    let mut docs = Vec::new<WitParsedInterface>()
    for i in 0..paths.len() {
        let doc = wit_parse_import::parse_wit_import_file(paths.get_unchecked(i))
        if doc.package.len() > 0 && doc.interface.len() > 0 {
            push(docs, doc)
        }
    }
    docs
}

fn wit_lookup_import(paths: Vec<String>, package_id: String) -> WitParsedInterface {
    return wit_find_interface(wit_load_interfaces(paths), package_id.clone())
}

fn wit_find_interface(docs: Vec<wit_parse_text::WitParsedInterface>, package_id: String) -> WitParsedInterface {
    for i in 0..docs.len() {
        let doc = docs.get_unchecked(i)
        if wit_parse_import::wit_import_id_matches(package_id.clone(), doc) {
            return doc
        }
    }
    wit_parse_text::WitParsedInterface_empty()
}

fn wit_interface_id(doc: wit_parse_text::WitParsedInterface) -> String {
    wit_identity::wit_identifier_path(doc.package.clone(), doc.interface.clone())
}

fn wit_component_interface_id(doc: wit_parse_text::WitParsedInterface) -> String {
    let interface_id = wit_interface_id(doc)
    let version = wit_parse_text::WitParsedInterface_package_version(doc)
    if version.len() == 0 {
        return interface_id
    }
    interface_id.concat("@".concat(wit_parse_text_scan::wit_component_version_txt(version)))
}

fn wit_import_id(doc: wit_parse_text::WitParsedInterface) -> String {
    let version = wit_parse_text::WitParsedInterface_package_version(doc)
    wit_identity::wit_identifier_canonical(
        doc.package.clone(),
        doc.interface.clone(),
        version.clone()
    )
}

fn wit_record_wit_names(doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    wit_type_map::wit_record_wit_names(doc)
}

fn wit_record_ark_names(doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    wit_type_map::wit_record_ark_names(doc)
}

fn wit_enum_wit_names(doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    wit_type_map::wit_enum_wit_names(doc)
}

fn wit_enum_ark_names(doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    wit_type_map::wit_enum_ark_names(doc)
}

fn wit_func_param_ark_types(func: wit_parse_text::WitParsedFunc, alias: String, doc: wit_parse_text::WitParsedInterface) -> Vec<String> {
    let mut out = Vec::new<String>()
    for pi in 0..func.param_wit_types.len() {
        push(out, wit_type_map::wit_type_to_ark(func.param_wit_types.get_unchecked(pi), alias.clone(), doc))
    }
    out
}

fn wit_func_ret_ark_type(func: wit_parse_text::WitParsedFunc, alias: String, doc: wit_parse_text::WitParsedInterface) -> String {
    wit_type_map::wit_type_to_ark(func.ret_wit_type, alias.clone(), doc)
}

fn wit_binding_key(interface_id: String, wit_func_name: String) -> String {
    interface_id.clone().concat("\x1f".concat(wit_func_name.clone()))
}
