use std::prelude::{clone, eq, starts_with, substring}
use std::text
use resolver::scope_lookup
use resolver::scope_stack_scopes
use resolver::scope_stack_symbols
use resolver::prelude_stable
use resolver::ast_decl_predicates
use resolver::ast_access
use resolver::scope_define
use resolver::kinds
use resolver::modules
use resolver::register_exports
use resolver::paths
use resolver::impl_target
use corehir::decl_impl_target
fn register_imported_modules(ctx: ResolveCtx, modules: Vec<ModuleDecls>) {
    let mod_count = len(modules)
    let mut mi = 0
    while mi < mod_count {
        let m = get_unchecked(modules, mi)
        let module_name = modules::module_name(m)
        let existing = scope_lookup::lookup(ctx, clone(module_name))
        if existing < 0 {
            scope_define::define(ctx, module_name, commands::SYM_MODULE())
        }
        register_imported_module_exports(ctx, m)
        mi = mi + 1
    }
    register_pub_use_reexports(ctx, modules)
    register_prelude_bare_names(ctx, modules)
}

fn register_prelude_bare_names(ctx: ResolveCtx, modules: Vec<ModuleDecls>) {
    let mod_count = len(modules)
    let mut mi = 0
    while mi < mod_count {
        let m = get_unchecked(modules, mi)
        let module_name = modules::module_name(m)
        if eq(clone(module_name), "prelude") {
            register_prelude_module_bare_names(ctx, m)
        }
        mi = mi + 1
    }
}

fn register_prelude_module_bare_names(ctx: ResolveCtx, m: ModuleDecls) {
    let mdecl_count = modules::module_decl_count(m)
    let mut di = 0
    while di < mdecl_count {
        let d = modules::module_decl_at(m, di)
        let is_pub = ast_access::node_is_pub(d)
        if is_pub && prelude_stable::is_stable_prelude_name(ast_access::node_text(d)) {
            let symbol_name = ast_access::node_text(d)
            let existing = scope_lookup::lookup(ctx, clone(symbol_name))
            if existing < 0 {
                if ast_decl_predicates::node_is_fn_decl(d) {
                    scope_define::define(ctx, symbol_name, commands::SYM_FN())
                } else {
                    if ast_decl_predicates::node_is_struct_decl(d) {
                        scope_define::define(ctx, symbol_name, commands::SYM_STRUCT())
                    } else {
                        if ast_decl_predicates::node_is_resource_decl(d) {
                            scope_define::define(ctx, symbol_name, commands::SYM_RESOURCE())
                        } else {
                            if ast_decl_predicates::node_is_enum_decl(d) {
                                scope_define::define(ctx, symbol_name, commands::SYM_ENUM())
                            }
                        }
                    }
                }
            }
        }
        di = di + 1
    }
}

fn register_imported_module_exports(ctx: ResolveCtx, m: ModuleDecls) {
    let module_name = modules::module_name(m)
    let mdecl_count = modules::module_decl_count(m)
    let mut di = 0
    while di < mdecl_count {
        let d = modules::module_decl_at(m, di)
        let symbol_name = ast_access::node_text(d)
        let is_pub = ast_access::node_is_pub(d)
        if ast_decl_predicates::node_is_fn_decl(d) {
            register_exports::register_module_export(ctx, clone(module_name), clone(symbol_name), commands::SYM_FN(), is_pub)
        } else {
            if ast_decl_predicates::node_is_struct_decl(d) {
                register_exports::register_module_export(ctx, clone(module_name), clone(symbol_name), commands::SYM_STRUCT(), is_pub)
            } else {
                if ast_decl_predicates::node_is_resource_decl(d) {
                    register_exports::register_module_export(ctx, clone(module_name), clone(symbol_name), commands::SYM_RESOURCE(), is_pub)
                } else {
                    if ast_decl_predicates::node_is_enum_decl(d) {
                        register_imported_enum_exports(ctx, clone(module_name), d, clone(symbol_name), is_pub)
                    } else {
                        if ast_decl_predicates::node_is_impl_decl(d) {
                            register_imported_impl_exports(ctx, m, clone(module_name), d)
                        }
                    }
                }
            }
        }
        di = di + 1
    }
}

// Export the associated functions and methods of an impl block on a public
// type declared by this module. `register_impl_method_headers` already binds
// the mangled `Type::method` name inside the module scope, but module exports
// only covered top-level decls. Without this, `io::Reader::from_bytes` has no
// module member for a cross-module associated call to resolve.
fn register_imported_impl_exports(ctx: ResolveCtx, m: ModuleDecls, module_name: String, impl_decl: AstNode) {
    let type_name = impl_target::impl_self_type_name(impl_decl)
    if len(clone(type_name)) == 0 {
        return
    }
    if !module_declares_pub_type(m, clone(type_name)) {
        return
    }
    let child_count = ast_access::node_child_count(impl_decl)
    let mut ci = 0
    while ci < child_count {
        let method = ast_access::node_child_at(impl_decl, ci)
        if ast_decl_predicates::node_is_fn_decl(method) {
            let mangled = decl_impl_target::impl_method_mangled_name(
                impl_decl,
                ast_access::node_text(method)
            )
            register_exports::register_module_export(
                ctx,
                clone(module_name),
                mangled,
                commands::SYM_FN(),
                true
            )
        }
        ci = ci + 1
    }
}

// Impl methods are only exported when their owner type is a public nominal
// type declared by the same module. Builtin owners (`Vec<T>`, `String`) and
// private helper structs must not leak module-qualified method entries.
fn module_declares_pub_type(m: ModuleDecls, type_name: String) -> bool {
    let mdecl_count = modules::module_decl_count(m)
    let mut di = 0
    while di < mdecl_count {
        let d = modules::module_decl_at(m, di)
        if ast_access::node_is_pub(d) && eq(ast_access::node_text(d), clone(type_name)) {
            if ast_decl_predicates::node_is_struct_decl(d) ||
            ast_decl_predicates::node_is_enum_decl(d) {
                return true
            }
        }
        di = di + 1
    }
    false
}

fn register_imported_enum_exports(ctx: ResolveCtx, module_name: String, enum_decl: AstNode, enum_name: String, is_pub: bool) {
    register_exports::register_module_export(ctx, clone(module_name), clone(enum_name), commands::SYM_ENUM(), is_pub)
    // Bare enum name enables Error::Variant after 'use std::core::error'.
    // Prelude enums outside the v2 stable set keep only the qualified
    // prelude::Name registration; the bare name needs 'use std::prelude::{Name}'.
    if eq(clone(module_name), "prelude") && !prelude_stable::is_stable_prelude_name(clone(enum_name)) {
        register_variants_only(ctx, module_name, enum_decl, enum_name, is_pub)
        return
    }
    let existing_bare = scope_lookup::lookup(ctx, clone(enum_name))
    if existing_bare < 0 {
        scope_define::define_with_vis(ctx, clone(enum_name), commands::SYM_ENUM(), is_pub)
    }
    let child_count = ast_access::node_child_count(enum_decl)
    let mut vi = 0
    while vi < child_count {
        let variant = ast_access::node_child_at(enum_decl, vi)
        let variant_name = ast_access::node_text(variant)
        let bare_variant = text::concat(clone(enum_name), text::concat(String_from("::"), clone(variant_name)))
        let existing_variant = scope_lookup::lookup(ctx, clone(bare_variant))
        if existing_variant < 0 {
            scope_define::define_with_vis(ctx, clone(bare_variant), commands::SYM_VARIANT(), is_pub)
        }
        // `module::Enum::Variant` for fully qualified constructor paths.
        register_exports::register_module_export(ctx, clone(module_name), clone(bare_variant), commands::SYM_VARIANT(), is_pub)
        vi = vi + 1
    }
}

// Variant registration for prelude enums whose bare name is gated out of the
// auto-import set: qualified prelude::Enum::Variant paths stay usable while
// Enum::Variant still resolves once the enum is explicitly imported.
fn register_variants_only(ctx: ResolveCtx, module_name: String, enum_decl: AstNode, enum_name: String, is_pub: bool) {
    let child_count = ast_access::node_child_count(enum_decl)
    let mut vi = 0
    while vi < child_count {
        let variant = ast_access::node_child_at(enum_decl, vi)
        let variant_name = ast_access::node_text(variant)
        let bare_variant = text::concat(clone(enum_name), text::concat(String_from("::"), clone(variant_name)))
        let existing_variant = scope_lookup::lookup(ctx, clone(bare_variant))
        if existing_variant < 0 {
            scope_define::define_with_vis(ctx, clone(bare_variant), commands::SYM_VARIANT(), is_pub)
        }
        register_exports::register_module_export(ctx, clone(module_name), clone(bare_variant), commands::SYM_VARIANT(), is_pub)
        vi = vi + 1
    }
}

// `pub use` chains (a re-export of a re-export) need repeated passes; each
// pass re-applies every pub-use edge and stops at the first pass that defines
// nothing new, bounded by the module count as before. The edges are collected
// once so the passes never re-walk module declarations.
fn register_pub_use_reexports(ctx: ResolveCtx, modules: Vec<ModuleDecls>) {
    let mod_count = len(modules)
    let edge_targets = Vec::new<String>()
    let edge_sources = Vec::new<String>()
    let mut mi = 0
    while mi < mod_count {
        let m = get_unchecked(modules, mi)
        collect_pub_use_edges(m, modules::module_name(m), modules, edge_targets, edge_sources)
        mi = mi + 1
    }
    let edge_count = len(edge_targets)
    let mut pass = 0
    while pass < mod_count {
        let mut defined_any = false
        let mut ei = 0
        while ei < edge_count {
            if reexport_module_symbols(
                ctx,
                clone(get_unchecked(edge_targets, ei)),
                clone(get_unchecked(edge_sources, ei))
            ) {
                defined_any = true
            }
            ei = ei + 1
        }
        if !defined_any {
            return
        }
        pass = pass + 1
    }
}

fn collect_pub_use_edges(m: ModuleDecls, module_name: String, modules: Vec<ModuleDecls>, edge_targets: Vec<String>, edge_sources: Vec<String>) {
    let mdecl_count = modules::module_decl_count(m)
    let mut di = 0
    while di < mdecl_count {
        let d = modules::module_decl_at(m, di)
        di = di + 1
        if !ast_decl_predicates::node_is_use(d) || !ast_access::node_is_pub(d) {
            continue
        }
        push(edge_targets, clone(module_name))
        push(edge_sources, pub_use_source_key(ast_access::node_text(d), modules))
        let child_count = ast_access::node_child_count(d)
        let mut ci = 0
        while ci < child_count {
            let child = ast_access::node_child_at(d, ci)
            if ast_decl_predicates::node_is_use(child) {
                push(edge_targets, clone(module_name))
                push(edge_sources, pub_use_source_key(ast_access::node_text(child), modules))
            }
            ci = ci + 1
        }
    }
}

// "pub use" paths are written in use-path form (std::json::parser,
// outer::inner, pkg::sub::sym) while module members register under the
// module's short name (parser::json_get, inner::helper). Map the written
// path onto the registered module key before collecting the edge: a trailing
// segment that names a loaded module re-exports that module's members, and
// otherwise the parent module's member is selected. Unknown shapes fall back
// to the written path so two-segment module::member sources keep working.
fn pub_use_source_key(source: String, modules: Vec<ModuleDecls>) -> String {
    let leaf = paths::use_module_short_name(clone(source))
    if modules::module_registered(modules, clone(leaf)) {
        return leaf
    }
    let parent = paths::use_module_parent_path(clone(source))
    if len(clone(parent)) == 0 {
        return clone(source)
    }
    let parent_leaf = paths::use_module_short_name(parent)
    if !modules::module_registered(modules, clone(parent_leaf)) {
        return clone(source)
    }
    text::concat(parent_leaf, text::concat("::", leaf))
}

// True when at least one new qualified symbol was defined.
fn reexport_module_symbols(ctx: ResolveCtx, target_module: String, source_module: String) -> bool {
    let source_root = paths::path_module_part(clone(source_module))
    let selected_symbol = paths::path_symbol_part(clone(source_module))
    let module_prefix = text::concat(clone(source_root), "::")
    let module_prefix_len = len(clone(module_prefix))
    let selected_prefix = text::concat(clone(source_module), "::")
    let scope = scope_stack_scopes::ResolveCtx_scope_at(ctx, 0)
    let sym_count = scope_stack_scopes::Scope_symbol_count(scope)
    let mut defined_any = false
    let mut i = 0
    while i < sym_count {
        let sym = scope_stack_scopes::Scope_symbol_at(scope, i)
        let sym_name = scope_stack_symbols::Symbol_name(sym)
        let matches_source = if len(clone(selected_symbol)) == 0 {
            starts_with(clone(sym_name), clone(module_prefix))
        } else {
            eq(clone(sym_name), clone(source_module)) || starts_with(clone(sym_name), clone(selected_prefix))
        }
        if matches_source && scope_stack_symbols::Symbol_is_pub(sym) {
            let suffix = substring(clone(sym_name), module_prefix_len, len(clone(sym_name)))
            let qualified = text::concat(clone(target_module), text::concat("::", clone(suffix)))
            let existing = scope_lookup::lookup(ctx, clone(qualified))
            if existing < 0 {
                let kind = scope_stack_symbols::Symbol_kind(sym)
                scope_define::define_with_vis(ctx, qualified, kind, true)
                defined_any = true
            }
        }
        i = i + 1
    }
    defined_any
}
