use std::text
use resolver::ctx_record
use resolver::scope_lookup
use resolver::scope_stack_scopes
use resolver::scope_stack_symbols
use resolver::prelude_stable
use resolver::ast_decl_predicates
use resolver::ast_access
use resolver::scope_define
use resolver::kinds
use resolver::modules
use resolver::register_exports
use resolver::paths
use resolver::impl_target
use corehir::decl_impl_target
fn register_imported_modules(mut ctx: ResolveCtx, modules: Vec<ModuleDecls>) {
    let mod_count = modules.len()
    let mut mi = 0
    while mi < mod_count {
        let m = modules.get_unchecked(mi)
        let module_name = modules::module_name(m)
        let existing = scope_lookup::lookup(ctx, module_name.clone())
        if existing < 0 {
            scope_define::define(ctx, module_name, commands::SYM_MODULE())
        }
        register_imported_module_exports(ctx, m)
        mi = mi + 1
    }
    register_pub_use_reexports(ctx, modules)
    register_prelude_bare_names(ctx, modules)
}

fn register_prelude_bare_names(mut ctx: ResolveCtx, modules: Vec<ModuleDecls>) {
    let mod_count = modules.len()
    let mut mi = 0
    while mi < mod_count {
        let m = modules.get_unchecked(mi)
        let module_name = modules::module_name(m)
        if module_name.clone().eq("prelude") {
            register_prelude_module_bare_names(ctx, m)
        }
        mi = mi + 1
    }
}

fn register_prelude_module_bare_names(mut ctx: ResolveCtx, m: ModuleDecls) {
    let mdecl_count = modules::module_decl_count(m)
    let mut di = 0
    while di < mdecl_count {
        let d = modules::module_decl_at(m, di)
        let is_pub = ast_access::node_is_pub(d)
        if is_pub && prelude_stable::is_stable_prelude_name(ast_access::node_text(d)) {
            let symbol_name = ast_access::node_text(d)
            let existing = scope_lookup::lookup(ctx, symbol_name.clone())
            if existing < 0 {
                if ast_decl_predicates::node_is_fn_decl(d) {
                    scope_define::define(ctx, symbol_name, commands::SYM_FN())
                } else {
                    if ast_decl_predicates::node_is_struct_decl(d) {
                        scope_define::define(ctx, symbol_name, commands::SYM_STRUCT())
                    } else {
                        if ast_decl_predicates::node_is_resource_decl(d) {
                            scope_define::define(ctx, symbol_name, commands::SYM_RESOURCE())
                        } else {
                            if ast_decl_predicates::node_is_enum_decl(d) {
                                scope_define::define(ctx, symbol_name, commands::SYM_ENUM())
                            }
                        }
                    }
                }
            }
        }
        di = di + 1
    }
}

fn register_imported_module_exports(mut ctx: ResolveCtx, m: ModuleDecls) {
    let module_name = modules::module_name(m)
    let mdecl_count = modules::module_decl_count(m)
    let mut di = 0
    while di < mdecl_count {
        let d = modules::module_decl_at(m, di)
        let symbol_name = ast_access::node_text(d)
        let is_pub = ast_access::node_is_pub(d)
        if ast_decl_predicates::node_is_fn_decl(d) {
            register_exports::register_module_export(ctx, module_name.clone(), symbol_name.clone(), commands::SYM_FN(), is_pub)
        } else {
            if ast_decl_predicates::node_is_struct_decl(d) {
                register_exports::register_module_export(ctx, module_name.clone(), symbol_name.clone(), commands::SYM_STRUCT(), is_pub)
            } else {
                if ast_decl_predicates::node_is_resource_decl(d) {
                    register_exports::register_module_export(ctx, module_name.clone(), symbol_name.clone(), commands::SYM_RESOURCE(), is_pub)
                } else {
                    if ast_decl_predicates::node_is_enum_decl(d) {
                        register_imported_enum_exports(ctx, module_name.clone(), d, symbol_name.clone(), is_pub)
                    } else {
                        if ast_decl_predicates::node_is_impl_decl(d) {
                            register_imported_impl_exports(ctx, m, module_name.clone(), d)
                        }
                    }
                }
            }
        }
        di = di + 1
    }
}

// Export the associated functions and methods of an impl block on a public
// type declared by this module. `register_impl_method_headers` already binds
// the mangled `Type::method` name inside the module scope, but module exports
// only covered top-level decls. Without this, `io::Reader::from_bytes` has no
// module member for a cross-module associated call to resolve.
fn register_imported_impl_exports(mut ctx: ResolveCtx, m: ModuleDecls, module_name: String, impl_decl: AstNode) {
    let known_type_names = ctx_record::resolve_ctx_declared_type_names(ctx)
    let type_name = impl_target::impl_self_type_name(impl_decl, known_type_names.clone())
    let base_name = impl_target::impl_self_base_type_name(impl_decl)
    if type_name.clone().len() == 0 || base_name.clone().len() == 0 {
        return
    }
    let declares_type = module_declares_pub_type(m, type_name.clone())
    let declares_base = module_declares_pub_type(m, base_name.clone())
    if !declares_type && !declares_base {
        return
    }
    let has_trait = impl_target::impl_head_count(impl_decl) >= 2
    // A concrete FromIterator impl registers under the per-source owner
    // (`HashSet_i32::from_iter__VecIter_i32`), which is not a source-level
    // spelling. Export an additional `Type::from_iter` member on the declared
    // base type so `HashSet::from_iter(...)` resolves; the concrete impl is
    // selected later from the call's source argument. The first concrete
    // family claims the alias; the selection stays argument-directed.
    let is_from_iterator = has_trait &&
    ast_access::node_text(impl_decl).eq(String_from("FromIterator"))
    let register_base_alias = is_from_iterator && !base_name.clone().eq(type_name.clone())
    let child_count = ast_access::node_child_count(impl_decl)
    let mut ci = 0
    while ci < child_count {
        let method = ast_access::node_child_at(impl_decl, ci)
        if ast_decl_predicates::node_is_fn_decl(method) {
            if declares_type {
                let mangled = decl_impl_target::impl_method_mangled_name(
                    impl_decl,
                    ast_access::node_text(method),
                    known_type_names.clone()
                )
                register_exports::register_module_export(
                    ctx,
                    module_name.clone(),
                    mangled,
                    commands::SYM_FN(),
                    true
                )
            }
            if register_base_alias {
                register_exports::register_module_export(
                    ctx,
                    module_name.clone(),
                    base_name.clone().concat(String_from("::".concat(ast_access::node_text(method)))),
                    commands::SYM_FN(),
                    true
                )
            }
        }
        ci = ci + 1
    }
}

// Impl methods are only exported when their owner type is a public nominal
// type declared by the same module. Builtin owners (`Vec<T>`, `String`) and
// private helper structs must not leak module-qualified method entries.
fn module_declares_pub_type(m: ModuleDecls, type_name: String) -> bool {
    let mdecl_count = modules::module_decl_count(m)
    let mut di = 0
    while di < mdecl_count {
        let d = modules::module_decl_at(m, di)
        if ast_access::node_is_pub(d) && ast_access::node_text(d).eq(type_name.clone()) {
            if ast_decl_predicates::node_is_struct_decl(d) ||
            ast_decl_predicates::node_is_enum_decl(d) {
                return true
            }
        }
        di = di + 1
    }
    false
}

fn register_imported_enum_exports(mut ctx: ResolveCtx, module_name: String, enum_decl: AstNode, enum_name: String, is_pub: bool) {
    register_exports::register_module_export(ctx, module_name.clone(), enum_name.clone(), commands::SYM_ENUM(), is_pub)
    // Bare enum name enables Error::Variant after 'use std::core::error'.
    // Prelude enums outside the v2 stable set keep only the qualified
    // prelude::Name registration; the bare name needs 'use std::prelude::{Name}'.
    if module_name.clone().eq("prelude") && !prelude_stable::is_stable_prelude_name(enum_name.clone()) {
        register_variants_only(ctx, module_name, enum_decl, enum_name, is_pub)
        return
    }
    let existing_bare = scope_lookup::lookup(ctx, enum_name.clone())
    if existing_bare < 0 {
        scope_define::define_with_vis(ctx, enum_name.clone(), commands::SYM_ENUM(), is_pub)
    }
    let child_count = ast_access::node_child_count(enum_decl)
    let mut vi = 0
    while vi < child_count {
        let variant = ast_access::node_child_at(enum_decl, vi)
        let variant_name = ast_access::node_text(variant)
        let bare_variant = enum_name.clone().concat(String_from("::").concat(variant_name.clone()))
        let existing_variant = scope_lookup::lookup(ctx, bare_variant.clone())
        if existing_variant < 0 {
            scope_define::define_with_vis(ctx, bare_variant.clone(), commands::SYM_VARIANT(), is_pub)
        }
        // `module::Enum::Variant` for fully qualified constructor paths.
        register_exports::register_module_export(ctx, module_name.clone(), bare_variant.clone(), commands::SYM_VARIANT(), is_pub)
        vi = vi + 1
    }
}

// Variant registration for prelude enums whose bare name is gated out of the
// auto-import set: qualified prelude::Enum::Variant paths stay usable while
// Enum::Variant still resolves once the enum is explicitly imported.
fn register_variants_only(mut ctx: ResolveCtx, module_name: String, enum_decl: AstNode, enum_name: String, is_pub: bool) {
    let child_count = ast_access::node_child_count(enum_decl)
    let mut vi = 0
    while vi < child_count {
        let variant = ast_access::node_child_at(enum_decl, vi)
        let variant_name = ast_access::node_text(variant)
        let bare_variant = enum_name.clone().concat(String_from("::").concat(variant_name.clone()))
        let existing_variant = scope_lookup::lookup(ctx, bare_variant.clone())
        if existing_variant < 0 {
            scope_define::define_with_vis(ctx, bare_variant.clone(), commands::SYM_VARIANT(), is_pub)
        }
        register_exports::register_module_export(ctx, module_name.clone(), bare_variant.clone(), commands::SYM_VARIANT(), is_pub)
        vi = vi + 1
    }
}

// `pub use` chains (a re-export of a re-export) need repeated passes; each
// pass re-applies every pub-use edge and stops at the first pass that defines
// nothing new, bounded by the module count as before. The edges are collected
// once so the passes never re-walk module declarations.
fn register_pub_use_reexports(mut ctx: ResolveCtx, modules: Vec<ModuleDecls>) {
    let mod_count = modules.len()
    let mut edge_targets = Vec::new<String>()
    let mut edge_sources = Vec::new<String>()
    let mut mi = 0
    while mi < mod_count {
        let m = modules.get_unchecked(mi)
        collect_pub_use_edges(m, modules::module_name(m), modules, edge_targets, edge_sources)
        mi = mi + 1
    }
    let edge_count = edge_targets.len()
    let mut pass = 0
    while pass < mod_count {
        let mut defined_any = false
        let mut ei = 0
        while ei < edge_count {
            if reexport_module_symbols(
                ctx,
                edge_targets.get_unchecked(ei).clone(),
                edge_sources.get_unchecked(ei).clone()
            ) {
                defined_any = true
            }
            ei = ei + 1
        }
        if !defined_any {
            return
        }
        pass = pass + 1
    }
}

fn collect_pub_use_edges(m: ModuleDecls, module_name: String, modules: Vec<ModuleDecls>, mut edge_targets: Vec<String>, mut edge_sources: Vec<String>) {
    let mdecl_count = modules::module_decl_count(m)
    let mut di = 0
    while di < mdecl_count {
        let d = modules::module_decl_at(m, di)
        di = di + 1
        if !ast_decl_predicates::node_is_use(d) || !ast_access::node_is_pub(d) {
            continue
        }
        edge_targets.push(module_name.clone())
        edge_sources.push(modules::reexport_source_key(ast_access::node_text(d), modules))
        let child_count = ast_access::node_child_count(d)
        let mut ci = 0
        while ci < child_count {
            let child = ast_access::node_child_at(d, ci)
            if ast_decl_predicates::node_is_use(child) {
                edge_targets.push(module_name.clone())
                edge_sources.push(modules::reexport_source_key(ast_access::node_text(child), modules))
            }
            ci = ci + 1
        }
    }
}

// True when at least one new qualified symbol was defined.
fn reexport_module_symbols(mut ctx: ResolveCtx, target_module: String, source_module: String) -> bool {
    let source_root = paths::path_module_part(source_module.clone())
    let selected_symbol = paths::path_symbol_part(source_module.clone())
    let module_prefix = source_root.clone().concat("::")
    let module_prefix_len = module_prefix.clone().len()
    let selected_prefix = source_module.clone().concat("::")
    let scope = scope_stack_scopes::ResolveCtx_scope_at(ctx, 0)
    let sym_count = scope_stack_scopes::Scope_symbol_count(scope)
    let mut defined_any = false
    let mut i = 0
    while i < sym_count {
        let sym = scope_stack_scopes::Scope_symbol_at(scope, i)
        let sym_name = scope_stack_symbols::Symbol_name(sym)
        let matches_source = if selected_symbol.clone().len() == 0 {
            sym_name.clone().starts_with(module_prefix.clone())
        } else {
            sym_name.clone().eq(source_module.clone()) || sym_name.clone().starts_with(selected_prefix.clone())
        }
        if matches_source && scope_stack_symbols::Symbol_is_pub(sym) {
            let suffix = sym_name.clone().slice(module_prefix_len, sym_name.clone().len())
            let qualified = target_module.clone().concat("::".concat(suffix.clone()))
            let existing = scope_lookup::lookup(ctx, qualified.clone())
            if existing < 0 {
                let kind = scope_stack_symbols::Symbol_kind(sym)
                scope_define::define_with_vis(ctx, qualified, kind, true)
                defined_any = true
            }
        }
        i = i + 1
    }
    defined_any
}
