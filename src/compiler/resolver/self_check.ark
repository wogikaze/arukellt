use std::host::stdio::Stdio
use std::text
use lexer::scan
use parser::core_api_token
use parser::decl
use resolver::context
use resolver::program
fn parse_decls(src: String) -> Vec<AstNode> {
    let tokens = scan::tokenize(src)
    let mut p = core_api_token::Parser_new(tokens)
    let decls = decl::parse_module(p)
    if len(p.errors) != 0 {
        Stdio::println("Resolver parse errors: ".concat(len(p.errors).to_string()))
    }
    decls
}

fn main() {
    let decls = parse_decls("fn main() { let x = 1 }")
    let ctx = program::resolve_program(decls, Vec::new<ModuleDecls>(), Vec::new<String>())
    let error_count = context::ResolveCtx_reported_error_count(ctx)
    if error_count != 0 {
        Stdio::println("Resolver errors: ".concat(error_count.to_string()))
        return
    }
    Stdio::println("Resolver OK.")
}
