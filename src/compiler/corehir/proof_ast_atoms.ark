use corehir::frontend_ast_node
use corehir::frontend_kind_map
use corehir::proof_json_escape

fn render_proof_atom(node: AstNode, kind: i32) -> String {
    if kind == frontend_kind_map::nk_ident() {
        return concat(
            String_from("(ident "),
            concat(
                proof_json_escape::quote_json(
                    frontend_ast_node::corehir_node_text(node)
                ),
                String_from(")")
            )
        )
    }
    if kind == frontend_kind_map::nk_path() {
        return concat(
            String_from("(path "),
            concat(
                proof_json_escape::quote_json(
                    frontend_ast_node::corehir_node_text(node)
                ),
                String_from(")")
            )
        )
    }
    if kind == frontend_kind_map::nk_int_lit() {
        return concat(
            String_from("(int "),
            concat(
                to_string(frontend_ast_node::corehir_node_int_val(node)),
                String_from(")")
            )
        )
    }
    if kind == frontend_kind_map::nk_float_lit() {
        return concat(
            String_from("(float "),
            concat(
                to_string(frontend_ast_node::corehir_node_float_val(node)),
                String_from(")")
            )
        )
    }
    if kind == frontend_kind_map::nk_string_lit() {
        return concat(
            String_from("(string "),
            concat(
                proof_json_escape::quote_json(
                    frontend_ast_node::corehir_node_text(node)
                ),
                String_from(")")
            )
        )
    }
    if kind == frontend_kind_map::nk_bool_lit() {
        let value = if frontend_ast_node::corehir_node_int_val(node) == 0 {
            String_from("false")
        } else {
            String_from("true")
        }
        return concat(
            String_from("(bool "),
            concat(value, String_from(")"))
        )
    }
    if kind == frontend_kind_map::nk_char_lit() {
        return concat(
            String_from("(char "),
            concat(
                to_string(frontend_ast_node::corehir_node_int_val(node)),
                String_from(")")
            )
        )
    }
    String_new()
}
