use corehir::frontend_ast_children
use corehir::frontend_ast_identity
use corehir::frontend_type_kind

fn type_ann_name(node: AstNode) -> String {
    frontend_ast_identity::corehir_node_text(node)
}

fn type_ann_child_count(node: AstNode) -> i32 {
    frontend_ast_children::corehir_node_child_count(node)
}

fn type_ann_child_at(node: AstNode, idx: i32) -> AstNode {
    frontend_ast_children::corehir_node_child_at(node, idx)
}

fn type_ann_return_count(node: AstNode) -> i32 {
    len(node.type_ann)
}

fn type_ann_return_at(node: AstNode, idx: i32) -> AstNode {
    get_unchecked(node.type_ann, idx)
}

// Keep the two reference-bearing callback shapes used by item-preserving
// iterator adapters distinct from the legacy scalar callback marker. The
// marker is deliberately atomic because function-signature segments use `_`
// as their separator.
fn type_ann_function_ref_name(node: AstNode) -> String {
    if !frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(node)) {
        return String_new()
    }
    if type_ann_child_count(node) == 1 && type_ann_return_count(node) == 1 {
        let param = type_ann_child_at(node, 0)
        let result = type_ann_return_at(node, 0)
        let param_name = type_ann_name(param)
        let result_name = type_ann_name(result)
        let param_is_string = eq(clone(param_name), String_from("String")) ||
        eq(clone(param_name), String_from("string"))
        let result_is_string = eq(clone(result_name), String_from("String")) ||
        eq(clone(result_name), String_from("string"))
        if param_is_string && result_is_string {
            return String_from("fnrefss")
        }
        if param_is_string && eq(clone(result_name), String_from("bool")) {
            return String_from("fnrefsb")
        }
        // Scalar-to-scalar callbacks keep the legacy `fnref` bucket so
        // existing map/filter layouts are unchanged. Every other unary
        // signature carries its segment spellings so monomorphized fields
        // such as `fn(T) -> U` substitute to a concrete callback ABI
        // (fnsig:<param>;<return>, #860/#691).
        if fn_sig_segment_is_i32_family(clone(param_name)) &&
        fn_sig_segment_is_i32_family(clone(result_name)) {
            return String_from("fnref")
        }
        return concat(
            String_from("fnsig:"),
            concat(
                fn_sig_segment_name(param),
                concat(String_from(";"), fn_sig_segment_name(result))
            )
        )
    }
    if type_ann_child_count(node) >= 2 {
        return String_from("fnref2")
    }
    String_from("fnref")
}

// Scalar type names whose Wasm ABI is a single i32 (widened to i64 under
// Memory64). These stay on the legacy `fnref` bucket; everything else
// needs an explicit fnsig segment so GC emission can pick the real func
// type.
fn fn_sig_segment_is_i32_family(name: String) -> bool {
    eq(clone(name), String_from("i32")) ||
    eq(clone(name), String_from("I32")) ||
    eq(clone(name), String_from("bool")) ||
    eq(clone(name), String_from("Bool")) ||
    eq(clone(name), String_from("char")) ||
    eq(clone(name), String_from("u8")) ||
    eq(clone(name), String_from("i8")) ||
    eq(clone(name), String_from("u16")) ||
    eq(clone(name), String_from("i16")) ||
    eq(clone(name), String_from("u32"))
}

// Canonical field-type spelling for one fnsig segment. Mirrors
// decl_layout_type_name's container spellings (vec:/option:/result:/
// Name<args>) so token substitution in ctx_substitute_generic_field_type
// turns `fn(Vec<T>) -> U` into `fnsig:vec:i32;i32`. Nested fn types stay
// opaque `fnref` — one callback level is all the GC emitter resolves.
fn fn_sig_segment_name(node: AstNode) -> String {
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(node)) {
        return String_from("fnref")
    }
    if type_ann_is_generic(node) {
        let seg_name = type_ann_name(node)
        if eq(clone(seg_name), String_from("Vec")) && type_ann_child_count(node) >= 2 {
            return concat(
                String_from("vec:"),
                fn_sig_segment_name(type_ann_child_at(node, 1))
            )
        }
        if eq(clone(seg_name), String_from("Option")) && type_ann_child_count(node) >= 2 {
            return concat(
                String_from("option:"),
                fn_sig_segment_name(type_ann_child_at(node, 1))
            )
        }
        if eq(clone(seg_name), String_from("Result")) && type_ann_child_count(node) >= 3 {
            return concat(
                String_from("result:"),
                concat(
                    fn_sig_segment_name(type_ann_child_at(node, 1)),
                    concat(String_from(":"), fn_sig_segment_name(type_ann_child_at(node, 2)))
                )
            )
        }
        if type_ann_child_count(node) >= 2 {
            let mut out = concat(clone(seg_name), String_from("<"))
            let mut gi = 1
            while gi < type_ann_child_count(node) {
                if gi > 1 {
                    out = concat(out, String_from(","))
                }
                out = concat(out, fn_sig_segment_name(type_ann_child_at(node, gi)))
                gi = gi + 1
            }
            return concat(out, String_from(">"))
        }
        return seg_name
    }
    if type_ann_is_tuple(node) && type_ann_child_count(node) == 2 {
        return concat(
            String_from("Tuple:"),
            concat(
                fn_sig_segment_name(type_ann_child_at(node, 0)),
                concat(String_from(":"), fn_sig_segment_name(type_ann_child_at(node, 1)))
            )
        )
    }
    type_ann_name(node)
}

fn type_ann_is_named(node: AstNode) -> bool {
    frontend_type_kind::corehir_kind_is_type_named(frontend_ast_identity::corehir_node_kind(node))
}

// True when the annotation is exactly `fn(i32) -> i32` — the only callback
// shape the HashMap storage adapters support (#691).
fn type_ann_is_i32_i32_fn(node: AstNode) -> bool {
    if !frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(node)) {
        return false
    }
    if type_ann_child_count(node) != 1 || type_ann_return_count(node) != 1 {
        return false
    }
    let param_name = type_ann_name(type_ann_child_at(node, 0))
    let result_name = type_ann_name(type_ann_return_at(node, 0))
    eq(param_name, String_from("i32")) && eq(result_name, String_from("i32"))
}

fn type_ann_is_generic(node: AstNode) -> bool {
    frontend_type_kind::corehir_kind_is_type_generic(frontend_ast_identity::corehir_node_kind(node))
}

fn type_ann_is_tuple(node: AstNode) -> bool {
    frontend_type_kind::corehir_kind_is_type_tuple(frontend_ast_identity::corehir_node_kind(node))
}

fn type_ann_is_name(node: AstNode, expected: String) -> bool {
    eq(type_ann_name(node), expected)
}
