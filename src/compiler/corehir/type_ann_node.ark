use std::text
use corehir::frontend_ast_children
use corehir::frontend_ast_identity
use corehir::frontend_type_kind
fn type_ann_name(node: AstNode) -> String {
    frontend_ast_identity::corehir_node_text(node)
}

fn type_ann_child_count(node: AstNode) -> i32 {
    frontend_ast_children::corehir_node_child_count(node)
}

fn type_ann_child_at(node: AstNode, idx: i32) -> AstNode {
    frontend_ast_children::corehir_node_child_at(node, idx)
}

fn type_ann_return_count(node: AstNode) -> i32 {
    len(node.type_ann)
}

fn type_ann_return_at(node: AstNode, idx: i32) -> AstNode {
    get_unchecked(node.type_ann, idx)
}

// Keep the two reference-bearing callback shapes used by item-preserving
// iterator adapters distinct from the legacy scalar callback marker. The
// marker is deliberately atomic because function-signature segments use `_`
// as their separator.
fn type_ann_function_ref_name(node: AstNode) -> String {
    if !frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(node)) {
        return String_new()
    }
    if type_ann_child_count(node) == 1 && type_ann_return_count(node) == 1 {
        let param = type_ann_child_at(node, 0)
        let result = type_ann_return_at(node, 0)
        let param_name = type_ann_name(param)
        let result_name = type_ann_name(result)
        let param_is_string = param_name.clone().eq(String_from("String")) ||
        param_name.clone().eq(String_from("string"))
        let result_is_string = result_name.clone().eq(String_from("String")) ||
        result_name.clone().eq(String_from("string"))
        if param_is_string && result_is_string {
            return String_from("fnrefss")
        }
        if param_is_string && result_name.clone().eq(String_from("bool")) {
            return String_from("fnrefsb")
        }
        // Scalar-to-scalar callbacks keep the legacy `fnref` bucket so
        // existing map/filter layouts are unchanged. Every other unary
        // signature carries its segment spellings so monomorphized fields
        // such as `fn(T) -> U` substitute to a concrete callback ABI
        // (fnsig:<param>;<return>, #860/#691).
        if fn_sig_segment_is_i32_family(param_name.clone()) &&
        fn_sig_segment_is_i32_family(result_name.clone()) {
            return String_from("fnref")
        }
        return String_from("fnsig:").concat(fn_sig_segment_name(param).concat(String_from(";").concat(fn_sig_segment_name(result))))
    }
    if type_ann_child_count(node) >= 2 {
        // Two-or-more-param callbacks keep the legacy fnref2 bucket while the
        // return is i32-family so fold/map signatures are unchanged. A named
        // non-scalar return needs the fnsig spelling so an indirect call's
        // dest local carries the real type; fnref2 drops it, which made
        // call_ref results land in i64 locals on GC (#874/#881).
        if type_ann_return_count(node) == 1 {
            let result_name = fn_sig_segment_name(type_ann_return_at(node, 0))
            if len(result_name) > 0 && !fn_sig_segment_is_i32_family(result_name.clone()) {
                let mut params = String_new()
                let mut pi = 0
                while pi < type_ann_child_count(node) {
                    if pi > 0 {
                        params = params.concat(String_from(","))
                    }
                    params = params.concat(fn_sig_segment_name(type_ann_child_at(node, pi)))
                    pi = pi + 1
                }
                return String_from("fnsig:").concat(params.clone().concat(String_from(";").concat(result_name)))
            }
        }
        return String_from("fnref2")
    }
    if type_ann_child_count(node) == 0 && type_ann_return_count(node) == 1 {
        // Zero-param fn values keep the legacy `fnref` bucket for scalar
        // returns, mirroring the closure spelling rule in
        // closure_funcref_type_name. A named non-scalar return needs the
        // `fnsig:;<ret>` spelling so an indirect call dest local carries
        // the ref type instead of collapsing to the scalar bucket (#872).
        let ret_seg_zero = fn_sig_segment_name(type_ann_return_at(node, 0))
        if len(ret_seg_zero) == 0 || fn_sig_segment_is_i32_family(ret_seg_zero.clone()) {
            return String_from("fnref")
        }
        return String_from("fnsig:;").concat(ret_seg_zero)
    }
    String_from("fnref")
}

// Scalar type names whose Wasm ABI is a single i32 (widened to i64 under
// Memory64). These stay on the legacy `fnref` bucket; everything else
// needs an explicit fnsig segment so GC emission can pick the real func
// type.
fn fn_sig_segment_is_i32_family(name: String) -> bool {
    name.clone().eq(String_from("i32")) ||
    name.clone().eq(String_from("I32")) ||
    name.clone().eq(String_from("bool")) ||
    name.clone().eq(String_from("Bool")) ||
    name.clone().eq(String_from("char")) ||
    name.clone().eq(String_from("u8")) ||
    name.clone().eq(String_from("i8")) ||
    name.clone().eq(String_from("u16")) ||
    name.clone().eq(String_from("i16")) ||
    name.clone().eq(String_from("u32"))
}

// Canonical field-type spelling for one fnsig segment. Mirrors
// decl_layout_type_name's container spellings (vec:/option:/result:/
// Name<args>) so token substitution in ctx_substitute_generic_field_type
// turns `fn(Vec<T>) -> U` into `fnsig:vec:i32;i32`. Nested fn types stay
// opaque `fnref` — one callback level is all the GC emitter resolves.
fn fn_sig_segment_name(node: AstNode) -> String {
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(node)) {
        return String_from("fnref")
    }
    if type_ann_is_generic(node) {
        let seg_name = type_ann_name(node)
        if seg_name.clone().eq(String_from("Vec")) && type_ann_child_count(node) >= 2 {
            return String_from("vec:").concat(fn_sig_segment_name(type_ann_child_at(node, 1)))
        }
        if seg_name.clone().eq(String_from("Option")) && type_ann_child_count(node) >= 2 {
            return String_from("option:").concat(fn_sig_segment_name(type_ann_child_at(node, 1)))
        }
        if seg_name.clone().eq(String_from("Result")) && type_ann_child_count(node) >= 3 {
            return String_from("result:").concat(fn_sig_segment_name(type_ann_child_at(node, 1)).concat(String_from(":").concat(fn_sig_segment_name(type_ann_child_at(node, 2)))))
        }
        if type_ann_child_count(node) >= 2 {
            let mut out = seg_name.clone().concat(String_from("<"))
            let mut gi = 1
            while gi < type_ann_child_count(node) {
                if gi > 1 {
                    out = out.concat(String_from(","))
                }
                out = out.concat(fn_sig_segment_name(type_ann_child_at(node, gi)))
                gi = gi + 1
            }
            return out.concat(String_from(">"))
        }
        return seg_name
    }
    if type_ann_is_tuple(node) && type_ann_child_count(node) == 2 {
        return String_from("Tuple:").concat(fn_sig_segment_name(type_ann_child_at(node, 0)).concat(String_from(":").concat(fn_sig_segment_name(type_ann_child_at(node, 1)))))
    }
    type_ann_name(node)
}

fn type_ann_is_named(node: AstNode) -> bool {
    frontend_type_kind::corehir_kind_is_type_named(frontend_ast_identity::corehir_node_kind(node))
}

// True when the annotation is exactly `fn(i32) -> i32` — the only callback
// shape the HashMap storage adapters support (#691).
fn type_ann_is_i32_i32_fn(node: AstNode) -> bool {
    if !frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(node)) {
        return false
    }
    if type_ann_child_count(node) != 1 || type_ann_return_count(node) != 1 {
        return false
    }
    let param_name = type_ann_name(type_ann_child_at(node, 0))
    let result_name = type_ann_name(type_ann_return_at(node, 0))
    param_name.eq(String_from("i32")) && result_name.eq(String_from("i32"))
}

fn type_ann_is_generic(node: AstNode) -> bool {
    frontend_type_kind::corehir_kind_is_type_generic(frontend_ast_identity::corehir_node_kind(node))
}

fn type_ann_is_tuple(node: AstNode) -> bool {
    frontend_type_kind::corehir_kind_is_type_tuple(frontend_ast_identity::corehir_node_kind(node))
}

fn type_ann_is_name(node: AstNode, expected: String) -> bool {
    type_ann_name(node).eq(expected)
}

// Tuple element spelling shared by `Vec<(A, B)>` annotations on locals,
// parameters, and signature types. Field keys reuse the fnsig segment
// spellings (fn values -> fnref, String keys capitalized) so the
// literal-built GC struct and every annotation-derived local type resolve
// to the same tuple:<a,b> name (#888).
fn type_ann_tuple_local_name(node: AstNode) -> String {
    let count = type_ann_child_count(node)
    if count == 0 {
        // `()` in type position is unit, not a heap tuple: it lowers to i32 0
        // in payloads (Ok(())) and scalar params. Emitting `tuple:` marks the
        // payload GC-ref, which makes match binds cast Result<(), E> values to
        // a ref-payload variant that Ok(()) never produces.
        return String_from("unit")
    }
    let mut name = String_from("tuple:")
    let mut i = 0
    while i < count {
        if i > 0 {
            name = name.concat(String_from(","))
        }
        name = name.concat(type_ann_tuple_field_key_name(type_ann_child_at(node, i)))
        i = i + 1
    }
    name
}

// Narrow integer annotations share the i32 ABI slot. Tuple layout keys use
// that ABI name so annotation-built and value-type-built tuples resolve to
// the same nominal GC struct type instead of two identical-layout twins.
fn type_ann_narrow_int_name(name: String) -> bool {
    name.clone().eq("i8") ||
    name.clone().eq("u8") ||
    name.clone().eq("i16") ||
    name.clone().eq("u16") ||
    name.clone().eq("u32")
}

fn type_ann_tuple_field_key_name(field: AstNode) -> String {
    if type_ann_is_tuple(field) {
        return type_ann_tuple_local_name(field)
    }
    let key = fn_sig_segment_name(field)
    if key.clone().eq(String_from("string")) || key.clone().eq(String_from("str")) {
        return String_from("String")
    }
    if type_ann_narrow_int_name(key.clone()) {
        return String_from("i32")
    }
    key
}
