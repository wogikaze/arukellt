// HashMap type-name aliases shared by CoreHir annotation shaping and
// MirValueType encoding. Kept free of TypeInfo/TypeTable so type_ann_* can
// call it without pulling the typed-spine overlay into annotation lowering.

fn hashmap_type_alias(k_name: String, v_name: String) -> String {
    if eq(clone(k_name), "String") && eq(clone(v_name), "i32") {
        return "si32"
    }
    if eq(clone(k_name), "i32") && eq(clone(v_name), "String") {
        return "i32str"
    }
    if eq(clone(k_name), "String") && eq(clone(v_name), "String") {
        return "strstr"
    }
    if eq(clone(k_name), "i32") && eq(clone(v_name), "i32") {
        return "i32i32"
    }
    // TYPE_FN ann text is "fnref" (#831); also accept bare fn / fn(...).
    if eq(clone(k_name), "i32") && (
        eq(clone(v_name), "fnref") ||
        eq(clone(v_name), "fn") ||
        starts_with(clone(v_name), "fn(")
    ) {
        return "i32fn"
    }
    if eq(clone(k_name), "String") && (
        eq(clone(v_name), "fnref") ||
        eq(clone(v_name), "fn") ||
        starts_with(clone(v_name), "fn(")
    ) {
        return "strfn"
    }
    concat(concat(k_name, ":"), v_name)
}
