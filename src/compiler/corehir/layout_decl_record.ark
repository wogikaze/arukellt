struct CoreHirLayoutDecl {
    kind: i32,
    name: String,
    fields: Vec<CoreHirLayoutField>,
    variants: Vec<CoreHirLayoutVariant>,
    // Declared generic parameter names in order (Pair<T> has ["T"]).
    // Empty for non-generic decls. MIR lowering uses these to derive
    // monomorphized layouts such as Pair<String> with substituted field
    // types instead of falling back to the unsubstituted declaration.
    type_params: Vec<String>,
}

fn CoreHirLayoutDecl_new(kind: i32, name: String, fields: Vec<CoreHirLayoutField>, variants: Vec<CoreHirLayoutVariant>, type_params: Vec<String>) -> CoreHirLayoutDecl {
    CoreHirLayoutDecl { kind: kind, name: name, fields: fields, variants: variants, type_params: type_params }
}

fn layout_decl_kind(decl: CoreHirLayoutDecl) -> i32 {
    decl.kind
}

fn layout_decl_name(decl: CoreHirLayoutDecl) -> String {
    decl.name.clone()
}

fn layout_decl_field_count(decl: CoreHirLayoutDecl) -> i32 {
    decl.fields.len()
}

fn layout_decl_field_at(decl: CoreHirLayoutDecl, index: i32) -> CoreHirLayoutField {
    decl.fields.get_unchecked(index)
}

fn layout_decl_variant_count(decl: CoreHirLayoutDecl) -> i32 {
    decl.variants.len()
}

fn layout_decl_variant_at(decl: CoreHirLayoutDecl, index: i32) -> CoreHirLayoutVariant {
    decl.variants.get_unchecked(index)
}

fn layout_decl_type_param_count(decl: CoreHirLayoutDecl) -> i32 {
    decl.type_params.len()
}

fn layout_decl_type_param_at(decl: CoreHirLayoutDecl, index: i32) -> String {
    decl.type_params.get_unchecked(index).clone()
}
