use corehir::raw_dto
use typechecker::contract_resolved_call
use typechecker::contract_result_state

// Convert the checker's per-call receiver-owner resolutions into the CoreHIR
// handoff table. Only the calls the checker actually resolved are present;
// lowering must not fall back to a syntactic callee scan (#933).
fn resolved_calls_from_check_result(check_result: TypeCheckResult) -> Vec<CoreHirResolvedCall> {
    let owners = contract_result_state::typecheck_result_resolved_call_owners(check_result)
    let mut calls = Vec::new<CoreHirResolvedCall>()
    let count = owners.len()
    let mut i = 0
    while i < count {
        let owner = get_unchecked(owners, i)
        calls.push(raw_dto::CoreHirResolvedCall_new(
                contract_resolved_call::ResolvedCallOwner_decl_index(owner.clone()),
                contract_resolved_call::ResolvedCallOwner_body_child_index(owner.clone()),
                contract_resolved_call::ResolvedCallOwner_span_start(owner.clone()),
                contract_resolved_call::ResolvedCallOwner_callee_name(owner.clone()),
                contract_resolved_call::ResolvedCallOwner_owner_name(owner)
            ))
        i = i + 1
    }
    calls
}
