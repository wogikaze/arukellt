//! Canonical spellings for a module-qualified call target.
//!
//! The resolver rewrites a `module::Type::method` call to `Type::method` in
//! the entry module, but loaded-module bodies keep the source spelling
//! (`json::JsonText::quote`) because they are not resolver-processed. The
//! signature spine and fn index register the impl method under its owner
//! spelling (`JsonText::quote`), so a lowering or emit lookup keyed on the
//! raw name misses and the call becomes an unresolved `drop; unreachable`.
//!
//! These variants are the canonical spellings the entry-module rewrite
//! already produces: the last two segments (`Owner::method`) and the
//! spelling with the leading module segment removed. Two-segment names are
//! left alone — they already spell `Owner::method` or `module::fn`, and
//! falling back to their last segment would turn a constructor such as
//! `Vec::new` into an unrelated bare `new`.

use std::prelude::{byte_at, substring}
use corehir::name_match

fn callee_spelling_segment_count(name: String) -> i32 {
    let n = name.len()
    let mut separators = 0
    let mut i = 0
    while i + 1 < n {
        if byte_at(name, i) == 58 && byte_at(name, i + 1) == 58 {
            separators = separators + 1
            i = i + 2
        } else {
            i = i + 1
        }
    }
    separators + 1
}

fn callee_spelling_after_first_segment(name: String) -> String {
    let n = name.len()
    let mut i = 0
    while i + 1 < n {
        if byte_at(name, i) == 58 && byte_at(name, i + 1) == 58 {
            return substring(name, i + 2, n)
        }
        i = i + 1
    }
    name.clone()
}

fn callee_spelling_last_two_segments(name: String) -> String {
    let n = name.len()
    let mut previous = 0 - 1
    let mut last = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if byte_at(name, i) == 58 && byte_at(name, i + 1) == 58 {
            previous = last
            last = i
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if previous < 0 {
        return name.clone()
    }
    substring(name, previous + 2, n)
}

// Namespace spellings for a sealed raw bridge: the canonical CoreOp callee
// (`raw_array_new`), the module-qualified form, the associated form
// (`RawArray::new`), and the monomorphized form (`RawArray__new__String`).
//
// This runs for every call site during lowering. The spellings are compared in
// place: building `"::" + name` or `name + "__" + method` here allocated per
// check and dominated the overlay GC churn.
fn starts_with_mono_tail(callee: String, owner_name: String, method_name: String) -> bool {
    let owner_len = owner_name.len()
    let method_len = method_name.len()
    if callee.len() < owner_len + 2 + method_len + 2 {
        return false
    }
    name_match::NameMatch::region_equal(callee, 0, owner_name, 0, owner_len) &&
    byte_at(callee, owner_len) == 95 &&
    byte_at(callee, owner_len + 1) == 95 &&
    name_match::NameMatch::region_equal(callee, owner_len + 2, method_name, 0, method_len) &&
    byte_at(callee, owner_len + 2 + method_len) == 95 &&
    byte_at(callee, owner_len + 3 + method_len) == 95
}

fn contains_mono_qualified(callee: String, owner_name: String, method_name: String) -> bool {
    let owner_len = owner_name.len()
    let method_len = method_name.len()
    let pattern_len = 2 + owner_len + 2 + method_len + 2
    let callee_len = callee.len()
    let mut i = 0
    while i + pattern_len <= callee_len {
        if byte_at(callee, i) == 58 &&
        byte_at(callee, i + 1) == 58 &&
        name_match::NameMatch::region_equal(callee, i + 2, owner_name, 0, owner_len) &&
        byte_at(callee, i + 2 + owner_len) == 95 &&
        byte_at(callee, i + 3 + owner_len) == 95 &&
        name_match::NameMatch::region_equal(callee, i + 4 + owner_len, method_name, 0, method_len) &&
        byte_at(callee, i + 4 + owner_len + method_len) == 95 &&
        byte_at(callee, i + 5 + owner_len + method_len) == 95 {
            return true
        }
        i = i + 1
    }
    false
}

fn is_namespace_member_callee(
    callee: String,
    raw_name: String,
    owner_name: String,
    method_name: String
) -> bool {
    if name_match::NameMatch::equal(callee, raw_name) {
        return true
    }
    if name_match::NameMatch::ends_with_qualified(callee, raw_name) {
        return true
    }
    if name_match::NameMatch::equals_pair(callee, owner_name, method_name, 58, 58) {
        return true
    }
    if name_match::NameMatch::ends_with_qualified_pair(callee, owner_name, method_name, 58, 58) {
        return true
    }
    if name_match::NameMatch::equals_pair(callee, owner_name, method_name, 95, 95) {
        return true
    }
    if starts_with_mono_tail(callee, owner_name, method_name) {
        return true
    }
    contains_mono_qualified(callee, owner_name, method_name)
}

fn callee_spelling_variants(name: String) -> Vec<String> {
    let mut variants = Vec::new<String>()
    if callee_spelling_segment_count(name.clone()) < 3 {
        return variants
    }
    let last_two = callee_spelling_last_two_segments(name.clone())
    if last_two.len() > 0 && !last_two.clone().eq(name.clone()) {
        push(variants, last_two.clone())
    }
    let after_first = callee_spelling_after_first_segment(name.clone())
    if after_first.len() > 0 && !after_first.clone().eq(name.clone()) {
        let mut seen = false
        let mut i = 0
        while i < variants.len() {
            if variants.get_unchecked(i).clone().eq(after_first.clone()) {
                seen = true
                i = variants.len()
            } else {
                i = i + 1
            }
        }
        if !seen {
            push(variants, after_first)
        }
    }
    variants
}
