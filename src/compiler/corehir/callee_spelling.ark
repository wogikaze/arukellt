//! Canonical spellings for a module-qualified call target.
//!
//! The resolver rewrites a `module::Type::method` call to `Type::method` in
//! the entry module, but loaded-module bodies keep the source spelling
//! (`json::JsonText::quote`) because they are not resolver-processed. The
//! signature spine and fn index register the impl method under its owner
//! spelling (`JsonText::quote`), so a lowering or emit lookup keyed on the
//! raw name misses and the call becomes an unresolved `drop; unreachable`.
//!
//! These variants are the canonical spellings the entry-module rewrite
//! already produces: the last two segments (`Owner::method`) and the
//! spelling with the leading module segment removed. Two-segment names are
//! left alone — they already spell `Owner::method` or `module::fn`, and
//! falling back to their last segment would turn a constructor such as
//! `Vec::new` into an unrelated bare `new`.

use std::prelude::{clone, eq}
use corehir::name_match

fn callee_spelling_segment_count(name: String) -> i32 {
    let n = len(name)
    let mut separators = 0
    let mut i = 0
    while i + 1 < n {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            separators = separators + 1
            i = i + 2
        } else {
            i = i + 1
        }
    }
    separators + 1
}

fn callee_spelling_after_first_segment(name: String) -> String {
    let n = len(name)
    let mut i = 0
    while i + 1 < n {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            return name.slice(i + 2, n)
        }
        i = i + 1
    }
    clone(name)
}

fn callee_spelling_last_two_segments(name: String) -> String {
    let n = len(name)
    let mut previous = 0 - 1
    let mut last = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            previous = last
            last = i
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if previous < 0 {
        return clone(name)
    }
    name.slice(previous + 2, n)
}

// Namespace spellings for a sealed raw bridge: the canonical CoreOp callee
// (`raw_array_new`), the module-qualified form, the associated form
// (`RawArray::new`), and the monomorphized form (`RawArray__new__String`).
//
// This runs for every call site during lowering. The spellings are compared in
// place: building `"::" + name` or `name + "__" + method` here allocated per
// check and dominated the overlay GC churn.
fn starts_with_mono_tail(callee: String, owner_name: String, method_name: String) -> bool {
    let owner_len = len(owner_name)
    let method_len = len(method_name)
    if len(callee) < owner_len + 2 + method_len + 2 {
        return false
    }
    name_match::name_region_equal(callee, 0, owner_name, 0, owner_len) &&
    callee.byte_at(owner_len) == 95 &&
    callee.byte_at(owner_len + 1) == 95 &&
    name_match::name_region_equal(callee, owner_len + 2, method_name, 0, method_len) &&
    callee.byte_at(owner_len + 2 + method_len) == 95 &&
    callee.byte_at(owner_len + 3 + method_len) == 95
}

fn contains_mono_qualified(callee: String, owner_name: String, method_name: String) -> bool {
    let owner_len = len(owner_name)
    let method_len = len(method_name)
    let pattern_len = 2 + owner_len + 2 + method_len + 2
    let callee_len = len(callee)
    let mut i = 0
    while i + pattern_len <= callee_len {
        if callee.byte_at(i) == 58 &&
        callee.byte_at(i + 1) == 58 &&
        name_match::name_region_equal(callee, i + 2, owner_name, 0, owner_len) &&
        callee.byte_at(i + 2 + owner_len) == 95 &&
        callee.byte_at(i + 3 + owner_len) == 95 &&
        name_match::name_region_equal(callee, i + 4 + owner_len, method_name, 0, method_len) &&
        callee.byte_at(i + 4 + owner_len + method_len) == 95 &&
        callee.byte_at(i + 5 + owner_len + method_len) == 95 {
            return true
        }
        i = i + 1
    }
    false
}

fn is_namespace_member_callee(
    callee: String,
    raw_name: String,
    owner_name: String,
    method_name: String
) -> bool {
    if name_match::name_equal(callee, raw_name) {
        return true
    }
    if name_match::name_ends_with_qualified(callee, raw_name) {
        return true
    }
    if name_match::name_equals_pair(callee, owner_name, method_name, 58, 58) {
        return true
    }
    if name_match::name_ends_with_qualified_pair(callee, owner_name, method_name, 58, 58) {
        return true
    }
    if name_match::name_equals_pair(callee, owner_name, method_name, 95, 95) {
        return true
    }
    if starts_with_mono_tail(callee, owner_name, method_name) {
        return true
    }
    contains_mono_qualified(callee, owner_name, method_name)
}

fn callee_spelling_variants(name: String) -> Vec<String> {
    let mut variants = Vec::new<String>()
    if callee_spelling_segment_count(clone(name)) < 3 {
        return variants
    }
    let last_two = callee_spelling_last_two_segments(clone(name))
    if len(last_two) > 0 && !eq(clone(last_two), clone(name)) {
        push(variants, clone(last_two))
    }
    let after_first = callee_spelling_after_first_segment(clone(name))
    if len(after_first) > 0 && !eq(clone(after_first), clone(name)) {
        let mut seen = false
        let mut i = 0
        while i < len(variants) {
            if eq(clone(get_unchecked(variants, i)), clone(after_first)) {
                seen = true
                i = len(variants)
            } else {
                i = i + 1
            }
        }
        if !seen {
            push(variants, after_first)
        }
    }
    variants
}
