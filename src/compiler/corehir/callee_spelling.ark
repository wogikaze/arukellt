//! Canonical spellings for a module-qualified call target.
//!
//! The resolver rewrites a `module::Type::method` call to `Type::method` in
//! the entry module, but loaded-module bodies keep the source spelling
//! (`json::JsonText::quote`) because they are not resolver-processed. The
//! signature spine and fn index register the impl method under its owner
//! spelling (`JsonText::quote`), so a lowering or emit lookup keyed on the
//! raw name misses and the call becomes an unresolved `drop; unreachable`.
//!
//! These variants are the canonical spellings the entry-module rewrite
//! already produces: the last two segments (`Owner::method`) and the
//! spelling with the leading module segment removed. Two-segment names are
//! left alone — they already spell `Owner::method` or `module::fn`, and
//! falling back to their last segment would turn a constructor such as
//! `Vec::new` into an unrelated bare `new`.

use std::prelude::{byte_at, clone, eq, substring}

fn callee_spelling_segment_count(name: String) -> i32 {
    let n = len(name)
    let mut separators = 0
    let mut i = 0
    while i + 1 < n {
        if byte_at(name, i) == 58 && byte_at(name, i + 1) == 58 {
            separators = separators + 1
            i = i + 2
        } else {
            i = i + 1
        }
    }
    separators + 1
}

fn callee_spelling_after_first_segment(name: String) -> String {
    let n = len(name)
    let mut i = 0
    while i + 1 < n {
        if byte_at(name, i) == 58 && byte_at(name, i + 1) == 58 {
            return substring(name, i + 2, n)
        }
        i = i + 1
    }
    clone(name)
}

fn callee_spelling_last_two_segments(name: String) -> String {
    let n = len(name)
    let mut previous = 0 - 1
    let mut last = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if byte_at(name, i) == 58 && byte_at(name, i + 1) == 58 {
            previous = last
            last = i
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if previous < 0 {
        return clone(name)
    }
    substring(name, previous + 2, n)
}

// Namespace spellings for a sealed raw bridge: the canonical CoreOp callee
// (`raw_array_new`), the module-qualified form, the associated form
// (`RawArray::new`), and the monomorphized form (`RawArray__new__String`).
fn is_namespace_member_callee(
    callee: String,
    raw_name: String,
    owner_name: String,
    method_name: String
) -> bool {
    if eq(clone(callee), clone(raw_name)) {
        return true
    }
    if ends_with(clone(callee), String_from("::").concat(clone(raw_name))) {
        return true
    }
    let associated = clone(owner_name).concat(String_from("::")).concat(clone(method_name))
    if eq(clone(callee), clone(associated)) {
        return true
    }
    if ends_with(clone(callee), String_from("::").concat(clone(associated))) {
        return true
    }
    let mono = clone(owner_name).concat(String_from("__")).concat(clone(method_name))
    if eq(clone(callee), clone(mono)) {
        return true
    }
    if starts_with(clone(callee), clone(mono).concat(String_from("__"))) {
        return true
    }
    index_of(clone(callee), String_from("::").concat(clone(mono)).concat(String_from("__"))) >= 0
}

fn callee_spelling_variants(name: String) -> Vec<String> {
    let mut variants = Vec::new<String>()
    if callee_spelling_segment_count(clone(name)) < 3 {
        return variants
    }
    let last_two = callee_spelling_last_two_segments(clone(name))
    if len(last_two) > 0 && !eq(clone(last_two), clone(name)) {
        push(variants, clone(last_two))
    }
    let after_first = callee_spelling_after_first_segment(clone(name))
    if len(after_first) > 0 && !eq(clone(after_first), clone(name)) {
        let mut seen = false
        let mut i = 0
        while i < len(variants) {
            if eq(clone(get_unchecked(variants, i)), clone(after_first)) {
                seen = true
                i = len(variants)
            } else {
                i = i + 1
            }
        }
        if !seen {
            push(variants, after_first)
        }
    }
    variants
}
