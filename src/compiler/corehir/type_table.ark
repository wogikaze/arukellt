use corehir::type_id
use corehir::kinds
use collections::name_index
fn type_id_is_valid(id: TypeId) -> bool {
    type_id::type_id_is_valid(id)
}

fn TYPE_ID_INVALID() -> TypeId {
    type_id::TYPE_ID_INVALID()
}

fn TypeId_new(raw: i32) -> TypeId {
    type_id::TypeId_new(raw)
}

fn TypeId_raw(id: TypeId) -> i32 {
    type_id::TypeId_raw(id)
}

struct TypeEntry {
    id: TypeId,
    kind: i32,
    name: String,
    type_param_ids: Vec<TypeId>,
}

// Entries sharing a name are chained through `next_same_name` from
// `name_head` so intern never rescans the whole table; (kind, name, params)
// is unique, so chain order does not affect which entry matches.
struct TypeTable {
    entries: Vec<TypeEntry>,
    next_id: i32,
    name_head: NameIndex,
    next_same_name: Vec<i32>,
}

fn TypeTable_new() -> TypeTable {
    TypeTable {
        entries: Vec::new<TypeEntry>(),
        next_id: 0,
        name_head: name_index::NameIndex_empty(),
        next_same_name: Vec::new<i32>(),
    }
}

fn TypeTable_entry_count(table: TypeTable) -> i32 {
    table.entries.len()
}

fn TypeTable_entry_at(table: TypeTable, index: i32) -> TypeEntry {
    table.entries.get_unchecked(index)
}

fn type_entry_id(entry: TypeEntry) -> TypeId {
    entry.id
}

fn type_entry_kind(entry: TypeEntry) -> i32 {
    entry.kind
}

fn type_entry_name(entry: TypeEntry) -> String {
    entry.name.clone()
}

fn type_entry_type_param_count(entry: TypeEntry) -> i32 {
    entry.type_param_ids.len()
}

fn type_entry_type_param_at(entry: TypeEntry, index: i32) -> TypeId {
    entry.type_param_ids.get_unchecked(index)
}

fn type_table_type_param_ids_equal(a: Vec<TypeId>, b: Vec<TypeId>) -> bool {
    let count = a.len()
    if count != b.len() {
        return false
    }
    let mut i = 0
    while i < count {
        let ai = a.get_unchecked(i)
        let bi = b.get_unchecked(i)
        if TypeId_raw(ai) != TypeId_raw(bi) {
            return false
        }
        i = i + 1
    }
    true
}

fn type_table_find_existing(table: TypeTable, kind: i32, name: String, type_param_ids: Vec<TypeId>) -> TypeId {
    let mut i = name_index::name_index_get(table.name_head, name)
    while i >= 0 {
        let entry = table.entries.get_unchecked(i)
        if entry.kind == kind && type_table_type_param_ids_equal(entry.type_param_ids, type_param_ids) {
            return entry.id
        }
        i = table.next_same_name.get_unchecked(i)
    }
    TYPE_ID_INVALID()
}

fn TypeTable_intern(mut table: TypeTable, kind: i32, name: String, type_param_ids: Vec<TypeId>) -> TypeId {
    let existing = type_table_find_existing(table, kind, name.clone(), type_param_ids)
    if type_id_is_valid(existing) {
        return existing
    }
    let id = TypeId_new(table.next_id)
    table.next_id = table.next_id + 1
    let entry_index = table.entries.len()
    table.next_same_name.push(name_index::name_index_get(table.name_head, name.clone()))
    name_index::name_index_set(table.name_head, name.clone(), entry_index)
    // The entry owns a copy; `id` is returned below, so it must stay live.
    let entry = TypeEntry { id: id.clone(), kind: kind, name: name, type_param_ids: type_param_ids }
    table.entries.push(entry)
    id
}

fn TypeTable_lookup(table: TypeTable, id: TypeId) -> TypeEntry {
    let raw = TypeId_raw(id)
    if raw >= 0 && raw < table.entries.len() {
        return table.entries.get_unchecked(raw)
    }
    TypeEntry {
        id: TYPE_ID_INVALID(),
        kind: kinds::TYPE_KIND_PRIMITIVE(),
        name: String_new(),
        type_param_ids: Vec::new<TypeId>()
    }
}
