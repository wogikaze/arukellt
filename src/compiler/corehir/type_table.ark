use corehir::type_id
use corehir::kinds

fn type_id_is_valid(id: TypeId) -> bool {
    type_id::type_id_is_valid(id)
}

fn TYPE_ID_INVALID() -> TypeId {
    type_id::TYPE_ID_INVALID()
}

fn TypeId_new(raw: i32) -> TypeId {
    type_id::TypeId_new(raw)
}

fn TypeId_raw(id: TypeId) -> i32 {
    type_id::TypeId_raw(id)
}

struct TypeEntry {
    id: TypeId,
    kind: i32,
    name: String,
    type_param_ids: Vec<TypeId>,
}

struct TypeTable {
    entries: Vec<TypeEntry>,
    next_id: i32,
}

fn TypeTable_new() -> TypeTable {
    TypeTable { entries: Vec::new<TypeEntry>(), next_id: 0 }
}

fn TypeTable_entry_count(table: TypeTable) -> i32 {
    len(table.entries)
}

fn TypeTable_entry_at(table: TypeTable, index: i32) -> TypeEntry {
    get_unchecked(table.entries, index)
}

fn type_entry_id(entry: TypeEntry) -> TypeId {
    entry.id
}

fn type_entry_kind(entry: TypeEntry) -> i32 {
    entry.kind
}

fn type_entry_name(entry: TypeEntry) -> String {
    clone(entry.name)
}

fn type_entry_type_param_count(entry: TypeEntry) -> i32 {
    len(entry.type_param_ids)
}

fn type_entry_type_param_at(entry: TypeEntry, index: i32) -> TypeId {
    get_unchecked(entry.type_param_ids, index)
}

fn type_table_type_param_ids_equal(a: Vec<TypeId>, b: Vec<TypeId>) -> bool {
    let count = len(a)
    if count != len(b) {
        return false
    }
    let mut i = 0
    while i < count {
        let ai = get_unchecked(a, i)
        let bi = get_unchecked(b, i)
        if TypeId_raw(ai) != TypeId_raw(bi) {
            return false
        }
        i = i + 1
    }
    true
}

// Legacy MIR type names encode a struct layout as `struct:<nominal>:<bytes>`.
// The byte count is representation metadata, not source nominal identity.
// Canonicalizing it here keeps typed MIR locals and the GC layout plan on the
// same TypeId without asking the Wasm backend to recover identity from names.
fn type_table_canonical_name(kind: i32, name: String) -> String {
    if kind != kinds::TYPE_KIND_STRUCT() || !starts_with(clone(name), "struct:") {
        return name
    }
    let n = len(name)
    let mut last_colon = 0 - 1
    let mut i = 7
    while i < n {
        if char_at(clone(name), i) == 58 {
            last_colon = i
        }
        i = i + 1
    }
    if last_colon <= 7 || last_colon + 1 >= n {
        return name
    }
    let mut j = last_colon + 1
    while j < n {
        let ch = char_at(clone(name), j)
        if ch < 48 || ch > 57 {
            return name
        }
        j = j + 1
    }
    substring(name, 7, last_colon)
}

fn type_table_find_existing(table: TypeTable, kind: i32, name: String, type_param_ids: Vec<TypeId>) -> TypeId {
    let canonical_name = type_table_canonical_name(kind, name)
    let count = len(table.entries)
    let mut i = 0
    while i < count {
        let entry = get_unchecked(table.entries, i)
        if entry.kind == kind && eq(clone(entry.name), clone(canonical_name)) && type_table_type_param_ids_equal(entry.type_param_ids, type_param_ids) {
            return entry.id
        }
        i = i + 1
    }
    TYPE_ID_INVALID()
}

fn TypeTable_intern(table: TypeTable, kind: i32, name: String, type_param_ids: Vec<TypeId>) -> TypeId {
    let canonical_name = type_table_canonical_name(kind, name)
    let existing = type_table_find_existing(table, kind, clone(canonical_name), type_param_ids)
    if type_id_is_valid(existing) {
        return existing
    }
    let id = TypeId_new(table.next_id)
    table.next_id = table.next_id + 1
    let entry = TypeEntry { id: id, kind: kind, name: canonical_name, type_param_ids: type_param_ids }
    push(table.entries, entry)
    id
}

fn TypeTable_lookup(table: TypeTable, id: TypeId) -> TypeEntry {
    let raw = TypeId_raw(id)
    if raw >= 0 && raw < len(table.entries) {
        return get_unchecked(table.entries, raw)
    }
    TypeEntry { id: TYPE_ID_INVALID(), kind: kinds::TYPE_KIND_PRIMITIVE(), name: String_new(), type_param_ids: Vec::new<TypeId>() }
}
