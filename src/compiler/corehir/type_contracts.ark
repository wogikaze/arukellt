struct MonoInstance {
    fn_name: String,
    mangled_name: String,
    type_args: Vec<TypeInfo>,
    return_type: TypeInfo,
    demanded: bool,
}

struct TypeCheckResult {
    error_count: i32,
    errors: Vec<String>,
    typed_fns: Vec<TypedFn>,
    mono_instances: Vec<MonoInstance>,
}

struct TypedFn {
    name: String,
    param_types: Vec<TypeInfo>,
    return_type: TypeInfo,
}

struct TypeInfo {
    tag: i32,
    name: String,
    type_args: Vec<TypeInfo>,
    // Function types (`TY_FN`) only: one entry per parameter, aligned with
    // `type_args` (whose last entry is the return type). Empty means every
    // parameter is the default shared mode, so types built by builtins and
    // older construction sites keep their historical contract.
    param_modes: Vec<bool>,
}

fn TypeInfo_tag(ty: TypeInfo) -> i32 {
    ty.tag
}

fn TypeInfo_name(ty: TypeInfo) -> String {
    ty.name.clone()
}

fn TypeInfo_type_arg_count(ty: TypeInfo) -> i32 {
    ty.type_args.len()
}

fn TypeInfo_type_arg_at(ty: TypeInfo, index: i32) -> TypeInfo {
    get_unchecked(ty.type_args, index)
}

fn TypedFn_return_type(fn_info: TypedFn) -> TypeInfo {
    fn_info.return_type
}

fn MonoInstance_fn_name(instance: MonoInstance) -> String {
    instance.fn_name.clone()
}

fn MonoInstance_mangled_name(instance: MonoInstance) -> String {
    instance.mangled_name.clone()
}

fn MonoInstance_type_arg_count(instance: MonoInstance) -> i32 {
    instance.type_args.len()
}

fn MonoInstance_type_arg_at(instance: MonoInstance, index: i32) -> TypeInfo {
    get_unchecked(instance.type_args, index)
}

fn MonoInstance_return_type(instance: MonoInstance) -> TypeInfo {
    instance.return_type
}

fn TypeInfo_simple(tag: i32) -> TypeInfo {
    TypeInfo {
        tag: tag,
        name: String_new(),
        type_args: Vec::new<TypeInfo>(),
        param_modes: Vec::new<bool>()
    }
}

fn TypeInfo_new(tag: i32, name: String, type_args: Vec<TypeInfo>) -> TypeInfo {
    TypeInfo {
        tag: tag,
        name: name,
        type_args: type_args,
        param_modes: Vec::new<bool>()
    }
}

fn TypeInfo_push_type_arg(mut ty: TypeInfo, arg: TypeInfo) {
    ty.type_args.push(arg)
}

fn MonoInstance_new(fn_name: String, mangled_name: String, type_args: Vec<TypeInfo>) -> MonoInstance {
    MonoInstance {
        fn_name: fn_name,
        mangled_name: mangled_name,
        type_args: type_args,
        return_type: TypeInfo_simple(commands::TY_UNKNOWN()),
        demanded: false
    }
}

fn MonoInstance_demanded(instance: MonoInstance) -> bool {
    instance.demanded
}

fn MonoInstance_set_demanded(mut instance: MonoInstance) {
    instance.demanded = true
}
