use corehir::body
use corehir::expr_raw
use corehir::kinds
use corehir::proof_json_escape

fn proof_expr_render(table: CoreHirBodyTable, root: i32) -> String {
    if root < 0 {
        return String_from("(invalid-root)")
    }
    let expr = body::corehir_body_expr_at(table, root)
    let kind = expr_raw::corehir_expr_kind(expr)
    if kind == commands::COREHIR_EXPR_IDENT() {
        return concat(String_from("(ident "), concat(proof_json_escape::quote_json(expr_raw::corehir_expr_text(expr)), String_from(")")))
    }
    if kind == commands::COREHIR_EXPR_PATH() {
        return concat(String_from("(path "), concat(proof_json_escape::quote_json(expr_raw::corehir_expr_text(expr)), String_from(")")))
    }
    if kind == commands::COREHIR_EXPR_INT() {
        return concat(String_from("(int "), concat(to_string(expr_raw::corehir_expr_int_val(expr)), String_from(")")))
    }
    if kind == commands::COREHIR_EXPR_FLOAT() {
        return concat(String_from("(float "), concat(to_string(expr_raw::corehir_expr_float_val(expr)), String_from(")")))
    }
    if kind == commands::COREHIR_EXPR_STRING() {
        return concat(String_from("(string "), concat(proof_json_escape::quote_json(expr_raw::corehir_expr_text(expr)), String_from(")")))
    }
    if kind == commands::COREHIR_EXPR_BOOL() {
        let value = if expr_raw::corehir_expr_int_val(expr) == 0 { String_from("false") } else { String_from("true") }
        return concat(String_from("(bool "), concat(value, String_from(")")))
    }
    if kind == commands::COREHIR_EXPR_CHAR() {
        return concat(String_from("(char "), concat(to_string(expr_raw::corehir_expr_int_val(expr)), String_from(")")))
    }
    if kind == commands::COREHIR_EXPR_BINARY() {
        return render_binary(table, expr)
    }
    if kind == commands::COREHIR_EXPR_UNARY() {
        return render_unary(table, expr)
    }
    if kind == commands::COREHIR_EXPR_CALL() {
        return render_named_children(table, String_from("call"), expr_raw::corehir_expr_text(expr), expr)
    }
    if kind == commands::COREHIR_EXPR_METHOD_CALL() {
        return render_named_children(table, String_from("method-call"), expr_raw::corehir_expr_text(expr), expr)
    }
    if kind == commands::COREHIR_EXPR_FIELD_ACCESS() {
        return render_named_children(table, String_from("field"), expr_raw::corehir_expr_text(expr), expr)
    }
    if kind == commands::COREHIR_EXPR_INDEX() {
        return render_children(table, String_from("index"), expr)
    }
    concat(String_from("(unsupported "), concat(to_string(kind), String_from(")")))
}

fn render_binary(table: CoreHirBodyTable, expr: CoreHirExpr) -> String {
    if expr_raw::corehir_expr_child_count(expr) < 2 {
        return String_from("(invalid-binary)")
    }
    let left = proof_expr_render(table, expr_raw::corehir_expr_child(expr, 0))
    let right = proof_expr_render(table, expr_raw::corehir_expr_child(expr, 1))
    concat(String_from("("), concat(binary_op_name(expr_raw::corehir_expr_int_val(expr)), concat(String_from(" "), concat(left, concat(String_from(" "), concat(right, String_from(")")))))))
}

fn render_unary(table: CoreHirBodyTable, expr: CoreHirExpr) -> String {
    if expr_raw::corehir_expr_child_count(expr) < 1 {
        return String_from("(invalid-unary)")
    }
    let operand = proof_expr_render(table, expr_raw::corehir_expr_child(expr, 0))
    concat(String_from("("), concat(unary_op_name(expr_raw::corehir_expr_int_val(expr)), concat(String_from(" "), concat(operand, String_from(")")))))
}

fn render_named_children(table: CoreHirBodyTable, head: String, name: String, expr: CoreHirExpr) -> String {
    let mut out = concat(String_from("("), concat(head, concat(String_from(" "), proof_json_escape::quote_json(name))))
    let count = expr_raw::corehir_expr_child_count(expr)
    let mut i = 0
    while i < count {
        out = concat(out, concat(String_from(" "), proof_expr_render(table, expr_raw::corehir_expr_child(expr, i))))
        i = i + 1
    }
    concat(out, String_from(")"))
}

fn render_children(table: CoreHirBodyTable, head: String, expr: CoreHirExpr) -> String {
    let mut out = concat(String_from("("), head)
    let count = expr_raw::corehir_expr_child_count(expr)
    let mut i = 0
    while i < count {
        out = concat(out, concat(String_from(" "), proof_expr_render(table, expr_raw::corehir_expr_child(expr, i))))
        i = i + 1
    }
    concat(out, String_from(")"))
}

fn binary_op_name(op: i32) -> String {
    if op == 1 { return String_from("add") }
    if op == 2 { return String_from("sub") }
    if op == 3 { return String_from("mul") }
    if op == 4 { return String_from("div") }
    if op == 5 { return String_from("mod") }
    if op == 6 { return String_from("eq") }
    if op == 7 { return String_from("ne") }
    if op == 8 { return String_from("lt") }
    if op == 9 { return String_from("le") }
    if op == 10 { return String_from("gt") }
    if op == 11 { return String_from("ge") }
    if op == 12 { return String_from("and") }
    if op == 13 { return String_from("or") }
    if op == 14 { return String_from("bit-and") }
    if op == 15 { return String_from("bit-or") }
    if op == 16 { return String_from("bit-xor") }
    if op == 17 { return String_from("shl") }
    if op == 18 { return String_from("shr") }
    concat(String_from("binary-op-"), to_string(op))
}

fn unary_op_name(op: i32) -> String {
    if op == 1 { return String_from("neg") }
    if op == 2 { return String_from("not") }
    if op == 3 { return String_from("bit-not") }
    concat(String_from("unary-op-"), to_string(op))
}
