use corehir::param
use corehir::param_shape_declared
use corehir::param_shape_local
use corehir::param_shape_node
use corehir::param_shape_value
use corehir::type_ann_param_name
fn param_type_name(node: AstNode) -> String {
    if param_shape_node::param_has_type_ann(node.clone()) {
        return type_ann_param_name::type_ann_shape_param_type_name(param_shape_node::param_type_ann(node))
    }
    String_new()
}

fn fn_param_from_node(
    node: AstNode,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> CoreHirParam {
    let name = param_shape_node::param_name(node.clone())
    let bindable = param_shape_node::param_is_ident(node.clone())
    param::CoreHirParam_new(
        name,
        param_shape_value::fn_param_value_type(node.clone(), type_params.clone(), nominal_types),
        param_type_name(node.clone()),
        param_shape_local::fn_param_local_type_name(node, type_params, nominal_types),
        bindable,
        false
    )
}

fn method_param_from_node(
    node: AstNode,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> CoreHirParam {
    let name = param_shape_node::param_name(node.clone())
    let bindable = param_shape_node::param_is_ident(node.clone())
    param::CoreHirParam_new(
        name.clone(),
        param_shape_value::method_param_value_type(node.clone(), type_params.clone(), nominal_types),
        param_type_name(node.clone()),
        param_shape_local::method_param_local_type_name(node, type_params, nominal_types),
        bindable,
        param_shape_node::param_is_self_name(name)
    )
}
