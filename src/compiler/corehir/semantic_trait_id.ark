// Canonical trait ids for language-syntax desugaring (RFC-004 §6).
// Syntax paths (operators, `?`) reference these ids directly and must not
// depend on import scope or bare trait-name string matching at use sites.

fn SEMANTIC_TRAIT_ID_NONE() -> i32 {
    0 - 1
}

// ADR-039 D2 / RFC-004: `expr?` heterogeneous Err conversion.
fn SEMANTIC_TRAIT_ID_FROM() -> i32 {
    1
}

// Map an impl-header trait name discovered in CoreHIR to a canonical id.
// Discovery may read the declaration name; resolution of `?` uses the id.
fn semantic_trait_id_from_trait_name(trait_name: String) -> i32 {
    if eq(clone(trait_name), "From") {
        return SEMANTIC_TRAIT_ID_FROM()
    }
    SEMANTIC_TRAIT_ID_NONE()
}

fn semantic_trait_id_is_from(trait_id: i32) -> bool {
    trait_id == SEMANTIC_TRAIT_ID_FROM()
}
