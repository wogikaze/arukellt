use collections::name_index

// Impl methods are registered under their source-level `Owner::method`
// spelling. Two modules can declare a same-named owner type, so that spelling
// is not unique: without an identity the signature index and the MIR function
// index collapse the two declarations onto the first one.
//
// The first method that claims a flat spelling keeps it. A later method gets
// its (impl decl, child) identity appended, which both indexes and the emitted
// function name carry. A generic method's monomorphized instances extend the
// identity-suffixed base (`Owner::method__impl_3_0__Arg`), so the mono naming
// and matching paths carry the same identity and two same-named generic
// declarations cannot alias.
fn impl_method_identity_marker() -> String {
    String_from("__impl_")
}

fn impl_method_identity_suffix(impl_decl_index: i32, method_index: i32) -> String {
    impl_method_identity_marker()
    .concat(impl_decl_index.to_string().concat("_").concat(method_index.to_string()))
}

// Whether `name` was given a per-method identity by
// `impl_method_emitted_name`. Lowering uses this to accept only the identity
// handoff from the checker's resolved-call table; ordinary flat method names
// keep their existing rewrite paths.
fn impl_method_has_identity_suffix(name: String) -> bool {
    name.clone().contains(impl_method_identity_marker())
}

// Remove the `__impl_<decl>_<child>` segment from a spelling that carries it,
// wherever it sits: `Owner::method__impl_3_0__Arg` -> `Owner::method__Arg`.
// The identity names the declaration, not the callable, so mono suffix
// parsing and source-spelling matching must see the keys and owner they see
// for the declaration that claimed the flat name.
fn impl_method_source_name(name: String) -> String {
    let marker = impl_method_identity_marker()
    let name_len = name.len()
    let start = name.clone().index_of(marker.clone())
    if start < 0 {
        return name
    }
    // The identity segment ends at the next `__` mono separator (the type
    // arguments follow it) or at the end of the spelling.
    let mut end = name_len
    let mut scan = start + marker.len()
    while scan + 1 < name_len {
        if name.byte_at(scan) == 95 && name.byte_at(scan + 1) == 95 {
            end = scan
            scan = name_len
        } else {
            scan = scan + 1
        }
    }
    name.slice(0, start).concat(name.slice(end, name_len))
}

// Resolve the symbol one impl method registers. `seen` records the flat
// spellings earlier methods already claimed, in declaration order, so callers
// must walk the combined loaded+entry decl list with impl children in order
// (the signature index, the checker's FnSig collection, and CoreHIR's method
// infos all do).
fn impl_method_emitted_name(
    mut seen: NameIndex,
    flat_name: String,
    impl_decl_index: i32,
    method_index: i32
) -> String {
    let is_claimed = name_index::name_index_get(seen, flat_name.clone()) >= 0
    name_index::name_index_increment(seen, flat_name.clone())
    if !is_claimed {
        return flat_name
    }
    flat_name.concat(impl_method_identity_suffix(impl_decl_index, method_index))
}
