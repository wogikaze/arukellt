    if chunk == 47 { return "ffffffffffffffffffffffff34000000ffffffff6d010000d100000085010000ffffffffffffffffffffffffbe010000ffffffff060000004201000077010000" }
    if chunk == 48 { return "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff17010000bb0000004e0100002b000000eb000000e000000090010000" }
    if chunk == 49 { return "ba0000001f000000450100002f0100006501000066010000ffffffffffffffff54010000ffffffffffffffffffffffff53010000ffffffffffffffffffffffff" }
    if chunk == 50 { return "8b010000ffffffff9000000026000000ffffffffffffffffffffffffe3000000ffffffff38010000ffffffffffffffffffffffffffffffff6a01000099010000" }
    if chunk == 51 { return "ffffffff300100003d010000ffffffff52000000dd0000006e0100000a010000ffffffff3c0100004d010000ffffffffffffffffffffffffffffffffffffffff" }
    if chunk == 52 { return "ffffffffffffffffffffffffffffffffffffffff00010000ffffffffffffffff9a0100007c0000009f000000ffffffff38000000670100008d0100007d000000" }
    if chunk == 53 { return "9e000000ffffffffffffffffa6010000ffffffff65000000ffffffff8e000000ffffffffffffffffd300000085000000ffffffff8600000013000000a8010000" }
    if chunk == 54 { return "02000000ffffffff37000000a3010000fb000000ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffd0000000ffffffff21010000" }
    if chunk == 55 { return "ffffffffec000000ffffffffffffffffffffffffffffffffffffffffffffffffffffffff6b0000000c0000007b010000fffffffffffffffff60000006c000000" }
    if chunk == 56 { return "2b010000d7000000ffffffffffffffff98000000ffffffffffffffff20010000ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" }
    if chunk == 57 { return "ffffffff9d010000f7000000ffffffffc3010000c4010000ffffffffffffffff1d00000060000000ffffffffffffffffffffffffffffffffffffffff61000000" }
    if chunk == 58 { return "02010000ffffffffffffffffffffffff21000000ffffffffffffffffd500000005000000800100001b000000f40000001b010000ffffffff91010000ffffffff" }
    if chunk == 59 { return "ffffffffffffffff0a000000bd000000fffffffffffffffffffffffffc000000fffffffffffffffffffffffffffffffffffffffffffffffffffffffff8000000" }
    if chunk == 60 { return "ffffffffffffffffffffffff12000000660000004d00000067000000ffffffffffffffffd9000000ffffffffffffffffffffffff9d000000ffffffffffffffff" }
    if chunk == 61 { return "ffffffff63000000ffffffffffffffff4c000000d6000000ea0000006400000077000000ffffffff120100003101000036000000ffffffffffffffffffffffff" }
    if chunk == 62 { return "100000008e010000ffffffffffffffff2f000000ffffffffffffffff5000000008010000ffffffffffffffffffffffffffffffffffffffffffffffffffffffff" }
    if chunk == 63 { return "bd010000370100008b000000a7000000a30000000b010000ffffffff8900000030000000ffffffffbc010000ffffffffffffffffffffffffffffffffffffffff" }
    return String_new()
}

fn core_op_binding_bucket_at(index: i32) -> i32 {
    if index < 0 || index >= 1024 {
        return 0 - 1
    }
    let chunk = index / 16
    let local = index - chunk * 16
    return table_blob::table_blob_i32_from_hex8(core_op_binding_bucket_hex_chunk(chunk), local * 8)
}

fn core_op_binding_lookup_callee(name: String) -> i32 {
    let capacity = 1024
    let fnv_offset = 216613626
    let fnv_prime = 16777619
    let mut hash = fnv_offset
    let name_len = len(name)
    let mut hi = 0
    while hi < name_len {
        hash = hash * fnv_prime ^ char_at(name, hi)
        if hash < 0 {
            hash = 0 - hash
        }
        hi = hi + 1
    }
    if hash < 0 {
        hash = 0
    }
    let mut slot = hash % capacity
    let mut probes = 0
    while probes < capacity {
        let idx = core_op_binding_bucket_at(slot)
        if idx < 0 {
            return 0 - 1
        }
        if eq(clone(name), core_op_binding_callee_at(idx)) {
            return idx
        }
        slot = (slot + 1) % capacity
        probes = probes + 1
    }
    return 0 - 1
}

fn core_op_binding_core_op_id_for_callee_exact(callee: String) -> String {
    let index = core_op_binding_lookup_callee(clone(callee))
    if index < 0 {
        return String_new()
    }
    return core_op_binding_core_op_id_at(index)
}

fn core_op_binding_core_op_id_for_callee_family(callee: String) -> String {
    let count = core_op_binding_pattern_count()
    let mut i = 0
    while i < count {
        let pattern = core_op_binding_pattern_at(i)
        if starts_with(clone(callee), clone(pattern)) {
            let suffix_len = len(callee) - len(pattern)
            if core_op_binding_pattern_requires_nonempty_suffix_at(i) && suffix_len <= 0 {
                i = i + 1
                continue
            }
            return core_op_binding_pattern_core_op_id_at(i)
        }
        i = i + 1
    }
    return String_new()
}

fn core_op_binding_core_op_id_for_callee(callee: String) -> String {
    return core_op_binding_core_op_id_for_callee_exact(clone(callee))
}

fn core_op_binding_core_op_id_for_callee_exact_then_family(callee: String) -> String {
    let exact = core_op_binding_core_op_id_for_callee_exact(clone(callee))
    if len(exact) > 0 {
        return exact
    }
    return core_op_binding_core_op_id_for_callee_family(clone(callee))
}
