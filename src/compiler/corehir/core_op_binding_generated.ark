fn core_op_binding_callee_at(index: i32) -> String {
    if index < 0 || index >= 543 {
        return String_new()
    }
    let start = core_op_binding_callee_off_at(index)
    let end = core_op_binding_callee_off_at(index + 1)
    if start >= end {
        return String_new()
    }
    let start_chunk = start / 144
    let last = end - 1
    let end_chunk = last / 144
    if start_chunk == end_chunk {
        let piece = core_op_binding_callee_data_chunk(start_chunk)
        let local = start - start_chunk * 144
        return substring(piece, local, local + (end - start))
    }
    let mut out = String_new()
    let mut i = start
    while i < end {
        let chunk = i / 144
        let local = i - chunk * 144
        let piece = core_op_binding_callee_data_chunk(chunk)
        let avail = 144 - local
        let remain = end - i
        let mut take = avail
        if remain < avail {
            take = remain
        }
        out = text::concat(out, substring(piece, local, local + take))
        i = i + take
    }
    return out
}

