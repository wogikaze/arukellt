fn core_op_binding_core_op_id_off_at(index: i32) -> i32 {
    if index < 0 || index >= 544 {
        return 0
    }
    let chunk = index / 18
    let local = index - chunk * 18
    return table_blob::table_blob_i32_from_hex8(core_op_binding_core_op_id_off_hex_chunk(chunk), local * 8)
}

