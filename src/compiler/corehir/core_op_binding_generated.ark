fn core_op_binding_bucket_at(index: i32) -> i32 {
    if index < 0 || index >= 2048 {
        return 0 - 1
    }
    let chunk = index / 18
    let local = index - chunk * 18
    return table_blob::table_blob_i32_from_hex8(core_op_binding_bucket_hex_chunk(chunk), local * 8)
}

fn core_op_binding_lookup_callee(name: String) -> i32 {
    let capacity = 2048
    let fnv_offset = 216613626
    let fnv_prime = 16777619
    let mut hash = fnv_offset
    let name_len = len(name)
    let mut hi = 0
    while hi < name_len {
        hash = hash * fnv_prime ^ byte_at(name, hi)
        if hash < 0 {
            hash = 0 - hash
        }
        hi = hi + 1
    }
    if hash < 0 {
        hash = 0
    }
    let mut slot = hash % capacity
    let mut probes = 0
    while probes < capacity {
        let idx = core_op_binding_bucket_at(slot)
        if idx < 0 {
            return 0 - 1
        }
        if name.clone().eq(core_op_binding_callee_at(idx)) {
            return idx
        }
        slot = (slot + 1) % capacity
        probes = probes + 1
    }
    return 0 - 1
}

fn core_op_binding_core_op_id_for_callee_exact(callee: String) -> String {
    let index = core_op_binding_lookup_callee(callee.clone())
    if index < 0 {
        return String_new()
    }
    return core_op_binding_core_op_id_at(index)
}

fn core_op_binding_core_op_id_for_callee_family(callee: String) -> String {
    let count = core_op_binding_pattern_count()
    let mut i = 0
    while i < count {
        let pattern = core_op_binding_pattern_at(i)
        if starts_with(callee.clone(), pattern.clone()) {
            let suffix_len = len(callee) - len(pattern)
            if core_op_binding_pattern_requires_nonempty_suffix_at(i) && suffix_len <= 0 {
                i = i + 1
                continue
            }
            return core_op_binding_pattern_core_op_id_at(i)
        }
        i = i + 1
    }
    return String_new()
}

fn core_op_binding_core_op_id_for_callee(callee: String) -> String {
    return core_op_binding_core_op_id_for_callee_exact(callee.clone())
}

fn core_op_binding_core_op_id_for_callee_exact_then_family(callee: String) -> String {
    let exact = core_op_binding_core_op_id_for_callee_exact(callee.clone())
    if len(exact) > 0 {
        return exact
    }
    return core_op_binding_core_op_id_for_callee_family(callee.clone())
}
