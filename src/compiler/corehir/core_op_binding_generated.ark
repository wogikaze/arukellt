        let local = start - start_chunk * 144
        return substring(piece, local, local + (end - start))
    }
    let mut out = String_new()
    let mut i = start
    while i < end {
        let chunk = i / 144
        let local = i - chunk * 144
        let piece = core_op_binding_callee_data_chunk(chunk)
        let avail = 144 - local
        let remain = end - i
        let mut take = avail
        if remain < avail {
            take = remain
        }
        out = text::concat(out, substring(piece, local, local + take))
        i = i + take
    }
    return out
}

