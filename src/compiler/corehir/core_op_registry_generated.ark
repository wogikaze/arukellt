    let last = end - 1
    let end_chunk = last / 80
    if start_chunk == end_chunk {
        let piece = core_op_registry_canonical_id_data_chunk(start_chunk)
        let local = start - start_chunk * 80
        return substring(piece, local, local + (end - start))
    }
    let mut out = String_new()
    let mut i = start
    while i < end {
        let chunk = i / 80
        let local = i - chunk * 80
        let piece = core_op_registry_canonical_id_data_chunk(chunk)
        let avail = 80 - local
        let remain = end - i
        let mut take = avail
        if remain < avail {
            take = remain
        }
        out = concat(out, substring(piece, local, local + take))
        i = i + take
    }
    return out
}

