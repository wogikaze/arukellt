    if chunk == 24 { return "__core_vec_set_impl" }
    return String_new()
}

fn core_op_registry_fallback_symbol_at(index: i32) -> String {
    if index < 0 || index >= 309 {
        return String_new()
    }
    let start = core_op_registry_fallback_symbol_off_at(index)
    let end = core_op_registry_fallback_symbol_off_at(index + 1)
    if start >= end {
        return String_new()
    }
    let start_chunk = start / 80
    let last = end - 1
    let end_chunk = last / 80
    if start_chunk == end_chunk {
        let piece = core_op_registry_fallback_symbol_data_chunk(start_chunk)
        let local = start - start_chunk * 80
        return substring(piece, local, local + (end - start))
    }
    let mut out = String_new()
    let mut i = start
    while i < end {
        let chunk = i / 80
        let local = i - chunk * 80
        let piece = core_op_registry_fallback_symbol_data_chunk(chunk)
        let avail = 80 - local
        let remain = end - i
        let mut take = avail
        if remain < avail {
            take = remain
        }
        out = concat(out, substring(piece, local, local + take))
        i = i + take
    }
    return out
}

fn core_op_registry_has_fallback_symbol(symbol: String) -> bool {
    let count = core_op_registry_entry_count()
    let mut index = 0
    while index < count {
        if eq(clone(symbol), core_op_registry_fallback_symbol_at(index)) {
            return true
        }
        index = index + 1
    }
    false
}

