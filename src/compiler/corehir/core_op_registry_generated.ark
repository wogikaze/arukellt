fn core_op_registry_bucket_at(index: i32) -> i32 {
    if index < 0 || index >= 1024 {
        return 0 - 1
    }
    let chunk = index / 16
    let local = index - chunk * 16
    return table_blob::table_blob_i32_from_hex8(core_op_registry_bucket_hex_chunk(chunk), local * 8)
}

fn core_op_registry_lookup_index(name: String) -> i32 {
    let capacity = 1024
    let fnv_offset = 216613626
    let fnv_prime = 16777619
    let mut hash = fnv_offset
    let name_len = len(name)
    let mut hi = 0
    while hi < name_len {
        hash = hash * fnv_prime ^ char_at(name, hi)
        if hash < 0 {
            hash = 0 - hash
        }
        hi = hi + 1
    }
    if hash < 0 {
        hash = 0
    }
    let mut slot = hash % capacity
    let mut probes = 0
    while probes < capacity {
        let idx = core_op_registry_bucket_at(slot)
        if idx < 0 {
            return 0 - 1
        }
        if eq(clone(name), core_op_registry_canonical_id_at(idx)) {
            return idx
        }
        slot = (slot + 1) % capacity
        probes = probes + 1
    }
    return 0 - 1
}
