struct CoreHirMirSignatureSource {
    fn_infos: Vec<CoreHirFnInfo>,
    method_infos: Vec<CoreHirMethodInfo>,
    // 1-based index into fn_infos, keyed by decl_index. Built once.
    fn_info_by_decl: Vec<i32>,
}

fn CoreHirMirSignatureSource_new(fn_infos: Vec<CoreHirFnInfo>, method_infos: Vec<CoreHirMethodInfo>) -> CoreHirMirSignatureSource {
    let slots = fn_info_decl_slots(fn_infos)
    CoreHirMirSignatureSource {
        fn_infos: fn_infos,
        method_infos: method_infos,
        fn_info_by_decl: slots
    }
}

fn fn_info_decl_slots(fn_infos: Vec<CoreHirFnInfo>) -> Vec<i32> {
    let count = len(fn_infos)
    let mut max_decl = 0
    let mut i = 0
    while i < count {
        let decl_index = get_unchecked(fn_infos, i).decl_index
        if decl_index > max_decl {
            max_decl = decl_index
        }
        i = i + 1
    }
    let slots = Vec::new<i32>()
    let mut s = 0
    while s <= max_decl {
        push(slots, 0)
        s = s + 1
    }
    i = 0
    while i < count {
        let decl_index = get_unchecked(fn_infos, i).decl_index
        if decl_index >= 0 {
            set(slots, decl_index, i + 1)
        }
        i = i + 1
    }
    slots
}

fn mir_signature_source_fn_infos(source: CoreHirMirSignatureSource) -> Vec<CoreHirFnInfo> {
    source.fn_infos
}

fn mir_signature_source_method_infos(source: CoreHirMirSignatureSource) -> Vec<CoreHirMethodInfo> {
    source.method_infos
}

fn mir_signature_source_fn_info_by_decl(source: CoreHirMirSignatureSource) -> Vec<i32> {
    source.fn_info_by_decl
}
