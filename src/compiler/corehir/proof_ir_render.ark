use corehir::body_table
use corehir::fn_info
use corehir::param
use corehir::proof_contract
use corehir::proof_contracts
use corehir::proof_json_escape
use corehir::raw_decls
use corehir::raw_record
use corehir::raw_types
use typechecker::contract_typed_fn
use typechecker::names

pub fn render_proof_ir(
    program: CoreHirRawProgram,
    checked_contracts: Vec<CheckedProofContract>,
    source_file: String
) -> String {
    let table = raw_record::raw_program_body_table(program)
    render_proof_ir_document(
        raw_decls::program_fn_infos(program),
        raw_types::program_typed_fns(program),
        body_table::corehir_body_table_fn_body_roots(table),
        proof_contracts::build_checked_proof_contracts(checked_contracts),
        source_file
    )
}

pub fn render_proof_ir_document(
    fn_infos: Vec<CoreHirFnInfo>,
    typed_fns: Vec<TypedFn>,
    fn_body_roots: Vec<i32>,
    contracts: Vec<CoreHirProofContract>,
    source_file: String
) -> String {
    let file_name = if len(clone(source_file)) > 0 {
        source_file
    } else {
        String_from("<memory>")
    }
    let mut out = String_from(
        "{\"schema\":\"arukellt-proof-ir\",\"schema_version\":1,\"generator\":\"arukellt-selfhost\",\"module\":"
    )
    out = concat(out, proof_json_escape::quote_json(clone(file_name)))
    out = concat(out, String_from(",\"functions\":["))
    let mut first = true
    let fn_count = len(fn_infos)
    let mut function_index = 0
    while function_index < fn_count {
        if function_contract_count(contracts, function_index) > 0 {
            if !first {
                out = concat(out, String_from(","))
            }
            out = concat(
                out,
                render_function(
                    fn_infos,
                    typed_fns,
                    fn_body_roots,
                    contracts,
                    function_index,
                    clone(file_name)
                )
            )
            first = false
        }
        function_index = function_index + 1
    }
    out = concat(out, String_from("]}"))
    __intrinsic_eprintln(clone(out))
    out
}

fn function_contract_count(
    contracts: Vec<CoreHirProofContract>,
    function_index: i32
) -> i32 {
    let count = len(contracts)
    let mut matched = 0
    let mut i = 0
    while i < count {
        let contract = get_unchecked(contracts, i)
        if proof_contract::CoreHirProofContract_function_index(contract) == function_index {
            matched = matched + 1
        }
        i = i + 1
    }
    matched
}

fn render_function(
    fn_infos: Vec<CoreHirFnInfo>,
    typed_fns: Vec<TypedFn>,
    fn_body_roots: Vec<i32>,
    contracts: Vec<CoreHirProofContract>,
    function_index: i32,
    source_file: String
) -> String {
    let mut name = fn_info::fn_info_qualified_name_at(
        fn_infos,
        function_index,
        String_new()
    )
    if len(clone(name)) == 0 {
        name = fn_info::fn_info_name_at(
            fn_infos,
            function_index,
            String_from("<unknown>")
        )
    }
    let typed_index = fn_info::fn_info_typed_index_at(
        fn_infos,
        function_index,
        0 - 1
    )
    let mut out = concat(String_from("{\"id\":"), to_string(function_index))
    out = concat(
        out,
        concat(String_from(",\"name\":"), proof_json_escape::quote_json(name))
    )
    out = concat(out, String_from(",\"parameters\":["))
    out = concat(
        out,
        render_parameters(fn_infos, typed_fns, function_index, typed_index)
    )
    out = concat(
        out,
        concat(
            String_from("],\"return_type\":"),
            proof_json_escape::quote_json(return_type_name(typed_fns, typed_index))
        )
    )
    out = concat(out, String_from(",\"contracts\":["))
    out = concat(out, render_contracts(contracts, function_index, source_file))
    let body_root = if function_index >= 0 && function_index < len(fn_body_roots) {
        get_unchecked(fn_body_roots, function_index)
    } else {
        0 - 1
    }
    out = concat(
        out,
        concat(
            String_from("],\"body\":{\"kind\":\"opaque\",\"corehir_body_id\":"),
            concat(to_string(body_root), String_from("}}"))
        )
    )
    out
}

fn render_parameters(
    fn_infos: Vec<CoreHirFnInfo>,
    typed_fns: Vec<TypedFn>,
    function_index: i32,
    typed_index: i32
) -> String {
    let count = fn_info::fn_info_param_count_at(fn_infos, function_index, 0)
    let mut out = String_new()
    let mut i = 0
    while i < count {
        if i > 0 {
            out = concat(out, String_from(","))
        }
        let parameter = fn_info::fn_info_param_at(fn_infos, function_index, i)
        out = concat(
            out,
            concat(
                String_from("{\"name\":"),
                proof_json_escape::quote_json(param::param_name(parameter))
            )
        )
        out = concat(
            out,
            concat(
                String_from(",\"type\":"),
                proof_json_escape::quote_json(
                    parameter_type_name(parameter, typed_fns, typed_index, i)
                )
            )
        )
        out = concat(out, String_from("}"))
        i = i + 1
    }
    out
}

fn parameter_type_name(
    parameter: CoreHirParam,
    typed_fns: Vec<TypedFn>,
    typed_index: i32,
    param_index: i32
) -> String {
    let stored = param::param_type_name(parameter)
    if len(clone(stored)) > 0 {
        return stored
    }
    if typed_index >= 0 && typed_index < len(typed_fns) {
        let typed_fn = get_unchecked(typed_fns, typed_index)
        let param_types = contract_typed_fn::TypedFn_param_types(typed_fn)
        if param_index >= 0 && param_index < len(param_types) {
            return names::type_display_name(get_unchecked(param_types, param_index))
        }
    }
    String_from("unknown")
}

fn return_type_name(typed_fns: Vec<TypedFn>, typed_index: i32) -> String {
    if typed_index >= 0 && typed_index < len(typed_fns) {
        let typed_fn = get_unchecked(typed_fns, typed_index)
        return names::type_display_name(
            contract_typed_fn::TypedFn_return_type(typed_fn)
        )
    }
    String_from("unknown")
}

fn render_contracts(
    contracts: Vec<CoreHirProofContract>,
    function_index: i32,
    source_file: String
) -> String {
    let count = len(contracts)
    let mut out = String_new()
    let mut first = true
    let mut i = 0
    while i < count {
        let contract = get_unchecked(contracts, i)
        if proof_contract::CoreHirProofContract_function_index(contract) == function_index {
            if !first {
                out = concat(out, String_from(","))
            }
            out = concat(out, render_contract(contract, clone(source_file)))
            first = false
        }
        i = i + 1
    }
    out
}

fn render_contract(
    contract: CoreHirProofContract,
    source_file: String
) -> String {
    let kind = proof_contract::CoreHirProofContract_kind(contract)
    let expression = proof_contract::CoreHirProofContract_expression(contract)
    let start = proof_contract::CoreHirProofContract_span_start(contract)
    let mut out = concat(
        String_from("{\"kind\":"),
        proof_json_escape::quote_json(clone(kind))
    )
    out = concat(
        out,
        concat(
            String_from(",\"expression\":"),
            proof_json_escape::quote_json(expression)
        )
    )
    if eq(clone(kind), String_from("ensures")) {
        out = concat(
            out,
            concat(
                String_from(",\"result_name\":"),
                proof_json_escape::quote_json(
                    proof_contract::CoreHirProofContract_result_name(contract)
                )
            )
        )
    }
    out = concat(
        out,
        concat(
            String_from(",\"span\":{\"file\":"),
            proof_json_escape::quote_json(source_file)
        )
    )
    out = concat(out, concat(String_from(",\"start\":"), to_string(start)))
    out = concat(
        out,
        concat(
            String_from(",\"end\":"),
            concat(to_string(start), String_from("}}"))
        )
    )
    out
}
