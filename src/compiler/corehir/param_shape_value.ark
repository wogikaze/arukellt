use std::prelude::{clone}
use corehir::decl_ann_name
use corehir::frontend_ast_identity
use corehir::frontend_type_kind
use corehir::param_shape_declared
use corehir::param_shape_node
use corehir::value_types
fn fn_param_value_type(
    node: AstNode,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> i32 {
    if param_shape_node::param_has_type_ann(node) {
        return param_ann_value_type(
            param_shape_node::param_type_ann(node),
            type_params,
            nominal_types
        )
    }
    value_types::VT_I32()
}

fn method_param_value_type(
    node: AstNode,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> i32 {
    if param_shape_node::param_has_type_ann(node) {
        return param_ann_value_type(
            param_shape_node::param_type_ann(node),
            type_params,
            nominal_types
        )
    }
    value_types::VT_I32()
}

fn param_ann_value_type(
    ann: AstNode,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> i32 {
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(ann)) {
        return value_types::VT_FUNCREF()
    }
    if decl_ann_name::decl_ann_is_name(ann, "f64") {
        return value_types::VT_F64()
    }
    if decl_ann_name::decl_ann_is_name(ann, "f32") {
        return value_types::VT_F32()
    }
    if decl_ann_name::decl_ann_is_name(ann, "v128") {
        return value_types::VT_V128()
    }
    if decl_ann_name::decl_ann_is_name(ann, "i64") || decl_ann_name::decl_ann_is_name(ann, "u64") {
        return value_types::VT_I64()
    }
    if decl_ann_name::decl_ann_is_name(ann, "String") || decl_ann_name::decl_ann_is_name(ann, "string") {
        return value_types::VT_REF()
    }
    if decl_ann_name::decl_ann_is_name(ann, "i32") ||
    decl_ann_name::decl_ann_is_name(ann, "bool") ||
    decl_ann_name::decl_ann_is_name(ann, "char") ||
    decl_ann_name::decl_ann_is_name(ann, "u8") ||
    decl_ann_name::decl_ann_is_name(ann, "u16") ||
    decl_ann_name::decl_ann_is_name(ann, "u32") ||
    decl_ann_name::decl_ann_is_name(ann, "i8") ||
    decl_ann_name::decl_ann_is_name(ann, "i16") {
        return value_types::VT_I32()
    }
    // Named/generic user types (Range, VecIter, Option, Vec, ...) are GC refs.
    // Declared type parameters stay i32 until mono fills them (ADR-089:
    // declaration, not name shape, decides); a declared nominal type is a
    // concrete GC value even when its name is one uppercase letter.
    if decl_ann_name::decl_ann_is_named(ann) {
        let name = decl_ann_name::decl_ann_name(ann)
        if param_shape_declared::corehir_declared_type_param_contains(clone(type_params), clone(name)) {
            return value_types::VT_I32()
        }
        if param_shape_declared::corehir_nominal_types_contains(nominal_types, clone(name)) {
            return value_types::VT_GC_REF()
        }
        if param_ann_name_is_type_param(clone(name)) {
            return value_types::VT_I32()
        }
        return value_types::VT_GC_REF()
    }
    if decl_ann_name::decl_ann_is_generic(ann) {
        return value_types::VT_GC_REF()
    }
    if decl_ann_name::decl_ann_is_tuple(ann) {
        return value_types::VT_GC_REF()
    }
    value_types::VT_I32()
}

// Fallback for a name that neither a declared parameter list nor the
// declared nominal-type table mentions: keep the historical single-letter
// convention. A declared struct/enum is handled before this predicate.
fn param_ann_name_is_type_param(name: String) -> bool {
    if len(name) == 0 {
        return false
    }
    if clone(name).starts_with("?") {
        return param_ann_name_is_type_param(name.slice(1, len(name)))
    }
    if len(name) == 1 {
        let ch = name.byte_at(0)
        if ch >= 65 && ch <= 90 {
            return true
        }
    }
    false
}
