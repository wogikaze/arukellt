use corehir::decl_ann_member
use corehir::decl_ann_children
use corehir::decl_ann_name
use corehir::decl_node_identity
use corehir::semantic_trait_id
use corehir::type_ann_node

// Return the concrete type that owns methods in an impl block.
// - `impl Trait for Type` → Type (type_ann[1])
// - `impl Type { ... }` → Type (type_ann[0] or decl name)
fn impl_self_type_name(decl: AstNode) -> String {
    let ann_count = decl_ann_member::decl_ann_count(decl)
    if ann_count >= 2 {
        return impl_target_type_name(decl_ann_member::decl_ann_at(decl, 1))
    }
    if ann_count >= 1 {
        return impl_target_type_name(decl_ann_member::decl_ann_at(decl, 0))
    }
    return decl_node_identity::decl_name(decl)
}

fn impl_target_type_name(target: AstNode) -> String {
    let target_name = decl_ann_name::decl_ann_name(target)
    if eq(clone(target_name), String_from("Vec")) &&
    type_ann_node::type_ann_child_count(target) > 1 {
        let element = type_ann_node::type_ann_child_at(target, 1)
        if eq(type_ann_node::type_ann_name(element), String_from("String")) {
            return String_from("Vec_String")
        }
    }
    // Concrete HashMap<K, V> impls need a per-pair owner name so each impl
    // method registers a unique HashMap_K_V::method symbol. Generic impl
    // heads (HashMap<K, V> with type params) keep the bare HashMap owner.
    if eq(clone(target_name), String_from("HashMap")) &&
    type_ann_node::type_ann_child_count(target) > 2 {
        let key_node = type_ann_node::type_ann_child_at(target, 1)
        let value_node = type_ann_node::type_ann_child_at(target, 2)
        let key_name = type_ann_node::type_ann_name(key_node)
        let value_name = type_ann_node::type_ann_name(value_node)
        if type_ann_node::type_ann_is_named(key_node) &&
        type_ann_node::type_ann_is_named(value_node) &&
        !impl_type_param_name(clone(key_name)) &&
        !impl_type_param_name(clone(value_name)) {
            return concat(
                String_from("HashMap_"),
                concat(clone(key_name), concat(String_from("_"), clone(value_name)))
            )
        }
    }
    // Concrete user-generic impl targets need a per-instantiation owner so
    // each impl method registers a unique Name_arg::method symbol (the same
    // collision rule as HashMap_K_V). Type-parameter args keep the bare
    // owner because the impl itself is generic (impl Pair<T> -> Pair).
    // Vec and HashMap keep their established owner spellings above.
    if type_ann_node::type_ann_is_generic(target) &&
    !eq(clone(target_name), String_from("Vec")) &&
    !eq(clone(target_name), String_from("HashMap")) {
        let inst_suffix = impl_inst_arg_suffix(target)
        if len(inst_suffix) > 0 {
            return concat(
                clone(target_name),
                concat(String_from("_"), inst_suffix)
            )
        }
    }
    target_name
}

fn impl_type_param_name(name: String) -> bool {
    len(name) == 1 && byte_at(name, 0) >= 65 && byte_at(name, 0) <= 90
}

// Underscore-joined concrete key for the type arguments of a generic impl
// target, or "" when any argument is a type parameter or has no owner-key
// spelling. Children[0] is the head name, so iteration starts at 1.
fn impl_inst_arg_suffix(target: AstNode) -> String {
    let child_count = type_ann_node::type_ann_child_count(target)
    if child_count < 2 {
        return String_new()
    }
    let mut suffix = String_new()
    let mut i = 1
    while i < child_count {
        let key = impl_inst_arg_key(type_ann_node::type_ann_child_at(target, i))
        if len(key) == 0 {
            return String_new()
        }
        if len(suffix) > 0 {
            suffix = concat(suffix, String_from("_"))
        }
        suffix = concat(suffix, key)
        i = i + 1
    }
    suffix
}

fn impl_inst_arg_key(arg: AstNode) -> String {
    if type_ann_node::type_ann_is_named(arg) {
        let name = type_ann_node::type_ann_name(arg)
        if impl_type_param_name(clone(name)) {
            return String_new()
        }
        return name
    }
    if type_ann_node::type_ann_is_generic(arg) {
        let base = type_ann_node::type_ann_name(arg)
        let inner = impl_inst_arg_suffix(arg)
        if len(inner) == 0 {
            return String_new()
        }
        return concat(clone(base), concat(String_from("_"), inner))
    }
    // Function-typed arguments share one owner-key marker; the typechecker
    // and resolver owner names use the same fnref spelling.
    if len(type_ann_node::type_ann_function_ref_name(arg)) > 0 {
        return String_from("fnref")
    }
    String_new()
}

// Canonical SemanticTraitId for `impl Trait for Type`, or NONE for inherent impls.
fn impl_semantic_trait_id(decl: AstNode) -> i32 {
    let ann_count = decl_ann_member::decl_ann_count(decl)
    if ann_count < 2 {
        return semantic_trait_id::SEMANTIC_TRAIT_ID_NONE()
    }
    let trait_ann = decl_ann_member::decl_ann_at(decl, 0)
    semantic_trait_id::semantic_trait_id_from_trait_name(decl_ann_name::decl_ann_name(trait_ann))
}

// Trait implementations share the owner's public method namespace.  Conversion
// traits select an implementation from a source type, so their lowering name
// must retain that type to keep overloads distinct while preserving the
// source-level associated-function spelling.
fn impl_method_mangled_name(decl: AstNode, method_name: String) -> String {
    let owner_name = impl_self_type_name(decl)
    let base_name = concat(clone(owner_name), concat("::", clone(method_name)))
    let source_name = impl_conversion_source_type_name(decl)
    if len(source_name) == 0 {
        return base_name
    }
    concat(base_name, concat("__", source_name))
}

fn impl_conversion_source_type_name(decl: AstNode) -> String {
    if decl_ann_member::decl_ann_count(decl) < 2 {
        return String_new()
    }
    let trait_ann = decl_ann_member::decl_ann_at(decl, 0)
    let trait_name = decl_ann_name::decl_ann_name(trait_ann)
    if !eq(clone(trait_name), "From") && !eq(clone(trait_name), "FromIterator") ||
    decl_ann_children::decl_ann_child_count(trait_ann) < 2 {
        return String_new()
    }
    let source_ann = decl_ann_children::decl_ann_child_at(trait_ann, 1)
    let source_name = type_ann_node::type_ann_name(source_ann)
    if !type_ann_node::type_ann_is_generic(source_ann) {
        return source_name
    }
    let mut key = clone(source_name)
    let child_count = type_ann_node::type_ann_child_count(source_ann)
    let mut i = 1
    while i < child_count {
        // Nested generic sources need the same underscore key the impl-owner
        // and call-site lookups use: TakeIter<MapIter<String, String>>
        // registers from_iter__TakeIter_MapIter_String_String, not
        // from_iter__TakeIter_MapIter (#691).
        let child_key = impl_inst_arg_key(type_ann_node::type_ann_child_at(source_ann, i))
        if len(child_key) == 0 {
            return String_new()
        }
        key = concat(key, concat("_", child_key))
        i = i + 1
    }
    key
}
