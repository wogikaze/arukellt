use std::prelude::{byte_at}
use std::text
use corehir::decl_ann_member
use corehir::decl_ann_children
use corehir::decl_ann_name
use corehir::decl_node_identity
use corehir::frontend_ast_node
use corehir::frontend_kind_map
use corehir::semantic_trait_id
use corehir::type_ann_local_name
use corehir::type_ann_node

// Return the concrete type that owns methods in an impl block.
// - `impl Trait for Type` → Type (type_ann[1])
// - `impl Type { ... }` → Type (type_ann[0] or decl name)
// A generic binder (`impl<T: Bound> ...`) is metadata after the heads.
fn impl_head_count(decl: AstNode) -> i32 {
    let count = decl_ann_member::decl_ann_count(decl)
    if count >= 2 &&
    frontend_ast_node::corehir_node_kind(
        decl_ann_member::decl_ann_at(decl, 1)
    ) != frontend_kind_map::nk_impl_generics() {
        return 2
    }
    if count >= 1 {
        return 1
    }
    0
}

fn impl_self_type_name(decl: AstNode, known_type_names: Vec<String>) -> String {
    let heads = impl_head_count(decl)
    let target = if heads >= 2 {
        decl_ann_member::decl_ann_at(decl, 1)
    } else if heads >= 1 {
        decl_ann_member::decl_ann_at(decl, 0)
    } else {
        return decl_node_identity::decl_name(decl)
    }
    impl_target_type_name(target, effective_impl_param_names(decl, known_type_names))
}

// Local-type spelling of the impl head, including its type arguments
// (`G<T>`). The owner name above stays the bare owner for generic impls so
// every instantiation shares one symbol; a substituted `Self` return needs
// the instantiated spelling so MIR can bind the impl's type parameters.
fn impl_self_local_type_name(decl: AstNode, known_type_names: Vec<String>) -> String {
    let heads = impl_head_count(decl)
    if heads < 1 {
        return String_new()
    }
    let local_name = type_ann_local_name::type_ann_shape_local_type_name(
        decl_ann_member::decl_ann_at(decl, heads - 1),
        0
    )
    if len(local_name) > 0 {
        return local_name
    }
    impl_self_type_name(decl, known_type_names)
}

// ADR-089's ADR-014 migration window. During 0.x the retired binderless
// spelling keeps its meaning: a single-uppercase head name that the unit does
// not declare is a type parameter, and the typechecker emits W0222 with the
// binder form. Declared nominal names are never inferred, so the #946 fix
// (`impl Copy for S` for a declared `struct S`) stays in force. The window
// closes at 1.0.0: flip this to false so E0222 is the only path.
fn adr089_binder_window_is_open() -> bool {
    true
}

fn has_impl_binder(decl: AstNode) -> bool {
    let count = decl_ann_member::decl_ann_count(decl)
    let mut i = 0
    while i < count {
        let ann = decl_ann_member::decl_ann_at(decl, i)
        if frontend_ast_node::corehir_node_kind(ann) == frontend_kind_map::nk_impl_generics() {
            return true
        }
        i = i + 1
    }
    false
}

fn binder_impl_param_names(decl: AstNode) -> Vec<String> {
    let mut names = Vec::new<String>()
    let count = decl_ann_member::decl_ann_count(decl)
    let mut i = 0
    while i < count {
        let ann = decl_ann_member::decl_ann_at(decl, i)
        if frontend_ast_node::corehir_node_kind(ann) == frontend_kind_map::nk_impl_generics() {
            let param_count = decl_ann_children::decl_ann_child_count(ann)
            let mut j = 0
            while j < param_count {
                push(
                    names,
                    decl_ann_name::decl_ann_name(
                        decl_ann_children::decl_ann_child_at(ann, j)
                    )
                )
                j = j + 1
            }
        }
        i = i + 1
    }
    names
}

// Head names that the binder and the unit's declarations do not introduce.
// This is the diagnostic set: a binder-present head can also contain one, and
// the typechecker rejects that spelling rather than widening the binder.
fn undefined_impl_head_type_names(decl: AstNode, known_type_names: Vec<String>) -> Vec<String> {
    let heads = impl_head_count(decl)
    let declared = binder_impl_param_names(decl)
    let mut names = Vec::new<String>()
    if heads >= 1 {
        collect_undefined_head_type_names(
            decl_ann_member::decl_ann_at(decl, heads - 1),
            known_type_names,
            declared,
            names
        )
    }
    if heads >= 2 {
        // The trait head's base names a trait, not a type; only its type
        // arguments participate in type-name resolution here.
        let trait_head = decl_ann_member::decl_ann_at(decl, 0)
        let child_count = type_ann_node::type_ann_child_count(trait_head)
        let mut i = 1
        while i < child_count {
            collect_undefined_head_type_names(
                type_ann_node::type_ann_child_at(trait_head, i),
                known_type_names,
                declared,
                names
            )
            i = i + 1
        }
    }
    names
}

fn collect_undefined_head_type_names(
    node: AstNode,
    known: Vec<String>,
    declared: Vec<String>,
    mut names: Vec<String>
) {
    if type_ann_node::type_ann_is_named(node) {
        let name = type_ann_node::type_ann_name(node)
        if is_single_uppercase_name(name.clone()) &&
        !string_vec_contains(known, name.clone()) &&
        !string_vec_contains(declared, name.clone()) &&
        !string_vec_contains(names, name.clone()) {
            push(names, name.clone())
        }
    }
    let count = type_ann_node::type_ann_child_count(node)
    let mut i = 0
    while i < count {
        collect_undefined_head_type_names(
            type_ann_node::type_ann_child_at(node, i),
            known,
            declared,
            names
        )
        i = i + 1
    }
}

fn is_single_uppercase_name(name: String) -> bool {
    if len(name) != 1 {
        return false
    }
    let ch = byte_at(name, 0)
    ch >= 65 && ch <= 90
}

// The retired binderless spelling inferred parameters only when there was no
// binder; an explicit binder keeps its declared list.
fn window_implicit_param_names(decl: AstNode, known_type_names: Vec<String>) -> Vec<String> {
    if has_impl_binder(decl) || !adr089_binder_window_is_open() {
        return Vec::new<String>()
    }
    undefined_impl_head_type_names(decl, known_type_names)
}

// The parameters an impl actually carries: the binder plus, while the ADR-014
// window is open, the names the binderless spelling used to infer.
fn effective_impl_param_names(decl: AstNode, known_type_names: Vec<String>) -> Vec<String> {
    let mut names = binder_impl_param_names(decl)
    let implicit = window_implicit_param_names(decl, known_type_names)
    let count = len(implicit)
    let mut i = 0
    while i < count {
        let name = get_unchecked(implicit, i)
        if !string_vec_contains(names, name.clone()) {
            push(names, name.clone())
        }
        i = i + 1
    }
    names
}

fn string_vec_contains(names: Vec<String>, name: String) -> bool {
    let count = len(names)
    let mut i = 0
    while i < count {
        if get_unchecked(names, i).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn impl_target_type_name(target: AstNode, declared: Vec<String>) -> String {
    let target_name = decl_ann_name::decl_ann_name(target)
    if target_name.clone().eq(String_from("Vec")) &&
    type_ann_node::type_ann_child_count(target) > 1 {
        let element = type_ann_node::type_ann_child_at(target, 1)
        if type_ann_node::type_ann_name(element).eq(String_from("String")) {
            return String_from("Vec_String")
        }
    }
    // Concrete HashMap<K, V> impls need a per-pair owner name so each impl
    // method registers a unique HashMap_K_V::method symbol. Generic impl
    // heads (HashMap<K, V> with type params) keep the bare HashMap owner.
    if target_name.clone().eq(String_from("HashMap")) &&
    type_ann_node::type_ann_child_count(target) > 2 {
        let key_node = type_ann_node::type_ann_child_at(target, 1)
        let value_node = type_ann_node::type_ann_child_at(target, 2)
        let key_key = impl_inst_arg_key(key_node, declared.clone())
        let value_key = impl_inst_arg_key(value_node, declared.clone())
        if len(key_key) > 0 && len(value_key) > 0 {
            return String_from("HashMap_").concat(key_key.clone().concat(String_from("_").concat(value_key.clone())))
        }
    }
    // Concrete user-generic impl targets need a per-instantiation owner so
    // each impl method registers a unique Name_arg::method symbol (the same
    // collision rule as HashMap_K_V). Type-parameter args keep the bare
    // owner because the impl itself is generic (impl Pair<T> -> Pair).
    // Vec and HashMap keep their established owner spellings above.
    if type_ann_node::type_ann_is_generic(target) &&
    !target_name.clone().eq(String_from("Vec")) &&
    !target_name.clone().eq(String_from("HashMap")) {
        let inst_suffix = impl_inst_arg_suffix(target, declared.clone())
        if len(inst_suffix) > 0 {
            return target_name.clone().concat(String_from("_").concat(inst_suffix))
        }
    }
    target_name
}

fn is_declared_impl_param(name: String, declared: Vec<String>) -> bool {
    let count = len(declared)
    let mut i = 0
    while i < count {
        if get_unchecked(declared, i).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

// Underscore-joined concrete key for the type arguments of a generic impl
// target, or "" when any argument is a type parameter or has no owner-key
// spelling. Children[0] is the head name, so iteration starts at 1.
fn impl_inst_arg_suffix(target: AstNode, declared: Vec<String>) -> String {
    let child_count = type_ann_node::type_ann_child_count(target)
    if child_count < 2 {
        return String_new()
    }
    let mut suffix = String_new()
    let mut i = 1
    while i < child_count {
        let key = impl_inst_arg_key(
            type_ann_node::type_ann_child_at(target, i),
            declared.clone()
        )
        if len(key) == 0 {
            return String_new()
        }
        if len(suffix) > 0 {
            suffix = suffix.concat(String_from("_"))
        }
        suffix = suffix.concat(key)
        i = i + 1
    }
    suffix
}

fn impl_inst_arg_key(arg: AstNode, declared: Vec<String>) -> String {
    if type_ann_node::type_ann_is_named(arg) {
        let name = type_ann_node::type_ann_name(arg)
        if is_declared_impl_param(name.clone(), declared) {
            return String_new()
        }
        return name
    }
    if type_ann_node::type_ann_is_generic(arg) {
        let base = type_ann_node::type_ann_name(arg)
        let inner = impl_inst_arg_suffix(arg, declared)
        if len(inner) == 0 {
            return String_new()
        }
        return base.clone().concat(String_from("_").concat(inner))
    }
    // Function-typed arguments share one owner-key marker; the typechecker
    // and resolver owner names use the same fnref spelling.
    if len(type_ann_node::type_ann_function_ref_name(arg)) > 0 {
        return String_from("fnref")
    }
    String_new()
}

// Canonical SemanticTraitId for `impl Trait for Type`, or NONE for inherent impls.
fn impl_semantic_trait_id(decl: AstNode) -> i32 {
    if impl_head_count(decl) < 2 {
        return semantic_trait_id::SEMANTIC_TRAIT_ID_NONE()
    }
    let trait_ann = decl_ann_member::decl_ann_at(decl, 0)
    semantic_trait_id::semantic_trait_id_from_trait_name(decl_ann_name::decl_ann_name(trait_ann))
}

// Source-level spelling of an impl method (`Owner::method`), before the
// conversion-source suffix that keeps overloads distinct.
fn impl_method_base_name(decl: AstNode, method_name: String, known_type_names: Vec<String>) -> String {
    impl_self_type_name(decl, known_type_names).concat("::".concat(method_name.clone()))
}

// Trait implementations share the owner's public method namespace.  Conversion
// traits select an implementation from a source type, so their lowering name
// must retain that type to keep overloads distinct while preserving the
// source-level associated-function spelling.
fn impl_method_mangled_name(decl: AstNode, method_name: String, known_type_names: Vec<String>) -> String {
    let base_name = impl_method_base_name(decl, method_name.clone(), known_type_names.clone())
    let source_name = impl_conversion_source_type_name(decl, known_type_names)
    if len(source_name) == 0 {
        return base_name
    }
    base_name.concat("__".concat(source_name))
}

fn impl_conversion_source_type_name(decl: AstNode, known_type_names: Vec<String>) -> String {
    if impl_head_count(decl) < 2 {
        return String_new()
    }
    let declared = effective_impl_param_names(decl, known_type_names)
    let trait_ann = decl_ann_member::decl_ann_at(decl, 0)
    let trait_name = decl_ann_name::decl_ann_name(trait_ann)
    if !impl_conversion_trait_has_source_type(trait_name.clone()) ||
    decl_ann_children::decl_ann_child_count(trait_ann) < 2 {
        return String_new()
    }
    let source_ann = decl_ann_children::decl_ann_child_at(trait_ann, 1)
    let source_name = type_ann_node::type_ann_name(source_ann)
    if !type_ann_node::type_ann_is_generic(source_ann) {
        return source_name
    }
    let mut key = source_name.clone()
    let child_count = type_ann_node::type_ann_child_count(source_ann)
    let mut i = 1
    while i < child_count {
        // Nested generic sources need the same underscore key the impl-owner
        // and call-site lookups use: TakeIter<MapIter<String, String>>
        // registers from_iter__TakeIter_MapIter_String_String, not
        // from_iter__TakeIter_MapIter (#691).
        let child_key = impl_inst_arg_key(
            type_ann_node::type_ann_child_at(source_ann, i),
            declared.clone()
        )
        if len(child_key) == 0 {
            return String_new()
        }
        key = key.concat("_".concat(child_key))
        i = i + 1
    }
    key
}

// Traits whose impl is selected by a source type. TryInto is deliberately
// absent: ADR-084 defers its method form, and its mangled owner is the
// receiver rather than the conversion source.
fn impl_conversion_trait_has_source_type(trait_name: String) -> bool {
    trait_name.clone().eq("From") ||
    trait_name.clone().eq("FromIterator") ||
    trait_name.clone().eq("TryFrom")
}
