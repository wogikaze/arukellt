use corehir::frontend_bundle
use corehir::frontend_checked
use corehir::frontend_export_surface
use corehir::expr_raw
use corehir::mir_view
use corehir::raw_record

pub fn build_checked_program(decls: Vec<AstNode>, check_result: TypeCheckResult) -> CoreHirRawProgram {
    frontend_checked::build_checked_program(decls, check_result)
}

pub fn build_from_frontend_bundle(bundle: FrontendBundle) -> CoreHirRawProgram {
    frontend_checked::build_checked_program_from_bundle(bundle)
}

pub fn build_from_frontend_bundle_without_bodies(bundle: FrontendBundle) -> CoreHirRawProgram {
    frontend_checked::build_checked_program_from_bundle_without_bodies(bundle)
}

pub fn build_export_surface(decls: Vec<AstNode>) -> CoreHirExportSurface {
    frontend_export_surface::build_export_surface(decls)
}

pub fn mir_view_from_program(program: CoreHirRawProgram) -> CoreHirMirView {
    mir_view::mir_view_from_program(program)
}

pub fn view_body_source(view: CoreHirMirView) -> CoreHirMirBodySource {
    mir_view::view_body_source(view)
}

pub fn view_signature_source(view: CoreHirMirView) -> CoreHirMirSignatureSource {
    mir_view::view_signature_source(view)
}

pub fn view_type_source(view: CoreHirMirView) -> CoreHirMirTypeSource {
    mir_view::view_type_source(view)
}

pub fn view_decl_source(view: CoreHirMirView) -> CoreHirMirDeclSource {
    mir_view::view_decl_source(view)
}

pub fn raw_program_release_body_table(program: CoreHirRawProgram) {
    raw_record::corehir_raw_program_release_body_table(program)
}

pub fn view_layout_source(view: CoreHirMirView) -> CoreHirMirLayoutSource {
    mir_view::view_layout_source(view)
}

pub fn release_body_expr_subtree(exprs: Vec<CoreHirExpr>, root: i32) {
    if root < 0 || root >= len(exprs) {
        return
    }
    let pending = Vec::new<i32>()
    push(pending, root)
    while len(pending) > 0 {
        let current = pop(pending).unwrap()
        if current < 0 || current >= len(exprs) {
            continue
        }
        let expr = get_unchecked(exprs, current)
        let child_count = expr_raw::corehir_expr_child_count(expr)
        let mut child_index = 0
        while child_index < child_count {
            push(pending, expr_raw::corehir_expr_child(expr, child_index))
            child_index = child_index + 1
        }
        expr_raw::corehir_expr_release_payload(expr)
    }
}
