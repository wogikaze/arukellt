use parser::ast_node_record

fn corehir_node_kind(node: AstNode) -> i32 {
    node.kind
}

fn corehir_node_text(node: AstNode) -> String {
    clone(node.text)
}

fn corehir_node_is_pub(node: AstNode) -> bool {
    node.is_pub
}

fn corehir_node_is_component_export(node: AstNode) -> bool {
    node.is_component_export
}
