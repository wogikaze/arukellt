use collections::name_index
use corehir::decl_impl_target
use corehir::decl_member_collections
use corehir::decl_node
use corehir::decl_node_identity
use corehir::impl_method_identity
use corehir::method_info
use corehir::param_shape
use corehir::param_shape_declared
use corehir::return_type
use corehir::return_type_name
fn build_method_params(
    impl_node: AstNode,
    method: AstNode,
    param_count: i32,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> Vec<CoreHirParam> {
    let mut params = Vec::new<CoreHirParam>()
    let mut i = 0
    while i < param_count {
        params.push(param_shape::method_param_from_node(
                decl_member_collections::decl_method_at(method, i),
                type_params.clone(),
                nominal_types
            ))
        i = i + 1
    }
    params
}

fn build_method_infos(
    decls: Vec<AstNode>,
    nominal_types: CoreHirNominalTypes
) -> Vec<CoreHirMethodInfo> {
    let mut infos = Vec::new<CoreHirMethodInfo>()
    let known_type_names = param_shape_declared::corehir_nominal_type_names(nominal_types)
    // Flat impl method spellings repeat across modules; identity-name later
    // claims exactly like the checker's signature collection so the MIR
    // function index and the emitted symbol agree with the checker.
    let mut seen = name_index::NameIndex_empty()
    let decl_count = decls.len()
    let mut i = 0
    while i < decl_count {
        let decl = decls.get_unchecked(i)
        if decl_node::decl_is_impl(decl) {
            let owner_name = decl_impl_target::impl_self_type_name(decl, known_type_names.clone())
            let trait_id = decl_impl_target::impl_semantic_trait_id(decl)
            let method_count = decl_member_collections::decl_method_count(decl)
            let mut mi = 0
            while mi < method_count {
                let method = decl_member_collections::decl_method_at(decl, mi)
                let body_index = decl_member_collections::method_body_index(method)
                let param_count = decl_member_collections::method_param_count(method)
                let type_params = return_type_name::return_declared_type_params(
                    decl,
                    method,
                    known_type_names.clone()
                )
                let type_param_count = type_params.len()
                let params = build_method_params(
                    decl,
                    method,
                    param_count,
                    type_params.clone(),
                    nominal_types
                )
                let method_name = decl_node_identity::method_name(method)
                let flat_mangled = decl_impl_target::impl_method_mangled_name(
                    decl,
                    method_name.clone(),
                    known_type_names.clone()
                )
                let mangled = impl_method_identity::impl_method_emitted_name(
                    seen,
                    flat_mangled,
                    i,
                    mi
                )
                let return_vt = return_type::return_value_type_tag_for_impl(
                    decl,
                    method,
                    known_type_names.clone()
                )
                let return_type_name = return_type::return_index_type_name_for_impl(
                    decl,
                    method,
                    known_type_names.clone()
                )
                infos.push(method_info::CoreHirMethodInfo_new(
                        i,
                        mi,
                        owner_name.clone(),
                        method_name,
                        mangled,
                        param_count,
                        type_param_count,
                        type_params.clone(),
                        params,
                        body_index,
                        return_vt,
                        return_type_name,
                        trait_id
                    ))
                mi = mi + 1
            }
        }
        i = i + 1
    }
    infos
}
