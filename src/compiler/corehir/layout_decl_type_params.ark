use corehir::layout_decl_record

fn layout_decl_type_param_count(decl: CoreHirLayoutDecl) -> i32 {
    layout_decl_record::layout_decl_type_param_count(decl)
}

fn layout_decl_type_param_at(decl: CoreHirLayoutDecl, index: i32) -> String {
    layout_decl_record::layout_decl_type_param_at(decl, index)
}
