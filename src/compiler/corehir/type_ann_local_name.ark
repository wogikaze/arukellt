use std::prelude::{eq}
use std::text
use corehir::type_ann_node
use corehir::hashmap_type_name
use corehir::frontend_ast_identity
use corehir::frontend_type_kind
fn type_ann_shape_local_type_name(ann: AstNode, known_struct_fields: i32) -> String {
    let ann_name = type_ann_node::type_ann_name(ann)
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(ann)) {
        // fn(...) -> R annotations spell their callback signature
        // (fnref/fnref2/fnrefss/fnrefsb/fnsig:) the same way fn params do —
        // the raw node text is always the opaque "fnref" marker, which
        // drops the return type and mis-types indirect-call results (#872).
        return type_ann_node::type_ann_function_ref_name(ann)
    }
    if type_ann_node::type_ann_is_generic(ann) {
        if eq(ann_name.clone(), "Vec") {
            if type_ann_node::type_ann_child_count(ann) >= 2 {
                let elem_ty = type_ann_node::type_ann_child_at(ann, 1)
                // Vec<(A, B)> elements are heap tuples; keep the tuple:<a,b>
                // struct spelling so emit picks the GC-ref element layout and
                // destructure can recover field names (#888).
                if type_ann_node::type_ann_is_tuple(elem_ty) {
                    return String_from("vec:").concat(type_ann_node::type_ann_tuple_local_name(elem_ty))
                }
                // Shape nested Option/Result so Vec<Option<i32>> → vec:Option_i32
                // (bare vec:Option falls through to the i32-vec layout).
                if type_ann_node::type_ann_is_generic(elem_ty) {
                    let shaped = type_ann_shape_local_type_name(elem_ty, 0)
                    if len(shaped) > 0 {
                        return "vec:".concat(shaped)
                    }
                }
                return "vec:".concat(type_ann_node::type_ann_name(elem_ty))
            }
            return "vec"
        }
        if eq(ann_name.clone(), "HashMap") {
            if type_ann_node::type_ann_child_count(ann) >= 3 {
                let key = type_ann_node::type_ann_child_at(ann, 1)
                let val = type_ann_node::type_ann_child_at(ann, 2)
                let k_name = type_ann_node::type_ann_name(key)
                let v_name = type_ann_node::type_ann_name(val)
                return "hashmap:".concat(hashmap_type_name::hashmap_type_alias(k_name, v_name))
            }
            return "hashmap:"
        }
        if eq(ann_name.clone(), "Result") {
            if type_ann_node::type_ann_child_count(ann) >= 2 {
                let ok_ty = type_ann_node::type_ann_child_at(ann, 1)
                if type_ann_node::type_ann_is_name(ok_ty, "f64") {
                    return type_ann_shape_result_local_type_name(ann, "f64")
                }
                if type_ann_node::type_ann_is_name(ok_ty, "i64") {
                    return type_ann_shape_result_local_type_name(ann, "i64")
                }
                // Tuple Ok payloads keep their element spelling so
                // Result<(i32, i32), E> resolves the tuple payload layout
                // instead of collapsing to a unit/generic slot (#904).
                if type_ann_node::type_ann_is_tuple(ok_ty) {
                    return type_ann_shape_result_local_type_name(ann, type_ann_node::type_ann_tuple_local_name(ok_ty))
                }
                // Nested Vec so Result<Vec<fn>, E> → Result_vec:fn… (#832).
                if type_ann_node::type_ann_is_generic(ok_ty) {
                    let shaped = type_ann_shape_local_type_name(ok_ty, 0)
                    if len(shaped) > 0 {
                        return type_ann_shape_result_local_type_name(ann, shaped)
                    }
                }
                let ok_name = type_ann_node::type_ann_name(ok_ty)
                if len(ok_name) > 0 {
                    return type_ann_shape_result_local_type_name(ann, ok_name)
                }
            }
            return "enum:Result"
        }
        if eq(ann_name.clone(), "Option") {
            if type_ann_node::type_ann_child_count(ann) >= 2 {
                let some_ty = type_ann_node::type_ann_child_at(ann, 1)
                if type_ann_node::type_ann_is_name(some_ty, "f64") {
                    return "Option_f64"
                }
                if type_ann_node::type_ann_is_name(some_ty, "i64") {
                    return "Option_i64"
                }
                if type_ann_node::type_ann_is_name(some_ty, "i32") {
                    return "Option_i32"
                }
                // Tuple Some payloads keep their element spelling so
                // Option<(i32, i32)> resolves the tuple payload layout
                // instead of the generic ref slot (#904).
                if type_ann_node::type_ann_is_tuple(some_ty) {
                    return "Option_".concat(type_ann_node::type_ann_tuple_local_name(some_ty))
                }
                // Nested Vec so Option<Vec<fn>> → Option_vec:fn (#832).
                if type_ann_node::type_ann_is_generic(some_ty) {
                    let shaped = type_ann_shape_local_type_name(some_ty, 0)
                    if len(shaped) > 0 {
                        return "Option_".concat(shaped)
                    }
                }
                let some_name = type_ann_node::type_ann_name(some_ty)
                if len(some_name) > 0 {
                    return "Option_".concat(some_name)
                }
            }
            return "enum:Option"
        }
        // User-defined generic types (Pair<String>, MapIter<I>) keep their
        // argument list so MIR lowering can derive the substituted layout.
        return type_ann_generic_inst_local_name(ann)
    }
    if type_ann_node::type_ann_is_tuple(ann) {
        return type_ann_node::type_ann_tuple_local_name(ann)
    }
    if eq(ann_name.clone(), "Vec") {
        return "vec"
    }
    if eq(ann_name.clone(), "String") ||
    eq(ann_name.clone(), "str") ||
    eq(ann_name.clone(), "string") {
        return "String"
    }
    if eq(ann_name.clone(), "char") ||
    eq(ann_name.clone(), "u8") ||
    eq(ann_name.clone(), "i8") ||
    eq(ann_name.clone(), "u16") ||
    eq(ann_name.clone(), "u32") ||
    eq(ann_name.clone(), "u64") ||
    eq(ann_name.clone(), "i16") ||
    eq(ann_name.clone(), "i32") ||
    eq(ann_name.clone(), "i64") ||
    eq(ann_name.clone(), "bool") ||
    eq(ann_name.clone(), "f64") ||
    eq(ann_name.clone(), "f32") {
        return ann_name
    }
    if known_struct_fields > 0 {
        return ann_name
    }
    String_new()
}

fn type_ann_shape_local_type_arg(ann: AstNode) -> String {
    if type_ann_node::type_ann_is_generic(ann) {
        let shaped = type_ann_shape_local_type_name(ann, 0)
        if len(shaped) > 0 {
            return shaped
        }
    }
    if type_ann_node::type_ann_is_tuple(ann) {
        return type_ann_node::type_ann_tuple_local_name(ann)
    }
    type_ann_node::type_ann_name(ann)
}

fn type_ann_shape_result_local_type_name(ann: AstNode, ok_name: String) -> String {
    let mut normalized_ok_name = ok_name
    // The parser represents the unit type `()` with an empty node name.
    // Keep it explicit in the compact Result_<ok>_<err> encoding so the
    // separator cannot make an Ok(()) payload look like the Err type.
    if len(normalized_ok_name) == 0 {
        normalized_ok_name = String_from("unit")
    }
    if type_ann_node::type_ann_child_count(ann) >= 3 {
        let err_ty = type_ann_node::type_ann_child_at(ann, 2)
        let err_name = type_ann_shape_local_type_arg(err_ty)
        if len(err_name) > 0 {
            return "Result_".concat(normalized_ok_name.concat("_".concat(err_name)))
        }
    }
    "Result_".concat(normalized_ok_name)
}

// Canonical Name<arg,arg> spelling for user generic local type names.
// Arguments reuse the local-type shaping so Pair<Vec<i32>> stays
// Pair<vec:i32>, matching the field-type conventions used by layouts.
fn type_ann_generic_inst_local_name(ann: AstNode) -> String {
    let ann_name = type_ann_node::type_ann_name(ann)
    if len(ann_name) == 0 {
        return String_new()
    }
    let arg_count = type_ann_node::type_ann_child_count(ann)
    if arg_count < 2 {
        return String_new()
    }
    let mut out = ann_name.concat(String_from("<"))
    let mut i = 1
    while i < arg_count {
        let arg_name = type_ann_shape_local_type_arg(type_ann_node::type_ann_child_at(ann, i))
        if len(arg_name) == 0 {
            return String_new()
        }
        if i > 1 {
            out = out.concat(String_from(","))
        }
        out = out.concat(arg_name)
        i = i + 1
    }
    out.concat(String_from(">"))
}
