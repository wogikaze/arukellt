use corehir::body_table
use corehir::proof_ast_render
use corehir::proof_contract
use typechecker::contract_proof

fn append_checked_proof_contracts(
    table: CoreHirBodyTable,
    contracts: Vec<CheckedProofContract>
) {
    let count = len(contracts)
    let mut i = 0
    while i < count {
        let checked = get_unchecked(contracts, i)
        body_table::corehir_body_table_push_proof_contract(
            table,
            proof_contract::CoreHirProofContract_new(
                contract_proof::CheckedProofContract_function_index(checked),
                contract_proof::CheckedProofContract_kind(checked),
                proof_ast_render::proof_ast_render(
                    contract_proof::CheckedProofContract_condition(checked)
                ),
                contract_proof::CheckedProofContract_result_name(checked),
                contract_proof::CheckedProofContract_span_start(checked)
            )
        )
        i = i + 1
    }
}
