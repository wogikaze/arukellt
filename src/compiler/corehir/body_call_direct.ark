use std::text
use corehir::expr_factory
use corehir::expr_builder_calls
use corehir::expr_predicates
use corehir::expr_node_access
use corehir::expr_node_predicates
use corehir::type_ann_node
use corehir::frontend_ast_identity
use corehir::frontend_type_kind
fn corehir_call_callee_supported(callee: AstNode) -> bool {
    // Call-expression callees (id(f)(x), get_unchecked(fs,0)(x)) lower via call_ref (#832).
    expr_node_predicates::expr_is_ident(callee) ||
    expr_node_predicates::expr_is_path(callee) ||
    expr_node_predicates::expr_is_call(callee)
}

fn corehir_build_call_expr(mut table: CoreHirBodyTable, node: AstNode) -> i32 {
    let child_count = expr_node_access::expr_child_count(node)
    if child_count < 1 {
        return corehir_push_expr(table, expr_factory::CoreHirExpr_unsupported(expr_node_access::expr_span_start(node)))
    }
    let callee = expr_node_access::expr_child_at(node, 0)
    if !corehir_call_callee_supported(callee) {
        return corehir_push_expr(table, expr_factory::CoreHirExpr_unsupported(expr_node_access::expr_span_start(node)))
    }
    let mut children = Vec::new<i32>()
    let mut i = 0
    let mut unsupported = false
    while i < child_count {
        let child = expr_node_access::expr_child_at(node, i)
        let child_index = corehir_build_expr(table, child)
        children.push(child_index)
        let child_expr = corehir_body_expr_at(table, child_index)
        if expr_predicates::expr_is_unsupported(child_expr) {
            unsupported = true
        }
        i = i + 1
    }
    if unsupported {
        return corehir_push_expr(table, expr_factory::CoreHirExpr_unsupported(expr_node_access::expr_span_start(node)))
    }
    corehir_push_expr(
        table,
        expr_builder_calls::corehir_expr_call(
            corehir_direct_call_callee_name(callee),
            expr_node_access::expr_span_start(node),
            children
        )
    )
}

fn corehir_direct_call_callee_name(callee: AstNode) -> String {
    let callee_name = expr_node_access::expr_text(callee)
    if callee_name.clone().eq("HashMap::new") {
        return corehir_hashmap_constructor_name(callee, String_from("new"))
    }
    if callee_name.clone().eq("HashMap::with_capacity") {
        return corehir_hashmap_constructor_name(callee, String_from("with_capacity"))
    }
    if !callee_name.clone().eq("Vec::new") &&
    !callee_name.clone().eq("Vec::with_capacity") {
        return callee_name
    }
    if expr_node_access::expr_child_count(callee) < 2 {
        return callee_name
    }
    let element_type = expr_node_access::expr_child_at(callee, 1)
    // fn turbofish elements record no mono instance (#845); spell the
    // constructor suffix fnref anyway so vec:fnref reaches the result
    // local instead of the i32 specialization fallback (#874).
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(element_type)) {
        if callee_name.clone().eq("Vec::new") {
            return String_from("Vec__new__fnref")
        }
        return String_from("Vec__with_capacity__fnref")
    }
    if !type_ann_node::type_ann_is_named(element_type) {
        return callee_name
    }
    let element_name = type_ann_node::type_ann_name(element_type)
    if element_name.len() == 0 || element_name.clone().contains("::") {
        return callee_name
    }
    let constructor = if callee_name.clone().eq("Vec::new") {
        "Vec__new__"
    } else {
        "Vec__with_capacity__"
    }
    constructor.concat(element_name)
}

fn corehir_hashmap_constructor_name(callee: AstNode, ctor_name: String) -> String {
    let source_name = String_from("HashMap::").concat(ctor_name.clone())
    if expr_node_access::expr_child_count(callee) < 3 {
        return source_name
    }
    let key_node = expr_node_access::expr_child_at(callee, 1)
    let value_node = expr_node_access::expr_child_at(callee, 2)
    let key_name = corehir_hashmap_ctor_type_arg_name(key_node)
    let value_name = corehir_hashmap_ctor_type_arg_name(value_node)
    if key_name.len() == 0 || value_name.len() == 0 ||
    key_name.clone().contains("::") || value_name.clone().contains("::") {
        return source_name
    }
    let pair = String_from("__").concat(key_name.concat(String_from("__").concat(value_name)))
    String_from("HashMap__").concat(ctor_name.concat(pair))
}

// Same spelling rule as mir_hashmap_ctor_type_arg_name: fn(i32) -> i32
// uses the mono_type_key form so the constructor rewrite matches (#691).
fn corehir_hashmap_ctor_type_arg_name(node: AstNode) -> String {
    if type_ann_node::type_ann_is_named(node) {
        return type_ann_node::type_ann_name(node)
    }
    if type_ann_node::type_ann_is_i32_i32_fn(node) {
        return String_from("fn_i32_i32_")
    }
    String_new()
}
