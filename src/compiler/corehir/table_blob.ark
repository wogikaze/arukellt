// Hex-packed i32 tables for generated CoreOp data.
// `_at` indexes a static chunk; it does not rebuild a Vec.

fn table_blob_hex_nibble(code: i32) -> i32 {
    if code >= 48 && code <= 57 {
        return code - 48
    }
    if code >= 97 && code <= 102 {
        return code - 87
    }
    0
}

fn table_blob_hex_byte(hex: String, offset: i32) -> i32 {
    table_blob_hex_nibble(char_at(hex, offset)) * 16 + table_blob_hex_nibble(char_at(hex, offset + 1))
}

fn table_blob_i32_from_hex8(hex: String, offset: i32) -> i32 {
    let b0 = table_blob_hex_byte(clone(hex), offset)
    let b1 = table_blob_hex_byte(clone(hex), offset + 2)
    let b2 = table_blob_hex_byte(clone(hex), offset + 4)
    let b3 = table_blob_hex_byte(hex, offset + 6)
    b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}
