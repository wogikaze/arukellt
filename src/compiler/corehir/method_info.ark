use corehir::param
use corehir::semantic_trait_id
use corehir::value_types
struct CoreHirMethodInfo {
    impl_decl_index: i32,
    method_index: i32,
    owner_name: String,
    name: String,
    mangled_name: String,
    param_count: i32,
    type_param_count: i32,
    type_params: Vec<String>,
    params: Vec<CoreHirParam>,
    body_index: i32,
    return_vt: i32,
    return_type_name: String,
    trait_id: i32,
}

fn CoreHirMethodInfo_new(
    impl_decl_index: i32,
    method_index: i32,
    owner_name: String,
    name: String,
    mangled_name: String,
    param_count: i32,
    type_param_count: i32,
    type_params: Vec<String>,
    params: Vec<CoreHirParam>,
    body_index: i32,
    return_vt: i32,
    return_type_name: String,
    trait_id: i32
) -> CoreHirMethodInfo {
    CoreHirMethodInfo {
        impl_decl_index: impl_decl_index,
        method_index: method_index,
        owner_name: owner_name,
        name: name,
        mangled_name: mangled_name,
        param_count: param_count,
        type_param_count: type_param_count,
        type_params: type_params,
        params: params,
        body_index: body_index,
        return_vt: return_vt,
        return_type_name: return_type_name,
        trait_id: trait_id
    }
}

fn method_info_index_for_method(method_infos: Vec<CoreHirMethodInfo>, impl_decl_index: i32, method_index: i32) -> i32 {
    let count = method_infos.len()
    let mut i = 0
    while i < count {
        let info = get_unchecked(method_infos, i)
        if info.impl_decl_index == impl_decl_index && info.method_index == method_index {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn method_info_mangled_name_at(method_infos: Vec<CoreHirMethodInfo>, info_index: i32, fallback: String) -> String {
    if info_index >= 0 && info_index < method_infos.len() {
        let info = get_unchecked(method_infos, info_index)
        return info.mangled_name.clone()
    }
    fallback
}

fn method_info_body_index_at(method_infos: Vec<CoreHirMethodInfo>, info_index: i32, fallback: i32) -> i32 {
    if info_index >= 0 && info_index < method_infos.len() {
        let info = get_unchecked(method_infos, info_index)
        return info.body_index
    }
    fallback
}

fn method_info_param_count_at(method_infos: Vec<CoreHirMethodInfo>, info_index: i32, fallback: i32) -> i32 {
    if info_index >= 0 && info_index < method_infos.len() {
        let info = get_unchecked(method_infos, info_index)
        return info.param_count
    }
    fallback
}

fn method_info_type_param_count_at(method_infos: Vec<CoreHirMethodInfo>, info_index: i32, fallback: i32) -> i32 {
    if info_index >= 0 && info_index < method_infos.len() {
        return get_unchecked(method_infos, info_index).type_param_count
    }
    fallback
}

// Declared binder names in the order the typechecker uses for MonoInstance
// type arguments (impl binders first, then method binders). Callers that
// build the ordinal mono map must use this list: a local-derived list drops
// an impl binder that the signature never mentions and shifts every later
// parameter key (#946).
fn method_info_type_params_at(method_infos: Vec<CoreHirMethodInfo>, info_index: i32) -> Vec<String> {
    if info_index >= 0 && info_index < method_infos.len() {
        return get_unchecked(method_infos, info_index).type_params
    }
    Vec::new<String>()
}

fn method_info_param_at(method_infos: Vec<CoreHirMethodInfo>, info_index: i32, param_index: i32) -> CoreHirParam {
    if info_index < 0 || info_index >= method_infos.len() {
        return param::CoreHirParam_new("", value_types::VT_I32(), "", "", false, false)
    }
    let info = get_unchecked(method_infos, info_index)
    if param_index < 0 || param_index >= info.params.len() {
        return param::CoreHirParam_new("", value_types::VT_I32(), "", "", false, false)
    }
    get_unchecked(info.params, param_index)
}

fn method_info_owner_name_for_impl(method_infos: Vec<CoreHirMethodInfo>, impl_decl_index: i32, fallback: String) -> String {
    let count = method_infos.len()
    let mut i = 0
    while i < count {
        let info = get_unchecked(method_infos, i)
        if info.impl_decl_index == impl_decl_index {
            return info.owner_name.clone()
        }
        i = i + 1
    }
    fallback
}

fn method_info_count_for_impl(method_infos: Vec<CoreHirMethodInfo>, impl_decl_index: i32) -> i32 {
    let count = method_infos.len()
    let mut total = 0
    let mut i = 0
    while i < count {
        let info = get_unchecked(method_infos, i)
        if info.impl_decl_index == impl_decl_index {
            total = total + 1
        }
        i = i + 1
    }
    total
}

fn method_info_return_vt_at(method_infos: Vec<CoreHirMethodInfo>, info_index: i32, fallback: i32) -> i32 {
    if info_index >= 0 && info_index < method_infos.len() {
        let info = get_unchecked(method_infos, info_index)
        return info.return_vt
    }
    fallback
}

fn method_info_return_type_name_at(method_infos: Vec<CoreHirMethodInfo>, info_index: i32, fallback: String) -> String {
    if info_index >= 0 && info_index < method_infos.len() {
        let info = get_unchecked(method_infos, info_index)
        return info.return_type_name.clone()
    }
    fallback
}

fn method_info_trait_id_at(method_infos: Vec<CoreHirMethodInfo>, info_index: i32) -> i32 {
    if info_index >= 0 && info_index < method_infos.len() {
        let info = get_unchecked(method_infos, info_index)
        return info.trait_id
    }
    semantic_trait_id::SEMANTIC_TRAIT_ID_NONE()
}
