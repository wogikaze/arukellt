use corehir::frontend
use corehir::frontend_bundle
use corehir::frontend_export_surface
use corehir::frontend_modules
use corehir::frontend_resolved_calls
use corehir::frontend_typed_locals
use corehir::type_facts
use typechecker::contract_result_state

fn build_checked_program_from_bundle(bundle: FrontendBundle) -> CoreHirRawProgram {
    build_checked_program_from_bundle_mode(bundle, true)
}

fn build_checked_program_from_bundle_without_bodies(bundle: FrontendBundle) -> CoreHirRawProgram {
    build_checked_program_from_bundle_mode(bundle, false)
}

fn build_checked_program_from_bundle_mode(bundle: FrontendBundle, include_bodies: bool) -> CoreHirRawProgram {
    let decls = frontend_bundle::bundle_decls(bundle)
    let check_result = frontend_bundle::bundle_check_result(bundle)
    let facts = type_facts::CoreHirTypeFacts_new(
        contract_result_state::typecheck_result_typed_fns(check_result),
        contract_result_state::typecheck_result_mono_instances(check_result)
    )
    let modules = frontend_modules::build_module_infos(
        frontend_bundle::bundle_module_names(bundle),
        frontend_bundle::bundle_module_decl_counts(bundle),
        frontend_bundle::bundle_module_stdlib_flags(bundle),
        decls.len()
    )
    // Checker resolutions are body-independent: the wasm32-gc path lowers
    // bodies from the AST fallback and does not build the CoreHIR body
    // artifact, but still needs the per-call owner table (#933).
    let resolved_calls = frontend_resolved_calls::resolved_calls_from_check_result(check_result)
    let typed_locals = if include_bodies {
        frontend_typed_locals::scan_typed_locals(decls)
    } else {
        Vec::new<CoreHirTypedLocal>()
    }
    frontend::build_program_from_facts_with_dto(
        decls,
        facts,
        modules,
        resolved_calls,
        typed_locals,
        frontend_export_surface::build_export_surface(frontend_bundle::bundle_export_decls(bundle)),
        include_bodies
    )
}

fn build_checked_program(decls: Vec<AstNode>, check_result: TypeCheckResult) -> CoreHirRawProgram {
    build_checked_program_from_bundle(frontend_bundle::FrontendBundle_new(
            decls,
            check_result,
            Vec::new<String>(),
            Vec::new<i32>(),
            Vec::new<bool>(),
            decls
        ))
}
