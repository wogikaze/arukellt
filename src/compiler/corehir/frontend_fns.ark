use std::prelude::{clone, eq}
use std::text
use corehir::decl_node_identity
use corehir::decl_children
use corehir::decl_member_collections
use corehir::decl_node
use corehir::fn_info
use corehir::frontend_ast_node
use corehir::frontend_kind_map
use corehir::param_shape
use corehir::raw_dto
fn find_entry_main_decl_index(decls: Vec<AstNode>) -> i32 {
    // `arukellt test` desugars test decls into `__test_<n>` fns plus a
    // synthesized `__test_main` (#719); it is the entry when present.
    let test_main = find_named_fn_decl_index(decls, "__test_main")
    if test_main >= 0 {
        return test_main
    }
    find_named_fn_decl_index(decls, "main")
}

fn find_named_fn_decl_index(decls: Vec<AstNode>, name: String) -> i32 {
    let mut entry_main_decl_index = 0 - 1
    let decl_count = len(decls)
    let mut i = 0
    while i < decl_count {
        let decl = get_unchecked(decls, i)
        if decl_node::decl_is_fn(decl) {
            if eq(decl_node_identity::decl_name(decl), clone(name)) {
                entry_main_decl_index = i
            }
        }
        i = i + 1
    }
    entry_main_decl_index
}

fn build_fn_params(decl: AstNode, param_count: i32) -> Vec<CoreHirParam> {
    let mut params = Vec::new<CoreHirParam>()
    let mut i = 0
    while i < param_count {
        push(params, param_shape::fn_param_from_node(decl_children::decl_child_at(decl, i)))
        i = i + 1
    }
    params
}

// Type-parameter names in declaration order, which is the order the
// typechecker uses for MonoInstance type args and mangled keys. The
// function's type annotations also carry the __return wrapper and proof
// contracts; neither is a type parameter.
pub fn build_fn_type_params(decl: AstNode) -> Vec<String> {
    let mut names = Vec::new<String>()
    let annotation_count = frontend_ast_node::corehir_node_type_ann_count(decl)
    let mut i = 0
    while i < annotation_count {
        let annotation = frontend_ast_node::corehir_node_type_ann_at(decl, i)
        if frontend_ast_node::corehir_node_kind(annotation) != frontend_kind_map::nk_proof_contract() {
            let annotation_name = frontend_ast_node::corehir_node_text(annotation)
            if !eq(clone(annotation_name), "__return") {
                push(names, annotation_name)
            }
        }
        i = i + 1
    }
    names
}

fn module_qualified_fn_name(modules: Vec<CoreHirModuleInfo>, decl_index: i32, fn_name: String) -> String {
    let module_count = len(modules)
    let mut module_index = 0
    while module_index < module_count {
        let module_info = get_unchecked(modules, module_index)
        let decl_start = raw_dto::CoreHirModuleInfo_decl_start(module_info)
        let decl_end = decl_start + raw_dto::CoreHirModuleInfo_decl_count(module_info)
        if decl_index >= decl_start && decl_index < decl_end {
            let module_name = clone(module_info.name)
            if !eq(clone(module_name), "<main>") {
                return module_name.concat("::".concat(fn_name))
            }
            return String_new()
        }
        module_index = module_index + 1
    }
    String_new()
}

// Whether the decl lives in a stdlib-loaded module. Defaults to false for
// <main> and decls outside every module range so user fns are never mistaken
// for CoreOp shim declarations.
fn module_fn_is_stdlib(modules: Vec<CoreHirModuleInfo>, decl_index: i32) -> bool {
    let module_count = len(modules)
    let mut module_index = 0
    while module_index < module_count {
        let module_info = get_unchecked(modules, module_index)
        let decl_start = raw_dto::CoreHirModuleInfo_decl_start(module_info)
        let decl_end = decl_start + raw_dto::CoreHirModuleInfo_decl_count(module_info)
        if decl_index >= decl_start && decl_index < decl_end {
            return raw_dto::CoreHirModuleInfo_is_stdlib(module_info)
        }
        module_index = module_index + 1
    }
    false
}

fn build_fn_infos(decls: Vec<AstNode>, modules: Vec<CoreHirModuleInfo>) -> Vec<CoreHirFnInfo> {
    let mut infos = Vec::new<CoreHirFnInfo>()
    let entry_main_decl_index = find_entry_main_decl_index(decls)
    let decl_count = len(decls)
    let mut typed_fn_index = 0
    let mut i = 0
    while i < decl_count {
        let decl = get_unchecked(decls, i)
        if decl_node::decl_is_fn(decl) {
            let body_index = decl_children::decl_body_index(decl)
            let param_count = decl_children::decl_param_count(decl)
            let params = build_fn_params(decl, param_count)
            let type_params = build_fn_type_params(decl)
            let fn_name = decl_node_identity::decl_name(decl)
            let info = fn_info::CoreHirFnInfo_new(
                i,
                typed_fn_index,
                clone(fn_name),
                module_qualified_fn_name(modules, i, fn_name),
                module_fn_is_stdlib(modules, i),
                param_count,
                params,
                type_params,
                body_index,
                i == entry_main_decl_index
            )
            push(infos, info)
            typed_fn_index = typed_fn_index + 1
        }
        // Note: impl methods do NOT get TypedFn entries (the typechecker only
        // appends TypedFn for top-level fn decls).  We must NOT increment
        // typed_fn_index for impl methods, otherwise the typed_fn_index stored
        // in CoreHirFnInfo will not match the actual index in the TypedFn array.
        i = i + 1
    }
    infos
}
