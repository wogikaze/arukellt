use std::prelude::{eq}
use std::text
use corehir::frontend_ast_identity
use corehir::frontend_type_kind
use corehir::type_ann_node
use corehir::hashmap_type_name
fn type_ann_shape_param_type_name(ty: AstNode) -> String {
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(ty)) {
        return type_ann_node::type_ann_function_ref_name(ty)
    }
    if type_ann_node::type_ann_is_generic(ty) {
        if type_ann_node::type_ann_is_name(ty, String_from("Vec")) && type_ann_node::type_ann_child_count(ty) >= 2 {
            let elem = type_ann_node::type_ann_child_at(ty, 1)
            // Vec<(A, B)> params keep the tuple:<k,...> element spelling so
            // the vec picks the GC-ref element layout; type_ann_name on a
            // tuple node is empty and collapses the elem to i32 (#888).
            if type_ann_node::type_ann_is_tuple(elem) {
                return String_from("vec:").concat(type_ann_node::type_ann_tuple_local_name(elem))
            }
            // Nested Vec<T>: recurse so Vec<Vec<i32>> → vec:vec:i32 and
            // get_unchecked/push recover T. Bare vec:Vec made every nested
            // vec element indistinguishable and pushed consumers onto a
            // vec:String guess (#922).
            if type_ann_node::type_ann_is_generic(elem) && type_ann_node::type_ann_is_name(elem, String_from("Vec")) {
                return String_from("vec:").concat(type_ann_shape_param_type_name(elem))
            }
            return String_from("vec:").concat(type_ann_node::type_ann_name(elem))
        }
        if type_ann_node::type_ann_is_name(ty, String_from("HashMap")) && type_ann_node::type_ann_child_count(ty) >= 3 {
            let key = type_ann_node::type_ann_child_at(ty, 1)
            let val = type_ann_node::type_ann_child_at(ty, 2)
            let k_name = type_ann_node::type_ann_name(key)
            let v_name = type_ann_node::type_ann_name(val)
            return String_from("hashmap:").concat(hashmap_type_name::hashmap_type_alias(k_name, v_name))
        }
        if type_ann_node::type_ann_is_name(ty, String_from("Option")) && type_ann_node::type_ann_child_count(ty) >= 2 {
            let elem = type_ann_node::type_ann_child_at(ty, 1)
            if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(elem)) ||
            eq(type_ann_node::type_ann_name(elem), String_from("fnref")) {
                return String_from("Option:fnref")
            }
            return String_from("Option:").concat(type_ann_node::type_ann_name(elem))
        }
        if type_ann_node::type_ann_is_name(ty, String_from("Result")) && type_ann_node::type_ann_child_count(ty) >= 3 {
            let ok_ty = type_ann_node::type_ann_child_at(ty, 1)
            let err_ty = type_ann_node::type_ann_child_at(ty, 2)
            return String_from("Result:").concat(type_ann_node::type_ann_name(ok_ty).concat(String_from(":").concat(type_ann_node::type_ann_name(err_ty))))
        }
        // User-defined generic types keep their argument list so MIR
        // lowering can derive the substituted layout (Pair<String>).
        let generic_name = type_ann_generic_inst_param_name(ty)
        if len(generic_name) > 0 {
            return generic_name
        }
    }
    if type_ann_node::type_ann_is_tuple(ty) && type_ann_node::type_ann_child_count(ty) == 2 {
        let a = type_ann_node::type_ann_child_at(ty, 0)
        let b = type_ann_node::type_ann_child_at(ty, 1)
        return String_from("Tuple:").concat(type_ann_node::type_ann_name(a).concat(String_from(":").concat(type_ann_node::type_ann_name(b))))
    }
    type_ann_node::type_ann_name(ty)
}

// Canonical Name<arg,arg> spelling for user generic parameter types.
fn type_ann_generic_inst_param_name(ty: AstNode) -> String {
    let arg_count = type_ann_node::type_ann_child_count(ty)
    if arg_count < 2 {
        return String_new()
    }
    let mut out = type_ann_node::type_ann_name(ty).concat(String_from("<"))
    let mut i = 1
    while i < arg_count {
        let arg_ty = type_ann_node::type_ann_child_at(ty, i)
        let arg_name = type_ann_shape_param_type_name(arg_ty)
        if len(arg_name) == 0 {
            return String_new()
        }
        if i > 1 {
            out = out.concat(String_from(","))
        }
        out = out.concat(arg_name)
        i = i + 1
    }
    out.concat(String_from(">"))
}
