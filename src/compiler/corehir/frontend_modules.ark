use corehir::raw_dto

fn build_module_infos(module_names: Vec<String>, module_decl_counts: Vec<i32>, module_stdlib_flags: Vec<bool>, total_decl_count: i32) -> Vec<CoreHirModuleInfo> {
    let mut infos = Vec::new<CoreHirModuleInfo>()
    let mut decl_offset = 0
    let module_count = module_names.len()
    let mut i = 0
    while i < module_count {
        let decl_count = get_unchecked(module_decl_counts, i)
        let mut is_stdlib = false
        if i < module_stdlib_flags.len() {
            is_stdlib = get_unchecked(module_stdlib_flags, i)
        }
        infos.push(raw_dto::CoreHirModuleInfo_new(get_unchecked(module_names, i), is_stdlib, decl_offset, decl_count))
        decl_offset = decl_offset + decl_count
        i = i + 1
    }
    let main_decl_count = total_decl_count - decl_offset
    if main_decl_count > 0 {
        infos.push(raw_dto::CoreHirModuleInfo_new("<main>", false, decl_offset, main_decl_count))
    }
    infos
}
