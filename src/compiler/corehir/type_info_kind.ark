use corehir::type_contracts
use corehir::kinds

fn type_info_tag_to_kind(tag: i32) -> i32 {
    if tag == 5 { return kinds::TYPE_KIND_STRING() }
    if tag == 10 { return kinds::TYPE_KIND_VEC() }
    if tag == 11 { return kinds::TYPE_KIND_OPTION() }
    if tag == 12 { return kinds::TYPE_KIND_RESULT() }
    if tag == 13 { return kinds::TYPE_KIND_HASHMAP() }
    if tag == 21 { return kinds::TYPE_KIND_STRUCT() }
    if tag == 22 { return kinds::TYPE_KIND_ENUM() }
    if tag == 23 { return kinds::TYPE_KIND_TUPLE() }
    if tag == 30 { return kinds::TYPE_KIND_TYPE_VAR() }
    kinds::TYPE_KIND_PRIMITIVE()
}

fn type_info_display_name(ty: TypeInfo) -> String {
    let tag = type_contracts::TypeInfo_tag(ty)
    if tag == 1 { return "i32" }
    if tag == 2 { return "i64" }
    if tag == 3 { return "f64" }
    if tag == 9 { return "f32" }
    if tag == 4 { return "bool" }
    if tag == 6 { return "char" }
    if tag == 5 { return "String" }
    if tag == 7 { return "()" }
    if tag == 0 { return "void" }
    if tag == 10 { return "Vec" }
    if tag == 11 { return "Option" }
    if tag == 12 { return "Result" }
    if tag == 13 { return "HashMap" }
    let name = type_contracts::TypeInfo_name(ty)
    if len(name) > 0 {
        return clone(name)
    }
    "i32"
}

fn type_info_display_name_from_tag(tag: i32) -> String {
    if tag == 1 { return "i32" }
    if tag == 2 { return "i64" }
    if tag == 3 { return "f64" }
    if tag == 9 { return "f32" }
    if tag == 4 { return "bool" }
    if tag == 6 { return "char" }
    if tag == 5 { return "String" }
    if tag == 7 { return "()" }
    if tag == 0 { return "void" }
    if tag == 10 { return "Vec" }
    if tag == 11 { return "Option" }
    if tag == 12 { return "Result" }
    if tag == 13 { return "HashMap" }
    if tag == 21 { return "struct" }
    if tag == 22 { return "enum" }
    if tag == 23 { return "tuple" }
    if tag == 30 { return "typevar" }
    concat("ty", to_string(tag))
}
