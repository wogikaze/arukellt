use corehir::kinds
use corehir::mir_value_type
use corehir::signature_entry
use corehir::type_id
use corehir::core_op_id
use collections::name_index
struct SignatureRegistry {
    entries: Vec<SignatureEntry>,
    id_to_mangled: Vec<String>,
    mangled_to_id: NameIndex,
    signature_only: Vec<bool>,
    next_id: i32,
}

fn SignatureRegistry_new() -> SignatureRegistry {
    SignatureRegistry {
        entries: Vec::new<SignatureEntry>(),
        id_to_mangled: Vec::new<String>(),
        mangled_to_id: name_index::NameIndex_new(8192),
        signature_only: Vec::new<bool>(),
        next_id: 0,
    }
}

fn signature_registry_entry_count(registry: SignatureRegistry) -> i32 {
    registry.entries.len()
}

fn signature_registry_register(mut registry: SignatureRegistry, entry: SignatureEntry, mangled_name: String) -> FunctionId {
    name_index::name_index_insert_first(registry.mangled_to_id, mangled_name.clone(), registry.next_id)
    push(registry.entries, entry)
    push(registry.id_to_mangled, mangled_name)
    push(registry.signature_only, false)
    let id = FunctionId_new(registry.next_id)
    registry.next_id = registry.next_id + 1
    id
}

// Decls whose Ark body is deferred (CoreOp shim / intrinsic stdlib rewrite)
// still register a signature so call sites typecheck, but they never produce
// a MirFunction. Same-name fid chains must skip them or an emitted user fn
// that shares the bare name (strings::repeat vs stdlib repeat, #920) binds
// the deferred decl's FunctionId and its own fid stays unmapped.
fn signature_registry_mark_signature_only(mut registry: SignatureRegistry, index: i32) {
    if index >= 0 && index < registry.signature_only.len() {
        set(registry.signature_only, index, true)
    }
}

fn signature_registry_is_signature_only(registry: SignatureRegistry, index: i32) -> bool {
    if index >= 0 && index < registry.signature_only.len() {
        return get_unchecked(registry.signature_only, index)
    }
    false
}

fn signature_registry_entry_at(registry: SignatureRegistry, index: i32) -> SignatureEntry {
    get_unchecked(registry.entries, index)
}

fn signature_registry_set_core_op_id_at(mut registry: SignatureRegistry, index: i32, core_op_id: CoreOpId) {
    let mut entry = get_unchecked(registry.entries, index)
    signature_entry::signature_entry_set_core_op_id(entry, core_op_id)
    set(registry.entries, index, entry)
}

fn signature_registry_mangled_at(registry: SignatureRegistry, index: i32) -> String {
    get_unchecked(registry.id_to_mangled, index)
}

fn signature_registry_lookup_by_mangled(registry: SignatureRegistry, mangled: String) -> FunctionId {
    let raw = name_index::name_index_get(registry.mangled_to_id, mangled)
    if raw >= 0 {
        return FunctionId_new(raw)
    }
    FUNCTION_ID_INVALID()
}

// Bind a qualified source name to an existing declaration entry.  Imported
// modules are lowered into one flat MIR module, so `module::f` and the emitted
// bare declaration `f` must share the same FunctionId.  Registering a second
// entry would break the FunctionId-to-body mapping and can turn a qualified
// forwarding call into recursion.
fn signature_registry_register_alias(mut registry: SignatureRegistry, alias: String, target: FunctionId) {
    let raw = FunctionId_raw(target)
    if raw < 0 || raw >= registry.entries.len() {
        return
    }
    // Qualified aliases must rebind an existing short-name collision.  The
    // source module qualifier is the disambiguating information; preserving
    // the first entry would make `text::is_empty` resolve to the generic Vec
    // implementation when `is_empty` was indexed earlier.
    name_index::name_index_set(registry.mangled_to_id, alias, raw)
}

fn signature_registry_register_core_op_alias(
    mut registry: SignatureRegistry,
    alias: String,
    coid: CoreOpId
) -> FunctionId {
    let receiver = mir_value_type::MirValueType_new(
        type_id::TYPE_ID_INVALID(),
        kinds::VALUE_REPR_SCALAR(),
        kinds::NULLABILITY_NOT_REF()
    )
    let entry = signature_entry::SignatureEntry_new(
        FunctionId_new(0),
        alias.clone(),
        Vec::new<MirValueType>(),
        Vec::new<MirValueType>(),
        false,
        receiver,
        0 - 1,
        0 - 1,
        0 - 1,
        kinds::ABI_KIND_CORE_OP_ALIAS(),
        coid
    )
    let id = signature_registry_register(registry, entry, alias.clone())
    // An alias can already point at a normal entry with a different CoreOp
    // identity (e.g. a bare prelude name versus a qualified module member).
    // insert_first keeps the old mapping, so explicitly rebind this alias to
    // the synthetic CoreOp entry.
    name_index::name_index_set(registry.mangled_to_id, alias, FunctionId_raw(id))
    id
}

fn signature_registry_lookup_by_id(registry: SignatureRegistry, id: FunctionId) -> SignatureEntry {
    let raw = FunctionId_raw(id)
    if raw >= 0 && raw < registry.entries.len() {
        return get_unchecked(registry.entries, raw)
    }
    signature_entry::SignatureEntry_new(
        FUNCTION_ID_INVALID(),
        String_new(),
        Vec::new<MirValueType>(),
        Vec::new<MirValueType>(),
        false,
        mir_value_type::MirValueType_new(type_id::TYPE_ID_INVALID(), 0, 0),
        0 - 1,
        0 - 1,
        0 - 1,
        kinds::ABI_KIND_NORMAL(),
        core_op_id::CORE_OP_ID_NONE()
    )
}

fn signature_registry_host_intrinsic_count(registry: SignatureRegistry) -> i32 {
    let count = registry.entries.len()
    let mut total = 0
    let mut i = 0
    while i < count {
        let entry = get_unchecked(registry.entries, i)
        if signature_entry::signature_entry_abi_kind(entry) == kinds::ABI_KIND_HOST_INTRINSIC() {
            total = total + 1
        }
        i = i + 1
    }
    total
}

fn signature_registry_builtin_count(registry: SignatureRegistry) -> i32 {
    let count = registry.entries.len()
    let mut total = 0
    let mut i = 0
    while i < count {
        let entry = get_unchecked(registry.entries, i)
        if signature_entry::signature_entry_abi_kind(entry) == kinds::ABI_KIND_BUILTIN() {
            total = total + 1
        }
        i = i + 1
    }
    total
}
