use corehir::decl_ann_children
use corehir::decl_ann_name
use corehir::frontend_ast_identity
use corehir::frontend_type_kind
use corehir::param_shape_node

fn param_named_local_type_name(ann: AstNode) -> String {
    if decl_ann_name::decl_ann_is_named(ann) {
        let name = decl_ann_name::decl_ann_name(ann)
        if !eq(clone(name), "i32") &&
        !eq(clone(name), "f64") &&
        !eq(clone(name), "i64") &&
        !eq(clone(name), "bool") &&
        !eq(clone(name), "String") &&
        !eq(clone(name), "u8") &&
        !eq(clone(name), "char") &&
        len(name) > 1 {
            return name
        }
    }
    String_new()
}

fn fn_param_local_type_name(node: AstNode) -> String {
    if !param_shape_node::param_has_type_ann(node) {
        return String_new()
    }
    let ann = param_shape_node::param_type_ann(node)
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(ann)) {
        return "fnref"
    }
    if decl_ann_name::decl_ann_is_generic(ann) {
        if decl_ann_name::decl_ann_is_name(ann, "HashMap") && decl_ann_children::decl_ann_child_count(ann) >= 3 {
            let key = decl_ann_children::decl_ann_child_at(ann, 1)
            let val = decl_ann_children::decl_ann_child_at(ann, 2)
            if decl_ann_name::decl_ann_is_name(key, "String") && decl_ann_name::decl_ann_is_name(val, "i32") {
                return "hashmap:si32"
            }
            if decl_ann_name::decl_ann_is_name(key, "i32") && decl_ann_name::decl_ann_is_name(val, "String") {
                return "hashmap:i32str"
            }
            if decl_ann_name::decl_ann_is_name(key, "String") && decl_ann_name::decl_ann_is_name(val, "String") {
                return "hashmap:strstr"
            }
            if decl_ann_name::decl_ann_is_name(key, "i32") && decl_ann_name::decl_ann_is_name(val, "i32") {
                return "hashmap:i32i32"
            }
            if decl_ann_name::decl_ann_is_name(key, "i32") && (
                frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(val)) ||
                decl_ann_name::decl_ann_is_name(val, "fnref")
            ) {
                return "hashmap:i32fn"
            }
            if decl_ann_name::decl_ann_is_name(key, "String") && (
                frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(val)) ||
                decl_ann_name::decl_ann_is_name(val, "fnref")
            ) {
                return "hashmap:strfn"
            }
        }
        if decl_ann_name::decl_ann_is_name(ann, "Vec") && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            let elem = decl_ann_children::decl_ann_child_at(ann, 1)
            return concat("vec:", decl_ann_name::decl_ann_name(elem))
        }
        if decl_ann_name::decl_ann_is_name(ann, "HashSet") && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            let elem = decl_ann_children::decl_ann_child_at(ann, 1)
            if decl_ann_name::decl_ann_is_name(elem, "String") {
                return "vec:String"
            }
            return "vec:i32"
        }
        if decl_ann_name::decl_ann_is_name(ann, "Option") && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            let elem2 = decl_ann_children::decl_ann_child_at(ann, 1)
            // Keep Option_i32/i64/f64 aliases for existing scalar match helpers,
            // and emit option:T for every other payload (String, structs, ...).
            if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(elem2)) {
                return "option:fnref"
            }
            if decl_ann_name::decl_ann_is_name(elem2, "i64") {
                return "Option_i64"
            }
            if decl_ann_name::decl_ann_is_name(elem2, "f64") {
                return "Option_f64"
            }
            if decl_ann_name::decl_ann_is_name(elem2, "i32") {
                return "Option_i32"
            }
            return concat("option:", decl_ann_name::decl_ann_name(elem2))
        }
        if decl_ann_name::decl_ann_is_name(ann, "Result") && decl_ann_children::decl_ann_child_count(ann) >= 3 {
            let ok_ty = decl_ann_children::decl_ann_child_at(ann, 1)
            let err_ty = decl_ann_children::decl_ann_child_at(ann, 2)
            return concat(
                "result:",
                concat(decl_ann_name::decl_ann_name(ok_ty), concat(":", decl_ann_name::decl_ann_name(err_ty)))
            )
        }
    } else {
        return param_named_local_type_name(ann)
    }
    String_new()
}

fn method_param_local_type_name(node: AstNode) -> String {
    if !param_shape_node::param_has_type_ann(node) {
        return String_new()
    }
    let ann = param_shape_node::param_type_ann(node)
    if decl_ann_name::decl_ann_is_generic(ann) {
        if decl_ann_name::decl_ann_is_name(ann, "HashMap") && decl_ann_children::decl_ann_child_count(ann) >= 3 {
            let key = decl_ann_children::decl_ann_child_at(ann, 1)
            let val = decl_ann_children::decl_ann_child_at(ann, 2)
            if decl_ann_name::decl_ann_is_name(key, "String") && decl_ann_name::decl_ann_is_name(val, "i32") {
                return "hashmap:si32"
            }
            if decl_ann_name::decl_ann_is_name(key, "i32") && decl_ann_name::decl_ann_is_name(val, "String") {
                return "hashmap:i32str"
            }
            if decl_ann_name::decl_ann_is_name(key, "String") && decl_ann_name::decl_ann_is_name(val, "String") {
                return "hashmap:strstr"
            }
            if decl_ann_name::decl_ann_is_name(key, "i32") && decl_ann_name::decl_ann_is_name(val, "i32") {
                return "hashmap:i32i32"
            }
            if decl_ann_name::decl_ann_is_name(key, "i32") && (
                frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(val)) ||
                decl_ann_name::decl_ann_is_name(val, "fnref")
            ) {
                return "hashmap:i32fn"
            }
            if decl_ann_name::decl_ann_is_name(key, "String") && (
                frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(val)) ||
                decl_ann_name::decl_ann_is_name(val, "fnref")
            ) {
                return "hashmap:strfn"
            }
        }
        if decl_ann_name::decl_ann_is_name(ann, "Vec") && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            let elem = decl_ann_children::decl_ann_child_at(ann, 1)
            return concat("vec:", decl_ann_name::decl_ann_name(elem))
        }
        if decl_ann_name::decl_ann_is_name(ann, "HashSet") && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            let elem = decl_ann_children::decl_ann_child_at(ann, 1)
            if decl_ann_name::decl_ann_is_name(elem, "String") {
                return "vec:String"
            }
            return "vec:i32"
        }
        if decl_ann_name::decl_ann_is_name(ann, "Option") && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            let elem2 = decl_ann_children::decl_ann_child_at(ann, 1)
            if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(elem2)) ||
            eq(decl_ann_name::decl_ann_name(elem2), "fnref") {
                return "option:fnref"
            }
            if decl_ann_name::decl_ann_is_name(elem2, "i64") {
                return "Option_i64"
            }
            if decl_ann_name::decl_ann_is_name(elem2, "f64") {
                return "Option_f64"
            }
            if decl_ann_name::decl_ann_is_name(elem2, "i32") {
                return "Option_i32"
            }
            return concat("option:", decl_ann_name::decl_ann_name(elem2))
        }
        if decl_ann_name::decl_ann_is_name(ann, "Result") && decl_ann_children::decl_ann_child_count(ann) >= 3 {
            let ok_ty = decl_ann_children::decl_ann_child_at(ann, 1)
            let err_ty = decl_ann_children::decl_ann_child_at(ann, 2)
            return concat(
                "result:",
                concat(decl_ann_name::decl_ann_name(ok_ty), concat(":", decl_ann_name::decl_ann_name(err_ty)))
            )
        }
    } else {
        return param_named_local_type_name(ann)
    }
    String_new()
}
