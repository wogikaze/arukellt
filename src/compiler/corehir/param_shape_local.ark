use std::text
use corehir::decl_ann_children
use corehir::type_ann_local_name
use corehir::decl_ann_name
use corehir::frontend_ast_identity
use corehir::frontend_type_kind
use corehir::param_shape_declared
use corehir::param_shape_node
use corehir::type_ann_node
// Payload segments nested inside Result<T, E> / Option<T> keep their own
// local-type encoding. Taking only the annotation head name (Option for
// Option<String>) makes the match-payload bind open the inner enum and lose
// the String element, so the payload local is declared as the enum base and
// consuming it as a String is invalid wasm.
fn nested_payload_local_type_name(ann: AstNode) -> String {
    let shaped = type_ann_local_name::type_ann_shape_local_type_name(ann, 0)
    if len(shaped) > 0 {
        return shaped
    }
    decl_ann_name::decl_ann_name(ann)
}

// Initial local-type spelling for a named annotation. A declared type
// parameter is a placeholder (empty spelling, filled by mono); a declared
// nominal type keeps its name even when that name is one uppercase letter,
// and a declared enum keeps the canonical enum: prefix so later signature
// and local-type resolution agree (ADR-089). The single-letter fallback
// below only covers names with no declaration context yet.
fn param_named_local_type_name(
    ann: AstNode,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> String {
    if decl_ann_name::decl_ann_is_named(ann) {
        let name = decl_ann_name::decl_ann_name(ann)
        if param_shape_declared::corehir_declared_type_param_contains(type_params.clone(), name.clone()) {
            return String_new()
        }
        if param_shape_declared::corehir_nominal_types_has_enum(nominal_types, name.clone()) {
            return String_from("enum:").concat(name)
        }
        if param_shape_declared::corehir_nominal_types_has_struct(nominal_types, name.clone()) {
            return name
        }
        if !name.clone().eq("i32") &&
        !name.clone().eq("f64") &&
        !name.clone().eq("i64") &&
        !name.clone().eq("bool") &&
        !name.clone().eq("String") &&
        !name.clone().eq("u8") &&
        !name.clone().eq("char") &&
        len(name) > 1 {
            return name
        }
    }
    String_new()
}

// Render a Vec<T> annotation as vec:T. Nested Vec elements recurse so
// Vec<Vec<i32>> → vec:vec:i32 — bare vec:Vec made every nested-vec element
// indistinguishable and pushed consumers onto a vec:String guess (#922).
fn vec_ann_local_type_name(ann: AstNode) -> String {
    let elem = decl_ann_children::decl_ann_child_at(ann, 1)
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(elem)) ||
    decl_ann_name::decl_ann_is_name(elem, String_from("fnref")) {
        return String_from("vec:fnref")
    }
    // Vec<(A, B)> keeps the tuple:<k,...> element spelling; decl_ann_name on
    // a tuple node is empty and collapses the elem to i32 (#888).
    if decl_ann_name::decl_ann_is_tuple(elem) {
        return String_from("vec:").concat(type_ann_node::type_ann_tuple_local_name(elem))
    }
    if decl_ann_name::decl_ann_is_generic(elem) && decl_ann_name::decl_ann_is_name(elem, String_from("Vec")) {
        return String_from("vec:").concat(vec_ann_local_type_name(elem))
    }
    String_from("vec:").concat(decl_ann_name::decl_ann_name(elem))
}

fn fn_param_local_type_name(
    node: AstNode,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> String {
    if !param_shape_node::param_has_type_ann(node) {
        return String_new()
    }
    let ann = param_shape_node::param_type_ann(node)
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(ann)) {
        return type_ann_node::type_ann_function_ref_name(ann)
    }
    if decl_ann_name::decl_ann_is_generic(ann) {
        if decl_ann_name::decl_ann_is_name(ann, String_from("HashMap")) && decl_ann_children::decl_ann_child_count(ann) >= 3 {
            let key = decl_ann_children::decl_ann_child_at(ann, 1)
            let val = decl_ann_children::decl_ann_child_at(ann, 2)
            if decl_ann_name::decl_ann_is_name(key, String_from("String")) && decl_ann_name::decl_ann_is_name(val, String_from("i32")) {
                return String_from("hashmap:si32")
            }
            if decl_ann_name::decl_ann_is_name(key, String_from("i32")) && decl_ann_name::decl_ann_is_name(val, String_from("String")) {
                return String_from("hashmap:i32str")
            }
            if decl_ann_name::decl_ann_is_name(key, String_from("String")) && decl_ann_name::decl_ann_is_name(val, String_from("String")) {
                return String_from("hashmap:strstr")
            }
            if decl_ann_name::decl_ann_is_name(key, String_from("i32")) && decl_ann_name::decl_ann_is_name(val, String_from("i32")) {
                return String_from("hashmap:i32i32")
            }
            if decl_ann_name::decl_ann_is_name(key, String_from("i32")) && (
                frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(val)) ||
                decl_ann_name::decl_ann_is_name(val, String_from("fnref"))
            ) {
                return String_from("hashmap:i32fn")
            }
            if decl_ann_name::decl_ann_is_name(key, String_from("String")) && (
                frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(val)) ||
                decl_ann_name::decl_ann_is_name(val, String_from("fnref"))
            ) {
                return String_from("hashmap:strfn")
            }
        }
        if decl_ann_name::decl_ann_is_name(ann, String_from("Vec")) && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            return vec_ann_local_type_name(ann)
        }
        if decl_ann_name::decl_ann_is_name(ann, String_from("HashSet")) && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            let elem = decl_ann_children::decl_ann_child_at(ann, 1)
            if decl_ann_name::decl_ann_is_name(elem, String_from("String")) {
                return String_from("vec:String")
            }
            return String_from("vec:i32")
        }
        if decl_ann_name::decl_ann_is_name(ann, String_from("Option")) && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            let elem2 = decl_ann_children::decl_ann_child_at(ann, 1)
            // Keep Option_i32/i64/f64 aliases for existing scalar match helpers,
            // and emit option:T for every other payload (String, structs, ...).
            if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(elem2)) {
                return String_from("option:fnref")
            }
            if decl_ann_name::decl_ann_is_name(elem2, String_from("i64")) {
                return String_from("Option_i64")
            }
            if decl_ann_name::decl_ann_is_name(elem2, String_from("f64")) {
                return String_from("Option_f64")
            }
            if decl_ann_name::decl_ann_is_name(elem2, String_from("i32")) {
                return String_from("Option_i32")
            }
            return String_from("option:").concat(nested_payload_local_type_name(elem2))
        }
        if decl_ann_name::decl_ann_is_name(ann, String_from("Result")) && decl_ann_children::decl_ann_child_count(ann) >= 3 {
            let ok_ty = decl_ann_children::decl_ann_child_at(ann, 1)
            let err_ty = decl_ann_children::decl_ann_child_at(ann, 2)
            return String_from("result:").concat(nested_payload_local_type_name(ok_ty).concat(String_from(":").concat(nested_payload_local_type_name(err_ty))))
        }
        let generic_user_type = generic_user_type_local_name(
            ann,
            type_params,
            nominal_types
        )
        if len(generic_user_type) > 0 {
            return generic_user_type
        }
    } else {
        return param_named_local_type_name(ann, type_params, nominal_types)
    }
    String_new()
}

fn method_param_local_type_name(
    node: AstNode,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> String {
    if !param_shape_node::param_has_type_ann(node) {
        return String_new()
    }
    let ann = param_shape_node::param_type_ann(node)
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(ann)) {
        return type_ann_node::type_ann_function_ref_name(ann)
    }
    if decl_ann_name::decl_ann_is_generic(ann) {
        if decl_ann_name::decl_ann_is_name(ann, String_from("HashMap")) && decl_ann_children::decl_ann_child_count(ann) >= 3 {
            let key = decl_ann_children::decl_ann_child_at(ann, 1)
            let val = decl_ann_children::decl_ann_child_at(ann, 2)
            if decl_ann_name::decl_ann_is_name(key, String_from("String")) && decl_ann_name::decl_ann_is_name(val, String_from("i32")) {
                return String_from("hashmap:si32")
            }
            if decl_ann_name::decl_ann_is_name(key, String_from("i32")) && decl_ann_name::decl_ann_is_name(val, String_from("String")) {
                return String_from("hashmap:i32str")
            }
            if decl_ann_name::decl_ann_is_name(key, String_from("String")) && decl_ann_name::decl_ann_is_name(val, String_from("String")) {
                return String_from("hashmap:strstr")
            }
            if decl_ann_name::decl_ann_is_name(key, String_from("i32")) && decl_ann_name::decl_ann_is_name(val, String_from("i32")) {
                return String_from("hashmap:i32i32")
            }
            if decl_ann_name::decl_ann_is_name(key, String_from("i32")) && (
                frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(val)) ||
                decl_ann_name::decl_ann_is_name(val, String_from("fnref"))
            ) {
                return String_from("hashmap:i32fn")
            }
            if decl_ann_name::decl_ann_is_name(key, String_from("String")) && (
                frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(val)) ||
                decl_ann_name::decl_ann_is_name(val, String_from("fnref"))
            ) {
                return String_from("hashmap:strfn")
            }
        }
        if decl_ann_name::decl_ann_is_name(ann, String_from("Vec")) && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            return vec_ann_local_type_name(ann)
        }
        if decl_ann_name::decl_ann_is_name(ann, String_from("HashSet")) && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            let elem = decl_ann_children::decl_ann_child_at(ann, 1)
            if decl_ann_name::decl_ann_is_name(elem, String_from("String")) {
                return String_from("vec:String")
            }
            return String_from("vec:i32")
        }
        if decl_ann_name::decl_ann_is_name(ann, String_from("Option")) && decl_ann_children::decl_ann_child_count(ann) >= 2 {
            let elem2 = decl_ann_children::decl_ann_child_at(ann, 1)
            if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(elem2)) ||
            decl_ann_name::decl_ann_name(elem2).eq(String_from("fnref")) {
                return String_from("option:fnref")
            }
            if decl_ann_name::decl_ann_is_name(elem2, String_from("i64")) {
                return String_from("Option_i64")
            }
            if decl_ann_name::decl_ann_is_name(elem2, String_from("f64")) {
                return String_from("Option_f64")
            }
            if decl_ann_name::decl_ann_is_name(elem2, String_from("i32")) {
                return String_from("Option_i32")
            }
            return String_from("option:").concat(nested_payload_local_type_name(elem2))
        }
        if decl_ann_name::decl_ann_is_name(ann, String_from("Result")) && decl_ann_children::decl_ann_child_count(ann) >= 3 {
            let ok_ty = decl_ann_children::decl_ann_child_at(ann, 1)
            let err_ty = decl_ann_children::decl_ann_child_at(ann, 2)
            return String_from("result:").concat(nested_payload_local_type_name(ok_ty).concat(String_from(":").concat(nested_payload_local_type_name(err_ty))))
        }
        let generic_user_type = generic_user_type_local_name(
            ann,
            type_params,
            nominal_types
        )
        if len(generic_user_type) > 0 {
            return generic_user_type
        }
    } else {
        return param_named_local_type_name(ann, type_params, nominal_types)
    }
    String_new()
}

// Built-in containers have dedicated compact aliases above. Preserve the
// type arguments for a user-defined generic type so MIR monomorphization can
// resolve payload fields such as `Box<T>::Owned(T)`.
fn generic_user_type_local_name(
    ann: AstNode,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> String {
    let name = decl_ann_name::decl_ann_name(ann)
    let arg_count = decl_ann_children::decl_ann_child_count(ann)
    if len(name) == 0 || arg_count < 2 {
        return String_new()
    }
    let mut has_type_var = false
    let mut i = 1
    while i < arg_count {
        let arg_name = decl_ann_name::decl_ann_name(decl_ann_children::decl_ann_child_at(ann, i))
        if is_generic_type_param_name(
            arg_name.clone(),
            type_params.clone(),
            nominal_types
        ) {
            has_type_var = true
        }
        i = i + 1
    }
    if !has_type_var {
        // All-concrete arguments are a real instantiation
        // (GenTakeIter<VecIter>): keep the canonical Name<args> local-type
        // spelling so field access derives the substituted layout.
        return type_ann_local_name::type_ann_generic_inst_local_name(ann)
    }
    let mut marker = String_from("?").concat(name.clone())
    i = 1
    while i < arg_count {
        let arg_name = decl_ann_name::decl_ann_name(decl_ann_children::decl_ann_child_at(ann, i))
        marker = marker.concat(String_from(":").concat(arg_name))
        i = i + 1
    }
    marker
}

fn is_generic_type_param_name(
    name: String,
    type_params: Vec<String>,
    nominal_types: CoreHirNominalTypes
) -> bool {
    if param_shape_declared::corehir_declared_type_param_contains(type_params.clone(), name.clone()) {
        return true
    }
    if param_shape_declared::corehir_nominal_types_contains(nominal_types, name.clone()) {
        return false
    }
    if len(name) != 1 {
        return false
    }
    let ch = name.byte_at(0)
    ch >= 65 && ch <= 90
}
