use corehir::body_table

struct CoreHirMirBodySource {
    exprs: Vec<CoreHirExpr>,
    fn_body_roots: Vec<i32>,
    method_body_roots: Vec<i32>,
}

fn mir_body_source_from_table(table: CoreHirBodyTable) -> CoreHirMirBodySource {
    // Share the frozen expr table. A deep copy here cloned every text/type_name
    // and doubled the CoreHIR live set for the whole lower. Renderers that need
    // a snapshot use corehir_body_table_exprs. After the view is built the
    // program table is emptied so only the view roots the forest.
    let source = CoreHirMirBodySource {
        exprs: body_table::corehir_body_table_exprs_ref(table),
        fn_body_roots: body_table::corehir_body_table_fn_body_roots_ref(table),
        method_body_roots: body_table::corehir_body_table_method_body_roots_ref(table)
    }
    body_table::corehir_body_table_release_bodies(table)
    source
}

fn mir_body_source_release(source: CoreHirMirBodySource) {
    source.exprs = Vec::new<CoreHirExpr>()
    source.fn_body_roots = Vec::new<i32>()
    source.method_body_roots = Vec::new<i32>()
}

fn mir_body_source_exprs(source: CoreHirMirBodySource) -> Vec<CoreHirExpr> {
    source.exprs
}

fn mir_body_source_fn_body_root(source: CoreHirMirBodySource, info_index: i32) -> i32 {
    if info_index >= 0 && info_index < len(source.fn_body_roots) {
        return get_unchecked(source.fn_body_roots, info_index)
    }
    0 - 1
}

fn mir_body_source_method_body_root(source: CoreHirMirBodySource, info_index: i32) -> i32 {
    if info_index >= 0 && info_index < len(source.method_body_roots) {
        return get_unchecked(source.method_body_roots, info_index)
    }
    0 - 1
}
