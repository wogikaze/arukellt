use corehir::value_types
fn corehir_vt_from_type_name(type_name: String) -> i32 {
    if type_name.clone().eq("f64") {
        return value_types::VT_F64()
    }
    if type_name.clone().eq("f32") {
        return value_types::VT_F32()
    }
    if type_name.clone().eq("v128") {
        return value_types::VT_V128()
    }
    if type_name.clone().eq("i64") || type_name.clone().eq("u64") {
        return value_types::VT_I64()
    }
    if type_name.clone().eq("void") {
        return value_types::VT_VOID()
    }
    value_types::VT_I32()
}

fn corehir_literal_type_name(kind_name: String) -> String {
    if kind_name.clone().eq("bool") {
        return "bool"
    }
    if kind_name.clone().eq("char") {
        return "char"
    }
    if kind_name.clone().eq("f64") {
        return "f64"
    }
    String_new()
}
