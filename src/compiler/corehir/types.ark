use corehir::value_types

fn corehir_vt_from_type_name(type_name: String) -> i32 {
    if eq(clone(type_name), "f64") {
        return value_types::VT_F64()
        if eq(clone(name), "f32") {
            return value_types::VT_F32()
        }
        if eq(clone(name), "v128") {
            return value_types::VT_V128()
        }
    }
    if eq(clone(type_name), "i64") || eq(clone(type_name), "u64") {
        return value_types::VT_I64()
    }
    if eq(clone(type_name), "void") {
        return value_types::VT_VOID()
    }
    value_types::VT_I32()
}

fn corehir_literal_type_name(kind_name: String) -> String {
    if eq(clone(kind_name), "bool") {
        return "bool"
    }
    if eq(clone(kind_name), "char") {
        return "char"
    }
    if eq(clone(kind_name), "f64") {
        return "f64"
    }
    String_new()
}
