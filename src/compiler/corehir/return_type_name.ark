use std::prelude::{clone, eq, get_unchecked, push}
use std::text
use corehir::decl_ann_children
use corehir::decl_impl_target
use corehir::decl_layout_shape
use corehir::frontend_fns
use corehir::semantic_trait_id
use corehir::type_ann_node
use corehir::type_ann_local_name
use corehir::decl_ann_name
use corehir::frontend_ast_identity
use corehir::frontend_type_kind
use corehir::return_ann_shape
fn return_index_type_name(node: AstNode) -> String {
    return_index_type_name_with_result_payload(
        node,
        true,
        frontend_fns::build_fn_type_params(node)
    )
}

fn return_index_type_name_with_result_payload(
    node: AstNode,
    encode_result: bool,
    type_params: Vec<String>
) -> String {
    let child_count = return_ann_shape::return_ann_child_count(node)
    if child_count <= 0 {
        return ""
    }
    let ret = return_ann_shape::return_ann_child(node)
    let name = decl_ann_name::decl_ann_name(ret)
    if eq(clone(name), "f64") {
        return "f64"
    }
    if eq(clone(name), "i64") || eq(clone(name), "u64") {
        return clone(name)
    }
    if eq(clone(name), "void") || eq(clone(name), "()") {
        return ""
    }
    if eq(clone(name), "i32") ||
    eq(clone(name), "u32") ||
    eq(clone(name), "u8") ||
    eq(clone(name), "u16") ||
    eq(clone(name), "i16") ||
    eq(clone(name), "i8") {
        return "i32"
    }
    if eq(clone(name), "bool") {
        return "bool"
    }
    if eq(clone(name), "String") || eq(clone(name), "str") {
        return "String"
    }
    if decl_ann_name::decl_ann_is_generic(ret) {
        if eq(clone(name), "Vec") && decl_ann_children::decl_ann_child_count(ret) >= 2 {
            let elem = decl_ann_children::decl_ann_child_at(ret, 1)
            // Vec<(A, B)> returns keep the tuple:<k,...> element spelling
            // (#888).
            if decl_ann_name::decl_ann_is_tuple(elem) {
                return "vec:".concat(type_ann_node::type_ann_tuple_local_name(elem))
            }
            return "vec:".concat(decl_ann_name::decl_ann_name(elem))
        }
        if eq(clone(name), "Option") && decl_ann_children::decl_ann_child_count(ret) >= 2 {
            let elem_opt = decl_ann_children::decl_ann_child_at(ret, 1)
            if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(elem_opt)) ||
            eq(decl_ann_name::decl_ann_name(elem_opt), "fnref") {
                return "option:fnref"
            }
            return "option:".concat(decl_ann_name::decl_ann_name(elem_opt))
        }
        if eq(clone(name), "HashMap") && decl_ann_children::decl_ann_child_count(ret) >= 3 {
            let key = decl_ann_children::decl_ann_child_at(ret, 1)
            let val = decl_ann_children::decl_ann_child_at(ret, 2)
            let key_name = decl_ann_name::decl_ann_name(key)
            let val_name = decl_ann_name::decl_ann_name(val)
            if eq(clone(key_name), "String") && eq(clone(val_name), "i32") {
                return "hashmap:si32"
            }
            if eq(clone(key_name), "i32") && eq(clone(val_name), "String") {
                return "hashmap:i32str"
            }
            if eq(clone(key_name), "String") && eq(clone(val_name), "String") {
                return "hashmap:strstr"
            }
            if eq(clone(key_name), "i32") && eq(clone(val_name), "i32") {
                return "hashmap:i32i32"
            }
            if eq(clone(key_name), "i32") && (
                frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(val)) ||
                eq(clone(val_name), "fnref")
            ) {
                return "hashmap:i32fn"
            }
            if eq(clone(key_name), "String") && (
                frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(val)) ||
                eq(clone(val_name), "fnref")
            ) {
                return "hashmap:strfn"
            }
        }
        // Result payloads must survive into the method return spelling so
        // MIR lowering can type `Ok` / `Err` binds. A bare `Result` made every
        // impl method returning Result an untyped scrutinee (#693 Phase D).
        if encode_result && eq(clone(name), "Result") && decl_ann_children::decl_ann_child_count(ret) >= 3 {
            let ok_ty = decl_ann_children::decl_ann_child_at(ret, 1)
            let err_ty = decl_ann_children::decl_ann_child_at(ret, 2)
            let ok_name = decl_layout_shape::decl_layout_type_name(ok_ty)
            let err_name = decl_layout_shape::decl_layout_type_name(err_ty)
            let ok_segment = if len(ok_name) == 0 || eq(clone(ok_name), String_from("()")) {
                String_from("void")
            } else {
                ok_name
            }
            let err_segment = if len(err_name) == 0 || eq(clone(err_name), String_from("()")) {
                String_from("void")
            } else {
                err_name
            }
            return String_from("result:").concat(ok_segment.concat(String_from(":").concat(err_segment)))
        }
        // User generic struct returns keep their instantiation args
        // (GenTakeIter<VecIter>) so MIR lowering sees the same Name<args>
        // spelling that params and locals already use, and can derive
        // substituted layouts plus per-instantiation impl owners. Generic
        // enums keep the bare base name: Result/Box/Slice layout handling
        // keys on it.
        if !eq(clone(name), String_from("Result")) &&
        !eq(clone(name), String_from("Box")) &&
        !eq(clone(name), String_from("Slice")) {
            let inst = type_ann_local_name::type_ann_generic_inst_local_name(ret)
            if len(inst) > 0 {
                return inst
            }
        }
        return clone(name)
    }
    if frontend_type_kind::corehir_kind_is_type_fn(frontend_ast_identity::corehir_node_kind(ret)) ||
    eq(clone(name), "fnref") {
        return "fnref"
    }
    // Declared type parameters are the function's only variables (ADR-089).
    // Any other name is a nominal type, including a one-uppercase struct.
    if len(name) > 0 && !frontend_fns::fn_type_param_is_declared(clone(type_params), clone(name)) {
        return name
    }
    ""
}

// Type parameters visible to an impl method: the impl binder first, then
// the method's own binder in declaration order.
fn return_declared_type_params(impl_node: AstNode, method_node: AstNode) -> Vec<String> {
    let names = decl_impl_target::declared_impl_param_names(impl_node)
    let method_names = frontend_fns::build_fn_type_params(method_node)
    let count = len(method_names)
    let mut i = 0
    while i < count {
        push(names, get_unchecked(method_names, i))
        i = i + 1
    }
    names
}

// An impl method return annotation can spell the receiver as `Self`. MIR
// lowering and the SignatureRegistry consume this name without the impl
// context, so an unresolved `Self` becomes an unknown named struct and the
// call dest is declared as a scalar/structref while the callee returns the
// concrete target. Substitute the impl head's instantiated local name
// (`G<T>`, not the bare owner `G`) here; the typechecker performs the same
// binding in associated_types::resolve_impl_self_return.
fn return_index_type_name_for_impl(impl_node: AstNode, method_node: AstNode) -> String {
    let type_name = return_index_type_name_with_result_payload(
        method_node,
        impl_can_encode_result_payload(impl_node, method_node),
        return_declared_type_params(impl_node, method_node)
    )
    if len(type_name) == 0 {
        return type_name
    }
    let self_name = decl_impl_target::impl_self_local_type_name(impl_node)
    if len(self_name) == 0 {
        return type_name
    }
    let replaced = replace_self_in_type_name(type_name, self_name)
    // A concrete HashSet<T> value is stored as its flat Vec<i32> / Vec<String>
    // store. Emitting the nominal spelling here would make the MIR signature
    // (and every call destination typed from it) a struct ref instead of the
    // store alias that the method body actually returns (#917).
    if clone(replaced).starts_with("HashSet") {
        let owner_name = decl_impl_target::impl_self_type_name(impl_node)
        if eq(clone(owner_name), "HashSet_String") {
            return String_from("vec:String")
        }
        if eq(clone(owner_name), "HashSet_i32") {
            return String_from("vec:i32")
        }
    }
    replaced
}

// Result payload spellings are safe for non-generic inherent methods whose
// construction and call sites share one concrete layout. Trait impls keep the
// bare spelling because the trait declaration owns the dispatch ABI, and
// generic methods keep it because mono instances resolve their return name
// separately (#693 Phase D).
fn impl_can_encode_result_payload(impl_node: AstNode, method_node: AstNode) -> bool {
    if decl_impl_target::impl_semantic_trait_id(impl_node) != semantic_trait_id::SEMANTIC_TRAIT_ID_NONE() {
        return false
    }
    if len(decl_impl_target::declared_impl_param_names(impl_node)) > 0 {
        return false
    }
    len(frontend_fns::build_fn_type_params(method_node)) == 0
}

fn replace_self_in_type_name(type_name: String, self_name: String) -> String {
    let mut out = String_new()
    let mut rest = type_name
    while len(rest) > 0 {
        let pos = clone(rest).index_of(String_from("Self"))
        if pos < 0 {
            out = out.concat(rest)
            rest = String_new()
        } else if is_self_type_token(rest, pos) {
            out = out.concat(rest.slice(0, pos))
            out = out.concat(clone(self_name))
            rest = rest.slice(pos + 4, len(rest))
        } else {
            out = out.concat(rest.slice(0, pos + 1))
            rest = rest.slice(pos + 1, len(rest))
        }
    }
    out
}

// Type-name encodings separate components with `:`, `_`, `<` and `,`; only
// an alphanumeric neighbour means the text is part of a longer identifier.
fn is_self_type_token(type_name: String, pos: i32) -> bool {
    if pos > 0 && is_type_name_ident_byte(type_name.byte_at(pos - 1)) {
        return false
    }
    let after = pos + 4
    if after < len(type_name) && is_type_name_ident_byte(type_name.byte_at(after)) {
        return false
    }
    true
}

fn is_type_name_ident_byte(ch: i32) -> bool {
    (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122)
}
