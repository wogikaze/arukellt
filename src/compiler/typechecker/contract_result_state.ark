use typechecker::contract_mono
use typechecker::contract_typed_fn
use typechecker::contract_types_record
struct TypeCheckResult {
    error_count: i32,
    errors: Vec<String>,
    diagnostics: Vec<Diagnostic>,
    warnings: Vec<Diagnostic>,
    typed_fns: Vec<TypedFn>,
    mono_instances: Vec<MonoInstance>,
    // Per-call receiver-owner resolutions. CoreHIR forwards these to MIR
    // lowering as the checked call-resolution table (#933).
    resolved_call_owners: Vec<ResolvedCallOwner>,
}

fn TypeCheckResult_new() -> TypeCheckResult {
    TypeCheckResult {
        error_count: 0,
        errors: Vec::new<String>(),
        diagnostics: Vec::new<Diagnostic>(),
        warnings: Vec::new<Diagnostic>(),
        typed_fns: Vec::new<TypedFn>(),
        mono_instances: Vec::new<MonoInstance>(),
        resolved_call_owners: Vec::new<ResolvedCallOwner>()
    }
}

fn typecheck_result_set_errors(mut result: TypeCheckResult, errors: Vec<String>) {
    result.errors = errors
}

fn typecheck_result_push_error(mut result: TypeCheckResult, error: String) {
    result.errors.push(error)
    result.error_count = result.error_count + 1
}

fn typecheck_result_push_diagnostic(mut result: TypeCheckResult, diagnostic: Diagnostic) {
    result.diagnostics.push(diagnostic)
}

fn typecheck_result_push_warning(mut result: TypeCheckResult, warning: Diagnostic) {
    result.warnings.push(warning)
}

fn typecheck_result_set_mono_instances(mut result: TypeCheckResult, instances: Vec<MonoInstance>) {
    result.mono_instances = instances
}

fn typecheck_result_push_typed_fn(mut result: TypeCheckResult, name: String, param_types: Vec<TypeInfo>, return_type: TypeInfo) {
    result.typed_fns.push(contract_typed_fn::TypedFn_new(name, param_types, return_type))
}

fn typecheck_result_error_count(result: TypeCheckResult) -> i32 {
    result.error_count
}

fn typecheck_result_message_count(result: TypeCheckResult) -> i32 {
    result.errors.len()
}

fn typecheck_result_error_at(result: TypeCheckResult, index: i32) -> String {
    get_unchecked(result.errors, index).clone()
}

fn typecheck_result_errors(result: TypeCheckResult) -> Vec<String> {
    result.errors
}

fn typecheck_result_diagnostics(result: TypeCheckResult) -> Vec<Diagnostic> {
    result.diagnostics
}

fn typecheck_result_warnings(result: TypeCheckResult) -> Vec<Diagnostic> {
    result.warnings
}

fn typecheck_result_typed_fn_count(result: TypeCheckResult) -> i32 {
    result.typed_fns.len()
}

fn typecheck_result_typed_fns(result: TypeCheckResult) -> Vec<TypedFn> {
    result.typed_fns
}

fn typecheck_result_mono_instance_count(result: TypeCheckResult) -> i32 {
    result.mono_instances.len()
}

fn typecheck_result_mono_instance_at(result: TypeCheckResult, index: i32) -> MonoInstance {
    get_unchecked(result.mono_instances, index)
}

fn typecheck_result_mono_instances(result: TypeCheckResult) -> Vec<MonoInstance> {
    result.mono_instances
}

fn typecheck_result_set_resolved_call_owners(mut result: TypeCheckResult, owners: Vec<ResolvedCallOwner>) {
    result.resolved_call_owners = owners
}

fn typecheck_result_resolved_call_owners(result: TypeCheckResult) -> Vec<ResolvedCallOwner> {
    result.resolved_call_owners
}
