use std::prelude::{clone}
use typechecker::kinds
use typechecker::ast_expr_predicates
use typechecker::ast_access
use typechecker::contract_env_record
use typechecker::contract_type_access
use typechecker::int_lit_suffix
use typechecker::scope
use typechecker::ownership
fn infer_leaf_expr(mut env: TypeEnv, scope: LocalScope, node: AstNode) -> TypeInfo {
    if ast_expr_predicates::node_is_int_lit(node) {
        let raw_text = ast_access::node_text(node)
        let raw_len = len(raw_text)
        if int_lit_suffix::typechecker_int_literal_has_64_suffix(raw_text, raw_len) {
            return TypeInfo_simple(commands::TY_I64())
        }
        return TypeInfo_simple(commands::TY_I32())
    }
    if ast_expr_predicates::node_is_float_lit(node) {
        let float_text = ast_access::node_text(node)
        let float_len = len(float_text)
        if float_len >= 3 {
            let fa = float_text.byte_at(float_len - 3)
            let fb = float_text.byte_at(float_len - 2)
            let fc = float_text.byte_at(float_len - 1)
            if fa == 102 && fb == 51 && fc == 50 {
                return TypeInfo_simple(commands::TY_F32())
            }
        }
        return TypeInfo_simple(commands::TY_F64())
    }
    if ast_expr_predicates::node_is_string_lit(node) {
        return TypeInfo_simple(commands::TY_STRING())
    }
    if ast_expr_predicates::node_is_bool_lit(node) {
        return TypeInfo_simple(commands::TY_BOOL())
    }
    if ast_expr_predicates::node_is_char_lit(node) {
        return TypeInfo_simple(commands::TY_CHAR())
    }
    if ast_expr_predicates::node_is_ident(node) {
        let name = ast_access::node_text(node)
        // Identifier inference is the single read-use point: return values,
        // operands, and field/index roots all evaluate their identifiers here
        // before the surrounding position decides whether to move them.
        ownership::check_moved_binding_use(env, scope, node)
        contract_env_record::type_env_mark_binding_used(env, clone(name))
        let local_ty = scope::scope_lookup_instantiated(env, scope, name)
        if contract_type_access::TypeInfo_tag(local_ty) != commands::TY_UNKNOWN() {
            return local_ty
        }
        // Module consts are registered as nullary fn sigs for `mod::K`
        // path lookup, so they never appear in LocalScope. A bare const
        // ident is a value: return its declared type.
        return contract_env_record::type_env_const_type(env, name)
    }
    TypeInfo_simple(commands::TY_UNKNOWN())
}
