use typechecker::contract_type_param_bounds
use typechecker::contract_types_record
struct FnSig {
    name: String,
    param_types: Vec<TypeInfo>,
    return_type: TypeInfo,
    type_params: Vec<String>,
    type_param_bounds: Vec<TypeParamBounds>,
    param_modes: Vec<bool>,
    // Declaration index of a top-level fn/const signature in the combined
    // loaded+entry decl list; -1 for a signature with no single declaration
    // (impl methods, WIT imports, synthesized prelude shapes). The checker
    // records it on resolved calls so MIR can bind the declaration's
    // FunctionId instead of the first entry sharing the bare name (#934).
    decl_index: i32,
}

fn FnSig_new(
    name: String,
    param_types: Vec<TypeInfo>,
    return_type: TypeInfo,
    type_params: Vec<String>,
    type_param_bounds: Vec<TypeParamBounds>
) -> FnSig {
    FnSig {
        name: name,
        param_types: param_types,
        return_type: return_type,
        type_params: type_params,
        type_param_bounds: type_param_bounds,
        param_modes: Vec::new<bool>(),
        decl_index: 0 - 1
    }
}

// Modes align with `param_types` by index; an empty vector means every
// parameter is the default shared mode, which keeps externally built
// signatures (WIT imports, builtins) on the historical contract.
fn FnSig_new_with_param_modes(
    name: String,
    param_types: Vec<TypeInfo>,
    param_modes: Vec<bool>,
    return_type: TypeInfo,
    type_params: Vec<String>,
    type_param_bounds: Vec<TypeParamBounds>
) -> FnSig {
    FnSig {
        name: name,
        param_types: param_types,
        return_type: return_type,
        type_params: type_params,
        type_param_bounds: type_param_bounds,
        param_modes: param_modes,
        decl_index: 0 - 1
    }
}

fn FnSig_empty(return_type: TypeInfo) -> FnSig {
    FnSig_new(String_new(), Vec::new<TypeInfo>(), return_type, Vec::new<String>(), Vec::new<TypeParamBounds>())
}

/// Return a copy of `sig` with the name replaced (used for impl method mangling).
fn FnSig_with_name(sig: FnSig, name: String) -> FnSig {
    FnSig_with_decl_index(
        FnSig_new_with_param_modes(
            name,
            sig.param_types,
            sig.param_modes,
            sig.return_type,
            sig.type_params,
            sig.type_param_bounds
        ),
        sig.decl_index
    )
}

// Attach the top-level declaration a signature was collected from. The
// builder keeps constructors unaware of declaration positions; collection is
// the only place that knows the index (#934).
fn FnSig_with_decl_index(sig: FnSig, decl_index: i32) -> FnSig {
    let mut named = sig.clone()
    named.decl_index = decl_index
    named
}

fn FnSig_decl_index(sig: FnSig) -> i32 {
    sig.decl_index
}

fn FnSig_with_types(sig: FnSig, param_types: Vec<TypeInfo>, return_type: TypeInfo) -> FnSig {
    FnSig_with_decl_index(
        FnSig_new_with_param_modes(
            FnSig_name(sig),
            param_types,
            sig.param_modes,
            return_type,
            sig.type_params,
            sig.type_param_bounds
        ),
        sig.decl_index
    )
}

fn FnSig_name(sig: FnSig) -> String {
    sig.name.clone()
}

fn FnSig_has_name(sig: FnSig) -> bool {
    FnSig_name(sig).len() > 0
}

fn FnSig_param_count(sig: FnSig) -> i32 {
    sig.param_types.len()
}

fn FnSig_param_at(sig: FnSig, index: i32) -> TypeInfo {
    sig.param_types.get_unchecked(index)
}

fn FnSig_param_is_mut(sig: FnSig, index: i32) -> bool {
    if index < 0 || index >= sig.param_modes.len() {
        return false
    }
    sig.param_modes.get_unchecked(index)
}

fn FnSig_return_type(sig: FnSig) -> TypeInfo {
    sig.return_type
}

fn FnSig_type_param_count(sig: FnSig) -> i32 {
    sig.type_params.len()
}

fn FnSig_type_param_at(sig: FnSig, index: i32) -> String {
    sig.type_params.get_unchecked(index).clone()
}

fn FnSig_type_param_bound_count(sig: FnSig) -> i32 {
    sig.type_param_bounds.len()
}

fn FnSig_type_param_bound_at(sig: FnSig, index: i32) -> TypeParamBounds {
    sig.type_param_bounds.get_unchecked(index)
}
