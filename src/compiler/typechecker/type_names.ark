use typechecker::names
use typechecker::kinds
use typechecker::contract_type_constructors
use typechecker::contract_type_access
use typechecker::type_name_aliases
use typechecker::type_name_containers
use typechecker::type_name_primitives
fn type_info_simple(tag: i32) -> TypeInfo {
    contract_type_constructors::TypeInfo_simple(tag)
}

fn type_info_named(tag: i32, name: String) -> TypeInfo {
    contract_type_constructors::TypeInfo_named(tag, name)
}

fn resolve_type_name(name: String) -> TypeInfo {
    // Qualified spellings split by owner kind. An uppercase or `?` owner
    // is a type-level projection (`Self::Item`, `I::Item`,
    // `VecIter<i32>::Item`) whose full spelling must survive so
    // normalize_projection_ty and resolve_trait_method_type can reduce it
    // through the impl's associated types. A lowercase owner is a module
    // path: `mod::T` refers to the same type as `T`, matching
    // names::unqualified_type_name on the method-lookup side.
    if projection_owner_keeps_qualifier(name.clone()) {
        return type_info_named(commands::TY_STRUCT(), name)
    }
    let leaf = names::unqualified_type_name(name)
    let primitive = type_name_primitives::resolve_primitive_type_name(leaf.clone())
    if contract_type_access::TypeInfo_tag(primitive) != commands::TY_UNKNOWN() {
        return primitive
    }
    let container = type_name_containers::resolve_container_type_name(leaf.clone())
    if contract_type_access::TypeInfo_tag(container) != commands::TY_UNKNOWN() {
        return container
    }
    let alias = type_name_aliases::resolve_alias_type_name(leaf.clone())
    if contract_type_access::TypeInfo_tag(alias) != commands::TY_UNKNOWN() {
        return alias
    }
    type_info_named(commands::TY_STRUCT(), leaf)
}

// True when `name` is an `Owner::Assoc` spelling whose owner denotes a
// type-level entity — a `?T` type variable, `Self`, or a PascalCase
// constructor — rather than a lowercase module path segment.
fn projection_owner_keeps_qualifier(name: String) -> bool {
    let mut i = name.len() - 2
    while i >= 0 {
        if name.clone().byte_at(i) == 58 && name.clone().byte_at(i + 1) == 58 {
            let first = name.byte_at(0)
            return first == 63 || (first >= 65 && first <= 90)
        }
        i = i - 1
    }
    false
}
