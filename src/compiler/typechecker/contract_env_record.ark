use std::text
use diagnostics::codes
use diagnostics::record
use typechecker::contract_associated_type_record
use typechecker::contract_mono
use typechecker::contract_struct_info
use typechecker::contract_trait_info_record
use typechecker::contract_trait_impl_record
use typechecker::contract_trait_method_record
use typechecker::contract_type_param_bounds
use typechecker::contract_typevar_record
use collections::name_index
use diagnostics::mod as diag_mod
struct TypeEnv {
    vars: Vec<TypeVar>,
    // `len` receivers that were still type variables at their call. The body
    // may bind such a variable to String or Vec afterwards, so the owner
    // contract is finalized once the whole body has run (#936).
    deferred_len_receivers: Vec<DeferredLenReceiver>,
    // Per-call resolutions (owner, declaration FunctionId, mono instance)
    // handed to MIR lowering. This is the #933 handoff: lowering must not
    // re-derive the callee or its owner from a local type spelling.
    resolved_calls: Vec<ResolvedCall>,
    // Source body that the current check belongs to: the decl index in the
    // checked program and, for impl methods, the method ordinal inside the
    // impl (-1 for top-level decls). MIR uses the same identity when it
    // lowers the body, so resolutions never collide across modules.
    current_decl_index: i32,
    current_body_child_index: i32,
    // Loaded module that owns the body being checked, index-aligned with
    // `loaded_module_names`; -1 means the entry module.
    current_module_index: i32,
    // Shared monotonic counter backing fresh inference-var ids. Envs derived
    // for nested inference (generic-call scratch envs, per-fn check envs)
    // share the parent box so t<id> names can never collide across scopes
    // (#915).
    var_id_box: Vec<i32>,
    errors: Vec<String>,
    error_count: i32,
    diagnostics: Vec<Diagnostic>,
    warnings: Vec<Diagnostic>,
    tracked_binding_names: Vec<String>,
    tracked_binding_spans_start: Vec<i32>,
    tracked_binding_spans_end: Vec<i32>,
    tracked_binding_used: Vec<i32>,
    mono_instances: Vec<MonoInstance>,
    mono_call_sites: Vec<MonoCallSite>,
    mono_template_sites: Vec<MonoTemplateSite>,
    trait_defs: Vec<TraitInfo>,
    trait_impls: Vec<TraitImplInfo>,
    associated_types: Vec<TraitAssociatedTypeInfo>,
    trait_methods: Vec<TraitMethodEntry>,
    struct_defs: Vec<StructInfo>,
    fn_sig_index: NameIndex,
    // Declaration identities a resolver-processed entry body may name bare:
    // its own top-level decls and the prelude. Module-owned declarations are
    // reachable only through their module-qualified identity, so this index
    // (not the flat signature index) is the entry body's bare-name contract
    // (#934).
    bare_fn_sig_index: NameIndex,
    // Bare-name scope of every loaded module, keyed `<module>::<name>`: the
    // module's own top-level decls, the symbols its `use` decls import, and
    // the prelude. Loaded bodies are not resolver-processed, so their calls
    // have no accepted identity; this recovers the module graph's answer
    // before the flat signature index is consulted (#934).
    loaded_bare_sig_index: NameIndex,
    loaded_module_names: Vec<String>,
    // First decl index of the entry module inside the combined loaded+entry
    // decl list. Bodies before it belong to loaded modules.
    entry_decl_start: i32,
    const_names: Vec<String>,
    const_types: Vec<TypeInfo>,
    current_fn_name: String,
    current_fn_type_params: Vec<String>,
    current_fn_bounds: Vec<TypeParamBounds>,
    current_fn_return_type: TypeInfo,
    is_ownership_tracking_enabled: bool,
    // Bootstrap self-compile only. The pin predates #951 and the flat overlay
    // strips `mut` modes, so the self-compile pass treats every parameter as a
    // mutable borrow. User compilations always keep the strict ADR-088 rule.
    allow_shared_param_mutation: bool,
    // Nominal type names declared by the compilation unit. A single-uppercase
    // impl head name on this list is a type, not an ADR-089 window parameter.
    declared_type_names: Vec<String>,
    // `--strict` closes the ADR-089 window: a binderless implicit-parameter
    // head reports E0222 instead of W0222.
    strict_impl_binders: bool,
}

fn TypeEnv_new() -> TypeEnv {
    let mut var_id_box = Vec::new<i32>()
    var_id_box.push(0)
    TypeEnv {
        vars: Vec::new<TypeVar>(),
        deferred_len_receivers: Vec::new<DeferredLenReceiver>(),
        resolved_calls: Vec::new<ResolvedCall>(),
        current_decl_index: 0 - 1,
        current_body_child_index: 0 - 1,
        current_module_index: 0 - 1,
        var_id_box: var_id_box,
        errors: Vec::new<String>(),
        error_count: 0,
        diagnostics: Vec::new<Diagnostic>(),
        warnings: Vec::new<Diagnostic>(),
        tracked_binding_names: Vec::new<String>(),
        tracked_binding_spans_start: Vec::new<i32>(),
        tracked_binding_spans_end: Vec::new<i32>(),
        tracked_binding_used: Vec::new<i32>(),
        mono_instances: Vec::new<MonoInstance>(),
        mono_call_sites: Vec::new<MonoCallSite>(),
        mono_template_sites: Vec::new<MonoTemplateSite>(),
        trait_defs: Vec::new<TraitInfo>(),
        trait_impls: Vec::new<TraitImplInfo>(),
        associated_types: Vec::new<TraitAssociatedTypeInfo>(),
        trait_methods: Vec::new<TraitMethodEntry>(),
        struct_defs: Vec::new<StructInfo>(),
        fn_sig_index: name_index::NameIndex_new(0),
        bare_fn_sig_index: name_index::NameIndex_new(0),
        loaded_bare_sig_index: name_index::NameIndex_empty(),
        loaded_module_names: Vec::new<String>(),
        entry_decl_start: 0 - 1,
        const_names: Vec::new<String>(),
        const_types: Vec::new<TypeInfo>(),
        current_fn_name: String_new(),
        current_fn_type_params: Vec::new<String>(),
        current_fn_bounds: Vec::new<TypeParamBounds>(),
        current_fn_return_type: TypeInfo_new(commands::TY_UNKNOWN(), String_new(), Vec::new<TypeInfo>()),
        is_ownership_tracking_enabled: true,
        allow_shared_param_mutation: false,
        declared_type_names: Vec::new<String>(),
        strict_impl_binders: false
    }
}

fn type_env_track_binding(mut env: TypeEnv, name: String, span_start: i32, span_end: i32) {
    env.tracked_binding_names.push(name)
    env.tracked_binding_spans_start.push(span_start)
    env.tracked_binding_spans_end.push(span_end)
    env.tracked_binding_used.push(0)
}

fn type_env_mark_binding_used(mut env: TypeEnv, name: String) {
    let count = env.tracked_binding_names.len()
    let mut i = 0
    while i < count {
        if env.tracked_binding_names.get_unchecked(i).eq(name.clone()) {
            env.tracked_binding_used.set(i, 1)
            return
        }
        i = i + 1
    }
}

fn type_env_release_tracked_bindings(mut env: TypeEnv) {
    env.tracked_binding_names = Vec::new<String>()
    env.tracked_binding_spans_start = Vec::new<i32>()
    env.tracked_binding_spans_end = Vec::new<i32>()
    env.tracked_binding_used = Vec::new<i32>()
}

// Const decls register a nullary FnSig so `mod::K` paths resolve, but that
// shape is indistinguishable from a real `fn() -> T`. The declared type is
// kept on a side table so expression inference can type a bare const ident
// as its value type instead of a function signature.
fn type_env_register_const(mut env: TypeEnv, name: String, const_type: TypeInfo) {
    env.const_names.push(name)
    env.const_types.push(const_type)
}

fn type_env_const_type(env: TypeEnv, name: String) -> TypeInfo {
    let count = env.const_names.len()
    let mut i = 0
    while i < count {
        if env.const_names.get_unchecked(i).eq(name.clone()) {
            return env.const_types.get_unchecked(i)
        }
        i = i + 1
    }
    TypeInfo_new(commands::TY_UNKNOWN(), String_new(), Vec::new<TypeInfo>())
}

fn type_env_is_const_name(env: TypeEnv, name: String) -> bool {
    let count = env.const_names.len()
    let mut i = 0
    while i < count {
        if env.const_names.get_unchecked(i).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn type_env_finalize_unused_bindings(mut env: TypeEnv) {
    let count = env.tracked_binding_names.len()
    let mut i = 0
    while i < count {
        if env.tracked_binding_used.get_unchecked(i) == 0 {
            let name = env.tracked_binding_names.get_unchecked(i).clone()
            let span_start = env.tracked_binding_spans_start.get_unchecked(i)
            let span_end = env.tracked_binding_spans_end.get_unchecked(i)
            let msg = "unused binding `".concat(name.concat("`"))
            let span = record::DiagnosticSpan_from_raw(span_start, span_end)
            let warn = diag_mod::Diagnostic_new(codes::DIAG_WARN_UNUSED_BINDING(), diag_mod::SEV_WARNING(), span, msg)
            env.warnings.push(warn)
        }
        i = i + 1
    }
    type_env_release_tracked_bindings(env)
}
