use typechecker::kinds

fn type_tag_name(tag: i32) -> String {
    if tag == commands::TY_I32() { return "i32" }
    if tag == commands::TY_I64() { return "i64" }
    if tag == commands::TY_F64() { return "f64" }
    if tag == commands::TY_F32() { return "f32" }
    if tag == commands::TY_V128() { return "v128" }
    if tag == commands::TY_BOOL() { return "bool" }
    if tag == commands::TY_STRING() { return "String" }
    if tag == commands::TY_CHAR() { return "char" }
    if tag == commands::TY_UNIT() { return "()" }
    if tag == commands::TY_VEC() { return "Vec" }
    if tag == commands::TY_FUTURE() { return "Future" }
    if tag == commands::TY_STREAM() { return "Stream" }
    if tag == commands::TY_FN() { return "fn" }
    if tag == commands::TY_STRUCT() { return "struct" }
    if tag == commands::TY_ENUM() { return "enum" }
    if tag == commands::TY_RESOURCE() { return "resource" }
    if tag == commands::TY_TYPE_VAR() { return "var" }
    "?"
}
