use typechecker::ast_decl_predicates
use typechecker::ast_access
use typechecker::call_generic_common
use typechecker::call_generic_resolve
use typechecker::contract_struct_info
use typechecker::contract_type_access
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::infer_env_scope
use typechecker::instantiate
use typechecker::module_enums
use typechecker::names
use typechecker::types
use typechecker::unify
use diagnostics::codes
use diagnostics::record
use diagnostics::mod as diag_mod

// Register struct declarations into the typecheck env so field-access
// expressions can recover a concrete field type. MIR owns the layout copy;
// this table only needs names, declaration type parameters, and annotated
// field types.
use std::prelude::{args, clone, eq, index_of}
use std::text
fn register_struct_decls(mut env: TypeEnv, decls: Vec<AstNode>) {
    let count = len(decls)
    let mut i = 0
    while i < count {
        let node = get_unchecked(decls, i)
        if ast_decl_predicates::node_is_struct_decl(node) {
            let info = collect_struct_def(node)
            report_struct_enum_shadow_conflict(
                env,
                decls,
                node,
                contract_struct_info::StructInfo_name(info),
                contract_struct_info::StructInfo_type_params(info)
            )
            push(env.struct_defs, info)
        }
        i = i + 1
    }
}

// A user struct may shadow a prelude enum only while the spellings stay
// unambiguous: a non-generic 'struct Box' claims the bare name while
// 'Box<args>' / '?Box:T' / 'Box::Owned' still name 'enum Box' (#905). A
// generic struct, or a collision with a non-generic enum, leaves one side
// unreachable and emits invalid core Wasm, so the decl is rejected here.
fn report_struct_enum_shadow_conflict(mut env: TypeEnv, decls: Vec<AstNode>, node: AstNode, struct_name: String, struct_params: Vec<String>) {
    let decl_count = len(decls)
    let mut j = 0
    while j < decl_count {
        let e_node = get_unchecked(decls, j)
        if !ast_decl_predicates::node_is_enum_decl(e_node) ||
        !eq(clone(ast_access::node_text(e_node)), clone(struct_name)) {
            j = j + 1
            continue
        }
        let enum_params = module_enums::enum_type_param_names(e_node)
        if len(struct_params) == 0 && len(enum_params) > 0 {
            j = j + 1
            continue
        }
        let message = String_from("ambiguous type name '").concat(
            clone(struct_name).concat(String_from("': only a non-generic struct may shadow a generic enum; rename the struct or drop its type parameters"))
        )
        env.error_count = env.error_count + 1
        push(env.errors, clone(message))
        let span = record::DiagnosticSpan_from_raw(
            ast_access::node_span_start(node),
            ast_access::node_span_end(node)
        )
        let diag = diag_mod::Diagnostic_new(
            codes::DIAG_RESOLVE_DUPLICATE_SYMBOL(),
            diag_mod::SEV_ERROR(),
            span,
            message
        )
        push(env.diagnostics, diag)
        j = j + 1
    }
}

fn collect_struct_def(node: AstNode) -> StructInfo {
    let type_params = module_enums::enum_type_param_names(node)
    let mut field_names = Vec::new<String>()
    let mut field_types = Vec::new<TypeInfo>()
    let field_count = ast_access::node_child_count(node)
    let mut i = 0
    while i < field_count {
        let field = ast_access::node_child_at(node, i)
        push(field_names, ast_access::node_text(field))
        if ast_access::node_type_ann_count(field) > 0 {
            push(
                field_types,
                types::resolve_type_ann_node_generic(
                    ast_access::node_type_ann_at(field, 0),
                    type_params
                )
            )
        } else {
            push(field_types, contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN()))
        }
        i = i + 1
    }
    contract_struct_info::StructInfo_new(ast_access::node_text(node), type_params, field_names, field_types)
}

// Resolve recv_ty.field_name through the registered struct declarations.
// Declaration type parameters are substituted with the receiver's concrete
// type arguments, so Take<Take<VecIter>>.iter reports Take<VecIter>.
// TY_UNKNOWN means "not a known struct field" and preserves the previous
// inference result for non-struct receivers.
fn struct_field_type(env: TypeEnv, recv_ty: TypeInfo, field_name: String) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(recv_ty) != commands::TY_STRUCT() {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let recv_name = names::unqualified_type_name(contract_type_access::TypeInfo_name(recv_ty))
    let def_count = len(env.struct_defs)
    let mut i = 0
    while i < def_count {
        let def = get_unchecked(env.struct_defs, i)
        if !eq(contract_struct_info::StructInfo_name(def), clone(recv_name)) {
            i = i + 1
            continue
        }
        let field_idx = contract_struct_info::StructInfo_field_index(def, clone(field_name))
        if field_idx < 0 {
            return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
        }
        let field_ty = contract_struct_info::StructInfo_field_type_at(def, field_idx)
        let type_params = contract_struct_info::StructInfo_type_params(def)
        if len(type_params) == 0 {
            return field_ty
        }
        return instantiate::instantiate_type(field_ty, type_params, recv_type_args(recv_ty))
    }
    contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
}

fn recv_type_args(recv_ty: TypeInfo) -> Vec<TypeInfo> {
    let mut args = Vec::new<TypeInfo>()
    let arg_count = contract_type_access::TypeInfo_type_arg_count(recv_ty)
    let mut i = 0
    while i < arg_count {
        push(args, contract_type_access::TypeInfo_type_arg_at(recv_ty, i))
        i = i + 1
    }
    args
}

// An unannotated `ScanBox { state: 7 }` literal used to keep the bare
// `ScanBox` type, so a later `it.get()` could not bind `T` and recorded no
// mono instance — the call then targeted the un-emitted generic template
// (empty MIR body, #882). Infer the arguments by unifying each literal
// field value against the declared generic field type. Any parameter left
// unbound (or bound to UNKNOWN) keeps the bare name so partial literals
// keep their previous shape.
fn infer_generic_literal_args(env: TypeEnv, mut aggregate_ty: TypeInfo, node: AstNode, val_tys: Vec<TypeInfo>) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(aggregate_ty) != commands::TY_STRUCT() {
        return aggregate_ty
    }
    if contract_type_access::TypeInfo_type_arg_count(aggregate_ty) > 0 {
        return aggregate_ty
    }
    let lit_name = contract_type_access::TypeInfo_name(aggregate_ty)
    // An explicit `Name<args>` spelling is authoritative; skip inference.
    if index_of(clone(lit_name), "<") >= 0 {
        return aggregate_ty
    }
    let base_name = names::unqualified_type_name(clone(lit_name))
    let def_count = len(env.struct_defs)
    let mut di = 0
    while di < def_count {
        let def = get_unchecked(env.struct_defs, di)
        if !eq(contract_struct_info::StructInfo_name(def), clone(base_name)) {
            di = di + 1
            continue
        }
        let type_params = contract_struct_info::StructInfo_type_params(def)
        if len(type_params) == 0 {
            return aggregate_ty
        }
        let mut infer_env = infer_env_scope::borrow_generic_infer_env(env)
        let mut var_types = Vec::new<TypeInfo>()
        let mut pi = 0
        while pi < len(type_params) {
            push(var_types, unify::fresh_var(infer_env))
            pi = pi + 1
        }
        let lit_field_count = ast_access::node_child_count(node)
        let mut fi = 0
        while fi < lit_field_count {
            let field = ast_access::node_child_at(node, fi)
            let decl_idx = contract_struct_info::StructInfo_field_index(def, ast_access::node_text(field))
            if decl_idx >= 0 && fi < len(val_tys) {
                let field_ty = contract_struct_info::StructInfo_field_type_at(def, decl_idx)
                if struct_lit_ty_mentions_params(clone(field_ty), clone(type_params)) {
                    let inst_ty = instantiate::instantiate_type(field_ty, clone(type_params), clone(var_types))
                    // Field value types can carry vars bound in the real env
                    // (e.g. a generic call result); resolve them there first
                    // so the scratch env only sees concrete or param types.
                    let val_ty = unify::resolve_type_deep(env, get_unchecked(val_tys, fi))
                    let _unified = unify::unify(infer_env, inst_ty, val_ty)
                }
            }
            fi = fi + 1
        }
        if call_generic_resolve::has_unresolved_fresh_type_arg(infer_env, clone(var_types)) {
            return aggregate_ty
        }
        let resolved = call_generic_common::resolve_type_args(infer_env, var_types)
        let mut ri = 0
        while ri < len(resolved) {
            let arg_ty = get_unchecked(resolved, ri)
            if contract_type_access::TypeInfo_tag(arg_ty) == commands::TY_UNKNOWN() {
                return aggregate_ty
            }
            // A surviving TYPE_VAR is only valid when it names one of the
            // struct's own parameters (a literal inside a generic body can
            // legitimately produce Box<T>); a stray inference var would leak
            // into mono keys, so keep the bare name instead.
            if contract_type_access::TypeInfo_tag(arg_ty) == commands::TY_TYPE_VAR() &&
            !struct_lit_name_in_params(contract_type_access::TypeInfo_name(arg_ty), clone(type_params)) {
                return aggregate_ty
            }
            ri = ri + 1
        }
        let mut ai = 0
        while ai < len(resolved) {
            contract_type_mutation::TypeInfo_push_type_arg(aggregate_ty, get_unchecked(resolved, ai))
            ai = ai + 1
        }
        return aggregate_ty
    }
    aggregate_ty
}

fn struct_lit_name_in_params(name: String, params: Vec<String>) -> bool {
    let mut pi = 0
    while pi < len(params) {
        if eq(clone(name), clone(get_unchecked(params, pi))) {
            return true
        }
        pi = pi + 1
    }
    false
}

// Declared field types were built with `resolve_type_ann_node_generic`, so a
// type parameter appears as a TY_TYPE_VAR whose name matches a param entry;
// container fields mention params through their type arguments.
fn struct_lit_ty_mentions_params(ty: TypeInfo, params: Vec<String>) -> bool {
    if contract_type_access::TypeInfo_tag(ty) == commands::TY_TYPE_VAR() {
        return struct_lit_name_in_params(contract_type_access::TypeInfo_name(ty), params)
    }
    let arg_count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut ai = 0
    while ai < arg_count {
        if struct_lit_ty_mentions_params(contract_type_access::TypeInfo_type_arg_at(ty, ai), clone(params)) {
            return true
        }
        ai = ai + 1
    }
    false
}
