use typechecker::contract_types_record

// Field table of one struct declaration for typecheck-time field access
// inference. Field types keep the declaration's type parameters as
// TY_TYPE_VAR; instantiate_type binds them to the receiver's concrete
// arguments at the access site.
struct StructInfo {
    name: String,
    type_params: Vec<String>,
    field_names: Vec<String>,
    field_types: Vec<TypeInfo>,
}

fn StructInfo_new(name: String, type_params: Vec<String>, field_names: Vec<String>, field_types: Vec<TypeInfo>) -> StructInfo {
    StructInfo {
        name: name,
        type_params: type_params,
        field_names: field_names,
        field_types: field_types,
    }
}

fn StructInfo_name(info: StructInfo) -> String {
    info.name.clone()
}

fn StructInfo_type_params(info: StructInfo) -> Vec<String> {
    info.type_params
}

fn StructInfo_field_index(info: StructInfo, field_name: String) -> i32 {
    let count = info.field_names.len()
    let mut i = 0
    while i < count {
        if info.field_names.get_unchecked(i).eq(field_name.clone()) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn StructInfo_field_type_at(info: StructInfo, index: i32) -> TypeInfo {
    if index < 0 || index >= info.field_types.len() {
        return contract_types_record::TypeInfo_new(commands::TY_UNKNOWN(), String_new(), Vec::new<TypeInfo>())
    }
    info.field_types.get_unchecked(index)
}
