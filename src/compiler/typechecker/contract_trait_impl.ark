use typechecker::contract_trait_impl_record
use typechecker::contract_type_param_bounds

fn TraitImplInfo_new(
    trait_name: String,
    trait_args: Vec<TypeInfo>,
    self_ty: TypeInfo,
    type_param_bounds: Vec<TypeParamBounds>
) -> TraitImplInfo {
    contract_trait_impl_record::TraitImplInfo_new(
        trait_name,
        trait_args,
        self_ty,
        type_param_bounds
    )
}

fn TraitImplInfo_trait_name(info: TraitImplInfo) -> String {
    contract_trait_impl_record::trait_impl_info_trait_name(info)
}

fn TraitImplInfo_self_ty(info: TraitImplInfo) -> TypeInfo {
    contract_trait_impl_record::trait_impl_info_self_ty(info)
}
