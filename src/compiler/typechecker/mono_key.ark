use std::text
use typechecker::kinds
use typechecker::contract_type_access
use typechecker::names

fn mono_type_key(ty: TypeInfo) -> String {
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == commands::TY_TYPE_VAR() {
        return text::concat("?", contract_type_access::TypeInfo_name(ty))
    }
    let mut base = ""
    if tag == commands::TY_STRUCT() || tag == commands::TY_ENUM() || tag == commands::TY_RESOURCE() {
        base = contract_type_access::TypeInfo_name(ty)
    } else {
        base = names::type_tag_name(tag)
    }
    // Option/Result/HashMap have no primitive tag name and used to key as
    // `?` — the same spelling mono sites emit for unbound type variables.
    // A concrete container arg then looks like a template spelling, so span
    // rewrites such as `Vec::new__Option<i32>` were dropped and the call
    // bound to the bare constructor (vec:i32 layout for Vec<Option<i32>>).
    if eq(clone(base), "?") {
        if tag == commands::TY_OPTION() {
            base = "Option"
        }
        if tag == commands::TY_RESULT() {
            base = "Result"
        }
        if tag == commands::TY_HASHMAP() {
            base = "HashMap"
        }
        if tag == commands::TY_TUPLE() {
            base = "tuple"
        }
    }
    let arg_count = contract_type_access::TypeInfo_type_arg_count(ty)
    if arg_count == 0 {
        return base
    }
    let mut result = text::concat(base, "<")
    let mut i = 0
    while i < arg_count {
        let arg = contract_type_access::TypeInfo_type_arg_at(ty, i)
        if i > 0 {
            result = text::builder_append(result, ",")
        }
        result = text::builder_append(result, mono_type_key(arg))
        i = i + 1
    }
    result = text::builder_append(result, ">")
    result
}
