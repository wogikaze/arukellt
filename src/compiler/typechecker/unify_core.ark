use std::text
use typechecker::kinds
use typechecker::contract_type_access
use typechecker::names
use typechecker::unify_bind
use typechecker::unify_env
use typechecker::unify_resolve
fn unify(mut env: TypeEnv, a: TypeInfo, b: TypeInfo) -> TypeInfo {
    let a_tag = contract_type_access::TypeInfo_tag(a)
    let b_tag = contract_type_access::TypeInfo_tag(b)
    if a_tag == commands::TY_UNKNOWN() {
        return b
    }
    if b_tag == commands::TY_UNKNOWN() {
        return a
    }
    // Declared generic parameters are copied into separate TypeInfo records
    // during signature construction. Equal names denote the same parameter;
    // binding that parameter to its copy would incorrectly trigger occurs check.
    if a_tag == commands::TY_TYPE_VAR() && b_tag == commands::TY_TYPE_VAR() &&
    contract_type_access::TypeInfo_name(a).eq(contract_type_access::TypeInfo_name(b)) {
        return a
    }
    if a_tag == commands::TY_TYPE_VAR() {
        // An already-bound variable must unify against its binding, not
        // silently rebind. Rebinding let fn(T) -> U parameters accept a
        // callback that disagreed with an earlier binding, which compiled
        // the call and then trapped at runtime (#887).
        let resolved_a = unify_resolve::resolve_type(env, a)
        if contract_type_access::TypeInfo_tag(resolved_a) != commands::TY_TYPE_VAR() ||
        !contract_type_access::TypeInfo_name(resolved_a).eq(contract_type_access::TypeInfo_name(a)) {
            return unify(env, resolved_a, b)
        }
        unify_bind::bind_var(env, contract_type_access::TypeInfo_name(a), b)
        return b
    }
    if b_tag == commands::TY_TYPE_VAR() {
        let resolved_b = unify_resolve::resolve_type(env, b)
        if contract_type_access::TypeInfo_tag(resolved_b) != commands::TY_TYPE_VAR() ||
        !contract_type_access::TypeInfo_name(resolved_b).eq(contract_type_access::TypeInfo_name(b)) {
            return unify(env, a, resolved_b)
        }
        unify_bind::bind_var(env, contract_type_access::TypeInfo_name(b), a)
        return a
    }
    // The unit literal is spelled as an empty tuple, so a zero-arg TUPLE
    // and UNIT denote the same type. Canonicalize to the UNIT side.
    if a_tag == commands::TY_UNIT() && b_tag == commands::TY_TUPLE() &&
    contract_type_access::TypeInfo_type_arg_count(b) == 0 {
        return a
    }
    if b_tag == commands::TY_UNIT() && a_tag == commands::TY_TUPLE() &&
    contract_type_access::TypeInfo_type_arg_count(a) == 0 {
        return b
    }
    if (a_tag == commands::TY_STRUCT() && b_tag == commands::TY_ENUM()) ||
    (a_tag == commands::TY_ENUM() && b_tag == commands::TY_STRUCT()) {
        let a_name = contract_type_access::TypeInfo_name(a)
        let b_name = contract_type_access::TypeInfo_name(b)
        if !names::same_type_name(a_name.clone(), b_name.clone()) {
            unify_env::type_error(env, "type mismatch: ".concat(a_name.concat(" vs ".concat(b_name))))
            return a
        }
        // A declaration is TY_STRUCT or TY_ENUM depending on which registry
        // resolved the name first, so `Wrap<T>` (signature) and `Wrap<i32>`
        // (constructor value) can disagree on the tag while naming the same
        // type. Their arguments still have to unify: without it the generic
        // call never binds T and falls back to the unsubstituted template.
        return unify_named_type_args(env, a, b)
    }
    if a_tag == b_tag {
        if a_tag == commands::TY_STRUCT() || a_tag == commands::TY_ENUM() || a_tag == commands::TY_RESOURCE() {
            let a_name = contract_type_access::TypeInfo_name(a)
            let b_name = contract_type_access::TypeInfo_name(b)
            if !names::same_named_type(a, b) {
                unify_env::type_error(env, "type mismatch: ".concat(a_name.concat(" vs ".concat(b_name))))
            }
        }
        return unify_named_type_args(env, a, b)
    }
    unify_env::type_error(env, type_mismatch_message(a_tag, b_tag))
    a
}

// Unify the declared type arguments of two spellings of the same nominal
// type and return the left operand, matching unify's argument result.
fn unify_named_type_args(mut env: TypeEnv, a: TypeInfo, b: TypeInfo) -> TypeInfo {
    let ad = unify_resolve::resolve_type_deep(env, a)
    let bd = unify_resolve::resolve_type_deep(env, b)
    let ac = contract_type_access::TypeInfo_type_arg_count(ad)
    let bc = contract_type_access::TypeInfo_type_arg_count(bd)
    if ac > 0 && bc > 0 {
        if ac != bc {
            unify_env::type_error(env, "generic arity mismatch: ".concat(names::type_tag_name(contract_type_access::TypeInfo_tag(ad))))
        } else {
            let mut k = 0
            while k < ac {
                unify(env, contract_type_access::TypeInfo_type_arg_at(ad, k), contract_type_access::TypeInfo_type_arg_at(bd, k))
                k = k + 1
            }
        }
    }
    a
}

fn type_mismatch_message(a_tag: i32, b_tag: i32) -> String {
    let base = "type mismatch: ".concat(names::type_tag_name(a_tag).concat(" vs ".concat(names::type_tag_name(b_tag))))
    if !is_numeric_tag(a_tag) || !is_numeric_tag(b_tag) {
        return base
    }
    base.concat("; no implicit numeric conversion (ADR-067)".concat(numeric_conversion_hint(a_tag, b_tag)))
}

fn is_numeric_tag(tag: i32) -> bool {
    tag == commands::TY_I32() || tag == commands::TY_I64() ||
    tag == commands::TY_F64() || tag == commands::TY_F32()
}

// The migration hint names only conversions that exist on the current stdlib
// surface; pairs without a canonical conversion say so instead of promising
// an unavailable function (tracked by the ADR-067 conversion matrix).
fn numeric_conversion_hint(a_tag: i32, b_tag: i32) -> String {
    if a_tag == commands::TY_I32() && b_tag == commands::TY_I64() {
        return "; try `i32_to_i64(x)`"
    }
    if a_tag == commands::TY_I64() && b_tag == commands::TY_I32() {
        return "; try `i64_to_i32(x)` or a `to_i32_*` method"
    }
    if a_tag == commands::TY_F32() && b_tag == commands::TY_F64() {
        return "; try `f32_to_f64(x)`"
    }
    if a_tag == commands::TY_F64() && b_tag == commands::TY_F32() {
        return "; try `f64_to_f32(x)`"
    }
    "; no canonical conversion exists for this pair yet; use an explicit arithmetic step"
}
