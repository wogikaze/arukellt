use std::prelude::{clone, eq}
use typechecker::kinds
use typechecker::contract_type_access
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::types
fn simple_type(tag: i32) -> TypeInfo {
    contract_type_constructors::TypeInfo_simple(tag)
}

fn hashmap_type(key: String, val: String) -> TypeInfo {
    let mut hm = simple_type(commands::TY_HASHMAP())
    contract_type_mutation::TypeInfo_push_type_arg(hm, types::resolve_type_name(key))
    contract_type_mutation::TypeInfo_push_type_arg(hm, types::resolve_type_name(val))
    hm
}

fn option_type(inner: String) -> TypeInfo {
    let mut opt = simple_type(commands::TY_OPTION())
    contract_type_mutation::TypeInfo_push_type_arg(opt, types::resolve_type_name(inner))
    opt
}

fn hashmap_i32_i32_type() -> TypeInfo {
    hashmap_type("i32", "i32")
}

fn hashmap_string_i32_type() -> TypeInfo {
    hashmap_type("String", "i32")
}

fn hashmap_i32_string_type() -> TypeInfo {
    hashmap_type("i32", "String")
}

fn hashmap_i32_fn_type() -> TypeInfo {
    let mut hm = simple_type(commands::TY_HASHMAP())
    contract_type_mutation::TypeInfo_push_type_arg(hm, simple_type(commands::TY_I32()))
    contract_type_mutation::TypeInfo_push_type_arg(hm, simple_type(kinds::TY_FN()))
    hm
}

fn hashmap_string_fn_type() -> TypeInfo {
    let mut hm = simple_type(commands::TY_HASHMAP())
    contract_type_mutation::TypeInfo_push_type_arg(hm, simple_type(commands::TY_STRING()))
    contract_type_mutation::TypeInfo_push_type_arg(hm, simple_type(kinds::TY_FN()))
    hm
}

fn option_fn_type() -> TypeInfo {
    let mut opt = simple_type(commands::TY_OPTION())
    contract_type_mutation::TypeInfo_push_type_arg(opt, simple_type(kinds::TY_FN()))
    opt
}

fn hashmap_string_string_type() -> TypeInfo {
    hashmap_type("String", "String")
}

fn vec_i32_type() -> TypeInfo {
    let mut v = simple_type(commands::TY_VEC())
    contract_type_mutation::TypeInfo_push_type_arg(v, simple_type(commands::TY_I32()))
    v
}

fn vec_string_type() -> TypeInfo {
    let mut v = simple_type(commands::TY_VEC())
    contract_type_mutation::TypeInfo_push_type_arg(v, simple_type(commands::TY_STRING()))
    v
}

fn vec_fn_type() -> TypeInfo {
    let mut v = simple_type(commands::TY_VEC())
    contract_type_mutation::TypeInfo_push_type_arg(v, simple_type(kinds::TY_FN()))
    v
}

// entries() returns Vec<(K, V)>: the pair is a tuple TypeInfo whose type args
// are the key and value types, matching resolve_type_tuple_node_generic.
fn vec_entry_type(key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    let mut entry = simple_type(commands::TY_TUPLE())
    contract_type_mutation::TypeInfo_push_type_arg(entry, key_ty)
    contract_type_mutation::TypeInfo_push_type_arg(entry, value_ty)
    let mut v = simple_type(commands::TY_VEC())
    contract_type_mutation::TypeInfo_push_type_arg(v, entry)
    v
}

fn hashmap_new_return_type(name: String) -> TypeInfo {
    if eq(clone(name), "HashMap_i32_i32_new") || eq(clone(name), "HashMap_new_i32_i32") {
        return hashmap_i32_i32_type()
    }
    if eq(clone(name), "HashMap_new_String_i32") || eq(clone(name), "HashMap_String_i32_new") {
        return hashmap_string_i32_type()
    }
    if eq(clone(name), "HashMap_new_i32_String") || eq(clone(name), "HashMap_i32_String_new") {
        return hashmap_i32_string_type()
    }
    if eq(clone(name), "HashMap_new_i32_fn") || eq(clone(name), "HashMap_i32_fn_new") {
        return hashmap_i32_fn_type()
    }
    if eq(clone(name), "HashMap_new_String_fn") || eq(clone(name), "HashMap_String_fn_new") {
        return hashmap_string_fn_type()
    }
    if eq(clone(name), "HashMap_new_String_String") || eq(clone(name), "HashMap_String_String_new") {
        return hashmap_string_string_type()
    }
    simple_type(commands::TY_UNKNOWN())
}

fn hashmap_get_return_type(name: String) -> TypeInfo {
    if eq(clone(name), "HashMap_i32_i32_get") {
        return option_type("i32")
    }
    if eq(clone(name), "HashMap_String_i32_get") {
        return option_type("i32")
    }
    if eq(clone(name), "HashMap_i32_String_get") {
        return option_type("String")
    }
    if eq(clone(name), "HashMap_i32_fn_get") {
        return option_fn_type()
    }
    if eq(clone(name), "HashMap_String_fn_get") {
        return option_fn_type()
    }
    if eq(clone(name), "HashMap_String_String_get") {
        return option_type("String")
    }
    if eq(clone(name), "HashMap_i32_i32_remove") || eq(clone(name), "HashMap_String_i32_remove") {
        return option_type("i32")
    }
    if eq(clone(name), "HashMap_i32_String_remove") || eq(clone(name), "HashMap_String_String_remove") {
        return option_type("String")
    }
    if eq(clone(name), "HashMap_i32_fn_remove") {
        return option_fn_type()
    }
    if eq(clone(name), "HashMap_String_fn_remove") {
        return option_fn_type()
    }
    simple_type(commands::TY_UNKNOWN())
}

fn hashmap_keys_return_type(name: String) -> TypeInfo {
    if eq(clone(name), "HashMap_i32_i32_keys") || eq(clone(name), "HashMap_i32_String_keys") {
        return vec_i32_type()
    }
    if eq(clone(name), "HashMap_String_i32_keys") || eq(clone(name), "HashMap_String_String_keys") {
        return vec_string_type()
    }
    if eq(clone(name), "HashMap_i32_fn_keys") {
        return vec_i32_type()
    }
    if eq(clone(name), "HashMap_String_fn_keys") {
        return vec_string_type()
    }
    simple_type(commands::TY_UNKNOWN())
}

fn hashmap_values_return_type(name: String) -> TypeInfo {
    if eq(clone(name), "HashMap_i32_i32_values") || eq(clone(name), "HashMap_String_i32_values") {
        return vec_i32_type()
    }
    if eq(clone(name), "HashMap_i32_String_values") || eq(clone(name), "HashMap_String_String_values") {
        return vec_string_type()
    }
    if eq(clone(name), "HashMap_i32_fn_values") || eq(clone(name), "HashMap_String_fn_values") {
        return vec_fn_type()
    }
    simple_type(commands::TY_UNKNOWN())
}

fn hashmap_entries_return_type(name: String) -> TypeInfo {
    if eq(clone(name), "HashMap_i32_i32_entries") {
        return vec_entry_type(simple_type(commands::TY_I32()), simple_type(commands::TY_I32()))
    }
    if eq(clone(name), "HashMap_String_i32_entries") {
        return vec_entry_type(simple_type(commands::TY_STRING()), simple_type(commands::TY_I32()))
    }
    if eq(clone(name), "HashMap_i32_String_entries") {
        return vec_entry_type(simple_type(commands::TY_I32()), simple_type(commands::TY_STRING()))
    }
    if eq(clone(name), "HashMap_String_String_entries") {
        return vec_entry_type(simple_type(commands::TY_STRING()), simple_type(commands::TY_STRING()))
    }
    if eq(clone(name), "HashMap_i32_fn_entries") {
        return vec_entry_type(simple_type(commands::TY_I32()), simple_type(kinds::TY_FN()))
    }
    if eq(clone(name), "HashMap_String_fn_entries") {
        return vec_entry_type(simple_type(commands::TY_STRING()), simple_type(kinds::TY_FN()))
    }
    simple_type(commands::TY_UNKNOWN())
}

fn hashmap_builtin_return_type(name: String) -> TypeInfo {
    let new_ty = hashmap_new_return_type(clone(name))
    if contract_type_access::TypeInfo_tag(new_ty) != commands::TY_UNKNOWN() {
        return new_ty
    }
    let get_ty = hashmap_get_return_type(clone(name))
    if contract_type_access::TypeInfo_tag(get_ty) != commands::TY_UNKNOWN() {
        return get_ty
    }
    let keys_ty = hashmap_keys_return_type(clone(name))
    if contract_type_access::TypeInfo_tag(keys_ty) != commands::TY_UNKNOWN() {
        return keys_ty
    }
    let values_ty = hashmap_values_return_type(clone(name))
    if contract_type_access::TypeInfo_tag(values_ty) != commands::TY_UNKNOWN() {
        return values_ty
    }
    let entries_ty = hashmap_entries_return_type(clone(name))
    if contract_type_access::TypeInfo_tag(entries_ty) != commands::TY_UNKNOWN() {
        return entries_ty
    }
    if eq(clone(name), "HashMap_i32_i32_len") ||
    eq(clone(name), "HashMap_String_i32_len") ||
    eq(clone(name), "HashMap_i32_String_len") ||
    eq(clone(name), "HashMap_i32_fn_len") ||
    eq(clone(name), "HashMap_String_fn_len") ||
    eq(clone(name), "HashMap_String_String_len") {
        return simple_type(commands::TY_I32())
    }
    if eq(clone(name), "HashMap_i32_i32_contains_key") ||
    eq(clone(name), "HashMap_String_i32_contains_key") ||
    eq(clone(name), "HashMap_i32_String_contains_key") ||
    eq(clone(name), "HashMap_i32_fn_contains_key") ||
    eq(clone(name), "HashMap_String_fn_contains_key") ||
    eq(clone(name), "HashMap_String_String_contains_key") {
        return simple_type(commands::TY_BOOL())
    }
    if eq(clone(name), "__hm_si_new") || eq(clone(name), "__hm_si_new_with_cap") {
        return hashmap_string_i32_type()
    }
    if eq(clone(name), "__hm_si_cap") ||
    eq(clone(name), "__hm_si_size") ||
    eq(clone(name), "__hm_si_get_flag") ||
    eq(clone(name), "__hm_si_get_val") {
        return simple_type(commands::TY_I32())
    }
    if eq(clone(name), "__hm_si_get_key") {
        return simple_type(commands::TY_STRING())
    }
    if eq(clone(name), "__hm_is_new") || eq(clone(name), "__hm_is_new_with_cap") {
        return hashmap_i32_string_type()
    }
    if eq(clone(name), "__hm_is_cap") ||
    eq(clone(name), "__hm_is_size") ||
    eq(clone(name), "__hm_is_get_flag") ||
    eq(clone(name), "__hm_is_get_key") {
        return simple_type(commands::TY_I32())
    }
    if eq(clone(name), "__hm_is_get_val") {
        return simple_type(commands::TY_STRING())
    }
    if eq(clone(name), "__hm_if_new") || eq(clone(name), "__hm_if_new_with_cap") {
        return hashmap_i32_fn_type()
    }
    if eq(clone(name), "__hm_if_cap") ||
    eq(clone(name), "__hm_if_size") ||
    eq(clone(name), "__hm_if_get_flag") ||
    eq(clone(name), "__hm_if_get_key") {
        return simple_type(commands::TY_I32())
    }
    if eq(clone(name), "__hm_if_get_val") {
        return simple_type(kinds::TY_FN())
    }
    if eq(clone(name), "__hm_sf_new") || eq(clone(name), "__hm_sf_new_with_cap") {
        return hashmap_string_fn_type()
    }
    if eq(clone(name), "__hm_sf_cap") ||
    eq(clone(name), "__hm_sf_size") ||
    eq(clone(name), "__hm_sf_get_flag") {
        return simple_type(commands::TY_I32())
    }
    if eq(clone(name), "__hm_sf_get_key") {
        return simple_type(commands::TY_STRING())
    }
    if eq(clone(name), "__hm_sf_get_val") {
        return simple_type(kinds::TY_FN())
    }
    if eq(clone(name), "__hm_ss_new") || eq(clone(name), "__hm_ss_new_with_cap") {
        return hashmap_string_string_type()
    }
    if eq(clone(name), "__hm_ss_cap") || eq(clone(name), "__hm_ss_size") || eq(clone(name), "__hm_ss_get_flag") {
        return simple_type(commands::TY_I32())
    }
    if eq(clone(name), "__hm_ss_get_key") || eq(clone(name), "__hm_ss_get_val") {
        return simple_type(commands::TY_STRING())
    }
    if eq(clone(name), "__intrinsic_i31_box") || eq(clone(name), "i31_box") {
        return simple_type(commands::TY_I32())
    }
    simple_type(commands::TY_UNKNOWN())
}
