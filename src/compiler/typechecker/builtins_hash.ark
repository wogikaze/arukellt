use typechecker::kinds
use typechecker::contract_type_access
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation

fn simple_type(tag: i32) -> TypeInfo {
    contract_type_constructors::TypeInfo_simple(tag)
}

fn hashmap_type(key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    let mut hm = simple_type(commands::TY_HASHMAP())
    contract_type_mutation::TypeInfo_push_type_arg(hm, key_ty)
    contract_type_mutation::TypeInfo_push_type_arg(hm, value_ty)
    hm
}

// The non-public __hm_<key><value>_* storage bridge has no Ark declarations;
// the resolver registers the spellings and MIR lowers them to the per-pair
// bucket arrays. The pair is encoded in the two-letter family, so derive the
// return type from the family and the operation suffix instead of repeating
// every pair × operation combination. Remove this once the bridge has real
// declarations (#936).
fn hashmap_builtin_return_type(name: String) -> TypeInfo {
    if name.clone().eq("__intrinsic_i31_box") || name.clone().eq("i31_box") {
        return simple_type(commands::TY_I32())
    }
    if !name.clone().starts_with("__hm_") || name.len() < 9 {
        return simple_type(commands::TY_UNKNOWN())
    }
    let family = name.slice(5, 7)
    let key_ty = hashmap_family_key_type(family.clone())
    if contract_type_access::TypeInfo_tag(key_ty) == commands::TY_UNKNOWN() {
        return simple_type(commands::TY_UNKNOWN())
    }
    let value_ty = hashmap_family_value_type(family)
    let op = name.slice(8, name.len())
    if op.clone().eq("new") || op.clone().eq("new_with_cap") {
        return hashmap_type(key_ty, value_ty)
    }
    if op.clone().eq("cap") || op.clone().eq("size") || op.clone().eq("get_flag") {
        return simple_type(commands::TY_I32())
    }
    if op.clone().eq("get_key") {
        return key_ty
    }
    if op.clone().eq("get_val") {
        return value_ty
    }
    simple_type(commands::TY_UNKNOWN())
}

fn hashmap_family_key_type(family: String) -> TypeInfo {
    if family.clone().eq("si") || family.clone().eq("sf") || family.clone().eq("ss") {
        return simple_type(commands::TY_STRING())
    }
    if family.clone().eq("is") || family.clone().eq("if") {
        return simple_type(commands::TY_I32())
    }
    simple_type(commands::TY_UNKNOWN())
}

fn hashmap_family_value_type(family: String) -> TypeInfo {
    if family.clone().eq("si") {
        return simple_type(commands::TY_I32())
    }
    if family.clone().eq("if") || family.clone().eq("sf") {
        return simple_type(kinds::TY_FN())
    }
    if family.clone().eq("is") || family.clone().eq("ss") {
        return simple_type(commands::TY_STRING())
    }
    simple_type(commands::TY_UNKNOWN())
}
