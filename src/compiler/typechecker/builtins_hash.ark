use typechecker::kinds
use typechecker::contract_type_access
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::types
fn simple_type(tag: i32) -> TypeInfo {
    contract_type_constructors::TypeInfo_simple(tag)
}

fn hashmap_type(key: String, val: String) -> TypeInfo {
    let mut hm = simple_type(commands::TY_HASHMAP())
    contract_type_mutation::TypeInfo_push_type_arg(hm, types::resolve_type_name(key))
    contract_type_mutation::TypeInfo_push_type_arg(hm, types::resolve_type_name(val))
    hm
}

fn hashmap_string_i32_type() -> TypeInfo {
    hashmap_type("String", "i32")
}

fn hashmap_i32_string_type() -> TypeInfo {
    hashmap_type("i32", "String")
}

fn hashmap_i32_fn_type() -> TypeInfo {
    let mut hm = simple_type(commands::TY_HASHMAP())
    contract_type_mutation::TypeInfo_push_type_arg(hm, simple_type(commands::TY_I32()))
    contract_type_mutation::TypeInfo_push_type_arg(hm, simple_type(kinds::TY_FN()))
    hm
}

fn hashmap_string_fn_type() -> TypeInfo {
    let mut hm = simple_type(commands::TY_HASHMAP())
    contract_type_mutation::TypeInfo_push_type_arg(hm, simple_type(commands::TY_STRING()))
    contract_type_mutation::TypeInfo_push_type_arg(hm, simple_type(kinds::TY_FN()))
    hm
}

fn hashmap_string_string_type() -> TypeInfo {
    hashmap_type("String", "String")
}

// The high-level HashMap_<K>_<V>_* builtins were retired by #917: the
// source spelling is `HashMap::new<K, V>()` plus receiver methods, which
// `typechecker::hashmap_methods` types. Only the non-public __hm_* storage
// bridge keeps builtin call typing here.
fn hashmap_builtin_return_type(name: String) -> TypeInfo {
    if name.clone().eq("__hm_si_new") || name.clone().eq("__hm_si_new_with_cap") {
        return hashmap_string_i32_type()
    }
    if name.clone().eq("__hm_si_cap") ||
    name.clone().eq("__hm_si_size") ||
    name.clone().eq("__hm_si_get_flag") ||
    name.clone().eq("__hm_si_get_val") {
        return simple_type(commands::TY_I32())
    }
    if name.clone().eq("__hm_si_get_key") {
        return simple_type(commands::TY_STRING())
    }
    if name.clone().eq("__hm_is_new") || name.clone().eq("__hm_is_new_with_cap") {
        return hashmap_i32_string_type()
    }
    if name.clone().eq("__hm_is_cap") ||
    name.clone().eq("__hm_is_size") ||
    name.clone().eq("__hm_is_get_flag") ||
    name.clone().eq("__hm_is_get_key") {
        return simple_type(commands::TY_I32())
    }
    if name.clone().eq("__hm_is_get_val") {
        return simple_type(commands::TY_STRING())
    }
    if name.clone().eq("__hm_if_new") || name.clone().eq("__hm_if_new_with_cap") {
        return hashmap_i32_fn_type()
    }
    if name.clone().eq("__hm_if_cap") ||
    name.clone().eq("__hm_if_size") ||
    name.clone().eq("__hm_if_get_flag") ||
    name.clone().eq("__hm_if_get_key") {
        return simple_type(commands::TY_I32())
    }
    if name.clone().eq("__hm_if_get_val") {
        return simple_type(kinds::TY_FN())
    }
    if name.clone().eq("__hm_sf_new") || name.clone().eq("__hm_sf_new_with_cap") {
        return hashmap_string_fn_type()
    }
    if name.clone().eq("__hm_sf_cap") ||
    name.clone().eq("__hm_sf_size") ||
    name.clone().eq("__hm_sf_get_flag") {
        return simple_type(commands::TY_I32())
    }
    if name.clone().eq("__hm_sf_get_key") {
        return simple_type(commands::TY_STRING())
    }
    if name.clone().eq("__hm_sf_get_val") {
        return simple_type(kinds::TY_FN())
    }
    if name.clone().eq("__hm_ss_new") || name.clone().eq("__hm_ss_new_with_cap") {
        return hashmap_string_string_type()
    }
    if name.clone().eq("__hm_ss_cap") || name.clone().eq("__hm_ss_size") || name.clone().eq("__hm_ss_get_flag") {
        return simple_type(commands::TY_I32())
    }
    if name.clone().eq("__hm_ss_get_key") || name.clone().eq("__hm_ss_get_val") {
        return simple_type(commands::TY_STRING())
    }
    if name.clone().eq("__intrinsic_i31_box") || name.clone().eq("i31_box") {
        return simple_type(commands::TY_I32())
    }
    simple_type(commands::TY_UNKNOWN())
}
