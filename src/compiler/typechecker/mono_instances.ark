use std::text
use std::prelude::{byte_at, clone, eq, index_of, substring}
use collections::name_index
use typechecker::associated_types
use typechecker::contract_fn_sig
use typechecker::contract_mono
use typechecker::contract_env_mono_record
use typechecker::contract_trait_impl
use typechecker::contract_trait_impl_record
use typechecker::contract_trait_method_record
use typechecker::contract_type_access
use typechecker::contract_types_record
use typechecker::instantiate
use typechecker::mono_key
use typechecker::trait_method_registry
use typechecker::trait_method_record
use typechecker::names
use typechecker::types

// Instance demand is a closure over the call edges of the bodies MIR
// will emit: an instance is demanded when a demanded body statically
// resolves a call to it (#912). Every call site produces a demand edge —
// concrete calls record their instance directly, calls whose arguments
// still mention enclosing type parameters record a template site that
// rebind_enclosing_template_sites binds when the enclosing function is
// instantiated, and trait method calls on a bare type-var receiver
// record a trait-method site that the same rebind resolves through the
// receiver's impl. There are no global caps and no speculative
// propagation: the closure terminates because sites are a finite set
// bound to concrete arguments and every mint dedups by mangled name.
// The former MONO_PROPAGATE_INSTANCE_BUDGET / receiver-depth stopgaps
// (#908) masked missing call edges by minting whole impl-method sets;
// that over-approximation was itself the termination hazard — a minted
// sibling's sites rebind ever-deeper adapter receivers without bound.
// Only genuinely polymorphic-recursive programs (no finite demanded
// set) still need fuel to cut off.

fn record_mono_instance(mut env: TypeEnv, fn_name: String, resolved_types: Vec<TypeInfo>) -> String {
    let mut mangled = clone(fn_name)
    let count = len(resolved_types)
    let mut i = 0
    while i < count {
        let ty = get_unchecked(resolved_types, i)
        mangled = mangled.concat("__".concat(mono_key::mono_type_key(ty)))
        i = i + 1
    }
    record_template_site_if_generic(env, clone(fn_name), clone(mangled), clone(resolved_types))
    let mi_count = contract_env_mono_record::type_env_mono_instance_count(env)
    let mut j = 0
    while j < mi_count {
        let mut mi = contract_env_mono_record::type_env_mono_instance_at(env, j)
        if eq(contract_mono::MonoInstance_mangled_name(mi), clone(mangled)) {
            if !contract_mono::MonoInstance_demanded(mi) {
                // An instance minted without demand (module merge or a
                // call-site marker) turned out to be a real call target:
                // upgrade it and bind its body's own demand edges.
                contract_mono::MonoInstance_set_demanded(mi)
                rebind_enclosing_template_sites(env, clone(fn_name), resolved_types)
            }
            return mangled
        }
        j = j + 1
    }
    let mut inst = contract_mono::MonoInstance_new(clone(fn_name), clone(mangled), clone(resolved_types))
    contract_mono::MonoInstance_set_demanded(inst)
    contract_env_mono_record::type_env_push_mono_instance(env, inst)
    rebind_enclosing_template_sites(env, fn_name, resolved_types)
    mangled
}

// Demand-driven propagation, callee axis (ADR-078). A call inside a
// generic body on a receiver that still mentions the enclosing
// function's type parameters (`inner.next()` on `Inner<I>` inside
// `Outer<I>::next`) records a template instance here. The enclosing
// function's concrete instantiation later supplies the arguments that
// re-bind the site into a callable instance; without it the call site
// can only bind the trapping template body.
fn record_template_site_if_generic(mut env: TypeEnv, fn_name: String, mangled_name: String, resolved_types: Vec<TypeInfo>) {
    if len(env.current_fn_name) == 0 {
        return
    }
    let mut mentions_var = false
    let count = len(resolved_types)
    let mut i = 0
    while i < count {
        if associated_types::type_contains_var(get_unchecked(resolved_types, i)) {
            mentions_var = true
        }
        i = i + 1
    }
    if !mentions_var {
        return
    }
    let site_count = len(env.mono_template_sites)
    let mut s = 0
    while s < site_count {
        let site = get_unchecked(env.mono_template_sites, s)
        if eq(clone(site.mangled_name), clone(mangled_name)) &&
        eq(clone(site.enclosing_fn), clone(env.current_fn_name)) {
            return
        }
        s = s + 1
    }
    push(env.mono_template_sites, MonoTemplateSite {
            fn_name: fn_name,
            mangled_name: mangled_name,
            type_args: resolved_types,
            enclosing_fn: clone(env.current_fn_name),
            enclosing_vars: clone(env.current_fn_type_params),
            is_var_method: false
        })
}

// Demand edge for method calls on a still-open type-var receiver
// (ADR-078, #912). `x.next()` where `x` is a bare type variable cannot
// name a concrete impl at check time -- even without a declared trait
// bound (`self.iter.next()` inside `impl Iterator for TakeIter<I>`),
// the call is a real demand edge. The site records the unqualified
// method name with the open receiver as its single type argument; when
// the enclosing function is instantiated,
// rebind_enclosing_template_sites binds the receiver and resolves the
// site through the impl table to `Receiver::method`.
fn record_var_method_site(mut env: TypeEnv, method_name: String, recv_ty: TypeInfo) {
    if len(env.current_fn_name) == 0 {
        return
    }
    if !associated_types::type_contains_var(clone(recv_ty)) &&
    !is_var_projection_receiver(env, clone(recv_ty)) {
        return
    }
    let mut mangled = clone(method_name)
    mangled = mangled.concat(String_from("__").concat(mono_key::mono_type_key(clone(recv_ty))))
    let site_count = len(env.mono_template_sites)
    let mut s = 0
    while s < site_count {
        let site = get_unchecked(env.mono_template_sites, s)
        if eq(clone(site.mangled_name), clone(mangled)) &&
        eq(clone(site.enclosing_fn), clone(env.current_fn_name)) {
            return
        }
        s = s + 1
    }
    let mut site_args = Vec::new<TypeInfo>()
    push(site_args, clone(recv_ty))
    push(env.mono_template_sites, MonoTemplateSite {
            fn_name: method_name,
            mangled_name: mangled,
            type_args: site_args,
            enclosing_fn: clone(env.current_fn_name),
            enclosing_vars: clone(env.current_fn_type_params),
            is_var_method: true
        })
}

// A `T::Assoc` projection carries an enclosing type variable in its
// owner prefix even though type_contains_var only inspects type
// arguments. For-desugar sites record `next` on `T::IntoIter` (#916).
fn is_var_projection_receiver(env: TypeEnv, recv_ty: TypeInfo) -> bool {
    if contract_type_access::TypeInfo_tag(recv_ty) != commands::TY_STRUCT() {
        return false
    }
    let name = contract_type_access::TypeInfo_name(recv_ty)
    let sep = associated_types::projection_sep_index(clone(name))
    if sep <= 0 {
        return false
    }
    let owner = substring(clone(name), 0, sep)
    let count = len(env.current_fn_type_params)
    let mut i = 0
    while i < count {
        if eq(get_unchecked(env.current_fn_type_params, i), clone(owner)) {
            return true
        }
        i = i + 1
    }
    false
}

// `Reverse<I>::cmp` -> `Reverse::cmp`: impl method sigs name the enclosing
// fn with the impl head's type params attached, while the mono instance key
// arrives with them resolved away (Reverse::cmp). Only the first balanced
// <...> span is removed — the owner head.
fn erase_impl_owner_args(name: String) -> String {
    let n = len(name)
    let mut lt = 0 - 1
    let mut i = 0
    while i < n {
        if byte_at(name, i) == 60 {
            lt = i
            i = n
        }
        i = i + 1
    }
    if lt < 0 {
        return name
    }
    let mut depth = 0
    let mut gt = 0 - 1
    i = lt
    while i < n {
        if byte_at(name, i) == 60 {
            depth = depth + 1
        }
        if byte_at(name, i) == 62 {
            depth = depth - 1
            if depth == 0 {
                gt = i
                i = n
            }
        }
        i = i + 1
    }
    if gt < 0 {
        return name
    }
    substring(name, 0, lt).concat(substring(name, gt + 1, n))
}

// `enclosing_fn` stores FnSig_name of the body being checked: bare decl
// names for free fns and trait-decl methods, `Owner<I>::m` for impl
// methods. Instantiated keys arrive type-qualified (Vec::sort) or
// impl-qualified (Reverse::cmp). Match shapes:
//   sort             vs Vec::sort     -> last `::` segment
//   Reverse<I>::cmp  vs Reverse::cmp  -> owner type-arg erasure
//   cmp              vs Ord::cmp      -> trait-decl vs trait name
// Critically `Ord::cmp` must NOT match `Reverse<I>::cmp` sites: a purely
// unqualified compare collapses every `cmp`/`next`/`eq` impl into one
// bucket and the mint chain explodes (#920 emit-phase stall).
fn enclosing_matches_instantiation(site_name: String, fn_name: String) -> bool {
    if eq(clone(site_name), clone(fn_name)) {
        return true
    }
    let site_erased = erase_impl_owner_args(clone(site_name))
    let fn_erased = erase_impl_owner_args(clone(fn_name))
    if eq(clone(site_erased), clone(fn_erased)) {
        return true
    }
    if index_of(clone(site_name), String_from("::")) < 0 {
        if eq(names::unqualified_type_name(clone(fn_erased)), clone(site_name)) {
            return true
        }
    }
    false
}

// Re-bind template sites recorded inside `fn_name`'s body now that a
// concrete instantiation supplies its arguments. `Outer::next`+[VecIter]
// turns the `Inner::next`+[?I] site into `Inner::next`+[VecIter], which
// MIR lowering can then emit and span-rewrite call sites can resolve.
fn rebind_enclosing_template_sites(mut env: TypeEnv, fn_name: String, resolved_types: Vec<TypeInfo>) {
    if len(resolved_types) == 0 {
        return
    }
    let arg_count = len(resolved_types)
    let mut a = 0
    while a < arg_count {
        if associated_types::type_contains_var(get_unchecked(resolved_types, a)) {
            return
        }
        a = a + 1
    }
    let site_count = len(env.mono_template_sites)
    let mut s = 0
    while s < site_count {
        let site = get_unchecked(env.mono_template_sites, s)
        if enclosing_matches_instantiation(clone(site.enclosing_fn), clone(fn_name)) {
            let site_vars = clone(site.enclosing_vars)
            if len(site_vars) == arg_count {
                let site_args = clone(site.type_args)
                let mut bound_args = Vec::new<TypeInfo>()
                let mut b = 0
                while b < len(site_args) {
                    push(
                        bound_args,
                        associated_types::normalize_projection_ty(
                            env,
                            clone(site_vars),
                            clone(resolved_types),
                            instantiate::instantiate_type(
                                get_unchecked(site_args, b),
                                clone(site_vars),
                                clone(resolved_types)
                            )
                        )
                    )
                    b = b + 1
                }
                let mut _rebound = String_new()
                if site.is_var_method {
                    // Method call on a type-var receiver: the bound
                    // receiver selects the impl and its
                    // `Receiver::method` body. Unresolvable sites were
                    // unresolved calls at check time too -- record
                    // nothing rather than a phantom bare-name instance.
                    if len(bound_args) > 0 {
                        _rebound = resolve_var_method_site(
                            env,
                            clone(site.fn_name),
                            get_unchecked(bound_args, 0)
                        )
                    }
                } else {
                    let mut resolved_via_trait = false
                    let sep = associated_types::projection_sep_index(clone(site.fn_name))
                    if sep >= 0 && len(bound_args) > 0 {
                        let trait_entry = trait_method_registry::lookup_trait_method(
                            env,
                            substring(clone(site.fn_name), 0, sep),
                            substring(clone(site.fn_name), sep + 2, len(site.fn_name))
                        )
                        if contract_fn_sig::FnSig_has_name(
                            contract_trait_method_record::trait_method_entry_sig(trait_entry)
                        ) {
                            // Trait-qualified call (`Iterator::next(x)`):
                            // the bound receiver selects the impl.
                            _rebound = mint_trait_method_instance(
                                env,
                                trait_entry,
                                substring(clone(site.fn_name), sep + 2, len(site.fn_name)),
                                get_unchecked(bound_args, 0)
                            )
                            resolved_via_trait = true
                        }
                    }
                    if !resolved_via_trait {
                        _rebound = record_mono_instance(
                            env,
                            clone(site.fn_name),
                            bound_args
                        )
                    }
                }
                // The rebound instance also needs the resolved return:
                // the template recorded it under the enclosing vars
                // (Vec<U> for collect_iterator inside MapIter<T,U>::collect).
                // Without it MIR falls back to the raw projection and emits
                // vec:T::Item with an opaque structref element (#691).
                let template_ret = mono_instance_return_type_by_mangled(
                    env,
                    clone(site.mangled_name)
                )
                if contract_type_access::TypeInfo_tag(clone(template_ret)) != 0 {
                    let rebound_ret = associated_types::normalize_projection_ty(
                        env,
                        clone(site_vars),
                        clone(resolved_types),
                        instantiate::instantiate_type(
                            clone(template_ret),
                            clone(site_vars),
                            clone(resolved_types)
                        )
                    )
                    record_mono_return_type(env, clone(_rebound), rebound_ret)
                }
            }
        }
        s = s + 1
    }
}

fn mono_instance_return_type_by_mangled(env: TypeEnv, mangled_name: String) -> TypeInfo {
    let count = contract_env_mono_record::type_env_mono_instance_count(env)
    let mut i = 0
    while i < count {
        let instance = contract_env_mono_record::type_env_mono_instance_at(env, i)
        if eq(
            contract_mono::MonoInstance_mangled_name(instance),
            clone(mangled_name)
        ) {
            return contract_mono::MonoInstance_return_type(instance)
        }
        i = i + 1
    }
    contract_types_record::TypeInfo_new(commands::TY_UNKNOWN(), String_new(), Vec::new<TypeInfo>())
}

fn record_mono_return_type(env: TypeEnv, mangled_name: String, return_type: TypeInfo) {
    let count = contract_env_mono_record::type_env_mono_instance_count(env)
    let mut i = 0
    while i < count {
        let mut instance = contract_env_mono_record::type_env_mono_instance_at(env, i)
        if eq(
            contract_mono::MonoInstance_mangled_name(instance),
            clone(mangled_name)
        ) {
            contract_mono::MonoInstance_set_return_type(instance, return_type)
            return
        }
        i = i + 1
    }
}

// Mint the concrete impl method a bound trait-method site resolves to
// (#912). The bound receiver selects the impl: trait name from the site
// entry must match and the impl self type's name must equal the
// receiver's, so `Iterator::next` at receiver `TakeIter<i32>` binds the
// impl's head vars and records `TakeIter::next`+[i32] demanded. The
// resolved return type is recorded the same way argument-impl
// propagation used to, keeping MIR scrutinee payloads typed. A method
// whose own type parameters outnumber the trait's cannot be resolved
// from the receiver alone; its call sites record directly instead.
fn mint_trait_method_instance(mut env: TypeEnv, entry: TraitMethodEntry, method_name: String, receiver: TypeInfo) -> String {
    if associated_types::type_contains_var(clone(receiver)) {
        return String_new()
    }
    let sig = contract_trait_method_record::trait_method_entry_sig(entry)
    let trait_param_count = trait_method_record::trait_method_entry_trait_type_param_count(entry)
    if contract_fn_sig::FnSig_type_param_count(sig) > trait_param_count {
        return String_new()
    }
    let trait_name = contract_trait_method_record::trait_method_entry_trait_name(entry)
    let owner_name = names::unqualified_type_name(contract_type_access::TypeInfo_name(clone(receiver)))
    let impl_count = len(env.trait_impls)
    let mut i = 0
    while i < impl_count {
        let impl_info = get_unchecked(env.trait_impls, i)
        let self_ty = contract_trait_impl::TraitImplInfo_self_ty(impl_info)
        if eq(
            contract_trait_impl::TraitImplInfo_trait_name(impl_info),
            clone(trait_name)
        ) && names::same_type_name(
            contract_type_access::TypeInfo_name(self_ty),
            contract_type_access::TypeInfo_name(clone(receiver))
        ) {
            let mut var_names = Vec::new<String>()
            let mut var_types = Vec::new<TypeInfo>()
            if !associated_types::match_pattern_collect_vars(
                self_ty,
                clone(receiver),
                var_names,
                var_types
            ) {
                i = i + 1
                continue
            }
            let method_fn = clone(owner_name).concat(String_from("::").concat(clone(method_name)))
            // Only impl-defined methods have a body to monomorphize;
            // trait defaults live under the trait's own owner name and
            // would record a phantom instance here.
            if name_index::name_index_get(env.fn_sig_index, clone(method_fn)) < 0 {
                i = i + 1
                continue
            }
            let mangled = record_mono_instance(env, clone(method_fn), clone(var_types))
            let recorded_ret = mono_instance_return_type_by_mangled(env, clone(mangled))
            if contract_type_access::TypeInfo_tag(recorded_ret) != 0 {
                return mangled
            }
            let bound = propagated_trait_bound(
                impl_info,
                var_names,
                var_types,
                clone(trait_name)
            )
            let resolved_sig = associated_types::resolve_trait_method_signature(
                env,
                entry,
                bound,
                clone(receiver)
            )
            record_mono_return_type(
                env,
                clone(mangled),
                associated_types::normalize_projection_ty(
                    env,
                    clone(var_names),
                    clone(var_types),
                    // resolve_trait_method_signature substitutes Self and
                    // trait-level params only; impl-head vars (I in
                    // TakeIter<I>) survive in the signature. Bind them to
                    // the receiver's concrete args first so the recorded
                    // return is TakeIter<VecIter>, not TakeIter<I>.
                    instantiate::instantiate_type(
                        contract_fn_sig::FnSig_return_type(resolved_sig),
                        clone(var_names),
                        clone(var_types)
                    )
                )
            )
            return mangled
        }
        i = i + 1
    }
    String_new()
}

// The trait reference with the impl's type variables replaced by the
// receiver's concrete arguments, used to resolve trait-method signatures.
// Resolve a bound var-method site to its concrete impl method (#912).
// The receiver is already concrete: scan the impl table for a trait
// impl on the receiver's type that declares `method_name`, then mint
// `Receiver::method` through the same path trait-qualified sites use.
// Inherent-impl methods are not in the impl table; those calls were
// unresolvable at check time as well, so an empty result is correct.
fn resolve_var_method_site(mut env: TypeEnv, method_name: String, receiver: TypeInfo) -> String {
    let owner_name = names::unqualified_type_name(
        contract_type_access::TypeInfo_name(clone(receiver))
    )
    let impl_count = len(env.trait_impls)
    let mut i = 0
    while i < impl_count {
        let impl_info = get_unchecked(env.trait_impls, i)
        let self_ty = contract_trait_impl::TraitImplInfo_self_ty(impl_info)
        let trait_name = contract_trait_impl::TraitImplInfo_trait_name(impl_info)
        if len(trait_name) > 0 && names::same_type_name(
            contract_type_access::TypeInfo_name(self_ty),
            clone(owner_name)
        ) {
            let entry = trait_method_registry::lookup_trait_method(
                env,
                clone(trait_name),
                clone(method_name)
            )
            if contract_fn_sig::FnSig_has_name(
                contract_trait_method_record::trait_method_entry_sig(entry)
            ) {
                return mint_trait_method_instance(env, entry, method_name, receiver)
            }
        }
        i = i + 1
    }
    String_new()
}

fn propagated_trait_bound(
    impl_info: TraitImplInfo,
    var_names: Vec<String>,
    var_types: Vec<TypeInfo>,
    trait_name: String
) -> TypeInfo {
    let base = types::resolve_type_name(clone(trait_name))
    let arg_patterns = contract_trait_impl_record::trait_impl_info_trait_args(impl_info)
    let arg_count = len(arg_patterns)
    if arg_count == 0 {
        return base
    }
    let mut concrete_args = Vec::new<TypeInfo>()
    let mut i = 0
    while i < arg_count {
        push(
            concrete_args,
            instantiate::instantiate_type(
                get_unchecked(arg_patterns, i),
                clone(var_names),
                clone(var_types)
            )
        )
        i = i + 1
    }
    contract_types_record::TypeInfo_new(
        contract_type_access::TypeInfo_tag(base),
        contract_type_access::TypeInfo_name(base),
        concrete_args
    )
}

fn has_mono_instance_for(mono_instances: Vec<MonoInstance>, fn_name: String) -> bool {
    let count = len(mono_instances)
    let mut i = 0
    while i < count {
        let mi = get_unchecked(mono_instances, i)
        if eq(contract_mono::MonoInstance_fn_name(mi), clone(fn_name)) {
            return true
        }
        i = i + 1
    }
    false
}
