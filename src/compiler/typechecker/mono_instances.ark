use std::text
use std::prelude::{clone, eq, substring}
use collections::name_index
use typechecker::associated_types
use typechecker::contract_fn_sig
use typechecker::contract_mono
use typechecker::contract_env_mono_record
use typechecker::contract_trait_impl
use typechecker::contract_trait_impl_record
use typechecker::contract_trait_method_record
use typechecker::contract_type_access
use typechecker::contract_types_record
use typechecker::instantiate
use typechecker::mono_key
use typechecker::trait_method_record
use typechecker::names
use typechecker::types

// Speculative propagation must stay inside a finite receiver space.
// Adapter constructors are open-ended: once projections like I::Item
// resolve through impls, sibling-propagation and template-site rebinding
// on ever-deeper adapter receivers mint fresh MonoInstances forever — a
// flat-overlay s2 never finished checking use std::core::iter. Instances
// deeper than this bound are still recorded (dedup + emit); only their
// transitive propagation is cut. The call sites a deep body needs were
// already minted at shallower receivers.
const MONO_PROPAGATE_DEPTH_LIMIT: i32 = 2

// The depth bound alone does not stop the breadth explosion: at depth <=2
// the adapter x impl-method cross product still mints new distinct
// instances for minutes (seq::binary_search_by check burned >15G fuel).
// Propagated siblings only exist so impl bodies can call sibling methods
// at the same concrete receiver; once the recorded set is large, the odds
// a further speculative instance is ever called are negligible. Cap the
// total recorded set so propagation provably terminates. The budget gates
// propagate_parametric_impl_mono only: rebind_enclosing_template_sites is
// demand binding that every recorded instantiation needs, so it must run
// past the cap or late instances emit untyped Option/Result scrutinees.
pub fn MONO_PROPAGATE_INSTANCE_BUDGET() -> i32 {
    300
}

fn mono_type_ctor_depth(ty: TypeInfo) -> i32 {
    let arg_count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut best = 0
    let mut i = 0
    while i < arg_count {
        let d = mono_type_ctor_depth(contract_type_access::TypeInfo_type_arg_at(ty, i))
        if d > best {
            best = d
        }
        i = i + 1
    }
    best + 1
}

fn mono_args_within_depth(resolved_types: Vec<TypeInfo>) -> bool {
    let count = len(resolved_types)
    let mut i = 0
    while i < count {
        let arg = get_unchecked(resolved_types, i)
        // Var-carrying args (Take::next+[?I]) have ctor depth 1 and would
        // otherwise propagate: match_pattern_collect_vars then binds impl
        // self-type vars against a still-open receiver, and the resulting
        // instances record+propagate again without ever converging.
        if associated_types::type_contains_var(clone(arg)) {
            return false
        }
        if mono_type_ctor_depth(arg) > MONO_PROPAGATE_DEPTH_LIMIT() {
            return false
        }
        i = i + 1
    }
    true
}

fn record_mono_instance(env: TypeEnv, fn_name: String, resolved_types: Vec<TypeInfo>) -> String {
    let mut mangled = clone(fn_name)
    let count = len(resolved_types)
    let mut i = 0
    while i < count {
        let ty = get_unchecked(resolved_types, i)
        mangled = text::builder_append(mangled, text::concat("__", mono_key::mono_type_key(ty)))
        i = i + 1
    }
    record_template_site_if_generic(env, clone(fn_name), clone(mangled), clone(resolved_types))
    let mi_count = contract_env_mono_record::type_env_mono_instance_count(env)
    let mut j = 0
    while j < mi_count {
        let mi = contract_env_mono_record::type_env_mono_instance_at(env, j)
        if eq(contract_mono::MonoInstance_mangled_name(mi), clone(mangled)) {
            if !contract_mono::MonoInstance_demanded(mi) {
                // A speculatively minted instance turned out to be a real
                // call target: upgrade it and re-run the demand closure so
                // the instances its body needs get marked too.
                contract_mono::MonoInstance_set_demanded(mi)
                propagate_arg_impls_for(env, clone(fn_name), clone(resolved_types), true)
                rebind_enclosing_template_sites(env, clone(fn_name), resolved_types, true)
            }
            return mangled
        }
        j = j + 1
    }
    let inst = contract_mono::MonoInstance_new(clone(fn_name), clone(mangled), clone(resolved_types))
    contract_mono::MonoInstance_set_demanded(inst)
    contract_env_mono_record::type_env_push_mono_instance(env, inst)
    propagate_arg_impls_for(env, clone(fn_name), clone(resolved_types), true)
    if contract_env_mono_record::type_env_mono_instance_count(env) <= MONO_PROPAGATE_INSTANCE_BUDGET() {
        propagate_parametric_impl_mono(env, clone(fn_name), resolved_types)
    }
    rebind_enclosing_template_sites(env, fn_name, resolved_types, true)
    mangled
}

// Recording without speculative propagation. Propagation-minted siblings
// use this so the closure stays one level deep: a real call's propagation
// mints the sibling methods its impl body can call on the same receiver,
// and those siblings do not propagate again. Letting them re-propagate
// chains receiver -> impl methods -> record -> propagate and enumerates
// the adapter x method space (~15G fuel on a seq::binary_search_by call).
// Rebind still runs: a propagated sibling's body may hold ?T call sites
// that must bind once the sibling is emitted with concrete args.
fn record_propagated_mono_instance(env: TypeEnv, fn_name: String, resolved_types: Vec<TypeInfo>) -> String {
    let mut mangled = clone(fn_name)
    let count = len(resolved_types)
    let mut i = 0
    while i < count {
        let ty = get_unchecked(resolved_types, i)
        mangled = text::builder_append(mangled, text::concat("__", mono_key::mono_type_key(ty)))
        i = i + 1
    }
    let mi_count = contract_env_mono_record::type_env_mono_instance_count(env)
    let mut j = 0
    while j < mi_count {
        let mi = contract_env_mono_record::type_env_mono_instance_at(env, j)
        if eq(contract_mono::MonoInstance_mangled_name(mi), clone(mangled)) {
            return mangled
        }
        j = j + 1
    }
    contract_env_mono_record::type_env_push_mono_instance(env, contract_mono::MonoInstance_new(clone(fn_name), clone(mangled), clone(resolved_types)))
    propagate_arg_impls_for(env, clone(fn_name), clone(resolved_types), false)
    rebind_enclosing_template_sites(env, fn_name, resolved_types, false)
    mangled
}

// Demand-driven propagation, callee axis (ADR-078). A call inside a
// generic body on a receiver that still mentions the enclosing
// function's type parameters (`inner.next()` on `Inner<I>` inside
// `Outer<I>::next`) records a template instance here. The enclosing
// function's concrete instantiation later supplies the arguments that
// re-bind the site into a callable instance; without it the call site
// can only bind the trapping template body.
fn record_template_site_if_generic(env: TypeEnv, fn_name: String, mangled_name: String, resolved_types: Vec<TypeInfo>) {
    if len(env.current_fn_name) == 0 {
        return
    }
    let mut mentions_var = false
    let count = len(resolved_types)
    let mut i = 0
    while i < count {
        if associated_types::type_contains_var(get_unchecked(resolved_types, i)) {
            mentions_var = true
        }
        i = i + 1
    }
    if !mentions_var {
        return
    }
    let site_count = len(env.mono_template_sites)
    let mut s = 0
    while s < site_count {
        let site = get_unchecked(env.mono_template_sites, s)
        if eq(clone(site.mangled_name), clone(mangled_name)) &&
        eq(clone(site.enclosing_fn), clone(env.current_fn_name)) {
            return
        }
        s = s + 1
    }
    push(env.mono_template_sites, MonoTemplateSite {
            fn_name: fn_name,
            mangled_name: mangled_name,
            type_args: resolved_types,
            enclosing_fn: clone(env.current_fn_name),
            enclosing_vars: clone(env.current_fn_type_params)
        })
}

// Re-bind template sites recorded inside `fn_name`'s body now that a
// concrete instantiation supplies its arguments. `Outer::next`+[VecIter]
// turns the `Inner::next`+[?I] site into `Inner::next`+[VecIter], which
// MIR lowering can then emit and span-rewrite call sites can resolve.
// The bound children inherit the parent's demanded flag: a demanded body
// needs its callees emitted, a speculative parent does not.
fn rebind_enclosing_template_sites(env: TypeEnv, fn_name: String, resolved_types: Vec<TypeInfo>, demanded: bool) {
    if len(resolved_types) == 0 {
        return
    }
    let arg_count = len(resolved_types)
    let mut a = 0
    while a < arg_count {
        if associated_types::type_contains_var(get_unchecked(resolved_types, a)) {
            return
        }
        a = a + 1
    }
    let site_count = len(env.mono_template_sites)
    let mut s = 0
    while s < site_count {
        let site = get_unchecked(env.mono_template_sites, s)
        if eq(clone(site.enclosing_fn), clone(fn_name)) {
            let site_vars = clone(site.enclosing_vars)
            if len(site_vars) == arg_count {
                let site_args = clone(site.type_args)
                let bound_args = Vec::new<TypeInfo>()
                let mut b = 0
                while b < len(site_args) {
                    push(
                        bound_args,
                        associated_types::normalize_projection_ty(
                            env,
                            clone(site_vars),
                            clone(resolved_types),
                            instantiate::instantiate_type(
                                get_unchecked(site_args, b),
                                clone(site_vars),
                                clone(resolved_types)
                            )
                        )
                    )
                    b = b + 1
                }
                let mut _rebound = clone(site.mangled_name)
                if demanded {
                    _rebound = record_mono_instance(
                        env,
                        clone(site.fn_name),
                        bound_args
                    )
                } else {
                    _rebound = record_propagated_mono_instance(
                        env,
                        clone(site.fn_name),
                        bound_args
                    )
                }
                // The rebound instance also needs the resolved return:
                // the template recorded it under the enclosing vars
                // (Vec<U> for collect_iterator inside MapIter<T,U>::collect).
                // Without it MIR falls back to the raw projection and emits
                // vec:T::Item with an opaque structref element (#691).
                let template_ret = mono_instance_return_type_by_mangled(
                    env,
                    clone(site.mangled_name)
                )
                if contract_type_access::TypeInfo_tag(clone(template_ret)) != 0 {
                    let rebound_ret = associated_types::normalize_projection_ty(
                        env,
                        clone(site_vars),
                        clone(resolved_types),
                        instantiate::instantiate_type(
                            clone(template_ret),
                            clone(site_vars),
                            clone(resolved_types)
                        )
                    )
                    record_mono_return_type(env, clone(_rebound), rebound_ret)
                }
            }
        }
        s = s + 1
    }
}

fn mono_instance_return_type_by_mangled(env: TypeEnv, mangled_name: String) -> TypeInfo {
    let count = contract_env_mono_record::type_env_mono_instance_count(env)
    let mut i = 0
    while i < count {
        let instance = contract_env_mono_record::type_env_mono_instance_at(env, i)
        if eq(
            contract_mono::MonoInstance_mangled_name(instance),
            clone(mangled_name)
        ) {
            return contract_mono::MonoInstance_return_type(instance)
        }
        i = i + 1
    }
    contract_types_record::TypeInfo_new(commands::TY_UNKNOWN(), String_new(), Vec::new<TypeInfo>())
}

fn record_mono_return_type(env: TypeEnv, mangled_name: String, return_type: TypeInfo) {
    let count = contract_env_mono_record::type_env_mono_instance_count(env)
    let mut i = 0
    while i < count {
        let instance = contract_env_mono_record::type_env_mono_instance_at(env, i)
        if eq(
            contract_mono::MonoInstance_mangled_name(instance),
            clone(mangled_name)
        ) {
            contract_mono::MonoInstance_set_return_type(instance, return_type)
            return
        }
        i = i + 1
    }
}

// Demand-driven nested monomorphization approximation (ADR-078). When
// `Twice::next` monomorphizes at I=WrapIter<i32>, its body calls
// `self.iter.next()`, which needs `WrapIter::next`+[i32]. The typechecker
// cannot see inside impl bodies, so recording an instance whose resolved
// args instantiate a parametric impl head also records that impl's trait
// methods at the bound arguments. Pattern bindings follow self-type
// traversal order, the same order extract_impl_type_params uses for impl
// type parameters; ADR-078's coverage rule (trait-ref vars ⊆ self vars)
// makes those bindings complete. Sibling minting is the speculative axis:
// it stays behind the caller's instance budget and the receiver-depth
// bound, because re-propagating at the same receiver is what enumerates
// the adapter x method space. Argument-impl propagation is demand-side
// instead (see propagate_arg_impls_for).
fn propagate_parametric_impl_mono(env: TypeEnv, fn_name: String, resolved_types: Vec<TypeInfo>) {
    if !mono_args_within_depth(clone(resolved_types)) {
        return
    }
    propagate_owner_impl_mono(env, fn_name, resolved_types)
}

// Demand-side propagation: every recorded instance's body can call trait
// methods on its argument types — a next() call on a bare-var receiver
// such as TakeIter<MapIter<..>> needs the impl's next bound at the inner
// args, which only impl-method propagation mints (bare-var receivers
// record no template site). This must run for every record regardless of
// the speculative budget/depth gates: the bound method args are the
// receiver's own inner type, so receiver depth strictly decreases along
// the chain and it provably terminates.
fn propagate_arg_impls_for(env: TypeEnv, fn_name: String, resolved_types: Vec<TypeInfo>, demanded: bool) {
    let count = len(resolved_types)
    let mut i = 0
    while i < count {
        propagate_arg_impl_mono(env, clone(fn_name), get_unchecked(resolved_types, i), demanded)
        i = i + 1
    }
}

// Sibling axis of demand-driven propagation. Recording
// `Ctor::method`+[args] also needs the OTHER methods of Ctor's
// var-carrying impls at the same args: `Take::collect`+[VecIter]
// contains `for item in self`, which calls `Take::into_iter` and
// `Take::next` at [VecIter] from inside the impl body. The
// typechecker saw that body at the bare type variable, so the
// concrete sibling instances only exist if they are recorded here.
fn propagate_owner_impl_mono(env: TypeEnv, fn_name: String, resolved_types: Vec<TypeInfo>) {
    if len(resolved_types) == 0 {
        return
    }
    let sep = associated_types::projection_sep_index(clone(fn_name))
    if sep < 0 {
        return
    }
    let owner = substring(clone(fn_name), 0, sep)
    let receiver = contract_types_record::TypeInfo_new(
        commands::TY_STRUCT(),
        clone(owner),
        resolved_types
    )
    let impl_count = len(env.trait_impls)
    let mut i = 0
    while i < impl_count {
        let impl_info = get_unchecked(env.trait_impls, i)
        let self_ty = contract_trait_impl::TraitImplInfo_self_ty(impl_info)
        if names::same_type_name(
            contract_type_access::TypeInfo_name(self_ty),
            clone(owner)
        ) && associated_types::type_contains_var(clone(self_ty)) {
            propagate_impl_methods_mono(env, impl_info, clone(receiver), false)
        }
        i = i + 1
    }
}

fn propagate_arg_impl_mono(env: TypeEnv, fn_name: String, arg: TypeInfo, demanded: bool) {
    let tag = contract_type_access::TypeInfo_tag(arg)
    if tag != commands::TY_STRUCT() && tag != commands::TY_ENUM() {
        return
    }
    if contract_type_access::TypeInfo_type_arg_count(arg) == 0 {
        return
    }
    if associated_types::type_contains_var(clone(arg)) {
        return
    }
    let impl_count = len(env.trait_impls)
    let mut i = 0
    while i < impl_count {
        let impl_info = get_unchecked(env.trait_impls, i)
        let self_ty = contract_trait_impl::TraitImplInfo_self_ty(impl_info)
        if names::same_type_name(
            contract_type_access::TypeInfo_name(self_ty),
            contract_type_access::TypeInfo_name(arg)
        ) && associated_types::type_contains_var(clone(self_ty)) {
            propagate_impl_methods_mono(env, impl_info, clone(arg), demanded)
        }
        i = i + 1
    }
}

fn propagate_impl_methods_mono(env: TypeEnv, impl_info: TraitImplInfo, receiver: TypeInfo, demanded: bool) {
    let var_names = Vec::new<String>()
    let var_types = Vec::new<TypeInfo>()
    if !associated_types::match_pattern_collect_vars(
        contract_trait_impl::TraitImplInfo_self_ty(impl_info),
        clone(receiver),
        var_names,
        var_types
    ) {
        return
    }
    let trait_name = contract_trait_impl::TraitImplInfo_trait_name(impl_info)
    let bound = propagated_trait_bound(impl_info, var_names, var_types, clone(trait_name))
    let owner_name = names::unqualified_type_name(contract_type_access::TypeInfo_name(receiver))
    let entry_count = len(env.trait_methods)
    let mut i = 0
    while i < entry_count {
        let entry = get_unchecked(env.trait_methods, i)
        if names::same_type_name(
            contract_trait_method_record::trait_method_entry_trait_name(entry),
            clone(trait_name)
        ) {
            let sig = contract_trait_method_record::trait_method_entry_sig(entry)
            let trait_param_count = trait_method_record::trait_method_entry_trait_type_param_count(entry)
            // A method with its own type parameters cannot be resolved
            // from the receiver alone; its call sites record directly.
            if contract_fn_sig::FnSig_type_param_count(sig) <= trait_param_count {
                let method_fn = text::concat(
                    clone(owner_name),
                    text::concat("::", contract_trait_method_record::trait_method_entry_method_name(entry))
                )
                // Only impl-defined methods have a body to monomorphize;
                // trait defaults live under the trait's own owner name and
                // would record a phantom instance here.
                if name_index::name_index_get(env.fn_sig_index, clone(method_fn)) < 0 {
                    i = i + 1
                    continue
                }
                // One level only: sibling records must not re-enter
                // propagate_parametric_impl_mono (see
                // record_propagated_mono_instance). Demanded parents mint
                // demanded callees; speculative parents stay off the emit
                // path.
                let mut mangled = clone(method_fn)
                if demanded {
                    mangled = record_mono_instance(env, clone(method_fn), clone(var_types))
                } else {
                    mangled = record_propagated_mono_instance(env, clone(method_fn), clone(var_types))
                }
                // resolve_trait_method_signature walks the impl table per
                // associated-type lookup; run it only when this mangled
                // name still lacks a recorded return type. Repeated mints
                // of the same sibling would otherwise redo the full
                // signature resolution and throw the result away.
                let recorded_ret = mono_instance_return_type_by_mangled(env, clone(mangled))
                if contract_type_access::TypeInfo_tag(recorded_ret) != 0 {
                    i = i + 1
                    continue
                }
                let resolved_sig = associated_types::resolve_trait_method_signature(
                    env,
                    entry,
                    clone(bound),
                    clone(receiver)
                )
                record_mono_return_type(
                    env,
                    mangled,
                    associated_types::normalize_projection_ty(
                        env,
                        clone(var_names),
                        clone(var_types),
                        // resolve_trait_method_signature substitutes Self and
                        // trait-level params only; impl-head vars (I in
                        // TakeIter<I>) survive in the signature. Bind them to
                        // the receiver's concrete args first so the recorded
                        // return is TakeIter<VecIter>, not TakeIter<I>.
                        instantiate::instantiate_type(
                            contract_fn_sig::FnSig_return_type(resolved_sig),
                            clone(var_names),
                            clone(var_types)
                        )
                    )
                )
            }
        }
        i = i + 1
    }
}

// The trait reference with the impl's type variables replaced by the
// receiver's concrete arguments, used to resolve trait-method signatures.
fn propagated_trait_bound(
    impl_info: TraitImplInfo,
    var_names: Vec<String>,
    var_types: Vec<TypeInfo>,
    trait_name: String
) -> TypeInfo {
    let base = types::resolve_type_name(clone(trait_name))
    let arg_patterns = contract_trait_impl_record::trait_impl_info_trait_args(impl_info)
    let arg_count = len(arg_patterns)
    if arg_count == 0 {
        return base
    }
    let concrete_args = Vec::new<TypeInfo>()
    let mut i = 0
    while i < arg_count {
        push(
            concrete_args,
            instantiate::instantiate_type(
                get_unchecked(arg_patterns, i),
                clone(var_names),
                clone(var_types)
            )
        )
        i = i + 1
    }
    contract_types_record::TypeInfo_new(
        contract_type_access::TypeInfo_tag(base),
        contract_type_access::TypeInfo_name(base),
        concrete_args
    )
}

fn has_mono_instance_for(mono_instances: Vec<MonoInstance>, fn_name: String) -> bool {
    let count = len(mono_instances)
    let mut i = 0
    while i < count {
        let mi = get_unchecked(mono_instances, i)
        if eq(contract_mono::MonoInstance_fn_name(mi), clone(fn_name)) {
            return true
        }
        i = i + 1
    }
    false
}
