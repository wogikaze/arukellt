use collections::vec_extend
use parser::ast
use typechecker::kinds
use typechecker::ast_access
use typechecker::contract_fn_sig
use typechecker::contract_type_constructors
use typechecker::contract_type_param_bounds
use typechecker::sig_bounds
use typechecker::types
fn simple_type(tag: i32) -> TypeInfo {
    contract_type_constructors::TypeInfo_simple(tag)
}

fn fn_sig_from_fn_decl(node: AstNode) -> FnSig {
    let type_param_bounds = sig_bounds::collect_type_param_bounds(ast_access::node_type_ann(node))
    let type_params = sig_bounds::collect_type_param_names(type_param_bounds)
    fn_sig_from_fn_decl_with_params(node, type_params, type_param_bounds)
}

fn fn_sig_from_fn_decl_with_type_params(
    node: AstNode,
    outer_type_params: Vec<String>
) -> FnSig {
    let type_param_bounds = sig_bounds::collect_type_param_bounds(ast_access::node_type_ann(node))
    let method_type_params = sig_bounds::collect_type_param_names(type_param_bounds)
    let type_params = merge_type_params(outer_type_params, method_type_params)
    fn_sig_from_fn_decl_with_params(node, type_params, type_param_bounds)
}

fn fn_sig_from_fn_decl_with_params(
    node: AstNode,
    type_params: Vec<String>,
    type_param_bounds: Vec<TypeParamBounds>
) -> FnSig {
    let ann_count = ast_access::node_type_ann_count(node)
    let mut j = 0
    let mut param_types = Vec::new<TypeInfo>()
    let mut param_modes = Vec::new<bool>()
    let child_count = ast_access::node_child_count(node)
    // The last child is the body only for fns that actually have one:
    // `= expr` bodies set the int_val marker and block bodies are
    // NK_BLOCK. Bodiless decls (trait methods, externs) keep every
    // child as a parameter -- the historical `child_count - 1` dropped
    // their last parameter, leaving `fn next(self: Self)` inside a
    // trait with param_count 0 (#912).
    let mut param_end = child_count
    if child_count > 0 {
        let last_child = ast_access::node_child_at(node, child_count - 1)
        if ast::ast_node_int_val(node) == 1 ||
        ast_access::node_kind_is(last_child, kinds::NK_BLOCK()) {
            param_end = child_count - 1
        }
    }
    if param_end > 0 {
        let mut p = 0
        while p < param_end {
            let param = ast_access::node_child_at(node, p)
            let mut pty = simple_type(commands::TY_UNKNOWN())
            if ast_access::node_type_ann_count(param) > 0 {
                let type_node = ast_access::node_type_ann_at(param, 0)
                pty = types::resolve_type_ann_node_generic(type_node, type_params)
            }
            param_types.push(pty)
            param_modes.push(ast_access::node_is_mut(param))
            p = p + 1
        }
    }
    let mut return_type = simple_type(commands::TY_UNIT())
    j = 0
    while j < ann_count {
        let ann = ast_access::node_type_ann_at(node, j)
        if ast_access::node_text(ann).eq("__return") {
            if ast_access::node_child_count(ann) > 0 {
                let ret_node = ast_access::node_child_at(ann, 0)
                return_type = types::resolve_type_ann_node_generic(ret_node, type_params)
            }
        }
        j = j + 1
    }
    contract_fn_sig::FnSig_new_with_param_modes(
        ast_access::node_text(node),
        param_types,
        param_modes,
        return_type,
        type_params,
        type_param_bounds
    )
}

fn fn_sig_from_const_decl(node: AstNode) -> FnSig {
    let param_types = Vec::new<TypeInfo>()
    let mut return_type = simple_type(commands::TY_UNKNOWN())
    let ann_count = ast_access::node_type_ann_count(node)
    let mut j = 0
    while j < ann_count {
        let ann = ast_access::node_type_ann_at(node, j)
        if ast_access::node_text(ann).eq("__return") {
            if ast_access::node_child_count(ann) > 0 {
                let ret_node = ast_access::node_child_at(ann, 0)
                return_type = types::resolve_type_ann_node_generic(ret_node, Vec::new<String>())
            }
        }
        j = j + 1
    }
    let type_params = Vec::new<String>()
    let type_param_bounds = Vec::new<TypeParamBounds>()
    contract_fn_sig::FnSig_new(ast_access::node_text(node), param_types, return_type, type_params, type_param_bounds)
}

// Like fn_sig_from_fn_decl but merges impl-level type parameters with the
// method's own type parameters. This is needed for `impl Vec<T> { fn push(self, x: T) }`
// where T comes from the impl block, not the method declaration. Impl-level
// bounds are carried into the method signature so body checking can resolve
// `self.field.method()` through the declared bound and call sites can enforce
// the same obligation at instantiation.
fn fn_sig_from_fn_decl_with_impl_type_params(
    node: AstNode,
    impl_type_params: Vec<String>,
    impl_type_param_bounds: Vec<TypeParamBounds>
) -> FnSig {
    let method_bounds = sig_bounds::collect_type_param_bounds(ast_access::node_type_ann(node))
    let method_type_params = sig_bounds::collect_type_param_names(method_bounds)
    let type_params = merge_type_params(impl_type_params.clone(), method_type_params)
    let type_param_bounds = merge_type_param_bounds(
        impl_type_params,
        impl_type_param_bounds,
        method_bounds
    )
    fn_sig_from_fn_decl_with_params(node, type_params, type_param_bounds)
}

// Keep bounds aligned with merge_type_params: impl bounds first, then method
// bounds for names the impl did not already declare.
fn merge_type_param_bounds(
    impl_params: Vec<String>,
    impl_bounds: Vec<TypeParamBounds>,
    method_bounds: Vec<TypeParamBounds>
) -> Vec<TypeParamBounds> {
    let mut merged = Vec::new<TypeParamBounds>()
    let impl_count = impl_bounds.len()
    let mut i = 0
    while i < impl_count {
        merged.push(impl_bounds.get_unchecked(i))
        i = i + 1
    }
    let method_count = method_bounds.len()
    let mut j = 0
    while j < method_count {
        let info = method_bounds.get_unchecked(j)
        if !string_vec_contains(
            impl_params.clone(),
            contract_type_param_bounds::TypeParamBounds_name(info)
        ) {
            merged.push(info)
        }
        j = j + 1
    }
    merged
}

fn string_vec_contains(names: Vec<String>, name: String) -> bool {
    let count = names.len()
    let mut i = 0
    while i < count {
        if names.get_unchecked(i).eq(name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

// Merge impl-level type params with method-level type params, avoiding duplicates.
fn merge_type_params(impl_params: Vec<String>, method_params: Vec<String>) -> Vec<String> {
    let mut merged = Vec::new<String>()
    vec_extend::Vec_extend_String_clone(merged, impl_params)
    let impl_count = impl_params.len()
    let method_count = method_params.len()
    let mut k = 0
    while k < method_count {
        let mp = method_params.get_unchecked(k).clone()
        let mut found = false
        let mut j = 0
        while j < impl_count {
            if impl_params.get_unchecked(j).clone().eq(mp.clone()) {
                found = true
            }
            j = j + 1
        }
        if !found {
            merged.push(mp)
        }
        k = k + 1
    }
    merged
}
