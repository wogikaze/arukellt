use typechecker::ast_access
use typechecker::match_coverage_mark_record
use typechecker::match_coverage_record
fn ident_looks_like_unit_variant(pat: AstNode) -> bool {
    let pat_name = ast_access::node_text(pat)
    pat_name.clone().eq(String_from("Some")) ||
    pat_name.clone().eq(String_from("None")) ||
    pat_name.clone().eq(String_from("Ok")) ||
    pat_name.clone().eq(String_from("Err")) ||
    pat_name.clone().ends_with(String_from("::Some")) ||
    pat_name.clone().ends_with(String_from("::None")) ||
    pat_name.clone().ends_with(String_from("::Ok")) ||
    pat_name.clone().ends_with(String_from("::Err"))
}

fn record_variant_pattern(mut coverage: MatchCoverage, pat: AstNode) {
    let pat_name = ast_access::node_text(pat)
    if pat_name.clone().eq(String_from("Some")) || pat_name.clone().ends_with(String_from("::Some")) {
        match_coverage_mark_record::match_coverage_mark_option_some(coverage)
    }
    if pat_name.clone().eq(String_from("None")) || pat_name.clone().ends_with(String_from("::None")) {
        match_coverage_mark_record::match_coverage_mark_option_none(coverage)
    }
    if pat_name.clone().eq(String_from("Ok")) || pat_name.clone().ends_with(String_from("::Ok")) {
        match_coverage_mark_record::match_coverage_mark_result_ok(coverage)
    }
    if pat_name.clone().eq(String_from("Err")) || pat_name.clone().ends_with(String_from("::Err")) {
        match_coverage_mark_record::match_coverage_mark_result_err(coverage)
    }
    match_coverage_mark_record::match_coverage_push_variant(coverage, variant_base_name(pat_name))
}

fn variant_base_name(name: String) -> String {
    // EnumInfo stores bare variant leaves (`Bool`). Module-qualified arms
    // like `types::WitType::Bool` must reduce to that leaf, not `WitType::Bool`
    // from the first `::` (#809).
    let n = name.len()
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    name
}
