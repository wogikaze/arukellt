// WIT function signature collection for typecheck (#653, #664, #671, #672).

use std::text
use collections::vec_extend
use typechecker::ast_decl_predicates
use typechecker::ast_access
use typechecker::contract_fn_sig
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::contract_enum_info
use typechecker::type_names
use component::wit_parse_text
use resolver::wit_register
use resolver::wit_surface

fn collect_wit_fn_sigs(wit_paths: Vec<String>, decls: Vec<AstNode>) -> Vec<FnSig> {
    let mut sigs = Vec::new<FnSig>()
    let count = decls.len()
    let mut i = 0
    while i < count {
        let d = decls.get_unchecked(i)
        if ast_decl_predicates::node_is_wit_import(d) {
            wit_push_fn_sigs_for_import(sigs, wit_paths, ast_access::node_text(d), wit_import_alias(d))
        }
        i = i + 1
    }
    sigs
}

fn collect_wit_enum_defs(wit_paths: Vec<String>, decls: Vec<AstNode>) -> Vec<EnumInfo> {
    let mut enum_defs = Vec::new<EnumInfo>()
    let count = decls.len()
    let mut i = 0
    while i < count {
        let d = decls.get_unchecked(i)
        if ast_decl_predicates::node_is_wit_import(d) {
            wit_push_enum_defs_for_import(enum_defs, wit_paths, ast_access::node_text(d), wit_import_alias(d))
        }
        i = i + 1
    }
    enum_defs
}

fn wit_import_alias(decl: AstNode) -> String {
    if ast_access::node_type_ann_count(decl) == 0 { return String_new() }
    ast_access::node_text(ast_access::node_type_ann_at(decl, 0))
}

fn wit_push_fn_sigs_for_import(mut sigs: Vec<FnSig>, wit_paths: Vec<String>, package_id: String, alias: String) {
    if alias.len() == 0 { return }
    let doc = wit_register::wit_doc_from_import(wit_paths, package_id.clone())
    if wit_register::wit_doc_has_surface(doc) {
        wit_push_fn_sigs_for_doc(sigs, alias.clone(), doc)
        return
    }
    if package_id.clone().eq("test:host/host") {
        sigs.push(wit_fn_sig_flags_param(alias.clone(), "set_perms"))
        return
    }
    if package_id.clone().eq("test:host/handles") {
        sigs.push(wit_fn_sig_i32_param(alias.clone(), "take"))
        sigs.push(wit_fn_sig_i32_param(alias.clone(), "peek"))
    }
}

fn wit_push_enum_defs_for_import(mut enum_defs: Vec<EnumInfo>, wit_paths: Vec<String>, package_id: String, alias: String) {
    if alias.len() == 0 { return }
    let doc = wit_register::wit_doc_from_import(wit_paths, package_id.clone())
    if !wit_register::wit_doc_has_surface(doc) { return }
    let enums = wit_parse_text::WitParsedInterface_enums(doc)
    for ei in 0..enums.len() {
        enum_defs.push(wit_enum_info_from_parsed(alias.clone(), enums.get_unchecked(ei)))
    }
}

fn wit_push_fn_sigs_for_doc(mut sigs: Vec<FnSig>, alias: String, doc: component::wit_parse_text::WitParsedInterface) {
    let funcs = wit_parse_text::WitParsedInterface_funcs(doc)
    for fi in 0..funcs.len() {
        sigs.push(wit_fn_sig_from_parsed(alias.clone(), doc, funcs.get_unchecked(fi)))
    }
}

fn wit_binding_generic_args(name: String) -> Vec<String> {
    let mut args = Vec::new<String>()
    let open = name.index_of("<")
    if open < 0 { return args }
    let mut close = name.len() - 1
    while close > open && name.byte_at(close) != 62 { close = close - 1 }
    if close <= open { return args }
    let inner = name.slice(open + 1, close)
    let mut depth = 0
    let mut start = 0
    let mut i = 0
    while i < inner.len() {
        let ch = inner.byte_at(i)
        if ch == 60 { depth = depth + 1 }
        if ch == 62 { depth = depth - 1 }
        if ch == 44 && depth == 0 {
            args.push(inner.slice(start, i))
            start = i + 1
        }
        i = i + 1
    }
    if start < inner.len() { args.push(inner.slice(start, inner.len())) }
    args
}

fn wit_binding_type_info(name: String) -> TypeInfo {
    if name.clone().eq("()") || name.len() == 0 {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNIT())
    }
    let open = name.index_of("<")
    if open > 0 {
        let base = name.slice(0, open)
        let mut ty = if base.clone().eq("Tuple") {
            contract_type_constructors::TypeInfo_named(commands::TY_TUPLE(), String_new())
        } else {
            type_names::resolve_type_name(base)
        }
        let args = wit_binding_generic_args(name)
        for i in 0..args.len() {
            contract_type_mutation::TypeInfo_push_type_arg(ty, wit_binding_type_info(args.get_unchecked(i)))
        }
        return ty
    }
    type_names::resolve_type_name(name)
}

fn wit_fn_sig_from_parsed(alias: String, doc: component::wit_parse_text::WitParsedInterface, func: component::wit_parse_text::WitParsedFunc) -> FnSig {
    let qualified = alias.clone().concat("::".concat(func.ark_name.clone()))
    let mut params = Vec::new<TypeInfo>()
    let param_types = wit_surface::wit_func_param_ark_types(func, alias.clone(), doc)
    for pi in 0..param_types.len() {
        params.push(wit_binding_type_info(param_types.get_unchecked(pi)))
    }
    let ret_name = wit_surface::wit_func_ret_ark_type(func, alias.clone(), doc)
    let ret_ty = wit_binding_type_info(ret_name)
    contract_fn_sig::FnSig_new(qualified, params, ret_ty, Vec::new<String>(), Vec::new<TypeParamBounds>())
}

fn wit_enum_info_from_parsed(alias: String, en: component::wit_parse_text::WitParsedEnum) -> EnumInfo {
    let qualified = alias.clone().concat("::".concat(en.ark_name.clone()))
    contract_enum_info::EnumInfo_new(qualified, en.variant_ark_names)
}

fn wit_fn_sig_flags_param(alias: String, func_name: String) -> FnSig {
    let qualified = alias.clone().concat("::".concat(func_name.clone()))
    let mut params = Vec::new<TypeInfo>()
    params.push(contract_type_constructors::TypeInfo_simple(commands::TY_I32()))
    contract_fn_sig::FnSig_new(qualified, params, contract_type_constructors::TypeInfo_simple(commands::TY_UNIT()), Vec::new<String>(), Vec::new<TypeParamBounds>())
}

fn wit_fn_sig_i32_param(alias: String, func_name: String) -> FnSig {
    let qualified = alias.clone().concat("::".concat(func_name.clone()))
    let mut params = Vec::new<TypeInfo>()
    params.push(contract_type_constructors::TypeInfo_simple(commands::TY_I32()))
    contract_fn_sig::FnSig_new(qualified, params, contract_type_constructors::TypeInfo_simple(commands::TY_UNIT()), Vec::new<String>(), Vec::new<TypeParamBounds>())
}

fn merge_fn_sigs(mut base: Vec<FnSig>, wit: Vec<FnSig>) -> Vec<FnSig> {
    vec_extend::Vec_extend_FnSig(base, wit)
    base
}

fn merge_enum_defs(mut base: Vec<EnumInfo>, wit: Vec<EnumInfo>) -> Vec<EnumInfo> {
    vec_extend::Vec_extend_EnumInfo(base, wit)
    base
}
