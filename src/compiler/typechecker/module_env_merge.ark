use collections::vec_extend
use typechecker::contract_mono
use typechecker::contract_env_mono_record
use typechecker::contract_env_record
use typechecker::contract_type_access
use typechecker::mono_instances
fn merge_mono_instances(mut dst: TypeEnv, src: TypeEnv) {
    let src_instances = contract_env_mono_record::type_env_mono_instances(src)
    let count = src_instances.len()
    let mut i = 0
    while i < count {
        let incoming = src_instances.get_unchecked(i)
        if is_mono_call_site_marker(incoming) {
            push(dst.mono_instances, incoming)
            i = i + 1
            continue
        }
        let incoming_mangled = contract_mono::MonoInstance_mangled_name(incoming)
        let dst_instances = contract_env_mono_record::type_env_mono_instances(dst)
        let dst_count = dst_instances.len()
        let mut found = false
        let mut j = 0
        while j < dst_count {
            let existing = dst_instances.get_unchecked(j)
            if contract_mono::MonoInstance_mangled_name(existing).eq(incoming_mangled.clone()) {
                found = true
            }
            j = j + 1
        }
        if !found {
            push(dst.mono_instances, incoming)
            // Rebind only for demanded instances (#912): a body that is
            // never emitted must not pull its callees into the demanded
            // set, and non-demanded marker records carry sentinel type
            // args that must never reach a rebind at all. A marker that
            // later becomes a real call target binds its sites through
            // record_mono_instance's demand-upgrade path instead.
            if contract_mono::MonoInstance_demanded(incoming) {
                mono_instances::rebind_enclosing_template_sites(
                    dst,
                    contract_mono::MonoInstance_fn_name(incoming),
                    incoming.type_args.clone()
                )
            }
        }
        i = i + 1
    }
}

fn merge_mono_template_sites(mut dst: TypeEnv, src: TypeEnv) {
    let src_count = src.mono_template_sites.len()
    let mut i = 0
    while i < src_count {
        let incoming = src.mono_template_sites.get_unchecked(i)
        let incoming_mangled = incoming.mangled_name.clone()
        let incoming_enclosing = incoming.enclosing_fn.clone()
        let dst_count = dst.mono_template_sites.len()
        let mut found = false
        let mut j = 0
        while j < dst_count {
            let existing = dst.mono_template_sites.get_unchecked(j)
            if existing.mangled_name.clone().eq(incoming_mangled.clone()) &&
            existing.enclosing_fn.clone().eq(incoming_enclosing.clone()) {
                found = true
            }
            j = j + 1
        }
        if !found {
            push(dst.mono_template_sites, incoming)
        }
        i = i + 1
    }
}

fn is_mono_call_site_marker(instance: MonoInstance) -> bool {
    if contract_mono::MonoInstance_type_arg_count(instance) < 1 {
        return false
    }
    contract_type_access::TypeInfo_tag(contract_mono::MonoInstance_type_arg_at(instance, 0)) < 0
}

fn merge_type_env(mut dst: TypeEnv, src: TypeEnv) {
    let err_count = src.error_count
    let mut e = 0
    while e < err_count {
        push(dst.errors, src.errors.get_unchecked(e).clone())
        dst.error_count = dst.error_count + 1
        e = e + 1
    }
    vec_extend::Vec_extend_Diagnostic(dst.diagnostics, src.diagnostics)
    vec_extend::Vec_extend_Diagnostic(dst.warnings, src.warnings)
    merge_mono_template_sites(dst, src)
    merge_mono_instances(dst, src)
    vec_extend::Vec_extend_MonoCallSite(dst.mono_call_sites, src.mono_call_sites)
    let owner_count = src.resolved_call_owners.len()
    let mut oi = 0
    while oi < owner_count {
        push(dst.resolved_call_owners, src.resolved_call_owners.get_unchecked(oi))
        oi = oi + 1
    }
}

fn type_env_for_fn_check(parent: TypeEnv) -> TypeEnv {
    let mut child = contract_env_record::TypeEnv_new()
    child.trait_defs = parent.trait_defs
    child.trait_impls = parent.trait_impls
    child.associated_types = parent.associated_types
    child.trait_methods = parent.trait_methods
    child.struct_defs = parent.struct_defs
    child.fn_sig_index = parent.fn_sig_index
    child.const_names = parent.const_names
    child.const_types = parent.const_types
    child.current_fn_name = parent.current_fn_name
    child.current_fn_type_params = parent.current_fn_type_params
    child.current_fn_bounds = parent.current_fn_bounds
    child.allow_shared_param_mutation = parent.allow_shared_param_mutation
    child.declared_type_names = parent.declared_type_names
    child.strict_impl_binders = parent.strict_impl_binders
    // Fresh vars minted during fn-check must not collide with parent vars
    // when inferred types containing them unify back in the parent (#915).
    child.var_id_box = parent.var_id_box
    child
}
