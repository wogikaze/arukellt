use collections::vec_extend
use typechecker::contract_mono
use typechecker::contract_env_mono_record
use typechecker::contract_env_record
use typechecker::contract_type_access
use typechecker::mono_instances

fn merge_mono_instances(dst: TypeEnv, src: TypeEnv) {
    let src_instances = contract_env_mono_record::type_env_mono_instances(src)
    let count = len(src_instances)
    let mut i = 0
    while i < count {
        let incoming = get_unchecked(src_instances, i)
        if is_mono_call_site_marker(incoming) {
            push(dst.mono_instances, incoming)
            i = i + 1
            continue
        }
        let incoming_mangled = contract_mono::MonoInstance_mangled_name(incoming)
        let dst_instances = contract_env_mono_record::type_env_mono_instances(dst)
        let dst_count = len(dst_instances)
        let mut found = false
        let mut j = 0
        while j < dst_count {
            let existing = get_unchecked(dst_instances, j)
            if eq(contract_mono::MonoInstance_mangled_name(existing), clone(incoming_mangled)) {
                found = true
            }
            j = j + 1
        }
        if !found {
            push(dst.mono_instances, incoming)
            mono_instances::rebind_enclosing_template_sites(
                dst,
                contract_mono::MonoInstance_fn_name(incoming),
                clone(incoming.type_args)
            )
        }
        i = i + 1
    }
}

fn merge_mono_template_sites(dst: TypeEnv, src: TypeEnv) {
    let src_count = len(src.mono_template_sites)
    let mut i = 0
    while i < src_count {
        let incoming = get_unchecked(src.mono_template_sites, i)
        let incoming_mangled = clone(incoming.mangled_name)
        let incoming_enclosing = clone(incoming.enclosing_fn)
        let dst_count = len(dst.mono_template_sites)
        let mut found = false
        let mut j = 0
        while j < dst_count {
            let existing = get_unchecked(dst.mono_template_sites, j)
            if eq(clone(existing.mangled_name), clone(incoming_mangled)) &&
            eq(clone(existing.enclosing_fn), clone(incoming_enclosing)) {
                found = true
            }
            j = j + 1
        }
        if !found {
            push(dst.mono_template_sites, incoming)
        }
        i = i + 1
    }
}

fn is_mono_call_site_marker(instance: MonoInstance) -> bool {
    if contract_mono::MonoInstance_type_arg_count(instance) < 1 {
        return false
    }
    contract_type_access::TypeInfo_tag(contract_mono::MonoInstance_type_arg_at(instance, 0)) < 0
}

fn merge_type_env(dst: TypeEnv, src: TypeEnv) {
    let err_count = src.error_count
    let mut e = 0
    while e < err_count {
        push(dst.errors, clone(get_unchecked(src.errors, e)))
        dst.error_count = dst.error_count + 1
        e = e + 1
    }
    vec_extend::Vec_extend_Diagnostic(dst.diagnostics, src.diagnostics)
    vec_extend::Vec_extend_Diagnostic(dst.warnings, src.warnings)
    merge_mono_template_sites(dst, src)
    merge_mono_instances(dst, src)
    vec_extend::Vec_extend_MonoCallSite(dst.mono_call_sites, src.mono_call_sites)
}

fn type_env_for_fn_check(parent: TypeEnv) -> TypeEnv {
    let child = contract_env_record::TypeEnv_new()
    child.trait_defs = parent.trait_defs
    child.trait_impls = parent.trait_impls
    child.associated_types = parent.associated_types
    child.trait_methods = parent.trait_methods
    child.struct_defs = parent.struct_defs
    child.fn_sig_index = parent.fn_sig_index
    child.current_fn_name = parent.current_fn_name
    child.current_fn_type_params = parent.current_fn_type_params
    child.current_fn_bounds = parent.current_fn_bounds
    child
}
