use corehir::callee_spelling
use resolver::expr_path
use resolver::paths
use typechecker::contract_fn_sig
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::names
use typechecker::sig_bounds
use typechecker::sig_decl
use typechecker::sig_lookup

fn lookup_fn_sig(env: TypeEnv, fn_sigs: Vec<FnSig>, name: String) -> FnSig {
    sig_lookup::lookup_fn_sig(env, fn_sigs, name)
}

// Module owning the body currently being checked, or "" for the entry module
// (and for a body outside the loaded ranges).
fn type_env_current_module_name(env: TypeEnv) -> String {
    let decl_index = env.current_decl_index
    if decl_index < 0 {
        return String_new()
    }
    let count = env.module_decl_starts.len()
    let mut i = 0
    while i < count {
        let start = env.module_decl_starts.get_unchecked(i)
        let end = if i + 1 < count {
            env.module_decl_starts.get_unchecked(i + 1)
        } else {
            env.entry_decl_start
        }
        if decl_index >= start && (end < 0 || decl_index < end) {
            return env.module_names.get_unchecked(i).clone()
        }
        i = i + 1
    }
    String_new()
}

// Resolve an impl method by the receiver's owner spelling. A loaded module
// registers its methods under `module::Owner::method`, and a receiver whose
// nominal name kept the module prefix (`beta::Counter`) can name that module
// directly. Both paths are tried before the flat `Owner::method` alias, which
// only the first declaration claiming the spelling can own. The fallback is
// what keeps imported-type calls and builtin owners (Vec / String) working.
fn lookup_impl_method_sig(
    env: TypeEnv,
    fn_sigs: Vec<FnSig>,
    qualified_owner: String,
    owner: String,
    method: String
) -> FnSig {
    if qualified_owner.len() > 0 {
        let qualified = qualified_owner.clone().concat(String_from("::").concat(method.clone()))
        let sig = lookup_fn_sig(env, fn_sigs, qualified)
        if contract_fn_sig::FnSig_has_name(sig) {
            return sig
        }
    }
    let module_name = type_env_current_module_name(env)
    if module_name.len() > 0 && owner.len() > 0 {
        let scoped = module_name.clone().concat(String_from("::").concat(owner.clone().concat(String_from("::").concat(method.clone()))))
        let sig = lookup_fn_sig(env, fn_sigs, scoped)
        if contract_fn_sig::FnSig_has_name(sig) {
            return sig
        }
    }
    lookup_fn_sig(env, fn_sigs, owner.concat(String_from("::").concat(method)))
}

fn fn_sig_from_fn_decl(node: AstNode) -> FnSig {
    sig_decl::fn_sig_from_fn_decl(node)
}

fn fn_sig_from_fn_decl_with_type_params(
    node: AstNode,
    outer_type_params: Vec<String>
) -> FnSig {
    sig_decl::fn_sig_from_fn_decl_with_type_params(node, outer_type_params)
}

fn fn_sig_from_const_decl(node: AstNode) -> FnSig {
    sig_decl::fn_sig_from_const_decl(node)
}

fn fn_sig_from_fn_decl_with_impl_type_params(
    node: AstNode,
    impl_type_params: Vec<String>,
    impl_type_param_bounds: Vec<TypeParamBounds>
) -> FnSig {
    sig_decl::fn_sig_from_fn_decl_with_impl_type_params(
        node,
        impl_type_params,
        impl_type_param_bounds
    )
}

fn collect_type_param_bounds(type_ann: Vec<AstNode>) -> Vec<TypeParamBounds> {
    sig_bounds::collect_type_param_bounds(type_ann)
}

fn collect_type_param_names(bound_infos: Vec<TypeParamBounds>) -> Vec<String> {
    sig_bounds::collect_type_param_names(bound_infos)
}

// A value expression can name a top-level function through its module path
// (`prelude::push`) or through the canonical impl spelling (`Point::bump`).
// The flat signature index registers the bare name and the module/owner
// qualified spelling, so try the canonical variants before the bare leaf.
// Type-owned heads (`Vec::new`) are excluded from the leaf fallback so an
// unrelated bare `new` cannot supply a function type.
fn resolve_fn_sig(env: TypeEnv, fn_sigs: Vec<FnSig>, name: String) -> FnSig {
    let mut sig = sig_lookup::lookup_declared_fn_sig(env, fn_sigs, name.clone())
    if contract_fn_sig::FnSig_has_name(sig) {
        return sig
    }
    let variants = callee_spelling::callee_spelling_variants(name.clone())
    let mut i = 0
    while i < variants.len() {
        let variant_sig = sig_lookup::lookup_declared_fn_sig(env, fn_sigs, variants.get_unchecked(i).clone())
        if contract_fn_sig::FnSig_has_name(variant_sig) {
            return variant_sig
        }
        i = i + 1
    }
    // The leaf fallback drops a module prefix. In a resolver-processed entry
    // body only a bare declaration identity (own decl / prelude) may answer;
    // a loaded-module body keeps the flat lookup until its calls carry resolver
    // identities (#934).
    let leaf = names::unqualified_type_name(name.clone())
    if !leaf.clone().eq(name.clone()) && !is_type_owned_name(name.clone()) {
        let leaf_sig = if sig_lookup::is_entry_body(env) {
            sig_lookup::lookup_bare_identity(env, fn_sigs, leaf)
        } else {
            sig_lookup::lookup_fn_sig(env, fn_sigs, leaf)
        }
        if contract_fn_sig::FnSig_has_name(leaf_sig) {
            return leaf_sig
        }
    }
    sig
}

fn is_type_owned_name(name: String) -> bool {
    let owner = paths::path_module_part(name.clone())
    if owner.len() == 0 {
        return false
    }
    let first = owner.byte_at(0)
    first == 63 || (first >= 65 && first <= 90)
}

// Build the TY_FN value type for a named function: parameter types followed
// by the return type, with the parameter modes aligned to the parameter
// prefix (ADR-088 §7).
fn fn_value_type_from_sig(env: TypeEnv, fn_sigs: Vec<FnSig>, name: String) -> TypeInfo {
    let sig = resolve_fn_sig(env, fn_sigs, name)
    if !contract_fn_sig::FnSig_has_name(sig) {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let mut fn_ty = contract_type_constructors::TypeInfo_simple(commands::TY_FN())
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    let mut i = 0
    while i < param_count {
        contract_type_mutation::TypeInfo_push_type_arg(fn_ty, contract_fn_sig::FnSig_param_at(sig, i))
        contract_type_mutation::TypeInfo_push_param_mode(fn_ty, contract_fn_sig::FnSig_param_is_mut(sig, i))
        i = i + 1
    }
    contract_type_mutation::TypeInfo_push_type_arg(fn_ty, contract_fn_sig::FnSig_return_type(sig))
    fn_ty
}
