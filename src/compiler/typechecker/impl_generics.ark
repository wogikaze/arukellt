use typechecker::ast_access
use typechecker::contract_type_param_bounds
use typechecker::kinds
use typechecker::types

// The binder of `impl<T: Bound> Trait for Ctor<T>` is one metadata annotation
// after the trait/self heads. Keeping it out of indices 0 and 1 preserves the
// impl-head contract used by the resolver, CoreHIR, and the rest of the
// typechecker. `head_count` marks where the heads end.
fn head_count(impl_node: AstNode) -> i32 {
    let count = ast_access::node_type_ann_count(impl_node)
    if count >= 2 &&
    !ast_access::node_kind_is(
        ast_access::node_type_ann_at(impl_node, 1),
        kinds::NK_IMPL_GENERICS()
    ) {
        return 2
    }
    if count >= 1 {
        return 1
    }
    0
}

fn generics_index(impl_node: AstNode) -> i32 {
    let count = ast_access::node_type_ann_count(impl_node)
    let mut i = 0
    while i < count {
        if ast_access::node_kind_is(
            ast_access::node_type_ann_at(impl_node, i),
            kinds::NK_IMPL_GENERICS()
        ) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn declared_type_param_names(impl_node: AstNode) -> Vec<String> {
    let mut names = Vec::new<String>()
    let index = generics_index(impl_node)
    if index < 0 {
        return names
    }
    let binder = ast_access::node_type_ann_at(impl_node, index)
    let count = ast_access::node_child_count(binder)
    let mut i = 0
    while i < count {
        push(names, ast_access::node_text(ast_access::node_child_at(binder, i)))
        i = i + 1
    }
    names
}

// ADR-089: impl type parameters come only from the `impl<...>` binder. The
// window inference and the diagnostic scan live in corehir::decl_impl_target
// so resolver, CoreHIR, and typechecker agree on the effective parameter set.
fn has_binder(impl_node: AstNode) -> bool {
    generics_index(impl_node) >= 0
}

// One entry per declared parameter, even without a bound, so the caller can
// align the entries with the signature's ordered type parameters.
fn type_param_bounds(impl_node: AstNode) -> Vec<TypeParamBounds> {
    let mut bounds = Vec::new<TypeParamBounds>()
    let index = generics_index(impl_node)
    if index < 0 {
        return bounds
    }
    let binder = ast_access::node_type_ann_at(impl_node, index)
    let declared = declared_type_param_names(impl_node)
    let count = ast_access::node_child_count(binder)
    let mut i = 0
    while i < count {
        let param = ast_access::node_child_at(binder, i)
        let mut info = contract_type_param_bounds::TypeParamBounds_new(
            ast_access::node_text(param)
        )
        let bound_count = ast_access::node_type_ann_count(param)
        let mut j = 0
        while j < bound_count {
            contract_type_param_bounds::TypeParamBounds_push_bound(
                info,
                types::resolve_type_ann_node_generic(
                    ast_access::node_type_ann_at(param, j),
                    declared.clone()
                )
            )
            j = j + 1
        }
        push(bounds, info)
        i = i + 1
    }
    bounds
}
