use typechecker::contract_type_access
use typechecker::contract_type_constructors

fn simple_type(tag: i32) -> TypeInfo {
    contract_type_constructors::TypeInfo_simple(tag)
}

// The __simd_* and __wasm_v128_* intrinsics have no Ark declarations; the
// resolver lowers them by spelling. Their result type follows the lane
// family prefix and the lane-access suffix, so derive it instead of listing
// every operation a second time. The canonical signatures live in
// data/core-ops.toml. Remove this once the intrinsics have declarations
// (#936).
fn simd_builtin_call_return_type(name: String) -> TypeInfo {
    if name.clone().starts_with("__wasm_v128_store") {
        return simple_type(commands::TY_UNIT())
    }
    if name.clone().starts_with("__wasm_v128_load") {
        return simple_type(commands::TY_V128())
    }
    if name.clone().starts_with("__simd_u") {
        return simd_unsigned_return_type(name)
    }
    if name.clone().starts_with("__simd_v128_") {
        if name.clone().eq("__simd_v128_any_true") {
            return simple_type(commands::TY_I32())
        }
        return simple_type(commands::TY_V128())
    }
    if name.clone().starts_with("__simd_f32x4_") {
        if name.clone().ends_with("_extract_lane") {
            return simple_type(commands::TY_F32())
        }
        return simple_type(commands::TY_V128())
    }
    if name.clone().starts_with("__simd_f64x2_") {
        if name.clone().ends_with("_extract_lane") {
            return simple_type(commands::TY_F64())
        }
        return simple_type(commands::TY_V128())
    }
    if name.clone().starts_with("__simd_i32x4_") {
        if name.clone().ends_with("_extract_lane") || simd_is_mask_result(name.clone()) {
            return simple_type(commands::TY_I32())
        }
        return simple_type(commands::TY_V128())
    }
    if name.clone().starts_with("__simd_i64x2_") {
        if name.clone().ends_with("_extract_lane") {
            return simple_type(commands::TY_I64())
        }
        if simd_is_mask_result(name.clone()) {
            return simple_type(commands::TY_I32())
        }
        return simple_type(commands::TY_V128())
    }
    if name.clone().starts_with("__simd_i8x16_") || name.clone().starts_with("__simd_i16x8_") {
        if simd_is_lane_extract(name.clone()) || simd_is_mask_result(name.clone()) {
            return simple_type(commands::TY_I32())
        }
        return simple_type(commands::TY_V128())
    }
    simple_type(commands::TY_UNKNOWN())
}

// Only u64x2's scalar lane is classified; the other unsigned extracts keep
// the pre-existing unknown result and MIR supplies their value type.
fn simd_unsigned_return_type(name: String) -> TypeInfo {
    if name.clone().starts_with("__simd_u64x2_") && name.clone().ends_with("_extract_lane") {
        return simple_type(commands::TY_I64())
    }
    if simd_is_lane_extract(name) {
        return simple_type(commands::TY_UNKNOWN())
    }
    simple_type(commands::TY_V128())
}

fn simd_is_lane_extract(name: String) -> bool {
    name.clone().ends_with("_extract_lane") ||
    name.clone().ends_with("_extract_lane_s") ||
    name.clone().ends_with("_extract_lane_u")
}

fn simd_is_mask_result(name: String) -> bool {
    name.clone().ends_with("_all_true") || name.clone().ends_with("_bitmask")
}

test mod "simd_builtin_return" {
    test "f32_extract_lane_returns_f32" {
        assert(contract_type_access::TypeInfo_tag(simd_builtin_call_return_type("__simd_f32x4_extract_lane")) == commands::TY_F32())
    }
    test "i8x16_mask_returns_i32" {
        assert(contract_type_access::TypeInfo_tag(simd_builtin_call_return_type("__simd_i8x16_bitmask")) == commands::TY_I32())
    }
    test "u64x2_extract_lane_returns_i64" {
        assert(contract_type_access::TypeInfo_tag(simd_builtin_call_return_type("__simd_u64x2_extract_lane")) == commands::TY_I64())
    }
    test "wasm_store_is_unit" {
        assert(contract_type_access::TypeInfo_tag(simd_builtin_call_return_type("__wasm_v128_store")) == commands::TY_UNIT())
    }
    test "unknown_simd_name_stays_unknown" {
        assert(contract_type_access::TypeInfo_tag(simd_builtin_call_return_type("__simd_unknown")) == commands::TY_UNKNOWN())
    }
}
