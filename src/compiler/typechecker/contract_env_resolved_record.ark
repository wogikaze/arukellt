use typechecker::contract_env_record
use typechecker::contract_resolved_call

fn type_env_resolved_call_count(env: TypeEnv) -> i32 {
    env.resolved_calls.len()
}

fn type_env_resolved_call_at(env: TypeEnv, index: i32) -> ResolvedCall {
    env.resolved_calls.get_unchecked(index)
}

// Record or complete the resolution of one call site. The checker may infer
// the same call more than once (the return-contract pass re-infers the body)
// and generic calls learn their FunctionId only after the owner, so an
// existing record for the site is completed field by field instead of
// duplicated (#933 / #934).
fn type_env_record_resolved_call(
    mut env: TypeEnv,
    span_start: i32,
    callee_name: String,
    owner_name: String,
    function_id: String,
    mono_instance_id: String,
    callee_decl_index: i32
) {
    if env.current_decl_index < 0 {
        return
    }
    let count = env.resolved_calls.len()
    let mut i = 0
    while i < count {
        let existing = env.resolved_calls.get_unchecked(i)
        let same_site = existing.decl_index == env.current_decl_index &&
        existing.body_child_index == env.current_body_child_index &&
        existing.span_start == span_start
        if same_site && existing.callee_name.clone().eq(callee_name.clone()) {
            let merged = contract_resolved_call::ResolvedCall_completed(
                existing,
                owner_name,
                function_id,
                mono_instance_id,
                callee_decl_index
            )
            env.resolved_calls.set(i, merged)
            return
        }
        i = i + 1
    }
    env.resolved_calls.push(contract_resolved_call::ResolvedCall_new(
            env.current_decl_index,
            env.current_body_child_index,
            span_start,
            callee_name,
            owner_name,
            function_id,
            mono_instance_id,
            callee_decl_index
        ))
}

fn type_env_deferred_len_receiver_count(env: TypeEnv) -> i32 {
    env.deferred_len_receivers.len()
}

fn type_env_deferred_len_receiver_at(env: TypeEnv, index: i32) -> DeferredLenReceiver {
    env.deferred_len_receivers.get_unchecked(index)
}

fn type_env_push_deferred_len_receiver(mut env: TypeEnv, receiver: DeferredLenReceiver) {
    env.deferred_len_receivers.push(receiver)
}

fn type_env_clear_deferred_len_receivers(mut env: TypeEnv) {
    env.deferred_len_receivers = Vec::new<DeferredLenReceiver>()
}
