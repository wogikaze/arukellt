use std::text
use typechecker::kinds
use typechecker::ast_access
use typechecker::call_generic_common
use typechecker::call_generic_method_args
use typechecker::call_generic_resolve
use typechecker::associated_types
use typechecker::contract_env_resolved_record
use typechecker::contract_fn_sig
use typechecker::contract_type_access
use typechecker::infer_env_scope
use typechecker::names
use typechecker::hashmap_api
use typechecker::instantiate
use typechecker::mono
use typechecker::mono_instances
use typechecker::traits
use typechecker::unify
fn infer_generic_method_call_expr(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    sig: FnSig,
    recv_ty: TypeInfo,
    explicit_args: i32
) -> TypeInfo {
    let mut infer_env = infer_env_scope::borrow_generic_infer_env(env)
    let mut var_names = Vec::new<String>()
    let mut var_types = Vec::new<TypeInfo>()
    call_generic_common::append_generic_type_vars(infer_env, sig, var_names, var_types)
    let inst_p0 = call_generic_method_args::constrain_generic_method_args(env, scope, fn_sigs, enum_defs, node, sig, recv_ty, explicit_args, infer_env, var_names, var_types)
    // infer_env is scratch, so speculation diagnostics vanish with it:
    // map.set(k, v) adopted prelude::set<T>(Vec<T>), unified only through
    // the value argument, and lowered to a Vec store that corrupts the map
    // (#874). The callee sig is already chosen at this point, so surviving
    // unify errors are genuine mismatches. Re-issue them against env unless
    // the receiver still owns unresolved type variables, which marks the
    // call as legitimately deferred.
    let resolved_recv = unify::resolve_type_deep(env, recv_ty)
    if infer_env.error_count > 0 &&
    !associated_types::type_contains_var(resolved_recv.clone()) &&
    contract_type_access::TypeInfo_tag(resolved_recv) != commands::TY_UNKNOWN() {
        let mut speculation_error = 0
        while speculation_error < infer_env.error_count {
            unify::type_error(env, infer_env.errors.get_unchecked(speculation_error).clone())
            speculation_error = speculation_error + 1
        }
    }
    let inst_ret = instantiate::instantiate_type(contract_fn_sig::FnSig_return_type(sig), var_names, var_types)
    let projected_ret = associated_types::resolve_generic_call_type(env, infer_env, sig, var_names, var_types, inst_ret)
    let ret_ty = call_generic_resolve::resolve_call_return_type(infer_env, projected_ret)
    if call_generic_resolve::has_unresolved_fresh_type_arg(infer_env, var_types) {
        report_unresolved_fresh_type_params(env, infer_env, var_names, var_types, resolved_recv, ast_access::node_text(node))
        return ret_ty
    }
    let resolved_type_args = call_generic_common::resolve_type_args(infer_env, var_types)
    traits::enforce_fn_sig_bounds(env, infer_env, sig, var_types)
    let resolved_recv_ty = unify::resolve_type_deep(infer_env, inst_p0)
    let method_name = ast_access::node_text(node)
    let mut mono_fn_name = method_name.clone()
    let type_prefix = type_name_for_mono(resolved_recv_ty)
    if type_prefix.len() > 0 {
        mono_fn_name = type_prefix.concat("::".concat(method_name))
    }
    if !hashmap_api::validate_hashmap_method(env, mono_fn_name.clone(), resolved_recv_ty) {
        return ret_ty
    }
    // A receiver that is still a bare type variable may resolve to an
    // impl method at the concrete instantiation instead of this sig
    // (MIR lowering prefers `Receiver::method`): record the var-method
    // demand edge alongside the sig's own instance so the rebind mints
    // whichever the call actually lowers to (#912).
    if contract_type_access::TypeInfo_tag(resolved_recv_ty) == commands::TY_TYPE_VAR() {
        mono_instances::record_var_method_site(
            env,
            method_name.clone(),
            resolved_recv_ty.clone()
        )
    }
    let mangled_name = mono::record_mono_instance(env, mono_fn_name.clone(), resolved_type_args)
    mono::record_mono_return_type(env, mangled_name.clone(), ret_ty)
    mono::record_mono_call_site(env, ast_access::node_span_start(node), mono_fn_name, mangled_name.clone())
    contract_env_resolved_record::type_env_record_resolved_call(
        env,
        ast_access::node_span_start(node),
        method_name,
        String_new(),
        contract_fn_sig::FnSig_name(sig),
        mangled_name,
        0 - 1
    )
    ret_ty
}

// A call on a fully concrete receiver must determine every method-level
// type parameter from its arguments. Fresh vars still unresolved here mean
// the call cannot be monomorphized, so name the parameter instead of
// silently skipping the instance and leaving an unknown symbol for the
// emitter (#887). Receivers that still own type variables (UNKNOWN field
// access, enclosing generic functions) legitimately defer inference and
// stay silent, as do calls whose argument unification already errored.
fn report_unresolved_fresh_type_params(mut env: TypeEnv, infer_env: TypeEnv, var_names: Vec<String>, var_types: Vec<TypeInfo>, resolved_recv: TypeInfo, method_name: String) {
    if infer_env.error_count > 0 {
        return
    }
    if associated_types::type_contains_var(resolved_recv.clone()) ||
    contract_type_access::TypeInfo_tag(resolved_recv) == commands::TY_UNKNOWN() {
        return
    }
    // impl-level params occupy the head of var_names and may legitimately
    // stay unbound on untyped-self receivers (Vec / HashMap adapters): the
    // receiver naming pass resolves those monomorphisations downstream.
    // Only method-declared params — the tail beyond the receiver arity —
    // must be determined by call arguments.
    let mut i = contract_type_access::TypeInfo_type_arg_count(resolved_recv)
    while i < var_types.len() {
        let resolved = unify::resolve_type(infer_env, var_types.get_unchecked(i))
        if call_generic_resolve::is_unresolved_fresh_type_var(infer_env, resolved) {
            unify::type_error(env, "cannot infer type parameter ".concat(var_names.get_unchecked(i).concat(" in method call ".concat(method_name))))
            return
        }
        i = i + 1
    }
}

// Map a receiver TypeInfo to the type name used for mono instance naming.
// Returns empty string for types that don't have a type prefix.
fn type_name_for_mono(ty: TypeInfo) -> String {
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == commands::TY_VEC() {
        return "Vec"
    }
    if tag == commands::TY_HASHMAP() {
        return "HashMap"
    }
    if tag == commands::TY_STRING() {
        return "String"
    }
    if tag == commands::TY_STRUCT() {
        let name = contract_type_access::TypeInfo_name(ty)
        if name.len() > 0 {
            return names::unqualified_type_name(name)
        }
    }
    if tag == commands::TY_ENUM() {
        let name = contract_type_access::TypeInfo_name(ty)
        if name.len() > 0 {
            return names::unqualified_type_name(name)
        }
    }
    String_new()
}
