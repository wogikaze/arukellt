use std::text
use corehir::decl_impl_target
use typechecker::ast_access
use typechecker::contract_associated_type
use typechecker::contract_fn_sig
use typechecker::contract_trait_impl
use typechecker::contract_trait_method_record
use typechecker::contract_type_access
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::contract_type_param_bounds
use typechecker::contract_types_record
use typechecker::impl_generics
use typechecker::instantiate
use typechecker::trait_method_record
use typechecker::types
use typechecker::names
use typechecker::unify

fn resolve_impl_signature(env: TypeEnv, impl_node: AstNode, sig: FnSig) -> FnSig {
    if impl_generics::head_count(impl_node) != 2 {
        return sig
    }
    let trait_node = ast_access::node_type_ann_at(impl_node, 0)
    let self_node = ast_access::node_type_ann_at(impl_node, 1)
    let trait_name = ast_access::node_text(trait_node)
    // Keep the impl head's type parameters as type variables, as
    // resolve_impl_self_return does. Otherwise T resolves as a named struct
    // and the projection pass below binds `Self` to a receiver whose type
    // argument no MonoInstance can substitute.
    let self_ty = types::resolve_type_ann_node_generic(
        self_node,
        decl_impl_target::effective_impl_param_names(
            impl_node,
            env.declared_type_names.clone()
        )
    )
    let mut params = Vec::new<TypeInfo>()
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    let mut i = 0
    while i < param_count {
        push(
            params,
            resolve_projection(
                env,
                trait_name.clone(),
                self_ty,
                contract_fn_sig::FnSig_param_at(sig, i)
            )
        )
        i = i + 1
    }
    let return_type = resolve_projection(
        env,
        trait_name.clone(),
        self_ty,
        contract_fn_sig::FnSig_return_type(sig)
    )
    contract_fn_sig::FnSig_with_types(sig, params, return_type)
}

// `Self` in an impl method names the impl target. Trait impls resolve it
// through resolve_impl_signature's projection pass, but that pass leaves
// inherent impls untouched and cannot resolve a `Self` the annotation
// resolver spelled as a named type. Every impl method return therefore
// resolves Self here, generic or not: the impl head's own type parameters
// are kept as type variables so a later MonoInstance can substitute them
// instead of a bare `Self` that no call can ever bind.
fn resolve_impl_self_return(env: TypeEnv, impl_node: AstNode, sig: FnSig) -> FnSig {
    let heads = impl_generics::head_count(impl_node)
    if heads < 1 {
        return sig
    }
    let self_ty = types::resolve_type_ann_node_generic(
        ast_access::node_type_ann_at(impl_node, heads - 1),
        decl_impl_target::effective_impl_param_names(
            impl_node,
            env.declared_type_names.clone()
        )
    )
    let return_type = resolve_self_type(self_ty, contract_fn_sig::FnSig_return_type(sig))
    let mut params = Vec::new<TypeInfo>()
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    let mut i = 0
    while i < param_count {
        push(params, contract_fn_sig::FnSig_param_at(sig, i))
        i = i + 1
    }
    contract_fn_sig::FnSig_with_types(sig, params, return_type)
}

// A return annotation resolver can spell `Self` as a type variable or as a
// concrete named type; both mean the impl target here. Container returns
// (`Option<Self>`) resolve recursively.
fn resolve_self_type(self_ty: TypeInfo, ty: TypeInfo) -> TypeInfo {
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == commands::TY_TYPE_VAR() || tag == commands::TY_STRUCT() {
        if contract_type_access::TypeInfo_name(ty).eq(String_from("Self")) {
            return self_ty
        }
    }
    let arg_count = contract_type_access::TypeInfo_type_arg_count(ty)
    if arg_count == 0 {
        return ty
    }
    let mut resolved = contract_type_constructors::TypeInfo_empty_like(ty)
    let mut i = 0
    while i < arg_count {
        contract_type_mutation::TypeInfo_push_type_arg(
            resolved,
            resolve_self_type(self_ty, contract_type_access::TypeInfo_type_arg_at(ty, i))
        )
        i = i + 1
    }
    resolved
}

fn resolve_projection_for_receiver(
    env: TypeEnv,
    trait_name: String,
    receiver: TypeInfo,
    ty: TypeInfo
) -> TypeInfo {
    resolve_projection(env, trait_name, receiver, ty)
}

fn resolve_trait_method_signature(
    env: TypeEnv,
    entry: TraitMethodEntry,
    bound: TypeInfo,
    receiver: TypeInfo
) -> FnSig {
    let sig = contract_trait_method_record::trait_method_entry_sig(entry)
    let trait_name = contract_trait_method_record::trait_method_entry_trait_name(entry)
    let trait_param_count = trait_method_record::trait_method_entry_trait_type_param_count(entry)
    let mut params = Vec::new<TypeInfo>()
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    let mut i = 0
    while i < param_count {
        push(
            params,
            resolve_trait_method_type(
                env,
                trait_name.clone(),
                bound,
                receiver,
                sig,
                trait_param_count,
                contract_fn_sig::FnSig_param_at(sig, i)
            )
        )
        i = i + 1
    }
    let return_type = resolve_trait_method_type(
        env,
        trait_name.clone(),
        bound,
        receiver,
        sig,
        trait_param_count,
        contract_fn_sig::FnSig_return_type(sig)
    )
    contract_fn_sig::FnSig_with_types(sig, params, return_type)
}

fn resolve_trait_method_type(
    env: TypeEnv,
    trait_name: String,
    bound: TypeInfo,
    receiver: TypeInfo,
    sig: FnSig,
    trait_param_count: i32,
    ty: TypeInfo
) -> TypeInfo {
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == commands::TY_TYPE_VAR() {
        let name = contract_type_access::TypeInfo_name(ty)
        if name.clone().eq("Self") {
            return receiver
        }
        let param_index = trait_type_param_index(sig, trait_param_count, name.clone())
        let bound_arg_count = contract_type_access::TypeInfo_type_arg_count(bound)
        if param_index >= 0 && param_index < bound_arg_count {
            return contract_type_access::TypeInfo_type_arg_at(bound, param_index)
        }
        return ty
    }
    if tag == commands::TY_STRUCT() {
        let name = contract_type_access::TypeInfo_name(ty)
        let prefix = String_from("Self::")
        if name.clone().starts_with(prefix.clone()) {
            let assoc_name = name.slice(prefix.len(), name.len())
            let mut resolved = lookup_associated_type(
                env,
                trait_name.clone(),
                receiver,
                assoc_name
            )
            if contract_type_access::TypeInfo_tag(resolved) != commands::TY_UNKNOWN() {
                return resolved
            }
            return unresolved_projection_for_receiver(receiver, assoc_name)
        }
    }
    let arg_count = contract_type_access::TypeInfo_type_arg_count(ty)
    if arg_count == 0 {
        return ty
    }
    let mut resolved = contract_type_constructors::TypeInfo_empty_like(ty)
    let mut i = 0
    while i < arg_count {
        contract_type_mutation::TypeInfo_push_type_arg(
            resolved,
            resolve_trait_method_type(
                env,
                trait_name.clone(),
                bound,
                receiver,
                sig,
                trait_param_count,
                contract_type_access::TypeInfo_type_arg_at(ty, i)
            )
        )
        i = i + 1
    }
    resolved
}

fn trait_type_param_index(sig: FnSig, count: i32, name: String) -> i32 {
    let mut i = 0
    while i < count {
        if contract_fn_sig::FnSig_type_param_at(sig, i).eq(name.clone()) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn resolve_projection(
    env: TypeEnv,
    trait_name: String,
    receiver: TypeInfo,
    ty: TypeInfo
) -> TypeInfo {
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == commands::TY_TYPE_VAR() {
        if contract_type_access::TypeInfo_name(ty).eq("Self") {
            return receiver
        }
        return ty
    }
    if tag == commands::TY_STRUCT() {
        let name = contract_type_access::TypeInfo_name(ty)
        let prefix = String_from("Self::")
        if name.clone().starts_with(prefix.clone()) {
            let assoc_name = name.slice(prefix.len(), name.len())
            let mut resolved = lookup_associated_type(env, trait_name.clone(), receiver, assoc_name)
            if contract_type_access::TypeInfo_tag(resolved) != commands::TY_UNKNOWN() {
                return resolved
            }
            return unresolved_projection_for_receiver(receiver, assoc_name)
        }
    }
    let arg_count = contract_type_access::TypeInfo_type_arg_count(ty)
    if arg_count == 0 {
        return ty
    }
    let mut resolved = contract_type_constructors::TypeInfo_empty_like(ty)
    let mut i = 0
    while i < arg_count {
        contract_type_mutation::TypeInfo_push_type_arg(
            resolved,
            resolve_projection(
                env,
                trait_name.clone(),
                receiver,
                contract_type_access::TypeInfo_type_arg_at(ty, i)
            )
        )
        i = i + 1
    }
    resolved
}

// Keep a projection symbolic while checking a generic body.  The concrete
// associated type is selected later, after a call binds the type parameter to
// an implementing type.
fn unresolved_projection_for_receiver(receiver: TypeInfo, assoc_name: String) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(receiver) != commands::TY_TYPE_VAR() {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let receiver_name = contract_type_access::TypeInfo_name(receiver)
    contract_type_constructors::TypeInfo_named(
        commands::TY_STRUCT(),
        receiver_name.clone().concat("::".concat(assoc_name))
    )
}

// Resolve `T::Item` after generic argument inference has bound T to a
// concrete receiver.  Signature construction cannot do this because it runs
// before a call site supplies the implementing type.
fn resolve_generic_call_type(
    env: TypeEnv,
    infer_env: TypeEnv,
    sig: FnSig,
    var_names: Vec<String>,
    var_types: Vec<TypeInfo>,
    ty: TypeInfo
) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(ty) == commands::TY_STRUCT() {
        let name = contract_type_access::TypeInfo_name(ty)
        let separator = name.clone().index_of("::")
        if separator > 0 {
            let type_param = name.clone().slice(0, separator)
            let assoc_name = name.clone().slice(separator + 2, name.len())
            let var_index = generic_type_var_index(var_names, type_param.clone())
            if var_index >= 0 && var_index < var_types.len() {
                let receiver = unify::resolve_type_deep(
                    infer_env,
                    var_types.get_unchecked(var_index)
                )
                let mut resolved = resolve_bound_projection(
                    env,
                    sig,
                    type_param.clone(),
                    receiver,
                    assoc_name.clone()
                )
                if contract_type_access::TypeInfo_tag(resolved) != commands::TY_UNKNOWN() {
                    return resolve_generic_call_type(
                        env,
                        infer_env,
                        sig,
                        var_names,
                        var_types,
                        resolved
                    )
                }
            }
        }
    }
    let arg_count = contract_type_access::TypeInfo_type_arg_count(ty)
    if arg_count == 0 {
        return ty
    }
    let mut resolved = contract_type_constructors::TypeInfo_empty_like(ty)
    let mut i = 0
    while i < arg_count {
        contract_type_mutation::TypeInfo_push_type_arg(
            resolved,
            resolve_generic_call_type(
                env,
                infer_env,
                sig,
                var_names,
                var_types,
                contract_type_access::TypeInfo_type_arg_at(ty, i)
            )
        )
        i = i + 1
    }
    resolved
}

fn generic_type_var_index(names: Vec<String>, target: String) -> i32 {
    let count = names.len()
    let mut i = 0
    while i < count {
        if names.get_unchecked(i).eq(target.clone()) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn resolve_bound_projection(
    env: TypeEnv,
    sig: FnSig,
    type_param: String,
    receiver: TypeInfo,
    assoc_name: String
) -> TypeInfo {
    let bound_count = contract_fn_sig::FnSig_type_param_bound_count(sig)
    let mut i = 0
    while i < bound_count {
        let bound_info = contract_fn_sig::FnSig_type_param_bound_at(sig, i)
        if contract_type_param_bounds::TypeParamBounds_name(bound_info).eq(type_param.clone()) {
            let trait_count = contract_type_param_bounds::TypeParamBounds_bound_count(bound_info)
            let mut j = 0
            while j < trait_count {
                let bound = contract_type_param_bounds::TypeParamBounds_bound_at(bound_info, j)
                let resolved = lookup_associated_type(
                    env,
                    contract_type_access::TypeInfo_name(bound),
                    receiver,
                    assoc_name.clone()
                )
                if contract_type_access::TypeInfo_tag(resolved) != commands::TY_UNKNOWN() {
                    return resolved
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    // The sig's parameter may carry no declared bound (parametric impl
    // methods such as TakeIter<I>::collect -> Vec<I::Item>). Once the
    // call binds the parameter to a concrete receiver, the projection
    // is still resolvable through the receiver's own impl entries.
    lookup_assoc_for_ctor(env, receiver, assoc_name)
}

fn lookup_associated_type(
    env: TypeEnv,
    trait_name: String,
    receiver: TypeInfo,
    assoc_name: String
) -> TypeInfo {
    let count = env.associated_types.len()
    let mut i = 0
    while i < count {
        let entry = env.associated_types.get_unchecked(i)
        if names::same_type_name(
            contract_associated_type::trait_associated_type_info_trait_name(entry),
            trait_name.clone()
        ) && contract_associated_type::trait_associated_type_info_name(entry).eq(assoc_name.clone()) && same_type(
            contract_associated_type::trait_associated_type_info_self_ty(entry),
            receiver
        ) {
            return contract_associated_type::trait_associated_type_info_value_ty(entry)
        }
        i = i + 1
    }
    // Parametric impls register associated types under a var-carrying self
    // pattern. Match the concrete receiver against the pattern, then
    // instantiate the declared value type with the bound arguments.
    let mut p = 0
    while p < count {
        let entry = env.associated_types.get_unchecked(p)
        let pattern = contract_associated_type::trait_associated_type_info_self_ty(entry)
        if names::same_type_name(
            contract_associated_type::trait_associated_type_info_trait_name(entry),
            trait_name.clone()
        ) && contract_associated_type::trait_associated_type_info_name(entry).eq(assoc_name.clone()) {
            // The entry's self pattern can degrade impl type variables to
            // named structs (I spelled as a struct), which hides the
            // pattern from type_contains_var. The trait_impls entry keeps
            // the authoritative var-carrying pattern for binding, the same
            // fallback lookup_assoc_for_ctor uses.
            let impl_self = lookup_var_carrying_impl_self(
                env,
                contract_associated_type::trait_associated_type_info_trait_name(entry),
                pattern.clone()
            )
            if type_contains_var(impl_self.clone()) {
                let mut var_names = Vec::new<String>()
                let mut var_types = Vec::new<TypeInfo>()
                if match_pattern_collect_vars(impl_self, receiver, var_names, var_types) {
                    // The declared value can itself be a projection
                    // (type Item = I::Item). instantiate_type only
                    // substitutes TY_TYPE_VAR nodes, so reduce the
                    // projection chain the same way lookup_assoc_for_ctor
                    // does or callers see the raw I::Item spelling.
                    return normalize_projection_ty(
                        env,
                        var_names.clone(),
                        var_types.clone(),
                        instantiate::instantiate_type(
                            contract_associated_type::trait_associated_type_info_value_ty(entry),
                            var_names,
                            var_types
                        )
                    )
                }
            }
        }
        p = p + 1
    }
    contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
}

// Reduce Owner::Assoc and Var::Assoc names left inside an instantiated
// type by resolving the associated type through the matching impl.
// instantiate_type only substitutes TY_TYPE_VAR nodes, so I::Item
// survives instantiation of Twice<I>'s Option<I::Item> return.
// Bound variables resolve through var_names/var_types; concrete
// Owner<Args> owners are reparsed into TypeInfo. Reduction recurses so
// chained projections (I::Item -> WrapIter<i32>::Item -> i32)
// finish at a concrete type. Unresolvable names stay symbolic.
fn normalize_projection_ty(
    env: TypeEnv,
    var_names: Vec<String>,
    var_types: Vec<TypeInfo>,
    ty: TypeInfo
) -> TypeInfo {
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == commands::TY_STRUCT() || tag == commands::TY_ENUM() {
        let name = contract_type_access::TypeInfo_name(ty)
        let sep = projection_sep_index(name.clone())
        if sep >= 0 {
            let owner_name = name.clone().slice(0, sep)
            let assoc_name = name.clone().slice(sep + 2, name.len())
            let receiver = projection_owner_ty(
                env,
                var_names.clone(),
                var_types.clone(),
                owner_name
            )
            if contract_type_access::TypeInfo_tag(receiver) != commands::TY_UNKNOWN() {
                let resolved = lookup_assoc_for_ctor(env, receiver, assoc_name)
                if contract_type_access::TypeInfo_tag(resolved) != commands::TY_UNKNOWN() {
                    return normalize_projection_ty(env, var_names, var_types, resolved)
                }
            }
        }
    }
    let arg_count = contract_type_access::TypeInfo_type_arg_count(ty)
    if arg_count == 0 {
        return ty
    }
    let mut result = contract_type_constructors::TypeInfo_empty_like(ty)
    let mut i = 0
    while i < arg_count {
        contract_type_mutation::TypeInfo_push_type_arg(
            result,
            normalize_projection_ty(
                env,
                var_names.clone(),
                var_types.clone(),
                contract_type_access::TypeInfo_type_arg_at(ty, i)
            )
        )
        i = i + 1
    }
    result
}

// Index of the last :: in a projection-style type name, or -1.
fn projection_sep_index(name: String) -> i32 {
    let mut i = name.len() - 2
    while i >= 0 {
        if name.clone().byte_at(i) == 58 && name.clone().byte_at(i + 1) == 58 {
            return i
        }
        i = i - 1
    }
    0 - 1
}

// The receiver half of an Owner::Assoc name as TypeInfo. A bound type
// variable resolves through the mono bindings; Owner<Args> reparses
// into a constructor application; anything else resolves by name.
fn projection_owner_ty(
    env: TypeEnv,
    var_names: Vec<String>,
    var_types: Vec<TypeInfo>,
    owner_name: String
) -> TypeInfo {
    let bound_count = var_names.len()
    let mut b = 0
    while b < bound_count {
        if projection_bare_name(var_names.get_unchecked(b)).eq(projection_bare_name(owner_name.clone())) {
            return var_types.get_unchecked(b)
        }
        b = b + 1
    }
    let n = owner_name.len()
    if n > 2 && owner_name.clone().byte_at(n - 1) == 62 {
        let mut lt = 0 - 1
        let mut i = 0
        while i < n {
            if owner_name.clone().byte_at(i) == 60 {
                lt = i
                i = n
            }
            i = i + 1
        }
        if lt > 0 {
            let ctor = owner_name.clone().slice(0, lt)
            let inner = owner_name.clone().slice(lt + 1, n - 1)
            let mut args = Vec::new<TypeInfo>()
            let mut seg_start = 0
            let mut depth = 0
            let m = inner.len()
            let mut j = 0
            while j <= m {
                let at_end = j == m
                let ch = if at_end { 44 } else { inner.clone().byte_at(j) }
                if ch == 60 {
                    depth = depth + 1
                }
                if ch == 62 {
                    depth = depth - 1
                }
                if (ch == 44 && depth == 0) || at_end {
                    push(
                        args,
                        projection_owner_ty(
                            env,
                            var_names.clone(),
                            var_types.clone(),
                            trim_type_ws(inner.clone().slice(seg_start, j))
                        )
                    )
                    seg_start = j + 1
                }
                j = j + 1
            }
            return contract_types_record::TypeInfo_new(commands::TY_STRUCT(), ctor, args)
        }
    }
    types::resolve_type_name(owner_name)
}

// Type-variable spellings differ between signature params (?I) and
// projection names (I::Item). Compare on the bare identifier.
fn projection_bare_name(name: String) -> String {
    if name.len() > 0 && name.clone().byte_at(0) == 63 {
        return name.slice(1, name.len())
    }
    name
}

fn trim_type_ws(seg: String) -> String {
    let mut start = 0
    let mut end = seg.len()
    while start < end && seg.clone().byte_at(start) == 32 {
        start = start + 1
    }
    while end > start && seg.clone().byte_at(end - 1) == 32 {
        end = end - 1
    }
    seg.slice(start, end)
}

// lookup_associated_type without a trait qualifier: the projection name
// Owner::Assoc carries no trait, so match on the associated-type name
// and the self-type constructor instead.
fn lookup_assoc_for_ctor(env: TypeEnv, receiver: TypeInfo, assoc_name: String) -> TypeInfo {
    let ctor = contract_type_access::TypeInfo_name(receiver)
    let count = env.associated_types.len()
    let mut i = 0
    while i < count {
        let entry = env.associated_types.get_unchecked(i)
        let entry_self = contract_associated_type::trait_associated_type_info_self_ty(entry)
        if contract_associated_type::trait_associated_type_info_name(entry).eq(assoc_name.clone()) && names::same_type_name(
            contract_type_access::TypeInfo_name(entry_self),
            ctor.clone()
        ) {
            // The entry's self pattern can degrade impl type variables to
            // named structs (T spelled as a struct). The trait_impls entry
            // keeps the authoritative var-carrying pattern for binding.
            let impl_self = lookup_var_carrying_impl_self(
                env,
                contract_associated_type::trait_associated_type_info_trait_name(entry),
                entry_self.clone()
            )
            let mut bound_names = Vec::new<String>()
            let mut bound_types = Vec::new<TypeInfo>()
            if match_pattern_collect_vars(
                impl_self.clone(),
                receiver.clone(),
                bound_names,
                bound_types
            ) {
                return normalize_projection_ty(
                    env,
                    bound_names.clone(),
                    bound_types.clone(),
                    instantiate::instantiate_type(
                        contract_associated_type::trait_associated_type_info_value_ty(entry),
                        bound_names,
                        bound_types
                    )
                )
            }
            if same_type(entry_self.clone(), receiver.clone()) {
                return contract_associated_type::trait_associated_type_info_value_ty(entry)
            }
        }
        i = i + 1
    }
    contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
}

// The var-carrying self pattern of the impl matching (trait, ctor), or
// the associated-type entry's own self type when the impl is concrete.
fn lookup_var_carrying_impl_self(env: TypeEnv, trait_name: String, entry_self: TypeInfo) -> TypeInfo {
    let count = env.trait_impls.len()
    let mut i = 0
    while i < count {
        let impl_info = env.trait_impls.get_unchecked(i)
        let self_ty = contract_trait_impl::TraitImplInfo_self_ty(impl_info)
        if names::same_type_name(
            contract_trait_impl::TraitImplInfo_trait_name(impl_info),
            trait_name.clone()
        ) && names::same_type_name(
            contract_type_access::TypeInfo_name(self_ty),
            contract_type_access::TypeInfo_name(entry_self)
        ) && type_contains_var(self_ty.clone()) {
            return self_ty
        }
        i = i + 1
    }
    entry_self
}

fn type_contains_var(ty: TypeInfo) -> bool {
    if contract_type_access::TypeInfo_tag(ty) == commands::TY_TYPE_VAR() {
        return true
    }
    let count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut i = 0
    while i < count {
        if type_contains_var(contract_type_access::TypeInfo_type_arg_at(ty, i)) {
            return true
        }
        i = i + 1
    }
    false
}

fn match_pattern_collect_vars(
    pattern: TypeInfo,
    actual: TypeInfo,
    mut names: Vec<String>,
    mut types: Vec<TypeInfo>
) -> bool {
    if contract_type_access::TypeInfo_tag(pattern) == commands::TY_TYPE_VAR() {
        let var_name = contract_type_access::TypeInfo_name(pattern)
        let bound_count = names.len()
        let mut i = 0
        while i < bound_count {
            if names.get_unchecked(i).eq(var_name.clone()) {
                return same_type(types.get_unchecked(i), actual)
            }
            i = i + 1
        }
        push(names, var_name)
        push(types, actual)
        return true
    }
    if !associated_type_tags_match(
        contract_type_access::TypeInfo_tag(pattern),
        contract_type_access::TypeInfo_tag(actual)
    ) || !names::same_type_name(
        contract_type_access::TypeInfo_name(pattern),
        contract_type_access::TypeInfo_name(actual)
    ) {
        return false
    }
    let pattern_count = contract_type_access::TypeInfo_type_arg_count(pattern)
    if pattern_count != contract_type_access::TypeInfo_type_arg_count(actual) {
        return false
    }
    let mut a = 0
    while a < pattern_count {
        if !match_pattern_collect_vars(
            contract_type_access::TypeInfo_type_arg_at(pattern, a),
            contract_type_access::TypeInfo_type_arg_at(actual, a),
            names,
            types
        ) {
            return false
        }
        a = a + 1
    }
    true
}

fn same_type(a: TypeInfo, b: TypeInfo) -> bool {
    if !associated_type_tags_match(
        contract_type_access::TypeInfo_tag(a),
        contract_type_access::TypeInfo_tag(b)
    ) ||
    !names::same_type_name(
        contract_type_access::TypeInfo_name(a),
        contract_type_access::TypeInfo_name(b)
    ) {
        return false
    }
    let ac = contract_type_access::TypeInfo_type_arg_count(a)
    let bc = contract_type_access::TypeInfo_type_arg_count(b)
    if ac != bc {
        return false
    }
    let mut i = 0
    while i < ac {
        if !same_type(
            contract_type_access::TypeInfo_type_arg_at(a, i),
            contract_type_access::TypeInfo_type_arg_at(b, i)
        ) {
            return false
        }
        i = i + 1
    }
    true
}

fn associated_type_tags_match(a_tag: i32, b_tag: i32) -> bool {
    if a_tag == b_tag {
        return true
    }
    if a_tag == commands::TY_STRUCT() && b_tag == commands::TY_ENUM() {
        return true
    }
    if a_tag == commands::TY_ENUM() && b_tag == commands::TY_STRUCT() {
        return true
    }
    false
}
