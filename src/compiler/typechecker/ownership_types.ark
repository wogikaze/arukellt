use typechecker::contract_type_access
use typechecker::contract_trait_impl
use typechecker::contract_type_param_bounds
use typechecker::names

fn type_is_builtin_copy(ty: TypeInfo) -> bool {
    let tag = contract_type_access::TypeInfo_tag(ty)
    tag == commands::TY_I32() ||
    tag == commands::TY_I64() ||
    tag == commands::TY_F32() ||
    tag == commands::TY_F64() ||
    tag == commands::TY_BOOL() ||
    tag == commands::TY_CHAR() ||
    tag == commands::TY_V128() ||
    tag == commands::TY_UNIT() ||
    tag == commands::TY_NEVER()
}

fn type_is_copy(env: TypeEnv, ty: TypeInfo) -> bool {
    if type_is_builtin_copy(ty) {
        return true
    }
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == commands::TY_TUPLE() || tag == commands::TY_OPTION() || tag == commands::TY_RESULT() {
        return type_args_are_copy(env, ty)
    }
    if tag == commands::TY_TYPE_VAR() {
        return type_var_has_copy_bound(env, contract_type_access::TypeInfo_name(ty))
    }
    if tag == commands::TY_STRUCT() || tag == commands::TY_ENUM() {
        return has_explicit_copy_impl(env, ty)
    }
    false
}

fn type_args_are_copy(env: TypeEnv, ty: TypeInfo) -> bool {
    let count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut i = 0
    while i < count {
        if !type_is_copy(env, contract_type_access::TypeInfo_type_arg_at(ty, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn has_explicit_copy_impl(env: TypeEnv, ty: TypeInfo) -> bool {
    let count = len(env.trait_impls)
    let mut i = 0
    while i < count {
        let impl_info = get_unchecked(env.trait_impls, i)
        if names::same_type_name(contract_trait_impl::TraitImplInfo_trait_name(impl_info), "Copy") &&
        names::same_nominal_type(contract_trait_impl::TraitImplInfo_self_ty(impl_info), ty) {
            return true
        }
        i = i + 1
    }
    false
}

fn type_var_has_copy_bound(env: TypeEnv, name: String) -> bool {
    let count = len(env.current_fn_bounds)
    let mut i = 0
    while i < count {
        let param = get_unchecked(env.current_fn_bounds, i)
        if eq(contract_type_param_bounds::TypeParamBounds_name(param), clone(name)) {
            let bound_count = contract_type_param_bounds::TypeParamBounds_bound_count(param)
            let mut j = 0
            while j < bound_count {
                let bound = contract_type_param_bounds::TypeParamBounds_bound_at(param, j)
                if eq(contract_type_access::TypeInfo_name(bound), "Copy") {
                    return true
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    false
}
