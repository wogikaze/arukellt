use typechecker::kinds
use typechecker::contract_type_access
use typechecker::match_coverage_read_record
use typechecker::match_exhaustive_builtin
use typechecker::match_exhaustive_enum
use typechecker::unify

// ADR-082: a match must be provably exhaustive. Arms that cannot prove
// coverage (guarded arms, refutable payload patterns) do not count, so
// any path where no arm can match is rejected at typecheck instead of
// diverging between backends at runtime.
fn check_match_exhaustive(mut env: TypeEnv, resolved_scrutinee: TypeInfo, enum_defs: Vec<EnumInfo>, coverage: MatchCoverage) {
    if match_coverage_read_record::MatchCoverage_has_wildcard(coverage) ||
    match_coverage_read_record::MatchCoverage_has_irrefutable(coverage) {
        return
    }
    let scrutinee_tag = contract_type_access::TypeInfo_tag(resolved_scrutinee)
    if scrutinee_tag == kinds::TY_UNKNOWN() {
        return
    }
    if scrutinee_tag == kinds::TY_BOOL() || scrutinee_tag == kinds::TY_OPTION() ||
    scrutinee_tag == kinds::TY_RESULT() {
        match_exhaustive_builtin::check_builtin_match_exhaustive(env, resolved_scrutinee, coverage)
        return
    }
    if scrutinee_tag == kinds::TY_ENUM() ||
    (contract_type_access::TypeInfo_has_name(resolved_scrutinee) &&
        match_exhaustive_enum::enum_def_exists(resolved_scrutinee, enum_defs)) {
        match_exhaustive_enum::check_enum_match_exhaustive(env, resolved_scrutinee, enum_defs, coverage)
        return
    }
    unify::type_error(env, String_from("non-exhaustive match: scrutinee requires a catchall arm"))
}
