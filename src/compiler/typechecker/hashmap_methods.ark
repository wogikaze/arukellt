use std::prelude::{clone, eq}
use std::text
use typechecker::ast_access
use typechecker::contract_type_access
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::hashmap_api
use typechecker::mono
use typechecker::types
use typechecker::unify
fn infer_hashmap_constructor_call(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    callee: AstNode
) -> TypeInfo {
    let callee_name = ast_access::node_text(callee)
    let is_new = eq(clone(callee_name), String_from("HashMap::new"))
    let is_with_capacity = eq(clone(callee_name), String_from("HashMap::with_capacity"))
    if !is_new && !is_with_capacity {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let type_arg_count = ast_access::node_child_count(callee) - 1
    if type_arg_count != 2 {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let key_ty = types::resolve_type_ann_node(ast_access::node_child_at(callee, 1))
    let value_ty = types::resolve_type_ann_node(ast_access::node_child_at(callee, 2))
    let mut resolved_types = Vec::new<TypeInfo>()
    push(resolved_types, key_ty)
    push(resolved_types, value_ty)
    let result_ty = hashmap_type(key_ty, value_ty)
    if is_with_capacity && !hashmap_pair_is_flat_store(key_ty, value_ty) {
        hashmap_report_unavailable(
            env,
            String_from("associated function"),
            String_from("with_capacity"),
            key_ty,
            value_ty
        )
        return result_ty
    }
    if !hashmap_api::validate_hashmap_constructor(env, clone(callee_name), resolved_types) {
        return result_ty
    }
    if is_with_capacity {
        if ast_access::node_child_count(node) != 2 {
            return result_ty
        }
        unify_hashmap_method_arg(
            env,
            scope,
            fn_sigs,
            enum_defs,
            node,
            1,
            contract_type_constructors::TypeInfo_simple(commands::TY_I32())
        )
    }
    // `with_capacity` has no generic shell declaration (the method is
    // declared on `impl HashMap<i32, i32>`), so a mono instance named
    // `HashMap::with_capacity` would have no body to instantiate. The MIR
    // constructor rewrite owns the callee instead; recording a call site
    // here leaves an unresolved `unreachable` at the call.
    if !is_with_capacity {
        let mangled_name = mono::record_mono_instance(env, clone(callee_name), resolved_types)
        mono::record_mono_call_site(
            env,
            ast_access::node_span_start(node),
            clone(callee_name),
            mangled_name
        )
    }
    result_ty
}

fn infer_builtin_hashmap_method(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    recv_ty: TypeInfo,
    method_name: String,
    child_count: i32
) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(recv_ty) != commands::TY_HASHMAP() {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    if contract_type_access::TypeInfo_type_arg_count(recv_ty) < 2 {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let explicit_args = child_count - 1
    if !hashmap_method_has_arity(clone(method_name), explicit_args) {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let key_ty = contract_type_access::TypeInfo_type_arg_at(recv_ty, 0)
    let value_ty = contract_type_access::TypeInfo_type_arg_at(recv_ty, 1)
    // The capacity / bulk-maintenance surface is implemented over the flat
    // i32 store. Reject the other pairs (and unresolved type parameters)
    // before argument unification can produce a misleading mismatch, so a
    // call can never be lowered over the String / fn bucket layout.
    if hashmap_method_needs_flat_store(clone(method_name)) &&
    !hashmap_pair_is_flat_store(key_ty, value_ty) {
        hashmap_report_unavailable(env, String_from("method"), method_name, key_ty, value_ty)
        return hashmap_method_return_type(clone(method_name), key_ty, value_ty)
    }
    if eq(clone(method_name), String_from("extend")) {
        // `extend` takes another map, not a key: unify the argument with the
        // receiver's pair so the previous key-typed default does not report
        // `i32` vs `HashMap<...>` for the shell body (#917).
        unify_hashmap_method_arg(env, scope, fn_sigs, enum_defs, node, 1, recv_ty)
    } else if explicit_args == 1 {
        unify_hashmap_method_arg(env, scope, fn_sigs, enum_defs, node, 1, key_ty)
    } else if explicit_args == 2 {
        unify_hashmap_method_arg(env, scope, fn_sigs, enum_defs, node, 1, key_ty)
        unify_hashmap_method_arg(env, scope, fn_sigs, enum_defs, node, 2, value_ty)
    }
    if !hashmap_api::validate_hashmap_method(env, String_from("HashMap::").concat(method_name), recv_ty) {
        return hashmap_method_return_type(clone(method_name), key_ty, value_ty)
    }
    let mut resolved_types = Vec::new<TypeInfo>()
    push(resolved_types, key_ty)
    push(resolved_types, value_ty)
    let mono_name = String_from("HashMap::").concat(method_name)
    let mangled_name = mono::record_mono_instance(env, clone(mono_name), resolved_types)
    mono::record_mono_call_site(env, ast_access::node_span_start(node), mono_name, mangled_name)
    hashmap_method_return_type(method_name, key_ty, value_ty)
}

fn hashmap_report_unavailable(
    mut env: TypeEnv,
    kind: String,
    method_name: String,
    key_ty: TypeInfo,
    value_ty: TypeInfo
) {
    let pair = String_from("HashMap<").concat(
        hashmap_type_name(key_ty).concat(
            String_from(", ").concat(hashmap_type_name(value_ty).concat(String_from(">")))
        )
    )
    let head = kind.concat(String_from(" `").concat(method_name.concat(String_from("` is not available on `"))))
    let capacity_group = String_from("(`with_capacity`, `capacity`, `reserve`, `try_reserve`, ").concat(
        String_from("`shrink_to_fit`, `clear`, `drain`, `remove_entry`, `extend`)")
    )
    let available_methods = String_from("`len`, `is_empty`, `insert`, `get`, `contains_key`, ").concat(
        String_from("`remove`, `keys`, `values`, and `entries`")
    )
    let message = head.concat(
        pair.concat(
            String_from("`; the capacity/bulk group ").concat(capacity_group).concat(
                String_from(" is implemented only for the flat `HashMap<i32, i32>` store; ")
            ).concat(String_from("this pair supports ").concat(available_methods).concat(String_from(".")))
        )
    )
    // Speculative inference can visit the same call node more than once;
    // report the family rejection once per environment.
    let mut seen = false
    let mut index = 0
    while index < len(env.errors) {
        if eq(get_unchecked(env.errors, index), clone(message)) {
            seen = true
        }
        index = index + 1
    }
    if !seen {
        unify::type_error(env, message)
    }
}

fn hashmap_pair_is_flat_store(key_ty: TypeInfo, value_ty: TypeInfo) -> bool {
    contract_type_access::TypeInfo_tag(key_ty) == commands::TY_I32() &&
    contract_type_access::TypeInfo_tag(value_ty) == commands::TY_I32()
}

fn hashmap_method_needs_flat_store(method_name: String) -> bool {
    eq(clone(method_name), String_from("capacity")) ||
    eq(clone(method_name), String_from("reserve")) ||
    eq(clone(method_name), String_from("try_reserve")) ||
    eq(clone(method_name), String_from("shrink_to_fit")) ||
    eq(clone(method_name), String_from("clear")) ||
    eq(clone(method_name), String_from("drain")) ||
    eq(clone(method_name), String_from("remove_entry")) ||
    eq(clone(method_name), String_from("extend"))
}

fn hashmap_type(key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    let mut hm = contract_type_constructors::TypeInfo_simple(commands::TY_HASHMAP())
    contract_type_mutation::TypeInfo_push_type_arg(hm, key_ty)
    contract_type_mutation::TypeInfo_push_type_arg(hm, value_ty)
    hm
}

fn hashmap_method_has_arity(method_name: String, explicit_args: i32) -> bool {
    if explicit_args == 0 {
        return eq(clone(method_name), String_from("len")) ||
        eq(clone(method_name), String_from("is_empty")) ||
        eq(clone(method_name), String_from("keys")) ||
        eq(clone(method_name), String_from("values")) ||
        eq(clone(method_name), String_from("entries")) ||
        eq(clone(method_name), String_from("capacity")) ||
        eq(clone(method_name), String_from("shrink_to_fit")) ||
        eq(clone(method_name), String_from("clear")) ||
        eq(clone(method_name), String_from("drain"))
    }
    if explicit_args == 1 {
        return eq(clone(method_name), String_from("get")) ||
        eq(clone(method_name), String_from("contains_key")) ||
        eq(clone(method_name), String_from("remove")) ||
        eq(clone(method_name), String_from("reserve")) ||
        eq(clone(method_name), String_from("try_reserve")) ||
        eq(clone(method_name), String_from("remove_entry")) ||
        eq(clone(method_name), String_from("extend"))
    }
    if explicit_args == 2 {
        return eq(clone(method_name), String_from("insert"))
    }
    false
}

fn unify_hashmap_method_arg(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    child_idx: i32,
    expected_ty: TypeInfo
) {
    let arg_node = ast_access::node_child_at(node, child_idx)
    let arg_ty = infer_expr(env, scope, fn_sigs, enum_defs, arg_node)
    unify::unify(env, expected_ty, arg_ty)
}

fn hashmap_method_return_type(method_name: String, key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    if eq(clone(method_name), String_from("keys")) {
        return hashmap_vec_type(key_ty)
    }
    if eq(clone(method_name), String_from("values")) {
        return hashmap_vec_type(value_ty)
    }
    if eq(clone(method_name), String_from("entries")) ||
    eq(clone(method_name), String_from("drain")) {
        return hashmap_vec_type(hashmap_pair_type(key_ty, value_ty))
    }
    if eq(clone(method_name), String_from("remove_entry")) {
        let mut option = contract_type_constructors::TypeInfo_simple(commands::TY_OPTION())
        contract_type_mutation::TypeInfo_push_type_arg(option, hashmap_pair_type(key_ty, value_ty))
        return option
    }
    if eq(clone(method_name), String_from("contains_key")) ||
    eq(clone(method_name), String_from("is_empty")) ||
    eq(clone(method_name), String_from("try_reserve")) {
        return contract_type_constructors::TypeInfo_simple(commands::TY_BOOL())
    }
    if eq(clone(method_name), String_from("len")) ||
    eq(clone(method_name), String_from("capacity")) {
        return contract_type_constructors::TypeInfo_simple(commands::TY_I32())
    }
    if eq(clone(method_name), String_from("reserve")) ||
    eq(clone(method_name), String_from("shrink_to_fit")) ||
    eq(clone(method_name), String_from("clear")) ||
    eq(clone(method_name), String_from("extend")) {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNIT())
    }
    let mut option = contract_type_constructors::TypeInfo_simple(commands::TY_OPTION())
    contract_type_mutation::TypeInfo_push_type_arg(option, value_ty)
    option
}

fn hashmap_pair_type(key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    let mut pair = contract_type_constructors::TypeInfo_simple(commands::TY_TUPLE())
    contract_type_mutation::TypeInfo_push_type_arg(pair, key_ty)
    contract_type_mutation::TypeInfo_push_type_arg(pair, value_ty)
    pair
}

fn hashmap_vec_type(element_ty: TypeInfo) -> TypeInfo {
    let mut vec_ty = contract_type_constructors::TypeInfo_simple(commands::TY_VEC())
    contract_type_mutation::TypeInfo_push_type_arg(vec_ty, element_ty)
    vec_ty
}
