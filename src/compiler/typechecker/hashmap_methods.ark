use std::text
use typechecker::ast_access
use typechecker::contract_type_access
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::hashmap_api
use typechecker::mono
use typechecker::types
use typechecker::unify
fn infer_hashmap_constructor_call(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    callee: AstNode
) -> TypeInfo {
    let callee_name = ast_access::node_text(callee)
    let is_new = callee_name.clone().eq(String_from("HashMap::new"))
    let is_with_capacity = callee_name.clone().eq(String_from("HashMap::with_capacity"))
    if !is_new && !is_with_capacity {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let type_arg_count = ast_access::node_child_count(callee) - 1
    if type_arg_count != 2 {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    // Resolve through the enclosing function's type parameters so the shell
    // bodies `HashMap::new<K, V>()` / `HashMap::with_capacity<K, V>(cap)`
    // produce `HashMap<K, V>` instead of anonymous struct placeholders.
    let type_params = env.current_fn_type_params.clone()
    let key_ty = types::resolve_type_ann_node_generic(ast_access::node_child_at(callee, 1), type_params.clone())
    let value_ty = types::resolve_type_ann_node_generic(ast_access::node_child_at(callee, 2), type_params)
    let mut resolved_types = Vec::new<TypeInfo>()
    resolved_types.push(key_ty)
    resolved_types.push(value_ty)
    let result_ty = hashmap_type(key_ty, value_ty)
    if !hashmap_api::validate_hashmap_constructor(env, callee_name.clone(), resolved_types) {
        return result_ty
    }
    if is_with_capacity {
        if ast_access::node_child_count(node) != 2 {
            return result_ty
        }
        unify_hashmap_method_arg(
            env,
            scope,
            fn_sigs,
            enum_defs,
            node,
            1,
            contract_type_constructors::TypeInfo_simple(commands::TY_I32())
        )
    }
    // Record the concrete instance for both constructors, matching
    // `HashMap::new`. The MIR constructor rewrite owns the emitted callee:
    // the typed `HashMap__with_capacity__<pair>` spelling selects the
    // per-pair store. `with_capacity` has no generic shell declaration (the
    // pinned bootstrap must still typecheck this module), so its worklist
    // entry comes from the constructor spelling in `edge_collect_calls`
    // rather than from an instantiated shell body.
    let mangled_name = mono::record_mono_instance(env, callee_name.clone(), resolved_types)
    mono::record_mono_call_site(
        env,
        ast_access::node_span_start(node),
        callee_name.clone(),
        mangled_name
    )
    result_ty
}

fn infer_builtin_hashmap_method(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    recv_ty: TypeInfo,
    method_name: String,
    child_count: i32
) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(recv_ty) != commands::TY_HASHMAP() {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    if contract_type_access::TypeInfo_type_arg_count(recv_ty) < 2 {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let explicit_args = child_count - 1
    if !hashmap_method_has_arity(method_name.clone(), explicit_args) {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let key_ty = contract_type_access::TypeInfo_type_arg_at(recv_ty, 0)
    let value_ty = contract_type_access::TypeInfo_type_arg_at(recv_ty, 1)
    let is_reserve = method_name.clone().eq(String_from("reserve")) ||
    method_name.clone().eq(String_from("try_reserve"))
    if method_name.clone().eq(String_from("extend")) {
        // `extend` takes another map, not a key: unify the argument with the
        // receiver's pair so the previous key-typed default does not report
        // `i32` vs `HashMap<...>` for the shell body (#917).
        unify_hashmap_method_arg(env, scope, fn_sigs, enum_defs, node, 1, recv_ty)
    } else if method_name.clone().eq(String_from("retain")) {
        // The predicate is `fn(K, V) -> bool`, not a key value. Unifying with
        // `key_ty` would report `i32 vs fn(...)` for String-keyed maps.
        unify_hashmap_method_arg(
            env,
            scope,
            fn_sigs,
            enum_defs,
            node,
            1,
            hashmap_predicate_type(key_ty, value_ty)
        )
    } else if is_reserve {
        // Both take an entry count, not a key. Unifying with `key_ty` worked
        // only while every pair was i32-keyed; a String key would bind the
        // count against `String` (#917).
        unify_hashmap_method_arg(
            env,
            scope,
            fn_sigs,
            enum_defs,
            node,
            1,
            contract_type_constructors::TypeInfo_simple(commands::TY_I32())
        )
    } else if explicit_args == 1 {
        unify_hashmap_method_arg(env, scope, fn_sigs, enum_defs, node, 1, key_ty)
    } else if explicit_args == 2 {
        unify_hashmap_method_arg(env, scope, fn_sigs, enum_defs, node, 1, key_ty)
        unify_hashmap_method_arg(env, scope, fn_sigs, enum_defs, node, 2, value_ty)
    }
    if !hashmap_api::validate_hashmap_method(env, String_from("HashMap::").concat(method_name), recv_ty) {
        return hashmap_method_return_type(method_name.clone(), key_ty, value_ty)
    }
    let mut resolved_types = Vec::new<TypeInfo>()
    resolved_types.push(key_ty)
    resolved_types.push(value_ty)
    let mono_name = String_from("HashMap::").concat(method_name)
    let mangled_name = mono::record_mono_instance(env, mono_name.clone(), resolved_types)
    mono::record_mono_call_site(env, ast_access::node_span_start(node), mono_name, mangled_name)
    hashmap_method_return_type(method_name, key_ty, value_ty)
}

fn hashmap_type(key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    let mut hm = contract_type_constructors::TypeInfo_simple(commands::TY_HASHMAP())
    contract_type_mutation::TypeInfo_push_type_arg(hm, key_ty)
    contract_type_mutation::TypeInfo_push_type_arg(hm, value_ty)
    hm
}

fn hashmap_method_has_arity(method_name: String, explicit_args: i32) -> bool {
    if explicit_args == 0 {
        return method_name.clone().eq(String_from("len")) ||
        method_name.clone().eq(String_from("is_empty")) ||
        method_name.clone().eq(String_from("keys")) ||
        method_name.clone().eq(String_from("values")) ||
        method_name.clone().eq(String_from("entries")) ||
        method_name.clone().eq(String_from("iter")) ||
        method_name.clone().eq(String_from("capacity")) ||
        method_name.clone().eq(String_from("shrink_to_fit")) ||
        method_name.clone().eq(String_from("clear")) ||
        method_name.clone().eq(String_from("drain"))
    }
    if explicit_args == 1 {
        return method_name.clone().eq(String_from("get")) ||
        method_name.clone().eq(String_from("contains_key")) ||
        method_name.clone().eq(String_from("remove")) ||
        method_name.clone().eq(String_from("reserve")) ||
        method_name.clone().eq(String_from("try_reserve")) ||
        method_name.clone().eq(String_from("remove_entry")) ||
        method_name.clone().eq(String_from("entry")) ||
        method_name.clone().eq(String_from("retain")) ||
        method_name.clone().eq(String_from("extend"))
    }
    if explicit_args == 2 {
        return method_name.clone().eq(String_from("insert"))
    }
    false
}

fn unify_hashmap_method_arg(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    child_idx: i32,
    expected_ty: TypeInfo
) {
    let arg_node = ast_access::node_child_at(node, child_idx)
    let arg_ty = infer_expr(env, scope, fn_sigs, enum_defs, arg_node)
    unify::unify(env, expected_ty, arg_ty)
}

fn hashmap_method_return_type(method_name: String, key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    if method_name.clone().eq(String_from("iter")) {
        return hashmap_iterator_type(key_ty, value_ty)
    }
    if method_name.clone().eq(String_from("entry")) {
        return hashmap_entry_type(key_ty, value_ty)
    }
    if method_name.clone().eq(String_from("keys")) {
        return hashmap_vec_type(key_ty)
    }
    if method_name.clone().eq(String_from("values")) {
        return hashmap_vec_type(value_ty)
    }
    if method_name.clone().eq(String_from("entries")) ||
    method_name.clone().eq(String_from("drain")) {
        return hashmap_vec_type(hashmap_pair_type(key_ty, value_ty))
    }
    if method_name.clone().eq(String_from("remove_entry")) {
        let mut option = contract_type_constructors::TypeInfo_simple(commands::TY_OPTION())
        contract_type_mutation::TypeInfo_push_type_arg(option, hashmap_pair_type(key_ty, value_ty))
        return option
    }
    if method_name.clone().eq(String_from("contains_key")) ||
    method_name.clone().eq(String_from("is_empty")) ||
    method_name.clone().eq(String_from("try_reserve")) {
        return contract_type_constructors::TypeInfo_simple(commands::TY_BOOL())
    }
    if method_name.clone().eq(String_from("len")) ||
    method_name.clone().eq(String_from("capacity")) {
        return contract_type_constructors::TypeInfo_simple(commands::TY_I32())
    }
    if method_name.clone().eq(String_from("reserve")) ||
    method_name.clone().eq(String_from("shrink_to_fit")) ||
    method_name.clone().eq(String_from("clear")) ||
    method_name.clone().eq(String_from("extend")) ||
    method_name.clone().eq(String_from("retain")) {
        return contract_type_constructors::TypeInfo_simple(commands::TY_UNIT())
    }
    let mut option = contract_type_constructors::TypeInfo_simple(commands::TY_OPTION())
    contract_type_mutation::TypeInfo_push_type_arg(option, value_ty)
    option
}

fn hashmap_predicate_type(key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    let mut predicate = contract_type_constructors::TypeInfo_simple(commands::TY_FN())
    contract_type_mutation::TypeInfo_push_type_arg(
        predicate,
        hashmap_pair_type(key_ty, value_ty)
    )
    let is_mut = false
    contract_type_mutation::TypeInfo_push_param_mode(predicate, is_mut)
    contract_type_mutation::TypeInfo_push_type_arg(
        predicate,
        contract_type_constructors::TypeInfo_simple(commands::TY_BOOL())
    )
    predicate
}

fn hashmap_iterator_type(key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    let mut iter_ty = contract_type_constructors::TypeInfo_named(
        commands::TY_STRUCT(),
        String_from("HashMapIter")
    )
    contract_type_mutation::TypeInfo_push_type_arg(iter_ty, key_ty)
    contract_type_mutation::TypeInfo_push_type_arg(iter_ty, value_ty)
    iter_ty
}

fn hashmap_entry_type(key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    let mut entry_ty = contract_type_constructors::TypeInfo_named(
        commands::TY_STRUCT(),
        String_from("Entry")
    )
    contract_type_mutation::TypeInfo_push_type_arg(entry_ty, key_ty)
    contract_type_mutation::TypeInfo_push_type_arg(entry_ty, value_ty)
    entry_ty
}

fn hashmap_pair_type(key_ty: TypeInfo, value_ty: TypeInfo) -> TypeInfo {
    let mut pair = contract_type_constructors::TypeInfo_simple(commands::TY_TUPLE())
    contract_type_mutation::TypeInfo_push_type_arg(pair, key_ty)
    contract_type_mutation::TypeInfo_push_type_arg(pair, value_ty)
    pair
}

fn hashmap_vec_type(element_ty: TypeInfo) -> TypeInfo {
    let mut vec_ty = contract_type_constructors::TypeInfo_simple(commands::TY_VEC())
    contract_type_mutation::TypeInfo_push_type_arg(vec_ty, element_ty)
    vec_ty
}
