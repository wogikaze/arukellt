struct TypeInfo {
    tag: i32,
    name: String,
    type_args: Vec<TypeInfo>,
    // TY_FN parameter modes; see corehir::type_contracts::TypeInfo. The flat
    // selfhost overlay carries both definitions, so the field order matches.
    param_modes: Vec<bool>,
}

fn TypeInfo_new(tag: i32, name: String, type_args: Vec<TypeInfo>) -> TypeInfo {
    TypeInfo {
        tag: tag,
        name: name,
        type_args: type_args,
        param_modes: Vec::new<bool>()
    }
}

fn type_info_tag(ty: TypeInfo) -> i32 {
    ty.tag
}

fn type_info_name(ty: TypeInfo) -> String {
    ty.name.clone()
}

fn type_info_set_name(mut ty: TypeInfo, name: String) {
    ty.name = name
}

fn type_info_type_arg_count(ty: TypeInfo) -> i32 {
    ty.type_args.len()
}

fn type_info_type_arg_at(ty: TypeInfo, index: i32) -> TypeInfo {
    ty.type_args.get_unchecked(index)
}

fn type_info_push_type_arg(mut ty: TypeInfo, arg: TypeInfo) {
    push(ty.type_args, arg)
}

fn type_info_param_mode_count(ty: TypeInfo) -> i32 {
    ty.param_modes.len()
}

fn type_info_param_is_mut(ty: TypeInfo, index: i32) -> bool {
    if index < 0 || index >= ty.param_modes.len() {
        return false
    }
    ty.param_modes.get_unchecked(index)
}

fn type_info_push_param_mode(mut ty: TypeInfo, is_mut: bool) {
    push(ty.param_modes, is_mut)
}
