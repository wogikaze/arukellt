use typechecker::name_compare
use typechecker::name_display
use typechecker::name_tags
fn type_tag_name(tag: i32) -> String {
    name_tags::type_tag_name(tag)
}

fn type_display_name(ty: TypeInfo) -> String {
    name_display::type_display_name(ty)
}

fn same_named_type(a: TypeInfo, b: TypeInfo) -> bool {
    name_compare::same_named_type(a, b)
}

fn same_nominal_type(a: TypeInfo, b: TypeInfo) -> bool {
    name_compare::same_nominal_type(a, b)
}

fn same_type_name(left: String, right: String) -> bool {
    name_compare::same_type_name(left, right)
}

// Impl methods register under the unqualified owner name (Reverse::cmp),
// while receiver types keep their import path (cmp::Reverse). Reduce a
// possibly module-qualified type name to its last :: segment so method
// lookup and mono instance naming agree with the registered signature.
fn unqualified_type_name(name: String) -> String {
    let n = name.len()
    let mut i = n - 2
    while i >= 0 {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            return name.slice(i + 2, n)
        }
        i = i - 1
    }
    name
}

// Module prefix of a qualified nominal spelling (`beta::Counter` -> `beta`),
// or "" for a bare name. Impl methods are keyed by `module::Owner::method`, so
// a receiver that kept its import path can name the declaring module instead
// of relying on the flat owner alias.
fn module_prefix(name: String) -> String {
    let n = name.len()
    let mut i = n - 2
    while i >= 0 {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            return name.slice(0, i)
        }
        i = i - 1
    }
    String_new()
}
