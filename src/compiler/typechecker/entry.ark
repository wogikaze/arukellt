use std::prelude::{clone}
use std::text
use typechecker::body
use typechecker::ast_decl_predicates
use typechecker::ast_access
use typechecker::contract_result_state
use typechecker::context
use typechecker::module
use typechecker::module_env_merge
use typechecker::module_fns
use typechecker::module_wit
use typechecker::contract_fn_sig
use collections::name_index
use resolver::ctx_record
use resolver::modules

// Index keys parallel to `collect_fn_sigs` output: a module-owned fn or
// const decl earns a `mod::name` key so qualified calls hit the signature
// of the module the resolver accepted, while impl methods and entry-module
// decls stay bare-only. `combine_loaded_and_main_decls` lists each loaded
// module's decls before the entry module's, so one decl cursor tracks the
// module boundaries.
fn sig_qualified_keys(decls: Vec<AstNode>, modules: Vec<ModuleDecls>) -> Vec<String> {
    let keys = Vec::new<String>()
    let decl_count = len(decls)
    let mut pos = 0
    let module_count = len(modules)
    let mut mi = 0
    while mi < module_count && pos < decl_count {
        let m = get_unchecked(modules, mi)
        let mname = modules::module_name(m)
        let mdcount = modules::module_decl_count(m)
        let mut dk = 0
        while dk < mdcount && pos < decl_count {
            push_sig_index_key(keys, get_unchecked(decls, pos), clone(mname))
            pos = pos + 1
            dk = dk + 1
        }
        mi = mi + 1
    }
    while pos < decl_count {
        push_sig_index_key(keys, get_unchecked(decls, pos), String_new())
        pos = pos + 1
    }
    keys
}

fn push_sig_index_key(keys: Vec<String>, decl: AstNode, module_name: String) {
    if ast_decl_predicates::node_is_fn_decl(decl) || ast_decl_predicates::node_is_const_decl(decl) {
        if len(module_name) == 0 {
            push(keys, String_new())
        } else {
            push(keys, text::concat(module_name, text::concat(String_from("::"), ast_access::node_text(decl))))
        }
        return
    }
    if ast_decl_predicates::node_is_impl_decl(decl) {
        let child_count = ast_access::node_child_count(decl)
        let mut ci = 0
        while ci < child_count {
            if ast_decl_predicates::node_is_fn_decl(ast_access::node_child_at(decl, ci)) {
                push(keys, String_new())
            }
            ci = ci + 1
        }
    }
}

fn build_fn_sig_index(fn_sigs: Vec<FnSig>, qualified_keys: Vec<String>) -> NameIndex {
    let count = len(fn_sigs)
    let index = name_index::NameIndex_new(count)
    let mut i = 0
    // combine_loaded_and_main_decls lists loaded modules before the entry
    // module, and name_index_insert_first keeps the first writer. A plain
    // in-order pass therefore lets an imported decl permanently claim the
    // bare-name slot over a same-named decl in the entry module itself:
    // `use std::test` pulls in std::core::identity(i32) and a local generic
    // `fn identity<T>` could never be found by unqualified calls, which
    // bound the concrete i32 sig and skipped mono-instance minting (#914).
    // Give entry-module GENERIC decls (empty qualified key, type params)
    // first claim on their bare names: a generic call can never resolve
    // to the imported concrete sig anyway, so that slot was dead weight.
    // Concrete entry decls keep the existing imported-first order so
    // std-internal calls to colliding names are not re-bound.
    while i < count {
        if i < len(qualified_keys) && len(get_unchecked(qualified_keys, i)) == 0 {
            let own_sig = get_unchecked(fn_sigs, i)
            if contract_fn_sig::FnSig_type_param_count(own_sig) > 0 {
                name_index::name_index_insert_first(index, contract_fn_sig::FnSig_name(own_sig), i)
            }
        }
        i = i + 1
    }
    i = 0
    while i < count {
        let sig = get_unchecked(fn_sigs, i)
        if i < len(qualified_keys) {
            let qname = get_unchecked(qualified_keys, i)
            if len(qname) > 0 {
                name_index::name_index_insert_first(index, qname, i)
            }
        }
        name_index::name_index_insert_first(index, contract_fn_sig::FnSig_name(sig), i)
        i = i + 1
    }
    index
}

fn typecheck_module(decls: Vec<AstNode>, resolve_ctx: ResolveCtx, wit_paths: Vec<String>) -> TypeCheckResult {
    let result = contract_result_state::TypeCheckResult_new()
    let mut env = context::TypeEnv_new()
    contract_result_state::typecheck_result_set_errors(result, ctx_record::resolve_ctx_errors(resolve_ctx))
    let decl_count = len(decls)
    module::register_trait_impl_decls(env, decls)
    module::register_struct_decls(env, decls)
    let fn_sigs = module_wit::merge_fn_sigs(module::collect_fn_sigs(decls, env), module_wit::collect_wit_fn_sigs(wit_paths, decls))
    env.fn_sig_index = build_fn_sig_index(fn_sigs, sig_qualified_keys(decls, ctx_record::resolve_ctx_modules(resolve_ctx)))
    let enum_defs = module_wit::merge_enum_defs(module::collect_enum_defs(decls), module_wit::collect_wit_enum_defs(wit_paths, decls))
    let mut i = 0
    while i < decl_count {
        let node = get_unchecked(decls, i)
        if ast_decl_predicates::node_is_fn_decl(node) {
            module::append_typed_fn(result, node)
            let fn_env = module_env_merge::type_env_for_fn_check(env)
            body::check_fn_body(fn_env, fn_sigs, enum_defs, node)
            module_env_merge::merge_type_env(env, fn_env)
        }
        if ast_decl_predicates::node_is_const_decl(node) {
            module::append_typed_fn(result, node)
            let fn_env = module_env_merge::type_env_for_fn_check(env)
            body::check_fn_body(fn_env, fn_sigs, enum_defs, node)
            module_env_merge::merge_type_env(env, fn_env)
        }
        if ast_decl_predicates::node_is_impl_decl(node) {
            check_impl_methods(env, fn_sigs, enum_defs, node)
        }
        if ast_decl_predicates::node_is_test_decl(node) || ast_decl_predicates::node_is_test_mod(node) {
            body::check_test_body(env, fn_sigs, enum_defs, node)
        }
        i = i + 1
    }
    module::append_env_errors(result, env)
    contract_result_state::typecheck_result_set_mono_instances(result, context::TypeEnv_mono_instances(env))
    result
}

fn check_impl_methods(env: TypeEnv, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) {
    let impl_child_count = ast_access::node_child_count(node)
    let mut ic = 0
    while ic < impl_child_count {
        let meth = ast_access::node_child_at(node, ic)
        if ast_decl_predicates::node_is_fn_decl(meth) {
            let meth_env = module_env_merge::type_env_for_fn_check(env)
            let method_sig = module_fns::impl_method_sig(env, node, meth)
            body::check_fn_body_with_sig(meth_env, fn_sigs, enum_defs, meth, method_sig)
            module_env_merge::merge_type_env(env, meth_env)
        }
        ic = ic + 1
    }
}
