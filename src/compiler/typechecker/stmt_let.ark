use typechecker::kinds
use diagnostics::codes
use typechecker::ast_access
use typechecker::ast_expr_predicates
use typechecker::contract_env_record
use typechecker::contract_type_access
use typechecker::scope
use typechecker::types
use typechecker::unify
use typechecker::ownership
use typechecker::ownership_types
use typechecker::closure_capture
use typechecker::sigs
use typechecker::param_mode
use diagnostics::mod as diag_mod
use diagnostics::record as diag_record
// A bare top-level function name infers TY_UNKNOWN (it is not a scope
// binding), so `let f: fn(mut T) -> U = f_name` has no function type to
// compare against the annotation. Recover it from the signature index; const
// declarations share the nullary fn-sig shape but are values, not functions.
fn fn_type_of_initializer(env: TypeEnv, fn_sigs: Vec<FnSig>, bind_ty: TypeInfo, node: AstNode) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(bind_ty) == commands::TY_FN() {
        return bind_ty
    }
    if ast_access::node_child_count(node) < 1 {
        return bind_ty
    }
    let init = ast_access::node_child_at(node, 0)
    if !ast_expr_predicates::node_is_ident(init) && !ast_expr_predicates::node_is_path(init) {
        return bind_ty
    }
    let name = ast_access::node_text(init)
    if contract_env_record::type_env_is_const_name(env, name.clone()) {
        return bind_ty
    }
    sigs::fn_value_type_from_sig(env, fn_sigs, name)
}

fn check_let_stmt(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) {
    let bind_name = ast_access::node_text(node)
    if bind_name.clone().eq("__tuple_destructure") {
        check_tuple_destructure_let(env, scope, fn_sigs, enum_defs, node)
        return
    }
    let mut bind_ty = TypeInfo_simple(commands::TY_UNKNOWN())
    if ast_access::node_child_count(node) > 0 {
        let init = ast_access::node_child_at(node, 0)
        bind_ty = infer_expr(env, scope, fn_sigs, enum_defs, init)
        check_shared_mut_alias(env, scope, node, init, bind_ty)
        if env.is_ownership_tracking_enabled {
            // Only a literal closure init registers the binding for capture
            // supply. Any other expression that yields a capturing closure —
            // an alias, block, if/match, or aggregate — loses that link, so
            // it is an escape (#872).
            if !ast_access::node_kind_is(init, kinds::NK_CLOSURE()) {
                closure_capture::closure_capture_escape(env, scope, init)
            }
        }
    }
    if ast_access::node_type_ann_count(node) > 0 {
        let ann = ast_access::node_type_ann_at(node, 0)
        // Resolve against the enclosing signature's type parameters so
        // "let inner: Inner<I>" inside a generic body binds I as the
        // type variable, not a nominal struct named "I". The var form is
        // what mono template spellings ("Inner::next__?I") key on.
        let ann_ty = types::resolve_type_ann_node_generic(ann, env.current_fn_type_params)
        if env.is_ownership_tracking_enabled {
            param_mode::check_fn_type_assignment(
                env,
                ann,
                ann_ty,
                fn_type_of_initializer(env, fn_sigs, bind_ty, node),
                "a function with a `mut` parameter cannot be assigned to a shared function type"
            )
        }
        // Comprehension element types are inferred from the source
        // iterator's item, which is reliable enough to stand against
        // the annotation: `let ys: Vec<String> = [x * 2 for x in xs]`
        // over Vec<i32> is a real mismatch that must reach unify,
        // not an annotation-override (#815). Other initializers keep
        // the lenient path because overloaded/weakly-inferred calls
        // (for example Vec::from_iter picking the first impl by name)
        // still produce concrete-but-wrong argument types.
        let init_is_comprehension = ast_access::node_child_count(node) > 0 &&
        ast_expr_predicates::node_is_comprehension(ast_access::node_child_at(node, 0))
        if should_prefer_annotation(bind_ty, ann_ty) && !init_is_comprehension {
            bind_ty = ann_ty
        } else {
            bind_ty = unify::unify(env, bind_ty, ann_ty)
        }
    }
    let mut is_copy = ownership_types::type_is_copy(env, bind_ty)
    if ast_access::node_child_count(node) > 0 {
        is_copy = ownership::expr_is_copy(
            env,
            scope,
            ast_access::node_child_at(node, 0),
            bind_ty
        )
        if env.is_ownership_tracking_enabled {
            ownership::consume_expr(env, scope, ast_access::node_child_at(node, 0))
            // A let binding stores the initializer value. consume_expr covers
            // moves and direct sink calls; the escape walk also catches stores
            // nested in a larger initializer expression (ADR-088 §6).
            ownership::check_borrowed_box_escape(env, scope, ast_access::node_child_at(node, 0))
        }
    }
    if !bind_name.clone().eq("_") {
        let borrow_mode = if ast_access::node_child_count(node) > 0 {
            closure_capture::value_borrow_mode(
                env,
                scope,
                ast_access::node_child_at(node, 0)
            )
        } else {
            0
        }
        if ast_access::node_child_count(node) > 0 &&
        !ast_access::node_is_mut(node) &&
        scope::is_non_expansive_value(scope, ast_access::node_child_at(node, 0)) {
            scope::scope_define_scheme_with_flags(
                scope,
                bind_name,
                scope::generalize(env, scope, bind_ty),
                ast_access::node_is_mut(node),
                is_copy
            )
        } else {
            scope::scope_define_with_flags(scope, bind_name, bind_ty, ast_access::node_is_mut(node), is_copy)
        }
        if env.is_ownership_tracking_enabled && borrow_mode > 0 {
            if closure_capture::value_borrow_is_mutable(borrow_mode) {
                scope::scope_mark_mutable_borrow(scope, bind_name.clone(), true)
            } else {
                scope::scope_mark_shared_borrow(scope, bind_name.clone(), true)
            }
        }
        // A bound closure value keeps its capture-ness so later escape
        // positions (call args, returns, stores) can reject it: borrow
        // captures get the semantic error, move captures the capability
        // diagnostic (#872).
        if env.is_ownership_tracking_enabled &&
        ast_access::node_child_count(node) > 0 &&
        closure_capture::value_has_captures(env, scope, ast_access::node_child_at(node, 0)) {
            scope::scope_mark_has_captures(scope, bind_name.clone(), true)
            if closure_capture::value_has_borrow_captures(env, scope, ast_access::node_child_at(node, 0)) {
                scope::scope_mark_has_borrow_captures(scope, bind_name.clone(), true)
            }
        }
        contract_env_record::type_env_track_binding(env, bind_name.clone(), ast_access::node_span_start(node), ast_access::node_span_end(node))
    }
}

fn check_tuple_destructure_let(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) {
    if ast_access::node_child_count(node) < 2 {
        return
    }
    let pat = ast_access::node_child_at(node, 0)
    let init = ast_access::node_child_at(node, 1)
    let bind_ty = infer_expr(env, scope, fn_sigs, enum_defs, init)
    check_shared_mut_alias(env, scope, node, init, bind_ty)
    if env.is_ownership_tracking_enabled {
        closure_capture::closure_capture_escape(env, scope, init)
        ownership::consume_expr(env, scope, init)
        ownership::check_borrowed_box_escape(env, scope, init)
    }
    bind_tuple_pat_identifiers(env, scope, pat, bind_ty)
}

fn bind_tuple_pat_identifiers(env: TypeEnv, mut scope: LocalScope, pat: AstNode, tuple_ty: TypeInfo) {
    if ast_access::node_child_count(pat) == 0 {
        return
    }
    let pat_count = ast_access::node_child_count(pat)
    let mut i = 0
    while i < pat_count {
        let elem = ast_access::node_child_at(pat, i)
        if ast_access::node_kind_is(elem, kinds::NK_PAT_IDENT()) {
            let name = ast_access::node_text(elem)
            if !name.clone().eq("_") {
                let elem_ty = tuple_element_type_at(tuple_ty, i)
                scope::scope_define_with_flags(
                    scope,
                    name,
                    elem_ty,
                    ast_access::node_is_mut(pat),
                    ownership_types::type_is_copy(env, elem_ty)
                )
            }
        }
        i = i + 1
    }
}

fn tuple_element_type_at(tuple_ty: TypeInfo, index: i32) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(tuple_ty) != commands::TY_TUPLE() {
        return TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let arg_count = contract_type_access::TypeInfo_type_arg_count(tuple_ty)
    if index >= 0 && index < arg_count {
        return contract_type_access::TypeInfo_type_arg_at(tuple_ty, index)
    }
    TypeInfo_simple(commands::TY_UNKNOWN())
}

// W0001: detect `let alias = v` where `v` is `mut` and the type is a reference type.
fn check_shared_mut_alias(mut env: TypeEnv, scope: LocalScope, let_node: AstNode, init: AstNode, bind_ty: TypeInfo) {
    if ast_access::node_is_mut(let_node) {
        return
    }
    if !ast_expr_predicates::node_is_ident(init) {
        return
    }
    if scope::scope_binding_is_copy(scope, ast_access::node_text(init)) {
        return
    }
    if is_reference_type(bind_ty) {
        let msg = "possible unintended sharing of reference type"
        let span = diag_record::DiagnosticSpan_from_raw(ast_access::node_span_start(init), ast_access::node_span_end(init))
        let warn = diag_mod::Diagnostic_new(codes::DIAG_WARN_SHARED_MUT_ALIAS(), diag_mod::SEV_WARNING(), span, msg)
        push(env.warnings, warn)
    }
}

fn is_reference_type(ty: TypeInfo) -> bool {
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == commands::TY_VEC() {
        return true
    }
    if tag == commands::TY_STRING() {
        return true
    }
    if tag == commands::TY_STRUCT() {
        return true
    }
    if tag == commands::TY_ENUM() {
        return true
    }
    if tag == commands::TY_RESOURCE() {
        return true
    }
    false
}

fn should_prefer_annotation(init_ty: TypeInfo, ann_ty: TypeInfo) -> bool {
    let init_tag = contract_type_access::TypeInfo_tag(init_ty)
    let ann_tag = contract_type_access::TypeInfo_tag(ann_ty)
    if init_tag != ann_tag {
        // A declaration resolves as TY_STRUCT or TY_ENUM depending on which
        // registry named it first, so the same nominal type can disagree
        // here. Treat that pair as one kind: `let w: Wrap<i32> = Wrap::None`
        // must keep the annotated instantiation instead of the bare enum the
        // unit-variant constructor carries (a generic caller needs the args).
        let nominal_pair = (init_tag == commands::TY_STRUCT() && ann_tag == commands::TY_ENUM()) ||
        (init_tag == commands::TY_ENUM() && ann_tag == commands::TY_STRUCT())
        if !nominal_pair {
            return false
        }
    }
    if init_tag != commands::TY_VEC() && init_tag != commands::TY_OPTION() && init_tag != commands::TY_ENUM() && init_tag != commands::TY_STRUCT() {
        return false
    }
    let init_args = contract_type_access::TypeInfo_type_arg_count(init_ty)
    let ann_args = contract_type_access::TypeInfo_type_arg_count(ann_ty)
    if init_args == 0 && ann_args > 0 {
        return true
    }
    if init_args > 0 && ann_args > 0 && init_args == ann_args {
        let mut k = 0
        while k < init_args {
            let ia = contract_type_access::TypeInfo_type_arg_at(init_ty, k)
            let aa = contract_type_access::TypeInfo_type_arg_at(ann_ty, k)
            let ia_tag = contract_type_access::TypeInfo_tag(ia)
            let aa_tag = contract_type_access::TypeInfo_tag(aa)
            if ia_tag != aa_tag {
                return true
            }
            k = k + 1
        }
    }
    false
}
