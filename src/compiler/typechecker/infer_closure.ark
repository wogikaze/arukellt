use typechecker::kinds
use typechecker::ast_access
use typechecker::ownership_types
use typechecker::scope
use typechecker::unify
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::closure_capture
use typechecker::types
fn infer_closure_expr(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    let mut closure_scope = scope::scope_child(scope)
    let child_count = ast_access::node_child_count(node)
    if child_count == 0 {
        return TypeInfo_simple(commands::TY_FN())
    }
    let mut param_types = Vec::new<TypeInfo>()
    let mut param_modes = Vec::new<bool>()
    let mut i = 0
    while i + 1 < child_count {
        let param = ast_access::node_child_at(node, i)
        let param_ty = if ast_access::node_type_ann_count(param) > 0 {
            types::resolve_type_ann_node(ast_access::node_type_ann_at(param, 0))
        } else {
            unify::fresh_var(env)
        }
        param_types.push(param_ty)
        param_modes.push(ast_access::node_is_mut(param))
        scope::scope_define_with_flags(
            closure_scope,
            ast_access::node_text(param),
            param_ty,
            ast_access::node_is_mut(param),
            ownership_types::type_is_builtin_copy(param_ty)
        )
        i = i + 1
    }
    let body = ast_access::node_child_at(node, child_count - 1)
    let body_ty = infer_expr(env, closure_scope, fn_sigs, enum_defs, body)
    // Nested closure captures and rebinds of outer places mark the
    // closure_scope copies; fold them back so the enclosing scope sees
    // the same ownership state a first-level capture records (#903).
    if env.is_ownership_tracking_enabled {
        scope::scope_merge_child_marks(scope, closure_scope)
    }
    // The closure result is also the inferred body type, so keep `body_ty`
    // available for the annotated return: moving it into `return_ty` would
    // make the annotation's `unify` argument a use of a moved value.
    let mut return_ty = body_ty.clone()
    let mut annotation_index = 0
    let annotation_count = ast_access::node_type_ann_count(node)
    while annotation_index < annotation_count {
        let annotation = ast_access::node_type_ann_at(node, annotation_index)
        if ast_access::node_text(annotation).eq("__return") {
            if ast_access::node_child_count(annotation) > 0 {
                let declared_ty = types::resolve_type_ann_node(
                    ast_access::node_child_at(annotation, 0)
                )
                return_ty = unify::unify(env, body_ty.clone(), declared_ty)
            }
        }
        annotation_index = annotation_index + 1
    }
    let capture_summary = closure_capture::closure_capture_summary(env, scope, node)
    closure_capture::apply_closure_capture_summary(env, scope, capture_summary)
    let mut fn_ty = contract_type_constructors::TypeInfo_simple(commands::TY_FN())
    let mut param_index = 0
    while param_index < param_types.len() {
        contract_type_mutation::TypeInfo_push_type_arg(
            fn_ty,
            unify::resolve_type_deep(env, get_unchecked(param_types, param_index))
        )
        contract_type_mutation::TypeInfo_push_param_mode(
            fn_ty,
            get_unchecked(param_modes, param_index)
        )
        param_index = param_index + 1
    }
    contract_type_mutation::TypeInfo_push_type_arg(fn_ty, unify::resolve_type_deep(env, return_ty))
    fn_ty
}
