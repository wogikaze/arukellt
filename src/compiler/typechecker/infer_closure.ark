use typechecker::kinds
use typechecker::ast_access
use typechecker::scope
use typechecker::unify
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation

fn infer_closure_expr(env: TypeEnv, scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    let closure_scope = scope::scope_child(scope)
    let child_count = ast_access::node_child_count(node)
    if child_count == 0 {
        return TypeInfo_simple(commands::TY_FN())
    }
    let param_types = Vec::new<TypeInfo>()
    let mut i = 0
    while i + 1 < child_count {
        let param = ast_access::node_child_at(node, i)
        let param_ty = unify::fresh_var(env)
        push(param_types, param_ty)
        scope::scope_define(closure_scope, ast_access::node_text(param), param_ty)
        i = i + 1
    }
    let body = ast_access::node_child_at(node, child_count - 1)
    let body_ty = infer_expr(env, closure_scope, fn_sigs, enum_defs, body)
    let fn_ty = contract_type_constructors::TypeInfo_simple(commands::TY_FN())
    let mut param_index = 0
    while param_index < len(param_types) {
        contract_type_mutation::TypeInfo_push_type_arg(
            fn_ty,
            unify::resolve_type_deep(env, get_unchecked(param_types, param_index))
        )
        param_index = param_index + 1
    }
    contract_type_mutation::TypeInfo_push_type_arg(fn_ty, unify::resolve_type_deep(env, body_ty))
    fn_ty
}
