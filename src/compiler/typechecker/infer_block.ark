use typechecker::kinds
use typechecker::ast_access
use typechecker::closure_capture

fn infer_block_expr(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    let count = ast_access::node_child_count(node)
    let mut i = 0
    while i < count {
        let child = ast_access::node_child_at(node, i)
        if i == count - 1 {
            // A trailing return never reaches check_return_stmt, so its
            // closure-capture escape check would be skipped inside if/match
            // branches. Run it here without changing the inferred type (#872).
            if ast_access::node_kind_is(child, kinds::NK_RETURN()) &&
            ast_access::node_child_count(child) > 0 &&
            env.is_ownership_tracking_enabled {
                closure_capture::closure_capture_escape(env, scope, ast_access::node_child_at(child, 0))
            }
            return infer_expr(env, scope, fn_sigs, enum_defs, child)
        }
        check_stmt(env, scope, fn_sigs, enum_defs, child)
        i = i + 1
    }
    TypeInfo_simple(commands::TY_UNIT())
}
