use std::prelude::{byte_at}
fn typechecker_int_literal_has_64_suffix(raw_text: String, raw_len: i32) -> bool {
    if raw_len >= 3 {
        let last3a = byte_at(raw_text, raw_len - 3)
        let last3b = byte_at(raw_text, raw_len - 2)
        let last3c = byte_at(raw_text, raw_len - 1)
        if (last3a == 105 || last3a == 117) && last3b == 54 && last3c == 52 {
            return true
        }
    }
    false
}

test mod "int_lit_suffix" {
    test "i64_suffix" { assert(typechecker_int_literal_has_64_suffix("123i64", 6)) }
    test "u64_suffix" { assert(typechecker_int_literal_has_64_suffix("7u64", 4)) }
    test "i32_no_suffix" { assert(typechecker_int_literal_has_64_suffix("42", 2) == false) }
    test "i32_suffix_rejected" { assert(typechecker_int_literal_has_64_suffix("5i32", 4) == false) }
    test "short_text_rejected" { assert(typechecker_int_literal_has_64_suffix("64", 2) == false) }
    test "suffix_inside_not_counted" { assert(typechecker_int_literal_has_64_suffix("i642", 4) == false) }
}
