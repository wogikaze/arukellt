use std::text
use corehir::callee_spelling
use resolver::expr_path
use resolver::paths
use typechecker::kinds
use typechecker::ast_expr_predicates
use typechecker::ast_access
use typechecker::call_args
use typechecker::closure_capture
use typechecker::call_generic
use typechecker::call_generic_fn_args
use typechecker::call_method
use typechecker::hashmap_methods
use typechecker::call_unknown
use typechecker::call_vec_ctor
use typechecker::enum_expr
use typechecker::contract_env_record
use typechecker::contract_env_resolved_record
use typechecker::contract_fn_sig
use typechecker::contract_resolved_call
use typechecker::contract_type_access
use typechecker::name_display
use typechecker::names
use typechecker::ownership
use typechecker::param_mode
use typechecker::scope
use typechecker::sig_lookup
use typechecker::sigs
use typechecker::unify
use typechecker::unify_compat
fn infer_call_expr(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    let child_count = ast_access::node_child_count(node)
    if child_count < 1 {
        return TypeInfo_simple(commands::TY_UNKNOWN())
    }
    // Every argument position is an escape for a capturing closure: the
    // callee receives a bare funcref that cannot carry the captures. Check
    // here — before signature resolution — so unresolved and builtin calls
    // are covered the same way (#872). Child 0 is the callee, which is a
    // direct-call position and stays legal.
    if env.is_ownership_tracking_enabled {
        let mut a = 1
        while a < child_count {
            closure_capture::closure_capture_escape(env, scope, ast_access::node_child_at(node, a))
            a = a + 1
        }
    }
    let callee = ast_access::node_child_at(node, 0)
    if !ast_expr_predicates::node_is_ident(callee) && !ast_expr_predicates::node_is_path(callee) {
        call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, child_count - 1)
        return TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let enum_variant_ty = enum_expr::infer_enum_variant_call(enum_defs, callee)
    if contract_type_access::TypeInfo_tag(enum_variant_ty) != commands::TY_UNKNOWN() {
        // Constructing an enum stores every payload value, so a borrowed
        // `Box<T>` parameter cannot appear here (ADR-088 §6).
        if env.is_ownership_tracking_enabled {
            let mut store_arg = 1
            while store_arg < child_count {
                ownership::check_borrowed_box_escape(
                    env,
                    scope,
                    ast_access::node_child_at(node, store_arg)
                )
                store_arg = store_arg + 1
            }
        }
        let arg_types = call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, child_count - 1)
        return enum_expr::instantiate_variant_result(
            env,
            enum_defs,
            callee,
            enum_variant_ty,
            arg_types
        )
    }
    let callee_name = ast_access::node_text(callee)
    let hashmap_ctor_ty = hashmap_methods::infer_hashmap_constructor_call(
        env,
        scope,
        fn_sigs,
        enum_defs,
        node,
        callee
    )
    if contract_type_access::TypeInfo_tag(hashmap_ctor_ty) != commands::TY_UNKNOWN() {
        return hashmap_ctor_ty
    }
    // `clone` is a compiler-provided polymorphic operation. The prelude keeps
    // a String-shaped declaration for compatibility, but typechecking must
    // preserve the argument type for structs, enums, and collection elements.
    if callee_name.clone().eq("clone") && child_count == 2 {
        return infer_expr(
            env,
            scope,
            fn_sigs,
            enum_defs,
            ast_access::node_child_at(node, 1)
        )
    }
    // A function-typed local binding shadows the flat fn_sigs index:
    // a higher-order parameter such as `f: fn(i32) -> i32` is called as
    // `f(x)` inside the body and must resolve to the parameter, not to an
    // imported module function that happens to share the bare name after
    // signature-index flattening.
    if ast_expr_predicates::node_is_ident(callee) {
        let local_fn_ty = scope::scope_lookup_instantiated(env, scope, callee_name.clone())
        if contract_type_access::TypeInfo_tag(local_fn_ty) == commands::TY_FN() {
            return call_unknown::infer_local_function_call(
                env,
                scope,
                fn_sigs,
                enum_defs,
                node,
                local_fn_ty
            )
        }
    }
    let mut mono_fn_name = callee_name.clone()
    let mut sig = sig_lookup::lookup_declared_fn_sig(env, fn_sigs, callee_name.clone())
    if !contract_fn_sig::FnSig_has_name(sig) {
        // Loaded-module bodies are not resolver-processed, so a
        // `module::Type::method` call keeps the module prefix. The signature
        // index registers the impl as `Type::method`; retry the canonical
        // spellings before falling back to the last segment.
        let variants = callee_spelling::callee_spelling_variants(callee_name.clone())
        let mut vi = 0
        while vi < variants.len() {
            let variant = variants.get_unchecked(vi).clone()
            let variant_sig = sig_lookup::lookup_declared_fn_sig(env, fn_sigs, variant.clone())
            if contract_fn_sig::FnSig_has_name(variant_sig) {
                sig = variant_sig
                mono_fn_name = variant
                vi = variants.len()
            } else {
                vi = vi + 1
            }
        }
    }
    if !contract_fn_sig::FnSig_has_name(sig) && !sig_lookup::is_entry_body(env) {
        // Loaded-module bodies are not resolver-processed, so a qualified call
        // can keep a source spelling the index does not key. Stripping to the
        // last segment is the remaining flat fallback; a resolver-processed
        // entry body must not use it (its accepted identity is the whole
        // name), because the last segment is exactly the overload-blind key
        // this issue removes (#934).
        let stripped = tc_strip_module_prefix(callee_name.clone())
        if !stripped.clone().eq(callee_name.clone()) &&
        !expr_path::is_builtin_type_name(paths::path_module_part(callee_name.clone())) {
            let bare_sig = sigs::lookup_fn_sig(env, fn_sigs, stripped.clone())
            if contract_fn_sig::FnSig_has_name(bare_sig) {
                sig = bare_sig
                mono_fn_name = stripped
            }
        }
    }
    if !contract_fn_sig::FnSig_has_name(sig) {
        // A concrete conversion impl is keyed by its source type
        // (`Vec_String::from_iter__VecIter_String`), while the source spelling
        // is the trait's `Vec::from_iter`. Select the declaration whose source
        // parameter the inferred first argument names, before the unresolved
        // call fallback (#934).
        let conversion_name = conversion_impl_candidate(
            env,
            scope,
            fn_sigs,
            enum_defs,
            node,
            callee_name.clone()
        )
        if conversion_name.clone().len() > 0 {
            let conversion_sig = sigs::lookup_fn_sig(env, fn_sigs, conversion_name)
            if contract_fn_sig::FnSig_has_name(conversion_sig) {
                return infer_concrete_call_expr(
                    env,
                    scope,
                    fn_sigs,
                    enum_defs,
                    node,
                    conversion_sig,
                    child_count - 1
                )
            }
        }
        // Vec::new<T>() / with_capacity without inherent-impl sig still need
        // mono sites so bare (unannotated) lets get vec:T (#845).
        if call_vec_ctor::is_vec_associated_ctor_name(callee_name.clone()) {
            let ctor_ty = call_vec_ctor::infer_vec_ctor_turbofish_call(env, node, callee)
            if contract_type_access::TypeInfo_tag(ctor_ty) != commands::TY_UNKNOWN() {
                call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, child_count - 1)
                return ctor_ty
            }
        }
        call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, child_count - 1)
        return call_unknown::infer_unknown_ident_call(env, scope, callee)
    }
    if is_prelude_len_signature(sig.clone()) {
        return infer_prelude_len_call(
            env,
            scope,
            fn_sigs,
            enum_defs,
            node,
            child_count - 1,
            contract_fn_sig::FnSig_name(sig)
        )
    }
    if contract_fn_sig::FnSig_type_param_count(sig) == 0 {
        return infer_concrete_call_expr(env, scope, fn_sigs, enum_defs, node, sig, child_count - 1)
    }
    call_generic::infer_generic_call_expr(env, scope, fn_sigs, enum_defs, node, sig, mono_fn_name)
}

// `len` retired from the user surface in wave/vec-intrinsic-len; `s.len()` /
// `v.len()` own it now. The flat bootstrap overlay still declares the
// signature-only String form so the pinned compiler can lower `.len()` on a
// String receiver, and this path keeps that declaration's receiver-owner
// contract (#936). A user generic `len` has no concrete String parameter and
// keeps the ordinary generic checking path.
fn is_prelude_len_signature(sig: FnSig) -> bool {
    if !eq(contract_fn_sig::FnSig_name(sig.clone()), String_from("len")) {
        return false
    }
    if contract_fn_sig::FnSig_type_param_count(sig.clone()) != 0 {
        return false
    }
    if contract_fn_sig::FnSig_param_count(sig.clone()) != 1 {
        return false
    }
    contract_type_access::TypeInfo_tag(contract_fn_sig::FnSig_param_at(sig, 0)) ==
    commands::TY_STRING()
}

fn infer_prelude_len_call(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    arg_count: i32,
    callee_name: String
) -> TypeInfo {
    if arg_count != 1 {
        unify::type_error_bad_arity(
            env,
            String_from("wrong number of arguments for `len`: expected 1, found ").concat(
                arg_count.to_string()
            )
        )
        call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, arg_count)
        return simple_type(commands::TY_I32())
    }
    let recv_ty = infer_expr(
        env,
        scope,
        fn_sigs,
        enum_defs,
        ast_access::node_child_at(node, 1)
    )
    let tag = contract_type_access::TypeInfo_tag(recv_ty)
    if tag == commands::TY_STRING() || tag == commands::TY_VEC() {
        record_len_owner(env, ast_access::node_span_start(node), callee_name, tag)
        return simple_type(commands::TY_I32())
    }
    // A type variable may still bind to String or Vec later in the same body,
    // so the owner is not decided at the call. Keep the receiver for the body
    // finalizer instead of accepting the call or rejecting it outright (#936).
    if tag == commands::TY_TYPE_VAR() {
        contract_env_resolved_record::type_env_push_deferred_len_receiver(
            env,
            contract_resolved_call::DeferredLenReceiver_new(recv_ty, ast_access::node_span_start(node), callee_name)
        )
        return simple_type(commands::TY_I32())
    }
    // Unresolved after another diagnostic is an error-recovery value, not a
    // receiver owner (#939 owns the general unknown-type rule).
    if tag == commands::TY_UNKNOWN() {
        return simple_type(commands::TY_I32())
    }
    unify::type_error(env, len_receiver_mismatch_message(recv_ty))
    simple_type(commands::TY_I32())
}

// The checker owns the owner decision. Recording it per call site is the
// #933 handoff: MIR lowering binds the owner-qualified FunctionId
// (`String::len` / `Vec::len`) and lets the CoreOp registry resolve it,
// instead of recovering the owner from the receiver's MIR local type.
fn record_len_owner(mut env: TypeEnv, span_start: i32, callee_name: String, tag: i32) {
    let owner = if tag == commands::TY_STRING() {
        String_from("String")
    } else {
        String_from("Vec")
    }
    // `len` has no single declaration identity shared by both receivers: the
    // owner-qualified spelling (`String::len` / `Vec::len`) is the FunctionId
    // the CoreOp registry binds (#936). Record it once the receiver owner is
    // decided so lowering does not recompose it from a type spelling.
    contract_env_resolved_record::type_env_record_resolved_call(
        env,
        span_start,
        callee_name,
        owner.clone(),
        owner.concat(String_from("::len")),
        String_new(),
        0 - 1
    )
}

// A `len` receiver that was still a type variable at its call is resolved
// here, after the whole body has run: a later argument position may have bound
// it to String or Vec. A type parameter of the enclosing body never binds
// during its own check, so an owner that is still undecided is rejected
// instead of letting backend name dispatch pick one (#936).
fn finalize_deferred_len_receivers(mut env: TypeEnv) {
    let count = contract_env_resolved_record::type_env_deferred_len_receiver_count(env)
    let mut i = 0
    while i < count {
        let deferred = contract_env_resolved_record::type_env_deferred_len_receiver_at(env, i)
        let resolved = unify::resolve_type(
            env,
            contract_resolved_call::DeferredLenReceiver_receiver_type(deferred.clone())
        )
        let tag = contract_type_access::TypeInfo_tag(resolved)
        let has_owner = tag == commands::TY_STRING() || tag == commands::TY_VEC()
        let is_recovery = tag == commands::TY_UNKNOWN()
        if has_owner {
            record_len_owner(
                env,
                contract_resolved_call::DeferredLenReceiver_span_start(deferred.clone()),
                contract_resolved_call::DeferredLenReceiver_callee_name(deferred),
                tag
            )
        }
        if !has_owner && !is_recovery {
            if tag == commands::TY_TYPE_VAR() {
                unify::type_error(
                    env,
                    String_from("cannot infer the type of the `len` receiver: argument 1 must be String or Vec<T>")
                )
            } else {
                unify::type_error(env, len_receiver_mismatch_message(resolved))
            }
        }
        i = i + 1
    }
    contract_env_resolved_record::type_env_clear_deferred_len_receivers(env)
}

fn len_receiver_mismatch_message(recv_ty: TypeInfo) -> String {
    String_from("type mismatch in call to `len`: argument 1 has type ").concat(
        names::type_display_name(recv_ty).concat(String_from(", expected String or Vec<T>"))
    )
}

// A concrete conversion impl (`impl FromIterator<VecIter<i32>> for Vec<i32>`)
// carries its source type in the symbol so one associated name can serve every
// element family. The source spelling (`Vec::from_iter`) therefore has no
// single signature; resolve it from the declaration whose source parameter
// the inferred first argument names, never from declaration order (#934).
fn conversion_impl_candidate(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    callee_name: String
) -> String {
    let canonical = callee_spelling::callee_spelling_last_two_segments(callee_name.clone())
    let owner_name = paths::path_module_part(canonical.clone())
    let method_name = paths::path_symbol_part(canonical)
    if owner_name.len() == 0 || !is_conversion_method_name(method_name.clone()) {
        return String_new()
    }
    if ast_access::node_child_count(node) < 2 {
        return String_new()
    }
    let source_ty = infer_expr(
        env,
        scope,
        fn_sigs,
        enum_defs,
        ast_access::node_child_at(node, 1)
    )
    let source_name = call_method::type_name_for_mangling(source_ty)
    if source_name.clone().len() == 0 {
        return String_new()
    }
    let suffix = String_from("::").concat(
        method_name.clone().concat(String_from("__").concat(source_name))
    )
    let mut found = String_new()
    let mut count = 0
    let mut i = 0
    while i < fn_sigs.len() {
        let name = contract_fn_sig::FnSig_name(fn_sigs.get_unchecked(i))
        if name.clone().ends_with(suffix.clone()) &&
        conversion_owner_matches(owner_name.clone(), name) {
            found = name
            count = count + 1
        }
        i = i + 1
    }
    if count == 1 {
        return found
    }
    String_new()
}

// The impl owner is the declared type (`Vec`) or its instantiation key
// (`Vec_String`, `HashSet_i32`, `HashMap_String_i32`). Match the exact owner or
// an underscore-suffixed instantiation so a same-prefix type cannot claim it.
fn conversion_owner_matches(owner_name: String, sig_name: String) -> bool {
    let sig_owner = paths::path_module_part(sig_name)
    sig_owner.clone().eq(owner_name.clone()) ||
    sig_owner.clone().starts_with(owner_name.clone().concat(String_from("_")))
}

// Associated functions whose concrete impls mangle their source type into the
// symbol (`impl_conversion_trait_has_source_type`).
fn is_conversion_method_name(method_name: String) -> bool {
    method_name.clone().eq(String_from("from_iter")) ||
    method_name.clone().eq(String_from("try_from")) ||
    method_name.clone().eq(String_from("from"))
}

fn infer_concrete_call_expr(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    sig: FnSig,
    arg_count: i32
) -> TypeInfo {
    let arg_types = infer_concrete_call_arg_types(env, scope, fn_sigs, enum_defs, node, arg_count)
    let selected_sig = select_conversion_impl_sig(env, fn_sigs, sig, arg_types)
    let param_count = contract_fn_sig::FnSig_param_count(selected_sig)
    let fname = contract_fn_sig::FnSig_name(selected_sig)
    if arg_count != param_count {
        unify::type_error_bad_arity(
            env,
            String_from("wrong number of arguments for `").concat(
                fname.clone().concat(String_from("`: expected ").concat(param_count.to_string().concat(String_from(", found ").concat(arg_count.to_string()))))
            )
        )
        return TypeInfo_simple(commands::TY_UNKNOWN())
    }
    param_mode::check_call_parameter_modes(
        env,
        scope,
        selected_sig,
        node,
        1,
        TypeInfo_simple(commands::TY_UNKNOWN())
    )
    check_concrete_call_args(env, scope, fn_sigs, node, selected_sig, arg_types)
    contract_env_resolved_record::type_env_record_resolved_call(
        env,
        ast_access::node_span_start(node),
        ast_access::node_text(ast_access::node_child_at(node, 0)),
        String_new(),
        contract_fn_sig::FnSig_name(selected_sig.clone()),
        String_new(),
        contract_fn_sig::FnSig_decl_index(selected_sig)
    )
    contract_fn_sig::FnSig_return_type(selected_sig)
}

// Infer every argument once, before the arity and parameter checks, so a
// conversion impl can be selected from the inferred source type without
// re-running inference (ownership uses are not idempotent).
fn infer_concrete_call_arg_types(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    arg_count: i32
) -> Vec<TypeInfo> {
    let mut arg_types = Vec::new<TypeInfo>()
    let mut i = 0
    while i < arg_count {
        let arg_node = ast_access::node_child_at(node, i + 1)
        let mut arg_ty = infer_expr(env, scope, fn_sigs, enum_defs, arg_node)
        // A bare function name infers TY_UNKNOWN because top-level functions
        // are not scope bindings. Recover the declared signature so a concrete
        // `fn(T) -> U` parameter receives a function value (#860).
        if contract_type_access::TypeInfo_tag(arg_ty) == commands::TY_UNKNOWN() &&
        (ast_expr_predicates::node_is_ident(arg_node) || ast_expr_predicates::node_is_path(arg_node)) &&
        !contract_env_record::type_env_is_const_name(env, ast_access::node_text(arg_node)) {
            let fn_ty = sigs::fn_value_type_from_sig(env, fn_sigs, ast_access::node_text(arg_node))
            if contract_type_access::TypeInfo_tag(fn_ty) == commands::TY_FN() {
                arg_ty = fn_ty
            }
        }
        arg_types.push(arg_ty)
        i = i + 1
    }
    arg_types
}

// `FromIterator` / `TryFrom` impls register as `<source spelling>__<source
// type>` because one associated name serves many source types. The flat index
// keeps the first impl for the bare spelling (#934), so a call whose first
// argument has another source type scans for the impl whose registration
// suffix is that argument's mangled type. The scan compares the owner family
// (`Vec` / `Vec_String`, `HashSet_i32` / `HashSet_String`) so one collection's
// impl cannot answer another collection's call.
fn select_conversion_impl_sig(
    env: TypeEnv,
    fn_sigs: Vec<FnSig>,
    sig: FnSig,
    arg_types: Vec<TypeInfo>
) -> FnSig {
    if arg_types.len() < 1 {
        return sig
    }
    let sig_name = contract_fn_sig::FnSig_name(sig)
    let prefix = conversion_impl_prefix(sig_name.clone())
    if prefix.len() == 0 {
        return sig
    }
    let arg_ty = unify::resolve_type(env, arg_types.get_unchecked(0))
    let arg_tag = contract_type_access::TypeInfo_tag(arg_ty)
    if arg_tag == commands::TY_UNKNOWN() || arg_tag == commands::TY_TYPE_VAR() {
        return sig
    }
    let arg_key = call_method::type_name_for_mangling(arg_ty)
    if arg_key.len() == 0 {
        return sig
    }
    // The candidate path already selected this source type; do not rescan and
    // risk swapping to another family that registers the same source key.
    if sig_name.clone().ends_with(String_from("__").concat(arg_key.clone())) {
        return sig
    }
    find_conversion_impl_sig(fn_sigs, prefix, arg_key, sig)
}

fn find_conversion_impl_sig(
    fn_sigs: Vec<FnSig>,
    prefix: String,
    arg_key: String,
    fallback: FnSig
) -> FnSig {
    let owner = paths::path_module_part(prefix.clone())
    let method = paths::path_symbol_part(prefix)
    if owner.len() == 0 || method.len() == 0 {
        return fallback
    }
    let family = conversion_owner_family(owner)
    let suffix = String_from("::").concat(method.concat(String_from("__").concat(arg_key)))
    let mut i = 0
    while i < fn_sigs.len() {
        let candidate = fn_sigs.get_unchecked(i)
        let name = contract_fn_sig::FnSig_name(candidate)
        if name.clone().ends_with(suffix.clone()) &&
        conversion_owner_family(paths::path_module_part(name)).eq(family.clone()) {
            return candidate
        }
        i = i + 1
    }
    fallback
}

// Impl owners carry their instantiation as an underscore suffix (`Vec_String`,
// `HashSet_i32`); the family is the declared type name before that suffix.
fn conversion_owner_family(owner: String) -> String {
    let n = owner.len()
    let mut i = 0
    while i < n {
        if owner.byte_at(i) == 95 {
            return owner.slice(0, i)
        }
        i = i + 1
    }
    owner
}

// The registration suffix separates the source spelling from the concrete
// source type (`Vec::from_iter__VecIter_i32`). A leading `__` is a compiler
// intrinsic spelling, not a conversion suffix, and yields no prefix.
fn conversion_impl_prefix(name: String) -> String {
    let n = name.len()
    let mut i = n - 2
    while i >= 0 {
        if name.byte_at(i) == 95 && name.byte_at(i + 1) == 95 {
            if i == 0 {
                return String_new()
            }
            return name.slice(0, i)
        }
        i = i - 1
    }
    String_new()
}

// A resolved non-generic call carries the declaration's parameter types, so
// every argument is checked against that contract instead of being inferred
// for effects only. `unify_compat::is_type_compatible` supplies the recursive
// identity answer for the diagnostic; `unify` still binds an open argument
// type variable the same way the generic path does. A concrete mismatch is
// E0200 at the argument position (#935).
fn check_concrete_call_args(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    node: AstNode,
    sig: FnSig,
    arg_types: Vec<TypeInfo>
) {
    let callee_name = contract_fn_sig::FnSig_name(sig)
    let conversion_prefix = conversion_impl_prefix(callee_name.clone())
    // A conversion registration is `Owner::method__<source>`; a mono or
    // intrinsic spelling has no `::` before its `__` and is not one.
    let is_conversion_impl = conversion_prefix.len() > 0 &&
    conversion_prefix.clone().contains(String_from("::"))
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    let mut i = 0
    while i < arg_types.len() && i < param_count {
        let arg_node = ast_access::node_child_at(node, i + 1)
        let mut arg_ty = arg_types.get_unchecked(i).clone()
        let param_ty = unify::resolve_type(env, contract_fn_sig::FnSig_param_at(sig, i))
        // An unsuffixed integer literal takes the declared width, so
        // `assert_eq_i64(value, 3)` stays valid; the emitter widens that
        // literal at an i64 parameter from the signature spine.
        arg_ty = call_generic_fn_args::adapt_int_literal_arg_type(arg_node, arg_ty, param_ty)
        param_mode::check_fn_type_value(
            env,
            scope,
            fn_sigs,
            arg_node,
            param_ty,
            arg_ty,
            String_from("a function with a `mut` parameter cannot be passed where a shared function type is expected")
        )
        let resolved_arg_ty = unify::resolve_type(env, arg_ty)
        let arg_tag = contract_type_access::TypeInfo_tag(resolved_arg_ty)
        let is_deferred = arg_tag == commands::TY_UNKNOWN() || arg_tag == commands::TY_TYPE_VAR()
        // An open source type cannot select a concrete conversion impl;
        // #934 owns the source-typed resolution. Leaving the call
        // unconstrained preserves the pre-check behavior instead of binding
        // the caller's type variable to the first flat impl.
        let is_open_conversion = i == 0 && is_conversion_impl && is_deferred
        // The emitter applies these representation conversions at the call
        // boundary; the declared parameter is already the target type.
        let is_emitter_conversion = is_integer_widening_argument(param_ty, resolved_arg_ty) ||
        is_char_codepoint_argument(param_ty, resolved_arg_ty)
        if is_print_boundary_parameter(param_ty) {
            if !is_deferred && !is_print_boundary_argument(resolved_arg_ty) {
                report_concrete_call_arg_mismatch(env, callee_name.clone(), i + 1, resolved_arg_ty, param_ty)
            }
        } else if !is_open_conversion && !is_emitter_conversion {
            if !unify_compat::is_type_compatible(env, param_ty, resolved_arg_ty) {
                report_concrete_call_arg_mismatch(env, callee_name.clone(), i + 1, resolved_arg_ty, param_ty)
            } else {
                // Keep the if-expression unit: the unified type is deliberately
                // unused, and the pinned checker unifies branch types even in
                // statement position.
                let _unified = unify::unify(env, param_ty, arg_ty)
            }
        }
        i = i + 1
    }
}

// `char` is represented as `i32` on both targets (spec §2.1), and ADR-091
// keeps the i32-codepoint boundary for `char_to_string` / `push_char`. The
// boundary is a property of the declared types, not of a callee name: an i32
// codepoint may enter a `char` parameter, and the char value may leave through
// an i32 parameter (`__core_char_to_string_impl`). It applies only to call
// arguments; `let`, returns (#938) and operators keep the nominal types.
fn is_char_codepoint_argument(param_ty: TypeInfo, arg_ty: TypeInfo) -> bool {
    let param_tag = contract_type_access::TypeInfo_tag(param_ty)
    let arg_tag = contract_type_access::TypeInfo_tag(arg_ty)
    if param_tag == commands::TY_CHAR() && arg_tag == commands::TY_I32() {
        return true
    }
    param_tag == commands::TY_I32() && arg_tag == commands::TY_CHAR()
}

// #923 makes the i32 -> i64 call-boundary widening part of the emitter
// contract: a declared i32 local is a real Wasm i32 at a component-boundary
// call and must be extended at an i64 parameter. Mirror that widening here;
// the opposite (narrowing) direction stays a type error (ADR-067).
fn is_integer_widening_argument(param_ty: TypeInfo, arg_ty: TypeInfo) -> bool {
    contract_type_access::TypeInfo_tag(param_ty) == commands::TY_I64() &&
    contract_type_access::TypeInfo_tag(arg_ty) == commands::TY_I32()
}

// The `String<__Printable>` declaration marker is the print emitter's conversion
// boundary: String, char, bool, i32, i64 and f64 arguments are converted to
// String before the call. Structs, enums, vectors and other references are
// not converted, so the checker keeps rejecting them.
fn is_print_boundary_parameter(param_ty: TypeInfo) -> bool {
    if contract_type_access::TypeInfo_tag(param_ty) != commands::TY_STRING() {
        return false
    }
    if contract_type_access::TypeInfo_type_arg_count(param_ty) < 1 {
        return false
    }
    let marker = contract_type_access::TypeInfo_type_arg_at(param_ty, 0)
    contract_type_access::TypeInfo_tag(marker) == commands::TY_STRUCT() &&
    contract_type_access::TypeInfo_name(marker).eq(String_from("__Printable"))
}

fn is_print_boundary_argument(arg_ty: TypeInfo) -> bool {
    let tag = contract_type_access::TypeInfo_tag(arg_ty)
    if tag == commands::TY_STRING() || tag == commands::TY_CHAR() ||
    tag == commands::TY_BOOL() {
        return true
    }
    tag == commands::TY_I32() || tag == commands::TY_I64() ||
    tag == commands::TY_F64()
}

fn report_concrete_call_arg_mismatch(
    mut env: TypeEnv,
    callee_name: String,
    position: i32,
    arg_ty: TypeInfo,
    param_ty: TypeInfo
) {
    let mut message = String_from("type mismatch in call to `")
    message = message.concat(callee_name)
    message = message.concat(String_from("`: argument "))
    message = message.concat(position.to_string())
    message = message.concat(String_from(" has type "))
    message = message.concat(name_display::type_display_name_with_args(arg_ty))
    message = message.concat(String_from(", expected "))
    message = message.concat(name_display::type_display_name_with_args(param_ty))
    unify::type_error(env, message)
}

fn tc_strip_module_prefix(name: String) -> String {
    let n = name.len()
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    name.clone()
}
