use std::prelude::{eq}
use std::text
use corehir::callee_spelling
use resolver::expr_path
use resolver::paths
use typechecker::kinds
use typechecker::ast_expr_predicates
use typechecker::ast_access
use typechecker::builtins
use typechecker::call_args
use typechecker::closure_capture
use typechecker::call_generic
use typechecker::call_method
use typechecker::hashmap_methods
use typechecker::call_unknown
use typechecker::call_vec_ctor
use typechecker::enum_expr
use typechecker::contract_fn_sig
use typechecker::contract_type_access
use typechecker::names
use typechecker::ownership
use typechecker::param_mode
use typechecker::scope
use typechecker::sigs
use typechecker::unify
fn infer_call_expr(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    let child_count = ast_access::node_child_count(node)
    if child_count < 1 {
        return TypeInfo_simple(commands::TY_UNKNOWN())
    }
    // Every argument position is an escape for a capturing closure: the
    // callee receives a bare funcref that cannot carry the captures. Check
    // here — before signature resolution — so unresolved and builtin calls
    // are covered the same way (#872). Child 0 is the callee, which is a
    // direct-call position and stays legal.
    if env.is_ownership_tracking_enabled {
        let mut a = 1
        while a < child_count {
            closure_capture::closure_capture_escape(env, scope, ast_access::node_child_at(node, a))
            a = a + 1
        }
    }
    let callee = ast_access::node_child_at(node, 0)
    if !ast_expr_predicates::node_is_ident(callee) && !ast_expr_predicates::node_is_path(callee) {
        call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, child_count - 1)
        return TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let enum_variant_ty = enum_expr::infer_enum_variant_call(enum_defs, callee)
    if contract_type_access::TypeInfo_tag(enum_variant_ty) != commands::TY_UNKNOWN() {
        // Constructing an enum stores every payload value, so a borrowed
        // `Box<T>` parameter cannot appear here (ADR-088 §6).
        if env.is_ownership_tracking_enabled {
            let mut store_arg = 1
            while store_arg < child_count {
                ownership::check_borrowed_box_escape(
                    env,
                    scope,
                    ast_access::node_child_at(node, store_arg)
                )
                store_arg = store_arg + 1
            }
        }
        let arg_types = call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, child_count - 1)
        return enum_expr::instantiate_variant_result(
            env,
            enum_defs,
            callee,
            enum_variant_ty,
            arg_types
        )
    }
    let callee_name = ast_access::node_text(callee)
    let hashmap_ctor_ty = hashmap_methods::infer_hashmap_constructor_call(
        env,
        scope,
        fn_sigs,
        enum_defs,
        node,
        callee
    )
    if contract_type_access::TypeInfo_tag(hashmap_ctor_ty) != commands::TY_UNKNOWN() {
        return hashmap_ctor_ty
    }
    // `clone` is a compiler-provided polymorphic operation. The prelude keeps
    // a String-shaped declaration for compatibility, but typechecking must
    // preserve the argument type for structs, enums, and collection elements.
    if eq(callee_name.clone(), "clone") && child_count == 2 {
        return infer_expr(
            env,
            scope,
            fn_sigs,
            enum_defs,
            ast_access::node_child_at(node, 1)
        )
    }
    // A function-typed local binding shadows the flat fn_sigs index:
    // higher-order parameters such as `map_i32_i32(v, f: fn(i32) -> i32)`
    // call `f(x)` inside their bodies and must resolve to the parameter,
    // not to an imported module function that happens to share the bare
    // name after signature-index flattening.
    if ast_expr_predicates::node_is_ident(callee) {
        let local_fn_ty = scope::scope_lookup_instantiated(env, scope, callee_name.clone())
        if contract_type_access::TypeInfo_tag(local_fn_ty) == commands::TY_FN() {
            return call_unknown::infer_local_function_call(
                env,
                scope,
                fn_sigs,
                enum_defs,
                node,
                local_fn_ty
            )
        }
    }
    let mut mono_fn_name = callee_name.clone()
    let mut sig = sigs::lookup_fn_sig(env, fn_sigs, callee_name.clone())
    if !contract_fn_sig::FnSig_has_name(sig) {
        // Loaded-module bodies are not resolver-processed, so a
        // `module::Type::method` call keeps the module prefix. The signature
        // index registers the impl as `Type::method`; retry the canonical
        // spellings before falling back to the last segment.
        let variants = callee_spelling::callee_spelling_variants(callee_name.clone())
        let mut vi = 0
        while vi < len(variants) {
            let variant = get_unchecked(variants, vi).clone()
            let variant_sig = sigs::lookup_fn_sig(env, fn_sigs, variant.clone())
            if contract_fn_sig::FnSig_has_name(variant_sig) {
                sig = variant_sig
                mono_fn_name = variant
                vi = len(variants)
            } else {
                vi = vi + 1
            }
        }
    }
    if !contract_fn_sig::FnSig_has_name(sig) {
        let stripped = tc_strip_module_prefix(callee_name.clone())
        if !eq(stripped.clone(), callee_name.clone()) &&
        !expr_path::is_builtin_type_name(paths::path_module_part(callee_name.clone())) {
            let bare_sig = sigs::lookup_fn_sig(env, fn_sigs, stripped.clone())
            // Imported declarations are flattened into the typecheck signature
            // index, while the source path keeps its module alias. Use the bare
            // signature for both generic and concrete calls after the direct
            // qualified lookup misses; monomorphization still needs the bare
            // declaration name for generic calls.
            if contract_fn_sig::FnSig_has_name(bare_sig) {
                sig = bare_sig
                mono_fn_name = stripped
            }
        }
    }
    if !contract_fn_sig::FnSig_has_name(sig) {
        // Concrete FromIterator impls are keyed by their source type
        // (`HashSet_i32::from_iter__VecIter_i32`), but the source spelling is
        // the trait's `HashSet::from_iter`. Select the impl from the inferred
        // first argument before the unresolved-call fallback (#917).
        let conversion_name = hashset_from_iter_candidate(
            env,
            scope,
            fn_sigs,
            enum_defs,
            node,
            callee_name.clone()
        )
        if len(conversion_name.clone()) > 0 {
            let conversion_sig = sigs::lookup_fn_sig(env, fn_sigs, conversion_name)
            if contract_fn_sig::FnSig_has_name(conversion_sig) {
                return infer_concrete_call_expr(
                    env,
                    scope,
                    fn_sigs,
                    enum_defs,
                    node,
                    conversion_sig,
                    child_count - 1
                )
            }
        }
        // Vec::new<T>() / with_capacity without inherent-impl sig still need
        // mono sites so bare (unannotated) lets get vec:T (#845).
        if call_vec_ctor::is_vec_associated_ctor_name(callee_name.clone()) {
            let ctor_ty = call_vec_ctor::infer_vec_ctor_turbofish_call(env, node, callee)
            if contract_type_access::TypeInfo_tag(ctor_ty) != commands::TY_UNKNOWN() {
                call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, child_count - 1)
                return ctor_ty
            }
        }
        if child_count > 1 {
            let recv_ty = infer_expr(
                env,
                scope,
                fn_sigs,
                enum_defs,
                ast_access::node_child_at(node, 1)
            )
            if contract_type_access::TypeInfo_tag(recv_ty) == commands::TY_VEC() {
                vec_core_mono::record_vec_core_mono_for_callee(env, callee_name.clone(), recv_ty)
            }
        }
        call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, child_count - 1)
        return call_unknown::infer_unknown_ident_call(env, scope, callee)
    }
    if is_prelude_len_signature(sig.clone()) {
        return infer_prelude_len_call(env, scope, fn_sigs, enum_defs, node, child_count - 1)
    }
    if contract_fn_sig::FnSig_type_param_count(sig) == 0 {
        return infer_concrete_call_expr(env, scope, fn_sigs, enum_defs, node, sig, child_count - 1)
    }
    call_generic::infer_generic_call_expr(env, scope, fn_sigs, enum_defs, node, sig, mono_fn_name)
}

// `len` is the one stable prelude free that serves two owners: `String` and
// `Vec<T>`. The committed pin can only compile the String declaration, so the
// checker selects the receiver's owner contract instead of checking every
// receiver against that spelling or skipping the arguments because the
// emitter lowers by name (#936). A user generic `len` does not have this
// concrete String parameter and keeps the ordinary generic checking path.
fn is_prelude_len_signature(sig: FnSig) -> bool {
    if !eq(contract_fn_sig::FnSig_name(sig.clone()), String_from("len")) {
        return false
    }
    if contract_fn_sig::FnSig_type_param_count(sig.clone()) != 0 {
        return false
    }
    if contract_fn_sig::FnSig_param_count(sig.clone()) != 1 {
        return false
    }
    contract_type_access::TypeInfo_tag(contract_fn_sig::FnSig_param_at(sig, 0)) ==
    commands::TY_STRING()
}

fn infer_prelude_len_call(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    arg_count: i32
) -> TypeInfo {
    if arg_count != 1 {
        unify::type_error_bad_arity(
            env,
            String_from("wrong number of arguments for `len`: expected 1, found ").concat(
                arg_count.to_string()
            )
        )
        call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, arg_count)
        return simple_type(commands::TY_I32())
    }
    let recv_ty = infer_expr(
        env,
        scope,
        fn_sigs,
        enum_defs,
        ast_access::node_child_at(node, 1)
    )
    let tag = contract_type_access::TypeInfo_tag(recv_ty)
    // An unbound type variable may later become a Vec through another use;
    // the call keeps the historical unchecked path for that deferred case.
    if tag == commands::TY_STRING() || tag == commands::TY_VEC() ||
    tag == commands::TY_TYPE_VAR() || tag == commands::TY_UNKNOWN() {
        return simple_type(commands::TY_I32())
    }
    unify::type_error(
        env,
        String_from("type mismatch in call to `len`: argument 1 has type ").concat(
            names::type_display_name(recv_ty).concat(String_from(", expected String or Vec<T>"))
        )
    )
    simple_type(commands::TY_I32())
}

// Concrete FromIterator impls carry their source type in the symbol
// (`HashSet_i32::from_iter__VecIter_i32`) so the same `from_iter` method can
// serve i32 and String sets. The source spelling has no concrete owner, so
// probe both families with the mangled source type; only the matching one
// exists.
fn hashset_from_iter_candidate(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    callee_name: String
) -> String {
    let is_from_iter = eq(callee_name.clone(), String_from("HashSet::from_iter")) ||
    callee_name.clone().ends_with(String_from("::HashSet::from_iter"))
    if !is_from_iter || ast_access::node_child_count(node) < 2 {
        return String_new()
    }
    let source_ty = infer_expr(
        env,
        scope,
        fn_sigs,
        enum_defs,
        ast_access::node_child_at(node, 1)
    )
    let source_name = call_method::type_name_for_mangling(source_ty)
    if len(source_name.clone()) == 0 {
        return String_new()
    }
    let i32_name = String_from("HashSet_i32::from_iter__").concat(source_name.clone())
    if contract_fn_sig::FnSig_has_name(sigs::lookup_fn_sig(env, fn_sigs, i32_name.clone())) {
        return i32_name
    }
    let string_name = String_from("HashSet_String::from_iter__").concat(source_name)
    if contract_fn_sig::FnSig_has_name(sigs::lookup_fn_sig(env, fn_sigs, string_name.clone())) {
        return string_name
    }
    String_new()
}

fn infer_concrete_call_expr(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    sig: FnSig,
    arg_count: i32
) -> TypeInfo {
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    let fname = contract_fn_sig::FnSig_name(sig)
    if arg_count != param_count {
        unify::type_error_bad_arity(
            env,
            String_from("wrong number of arguments for `").concat(
                fname.clone().concat(String_from("`: expected ").concat(param_count.to_string().concat(String_from(", found ").concat(arg_count.to_string()))))
            )
        )
        call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, arg_count)
        return TypeInfo_simple(commands::TY_UNKNOWN())
    }
    param_mode::check_call_parameter_modes(
        env,
        scope,
        sig,
        node,
        1,
        TypeInfo_simple(commands::TY_UNKNOWN())
    )
    if builtins::is_concrete_prelude_builtin(fname.clone()) {
        infer_prelude_concrete_call_args(env, scope, fn_sigs, enum_defs, node, sig, arg_count)
        return contract_fn_sig::FnSig_return_type(sig)
    }
    // Remaining concrete calls keep the unchecked path: the flat name index is
    // not overload-aware, and their declared signatures are placeholders or
    // overloads (`len`, `push`, `to_string`, `eq`, `assert_eq_i64`, ...).
    // Checking them against the first flat signature would false-fail valid
    // calls (#936). The argument inference still checks the function-type
    // mode direction (ADR-088 §7), which does not depend on unification.
    infer_concrete_call_args_with_fn_modes(env, scope, fn_sigs, enum_defs, node, sig, arg_count)
    contract_fn_sig::FnSig_return_type(sig)
}

fn infer_concrete_call_args_with_fn_modes(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    sig: FnSig,
    arg_count: i32
) {
    let mut a = 0
    while a < arg_count {
        let arg_node = ast_access::node_child_at(node, a + 1)
        let arg_ty = infer_expr(env, scope, fn_sigs, enum_defs, arg_node)
        param_mode::check_fn_type_value(
            env,
            scope,
            fn_sigs,
            arg_node,
            contract_fn_sig::FnSig_param_at(sig, a),
            arg_ty,
            String_from("a function with a `mut` parameter cannot be passed where a shared function type is expected")
        )
        a = a + 1
    }
}

// Concrete prelude frees lower by name from their prelude signatures, so
// checking only the arity lets a wrong argument reach the emitter:
// `i32_to_i64(<i64>)` used to truncate silently, and `f64_bits_lo(<String>)`
// emitted invalid Wasm caught only by the W0004 self-check. Polymorphic
// prelude operations keep the unchecked path above because their declared
// signatures are placeholders (#936).
fn infer_prelude_concrete_call_args(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    sig: FnSig,
    arg_count: i32
) {
    let callee_name = contract_fn_sig::FnSig_name(sig)
    let mut i = 0
    while i < arg_count {
        let arg_node = ast_access::node_child_at(node, i + 1)
        let arg_ty = infer_expr(env, scope, fn_sigs, enum_defs, arg_node)
        let param_ty = unify::resolve_type(env, contract_fn_sig::FnSig_param_at(sig, i))
        let resolved_arg_ty = unify::resolve_type(env, arg_ty)
        if has_concrete_arg_conflict(param_ty, resolved_arg_ty) {
            let mut message = String_from("type mismatch in call to `")
            message = message.concat(callee_name.clone())
            message = message.concat(String_from("`: argument "))
            message = message.concat((i + 1).to_string())
            message = message.concat(String_from(" has type "))
            message = message.concat(names::type_display_name(resolved_arg_ty))
            message = message.concat(String_from(", expected "))
            message = message.concat(names::type_display_name(param_ty))
            unify::type_error(env, message)
        } else {
            let _unified = unify::unify(env, param_ty, arg_ty)
        }
        i = i + 1
    }
}

// Unknown and type-variable arguments are left to `unify` so a generic caller
// can still bind the parameter; only two concrete, different tags are a
// definite mismatch.
fn has_concrete_arg_conflict(param_ty: TypeInfo, arg_ty: TypeInfo) -> bool {
    let param_tag = contract_type_access::TypeInfo_tag(param_ty)
    let arg_tag = contract_type_access::TypeInfo_tag(arg_ty)
    if param_tag == commands::TY_UNKNOWN() || param_tag == commands::TY_TYPE_VAR() {
        return false
    }
    if arg_tag == commands::TY_UNKNOWN() || arg_tag == commands::TY_TYPE_VAR() {
        return false
    }
    param_tag != arg_tag
}

fn tc_strip_module_prefix(name: String) -> String {
    let n = len(name)
    let mut i = n - 1
    while i >= 0 {
        if name.byte_at(i) == 58 {
            return name.slice(i + 1, n)
        }
        i = i - 1
    }
    name.clone()
}
