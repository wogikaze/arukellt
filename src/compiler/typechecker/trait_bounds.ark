use std::text
use typechecker::contract_fn_sig
use typechecker::contract_type_param_bounds
use typechecker::contract_trait_impl
use typechecker::contract_trait_impl_record
use typechecker::contract_trait_info
use typechecker::contract_type_access
use typechecker::names
use typechecker::type_names
use typechecker::unify
fn type_satisfies_trait_bound(mut env: TypeEnv, ty: TypeInfo, bound: TypeInfo) -> bool {
    type_satisfies_trait_bound_at_depth(env, ty, bound, 0)
}

fn type_satisfies_trait_bound_at_depth(
    mut env: TypeEnv,
    ty: TypeInfo,
    bound: TypeInfo,
    depth: i32
) -> bool {
    let resolved_ty = unify::resolve_type(env, ty)
    if contract_type_access::TypeInfo_tag(resolved_ty) == commands::TY_TYPE_VAR() {
        return true
    }
    if is_builtin_trait_impl(resolved_ty, bound) {
        return true
    }
    let match_count = matching_trait_impl_count(env, resolved_ty, bound, depth)
    if match_count > 1 {
        unify::type_error(
            env,
            String_from("ambiguous trait bound: multiple impls satisfy ").concat(names::type_display_name(bound))
        )
        return false
    }
    if match_count != 1 {
        return false
    }
    // Fuel for cyclic supertrait chains: a simple path through the declared
    // traits has at most trait_defs nodes, so any chain deeper than that has
    // revisited a trait. The guard must not reject the top-level call itself
    // when the registry is empty — an impl can satisfy a bound even when the
    // trait declaration is not in scope (ADR-065: operator legality must not
    // depend on importing std::core::ops) (#886).
    if depth > env.trait_defs.len() {
        return false
    }
    let trait_info = trait_info_for_name(
        env,
        contract_type_access::TypeInfo_name(bound)
    )
    let super_count = contract_trait_info::trait_info_supertrait_count(trait_info)
    let mut i = 0
    while i < super_count {
        let super_name = contract_trait_info::trait_info_supertrait_at(trait_info, i)
        if !type_satisfies_trait_bound_at_depth(
            env,
            resolved_ty,
            type_names::resolve_type_name(super_name.clone()),
            depth + 1
        ) {
            return false
        }
        i = i + 1
    }
    true
}

// A type variable carries only the contracts declared in the current
// function's parameter bounds. Callers use this to require a concrete
// protocol (`IntoIterator`, `Copy`, operator traits) on generic values
// before monomorphisation exposes the substituted type.
fn env_type_var_has_trait_bound(env: TypeEnv, type_param_name: String, trait_name: String) -> bool {
    let bound_count = env.current_fn_bounds.len()
    let mut i = 0
    while i < bound_count {
        let param = get_unchecked(env.current_fn_bounds, i)
        if contract_type_param_bounds::TypeParamBounds_name(param).eq(type_param_name.clone()) && type_param_bounds_has_trait(param, trait_name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn type_param_bounds_has_trait(param: TypeParamBounds, trait_name: String) -> bool {
    let count = contract_type_param_bounds::TypeParamBounds_bound_count(param)
    let mut i = 0
    while i < count {
        let bound = contract_type_param_bounds::TypeParamBounds_bound_at(param, i)
        if names::same_type_name(contract_type_access::TypeInfo_name(bound), trait_name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn trait_info_for_name(env: TypeEnv, trait_name: String) -> TraitInfo {
    let count = env.trait_defs.len()
    let mut i = 0
    while i < count {
        let info = get_unchecked(env.trait_defs, i)
        if names::same_type_name(contract_trait_info::trait_info_name(info), trait_name.clone()) {
            return info
        }
        i = i + 1
    }
    contract_trait_info::TraitInfo_new(String_new(), 0 - 1)
}

fn matching_trait_impl_count(
    mut env: TypeEnv,
    resolved_ty: TypeInfo,
    bound: TypeInfo,
    depth: i32
) -> i32 {
    let count = env.trait_impls.len()
    let mut matches = 0
    let mut i = 0
    while i < count {
        let impl_info = get_unchecked(env.trait_impls, i)
        if trait_impl_matches_at_depth(env, impl_info, resolved_ty, bound, depth) {
            matches = matches + 1
        }
        i = i + 1
    }
    matches
}

fn trait_impl_matches(
    mut env: TypeEnv,
    impl_info: TraitImplInfo,
    resolved_ty: TypeInfo,
    bound: TypeInfo
) -> bool {
    trait_impl_matches_at_depth(env, impl_info, resolved_ty, bound, 0)
}

fn trait_impl_matches_at_depth(
    mut env: TypeEnv,
    impl_info: TraitImplInfo,
    resolved_ty: TypeInfo,
    bound: TypeInfo,
    depth: i32
) -> bool {
    if !names::same_type_name(
        contract_trait_impl::TraitImplInfo_trait_name(impl_info),
        contract_type_access::TypeInfo_name(bound)
    ) {
        return false
    }
    let self_ty = contract_trait_impl::TraitImplInfo_self_ty(impl_info)
    if !type_matches_pattern(self_ty.clone(), resolved_ty) {
        return false
    }
    if !type_args_match(
        contract_trait_impl_record::trait_impl_info_trait_args(impl_info),
        bound
    ) {
        return false
    }
    impl_bounds_satisfied(env, impl_info, self_ty.clone(), resolved_ty, depth)
}

// ADR-078 §3: a parametric impl that matches a concrete instantiation must
// check its declared bounds against the matched self arguments. Type
// variables still defer (they may be constrained by the enclosing function
// or by monomorphisation), preserving the existing demand-edge behaviour.
fn impl_bounds_satisfied(
    mut env: TypeEnv,
    impl_info: TraitImplInfo,
    self_pattern: TypeInfo,
    resolved_ty: TypeInfo,
    depth: i32
) -> bool {
    let bounds = contract_trait_impl_record::trait_impl_info_type_param_bounds(impl_info)
    let count = bounds.len()
    let mut i = 0
    while i < count {
        let param = get_unchecked(bounds, i)
        let actual = match_impl_param(
            self_pattern.clone(),
            resolved_ty.clone(),
            contract_type_param_bounds::TypeParamBounds_name(param)
        )
        if contract_type_access::TypeInfo_tag(actual) == commands::TY_UNKNOWN() {
            return false
        }
        let bound_count = contract_type_param_bounds::TypeParamBounds_bound_count(param)
        let mut j = 0
        while j < bound_count {
            if !type_satisfies_trait_bound_at_depth(
                env,
                actual.clone(),
                contract_type_param_bounds::TypeParamBounds_bound_at(param, j),
                depth + 1
            ) {
                return false
            }
            j = j + 1
        }
        i = i + 1
    }
    true
}

// Return the actual type bound to one named impl parameter by matching the
// impl's self pattern against the candidate self type, or TY_UNKNOWN when the
// parameter does not occur in the pattern.
fn match_impl_param(pattern: TypeInfo, actual: TypeInfo, param_name: String) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(pattern) == commands::TY_TYPE_VAR() {
        if contract_type_access::TypeInfo_name(pattern).eq(param_name.clone()) {
            return actual
        }
        return type_names::type_info_simple(commands::TY_UNKNOWN())
    }
    if !trait_type_tags_match(
        contract_type_access::TypeInfo_tag(pattern),
        contract_type_access::TypeInfo_tag(actual)
    ) || !names::same_type_name(
        contract_type_access::TypeInfo_name(pattern),
        contract_type_access::TypeInfo_name(actual)
    ) {
        return type_names::type_info_simple(commands::TY_UNKNOWN())
    }
    let pattern_count = contract_type_access::TypeInfo_type_arg_count(pattern)
    if pattern_count != contract_type_access::TypeInfo_type_arg_count(actual) {
        return type_names::type_info_simple(commands::TY_UNKNOWN())
    }
    let mut i = 0
    while i < pattern_count {
        let found = match_impl_param(
            contract_type_access::TypeInfo_type_arg_at(pattern, i),
            contract_type_access::TypeInfo_type_arg_at(actual, i),
            param_name.clone()
        )
        if contract_type_access::TypeInfo_tag(found) != commands::TY_UNKNOWN() {
            return found
        }
        i = i + 1
    }
    type_names::type_info_simple(commands::TY_UNKNOWN())
}

fn type_args_match(impl_args: Vec<TypeInfo>, bound: TypeInfo) -> bool {
    let bound_count = contract_type_access::TypeInfo_type_arg_count(bound)
    if impl_args.len() != bound_count {
        return false
    }
    let mut i = 0
    while i < bound_count {
        if !type_matches_pattern(
            get_unchecked(impl_args, i),
            contract_type_access::TypeInfo_type_arg_at(bound, i)
        ) {
            return false
        }
        i = i + 1
    }
    true
}

fn type_matches_pattern(pattern: TypeInfo, actual: TypeInfo) -> bool {
    if contract_type_access::TypeInfo_tag(pattern) == commands::TY_TYPE_VAR() {
        return true
    }
    if !trait_type_tags_match(
        contract_type_access::TypeInfo_tag(pattern),
        contract_type_access::TypeInfo_tag(actual)
    ) ||
    !names::same_type_name(
        contract_type_access::TypeInfo_name(pattern),
        contract_type_access::TypeInfo_name(actual)
    ) {
        return false
    }
    let pattern_count = contract_type_access::TypeInfo_type_arg_count(pattern)
    let actual_count = contract_type_access::TypeInfo_type_arg_count(actual)
    if pattern_count != actual_count {
        return false
    }
    let mut i = 0
    while i < pattern_count {
        if !type_matches_pattern(
            contract_type_access::TypeInfo_type_arg_at(pattern, i),
            contract_type_access::TypeInfo_type_arg_at(actual, i)
        ) {
            return false
        }
        i = i + 1
    }
    true
}

fn trait_type_tags_match(pattern_tag: i32, actual_tag: i32) -> bool {
    if pattern_tag == actual_tag {
        return true
    }
    if pattern_tag == commands::TY_STRUCT() && actual_tag == commands::TY_ENUM() {
        return true
    }
    if pattern_tag == commands::TY_ENUM() && actual_tag == commands::TY_STRUCT() {
        return true
    }
    false
}

fn is_builtin_trait_impl(ty: TypeInfo, bound: TypeInfo) -> bool {
    if !contract_type_access::TypeInfo_name(bound).eq("Ord") {
        return false
    }
    let tag = contract_type_access::TypeInfo_tag(ty)
    tag == commands::TY_I32() ||
    tag == commands::TY_I64() ||
    tag == commands::TY_F64() ||
    tag == commands::TY_STRING() ||
    tag == commands::TY_CHAR() ||
    tag == commands::TY_BOOL()
}

fn enforce_trait_bound(mut env: TypeEnv, ty: TypeInfo, bound: TypeInfo) {
    if type_satisfies_trait_bound(env, ty, bound) {
        return
    }
    let ty_name = names::type_display_name(unify::resolve_type(env, ty))
    let bound_name = names::type_display_name(bound)
    unify::type_error(env, "trait bound not satisfied: ".concat(ty_name.concat(" does not implement ".concat(bound_name))))
}

fn enforce_fn_sig_bounds(mut env: TypeEnv, infer_env: TypeEnv, sig: FnSig, var_types: Vec<TypeInfo>) {
    let tp_count = contract_fn_sig::FnSig_type_param_bound_count(sig)
    let mut i = 0
    while i < tp_count {
        let tp = contract_fn_sig::FnSig_type_param_bound_at(sig, i)
        let resolved_ty = unify::resolve_type(infer_env, get_unchecked(var_types, i))
        let bound_count = contract_type_param_bounds::TypeParamBounds_bound_count(tp)
        let mut j = 0
        while j < bound_count {
            let bound = contract_type_param_bounds::TypeParamBounds_bound_at(tp, j)
            enforce_trait_bound(env, resolved_ty, bound)
            j = j + 1
        }
        i = i + 1
    }
}
