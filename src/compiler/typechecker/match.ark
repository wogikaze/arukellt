use std::text
use typechecker::kinds
use typechecker::ast_access
use typechecker::match_coverage_collect
use typechecker::match_coverage_record
use typechecker::match_coverage_variant
use typechecker::match_exhaustive
use typechecker::unify
use typechecker::scope
use typechecker::contract_type_access
use typechecker::contract_enum_info
use typechecker::ast_pattern_predicates
use typechecker::stmt_let
use typechecker::ownership_types
use typechecker::instantiate
use typechecker::names
fn infer_match_expr(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    let child_count = ast_access::node_child_count(node)
    let arm_count = child_count - 1
    if arm_count < 1 {
        return TypeInfo_simple(commands::TY_UNKNOWN())
    }
    let scrutinee_node = ast_access::node_child_at(node, 0)
    let scrutinee_ty = infer_expr(env, scope, fn_sigs, enum_defs, scrutinee_node)
    let mut result_ty = TypeInfo_simple(commands::TY_UNKNOWN())
    let mut coverage = match_coverage_record::MatchCoverage_new()
    let mut idx = 0
    while idx < arm_count {
        let arm = ast_access::node_child_at(node, idx + 1)
        let arm_child_count = ast_access::node_child_count(arm)
        if arm_child_count < 2 {
            idx = idx + 1
            continue
        }
        let pat = ast_access::node_child_at(arm, 0)
        match_coverage_collect::record_match_pattern(coverage, pat, arm_child_count > 2)
        let body = ast_access::node_child_at(arm, arm_child_count - 1)
        let mut arm_scope = scope::scope_child(scope)
        bind_match_pattern(env, arm_scope, enum_defs, scrutinee_ty, pat)
        let arm_ty = infer_expr(env, arm_scope, fn_sigs, enum_defs, body)
        // An arm may move or capture an outer binding; without folding the
        // marks back, later arms and post-match uses miss the possibly-
        // moved state (#903 — same gap as nested closures).
        if env.is_ownership_tracking_enabled {
            scope::scope_merge_child_marks(scope, arm_scope)
        }
        if idx == 0 {
            result_ty = arm_ty
        } else {
            // Arms must agree on a single result type. Without this, a
            // later arm could return a different type and the match would
            // silently take the first arm's type.
            result_ty = unify::unify(env, result_ty, arm_ty)
        }
        idx = idx + 1
    }
    let resolved_scrutinee = unify::resolve_type(env, scrutinee_ty)
    match_exhaustive::check_match_exhaustive(env, resolved_scrutinee, enum_defs, coverage)
    result_ty
}

fn bind_match_pattern(mut env: TypeEnv, mut scope: LocalScope, enum_defs: Vec<EnumInfo>, scrutinee_ty: TypeInfo, pat: AstNode) {
    if ast_access::node_kind_is(pat, kinds::NK_PAT_IDENT()) {
        let name = ast_access::node_text(pat)
        if !name.clone().eq("_") {
            scope::scope_define(scope, name, scrutinee_ty)
        }
        return
    }
    if ast_access::node_kind_is(pat, kinds::NK_PAT_TUPLE()) {
        bind_tuple_arm_pattern(env, scope, enum_defs, scrutinee_ty, pat)
        return
    }
    if ast_access::node_kind_is(pat, kinds::NK_PAT_OR()) {
        check_or_alternative_bindings(env, pat)
        return
    }
    if !ast_access::node_kind_is(pat, kinds::NK_PAT_VARIANT()) {
        return
    }
    bind_variant_payload_idents(env, scope, enum_defs, scrutinee_ty, pat)
}

// Or-pattern alternatives act as match discriminators only. A binding
// inside an alternative would need per-alternative payload extraction that
// is not implemented, and a name bound by one alternative would otherwise
// read an uninitialized local when a different alternative matches —
// the resolver already allocates the symbol, so it compiled and silently
// read 0. Reject binding and nested-composite alternatives here so the
// surface is a diagnostic instead of a wrong value (#901).
fn check_or_alternative_bindings(mut env: TypeEnv, pat: AstNode) {
    let alt_count = ast_access::node_child_count(pat)
    let mut i = 0
    while i < alt_count {
        let alt = ast_access::node_child_at(pat, i)
        if ast_access::node_kind_is(alt, kinds::NK_PAT_IDENT()) {
            if !match_coverage_variant::ident_looks_like_unit_variant(alt) {
                unify::type_error(env, String_from("unsupported match pattern: or-pattern alternatives cannot introduce bindings"))
                return
            }
        }
        if ast_access::node_kind_is(alt, kinds::NK_PAT_VARIANT()) {
            check_or_variant_alt_children(env, alt)
        }
        if ast_access::node_kind_is(alt, kinds::NK_PAT_TUPLE()) ||
        ast_access::node_kind_is(alt, kinds::NK_PAT_STRUCT()) ||
        ast_access::node_kind_is(alt, kinds::NK_PAT_OR()) {
            unify::type_error(env, String_from("unsupported match pattern: nested composite alternatives in or-patterns are not implemented"))
            return
        }
        i = i + 1
    }
}

fn check_or_variant_alt_children(mut env: TypeEnv, alt: AstNode) {
    let child_count = ast_access::node_child_count(alt)
    let mut i = 0
    while i < child_count {
        let sub = ast_access::node_child_at(alt, i)
        if ast_access::node_kind_is(sub, kinds::NK_PAT_IDENT()) {
            let sub_name = ast_access::node_text(sub)
            if !sub_name.clone().eq("_") {
                unify::type_error(env, String_from("unsupported match pattern: or-pattern alternatives cannot introduce bindings"))
                return
            }
        }
        if ast_access::node_kind_is(sub, kinds::NK_PAT_VARIANT()) ||
        ast_access::node_kind_is(sub, kinds::NK_PAT_TUPLE()) ||
        ast_access::node_kind_is(sub, kinds::NK_PAT_STRUCT()) ||
        ast_access::node_kind_is(sub, kinds::NK_PAT_OR()) {
            unify::type_error(env, String_from("unsupported match pattern: nested composite alternatives in or-patterns are not implemented"))
            return
        }
        i = i + 1
    }
}

// Bind the ident children of a variant pattern against the payload types of
// scrutinee_ty's enum. Shared by top-level variant arms and tuple-arm
// element variants, which look the payload types up on the element type.
// Nested composite children recurse so Some(Some(v)) and Some((k, _)) bind
// their inner idents; literal children are match conditions, not bindings,
// and struct children are rejected rather than silently ignored (#902).
fn bind_variant_payload_idents(mut env: TypeEnv, mut scope: LocalScope, enum_defs: Vec<EnumInfo>, scrutinee_ty: TypeInfo, pat: AstNode) {
    let variant_name = ast_access::node_text(pat)
    let enum_info = match_enum_info(enum_defs, scrutinee_ty)
    let variant_index = contract_enum_info::EnumInfo_variant_index(enum_info, variant_name.clone())
    let type_params = contract_enum_info::EnumInfo_type_params(enum_info)
    let inst_args = enum_scrutinee_type_args(enum_info, scrutinee_ty)
    let has_declared_payloads = contract_enum_info::EnumInfo_name(enum_info).len() > 0
    let bind_count = ast_access::node_child_count(pat)
    let mut i = 0
    while i < bind_count {
        let bind_pat = ast_access::node_child_at(pat, i)
        let declared_ty = if has_declared_payloads {
            contract_enum_info::EnumInfo_variant_payload_at(enum_info, variant_index, i)
        } else {
            // Builtin Result / Option values carry their payload types as
            // type arguments but no nominal EnumInfo, so a match binding
            // used to fall back to TY_UNKNOWN. Checker-side binding is the
            // only place the payload type exists; recovering it in lowering
            // would hand MIR a type the checker never proved (#933).
            builtin_variant_payload_type(scrutinee_ty.clone(), variant_name.clone(), i)
        }
        let bind_ty = if inst_args.len() > 0 {
            instantiate::instantiate_type(declared_ty, type_params, inst_args)
        } else {
            declared_ty
        }
        bind_payload_subpat_idents(env, scope, enum_defs, bind_ty, bind_pat)
        i = i + 1
    }
}

// Payload type of a builtin Result / Option variant, read from the scrutinee's
// type arguments: Result Ok = arg0, Err = arg1; Option Some = arg0. Returns
// TY_UNKNOWN for any other shape so custom enums keep the declared path.
fn builtin_variant_payload_type(scrutinee_ty: TypeInfo, variant_name: String, payload_index: i32) -> TypeInfo {
    let variant = names::unqualified_type_name(variant_name.clone())
    let arg_count = contract_type_access::TypeInfo_type_arg_count(scrutinee_ty)
    let tag = contract_type_access::TypeInfo_tag(scrutinee_ty)
    if tag == commands::TY_RESULT() {
        if variant.clone().eq(String_from("Ok")) && payload_index == 0 && arg_count > 0 {
            return contract_type_access::TypeInfo_type_arg_at(scrutinee_ty, 0)
        }
        if variant.clone().eq(String_from("Err")) && payload_index == 0 && arg_count > 1 {
            return contract_type_access::TypeInfo_type_arg_at(scrutinee_ty, 1)
        }
    }
    if tag == commands::TY_OPTION() {
        if variant.clone().eq(String_from("Some")) && payload_index == 0 && arg_count > 0 {
            return contract_type_access::TypeInfo_type_arg_at(scrutinee_ty, 0)
        }
    }
    return TypeInfo_simple(commands::TY_UNKNOWN())
}

// Scrutinee type arguments in declared parameter order. Empty when the
// scrutinee carries no instantiation or its arity disagrees with the
// declaration, in which case the unsubstituted payload type is the only
// sound answer.
fn enum_scrutinee_type_args(enum_info: EnumInfo, scrutinee_ty: TypeInfo) -> Vec<TypeInfo> {
    let mut args = Vec::new<TypeInfo>()
    let params = contract_enum_info::EnumInfo_type_params(enum_info)
    let arg_count = contract_type_access::TypeInfo_type_arg_count(scrutinee_ty)
    if params.len() == 0 || arg_count != params.len() {
        return args
    }
    let mut i = 0
    while i < arg_count {
        push(args, contract_type_access::TypeInfo_type_arg_at(scrutinee_ty, i))
        i = i + 1
    }
    args
}

// Bind the idents introduced by one payload sub-pattern at type payload_ty.
// Literal and wildcard children bind nothing; ident children bind unless
// they name a variant of the payload enum (a tag condition, not a name);
// tuple and nested variant children destructure recursively; or and
// struct children cannot introduce bindings (#902).
fn bind_payload_subpat_idents(mut env: TypeEnv, mut scope: LocalScope, enum_defs: Vec<EnumInfo>, payload_ty: TypeInfo, pat: AstNode) {
    if ast_access::node_kind_is(pat, kinds::NK_PAT_IDENT()) {
        let name = ast_access::node_text(pat)
        if name.clone().eq("_") {
            return
        }
        let payload_enum = match_enum_info(enum_defs, payload_ty)
        if contract_enum_info::EnumInfo_variant_index(payload_enum, name.clone()) >= 0 {
            return
        }
        if match_coverage_variant::ident_looks_like_unit_variant(pat) {
            return
        }
        scope::scope_define(scope, name, payload_ty)
        return
    }
    if ast_access::node_kind_is(pat, kinds::NK_PAT_VARIANT()) {
        bind_variant_payload_idents(env, scope, enum_defs, payload_ty, pat)
        return
    }
    if ast_access::node_kind_is(pat, kinds::NK_PAT_TUPLE()) {
        let elem_count = ast_access::node_child_count(pat)
        let mut i = 0
        while i < elem_count {
            let elem = ast_access::node_child_at(pat, i)
            let elem_ty = stmt_let::tuple_element_type_at(payload_ty, i)
            bind_payload_subpat_idents(env, scope, enum_defs, elem_ty, elem)
            i = i + 1
        }
        return
    }
    if ast_access::node_kind_is(pat, kinds::NK_PAT_OR()) {
        check_or_alternative_bindings(env, pat)
        return
    }
    if ast_access::node_kind_is(pat, kinds::NK_PAT_STRUCT()) {
        unify::type_error(env, String_from("unsupported match pattern: struct sub-patterns in variant payloads are not implemented"))
    }
}

// Tuple arm patterns destructure the scrutinee per element: ident elements
// bind the element type, variant elements bind payload idents, and nested
// tuple/struct shapes the lowerer cannot emit are rejected here so they
// surface as a diagnostic instead of invalid Wasm (#893).
fn bind_tuple_arm_pattern(mut env: TypeEnv, mut scope: LocalScope, enum_defs: Vec<EnumInfo>, scrutinee_ty: TypeInfo, pat: AstNode) {
    let elem_count = ast_access::node_child_count(pat)
    let mut i = 0
    while i < elem_count {
        let sub = ast_access::node_child_at(pat, i)
        let elem_ty = stmt_let::tuple_element_type_at(scrutinee_ty, i)
        if ast_access::node_kind_is(sub, kinds::NK_PAT_IDENT()) {
            let name = ast_access::node_text(sub)
            if !name.clone().eq("_") && !match_coverage_variant::ident_looks_like_unit_variant(sub) {
                scope::scope_define_with_flags(
                    scope,
                    name,
                    elem_ty,
                    ast_access::node_is_mut(pat),
                    ownership_types::type_is_copy(env, elem_ty)
                )
            }
        }
        if ast_access::node_kind_is(sub, kinds::NK_PAT_VARIANT()) {
            check_tuple_elem_variant_binds(env, scope, enum_defs, elem_ty, sub)
        }
        if ast_access::node_kind_is(sub, kinds::NK_PAT_OR()) {
            check_tuple_elem_or_alts(env, sub)
        }
        if ast_access::node_kind_is(sub, kinds::NK_PAT_TUPLE()) ||
        ast_access::node_kind_is(sub, kinds::NK_PAT_STRUCT()) {
            unify::type_error(env, String_from("unsupported match pattern: nested tuple/struct patterns in tuple arm elements are not implemented"))
        }
        i = i + 1
    }
}

fn check_tuple_elem_variant_binds(mut env: TypeEnv, mut scope: LocalScope, enum_defs: Vec<EnumInfo>, elem_ty: TypeInfo, sub: AstNode) {
    let bind_count = ast_access::node_child_count(sub)
    let mut i = 0
    while i < bind_count {
        let bind_pat = ast_access::node_child_at(sub, i)
        if ast_access::node_kind_is(bind_pat, kinds::NK_PAT_TUPLE()) ||
        ast_access::node_kind_is(bind_pat, kinds::NK_PAT_STRUCT()) ||
        ast_access::node_kind_is(bind_pat, kinds::NK_PAT_OR()) {
            unify::type_error(env, String_from("unsupported match pattern: nested composite sub-patterns in tuple arm variant elements are not implemented"))
            return
        }
        i = i + 1
    }
    bind_variant_payload_idents(env, scope, enum_defs, elem_ty, sub)
}

fn check_tuple_elem_or_alts(mut env: TypeEnv, sub: AstNode) {
    let alt_count = ast_access::node_child_count(sub)
    let mut has_literal_alt = false
    let mut has_variant_alt = false
    let mut unsupported = false
    let mut i = 0
    while i < alt_count {
        let alt = ast_access::node_child_at(sub, i)
        if ast_pattern_predicates::node_is_pat_literal(alt) {
            has_literal_alt = true
        } else if ast_pattern_predicates::node_is_pat_variant(alt) {
            has_variant_alt = true
        } else if ast_pattern_predicates::node_is_pat_ident(alt) {
            if match_coverage_variant::ident_looks_like_unit_variant(alt) {
                has_variant_alt = true
            } else {
                unsupported = true
            }
        } else {
            unsupported = true
        }
        i = i + 1
    }
    if unsupported || (has_literal_alt && has_variant_alt) {
        unify::type_error(env, String_from("unsupported match pattern: or-pattern alternatives in tuple arm elements must be all literals or all variants"))
    }
}

fn match_enum_info(enum_defs: Vec<EnumInfo>, scrutinee_ty: TypeInfo) -> EnumInfo {
    let enum_name = contract_type_access::TypeInfo_name(scrutinee_ty)
    let mut i = 0
    while i < enum_defs.len() {
        let info = get_unchecked(enum_defs, i)
        let declared = contract_enum_info::EnumInfo_name(info)
        if declared.clone().eq(enum_name.clone()) || declared.clone().ends_with("::".concat(enum_name.clone())) {
            return info
        }
        i = i + 1
    }
    contract_enum_info::EnumInfo_new(String_new(), Vec::new<String>())
}
