use std::text
use typechecker::ast_access
use typechecker::call_generic_common
use typechecker::call_generic_fn_args
use typechecker::call_generic_resolve
use typechecker::call_generic_turbofish
use typechecker::associated_types
use typechecker::contract_env_resolved_record
use typechecker::contract_fn_sig
use typechecker::contract_struct_info
use typechecker::contract_type_access
use typechecker::contract_type_constructors
use typechecker::infer_env_scope
use typechecker::instantiate
use typechecker::hashmap_api
use typechecker::mono
use typechecker::names
use typechecker::traits
use typechecker::unify
fn infer_generic_call_expr(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode, sig: FnSig, fn_name: String) -> TypeInfo {
    let mut infer_env = infer_env_scope::borrow_generic_infer_env(env)
    let mut var_names = Vec::new<String>()
    let mut var_types = Vec::new<TypeInfo>()
    call_generic_common::append_generic_type_vars(infer_env, sig, var_names, var_types)
    // Explicit turbofish on the callee PATH (e.g. Vec::new<i32>) binds before
    // value-arg inference so zero-arg generics can monomorphize (#845).
    call_generic_turbofish::constrain_turbofish_type_args(
        ast_access::node_child_at(node, 0),
        infer_env,
        var_types
    )
    let mut arg_types = Vec::new<TypeInfo>()
    call_generic_fn_args::constrain_generic_fn_args(env, scope, fn_sigs, enum_defs, node, sig, infer_env, var_names, var_types, arg_types)
    // Resolve the callable's nominal receiver owner from the unified first
    // parameter, before unresolved element variables can defer the call.
    // MIR lowering consumes this per-call resolution instead of re-deriving
    // the owner from the receiver's local type spelling (#933 / #936).
    let receiver_owner = generic_call_receiver_owner(sig.clone(), var_names.clone(), var_types.clone())
    if receiver_owner.len() > 0 {
        contract_env_resolved_record::type_env_record_resolved_call_owner(
            env,
            ast_access::node_span_start(node),
            contract_fn_sig::FnSig_name(sig.clone()),
            receiver_owner
        )
    }
    // infer_env is scratch, so speculation diagnostics vanish with it:
    // set(m, k, v) on a HashMap adopted prelude::set<T>(Vec<T>) and lowered
    // to a map-corrupting Vec store (#874). The callee sig is already
    // chosen, so surviving unify errors are genuine mismatches. Re-issue
    // them against env only when every argument is already concrete;
    // arguments that still own type variables mark the call as deferred.
    if infer_env.error_count > 0 && generic_call_args_concrete(arg_types) {
        let mut speculation_error = 0
        while speculation_error < infer_env.error_count {
            unify::type_error(env, get_unchecked(infer_env.errors, speculation_error).clone())
            speculation_error = speculation_error + 1
        }
    }
    let inst_ret = instantiate::instantiate_type(contract_fn_sig::FnSig_return_type(sig), var_names, var_types)
    let projected_ret = associated_types::resolve_generic_call_type(env, infer_env, sig, var_names, var_types, inst_ret)
    let ret_ty = call_generic_resolve::resolve_call_return_type(infer_env, projected_ret)
    // An associated function of a generic impl can be called without binding
    // an impl type parameter that its own signature never mentions. That
    // parameter is not inferable from the call, but it is also absent from
    // the callee's parameter and return ABI. Give it the canonical scalar key
    // so the concrete call can mint a mono instance; otherwise the unresolved
    // fresh variable skips `record_mono_instance` and MIR emits the
    // drop+unreachable stub (#946).
    if call_generic_resolve::has_unresolved_fresh_type_arg(infer_env, var_types) {
        bind_uninferable_impl_type_params(
            env,
            infer_env,
            sig,
            fn_name.clone(),
            var_names.clone(),
            var_types.clone(),
            arg_types.clone()
        )
    }
    // Unresolved polymorphic calls must not mint mono instances.
    if call_generic_resolve::has_unresolved_fresh_type_arg(infer_env, var_types) {
        if arg_types.len() == 0 {
            report_unbindable_type_params(env, infer_env, var_names, var_types, projected_ret, fn_name)
        }
        return ret_ty
    }
    let resolved_type_args = call_generic_common::resolve_type_args(infer_env, var_types)
    traits::enforce_fn_sig_bounds(env, infer_env, sig, var_types)
    if !hashmap_api::validate_hashmap_constructor(env, fn_name.clone(), resolved_type_args) {
        return ret_ty
    }
    let mangled_name = mono::record_mono_instance(env, fn_name.clone(), resolved_type_args)
    mono::record_mono_return_type(env, mangled_name.clone(), ret_ty)
    mono::record_mono_call_site(env, ast_access::node_span_start(node), fn_name, mangled_name)
    ret_ty
}

fn generic_call_args_concrete(arg_types: Vec<TypeInfo>) -> bool {
    let count = arg_types.len()
    let mut i = 0
    while i < count {
        let arg_ty = get_unchecked(arg_types, i)
        if associated_types::type_contains_var(arg_ty.clone()) {
            return false
        }
        if contract_type_access::TypeInfo_tag(arg_ty) == commands::TY_UNKNOWN() {
            return false
        }
        i = i + 1
    }
    true
}

// An impl-level type parameter that the callee signature never mentions has
// no binding site in an associated-function call: it is not in any argument
// and not in the return type. The impl binder still contributes a type
// argument to the mono key. Defaulting it to the canonical scalar keeps the
// instance arity aligned with the impl and does not change the callee ABI,
// because the signature does not mention the parameter. Method-level
// parameters are deliberately not defaulted here: they keep the ADR-079
// deferral and diagnostic path (impl params occupy the head of `var_names`,
// matching the owner type's declared arity).
fn bind_uninferable_impl_type_params(
    env: TypeEnv,
    mut infer_env: TypeEnv,
    sig: FnSig,
    fn_name: String,
    var_names: Vec<String>,
    var_types: Vec<TypeInfo>,
    arg_types: Vec<TypeInfo>
) {
    if !generic_call_args_concrete(arg_types) {
        return
    }
    let impl_param_count = call_owner_type_param_count(env, fn_name.clone())
    let count = var_types.len()
    let mut i = 0
    while i < count && i < impl_param_count {
        let resolved = unify::resolve_type(infer_env, get_unchecked(var_types, i))
        if call_generic_resolve::is_unresolved_fresh_type_var(infer_env, resolved) &&
        !fn_sig_mentions_type_param(sig, get_unchecked(var_names, i)) {
            unify::bind_var(
                infer_env,
                contract_type_access::TypeInfo_name(resolved),
                contract_type_constructors::TypeInfo_simple(commands::TY_I32())
            )
        }
        i = i + 1
    }
}

fn fn_sig_mentions_type_param(sig: FnSig, param_name: String) -> bool {
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    let mut i = 0
    while i < param_count {
        if type_mentions_var(contract_fn_sig::FnSig_param_at(sig, i), param_name.clone()) {
            return true
        }
        i = i + 1
    }
    type_mentions_var(contract_fn_sig::FnSig_return_type(sig), param_name)
}

// The owner segment of an associated call (`Wrap::pass` -> `Wrap`,
// `module::Wrap::pass` -> `module::Wrap`). A bare function name has no owner.
fn call_owner_segment(name: String) -> String {
    let n = name.len()
    let mut last_separator = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if name.byte_at(i) == 58 && name.byte_at(i + 1) == 58 {
            last_separator = i
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if last_separator < 0 {
        return String_new()
    }
    name.slice(0, last_separator)
}

// Impl binder arity for an inherent/trait associated call. The owner's
// declared struct parameters are the impl-level prefix of the callee's
// merged parameter list. Owners that are not user structs (traits, builtins)
// return 0 and stay on the existing deferral path.
fn call_owner_type_param_count(env: TypeEnv, fn_name: String) -> i32 {
    let owner = call_owner_segment(fn_name.clone())
    if owner.len() == 0 {
        return 0
    }
    let base = names::unqualified_type_name(owner)
    let count = env.struct_defs.len()
    let mut i = 0
    while i < count {
        let def = get_unchecked(env.struct_defs, i)
        if contract_struct_info::StructInfo_name(def).eq(base.clone()) {
            return contract_struct_info::StructInfo_type_params(def).len()
        }
        i = i + 1
    }
    0
}

// On a zero-argument call, a fresh type variable that is unreachable from
// the instantiated return type can never be constrained by a later
// unification site (annotation or a subsequent call), so leaving it
// silent would let the call monomorphize with a meaningless type
// argument. Vars that appear in the return type may still be bound
// downstream and stay deferred on purpose.
fn report_unbindable_type_params(mut env: TypeEnv, infer_env: TypeEnv, var_names: Vec<String>, var_types: Vec<TypeInfo>, ret_ty: TypeInfo, fn_name: String) {
    let count = var_types.len()
    let mut i = 0
    while i < count {
        let resolved = unify::resolve_type(infer_env, get_unchecked(var_types, i))
        if call_generic_resolve::is_unresolved_fresh_type_var(infer_env, resolved) {
            let var_name = contract_type_access::TypeInfo_name(resolved)
            if !type_mentions_var(ret_ty, var_name) {
                unify::type_error(
                    env,
                    "cannot infer type parameter ".concat(get_unchecked(var_names, i).concat(" in call ".concat(fn_name.clone())))
                )
            }
        }
        i = i + 1
    }
}

fn type_mentions_var(ty: TypeInfo, var_name: String) -> bool {
    if contract_type_access::TypeInfo_tag(ty) == commands::TY_TYPE_VAR() {
        return contract_type_access::TypeInfo_name(ty).eq(var_name)
    }
    let count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut i = 0
    while i < count {
        if type_mentions_var(contract_type_access::TypeInfo_type_arg_at(ty, i), var_name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

// The nominal owner a generic free call resolves against, read from the
// instantiated first parameter. A call whose first parameter stays a type
// variable has no owner to bind and records nothing.
fn generic_call_receiver_owner(sig: FnSig, var_names: Vec<String>, var_types: Vec<TypeInfo>) -> String {
    if contract_fn_sig::FnSig_param_count(sig.clone()) < 1 {
        return String_new()
    }
    let first_param = instantiate::instantiate_type(
        contract_fn_sig::FnSig_param_at(sig, 0),
        var_names,
        var_types
    )
    let tag = contract_type_access::TypeInfo_tag(first_param)
    if tag == commands::TY_VEC() {
        return String_from("Vec")
    }
    if tag == commands::TY_STRING() {
        return String_from("String")
    }
    String_new()
}
