use std::prelude::{clone, eq}
use std::text
use typechecker::ast_access
use typechecker::call_generic_common
use typechecker::call_generic_fn_args
use typechecker::call_generic_resolve
use typechecker::call_generic_turbofish
use typechecker::associated_types
use typechecker::contract_fn_sig
use typechecker::contract_type_access
use typechecker::infer_env_scope
use typechecker::instantiate
use typechecker::hashmap_api
use typechecker::mono
use typechecker::traits
use typechecker::unify
fn infer_generic_call_expr(env: TypeEnv, scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode, sig: FnSig, fn_name: String) -> TypeInfo {
    let infer_env = infer_env_scope::borrow_generic_infer_env(env)
    let var_names = Vec::new<String>()
    let var_types = Vec::new<TypeInfo>()
    call_generic_common::append_generic_type_vars(infer_env, sig, var_names, var_types)
    // Explicit turbofish on the callee PATH (e.g. Vec::new<i32>) binds before
    // value-arg inference so zero-arg generics can monomorphize (#845).
    call_generic_turbofish::constrain_turbofish_type_args(
        ast_access::node_child_at(node, 0),
        infer_env,
        var_types
    )
    let arg_types = Vec::new<TypeInfo>()
    call_generic_fn_args::constrain_generic_fn_args(env, scope, fn_sigs, enum_defs, node, sig, infer_env, var_names, var_types, arg_types)
    // infer_env is scratch, so speculation diagnostics vanish with it:
    // set(m, k, v) on a HashMap adopted prelude::set<T>(Vec<T>) and lowered
    // to a map-corrupting Vec store (#874). The callee sig is already
    // chosen, so surviving unify errors are genuine mismatches. Re-issue
    // them against env only when every argument is already concrete;
    // arguments that still own type variables mark the call as deferred.
    if infer_env.error_count > 0 && generic_call_args_concrete(arg_types) {
        let mut speculation_error = 0
        while speculation_error < infer_env.error_count {
            unify::type_error(env, clone(get_unchecked(infer_env.errors, speculation_error)))
            speculation_error = speculation_error + 1
        }
    }
    let inst_ret = instantiate::instantiate_type(contract_fn_sig::FnSig_return_type(sig), var_names, var_types)
    let projected_ret = associated_types::resolve_generic_call_type(env, infer_env, sig, var_names, var_types, inst_ret)
    let ret_ty = call_generic_resolve::resolve_call_return_type(infer_env, projected_ret)
    // Unresolved polymorphic calls must not mint mono instances.
    if call_generic_resolve::has_unresolved_fresh_type_arg(infer_env, var_types) {
        if len(arg_types) == 0 {
            report_unbindable_type_params(env, infer_env, var_names, var_types, projected_ret, fn_name)
        }
        return ret_ty
    }
    let resolved_type_args = call_generic_common::resolve_type_args(infer_env, var_types)
    traits::enforce_fn_sig_bounds(env, infer_env, sig, var_types)
    if !hashmap_api::validate_hashmap_constructor(env, clone(fn_name), resolved_type_args) {
        return ret_ty
    }
    let mangled_name = mono::record_mono_instance(env, clone(fn_name), resolved_type_args)
    mono::record_mono_return_type(env, clone(mangled_name), ret_ty)
    mono::record_mono_call_site(env, ast_access::node_span_start(node), fn_name, mangled_name)
    ret_ty
}

fn generic_call_args_concrete(arg_types: Vec<TypeInfo>) -> bool {
    let count = len(arg_types)
    let mut i = 0
    while i < count {
        let arg_ty = get_unchecked(arg_types, i)
        if associated_types::type_contains_var(clone(arg_ty)) {
            return false
        }
        if contract_type_access::TypeInfo_tag(arg_ty) == commands::TY_UNKNOWN() {
            return false
        }
        i = i + 1
    }
    true
}

// On a zero-argument call, a fresh type variable that is unreachable from
// the instantiated return type can never be constrained by a later
// unification site (annotation or a subsequent call), so leaving it
// silent would let the call monomorphize with a meaningless type
// argument. Vars that appear in the return type may still be bound
// downstream and stay deferred on purpose.
fn report_unbindable_type_params(env: TypeEnv, infer_env: TypeEnv, var_names: Vec<String>, var_types: Vec<TypeInfo>, ret_ty: TypeInfo, fn_name: String) {
    let count = len(var_types)
    let mut i = 0
    while i < count {
        let resolved = unify::resolve_type(infer_env, get_unchecked(var_types, i))
        if call_generic_resolve::is_unresolved_fresh_type_var(infer_env, resolved) {
            let var_name = contract_type_access::TypeInfo_name(resolved)
            if !type_mentions_var(ret_ty, var_name) {
                unify::type_error(
                    env,
                    "cannot infer type parameter ".concat(get_unchecked(var_names, i).concat(" in call ".concat(clone(fn_name))))
                )
            }
        }
        i = i + 1
    }
}

fn type_mentions_var(ty: TypeInfo, var_name: String) -> bool {
    if contract_type_access::TypeInfo_tag(ty) == commands::TY_TYPE_VAR() {
        return eq(contract_type_access::TypeInfo_name(ty), var_name)
    }
    let count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut i = 0
    while i < count {
        if type_mentions_var(contract_type_access::TypeInfo_type_arg_at(ty, i), clone(var_name)) {
            return true
        }
        i = i + 1
    }
    false
}
