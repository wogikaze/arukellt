use typechecker::contract_types_record
struct MonoInstance {
    fn_name: String,
    mangled_name: String,
    type_args: Vec<TypeInfo>,
    return_type: TypeInfo,
    // Whether a real call edge demands this instance's body be emitted.
    // Instance demand is a closure over emitted bodies (#912): every
    // record_mono_instance mint is demanded, so the flag only stays false
    // for records pushed outside that path (call-site markers).
    demanded: bool,
    // Call-site markers only: the declaration index and body child index of
    // the body that recorded the site, in the combined loaded+entry decl
    // list. `node_span_start` is a byte offset inside one module's text, so
    // MIR scopes the span rewrite pool by this identity to keep equal offsets
    // in different modules apart (#934). -1 for real instances.
    site_decl_index: i32,
    site_body_child_index: i32,
}

struct MonoCallSite {
    decl_index: i32,
    body_child_index: i32,
    span_start: i32,
    fn_name: String,
    mangled_name: String,
}

// A mono recording whose resolved arguments still mention the enclosing
// function's type parameters (for example `inner.next()` on `Inner<I>`
// inside `Outer<I>::next`). The enclosing function's own instantiation
// supplies the concrete arguments later; the site is re-bound then so the
// callee instance exists for MIR lowering (demand-driven propagation,
// callee axis of ADR-078).
struct MonoTemplateSite {
    fn_name: String,
    mangled_name: String,
    type_args: Vec<TypeInfo>,
    enclosing_fn: String,
    enclosing_vars: Vec<String>,
    // True for sites recorded by a method call on a still-open type-var
    // receiver (`x.next()` on ?T): fn_name is the unqualified method
    // name and rebind resolves `Receiver::method` through the impl
    // table instead of recording a same-name instance (#912).
    is_var_method: bool,
}

fn MonoInstance_new(fn_name: String, mangled_name: String, type_args: Vec<TypeInfo>) -> MonoInstance {
    MonoInstance {
        fn_name: fn_name,
        mangled_name: mangled_name,
        type_args: type_args,
        return_type: contract_types_record::TypeInfo_new(
            commands::TY_UNKNOWN(),
            String_new(),
            Vec::new<TypeInfo>()
        ),
        demanded: false,
        site_decl_index: 0 - 1,
        site_body_child_index: 0 - 1
    }
}

fn MonoInstance_demanded(instance: MonoInstance) -> bool {
    instance.demanded
}

fn MonoInstance_set_demanded(mut instance: MonoInstance) {
    instance.demanded = true
}

fn MonoInstance_site_decl_index(instance: MonoInstance) -> i32 {
    instance.site_decl_index
}

fn MonoInstance_site_body_child_index(instance: MonoInstance) -> i32 {
    instance.site_body_child_index
}

fn MonoInstance_set_call_site(mut instance: MonoInstance, decl_index: i32, body_child_index: i32) {
    instance.site_decl_index = decl_index
    instance.site_body_child_index = body_child_index
}

fn MonoInstance_fn_name(instance: MonoInstance) -> String {
    instance.fn_name.clone()
}

fn MonoInstance_mangled_name(instance: MonoInstance) -> String {
    instance.mangled_name.clone()
}

fn MonoInstance_type_arg_count(instance: MonoInstance) -> i32 {
    instance.type_args.len()
}

fn MonoInstance_type_arg_at(instance: MonoInstance, index: i32) -> TypeInfo {
    instance.type_args.get_unchecked(index)
}

fn MonoInstance_return_type(instance: MonoInstance) -> TypeInfo {
    instance.return_type
}

fn MonoInstance_set_return_type(mut instance: MonoInstance, return_type: TypeInfo) {
    instance.return_type = return_type
}

fn MonoCallSite_new(
    decl_index: i32,
    body_child_index: i32,
    span_start: i32,
    fn_name: String,
    mangled_name: String
) -> MonoCallSite {
    MonoCallSite {
        decl_index: decl_index,
        body_child_index: body_child_index,
        span_start: span_start,
        fn_name: fn_name,
        mangled_name: mangled_name
    }
}

fn MonoCallSite_decl_index(site: MonoCallSite) -> i32 {
    site.decl_index
}

fn MonoCallSite_body_child_index(site: MonoCallSite) -> i32 {
    site.body_child_index
}

fn MonoCallSite_span_start(site: MonoCallSite) -> i32 {
    site.span_start
}

fn MonoCallSite_fn_name(site: MonoCallSite) -> String {
    site.fn_name.clone()
}
