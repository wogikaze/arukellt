use std::text
use diagnostics::codes
use diagnostics::record
use corehir::decl_impl_target
use typechecker::ast_access
use typechecker::ast_decl_predicates
use typechecker::contract_associated_type
use typechecker::contract_fn_sig
use typechecker::contract_trait_impl
use typechecker::contract_trait_impl_record
use typechecker::contract_trait_info
use typechecker::contract_type_access
use typechecker::impl_generics
use typechecker::kinds
use typechecker::names
use typechecker::trait_bounds
use typechecker::types
use diagnostics::mod as diag_mod
// Register declarations before impls so arity and associated-item checks use
// the same local trait registry as obligation solving.
use std::prelude::{clone, eq}

fn register_trait_decls(mut env: TypeEnv, decls: Vec<AstNode>) {
    let count = len(decls)
    let mut i = 0
    while i < count {
        let node = get_unchecked(decls, i)
        if ast_decl_predicates::node_is_trait_decl(node) {
            register_trait_decl(env, node)
        }
        i = i + 1
    }
}

fn register_trait_decl(mut env: TypeEnv, node: AstNode) {
    reject_trait_default_methods(env, node)
    let trait_name = ast_access::node_text(node)
    if trait_info_index(env, clone(trait_name)) >= 0 {
        return
    }
    let param_count = count_trait_type_params(node)
    let mut info = contract_trait_info::TraitInfo_new(clone(trait_name), param_count)
    let ann_count = ast_access::node_type_ann_count(node)
    let mut i = 0
    while i < ann_count {
        let ann = ast_access::node_type_ann_at(node, i)
        if ast_access::node_kind_is(ann, kinds::NK_ASSOC_TYPE()) {
            contract_trait_info::trait_info_push_associated_type(
                info,
                ast_access::node_text(ann)
            )
        } else if ast_access::node_kind_is(ann, kinds::NK_TRAIT_SUPER()) {
            contract_trait_info::trait_info_push_supertrait(
                info,
                ast_access::node_text(ann)
            )
        }
        i = i + 1
    }
    push(env.trait_defs, info)
}

// ADR-062 keeps default methods out of the v2 trait core. The parser records
// a body, but no impl instance is lowered for it; accepting it would resolve
// calls to the drop+unreachable fallback. Rejecting the body here makes this
// diagnostic the explicit blocker for adopting default methods later.
fn reject_trait_default_methods(mut env: TypeEnv, trait_node: AstNode) {
    let trait_name = ast_access::node_text(trait_node)
    let child_count = ast_access::node_child_count(trait_node)
    let mut i = 0
    while i < child_count {
        let child = ast_access::node_child_at(trait_node, i)
        if ast_decl_predicates::node_is_fn_decl(child) &&
        ast_decl_predicates::node_fn_has_body(child) {
            report_trait_error(
                env,
                codes::DIAG_TYPE_TRAIT_DEFAULT_METHOD(),
                String_from("trait method body is not supported (ADR-062): ").concat(clone(trait_name).concat("::".concat(ast_access::node_text(child))))
            )
        }
        i = i + 1
    }
}

fn count_trait_type_params(node: AstNode) -> i32 {
    let count = ast_access::node_type_ann_count(node)
    let mut total = 0
    let mut i = 0
    while i < count {
        let ann = ast_access::node_type_ann_at(node, i)
        if !ast_access::node_kind_is(ann, kinds::NK_ASSOC_TYPE()) &&
        !ast_access::node_kind_is(ann, kinds::NK_TRAIT_SUPER()) {
            total = total + 1
        }
        i = i + 1
    }
    total
}

fn register_trait_impl(mut env: TypeEnv, trait_name: String, self_ty: TypeInfo) {
    register_trait_impl_entry(
        env,
        trait_name,
        Vec::new<TypeInfo>(),
        self_ty,
        String_new(),
        Vec::new<TypeParamBounds>()
    )
}

fn register_trait_impl_entry(
    mut env: TypeEnv,
    trait_name: String,
    trait_args: Vec<TypeInfo>,
    self_ty: TypeInfo,
    display_self_ty: String,
    type_param_bounds: Vec<TypeParamBounds>
) {
    let count = len(env.trait_impls)
    let mut i = 0
    while i < count {
        let existing = get_unchecked(env.trait_impls, i)
        let existing_self = contract_trait_impl::TraitImplInfo_self_ty(existing)
        if names::same_type_name(
            contract_trait_impl::TraitImplInfo_trait_name(existing),
            clone(trait_name)
        ) && type_vec_equal(
            contract_trait_impl_record::trait_impl_info_trait_args(existing),
            trait_args
        ) && same_type(
            clone(existing_self),
            self_ty
        ) {
            let shown = if len(display_self_ty) > 0 {
                clone(display_self_ty)
            } else {
                names::type_display_name(self_ty)
            }
            report_trait_error(
                env,
                codes::DIAG_TYPE_TRAIT_CONFLICT(),
                String_from("overlapping trait impl: duplicate impl of ").concat(clone(trait_name).concat(" for ".concat(shown)))
            )
            return
        }
        // ADR-078: a parametric impl matches every instantiation of its self
        // constructor, so it conflicts with any other impl that shares the
        // (trait, constructor head) key — concrete or parametric.
        if names::same_type_name(
            contract_trait_impl::TraitImplInfo_trait_name(existing),
            clone(trait_name)
        ) && (type_contains_var(existing_self) || type_contains_var(self_ty)) &&
        impl_self_head_matches(existing_self, self_ty) {
            let shown = if len(display_self_ty) > 0 {
                clone(display_self_ty)
            } else {
                names::type_display_name(self_ty)
            }
            report_trait_error(
                env,
                codes::DIAG_TYPE_TRAIT_CONFLICT(),
                String_from("overlapping trait impl: parametric impl conflicts on ").concat(clone(trait_name).concat(" for ".concat(shown)))
            )
            return
        }
        i = i + 1
    }
    push(
        env.trait_impls,
        contract_trait_impl::TraitImplInfo_new(
            trait_name,
            trait_args,
            self_ty,
            type_param_bounds
        )
    )
}

fn maybe_register_impl_decl(mut env: TypeEnv, node: AstNode, known_type_names: Vec<String>) {
    if !ast_decl_predicates::node_is_impl_decl(node) {
        return
    }
    if report_undefined_impl_head_types(env, node, known_type_names) {
        return
    }
    if impl_generics::head_count(node) != 2 {
        return
    }
    let trait_node = ast_access::node_type_ann_at(node, 0)
    let self_node = ast_access::node_type_ann_at(node, 1)
    let type_params = decl_impl_target::effective_impl_param_names(
        node,
        clone(known_type_names)
    )
    let type_param_bounds = impl_generics::type_param_bounds(node)
    let trait_ref = types::resolve_type_ann_node_generic(trait_node, clone(type_params))
    let self_ty = types::resolve_type_ann_node_generic(self_node, clone(type_params))
    let trait_name = ast_access::node_text(trait_node)
    let trait_args = type_args(trait_ref)
    if !validate_trait_arity(env, clone(trait_name), len(trait_args)) {
        return
    }
    if !validate_impl_param_constraints(env, node, clone(self_ty)) {
        return
    }
    let contains_var = type_contains_var(trait_ref) || type_contains_var(self_ty)
    let mut is_parametric = false
    if contains_var && !is_compiler_owned_blanket(clone(trait_name), self_ty) {
        // ADR-078: a var-carrying impl is legal only as a parametric impl —
        // the self type must be a nominal constructor application and every
        // trait-reference variable must also appear in that self type. Bare
        // type-variable self types stay rejected as blanket impls.
        if !is_legal_parametric_impl(trait_ref, self_ty) {
            report_trait_error(
                env,
                codes::DIAG_TYPE_TRAIT_BLANKET(),
                String_from("blanket trait impl is not allowed for user code: ").concat(clone(trait_name))
            )
            return
        }
        is_parametric = true
    }
    register_trait_impl_entry(
        env,
        clone(trait_name),
        trait_args,
        self_ty,
        ast_access::node_text(self_node),
        type_param_bounds
    )
    if !contains_var || is_parametric {
        register_impl_associated_types(
            env,
            clone(trait_name),
            types::resolve_type_ann_node(self_node),
            type_params,
            node
        )
    }
}

// ADR-089 during the ADR-014 migration window: a binder-less head that used
// the retired single-uppercase spelling still infers those names as
// parameters (corehir::decl_impl_target::effective_impl_param_names), and this
// reports W0222 with the binder form. A declared nominal name never reaches
// here, so `impl Copy for S` for a declared `struct S` keeps its #946 meaning.
// A binder-present undefined name, `--strict`, or a closed window reports
// E0222 and aborts registration.
fn report_undefined_impl_head_types(mut env: TypeEnv, node: AstNode, known_type_names: Vec<String>) -> bool {
    let undefined = decl_impl_target::undefined_impl_head_type_names(node, known_type_names)
    let count = len(undefined)
    if count == 0 {
        return false
    }
    let is_window = !impl_generics::has_binder(node) &&
    !env.strict_impl_binders &&
    decl_impl_target::adr089_binder_window_is_open()
    let mut i = 0
    while i < count {
        let name = get_unchecked(undefined, i)
        if is_window {
            let message = String_from("implicit impl type parameter `").concat(
                clone(name).concat(
                    String_from("` is accepted in the ADR-014 migration window; add an explicit impl type parameter binder such as `impl<").concat(
                        clone(name).concat(String_from(">`"))
                    )
                )
            )
            report_trait_warning_at(env, codes::DIAG_WARN_IMPL_TYPE_PARAM(), node, message)
        } else {
            let message = String_from("undefined type `").concat(
                clone(name).concat(
                    String_from("` in impl head: add an explicit impl type parameter binder such as `impl<").concat(
                        clone(name).concat(String_from(">`"))
                    )
                )
            )
            report_trait_error_at(env, codes::DIAG_TYPE_IMPL_PARAM(), node, message)
        }
        i = i + 1
    }
    !is_window
}

fn report_trait_error_at(mut env: TypeEnv, code: String, node: AstNode, message: String) {
    env.error_count = env.error_count + 1
    push(env.errors, clone(message))
    push(env.diagnostics, trait_diagnostic(code, diag_mod::SEV_ERROR(), node, message))
}

fn report_trait_warning_at(mut env: TypeEnv, code: String, node: AstNode, message: String) {
    push(env.warnings, trait_diagnostic(code, diag_mod::SEV_WARNING(), node, message))
}

fn trait_diagnostic(code: String, severity: i32, node: AstNode, message: String) -> Diagnostic {
    let span = record::DiagnosticSpan_from_raw(
        ast_access::node_span_start(node),
        ast_access::node_span_end(node)
    )
    diag_mod::Diagnostic_new(code, severity, span, message)
}

// ADR-078 §2 rejects an impl parameter that never reaches the self type: it
// could only be instantiated by guessing from trait arguments or method
// bodies, which leaves the obligation unconstrained. Only binder-declared
// parameters participate (ADR-089).
fn validate_impl_param_constraints(mut env: TypeEnv, node: AstNode, self_ty: TypeInfo) -> bool {
    let declared = impl_generics::declared_type_param_names(node)
    let mut i = 0
    while i < len(declared) {
        let name = get_unchecked(declared, i)
        if !type_contains_named_var(self_ty, clone(name)) {
            report_trait_error(
                env,
                codes::DIAG_TYPE_TRAIT_BOUND(),
                String_from("impl type parameter `").concat(name.concat("` is not constrained by the self type"))
            )
            return false
        }
        i = i + 1
    }
    true
}

fn type_contains_named_var(ty: TypeInfo, name: String) -> bool {
    if contract_type_access::TypeInfo_tag(ty) == commands::TY_TYPE_VAR() &&
    eq(contract_type_access::TypeInfo_name(ty), clone(name)) {
        return true
    }
    let count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut i = 0
    while i < count {
        if type_contains_named_var(
            contract_type_access::TypeInfo_type_arg_at(ty, i),
            clone(name)
        ) {
            return true
        }
        i = i + 1
    }
    false
}

fn validate_trait_supertraits(mut env: TypeEnv) {
    let impl_count = len(env.trait_impls)
    let mut i = 0
    while i < impl_count {
        let impl_info = get_unchecked(env.trait_impls, i)
        let trait_name = contract_trait_impl::TraitImplInfo_trait_name(impl_info)
        let trait_info = trait_info_at(env, clone(trait_name))
        let super_count = contract_trait_info::trait_info_supertrait_count(trait_info)
        let self_ty = contract_trait_impl::TraitImplInfo_self_ty(impl_info)
        let mut j = 0
        while j < super_count {
            let super_name = contract_trait_info::trait_info_supertrait_at(trait_info, j)
            let super_ty = types::resolve_type_name(clone(super_name))
            if !trait_bounds::type_satisfies_trait_bound(env, self_ty, super_ty) {
                let displayed_self = names::type_display_name(self_ty)
                let message = String_from("trait `").concat(clone(trait_name).concat("` requires supertrait `".concat(clone(super_name).concat("` for ".concat(displayed_self)))))
                report_trait_error(
                    env,
                    codes::DIAG_TYPE_TRAIT_BOUND(),
                    message
                )
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn is_compiler_owned_blanket(trait_name: String, self_ty: TypeInfo) -> bool {
    if !eq(clone(trait_name), "Ord") {
        return false
    }
    if !eq(contract_type_access::TypeInfo_name(self_ty), "Reverse") {
        return false
    }
    if contract_type_access::TypeInfo_type_arg_count(self_ty) != 1 {
        return false
    }
    contract_type_access::TypeInfo_tag(
        contract_type_access::TypeInfo_type_arg_at(self_ty, 0)
    ) == commands::TY_TYPE_VAR()
}

fn register_impl_associated_types(
    mut env: TypeEnv,
    trait_name: String,
    self_ty: TypeInfo,
    type_params: Vec<String>,
    impl_node: AstNode
) {
    let trait_info = trait_info_at(env, clone(trait_name))
    let is_known_trait = contract_trait_info::trait_info_type_param_count(trait_info) >= 0
    let ann_count = ast_access::node_type_ann_count(impl_node)
    let mut i = 2
    while i < ann_count {
        let assoc = ast_access::node_type_ann_at(impl_node, i)
        if !ast_access::node_kind_is(assoc, kinds::NK_ASSOC_TYPE()) {
            i = i + 1
            continue
        }
        let assoc_name = ast_access::node_text(assoc)
        if !is_known_trait || !trait_has_associated_type(trait_info, clone(assoc_name)) {
            report_trait_error(
                env,
                codes::DIAG_TYPE_ASSOCIATED_ITEM(),
                String_from("associated type `").concat(clone(assoc_name).concat("` is not declared by trait"))
            )
            i = i + 1
            continue
        }
        if ast_access::node_type_ann_count(assoc) == 0 {
            report_trait_error(
                env,
                codes::DIAG_TYPE_ASSOCIATED_ITEM(),
                String_from("associated type `").concat(clone(assoc_name).concat("` requires an impl definition"))
            )
            i = i + 1
            continue
        }
        let value_node = ast_access::node_type_ann_at(assoc, 0)
        let value_ty = types::resolve_type_ann_node_generic(value_node, type_params)
        if associated_type_impl_exists(env, clone(trait_name), self_ty, clone(assoc_name)) {
            report_trait_error(
                env,
                codes::DIAG_TYPE_ASSOCIATED_ITEM(),
                String_from("duplicate associated type definition: `").concat(clone(assoc_name).concat("`"))
            )
        } else {
            push(
                env.associated_types,
                contract_associated_type::TraitAssociatedTypeInfo_new(
                    clone(trait_name),
                    self_ty,
                    clone(assoc_name),
                    value_ty
                )
            )
        }
        i = i + 1
    }
    require_associated_type_definitions(env, clone(trait_name), self_ty, trait_info)
}

fn require_associated_type_definitions(
    mut env: TypeEnv,
    trait_name: String,
    self_ty: TypeInfo,
    trait_info: TraitInfo
) {
    let count = contract_trait_info::trait_info_associated_type_count(trait_info)
    let mut i = 0
    while i < count {
        let name = contract_trait_info::trait_info_associated_type_at(trait_info, i)
        if !associated_type_impl_exists(env, clone(trait_name), self_ty, clone(name)) {
            report_trait_error(
                env,
                codes::DIAG_TYPE_ASSOCIATED_ITEM(),
                String_from("impl is missing associated type `").concat(clone(name).concat("`"))
            )
        }
        i = i + 1
    }
}

fn associated_type_impl_exists(
    env: TypeEnv,
    trait_name: String,
    self_ty: TypeInfo,
    assoc_name: String
) -> bool {
    let count = len(env.associated_types)
    let mut i = 0
    while i < count {
        let entry = get_unchecked(env.associated_types, i)
        if names::same_type_name(
            contract_associated_type::trait_associated_type_info_trait_name(entry),
            clone(trait_name)
        ) && eq(
            contract_associated_type::trait_associated_type_info_name(entry),
            clone(assoc_name)
        ) && same_type(
            contract_associated_type::trait_associated_type_info_self_ty(entry),
            self_ty
        ) {
            return true
        }
        i = i + 1
    }
    false
}

fn trait_has_associated_type(info: TraitInfo, name: String) -> bool {
    let count = contract_trait_info::trait_info_associated_type_count(info)
    let mut i = 0
    while i < count {
        if eq(
            contract_trait_info::trait_info_associated_type_at(info, i),
            clone(name)
        ) {
            return true
        }
        i = i + 1
    }
    false
}

fn validate_trait_arity(mut env: TypeEnv, trait_name: String, actual: i32) -> bool {
    let info = trait_info_at(env, clone(trait_name))
    let expected = contract_trait_info::trait_info_type_param_count(info)
    if expected < 0 || expected == actual {
        return true
    }
    report_trait_error(
        env,
        codes::DIAG_TYPE_TRAIT_ARITY(),
        String_from("trait `").concat(clone(trait_name).concat("` expects ".concat(expected.to_string().concat(" type argument(s), found ".concat(actual.to_string())))))
    )
    false
}

fn trait_info_index(env: TypeEnv, trait_name: String) -> i32 {
    let count = len(env.trait_defs)
    let mut i = 0
    while i < count {
        if names::same_type_name(
            contract_trait_info::trait_info_name(get_unchecked(env.trait_defs, i)),
            clone(trait_name)
        ) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn trait_info_at(env: TypeEnv, trait_name: String) -> TraitInfo {
    let index = trait_info_index(env, clone(trait_name))
    if index < 0 {
        return contract_trait_info::TraitInfo_new(String_new(), 0 - 1)
    }
    get_unchecked(env.trait_defs, index)
}

fn string_vec_contains(names: Vec<String>, name: String) -> bool {
    let count = len(names)
    let mut i = 0
    while i < count {
        if eq(get_unchecked(names, i), clone(name)) {
            return true
        }
        i = i + 1
    }
    false
}

fn type_args(ty: TypeInfo) -> Vec<TypeInfo> {
    let mut args = Vec::new<TypeInfo>()
    let count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut i = 0
    while i < count {
        push(args, contract_type_access::TypeInfo_type_arg_at(ty, i))
        i = i + 1
    }
    args
}

fn type_contains_var(ty: TypeInfo) -> bool {
    if contract_type_access::TypeInfo_tag(ty) == commands::TY_TYPE_VAR() {
        return true
    }
    let count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut i = 0
    while i < count {
        if type_contains_var(contract_type_access::TypeInfo_type_arg_at(ty, i)) {
            return true
        }
        i = i + 1
    }
    false
}

// Constructor-head comparison for the parametric-impl overlap check.
// Builtin container types (TY_VEC, TY_HASHMAP, TY_OPTION, ...) carry no
// TypeInfo name, so an empty-name equality would collapse every builtin
// head onto the same key — a parametric HashMap<K,V> impl would then
// "conflict" with unrelated Vec impls. When either side is nameless the
// tag is the head; named types keep the usual name comparison (#691).
fn impl_self_head_matches(a: TypeInfo, b: TypeInfo) -> bool {
    let a_name = contract_type_access::TypeInfo_name(a)
    let b_name = contract_type_access::TypeInfo_name(b)
    if len(a_name) == 0 || len(b_name) == 0 {
        return contract_type_access::TypeInfo_tag(a) == contract_type_access::TypeInfo_tag(b)
    }
    names::same_type_name(a_name, b_name)
}

// ADR-078: a var-carrying impl is a legal parametric impl when its self type
// is a nominal constructor application (not a bare type variable) and every
// type variable in the trait reference also appears in the self type — an
// impl parameter that never reaches the self type is unconstrained.
fn is_legal_parametric_impl(trait_ref: TypeInfo, self_ty: TypeInfo) -> bool {
    if contract_type_access::TypeInfo_tag(self_ty) == commands::TY_TYPE_VAR() {
        return false
    }
    let mut self_vars = Vec::new<String>()
    collect_type_var_names(self_ty, self_vars)
    let mut trait_vars = Vec::new<String>()
    collect_type_var_names(trait_ref, trait_vars)
    let count = len(trait_vars)
    let mut i = 0
    while i < count {
        if !string_vec_contains(self_vars, get_unchecked(trait_vars, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn collect_type_var_names(ty: TypeInfo, mut out: Vec<String>) {
    if contract_type_access::TypeInfo_tag(ty) == commands::TY_TYPE_VAR() {
        let name = contract_type_access::TypeInfo_name(ty)
        if !string_vec_contains(out, clone(name)) {
            push(out, name)
        }
        return
    }
    let count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut i = 0
    while i < count {
        collect_type_var_names(contract_type_access::TypeInfo_type_arg_at(ty, i), out)
        i = i + 1
    }
}

fn same_type(a: TypeInfo, b: TypeInfo) -> bool {
    if !trait_type_tags_match(
        contract_type_access::TypeInfo_tag(a),
        contract_type_access::TypeInfo_tag(b)
    ) ||
    !names::same_type_name(
        contract_type_access::TypeInfo_name(a),
        contract_type_access::TypeInfo_name(b)
    ) {
        return false
    }
    type_vec_equal(type_args(a), type_args(b))
}

fn type_vec_equal(a: Vec<TypeInfo>, b: Vec<TypeInfo>) -> bool {
    if len(a) != len(b) {
        return false
    }
    let mut i = 0
    while i < len(a) {
        if !same_type(get_unchecked(a, i), get_unchecked(b, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn trait_type_tags_match(a_tag: i32, b_tag: i32) -> bool {
    if a_tag == b_tag {
        return true
    }
    if a_tag == commands::TY_STRUCT() && b_tag == commands::TY_ENUM() {
        return true
    }
    if a_tag == commands::TY_ENUM() && b_tag == commands::TY_STRUCT() {
        return true
    }
    false
}

fn report_trait_error(mut env: TypeEnv, code: String, message: String) {
    env.error_count = env.error_count + 1
    push(env.errors, clone(message))
    let span = record::DiagnosticSpan_from_raw(0, 0)
    let diag = diag_mod::Diagnostic_new(code, diag_mod::SEV_ERROR(), span, message)
    push(env.diagnostics, diag)
}

fn reject_dyn_in_sig(mut env: TypeEnv, sig: FnSig) {
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    let mut i = 0
    while i < param_count {
        reject_dyn_in_type(env, contract_fn_sig::FnSig_param_at(sig, i))
        i = i + 1
    }
    reject_dyn_in_type(env, contract_fn_sig::FnSig_return_type(sig))
}

fn reject_dyn_in_type(mut env: TypeEnv, ty: TypeInfo) {
    if contract_type_access::TypeInfo_tag(ty) == commands::TY_STRUCT() &&
    contract_type_access::TypeInfo_name(ty).starts_with("dyn ") {
        report_trait_error(
            env,
            codes::DIAG_TYPE_DYN_TRAIT(),
            "dyn Trait requires a separate dynamic-dispatch ABI; use a generic trait bound"
        )
        return
    }
    let count = contract_type_access::TypeInfo_type_arg_count(ty)
    let mut i = 0
    while i < count {
        reject_dyn_in_type(env, contract_type_access::TypeInfo_type_arg_at(ty, i))
        i = i + 1
    }
}
