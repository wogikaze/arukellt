use std::text
use typechecker::kinds
use typechecker::ast_access
use typechecker::scope
use typechecker::ownership_types
use typechecker::ast_expr_predicates
use typechecker::contract_type_access
use typechecker::contract_type_constructors
use typechecker::names
use typechecker::unify
use parser::ast
use diagnostics::codes
use diagnostics::mod as diag_mod
use diagnostics::record as diag_record
fn check_assignment_target(mut env: TypeEnv, mut scope: LocalScope, target: AstNode) {
    if ast_expr_predicates::node_is_ident(target) {
        let name = ast_access::node_text(target)
        if scope::scope_binding_has_shared_borrow(scope, name.clone()) ||
        scope::scope_binding_has_mutable_borrow(scope, name.clone()) {
            report_ownership_error(
                env,
                codes::DIAG_TYPE_CLOSURE_BORROW_CONFLICT(),
                target,
                "cannot assign to borrowed capture `".concat(name.concat("`"))
            )
            return
        }
        if scope::scope_binding_is_shared_param(scope, name.clone()) {
            report_ownership_error(
                env,
                codes::DIAG_TYPE_SHARED_PARAM_MUTATION(),
                target,
                shared_param_mutation_message(name)
            )
            return
        }
        if !scope::scope_binding_is_mutable(scope, name.clone()) {
            report_ownership_error(
                env,
                codes::DIAG_TYPE_RETURN_MISMATCH(),
                target,
                "cannot assign to immutable variable ".concat(name)
            )
            return
        }
        scope::scope_mark_moved(scope, name, false)
        return
    }
    let kind = ast_access::node_kind(target)
    if kind == kinds::NK_FIELD_ACCESS() || kind == kinds::NK_INDEX() {
        if ast_access::node_child_count(target) > 0 {
            check_assignment_target(env, scope, ast_access::node_child_at(target, 0))
        }
    }
}

fn shared_param_mutation_message(name: String) -> String {
    if name.clone().eq("self") {
        return "cannot assign through shared receiver `self`; declare the method `mut self`"
    }
    "cannot assign through shared parameter `".concat(
        name.concat("`; declare it `mut ")
    ).concat(name.concat("`"))
}

fn consume_expr(mut env: TypeEnv, mut scope: LocalScope, node: AstNode) {
    if ast_expr_predicates::node_is_ident(node) {
        consume_identifier(env, scope, node)
        return
    }
    let kind = ast_access::node_kind(node)
    if kind == kinds::NK_FIELD_ACCESS() {
        return
    }
    if kind == kinds::NK_INDEX() {
        if ast_access::node_child_count(node) > 1 {
            consume_expr(env, scope, ast_access::node_child_at(node, 1))
        }
        return
    }
    if kind == kinds::NK_METHOD_CALL() {
        // `boxed.take()` consumes its receiver like the retired `unbox(b)`.
        // A user type may also define a `take` method; only the prelude
        // `Box<T>` receiver is the unique-owner boundary.
        if ast_access::node_text(node).eq("take") &&
        ast_access::node_child_count(node) > 0 &&
        box_typed_identifier(env, scope, ast_access::node_child_at(node, 0)) {
            consume_expr(env, scope, ast_access::node_child_at(node, 0))
        }
        return
    }
    if kind == kinds::NK_ASSIGN() ||
    kind == kinds::NK_PATH() || kind == kinds::NK_BLOCK() || kind == kinds::NK_BINARY() ||
    kind == kinds::NK_UNARY() || kind == kinds::NK_IF_EXPR() || kind == kinds::NK_MATCH_EXPR() ||
    kind == kinds::NK_CLOSURE() || kind == kinds::NK_COMPREHENSION() || kind == kinds::NK_TRY() {
        return
    }
    if kind == kinds::NK_CALL() {
        consume_box_boundary_argument(env, scope, node)
        return
    }
    if kind == kinds::NK_TUPLE() || kind == kinds::NK_ARRAY_LIT() {
        consume_aggregate_children(env, scope, node)
        return
    }
    if kind == kinds::NK_ARRAY_REPEAT() {
        if ast_access::node_child_count(node) > 0 {
            consume_expr(env, scope, ast_access::node_child_at(node, 0))
        }
        return
    }
    if kind == kinds::NK_STRUCT_LIT() {
        consume_struct_fields(env, scope, node)
        return
    }
}

fn consume_box_boundary_argument(mut env: TypeEnv, mut scope: LocalScope, node: AstNode) {
    if ast_access::node_child_count(node) < 2 {
        return
    }
    let callee = ast_access::node_child_at(node, 0)
    let callee_name = ast_access::node_text(callee)
    if is_box_new_callee(callee_name) {
        consume_expr(env, scope, ast_access::node_child_at(node, 1))
    }
}

// `Box::new(value)` is the associated-function replacement for `Box_new`.
// Module-qualified spellings may extend the path, so accept any suffix.
fn is_box_new_callee(callee_name: String) -> bool {
    callee_name.clone().eq("Box::new") ||
    callee_name.clone().ends_with(String_from("::Box::new"))
}

fn consume_aggregate_children(mut env: TypeEnv, mut scope: LocalScope, node: AstNode) {
    let child_count = ast_access::node_child_count(node)
    let mut i = 0
    while i < child_count {
        consume_expr(env, scope, ast_access::node_child_at(node, i))
        i = i + 1
    }
}

fn consume_struct_fields(mut env: TypeEnv, mut scope: LocalScope, node: AstNode) {
    let field_count = ast_access::node_child_count(node)
    let mut i = 0
    while i < field_count {
        let field = ast_access::node_child_at(node, i)
        if ast_access::node_child_count(field) > 0 {
            consume_expr(env, scope, ast_access::node_child_at(field, 0))
        }
        i = i + 1
    }
}

fn consume_identifier(mut env: TypeEnv, mut scope: LocalScope, node: AstNode) {
    let name = ast_access::node_text(node)
    if scope::scope_binding_index(scope, name.clone()) < 0 {
        return
    }
    if scope::scope_binding_is_copy(scope, name.clone()) {
        return
    }
    // ADR-088 §6: a `Box<T>` parameter is a call-scoped borrow of a unique
    // owner. Unlike other non-Copy parameters it cannot escape by sharing, so
    // any move out of the parameter would steal the caller's value. Report
    // the move here; the store/return walker covers positions that never call
    // consume_identifier.
    if borrowed_box_param(env, scope, name.clone()) {
        report_borrowed_box_escape(env, node, borrowed_box_escape_message(name))
        return
    }
    if !scope::scope_binding_is_function(scope, name.clone()) &&
    (scope::scope_binding_has_shared_borrow(scope, name.clone()) ||
        scope::scope_binding_has_mutable_borrow(scope, name.clone())) {
        report_ownership_error(
            env,
            codes::DIAG_TYPE_CLOSURE_BORROW_CONFLICT(),
            node,
            "cannot move borrowed capture `".concat(name.concat("`"))
        )
        return
    }
    if scope::scope_binding_is_moved(scope, name.clone()) {
        report_ownership_error_once(
            env,
            codes::DIAG_TYPE_MOVE_AFTER_USE(),
            node,
            move_after_use_message(name)
        )
        return
    }
    scope::scope_mark_moved(scope, name, true)
}

fn borrowed_box_param(env: TypeEnv, scope: LocalScope, name: String) -> bool {
    if !scope::scope_binding_is_param(scope, name.clone()) {
        return false
    }
    type_is_box(env, scope::scope_binding_type(scope, name))
}

// True for an identifier binding whose declared/inferred type is the prelude
// `Box<T>`. Method calls use this to distinguish the unique-owner `take` from
// an unrelated user method with the same name.
fn box_typed_identifier(env: TypeEnv, scope: LocalScope, node: AstNode) -> bool {
    if !ast_expr_predicates::node_is_ident(node) {
        return false
    }
    let name = ast_access::node_text(node)
    if scope::scope_binding_index(scope, name.clone()) < 0 {
        return false
    }
    type_is_box(env, scope::scope_binding_type(scope, name))
}

// The prelude `Box<T>` is a generic enum. A user non-generic `struct Box`
// shadows only the bare name, so requiring a type argument distinguishes the
// unique-owner type from the shadowing struct.
fn type_is_box(env: TypeEnv, ty: TypeInfo) -> bool {
    let resolved = unify::resolve_type(env, ty)
    let tag = contract_type_access::TypeInfo_tag(resolved)
    if tag != commands::TY_STRUCT() && tag != commands::TY_ENUM() {
        return false
    }
    if !contract_type_access::TypeInfo_name(resolved).eq(String_from("Box")) {
        return false
    }
    contract_type_access::TypeInfo_type_arg_count(resolved) >= 1
}

// The expression-statement pass and the tail pass both visit a block's last
// expression, so the same node can reach the walker twice. Suppress the
// second report for the same span while still allowing two distinct uses.
fn report_borrowed_box_escape(mut env: TypeEnv, node: AstNode, message: String) {
    report_ownership_error_once(env, codes::DIAG_TYPE_BORROWED_BOX_ESCAPE(), node, message)
}

// ADR-088 §1: an argument or receiver is read for the call, not moved. A place
// rooted at a binding that was already moved is still a use of a moved value
// (E0212), exactly like any other use. The call shape (free call, method call,
// function value, builtin) does not change the rule, so inference dispatches
// every call through this single check before resolving the callee.
fn check_call_place_uses(mut env: TypeEnv, scope: LocalScope, node: AstNode, first_use: i32) {
    if !env.is_ownership_tracking_enabled {
        return
    }
    let count = ast_access::node_child_count(node)
    let mut i = first_use
    while i < count {
        check_moved_place_use(env, scope, ast_access::node_child_at(node, i))
        i = i + 1
    }
}

fn check_moved_place_use(mut env: TypeEnv, scope: LocalScope, node: AstNode) {
    if ast_expr_predicates::node_is_ident(node) {
        let name = ast_access::node_text(node)
        if is_moved_binding(scope, name.clone()) {
            report_ownership_error_once(
                env,
                codes::DIAG_TYPE_MOVE_AFTER_USE(),
                node,
                move_after_use_message(name)
            )
        }
        return
    }
    let kind = ast_access::node_kind(node)
    if kind == kinds::NK_FIELD_ACCESS() || kind == kinds::NK_INDEX() {
        if ast_access::node_child_count(node) > 0 {
            check_moved_place_use(env, scope, ast_access::node_child_at(node, 0))
        }
    }
}

// ADR-059 §4: every evaluation of a non-`Copy` binding after it was moved is
// E0212, not only a call argument or receiver. Expression inference reaches
// this for each identifier it evaluates, so return values, operands, and
// field-read roots share the call position's moved/Copy predicate. The call
// and move paths report the same span through report_ownership_error_once.
fn check_moved_binding_use(mut env: TypeEnv, scope: LocalScope, node: AstNode) {
    if !env.is_ownership_tracking_enabled {
        return
    }
    let name = ast_access::node_text(node)
    if !is_moved_binding(scope, name.clone()) {
        return
    }
    report_ownership_error_once(
        env,
        codes::DIAG_TYPE_MOVE_AFTER_USE(),
        node,
        move_after_use_message(name)
    )
}

fn is_moved_binding(scope: LocalScope, name: String) -> bool {
    if scope::scope_binding_index(scope, name.clone()) < 0 {
        return false
    }
    if scope::scope_binding_is_copy(scope, name.clone()) {
        return false
    }
    scope::scope_binding_is_moved(scope, name)
}

// A moved place cannot be a mutable borrow either. The call argument already
// carries E0212, so the mut-place check must not add a second diagnostic for
// the same argument.
fn is_moved_place(scope: LocalScope, node: AstNode) -> bool {
    if ast_expr_predicates::node_is_ident(node) {
        return is_moved_binding(scope, ast_access::node_text(node))
    }
    let kind = ast_access::node_kind(node)
    if kind == kinds::NK_FIELD_ACCESS() || kind == kinds::NK_INDEX() {
        if ast_access::node_child_count(node) < 1 {
            return false
        }
        return is_moved_place(scope, ast_access::node_child_at(node, 0))
    }
    false
}

// Re-inference paths (method resolution fallbacks, the statement and tail
// passes) can visit the same node twice. A second identical code+span pair is
// the same finding, not two distinct uses.
fn report_ownership_error_once(mut env: TypeEnv, code: String, node: AstNode, message: String) {
    if diagnostic_exists_at(
        env,
        code.clone(),
        ast_access::node_span_start(node),
        ast_access::node_span_end(node)
    ) {
        return
    }
    report_ownership_error(env, code, node, message)
}

fn diagnostic_exists_at(env: TypeEnv, code: String, start: i32, end: i32) -> bool {
    let mut i = 0
    while i < env.diagnostics.len() {
        let diag = env.diagnostics.get_unchecked(i)
        if diag_record::diagnostic_code(diag).eq(code.clone()) &&
        diag_record::diagnostic_start(diag) == start &&
        diag_record::diagnostic_end(diag) == end {
            return true
        }
        i = i + 1
    }
    false
}

fn borrowed_box_escape_message(name: String) -> String {
    "borrowed `Box<T>` parameter `".concat(
        name.concat("` cannot be returned, stored, or unboxed")
    )
}

// Walk the value-producing shapes of an expression and reject a borrowed
// `Box<T>` parameter in an escape position (ADR-088 §6). `if` and `match`
// contribute only their branch values: the condition and the match scrutinee
// are reads, not escapes. Read positions still recurse through
// check_borrowed_box_nested_escape so a store nested inside a larger
// expression is not hidden by the outer shape.
fn check_borrowed_box_escape(mut env: TypeEnv, scope: LocalScope, node: AstNode) {
    if ast_expr_predicates::node_is_ident(node) {
        let name = ast_access::node_text(node)
        if borrowed_box_param(env, scope, name.clone()) {
            report_borrowed_box_escape(env, node, borrowed_box_escape_message(name))
        }
        return
    }
    let kind = ast_access::node_kind(node)
    if kind == kinds::NK_EXPR_STMT() {
        check_borrowed_box_escape_child(env, scope, node, 0)
        return
    }
    if kind == kinds::NK_BLOCK() {
        let count = ast_access::node_child_count(node)
        check_borrowed_box_escape_child(env, scope, node, count - 1)
        return
    }
    if kind == kinds::NK_IF_EXPR() {
        let count = ast_access::node_child_count(node)
        check_borrowed_box_nested_escape(env, scope, ast_access::node_child_at(node, 0))
        let mut i = 1
        while i < count {
            check_borrowed_box_escape(env, scope, ast_access::node_child_at(node, i))
            i = i + 1
        }
        return
    }
    if kind == kinds::NK_MATCH_EXPR() {
        check_borrowed_box_nested_escape(env, scope, ast_access::node_child_at(node, 0))
        check_borrowed_box_escape_match_arms(env, scope, node)
        return
    }
    if kind == kinds::NK_TUPLE() || kind == kinds::NK_ARRAY_LIT() {
        let count = ast_access::node_child_count(node)
        let mut i = 0
        while i < count {
            check_borrowed_box_escape(env, scope, ast_access::node_child_at(node, i))
            i = i + 1
        }
        return
    }
    if kind == kinds::NK_ARRAY_REPEAT() {
        check_borrowed_box_escape_child(env, scope, node, 0)
        return
    }
    if kind == kinds::NK_STRUCT_LIT() {
        check_borrowed_box_escape_struct_fields(env, scope, node)
        return
    }
    if kind == kinds::NK_ASSIGN() {
        check_borrowed_box_nested_escape(env, scope, ast_access::node_child_at(node, 0))
        check_borrowed_box_escape_child(env, scope, node, 1)
        return
    }
    if kind == kinds::NK_CALL() {
        check_borrowed_box_escape_call_args(env, scope, node)
        return
    }
    // The remaining shapes are reads: an operand, receiver, index, or range
    // may contain a store, but the identifier itself is a shared read.
    check_borrowed_box_nested_escape(env, scope, node)
}

// Report a store reached through an otherwise read-only expression.
// `Box::new`, `.take()`, and aggregate constructors move the borrowed Box no
// matter how deeply they are nested (binary operand, call argument, method
// receiver...).
fn check_borrowed_box_nested_escape(mut env: TypeEnv, scope: LocalScope, node: AstNode) {
    let kind = ast_access::node_kind(node)
    if kind == kinds::NK_IDENT() || kind == kinds::NK_PATH() ||
    kind == kinds::NK_CLOSURE() {
        return
    }
    if kind == kinds::NK_METHOD_CALL() {
        if ast_access::node_text(node).eq("take") && ast_access::node_child_count(node) > 0 {
            check_borrowed_box_escape(env, scope, ast_access::node_child_at(node, 0))
        }
        check_borrowed_box_nested_children(env, scope, node, 1)
        return
    }
    if kind == kinds::NK_CALL() {
        if ast_access::node_child_count(node) > 0 &&
        is_borrowed_box_sink_callee(ast_access::node_text(ast_access::node_child_at(node, 0))) {
            check_borrowed_box_escape(env, scope, node)
            return
        }
        check_borrowed_box_nested_children(env, scope, node, 1)
        return
    }
    if kind == kinds::NK_TUPLE() || kind == kinds::NK_ARRAY_LIT() ||
    kind == kinds::NK_ARRAY_REPEAT() || kind == kinds::NK_STRUCT_LIT() ||
    kind == kinds::NK_ASSIGN() {
        check_borrowed_box_escape(env, scope, node)
        return
    }
    check_borrowed_box_nested_children(env, scope, node, 0)
}

fn check_borrowed_box_nested_children(mut env: TypeEnv, scope: LocalScope, node: AstNode, first: i32) {
    let count = ast_access::node_child_count(node)
    let mut i = first
    while i < count {
        check_borrowed_box_nested_escape(env, scope, ast_access::node_child_at(node, i))
        i = i + 1
    }
}

fn check_borrowed_box_escape_child(mut env: TypeEnv, scope: LocalScope, node: AstNode, index: i32) {
    if index < 0 || index >= ast_access::node_child_count(node) {
        return
    }
    check_borrowed_box_escape(env, scope, ast_access::node_child_at(node, index))
}

fn check_borrowed_box_escape_match_arms(mut env: TypeEnv, scope: LocalScope, node: AstNode) {
    let count = ast_access::node_child_count(node)
    let mut i = 1
    while i < count {
        let arm = ast_access::node_child_at(node, i)
        check_borrowed_box_escape_child(env, scope, arm, ast_access::node_child_count(arm) - 1)
        i = i + 1
    }
}

fn check_borrowed_box_escape_struct_fields(mut env: TypeEnv, scope: LocalScope, node: AstNode) {
    let count = ast_access::node_child_count(node)
    let mut i = 0
    while i < count {
        let field = ast_access::node_child_at(node, i)
        check_borrowed_box_escape_child(env, scope, field, 0)
        i = i + 1
    }
}

// `Box::new` stores its argument in a fresh aggregate and `.take()` consumes
// its receiver, while the builtin `Option`/`Result` payload constructors
// store it in a fresh aggregate. The builtin constructors are not source enum
// defs, so the enum-constructor argument check in call_fn.ark never sees
// `Option::Some`, `Ok`, or `Err`.
fn is_borrowed_box_sink_callee(callee_name: String) -> bool {
    if is_box_new_callee(callee_name.clone()) {
        return true
    }
    let leaf = names::unqualified_type_name(callee_name)
    leaf.clone().eq("Some") || leaf.clone().eq("Ok") || leaf.eq("Err")
}

fn check_borrowed_box_escape_call_args(mut env: TypeEnv, scope: LocalScope, node: AstNode) {
    if ast_access::node_child_count(node) < 1 {
        return
    }
    let callee_name = ast_access::node_text(ast_access::node_child_at(node, 0))
    let count = ast_access::node_child_count(node)
    let mut i = 1
    if is_borrowed_box_sink_callee(callee_name) {
        while i < count {
            check_borrowed_box_escape(env, scope, ast_access::node_child_at(node, i))
            i = i + 1
        }
        return
    }
    // A call argument is a read, but a store nested inside it is still an
    // escape; recurse instead of reporting the argument root.
    while i < count {
        check_borrowed_box_nested_escape(env, scope, ast_access::node_child_at(node, i))
        i = i + 1
    }
}

// E0212 is also the v2 alias->move/borrow migration diagnostic (#878):
// code written under implicit sharing now needs an explicit clone or
// borrow, so the message points at both remedies.
fn move_after_use_message(name: String) -> String {
    "use of moved value `".concat(name.concat("`; v2 uses move semantics; call `.clone()` before moving or borrow instead"))
}

fn expr_is_copy(env: TypeEnv, scope: LocalScope, node: AstNode, inferred_ty: TypeInfo) -> bool {
    if ast_expr_predicates::node_is_ident(node) {
        let name = ast_access::node_text(node)
        if scope::scope_binding_index(scope, name.clone()) >= 0 {
            return scope::scope_binding_is_copy(scope, name)
        }
    }
    let kind = ast_access::node_kind(node)
    if kind == kinds::NK_TUPLE() || kind == kinds::NK_ARRAY_LIT() {
        return aggregate_children_are_copy(env, scope, node)
    }
    if kind == kinds::NK_ARRAY_REPEAT() {
        if ast_access::node_child_count(node) == 0 {
            return false
        }
        return expr_is_copy(env, scope, ast_access::node_child_at(node, 0), inferred_ty)
    }
    if ast_expr_predicates::node_is_struct_lit(node) {
        return ownership_types::type_is_copy(env, inferred_ty)
    }
    if ast_expr_predicates::node_is_int_lit(node) || ast_expr_predicates::node_is_float_lit(node) ||
    ast_expr_predicates::node_is_bool_lit(node) || ast_expr_predicates::node_is_char_lit(node) {
        return true
    }
    ownership_types::type_is_copy(env, inferred_ty)
}

fn aggregate_children_are_copy(env: TypeEnv, scope: LocalScope, node: AstNode) -> bool {
    let count = ast_access::node_child_count(node)
    let mut i = 0
    while i < count {
        if !expr_is_copy(
            env,
            scope,
            ast_access::node_child_at(node, i),
            contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
        ) {
            return false
        }
        i = i + 1
    }
    true
}

fn report_ownership_error(mut env: TypeEnv, code: String, node: AstNode, message: String) {
    env.error_count = env.error_count + 1
    env.errors.push(message.clone())
    let span = diag_record::DiagnosticSpan_from_raw(
        ast_access::node_span_start(node),
        ast::ast_node_span_end(node)
    )
    let diag = diag_mod::Diagnostic_new(code, diag_mod::SEV_ERROR(), span, message)
    env.diagnostics.push(diag)
}
