use typechecker::kinds

fn is_comparison_op(op: i32) -> bool {
    if op == kinds::OP_EQ() {
        return true
    }
    if op == kinds::OP_NEQ() {
        return true
    }
    if op == kinds::OP_LT() {
        return true
    }
    if op == kinds::OP_LTEQ() {
        return true
    }
    if op == kinds::OP_GT() {
        return true
    }
    if op == kinds::OP_GTEQ() {
        return true
    }
    false
}

fn is_logical_op(op: i32) -> bool {
    if op == kinds::OP_AND() {
        return true
    }
    if op == kinds::OP_OR() {
        return true
    }
    false
}

// Arithmetic / bitwise operators (not comparison or logical).
// Parser op codes: ADD..MOD = 1..5, BIT_* / shifts = 14..18.
fn is_value_operator(op: i32) -> bool {
    if is_comparison_op(op) || is_logical_op(op) {
        return false
    }
    op >= 1 && op <= 18
}
