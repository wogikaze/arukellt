use std::prelude::{eq}
use std::text
use typechecker::ast_access
use typechecker::contract_env_record
use typechecker::kinds
use typechecker::ownership
use typechecker::scope
use diagnostics::codes
use diagnostics::mod as diag_mod
use diagnostics::record as diag_record
fn capture_shared_borrow() -> i32 { 1 }
fn capture_mutable_borrow() -> i32 { 2 }
fn capture_move() -> i32 { 3 }

struct ClosureCaptureSummary {
    names: Vec<String>,
    modes: Vec<i32>,
    nodes: Vec<AstNode>,
    rebinds: Vec<i32>,
    include_copy: bool,
}

struct CaptureEscape {
    mode: i32,
    span_start: i32,
    span_end: i32,
}

fn ClosureCaptureSummary_new() -> ClosureCaptureSummary {
    ClosureCaptureSummary {
        names: Vec::new<String>(),
        modes: Vec::new<i32>(),
        nodes: Vec::new<AstNode>(),
        rebinds: Vec::new<i32>(),
        include_copy: false,
    }
}

// Escape checking needs every free variable the backend would pass as an
// extra parameter — including Copy captures, which ownership tracking
// skips because they cannot alias.
fn ClosureCaptureSummary_new_with_copy() -> ClosureCaptureSummary {
    let mut summary = ClosureCaptureSummary_new()
    summary.include_copy = true
    summary
}

fn CaptureEscape_none() -> CaptureEscape {
    CaptureEscape { mode: 0, span_start: -1, span_end: -1 }
}

fn closure_capture_summary(env: TypeEnv, scope: LocalScope, closure: AstNode) -> ClosureCaptureSummary {
    let mut summary = ClosureCaptureSummary_new()
    let child_count = ast_access::node_child_count(closure)
    if child_count == 0 {
        return summary
    }
    let body = ast_access::node_child_at(closure, child_count - 1)
    scan_capture_expr(env, scope, closure, body, summary)
    summary
}

fn closure_escape_summary(env: TypeEnv, scope: LocalScope, closure: AstNode) -> ClosureCaptureSummary {
    let mut summary = ClosureCaptureSummary_new_with_copy()
    let child_count = ast_access::node_child_count(closure)
    if child_count == 0 {
        return summary
    }
    let body = ast_access::node_child_at(closure, child_count - 1)
    scan_capture_expr(env, scope, closure, body, summary)
    summary
}

fn scan_capture_expr(env: TypeEnv, scope: LocalScope, closure: AstNode, node: AstNode, mut summary: ClosureCaptureSummary) {
    if ast_access::node_kind_is(node, kinds::NK_CLOSURE()) {
        return
    }
    if ast_access::node_kind_is(node, kinds::NK_IDENT()) {
        add_capture(env, scope, closure, node, false, false, summary)
        return
    }
    let kind = ast_access::node_kind(node)
    if kind == kinds::NK_ASSIGN() {
        if ast_access::node_child_count(node) >= 1 {
            let target = ast_access::node_child_at(node, 0)
            // Bare "name = value" rebinds the captured place; a
            // "name.field = value" target mutates through the held ref.
            scan_capture_target(env, scope, closure, target, summary, ast_access::node_kind_is(target, kinds::NK_IDENT()))
        }
        if ast_access::node_child_count(node) >= 2 {
            scan_capture_expr(env, scope, closure, ast_access::node_child_at(node, 1), summary)
        }
        return
    }
    if kind == kinds::NK_METHOD_CALL() && is_mutating_method(ast_access::node_text(node)) {
        if ast_access::node_child_count(node) > 0 {
            scan_capture_target(env, scope, closure, ast_access::node_child_at(node, 0), summary, false)
        }
        let child_count = ast_access::node_child_count(node)
        let mut i = 1
        while i < child_count {
            scan_capture_expr(env, scope, closure, ast_access::node_child_at(node, i), summary)
            i = i + 1
        }
        return
    }
    let child_count = ast_access::node_child_count(node)
    let mut i = 0
    while i < child_count {
        scan_capture_expr(env, scope, closure, ast_access::node_child_at(node, i), summary)
        i = i + 1
    }
}

fn scan_capture_target(env: TypeEnv, scope: LocalScope, closure: AstNode, node: AstNode, mut summary: ClosureCaptureSummary, is_rebind: bool) {
    if ast_access::node_kind_is(node, kinds::NK_IDENT()) {
        add_capture(env, scope, closure, node, true, is_rebind, summary)
        return
    }
    let child_count = ast_access::node_child_count(node)
    if child_count > 0 {
        scan_capture_target(env, scope, closure, ast_access::node_child_at(node, 0), summary, false)
    }
}

fn is_mutating_method(name: String) -> bool {
    eq(name.clone(), "push") || eq(name.clone(), "set") ||
    eq(name.clone(), "append") || eq(name.clone(), "insert") ||
    eq(name.clone(), "remove") || eq(name.clone(), "clear")
}

fn add_capture(env: TypeEnv, scope: LocalScope, closure: AstNode, node: AstNode, is_mutable_use: bool, is_rebind: bool, mut summary: ClosureCaptureSummary) {
    let name = ast_access::node_text(node)
    if closure_name_is_local(closure, name.clone()) {
        return
    }
    let binding_index = scope::scope_binding_index(scope, name.clone())
    if binding_index < 0 {
        return
    }
    let is_copy_capture = scope::scope_binding_is_copy(scope, name.clone())
    // A non-move rebind of a Copy binding is a mutable borrow, not a
    // shared-copy read: it must stay in the apply summary so the source is
    // marked and assign/borrow-conflict diagnostics fire (#874, ADR-061).
    // Move-closure Copy captures are still skipped: a Copy move capture
    // must not consume its source.
    if is_copy_capture && !summary.include_copy &&
    (!(is_mutable_use && is_rebind) || ast_access::node_is_move(closure)) {
        return
    }
    let mut mode = capture_shared_borrow()
    // A rebind (name = expr) inside a move closure targets an owned env-cell
    // slot, so it stays a move capture and escapes like any move capture
    // (#874). The same rebind in a non-move closure is a mutable borrow:
    // writes must reach the live source, which env cells cannot represent,
    // so escape is still rejected (E0213, ADR-061 fallback). Mutating
    // through a moved ref (field set, mutating method) stays a move
    // capture: the env shares the ref, so writes land.
    let mut rebind_mode = capture_mutable_borrow()
    if ast_access::node_is_move(closure) {
        rebind_mode = capture_move()
    }
    if is_mutable_use && is_rebind {
        mode = rebind_mode
    } else if ast_access::node_is_move(closure) {
        mode = capture_move()
    } else if is_mutable_use {
        mode = capture_mutable_borrow()
    } else if is_copy_capture {
        // Copy captures ride in the managed env record, so they classify
        // as move for escape purposes (#872).
        mode = capture_move()
    }
    // A rebind pins the capture to rebind_mode: it must not be upgraded
    // back by later reads of the same name.
    let rebind_use = is_mutable_use && is_rebind
    let existing = capture_name_index(summary, name.clone())
    if existing < 0 {
        push(summary.names, name.clone())
        push(summary.modes, mode)
        push(summary.nodes, node)
        if rebind_use {
            push(summary.rebinds, 1)
        } else {
            push(summary.rebinds, 0)
        }
        return
    }
    if rebind_use {
        set(summary.modes, existing, rebind_mode)
        set(summary.nodes, existing, node)
        set(summary.rebinds, existing, 1)
        return
    }
    if get_unchecked(summary.rebinds, existing) == 1 {
        return
    }
    let previous = get_unchecked(summary.modes, existing)
    if mode > previous {
        set(summary.modes, existing, mode)
        set(summary.nodes, existing, node)
    }
}

fn capture_name_index(summary: ClosureCaptureSummary, name: String) -> i32 {
    let mut i = 0
    while i < len(summary.names) {
        if eq(get_unchecked(summary.names, i), name.clone()) {
            return i
        }
        i = i + 1
    }
    -1
}

fn closure_name_is_local(closure: AstNode, name: String) -> bool {
    let child_count = ast_access::node_child_count(closure)
    if child_count == 0 {
        return false
    }
    let mut i = 0
    while i < child_count - 1 {
        let parameter = ast_access::node_child_at(closure, i)
        if eq(ast_access::node_text(parameter), name.clone()) {
            return true
        }
        i = i + 1
    }
    closure_body_declares_name(ast_access::node_child_at(closure, child_count - 1), name.clone())
}

fn closure_body_declares_name(node: AstNode, name: String) -> bool {
    if ast_access::node_kind_is(node, kinds::NK_CLOSURE()) {
        return false
    }
    if ast_access::node_kind_is(node, kinds::NK_LET()) &&
    eq(ast_access::node_text(node), name.clone()) {
        return true
    }
    let child_count = ast_access::node_child_count(node)
    let mut i = 0
    while i < child_count {
        if closure_body_declares_name(ast_access::node_child_at(node, i), name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn apply_closure_capture_summary(mut env: TypeEnv, mut scope: LocalScope, summary: ClosureCaptureSummary) {
    if !env.is_ownership_tracking_enabled {
        return
    }
    let mut i = 0
    while i < len(summary.names) {
        let name = get_unchecked(summary.names, i).clone()
        let mode = get_unchecked(summary.modes, i)
        let node = get_unchecked(summary.nodes, i)
        if mode == capture_move() {
            apply_move_capture(env, scope, name, node)
        } else {
            apply_borrow_capture(env, scope, name, node, mode == capture_mutable_borrow())
        }
        i = i + 1
    }
}

fn apply_move_capture(mut env: TypeEnv, mut scope: LocalScope, name: String, node: AstNode) {
    if scope::scope_binding_has_shared_borrow(scope, name.clone()) ||
    scope::scope_binding_has_mutable_borrow(scope, name.clone()) {
        report_capture_conflict(env, node, name, "cannot move a value while it is borrowed")
        return
    }
    ownership::consume_expr(env, scope, node)
}

fn apply_borrow_capture(mut env: TypeEnv, mut scope: LocalScope, name: String, node: AstNode, is_mutable: bool) {
    if scope::scope_binding_is_moved(scope, name.clone()) {
        ownership::consume_expr(env, scope, node)
        return
    }
    if is_mutable {
        if scope::scope_binding_has_shared_borrow(scope, name.clone()) ||
        scope::scope_binding_has_mutable_borrow(scope, name.clone()) {
            report_capture_conflict(env, node, name, "cannot create a mutable capture while the value is borrowed")
            return
        }
        scope::scope_mark_mutable_borrow(scope, name, true)
        return
    }
    if scope::scope_binding_has_mutable_borrow(scope, name.clone()) {
        report_capture_conflict(env, node, name, "cannot create a shared capture while the value is mutably borrowed")
        return
    }
    scope::scope_mark_shared_borrow(scope, name, true)
}

fn value_borrow_mode(env: TypeEnv, scope: LocalScope, node: AstNode) -> i32 {
    if ast_access::node_kind_is(node, kinds::NK_CLOSURE()) {
        let summary = closure_capture_summary(env, scope, node)
        let mut mode = 0
        let mut i = 0
        while i < len(summary.modes) {
            let capture_mode = get_unchecked(summary.modes, i)
            if capture_mode == capture_mutable_borrow() &&
            get_unchecked(summary.rebinds, i) == 0 {
                return capture_mutable_borrow()
            }
            if capture_mode == capture_shared_borrow() {
                mode = capture_shared_borrow()
            }
            i = i + 1
        }
        return mode
    }
    if ast_access::node_kind_is(node, kinds::NK_IDENT()) {
        let name = ast_access::node_text(node)
        if scope::scope_binding_has_mutable_borrow(scope, name.clone()) {
            return capture_mutable_borrow()
        }
        if scope::scope_binding_has_shared_borrow(scope, name.clone()) {
            return capture_shared_borrow()
        }
        return 0
    }
    let kind = ast_access::node_kind(node)
    if kind != kinds::NK_TUPLE() && kind != kinds::NK_ARRAY_LIT() &&
    kind != kinds::NK_ARRAY_REPEAT() && kind != kinds::NK_STRUCT_LIT() &&
    kind != kinds::NK_BLOCK() {
        return 0
    }
    let mut mode = 0
    let child_count = ast_access::node_child_count(node)
    let mut i = 0
    while i < child_count {
        let child_mode = value_borrow_mode(env, scope, ast_access::node_child_at(node, i))
        if child_mode > mode {
            mode = child_mode
        }
        i = i + 1
    }
    mode
}

fn value_borrow_is_mutable(mode: i32) -> bool {
    mode == capture_mutable_borrow()
}

// True when the expression evaluates to a closure value carrying captures
// (a literal with captures, a binding flagged has_captures, or an
// aggregate containing either). Used to mark let bindings so later
// escape positions can reject the value (#872).
fn value_has_captures(env: TypeEnv, scope: LocalScope, node: AstNode) -> bool {
    if ast_access::node_kind_is(node, kinds::NK_CLOSURE()) {
        let summary = closure_escape_summary(env, scope, node)
        return len(summary.names) > 0
    }
    if ast_access::node_kind_is(node, kinds::NK_IDENT()) {
        let name = ast_access::node_text(node)
        return scope::scope_binding_has_captures(scope, name.clone()) ||
        scope::scope_binding_has_shared_borrow(scope, name.clone()) ||
        scope::scope_binding_has_mutable_borrow(scope, name.clone())
    }
    let kind = ast_access::node_kind(node)
    if kind == kinds::NK_BLOCK() {
        let count = ast_access::node_child_count(node)
        if count == 0 {
            return false
        }
        return value_has_captures(env, scope, ast_access::node_child_at(node, count - 1))
    }
    if kind != kinds::NK_TUPLE() && kind != kinds::NK_ARRAY_LIT() &&
    kind != kinds::NK_ARRAY_REPEAT() && kind != kinds::NK_STRUCT_LIT() &&
    kind != kinds::NK_EXPR_STMT() {
        return false
    }
    let child_count = ast_access::node_child_count(node)
    let mut i = 0
    while i < child_count {
        if value_has_captures(env, scope, ast_access::node_child_at(node, i)) {
            return true
        }
        i = i + 1
    }
    false
}

fn closure_summary_has_borrow(summary: ClosureCaptureSummary) -> bool {
    let mut i = 0
    while i < len(summary.modes) {
        let mode = get_unchecked(summary.modes, i)
        if mode == capture_shared_borrow() ||
        (mode == capture_mutable_borrow() && get_unchecked(summary.rebinds, i) == 0) {
            return true
        }
        i = i + 1
    }
    false
}

// Whether a value contains a closure whose env would hold borrow captures
// (#872). Bindings marked with this cannot flow to escape positions —
// their env snapshot would go stale against the live local.
fn value_has_borrow_captures(env: TypeEnv, scope: LocalScope, node: AstNode) -> bool {
    if ast_access::node_kind_is(node, kinds::NK_CLOSURE()) {
        let summary = closure_escape_summary(env, scope, node)
        return closure_summary_has_borrow(summary)
    }
    if ast_access::node_kind_is(node, kinds::NK_IDENT()) {
        let name = ast_access::node_text(node)
        return scope::scope_binding_has_borrow_captures(scope, name.clone())
    }
    let kind = ast_access::node_kind(node)
    if kind == kinds::NK_BLOCK() {
        let child_count = ast_access::node_child_count(node)
        if child_count == 0 {
            return false
        }
        return value_has_borrow_captures(env, scope, ast_access::node_child_at(node, child_count - 1))
    }
    if kind != kinds::NK_TUPLE() && kind != kinds::NK_ARRAY_LIT() &&
    kind != kinds::NK_ARRAY_REPEAT() && kind != kinds::NK_STRUCT_LIT() &&
    kind != kinds::NK_EXPR_STMT() {
        return false
    }
    let child_count = ast_access::node_child_count(node)
    let mut i = 0
    while i < child_count {
        if value_has_borrow_captures(env, scope, ast_access::node_child_at(node, i)) {
            return true
        }
        i = i + 1
    }
    false
}

fn closure_capture_escape(mut env: TypeEnv, scope: LocalScope, node: AstNode) {
    let witness = capture_escape_witness(env, scope, node)
    if witness.mode == 0 {
        return
    }
    let span = diag_record::DiagnosticSpan_from_raw(witness.span_start, witness.span_end)
    // Managed closure environments (#872) carry move and Copy captures in
    // the fn pair's env record, so they may escape freely. Borrow captures
    // would observe a stale snapshot of a live local and stay semantic
    // errors (E0213).
    let message = "borrowed closure capture cannot escape its enclosing function"
    let code = codes::DIAG_TYPE_CLOSURE_BORROW_ESCAPE()
    let diag = diag_mod::Diagnostic_new(
        code,
        diag_mod::SEV_ERROR(),
        span,
        message
    )
    env.error_count = env.error_count + 1
    push(env.errors, message)
    push(env.diagnostics, diag)
}

fn capture_escape_witness(env: TypeEnv, scope: LocalScope, node: AstNode) -> CaptureEscape {
    if ast_access::node_kind_is(node, kinds::NK_CLOSURE()) {
        let summary = closure_escape_summary(env, scope, node)
        return summary_escape_witness(summary)
    }
    if ast_access::node_kind_is(node, kinds::NK_IDENT()) {
        let name = ast_access::node_text(node)
        if scope::scope_binding_has_shared_borrow(scope, name.clone()) ||
        scope::scope_binding_has_mutable_borrow(scope, name.clone()) {
            let mut borrow_mode = capture_shared_borrow()
            if scope::scope_binding_has_mutable_borrow(scope, name.clone()) {
                borrow_mode = capture_mutable_borrow()
            }
            return CaptureEscape {
                mode: borrow_mode,
                span_start: ast_access::node_span_start(node),
                span_end: ast_access::node_span_end(node),
            }
        }
        // A binding whose closure captured by borrow keeps an env snapshot
        // of a live local; escaping it would observe stale state (E0213).
        // Move/Copy captures travel inside the pair env and escape freely.
        if scope::scope_binding_has_borrow_captures(scope, name.clone()) {
            return CaptureEscape {
                mode: capture_shared_borrow(),
                span_start: ast_access::node_span_start(node),
                span_end: ast_access::node_span_end(node),
            }
        }
        return CaptureEscape_none()
    }
    let kind = ast_access::node_kind(node)
    if kind == kinds::NK_BLOCK() {
        // Only the last child carries the block's value, so earlier
        // statements cannot make a closure escape through this position.
        let count = ast_access::node_child_count(node)
        if count == 0 {
            return CaptureEscape_none()
        }
        return capture_escape_witness(env, scope, ast_access::node_child_at(node, count - 1))
    }
    if kind != kinds::NK_TUPLE() && kind != kinds::NK_ARRAY_LIT() &&
    kind != kinds::NK_ARRAY_REPEAT() && kind != kinds::NK_STRUCT_LIT() &&
    kind != kinds::NK_IF_EXPR() && kind != kinds::NK_MATCH_EXPR() &&
    kind != kinds::NK_EXPR_STMT() {
        return CaptureEscape_none()
    }
    let child_count = ast_access::node_child_count(node)
    let mut i = 0
    while i < child_count {
        let child = ast_access::node_child_at(node, i)
        let witness = capture_escape_witness(env, scope, child)
        if witness.mode != 0 {
            return witness
        }
        i = i + 1
    }
    CaptureEscape_none()
}

fn summary_escape_witness(summary: ClosureCaptureSummary) -> CaptureEscape {
    let mut i = 0
    while i < len(summary.modes) {
        let mode = get_unchecked(summary.modes, i)
        // Only borrow captures block escape: move/Copy captures are packed
        // into the managed env record (#872), and a mutable-borrow rebind
        // capture rides a promoted shared cell that the env can carry as a
        // live alias (#891).
        if mode == capture_shared_borrow() ||
        (mode == capture_mutable_borrow() && get_unchecked(summary.rebinds, i) == 0) {
            let node = get_unchecked(summary.nodes, i)
            return CaptureEscape {
                mode: mode,
                span_start: ast_access::node_span_start(node),
                span_end: ast_access::node_span_end(node),
            }
        }
        i = i + 1
    }
    CaptureEscape_none()
}

fn report_capture_conflict(mut env: TypeEnv, node: AstNode, name: String, reason: String) {
    let span = diag_record::DiagnosticSpan_from_raw(
        ast_access::node_span_start(node),
        ast_access::node_span_end(node)
    )
    let message = reason.concat(": `".concat(name.concat("`")))
    let diag = diag_mod::Diagnostic_new(
        codes::DIAG_TYPE_CLOSURE_BORROW_CONFLICT(),
        diag_mod::SEV_ERROR(),
        span,
        message
    )
    env.error_count = env.error_count + 1
    push(env.errors, message)
    push(env.diagnostics, diag)
}
