use typechecker::ast_stmt_predicates
use typechecker::ast_expr_predicates
use typechecker::ast_access
use typechecker::unify
use typechecker::try_expr
use typechecker::operator_traits

fn infer_wrapper_expr(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    if ast_expr_predicates::node_is_unary(node) {
        if ast_access::node_child_count(node) > 0 {
            let operand = ast_access::node_child_at(node, 0)
            let operand_ty = infer_expr(env, scope, fn_sigs, enum_defs, operand)
            operator_traits::enforce_unary_operator(
                env,
                operand_ty,
                ast_access::node_op(node)
            )
            return operand_ty
        }
    }
    if ast_expr_predicates::node_is_if_expr(node) {
        if ast_access::node_child_count(node) >= 2 {
            // Infer the calls inside the condition before the arms. Control
            // flow never needed the condition type, but a method call reached
            // only from a condition (self.buffered() in
            // BufReader::read_line) never recorded its mono demand edge, so
            // the emitter bound an unresolved callee and trapped.
            let cond_node = ast_access::node_child_at(node, 0)
            infer_condition_call_demand_edges(env, scope, fn_sigs, enum_defs, cond_node)
            let then_node = ast_access::node_child_at(node, 1)
            let then_ty = infer_expr(env, scope, fn_sigs, enum_defs, then_node)
            if ast_access::node_child_count(node) >= 3 {
                let else_node = ast_access::node_child_at(node, 2)
                let else_ty = infer_expr(env, scope, fn_sigs, enum_defs, else_node)
                return unify::unify(env, then_ty, else_ty)
            }
            return then_ty
        }
    }
    if ast_stmt_predicates::node_is_expr_stmt(node) {
        if ast_access::node_child_count(node) > 0 {
            return infer_expr(env, scope, fn_sigs, enum_defs, ast_access::node_child_at(node, 0))
        }
        return TypeInfo_simple(commands::TY_UNIT())
    }
    if ast_expr_predicates::node_is_try(node) {
        if ast_access::node_child_count(node) > 0 {
            let inner = ast_access::node_child_at(node, 0)
            let inner_ty = infer_expr(env, scope, fn_sigs, enum_defs, inner)
            return try_expr::infer_try_expr(env, inner_ty)
        }
    }
    TypeInfo_simple(commands::TY_UNKNOWN())
}

// Condition expressions were historically unchecked, so inferring the whole
// tree would introduce a new type-error surface (operator unification on
// numeric literals) in already-valid programs. Only call nodes can publish a
// mono demand edge, so infer those and discard the speculative diagnostics;
// this keeps the language contract while restoring the missing edges.
fn infer_condition_call_demand_edges(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) {
    if ast_expr_predicates::node_is_call(node) || ast_expr_predicates::node_is_method_call(node) {
        let saved_error_count = env.error_count
        let saved_error_len = env.errors.len()
        let saved_diagnostic_len = env.diagnostics.len()
        let _call_ty = infer_expr(env, scope, fn_sigs, enum_defs, node)
        env.error_count = saved_error_count
        while env.errors.len() > saved_error_len {
            match env.errors.pop() {
                Option::Some(_) => {
                },
                Option::None => {
                    break
                },
            }
        }
        while env.diagnostics.len() > saved_diagnostic_len {
            match env.diagnostics.pop() {
                Option::Some(_) => {
                },
                Option::None => {
                    break
                },
            }
        }
        return
    }
    // A call already infers its receiver and arguments, so only non-call
    // nodes recurse (operators, parens, field accesses, blocks).
    let child_count = ast_access::node_child_count(node)
    let mut child_index = 0
    while child_index < child_count {
        infer_condition_call_demand_edges(
            env,
            scope,
            fn_sigs,
            enum_defs,
            ast_access::node_child_at(node, child_index)
        )
        child_index = child_index + 1
    }
}
