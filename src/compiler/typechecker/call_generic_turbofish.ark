use typechecker::ast_access
use typechecker::ast_expr_predicates
use typechecker::types
use typechecker::unify

// Bind turbofish type arguments from a PATH callee's children onto fresh
// generic type vars. PATH layout after parse_path_suffix:
//   children[0] = lhs segment, children[1..] = explicit type args (#845).
fn constrain_turbofish_type_args(
    callee: AstNode,
    infer_env: TypeEnv,
    var_types: Vec<TypeInfo>
) {
    if !ast_expr_predicates::node_is_path(callee) {
        return
    }
    let child_count = ast_access::node_child_count(callee)
    if child_count < 2 {
        return
    }
    let type_arg_count = child_count - 1
    let var_count = len(var_types)
    let mut i = 0
    while i < type_arg_count && i < var_count {
        let type_node = ast_access::node_child_at(callee, i + 1)
        let concrete = types::resolve_type_ann_node(type_node)
        unify::unify(infer_env, get_unchecked(var_types, i), concrete)
        i = i + 1
    }
}
