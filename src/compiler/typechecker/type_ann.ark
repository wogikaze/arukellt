use typechecker::ast_type_predicates
use typechecker::ast_access
use typechecker::contract_type_mutation
use typechecker::kinds
use typechecker::type_names

fn resolve_type_ann_node(ann: AstNode) -> TypeInfo {
    if ast_access::node_kind_is(ann, kinds::NK_TYPE_TUPLE()) {
        let tuple_ty = type_names::type_info_named(commands::TY_TUPLE(), String_new())
        let child_count = ast_access::node_child_count(ann)
        let mut k = 0
        while k < child_count {
            let elem = ast_access::node_child_at(ann, k)
            let elem_ty = resolve_type_ann_node(elem)
            contract_type_mutation::TypeInfo_push_type_arg(tuple_ty, elem_ty)
            k = k + 1
        }
        return tuple_ty
    }
    if ast_access::node_kind_is(ann, kinds::NK_TYPE_FN()) {
        return resolve_type_fn_node(ann)
    }
    if ast_type_predicates::node_is_type_generic(ann) {
        let base_ty = type_names::resolve_type_name(ast_access::node_text(ann))
        let child_count = ast_access::node_child_count(ann)
        let mut k = 1
        while k < child_count {
            let arg_child = ast_access::node_child_at(ann, k)
            let arg_ty = resolve_type_ann_node(arg_child)
            contract_type_mutation::TypeInfo_push_type_arg(base_ty, arg_ty)
            k = k + 1
        }
        return base_ty
    }
    type_names::resolve_type_name(ast_access::node_text(ann))
}

// `fn(A, B) -> R` resolves to a TY_FN whose type args are the parameter
// types followed by the return type in the last position — the same layout
// infer_closure_expr produces for closure literals. A missing return
// annotation contributes TY_UNKNOWN so the arg count stays uniform and
// unification does not fail on arity alone.
fn resolve_type_fn_node(ann: AstNode) -> TypeInfo {
    let fn_ty = type_names::type_info_simple(commands::TY_FN())
    let child_count = ast_access::node_child_count(ann)
    let mut k = 0
    while k < child_count {
        let param = ast_access::node_child_at(ann, k)
        contract_type_mutation::TypeInfo_push_type_arg(fn_ty, resolve_type_ann_node(param))
        k = k + 1
    }
    if ast_access::node_type_ann_count(ann) > 0 {
        let ret = ast_access::node_type_ann_at(ann, 0)
        contract_type_mutation::TypeInfo_push_type_arg(fn_ty, resolve_type_ann_node(ret))
    } else {
        contract_type_mutation::TypeInfo_push_type_arg(fn_ty, type_names::type_info_simple(commands::TY_UNKNOWN()))
    }
    fn_ty
}
