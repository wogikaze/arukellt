struct TraitInfo {
    name: String,
    type_param_count: i32,
    associated_type_names: Vec<String>,
    supertrait_names: Vec<String>,
}

fn TraitInfo_new(name: String, type_param_count: i32) -> TraitInfo {
    TraitInfo {
        name: name,
        type_param_count: type_param_count,
        associated_type_names: Vec::new<String>(),
        supertrait_names: Vec::new<String>(),
    }
}

fn trait_info_name(info: TraitInfo) -> String {
    info.name.clone()
}

fn trait_info_type_param_count(info: TraitInfo) -> i32 {
    info.type_param_count
}

fn trait_info_associated_type_count(info: TraitInfo) -> i32 {
    info.associated_type_names.len()
}

fn trait_info_associated_type_at(info: TraitInfo, index: i32) -> String {
    get_unchecked(info.associated_type_names, index).clone()
}

fn trait_info_push_associated_type(mut info: TraitInfo, name: String) {
    info.associated_type_names.push(name)
}

fn trait_info_supertrait_count(info: TraitInfo) -> i32 {
    info.supertrait_names.len()
}

fn trait_info_supertrait_at(info: TraitInfo, index: i32) -> String {
    get_unchecked(info.supertrait_names, index).clone()
}

fn trait_info_push_supertrait(mut info: TraitInfo, name: String) {
    info.supertrait_names.push(name)
}
