use typechecker::ast_decl_predicates
use typechecker::ast_access
use typechecker::contract_enum_info
use typechecker::types

fn collect_enum_defs(decls: Vec<AstNode>) -> Vec<EnumInfo> {
    let mut enum_defs = Vec::new<EnumInfo>()
    let decl_count = decls.len()
    let mut i = 0
    while i < decl_count {
        let node = get_unchecked(decls, i)
        if ast_decl_predicates::node_is_enum_decl(node) {
            enum_defs.push(collect_enum_def(node))
        }
        i = i + 1
    }
    enum_defs
}

fn collect_enum_def(node: AstNode) -> EnumInfo {
    let mut variant_names = Vec::new<String>()
    let mut payload_types = Vec::new<TypeInfo>()
    let mut payload_starts = Vec::new<i32>()
    let mut payload_counts = Vec::new<i32>()
    let type_params = enum_type_param_names(node)
    let vc = ast_access::node_child_count(node)
    let mut vi = 0
    while vi < vc {
        let variant = ast_access::node_child_at(node, vi)
        variant_names.push(ast_access::node_text(variant))
        payload_starts.push(payload_types.len())
        let mut payload_count = 0
        let ann_count = ast_access::node_type_ann_count(variant)
        let mut ai = 0
        while ai < ann_count {
            payload_types.push(types::resolve_type_ann_node_generic(
                    ast_access::node_type_ann_at(variant, ai),
                    type_params
                ))
            payload_count = payload_count + 1
            ai = ai + 1
        }
        let field_count = ast_access::node_child_count(variant)
        let mut fi = 0
        while fi < field_count {
            let field = ast_access::node_child_at(variant, fi)
            if ast_access::node_type_ann_count(field) > 0 {
                payload_types.push(types::resolve_type_ann_node_generic(
                        ast_access::node_type_ann_at(field, 0),
                        type_params
                    ))
                payload_count = payload_count + 1
            }
            fi = fi + 1
        }
        payload_counts.push(payload_count)
        vi = vi + 1
    }
    contract_enum_info::EnumInfo_new_with_payloads(
        ast_access::node_text(node),
        variant_names,
        payload_types,
        payload_starts,
        payload_counts,
        type_params
    )
}

fn enum_type_param_names(node: AstNode) -> Vec<String> {
    let mut names = Vec::new<String>()
    let count = ast_access::node_type_ann_count(node)
    let mut i = 0
    while i < count {
        let ann = ast_access::node_type_ann_at(node, i)
        names.push(ast_access::node_text(ann))
        i = i + 1
    }
    names
}
