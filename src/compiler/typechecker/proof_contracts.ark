use typechecker::ast_access
use typechecker::contract_fn_sig
use typechecker::contract_result_state
use typechecker::contract_type_access
use typechecker::infer
use typechecker::kinds
use typechecker::names
use typechecker::scope
use typechecker::unify

fn check_fn_contracts(
    env: TypeEnv,
    base_scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    fn_node: AstNode,
    sig: FnSig,
    contracts_supported: bool,
    result: TypeCheckResult,
    function_index: i32
) {
    let ann_count = ast_access::node_type_ann_count(fn_node)
    let mut rejected = false
    let mut i = 0
    while i < ann_count {
        let ann = ast_access::node_type_ann_at(fn_node, i)
        if ast_access::node_kind_is(ann, kinds::NK_PROOF_CONTRACT()) {
            if contracts_supported {
                check_contract(
                    env,
                    base_scope,
                    fn_sigs,
                    enum_defs,
                    ann,
                    sig,
                    result,
                    function_index
                )
            } else if !rejected {
                unify::type_error(
                    env,
                    String_from("proof contracts on impl methods are not yet supported")
                )
                rejected = true
            }
        }
        i = i + 1
    }
}

fn check_contract(
    env: TypeEnv,
    base_scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    contract: AstNode,
    sig: FnSig,
    result: TypeCheckResult,
    function_index: i32
) {
    let clause = ast_access::node_text(contract)
    if ast_access::node_child_count(contract) == 0 {
        unify::type_error(
            env,
            concat(
                String_from("proof "),
                concat(clause, String_from(" contract has no condition"))
            )
        )
        return
    }
    let contract_scope = scope::scope_child(base_scope)
    let mut result_name = String_new()
    if eq(clone(clause), String_from("ensures")) {
        result_name = String_from("result")
        scope::scope_define(
            contract_scope,
            clone(result_name),
            contract_fn_sig::FnSig_return_type(sig)
        )
    } else if !eq(clone(clause), String_from("requires")) {
        unify::type_error(
            env,
            concat(String_from("unsupported proof contract kind: "), clause)
        )
        return
    }
    let condition = ast_access::node_child_at(contract, 0)
    let condition_ty = infer::infer_expr(
        env,
        contract_scope,
        fn_sigs,
        enum_defs,
        condition
    )
    let resolved = unify::resolve_type(env, condition_ty)
    contract_result_state::typecheck_result_push_proof_contract(
        result,
        function_index,
        clone(clause),
        condition,
        clone(result_name),
        ast_access::node_span_start(contract)
    )
    let tag = contract_type_access::TypeInfo_tag(resolved)
    if tag == commands::TY_UNKNOWN() {
        return
    }
    if tag != commands::TY_BOOL() {
        let actual = names::type_display_name(resolved)
        unify::type_error(
            env,
            concat(
                String_from("proof "),
                concat(
                    clause,
                    concat(String_from(" contract must have type bool, got "), actual)
                )
            )
        )
    }
}
