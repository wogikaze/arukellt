use std::text
use diagnostics::codes
use diagnostics::record
use typechecker::contract_trait_impl
use typechecker::contract_trait_impl_record
use typechecker::contract_type_access
use typechecker::names
use typechecker::unify
use diagnostics::mod as diag_mod

fn infer_try_expr(mut env: TypeEnv, operand_ty: TypeInfo) -> TypeInfo {
    let resolved_operand = unify::resolve_type_deep(env, operand_ty)
    let resolved_return = unify::resolve_type_deep(env, env.current_fn_return_type)
    let operand_tag = contract_type_access::TypeInfo_tag(resolved_operand)
    if operand_tag == commands::TY_RESULT() {
        return infer_result_try(env, resolved_operand, resolved_return)
    }
    if operand_tag == commands::TY_OPTION() {
        return infer_option_try(env, resolved_operand, resolved_return)
    }
    report_try_error(env, "? operator requires a Result or Option operand")
    resolved_operand
}

fn infer_result_try(mut env: TypeEnv, operand_ty: TypeInfo, return_ty: TypeInfo) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(return_ty) == commands::TY_OPTION() {
        report_try_error(env, "? operator cannot convert Result into Option")
        return try_payload_or_unknown(operand_ty)
    }
    if contract_type_access::TypeInfo_tag(return_ty) != commands::TY_RESULT() {
        report_try_error(env, "? operator requires function to return Result")
        return try_payload_or_unknown(operand_ty)
    }
    if contract_type_access::TypeInfo_type_arg_count(operand_ty) < 2 ||
    contract_type_access::TypeInfo_type_arg_count(return_ty) < 2 {
        report_try_error(env, "? operator requires Result<T, E> on both sides")
        return try_payload_or_unknown(operand_ty)
    }
    let source_error = contract_type_access::TypeInfo_type_arg_at(operand_ty, 1)
    let target_error = contract_type_access::TypeInfo_type_arg_at(return_ty, 1)
    if same_try_type(source_error, target_error) {
        return contract_type_access::TypeInfo_type_arg_at(operand_ty, 0)
    }
    let conversion_count = count_from_impls(env, source_error, target_error)
    if conversion_count == 1 {
        return contract_type_access::TypeInfo_type_arg_at(operand_ty, 0)
    }
    if conversion_count > 1 {
        report_try_error(
            env,
            "? operator has ambiguous From conversion for ".concat(names::type_display_name(source_error).concat(" error"))
        )
    } else {
        report_try_error(
            env,
            "? operator cannot convert error type ".concat(names::type_display_name(source_error).concat(" via From"))
        )
    }
    contract_type_access::TypeInfo_type_arg_at(operand_ty, 0)
}

fn infer_option_try(mut env: TypeEnv, operand_ty: TypeInfo, return_ty: TypeInfo) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(return_ty) != commands::TY_OPTION() {
        if contract_type_access::TypeInfo_tag(return_ty) == commands::TY_RESULT() {
            report_try_error(env, "? operator cannot convert Option into Result")
        } else {
            report_try_error(env, "? operator requires function to return Option")
        }
        return try_payload_or_unknown(operand_ty)
    }
    if contract_type_access::TypeInfo_type_arg_count(operand_ty) < 1 ||
    contract_type_access::TypeInfo_type_arg_count(return_ty) < 1 {
        report_try_error(env, "? operator requires Option<T> on both sides")
        return try_payload_or_unknown(operand_ty)
    }
    contract_type_access::TypeInfo_type_arg_at(operand_ty, 0)
}

fn try_payload_or_unknown(operand_ty: TypeInfo) -> TypeInfo {
    if contract_type_access::TypeInfo_type_arg_count(operand_ty) > 0 {
        return contract_type_access::TypeInfo_type_arg_at(operand_ty, 0)
    }
    TypeInfo_simple(commands::TY_UNKNOWN())
}

fn count_from_impls(env: TypeEnv, source_ty: TypeInfo, target_ty: TypeInfo) -> i32 {
    let mut matches = 0
    let count = env.trait_impls.len()
    let mut i = 0
    while i < count {
        let impl_info = env.trait_impls.get_unchecked(i)
        if names::same_type_name(
            contract_trait_impl::TraitImplInfo_trait_name(impl_info),
            "From"
        ) && from_impl_matches(impl_info, source_ty, target_ty) {
            matches = matches + 1
        }
        i = i + 1
    }
    matches
}

fn from_impl_matches(impl_info: TraitImplInfo, source_ty: TypeInfo, target_ty: TypeInfo) -> bool {
    if !same_try_type(
        contract_trait_impl::TraitImplInfo_self_ty(impl_info),
        target_ty
    ) {
        return false
    }
    let args = contract_trait_impl_record::trait_impl_info_trait_args(impl_info)
    args.len() == 1 && same_try_type(args.get_unchecked(0), source_ty)
}

fn same_try_type(left: TypeInfo, right: TypeInfo) -> bool {
    if contract_type_access::TypeInfo_tag(left) != contract_type_access::TypeInfo_tag(right) ||
    !contract_type_access::TypeInfo_name(left).eq(contract_type_access::TypeInfo_name(right)) {
        return false
    }
    let count = contract_type_access::TypeInfo_type_arg_count(left)
    if count != contract_type_access::TypeInfo_type_arg_count(right) {
        return false
    }
    let mut i = 0
    while i < count {
        if !same_try_type(
            contract_type_access::TypeInfo_type_arg_at(left, i),
            contract_type_access::TypeInfo_type_arg_at(right, i)
        ) {
            return false
        }
        i = i + 1
    }
    true
}

fn report_try_error(mut env: TypeEnv, message: String) {
    env.error_count = env.error_count + 1
    env.errors.push(message.clone())
    let span = record::DiagnosticSpan_from_raw(0, 0)
    let diag = diag_mod::Diagnostic_new(
        codes::DIAG_TYPE_GENERIC_INFERENCE(),
        diag_mod::SEV_ERROR(),
        span,
        message
    )
    env.diagnostics.push(diag)
}
