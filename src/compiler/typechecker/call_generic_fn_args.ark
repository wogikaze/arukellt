use std::prelude::{clone, to_string}
use std::text
use typechecker::ast_access
use typechecker::ast_expr_predicates
use typechecker::associated_types
use typechecker::contract_fn_sig
use typechecker::contract_env_record
use typechecker::contract_type_access
use typechecker::instantiate
use typechecker::param_mode
use typechecker::sigs
use typechecker::type_names
use typechecker::unify
fn constrain_generic_fn_args(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    sig: FnSig,
    mut infer_env: TypeEnv,
    var_names: Vec<String>,
    var_types: Vec<TypeInfo>,
    mut arg_types: Vec<TypeInfo>
) {
    let arg_count = ast_access::node_child_count(node) - 1
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    // Arity only: overload-unaware name lookup makes param unify unsafe for stdlib.
    if arg_count != param_count {
        let fname = contract_fn_sig::FnSig_name(sig)
        unify::type_error_bad_arity(
            env,
            String_from("wrong number of arguments for `").concat(
                clone(fname).concat(String_from("`: expected ").concat(to_string(param_count).concat(String_from(", found ").concat(to_string(arg_count)))))
            )
        )
    }
    param_mode::check_call_parameter_modes(
        env,
        scope,
        sig,
        node,
        1,
        type_names::type_info_simple(commands::TY_UNKNOWN())
    )
    let mut a = 0
    while a < arg_count && a < param_count {
        let arg_node = ast_access::node_child_at(node, a + 1)
        let mut arg_ty = infer_expr(env, scope, fn_sigs, enum_defs, arg_node)
        // A bare function name passed as a callback argument infers
        // TY_UNKNOWN because top-level functions are not scope bindings.
        // Recover the declared signature so `fn(T) -> U` parameters bind
        // the item type variables from the callee's own signature (#860).
        // A module-qualified path needs the same recovery (ADR-088 §7).
        // Const decls share the nullary fn-sig shape but are values, not
        // callbacks: `set(v, 0, K)` must not mint a fn-typed argument.
        if contract_type_access::TypeInfo_tag(arg_ty) == commands::TY_UNKNOWN() &&
        (ast_expr_predicates::node_is_ident(arg_node) || ast_expr_predicates::node_is_path(arg_node)) &&
        !contract_env_record::type_env_is_const_name(env, ast_access::node_text(arg_node)) {
            let fn_ty = sigs::fn_value_type_from_sig(env, fn_sigs, ast_access::node_text(arg_node))
            if contract_type_access::TypeInfo_tag(fn_ty) == commands::TY_FN() {
                arg_ty = fn_ty
            }
        }
        push(arg_types, clone(arg_ty))
        let param_ty = contract_fn_sig::FnSig_param_at(sig, a)
        let inst_param = instantiate::instantiate_type(param_ty, var_names, var_types)
        let projected_param = associated_types::resolve_generic_call_type(env, infer_env, sig, var_names, var_types, inst_param)
        param_mode::check_fn_type_value(
            env,
            scope,
            fn_sigs,
            arg_node,
            projected_param,
            arg_ty,
            String_from("a function with a `mut` parameter cannot be passed where a shared function type is expected")
        )
        unify::unify(infer_env, projected_param, arg_ty)
        a = a + 1
    }
}
