use std::text
use typechecker::kinds
use typechecker::ast_access
use typechecker::associated_types
use typechecker::call_args
use typechecker::closure_capture
use typechecker::call_method_args
use typechecker::call_generic
use typechecker::contract_fn_sig
use typechecker::contract_trait_method_record
use typechecker::contract_type_access
use typechecker::contract_type_param_bounds
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::contract_types_record
use typechecker::hashmap_methods
use typechecker::mono_instances
use typechecker::names
use typechecker::param_mode
use typechecker::sigs
use typechecker::trait_bounds
use typechecker::trait_method_registry
use typechecker::trait_method_record
use typechecker::type_names
use typechecker::unify
use typechecker::vec_core_mono
fn simple_type(tag: i32) -> TypeInfo {
    contract_type_constructors::TypeInfo_simple(tag)
}

fn infer_method_call_expr(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    let child_count = ast_access::node_child_count(node)
    if child_count < 1 {
        return simple_type(commands::TY_UNKNOWN())
    }
    // The receiver and every explicit argument are escape positions for a
    // capturing closure. Check before method resolution so trait, builtin,
    // and unresolved calls reject the same way (#872).
    if env.is_ownership_tracking_enabled {
        let mut a = 0
        while a < child_count {
            closure_capture::closure_capture_escape(env, scope, ast_access::node_child_at(node, a))
            a = a + 1
        }
    }
    let method_name = ast_access::node_text(node)
    let recv_node = ast_access::node_child_at(node, 0)
    let recv_ty = infer_expr(env, scope, fn_sigs, enum_defs, recv_node)
    // Primitive .to_string() always returns String and does not require an
    // inherent impl block to be present in the prelude.
    if method_name.clone().eq(String_from("to_string")) {
        let tag = contract_type_access::TypeInfo_tag(recv_ty)
        if tag == commands::TY_I32() || tag == commands::TY_I64() || tag == commands::TY_F64() ||
        tag == commands::TY_BOOL() || tag == commands::TY_CHAR() || tag == commands::TY_STRING() {
            return simple_type(commands::TY_STRING())
        }
    }
    let builtin_hashmap_return = hashmap_methods::infer_builtin_hashmap_method(
        env,
        scope,
        fn_sigs,
        enum_defs,
        node,
        recv_ty,
        method_name,
        child_count
    )
    if contract_type_access::TypeInfo_tag(builtin_hashmap_return) != commands::TY_UNKNOWN() {
        return builtin_hashmap_return
    }
    if contract_type_access::TypeInfo_tag(recv_ty) == commands::TY_STRING() &&
    method_name.clone().eq(String_from("lines")) && child_count == 1 {
        return string_vec_type()
    }
    // Try mangled name lookup first (e.g. "String::len", "i32::to_string")
    // so that impl-block methods are resolved to the correct signature.
    let recv_type_name = type_name_for_mangling(recv_ty)
    if len(recv_type_name) > 0 {
        let mangled = recv_type_name.clone().concat(String_from("::").concat(method_name.clone()))
        let mangled_sig = sigs::lookup_fn_sig(env, fn_sigs, mangled)
        if contract_fn_sig::FnSig_has_name(mangled_sig) {
            return infer_resolved_method_call(env, scope, fn_sigs, enum_defs, node, mangled_sig, recv_ty, child_count)
        }
        // Concrete generic-struct receivers only own trait/inherent impls
        // under the per-instantiation owner (Name_arg::method); generic
        // impls stay on the bare owner. Retry the bare owner so a receiver
        // like Pair<i32> still reaches impl Pair<T> methods.
        if contract_type_access::TypeInfo_tag(recv_ty) == commands::TY_STRUCT() {
            let bare_recv = names::unqualified_type_name(contract_type_access::TypeInfo_name(recv_ty))
            if len(bare_recv) > 0 && !recv_type_name.clone().eq(bare_recv.clone()) {
                let shell = bare_recv.clone().concat(String_from("::").concat(method_name.clone()))
                let shell_sig = sigs::lookup_fn_sig(env, fn_sigs, shell)
                if contract_fn_sig::FnSig_has_name(shell_sig) {
                    return infer_resolved_method_call(env, scope, fn_sigs, enum_defs, node, shell_sig, recv_ty, child_count)
                }
            }
        }
        // A concrete `Vec<String>` receiver mangles as `Vec_String`, which only
        // owns per-instantiation trait impls. Inherent methods stay on the
        // generic `Vec<T>` shell, so retry the bare owner; without this the
        // method fell through to bare-name lookup and lowered to a trap stub
        // (#966).
        if contract_type_access::TypeInfo_tag(recv_ty) == commands::TY_VEC() &&
        !recv_type_name.clone().eq(String_from("Vec")) {
            let shell = String_from("Vec::").concat(method_name.clone())
            let shell_sig = sigs::lookup_fn_sig(env, fn_sigs, shell)
            if contract_fn_sig::FnSig_has_name(shell_sig) {
                return infer_resolved_method_call(env, scope, fn_sigs, enum_defs, node, shell_sig, recv_ty, child_count)
            }
        }
        // Concrete HashMap pairs only own trait impls (for example
        // HashMap_i32_i32::into_iter); inherent methods such as get/insert
        // stay on the generic HashMap<K, V> shell. Retry the bare owner so
        // pair receivers keep resolving the canonical API.
        if contract_type_access::TypeInfo_tag(recv_ty) == commands::TY_HASHMAP() &&
        !recv_type_name.clone().eq(String_from("HashMap")) {
            let shell = String_from("HashMap::").concat(method_name.clone())
            let shell_sig = sigs::lookup_fn_sig(env, fn_sigs, shell)
            if contract_fn_sig::FnSig_has_name(shell_sig) {
                return infer_resolved_method_call(env, scope, fn_sigs, enum_defs, node, shell_sig, recv_ty, child_count)
            }
        }
        if reject_hashset_method_outside_family(env, fn_sigs, recv_type_name.clone(), method_name.clone()) {
            return simple_type(commands::TY_UNKNOWN())
        }
    }
    let builtin_vec_return = infer_builtin_vec_method(
        env,
        scope,
        fn_sigs,
        enum_defs,
        node,
        recv_ty,
        method_name,
        child_count
    )
    if contract_type_access::TypeInfo_tag(builtin_vec_return) != commands::TY_UNKNOWN() {
        return builtin_vec_return
    }
    // Fall back to bare-name lookup (free functions / prelude builtins).
    let sig = sigs::lookup_fn_sig(env, fn_sigs, method_name)
    if !contract_fn_sig::FnSig_has_name(sig) {
        // Fallback: receiver might be a type variable bounded by a trait.
        // Try to resolve the method via trait bounds.
        let trait_resolution = try_resolve_trait_method_from_bounds(env, scope, fn_sigs, enum_defs, node, method_name)
        let trait_sig = contract_trait_method_record::trait_method_entry_sig(trait_resolution)
        if contract_fn_sig::FnSig_has_name(trait_sig) {
            return infer_trait_method_call(env, scope, fn_sigs, enum_defs, node, trait_resolution)
        }
        let numeric_result = infer_concrete_numeric_consumer_call(
            env,
            scope,
            fn_sigs,
            enum_defs,
            node,
            recv_ty,
            method_name
        )
        if contract_type_access::TypeInfo_tag(numeric_result) != commands::TY_UNKNOWN() {
            return numeric_result
        }
        // Unbounded-var receiver: no declared bound names a trait for
        // this method (`self.iter.next()` inside `impl Iterator for
        // TakeIter<I>` where I has no bound). The call still produces a
        // demand edge so the enclosing instantiation mints
        // `Receiver::method` at rebind (#912).
        if contract_type_access::TypeInfo_tag(recv_ty) == commands::TY_TYPE_VAR() {
            mono_instances::record_var_method_site(env, method_name.clone(), recv_ty.clone())
        }
        // Without this diagnostic an unloaded std::core::iter resolves the
        // method to TY_UNKNOWN and MIR emits the unresolved drop+unreachable
        // fallback, so a runtime trap replaces a missing-import error.
        if is_iterator_api_method(method_name.clone()) && receiver_exposes_iterator_api(recv_ty) {
            let message = text::concat(
                String_from("method `"),
                text::concat(
                    method_name.clone(),
                    String_from("` requires `use std::core::iter`")
                )
            )
            // Speculative inference visits the same node more than once;
            // report the missing import once per environment.
            let mut seen = false
            let mut ei = 0
            while ei < len(env.errors) {
                if get_unchecked(env.errors, ei).clone().eq(message.clone()) {
                    seen = true
                }
                ei = ei + 1
            }
            if !seen {
                unify::type_error(env, message)
            }
        }
        return simple_type(commands::TY_UNKNOWN())
    }
    // Bare function found — but if receiver is a type variable, prefer
    // trait dispatch to handle Self return types correctly (#707).
    // Without this, `x.clone()` where `x: T: Clone` would resolve to the
    // prelude `clone(s: String) -> String` instead of `Clone::clone -> Self`.
    if contract_type_access::TypeInfo_tag(recv_ty) == commands::TY_TYPE_VAR() {
        let trait_resolution = try_resolve_trait_method_from_bounds(env, scope, fn_sigs, enum_defs, node, method_name)
        let trait_sig = contract_trait_method_record::trait_method_entry_sig(trait_resolution)
        if contract_fn_sig::FnSig_has_name(trait_sig) {
            return infer_trait_method_call(env, scope, fn_sigs, enum_defs, node, trait_resolution)
        }
        // `clone` is a compiler-polymorphic intrinsic, not trait dispatch:
        // the free `clone(x)` path preserves any argument type, so
        // `x.clone()` on an unbound type var keeps the receiver type
        // instead of falling through to the String-shaped prelude sig
        // (#691 generic adapter bodies).
        if method_name.clone().eq(String_from("clone")) {
            return recv_ty
        }
    }
    infer_resolved_method_call(env, scope, fn_sigs, enum_defs, node, sig, recv_ty, child_count)
}

// `impl HashSet<i32>` and `impl HashSet<String>` are separate method surfaces
// over different stores. The mangled owner already carries the receiver's
// family (`HashSet_String`), so a name that exists only under the other family
// must stop here instead of continuing into bare-name and Vec lookups that
// would run the wrong store. The capacity group is now declared on both
// families because the String set shares the String-keyed map's bucket
// layout; the guard remains for future family-specific methods (#917).
fn reject_hashset_method_outside_family(
    mut env: TypeEnv,
    fn_sigs: Vec<FnSig>,
    recv_type_name: String,
    method_name: String
) -> bool {
    let family = hashset_family_from_owner(recv_type_name.clone())
    if len(family.clone()) == 0 {
        return false
    }
    let mut other_family = String_from("i32")
    if family.clone().eq(String_from("i32")) {
        other_family = String_from("String")
    }
    let other_method = String_from("HashSet_").concat(
        other_family.clone().concat(String_from("::").concat(method_name.clone()))
    )
    if !contract_fn_sig::FnSig_has_name(sigs::lookup_fn_sig(env, fn_sigs, other_method)) {
        return false
    }
    let message = hashset_method_unavailable_message(method_name.clone(), family.clone())
    // Speculative inference can visit the same method node more than once;
    // report the family rejection once per environment.
    let mut index = 0
    while index < len(env.errors) {
        if get_unchecked(env.errors, index).clone().eq(message.clone()) {
            return true
        }
        index = index + 1
    }
    unify::type_error(env, message)
    true
}

// Element family carried by the impl owner spelling used for method mangling.
// Any other owner (including a HashSet<T> with a still-open type argument)
// returns "" so the call keeps the deferred/generic resolution path.
fn hashset_family_from_owner(owner_name: String) -> String {
    if owner_name.clone().eq(String_from("HashSet_i32")) {
        return String_from("i32")
    }
    if owner_name.clone().eq(String_from("HashSet_String")) {
        return String_from("String")
    }
    String_new()
}

fn hashset_method_unavailable_message(method_name: String, family: String) -> String {
    let other_family = if family.clone().eq(String_from("String")) {
        String_from("i32")
    } else {
        String_from("String")
    }
    let head = String_from("method `").concat(method_name.clone())
    let available = String_from("` is not available on `HashSet<").concat(family.clone())
    let defined = String_from(">`; it is defined only for `HashSet<").concat(other_family.clone())
    head.concat(available.concat(defined.concat(String_from(">`"))))
}

// Numeric iterator consumers are trait methods rather than inherent methods.
// Keep direct concrete calls on the same capability boundary as generic calls,
// and reject a non-numeric iterator before MIR can lower an unresolved method
// to a runtime trap.
fn infer_concrete_numeric_consumer_call(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    recv_ty: TypeInfo,
    method_name: String
) -> TypeInfo {
    if !is_numeric_consumer_method(method_name.clone()) ||
    !receiver_has_iterator_contract(env, recv_ty) {
        return simple_type(commands::TY_UNKNOWN())
    }
    let bound = numeric_consumer_bound(method_name.clone())
    if !trait_bounds::type_satisfies_trait_bound(env, recv_ty, bound) {
        trait_bounds::enforce_trait_bound(env, recv_ty, bound)
        return simple_type(commands::TY_UNKNOWN())
    }
    let trait_name = numeric_consumer_trait_name(method_name.clone())
    let entry = trait_method_registry::lookup_trait_method(
        env,
        trait_name.clone(),
        method_name.clone()
    )
    let sig = associated_types::resolve_trait_method_signature(
        env,
        entry,
        bound,
        recv_ty
    )
    let resolved_entry = trait_method_record::trait_method_entry_with_sig(entry, sig)
    infer_trait_method_call(env, scope, fn_sigs, enum_defs, node, resolved_entry)
}

fn is_numeric_consumer_method(method_name: String) -> bool {
    method_name.clone().eq(String_from("sum")) ||
    method_name.clone().eq(String_from("fold"))
}

fn numeric_consumer_trait_name(method_name: String) -> String {
    if method_name.clone().eq(String_from("sum")) {
        return String_from("IteratorSum")
    }
    String_from("IteratorFold")
}

fn numeric_consumer_bound(method_name: String) -> TypeInfo {
    let mut bound = type_names::resolve_type_name(
        numeric_consumer_trait_name(method_name.clone())
    )
    contract_type_mutation::TypeInfo_push_type_arg(
        bound,
        simple_type(commands::TY_I32())
    )
    contract_type_mutation::TypeInfo_push_type_arg(
        bound,
        simple_type(commands::TY_I32())
    )
    bound
}

fn receiver_has_iterator_contract(mut env: TypeEnv, recv_ty: TypeInfo) -> bool {
    let tag = contract_type_access::TypeInfo_tag(recv_ty)
    if tag == commands::TY_TYPE_VAR() {
        return trait_bounds::env_type_var_has_trait_bound(
            env,
            contract_type_access::TypeInfo_name(recv_ty),
            String_from("Iterator")
        )
    }
    trait_bounds::type_satisfies_trait_bound(
        env,
        recv_ty,
        type_names::resolve_type_name(String_from("Iterator"))
    )
}

fn string_vec_type() -> TypeInfo {
    let mut type_args = Vec::new<TypeInfo>()
    push(type_args, simple_type(commands::TY_STRING()))
    contract_types_record::TypeInfo_new(commands::TY_VEC(), String_from("Vec"), type_args)
}

fn infer_builtin_vec_method(
    mut env: TypeEnv,
    mut scope: LocalScope,
    fn_sigs: Vec<FnSig>,
    enum_defs: Vec<EnumInfo>,
    node: AstNode,
    recv_ty: TypeInfo,
    method_name: String,
    child_count: i32
) -> TypeInfo {
    if contract_type_access::TypeInfo_tag(recv_ty) != commands::TY_VEC() {
        return simple_type(commands::TY_UNKNOWN())
    }
    let explicit_args = child_count - 1
    if !is_vec_method_with_arity(method_name.clone(), explicit_args) {
        return simple_type(commands::TY_UNKNOWN())
    }
    call_args::infer_call_args(env, scope, fn_sigs, enum_defs, node, 1, explicit_args)
    vec_core_mono::record_vec_core_mono_for_callee(env, method_name.clone(), recv_ty)
    if method_name.clone().eq(String_from("len")) {
        return simple_type(commands::TY_I32())
    }
    if method_name.clone().eq(String_from("is_empty")) {
        return simple_type(commands::TY_BOOL())
    }
    if method_name.clone().eq(String_from("pop")) {
        // pop returns Option<T> like get; without this the bare Vec<T>
        // receiver falls through to the concrete Vec<i32> prelude fn and
        // rejects every non-i32 element type (#874).
        if contract_type_access::TypeInfo_type_arg_count(recv_ty) > 0 {
            let elem = contract_type_access::TypeInfo_type_arg_at(recv_ty, 0)
            let mut opt = simple_type(commands::TY_OPTION())
            contract_type_mutation::TypeInfo_push_type_arg(opt, elem)
            return opt
        }
        return simple_type(commands::TY_OPTION())
    }
    if method_name.clone().eq(String_from("get_unchecked")) {
        if contract_type_access::TypeInfo_type_arg_count(recv_ty) > 0 {
            return contract_type_access::TypeInfo_type_arg_at(recv_ty, 0)
        }
        return simple_type(commands::TY_UNKNOWN())
    }
    if method_name.clone().eq(String_from("get")) {
        // Bounds-checked get returns Option<T> (spec / docs/quickstart).
        if contract_type_access::TypeInfo_type_arg_count(recv_ty) > 0 {
            let elem = contract_type_access::TypeInfo_type_arg_at(recv_ty, 0)
            let mut opt = simple_type(commands::TY_OPTION())
            contract_type_mutation::TypeInfo_push_type_arg(opt, elem)
            return opt
        }
        return simple_type(commands::TY_OPTION())
    }
    simple_type(commands::TY_UNIT())
}

fn is_vec_method_with_arity(method_name: String, explicit_args: i32) -> bool {
    if explicit_args == 0 {
        return method_name.clone().eq(String_from("len")) ||
        method_name.clone().eq(String_from("pop")) ||
        method_name.clone().eq(String_from("is_empty"))
    }
    if explicit_args == 1 {
        return method_name.clone().eq(String_from("push")) ||
        method_name.clone().eq(String_from("get")) ||
        method_name.clone().eq(String_from("get_unchecked"))
    }
    if explicit_args == 2 {
        return method_name.clone().eq(String_from("set"))
    }
    false
}

fn infer_resolved_method_call(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode, sig: FnSig, recv_ty: TypeInfo, child_count: i32) -> TypeInfo {
    let explicit_args = child_count - 1
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    if param_count < 1 {
        return simple_type(commands::TY_UNKNOWN())
    }
    if explicit_args + 1 != param_count {
        return simple_type(commands::TY_UNKNOWN())
    }
    // Child 0 is the receiver, so the signature parameter index and the child
    // index line up without an offset; a `mut self` method therefore checks
    // the receiver and the same-root rule covers receiver/argument overlap.
    param_mode::check_call_parameter_modes(env, scope, sig, node, 0, recv_ty)
    if contract_fn_sig::FnSig_type_param_count(sig) == 0 {
        call_method_args::constrain_method_args(env, scope, fn_sigs, enum_defs, node, sig, recv_ty, explicit_args)
        return contract_fn_sig::FnSig_return_type(sig)
    }
    call_generic::infer_generic_method_call_expr(env, scope, fn_sigs, enum_defs, node, sig, recv_ty, explicit_args)
}

// Map a receiver TypeInfo to the type name used for impl method mangling.
// Returns empty string for types that don't have inherent impl blocks.
fn type_name_for_mangling(ty: TypeInfo) -> String {
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == commands::TY_I32() {
        return String_from("i32")
    }
    if tag == commands::TY_I64() {
        return String_from("i64")
    }
    if tag == commands::TY_F64() {
        return String_from("f64")
    }
    if tag == commands::TY_F32() {
        return String_from("f32")
    }
    if tag == commands::TY_BOOL() {
        return String_from("bool")
    }
    if tag == commands::TY_CHAR() {
        return String_from("char")
    }
    if tag == commands::TY_STRING() {
        return String_from("String")
    }
    if tag == commands::TY_FN() {
        return String_from("fnref")
    }
    if tag == commands::TY_VEC() {
        if contract_type_access::TypeInfo_type_arg_count(ty) > 0 {
            let elem_ty = contract_type_access::TypeInfo_type_arg_at(ty, 0)
            if contract_type_access::TypeInfo_tag(elem_ty) == commands::TY_STRING() {
                return String_from("Vec_String")
            }
        }
        return String_from("Vec")
    }
    if tag == commands::TY_HASHMAP() {
        // Concrete pairs own their trait impls under HashMap_K_V (for
        // example HashMap_String_i32::into_iter). Inherent methods stay on
        // the generic HashMap<K, V> shell, so the lookup site retries the
        // bare HashMap owner when the pair symbol is absent. Type variables
        // keep the bare HashMap owner; fn-valued pairs use the shared fnref
        // owner key (HashMap_i32_fnref, #691).
        if contract_type_access::TypeInfo_type_arg_count(ty) >= 2 {
            let key_name = type_name_for_mangling(
                contract_type_access::TypeInfo_type_arg_at(ty, 0)
            )
            let value_name = type_name_for_mangling(
                contract_type_access::TypeInfo_type_arg_at(ty, 1)
            )
            if len(key_name) > 0 && len(value_name) > 0 {
                return String_from("HashMap_").concat(key_name.clone().concat(String_from("_").concat(value_name.clone())))
            }
        }
        return String_from("HashMap")
    }
    if tag == commands::TY_STRUCT() {
        let name = contract_type_access::TypeInfo_name(ty)
        if len(name) > 0 {
            let inst_owner = struct_inst_owner_name(ty)
            if len(inst_owner) > 0 {
                return inst_owner
            }
            return names::unqualified_type_name(name)
        }
    }
    if tag == commands::TY_ENUM() {
        let name = contract_type_access::TypeInfo_name(ty)
        if len(name) > 0 {
            return names::unqualified_type_name(name)
        }
    }
    String_new()
}

// Per-instantiation owner name for a concrete generic struct type, or ""
// when the receiver is not a fully concrete generic instantiation. Impl
// blocks on GenTakeIter<VecIter> register their methods under
// GenTakeIter_VecIter so separate instantiations cannot collide (the same
// rule as HashMap_K_V).
fn struct_inst_owner_name(ty: TypeInfo) -> String {
    if contract_type_access::TypeInfo_tag(ty) != commands::TY_STRUCT() {
        return String_new()
    }
    let arg_count = contract_type_access::TypeInfo_type_arg_count(ty)
    if arg_count == 0 {
        return String_new()
    }
    let base = names::unqualified_type_name(contract_type_access::TypeInfo_name(ty))
    if len(base) == 0 {
        return String_new()
    }
    let mut suffix = String_new()
    let mut i = 0
    while i < arg_count {
        let key = inst_arg_key(contract_type_access::TypeInfo_type_arg_at(ty, i))
        if len(key) == 0 {
            return String_new()
        }
        if len(suffix) > 0 {
            suffix = suffix.concat(String_from("_"))
        }
        suffix = suffix.concat(key)
        i = i + 1
    }
    base.clone().concat(String_from("_").concat(suffix))
}

// Owner-key spelling for one concrete type argument. Type variables return
// "" so generic impl heads keep the bare owner name.
fn inst_arg_key(ty: TypeInfo) -> String {
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == commands::TY_TYPE_VAR() {
        return String_new()
    }
    if tag == commands::TY_I32() { return String_from("i32") }
    if tag == commands::TY_I64() { return String_from("i64") }
    if tag == commands::TY_F64() { return String_from("f64") }
    if tag == commands::TY_F32() { return String_from("f32") }
    if tag == commands::TY_BOOL() { return String_from("bool") }
    if tag == commands::TY_CHAR() { return String_from("char") }
    if tag == commands::TY_STRING() { return String_from("String") }
    if tag == commands::TY_FN() { return String_from("fnref") }
    if tag == commands::TY_VEC() {
        if contract_type_access::TypeInfo_type_arg_count(ty) == 0 {
            return String_from("Vec")
        }
        let elem_key = inst_arg_key(contract_type_access::TypeInfo_type_arg_at(ty, 0))
        if len(elem_key) == 0 {
            return String_new()
        }
        return String_from("Vec_").concat(elem_key)
    }
    if tag == commands::TY_HASHMAP() {
        if contract_type_access::TypeInfo_type_arg_count(ty) < 2 {
            return String_from("HashMap")
        }
        let key_key = inst_arg_key(contract_type_access::TypeInfo_type_arg_at(ty, 0))
        let value_key = inst_arg_key(contract_type_access::TypeInfo_type_arg_at(ty, 1))
        if len(key_key) == 0 || len(value_key) == 0 {
            return String_new()
        }
        return String_from("HashMap_").concat(key_key.clone().concat(String_from("_").concat(value_key)))
    }
    if tag == commands::TY_OPTION() {
        if contract_type_access::TypeInfo_type_arg_count(ty) == 0 {
            return String_from("Option")
        }
        let some_key = inst_arg_key(contract_type_access::TypeInfo_type_arg_at(ty, 0))
        if len(some_key) == 0 {
            return String_new()
        }
        return String_from("Option_").concat(some_key)
    }
    if tag == commands::TY_STRUCT() || tag == commands::TY_ENUM() {
        let name = names::unqualified_type_name(contract_type_access::TypeInfo_name(ty))
        if len(name) == 0 {
            return String_new()
        }
        let inner_count = contract_type_access::TypeInfo_type_arg_count(ty)
        if inner_count == 0 {
            return name
        }
        let mut inner = String_new()
        let mut i = 0
        while i < inner_count {
            let key = inst_arg_key(contract_type_access::TypeInfo_type_arg_at(ty, i))
            if len(key) == 0 {
                return String_new()
            }
            if len(inner) > 0 {
                inner = inner.concat(String_from("_"))
            }
            inner = inner.concat(key)
            i = i + 1
        }
        return name.clone().concat(String_from("_").concat(inner))
    }
    String_new()
}

fn try_resolve_trait_method_from_bounds(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode, method_name: String) -> TraitMethodEntry {
    let recv_node = ast_access::node_child_at(node, 0)
    let recv_ty = infer_expr(env, scope, fn_sigs, enum_defs, recv_node)
    // Only attempt trait resolution when the receiver is a type variable.
    if contract_type_access::TypeInfo_tag(recv_ty) != commands::TY_TYPE_VAR() {
        return trait_method_registry::lookup_trait_method(env, String_new(), String_new())
    }
    let recv_ty_name = contract_type_access::TypeInfo_name(recv_ty)
    // Search the current function's type parameter bounds for a trait
    // that declares this method.
    let bound_count = len(env.current_fn_bounds)
    let mut i = 0
    while i < bound_count {
        let tp_bound = get_unchecked(env.current_fn_bounds, i)
        let tp_name = contract_type_param_bounds::TypeParamBounds_name(tp_bound)
        if tp_name.clone().eq(recv_ty_name.clone()) {
            let inner_bound_count = contract_type_param_bounds::TypeParamBounds_bound_count(tp_bound)
            let mut j = 0
            while j < inner_bound_count {
                let bound_ty = contract_type_param_bounds::TypeParamBounds_bound_at(tp_bound, j)
                let trait_name = contract_type_access::TypeInfo_name(bound_ty)
                let trait_entry = trait_method_registry::lookup_trait_method(
                    env,
                    trait_name.clone(),
                    method_name.clone()
                )
                let trait_sig = contract_trait_method_record::trait_method_entry_sig(trait_entry)
                if contract_fn_sig::FnSig_has_name(trait_sig) {
                    let resolved_sig = associated_types::resolve_trait_method_signature(
                        env,
                        trait_entry,
                        bound_ty,
                        recv_ty
                    )
                    return trait_method_record::trait_method_entry_with_sig(
                        trait_entry,
                        resolved_sig
                    )
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    trait_method_registry::lookup_trait_method(env, String_new(), String_new())
}

fn infer_trait_method_call(mut env: TypeEnv, mut scope: LocalScope, fn_sigs: Vec<FnSig>, enum_defs: Vec<EnumInfo>, node: AstNode, entry: TraitMethodEntry) -> TypeInfo {
    let sig = contract_trait_method_record::trait_method_entry_sig(entry)
    let child_count = ast_access::node_child_count(node)
    let explicit_args = child_count - 1
    let param_count = contract_fn_sig::FnSig_param_count(sig)
    if param_count < 1 {
        return simple_type(commands::TY_UNKNOWN())
    }
    if explicit_args + 1 != param_count {
        return simple_type(commands::TY_UNKNOWN())
    }
    let recv_node = ast_access::node_child_at(node, 0)
    let recv_ty = infer_expr(env, scope, fn_sigs, enum_defs, recv_node)
    call_method_args::constrain_method_args(env, scope, fn_sigs, enum_defs, node, sig, recv_ty, explicit_args)
    // Demand edge (#912): a trait method call on a still-open receiver
    // records a var-method site; the enclosing function's
    // instantiation binds the receiver and mints `Receiver::method`
    // through the impl table (see
    // mono_instances::rebind_enclosing_template_sites).
    mono_instances::record_var_method_site(
        env,
        ast_access::node_text(node),
        recv_ty.clone()
    )
    let ret_ty = contract_fn_sig::FnSig_return_type(sig)
    // Self substitution: if the trait method's return type is a TY_TYPE_VAR
    // named "Self", substitute the receiver's concrete type (#707).
    if contract_type_access::TypeInfo_tag(ret_ty) == commands::TY_TYPE_VAR() {
        let ret_name = contract_type_access::TypeInfo_name(ret_ty)
        if ret_name.clone().eq(String_from("Self")) {
            return recv_ty
        }
    }
    // Some trait methods are parsed with `Self` as a concrete struct name;
    // treat that the same as a type variable named Self.
    if contract_type_access::TypeInfo_tag(ret_ty) == commands::TY_STRUCT() {
        let ret_name = contract_type_access::TypeInfo_name(ret_ty)
        if ret_name.clone().eq(String_from("Self")) {
            return recv_ty
        }
    }
    ret_ty
}

fn is_iterator_api_method(method_name: String) -> bool {
    let names = String_from("|iter|into_iter|collect|count|map|filter|take|skip|flat_map|peekable|step_by|scan|chain|enumerate|zip|rev|unique|any|all|sum|fold|contains|count_eq|find|")
    names.contains(text::concat("|", text::concat(method_name, String_from("|"))))
}

fn receiver_exposes_iterator_api(recv_ty: TypeInfo) -> bool {
    let tag = contract_type_access::TypeInfo_tag(recv_ty)
    if tag == commands::TY_VEC() {
        return true
    }
    let name = contract_type_access::TypeInfo_name(recv_ty)
    let n = len(name)
    if n >= 4 && name.contains(String_from("Iter")) {
        return true
    }
    name.clone().eq(String_from("Range")) || name.clone().eq(String_from("RangeInclusive"))
}
