use std::prelude::clone
use typechecker::contract_type_access
use typechecker::name_display
use typechecker::unify
use typechecker::unify_compat
fn check_return_type_compat(mut env: TypeEnv, fn_name: String, ret_type: TypeInfo, val_ty: TypeInfo) {
    if unify_compat::is_type_compatible(env, ret_type, val_ty) {
        return
    }
    if returns_char_as_i32(env, ret_type, val_ty) {
        return
    }
    let ret_name = name_display::type_display_name_with_args(unify::resolve_type(env, ret_type))
    let val_name = name_display::type_display_name_with_args(unify::resolve_type(env, val_ty))
    let prefix = String_from("return type mismatch: '").concat(clone(fn_name))
    let expected = prefix.concat(String_from("' declared to return ").concat(ret_name))
    unify::type_error(env, expected.concat(String_from(" but body returns ").concat(val_name)))
}

// `char` is i32-representable, and std's `Hash for char` identity impl returns
// the code unit as `i32`. Only this direction and only in return position has
// ever been allowed; it stays outside the shared identity predicate so `let`
// annotations keep rejecting it. Tracked in #938 until the stdlib impl and an
// ADR settle whether the coercion stays.
fn returns_char_as_i32(env: TypeEnv, ret_type: TypeInfo, val_ty: TypeInfo) -> bool {
    let ret_tag = contract_type_access::TypeInfo_tag(unify::resolve_type(env, ret_type))
    let val_tag = contract_type_access::TypeInfo_tag(unify::resolve_type(env, val_ty))
    ret_tag == commands::TY_I32() && val_tag == commands::TY_CHAR()
}
