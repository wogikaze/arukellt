use std::text
use typechecker::ast_access
use typechecker::ast_expr_predicates
use typechecker::contract_enum_info
use typechecker::contract_type_constructors
use typechecker::contract_type_mutation
use typechecker::contract_type_access
use typechecker::infer_env_scope
use typechecker::instantiate
use typechecker::unify
fn infer_enum_variant_path(enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    if !ast_expr_predicates::node_is_path(node) {
        return unknown_type()
    }
    infer_enum_variant_value(enum_defs, node)
}

fn infer_enum_variant_struct_lit(enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    if !ast_expr_predicates::node_is_struct_lit(node) {
        return unknown_type()
    }
    infer_enum_variant_value(enum_defs, node)
}

fn infer_enum_variant_value(enum_defs: Vec<EnumInfo>, node: AstNode) -> TypeInfo {
    let path = ast_access::node_text(node)
    let enum_name = enum_name_from_variant_path(path.clone())
    if enum_name.len() == 0 {
        return unknown_type()
    }
    let enum_type_name = enum_type_name_from_variant_path(path.clone())
    if enum_type_name.len() == 0 {
        return unknown_type()
    }
    let enum_def = find_enum_def(enum_defs, path.clone(), enum_name.clone())
    let declared_name = contract_enum_info::EnumInfo_name(enum_def)
    if declared_name.len() == 0 {
        return unknown_type()
    }
    contract_type_constructors::TypeInfo_named(commands::TY_ENUM(), enum_type_name)
}

fn infer_enum_variant_call(enum_defs: Vec<EnumInfo>, callee: AstNode) -> TypeInfo {
    infer_enum_variant_path(enum_defs, callee)
}

// Give a variant construction the enum's declared type arguments, inferred
// from the payload values: `Wrap::Some(41)` is a `Wrap<i32>`, not a bare
// `Wrap`. Without the argument list a caller that binds the parameter from
// the value (a generic function or `unbox`) cannot instantiate it and falls
// back to the unsubstituted template.
fn instantiate_variant_result(mut env: TypeEnv, enum_defs: Vec<EnumInfo>, callee: AstNode, base_ty: TypeInfo, arg_types: Vec<TypeInfo>) -> TypeInfo {
    let path = ast_access::node_text(callee)
    let enum_def = find_enum_def(enum_defs, path.clone(), enum_name_from_variant_path(path.clone()))
    let type_params = contract_enum_info::EnumInfo_type_params(enum_def)
    if type_params.len() == 0 {
        return base_ty
    }
    let variant_index = contract_enum_info::EnumInfo_variant_index(enum_def, path.clone())
    if variant_index < 0 {
        return base_ty
    }
    let mut infer_env = infer_env_scope::borrow_generic_infer_env(env)
    let mut inst_args = Vec::new<TypeInfo>()
    let mut param_index = 0
    while param_index < type_params.len() {
        push(inst_args, unify::fresh_var(infer_env))
        param_index = param_index + 1
    }
    let payload_count = contract_enum_info::EnumInfo_variant_payload_count(enum_def, variant_index)
    let mut payload_index = 0
    while payload_index < payload_count && payload_index < arg_types.len() {
        let declared = contract_enum_info::EnumInfo_variant_payload_at(enum_def, variant_index, payload_index)
        let inst_payload = instantiate::instantiate_type(declared, type_params.clone(), inst_args)
        unify::unify(infer_env, inst_payload, get_unchecked(arg_types, payload_index))
        payload_index = payload_index + 1
    }
    // A constructor that mentions no parameter (a unit variant) leaves the
    // argument list unresolved. Keep the bare enum spelling in that case:
    // leaking an unbound variable into the value type would make the let
    // annotation and later generic call sites read the value as untyped.
    let mut resolved_args = Vec::new<TypeInfo>()
    let mut resolve_index = 0
    while resolve_index < inst_args.len() {
        let arg_ty = unify::resolve_type(infer_env, get_unchecked(inst_args, resolve_index))
        if contract_type_access::TypeInfo_tag(arg_ty) == commands::TY_TYPE_VAR() {
            return base_ty
        }
        push(resolved_args, arg_ty)
        resolve_index = resolve_index + 1
    }
    let mut result_ty = base_ty
    let mut push_index = 0
    while push_index < resolved_args.len() {
        contract_type_mutation::TypeInfo_push_type_arg(result_ty, get_unchecked(resolved_args, push_index))
        push_index = push_index + 1
    }
    result_ty
}

fn find_enum_def(enum_defs: Vec<EnumInfo>, path: String, enum_name: String) -> EnumInfo {
    let fallback = contract_enum_info::EnumInfo_new(String_new(), Vec::new<String>())
    let count = enum_defs.len()
    let mut i = 0
    while i < count {
        let enum_def = get_unchecked(enum_defs, i)
        let declared_name = contract_enum_info::EnumInfo_name(enum_def)
        if enum_names_match(declared_name.clone(), enum_name.clone()) &&
        contract_enum_info::EnumInfo_variant_index(enum_def, path.clone()) >= 0 {
            return enum_def
        }
        i = i + 1
    }
    fallback
}

fn enum_name_from_variant_path(path: String) -> String {
    let n = path.len()
    let mut last_sep = 0 - 1
    let mut prev_sep = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if path.byte_at(i) == 58 && path.byte_at(i + 1) == 58 {
            prev_sep = last_sep
            last_sep = i
            i = i + 2
            continue
        }
        i = i + 1
    }
    if last_sep < 0 {
        return String_new()
    }
    if prev_sep < 0 {
        return path.slice(0, last_sep)
    }
    path.slice(prev_sep + 2, last_sep)
}

fn enum_type_name_from_variant_path(path: String) -> String {
    let n = path.len()
    let mut last_sep = 0 - 1
    let mut i = 0
    while i + 1 < n {
        if path.byte_at(i) == 58 && path.byte_at(i + 1) == 58 {
            last_sep = i
            i = i + 2
            continue
        }
        i = i + 1
    }
    if last_sep < 0 {
        return String_new()
    }
    path.slice(0, last_sep)
}

fn enum_names_match(declared_name: String, enum_name: String) -> bool {
    if declared_name.clone().eq(enum_name.clone()) {
        return true
    }
    declared_name.clone().ends_with("::".concat(enum_name.clone()))
}

fn unknown_type() -> TypeInfo {
    contract_type_constructors::TypeInfo_simple(commands::TY_UNKNOWN())
}
