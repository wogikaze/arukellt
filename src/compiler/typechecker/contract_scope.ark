use typechecker::contract_types_record
struct TypeScheme {
    vars: Vec<String>,
    body: TypeInfo,
}

fn TypeScheme_empty() -> TypeScheme {
    TypeScheme {
        vars: Vec::new<String>(),
        body: contract_types_record::TypeInfo_new(commands::TY_UNKNOWN(), String_new(), Vec::new<TypeInfo>())
    }
}

struct VarBinding {
    name: String,
    ty: TypeInfo,
    scheme: TypeScheme,
    is_generalized: bool,
    is_mutable: bool,
    is_copy: bool,
    is_moved: bool,
    has_shared_borrow: bool,
    has_mutable_borrow: bool,
    has_captures: bool,
    // The bound value is a closure whose env holds borrow captures (#872);
    // such bindings cannot flow to escape positions (E0213).
    has_borrow_captures: bool,
    // A parameter or receiver declared without `mut` (ADR-088 §2). The
    // binding is immutable, but the reason is the call boundary rather than a
    // local `let`, so the assignment diagnostic can name the missing `mut`.
    is_shared_param: bool,
    // The binding is a parameter or receiver of either mode. ADR-088 §6
    // restricts borrowed `Box<T>` escapes, so the checker must distinguish a
    // borrowed parameter from a local `let` of the same type.
    is_param: bool,
}

struct LocalScope {
    bindings: Vec<VarBinding>,
}

fn LocalScope_new_contract() -> LocalScope {
    LocalScope { bindings: Vec::new<VarBinding>() }
}

fn VarBinding_new(name: String, ty: TypeInfo) -> VarBinding {
    VarBinding_new_with_flags(name, ty, false, false)
}

fn VarBinding_new_with_flags(name: String, ty: TypeInfo, is_mutable: bool, is_copy: bool) -> VarBinding {
    VarBinding {
        name: name,
        ty: ty,
        scheme: TypeScheme_empty(),
        is_generalized: false,
        is_mutable: is_mutable,
        is_copy: is_copy,
        is_moved: false,
        has_shared_borrow: false,
        has_mutable_borrow: false,
        has_captures: false,
        has_borrow_captures: false,
        is_shared_param: false,
        is_param: false,
    }
}

fn VarBinding_new_scheme(name: String, scheme: TypeScheme) -> VarBinding {
    VarBinding_new_scheme_with_flags(name, scheme, false, false)
}

fn VarBinding_new_scheme_with_flags(name: String, scheme: TypeScheme, is_mutable: bool, is_copy: bool) -> VarBinding {
    VarBinding {
        name: name,
        ty: scheme.body,
        scheme: scheme,
        is_generalized: true,
        is_mutable: is_mutable,
        is_copy: is_copy,
        is_moved: false,
        has_shared_borrow: false,
        has_mutable_borrow: false,
        has_captures: false,
        has_borrow_captures: false,
        is_shared_param: false,
        is_param: false,
    }
}

fn VarBinding_name(binding: VarBinding) -> String {
    binding.name.clone()
}

fn VarBinding_type(binding: VarBinding) -> TypeInfo {
    binding.ty
}

fn VarBinding_scheme(binding: VarBinding) -> TypeScheme {
    binding.scheme
}

fn VarBinding_is_generalized(binding: VarBinding) -> bool {
    binding.is_generalized
}

fn VarBinding_is_mutable(binding: VarBinding) -> bool {
    binding.is_mutable
}

fn VarBinding_is_shared_param(binding: VarBinding) -> bool {
    binding.is_shared_param
}

fn VarBinding_set_is_shared_param(mut binding: VarBinding, is_shared_param: bool) {
    binding.is_shared_param = is_shared_param
}

fn VarBinding_is_param(binding: VarBinding) -> bool {
    binding.is_param
}

fn VarBinding_set_is_param(mut binding: VarBinding, is_param: bool) {
    binding.is_param = is_param
}

fn VarBinding_is_copy(binding: VarBinding) -> bool {
    binding.is_copy
}

fn VarBinding_is_moved(binding: VarBinding) -> bool {
    binding.is_moved
}

fn VarBinding_has_shared_borrow(binding: VarBinding) -> bool {
    binding.has_shared_borrow
}

fn VarBinding_has_mutable_borrow(binding: VarBinding) -> bool {
    binding.has_mutable_borrow
}

fn VarBinding_set_moved(mut binding: VarBinding, is_moved: bool) {
    binding.is_moved = is_moved
}

fn VarBinding_set_shared_borrow(mut binding: VarBinding, has_borrow: bool) {
    binding.has_shared_borrow = has_borrow
}

fn VarBinding_set_mutable_borrow(mut binding: VarBinding, has_borrow: bool) {
    binding.has_mutable_borrow = has_borrow
}

// True when the binding holds a closure value that captures names from its
// environment (any capture mode). Such a value cannot be passed, returned,
// or stored where the backend cannot supply the captures (#872).
fn VarBinding_has_captures(binding: VarBinding) -> bool {
    binding.has_captures
}

fn VarBinding_set_has_captures(mut binding: VarBinding, has_caps: bool) {
    binding.has_captures = has_caps
}

fn VarBinding_has_borrow_captures(binding: VarBinding) -> bool {
    binding.has_borrow_captures
}

fn VarBinding_set_has_borrow_captures(mut binding: VarBinding, has_borrow_caps: bool) {
    binding.has_borrow_captures = has_borrow_caps
}

fn LocalScope_binding_count(scope: LocalScope) -> i32 {
    scope.bindings.len()
}

fn LocalScope_binding_at(scope: LocalScope, index: i32) -> VarBinding {
    scope.bindings.get_unchecked(index)
}

fn LocalScope_push_binding(mut scope: LocalScope, binding: VarBinding) {
    push(scope.bindings, binding)
}
