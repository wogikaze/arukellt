use typechecker::contract_types_record

struct TypeScheme {
    vars: Vec<String>,
    body: TypeInfo,
}

fn TypeScheme_empty() -> TypeScheme {
    TypeScheme {
        vars: Vec::new<String>(),
        body: contract_types_record::TypeInfo_new(commands::TY_UNKNOWN(), String_new(), Vec::new<TypeInfo>())
    }
}

struct VarBinding {
    name: String,
    ty: TypeInfo,
    scheme: TypeScheme,
    is_generalized: bool,
}

struct LocalScope {
    bindings: Vec<VarBinding>,
}

fn LocalScope_new_contract() -> LocalScope {
    LocalScope { bindings: Vec::new<VarBinding>() }
}

fn VarBinding_new(name: String, ty: TypeInfo) -> VarBinding {
    VarBinding {
        name: name,
        ty: ty,
        scheme: TypeScheme_empty(),
        is_generalized: false
    }
}

fn VarBinding_new_scheme(name: String, scheme: TypeScheme) -> VarBinding {
    VarBinding {
        name: name,
        ty: scheme.body,
        scheme: scheme,
        is_generalized: true
    }
}

fn VarBinding_name(binding: VarBinding) -> String {
    clone(binding.name)
}

fn VarBinding_type(binding: VarBinding) -> TypeInfo {
    binding.ty
}

fn VarBinding_scheme(binding: VarBinding) -> TypeScheme {
    binding.scheme
}

fn VarBinding_is_generalized(binding: VarBinding) -> bool {
    binding.is_generalized
}

fn LocalScope_binding_count(scope: LocalScope) -> i32 {
    len(scope.bindings)
}

fn LocalScope_binding_at(scope: LocalScope, index: i32) -> VarBinding {
    get_unchecked(scope.bindings, index)
}

fn LocalScope_push_binding(scope: LocalScope, binding: VarBinding) {
    push(scope.bindings, binding)
}
