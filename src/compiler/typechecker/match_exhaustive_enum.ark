use std::text
use typechecker::contract_enum_info
use typechecker::contract_type_access
use typechecker::match_exhaustive_covered
use typechecker::unify
fn check_enum_match_exhaustive(mut env: TypeEnv, resolved_scrutinee: TypeInfo, enum_defs: Vec<EnumInfo>, coverage: MatchCoverage) {
    let enum_name = contract_type_access::TypeInfo_name(resolved_scrutinee)
    let mut found_enum = false
    let mut enum_idx = 0
    let enum_def_count = enum_defs.len()
    while enum_idx < enum_def_count {
        let edef = enum_defs.get_unchecked(enum_idx)
        let declared_name = contract_enum_info::EnumInfo_name(edef)
        if enum_name_matches(enum_name.clone(), declared_name.clone()) {
            found_enum = true
            check_enum_variants_covered(env, declared_name, edef, coverage)
        }
        enum_idx = enum_idx + 1
    }
    if !found_enum {
        unify::type_error(env, "non-exhaustive match: unknown enum '".concat(enum_name.clone()))
    }
}

fn enum_def_exists(resolved_scrutinee: TypeInfo, enum_defs: Vec<EnumInfo>) -> bool {
    let enum_name = contract_type_access::TypeInfo_name(resolved_scrutinee)
    let mut i = 0
    let def_count = enum_defs.len()
    while i < def_count {
        let declared_name = contract_enum_info::EnumInfo_name(enum_defs.get_unchecked(i))
        if enum_name_matches(enum_name.clone(), declared_name.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn enum_name_matches(resolved_name: String, declared_name: String) -> bool {
    if resolved_name.clone().eq(declared_name.clone()) {
        return true
    }
    if resolved_name.ends_with("::".concat(declared_name)) {
        return true
    }
    // The scrutinee type may carry the unqualified name (Ordering from a
    // trait signature) while the enum decl is registered under its module
    // path (cmp::Ordering). Accept the suffix match in both directions.
    declared_name.ends_with("::".concat(resolved_name))
}

fn check_enum_variants_covered(mut env: TypeEnv, enum_name: String, edef: EnumInfo, coverage: MatchCoverage) {
    let variant_count = contract_enum_info::EnumInfo_variant_count(edef)
    let mut v = 0
    while v < variant_count {
        let vname = contract_enum_info::EnumInfo_variant_at(edef, v)
        if !match_exhaustive_covered::is_variant_covered(coverage, vname) {
            unify::type_error(env, "non-exhaustive match: missing ".concat(enum_name.clone().concat("::".concat(vname.clone()))))
        }
        v = v + 1
    }
}
