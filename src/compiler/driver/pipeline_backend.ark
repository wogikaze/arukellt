use std::host::clock::Clock
use std::host::stdio::Stdio
use compiler::phases
use driver::config_record
use driver::errors_phase
use driver::local_lint
use driver::pipeline_frontend
use driver::backend_resolve
use driver::backend_typecheck
use driver::checked_program
use driver::debug
use driver::emit
use driver::lower
use driver::result_record
use driver::typed_corehir_render
use loader::mod
use loader::module_decls
use mir_opt::optimize_module
use mir::module_functions
use mir::mod as mir_api
fn compile_source(source: String, config: DriverConfig) -> CompileResult {
    let frontend = pipeline_frontend::run_frontend(source, config)
    if pipeline_frontend::frontend_result_should_return(frontend) {
        return pipeline_frontend::frontend_result_result(frontend)
    }
    if config_record::config_lint_local_only(config) {
        return local_lint::run_local_lint_stage(
            source.clone(),
            config,
            pipeline_frontend::frontend_result_decls(frontend),
            pipeline_frontend::frontend_result_parse_warnings(frontend)
        )
    }
    let decls = pipeline_frontend::frontend_result_decls(frontend)
    let t0: i64 = pipeline_frontend::frontend_result_t0(frontend)
    let t_lex: i64 = pipeline_frontend::frontend_result_t_lex(frontend)
    let t_parse: i64 = pipeline_frontend::frontend_result_t_parse(frontend)
    run_backend(
        source,
        config,
        decls,
        t0,
        t_lex,
        t_parse,
        pipeline_frontend::frontend_result_parse_warnings(frontend)
    )
}

fn run_backend(source: String, config: DriverConfig, decls: Vec<AstNode>, t0: i64, t_lex: i64, t_parse: i64, parse_warnings: Vec<Diagnostic>) -> CompileResult {
    let mut resolved = backend_resolve::backend_resolve(source, config, decls)
    if backend_resolve::resolve_result_should_return(resolved) {
        return backend_resolve::resolve_result_result(resolved)
    }
    if config_record::config_emit_mode(config).eq("resolve") {
        mod::release_module_asts(backend_resolve::resolve_result_load_state(resolved))
        return result_record::CompileResult_ok(phases::PHASE_RESOLVE())
    }
    let all_decls = module_decls::combine_loaded_and_main_decls(backend_resolve::resolve_result_loaded_modules(resolved), decls)
    let mut checked = backend_typecheck::backend_typecheck(
        source.clone(),
        config,
        all_decls,
        decls.clone(),
        backend_resolve::resolve_result_ctx(resolved),
        parse_warnings
    )
    if backend_typecheck::typecheck_result_should_return(checked) {
        return backend_typecheck::typecheck_result_result(checked)
    }
    if config_record::config_emit_mode(config).eq("typecheck") {
        mod::release_module_asts(backend_resolve::resolve_result_load_state(resolved))
        return result_record::CompileResult_ok(phases::PHASE_TYPECHECK())
    }
    let program = checked_program::build_checked_program(
        all_decls,
        backend_typecheck::typecheck_result_check_result(checked),
        backend_resolve::resolve_result_loaded_modules(resolved),
        backend_resolve::resolve_result_module_stdlib_flags(resolved),
        decls,
        config_record::config_emit_mode(config).clone().eq("typed-corehir") ||
        !config_record::config_target(config).clone().eq("wasm32-gc")
    )
    backend_typecheck::typecheck_result_release_check_result(checked)
    backend_resolve::resolve_result_release_ctx(resolved)
    if config_record::config_emit_mode(config).eq("check") {
        mod::release_module_asts(backend_resolve::resolve_result_load_state(resolved))
        return result_record::CompileResult_ok(phases::PHASE_TYPECHECK())
    }
    if config_record::config_emit_mode(config).eq("typed-corehir") {
        let rendered = typed_corehir_render::render_typed_corehir(
            checked_program::checked_program_core_program(program),
            config
        )
        if rendered.clone().len() == 0 {
            return result_record::CompileResult_err(4, "TypedCoreHIR rendering failed")
        }
        Stdio::println(rendered)
        mod::release_module_asts(backend_resolve::resolve_result_load_state(resolved))
        return result_record::CompileResult_ok(4)
    }
    mod::release_module_asts(backend_resolve::resolve_result_load_state(resolved))
    let t_typecheck = backend_typecheck::typecheck_result_t_typecheck(checked)
    let mut mir_lowered = lower::lower_checked_program(program, config, source.clone())
    let t_lower = Clock::monotonic_now()
    let mut mir_module = mir_opt::optimize_module(mir_lowered, config_record::config_opt_level(config), config_record::config_target(config))
    let t_mir_opt = Clock::monotonic_now()
    // Lower-phase diagnostics: emit-side code paths that could not pick a
    // sound lowering (e.g. an Option/Result payload bind on a scrutinee
    // with no payload type spelling) record messages on the module so the
    // failure is a compile diagnostic instead of invalid core Wasm (#906).
    let lower_diags = module_functions::MirModule_drain_diagnostics(mir_module)
    let lower_diag_count = lower_diags.len()
    if lower_diag_count > 0 {
        let mut result = result_record::CompileResult_err(
            phases::PHASE_LOWER(),
            get_unchecked(lower_diags, 0).clone()
        )
        let mut di = 1
        while di < lower_diag_count {
            result_record::compile_result_push_error_message(result, get_unchecked(lower_diags, di).clone())
            di = di + 1
        }
        result_record::compile_result_set_error_count(result, lower_diag_count)
        return result
    }
    if mir_api::verify_mir_pipeline(mir_module) != 0 {
        return errors_phase::mir_verify_failed_result()
    }
    let t_mir_verify = Clock::monotonic_now()
    if config_record::config_show_timing(config) {
        module_functions::mir_note_receipt_counts(mir_module, 1)
    }
    if config_record::config_emit_mode(config).eq("mir") {
        return result_record::CompileResult_ok(phases::PHASE_LOWER())
    }
    debug::dump_backend_plan_if_enabled(config)
    debug::dump_wit_bindings_if_enabled(config)
    debug::dump_mir_if_enabled(config, mir_module)
    emit::emit_output(
        mir_module,
        program,
        config,
        t0,
        t_lex,
        t_parse,
        backend_resolve::resolve_result_t_resolve(resolved),
        t_typecheck,
        t_lower,
        t_mir_opt,
        t_mir_verify
    )
}
