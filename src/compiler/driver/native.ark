use std::text
pub fn native_output_bytes_from_string(text: String) -> Vec<i32> {
    let mut out = Vec::new<i32>()
    let text_len = text.len()
    let mut i = 0
    while i < text_len {
        out.push(text.byte_at(i))
        i = i + 1
    }
    out
}

pub fn emit_native_llvm_scaffold(_mir: MirModule) -> Vec<i32> {
    let asm = "; Arukellt native-llvm scaffold (#641)\n"
    let asm = asm.concat(".text\n")
    let asm = asm.concat(".globl main\n")
    let asm = asm.concat("main:\n")
    let asm = asm.concat("    xor %eax, %eax\n")
    let asm = asm.concat("    ret\n")
    native_output_bytes_from_string(asm)
}
