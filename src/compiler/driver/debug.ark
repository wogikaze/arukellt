use std::host::stdio
use component::wit_parse_import
use component::wit_parse_text
use driver::config_record
use driver::parser_dump_view
use driver::resolver_dump_view
use driver::typechecker_dump_view
use mir
use lexer::names
use lexer::token_state

pub fn dump_ast(decls: Vec<AstNode>) {
    stdio::eprintln("=== AST ===")
    let decl_count = len(decls)
    let mut j = 0
    while j < decl_count {
        let d = get_unchecked(decls, j)
        parser_dump_view::driver_print_ast(d, 0)
        j = j + 1
    }
}

fn dump_tokens_if_enabled(config: DriverConfig, tokens: Vec<Token>) {
    if config_record::config_dump_tokens(config) {
        dump_tokens(tokens)
    }
}

fn dump_ast_if_enabled(config: DriverConfig, decls: Vec<AstNode>) {
    if config_record::config_dump_ast(config) {
        dump_ast(decls)
    }
}

fn dump_resolved_hir_if_enabled(config: DriverConfig, resolve_ctx: ResolveCtx) {
    if config_record::config_dump_hir(config) {
        // Bind the header first so CONST_STRING gets a real dest. A bare
        // eprintln(String_from(...)) can leave dest=-1 with SKIP and then
        // LOCAL_GET+SET, leaving the pointer on the stack (KEEP_CLOCK validate).
        let header = "=== HIR (post-resolve) ==="
        stdio::eprintln(header)
        dump_resolved_scope(resolve_ctx)
    }
}

fn dump_typed_hir_if_enabled(config: DriverConfig, check_result: TypeCheckResult) {
    if config_record::config_dump_hir(config) {
        let header = "=== TYPED HIR ==="
        stdio::eprintln(header)
        dump_checked_hir(check_result)
    }
}

fn dump_mir_if_enabled(config: DriverConfig, mir_module: MirModule) {
    if config_record::config_dump_mir(config) {
        mir::dump_mir(mir_module)
    }
}

fn dump_backend_plan_if_enabled(config: DriverConfig) {
    if !config_record::config_dump_backend_plan(config) {
        return
    }
    stdio::eprintln("=== BACKEND PLAN ===")
    let paths = config_record::config_wit_paths(config)
    stdio::eprintln(concat("wit-imports: ", to_string(len(paths))))
    for i in 0..len(paths) {
        let path = get_unchecked(paths, i)
        let doc = wit_parse_import::parse_wit_import_file(clone(path))
        let funcs = wit_parse_text::WitParsedInterface_funcs(doc)
        let records = wit_parse_text::WitParsedInterface_records(doc)
        let enums = wit_parse_text::WitParsedInterface_enums(doc)
        let variants = wit_parse_text::WitParsedInterface_variants(doc)
        let summary = concat(
            "wit-import ",
            concat(
                clone(doc.package),
                concat(
                    "/",
                    concat(
                        clone(doc.interface),
                        concat(
                            " funcs=",
                            concat(
                                to_string(len(funcs)),
                                concat(
                                    " records=",
                                    concat(
                                        to_string(len(records)),
                                        concat(
                                            " enums=",
                                            concat(to_string(len(enums)), concat(" variants=", to_string(len(variants))))
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
        stdio::eprintln(summary)
    }
}

fn dump_resolved_scope(ctx: ResolveCtx) {
    resolver_dump_view::driver_dump_scope(ctx)
}

fn dump_checked_hir(result: TypeCheckResult) {
    typechecker_dump_view::driver_dump_typed_hir(result)
}

pub fn dump_tokens(tokens: Vec<Token>) {
    stdio::eprintln("=== TOKENS ===")
    let token_count = len(tokens)
    let mut i = 0
    while i < token_count {
        let tok = get_unchecked(tokens, i)
        stdio::eprintln(concat(names::token_kind_name(token_state::Token_kind(tok)), concat(" ", token_state::Token_text(tok))))
        i = i + 1
    }
}

fn phase_timing_ms(start: i64, end: i64) -> i32 {
    // Inline ns→ms: `time::duration_ms` lowers to unreachable under pinned→s2 (#823).
    let diff = end - start
    if diff < 0i64 {
        return 0
    }
    i64_to_i32(diff / 1000000i64)
}

pub fn emit_phase_timing(
    t0: i64,
    t_lex: i64,
    t_parse: i64,
    t_resolve: i64,
    t_typecheck: i64,
    t_lower: i64,
    t_mir_opt: i64,
    t_mir_verify: i64,
    t_emit: i64
) {
    stdio::eprintln(concat("[arukellt] lex: ", concat(to_string(phase_timing_ms(t0, t_lex)), "ms")))
    stdio::eprintln(concat("[arukellt] parse: ", concat(to_string(phase_timing_ms(t_lex, t_parse)), "ms")))
    stdio::eprintln(concat("[arukellt] resolve: ", concat(to_string(phase_timing_ms(t_parse, t_resolve)), "ms")))
    stdio::eprintln(concat("[arukellt] typecheck: ", concat(to_string(phase_timing_ms(t_resolve, t_typecheck)), "ms")))
    stdio::eprintln(concat("[arukellt] lower: ", concat(to_string(phase_timing_ms(t_typecheck, t_lower)), "ms")))
    stdio::eprintln(concat("[arukellt] mir_opt: ", concat(to_string(phase_timing_ms(t_lower, t_mir_opt)), "ms")))
    stdio::eprintln(concat("[arukellt] mir_verify: ", concat(to_string(phase_timing_ms(t_mir_opt, t_mir_verify)), "ms")))
    stdio::eprintln(concat("[arukellt] emit: ", concat(to_string(phase_timing_ms(t_mir_verify, t_emit)), "ms")))
    stdio::eprintln(concat("[arukellt] total: ", concat(to_string(phase_timing_ms(t0, t_emit)), "ms")))
}
