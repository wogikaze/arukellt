use std::host::fs::Fs
use std::host::stdio::Stdio
use std::text
use component
use component::wit_parse_text
use component::wit_parse_text_scan
use driver::config_record
use driver::parser_dump_view
use driver::resolver_dump_view
use driver::typechecker_dump_view
use mir
use lexer::names
use lexer::token_state
pub fn dump_ast(decls: Vec<AstNode>) {
    Stdio::eprintln("=== AST ===")
    let decl_count = decls.len()
    let mut j = 0
    while j < decl_count {
        let d = get_unchecked(decls, j)
        parser_dump_view::driver_print_ast(d, 0)
        j = j + 1
    }
}

fn dump_tokens_if_enabled(config: DriverConfig, tokens: Vec<Token>) {
    if config_record::config_dump_tokens(config) {
        dump_tokens(tokens)
    }
}

fn dump_ast_if_enabled(config: DriverConfig, decls: Vec<AstNode>) {
    if config_record::config_dump_ast(config) {
        dump_ast(decls)
    }
}

fn dump_resolved_hir_if_enabled(config: DriverConfig, resolve_ctx: ResolveCtx) {
    if config_record::config_dump_hir(config) {
        let header = "=== HIR (post-resolve) ==="
        Stdio::eprintln(header)
        dump_resolved_scope(resolve_ctx)
    }
}

fn dump_typed_hir_if_enabled(config: DriverConfig, check_result: TypeCheckResult) {
    if config_record::config_dump_hir(config) {
        let header = "=== TYPED HIR ==="
        Stdio::eprintln(header)
        dump_checked_hir(check_result)
    }
}

fn dump_mir_if_enabled(config: DriverConfig, mir_module: MirModule) {
    if config_record::config_dump_mir(config) {
        mir::dump_mir(mir_module)
    }
}

fn dump_backend_plan_if_enabled(config: DriverConfig) {
    if !config_record::config_dump_backend_plan(config) {
        return
    }
    Stdio::eprintln("=== BACKEND PLAN ===")
    let paths = config_record::config_wit_paths(config)
    Stdio::eprintln("wit-imports: ".concat(paths.len().to_string()))
    for i in 0..paths.len() {
        let path = get_unchecked(paths, i)
        let scan_package = match Fs::read_to_string(path.clone()) {
            Result::Ok(source) => wit_parse_text_scan::wit_extract_package(source),
            Result::Err(_) => String_new(),
        }
        let scan_interface = match Fs::read_to_string(path.clone()) {
            Result::Ok(source) => wit_parse_text_scan::wit_extract_interface_name(source),
            Result::Err(_) => String_new(),
        }
        let doc = match Fs::read_to_string(path.clone()) {
            Result::Ok(source) => component::parse_wit_import_text(source),
            Result::Err(_) => component::parse_wit_import_file(path.clone()),
        }
        // Read identity through the source scanner because bootstrap record
        // field access can alias scalar fields while parsed fields are moved.
        let package = if scan_package.len() > 0 { scan_package } else { doc.package.clone() }
        let interface = if scan_interface.len() > 0 { scan_interface } else { doc.interface.clone() }
        let identity = package.concat("/".concat(interface))
        let mut summary = "wit-import ".concat(identity)
        let funcs = wit_parse_text::WitParsedInterface_funcs(doc)
        let records = wit_parse_text::WitParsedInterface_records(doc)
        let enums = wit_parse_text::WitParsedInterface_enums(doc)
        let variants = wit_parse_text::WitParsedInterface_variants(doc)
        summary = summary.concat(" funcs=")
        summary = summary.concat(funcs.len().to_string())
        summary = summary.concat(" records=")
        summary = summary.concat(records.len().to_string())
        summary = summary.concat(" enums=")
        summary = summary.concat(enums.len().to_string())
        summary = summary.concat(" variants=")
        summary = summary.concat(variants.len().to_string())
        Stdio::eprintln(summary)
    }
}

fn dump_wit_bindings_if_enabled(config: DriverConfig) {
    if !config_record::config_dump_wit_bindings(config) {
        return
    }
    Stdio::eprintln("=== WIT BINDINGS ===")
    let paths = config_record::config_wit_paths(config)
    for i in 0..paths.len() {
        let path = get_unchecked(paths, i)
        let read_result = Fs::read_to_string(path.clone())
        match read_result {
            Result::Ok(source) => {
                Stdio::eprintln("// source: ".concat(path.clone()))
                Stdio::eprintln(component::emit_wit_bindings_text(source))
            },
            Result::Err(error) => {
                Stdio::eprintln("// unable to read WIT binding source: ".concat(error))
            },
        }
    }
}

fn dump_resolved_scope(ctx: ResolveCtx) {
    resolver_dump_view::driver_dump_scope(ctx)
}

fn dump_checked_hir(result: TypeCheckResult) {
    typechecker_dump_view::driver_dump_typed_hir(result)
}

pub fn dump_tokens(tokens: Vec<Token>) {
    Stdio::eprintln("=== TOKENS ===")
    let token_count = tokens.len()
    let mut i = 0
    while i < token_count {
        let tok = get_unchecked(tokens, i)
        Stdio::eprintln(names::token_kind_name(token_state::Token_kind(tok)).concat(" ".concat(token_state::Token_text(tok))))
        i = i + 1
    }
}

fn phase_timing_ms(start: i64, end: i64) -> i32 {
    let diff = end - start
    if diff < 0i64 {
        return 0
    }
    __intrinsic_i64_to_i32(diff / 1000000i64)
}

pub fn emit_phase_timing(
    t0: i64,
    t_lex: i64,
    t_parse: i64,
    t_resolve: i64,
    t_typecheck: i64,
    t_lower: i64,
    t_mir_opt: i64,
    t_mir_verify: i64,
    t_emit: i64
) {
    Stdio::eprintln("[arukellt] lex: ".concat(phase_timing_ms(t0, t_lex).to_string().concat("ms")))
    Stdio::eprintln("[arukellt] parse: ".concat(phase_timing_ms(t_lex, t_parse).to_string().concat("ms")))
    Stdio::eprintln("[arukellt] resolve: ".concat(phase_timing_ms(t_parse, t_resolve).to_string().concat("ms")))
    Stdio::eprintln("[arukellt] typecheck: ".concat(phase_timing_ms(t_resolve, t_typecheck).to_string().concat("ms")))
    Stdio::eprintln("[arukellt] lower: ".concat(phase_timing_ms(t_typecheck, t_lower).to_string().concat("ms")))
    Stdio::eprintln("[arukellt] mir_opt: ".concat(phase_timing_ms(t_lower, t_mir_opt).to_string().concat("ms")))
    Stdio::eprintln("[arukellt] mir_verify: ".concat(phase_timing_ms(t_mir_opt, t_mir_verify).to_string().concat("ms")))
    Stdio::eprintln("[arukellt] emit: ".concat(phase_timing_ms(t_mir_verify, t_emit).to_string().concat("ms")))
    Stdio::eprintln("[arukellt] total: ".concat(phase_timing_ms(t0, t_emit).to_string().concat("ms")))
}
