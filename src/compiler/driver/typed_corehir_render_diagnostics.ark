use corehir::fn_info
use corehir::raw_decls
use corehir::raw_dto
use corehir::raw_record
use driver::verified_core_render_safe

fn diagnose_typed_corehir_rejection(program: CoreHirRawProgram) -> String {
    let modules = raw_record::raw_program_modules(program)
    if len(modules) == 0 {
        return "TypedCoreHIR reject: no modules"
    }
    let main_module = get_unchecked(modules, len(modules) - 1)
    let main_decl_start = raw_dto::CoreHirModuleInfo_decl_start(main_module)
    let main_decl_end = main_decl_start + raw_dto::CoreHirModuleInfo_decl_count(main_module)
    let fn_infos = raw_decls::program_fn_infos(program)
    let mut main_function_count = 0
    let mut function_index = 0
    while function_index < len(fn_infos) {
        let decl_index = fn_info::fn_info_decl_index_at(fn_infos, function_index, 0 - 1)
        if decl_index >= main_decl_start && decl_index < main_decl_end {
            main_function_count = main_function_count + 1
            if !verified_core_render_safe::vcs_typed_function_exists(program, function_index) {
                return concat("TypedCoreHIR reject: missing typed function index=", to_string(function_index))
            }
            let root = verified_core_render_safe::vcs_body_root(program, function_index)
            if !verified_core_render_safe::vcs_body_root_is_valid(program, root) {
                return concat(
                    concat("TypedCoreHIR reject: invalid body root function=", to_string(function_index)),
                    concat(" root=", to_string(root))
                )
            }
            let reachable = verified_core_render_safe::vcs_collect_reachable(program, root)
            if !verified_core_render_safe::vcs_reachable_is_typed(program, reachable) {
                return concat("TypedCoreHIR reject: untyped reachable expression function=", to_string(function_index))
            }
            let return_vt = verified_core_render_safe::vcs_return_value_type(program, function_index)
            let return_type_id = verified_core_render_safe::vcs_return_type_id(program, function_index)
            if return_vt < 0 || return_type_id < 0 {
                return concat(
                    concat("TypedCoreHIR reject: invalid return type function=", to_string(function_index)),
                    concat(
                        concat(" value_type=", to_string(return_vt)),
                        concat(" type_id=", to_string(return_type_id))
                    )
                )
            }
            let name = verified_core_render_safe::vcs_function_name(program, function_index)
            if len(clone(name)) == 0 {
                return concat("TypedCoreHIR reject: empty function name index=", to_string(function_index))
            }
            if !verified_core_render_safe::vcs_parameters_are_valid(program, function_index) {
                return concat("TypedCoreHIR reject: invalid parameters function=", to_string(function_index))
            }
        }
        function_index = function_index + 1
    }
    if main_function_count == 0 {
        return "TypedCoreHIR reject: no functions in main module"
    }
    "TypedCoreHIR reject: contract renderer returned empty after preconditions"
}
