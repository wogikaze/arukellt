use compiler::session
use corehir::frontend_bundle
use corehir::mod
use loader::module_state_modules

struct CheckedProgram {
    all_decls: Vec<AstNode>,
    core_program: CoreHirRawProgram,
    session: CompileSession,
    main_decls: Vec<AstNode>,
}

fn CheckedProgram_new(
    all_decls: Vec<AstNode>,
    core_program: CoreHirRawProgram,
    session: CompileSession,
    main_decls: Vec<AstNode>
) -> CheckedProgram {
    CheckedProgram { all_decls: all_decls, core_program: core_program, session: session, main_decls: main_decls }
}

fn build_checked_program_bundle(
    all_decls: Vec<AstNode>,
    check_result: TypeCheckResult,
    modules: Vec<ModuleDecls>,
    module_stdlib_flags: Vec<bool>,
    main_decls: Vec<AstNode>
) -> FrontendBundle {
    let mut module_names = Vec::new<String>()
    let mut module_decl_counts = Vec::new<i32>()
    let module_count = modules.len()
    let mut mi = 0
    while mi < module_count {
        let md = modules.get_unchecked(mi)
        let decl_count = module_state_modules::ModuleDecls_decl_count(md)
        // Hoist the String field into a local: the pinned compiler's linear
        // method-argument staging materializes a field-access argument before
        // `push` reads it, which makes the pin-built s2 invalid. Delete the
        // local when the pin is refreshed past that staging bug.
        let module_name = md.name
        module_names.push(module_name)
        module_decl_counts.push(decl_count)
        mi = mi + 1
    }
    frontend_bundle::FrontendBundle_new(
        all_decls,
        check_result,
        module_names,
        module_decl_counts,
        module_stdlib_flags,
        main_decls
    )
}

fn build_checked_program(
    all_decls: Vec<AstNode>,
    check_result: TypeCheckResult,
    modules: Vec<ModuleDecls>,
    module_stdlib_flags: Vec<bool>,
    main_decls: Vec<AstNode>,
    include_body_artifact: bool
) -> CheckedProgram {
    let bundle = build_checked_program_bundle(all_decls, check_result, modules, module_stdlib_flags, main_decls)
    let retained_decls = frontend_bundle::bundle_decls(bundle)
    let core_program = if include_body_artifact {
        mod::build_from_frontend_bundle(bundle)
    } else {
        mod::build_from_frontend_bundle_without_bodies(bundle)
    }
    let session = session::CompileSession_build(core_program)
    CheckedProgram_new(retained_decls, core_program, session, main_decls)
}

fn checked_program_session(program: CheckedProgram) -> CompileSession {
    program.session
}

fn checked_program_core_program(program: CheckedProgram) -> CoreHirRawProgram {
    program.core_program
}

fn checked_program_export_surface(program: CheckedProgram) -> CoreHirExportSurface {
    mod::build_export_surface(program.main_decls)
}

fn checked_program_wit_decls(program: CheckedProgram) -> Vec<AstNode> {
    program.main_decls
}

fn checked_program_all_decls(program: CheckedProgram) -> Vec<AstNode> {
    program.all_decls
}
