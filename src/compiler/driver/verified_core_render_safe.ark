use corehir::body_table
use corehir::expr_raw
use corehir::fn_info
use corehir::param
use corehir::raw_bodies
use corehir::raw_decls
use corehir::raw_dto
use corehir::raw_record
use corehir::raw_types
use corehir::value_types
use driver::config_record
use driver::verified_core_render
use typechecker::contract_typed_fn
use typechecker::name_display

// Keep GC-reference-bearing locals in small helpers. The selfhost Wasm GC
// backend otherwise has to assign several unrelated struct/array reference
// types inside one large renderer function.

fn vcs_typed_index(program: CoreHirRawProgram, function_index: i32) -> i32 {
    let fn_infos = raw_decls::program_fn_infos(program)
    fn_info::fn_info_typed_index_at(fn_infos, function_index, 0 - 1)
}

fn vcs_typed_function_exists(program: CoreHirRawProgram, function_index: i32) -> bool {
    let typed_index = vcs_typed_index(program, function_index)
    if typed_index < 0 {
        return false
    }
    let typed_fns = raw_types::program_typed_fns(program)
    typed_index < len(typed_fns)
}

fn vcs_return_value_type(program: CoreHirRawProgram, function_index: i32) -> i32 {
    let typed_index = vcs_typed_index(program, function_index)
    let typed_fns = raw_types::program_typed_fns(program)
    if typed_index < 0 || typed_index >= len(typed_fns) {
        return 0 - 1
    }
    let typed_fn = get_unchecked(typed_fns, typed_index)
    let return_type = contract_typed_fn::TypedFn_return_type(typed_fn)
    verified_core_render::vc_type_info_value_type(return_type)
}

fn vcs_return_type_id(program: CoreHirRawProgram, function_index: i32) -> i32 {
    let typed_index = vcs_typed_index(program, function_index)
    let typed_fns = raw_types::program_typed_fns(program)
    if typed_index < 0 || typed_index >= len(typed_fns) {
        return 0 - 1
    }
    let typed_fn = get_unchecked(typed_fns, typed_index)
    let return_type = contract_typed_fn::TypedFn_return_type(typed_fn)
    let return_vt = verified_core_render::vc_type_info_value_type(return_type)
    verified_core_render::vc_type_id(
        return_vt,
        name_display::type_display_name(return_type)
    )
}

fn vcs_typed_param_count(program: CoreHirRawProgram, function_index: i32) -> i32 {
    let typed_index = vcs_typed_index(program, function_index)
    let typed_fns = raw_types::program_typed_fns(program)
    if typed_index < 0 || typed_index >= len(typed_fns) {
        return 0 - 1
    }
    let typed_fn = get_unchecked(typed_fns, typed_index)
    len(contract_typed_fn::TypedFn_param_types(typed_fn))
}

fn vcs_body_root(program: CoreHirRawProgram, function_index: i32) -> i32 {
    let fn_infos = raw_decls::program_fn_infos(program)
    let body_index = fn_info::fn_info_body_index_at(fn_infos, function_index, 0 - 1)
    let table = raw_bodies::program_body_table(program)
    if body_index < 0 || body_index >= body_table::corehir_body_table_fn_body_root_count(table) {
        return 0 - 1
    }
    body_table::corehir_body_table_fn_body_root_at(table, body_index)
}

fn vcs_body_root_is_valid(program: CoreHirRawProgram, root: i32) -> bool {
    if root < 0 {
        return false
    }
    let table = raw_bodies::program_body_table(program)
    let exprs = body_table::corehir_body_table_exprs(table)
    root < len(exprs)
}

fn vcs_collect_reachable(program: CoreHirRawProgram, root: i32) -> Vec<i32> {
    let table = raw_bodies::program_body_table(program)
    let exprs = body_table::corehir_body_table_exprs(table)
    let reachable = Vec::new<i32>()
    let stack = Vec::new<i32>()
    push(stack, root)
    while len(stack) > 0 {
        let id = pop(stack).unwrap()
        let mut already_seen = false
        let mut seen_i = 0
        while seen_i < len(reachable) {
            if get_unchecked(reachable, seen_i) == id {
                already_seen = true
                seen_i = len(reachable)
            } else {
                seen_i = seen_i + 1
            }
        }
        if !already_seen {
            push(reachable, id)
            if id >= 0 && id < len(exprs) {
                let expr = get_unchecked(exprs, id)
                let child_count = expr_raw::corehir_expr_child_count(expr)
                let mut child_i = 0
                while child_i < child_count {
                    push(stack, expr_raw::corehir_expr_child(expr, child_i))
                    child_i = child_i + 1
                }
            }
        }
    }
    reachable
}

fn vcs_reachable_is_typed(program: CoreHirRawProgram, reachable: Vec<i32>) -> bool {
    let table = raw_bodies::program_body_table(program)
    let exprs = body_table::corehir_body_table_exprs(table)
    let mut i = 0
    while i < len(reachable) {
        let id = get_unchecked(reachable, i)
        if id < 0 || id >= len(exprs) {
            return false
        }
        let expr = get_unchecked(exprs, id)
        let type_id = verified_core_render::vc_type_id(
            expr_raw::corehir_expr_val_type(expr),
            expr_raw::corehir_expr_type_name(expr)
        )
        if type_id < 0 {
            return false
        }
        i = i + 1
    }
    true
}

fn vcs_function_name(program: CoreHirRawProgram, function_index: i32) -> String {
    let fn_infos = raw_decls::program_fn_infos(program)
    let qualified = fn_info::fn_info_qualified_name_at(fn_infos, function_index, "")
    if len(clone(qualified)) > 0 {
        return qualified
    }
    fn_info::fn_info_name_at(fn_infos, function_index, "")
}

fn vcs_parameters_are_valid(program: CoreHirRawProgram, function_index: i32) -> bool {
    let fn_infos = raw_decls::program_fn_infos(program)
    let param_count = fn_info::fn_info_param_count_at(fn_infos, function_index, 0)
    if vcs_typed_param_count(program, function_index) != param_count {
        return false
    }
    let mut i = 0
    while i < param_count {
        let p = fn_info::fn_info_param_at(fn_infos, function_index, i)
        if verified_core_render::vc_type_id(
            param::param_value_type(p),
            param::param_type_name(p)
        ) < 0 {
            return false
        }
        i = i + 1
    }
    true
}

fn vcs_render_signature_parameters(program: CoreHirRawProgram, function_index: i32) -> String {
    let fn_infos = raw_decls::program_fn_infos(program)
    let param_count = fn_info::fn_info_param_count_at(fn_infos, function_index, 0)
    let mut out = ""
    let mut i = 0
    while i < param_count {
        if i > 0 {
            out = concat(out, ",")
        }
        let p = fn_info::fn_info_param_at(fn_infos, function_index, i)
        let type_id = verified_core_render::vc_type_id(
            param::param_value_type(p),
            param::param_type_name(p)
        )
        out = concat(out, concat("{\"name\":", verified_core_render::vc_quote(param::param_name(p))))
        out = concat(out, concat(",\"type_id\":", concat(to_string(type_id), "}")))
        i = i + 1
    }
    out
}

fn vcs_render_abi_parameters(program: CoreHirRawProgram, function_index: i32) -> String {
    let fn_infos = raw_decls::program_fn_infos(program)
    let param_count = fn_info::fn_info_param_count_at(fn_infos, function_index, 0)
    let mut out = ""
    let mut i = 0
    while i < param_count {
        if i > 0 {
            out = concat(out, ",")
        }
        let p = fn_info::fn_info_param_at(fn_infos, function_index, i)
        let value_type = param::param_value_type(p)
        let type_id = verified_core_render::vc_type_id(value_type, param::param_type_name(p))
        out = concat(out, verified_core_render::vc_render_abi_item(type_id, value_type))
        i = i + 1
    }
    out
}

fn vcs_render_parameter_locals(program: CoreHirRawProgram, function_index: i32) -> String {
    let fn_infos = raw_decls::program_fn_infos(program)
    let param_count = fn_info::fn_info_param_count_at(fn_infos, function_index, 0)
    let mut out = ""
    let mut i = 0
    while i < param_count {
        if i > 0 {
            out = concat(out, ",")
        }
        let p = fn_info::fn_info_param_at(fn_infos, function_index, i)
        let type_id = verified_core_render::vc_type_id(
            param::param_value_type(p),
            param::param_type_name(p)
        )
        out = concat(out, concat("{\"id\":", to_string(i)))
        out = concat(out, concat(",\"name\":", verified_core_render::vc_quote(param::param_name(p))))
        out = concat(out, concat(",\"type_id\":", to_string(type_id)))
        out = concat(out, ",\"storage\":\"parameter\"}")
        i = i + 1
    }
    out
}

fn vcs_is_reachable(reachable: Vec<i32>, expr_id: i32) -> bool {
    let mut i = 0
    while i < len(reachable) {
        if get_unchecked(reachable, i) == expr_id {
            return true
        }
        i = i + 1
    }
    false
}

fn vcs_render_expressions(program: CoreHirRawProgram, reachable: Vec<i32>) -> String {
    let table = raw_bodies::program_body_table(program)
    let exprs = body_table::corehir_body_table_exprs(table)
    let mut out = ""
    let mut first = true
    let mut expr_id = 0
    while expr_id < len(exprs) {
        if vcs_is_reachable(reachable, expr_id) {
            if !first {
                out = concat(out, ",")
            }
            out = concat(out, verified_core_render::vc_render_expression(program, expr_id))
            first = false
        }
        expr_id = expr_id + 1
    }
    out
}

fn vcs_render_function(program: CoreHirRawProgram, function_index: i32) -> String {
    if !vcs_typed_function_exists(program, function_index) {
        return ""
    }
    let root = vcs_body_root(program, function_index)
    if !vcs_body_root_is_valid(program, root) {
        return ""
    }
    let reachable = vcs_collect_reachable(program, root)
    if !vcs_reachable_is_typed(program, reachable) {
        return ""
    }
    let return_vt = vcs_return_value_type(program, function_index)
    let return_type_id = vcs_return_type_id(program, function_index)
    if return_vt < 0 || return_type_id < 0 {
        return ""
    }
    let name = vcs_function_name(program, function_index)
    if len(clone(name)) == 0 || !vcs_parameters_are_valid(program, function_index) {
        return ""
    }

    let mut out = concat("{\"id\":", to_string(function_index))
    out = concat(out, concat(",\"name\":", verified_core_render::vc_quote(name)))
    out = concat(out, ",\"signature\":{\"parameters\":[")
    out = concat(out, vcs_render_signature_parameters(program, function_index))
    out = concat(out, concat("],\"return_type_id\":", concat(to_string(return_type_id), "}")))
    out = concat(out, ",\"abi\":{\"calling_convention\":\"arukellt\",\"parameters\":[")
    out = concat(out, vcs_render_abi_parameters(program, function_index))
    out = concat(out, "],\"results\":[")
    if return_vt != value_types::VT_VOID() {
        out = concat(out, verified_core_render::vc_render_abi_item(return_type_id, return_vt))
    }
    out = concat(out, "]}")
    out = concat(out, ",\"locals\":[")
    out = concat(out, vcs_render_parameter_locals(program, function_index))
    out = concat(out, "],\"contracts\":[]")
    out = concat(out, concat(",\"body\":{\"root_expr_id\":", to_string(root)))
    out = concat(out, ",\"expressions\":[")
    out = concat(out, vcs_render_expressions(program, reachable))
    out = concat(out, "]}}")
    out
}

fn render_verified_core(program: CoreHirRawProgram, config: DriverConfig) -> String {
    let pointer_width = if contains(config_record::config_target(config), "64") { 64 } else { 32 }
    let module_name = if len(config_record::config_source_file(config)) > 0 {
        config_record::config_source_file(config)
    } else {
        "<memory>"
    }

    let mut out = "{\"schema\":\"arukellt-verified-core\",\"schema_version\":1,\"generator\":\"arukellt-selfhost\",\"module\":"
    out = concat(out, verified_core_render::vc_quote(module_name))
    out = concat(out, ",\"target_profile\":{\"integer_model\":\"machine\",\"overflow\":\"compiler-current\",\"floating_point\":\"ieee754\",\"pointer_width\":")
    out = concat(out, concat(to_string(pointer_width), "}"))
    out = concat(out, ",\"types\":[")
    let mut type_id = 0
    while type_id < verified_core_render::vc_type_count() {
        if type_id > 0 {
            out = concat(out, ",")
        }
        out = concat(out, verified_core_render::vc_render_type(type_id, pointer_width))
        type_id = type_id + 1
    }
    out = concat(out, "],\"functions\":[")

    let modules = raw_record::raw_program_modules(program)
    if len(modules) == 0 {
        return ""
    }
    let main_module = get_unchecked(modules, len(modules) - 1)
    let main_decl_start = raw_dto::CoreHirModuleInfo_decl_start(main_module)
    let main_decl_end = main_decl_start + raw_dto::CoreHirModuleInfo_decl_count(main_module)
    let fn_infos = raw_decls::program_fn_infos(program)
    let mut first_function = true
    let mut function_index = 0
    while function_index < len(fn_infos) {
        let decl_index = fn_info::fn_info_decl_index_at(fn_infos, function_index, 0 - 1)
        if decl_index >= main_decl_start && decl_index < main_decl_end {
            let rendered = vcs_render_function(program, function_index)
            if len(clone(rendered)) == 0 {
                return ""
            }
            if !first_function {
                out = concat(out, ",")
            }
            out = concat(out, rendered)
            first_function = false
        }
        function_index = function_index + 1
    }
    out = concat(out, "]}")
    out
}
