use corehir::body_table
use corehir::expr_raw
use corehir::fn_info
use corehir::param
use corehir::raw_bodies
use corehir::raw_decls
use corehir::raw_types
use corehir::value_types
use driver::config_record
use typechecker::contract_type_access
use typechecker::contract_typed_fn
use typechecker::kinds
use typechecker::name_display

struct VerifiedCoreRenderResult {
    ok: bool,
    output: String,
    error: String,
}

struct VerifiedCoreTypeRegistry {
    ok: bool,
    error: String,
    names: Vec<String>,
    value_types: Vec<i32>,
}

fn VerifiedCoreRenderResult_ok(output: String) -> VerifiedCoreRenderResult {
    VerifiedCoreRenderResult { ok: true, output: output, error: "" }
}

fn VerifiedCoreRenderResult_err(error: String) -> VerifiedCoreRenderResult {
    VerifiedCoreRenderResult { ok: false, output: "", error: error }
}

fn verified_core_render_result_ok(result: VerifiedCoreRenderResult) -> bool {
    result.ok
}

fn verified_core_render_result_output(result: VerifiedCoreRenderResult) -> String {
    clone(result.output)
}

fn verified_core_render_result_error(result: VerifiedCoreRenderResult) -> String {
    clone(result.error)
}

fn VerifiedCoreTypeRegistry_new() -> VerifiedCoreTypeRegistry {
    let registry = VerifiedCoreTypeRegistry {
        ok: true,
        error: "",
        names: Vec::new<String>(),
        value_types: Vec::new<i32>(),
    }
    vc_register_type(registry, value_types::VT_VOID(), "()")
    registry
}

fn vc_registry_fail(registry: VerifiedCoreTypeRegistry, message: String) {
    if registry.ok {
        registry.ok = false
        registry.error = message
    }
}

fn vc_string_has_question(s: String) -> bool {
    let n = len(s)
    let mut i = 0
    while i < n {
        if char_at(s, i) == 63 {
            return true
        }
        i = i + 1
    }
    false
}

fn vc_normalize_type_name(value_type: i32, supplied: String) -> String {
    if len(clone(supplied)) > 0 {
        if vc_string_has_question(clone(supplied)) || eq(clone(supplied), "unknown") {
            return ""
        }
        return supplied
    }
    if value_type == value_types::VT_VOID() { return "()" }
    if value_type == value_types::VT_I32() { return "i32" }
    if value_type == value_types::VT_I64() { return "i64" }
    if value_type == value_types::VT_F32() { return "f32" }
    if value_type == value_types::VT_F64() { return "f64" }
    if value_type == value_types::VT_V128() { return "v128" }
    if value_type == value_types::VT_FUNCREF() { return "fnref" }
    // A reference without a semantic name cannot be verified safely.
    ""
}

fn vc_register_type(registry: VerifiedCoreTypeRegistry, value_type: i32, supplied_name: String) -> i32 {
    if !registry.ok {
        return 0 - 1
    }
    let name = vc_normalize_type_name(value_type, supplied_name)
    if len(clone(name)) == 0 {
        vc_registry_fail(
            registry,
            concat("VerifiedCore requires an explicit type name for value type ", to_string(value_type))
        )
        return 0 - 1
    }
    let count = len(registry.names)
    let mut i = 0
    while i < count {
        if registry.value_types[i] == value_type && eq(clone(registry.names[i]), clone(name)) {
            return i
        }
        i = i + 1
    }
    push(registry.names, name)
    push(registry.value_types, value_type)
    count
}

fn vc_find_type(registry: VerifiedCoreTypeRegistry, value_type: i32, supplied_name: String) -> i32 {
    let name = vc_normalize_type_name(value_type, supplied_name)
    if len(clone(name)) == 0 {
        return 0 - 1
    }
    let count = len(registry.names)
    let mut i = 0
    while i < count {
        if registry.value_types[i] == value_type && eq(clone(registry.names[i]), clone(name)) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn vc_type_info_value_type(ty: TypeInfo) -> i32 {
    let tag = contract_type_access::TypeInfo_tag(ty)
    if tag == kinds::TY_I32() || tag == kinds::TY_BOOL() || tag == kinds::TY_CHAR() {
        return value_types::VT_I32()
    }
    if tag == kinds::TY_I64() { return value_types::VT_I64() }
    if tag == kinds::TY_F32() { return value_types::VT_F32() }
    if tag == kinds::TY_F64() { return value_types::VT_F64() }
    if tag == kinds::TY_V128() { return value_types::VT_V128() }
    if tag == kinds::TY_UNIT() || tag == kinds::TY_NEVER() { return value_types::VT_VOID() }
    if tag == kinds::TY_STRING() { return value_types::VT_REF() }
    if tag == kinds::TY_FN() { return value_types::VT_FUNCREF() }
    if tag == kinds::TY_VEC() || tag == kinds::TY_OPTION() || tag == kinds::TY_RESULT() ||
       tag == kinds::TY_HASHMAP() || tag == kinds::TY_FUTURE() || tag == kinds::TY_STREAM() ||
       tag == kinds::TY_TUPLE() || tag == kinds::TY_STRUCT() || tag == kinds::TY_ENUM() ||
       tag == kinds::TY_RESOURCE() {
        return value_types::VT_GC_REF()
    }
    0 - 1
}

fn vc_collect_types(program: CoreHirRawProgram, registry: VerifiedCoreTypeRegistry) {
    let fn_infos = raw_decls::program_fn_infos(program)
    let typed_fns = raw_types::program_typed_fns(program)
    let fn_count = len(fn_infos)
    let mut fi = 0
    while fi < fn_count && registry.ok {
        let param_count = fn_info::fn_info_param_count_at(fn_infos, fi, 0)
        let mut pi = 0
        while pi < param_count && registry.ok {
            let p = fn_info::fn_info_param_at(fn_infos, fi, pi)
            vc_register_type(registry, param::param_value_type(p), param::param_type_name(p))
            pi = pi + 1
        }
        let typed_index = fn_info::fn_info_typed_index_at(fn_infos, fi, 0 - 1)
        if typed_index < 0 || typed_index >= len(typed_fns) {
            vc_registry_fail(registry, concat("VerifiedCore missing TypedFn for function index ", to_string(fi)))
        } else {
            let typed_fn = get_unchecked(typed_fns, typed_index)
            let return_type = contract_typed_fn::TypedFn_return_type(typed_fn)
            let return_vt = vc_type_info_value_type(return_type)
            if return_vt < 0 {
                vc_registry_fail(registry, concat("VerifiedCore unsupported return type for function index ", to_string(fi)))
            } else {
                vc_register_type(registry, return_vt, name_display::type_display_name(return_type))
            }
        }
        fi = fi + 1
    }

    let table = raw_bodies::program_body_table(program)
    let exprs = body_table::corehir_body_table_exprs(table)
    let expr_count = len(exprs)
    let mut ei = 0
    while ei < expr_count && registry.ok {
        let expr = get_unchecked(exprs, ei)
        if expr_raw::corehir_expr_kind(expr) == 0 {
            vc_registry_fail(registry, concat("VerifiedCore contains unsupported CoreHIR expression ", to_string(ei)))
        } else {
            vc_register_type(
                registry,
                expr_raw::corehir_expr_val_type(expr),
                expr_raw::corehir_expr_type_name(expr)
            )
        }
        ei = ei + 1
    }
}

fn vc_value_type_name(value_type: i32) -> String {
    if value_type == value_types::VT_VOID() { return "void" }
    if value_type == value_types::VT_I32() { return "i32" }
    if value_type == value_types::VT_I64() { return "i64" }
    if value_type == value_types::VT_F32() { return "f32" }
    if value_type == value_types::VT_F64() { return "f64" }
    if value_type == value_types::VT_V128() { return "v128" }
    if value_type == value_types::VT_REF() { return "ref" }
    if value_type == value_types::VT_GC_REF() { return "gc-ref" }
    if value_type == value_types::VT_FUNCREF() { return "funcref" }
    ""
}

fn vc_type_kind(value_type: i32, name: String) -> String {
    if value_type == value_types::VT_VOID() { return "unit" }
    if eq(clone(name), "bool") { return "bool" }
    if value_type == value_types::VT_F32() || value_type == value_types::VT_F64() { return "float" }
    if value_type == value_types::VT_V128() { return "vector" }
    if eq(clone(name), "String") || eq(clone(name), "string") { return "string" }
    if value_type == value_types::VT_FUNCREF() { return "function" }
    if value_type == value_types::VT_REF() || value_type == value_types::VT_GC_REF() { return "reference" }
    "integer"
}

fn vc_representation_kind(value_type: i32) -> String {
    if value_type == value_types::VT_VOID() { return "unit" }
    if value_type == value_types::VT_REF() { return "linear-ptr" }
    if value_type == value_types::VT_GC_REF() { return "gc-ref" }
    if value_type == value_types::VT_FUNCREF() { return "funcref" }
    "scalar"
}

fn vc_wasm_json(value_type: i32) -> String {
    if value_type == value_types::VT_VOID() { return "[]" }
    if value_type == value_types::VT_I32() || value_type == value_types::VT_REF() { return "[\"i32\"]" }
    if value_type == value_types::VT_I64() { return "[\"i64\"]" }
    if value_type == value_types::VT_F32() { return "[\"f32\"]" }
    if value_type == value_types::VT_F64() { return "[\"f64\"]" }
    if value_type == value_types::VT_V128() { return "[\"v128\"]" }
    if value_type == value_types::VT_GC_REF() { return "[\"gc-ref\"]" }
    if value_type == value_types::VT_FUNCREF() { return "[\"funcref\"]" }
    "[]"
}

fn vc_nullable(value_type: i32) -> bool {
    value_type == value_types::VT_REF() || value_type == value_types::VT_GC_REF() || value_type == value_types::VT_FUNCREF()
}

fn vc_size_bytes(value_type: i32, pointer_width: i32) -> i32 {
    if value_type == value_types::VT_VOID() { return 0 }
    if value_type == value_types::VT_I64() || value_type == value_types::VT_F64() { return 8 }
    if value_type == value_types::VT_V128() { return 16 }
    if value_type == value_types::VT_REF() || value_type == value_types::VT_GC_REF() || value_type == value_types::VT_FUNCREF() {
        return pointer_width / 8
    }
    4
}

fn vc_align_bytes(value_type: i32, pointer_width: i32) -> i32 {
    let size = vc_size_bytes(value_type, pointer_width)
    if size == 0 { return 1 }
    size
}

fn vc_passing(value_type: i32) -> String {
    if value_type == value_types::VT_REF() || value_type == value_types::VT_GC_REF() || value_type == value_types::VT_FUNCREF() {
        return "reference"
    }
    "value"
}

fn vc_bool_json(value: bool) -> String {
    if value { "true" } else { "false" }
}

fn vc_json_escape(s: String) -> String {
    let n = len(s)
    let mut out = ""
    let mut i = 0
    while i < n {
        let c = char_at(s, i)
        if c == 34 {
            out = concat(out, "\\\"")
        } else if c == 92 {
            out = concat(out, "\\\\")
        } else if c == 10 {
            out = concat(out, "\\n")
        } else if c == 13 {
            out = concat(out, "\\r")
        } else if c == 9 {
            out = concat(out, "\\t")
        } else {
            out = concat(out, substring(clone(s), i, i + 1))
        }
        i = i + 1
    }
    out
}

fn vc_quote(s: String) -> String {
    concat("\"", concat(vc_json_escape(s), "\""))
}

fn vc_render_type(registry: VerifiedCoreTypeRegistry, type_id: i32, pointer_width: i32) -> String {
    let name = clone(registry.names[type_id])
    let value_type = registry.value_types[type_id]
    let mut out = concat("{\"id\":", to_string(type_id))
    out = concat(out, concat(",\"kind\":", vc_quote(vc_type_kind(value_type, clone(name)))))
    out = concat(out, concat(",\"name\":", vc_quote(name)))
    out = concat(out, concat(",\"value_type\":", vc_quote(vc_value_type_name(value_type))))
    out = concat(out, concat(",\"representation\":{\"kind\":", vc_quote(vc_representation_kind(value_type))))
    out = concat(out, concat(",\"wasm\":", vc_wasm_json(value_type)))
    out = concat(out, concat(",\"nullable\":", vc_bool_json(vc_nullable(value_type))))
    out = concat(out, concat(",\"size_bytes\":", to_string(vc_size_bytes(value_type, pointer_width))))
    out = concat(out, concat(",\"align_bytes\":", concat(to_string(vc_align_bytes(value_type, pointer_width)), "}}")))
    out
}

fn vc_expr_kind_name(kind: i32) -> String {
    if kind == 1 { return "block" }
    if kind == 2 { return "let" }
    if kind == 3 { return "return" }
    if kind == 4 { return "call" }
    if kind == 5 { return "ident" }
    if kind == 6 { return "int" }
    if kind == 7 { return "float" }
    if kind == 8 { return "string" }
    if kind == 9 { return "bool" }
    if kind == 10 { return "char" }
    if kind == 11 { return "binary" }
    if kind == 12 { return "unary" }
    if kind == 13 { return "if" }
    if kind == 14 { return "assign" }
    if kind == 15 { return "field-access" }
    if kind == 16 { return "index" }
    if kind == 17 { return "array" }
    if kind == 18 { return "tuple" }
    if kind == 19 { return "method-call" }
    if kind == 20 { return "while" }
    if kind == 21 { return "loop" }
    if kind == 22 { return "break" }
    if kind == 23 { return "continue" }
    if kind == 24 { return "try" }
    if kind == 25 { return "for-range" }
    if kind == 26 { return "struct" }
    if kind == 27 { return "struct-field" }
    if kind == 28 { return "path" }
    if kind == 29 { return "comprehension" }
    if kind == 30 { return "struct-base" }
    if kind == 31 { return "for-values" }
    if kind == 32 { return "for-iter" }
    if kind == 33 { return "match" }
    if kind == 34 { return "match-arm" }
    if kind == 35 { return "pattern-ident" }
    if kind == 36 { return "pattern-wildcard" }
    if kind == 37 { return "pattern-literal" }
    if kind == 38 { return "pattern-variant" }
    if kind == 39 { return "pattern-or" }
    if kind == 40 { return "closure" }
    if kind == 41 { return "array-repeat" }
    "unsupported"
}

fn vc_contains_id(ids: Vec<i32>, id: i32) -> bool {
    let count = len(ids)
    let mut i = 0
    while i < count {
        if ids[i] == id { return true }
        i = i + 1
    }
    false
}

fn vc_collect_reachable(exprs: Vec<CoreHirExpr>, root: i32) -> Vec<i32> {
    let reachable = Vec::new<i32>()
    let stack = Vec::new<i32>()
    push(stack, root)
    while len(stack) > 0 {
        let id = pop(stack).unwrap()
        if vc_contains_id(reachable, id) {
            continue
        }
        push(reachable, id)
        let expr = get_unchecked(exprs, id)
        let child_count = expr_raw::corehir_expr_child_count(expr)
        let mut ci = 0
        while ci < child_count {
            push(stack, expr_raw::corehir_expr_child(expr, ci))
            ci = ci + 1
        }
    }
    reachable
}

fn vc_render_expression(exprs: Vec<CoreHirExpr>, expr_id: i32, registry: VerifiedCoreTypeRegistry) -> String {
    let expr = get_unchecked(exprs, expr_id)
    let kind = expr_raw::corehir_expr_kind(expr)
    let value_type = expr_raw::corehir_expr_val_type(expr)
    let type_id = vc_find_type(registry, value_type, expr_raw::corehir_expr_type_name(expr))
    let mut out = concat("{\"id\":", to_string(expr_id))
    out = concat(out, concat(",\"kind\":", vc_quote(vc_expr_kind_name(kind))))
    out = concat(out, concat(",\"kind_id\":", to_string(kind)))
    out = concat(out, concat(",\"type_id\":", to_string(type_id)))
    out = concat(out, concat(",\"value_type\":", vc_quote(vc_value_type_name(value_type))))
    out = concat(out, concat(",\"text\":", vc_quote(expr_raw::corehir_expr_text(expr))))
    out = concat(out, concat(",\"int_value\":", to_string(expr_raw::corehir_expr_int_val(expr))))
    out = concat(out, concat(",\"float_value\":", to_string(expr_raw::corehir_expr_float_val(expr))))
    let span_start = expr_raw::corehir_expr_span_start(expr)
    out = concat(out, concat(",\"span_start\":", to_string(if span_start < 0 { 0 } else { span_start })))
    out = concat(out, ",\"children\":[")
    let child_count = expr_raw::corehir_expr_child_count(expr)
    let mut ci = 0
    while ci < child_count {
        if ci > 0 { out = concat(out, ",") }
        out = concat(out, to_string(expr_raw::corehir_expr_child(expr, ci)))
        ci = ci + 1
    }
    concat(out, "]}")
}

fn vc_render_abi_item(type_id: i32, value_type: i32) -> String {
    let mut out = concat("{\"type_id\":", to_string(type_id))
    out = concat(out, concat(",\"passing\":", vc_quote(vc_passing(value_type))))
    out = concat(out, concat(",\"wasm\":", concat(vc_wasm_json(value_type), "}")))
    out
}

fn vc_render_function(
    fn_infos: Vec<CoreHirFnInfo>,
    typed_fns: Vec<TypedFn>,
    table: CoreHirBodyTable,
    exprs: Vec<CoreHirExpr>,
    function_index: i32,
    registry: VerifiedCoreTypeRegistry
) -> VerifiedCoreRenderResult {
    let typed_index = fn_info::fn_info_typed_index_at(fn_infos, function_index, 0 - 1)
    if typed_index < 0 || typed_index >= len(typed_fns) {
        return VerifiedCoreRenderResult_err(concat("VerifiedCore missing TypedFn for function index ", to_string(function_index)))
    }
    let body_index = fn_info::fn_info_body_index_at(fn_infos, function_index, 0 - 1)
    if body_index < 0 || body_index >= body_table::corehir_body_table_fn_body_root_count(table) {
        return VerifiedCoreRenderResult_err(concat("VerifiedCore missing body for function index ", to_string(function_index)))
    }
    let root = body_table::corehir_body_table_fn_body_root_at(table, body_index)
    if root < 0 || root >= len(exprs) {
        return VerifiedCoreRenderResult_err(concat("VerifiedCore invalid body root for function index ", to_string(function_index)))
    }
    let reachable = vc_collect_reachable(exprs, root)
    let expr_count = len(exprs)
    let mut ri = 0
    while ri < len(reachable) {
        let id = reachable[ri]
        if id < 0 || id >= expr_count {
            return VerifiedCoreRenderResult_err(concat("VerifiedCore body references unknown expression ", to_string(id)))
        }
        ri = ri + 1
    }

    let typed_fn = get_unchecked(typed_fns, typed_index)
    let return_type = contract_typed_fn::TypedFn_return_type(typed_fn)
    let return_vt = vc_type_info_value_type(return_type)
    let return_type_id = vc_find_type(registry, return_vt, name_display::type_display_name(return_type))
    if return_type_id < 0 {
        return VerifiedCoreRenderResult_err(concat("VerifiedCore missing return type for function index ", to_string(function_index)))
    }

    let qualified = fn_info::fn_info_qualified_name_at(fn_infos, function_index, "")
    let name = if len(clone(qualified)) > 0 {
        qualified
    } else {
        fn_info::fn_info_name_at(fn_infos, function_index, "")
    }
    if len(clone(name)) == 0 {
        return VerifiedCoreRenderResult_err(concat("VerifiedCore missing function name for index ", to_string(function_index)))
    }

    let param_count = fn_info::fn_info_param_count_at(fn_infos, function_index, 0)
    let typed_params = contract_typed_fn::TypedFn_param_types(typed_fn)
    if len(typed_params) != param_count {
        return VerifiedCoreRenderResult_err(concat("VerifiedCore parameter count mismatch for ", clone(name)))
    }

    let mut out = concat("{\"id\":", to_string(function_index))
    out = concat(out, concat(",\"name\":", vc_quote(name)))
    out = concat(out, ",\"signature\":{\"parameters\":[")
    let mut pi = 0
    while pi < param_count {
        if pi > 0 { out = concat(out, ",") }
        let p = fn_info::fn_info_param_at(fn_infos, function_index, pi)
        let p_vt = param::param_value_type(p)
        let p_type_id = vc_find_type(registry, p_vt, param::param_type_name(p))
        if p_type_id < 0 {
            return VerifiedCoreRenderResult_err(concat("VerifiedCore missing parameter type for ", clone(name)))
        }
        out = concat(out, concat("{\"name\":", vc_quote(param::param_name(p))))
        out = concat(out, concat(",\"type_id\":", concat(to_string(p_type_id), "}")))
        pi = pi + 1
    }
    out = concat(out, concat("],\"return_type_id\":", concat(to_string(return_type_id), "}")))

    out = concat(out, ",\"abi\":{\"calling_convention\":\"arukellt\",\"parameters\":[")
    pi = 0
    while pi < param_count {
        if pi > 0 { out = concat(out, ",") }
        let p = fn_info::fn_info_param_at(fn_infos, function_index, pi)
        let p_vt = param::param_value_type(p)
        let p_type_id = vc_find_type(registry, p_vt, param::param_type_name(p))
        out = concat(out, vc_render_abi_item(p_type_id, p_vt))
        pi = pi + 1
    }
    out = concat(out, "],\"results\":[")
    if return_vt != value_types::VT_VOID() {
        out = concat(out, vc_render_abi_item(return_type_id, return_vt))
    }
    out = concat(out, "]}")

    out = concat(out, ",\"locals\":[")
    pi = 0
    while pi < param_count {
        if pi > 0 { out = concat(out, ",") }
        let p = fn_info::fn_info_param_at(fn_infos, function_index, pi)
        let p_type_id = vc_find_type(registry, param::param_value_type(p), param::param_type_name(p))
        out = concat(out, concat("{\"id\":", to_string(pi)))
        out = concat(out, concat(",\"name\":", vc_quote(param::param_name(p))))
        out = concat(out, concat(",\"type_id\":", to_string(p_type_id)))
        out = concat(out, ",\"storage\":\"parameter\"}")
        pi = pi + 1
    }
    out = concat(out, "],\"contracts\":[]")
    out = concat(out, concat(",\"body\":{\"root_expr_id\":", to_string(root)))
    out = concat(out, ",\"expressions\":[")
    let mut first_expr = true
    let mut ei = 0
    while ei < expr_count {
        if vc_contains_id(reachable, ei) {
            if !first_expr { out = concat(out, ",") }
            out = concat(out, vc_render_expression(exprs, ei, registry))
            first_expr = false
        }
        ei = ei + 1
    }
    out = concat(out, "]}}")
    VerifiedCoreRenderResult_ok(out)
}

fn render_verified_core(program: CoreHirRawProgram, config: DriverConfig) -> VerifiedCoreRenderResult {
    let registry = VerifiedCoreTypeRegistry_new()
    vc_collect_types(program, registry)
    if !registry.ok {
        return VerifiedCoreRenderResult_err(registry.error)
    }
    let pointer_width = if contains(config_record::config_target(config), "64") { 64 } else { 32 }
    let module_name = if len(config_record::config_source_file(config)) > 0 {
        config_record::config_source_file(config)
    } else {
        "<memory>"
    }

    let mut out = "{\"schema\":\"arukellt-verified-core\",\"schema_version\":1,\"generator\":\"arukellt-selfhost\",\"module\":"
    out = concat(out, vc_quote(module_name))
    out = concat(out, ",\"target_profile\":{\"integer_model\":\"machine\",\"overflow\":\"compiler-current\",\"floating_point\":\"ieee754\",\"pointer_width\":")
    out = concat(out, concat(to_string(pointer_width), "}"))
    out = concat(out, ",\"types\":[")
    let type_count = len(registry.names)
    let mut ti = 0
    while ti < type_count {
        if ti > 0 { out = concat(out, ",") }
        out = concat(out, vc_render_type(registry, ti, pointer_width))
        ti = ti + 1
    }
    out = concat(out, "],\"functions\":[")

    let fn_infos = raw_decls::program_fn_infos(program)
    let typed_fns = raw_types::program_typed_fns(program)
    let table = raw_bodies::program_body_table(program)
    let exprs = body_table::corehir_body_table_exprs(table)
    let fn_count = len(fn_infos)
    let mut fi = 0
    while fi < fn_count {
        if fi > 0 { out = concat(out, ",") }
        let rendered = vc_render_function(fn_infos, typed_fns, table, exprs, fi, registry)
        if !rendered.ok {
            return rendered
        }
        out = concat(out, rendered.output)
        fi = fi + 1
    }
    out = concat(out, "]}")
    VerifiedCoreRenderResult_ok(out)
}
