fn blocktype_text(mut r: Rd) -> String {
    let b: i32 = peek_byte(r)
    if b == DISASM_BT_EMPTY {
        skip_bytes(r, 1)
        return String_from("")
    }
    if is_valtype_start(b) {
        return " (result ".concat(read_valtype_text(r)).concat(")")
    }
    let index: i32 = read_s32(r)
    if index < 0 {
        return String_from("")
    }
    return " (type ".concat(text_u32(index)).concat(")")
}

fn br_table_text(mut r: Rd) -> String {
    let count: i32 = read_u32(r)
    let mut s: String = String_from("br_table")
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        s = s.concat(" ").concat(text_u32(read_u32(r)))
        i = i + 1
    }
    s = s.concat(" ").concat(text_u32(read_u32(r)))
    return s
}

fn select_text(mut r: Rd) -> String {
    let n: i32 = read_u32(r)
    if n == 0 {
        return "select"
    }
    let mut s: String = String_from("select (result")
    let mut i: i32 = 0
    while i < n && r.p < r.n {
        s = s.concat(" ").concat(read_valtype_text(r))
        i = i + 1
    }
    return s.concat(")")
}

fn reftype_of(heaptype: String, nullable: bool) -> String {
    if nullable {
        return "(ref null ".concat(heaptype).concat(")")
    }
    return "(ref ".concat(heaptype).concat(")")
}

fn gc_instr_text(mut r: Rd) -> String {
    let sub: i32 = read_u32(r)
    if sub == 0 {
        return "struct.new ".concat(text_u32(read_u32(r)))
    }
    if sub == 1 {
        return "struct.new_default ".concat(text_u32(read_u32(r)))
    }
    if sub == 2 {
        let t: String = text_u32(read_u32(r))
        return "struct.get ".concat(t).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 3 {
        let t: String = text_u32(read_u32(r))
        return "struct.get_s ".concat(t).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 4 {
        let t: String = text_u32(read_u32(r))
        return "struct.get_u ".concat(t).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 5 {
        let t: String = text_u32(read_u32(r))
        return "struct.set ".concat(t).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 6 {
        return "array.new ".concat(text_u32(read_u32(r)))
    }
    if sub == 7 {
        return "array.new_default ".concat(text_u32(read_u32(r)))
    }
    if sub == 8 {
        let t: String = text_u32(read_u32(r))
        return "array.new_fixed ".concat(t).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 9 {
        let t: String = text_u32(read_u32(r))
        return "array.new_data ".concat(t).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 10 {
        let t: String = text_u32(read_u32(r))
        return "array.new_elem ".concat(t).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 11 {
        return "array.get ".concat(text_u32(read_u32(r)))
    }
    if sub == 12 {
        return "array.get_s ".concat(text_u32(read_u32(r)))
    }
    if sub == 13 {
        return "array.get_u ".concat(text_u32(read_u32(r)))
    }
    if sub == 14 {
        return "array.set ".concat(text_u32(read_u32(r)))
    }
    if sub == 16 {
        return "array.fill ".concat(text_u32(read_u32(r)))
    }
    if sub == 17 {
        let dst: String = text_u32(read_u32(r))
        return "array.copy ".concat(dst).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 18 {
        let t: String = text_u32(read_u32(r))
        return "array.init_data ".concat(t).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 19 {
        let t: String = text_u32(read_u32(r))
        return "array.init_elem ".concat(t).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 20 {
        return "ref.test ".concat(reftype_of(read_heaptype_text(r), false))
    }
    if sub == 21 {
        return "ref.test ".concat(reftype_of(read_heaptype_text(r), true))
    }
    if sub == 22 {
        return "ref.cast ".concat(reftype_of(read_heaptype_text(r), false))
    }
    if sub == 23 {
        return "ref.cast ".concat(reftype_of(read_heaptype_text(r), true))
    }
    if sub == 24 {
        return br_on_cast_text(r, "br_on_cast")
    }
    if sub == 25 {
        return br_on_cast_text(r, "br_on_cast_fail")
    }
    let name: String = gc_noimm_name(sub)
    if name != "" {
        return name
    }
    return String_from("")
}

fn br_on_cast_text(mut r: Rd, name: String) -> String {
    let flags: i32 = read_byte(r)
    let label: String = text_u32(read_u32(r))
    let ht1: String = read_heaptype_text(r)
    let ht2: String = read_heaptype_text(r)
    let rt1: String = reftype_of(ht1, (flags & 1) != 0)
    let rt2: String = reftype_of(ht2, (flags & 2) != 0)
    return name.concat(" ").concat(label).concat(" ").concat(rt1).concat(" ").concat(rt2)
}

fn misc_instr_text(mut r: Rd) -> String {
    let sub: i32 = read_u32(r)
    let simple: String = misc_noimm_name(sub)
    if simple != "" {
        return simple
    }
    if sub == 8 {
        let data: String = text_u32(read_u32(r))
        let mem: i32 = read_u32(r)
        if mem == 0 {
            return "memory.init ".concat(data)
        }
        return "memory.init ".concat(text_u32(mem)).concat(" ").concat(data)
    }
    if sub == 9 {
        return "data.drop ".concat(text_u32(read_u32(r)))
    }
    if sub == 10 {
        let dst: i32 = read_u32(r)
        let src: i32 = read_u32(r)
        if dst == 0 && src == 0 {
            return "memory.copy"
        }
        return "memory.copy ".concat(text_u32(dst)).concat(" ").concat(text_u32(src))
    }
    if sub == 11 {
        let mem: i32 = read_u32(r)
        if mem == 0 {
            return "memory.fill"
        }
        return "memory.fill ".concat(text_u32(mem))
    }
    if sub == 12 {
        let elem: String = text_u32(read_u32(r))
        let table: String = text_u32(read_u32(r))
        return "table.init ".concat(table).concat(" ").concat(elem)
    }
    if sub == 13 {
        return "elem.drop ".concat(text_u32(read_u32(r)))
    }
    if sub == 14 {
        let dst: String = text_u32(read_u32(r))
        return "table.copy ".concat(dst).concat(" ").concat(text_u32(read_u32(r)))
    }
    if sub == 15 {
        return "table.grow ".concat(text_u32(read_u32(r)))
    }
    if sub == 16 {
        return "table.size ".concat(text_u32(read_u32(r)))
    }
    if sub == 17 {
        return "table.fill ".concat(text_u32(read_u32(r)))
    }
    return String_from("")
}

fn call_indirect_text(mut r: Rd, name: String) -> String {
    let typeidx: String = text_u32(read_u32(r))
    let tableidx: i32 = read_u32(r)
    if tableidx == 0 {
        return name.concat(" (type ").concat(typeidx).concat(")")
    }
    return name.concat(" ").concat(text_u32(tableidx)).concat(" (type ").concat(typeidx).concat(")")
}

fn instr_text(mut r: Rd) -> String {
    let start: i32 = r.p
    let op: i32 = read_byte(r)
    // 制御（即値あり）
    if op == 0x0c {
        return "br ".concat(text_u32(read_u32(r)))
    }
    if op == 0x0d {
        return "br_if ".concat(text_u32(read_u32(r)))
    }
    if op == 0x0e {
        return br_table_text(r)
    }
    if op == 0x10 {
        return "call ".concat(text_u32(read_u32(r)))
    }
    if op == 0x11 {
        return call_indirect_text(r, String_from("call_indirect"))
    }
    if op == 0x12 {
        return "return_call ".concat(text_u32(read_u32(r)))
    }
    if op == 0x13 {
        return call_indirect_text(r, String_from("return_call_indirect"))
    }
    if op == 0x14 {
        return "call_ref ".concat(text_u32(read_u32(r)))
    }
    if op == 0x15 {
        return "return_call_ref ".concat(text_u32(read_u32(r)))
    }
    if op == 0x1c {
        return select_text(r)
    }
    // 変数
    if op == 0x20 {
        return "local.get ".concat(text_u32(read_u32(r)))
    }
    if op == 0x21 {
        return "local.set ".concat(text_u32(read_u32(r)))
    }
    if op == 0x22 {
        return "local.tee ".concat(text_u32(read_u32(r)))
    }
    if op == 0x23 {
        return "global.get ".concat(text_u32(read_u32(r)))
    }
    if op == 0x24 {
        return "global.set ".concat(text_u32(read_u32(r)))
    }
    // テーブル
    if op == 0x25 {
        return "table.get ".concat(text_u32(read_u32(r)))
    }
    if op == 0x26 {
        return "table.set ".concat(text_u32(read_u32(r)))
    }
    // メモリ（memarg）
    if op >= 0x28 && op <= 0x3e {
        return memarg_text(r, op, memory_instr_name(op))
    }
    if op == 0x3f {
        let mem: i32 = read_u32(r)
        if mem == 0 {
            return String_from("memory.size")
        }
        return "memory.size ".concat(text_u32(mem))
    }
    if op == 0x40 {
        let mem: i32 = read_u32(r)
        if mem == 0 {
            return String_from("memory.grow")
        }
        return "memory.grow ".concat(text_u32(mem))
    }
    // 定数
    if op == 0x41 {
        return "i32.const ".concat(read_s32(r).to_string())
    }
    if op == 0x42 {
        return "i64.const ".concat(read_s64(r).to_string())
    }
    if op == 0x43 {
        return "f32.const ".concat(f32_text(read_u32_le(r)))
    }
    if op == 0x44 {
        return "f64.const ".concat(f64_text(read_u64_le(r)))
    }
    // 参照
    if op == 0xd0 {
        return "ref.null ".concat(read_heaptype_text(r))
    }
    if op == 0xd1 {
        return String_from("ref.is_null")
    }
    if op == 0xd2 {
        return "ref.func ".concat(text_u32(read_u32(r)))
    }
    if op == 0xd3 {
        return String_from("ref.eq")
    }
    if op == 0xd4 {
        return String_from("ref.as_non_null")
    }
    if op == 0xd5 {
        return "br_on_null ".concat(text_u32(read_u32(r)))
    }
    if op == 0xd6 {
        return "br_on_non_null ".concat(text_u32(read_u32(r)))
    }
    // 接頭辞つき
    if op == DISASM_PREFIX_GC {
        return gc_instr_text(r)
    }
    if op == DISASM_PREFIX_MISC {
        return misc_instr_text(r)
    }
    // 即値なし
    if op == 0x00 {
        return String_from("unreachable")
    }
    if op == 0x01 {
        return String_from("nop")
    }
    if op == 0x0f {
        return String_from("return")
    }
    if op == 0x1a {
        return String_from("drop")
    }
    if op == 0x1b {
        return String_from("select")
    }
    let name: String = numeric_noimm_name(op)
    if name != "" {
        return name
    }
    r.p = start
    return String_from("")
}

// 未対応 opcode の説明文（プレフィックス付きならサブオペコードも出す）。
fn opcode_label(b: Vec<i32>, start: i32) -> String {
    let op: i32 = b.get_unchecked(start)
    if op == DISASM_PREFIX_GC || op == DISASM_PREFIX_MISC || op == DISASM_PREFIX_SIMD || op == DISASM_PREFIX_ATOMIC {
        return opcode_text(op).concat("/").concat(text_u32(u32_at(b, start + 1)))
    }
    return opcode_text(op)
}

fn u32_at(b: Vec<i32>, start: i32) -> i32 {
    let mut result: i32 = 0
    let mut shift: i32 = 0
    let mut p: i32 = start
    let mut i: i32 = 0
    while i < 5 && p < b.len() {
        let v: i32 = b.get_unchecked(p)
        p = p + 1
        result = result | ((v & 0x7f) << shift)
        shift = shift + 7
        if (v & 0x80) == 0 {
            break
        }
        i = i + 1
    }
    return result
}

fn emit_body(mut r: Rd, mut o: Out, body_end: i32) {
    let mut depth: i32 = 2
    let mut done: bool = false
    while !done && r.p < body_end && r.p < r.n {
        let start: i32 = r.p
        let op: i32 = peek_byte(r)
        if op == 0x0b {
            skip_bytes(r, 1)
            if depth <= 2 {
                done = true
            } else {
                depth = depth - 1
                put(o, depth, String_from("end"))
            }
            continue
        }
        if op == 0x05 {
            skip_bytes(r, 1)
            depth = depth - 1
            put(o, depth, String_from("else"))
            depth = depth + 1
            continue
        }
        if op == 0x02 || op == 0x03 || op == 0x04 {
            skip_bytes(r, 1)
            let mut head: String = String_from("block")
            if op == 0x03 {
                head = String_from("loop")
            }
            if op == 0x04 {
                head = String_from("if")
            }
            put(o, depth, head.concat(blocktype_text(r)))
            depth = depth + 1
            continue
        }
        let text: String = instr_text(r)
        if text == "" {
            r.p = start
            put_gap(o, depth, "unsupported opcode ".concat(opcode_label(r.b, start)).concat(" (body skipped)"))
            r.p = body_end
            done = true
        } else {
            put(o, depth, text)
        }
    }
}

// ---------------------------------------------------------------------------
// セクション
// ---------------------------------------------------------------------------

fn import_desc_text(mut r: Rd, kind: i32) -> String {
    if kind == 0 {
        return "(func (type ".concat(text_u32(read_u32(r))).concat("))")
    }
    if kind == 1 {
        let rt: String = read_valtype_text(r)
        return "(table ".concat(read_limits_text(r)).concat(" ").concat(rt).concat(")")
    }
    if kind == 2 {
        return "(memory ".concat(read_limits_text(r)).concat(")")
    }
    if kind == 3 {
        return "(global ".concat(read_globaltype_text(r)).concat(")")
    }
    return "(func)"
}

fn emit_import_section(mut r: Rd, mut o: Out) {
    let count: i32 = read_u32(r)
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        let module_name: String = read_name(r)
        let field_name: String = read_name(r)
        let kind: i32 = read_byte(r)
        let desc: String = import_desc_text(r, kind)
        put(o, 1, "(import ".concat(module_name).concat(" ").concat(field_name).concat(" ").concat(desc).concat(")"))
        i = i + 1
    }
}

fn read_function_section(mut r: Rd) -> Vec<i32> {
    let count: i32 = read_u32(r)
    let mut types: Vec<i32> = Vec::new<i32>()
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        types.push(read_u32(r))
        i = i + 1
    }
    return types
}

fn emit_table_section(mut r: Rd, mut o: Out) {
    let count: i32 = read_u32(r)
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        let mut text: String = "(table (;".concat(i.to_string()).concat(";) ")
        if peek_byte(r) == 0x40 {
            // 明示初期化式つきテーブル: 0x40 0x00 reftype limits expr
            skip_bytes(r, 1)
            skip_bytes(r, 1)
            let rt: String = read_valtype_text(r)
            text = text.concat(read_limits_text(r)).concat(" ").concat(rt)
            text = text.concat(" ").concat(const_expr_text(r)).concat(")")
        } else {
            let rt: String = read_valtype_text(r)
            text = text.concat(read_limits_text(r)).concat(" ").concat(rt).concat(")")
        }
        put(o, 1, text)
        i = i + 1
    }
}

fn emit_memory_section(mut r: Rd, mut o: Out) {
    let count: i32 = read_u32(r)
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        put(o, 1, "(memory (;".concat(i.to_string()).concat(";) ").concat(read_limits_text(r)).concat(")"))
        i = i + 1
    }
}

fn emit_global_section(mut r: Rd, mut o: Out) {
    let count: i32 = read_u32(r)
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        let gt: String = read_globaltype_text(r)
        let init: String = const_expr_text(r)
        put(o, 1, "(global (;".concat(i.to_string()).concat(";) ").concat(gt).concat(" ").concat(init).concat(")"))
        i = i + 1
    }
}

fn export_kind_name(kind: i32) -> String {
    if kind == 0 {
        return "func"
    }
    if kind == 1 {
        return "table"
    }
    if kind == 2 {
        return "memory"
    }
    if kind == 3 {
        return "global"
    }
    if kind == 4 {
        return "tag"
    }
    return "func"
}

fn emit_export_section(mut r: Rd, mut o: Out) {
    let count: i32 = read_u32(r)
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        let name: String = read_name(r)
        let kind: i32 = read_byte(r)
        let index: String = text_u32(read_u32(r))
        let mut text: String = "(export ".concat(name).concat(" (")
        text = text.concat(export_kind_name(kind)).concat(" ").concat(index).concat("))")
        put(o, 1, text)
        i = i + 1
    }
}

fn emit_start_section(mut r: Rd, mut o: Out) {
    put(o, 1, "(start ".concat(text_u32(read_u32(r))).concat(")"))
}

fn func_index_list(mut r: Rd, count: i32) -> String {
    let mut s: String = String_from("")
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        s = s.concat(" ").concat(text_u32(read_u32(r)))
        i = i + 1
    }
    return s
}

fn expr_list(mut r: Rd, count: i32) -> String {
    let mut s: String = String_from("")
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        s = s.concat(" ").concat(const_expr_text(r))
        i = i + 1
    }
    return s
}

fn emit_elem_section(mut r: Rd, mut o: Out) {
    let count: i32 = read_u32(r)
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        let flags: i32 = read_u32(r)
        put(o, 1, elem_text(r, flags))
        i = i + 1
    }
}

fn elem_text(mut r: Rd, flags: i32) -> String {
    if flags == 0 {
        let off: String = const_expr_text(r)
        let n: i32 = read_u32(r)
        return "(elem ".concat(off).concat(" func").concat(func_index_list(r, n)).concat(")")
    }
    if flags == 1 {
        skip_bytes(r, 1)
        let n: i32 = read_u32(r)
        return "(elem func".concat(func_index_list(r, n)).concat(")")
    }
    if flags == 2 {
        let table: String = text_u32(read_u32(r))
        let off: String = const_expr_text(r)
        skip_bytes(r, 1)
        let n: i32 = read_u32(r)
        let head: String = "(elem (table ".concat(table).concat(") (offset ").concat(off).concat(") func")
        return head.concat(func_index_list(r, n)).concat(")")
    }
    if flags == 3 {
        skip_bytes(r, 1)
        let n: i32 = read_u32(r)
        return "(elem declare func".concat(func_index_list(r, n)).concat(")")
    }
    if flags == 4 {
        let off: String = const_expr_text(r)
        let n: i32 = read_u32(r)
        return "(elem ".concat(off).concat(" funcref").concat(expr_list(r, n)).concat(")")
    }
    if flags == 5 {
        let rt: String = read_valtype_text(r)
        let n: i32 = read_u32(r)
        return "(elem ".concat(rt).concat(expr_list(r, n)).concat(")")
    }
    if flags == 6 {
        let table: String = text_u32(read_u32(r))
        let off: String = const_expr_text(r)
        let rt: String = read_valtype_text(r)
        let n: i32 = read_u32(r)
        let head: String = "(elem (table ".concat(table).concat(") (offset ").concat(off).concat(") ").concat(rt)
        return head.concat(expr_list(r, n)).concat(")")
    }
    let rt: String = read_valtype_text(r)
    let n: i32 = read_u32(r)
    return "(elem declare ".concat(rt).concat(expr_list(r, n)).concat(")")
}

fn data_string(mut r: Rd) -> String {
    let n: i32 = read_u32(r)
    return quoted_bytes(r, n)
}

fn emit_data_section(mut r: Rd, mut o: Out) {
    let count: i32 = read_u32(r)
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        let flags: i32 = read_u32(r)
        if flags == 0 {
            let off: String = const_expr_text(r)
            put(o, 1, "(data ".concat(off).concat(" ").concat(data_string(r)).concat(")"))
        } else if flags == 1 {
            put(o, 1, "(data ".concat(data_string(r)).concat(")"))
        } else {
            let mem: String = text_u32(read_u32(r))
            let off: String = const_expr_text(r)
            let body: String = data_string(r)
            let head: String = "(data (memory ".concat(mem).concat(") (offset ").concat(off).concat(") ")
            put(o, 1, head.concat(body).concat(")"))
        }
        i = i + 1
    }
}

fn emit_code_section(mut r: Rd, mut o: Out, func_types: Vec<i32>) {
    let count: i32 = read_u32(r)
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        let size: i32 = read_u32(r)
        let mut body_end: i32 = r.p + size
        if body_end > r.n {
            body_end = r.n
        }
        let mut typeidx: i32 = 0
        if i < func_types.len() {
            typeidx = func_types.get_unchecked(i)
        }
        put(o, 1, "(func (type ".concat(text_u32(typeidx)).concat(")").concat(locals_text(r)))
        emit_body(r, o, body_end)
        put(o, 1, ")")
        if r.p != body_end {
            put_gap(o, 1, "code body size mismatch at byte ".concat(r.p.to_string()))
            r.p = body_end
        }
        i = i + 1
    }
}

fn locals_text(mut r: Rd) -> String {
    let groups: i32 = read_u32(r)
    if groups == 0 {
        return String_from("")
    }
    let mut parts: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < groups && r.p < r.n {
        let count: i32 = read_u32(r)
        let vt: String = read_valtype_text(r)
        let mut j: i32 = 0
        while j < count && r.p < r.n {
            parts.push(vt)
            j = j + 1
        }
        i = i + 1
    }
    return " (local ".concat(parts.join(String_from(" "))).concat(")")
}

// ---------------------------------------------------------------------------
// モジュール全体
// ---------------------------------------------------------------------------

fn header_is_valid(b: Vec<i32>, n: i32) -> bool {
    if n < 8 {
        return false
    }
    if b.get_unchecked(0) != 0x00 || b.get_unchecked(1) != 0x61 {
        return false
    }
    if b.get_unchecked(2) != 0x73 || b.get_unchecked(3) != 0x6d {
        return false
    }
    if b.get_unchecked(4) != 0x01 || b.get_unchecked(5) != 0x00 {
        return false
    }
    if b.get_unchecked(6) != 0x00 || b.get_unchecked(7) != 0x00 {
        return false
    }
    return true
}

fn section_name(id: i32) -> String {
    if id == DISASM_SEC_TYPE {
        return "type"
    }
    if id == DISASM_SEC_IMPORT {
        return "import"
    }
    if id == DISASM_SEC_FUNCTION {
        return "function"
    }
    if id == DISASM_SEC_TABLE {
        return "table"
    }
    if id == DISASM_SEC_MEMORY {
        return "memory"
    }
    if id == DISASM_SEC_GLOBAL {
        return "global"
    }
    if id == DISASM_SEC_EXPORT {
        return "export"
    }
    if id == DISASM_SEC_START {
        return "start"
    }
    if id == DISASM_SEC_ELEMENT {
        return "element"
    }
    if id == DISASM_SEC_CODE {
        return "code"
    }
    if id == DISASM_SEC_DATA {
        return "data"
    }
    if id == DISASM_SEC_DATA_COUNT {
        return "data count"
    }
    if id == DISASM_SEC_TAG {
        return "tag"
    }
    return "section ".concat(id.to_string())
}

/// Disassembles a core Wasm module into WAT text for `--emit wat`.
///
/// Unsupported opcodes/sections are rendered as `;; GAP:` comments so a
/// partial disassembly never masquerades as valid WAT.
pub fn wasm_to_wat(bytes: Vec<i32>) -> String {
    let mut o: Out = Out { lines: Vec::new<String>() }
    let n: i32 = bytes.len()
    if !header_is_valid(bytes, n) {
        put(o, 0, ";; GAP: not a wasm core module (bad magic or version)")
        put(o, 0, "(module)")
        return (o.lines).join(String_from("\n")).concat("\n")
    }
    let mut r: Rd = Rd { b: bytes, n: n, p: 8 }
    let mut func_types: Vec<i32> = Vec::new<i32>()
    put(o, 0, "(module")
    while r.p < r.n {
        let id: i32 = read_byte(r)
        let size: i32 = read_u32(r)
        let mut end: i32 = r.p + size
        if end > r.n {
            end = r.n
        }
        if id == DISASM_SEC_TYPE {
            emit_type_section(r, o)
        } else if id == DISASM_SEC_IMPORT {
            emit_import_section(r, o)
        } else if id == DISASM_SEC_FUNCTION {
            func_types = read_function_section(r)
        } else if id == DISASM_SEC_TABLE {
            emit_table_section(r, o)
        } else if id == DISASM_SEC_MEMORY {
            emit_memory_section(r, o)
        } else if id == DISASM_SEC_GLOBAL {
            emit_global_section(r, o)
        } else if id == DISASM_SEC_EXPORT {
            emit_export_section(r, o)
        } else if id == DISASM_SEC_START {
            emit_start_section(r, o)
        } else if id == DISASM_SEC_ELEMENT {
            emit_elem_section(r, o)
        } else if id == DISASM_SEC_CODE {
            emit_code_section(r, o, func_types)
        } else if id == DISASM_SEC_DATA {
            emit_data_section(r, o)
        } else if id == DISASM_SEC_DATA_COUNT {
            // data count は WAT に対応する構文がない（データ数から再計算される）ので読み飛ばす。
            skip_bytes(r, end - r.p)
        } else if id == DISASM_SEC_CUSTOM {
            skip_bytes(r, end - r.p)
        } else {
            let message: String = "unsupported ".concat(section_name(id)).concat(" (").concat(size.to_string())
            put_gap(o, 1, message.concat(" bytes) skipped"))
        }
        if r.p != end {
            r.p = end
        }
    }
    put(o, 0, ")")
    return (o.lines).join(String_from("\n")).concat("\n")
}
