// 生成済み Wasm バイナリ → WAT テキスト逆アセンブラ。
//
// `wasm_to_wat` は純粋関数（Vec<i32> の生バイト → String）で、`--emit wat` の
// 出力生成に使う。未対応の opcode / セクションは trap させず `;; GAP:` コメントを
// 残す（壊れた WAT を黙って出さない）。
//
// 定数は他のモジュールの同名関数（value_types::DISASM_VT_I32 など）と衝突しないよう
// DISASM_ 接頭辞を付ける。flat overlay では定数が名前空間化されないため。
// wasm2wat.ark — WebAssembly バイナリ → WAT テキスト逆アセンブラ。
//
// 中核の `wasm_to_wat` は純粋関数（Vec<i32> の生バイト → String）で、
// arukellt の `--emit wat` からそのまま呼べる形にしてある。ファイル入出力は main のみ。
//
// 失敗時も trap せず、WAT コメント `;; GAP:` を差し込んで未対応箇所を残す。

use std::prelude::{String_from}

// ---------------------------------------------------------------------------
// 定数
// ---------------------------------------------------------------------------

const DISASM_SEC_CUSTOM: i32 = 0
const DISASM_SEC_TYPE: i32 = 1
const DISASM_SEC_IMPORT: i32 = 2
const DISASM_SEC_FUNCTION: i32 = 3
const DISASM_SEC_TABLE: i32 = 4
const DISASM_SEC_MEMORY: i32 = 5
const DISASM_SEC_GLOBAL: i32 = 6
const DISASM_SEC_EXPORT: i32 = 7
const DISASM_SEC_START: i32 = 8
const DISASM_SEC_ELEMENT: i32 = 9
const DISASM_SEC_CODE: i32 = 10
const DISASM_SEC_DATA: i32 = 11
const DISASM_SEC_DATA_COUNT: i32 = 12
const DISASM_SEC_TAG: i32 = 13

const DISASM_VT_I32: i32 = 0x7f
const DISASM_VT_I64: i32 = 0x7e
const DISASM_VT_F32: i32 = 0x7d
const DISASM_VT_F64: i32 = 0x7c
const DISASM_VT_V128: i32 = 0x7b
const DISASM_VT_I8: i32 = 0x78
const DISASM_VT_I16: i32 = 0x77
const DISASM_VT_REF_NULL: i32 = 0x63
const DISASM_VT_REF: i32 = 0x64
const DISASM_BT_EMPTY: i32 = 0x40
const DISASM_REC_GROUP: i32 = 0x4e
const DISASM_SUB_FINAL: i32 = 0x4f
const DISASM_SUB: i32 = 0x50
const DISASM_COMP_FUNC: i32 = 0x60
const DISASM_COMP_STRUCT: i32 = 0x5f
const DISASM_COMP_ARRAY: i32 = 0x5e

const DISASM_HEAP_NOEXN: i32 = -0x18
const DISASM_HEAP_EXN: i32 = -0x17
const DISASM_HEAP_ARRAY: i32 = -0x16
const DISASM_HEAP_STRUCT: i32 = -0x15
const DISASM_HEAP_I31: i32 = -0x14
const DISASM_HEAP_EQ: i32 = -0x13
const DISASM_HEAP_ANY: i32 = -0x12
const DISASM_HEAP_EXTERN: i32 = -0x11
const DISASM_HEAP_FUNC: i32 = -0x10
const DISASM_HEAP_NONE: i32 = -0x0f
const DISASM_HEAP_NOEXTERN: i32 = -0x0e
const DISASM_HEAP_NOFUNC: i32 = -0x0d

const DISASM_PREFIX_GC: i32 = 0xfb
const DISASM_PREFIX_MISC: i32 = 0xfc
const DISASM_PREFIX_SIMD: i32 = 0xfd
const DISASM_PREFIX_ATOMIC: i32 = 0xfe

// ---------------------------------------------------------------------------
// 出力バッファと小物
// ---------------------------------------------------------------------------

struct Out {
    lines: Vec<String>,
}

fn put(mut o: Out, depth: i32, text: String) {
    o.lines.push(indent_of(depth).concat(text))
}

fn put_gap(mut o: Out, depth: i32, message: String) {
    put(o, depth, ";; GAP: ".concat(message))
}

fn indent_of(depth: i32) -> String {
    let mut s: String = String_from("")
    let mut i: i32 = 0
    while i < depth {
        s = s.concat("  ")
        i = i + 1
    }
    s
}

fn ascii_table() -> String {
    " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
}

fn hex_digit(n: i32) -> String {
    "0123456789abcdef".slice(n, n + 1)
}

fn hex_byte(v: i32) -> String {
    return hex_digit((v >> 4) & 15).concat(hex_digit(v & 15))
}

fn opcode_text(op: i32) -> String {
    return "0x".concat(hex_byte(op))
}

// 符号なし 32bit として表示する（インデックス・件数・オフセット用）。
fn text_u32(v: i32) -> String {
    if v < 0 {
        return (__intrinsic_i32_to_i64(v) & 4294967295i64).to_string()
    }
    return v.to_string()
}

// ---------------------------------------------------------------------------
// リーダ
// ---------------------------------------------------------------------------

struct Rd {
    b: Vec<i32>,
    n: i32,
    p: i32,
}

fn read_byte(mut r: Rd) -> i32 {
    if r.p >= r.n {
        return 0
    }
    let v: i32 = r.b.get_unchecked(r.p)
    r.p = r.p + 1
    return v
}

fn peek_byte(r: Rd) -> i32 {
    if r.p >= r.n {
        return -1
    }
    return r.b.get_unchecked(r.p)
}

fn skip_bytes(mut r: Rd, count: i32) {
    r.p = r.p + count
    if r.p > r.n {
        r.p = r.n
    }
}

fn read_u32(mut r: Rd) -> i32 {
    let mut result: i32 = 0
    let mut shift: i32 = 0
    let mut i: i32 = 0
    while i < 5 {
        let b: i32 = read_byte(r)
        result = result | ((b & 0x7f) << shift)
        shift = shift + 7
        if (b & 0x80) == 0 {
            break
        }
        i = i + 1
    }
    return result
}

fn read_u64(mut r: Rd) -> i64 {
    let mut result: i64 = 0i64
    let mut shift: i64 = 0i64
    let mut i: i32 = 0
    while i < 10 {
        let b: i32 = read_byte(r)
        result = result | (__intrinsic_i32_to_i64(b & 0x7f) << shift)
        shift = shift + 7i64
        if (b & 0x80) == 0 {
            break
        }
        i = i + 1
    }
    return result
}

fn read_s32(mut r: Rd) -> i32 {
    let mut result: i32 = 0
    let mut shift: i32 = 0
    let mut last: i32 = 0
    let mut more: bool = true
    let mut i: i32 = 0
    while i < 5 && more {
        let b: i32 = read_byte(r)
        last = b
        result = result | ((b & 0x7f) << shift)
        shift = shift + 7
        more = (b & 0x80) != 0
        i = i + 1
    }
    if shift < 32 && (last & 0x40) != 0 {
        result = result | (0 - (1 << shift))
    }
    return result
}

fn read_s64(mut r: Rd) -> i64 {
    let mut result: i64 = 0i64
    let mut shift: i64 = 0i64
    let mut last: i32 = 0
    let mut more: bool = true
    let mut i: i32 = 0
    while i < 10 && more {
        let b: i32 = read_byte(r)
        last = b
        result = result | (__intrinsic_i32_to_i64(b & 0x7f) << shift)
        shift = shift + 7i64
        more = (b & 0x80) != 0
        i = i + 1
    }
    if shift < 64i64 && (last & 0x40) != 0 {
        result = result | (0i64 - (1i64 << shift))
    }
    return result
}

fn read_u32_le(mut r: Rd) -> i32 {
    let b0: i32 = read_byte(r)
    let b1: i32 = read_byte(r)
    let b2: i32 = read_byte(r)
    let b3: i32 = read_byte(r)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn read_u64_le(mut r: Rd) -> i64 {
    let b0: i32 = read_byte(r)
    let b1: i32 = read_byte(r)
    let b2: i32 = read_byte(r)
    let b3: i32 = read_byte(r)
    let b4: i32 = read_byte(r)
    let b5: i32 = read_byte(r)
    let b6: i32 = read_byte(r)
    let b7: i32 = read_byte(r)
    let lo: i64 = __intrinsic_i32_to_i64(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & 4294967295i64
    let hi: i64 = __intrinsic_i32_to_i64(b4 | (b5 << 8) | (b6 << 16) | (b7 << 24)) & 4294967295i64
    return lo | (hi << 32i64)
}

// ---------------------------------------------------------------------------
// 文字列・数値の整形
// ---------------------------------------------------------------------------

// WAT の文字列本体（引用符を除く）へ 1 バイトをエスケープする。
fn escape_byte(b: i32) -> String {
    if b < 0 || b > 255 {
        return String_from("")
    }
    if b == 34 {
        return String_from("\\\"")
    }
    if b == 92 {
        return String_from("\\\\")
    }
    if b >= 32 && b <= 126 {
        return ascii_table().slice(b - 32, b - 31)
    }
    return String_from("\\").concat(hex_byte(b))
}

fn quoted_bytes(mut r: Rd, count: i32) -> String {
    let mut parts: Vec<String> = Vec::new<String>()
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        parts.push(escape_byte(read_byte(r)))
        i = i + 1
    }
    return "\"".concat(parts.join(String_from("")).concat("\""))
}

fn read_name(mut r: Rd) -> String {
    let n: i32 = read_u32(r)
    return quoted_bytes(r, n)
}

fn signed_text(v: i32) -> String {
    if v < 0 {
        return "-".concat((0 - v).to_string())
    }
    return "+".concat(v.to_string())
}

// f64 のビット列を WAT の 16 進浮動小数（例 0x1.8p+3）へ。
fn f64_text(bits: i64) -> String {
    let mut sign: String = String_from("")
    if bits < 0i64 {
        sign = String_from("-")
    }
    let e: i32 = __intrinsic_i64_to_i32((bits >> 52i64) & 2047i64)
    let frac: i64 = bits & 4503599627370495i64
    if e == 0x7ff {
        if frac == 0i64 {
            return sign.concat("inf")
        }
        return sign.concat("nan:0x").concat(u64_hex(frac))
    }
    if e == 0 {
        if frac == 0i64 {
            return sign.concat("0x0p+0")
        }
        let mut m: i64 = frac
        let mut ex: i32 = 0 - 1074
        while (m & 4503599627370496i64) == 0i64 {
            m = m << 1i64
            ex = ex - 1
        }
        let f: i64 = m - 4503599627370496i64
        return sign.concat("0x1.").concat(u64_hex_pad(f, 13)).concat("p").concat(signed_text(ex + 52))
    }
    return sign.concat("0x1.").concat(u64_hex_pad(frac, 13)).concat("p").concat(signed_text(e - 1023))
}

// f32 のビット列を WAT の 16 進浮動小数へ。6 桁 = 24bit 仮数で厳密に表せる。
fn f32_text(raw: i32) -> String {
    let bits: i64 = __intrinsic_i32_to_i64(raw) & 4294967295i64
    let mut sign: String = String_from("")
    if ((bits >> 31i64) & 1i64) != 0i64 {
        sign = String_from("-")
    }
    let e: i32 = __intrinsic_i64_to_i32((bits >> 23i64) & 255i64)
    let frac: i64 = bits & 8388607i64
    if e == 0xff {
        if frac == 0i64 {
            return sign.concat("inf")
        }
        return sign.concat("nan:0x").concat(u64_hex(frac))
    }
    if e == 0 {
        if frac == 0i64 {
            return sign.concat("0x0p+0")
        }
        let mut m: i64 = frac
        let mut ex: i32 = 0 - 149
        while (m & 8388608i64) == 0i64 {
            m = m << 1i64
            ex = ex - 1
        }
        let mantissa: i64 = (m - 8388608i64) << 1i64
        return sign.concat("0x1.").concat(u64_hex_pad(mantissa, 6)).concat("p").concat(signed_text(23 + ex))
    }
    return sign.concat("0x1.").concat(u64_hex_pad(frac << 1i64, 6)).concat("p").concat(signed_text(e - 127))
}

fn u64_hex(v: i64) -> String {
    if v == 0i64 {
        return String_from("0")
    }
    let mut digits: Vec<String> = Vec::new<String>()
    let mut x: i64 = v
    while x > 0i64 {
        digits.push(hex_digit(__intrinsic_i64_to_i32(x & 15i64)))
        x = x >> 4i64
    }
    let mut reversed: Vec<String> = Vec::new<String>()
    let mut i: i32 = digits.len() - 1
    while i >= 0 {
        reversed.push(digits.get_unchecked(i))
        i = i - 1
    }
    return reversed.join(String_from(""))
}

fn u64_hex_pad(v: i64, digits: i32) -> String {
    let mut out: Vec<String> = Vec::new<String>()
    let mut i: i32 = digits - 1
    while i >= 0 {
        out.push(hex_digit(__intrinsic_i64_to_i32((v >> __intrinsic_i32_to_i64(i * 4)) & 15i64)))
        i = i - 1
    }
    return out.join(String_from(""))
}

// ---------------------------------------------------------------------------
// 型
// ---------------------------------------------------------------------------

fn is_abstract_heap_byte(b: i32) -> bool {
    return b >= 0x68 && b <= 0x73
}

fn is_valtype_start(b: i32) -> bool {
    if b < 0 {
        return false
    }
    if b == DISASM_VT_I32 || b == DISASM_VT_I64 || b == DISASM_VT_F32 || b == DISASM_VT_F64 || b == DISASM_VT_V128 {
        return true
    }
    if b == DISASM_VT_REF_NULL || b == DISASM_VT_REF {
        return true
    }
    return is_abstract_heap_byte(b)
}

fn shorthand_ref_name(b: i32) -> String {
    if b == 0x70 {
        return "funcref"
    }
    if b == 0x6f {
        return "externref"
    }
    if b == 0x6e {
        return "anyref"
    }
    if b == 0x6d {
        return "eqref"
    }
    if b == 0x6c {
        return "i31ref"
    }
    if b == 0x6b {
        return "structref"
    }
    if b == 0x6a {
        return "arrayref"
    }
    if b == 0x69 {
        return "exnref"
    }
    if b == 0x71 {
        return "nullref"
    }
    if b == 0x72 {
        return "nullexternref"
    }
    if b == 0x73 {
        return "nullfuncref"
    }
    if b == 0x68 {
        return "nullexnref"
    }
    return String_from("")
}

fn abstract_heap_name(h: i32) -> String {
    if h == DISASM_HEAP_FUNC {
        return "func"
    }
    if h == DISASM_HEAP_EXTERN {
        return "extern"
    }
    if h == DISASM_HEAP_ANY {
        return "any"
    }
    if h == DISASM_HEAP_EQ {
        return "eq"
    }
    if h == DISASM_HEAP_I31 {
        return "i31"
    }
    if h == DISASM_HEAP_STRUCT {
        return "struct"
    }
    if h == DISASM_HEAP_ARRAY {
        return "array"
    }
    if h == DISASM_HEAP_EXN {
        return "exn"
    }
    if h == DISASM_HEAP_NONE {
        return "none"
    }
    if h == DISASM_HEAP_NOEXTERN {
        return "noextern"
    }
    if h == DISASM_HEAP_NOFUNC {
        return "nofunc"
    }
    if h == DISASM_HEAP_NOEXN {
        return "noexn"
    }
    return String_from("")
}

fn read_heaptype_text(mut r: Rd) -> String {
    let h: i32 = read_s32(r)
    if h >= 0 {
        return h.to_string()
    }
    let name: String = abstract_heap_name(h)
    if name == "" {
        return "func"
    }
    return name
}

fn read_valtype_text(mut r: Rd) -> String {
    let b: i32 = read_byte(r)
    if b == DISASM_VT_I32 {
        return "i32"
    }
    if b == DISASM_VT_I64 {
        return "i64"
    }
    if b == DISASM_VT_F32 {
        return "f32"
    }
    if b == DISASM_VT_F64 {
        return "f64"
    }
    if b == DISASM_VT_V128 {
        return "v128"
    }
    if b == DISASM_VT_REF_NULL {
        return "(ref null ".concat(read_heaptype_text(r)).concat(")")
    }
    if b == DISASM_VT_REF {
        return "(ref ".concat(read_heaptype_text(r)).concat(")")
    }
    return shorthand_ref_name(b)
}

fn read_storagetype_text(mut r: Rd) -> String {
    let b: i32 = peek_byte(r)
    if b == DISASM_VT_I8 {
        skip_bytes(r, 1)
        return "i8"
    }
    if b == DISASM_VT_I16 {
        skip_bytes(r, 1)
        return "i16"
    }
    return read_valtype_text(r)
}

fn read_fieldtype_text(mut r: Rd) -> String {
    let t: String = read_storagetype_text(r)
    let mutability: i32 = read_byte(r)
    if mutability != 0 {
        return "(mut ".concat(t).concat(")")
    }
    return t
}

fn read_limits_text(mut r: Rd) -> String {
    let flags: i32 = read_byte(r)
    let has_max: bool = (flags & 1) != 0
    let is_shared: bool = (flags & 2) != 0
    let is_64: bool = (flags & 4) != 0
    let has_pagesize: bool = (flags & 8) != 0
    let mut s: String = String_from("")
    if is_64 {
        s = s.concat("i64 ")
        s = s.concat(read_u64(r).to_string())
    } else {
        s = s.concat(text_u32(read_u32(r)))
    }
    if has_max {
        if is_64 {
            s = s.concat(" ").concat(read_u64(r).to_string())
        } else {
            s = s.concat(" ").concat(text_u32(read_u32(r)))
        }
    }
    if is_shared {
        s = s.concat(" shared")
    }
    if has_pagesize {
        // custom-page-sizes: limits の後ろに log2(page_size) が続く。
        let log2: i32 = read_u32(r)
        s = s.concat(" (pagesize 0x").concat(u64_hex(1i64 << __intrinsic_i32_to_i64(log2))).concat(")")
    }
    return s
}

fn read_globaltype_text(mut r: Rd) -> String {
    let t: String = read_valtype_text(r)
    let mutability: i32 = read_byte(r)
    if mutability != 0 {
        return "(mut ".concat(t).concat(")")
    }
    return t
}

fn read_param_result_lists(mut r: Rd, prefix: String) -> String {
    let mut s: String = prefix
    let np: i32 = read_u32(r)
    if np > 0 {
        s = s.concat(" (param")
        let mut i: i32 = 0
        while i < np && r.p < r.n {
            s = s.concat(" ").concat(read_valtype_text(r))
            i = i + 1
        }
        s = s.concat(")")
    }
    let nr: i32 = read_u32(r)
    if nr > 0 {
        s = s.concat(" (result")
        let mut i: i32 = 0
        while i < nr && r.p < r.n {
            s = s.concat(" ").concat(read_valtype_text(r))
            i = i + 1
        }
        s = s.concat(")")
    }
    return s
}

fn comptype_text(mut r: Rd) -> String {
    let b: i32 = read_byte(r)
    if b == DISASM_COMP_FUNC {
        return read_param_result_lists(r, String_from("(func")).concat(")")
    }
    if b == DISASM_COMP_STRUCT {
        let n: i32 = read_u32(r)
        let mut s: String = String_from("(struct")
        let mut i: i32 = 0
        while i < n && r.p < r.n {
            s = s.concat(" (field ").concat(read_fieldtype_text(r)).concat(")")
            i = i + 1
        }
        return s.concat(")")
    }
    if b == DISASM_COMP_ARRAY {
        return "(array ".concat(read_fieldtype_text(r)).concat(")")
    }
    return "(func)"
}

fn subtype_text(mut r: Rd) -> String {
    let b: i32 = peek_byte(r)
    if b != DISASM_SUB && b != DISASM_SUB_FINAL {
        return comptype_text(r)
    }
    skip_bytes(r, 1)
    let nsuper: i32 = read_u32(r)
    let mut s: String = String_from("(sub ")
    if b == DISASM_SUB_FINAL {
        s = s.concat("final ")
    }
    let mut i: i32 = 0
    while i < nsuper && r.p < r.n {
        s = s.concat(text_u32(read_u32(r))).concat(" ")
        i = i + 1
    }
    return s.concat(comptype_text(r)).concat(")")
}

fn emit_type_section(mut r: Rd, mut o: Out) {
    let count: i32 = read_u32(r)
    let mut index: i32 = 0
    let mut i: i32 = 0
    while i < count && r.p < r.n {
        if peek_byte(r) == DISASM_REC_GROUP {
            skip_bytes(r, 1)
            let n: i32 = read_u32(r)
            put(o, 1, "(rec")
            let mut j: i32 = 0
            while j < n && r.p < r.n {
                put(o, 2, type_entry_text(r, index))
                index = index + 1
                j = j + 1
            }
            put(o, 1, ")")
        } else {
            put(o, 1, type_entry_text(r, index))
            index = index + 1
        }
        i = i + 1
    }
}

fn type_entry_text(mut r: Rd, index: i32) -> String {
    return "(type (;".concat(index.to_string()).concat(";) ").concat(subtype_text(r)).concat(")")
}

// ---------------------------------------------------------------------------
// 初期化式（global / elem / data の offset など）
// ---------------------------------------------------------------------------

fn const_expr_parts(mut r: Rd) -> Vec<String> {
    let mut parts: Vec<String> = Vec::new<String>()
    let mut done: bool = false
    while !done && r.p < r.n {
        if peek_byte(r) == 0x0b {
            skip_bytes(r, 1)
            done = true
        } else {
            let text: String = instr_text(r)
            if text == "" {
                done = true
            } else {
                parts.push(text)
            }
        }
    }
    return parts
}

// 単一命令なら `(i32.const 0)`、複数なら平坦な並びで返す。
fn const_expr_text(mut r: Rd) -> String {
    let parts: Vec<String> = const_expr_parts(r)
    if parts.len() == 0 {
        return "(i32.const 0)"
    }
    if parts.len() == 1 {
        return "(".concat(parts.get_unchecked(0)).concat(")")
    }
    return parts.join(String_from(" "))
}

// ---------------------------------------------------------------------------
// 命令
// ---------------------------------------------------------------------------

fn natural_align(op: i32) -> i32 {
    if op == 0x28 || op == 0x2a || op == 0x34 || op == 0x35 {
        return 2
    }
    if op == 0x29 || op == 0x2b || op == 0x36 || op == 0x37 || op == 0x38 || op == 0x39 || op == 0x3e {
        return 3
    }
    if op == 0x2c || op == 0x2d || op == 0x30 || op == 0x31 || op == 0x3a || op == 0x3c {
        return 0
    }
    if op == 0x2e || op == 0x2f || op == 0x32 || op == 0x33 || op == 0x3b || op == 0x3d {
        return 1
    }
    return 2
}

fn memory_instr_name(op: i32) -> String {
    if op == 0x28 {
        return "i32.load"
    }
    if op == 0x29 {
        return "i64.load"
    }
    if op == 0x2a {
        return "f32.load"
    }
    if op == 0x2b {
        return "f64.load"
    }
    if op == 0x2c {
        return "i32.load8_s"
    }
    if op == 0x2d {
        return "i32.load8_u"
    }
    if op == 0x2e {
        return "i32.load16_s"
    }
    if op == 0x2f {
        return "i32.load16_u"
    }
    if op == 0x30 {
        return "i64.load8_s"
    }
    if op == 0x31 {
        return "i64.load8_u"
    }
    if op == 0x32 {
        return "i64.load16_s"
    }
    if op == 0x33 {
        return "i64.load16_u"
    }
    if op == 0x34 {
        return "i64.load32_s"
    }
    if op == 0x35 {
        return "i64.load32_u"
    }
    if op == 0x36 {
        return "i32.store"
    }
    if op == 0x37 {
        return "i64.store"
    }
    if op == 0x38 {
        return "f32.store"
    }
    if op == 0x39 {
        return "f64.store"
    }
    if op == 0x3a {
        return "i32.store8"
    }
    if op == 0x3b {
        return "i32.store16"
    }
    if op == 0x3c {
        return "i64.store8"
    }
    if op == 0x3d {
        return "i64.store16"
    }
    if op == 0x3e {
        return "i64.store32"
    }
    return String_from("")
}

fn memarg_text(mut r: Rd, op: i32, name: String) -> String {
    let raw_align: i32 = read_u32(r)
    let mut memidx: i32 = 0
    let mut align_exp: i32 = raw_align
    if (raw_align & 0x40) != 0 {
        memidx = read_u32(r)
        align_exp = raw_align & 0x3f
    }
    let offset: i64 = read_u64(r)
    let mut s: String = name
    if memidx != 0 {
        s = s.concat(" ").concat(text_u32(memidx))
    }
    if offset != 0i64 {
        s = s.concat(" offset=").concat(offset.to_string())
    }
    if align_exp != natural_align(op) {
        s = s.concat(" align=").concat((1 << align_exp).to_string())
    }
    return s
}

fn numeric_noimm_name(op: i32) -> String {
    if op >= 0x45 && op <= 0x4f {
        return i32_cmp_name(op - 0x45)
    }
    if op >= 0x50 && op <= 0x5a {
        return i64_cmp_name(op - 0x50)
    }
    if op >= 0x5b && op <= 0x60 {
        return f32_cmp_name(op - 0x5b)
    }
    if op >= 0x61 && op <= 0x66 {
        return f64_cmp_name(op - 0x61)
    }
    if op >= 0x67 && op <= 0x78 {
        return i32_arith_name(op - 0x67)
    }
    if op >= 0x79 && op <= 0x8a {
        return i64_arith_name(op - 0x79)
    }
    if op >= 0x8b && op <= 0x98 {
        return f32_arith_name(op - 0x8b)
    }
    if op >= 0x99 && op <= 0xa6 {
        return f64_arith_name(op - 0x99)
    }
    if op >= 0xa7 && op <= 0xc4 {
        return convert_name(op - 0xa7)
    }
    return String_from("")
}

