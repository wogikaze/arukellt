use std::prelude::{eq}
use compiler::session
use corehir::export_surface
use driver::checked_program
use driver::config_record
use mir::emit_spec
use resolver::wit_import_bind
use wasm::emit_target

// #851 Phase 3: emit parameters for the fused in-loop body emit. Enabled
// only when this compile will emit core Wasm on the GC target — other emit
// modes and the linear target keep the legacy post-lower emit loop.
fn lower_emit_spec_for(program: CheckedProgram, config: DriverConfig) -> MirLowerEmitSpec {
    let emit_mode = config_record::config_emit_mode(config)
    let target = config_record::config_target(config)
    let emits_wasm = eq(emit_mode.clone(), String_from("wasm")) ||
    eq(emit_mode.clone(), String_from("core-wasm")) ||
    eq(emit_mode.clone(), String_from("component"))
    if !emits_wasm || !emit_target::is_gc_target(target.clone()) {
        return emit_spec::mir_lower_emit_spec_disabled()
    }
    let wasi_version = config_record::config_wasi_version(config)
    let bindings = wit_import_bind::wit_collect_bindings(
        config_record::config_wit_paths(config),
        checked_program::checked_program_wit_decls(program)
    )
    emit_spec::mir_lower_emit_spec_new(
        wasi_version.clone(),
        emit_target::uses_memory64(target.clone(), wasi_version, config_record::config_memory_width(config)),
        target.clone(),
        config_record::config_source_file(config),
        bindings,
        config_record::config_opt_level(config),
        lower_report_phase_timing(config)
    )
}

fn lower_report_phase_timing(config: DriverConfig) -> i32 {
    if config_record::config_show_timing(config) {
        return 1
    }
    0
}

fn lower_checked_program(program: CheckedProgram, config: DriverConfig, source: String) -> MirModule {
    let emit_mode = config_record::config_emit_mode(config)
    let component_mode = eq(emit_mode.clone(), "component") || eq(emit_mode.clone(), "wit")
    if component_mode {
        return lower_component_program(program, config, source.clone())
    }
    if is_t3_wasm_emit(config, emit_mode.clone()) {
        return lower_t3_wasm_program(program, config, source.clone())
    }
    let decls = checked_program::checked_program_all_decls(program)
    let export_roots = export_surface::export_surface_names(
        checked_program::checked_program_export_surface(program)
    )
    session::session_lower_mir(
        checked_program::checked_program_session(program),
        decls,
        export_roots,
        config_record::config_wit_paths(config),
        config_record::config_target(config),
        lower_report_phase_timing(config),
        source,
        lower_emit_spec_for(program, config)
    )
}

fn is_t3_wasm_emit(config: DriverConfig, emit_mode: String) -> bool {
    if !eq(emit_mode.clone(), "wasm") && !eq(emit_mode.clone(), "core-wasm") {
        return false
    }
    let target = config_record::config_target(config)
    // Primary GC target is T3 even when wasi-version is a separate CLI flag
    // (config_target is often just "wasm32-gc", without "-p2" in the string).
    eq(target.clone(), "wasm32-gc")
    || target.clone().contains("wasm32-gc")
    || target.clone().contains("-p2")
}

fn lower_t3_wasm_program(program: CheckedProgram, config: DriverConfig, source: String) -> MirModule {
    let decls = checked_program::checked_program_all_decls(program)
    let export_roots = export_surface::export_surface_names(checked_program::checked_program_export_surface(program))
    session::session_lower_mir_component(
        checked_program::checked_program_session(program),
        decls,
        export_roots,
        config_record::config_wit_paths(config),
        config_record::config_target(config),
        lower_report_phase_timing(config),
        source,
        lower_emit_spec_for(program, config)
    )
}

fn lower_component_program(program: CheckedProgram, config: DriverConfig, source: String) -> MirModule {
    let decls = checked_program::checked_program_all_decls(program)
    let export_roots = export_surface::export_surface_names(checked_program::checked_program_export_surface(program))
    session::session_lower_mir_component(
        checked_program::checked_program_session(program),
        decls,
        export_roots,
        config_record::config_wit_paths(config),
        config_record::config_target(config),
        lower_report_phase_timing(config),
        source,
        lower_emit_spec_for(program, config)
    )
}
