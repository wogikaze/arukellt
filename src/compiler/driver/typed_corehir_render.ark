use driver::verified_core_render_safe

fn render_typed_corehir(program: CoreHirRawProgram, config: DriverConfig) -> String {
    let rendered = verified_core_render_safe::render_verified_core(program, config)
    if len(clone(rendered)) == 0 {
        return ""
    }
    replace(
        rendered,
        String_from("\"schema\":\"arukellt-verified-core\""),
        String_from("\"schema\":\"arukellt-typed-corehir\"")
    )
}
