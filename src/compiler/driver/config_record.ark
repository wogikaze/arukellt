struct DriverConfig {
    target: String,
    wasi_version: String,
    // True when `--wasi-version` was set on the CLI (not inferred from --target).
    wasi_version_explicit: bool,
    memory_width: String,
    opt_level: i32,
    emit_mode: String,
    wit_paths: Vec<String>,
    dump_tokens: bool,
    dump_ast: bool,
    dump_hir: bool,
    dump_verified_core: bool,
    dump_mir: bool,
    dump_backend_plan: bool,
    dump_wit_bindings: bool,
    dump_wasm: bool,
    parse_only: bool,
    check_only: bool,
    test_mode: bool,
    source_dir: String,
    source_file: String,
    show_timing: bool,
    world: String,
    lint_allow: Vec<String>,
    lint_deny: Vec<String>,
    lint_local_only: bool,
    cache_dir: String,
    strip_debug: bool,
    // Self-compile bootstrap escape hatch; not a user-facing language mode.
    bootstrap_shared_param_mutation: bool,
    // Close the ADR-089 ADR-014 migration window (E0222, no implicit inference).
    strict_impl_binders: bool,
}

fn DriverConfig_default() -> DriverConfig {
    DriverConfig {
        target: "wasm32-gc",
        wasi_version: "wasi-p2",
        wasi_version_explicit: false,
        memory_width: "auto",
        opt_level: 0,
        emit_mode: "wasm",
        wit_paths: Vec::new<String>(),
        dump_tokens: false,
        dump_ast: false,
        dump_hir: false,
        dump_verified_core: false,
        dump_mir: false,
        dump_backend_plan: false,
        dump_wit_bindings: false,
        dump_wasm: false,
        parse_only: false,
        check_only: false,
        test_mode: false,
        source_dir: ".",
        source_file: "",
        show_timing: false,
        world: "",
        lint_allow: Vec::new<String>(),
        lint_deny: Vec::new<String>(),
        lint_local_only: false,
        cache_dir: "",
        strip_debug: false,
        bootstrap_shared_param_mutation: false,
        strict_impl_binders: false,
    }
}

fn config_target(config: DriverConfig) -> String { config.target.clone() }
fn config_wasi_version(config: DriverConfig) -> String { config.wasi_version.clone() }
fn config_wasi_version_explicit(config: DriverConfig) -> bool { config.wasi_version_explicit }
fn config_memory_width(config: DriverConfig) -> String { config.memory_width.clone() }
fn config_opt_level(config: DriverConfig) -> i32 { config.opt_level }
fn config_emit_mode(config: DriverConfig) -> String { config.emit_mode.clone() }
fn config_wit_paths(config: DriverConfig) -> Vec<String> { config.wit_paths }
fn config_dump_tokens(config: DriverConfig) -> bool { config.dump_tokens }
fn config_dump_ast(config: DriverConfig) -> bool { config.dump_ast }
fn config_dump_hir(config: DriverConfig) -> bool { config.dump_hir }
fn config_dump_verified_core(config: DriverConfig) -> bool { config.dump_verified_core }
fn config_dump_mir(config: DriverConfig) -> bool { config.dump_mir }
fn config_dump_backend_plan(config: DriverConfig) -> bool { config.dump_backend_plan }
fn config_dump_wit_bindings(config: DriverConfig) -> bool { config.dump_wit_bindings }
fn config_dump_wasm(config: DriverConfig) -> bool { config.dump_wasm }
fn config_show_timing(config: DriverConfig) -> bool { config.show_timing }
fn config_parse_only(config: DriverConfig) -> bool { config.parse_only }
fn config_check_only(config: DriverConfig) -> bool { config.check_only }
fn config_test_mode(config: DriverConfig) -> bool { config.test_mode }
fn config_source_dir(config: DriverConfig) -> String { config.source_dir.clone() }
fn config_source_file(config: DriverConfig) -> String { config.source_file.clone() }
fn config_set_wasi_version(mut config: DriverConfig, wasi_version: String) { config.wasi_version = wasi_version }
fn config_set_wasi_version_explicit(mut config: DriverConfig, wasi_version_explicit: bool) {
    config.wasi_version_explicit = wasi_version_explicit
}
fn config_set_memory_width(mut config: DriverConfig, memory_width: String) { config.memory_width = memory_width }
fn config_set_target(mut config: DriverConfig, target: String) { config.target = target }
fn config_set_opt_level(mut config: DriverConfig, opt_level: i32) { config.opt_level = opt_level }
fn config_set_emit_mode(mut config: DriverConfig, emit_mode: String) { config.emit_mode = emit_mode }
fn config_set_wit_paths(mut config: DriverConfig, wit_paths: Vec<String>) { config.wit_paths = wit_paths }
fn config_set_dump_tokens(mut config: DriverConfig, dump_tokens: bool) { config.dump_tokens = dump_tokens }
fn config_set_dump_ast(mut config: DriverConfig, dump_ast: bool) { config.dump_ast = dump_ast }
fn config_set_dump_hir(mut config: DriverConfig, dump_hir: bool) { config.dump_hir = dump_hir }
fn config_set_dump_verified_core(mut config: DriverConfig, dump_verified_core: bool) { config.dump_verified_core = dump_verified_core }
fn config_set_dump_mir(mut config: DriverConfig, dump_mir: bool) { config.dump_mir = dump_mir }
fn config_set_dump_backend_plan(mut config: DriverConfig, dump_backend_plan: bool) { config.dump_backend_plan = dump_backend_plan }
fn config_set_dump_wit_bindings(mut config: DriverConfig, dump_wit_bindings: bool) { config.dump_wit_bindings = dump_wit_bindings }
fn config_set_dump_wasm(mut config: DriverConfig, dump_wasm: bool) { config.dump_wasm = dump_wasm }
fn config_set_show_timing(mut config: DriverConfig, show_timing: bool) { config.show_timing = show_timing }
fn config_set_parse_only(mut config: DriverConfig, parse_only: bool) { config.parse_only = parse_only }
fn config_set_check_only(mut config: DriverConfig, check_only: bool) { config.check_only = check_only }
fn config_set_test_mode(mut config: DriverConfig, test_mode: bool) { config.test_mode = test_mode }
fn config_set_source_dir(mut config: DriverConfig, source_dir: String) { config.source_dir = source_dir }
fn config_set_source_file(mut config: DriverConfig, source_file: String) { config.source_file = source_file }
fn config_world(config: DriverConfig) -> String { config.world.clone() }
fn config_set_world(mut config: DriverConfig, world: String) { config.world = world }
fn config_lint_allow(config: DriverConfig) -> Vec<String> { config.lint_allow }
fn config_lint_deny(config: DriverConfig) -> Vec<String> { config.lint_deny }
fn config_set_lint_allow(mut config: DriverConfig, lint_allow: Vec<String>) { config.lint_allow = lint_allow }
fn config_set_lint_deny(mut config: DriverConfig, lint_deny: Vec<String>) { config.lint_deny = lint_deny }
fn config_lint_local_only(config: DriverConfig) -> bool { config.lint_local_only }
fn config_set_lint_local_only(mut config: DriverConfig, lint_local_only: bool) { config.lint_local_only = lint_local_only }
fn config_cache_dir(config: DriverConfig) -> String { config.cache_dir.clone() }
fn config_set_cache_dir(mut config: DriverConfig, cache_dir: String) { config.cache_dir = cache_dir }
fn config_strip_debug(config: DriverConfig) -> bool { config.strip_debug }
fn config_bootstrap_shared_param_mutation(config: DriverConfig) -> bool { config.bootstrap_shared_param_mutation }
fn config_set_bootstrap_shared_param_mutation(mut config: DriverConfig, enabled: bool) {
    config.bootstrap_shared_param_mutation = enabled
}
fn config_strict_impl_binders(config: DriverConfig) -> bool { config.strict_impl_binders }
fn config_set_strict_impl_binders(mut config: DriverConfig, enabled: bool) {
    config.strict_impl_binders = enabled
}
fn config_set_strip_debug(mut config: DriverConfig, strip_debug: bool) { config.strip_debug = strip_debug }
