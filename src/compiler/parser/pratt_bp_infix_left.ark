use lexer::tokens

pub fn infix_bp_left(kind: i32) -> i32 {
    if kind == tokens::TK_PIPEPIPE() {
        return 3
    }
    if kind == tokens::TK_AMPAMP() {
        return 5
    }
    if kind == tokens::TK_PIPE() {
        return 7
    }
    if kind == tokens::TK_CARET() {
        return 9
    }
    if kind == tokens::TK_AMP() {
        return 11
    }
    if kind == tokens::TK_EQEQ() || kind == tokens::TK_BANGEQ() {
        return 13
    }
    if kind == tokens::TK_LT() || kind == tokens::TK_LTEQ() || kind == tokens::TK_GT() || kind == tokens::TK_GTEQ() {
        return 15
    }
    if kind == tokens::TK_SHL() || kind == tokens::TK_SHR() {
        return 17
    }
    if kind == tokens::TK_PLUS() || kind == tokens::TK_MINUS() {
        return 19
    }
    if kind == tokens::TK_STAR() || kind == tokens::TK_SLASH() || kind == tokens::TK_PERCENT() {
        return 21
    }
    0
}

test mod "infix_bp_left" {
    test "logical_or_weakest" { assert(infix_bp_left(tokens::TK_PIPEPIPE()) == 3) }
    test "logical_and_above_or" { assert(infix_bp_left(tokens::TK_AMPAMP()) == 5) }
    test "equality" { assert(infix_bp_left(tokens::TK_EQEQ()) == 13) }
    test "inequality" { assert(infix_bp_left(tokens::TK_BANGEQ()) == 13) }
    test "comparison" { assert(infix_bp_left(tokens::TK_LT()) == 15) }
    test "shift" { assert(infix_bp_left(tokens::TK_SHL()) == 17) }
    test "additive" { assert(infix_bp_left(tokens::TK_PLUS()) == 19) }
    test "multiplicative_strongest" { assert(infix_bp_left(tokens::TK_STAR()) == 21) }
    test "non_infix_zero" { assert(infix_bp_left(tokens::TK_EOF()) == 0) }
    test "precedence_ordering" {
        assert(infix_bp_left(tokens::TK_STAR()) > infix_bp_left(tokens::TK_PLUS()))
        assert(infix_bp_left(tokens::TK_PLUS()) > infix_bp_left(tokens::TK_EQEQ()))
    }
}
