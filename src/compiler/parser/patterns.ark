use lexer::tokens
use parser::core_ast_children
use parser::core_ast_factory
use parser::core_ast_span_fields
use parser::core_api_cursor
use parser::core_api_expect
use parser::pattern_ident
use parser::pattern_literals
use parser::kinds
use parser::token_state

fn parse_pattern(mut p: Parser) -> AstNode {
    skip_newlines(p)
    let t = cur(p)
    let kind = token_state::Token_kind(t)
    if kind == tokens::TK_UNDERSCORE()
    || kind == tokens::TK_INT()
    || kind == tokens::TK_STRING()
    || kind == tokens::TK_BOOL() {
        return pattern_literals::parse_literal_pattern(p, t)
    }
    if kind == tokens::TK_LPAREN() {
        return parse_tuple_pattern(p, t)
    }
    if kind == tokens::TK_IDENT() {
        return pattern_ident::parse_ident_pattern(p, t)
    }
    error(p, "expected pattern")
    AstNode_leaf(kinds::NK_PAT_WILDCARD(), "_", tok_span(t))
}

fn parse_tuple_pattern(mut p: Parser, t: Token) -> AstNode {
    p.pos = p.pos + 1
    let mut node = AstNode_new(kinds::NK_PAT_TUPLE(), tok_span(t))
    let mut first = true
    while !core_api_cursor::at(p, tokens::TK_RPAREN()) && !core_api_cursor::at_eof(p) {
        if !first {
            expect_token(p, tokens::TK_COMMA())
        }
        first = false
        skip_newlines(p)
        // An element may carry pipe alternatives just like an arm head, so
        // match lowering sees the same NK_PAT_OR shape in element position.
        let elem = parse_or_pattern_alts(p, parse_pattern(p))
        core_ast_children::AstNode_push_child(node, elem)
        skip_newlines(p)
    }
    expect_token(p, tokens::TK_RPAREN())
    node
}

// Wrap a pattern in NK_PAT_OR when pipe alternatives follow, mirroring the
// arm-head or-pattern builder in expr_control_match_arm.
fn parse_or_pattern_alts(mut p: Parser, first: AstNode) -> AstNode {
    if peek_kind(p) != tokens::TK_PIPE() {
        return first
    }
    let mut or_node = AstNode_new(kinds::NK_PAT_OR(), core_ast_span_fields::AstNode_span(first))
    core_ast_children::AstNode_push_child(or_node, first)
    while peek_kind(p) == tokens::TK_PIPE() {
        p.pos = p.pos + 1
        skip_newlines(p)
        let alt = parse_pattern(p)
        core_ast_children::AstNode_push_child(or_node, alt)
        skip_newlines(p)
    }
    or_node
}
