use lexer::tokens
use parser::core_ast_children
use parser::core_ast_text_fields
use parser::core_ast_factory
use parser::core_ast_type_ann
use parser::core_api_cursor
use parser::core_api_expect
use parser::kinds
use parser::type_params
use parser::types

fn parse_impl_header(p: Parser) -> AstNode {
    let t = core_api_expect::expect_token(p, tokens::TK_IMPL())
    let impl_span = core_api_expect::tok_span(t)
    let node = core_ast_factory::AstNode_new(kinds::NK_IMPL_DECL(), impl_span)
    core_api_cursor::skip_newlines(p)
    let generics = type_params::parse_generic_params(p)
    core_api_cursor::skip_newlines(p)
    let impl_head = types::parse_type(p)
    core_ast_text_fields::AstNode_set_text(node, core_ast_text_fields::AstNode_text(impl_head))
    core_ast_type_ann::AstNode_push_type_ann(node, impl_head)
    core_api_cursor::skip_newlines(p)
    if core_api_cursor::peek_kind(p) == tokens::TK_FOR() {
        p.pos = p.pos + 1
        core_api_cursor::skip_newlines(p)
        let target_ty = types::parse_type(p)
        core_ast_type_ann::AstNode_push_type_ann(node, target_ty)
    }
    push_impl_generics(node, generics, impl_span)
    core_api_cursor::skip_newlines(p)
    core_api_expect::expect_token(p, tokens::TK_LBRACE())
    node
}

// The binder is appended after the trait/self heads rather than parsed in
// place: resolver, CoreHIR, and typechecker all read the heads from type-ann
// indices 0 and 1, and the binder must not shift those established slots.
fn push_impl_generics(node: AstNode, generics: Vec<AstNode>, span: Span) {
    if len(generics) == 0 {
        return
    }
    let binder = core_ast_factory::AstNode_new(kinds::NK_IMPL_GENERICS(), span)
    let count = len(generics)
    let mut i = 0
    while i < count {
        core_ast_children::AstNode_push_child(binder, get_unchecked(generics, i))
        i = i + 1
    }
    core_ast_type_ann::AstNode_push_type_ann(node, binder)
}
