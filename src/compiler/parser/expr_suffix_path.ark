use std::text
use lexer::tokens
use parser::core_ast_text_fields
use parser::core_ast_span_fields
use parser::kinds
use parser::core_ast_factory
use parser::core_ast_children
use parser::core_api_cursor
use parser::core_api_expect
use parser::expr_prefix_struct_fields
use parser::expr_prefix_struct_probe
use parser::state_record
use parser::token_state
use parser::type_token_predicates
use parser::types

pub fn parse_path_suffix(mut p: Parser, lhs: AstNode) -> AstNode {
    p.pos = p.pos + 1
    let seg = expect_token(p, tokens::TK_IDENT())
    let mut node = AstNode_new(kinds::NK_PATH(), core_ast_span_fields::AstNode_span(lhs))
    core_ast_text_fields::AstNode_set_text(node, core_ast_text_fields::AstNode_text(lhs).concat("::".concat(token_state::Token_text(seg))))
    core_ast_children::AstNode_push_child(node, lhs)
    if expr_prefix_struct_probe::next_prefix_is_struct_lit(p) {
        let mut lit = expr_prefix_struct_fields::parse_struct_lit_fields(p, seg)
        core_ast_text_fields::AstNode_set_text(lit, core_ast_text_fields::AstNode_text(node))
        return lit
    }
    // Turbofish: Type::function<T>() — parse explicit type arguments after path.
    // Accept any type start (named, fn, tuple), not only identifiers (#845 fn vec).
    // Use backtracking: if the type arg list is not properly closed with >,
    // restore position so < is treated as a binary less-than operator.
    if core_api_cursor::peek_kind(p) == tokens::TK_LT() {
        let saved_pos = state_record::parser_position(p)
        p.pos = p.pos + 1
        core_api_cursor::skip_newlines(p)
        let peek = core_api_cursor::peek_kind(p)
        if type_token_predicates::is_named_start(peek) ||
        type_token_predicates::is_fn_start(peek) ||
        type_token_predicates::is_tuple_start(peek) {
            let type_args = parse_turbofish_type_args(p)
            if type_args.len() > 0 {
                let mut k = 0
                while k < type_args.len() {
                    core_ast_children::AstNode_push_child(node, type_args.get_unchecked(k))
                    k = k + 1
                }
                // Vec::new<T>() keeps path text "Vec::new"; typechecker binds
                // turbofish children and monomorphizes the associated fn (#845).
            } else {
                state_record::parser_set_position(p, saved_pos)
            }
        } else {
            state_record::parser_set_position(p, saved_pos)
        }
    }
    // Rewrite known builtin associated functions (no turbofish) to intrinsic names.
    // String::from(x) → String_from, i32::from(s) → parse_i32.
    // This lets the resolver/typechecker/lowering see the prelude function directly.
    let final_text = core_ast_text_fields::AstNode_text(node)
    if final_text.clone().eq("String::from") {
        core_ast_text_fields::AstNode_set_text(node, "String_from")
    }
    if final_text.clone().eq("i32::from") {
        core_ast_text_fields::AstNode_set_text(node, "parse_i32")
    }
    node
}

// Parse turbofish type arguments: < already consumed, parse type, type, ... >
// Returns a Vec of type AST nodes, or empty Vec if > not found (backtrack needed).
fn parse_turbofish_type_args(mut p: Parser) -> Vec<AstNode> {
    let mut args = Vec::new<AstNode>()
    let mut first = true
    while true {
        core_api_cursor::skip_newlines(p)
        if core_api_cursor::peek_kind(p) == tokens::TK_GT() {
            p.pos = p.pos + 1
            return args
        }
        if core_api_cursor::peek_kind(p) == tokens::TK_SHR() {
            // Split >> into > and remaining >
            let t = core_api_cursor::cur(p)
            let gt_tok = token_state::Token_new(tokens::TK_GT(), ">", token_state::Token_start(t), token_state::Token_end(t))
            state_record::parser_set_current_token(p, gt_tok)
            return args
        }
        if !first {
            if core_api_cursor::peek_kind(p) != tokens::TK_COMMA() {
                return Vec::new<AstNode>()
            }
            p.pos = p.pos + 1
            core_api_cursor::skip_newlines(p)
        }
        first = false
        let arg_peek = core_api_cursor::peek_kind(p)
        if !type_token_predicates::is_named_start(arg_peek) &&
        !type_token_predicates::is_fn_start(arg_peek) &&
        !type_token_predicates::is_tuple_start(arg_peek) {
            return Vec::new<AstNode>()
        }
        let arg = types::parse_type(p)
        push(args, arg)
    }
    args
}
