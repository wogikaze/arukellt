use parser::fstring_nodes

fn fstring_concat_segments(nodes: Vec<AstNode>, span: Span) -> AstNode {
    let n = nodes.len()
    if n == 0 {
        return fstring_nodes::fstring_string_lit(String_new(), span)
    }
    if n == 1 {
        return nodes.get_unchecked(0)
    }
    let mut result = nodes.get_unchecked(0)
    let mut j = 1
    while j < n {
        result = fstring_nodes::fstring_concat_call(result, nodes.get_unchecked(j), span)
        j = j + 1
    }
    result
}
