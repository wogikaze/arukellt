use std::text
use parser::ast_kind_fields
use parser::core_ast_text_fields
use parser::core_ast_op_fields
use parser::kinds
use parser::core_ast_children
use parser::self_check_issue499_parse
fn issue499_parser_lexer_integration_self_check() -> String {
    let src = "fn main() { let add = |x, y| x + y }"
    let parse = self_check_issue499_parse::parse_issue499_source(src)
    let decls = self_check_issue499_parse::issue499_parse_decls(parse)
    let error_count = self_check_issue499_parse::issue499_parse_error_count(parse)
    if error_count != 0 {
        return "issue499 lexer integration fail: parse errors=".concat(error_count.to_string())
    }
    if decls.len() != 1 {
        return "issue499 lexer integration fail: decl count=".concat(decls.len().to_string())
    }
    let fn_decl = decls.get_unchecked(0)
    if ast_kind_fields::AstNode_kind(fn_decl) != kinds::NK_FN_DECL() {
        return "issue499 lexer integration fail: expected fn decl"
    }
    if core_ast_children::AstNode_child_count(fn_decl) != 1 {
        return "issue499 lexer integration fail: fn child count=".concat(core_ast_children::AstNode_child_count(fn_decl).to_string())
    }
    let body = core_ast_children::AstNode_child_at(fn_decl, 0)
    if ast_kind_fields::AstNode_kind(body) != kinds::NK_BLOCK() {
        return "issue499 lexer integration fail: expected block body"
    }
    if core_ast_children::AstNode_child_count(body) != 1 {
        return "issue499 lexer integration fail: stmt count=".concat(core_ast_children::AstNode_child_count(body).to_string())
    }
    let let_stmt = core_ast_children::AstNode_child_at(body, 0)
    if ast_kind_fields::AstNode_kind(let_stmt) != kinds::NK_LET() {
        return "issue499 lexer integration fail: expected let stmt"
    }
    if core_ast_children::AstNode_child_count(let_stmt) != 1 {
        return "issue499 lexer integration fail: let child count=".concat(core_ast_children::AstNode_child_count(let_stmt).to_string())
    }
    let closure = core_ast_children::AstNode_child_at(let_stmt, 0)
    if ast_kind_fields::AstNode_kind(closure) != kinds::NK_CLOSURE() {
        return "issue499 lexer integration fail: expected closure expr"
    }
    if core_ast_children::AstNode_child_count(closure) != 3 {
        return "issue499 lexer integration fail: closure child count=".concat(core_ast_children::AstNode_child_count(closure).to_string())
    }
    let param0 = core_ast_children::AstNode_child_at(closure, 0)
    let param1 = core_ast_children::AstNode_child_at(closure, 1)
    let closure_body = core_ast_children::AstNode_child_at(closure, 2)
    if !core_ast_text_fields::AstNode_text(param0).eq("x") {
        return "issue499 lexer integration fail: first param"
    }
    if !core_ast_text_fields::AstNode_text(param1).eq("y") {
        return "issue499 lexer integration fail: second param"
    }
    if ast_kind_fields::AstNode_kind(closure_body) != kinds::NK_BINARY() || core_ast_op_fields::AstNode_op(closure_body) != kinds::OP_ADD() {
        return "issue499 lexer integration fail: closure body"
    }
    "issue499 parser ok: lexer integration |x, y| x + y"
}
