use lexer::tokens
use parser::core_ast_factory
use parser::core_ast_type_ann
use parser::core_api_cursor
use parser::core_api_expect
use parser::kinds
use parser::token_state
use parser::types

fn parse_type_param(mut p: Parser) -> AstNode {
    core_api_cursor::skip_newlines(p)
    let gp = core_api_expect::expect_token(p, tokens::TK_IDENT())
    let mut param = core_ast_factory::AstNode_leaf(kinds::NK_TYPE_NAMED(), token_state::Token_text(gp), core_api_expect::tok_span(gp))
    core_api_cursor::skip_newlines(p)
    if core_api_cursor::peek_kind(p) == tokens::TK_COLON() {
        p.pos = p.pos + 1
        // Support `T: Eq + Debug` — each bound is a separate type annotation.
        while true {
            core_api_cursor::skip_newlines(p)
            let bound = types::parse_type(p)
            core_ast_type_ann::AstNode_push_type_ann(param, bound)
            core_api_cursor::skip_newlines(p)
            if core_api_cursor::peek_kind(p) != tokens::TK_PLUS() {
                break
            }
            p.pos = p.pos + 1
        }
    }
    param
}

fn parse_generic_params(mut p: Parser) -> Vec<AstNode> {
    let mut params = Vec::new<AstNode>()
    if core_api_cursor::peek_kind(p) != tokens::TK_LT() {
        return params
    }
    p.pos = p.pos + 1
    let mut first = true
    while !core_api_cursor::at(p, tokens::TK_GT()) && !core_api_cursor::at(p, tokens::TK_SHR()) && !core_api_cursor::at_eof(p) {
        if !first {
            core_api_expect::expect_token(p, tokens::TK_COMMA())
        }
        first = false
        core_api_cursor::skip_newlines(p)
        push(params, parse_type_param(p))
        core_api_cursor::skip_newlines(p)
    }
    core_api_expect::consume_closing_gt(p)
    params
}

fn parse_generic_params_into_node(mut p: Parser, mut node: AstNode) {
    let params = parse_generic_params(p)
    let count = params.len()
    let mut i = 0
    while i < count {
        core_ast_type_ann::AstNode_push_type_ann(node, get_unchecked(params, i))
        i = i + 1
    }
}
