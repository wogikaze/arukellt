use parser::ast_node_record

fn AstNode_push_type_ann(mut node: AstNode, ann: AstNode) {
    node.type_ann.push(ann)
}

fn AstNode_type_ann_count(node: AstNode) -> i32 {
    node.type_ann.len()
}

fn AstNode_type_ann_at(node: AstNode, index: i32) -> AstNode {
    node.type_ann.get_unchecked(index)
}
