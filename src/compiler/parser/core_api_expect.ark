use parser::expect

fn consume_closing_gt(mut p: Parser) { expect::consume_closing_gt(p) }
fn consume_optional_mut(mut p: Parser) -> bool { expect::consume_optional_mut(p) }
fn expect_token(mut p: Parser, kind: i32) -> Token { expect::expect_token(p, kind) }
fn tok_span(t: Token) -> Span { expect::tok_span(t) }
fn error(mut p: Parser, msg: String) { expect::error(p, msg) }
