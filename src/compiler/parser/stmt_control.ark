use parser::stmt_loop
use parser::stmt_transfer

pub fn parse_return(mut p: Parser) -> AstNode {
    stmt_transfer::parse_return(p)
}

pub fn parse_break(mut p: Parser) -> AstNode {
    stmt_transfer::parse_break(p)
}

pub fn parse_continue(mut p: Parser) -> AstNode {
    stmt_transfer::parse_continue(p)
}

pub fn parse_while(mut p: Parser) -> AstNode {
    stmt_loop::parse_while(p)
}

pub fn parse_loop(mut p: Parser) -> AstNode {
    stmt_loop::parse_loop(p)
}

pub fn parse_for(mut p: Parser) -> AstNode {
    stmt_loop::parse_for(p)
}
