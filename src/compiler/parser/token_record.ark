use std::prelude::{clone}
pub struct Token {
    kind: i32,
    text: String,
    int_val: i32,
    float_val: f64,
    start: i32,
    end: i32,
}

fn make_token(kind: i32, text: String, start: i32, end: i32) -> Token {
    Token { kind: kind, text: text, int_val: 0, float_val: 0.0, start: start, end: end }
}

fn token_kind(tok: Token) -> i32 {
    tok.kind
}

fn token_text(tok: Token) -> String {
    clone(tok.text)
}

fn token_int_val(tok: Token) -> i32 {
    tok.int_val
}

fn token_float_val(tok: Token) -> f64 {
    tok.float_val
}

fn token_start(tok: Token) -> i32 {
    tok.start
}

fn token_end(tok: Token) -> i32 {
    tok.end
}

test mod "token_record" {
    test "make_token_kind" {
        let t = make_token(10, "fn", 0, 2)
        assert(token_kind(t) == 10)
    }
    test "make_token_text" {
        let t = make_token(1, "abc", 3, 6)
        assert(token_text(t) == "abc")
    }
    test "make_token_positions" {
        let t = make_token(1, "x", 5, 9)
        assert(token_start(t) == 5)
        assert(token_end(t) == 9)
    }
    test "make_token_default_vals" {
        let t = make_token(1, "x", 0, 1)
        assert(token_int_val(t) == 0)
    }
}
