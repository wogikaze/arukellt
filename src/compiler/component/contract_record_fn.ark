use component::contract_helpers
fn component_fn_is_point_to_i32(f: ComponentExportFunc) -> bool {
    contract_helpers::component_export_param_count_is(f, 1) &&
    contract_helpers::component_export_param_type_name_at(f, 0).eq("Point") &&
    contract_helpers::component_export_return_type_name(f).eq("i32")
}

fn component_fn_is_point_point_to_point(f: ComponentExportFunc) -> bool {
    contract_helpers::component_export_param_count_is(f, 2) &&
    contract_helpers::component_export_param_type_name_at(f, 0).eq("Point") &&
    contract_helpers::component_export_param_type_name_at(f, 1).eq("Point") &&
    contract_helpers::component_export_return_type_name(f).eq("Point")
}

fn component_fn_is_point_to_point(f: ComponentExportFunc) -> bool {
    contract_helpers::component_export_param_count_is(f, 1) &&
    contract_helpers::component_export_param_type_name_at(f, 0).eq("Point") &&
    contract_helpers::component_export_return_type_name(f).eq("Point")
}

