use std::text
use component::type_node
use component::wit_names

fn wit_type_from_ast(ty: ComponentTypeNode) -> String {
    if type_node::type_node_is_named_kind(ty) {
        return wit_named_type(type_node::type_node_text(ty))
    }
    if type_node::type_node_is_generic_kind(ty) {
        let name = type_node::type_node_text(ty)
        if eq(clone(name), "Vec") && type_node::type_node_child_count(ty) > 1 {
            return concat("list<", concat(wit_type_from_ast(type_node::type_node_child_at(ty, 1)), ">"))
        }
        if eq(clone(name), "Option") && type_node::type_node_child_count(ty) > 1 {
            return concat("option<", concat(wit_type_from_ast(type_node::type_node_child_at(ty, 1)), ">"))
        }
        if eq(clone(name), "Result") && type_node::type_node_child_count(ty) > 2 {
            return concat(
                "result<",
                concat(wit_type_from_ast(type_node::type_node_child_at(ty, 1)), concat(", ", concat(wit_type_from_ast(type_node::type_node_child_at(ty, 2)), ">")))
            )
        }
        if eq(clone(name), "Future") && type_node::type_node_child_count(ty) > 1 {
            return concat("future<", concat(wit_type_from_ast(type_node::type_node_child_at(ty, 1)), ">"))
        }
        if eq(clone(name), "Stream") && type_node::type_node_child_count(ty) > 1 {
            return concat("stream<", concat(wit_type_from_ast(type_node::type_node_child_at(ty, 1)), ">"))
        }
        return wit_names::wit_type_name(name)
    }
    if type_node::type_node_is_tuple_kind(ty) {
        let mut out = "tuple<"
        let mut i = 0
        while i < type_node::type_node_child_count(ty) {
            if i > 0 {
                out = text::builder_append(out, ", ")
            }
            out = text::builder_append(out, wit_type_from_ast(type_node::type_node_child_at(ty, i)))
            i = i + 1
        }
        return concat(out, ">")
    }
    "s32"
}

fn wit_named_type(name: String) -> String {
    if eq(clone(name), "i32") {
        return "s32"
    }
    if eq(clone(name), "i64") {
        return "s64"
    }
    if eq(clone(name), "f32") {
        return "f32"
    }
    if eq(clone(name), "f64") {
        return "f64"
    }
    if eq(clone(name), "bool") {
        return "bool"
    }
    if eq(clone(name), "char") {
        return "char"
    }
    if eq(clone(name), "u8") {
        return "u8"
    }
    if eq(clone(name), "u16") {
        return "u16"
    }
    if eq(clone(name), "u32") {
        return "u32"
    }
    if eq(clone(name), "u64") {
        return "u64"
    }
    if eq(clone(name), "i8") {
        return "s8"
    }
    if eq(clone(name), "i16") {
        return "s16"
    }
    if eq(clone(name), "String") || eq(clone(name), "string") {
        return "string"
    }
    wit_names::wit_type_name(name)
}
