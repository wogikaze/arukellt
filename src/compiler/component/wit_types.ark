use std::text
use component::type_node
use component::wit_names
fn component_wit_type_to_text(ty: ComponentTypeNode) -> String {
    let child_count = type_node::type_node_child_count(ty)
    if type_node::type_node_is_named_kind(ty) {
        return wit_named_type(type_node::type_node_text(ty))
    }
    if type_node::type_node_is_generic_kind(ty) {
        let name = type_node::type_node_text(ty)
        if name.clone().eq("Vec") && child_count > 1 {
            let child_type = component_wit_type_to_text(type_node::type_node_child_at(ty, 1))
            return "list<".concat(child_type.concat(">"))
        }
        if name.clone().eq("Option") && child_count > 1 {
            let child_type = component_wit_type_to_text(type_node::type_node_child_at(ty, 1))
            return "option<".concat(child_type.concat(">"))
        }
        if name.clone().eq("Result") && child_count > 2 {
            let ok_type = component_wit_type_to_text(type_node::type_node_child_at(ty, 1))
            let error_type = component_wit_type_to_text(type_node::type_node_child_at(ty, 2))
            return "result<".concat(ok_type.concat(", ".concat(error_type.concat(">"))))
        }
        if name.clone().eq("Future") && child_count > 1 {
            return "future<".concat(component_wit_type_to_text(type_node::type_node_child_at(ty, 1)).concat(">"))
        }
        if name.clone().eq("Stream") && child_count > 1 {
            return "stream<".concat(component_wit_type_to_text(type_node::type_node_child_at(ty, 1)).concat(">"))
        }
        return wit_names::wit_type_name(name)
    }
    if type_node::type_node_is_tuple_kind(ty) {
        let mut out = "tuple<"
        let mut i = 0
        while i < child_count {
            if i > 0 {
                out = out.concat(", ")
            }
            let child_type = component_wit_type_to_text(type_node::type_node_child_at(ty, i))
            out = out.concat(child_type)
            i = i + 1
        }
        return out.concat(">")
    }
    "s32"
}

fn wit_named_type(name: String) -> String {
    if name.clone().eq("i32") {
        return "s32"
    }
    if name.clone().eq("i64") {
        return "s64"
    }
    if name.clone().eq("f32") {
        return "f32"
    }
    if name.clone().eq("f64") {
        return "f64"
    }
    if name.clone().eq("bool") {
        return "bool"
    }
    if name.clone().eq("char") {
        return "char"
    }
    if name.clone().eq("u8") {
        return "u8"
    }
    if name.clone().eq("u16") {
        return "u16"
    }
    if name.clone().eq("u32") {
        return "u32"
    }
    if name.clone().eq("u64") {
        return "u64"
    }
    if name.clone().eq("i8") {
        return "s8"
    }
    if name.clone().eq("i16") {
        return "s16"
    }
    if name.clone().eq("String") || name.clone().eq("string") {
        return "string"
    }
    wit_names::wit_type_name(name)
}
