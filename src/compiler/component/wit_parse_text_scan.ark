// Compiler-specific WIT text view helpers. Low-level scanning lives in std::wit (#706).

use std::wit::scan

fn wit_find_char_from(s: String, ch: i32, from: i32) -> i32 {
    scan::wit_find_char(s, ch, from)
}

fn wit_trim_txt(s: String) -> String {
    scan::wit_trim(s)
}

fn wit_strip_version_txt(pkg: String) -> String {
    scan::wit_strip_version(pkg)
}

fn wit_before_colon_txt(s: String) -> String {
    scan::wit_before_colon(s)
}

fn wit_split_param_txt(param: String) -> String {
    scan::wit_split_param(param)
}

fn wit_split_csv_items_txt(inner: String) -> Vec<String> {
    scan::wit_split_csv_items(inner)
}

fn wit_extract_package(text: String) -> String {
    let mark = index_of(text, "package ")
    if mark < 0 {
        return String_new()
    }
    let semi = scan::wit_find_char(text, 59, mark + 8)
    if semi < 0 {
        return String_new()
    }
    scan::wit_strip_version(scan::wit_trim(substring(text, mark + 8, semi)))
}

fn wit_extract_interface_name(text: String) -> String {
    let mark = index_of(text, "interface ")
    if mark < 0 {
        return String_new()
    }
    let brace = scan::wit_find_char(text, 123, mark + 10)
    if brace < 0 {
        return String_new()
    }
    scan::wit_trim(substring(text, mark + 10, brace))
}

fn wit_extract_interface_body(text: String) -> String {
    let mark = index_of(text, "interface ")
    if mark < 0 {
        return String_new()
    }
    let open = scan::wit_find_char(text, 123, mark)
    if open < 0 {
        return String_new()
    }
    let mut depth = 0
    let mut i = open
    let n = len(text)
    while i < n {
        let ch = char_at(text, i)
        if ch == 123 {
            depth = depth + 1
        }
        if ch == 125 {
            depth = depth - 1
            if depth == 0 {
                return substring(text, open + 1, i)
            }
        }
        i = i + 1
    }
    String_new()
}

fn wit_line_start_txt(text: String, pos: i32) -> i32 {
    scan::wit_line_start(text, pos)
}

fn wit_line_end_txt(text: String, pos: i32) -> i32 {
    scan::wit_line_end(text, pos)
}
