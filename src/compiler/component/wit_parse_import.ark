// WIT import document parser — std::wit AST to compiler metadata (#653, #706).

use std::host::fs
use std::wit::parser
use component::wit_names_import
use component::wit_parse_text
use component::wit_parse_text_scan

fn wit_parse_has_surface(doc: wit_parse_text::WitParsedInterface) -> bool {
    len(doc.package) > 0 && len(doc.interface) > 0
}

fn wit_import_serialized_records(text: String) -> Vec<String> {
    let records = Vec::new<String>()
    let mut start = 0
    let mut i = 0
    let n = len(text)
    while i < n {
        if char_at(text, i) == 59 {
            if i > start {
                push(records, substring(text, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        push(records, substring(text, start, n))
    }
    records
}

fn wit_import_serialized_fields(record: String) -> Vec<String> {
    let fields = Vec::new<String>()
    let mut start = 0
    let mut i = 0
    let n = len(record)
    while i < n {
        if char_at(record, i) == 124 {
            push(fields, substring(record, start, i))
            start = i + 1
        }
        i = i + 1
    }
    push(fields, substring(record, start, n))
    fields
}

fn wit_import_serialized_list(text: String) -> Vec<String> {
    let values = Vec::new<String>()
    if len(text) == 0 {
        return values
    }
    let mut start = 0
    let mut i = 0
    let n = len(text)
    while i < n {
        if char_at(text, i) == 126 {
            push(values, substring(text, start, i))
            start = i + 1
        }
        i = i + 1
    }
    push(values, substring(text, start, n))
    values
}

fn wit_import_serialized_doc(serialized: String) -> wit_parse_text::WitParsedInterface {
    let records = wit_import_serialized_records(serialized)
    if len(records) == 0 {
        return wit_parse_text::WitParsedInterface_empty()
    }
    let header = wit_import_serialized_fields(get_unchecked(records, 0))
    if len(header) < 4 || !eq(get_unchecked(header, 0), "header") {
        return wit_parse_text::WitParsedInterface_empty()
    }

    let funcs = Vec::new<WitParsedFunc>()
    let records_out = Vec::new<WitParsedRecord>()
    let enums = Vec::new<WitParsedEnum>()
    let variants = Vec::new<WitParsedVariant>()
    let mut i = 1
    while i < len(records) {
        let fields = wit_import_serialized_fields(get_unchecked(records, i))
        if len(fields) >= 2 {
            let kind = get_unchecked(fields, 0)
            let name = get_unchecked(fields, 1)
            if eq(kind, "func") && len(fields) >= 4 {
                let params = wit_import_serialized_list(get_unchecked(fields, 2))
                let result = get_unchecked(fields, 3)
                push(funcs, wit_parse_text::WitParsedFunc_new(
                        clone(name),
                        wit_names_import::wit_import_func_name(name),
                        params,
                        result
                    ))
            } else if eq(kind, "record") && len(fields) >= 4 {
                let field_names = wit_import_serialized_list(get_unchecked(fields, 2))
                let field_types = wit_import_serialized_list(get_unchecked(fields, 3))
                push(records_out, wit_parse_text::WitParsedRecord_new(
                        clone(name),
                        wit_names_import::wit_record_type_name(name),
                        field_names,
                        field_types
                    ))
            } else if eq(kind, "enum") && len(fields) >= 3 {
                let variant_names = wit_import_serialized_list(get_unchecked(fields, 2))
                let variant_ark_names = Vec::new<String>()
                for vi in 0..len(variant_names) {
                    push(variant_ark_names, wit_names_import::wit_enum_variant_name(get_unchecked(variant_names, vi)))
                }
                push(enums, wit_parse_text::WitParsedEnum_new(
                        clone(name),
                        wit_names_import::wit_enum_type_name(name),
                        variant_names,
                        variant_ark_names
                    ))
            } else if eq(kind, "variant") && len(fields) >= 4 {
                let case_names = wit_import_serialized_list(get_unchecked(fields, 2))
                let payload_types = wit_import_serialized_list(get_unchecked(fields, 3))
                let case_ark_names = Vec::new<String>()
                for ci in 0..len(case_names) {
                    push(case_ark_names, wit_names_import::wit_enum_variant_name(get_unchecked(case_names, ci)))
                }
                push(variants, wit_parse_text::WitParsedVariant_new(
                        clone(name),
                        wit_names_import::wit_enum_type_name(name),
                        case_names,
                        case_ark_names,
                        payload_types
                    ))
            }
        }
        i = i + 1
    }
    let mut doc = wit_parse_text::WitParsedInterface_new(
        get_unchecked(header, 1),
        get_unchecked(header, 3),
        funcs,
        records_out,
        enums
    )
    doc.package_version = get_unchecked(header, 2)
    doc.variants = variants
    doc
}

fn parse_wit_import_text(source: String) -> wit_parse_text::WitParsedInterface {
    // `std::wit::parser::parse_full` is the canonical parser. The parser's
    // import-text helper calls it once and seals the recursive AST as String
    // metadata before this compiler layer decodes it.
    let serialized = parser::parse_full_import_text(source)
    let doc = wit_import_serialized_doc(serialized)
    if !wit_parse_has_surface(doc) {
        return wit_parse_text::WitParsedInterface_empty()
    }
    doc
}

fn parse_wit_import_file(path: String) -> wit_parse_text::WitParsedInterface {
    match fs::read_to_string(clone(path)) {
        Result::Ok(source) => parse_wit_import_text(source),
        Result::Err(_) => wit_parse_text::WitParsedInterface_empty(),
    }
}

fn wit_import_id_matches(package_id: String, doc: wit_parse_text::WitParsedInterface) -> bool {
    if len(doc.package) == 0 || len(doc.interface) == 0 {
        return false
    }
    let slash = index_of(clone(package_id), "/")
    if slash < 0 {
        return false
    }
    let want_pkg = wit_parse_text_scan::wit_strip_version_txt(substring(package_id, 0, slash))
    let want_iface = wit_strip_import_iface(substring(package_id, slash + 1, len(package_id)))
    eq(clone(doc.package), clone(want_pkg)) && eq(clone(doc.interface), clone(want_iface))
}

fn wit_strip_import_iface(name: String) -> String {
    let at = index_of(clone(name), "@")
    if at < 0 {
        return clone(name)
    }
    substring(name, 0, at)
}
