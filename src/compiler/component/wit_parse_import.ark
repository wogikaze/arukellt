// WIT import document parser — std::wit AST to compiler metadata (#653, #706).

use std::host::fs::Fs
use std::wit::ast
use compiler::wit_identity
use component::wit_names_import
use component::wit_parse_text

fn wit_parse_has_surface(doc: wit_parse_text::WitParsedInterface) -> bool {
    len(doc.package) > 0 && len(doc.interface) > 0
}

fn wit_import_serialized_records(text: String) -> Vec<String> {
    let mut records = Vec::new<String>()
    let mut start = 0
    let mut i = 0
    let n = len(text)
    while i < n {
        if text.byte_at(i) == 59 {
            if i > start {
                push(records, text.slice(start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        push(records, text.slice(start, n))
    }
    records
}

fn wit_import_serialized_fields(record: String) -> Vec<String> {
    let mut fields = Vec::new<String>()
    let mut start = 0
    let mut i = 0
    let n = len(record)
    while i < n {
        if record.byte_at(i) == 124 {
            push(fields, record.slice(start, i))
            start = i + 1
        }
        i = i + 1
    }
    push(fields, record.slice(start, n))
    fields
}

fn wit_import_serialized_list(text: String) -> Vec<String> {
    let mut values = Vec::new<String>()
    if len(text) == 0 {
        return values
    }
    let mut start = 0
    let mut i = 0
    let n = len(text)
    while i < n {
        if text.byte_at(i) == 126 {
            push(values, text.slice(start, i))
            start = i + 1
        }
        i = i + 1
    }
    push(values, text.slice(start, n))
    values
}

fn wit_import_serialized_doc(serialized: String) -> WitParsedInterface {
    let records = wit_import_serialized_records(serialized)
    if len(records) == 0 {
        return wit_parse_text::WitParsedInterface_empty()
    }
    let header = wit_import_serialized_fields(get_unchecked(records, 0))
    if len(header) < 4 || !get_unchecked(header, 0).eq("header") {
        return wit_parse_text::WitParsedInterface_empty()
    }

    let mut funcs = Vec::new<WitParsedFunc>()
    let mut records_out = Vec::new<WitParsedRecord>()
    let mut enums = Vec::new<WitParsedEnum>()
    let mut variants = Vec::new<WitParsedVariant>()
    let mut i = 1
    while i < len(records) {
        let fields = wit_import_serialized_fields(get_unchecked(records, i))
        if len(fields) >= 2 {
            let kind = get_unchecked(fields, 0)
            let name = get_unchecked(fields, 1)
            if kind.eq("func") && len(fields) >= 4 {
                let params = wit_import_serialized_list(get_unchecked(fields, 2))
                let result = get_unchecked(fields, 3)
                push(funcs, wit_parse_text::WitParsedFunc_new(
                        name.clone(),
                        wit_names_import::wit_import_func_name(name),
                        params,
                        result
                    ))
            } else if kind.eq("record") && len(fields) >= 4 {
                let field_names = wit_import_serialized_list(get_unchecked(fields, 2))
                let field_types = wit_import_serialized_list(get_unchecked(fields, 3))
                push(records_out, wit_parse_text::WitParsedRecord_new(
                        name.clone(),
                        wit_names_import::wit_record_type_name(name),
                        field_names,
                        field_types
                    ))
            } else if kind.eq("enum") && len(fields) >= 3 {
                let variant_names = wit_import_serialized_list(get_unchecked(fields, 2))
                let mut variant_ark_names = Vec::new<String>()
                for vi in 0..len(variant_names) {
                    push(variant_ark_names, wit_names_import::wit_enum_variant_name(get_unchecked(variant_names, vi)))
                }
                push(enums, wit_parse_text::WitParsedEnum_new(
                        name.clone(),
                        wit_names_import::wit_enum_type_name(name),
                        variant_names,
                        variant_ark_names
                    ))
            } else if kind.eq("variant") && len(fields) >= 4 {
                let case_names = wit_import_serialized_list(get_unchecked(fields, 2))
                let payload_types = wit_import_serialized_list(get_unchecked(fields, 3))
                let mut case_ark_names = Vec::new<String>()
                for ci in 0..len(case_names) {
                    push(case_ark_names, wit_names_import::wit_enum_variant_name(get_unchecked(case_names, ci)))
                }
                push(variants, wit_parse_text::WitParsedVariant_new(
                        name.clone(),
                        wit_names_import::wit_enum_type_name(name),
                        case_names,
                        case_ark_names,
                        payload_types
                    ))
            }
        }
        i = i + 1
    }
    let mut doc = wit_parse_text::WitParsedInterface_new(
        get_unchecked(header, 1),
        get_unchecked(header, 3),
        funcs,
        records_out,
        enums
    )
    doc.package_version = get_unchecked(header, 2)
    doc.variants = variants
    doc
}

fn parse_wit_import_text(source: String) -> WitParsedInterface {
    // `WitNode::import_metadata` is the canonical parser adapter. It runs the
    // full WIT 1.0 parser once and seals the recursive AST as String metadata
    // before this compiler layer decodes it.
    let serialized = ast::WitNode::import_metadata(source)
    let doc = wit_import_serialized_doc(serialized)
    if !wit_parse_has_surface(doc) {
        return wit_parse_text::WitParsedInterface_empty()
    }
    doc
}

fn parse_wit_import_file(path: String) -> WitParsedInterface {
    match Fs::read_to_string(path.clone()) {
        Result::Ok(source) => parse_wit_import_text(source),
        Result::Err(_) => wit_parse_text::WitParsedInterface_empty(),
    }
}

fn wit_import_id_matches(package_id: String, doc: wit_parse_text::WitParsedInterface) -> bool {
    if len(doc.package) == 0 || len(doc.interface) == 0 {
        return false
    }
    if len(wit_identity::wit_identifier_error(package_id.clone())) > 0 {
        return false
    }
    let want_pkg = wit_identity::wit_identifier_package(package_id.clone())
    let want_iface = wit_identity::wit_identifier_interface(package_id.clone())
    if !doc.package.clone().eq(want_pkg.clone()) || !doc.interface.clone().eq(want_iface.clone()) {
        return false
    }
    let want_version = wit_identity::wit_identifier_version(package_id.clone())
    if len(want_version) == 0 {
        return true
    }
    doc.package_version.clone().eq(want_version.clone())
}
