use component::wit_parse_flags
use component
fn issue651_flags_parse_self_check() -> bool {
    let members = wit_parse_flags::wit_flags_member_names("flags { read, write }")
    if members.len() != 2 {
        return false
    }
    if !get_unchecked(members, 0).eq("read") {
        return false
    }
    if !get_unchecked(members, 1).eq("write") {
        return false
    }
    let doc = component::parse_wit_import_file("tests/fixtures/component/import_flags_type.wit")
    if !doc.package.clone().eq("test:host") {
        return false
    }
    if !doc.interface.clone().eq("host") {
        return false
    }
    if doc.funcs.len() != 1 {
        return false
    }
    let func = get_unchecked(doc.funcs, 0)
    if !func.wit_name.clone().eq("set-perms") {
        return false
    }
    if !func.ark_name.clone().eq("set_perms") {
        return false
    }
    if func.param_wit_types.len() != 1 {
        return false
    }
    wit_parse_flags::wit_is_flags_type(get_unchecked(func.param_wit_types, 0))
}
