use component::export_function_view
use component::export_shapes_string_predicates
use component::naming
use mir::module_functions

// Names only. A Vec of a compiler-internal record here used to leftover-type
// the `mir` local as that vec and emit `unreachable` at function entry.
struct StringGeneralPlan {
    names: Vec<String>,
}

fn StringGeneralPlan_new(names: Vec<String>) -> StringGeneralPlan {
    StringGeneralPlan { names: names }
}

fn StringGeneralPlan_empty() -> StringGeneralPlan {
    StringGeneralPlan_new(Vec::new<String>())
}

fn StringGeneralPlan_count(plan: StringGeneralPlan) -> i32 {
    len(plan.names)
}

fn StringGeneralPlan_name_at(plan: StringGeneralPlan, idx: i32) -> String {
    get_unchecked(plan.names, idx)
}

fn comp_string_general_exports_match(mir: MirModule) -> bool {
    let mut export_count = 0
    let n = module_functions::MirModule_function_count(mir)
    let mut i = 0
    while i < n {
        let f = module_functions::MirModule_function_at(mir, i)
        let export_name = export_function_view::export_function_name(f)
        if naming::comp_should_export_func(clone(export_name)) {
            export_count = export_count + 1
            if !export_shapes_string_predicates::comp_function_is_string_unary_export(f) {
                return false
            }
        }
        i = i + 1
    }
    export_count >= 2
}

fn comp_string_general_plan(mir: MirModule) -> StringGeneralPlan {
    if !comp_string_general_exports_match(mir) {
        return StringGeneralPlan_empty()
    }
    let names: Vec<String> = Vec::new<String>()
    let n = module_functions::MirModule_function_count(mir)
    let mut i = 0
    while i < n {
        let f = module_functions::MirModule_function_at(mir, i)
        let export_name = export_function_view::export_function_name(f)
        if naming::comp_should_export_func(clone(export_name)) {
            push(names, export_name)
        }
        i = i + 1
    }
    StringGeneralPlan_new(names)
}

fn comp_string_general_plan_is_valid(plan: StringGeneralPlan) -> bool {
    StringGeneralPlan_count(plan) >= 2
}
