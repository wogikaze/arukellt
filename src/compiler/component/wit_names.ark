// WIT export/type kebab mangling. Same-file implementation: host DCE drops
// `std::wit::names::kebab_name` edges in a full compiler compile.

use std::text
use std::prelude::{eq}
fn wit_kebab_name(name: String) -> String {
    let mut out = String_from("")
    let n = len(name)
    let mut i = 0
    while i < n {
        let ch = name.byte_at(i)
        if ch == 95 {
            out = out.concat(String_from("-"))
        } else if ch >= 65 && ch <= 90 {
            if len(out) > 0 {
                let prev = out.byte_at(len(out) - 1)
                if prev != 45 {
                    out = out.concat(String_from("-"))
                }
            }
            out = out.concat(char_to_string(ch + 32))
        } else if ch == 45 {
            out = out.concat(String_from("-"))
        } else {
            out = out.concat(name.slice(i, i + 1))
        }
        i = i + 1
    }
    out
}

fn wit_export_name(name: String) -> String {
    wit_kebab_name(name)
}

fn wit_type_name(name: String) -> String {
    let kebab = wit_kebab_name(name)
    if wit_type_name_is_reserved(kebab.clone()) {
        return String_from("ark-").concat(kebab)
    }
    kebab
}

fn wit_type_name_is_reserved(name: String) -> bool {
    eq(name.clone(), "bool") ||
    eq(name.clone(), "u8") ||
    eq(name.clone(), "s8") ||
    eq(name.clone(), "u16") ||
    eq(name.clone(), "s16") ||
    eq(name.clone(), "u32") ||
    eq(name.clone(), "s32") ||
    eq(name.clone(), "u64") ||
    eq(name.clone(), "s64") ||
    eq(name.clone(), "u128") ||
    eq(name.clone(), "s128") ||
    eq(name.clone(), "float32") ||
    eq(name.clone(), "float64") ||
    eq(name.clone(), "char") ||
    eq(name.clone(), "string") ||
    eq(name.clone(), "list") ||
    eq(name.clone(), "option") ||
    eq(name.clone(), "result") ||
    eq(name.clone(), "tuple") ||
    eq(name.clone(), "resource") ||
    eq(name.clone(), "record") ||
    eq(name.clone(), "variant") ||
    eq(name.clone(), "enum") ||
    eq(name.clone(), "flags") ||
    eq(name.clone(), "type") ||
    eq(name.clone(), "interface") ||
    eq(name.clone(), "world") ||
    eq(name.clone(), "use") ||
    eq(name.clone(), "include") ||
    eq(name.clone(), "import") ||
    eq(name.clone(), "export") ||
    eq(name.clone(), "package") ||
    eq(name.clone(), "constructor") ||
    eq(name.clone(), "func") ||
    eq(name.clone(), "async") ||
    eq(name.clone(), "stream") ||
    eq(name.clone(), "future") ||
    eq(name.clone(), "own") ||
    eq(name.clone(), "borrow") ||
    eq(name.clone(), "static")
}
