// WIT export/type kebab mangling. Same-file implementation: host DCE drops
// `std::wit::names::kebab_name` edges in a full compiler compile.

use std::text
fn wit_kebab_name(name: String) -> String {
    let mut out = String_from("")
    let n = name.len()
    let mut i = 0
    while i < n {
        let ch = name.byte_at(i)
        if ch == 95 {
            out = out.concat(String_from("-"))
        } else if ch >= 65 && ch <= 90 {
            if out.len() > 0 {
                let prev = out.byte_at(out.len() - 1)
                if prev != 45 {
                    out = out.concat(String_from("-"))
                }
            }
            out = out.concat(char_to_string(ch + 32))
        } else if ch == 45 {
            out = out.concat(String_from("-"))
        } else {
            out = out.concat(name.slice(i, i + 1))
        }
        i = i + 1
    }
    out
}

fn wit_export_name(name: String) -> String {
    wit_kebab_name(name)
}

fn wit_type_name(name: String) -> String {
    let kebab = wit_kebab_name(name)
    if wit_type_name_is_reserved(kebab.clone()) {
        return String_from("ark-").concat(kebab)
    }
    kebab
}

fn wit_type_name_is_reserved(name: String) -> bool {
    name.clone().eq("bool") ||
    name.clone().eq("u8") ||
    name.clone().eq("s8") ||
    name.clone().eq("u16") ||
    name.clone().eq("s16") ||
    name.clone().eq("u32") ||
    name.clone().eq("s32") ||
    name.clone().eq("u64") ||
    name.clone().eq("s64") ||
    name.clone().eq("u128") ||
    name.clone().eq("s128") ||
    name.clone().eq("float32") ||
    name.clone().eq("float64") ||
    name.clone().eq("char") ||
    name.clone().eq("string") ||
    name.clone().eq("list") ||
    name.clone().eq("option") ||
    name.clone().eq("result") ||
    name.clone().eq("tuple") ||
    name.clone().eq("resource") ||
    name.clone().eq("record") ||
    name.clone().eq("variant") ||
    name.clone().eq("enum") ||
    name.clone().eq("flags") ||
    name.clone().eq("type") ||
    name.clone().eq("interface") ||
    name.clone().eq("world") ||
    name.clone().eq("use") ||
    name.clone().eq("include") ||
    name.clone().eq("import") ||
    name.clone().eq("export") ||
    name.clone().eq("package") ||
    name.clone().eq("constructor") ||
    name.clone().eq("func") ||
    name.clone().eq("async") ||
    name.clone().eq("stream") ||
    name.clone().eq("future") ||
    name.clone().eq("own") ||
    name.clone().eq("borrow") ||
    name.clone().eq("static")
}
