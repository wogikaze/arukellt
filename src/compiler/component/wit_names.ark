// WIT export/type kebab mangling. Same-file implementation: host DCE drops
// `std::wit::names::kebab_name` edges in a full compiler compile.

use std::text

fn wit_kebab_name(name: String) -> String {
    let mut out = String_from("")
    let n = len(name)
    let mut i = 0
    while i < n {
        let ch = char_at(name, i)
        if ch == 95 {
            out = text::builder_append(out, String_from("-"))
        } else if ch >= 65 && ch <= 90 {
            if len(out) > 0 {
                let prev = char_at(out, len(out) - 1)
                if prev != 45 {
                    out = text::builder_append(out, String_from("-"))
                }
            }
            out = text::builder_append(out, char_to_string(ch + 32))
        } else if ch == 45 {
            out = text::builder_append(out, String_from("-"))
        } else {
            out = text::builder_append(out, substring(name, i, i + 1))
        }
        i = i + 1
    }
    out
}

fn wit_export_name(name: String) -> String {
    wit_kebab_name(name)
}

fn wit_type_name(name: String) -> String {
    let kebab = wit_kebab_name(name)
    if wit_type_name_is_reserved(clone(kebab)) {
        return concat(String_from("ark-"), kebab)
    }
    kebab
}

fn wit_type_name_is_reserved(name: String) -> bool {
    eq(clone(name), "bool") ||
    eq(clone(name), "u8") ||
    eq(clone(name), "s8") ||
    eq(clone(name), "u16") ||
    eq(clone(name), "s16") ||
    eq(clone(name), "u32") ||
    eq(clone(name), "s32") ||
    eq(clone(name), "u64") ||
    eq(clone(name), "s64") ||
    eq(clone(name), "u128") ||
    eq(clone(name), "s128") ||
    eq(clone(name), "float32") ||
    eq(clone(name), "float64") ||
    eq(clone(name), "char") ||
    eq(clone(name), "string") ||
    eq(clone(name), "list") ||
    eq(clone(name), "option") ||
    eq(clone(name), "result") ||
    eq(clone(name), "tuple") ||
    eq(clone(name), "resource") ||
    eq(clone(name), "record") ||
    eq(clone(name), "variant") ||
    eq(clone(name), "enum") ||
    eq(clone(name), "flags") ||
    eq(clone(name), "type") ||
    eq(clone(name), "interface") ||
    eq(clone(name), "world") ||
    eq(clone(name), "use") ||
    eq(clone(name), "include") ||
    eq(clone(name), "import") ||
    eq(clone(name), "export") ||
    eq(clone(name), "package") ||
    eq(clone(name), "constructor") ||
    eq(clone(name), "func") ||
    eq(clone(name), "async") ||
    eq(clone(name), "stream") ||
    eq(clone(name), "future") ||
    eq(clone(name), "own") ||
    eq(clone(name), "borrow") ||
    eq(clone(name), "static")
}
