use std::text
use component::type_node
use component::wit_decl
use component::wit_names
use component::wit_types
fn emit_wit_type_defs(decls: Vec<AstNode>) -> String {
    let mut out = ""
    for i in 0..decls.len() {
        let d = wit_decl::wit_decl_from_node(decls.get_unchecked(i))
        // Generic decls (Pair<T>) have no WIT record/enum equivalent;
        // emitting their unsubstituted fields produces undeclared types.
        // A nested guard is used instead of continue: for-loop continue
        // support depends on the building compiler's lowering, and the
        // pinned bootstrap predates the index-loop continue fix.
        if !wit_decl::wit_decl_is_generic(d) {
            if wit_decl::wit_decl_is_record(d) {
                out = out.concat(emit_wit_record_type_def(d))
            }
            if wit_decl::wit_decl_is_resource(d) {
                out = out.concat(emit_wit_resource_type_def(d))
            }
            if wit_decl::wit_decl_is_enum(d) {
                out = out.concat(emit_wit_enum_type_def(d))
            }
            if component_decl_is_perms_flags_shape(decls.get_unchecked(i)) {
                out = out.concat(emit_wit_flags_type_def(decls.get_unchecked(i)))
            }
        }
    }
    out
}

fn emit_wit_record_type_def(d: ComponentWitDecl) -> String {
    let mut out = "  record "
    out = out.concat(wit_names::wit_type_name(wit_decl::wit_decl_name(d)))
    out = out.concat(" {\n")
    let mut fi = 0
    while fi < wit_decl::wit_decl_member_count(d) {
        let field = wit_decl::wit_decl_member_at(d, fi)
        out = out.concat("    ")
        out = out.concat(wit_names::wit_export_name(wit_decl::wit_decl_member_name(field)))
        out = out.concat(": ")
        if wit_decl::wit_decl_member_has_type(field) {
            out = out.concat(wit_types::component_wit_type_to_text(wit_decl::wit_decl_member_type_view(field)))
        } else {
            out = out.concat("s32")
        }
        out = out.concat(",\n")
        fi = fi + 1
    }
    out.concat("  }\n\n")
}

fn emit_wit_resource_type_def(d: ComponentWitDecl) -> String {
    let mut out = "  resource "
    out = out.concat(wit_names::wit_type_name(wit_decl::wit_decl_name(d)))
    out = out.concat(" {\n")
    let mut fi = 0
    while fi < wit_decl::wit_decl_member_count(d) {
        let field = wit_decl::wit_decl_member_at(d, fi)
        out = out.concat("    ")
        out = out.concat(wit_names::wit_export_name(wit_decl::wit_decl_member_name(field)))
        out = out.concat(": ")
        if wit_decl::wit_decl_member_has_type(field) {
            out = out.concat(wit_types::component_wit_type_to_text(wit_decl::wit_decl_member_type_view(field)))
        } else {
            out = out.concat("s32")
        }
        out = out.concat(",\n")
        fi = fi + 1
    }
    out.concat("  }\n\n")
}

fn wit_export_flags_type_name() -> String {
    "perms"
}

fn wit_export_resource_type_name() -> String {
    "handle"
}

fn wit_export_own_handle_type() -> String {
    "own<".concat(wit_export_resource_type_name().concat(">"))
}

fn component_decl_is_perms_flags_shape(d: AstNode) -> bool {
    let decl = wit_decl::wit_decl_from_node(d)
    if !wit_decl::wit_decl_is_record(decl) {
        return false
    }
    if !wit_decl::wit_decl_name(decl).eq("Perms") {
        return false
    }
    if wit_decl::wit_decl_member_count(decl) != 2 {
        return false
    }
    let f0 = wit_decl::wit_decl_member_at(decl, 0)
    let f1 = wit_decl::wit_decl_member_at(decl, 1)
    wit_decl::wit_decl_member_name(f0).eq("read") &&
    wit_decl::wit_decl_member_name(f1).eq("write") &&
    wit_decl::wit_decl_member_has_type(f0) &&
    wit_decl::wit_decl_member_has_type(f1) &&
    type_node::type_node_is_named(wit_decl::wit_decl_member_type_view(f0), "bool") &&
    type_node::type_node_is_named(wit_decl::wit_decl_member_type_view(f1), "bool")
}

fn emit_wit_flags_type_def(d: AstNode) -> String {
    let decl = wit_decl::wit_decl_from_node(d)
    let mut out = "  flags "
    out = out.concat(wit_export_flags_type_name())
    out = out.concat(" {\n")
    let mut fi = 0
    while fi < wit_decl::wit_decl_member_count(decl) {
        out = out.concat("    ")
        out = out.concat(wit_names::wit_export_name(wit_decl::wit_decl_member_name(wit_decl::wit_decl_member_at(decl, fi))))
        out = out.concat(",\n")
        fi = fi + 1
    }
    out.concat("  }\n\n")
}

fn emit_wit_enum_type_def(d: ComponentWitDecl) -> String {
    let mut out = ""
    if wit_decl::wit_decl_enum_has_payloads(d) {
        out = out.concat("  variant ")
    } else {
        out = out.concat("  enum ")
    }
    out = out.concat(wit_names::wit_type_name(wit_decl::wit_decl_name(d)))
    out = out.concat(" {\n")
    let mut vi = 0
    while vi < wit_decl::wit_decl_member_count(d) {
        let variant = wit_decl::wit_decl_member_at(d, vi)
        out = out.concat("    ")
        out = out.concat(wit_names::wit_type_name(wit_decl::wit_decl_member_name(variant)))
        if wit_decl::wit_decl_member_has_type(variant) {
            out = out.concat("(")
            out = out.concat(wit_types::component_wit_type_to_text(wit_decl::wit_decl_member_type_view(variant)))
            out = out.concat(")")
        }
        out = out.concat(",\n")
        vi = vi + 1
    }
    out.concat("  }\n\n")
}
