// Compiler WIT AST-view facade — package/interface callable and binding surfaces (#663, #664, #672).

struct WitParsedFunc {
    wit_name: String,
    ark_name: String,
    param_wit_types: Vec<String>,
    ret_wit_type: String,
}

struct WitParsedRecord {
    wit_name: String,
    ark_name: String,
    field_names: Vec<String>,
    field_wit_types: Vec<String>,
}

struct WitParsedEnum {
    wit_name: String,
    ark_name: String,
    variant_wit_names: Vec<String>,
    variant_ark_names: Vec<String>,
}

struct WitParsedVariant {
    wit_name: String,
    ark_name: String,
    case_wit_names: Vec<String>,
    case_ark_names: Vec<String>,
    case_payload_wit_types: Vec<String>,
}

struct WitParsedInterface {
    package: String,
    package_version: String,
    interface: String,
    funcs: Vec<WitParsedFunc>,
    records: Vec<WitParsedRecord>,
    enums: Vec<WitParsedEnum>,
    variants: Vec<WitParsedVariant>,
}

fn WitParsedInterface_empty() -> WitParsedInterface {
    WitParsedInterface {
        package: String_new(),
        package_version: String_new(),
        interface: String_new(),
        funcs: Vec::new<WitParsedFunc>(),
        records: Vec::new<WitParsedRecord>(),
        enums: Vec::new<WitParsedEnum>(),
        variants: Vec::new<WitParsedVariant>(),
    }
}

// Keep the historical constructor signature for fixture helpers. Variants are populated
// by the text/AST facade after construction.
fn WitParsedInterface_new(package: String, interface: String, funcs: Vec<WitParsedFunc>, records: Vec<WitParsedRecord>, enums: Vec<WitParsedEnum>) -> WitParsedInterface {
    WitParsedInterface {
        package: package,
        package_version: String_new(),
        interface: interface,
        funcs: funcs,
        records: records,
        enums: enums,
        variants: Vec::new<WitParsedVariant>(),
    }
}

fn WitParsedInterface_funcs(doc: WitParsedInterface) -> Vec<WitParsedFunc> { doc.funcs }
fn WitParsedInterface_package_version(doc: WitParsedInterface) -> String { clone(doc.package_version) }
fn WitParsedInterface_records(doc: WitParsedInterface) -> Vec<WitParsedRecord> { doc.records }
fn WitParsedInterface_enums(doc: WitParsedInterface) -> Vec<WitParsedEnum> { doc.enums }
fn WitParsedInterface_variants(doc: WitParsedInterface) -> Vec<WitParsedVariant> { doc.variants }

fn WitParsedFunc_new(wit_name: String, ark_name: String, param_wit_types: Vec<String>, ret_wit_type: String) -> WitParsedFunc {
    WitParsedFunc { wit_name: wit_name, ark_name: ark_name, param_wit_types: param_wit_types, ret_wit_type: ret_wit_type }
}

fn WitParsedRecord_new(wit_name: String, ark_name: String, field_names: Vec<String>, field_wit_types: Vec<String>) -> WitParsedRecord {
    WitParsedRecord { wit_name: wit_name, ark_name: ark_name, field_names: field_names, field_wit_types: field_wit_types }
}

fn WitParsedEnum_new(wit_name: String, ark_name: String, variant_wit_names: Vec<String>, variant_ark_names: Vec<String>) -> WitParsedEnum {
    WitParsedEnum { wit_name: wit_name, ark_name: ark_name, variant_wit_names: variant_wit_names, variant_ark_names: variant_ark_names }
}

fn WitParsedVariant_new(wit_name: String, ark_name: String, case_wit_names: Vec<String>, case_ark_names: Vec<String>, case_payload_wit_types: Vec<String>) -> WitParsedVariant {
    WitParsedVariant {
        wit_name: wit_name,
        ark_name: ark_name,
        case_wit_names: case_wit_names,
        case_ark_names: case_ark_names,
        case_payload_wit_types: case_payload_wit_types,
    }
}
