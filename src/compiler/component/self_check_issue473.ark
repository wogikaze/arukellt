use component::wit_parse_import
use component::wit_parse_resource

fn issue473_resource_parse_self_check() -> bool {
    if !wit_parse_resource::wit_is_own_type("own<handle>") {
        return false
    }
    if !wit_parse_resource::wit_is_borrow_type("borrow<handle>") {
        return false
    }
    if !eq(wit_parse_resource::wit_own_inner_name("own<handle>"), "handle") {
        return false
    }
    let doc = wit_parse_import::parse_wit_import_file("tests/fixtures/component/import_resource_handle_type.wit")
    if !eq(clone(doc.package), "test:host") {
        return false
    }
    if !eq(clone(doc.interface), "handles") {
        return false
    }
    if len(doc.funcs) != 2 {
        return false
    }
    let take = get_unchecked(doc.funcs, 0)
    if !eq(clone(take.wit_name), "take") {
        return false
    }
    if len(take.param_wit_types) != 1 {
        return false
    }
    if !wit_parse_resource::wit_is_own_type(get_unchecked(take.param_wit_types, 0)) {
        return false
    }
    let peek = get_unchecked(doc.funcs, 1)
    if !eq(clone(peek.wit_name), "peek") {
        return false
    }
    if len(peek.param_wit_types) != 1 {
        return false
    }
    wit_parse_resource::wit_is_borrow_type(get_unchecked(peek.param_wit_types, 0))
}
