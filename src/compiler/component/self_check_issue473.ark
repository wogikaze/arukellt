use component
use component::wit_parse_resource
fn issue473_resource_parse_self_check() -> bool {
    if !wit_parse_resource::wit_is_own_type("own<handle>") {
        return false
    }
    if !wit_parse_resource::wit_is_borrow_type("borrow<handle>") {
        return false
    }
    if !wit_parse_resource::wit_own_inner_name("own<handle>").eq("handle") {
        return false
    }
    let doc = component::parse_wit_import_file("tests/fixtures/component/import_resource_handle_type.wit")
    if !doc.package.clone().eq("test:host") {
        return false
    }
    if !doc.interface.clone().eq("handles") {
        return false
    }
    if doc.funcs.len() != 2 {
        return false
    }
    let take = doc.funcs.get_unchecked(0)
    if !take.wit_name.clone().eq("take") {
        return false
    }
    if take.param_wit_types.len() != 1 {
        return false
    }
    if !wit_parse_resource::wit_is_own_type(take.param_wit_types.get_unchecked(0)) {
        return false
    }
    let peek = doc.funcs.get_unchecked(1)
    if !peek.wit_name.clone().eq("peek") {
        return false
    }
    if peek.param_wit_types.len() != 1 {
        return false
    }
    wit_parse_resource::wit_is_borrow_type(peek.param_wit_types.get_unchecked(0))
}
