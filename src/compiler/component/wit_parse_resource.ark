// WIT resource / own / borrow type parsing helpers (#473).

use std::text
fn wit_trim_ws(text: String) -> String {
    let n = text.len()
    let mut start = 0
    while start < n {
        let ch = text.byte_at(start)
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        start = start + 1
    }
    let mut end = n
    while end > start {
        let ch = text.byte_at(end - 1)
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        end = end - 1
    }
    text.slice(start, end)
}

fn wit_is_resource_decl(text: String) -> bool {
    wit_trim_ws(text).starts_with("resource ")
}

fn wit_is_own_type(text: String) -> bool {
    wit_trim_ws(text).starts_with("own<")
}

fn wit_is_borrow_type(text: String) -> bool {
    wit_trim_ws(text).starts_with("borrow<")
}

fn wit_own_inner_name(text: String) -> String {
    let open = text.index_of("<")
    let close = text.index_of(">")
    if open < 0 || close <= open {
        return String_new()
    }
    wit_trim_ws(text.slice(open + 1, close))
}

fn wit_borrow_inner_name(text: String) -> String {
    wit_own_inner_name(text)
}

fn wit_own_type_text(resource_name: String) -> String {
    "own<".concat(resource_name.concat(">"))
}

fn wit_borrow_type_text(resource_name: String) -> String {
    "borrow<".concat(resource_name.concat(">"))
}
