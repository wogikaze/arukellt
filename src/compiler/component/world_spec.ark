use std::text
use component::constants_world_spec
fn world_spec_kind(world: String) -> i32 {
    if world.clone().eq("wasi:cli/command") { return constants_world_spec::WORLD_KIND_CLI_COMMAND() }
    constants_world_spec::WORLD_KIND_NONE()
}

fn world_spec_is_cli_command(world: String) -> bool {
    world_spec_kind(world.clone()) == constants_world_spec::WORLD_KIND_CLI_COMMAND()
}

fn world_spec_world_name(world: String) -> String {
    let kind = world_spec_kind(world.clone())
    if kind == constants_world_spec::WORLD_KIND_CLI_COMMAND() { return "command" }
    "arukellt"
}

fn world_spec_parse_error(world: String) -> String {
    if world.len() == 0 { return String_new() }
    if world_spec_kind(world.clone()) != constants_world_spec::WORLD_KIND_NONE() { return String_new() }
    "unknown world `".concat(world.clone().concat("` (supported: wasi:cli/command)"))
}

fn world_spec_emit_use_block(world: String) -> String {
    let kind = world_spec_kind(world.clone())
    let mut out = String_new()
    if kind == constants_world_spec::WORLD_KIND_CLI_COMMAND() {
        out = out.concat(world_spec_wasi_imports())
        return out
    }
    world_spec_wasi_imports()
}

fn world_spec_wasi_imports() -> String {
    // The generated library world describes the interfaces used by the core
    // module. Keeping these imports in the WIT world lets wasm-tools perform
    // the official P2 lift without a repository-owned adapter.
    let mut out = "    import wasi:cli/environment@0.2.0;\n"
    out = out.concat("    import wasi:cli/exit@0.2.0;\n")
    out = out.concat("    import wasi:io/error@0.2.0;\n")
    out = out.concat("    import wasi:io/streams@0.2.0;\n")
    out = out.concat("    import wasi:cli/stdin@0.2.0;\n")
    out = out.concat("    import wasi:cli/stdout@0.2.0;\n")
    out = out.concat("    import wasi:cli/stderr@0.2.0;\n")
    out = out.concat("    import wasi:clocks/monotonic-clock@0.2.0;\n")
    out = out.concat("    import wasi:clocks/wall-clock@0.2.0;\n")
    out = out.concat("    import wasi:filesystem/types@0.2.0;\n")
    out = out.concat("    import wasi:filesystem/preopens@0.2.0;\n")
    out = out.concat("    import wasi:random/random@0.2.0;\n")
    out.concat("\n")
}

fn world_target_error(world: String, target: String, emit_mode: String) -> String {
    if world.len() == 0 { return String_new() }
    let unknown = world_spec_parse_error(world.clone())
    if unknown.len() > 0 { return unknown }
    if !target.clone().eq("wasm32-gc") { return "--world requires --target wasm32-gc" }
    String_new()
}
