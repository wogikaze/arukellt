use std::host::fs::Fs
use std::text
use std::prelude::{byte_at, clone, contains, eq, to_string}
use component::wit_decl
use component::wit_names
use component::wit_type_defs
use component::wit_types
use component::world_spec
use resolver::wit_import_bind
fn emit_wit_text_from_decls(decls: Vec<AstNode>) -> String {
    emit_wit_text_from_decls_with_world(decls, String_new(), Vec::new<String>())
}

fn emit_wit_text_from_decls_with_world(decls: Vec<AstNode>, world: String, wit_paths: Vec<String>) -> String {
    let package_name = if len(clone(world)) > 0 { "arukellt:app" } else { "arukellt:generated" }
    let world_name = world_spec::world_spec_world_name(clone(world))
    let mut out = "package ".concat(package_name.concat(";\n\nworld "))
    out = out.concat(world_name)
    out = out.concat(" {\n")
    out = out.concat(world_spec::world_spec_emit_use_block(clone(world)))
    out = out.concat(emit_wit_imports(wit_paths, decls))
    out = out.concat(wit_type_defs::emit_wit_type_defs(decls))
    out = out.concat(emit_wit_func_exports_with_world(decls, clone(world)))
    return out.concat("}\n")
}

fn emit_wit_imports(wit_paths: Vec<String>, decls: Vec<AstNode>) -> String {
    let bindings = wit_import_bind::wit_collect_bindings(wit_paths, decls)
    let mut out = String_new()
    for i in 0..len(bindings) {
        let binding = get_unchecked(bindings, i)
        let import_id = wit_import_bind::wit_import_binding_wit_import_id(binding)
        if len(import_id) > 0 {
            let line = "    import ".concat(import_id.concat(";\n"))
            if !contains(clone(out), clone(line)) {
                out = out.concat(line)
            }
        }
    }
    out
}

fn emit_wit_text_from_decls_legacy(decls: Vec<AstNode>) -> String {
    let mut out = "package arukellt:generated;\n\nworld arukellt {\n"
    out = out.concat(wit_type_defs::emit_wit_type_defs(decls))
    out = out.concat(emit_wit_func_exports(decls))
    out.concat("}\n")
}

fn emit_wit_func_exports_with_world(decls: Vec<AstNode>, world: String) -> String {
    if !world_spec::world_spec_is_cli_command(clone(world)) { return emit_wit_func_exports(decls) }
    let mut out = ""
    for i in 0..len(decls) {
        let decl = wit_decl::wit_decl_from_node(get_unchecked(decls, i))
        if wit_decl::wit_decl_is_func(decl) {
            let f = wit_decl::wit_func_from_node(get_unchecked(decls, i))
            let fname = wit_decl::wit_func_name(f)
            if eq(clone(fname), "main") || eq(clone(fname), "_start") {
                let export_key = "    export wasi:cli/run@0.2.0;\n"
                if !contains(clone(out), clone(export_key)) {
                    out = out.concat(export_key)
                }
            } else {
                if wit_decl::wit_func_is_export(f) {
                    let export_name = wit_names::wit_export_name(fname)
                    let export_key = "export ".concat(clone(export_name).concat(":"))
                    if !contains(clone(out), clone(export_key)) {
                        out = out.concat("    export ")
                        out = out.concat(export_name)
                        out = out.concat(": func();\n")
                    }
                }
            }
        }
    }
    out
}

fn emit_wit_func_exports(decls: Vec<AstNode>) -> String {
    let mut out = ""
    for i in 0..len(decls) {
        let decl = wit_decl::wit_decl_from_node(get_unchecked(decls, i))
        if wit_decl::wit_decl_is_func(decl) {
            let f = wit_decl::wit_func_from_node(get_unchecked(decls, i))
            let fname = wit_decl::wit_func_name(f)
            if wit_decl::wit_func_is_export(f) {
                out = out.concat("  export ")
                out = out.concat(wit_names::wit_export_name(fname))
                out = out.concat(": func(")
                for pi in 0..wit_decl::wit_func_param_count(f) {
                    if pi > 0 { out = out.concat(", ") }
                    let pname = wit_decl::wit_func_param_name_at(f, pi)
                    if len(clone(pname)) > 0 { out = out.concat(pname) } else { out = out.concat("arg".concat(to_string(pi))) }
                    out = out.concat(": ")
                    if eq(clone(fname), "flip_read") {
                        out = out.concat(wit_type_defs::wit_export_flags_type_name())
                    } else {
                        if eq(clone(fname), "pass_handle") {
                            out = out.concat(wit_type_defs::wit_export_own_handle_type())
                        } else {
                            if wit_decl::wit_func_param_has_type_at(f, pi) {
                                out = out.concat(wit_types::component_wit_type_to_text(wit_decl::wit_func_param_type_view_at(f, pi)))
                            } else {
                                out = out.concat("s32")
                            }
                        }
                    }
                }
                out = out.concat(")")
                let mut ret = String_new()
                if wit_decl::wit_func_return_has_type(f) { ret = wit_types::component_wit_type_to_text(wit_decl::wit_func_return_type_view(f)) }
                if len(ret) > 0 {
                    out = out.concat(" -> ")
                    if eq(clone(fname), "flip_read") {
                        out = out.concat(wit_type_defs::wit_export_flags_type_name())
                    } else {
                        if eq(clone(fname), "pass_handle") { out = out.concat(wit_type_defs::wit_export_own_handle_type()) } else { out = out.concat(ret) }
                    }
                }
                out = out.concat(";\n")
            }
        }
    }
    out
}

fn collect_export_roots(decls: Vec<AstNode>) -> Vec<String> {
    let mut export_roots = Vec::new<String>()
    for i in 0..len(decls) {
        let decl = wit_decl::wit_decl_from_node(get_unchecked(decls, i))
        if wit_decl::wit_decl_is_func(decl) {
            let f = wit_decl::wit_func_from_node(get_unchecked(decls, i))
            if wit_decl::wit_func_is_export(f) { push(export_roots, wit_decl::wit_func_name(f)) }
        }
    }
    export_roots
}

fn string_to_bytes(text: String) -> Vec<i32> {
    let mut bytes = Vec::new<i32>()
    for i in 0..len(text) { push(bytes, byte_at(text, i)) }
    bytes
}

fn validate_wit_import_surface(paths: Vec<String>) -> String {
    for i in 0..len(paths) {
        let path = get_unchecked(paths, i)
        let read_result = Fs::read_to_string(clone(path))
        match read_result {
            Result::Err(e) => {
                return "unable to read WIT file ".concat(clone(path).concat(": ".concat(e)))
            },
            Result::Ok(source) => {
                if contains(clone(source), "future<") {
                    return "E0402 unsupported WIT import type `future<T>` in ".concat(clone(path))
                }
                if contains(clone(source), "stream<") {
                    return "E0402 unsupported WIT import type `stream<T>` in ".concat(clone(path))
                }
            },
        }
    }
    String_new()
}
