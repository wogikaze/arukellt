use std::host::fs::Fs
use std::prelude::{eq}
use std::text
use component::wit_parse_flags
struct ComposeWitFuncSig {
    name: String,
    signature: String,
}

struct ComposeWitWorld {
    imports: Vec<ComposeWitFuncSig>,
    exports: Vec<ComposeWitFuncSig>,
}

fn ComposeWitFuncSig_new(name: String, signature: String) -> ComposeWitFuncSig {
    ComposeWitFuncSig { name: name, signature: signature }
}

fn ComposeWitWorld_new(imports: Vec<ComposeWitFuncSig>, exports: Vec<ComposeWitFuncSig>) -> ComposeWitWorld {
    ComposeWitWorld { imports: imports, exports: exports }
}

fn ComposeWitWorld_empty() -> ComposeWitWorld {
    ComposeWitWorld_new(Vec::new<ComposeWitFuncSig>(), Vec::new<ComposeWitFuncSig>())
}

fn compose_wit_sidecar_for_wasm(wasm_path: String) -> String {
    if wasm_path.clone().ends_with(".wasm") {
        let base = wasm_path.slice(0, len(wasm_path) - 5)
        return base.concat(".wit")
    }
    wasm_path.concat(".wit")
}

fn compose_wit_normalize_sig(sig: String) -> String {
    wit_parse_flags::wit_trim_ws(sig)
}

fn compose_wit_scan_entries(text: String, keyword: String) -> Vec<ComposeWitFuncSig> {
    let mut funcs = Vec::new<ComposeWitFuncSig>()
    let key_len = len(keyword)
    let mut pos = 0
    while pos < len(text) {
        let tail = text.slice(pos, len(text))
        let rel = tail.index_of(keyword)
        if rel < 0 {
            break
        }
        let entry_start = pos + rel + key_len
        let name_tail = text.slice(entry_start, len(text))
        let colon_rel = name_tail.index_of(":")
        if colon_rel < 0 {
            break
        }
        let name_end = entry_start + colon_rel
        let name = compose_wit_normalize_sig(text.slice(entry_start, name_end))
        let after_colon = name_end + 1
        let rest = text.slice(after_colon, len(text))
        let func_rel = rest.index_of("func")
        if func_rel < 0 {
            pos = entry_start + 1
            continue
        }
        let sig_start = after_colon + func_rel
        let sig_tail = text.slice(sig_start, len(text))
        let semi_rel = sig_tail.index_of(";")
        if semi_rel < 0 {
            break
        }
        let sig_end = sig_start + semi_rel
        let signature = compose_wit_normalize_sig(text.slice(sig_start, sig_end))
        push(funcs, ComposeWitFuncSig_new(name, signature))
        pos = sig_end + 1
    }
    funcs
}

fn compose_wit_parse_world_text(text: String) -> ComposeWitWorld {
    ComposeWitWorld_new(
        compose_wit_scan_entries(text.clone(), "import "),
        compose_wit_scan_entries(text.clone(), "export ")
    )
}

fn compose_wit_load_world(path: String) -> ComposeWitWorld {
    let read_result = Fs::read_to_string(path.clone())
    match read_result {
        Result::Ok(text) => compose_wit_parse_world_text(text),
        Result::Err(_) => ComposeWitWorld_empty(),
    }
}

fn compose_wit_find_export(exports: Vec<ComposeWitFuncSig>, name: String) -> i32 {
    for i in 0..len(exports) {
        if eq(get_unchecked(exports, i).name.clone(), name.clone()) {
            return i
        }
    }
    -1
}

fn compose_wit_validate_imports(socket_imports: Vec<ComposeWitFuncSig>, provider_exports: Vec<ComposeWitFuncSig>) -> String {
    for i in 0..len(socket_imports) {
        let imp = get_unchecked(socket_imports, i)
        // prelude clone() is String-only; cloning a Vec makes Memory64 locals
        // typed as String and fails validate (#730).
        let export_idx = compose_wit_find_export(provider_exports, imp.name.clone())
        if export_idx < 0 {
            return "error: compose conflict: socket import '".concat(imp.name.clone().concat("' has no matching provider export".concat(String_new())))
        }
        let exp = get_unchecked(provider_exports, export_idx)
        if !eq(imp.signature.clone(), exp.signature.clone()) {
            return "error: compose conflict: import/export type mismatch for '".concat(
                imp.name.clone().concat("': socket expects ".concat(imp.signature.clone().concat(" but provider exports ".concat(exp.signature.clone()))))
            )
        }
    }
    String_new()
}

fn validate_plug_surfaces(provider_wasm: String, socket_wasm: String) -> String {
    let provider_wit = compose_wit_sidecar_for_wasm(provider_wasm.clone())
    let socket_wit = compose_wit_sidecar_for_wasm(socket_wasm.clone())
    let provider_has = match Fs::read_to_string(provider_wit.clone()) {
        Result::Ok(_) => {
            true
        },
        Result::Err(_) => {
            false
        },
    }
    let socket_has = match Fs::read_to_string(socket_wit.clone()) {
        Result::Ok(_) => {
            true
        },
        Result::Err(_) => {
            false
        },
    }
    if !provider_has && !socket_has {
        return String_new()
    }
    if provider_has && !socket_has {
        return "error: compose conflict: missing WIT sidecar for socket component: ".concat(socket_wit.clone())
    }
    if !provider_has && socket_has {
        return "error: compose conflict: missing WIT sidecar for provider component: ".concat(provider_wit.clone())
    }
    let provider_world = compose_wit_load_world(provider_wit.clone())
    let socket_world = compose_wit_load_world(socket_wit.clone())
    compose_wit_validate_imports(socket_world.imports, provider_world.exports)
}
