// WIT flags type parsing helpers (#651).

use std::text
fn wit_trim_ws(text: String) -> String {
    let n = text.len()
    let mut start = 0
    while start < n {
        let ch = text.byte_at(start)
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        start = start + 1
    }
    let mut end = n
    while end > start {
        let ch = text.byte_at(end - 1)
        if ch != 32 && ch != 9 && ch != 10 && ch != 13 {
            break
        }
        end = end - 1
    }
    text.slice(start, end)
}

fn wit_is_flags_type(text: String) -> bool {
    wit_trim_ws(text).starts_with("flags")
}

fn wit_flags_member_names(text: String) -> Vec<String> {
    let mut names = Vec::new<String>()
    let open = text.index_of("{")
    let close = text.index_of("}")
    if open < 0 || close <= open {
        return names
    }
    let body = wit_trim_ws(text.slice(open + 1, close))
    if body.len() == 0 {
        return names
    }
    let mut part = String_new()
    for i in 0..body.len() {
        let ch = body.byte_at(i)
        if ch == 44 {
            let trimmed = wit_trim_ws(part)
            if trimmed.len() > 0 {
                names.push(trimmed)
            }
            part = String_new()
        } else {
            part = part.concat(body.slice(i, i + 1))
        }
    }
    let trimmed = wit_trim_ws(part)
    if trimmed.len() > 0 {
        names.push(trimmed)
    }
    names
}

fn wit_flags_type_text(member_names: Vec<String>) -> String {
    let mut out = "flags {"
    for i in 0..member_names.len() {
        if i > 0 {
            out = out.concat(", ")
        }
        out = out.concat(get_unchecked(member_names, i))
    }
    out.concat("}")
}
