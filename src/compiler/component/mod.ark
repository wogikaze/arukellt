use component::contract
use component::contract_preflight
use component::wit_bindings
use component::wit_parse_import
use component::wit_parse_text
use component::wit_text

// Keep compiler-internal WIT entry points on the component namespace boundary.
// The implementation modules remain private so they cannot become accidental
// user-facing free-function APIs.
pub fn parse_wit_import_text(source: String) -> wit_parse_text::WitParsedInterface {
    wit_parse_import::parse_wit_import_text(source)
}

pub fn parse_wit_import_file(path: String) -> wit_parse_text::WitParsedInterface {
    wit_parse_import::parse_wit_import_file(path)
}

pub fn wit_import_id_matches(package_id: String, doc: wit_parse_text::WitParsedInterface) -> bool {
    wit_parse_import::wit_import_id_matches(package_id, doc)
}

pub fn emit_wit_text_from_decls_with_world(decls: Vec<AstNode>, world: String, wit_paths: Vec<String>) -> String {
    wit_text::emit_wit_text_from_decls_with_world(decls, world, wit_paths)
}

pub fn emit_wit_bindings_text(source: String) -> String {
    wit_bindings::emit_wit_bindings_text(source)
}

pub fn collect_export_roots(decls: Vec<AstNode>) -> Vec<String> {
    wit_text::collect_export_roots(decls)
}

pub fn string_to_bytes(text: String) -> Vec<i32> {
    wit_text::string_to_bytes(text)
}

pub fn validate_wit_import_surface(paths: Vec<String>) -> String {
    wit_text::validate_wit_import_surface(paths)
}

pub fn validate_export_surface(decls: Vec<AstNode>) -> String {
    contract::validate_export_surface(decls)
}

pub fn preflight_frontend(config_emit_mode: String, wit_paths: Vec<String>, decls: Vec<AstNode>, world: String) -> String {
    contract_preflight::preflight_frontend(config_emit_mode, wit_paths, decls, world)
}
