use std::text
use lsp::state_record
use lsp::symbol_index_record
fn ascii_lower_char(c: i32) -> i32 {
    if c >= 65 && c <= 90 {
        return c + 32
    }
    c
}

fn ascii_lower_str(s: String) -> String {
    let n = s.len()
    let mut out = String_new()
    let mut i = 0
    while i < n {
        out = out.concat(char_to_string(ascii_lower_char(s.byte_at(i))))
        i = i + 1
    }
    out
}

fn name_matches_query(name: String, query: String) -> bool {
    if query.len() == 0 {
        return true
    }
    ascii_lower_str(name.clone()).contains(ascii_lower_str(query.clone()))
}

fn result_key(uri: String, name: String) -> String {
    uri.concat(":").concat(name)
}

fn results_contains(results: Vec<symbol_index_record::IndexedSymbol>, uri: String, name: String) -> bool {
    let key = result_key(uri.clone(), name.clone())
    let n = results.len()
    let mut i = 0
    while i < n {
        let sym = results.get_unchecked(i)
        let existing = result_key(symbol_index_record::indexed_symbol_uri(sym), symbol_index_record::indexed_symbol_name(sym))
        if existing.eq(key.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn push_unique_result(mut results: Vec<symbol_index_record::IndexedSymbol>, sym: symbol_index_record::IndexedSymbol) -> Vec<symbol_index_record::IndexedSymbol> {
    if results_contains(results, symbol_index_record::indexed_symbol_uri(sym), symbol_index_record::indexed_symbol_name(sym)) {
        return results
    }
    results.push(sym)
    results
}

pub fn symbol_index_search(state: LspState, query: String) -> Vec<symbol_index_record::IndexedSymbol> {
    let mut results = Vec::new<IndexedSymbol>()
    let symbols = state_record::lsp_state_symbol_symbols(state)
    let file_n = symbols.len()
    let mut fi = 0
    while fi < file_n {
        let sym = symbols.get_unchecked(fi)
        if name_matches_query(symbol_index_record::indexed_symbol_name(sym), query.clone()) {
            push_unique_result(results, sym)
        }
        fi = fi + 1
    }
    results
}
