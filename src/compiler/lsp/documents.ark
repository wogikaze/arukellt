use std::json
use analysis
use lsp::diagnostics
use lsp::framing
use lsp::init_workspace
use lsp::lsp_package_definition
use lsp::state_docs
use lsp::state_record
use lsp::symbol_index
use lsp::symbol_index_stdlib
use lsp::symbol_index_update
use lsp::project_resolve_modules
pub fn handle_did_open(mut state: LspState, body: String) {
    let uri = json::JsonText::get_str(body.clone(), String_from("uri"))
    let text = json::JsonText::get_str(body.clone(), String_from("text"))
    let version = json::JsonText::get_int(body.clone(), String_from("version"))
    state_docs::lsp_doc_store_set(state_record::lsp_state_doc_store(state), uri.clone(), text.clone(), version)
    symbol_index_stdlib::symbol_index_load_stdlib(state)
    symbol_index_update::symbol_index_update_uri(state, uri.clone(), text.clone())
    publish_for(state, uri.clone(), text.clone())
}

pub fn handle_did_change(mut state: LspState, body: String) {
    let uri = json::JsonText::get_str(body.clone(), String_from("uri"))
    let version = json::JsonText::get_int(body.clone(), String_from("version"))
    let cc = json::JsonText::find_key_pos(body.clone(), String_from("contentChanges"), 0)
    let text = if cc < 0 {
        json::JsonText::get_str(body.clone(), String_from("text"))
    } else {
        json::JsonText::get_str_after(body.clone(), String_from("text"), cc)
    }
    state_docs::lsp_doc_store_set(state_record::lsp_state_doc_store(state), uri.clone(), text.clone(), version)
    symbol_index_update::symbol_index_update_uri(state, uri.clone(), text.clone())
    publish_for(state, uri.clone(), text.clone())
}

pub fn handle_did_close(mut state: LspState, body: String) {
    let uri = json::JsonText::get_str(body.clone(), String_from("uri"))
    symbol_index::symbol_index_remove_file(state, uri.clone())
}

pub fn handle_did_change_watched_files(mut state: LspState, body: String) {
    if !lsp_package_definition::watched_files_body_has_ark_toml(body.clone()) {
        return
    }
    init_workspace::rebuild_workspace_package_index_from_manifest_change(state)
}

pub fn handle_did_save(mut state: LspState, body: String) {
    if !state_record::lsp_state_check_on_save(state) {
        return
    }
    let uri = json::JsonText::get_str(body.clone(), String_from("uri"))
    let text = state_docs::lsp_doc_store_lookup_text(state_record::lsp_state_doc_store(state), uri.clone())
    if len(text) > 0 {
        publish_for(state, uri.clone(), text.clone())
    }
}

fn publish_for(mut state: LspState, uri: String, text: String) {
    let modules = project_resolve_modules::build_resolve_modules_with_prelude(state, uri.clone())
    let snap = analysis::analyze_with_modules(uri.clone(), text.clone(), modules)
    framing::append_framed(state, diagnostics::build_publish_diagnostics(uri.clone(), text.clone(), snap))
}
