use std::host::fs::Fs
use compiler::session_parse
use lsp::state_docs
use lsp::state_record
use lsp::symbol_index_paths
use loader::load
use resolver
fn ark_stem_from_path(path: String) -> String {
    let n = path.len()
    let mut last_slash = 0 - 1
    let mut i = n - 1
    while i >= 0 {
        if path.byte_at(i) == 47 {
            last_slash = i
            i = 0 - 1
        } else {
            i = i - 1
        }
    }
    let start = if last_slash < 0 {
        0
    } else {
        last_slash + 1
    }
    let name = path.slice(start, n)
    let nl = name.len()
    if nl > 4 && name.clone().slice(nl - 4, nl).eq(".ark") {
        return name.slice(0, nl - 4)
    }
    name
}

fn module_text_for_uri(state: LspState, uri: String) -> String {
    let store = state_record::lsp_state_doc_store(state)
    let from_store = state_docs::lsp_doc_store_lookup_text(store, uri.clone())
    if from_store.len() > 0 {
        return from_store
    }
    let mut path = symbol_index_paths::uri_to_file_path(uri.clone())
    if path.len() == 0 {
        return String_new()
    }
    let read_result = Fs::read_to_string(path)
    match read_result {
        Result::Ok(text) => {
            text
        },
        Result::Err(_) => {
            String_new()
        },
    }
}

pub fn build_resolve_modules(state: LspState, current_uri: String) -> Vec<ModuleDecls> {
    let mut out = Vec::new<ModuleDecls>()
    let indexed = state_record::lsp_state_symbol_indexed_uris(state)
    let n = indexed.len()
    let mut i = 0
    while i < n {
        let uri = indexed.get_unchecked(i)
        if !uri.clone().eq(current_uri.clone()) {
            let text = module_text_for_uri(state, uri.clone())
            if text.len() > 0 {
                let decls = session_parse::session_parse_decls(text.clone())
                let stem = ark_stem_from_path(symbol_index_paths::uri_to_file_path(uri.clone()))
                if stem.len() > 0 {
                    out.push(resolver::ModuleDecls_new(stem, decls))
                }
            }
        }
        i = i + 1
    }
    out
}

pub fn build_resolve_modules_with_prelude(state: LspState, current_uri: String) -> Vec<ModuleDecls> {
    let prelude_modules = load::load_prelude_modules()
    let project_modules = build_resolve_modules(state, current_uri)
    let mut combined = Vec::new<ModuleDecls>()
    let pn = prelude_modules.len()
    let mut pi = 0
    while pi < pn {
        combined.push(prelude_modules.get_unchecked(pi))
        pi = pi + 1
    }
    let mn = project_modules.len()
    let mut mi = 0
    while mi < mn {
        combined.push(project_modules.get_unchecked(mi))
        mi = mi + 1
    }
    combined
}
