use std::host::fs::Fs
use lsp::lsp_package_definition
use lsp::state_record
use lsp::symbol_index_paths
use lsp::symbol_index_project
use lsp::symbol_index_stdlib
use lsp::symbol_index_update

fn collect_path_dependency_rel_paths(content: String) -> Vec<String> {
    let mut out = Vec::new<String>()
    let needle = "path = \""
    let content_len = content.len()
    let needle_len = needle.len()
    let mut search_from = 0
    while search_from < content_len {
        let tail = content.slice(search_from, content_len)
        let pos = tail.clone().index_of(needle)
        if pos < 0 {
            return out
        }
        let abs = search_from + pos + needle_len
        let rest = content.slice(abs, content_len)
        let end = rest.clone().index_of("\"")
        if end < 0 {
            return out
        }
        out.push(rest.slice(0, end))
        search_from = abs + end + 1
    }
    out
}

fn tail_strings(items: Vec<String>) -> Vec<String> {
    let mut out = Vec::new<String>()
    let n = items.len()
    let mut i = 1
    while i < n {
        out.push(get_unchecked(items, i))
        i = i + 1
    }
    out
}

fn roots_contains(roots: Vec<String>, path: String) -> bool {
    let n = roots.len()
    let mut i = 0
    while i < n {
        if get_unchecked(roots, i).eq(path.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn roots_push_unique(mut roots: Vec<String>, path: String) -> Vec<String> {
    if path.len() == 0 || roots_contains(roots, path.clone()) {
        return roots
    }
    roots.push(path)
    roots
}

fn discover_path_dependency_roots(seed_root: String) -> Vec<String> {
    let mut ordered = Vec::new<String>()
    let mut visited = Vec::new<String>()
    let mut pending = roots_push_unique(Vec::new<String>(), seed_root.clone())
    while pending.len() > 0 {
        let next = get_unchecked(pending, 0)
        pending = tail_strings(pending)
        if roots_contains(visited, next.clone()) {
            continue
        }
        visited = roots_push_unique(visited, next.clone())
        let manifest_path = symbol_index_paths::join_path(next.clone(), "ark.toml")
        let read_result = Fs::read_to_string(manifest_path.clone())
        match read_result {
            Result::Ok(content) => {
                ordered = roots_push_unique(ordered, next.clone())
                let deps = collect_path_dependency_rel_paths(content.clone())
                let dn = deps.len()
                let mut di = 0
                while di < dn {
                    let dep_rel = get_unchecked(deps, di)
                    let dep_start = symbol_index_paths::resolve_relative_path(next.clone(), dep_rel)
                    let dep_root = lsp_package_definition::find_package_root(dep_start)
                    if dep_root.len() > 0 {
                        pending = roots_push_unique(pending, dep_root)
                    }
                    di = di + 1
                }
            },
            Result::Err(_) => {},
        }
    }
    ordered
}

fn discover_workspace_package_roots(workspace_roots: Vec<String>) -> Vec<String> {
    let mut out = Vec::new<String>()
    let n = workspace_roots.len()
    let mut i = 0
    while i < n {
        let seed = get_unchecked(workspace_roots, i)
        let project_root = lsp_package_definition::find_package_root(seed.clone())
        if project_root.len() > 0 {
            let discovered = discover_path_dependency_roots(project_root.clone())
            let dn = discovered.len()
            let mut di = 0
            while di < dn {
                out = roots_push_unique(out, get_unchecked(discovered, di).clone())
                di = di + 1
            }
        }
        i = i + 1
    }
    out
}

fn build_workspace_seeds(state: LspState) -> Vec<String> {
    let mut out = Vec::new<String>()
    let n = state_record::lsp_state_workspace_roots_len(state)
    let mut i = 0
    while i < n {
        out.push(state_record::lsp_state_workspace_root_at(state, i))
        i = i + 1
    }
    if out.len() > 0 {
        return out
    }
    let project_root = state_record::lsp_state_project_root(state)
    if project_root.len() > 0 {
        out.push(project_root)
    }
    out
}

pub fn rebuild_workspace_package_index(mut state: LspState) {
    symbol_index_stdlib::symbol_index_load_stdlib(state)
    let package_roots = discover_workspace_package_roots(build_workspace_seeds(state))
    let n = package_roots.len()
    let mut i = 0
    while i < n {
        symbol_index_project::symbol_index_load_project(state, get_unchecked(package_roots, i))
        i = i + 1
    }
}

pub fn initialize_workspace_index(mut state: LspState, body: String) {
    let workspace_roots = lsp_package_definition::workspace_roots_from_initialize(body.clone())
    let primary = if workspace_roots.len() > 0 {
        get_unchecked(workspace_roots, 0)
    } else {
        String_new()
    }
    state_record::lsp_state_set_workspace_roots(state, workspace_roots)
    state_record::lsp_state_set_project_root(state, primary.clone())
    rebuild_workspace_package_index(state)
}

pub fn rebuild_workspace_package_index_from_manifest_change(mut state: LspState) {
    symbol_index_update::symbol_index_clear_project(state)
    rebuild_workspace_package_index(state)
}
