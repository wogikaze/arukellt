use std::text
use std::json
fn append_param_labels(items: String, params: Vec<String>) -> String {
    let n = params.len()
    let mut i = 0
    let mut out = items
    while i < n {
        if out.len() > 0 {
            out = out.concat(String_from(","))
        }
        out = out.concat(String_from("{\"label\":"))
        out = out.concat(json::JsonText::quote(params.get_unchecked(i)))
        out = out.concat(String_from("}"))
        i = i + 1
    }
    out
}

fn signature_info_json(label: String, doc: String, params: Vec<String>) -> String {
    let mut out = String_from("{\"label\":")
    out = out.concat(json::JsonText::quote(label))
    if doc.len() > 0 {
        out = out.concat(String_from(",\"documentation\":{\"kind\":\"markdown\",\"value\":"))
        out = out.concat(json::JsonText::quote(doc))
        out = out.concat(String_from("}"))
    }
    out = out.concat(String_from(",\"parameters\":["))
    out = out.concat(append_param_labels(String_new(), params))
    out = out.concat(String_from("]}"))
    out
}

pub fn build_signature_help_response(id: i32, label: String, doc: String, params: Vec<String>, active_param: i32) -> String {
    let mut body = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
    body = body.concat(id.to_string())
    body = body.concat(String_from(",\"result\":{\"signatures\":["))
    body = body.concat(signature_info_json(label, doc, params))
    body = body.concat(String_from("],\"activeSignature\":0,\"activeParameter\":"))
    body = body.concat(active_param.to_string())
    body = body.concat(String_from("}}"))
    body
}
