use lsp::feature_request
use lsp::feature_symbol
use lsp::framing
use lsp::positions
use lsp::qualified_name
use lsp::responses
use lsp::source_text
use lsp::stdlib_definition
use lsp::symbol_index_lookup
use lsp::symbol_index_record
use lsp::symbol_index_search
fn lookup_short_name(text: String, offset: i32) -> String {
    let lookup_name = qualified_name::lookup_name_at_offset(text.clone(), offset)
    if lookup_name.len() == 0 {
        return String_new()
    }
    if !lookup_name.clone().contains("::") {
        return lookup_name
    }
    let mut last_colon = 0
    let mut pos = lookup_name.len() - 1
    while pos >= 0 {
        if lookup_name.byte_at(pos) == 58 && pos > 0 && lookup_name.byte_at(pos - 1) == 58 {
            last_colon = pos + 1
            pos = 0 - 1
        } else {
            pos = pos - 1
        }
    }
    if last_colon > 0 && last_colon < lookup_name.len() {
        return lookup_name.slice(last_colon, lookup_name.len())
    }
    lookup_name
}

pub fn handle_definition(mut state: LspState, body: String) {
    let req = feature_request::read_text_position_request(state, body.clone())
    if !feature_request::text_position_request_has_text(req) {
        framing::append_framed(state, responses::build_null_response(feature_request::text_position_request_id(req)))
        return
    }
    let req_text = feature_request::text_position_request_text(req)
    let req_offset = feature_request::text_position_request_offset(req)
    let qualified = qualified_name::lookup_name_at_offset(req_text.clone(), req_offset)
    let short_name = lookup_short_name(req_text.clone(), req_offset)
    if short_name.len() > 0 && stdlib_definition::lookup_stdlib_definition(state, short_name.clone()) {
        framing::append_framed(
            state,
            responses::build_definition_response(
                feature_request::text_position_request_id(req),
                stdlib_definition::stdlib_definition_uri(state, short_name.clone()),
                stdlib_definition::stdlib_definition_start(state, short_name.clone()),
                stdlib_definition::stdlib_definition_end(state, short_name.clone())
            )
        )
        return
    }
    let sym = feature_symbol::resolve_symbol_request(state, body)
    let use_local_def = feature_symbol::symbol_request_found(sym) && !qualified.clone().contains("::")
    if use_local_def {
        framing::append_framed(
            state,
            responses::build_definition_response(
                feature_symbol::symbol_request_id(sym),
                feature_symbol::symbol_request_uri(sym),
                feature_symbol::symbol_request_start(sym),
                feature_symbol::symbol_request_end(sym)
            )
        )
        return
    }
    let def = symbol_index_lookup::lookup_definition(state, short_name.clone())
    if !symbol_index_lookup::index_definition_found(def) {
        let matches = symbol_index_search::symbol_index_search(state, short_name.clone())
        if matches.len() == 0 {
            framing::append_framed(state, responses::build_null_response(feature_request::text_position_request_id(req)))
            return
        }
        let hit = get_unchecked(matches, 0)
        let def_uri = symbol_index_record::indexed_symbol_uri(hit)
        let def_text = source_text::text_for_uri(state, def_uri.clone())
        let start = positions::offset_to_position(def_text.clone(), symbol_index_record::indexed_symbol_decl_start(hit))
        let end = positions::offset_to_position(def_text, symbol_index_record::indexed_symbol_decl_end(hit))
        framing::append_framed(state, responses::build_definition_response(feature_request::text_position_request_id(req), def_uri, start, end))
        return
    }
    let def_uri = symbol_index_lookup::index_definition_uri(def)
    let def_text = source_text::text_for_uri(state, def_uri.clone())
    let start = positions::offset_to_position(def_text.clone(), symbol_index_lookup::index_definition_decl_start(def))
    let end = positions::offset_to_position(def_text, symbol_index_lookup::index_definition_decl_end(def))
    framing::append_framed(state, responses::build_definition_response(feature_request::text_position_request_id(req), def_uri, start, end))
}
