use std::text
use std::json
use std::prelude::{clone, eq}
use fmt
use lsp::positions
use lsp::source_text
fn extract_section_line(body: String, section: String) -> i32 {
    let marker = section.concat(String_from("\"line\""))
    let pos = clone(body).index_of(marker)
    if pos < 0 {
        return 0
    }
    let after = body.slice(pos, len(body))
    json::JsonText::get_int(after, String_from("line"))
}

fn build_full_document_edit(text: String, formatted: String) -> String {
    let end_pos = positions::offset_to_position(clone(text), len(text))
    let mut out = String_from("[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":")
    out = out.concat(positions::lsp_position_line(end_pos).to_string())
    out = out.concat(String_from(",\"character\":"))
    out = out.concat(positions::lsp_position_character(end_pos).to_string())
    out = out.concat(String_from("}},\"newText\":"))
    out = out.concat(json::JsonText::quote(formatted))
    out = out.concat(String_from("}]"))
    out
}

fn build_formatting_result(text: String) -> String {
    match fmt::format_source(clone(text)) {
        Option::None => {
            String_from("[]")
        },
        Option::Some(formatted) => {
            if eq(clone(formatted), clone(text)) {
                return String_from("[]")
            }
            build_full_document_edit(text, formatted)
        },
    }
}

pub fn build_formatting_response_for_request(state: LspState, body: String, id: i32) -> String {
    let uri = json::JsonText::get_str(clone(body), String_from("uri"))
    let text = source_text::text_for_uri(state, clone(uri))
    let edits = build_formatting_result(text)
    let mut out = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
    out = out.concat(id.to_string())
    out = out.concat(String_from(",\"result\":"))
    out = out.concat(edits)
    out = out.concat(String_from("}"))
    out
}

pub fn build_range_formatting_response_for_request(state: LspState, body: String, id: i32) -> String {
    let uri = json::JsonText::get_str(clone(body), String_from("uri"))
    let text = source_text::text_for_uri(state, clone(uri))
    let start_line = extract_section_line(clone(body), String_from("\"start\":{"))
    let end_line = extract_section_line(clone(body), String_from("\"end\":{"))
    let mut out = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
    out = out.concat(id.to_string())
    out = out.concat(String_from(",\"result\":"))
    match fmt::format_range(clone(text), start_line, end_line) {
        Option::None => {
            out = out.concat(String_from("[]"))
        },
        Option::Some(formatted) => {
            if eq(clone(formatted), clone(text)) {
                out = out.concat(String_from("[]"))
            } else {
                out = out.concat(build_full_document_edit(text, formatted))
            }
        },
    }
    out = out.concat(String_from("}"))
    out
}
