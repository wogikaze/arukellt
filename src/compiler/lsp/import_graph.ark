use std::prelude::{eq}
use std::text
use compiler::session_parse
use loader::module_import_paths
fn path_is_imported(paths: Vec<String>, import_path: String) -> bool {
    let n = len(paths)
    let mut i = 0
    while i < n {
        if eq(get_unchecked(paths, i), import_path.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

pub fn import_paths_in_text(text: String) -> Vec<String> {
    module_import_paths::collect_import_paths(session_parse::session_parse_decls(text.clone()))
}

pub fn is_path_imported(text: String, import_path: String) -> bool {
    path_is_imported(import_paths_in_text(text.clone()), import_path)
}

pub fn stdlib_import_path(module_path: String, symbol_name: String) -> String {
    module_path.concat("::".concat(symbol_name))
}

pub fn build_use_statement(import_path: String) -> String {
    "use ".concat(import_path.concat("\n"))
}

pub fn first_use_insert_offset(text: String) -> i32 {
    let use_pos = text.clone().index_of("use ")
    if use_pos < 0 {
        return 0
    }
    let n = len(text)
    let mut line_end = use_pos
    while line_end < n && text.byte_at(line_end) != 10 {
        line_end = line_end + 1
    }
    if line_end < n {
        return line_end + 1
    }
    line_end
}
