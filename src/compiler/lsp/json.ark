//
// Delegates to std::json (issue #704). Facade retained for existing `lsp::json` callers.

use std::json

fn json_escape(s: String) -> String {
    json::json_escape(s)
}

fn quote_string(s: String) -> String {
    json::quote_string(s)
}

fn json_skip_ws(s: String, pos: i32) -> i32 {
    json::skip_ws(s, pos)
}

fn find_key_pos(json_str: String, key: String, from: i32) -> i32 {
    json::find_key_pos(json_str, key, from)
}

fn json_parse_int_at(s: String, pos: i32) -> i32 {
    json::parse_int_at(s, pos)
}

fn extract_string_field(json_str: String, key: String) -> String {
    json::json_get_str(json_str, key)
}

fn extract_string_field_after(json_str: String, key: String, from: i32) -> String {
    json::json_get_str_after(json_str, key, from)
}

fn extract_int_field(json_str: String, key: String) -> i32 {
    json::json_get_int(json_str, key)
}
