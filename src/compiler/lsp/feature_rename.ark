use std::json
use lsp::framing
use lsp::rename_semantic
pub fn handle_prepare_rename(mut state: LspState, body: String) {
    let id = json::JsonText::get_int(body.clone(), String_from("id"))
    framing::append_framed(state, rename_semantic::build_prepare_rename_response_for_request(state, body.clone(), id))
}

pub fn handle_rename(mut state: LspState, body: String) {
    let id = json::JsonText::get_int(body.clone(), String_from("id"))
    framing::append_framed(state, rename_semantic::build_rename_response_for_request(state, body.clone(), id))
}
