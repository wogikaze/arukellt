use std::text
use std::json
use lsp::feature_request
use lsp::framing
use lsp::responses
use lsp::source_text
use lsp::state_docs
use lsp::state_record
fn line_has_open_brace(text: String, line: i32) -> bool {
    let mut i = 0
    let mut cur = 0
    while i < len(text) {
        if text.byte_at(i) == 10 {
            if cur == line {
                return false
            }
            cur = cur + 1
            i = i + 1
            continue
        }
        if cur == line && text.byte_at(i) == 123 {
            return true
        }
        i = i + 1
    }
    false
}

fn find_brace_end_line(text: String, start_line: i32) -> i32 {
    let mut depth = 0
    let mut i = 0
    let mut cur = 0
    while i < len(text) {
        let ch = text.byte_at(i)
        if ch == 10 {
            if cur > start_line && depth <= 0 {
                return cur - 1
            }
            cur = cur + 1
            i = i + 1
            continue
        }
        if cur >= start_line {
            if ch == 123 { depth = depth + 1 }
            if ch == 125 {
                depth = depth - 1
                if depth <= 0 && cur > start_line {
                    return cur
                }
            }
        }
        i = i + 1
    }
    start_line
}

fn append_folding_entry(out: String, start_line: i32, end_line: i32) -> String {
    let mut body = out
    if len(body) > 1 {
        body = body.concat(String_from(","))
    }
    body = body.concat(String_from("{\"startLine\":"))
    body = body.concat(start_line.to_string())
    body = body.concat(String_from(",\"endLine\":"))
    body = body.concat(end_line.to_string())
    body = body.concat(String_from(",\"kind\":\"region\"}"))
    body
}

pub fn handle_folding_range(mut state: LspState, body: String) {
    let id = json::JsonText::get_int(body.clone(), String_from("id"))
    let uri = json::JsonText::get_str(body.clone(), String_from("uri"))
    let mut text = state_docs::lsp_doc_store_lookup_text(state_record::lsp_state_doc_store(state), uri.clone())
    if len(text) == 0 {
        text = source_text::text_for_uri(state, uri.clone())
    }
    if len(text) == 0 {
        framing::append_framed(state, responses::build_empty_array_response(id))
        return
    }
    let mut line = 0
    let mut items = String_from("[")
    while line < 200 {
        if line_has_open_brace(text.clone(), line) {
            let end_line = find_brace_end_line(text.clone(), line)
            items = append_folding_entry(items, line, end_line)
        }
        line = line + 1
    }
    items = items.concat(String_from("]"))
    let mut out = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
    out = out.concat(id.to_string())
    out = out.concat(String_from(",\"result\":"))
    out = out.concat(items)
    out = out.concat(String_from("}"))
    framing::append_framed(state, out)
}
