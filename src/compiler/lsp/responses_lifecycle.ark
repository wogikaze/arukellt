use std::text
fn build_initialize_response(id: i32) -> String {
    let mut body = "{\"jsonrpc\":\"2.0\",\"id\":"
    body = body.concat(id.to_string())
    body = body.concat(",\"result\":{\"capabilities\":{\"textDocumentSync\":1")
    body = body.concat(",\"hoverProvider\":true,\"definitionProvider\":true")
    body = body.concat(",\"typeDefinitionProvider\":true,\"referencesProvider\":true")
    body = body.concat(",\"documentHighlightProvider\":true,\"renameProvider\":true")
    body = body.concat(",\"completionProvider\":{\"resolveProvider\":false,\"triggerCharacters\":[\".\",\":\"]}")
    body = body.concat(",\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]}")
    body = body.concat(",\"codeActionProvider\":true,\"workspaceSymbolProvider\":true")
    body = body.concat(",\"documentFormattingProvider\":true,\"documentRangeFormattingProvider\":true")
    body = body.concat(",\"diagnosticProvider\":{\"interFileDependencies\":false,\"workspaceDiagnostics\":false}}")
    body = body.concat(",\"serverInfo\":{\"name\":\"arukellt-lsp\",\"version\":\"0.1.0\"}}}")
    body
}

fn build_shutdown_response(id: i32) -> String {
    let mut body = "{\"jsonrpc\":\"2.0\",\"id\":"
    body = body.concat(id.to_string())
    body = body.concat(",\"result\":null}")
    body
}

fn build_null_response(id: i32) -> String {
    let mut body = "{\"jsonrpc\":\"2.0\",\"id\":"
    body = body.concat(id.to_string())
    body = body.concat(",\"result\":null}")
    body
}
