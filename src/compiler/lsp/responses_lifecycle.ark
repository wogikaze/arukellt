use std::text

fn build_initialize_response(id: i32) -> String {
    let mut body = "{\"jsonrpc\":\"2.0\",\"id\":"
    body = text::builder_append(body, to_string(id))
    body = text::builder_append(
        body,
        ",\"result\":{\"capabilities\":{\"textDocumentSync\":1"
    )
    body = text::builder_append(body, ",\"hoverProvider\":true,\"definitionProvider\":true")
    body = text::builder_append(body, ",\"typeDefinitionProvider\":true,\"referencesProvider\":true")
    body = text::builder_append(body, ",\"documentHighlightProvider\":true,\"renameProvider\":true")
    body = text::builder_append(
        body,
        ",\"completionProvider\":{\"resolveProvider\":false,\"triggerCharacters\":[\".\",\":\"]}"
    )
    body = text::builder_append(
        body,
        ",\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]}"
    )
    body = text::builder_append(body, ",\"codeActionProvider\":true,\"workspaceSymbolProvider\":true")
    body = text::builder_append(
        body,
        ",\"documentFormattingProvider\":true,\"documentRangeFormattingProvider\":true"
    )
    body = text::builder_append(
        body,
        ",\"diagnosticProvider\":{\"interFileDependencies\":false,\"workspaceDiagnostics\":false}}"
    )
    body = text::builder_append(
        body,
        ",\"serverInfo\":{\"name\":\"arukellt-lsp\",\"version\":\"0.1.0\"}}}"
    )
    body
}

fn build_shutdown_response(id: i32) -> String {
    let mut body = "{\"jsonrpc\":\"2.0\",\"id\":"
    body = text::builder_append(body, to_string(id))
    body = text::builder_append(body, ",\"result\":null}")
    body
}

fn build_null_response(id: i32) -> String {
    let mut body = "{\"jsonrpc\":\"2.0\",\"id\":"
    body = text::builder_append(body, to_string(id))
    body = text::builder_append(body, ",\"result\":null}")
    body
}
