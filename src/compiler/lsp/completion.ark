use std::json::parser
use std::prelude::{byte_at, clone, substring}
use lsp::completion_providers
use lsp::positions
fn is_ident_char(ch: i32) -> bool {
    if ch >= 97 && ch <= 122 {
        return true
    }
    if ch >= 65 && ch <= 90 {
        return true
    }
    if ch >= 48 && ch <= 57 {
        return true
    }
    ch == 95
}

fn prefix_at_offset(text: String, offset: i32) -> String {
    let n = len(text)
    let mut end = offset
    if end > n {
        end = n
    }
    let mut start = end
    while start > 0 && is_ident_char(byte_at(text, start - 1)) {
        start = start - 1
    }
    substring(text, start, end)
}

pub fn build_completion_response(state: LspState, id: i32, text: String, offset: i32) -> String {
    let prefix = prefix_at_offset(clone(text), offset)
    let items = completion_providers::collect_completion_items(state, clone(text), offset, prefix)
    let mut items_arr = Vec::new<parser::JsonValue>()
    push(items_arr, parser::JsonValue::raw(items))
    let mut result_obj = Vec::new<parser::JsonField>()
    push(result_obj, parser::JsonField::new("isIncomplete", parser::JsonValue::raw("false")))
    push(result_obj, parser::JsonField::new("items", JsonValue::Array(items_arr)))
    let mut fields = Vec::new<parser::JsonField>()
    push(fields, parser::JsonField::new("jsonrpc", parser::JsonValue::string("2.0")))
    push(fields, parser::JsonField::new("id", parser::JsonValue::int(id)))
    push(fields, parser::JsonField::new("result", JsonValue::Object(result_obj)))
    parser::JsonValue::object(fields).to_text()
}
