use std::json::parser
use lsp::completion_providers
use lsp::positions
fn is_ident_char(ch: i32) -> bool {
    if ch >= 97 && ch <= 122 {
        return true
    }
    if ch >= 65 && ch <= 90 {
        return true
    }
    if ch >= 48 && ch <= 57 {
        return true
    }
    ch == 95
}

fn prefix_at_offset(text: String, offset: i32) -> String {
    let n = text.len()
    let mut end = offset
    if end > n {
        end = n
    }
    let mut start = end
    while start > 0 && is_ident_char(text.byte_at(start - 1)) {
        start = start - 1
    }
    text.slice(start, end)
}

pub fn build_completion_response(state: LspState, id: i32, text: String, offset: i32) -> String {
    let prefix = prefix_at_offset(text.clone(), offset)
    let items = completion_providers::collect_completion_items(state, text.clone(), offset, prefix)
    let mut items_arr = Vec::new<parser::JsonValue>()
    items_arr.push(parser::JsonValue::raw(items))
    let mut result_obj = Vec::new<parser::JsonField>()
    result_obj.push(parser::JsonField::new("isIncomplete", parser::JsonValue::raw("false")))
    result_obj.push(parser::JsonField::new("items", JsonValue::Array(items_arr)))
    let mut fields = Vec::new<parser::JsonField>()
    fields.push(parser::JsonField::new("jsonrpc", parser::JsonValue::string("2.0")))
    fields.push(parser::JsonField::new("id", parser::JsonValue::int(id)))
    fields.push(parser::JsonField::new("result", JsonValue::Object(result_obj)))
    parser::JsonValue::object(fields).to_text()
}
