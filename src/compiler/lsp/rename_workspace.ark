use std::text
use std::json
use analysis::symbol_references
use lsp::positions
fn append_text_edit(edits: String, text: String, start: i32, end: i32, new_text: String) -> String {
    let start_pos = positions::offset_to_position(text.clone(), start)
    let end_pos = positions::offset_to_position(text, end)
    let mut item = String_from("{\"range\":{\"start\":{\"line\":")
    item = item.concat(positions::lsp_position_line(start_pos).to_string())
    item = item.concat(String_from(",\"character\":"))
    item = item.concat(positions::lsp_position_character(start_pos).to_string())
    item = item.concat(String_from("},\"end\":{\"line\":"))
    item = item.concat(positions::lsp_position_line(end_pos).to_string())
    item = item.concat(String_from(",\"character\":"))
    item = item.concat(positions::lsp_position_character(end_pos).to_string())
    item = item.concat(String_from("}},\"newText\":"))
    item = item.concat(json::JsonText::quote(new_text))
    item = item.concat(String_from("}"))
    if edits.len() == 0 {
        return item
    }
    edits.concat(String_from(",")).concat(item)
}

fn append_uri_edits(changes: String, uri: String, edits: String) -> String {
    if edits.len() == 0 {
        return changes
    }
    let mut entry = json::JsonText::quote(uri)
    entry = entry.concat(String_from(":["))
    entry = entry.concat(edits)
    entry = entry.concat(String_from("]"))
    if changes.len() == 0 {
        return entry
    }
    changes.concat(String_from(",")).concat(entry)
}

pub fn collect_workspace_changes(state: LspState, req_uri: String, req_text: String, offset: i32, new_name: String) -> String {
    let refs = symbol_references::collect_semantic_references(req_text.clone(), offset)
    let rn = refs.len()
    let mut edits = String_new()
    let mut ri = 0
    while ri < rn {
        let loc = get_unchecked(refs, ri)
        edits = append_text_edit(edits, req_text.clone(), symbol_references::reference_location_start(loc), symbol_references::reference_location_end(loc), new_name.clone())
        ri = ri + 1
    }
    append_uri_edits(String_new(), req_uri, edits)
}
