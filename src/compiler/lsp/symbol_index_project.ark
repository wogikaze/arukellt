use std::host::fs::Fs
use std::toml
use loader::module_file_load_local
use loader::module_import_paths
use loader::module_package_root
use loader::module_paths
use lsp::state_record
use lsp::symbol_index_paths
use lsp::symbol_index_record
use lsp::symbol_index_update
use compiler::session_parse
use resolver::paths
fn pending_contains(pending: Vec<String>, path: String) -> bool {
    let n = pending.len()
    let mut i = 0
    while i < n {
        if get_unchecked(pending, i).eq(path.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn pending_push_unique(mut pending: Vec<String>, path: String) -> Vec<String> {
    if path.len() == 0 || pending_contains(pending, path.clone()) {
        return pending
    }
    pending.push(path)
    pending
}

fn resolve_import_to_path(import_path: String, base_dir: String, root_dir: String, project_root: String) -> String {
    let base = if import_path.clone().contains(String_from("::")) {
        root_dir
    } else {
        base_dir
    }
    let loaded = module_file_load_local::read_local_module_source(import_path.clone(), base.clone())
    if module_file_load_local::DriverLoadedSource_is_ok(loaded) {
        module_file_load_local::DriverLoadedSource_path(loaded)
    } else {
        if import_path.clone().contains(String_from("::")) {
            let parent_path = paths::use_module_parent_path(import_path.clone())
            if parent_path.clone().len() > 0 {
                let parent = module_file_load_local::read_local_module_source(parent_path.clone(), base_dir.clone())
                if module_file_load_local::DriverLoadedSource_is_ok(parent) {
                    return module_file_load_local::DriverLoadedSource_path(parent)
                }
            }
            return String_new()
        }
        dependency_module_file(project_root.clone(), import_path.clone())
    }
}

fn dependency_module_file(project_root: String, import_name: String) -> String {
    if project_root.len() == 0 || import_name.len() == 0 {
        return String_new()
    }
    let manifest_path = symbol_index_paths::join_path(project_root.clone(), String_from("ark.toml"))
    let read_result = Fs::read_to_string(manifest_path.clone())
    match read_result {
        Result::Ok(content) => {
            let dep_rel = symbol_index_paths::find_dependency_path(content.clone(), import_name.clone())
            if dep_rel.len() == 0 {
                return String_new()
            }
            let dep_root = symbol_index_paths::resolve_relative_path(project_root.clone(), dep_rel)
            let mut dep_manifest = symbol_index_paths::join_path(dep_root.clone(), String_from("ark.toml"))
            let dep_read = Fs::read_to_string(dep_manifest)
            match dep_read {
                Result::Ok(dep_content) => {
                    let pkg_name = toml::TomlText::find_value(dep_content.clone(), String_from("name"))
                    if pkg_name.len() > 0 && import_name.clone().eq(pkg_name.clone()) {
                        let lib_path = toml::TomlText::find_value(dep_content.clone(), String_from("path"))
                        if lib_path.len() > 0 {
                            return symbol_index_paths::join_path(dep_root.clone(), lib_path)
                        }
                        return symbol_index_paths::join_path(dep_root.clone(), String_from("src/lib.ark"))
                    }
                    let dep_src = symbol_index_paths::join_path(dep_root.clone(), String_from("src"))
                    let loaded = module_file_load_local::read_local_module_source(import_name.clone(), dep_src)
                    if module_file_load_local::DriverLoadedSource_is_ok(loaded) {
                        module_file_load_local::DriverLoadedSource_path(loaded)
                    } else {
                        String_new()
                    }
                },
                Result::Err(_) => {
                    String_new()
                },
            }
        },
        Result::Err(_) => {
            String_new()
        },
    }
}

pub fn collect_import_file_paths(decls: Vec<AstNode>, base_dir: String, root_dir: String, project_root: String) -> Vec<String> {
    let mut out = Vec::new<String>()
    let paths = module_import_paths::collect_import_paths(decls)
    let n = paths.len()
    let mut i = 0
    while i < n {
        let import_path = get_unchecked(paths, i)
        if !import_path.clone().contains(String_from("std::")) {
            let file_path = resolve_import_to_path(import_path.clone(), base_dir.clone(), root_dir.clone(), project_root.clone())
            if file_path.len() > 0 {
                out.push(file_path)
            }
        }
        i = i + 1
    }
    out
}

fn project_entry_path(project_root: String) -> String {
    let manifest_path = symbol_index_paths::join_path(project_root.clone(), String_from("ark.toml"))
    let read_result = Fs::read_to_string(manifest_path.clone())
    match read_result {
        Result::Ok(content) => {
            let entry = toml::TomlText::find_value(content.clone(), String_from("path"))
            if entry.len() > 0 {
                let candidate = symbol_index_paths::join_path(project_root.clone(), entry)
                match Fs::read_to_string(candidate.clone()) {
                    Result::Ok(_) => {
                        return candidate
                    },
                    Result::Err(_) => {},
                }
            }
            let lib = symbol_index_paths::join_path(project_root.clone(), String_from("src/lib.ark"))
            match Fs::read_to_string(lib.clone()) {
                Result::Ok(_) => {
                    return lib
                },
                Result::Err(_) => {},
            }
            String_new()
        },
        Result::Err(_) => {
            String_new()
        },
    }
}

fn index_file_at_path(mut state: LspState, file_path: String) {
    let uri = symbol_index_paths::file_path_to_uri(file_path.clone())
    let indexed_uris = state_record::lsp_state_symbol_indexed_uris(state)
    if symbol_index_record::symbol_index_is_indexed(indexed_uris, uri.clone()) {
        return
    }
    let read_result = Fs::read_to_string(file_path.clone())
    match read_result {
        Result::Ok(text) => {
            symbol_index_update::symbol_index_update_uri(state, uri, text)
        },
        Result::Err(_) => {},
    }
}

fn index_import_graph_from(mut state: LspState, start_path: String, project_root: String) {
    let mut pending = pending_push_unique(Vec::new<String>(), start_path.clone())
    let root_dir = module_package_root::find_package_root(project_root.clone())
    let mut pos = 0
    while pos < pending.len() {
        let path = get_unchecked(pending, pos)
        index_file_at_path(state, path.clone())
        let read_result = Fs::read_to_string(path.clone())
        match read_result {
            Result::Ok(text) => {
                let decls = session_parse::session_parse_decls(text.clone())
                let base_dir = module_paths::parent_dir(path.clone())
                let imports = collect_import_file_paths(decls, base_dir, root_dir.clone(), project_root.clone())
                let in_n = imports.len()
                let mut ii = 0
                while ii < in_n {
                    pending = pending_push_unique(pending, get_unchecked(imports, ii))
                    ii = ii + 1
                }
            },
            Result::Err(_) => {},
        }
        pos = pos + 1
    }
}

pub fn symbol_index_load_project(mut state: LspState, project_root: String) {
    if project_root.len() == 0 {
        return
    }
    let entry = project_entry_path(project_root.clone())
    if entry.len() > 0 {
        index_import_graph_from(state, entry, project_root.clone())
    }
}

pub fn symbol_index_project_root_from_uri(root_uri: String) -> String {
    symbol_index_paths::uri_to_file_path(root_uri.clone())
}
