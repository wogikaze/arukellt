use std::text
use std::json
use std::prelude::{clone, to_string}
use lsp::import_graph
use lsp::positions
pub fn completion_item(label: String, kind: i32, detail: String) -> String {
    let mut out = String_from("{\"label\":")
    out = out.concat(json::quote_string(label))
    out = out.concat(String_from(",\"kind\":"))
    out = out.concat(to_string(kind))
    out = out.concat(String_from(",\"detail\":"))
    out = out.concat(json::quote_string(detail))
    out = out.concat(String_from("}"))
    out
}

pub fn completion_item_json(label: String, kind: i32, detail: String, text: String, import_path: String, needs_import: bool) -> String {
    if !needs_import || len(import_path) == 0 {
        return completion_item(label, kind, detail)
    }
    let offset = import_graph::first_use_insert_offset(clone(text))
    let pos = positions::offset_to_position(clone(text), offset)
    let mut out = String_from("{\"label\":")
    out = out.concat(json::quote_string(label))
    out = out.concat(String_from(",\"kind\":"))
    out = out.concat(to_string(kind))
    out = out.concat(String_from(",\"detail\":"))
    out = out.concat(json::quote_string(detail))
    out = out.concat(String_from(",\"additionalTextEdits\":[{\"range\":{\"start\":{\"line\":"))
    out = out.concat(to_string(positions::lsp_position_line(pos)))
    out = out.concat(String_from(",\"character\":"))
    out = out.concat(to_string(positions::lsp_position_character(pos)))
    out = out.concat(String_from("},\"end\":{\"line\":"))
    out = out.concat(to_string(positions::lsp_position_line(pos)))
    out = out.concat(String_from(",\"character\":"))
    out = out.concat(to_string(positions::lsp_position_character(pos)))
    out = out.concat(String_from("}},\"newText\":"))
    out = out.concat(json::quote_string(import_graph::build_use_statement(import_path)))
    out = out.concat(String_from("}]}"))
    out
}

pub fn append_item(items: String, item: String) -> String {
    if len(items) == 0 {
        return item
    }
    items.concat(String_from(",")).concat(item)
}
