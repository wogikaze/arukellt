use std::host::fs::Fs
use lsp::symbol_index_paths
fn roots_contains(roots: Vec<String>, path: String) -> bool {
    let n = roots.len()
    let mut i = 0
    while i < n {
        if get_unchecked(roots, i).eq(path.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

fn roots_push_unique(mut roots: Vec<String>, path: String) -> Vec<String> {
    if path.len() == 0 || roots_contains(roots, path.clone()) {
        return roots
    }
    push(roots, path)
    roots
}

pub fn workspace_roots_from_initialize(body: String) -> Vec<String> {
    let uris = workspace_folder_uris_from_initialize(body.clone())
    let n = uris.len()
    let mut out = Vec::new<String>()
    let mut i = 0
    while i < n {
        let path = symbol_index_paths::uri_to_file_path(get_unchecked(uris, i))
        out = roots_push_unique(out, path)
        i = i + 1
    }
    if out.len() > 0 {
        return out
    }
    let root_uri = symbol_index_paths::root_uri_from_initialize(body.clone())
    if root_uri.len() > 0 {
        out = roots_push_unique(out, symbol_index_paths::uri_to_file_path(root_uri))
    }
    out
}

fn workspace_folder_uris_from_initialize(body: String) -> Vec<String> {
    let pos = body.clone().index_of("workspaceFolders")
    if pos < 0 {
        return Vec::new<String>()
    }
    let tail = body.slice(pos, body.len())
    let arr_start = tail.clone().index_of("[")
    if arr_start < 0 {
        return Vec::new<String>()
    }
    let arr_end = tail.clone().index_of("]")
    if arr_end < arr_start {
        return Vec::new<String>()
    }
    let section = tail.slice(arr_start, arr_end)
    let mut out = Vec::new<String>()
    let mut scan = 0
    let section_len = section.len()
    while scan < section_len {
        let rest = section.slice(scan, section_len)
        let uri_pos = rest.clone().index_of("\"uri\"")
        if uri_pos < 0 {
            break
        }
        let uri = symbol_index_paths::extract_json_string_field(rest.slice(uri_pos, rest.len()), "uri")
        if uri.len() > 0 {
            out = roots_push_unique(out, uri)
        }
        scan = scan + uri_pos + 5
    }
    out
}

pub fn find_package_root(start_dir: String) -> String {
    if start_dir.len() == 0 {
        return String_new()
    }
    // Avoid the `Fs` read probe on wasm32-gc (GC String → i64 scratch validate fail).
    let manifest = symbol_index_paths::join_path(start_dir.clone(), "ark.toml")
    match Fs::read_to_string(manifest.clone()) {
        Result::Ok(_) => {
            return start_dir
        },
        Result::Err(_) => {},
    }
    let parent = loader::module_paths::parent_dir(start_dir.clone())
    if parent.clone().eq(start_dir.clone()) {
        return String_new()
    }
    find_package_root(parent)
}

pub fn watched_files_body_has_ark_toml(body: String) -> bool {
    body.clone().contains("ark.toml")
}
