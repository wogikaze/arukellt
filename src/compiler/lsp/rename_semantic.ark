use std::text
use std::json
use analysis::ident_span
use analysis::symbol_references
use analysis::symbols
use lexer::keywords
use lsp::feature_request
use lsp::positions
use lsp::rename_workspace
use lsp::responses
fn null_result(id: i32) -> String {
    responses::build_null_response(id)
}

fn is_keyword_name(name: String) -> bool {
    keywords::is_reserved_name(name.clone())
}

fn is_renamable_at_offset(text: String, offset: i32) -> bool {
    let refs = symbol_references::collect_semantic_references(text.clone(), offset)
    if refs.len() > 0 {
        return true
    }
    let span = symbols::ident_span_at_offset(text.clone(), offset)
    if !ident_span::ident_span_found(span) {
        return false
    }
    !is_keyword_name(ident_span::ident_span_name(span))
}

fn build_prepare_rename_response(id: i32, text: String, offset: i32) -> String {
    if !is_renamable_at_offset(text.clone(), offset) {
        return null_result(id)
    }
    let refs = symbol_references::collect_semantic_references(text.clone(), offset)
    let mut start = 0
    let mut end = 0
    let mut name = String_new()
    if refs.len() > 0 {
        let loc = refs.get_unchecked(0)
        start = symbol_references::reference_location_start(loc)
        end = symbol_references::reference_location_end(loc)
        name = text.clone().slice(start, end)
    } else {
        let span = symbols::ident_span_at_offset(text.clone(), offset)
        if !ident_span::ident_span_found(span) {
            return null_result(id)
        }
        start = ident_span::ident_span_start(span)
        end = ident_span::ident_span_end(span)
        name = ident_span::ident_span_name(span)
    }
    let start_pos = positions::offset_to_position(text.clone(), start)
    let end_pos = positions::offset_to_position(text, end)
    let mut body = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
    body = body.concat(id.to_string())
    body = body.concat(String_from(",\"result\":{\"range\":{\"start\":{\"line\":"))
    body = body.concat(positions::lsp_position_line(start_pos).to_string())
    body = body.concat(String_from(",\"character\":"))
    body = body.concat(positions::lsp_position_character(start_pos).to_string())
    body = body.concat(String_from("},\"end\":{\"line\":"))
    body = body.concat(positions::lsp_position_line(end_pos).to_string())
    body = body.concat(String_from(",\"character\":"))
    body = body.concat(positions::lsp_position_character(end_pos).to_string())
    body = body.concat(String_from("}},\"placeholder\":"))
    body = body.concat(json::JsonText::quote(name))
    body = body.concat(String_from("}}"))
    body
}

fn build_rename_response(id: i32, changes: String) -> String {
    let mut body = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
    body = body.concat(id.to_string())
    body = body.concat(String_from(",\"result\":{\"changes\":{"))
    body = body.concat(changes)
    body = body.concat(String_from("}}}"))
    body
}

pub fn build_prepare_rename_response_for_request(state: LspState, body: String, id: i32) -> String {
    let req = feature_request::read_text_position_request(state, body.clone())
    if !feature_request::text_position_request_has_text(req) {
        return null_result(id)
    }
    build_prepare_rename_response(id, feature_request::text_position_request_text(req), feature_request::text_position_request_offset(req))
}

pub fn build_rename_response_for_request(state: LspState, body: String, id: i32) -> String {
    let req = feature_request::read_text_position_request(state, body.clone())
    if !feature_request::text_position_request_has_text(req) {
        return null_result(id)
    }
    let req_text = feature_request::text_position_request_text(req)
    let offset = feature_request::text_position_request_offset(req)
    if !is_renamable_at_offset(req_text.clone(), offset) {
        return null_result(id)
    }
    let new_name = json::JsonText::get_str(body.clone(), String_from("newName"))
    if new_name.len() == 0 || is_keyword_name(new_name.clone()) {
        return null_result(id)
    }
    let changes = rename_workspace::collect_workspace_changes(state, feature_request::text_position_request_uri(req), req_text.clone(), offset, new_name)
    if changes.len() == 0 {
        return null_result(id)
    }
    build_rename_response(id, changes)
}
