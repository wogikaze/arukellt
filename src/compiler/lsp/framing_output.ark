use std::text
use lsp::state_record
fn frame(body: String) -> String {
    let header = "Content-Length: ".concat(len(body.clone()).to_string().concat("\r\n\r\n"))
    header.concat(body)
}

fn append_framed(mut state: LspState, body: String) {
    state_record::lsp_state_append_output(state, frame(body))
}
