use std::prelude::{clone, to_string}
use std::text
use lsp::state_record
fn frame(body: String) -> String {
    let header = "Content-Length: ".concat(to_string(len(clone(body))).concat("\r\n\r\n"))
    header.concat(body)
}

fn append_framed(state: LspState, body: String) {
    state_record::lsp_state_append_output(state, frame(body))
}
