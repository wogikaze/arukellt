use std::prelude::{eq}
use lsp::feature_folding_range
use lsp::feature_selection_range
fn dispatch_structure_features(mut state: LspState, body: String, method: String) -> bool {
    if eq(method.clone(), "textDocument/foldingRange") {
        feature_folding_range::handle_folding_range(state, body.clone())
        return true
    }
    if eq(method.clone(), "textDocument/selectionRange") {
        feature_selection_range::handle_selection_range(state, body.clone())
        return true
    }
    false
}
