use std::text
pub fn file_path_to_uri(path: String) -> String {
    if path.clone().starts_with("file://") {
        return path
    }
    "file://".concat(path)
}

pub fn uri_to_file_path(uri: String) -> String {
    if uri.clone().starts_with("file://") {
        return uri.slice(7, uri.len())
    }
    uri
}

pub fn root_uri_from_initialize(body: String) -> String {
    let root_uri = extract_json_string_field(body.clone(), "rootUri")
    if root_uri.len() > 0 {
        return root_uri
    }
    extract_workspace_folder_uri(body.clone())
}

fn extract_workspace_folder_uri(body: String) -> String {
    let pos = body.clone().index_of("workspaceFolders")
    if pos < 0 {
        return String_new()
    }
    let uri_pos = body.slice(pos, body.len()).index_of("\"uri\"")
    if uri_pos < 0 {
        return String_new()
    }
    extract_json_string_field(body.slice(pos + uri_pos, body.len()), "uri")
}

pub fn extract_json_string_field(body: String, key: String) -> String {
    let key_pat = "\"".concat(key.clone()).concat("\"")
    let pos = body.clone().index_of(key_pat)
    if pos < 0 {
        return String_new()
    }
    let tail = body.slice(pos, body.len())
    let colon = tail.clone().index_of(":")
    if colon < 0 {
        return String_new()
    }
    let after = tail.slice(colon + 1, tail.len())
    let after_len = after.len()
    let mut p = 0
    while p < after_len {
        let c = after.byte_at(p)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        p = p + 1
    }
    if p < after_len && after.byte_at(p) == 110 && after.slice(p, after_len).starts_with("null") {
        return String_new()
    }
    if p >= after_len || after.byte_at(p) != 34 {
        return String_new()
    }
    let rest = after.slice(p + 1, after_len)
    let q2 = rest.clone().index_of("\"")
    if q2 < 0 {
        return String_new()
    }
    rest.slice(0, q2)
}

pub fn join_path(base: String, rel: String) -> String {
    if base.len() == 0 {
        return rel
    }
    if base.clone().ends_with("/") {
        return base.concat(rel)
    }
    base.concat("/").concat(rel)
}

pub fn resolve_relative_path(base: String, rel: String) -> String {
    if rel.len() == 0 {
        return base.clone()
    }
    if rel.clone().starts_with("../") {
        let parent = loader::module_paths::parent_dir(base.clone())
        return resolve_relative_path(parent, rel.slice(3, rel.len()))
    }
    if rel.clone().starts_with("./") {
        return resolve_relative_path(base.clone(), rel.slice(2, rel.len()))
    }
    join_path(base.clone(), rel)
}

pub fn find_dependency_path(content: String, dep_name: String) -> String {
    let needle = dep_name.clone().concat(" = { path = \"")
    let pos = content.clone().index_of(needle)
    if pos < 0 {
        return String_new()
    }
    let tail = content.slice(pos + needle.len(), content.len())
    let end = tail.clone().index_of("\"")
    if end < 0 {
        return String_new()
    }
    tail.slice(0, end)
}
