use lsp::dispatch_features_core
use lsp::dispatch_features_structure
fn dispatch_features(mut state: LspState, body: String, method: String) -> bool {
    if dispatch_features_structure::dispatch_structure_features(state, body.clone(), method.clone()) {
        return true
    }
    dispatch_features_core::dispatch_core_features(state, body, method)
}
