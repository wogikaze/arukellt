use std::host::fs::Fs
use std::toml
use std::text
use lsp::kinds
use lsp::state_record
use lsp::symbol_index_paths
use lsp::symbol_index_record

struct ManifestParseState {
    section: i32,
    name: String,
    module: String,
    params: String,
    returns: String,
    doc: String,
}

fn ManifestParseState_new() -> ManifestParseState {
    ManifestParseState { section: 0, name: String_new(), module: String_new(), params: String_new(), returns: String_new(), doc: String_new() }
}

fn stdlib_module_to_source_uri(module_path: String) -> String {
    let rel = (module_path.clone()).replace(String_from("::"), String_from("/"))
    symbol_index_paths::file_path_to_uri(rel.concat(String_from(".ark")))
}

fn render_manifest_signature(name: String, params: String, returns: String) -> String {
    let mut sig = String_from("fn ").concat(name.clone())
    sig = sig.concat(String_from("("))
    if len(params) > 0 {
        sig = sig.concat(String_from("s: ").concat(params))
    }
    sig = sig.concat(String_from(")"))
    if len(returns) > 0 {
        sig = sig.concat(String_from(" -> ").concat(returns))
    }
    sig
}

fn push_function_symbol(mut out: Vec<symbol_index_record::StdlibIndexedSymbol>, name: String, module_path: String, detail: String, doc: String) {
    let nm = name.clone()
    push(out, symbol_index_record::StdlibIndexedSymbol_new(name, kinds::LSP_SYMBOL_FUNCTION(), detail, module_path, stdlib_module_to_source_uri(module_path.clone()), 0, len(nm), doc))
}

fn push_type_symbol(mut out: Vec<symbol_index_record::StdlibIndexedSymbol>, name: String) {
    let detail = String_from("type ").concat(name.clone())
    push(out, symbol_index_record::StdlibIndexedSymbol_new(name, kinds::LSP_SYMBOL_STRUCT(), detail, String_new(), String_new(), 0, len(detail), String_new()))
}

fn flush_function_symbol(mut out: Vec<symbol_index_record::StdlibIndexedSymbol>, state: ManifestParseState) {
    if len(state.name) > 0 && len(state.module) > 0 {
        let detail = render_manifest_signature(state.name.clone(), state.params.clone(), state.returns.clone())
        push_function_symbol(out, state.name, state.module, detail, state.doc)
    }
}

fn apply_manifest_line(out: Vec<symbol_index_record::StdlibIndexedSymbol>, state: ManifestParseState, line: String) -> ManifestParseState {
    // Full TOML walk poisoned ManifestParseState locals to String on wasm32-gc
    // (#730). Fs::read_to_string is already a GC stub, so stdlib symbols stay
    // empty at runtime; keep a validate-safe passthrough until record locals fix.
    let _out = out
    let _line = line
    state
}

pub fn trim_brackets(raw: String) -> String {
    let n = len(raw)
    let mut start = 0
    while start < n && raw.byte_at(start) == 32 {
        start = start + 1
    }
    let mut end = n
    while end > start && raw.byte_at(end - 1) == 32 {
        end = end - 1
    }
    let s = raw.slice(start, end)
    let sn = len(s)
    if sn >= 2 && s.byte_at(0) == 91 {
        let inner = s.slice(1, sn - 1)
        let in_n = len(inner)
        if in_n >= 2 && inner.byte_at(0) == 34 {
            return inner.slice(1, in_n - 1)
        }
        return inner
    }
    s
}

fn apply_manifest_fields(mut state: ManifestParseState, line: String) -> ManifestParseState {
    let key_doc = toml::TomlText::find_value(line.clone(), String_from("doc"))
    if len(key_doc) > 0 {
        state.doc = key_doc
    }
    if line.clone().contains(String_from("params =")) {
        let eq_pos = line.clone().index_of(String_from("="))
        if eq_pos >= 0 {
            state.params = trim_brackets(line.slice(eq_pos + 1, len(line)))
        }
    }
    let key_ret = toml::TomlText::find_value(line.clone(), String_from("returns"))
    if len(key_ret) > 0 {
        state.returns = key_ret
    }
    let key_module = toml::TomlText::find_value(line.clone(), String_from("module"))
    if len(key_module) > 0 {
        state.module = key_module
    }
    state
}

fn parse_manifest_symbols(content: String) -> Vec<symbol_index_record::StdlibIndexedSymbol> {
    let _content = content
    Vec::new<StdlibIndexedSymbol>()
}

fn manifest_load_path() -> String {
    // The ARUKELLT_MANIFEST env override is disabled.
    String_from("std/manifest.toml")
}

pub fn symbol_index_load_stdlib(mut state: LspState) {
    let read_result = Fs::read_to_string(manifest_load_path())
    match read_result {
        Result::Ok(content) => {
            state_record::lsp_state_set_symbol_stdlib_symbols(state, parse_manifest_symbols(content))
        },
        Result::Err(_) => {
            state_record::lsp_state_set_symbol_stdlib_symbols(state, Vec::new<StdlibIndexedSymbol>())
        },
    }
}
