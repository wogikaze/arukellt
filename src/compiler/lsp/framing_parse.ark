use lsp::framing_record
fn parse_frame(input: String, pos: i32) -> FrameResult {
    let n = len(input)
    let mut p = pos
    while p < n {
        let c = input.byte_at(p)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        p = p + 1
    }
    if p >= n {
        return framing_record::FrameResult_new(String_new(), n, false)
    }
    let header_end_rel = input.clone().slice(p, n).index_of("\r\n\r\n")
    if header_end_rel < 0 {
        return framing_record::FrameResult_new(String_new(), n, false)
    }
    let header_block = input.clone().slice(p, p + header_end_rel)
    let cl_idx = header_block.clone().index_of("Content-Length:")
    if cl_idx < 0 {
        return framing_record::FrameResult_new(String_new(), n, false)
    }
    let block_len = len(header_block)
    let mut q = cl_idx + 15
    while q < block_len {
        let c = header_block.byte_at(q)
        if c != 32 && c != 9 {
            break
        }
        q = q + 1
    }
    let mut clen = 0
    while q < block_len {
        let c = header_block.byte_at(q)
        if c < 48 || c > 57 {
            break
        }
        clen = clen * 10 + (c - 48)
        q = q + 1
    }
    let body_start = p + header_end_rel + 4
    if body_start + clen > n {
        return framing_record::FrameResult_new(String_new(), n, false)
    }
    let body = input.clone().slice(body_start, body_start + clen)
    framing_record::FrameResult_new(body, body_start + clen, true)
}
