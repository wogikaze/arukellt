use std::prelude::{eq}
use lsp::documents
use lsp::state_record
fn dispatch_documents(mut state: LspState, body: String, method: String) -> bool {
    if eq(method.clone(), "textDocument/didOpen") {
        documents::handle_did_open(state, body.clone())
        return true
    }
    if eq(method.clone(), "textDocument/didChange") {
        documents::handle_did_change(state, body.clone())
        return true
    }
    if eq(method.clone(), "textDocument/didClose") {
        documents::handle_did_close(state, body.clone())
        return true
    }
    if eq(method.clone(), "textDocument/didSave") {
        documents::handle_did_save(state, body.clone())
        return true
    }
    if eq(method.clone(), "workspace/didChangeWatchedFiles") {
        documents::handle_did_change_watched_files(state, body.clone())
        return true
    }
    false
}
