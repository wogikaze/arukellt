use std::text
use std::json
use std::prelude::{clone, to_string}
use analysis
use analysis::diagnostic_record
use lsp::diag_position
fn phase_code(phase: i32) -> String {
    if phase == analysis::PHASE_LEX() {
        return String_from("ark.lex")
    }
    if phase == analysis::PHASE_PARSE() {
        return String_from("ark.parse")
    }
    if phase == analysis::PHASE_RESOLVE() {
        return String_from("ark.resolve")
    }
    if phase == analysis::PHASE_TYPECHECK() {
        return String_from("ark.typecheck")
    }
    if phase == analysis::PHASE_LINT() {
        return String_from("arukellt-lint")
    }
    String_from("ark.unknown")
}

fn build_diagnostic_object(text: String, diag: AnalysisDiagnostic) -> String {
    let s = diag_position::offset_to_diag_position(clone(text), diagnostic_record::analysis_diagnostic_start(diag))
    let e = diag_position::offset_to_diag_position(clone(text), diagnostic_record::analysis_diagnostic_end(diag))
    let mut out = String_from("{\"range\":{\"start\":{\"line\":")
    out = out.concat(to_string(diag_position::lsp_diag_position_line(s)))
    out = out.concat(String_from(",\"character\":"))
    out = out.concat(to_string(diag_position::lsp_diag_position_character(s)))
    out = out.concat(String_from("},\"end\":{\"line\":"))
    out = out.concat(to_string(diag_position::lsp_diag_position_line(e)))
    out = out.concat(String_from(",\"character\":"))
    out = out.concat(to_string(diag_position::lsp_diag_position_character(e)))
    out = out.concat(String_from("}},\"severity\":"))
    let sev = if diagnostic_record::analysis_diagnostic_phase(diag) == analysis::PHASE_LINT() {
        2
    } else {
        1
    }
    out = out.concat(to_string(sev))
    out = out.concat(String_from(",\"source\":\"arukellt\",\"code\":"))
    out = out.concat(json::quote_string(phase_code(diagnostic_record::analysis_diagnostic_phase(diag))))
    out = out.concat(String_from(",\"message\":"))
    out = out.concat(json::quote_string(diagnostic_record::analysis_diagnostic_message(diag)))
    out = out.concat(String_from("}"))
    out
}
// Lint diagnostics are warnings (severity 2), others are errors (severity 1)
