use std::host::fs::Fs
use compiler::session_parse
use lsp::state_record
use lsp::symbol_index_paths
use lsp::symbol_index_project
use lsp::symbol_index_record
use lsp::symbol_index_update
fn index_import_neighbors(mut state: LspState, file_path: String, project_root: String) {
    let read_result = Fs::read_to_string(file_path.clone())
    match read_result {
        Result::Ok(text) => {
            let decls = session_parse::session_parse_decls(text.clone())
            let base_dir = loader::parent_dir(file_path.clone())
            let root_dir = loader::module_package_root::find_package_root(if project_root.len() > 0 { project_root.clone() } else { base_dir.clone() })
            let imports = symbol_index_project::collect_import_file_paths(decls, base_dir, root_dir, project_root.clone())
            let indexed_uris = state_record::lsp_state_symbol_indexed_uris(state)
            let n = imports.len()
            let mut i = 0
            while i < n {
                let import_path = imports.get_unchecked(i)
                let uri = symbol_index_paths::file_path_to_uri(import_path.clone())
                if !symbol_index_record::symbol_index_is_indexed(indexed_uris, uri.clone()) {
                    let import_read = Fs::read_to_string(import_path.clone())
                    match import_read {
                        Result::Ok(import_text) => {
                            symbol_index_update::symbol_index_update_uri(state, uri, import_text)
                        },
                        Result::Err(_) => {},
                    }
                }
                i = i + 1
            }
        },
        Result::Err(_) => {},
    }
}

pub fn symbol_index_update_open_file_with_imports(mut state: LspState, uri: String, text: String, project_root: String) {
    symbol_index_update::symbol_index_update_uri(state, uri.clone(), text.clone())
    let file_path = symbol_index_paths::uri_to_file_path(uri.clone())
    if file_path.len() > 0 {
        index_import_neighbors(state, file_path, project_root.clone())
    }
}
