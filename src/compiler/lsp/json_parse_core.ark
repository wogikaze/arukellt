//
// Delegates to std::json (issue #704).

use std::json

fn json_skip_ws(s: String, pos: i32) -> i32 {
    json::skip_ws(s, pos)
}

fn find_key_pos(json: String, key: String, from: i32) -> i32 {
    json::find_key_pos(json, key, from)
}

fn json_parse_string_at(s: String, pos: i32) -> json::JsonStrResult {
    json::json_parse_string_at(s, pos)
}

fn json_parse_int_at(s: String, pos: i32) -> i32 {
    json::parse_int_at(s, pos)
}
