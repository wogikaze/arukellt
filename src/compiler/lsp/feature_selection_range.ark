use std::text
use std::json
use std::prelude::{clone}
use lsp::feature_request
use lsp::framing
use lsp::positions
use lsp::responses
use lsp::state_record
use lsp::state_docs
use lsp::source_text
pub fn handle_selection_range(mut state: LspState, body: String) {
    let req_id = json::JsonText::get_int(clone(body), String_from("id"))
    let uri = json::JsonText::get_str(clone(body), String_from("uri"))
    let mut text = state_docs::lsp_doc_store_lookup_text(state_record::lsp_state_doc_store(state), clone(uri))
    if len(text) == 0 {
        text = source_text::text_for_uri(state, clone(uri))
    }
    if len(text) == 0 {
        framing::append_framed(state, responses::build_null_response(req_id))
        return
    }
    let line = json::JsonText::get_int(clone(body), String_from("line"))
    let character = json::JsonText::get_int(clone(body), String_from("character"))
    let mut out = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
    out = out.concat(req_id.to_string())
    out = out.concat(String_from(",\"result\":{\"ranges\":[{\"range\":{\"start\":{\"line\":"))
    out = out.concat(line.to_string())
    out = out.concat(String_from(",\"character\":"))
    out = out.concat(character.to_string())
    out = out.concat(String_from("},\"end\":{\"line\":"))
    out = out.concat(line.to_string())
    out = out.concat(String_from(",\"character\":"))
    out = out.concat((character + 1).to_string())
    out = out.concat(String_from("}}}]}}"))
    framing::append_framed(state, out)
}
