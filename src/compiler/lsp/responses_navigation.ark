use std::text
use std::json
use std::prelude::{clone, to_string}
use lsp::positions
fn build_hover_response(id: i32, markdown: String, start: LspPosition, end: LspPosition) -> String {
    let mut body = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
    body = body.concat(to_string(id))
    body = body.concat(String_from(",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":"))
    body = body.concat(json::quote_string(markdown))
    body = body.concat(String_from("},\"range\":{\"start\":{\"line\":"))
    body = body.concat(to_string(positions::lsp_position_line(start)))
    body = body.concat(String_from(",\"character\":"))
    body = body.concat(to_string(positions::lsp_position_character(start)))
    body = body.concat(String_from("},\"end\":{\"line\":"))
    body = body.concat(to_string(positions::lsp_position_line(end)))
    body = body.concat(String_from(",\"character\":"))
    body = body.concat(to_string(positions::lsp_position_character(end)))
    body = body.concat(String_from("}}}}"))
    body
}

pub fn location_json(uri: String, text: String, start: i32, end: i32) -> String {
    let start_pos = positions::offset_to_position(clone(text), start)
    let end_pos = positions::offset_to_position(text, end)
    let mut out = String_from("{\"uri\":")
    out = out.concat(json::quote_string(uri))
    out = out.concat(String_from(",\"range\":{\"start\":{\"line\":"))
    out = out.concat(to_string(positions::lsp_position_line(start_pos)))
    out = out.concat(String_from(",\"character\":"))
    out = out.concat(to_string(positions::lsp_position_character(start_pos)))
    out = out.concat(String_from("},\"end\":{\"line\":"))
    out = out.concat(to_string(positions::lsp_position_line(end_pos)))
    out = out.concat(String_from(",\"character\":"))
    out = out.concat(to_string(positions::lsp_position_character(end_pos)))
    out = out.concat(String_from("}}}"))
    out
}

fn build_definition_response(id: i32, uri: String, start: LspPosition, end: LspPosition) -> String {
    let mut body = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
    body = body.concat(to_string(id))
    body = body.concat(String_from(",\"result\":{\"uri\":"))
    body = body.concat(json::quote_string(uri))
    body = body.concat(String_from(",\"range\":{\"start\":{\"line\":"))
    body = body.concat(to_string(positions::lsp_position_line(start)))
    body = body.concat(String_from(",\"character\":"))
    body = body.concat(to_string(positions::lsp_position_character(start)))
    body = body.concat(String_from("},\"end\":{\"line\":"))
    body = body.concat(to_string(positions::lsp_position_line(end)))
    body = body.concat(String_from(",\"character\":"))
    body = body.concat(to_string(positions::lsp_position_character(end)))
    body = body.concat(String_from("}}}}"))
    body
}
