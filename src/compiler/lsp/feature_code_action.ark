use std::text
use std::json
use analysis::ident_span
use analysis::symbols
use lsp::feature_request
use lsp::framing
use lsp::import_graph
use lsp::organize_imports
use lsp::positions
use lsp::responses
use lsp::state_record
use lsp::symbol_index_lookup
use lsp::symbol_index_record
fn build_import_action(title: String, uri: String, import_path: String, text: String) -> String {
    let offset = import_graph::first_use_insert_offset(text.clone())
    let pos = positions::offset_to_position(text.clone(), offset)
    let mut out = String_from("{\"title\":")
    out = out.concat(json::JsonText::quote(title))
    out = out.concat(String_from(",\"kind\":\"quickfix\",\"edit\":{\"changes\":{"))
    out = out.concat(json::JsonText::quote(uri))
    out = out.concat(String_from(":[{\"range\":{\"start\":{\"line\":"))
    out = out.concat(positions::lsp_position_line(pos).to_string())
    out = out.concat(String_from(",\"character\":"))
    out = out.concat(positions::lsp_position_character(pos).to_string())
    out = out.concat(String_from("},\"end\":{\"line\":"))
    out = out.concat(positions::lsp_position_line(pos).to_string())
    out = out.concat(String_from(",\"character\":"))
    out = out.concat(positions::lsp_position_character(pos).to_string())
    out = out.concat(String_from("}},\"newText\":"))
    out = out.concat(json::JsonText::quote(import_graph::build_use_statement(import_path)))
    out = out.concat(String_from("}]}}}"))
    out
}

fn build_import_actions_json(state: LspState, uri: String, text: String, name: String) -> String {
    let stdlib = state_record::lsp_state_symbol_stdlib_symbols(state)
    let sn = len(stdlib)
    let mut j = 0
    let mut actions = String_new()
    while j < sn {
        let sym = get_unchecked(stdlib, j)
        if symbol_index_record::stdlib_indexed_symbol_name(sym).eq(name.clone()) {
            let module_path = symbol_index_record::stdlib_indexed_symbol_module_path(sym)
            if len(module_path) > 0 {
                let import_path = import_graph::stdlib_import_path(module_path.clone(), name.clone())
                if !import_graph::is_path_imported(text.clone(), import_path.clone()) {
                    let title = String_from("Import '").concat(import_path.clone()).concat(String_from("'"))
                    if len(actions) > 0 {
                        actions = actions.concat(String_from(","))
                    }
                    actions = actions.concat(build_import_action(title, uri, import_path, text.clone()))
                }
            }
        }
        j = j + 1
    }
    actions
}

pub fn handle_code_action(mut state: LspState, body: String) {
    let req = feature_request::read_text_position_request(state, body.clone())
    let req_id = feature_request::text_position_request_id(req)
    if !feature_request::text_position_request_has_text(req) {
        framing::append_framed(state, responses::build_empty_array_response(req_id))
        return
    }
    let req_text = feature_request::text_position_request_text(req)
    let req_uri = feature_request::text_position_request_uri(req)
    if organize_imports::request_wants_fix_all(body.clone()) {
        let fix_all = organize_imports::build_fix_all_action(req_uri.clone(), req_text.clone())
        let mut body_out = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
        body_out = body_out.concat(req_id.to_string())
        body_out = body_out.concat(String_from(",\"result\":["))
        if len(fix_all) > 0 {
            body_out = body_out.concat(fix_all)
        }
        body_out = body_out.concat(String_from("]}"))
        framing::append_framed(state, body_out)
        return
    }
    if organize_imports::request_wants_organize_imports(body.clone()) {
        let organize = organize_imports::build_organize_imports_action(req_uri.clone(), req_text.clone())
        let mut body_out = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
        body_out = body_out.concat(req_id.to_string())
        body_out = body_out.concat(String_from(",\"result\":["))
        if len(organize) > 0 {
            body_out = body_out.concat(organize)
        }
        body_out = body_out.concat(String_from("]}"))
        framing::append_framed(state, body_out)
        return
    }
    let offset = feature_request::text_position_request_offset(req)
    let span = symbols::ident_span_at_offset(req_text.clone(), offset)
    if !ident_span::ident_span_found(span) {
        framing::append_framed(state, responses::build_empty_array_response(req_id))
        return
    }
    let name = ident_span::ident_span_name(span)
    let def = symbol_index_lookup::lookup_definition(state, name.clone())
    if symbol_index_lookup::index_definition_found(def) {
        framing::append_framed(state, responses::build_empty_array_response(req_id))
        return
    }
    let actions = build_import_actions_json(state, req_uri.clone(), req_text.clone(), name.clone())
    let mut body_out = String_from("{\"jsonrpc\":\"2.0\",\"id\":")
    body_out = body_out.concat(req_id.to_string())
    body_out = body_out.concat(String_from(",\"result\":["))
    body_out = body_out.concat(actions)
    body_out = body_out.concat(String_from("]}"))
    framing::append_framed(state, body_out)
}
