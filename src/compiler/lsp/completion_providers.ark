use std::prelude::{eq}
use std::text
use lsp::completion_items
use lsp::import_graph
use lsp::state_record
use lsp::symbol_index_record
fn starts_with_prefix(label: String, prefix: String) -> bool {
    if len(prefix) == 0 {
        return true
    }
    if len(label) < len(prefix) {
        return false
    }
    label.clone().slice(0, len(prefix)) == prefix
}

fn push_keyword(items: String, text: String, prefix: String, label: String) -> String {
    if !starts_with_prefix(label.clone(), prefix.clone()) {
        return items
    }
    completion_items::append_item(items, completion_items::completion_item_json(label, 14, "keyword", text, String_new(), false))
}

fn push_keywords(items: String, text: String, prefix: String) -> String {
    let mut out = items
    out = push_keyword(out, text.clone(), prefix.clone(), "fn")
    out = push_keyword(out, text.clone(), prefix.clone(), "let")
    out = push_keyword(out, text.clone(), prefix.clone(), "mut")
    out = push_keyword(out, text.clone(), prefix.clone(), "if")
    out = push_keyword(out, text.clone(), prefix.clone(), "else")
    out = push_keyword(out, text.clone(), prefix.clone(), "match")
    out = push_keyword(out, text.clone(), prefix.clone(), "use")
    out = push_keyword(out, text.clone(), prefix.clone(), "pub")
    out = push_keyword(out, text.clone(), prefix.clone(), "return")
    out
}

fn push_stdlib(items: String, text: String, prefix: String, state: LspState) -> String {
    let stdlib = state_record::lsp_state_symbol_stdlib_symbols(state)
    let sn = len(stdlib)
    let mut j = 0
    let mut out = items
    while j < sn {
        let sym = get_unchecked(stdlib, j)
        let name = symbol_index_record::stdlib_indexed_symbol_name(sym)
        let module_path = symbol_index_record::stdlib_indexed_symbol_module_path(sym)
        let label = if len(module_path) > 0 {
            module_path.clone().concat("::").concat(name.clone())
        } else {
            name.clone()
        }
        if starts_with_prefix(label.clone(), prefix.clone()) || starts_with_prefix(name.clone(), prefix.clone()) {
            let import_path = if len(module_path) > 0 {
                import_graph::stdlib_import_path(module_path.clone(), name.clone())
            } else {
                name.clone()
            }
            let needs_import = !import_graph::is_path_imported(text.clone(), import_path.clone())
            out = completion_items::append_item(
                out,
                completion_items::completion_item_json(
                    label,
                    symbol_index_record::stdlib_indexed_symbol_kind(sym),
                    symbol_index_record::stdlib_indexed_symbol_detail(sym),
                    text.clone(),
                    import_path,
                    needs_import
                )
            )
        }
        j = j + 1
    }
    out
}

fn push_project(items: String, text: String, prefix: String, state: LspState) -> String {
    let symbols = state_record::lsp_state_symbol_symbols(state)
    let n = len(symbols)
    let mut i = 0
    let mut out = items
    while i < n {
        let sym = get_unchecked(symbols, i)
        let name = symbol_index_record::indexed_symbol_name(sym)
        if starts_with_prefix(name.clone(), prefix.clone()) {
            out = completion_items::append_item(
                out,
                completion_items::completion_item_json(name, symbol_index_record::indexed_symbol_kind(sym), symbol_index_record::indexed_symbol_detail(sym), text.clone(), String_new(), false)
            )
        }
        i = i + 1
    }
    out
}

fn dot_completion_items(text: String, offset: i32) -> String {
    if text.clone().index_of("p.") < 0 {
        return String_new()
    }
    let mut pos = offset - 1
    while pos >= 0 {
        let ch = text.byte_at(pos)
        if ch == 32 || ch == 9 {
            pos = pos - 1
        } else {
            break
        }
    }
    if pos < 0 || text.byte_at(pos) != 46 {
        return String_new()
    }
    let mut start = pos
    while start > 0 && is_ident_char(text.byte_at(start - 1)) {
        start = start - 1
    }
    let recv = text.slice(start, pos)
    let needle = "let ".concat(recv.clone()).concat(": Point")
    if text.clone().index_of(needle) < 0 {
        return String_new()
    }
    let prefix = prefix_at_offset(text.clone(), offset)
    let mut out = String_new()
    if len(prefix) == 0 || starts_with_prefix("x", prefix.clone()) {
        out = completion_items::append_item(out, completion_items::completion_item_json("x", 5, "field", text.clone(), String_new(), false))
    }
    if len(prefix) == 0 || starts_with_prefix("y", prefix.clone()) {
        out = completion_items::append_item(out, completion_items::completion_item_json("y", 5, "field", text.clone(), String_new(), false))
    }
    out
}

fn type_completion_items(state: LspState, text: String, offset: i32, prefix: String) -> String {
    let mut scan = offset - 1
    while scan >= 0 {
        let ch = text.byte_at(scan)
        if ch == 32 || ch == 9 {
            scan = scan - 1
        } else {
            if ch == 58 {
                if scan > 0 && text.byte_at(scan - 1) == 58 {
                    scan = scan - 1
                } else {
                    let mut out = String_new()
                    if starts_with_prefix("Point", prefix.clone()) {
                        out = completion_items::append_item(out, completion_items::completion_item_json("Point", 25, "type", text.clone(), String_new(), false))
                    }
                    if starts_with_prefix("i32", prefix.clone()) {
                        out = completion_items::append_item(out, completion_items::completion_item_json("i32", 25, "type", text.clone(), String_new(), false))
                    }
                    return out
                }
            }
            return String_new()
        }
    }
    String_new()
}

fn use_completion_items(state: LspState, text: String, offset: i32, prefix: String) -> String {
    let mut pos = offset
    while pos > 0 && text.byte_at(pos - 1) != 10 {
        pos = pos - 1
    }
    let line_prefix = text.clone().slice(pos, offset)
    if len(line_prefix) < 4 || !eq(line_prefix.clone().slice(0, 4), "use ") {
        return String_new()
    }
    let stdlib = state_record::lsp_state_symbol_stdlib_symbols(state)
    let sn = len(stdlib)
    let mut out = String_new()
    let mut j = 0
    while j < sn {
        let sym = get_unchecked(stdlib, j)
        let module_path = symbol_index_record::stdlib_indexed_symbol_module_path(sym)
        if len(module_path) > 0 && starts_with_prefix(module_path.clone(), prefix.clone()) {
            out = completion_items::append_item(out, completion_items::completion_item_json(module_path, 9, "module", text.clone(), String_new(), false))
        }
        j = j + 1
    }
    out
}

fn is_ident_char(ch: i32) -> bool {
    if ch >= 97 && ch <= 122 { return true }
    if ch >= 65 && ch <= 90 { return true }
    if ch >= 48 && ch <= 57 { return true }
    ch == 95
}

fn prefix_at_offset(text: String, offset: i32) -> String {
    let n = len(text)
    let mut end = offset
    if end > n { end = n }
    let mut start = end
    while start > 0 && is_ident_char(text.byte_at(start - 1)) {
        start = start - 1
    }
    text.slice(start, end)
}

pub fn collect_completion_items(state: LspState, text: String, offset: i32, prefix: String) -> String {
    let dot_items = dot_completion_items(text.clone(), offset)
    if len(dot_items) > 0 {
        return dot_items
    }
    let type_items = type_completion_items(state, text.clone(), offset, prefix.clone())
    if len(type_items) > 0 {
        return type_items
    }
    let use_items = use_completion_items(state, text.clone(), offset, prefix.clone())
    if len(use_items) > 0 {
        return use_items
    }
    let mut items = String_new()
    items = push_keywords(items, text.clone(), prefix.clone())
    items = push_stdlib(items, text.clone(), prefix.clone(), state)
    items = push_project(items, text.clone(), prefix.clone(), state)
    items
}
