//
// Central registry of deprecated module paths, prelude function names,
// and target aliases.  Used by lint::checks for W0009 and W0002.

// ── Deprecated module paths ─────────────────────────────────────────────

// Returns a non-empty replacement message if the `use` path is deprecated.
use std::prelude::{clone, eq}
pub fn deprecated_use_message(path: String) -> String {
    if eq(clone(path), "std::time") {
        return "import `use std::host::clock` and call `clock::monotonic_now()`"
    }
    if eq(clone(path), "std::fs") {
        return "module `std::fs` has moved to `std::host::fs`"
    }
    if eq(clone(path), "std::env") {
        return "module `std::env` has moved to `std::host::env`"
    }
    if eq(clone(path), "std::process") {
        return "module `std::process` has moved to `std::host::process`"
    }
    String_new()
}

// ── Deprecated bare prelude calls ──────────────────────────────────────

pub fn deprecated_call_message(name: String) -> String {
    let numeric = deprecated_numeric_call_message(clone(name))
    if len(numeric) > 0 {
        return numeric
    }
    let vec = deprecated_vec_call_message(clone(name))
    if len(vec) > 0 {
        return vec
    }
    let assertion = deprecated_assert_call_message(clone(name))
    if len(assertion) > 0 {
        return assertion
    }
    String_new()
}

// The stable must-delete wave converted 60 entries to `deprecated` under
// ADR-087. Their bare names warn here while they remain resolvable; physical
// deletion is Wave 2. `clear`, `map_option_String_String`, and
// `map_result_i32_i32` were stale non-callable entries and were retired
// directly; `i8_to_i32` is a deferral and stays stable.
fn deprecated_numeric_call_message(name: String) -> String {
    if eq(clone(name), "u8_to_i32") {
        return "use `(x).to_i32()` on the `u8` value instead"
    }
    if eq(clone(name), "u16_to_i32") {
        return "use `(x).to_i32()` on the `u16` value instead"
    }
    if eq(clone(name), "i16_to_i32") {
        return "use `(x).to_i32()` on the `i16` value instead"
    }
    if eq(clone(name), "i32_to_u8") {
        return "use `(x).to_u8_wrapping()` instead"
    }
    if eq(clone(name), "i32_to_u16") {
        return "use `(x).to_u16_wrapping()` instead"
    }
    if eq(clone(name), "i32_to_i8") {
        return "use `(x).to_i8_wrapping()` instead"
    }
    if eq(clone(name), "i32_to_i16") {
        return "use `(x).to_i16_wrapping()` instead"
    }
    if eq(clone(name), "u32_to_u64") {
        return "use `(x).to_u64()` instead"
    }
    if eq(clone(name), "u64_to_u32") {
        return "use `(x).to_u32_wrapping()` instead"
    }
    if eq(clone(name), "i32_to_i64") {
        return "use `(x).into()` instead"
    }
    if eq(clone(name), "i64_to_i32") {
        return "use `(x).to_i32_checked()` (or wrapping/saturating) instead"
    }
    if eq(clone(name), "f32_to_f64") {
        return "use `(x).to_f64()` instead"
    }
    if eq(clone(name), "f64_to_f32") {
        return "use `(x).to_f32()` instead"
    }
    if eq(clone(name), "i32_to_u32") {
        return "use `(x).to_u32_bits()` instead"
    }
    if eq(clone(name), "f64_bits_lo") {
        return "use `(x).to_bits_lo()` instead"
    }
    if eq(clone(name), "f64_bits_hi") {
        return "use `(x).to_bits_hi()` instead"
    }
    String_new()
}

// ── Deprecated qualified path calls (cmp::min → a.cmp(b)) ──────────────
fn deprecated_vec_call_message(name: String) -> String {
    if eq(clone(name), "push") {
        return "use the Vec method `v.push(x)` instead"
    }
    if eq(clone(name), "pop") {
        return "use the Vec method `v.pop()` instead"
    }
    if eq(clone(name), "len") {
        return "use the Vec/String method `v.len()` instead"
    }
    if eq(clone(name), "get") {
        return "use the Vec method `v.get(idx)` instead"
    }
    if eq(clone(name), "set") {
        return "use the Vec method `v.set(idx, val)` instead"
    }
    if eq(clone(name), "get_unchecked") {
        return "use the Vec method `v.get_unchecked(idx)` instead"
    }
    if eq(clone(name), "as_slice") {
        return "use the Vec method `v.as_slice(start, end)` instead"
    }
    if eq(clone(name), "slice_len") {
        return "use the Slice method `view.len()` instead"
    }
    if eq(clone(name), "slice_get") {
        return "use the Slice method `view.get(idx)` instead"
    }
    String_new()
}

fn deprecated_assert_call_message(name: String) -> String {
    if eq(clone(name), "assert_eq") {
        return "use `std::test::assert_eq_i32(actual, expected)` instead"
    }
    if eq(clone(name), "assert_ne") {
        return "use `std::test::assert_ne_i32(actual, unexpected)` instead"
    }
    if eq(clone(name), "assert_eq_i64") {
        return "use `std::test::assert_eq_i64(actual, expected)` instead"
    }
    if eq(clone(name), "assert_eq_str") {
        return "use `std::test::assert_eq_string(actual, expected)` instead"
    }
    String_new()
}

// ── Deprecated qualified path calls (math::abs_i32 → x.abs()) ──────────

// Returns a non-empty replacement message if the qualified path call is deprecated.
// `path` is the full qualified path, e.g. "seq::sum_i32" or "cmp::min".
pub fn deprecated_qualified_call_message(path: String) -> String {
    let msg2 = deprecated_cmp_qualified_message(path)
    if len(msg2) > 0 {
        return msg2
    }
    let msg3 = deprecated_convert_qualified_message(path)
    if len(msg3) > 0 {
        return msg3
    }
    let msg4 = deprecated_seq_qualified_message(path)
    if len(msg4) > 0 {
        return msg4
    }
    let msg5 = deprecated_io_qualified_message(path)
    if len(msg5) > 0 {
        return msg5
    }
    let msg6 = deprecated_bytes_qualified_message(path)
    if len(msg6) > 0 {
        return msg6
    }
    return deprecated_hash_qualified_message(path)
}

// ── Deprecated std::io tagged output writers (ADR-085 Phase F) ────────
//
// The Vec-layout reader / buffered / memory-writer wrappers were retired in
// Phase F (E0100 in resolver::removed_names). Only the tagged output pair
// survives, because stdout() / stderr() are still tagged Vec<i32> handles;
// their W0009 hint names the blocker instead of promising a method call that
// those handles cannot satisfy.
fn deprecated_io_qualified_message(path: String) -> String {
    if eq(clone(path), "io::writer_write") {
        return "stdout() / stderr() have no typed `Write` handle yet; use `w.write(data)` on `Writer` for memory handles (#693)"
    }
    if eq(clone(path), "io::writer_write_str") {
        return "stdout() / stderr() have no typed `Write` handle yet; use `w.write_string(s)` on `Writer` for memory handles (#693)"
    }
    String_new()
}

fn deprecated_cmp_qualified_message(path: String) -> String {
    // std::core::cmp free functions were removed; unresolved qualified calls
    // surface as E0100 paths, so no live warning entries remain here.
    String_new()
}

fn deprecated_convert_qualified_message(path: String) -> String {
    // std::core::convert *_to_string free functions were removed; unresolved
    // calls surface as E0100 with the resolver::removed_names hint.
    String_new()
}

// ── Deprecated std::seq helpers (ADR-076 / #703) ───────────────────────

// The compatibility helpers stay callable through `use std::seq` until the
// ADR-014 window closes.  They are keyed by the qualified call text because
// the bare names overlap the still-stable prelude frees (for example
// `sum_i32`), which must not warn before Wave 1 deprecates them.
fn deprecated_seq_qualified_message(path: String) -> String {
    if eq(clone(path), "seq::map_i32_i32") {
        return "use `v.iter().map(f).collect()` instead"
    }
    if eq(clone(path), "seq::filter_i32") {
        return "use `v.iter().filter(f).collect()` instead"
    }
    if eq(clone(path), "seq::take_i32") {
        return "use `v.iter().take(n).collect()` instead"
    }
    if eq(clone(path), "seq::skip_i32") {
        return "use `v.iter().skip(n).collect()` instead"
    }
    if eq(clone(path), "seq::fold_i32_i32") {
        return "use `v.iter().fold(init, f)` instead"
    }
    if eq(clone(path), "seq::binary_search") {
        return "use `std::seq::binary_search_by(v, target)` instead"
    }
    if eq(clone(path), "seq::min_i32") {
        return "use `std::seq::min_by(v)` instead"
    }
    if eq(clone(path), "seq::max_i32") {
        return "use `std::seq::max_by(v)` instead"
    }
    if eq(clone(path), "seq::sum_i32") {
        return "use `v.iter().sum()` instead"
    }
    if eq(clone(path), "seq::seq_reverse") {
        return "use `v.iter().rev().collect()` instead"
    }
    if eq(clone(path), "seq::seq_contains") {
        return "use `v.iter().contains(target)` instead"
    }
    if eq(clone(path), "seq::unique") {
        return "use `v.iter().unique().collect()` instead"
    }
    if eq(clone(path), "seq::count_eq") {
        return "use `v.iter().count_eq(target)` instead"
    }
    String_new()
}

// The stable std::text frees are deprecated under ADR-087 while their
// receiver / associated replacements are already available. The qualified
// alias is `text`; aliases of the removed `fmt` / `rope` helpers are no longer
// live calls and are covered by resolver::removed_names instead.
// ── Deprecated std::bytes free functions (ADR-087) ─────────────────────
//
// The method / associated surface landed in the 2026-10-27 bytes wave:
// byte-vector methods on `Vec<i32>` plus the `Bytes` namespace for
// receiver-less decoders/encoders. Free names stay callable through the
// 0.x window, so these entries are live W0009 warnings.
fn deprecated_bytes_qualified_message(path: String) -> String {
    if eq(clone(path), "bytes::bytes_new") { return String_from("use `Vec::new<i32>()` instead") }
    if eq(clone(path), "bytes::bytes_len") { return String_from("use `b.len()` on the byte vector instead") }
    if eq(clone(path), "bytes::bytes_get") { return String_from("use `b.get_unchecked(i)` instead") }
    if eq(clone(path), "bytes::bytes_push") { return String_from("use `b.push_byte(x)` instead") }
    if eq(clone(path), "bytes::bytes_eq") { return String_from("use `a.equals_bytes(b)` instead") }
    if eq(clone(path), "bytes::bytes_from_string") { return String_from("use `s.to_utf8_bytes()` on the `String` instead") }
    if eq(clone(path), "bytes::string_from_bytes") { return String_from("use `String::from_utf8_lossy(b)` instead") }
    if eq(clone(path), "bytes::bytes_concat") { return String_from("use `a.concat_bytes(b)` instead") }
    if eq(clone(path), "bytes::bytes_slice") { return String_from("use `b.slice_bytes(start, end)` instead") }
    if eq(clone(path), "bytes::byte_length") { return String_from("use `s.len_bytes()` on the `String` instead") }
    if eq(clone(path), "bytes::hex_encode") { return String_from("use `b.to_hex()` instead") }
    if eq(clone(path), "bytes::hex_decode") { return String_from("use `Bytes::from_hex(s)` via `use std::bytes::Bytes` instead") }
    if eq(clone(path), "bytes::leb128_encode_u32") { return String_from("use `Bytes::from_leb128_u32(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(path), "bytes::leb128_encode_i32") { return String_from("use `Bytes::from_leb128_i32(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(path), "bytes::u16_to_le_bytes") { return String_from("use `Bytes::from_u16_le(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(path), "bytes::u16_from_le_bytes") { return String_from("use `b.to_u16_le()` instead") }
    if eq(clone(path), "bytes::u32_to_le_bytes") { return String_from("use `Bytes::from_u32_le(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(path), "bytes::u32_from_le_bytes") { return String_from("use `b.to_u32_le()` instead") }
    if eq(clone(path), "bytes::u32_to_be_bytes") { return String_from("use `Bytes::from_u32_be(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(path), "bytes::u32_from_be_bytes") { return String_from("use `b.to_u32_be()` instead") }
    if eq(clone(path), "bytes::bytes_from_array") { return String_from("use `Bytes::from_array(xs)` via `use std::bytes::Bytes` instead") }
    if eq(clone(path), "bytes::buf_new") { return String_from("use `Vec::new<i32>()` instead") }
    if eq(clone(path), "bytes::buf_with_capacity") { return String_from("use `Vec::with_capacity<i32>(cap)` instead") }
    if eq(clone(path), "bytes::buf_push_u8") { return String_from("use `b.push_byte(x)` instead") }
    if eq(clone(path), "bytes::buf_push_u16_le") { return String_from("use `b.push_u16_le(x)` instead") }
    if eq(clone(path), "bytes::buf_push_u32_le") { return String_from("use `b.push_u32_le(x)` instead") }
    if eq(clone(path), "bytes::buf_push_u64_le") { return String_from("use `b.push_u64_le(x)` instead") }
    if eq(clone(path), "bytes::buf_extend") { return String_from("use `b.extend_bytes(other)` instead") }
    if eq(clone(path), "bytes::buf_freeze") { return String_from("use the buffer directly; `Bytes` and `ByteBuf` share the `Vec<i32>` layout") }
    if eq(clone(path), "bytes::buf_len") { return String_from("use `b.len()` on the byte vector instead") }
    if eq(clone(path), "bytes::cursor_new") { return String_from("use `data.byte_cursor()` instead") }
    if eq(clone(path), "bytes::cursor_pos") { return String_from("use `c.cursor_pos()` instead") }
    if eq(clone(path), "bytes::cursor_remaining") { return String_from("use `c.cursor_remaining()` instead") }
    if eq(clone(path), "bytes::read_u8") { return String_from("use `c.read_u8()` instead") }
    if eq(clone(path), "bytes::read_u16_le") { return String_from("use `c.read_u16_le()` instead") }
    if eq(clone(path), "bytes::read_u32_le") { return String_from("use `c.read_u32_le()` instead") }
    if eq(clone(path), "bytes::read_u64_le") { return String_from("use `c.read_u64_le()` instead") }
    if eq(clone(path), "bytes::read_u32_be") { return String_from("use `c.read_u32_be()` instead") }
    if eq(clone(path), "bytes::read_bytes") { return String_from("use `c.read_bytes(n)` instead") }
    if eq(clone(path), "bytes::base64_encode") { return String_from("use `b.to_base64()` instead") }
    if eq(clone(path), "bytes::base64_decode") { return String_from("use `Bytes::from_base64(s)` via `use std::bytes::Bytes` instead") }
    if eq(clone(path), "bytes::leb128_decode_u32") { return String_from("use `c.read_leb128_u32()` instead") }
    if eq(clone(path), "bytes::leb128_decode_i32") { return String_from("use `c.read_leb128_i32()` instead") }
    if eq(clone(path), "bytes::leb128_encode_u64") { return String_from("use `Bytes::from_leb128_u64(x)` via `use std::bytes::Bytes` instead") }
    if eq(clone(path), "bytes::leb128_decode_u64") { return String_from("use `c.read_leb128_u64()` instead") }
    String_new()
}

fn deprecated_hash_qualified_message(path: String) -> String {
    // std::core::hash only exposes 'combine'; removed names are covered by
    // resolver::removed_names instead of this live-call table.
    String_new()
}

test mod "deprecated" {
    test "std_io_import_no_longer_deprecated" {
        // ADR-085 D1: std::io is the canonical abstraction module, so a plain
        // `use std::io` must not emit the retired moved-to-host-stdio warning.
        assert(len(deprecated_use_message("std::io")) == 0)
    }
    test "fs" { assert(len(deprecated_use_message("std::fs")) > 0) }
    test "gated_prelude_names_not_double_warned" {
        // Gated prelude names fail resolution with E0100; W0009 must not
        // also fire on the same name.
        assert(len(deprecated_call_message("println")) == 0)
        assert(len(deprecated_call_message("concat")) == 0)
        assert(len(deprecated_call_message("char_at")) == 0)
    }
    test "math_helpers_removed" { assert(len(deprecated_qualified_call_message("math::popcount")) == 0) }
    test "non_deprecated" { assert(len(deprecated_qualified_call_message("math::gcd")) == 0) }
    test "seq_deprecated_helpers" {
        assert(len(deprecated_qualified_call_message("seq::map_i32_i32")) > 0)
        assert(len(deprecated_qualified_call_message("seq::filter_i32")) > 0)
        assert(len(deprecated_qualified_call_message("seq::take_i32")) > 0)
        assert(len(deprecated_qualified_call_message("seq::skip_i32")) > 0)
        assert(len(deprecated_qualified_call_message("seq::fold_i32_i32")) > 0)
        assert(len(deprecated_qualified_call_message("seq::binary_search")) > 0)
        assert(len(deprecated_qualified_call_message("seq::min_i32")) > 0)
        assert(len(deprecated_qualified_call_message("seq::max_i32")) > 0)
        assert(len(deprecated_qualified_call_message("seq::sum_i32")) > 0)
        assert(len(deprecated_qualified_call_message("seq::seq_reverse")) > 0)
        assert(len(deprecated_qualified_call_message("seq::seq_contains")) > 0)
        assert(len(deprecated_qualified_call_message("seq::unique")) > 0)
        assert(len(deprecated_qualified_call_message("seq::count_eq")) > 0)
    }
    test "seq_generic_helpers_not_deprecated" {
        assert(len(deprecated_qualified_call_message("seq::binary_search_by")) == 0)
        assert(len(deprecated_qualified_call_message("seq::binary_search_by_key")) == 0)
        assert(len(deprecated_qualified_call_message("seq::lower_bound")) == 0)
        assert(len(deprecated_qualified_call_message("seq::upper_bound")) == 0)
        assert(len(deprecated_qualified_call_message("seq::sort_by")) == 0)
        assert(len(deprecated_qualified_call_message("seq::min_by")) == 0)
        assert(len(deprecated_qualified_call_message("seq::max_by")) == 0)
        assert(len(deprecated_qualified_call_message("seq::min_by_key")) == 0)
        assert(len(deprecated_qualified_call_message("seq::max_by_key")) == 0)
    }
    test "numeric_frees_warn_w0009" {
        assert(len(deprecated_call_message("u8_to_i32")) > 0)
        assert(len(deprecated_call_message("u16_to_i32")) > 0)
        assert(len(deprecated_call_message("i16_to_i32")) > 0)
        assert(len(deprecated_call_message("i32_to_u8")) > 0)
        assert(len(deprecated_call_message("i32_to_u16")) > 0)
        assert(len(deprecated_call_message("i32_to_i8")) > 0)
        assert(len(deprecated_call_message("i32_to_i16")) > 0)
        assert(len(deprecated_call_message("u32_to_u64")) > 0)
        assert(len(deprecated_call_message("u64_to_u32")) > 0)
        assert(len(deprecated_call_message("i32_to_i64")) > 0)
        assert(len(deprecated_call_message("i64_to_i32")) > 0)
        assert(len(deprecated_call_message("f32_to_f64")) > 0)
        assert(len(deprecated_call_message("f64_to_f32")) > 0)
        assert(len(deprecated_call_message("i32_to_u32")) > 0)
        assert(len(deprecated_call_message("f64_bits_lo")) > 0)
        assert(len(deprecated_call_message("f64_bits_hi")) > 0)
    }
    test "vec_frees_warn_w0009" {
        assert(len(deprecated_call_message("push")) > 0)
        assert(len(deprecated_call_message("pop")) > 0)
        assert(len(deprecated_call_message("len")) > 0)
        assert(len(deprecated_call_message("get")) > 0)
        assert(len(deprecated_call_message("set")) > 0)
        assert(len(deprecated_call_message("get_unchecked")) > 0)
        assert(len(deprecated_call_message("as_slice")) > 0)
        assert(len(deprecated_call_message("slice_len")) > 0)
        assert(len(deprecated_call_message("slice_get")) > 0)
    }
    test "assert_frees_warn_w0009" {
        assert(len(deprecated_call_message("assert_eq")) > 0)
        assert(len(deprecated_call_message("assert_ne")) > 0)
        assert(len(deprecated_call_message("assert_eq_i64")) > 0)
        assert(len(deprecated_call_message("assert_eq_str")) > 0)
    }
    test "io_tagged_writers_warn_w0009" {
        assert(len(deprecated_qualified_call_message("io::writer_write")) > 0)
        assert(len(deprecated_qualified_call_message("io::writer_write_str")) > 0)
    }
    test "removed_io_frees_have_no_w0009_entry" {
        // These are E0100 removals; a live W0009 entry would be a dead warning.
        assert(len(deprecated_qualified_call_message("io::reader_read")) == 0)
        assert(len(deprecated_qualified_call_message("io::copy")) == 0)
        assert(len(deprecated_qualified_call_message("io::new_memory_buffer")) == 0)
        assert(len(deprecated_qualified_call_message("io::seek_to")) == 0)
        assert(len(deprecated_qualified_call_message("io::print_bytes")) == 0)
        assert(len(deprecated_qualified_call_message("io::reader_from_bytes")) == 0)
        assert(len(deprecated_qualified_call_message("io::buf_reader_new")) == 0)
        assert(len(deprecated_qualified_call_message("io::buffered_reader")) == 0)
        assert(len(deprecated_qualified_call_message("io::buf_reader_read_line")) == 0)
        assert(len(deprecated_qualified_call_message("io::buf_writer_new")) == 0)
        assert(len(deprecated_qualified_call_message("io::buffered_writer")) == 0)
        assert(len(deprecated_qualified_call_message("io::buf_writer_write_str")) == 0)
        assert(len(deprecated_qualified_call_message("io::buf_writer_flush")) == 0)
        assert(len(deprecated_qualified_call_message("io::writer_new")) == 0)
        assert(len(deprecated_qualified_call_message("io::write_all")) == 0)
        assert(len(deprecated_qualified_call_message("io::write_string")) == 0)
        assert(len(deprecated_qualified_call_message("io::writer_flush")) == 0)
        assert(len(deprecated_qualified_call_message("io::writer_to_bytes")) == 0)
    }

    test "removed_seq_frees_have_no_w0009_entry" {
        // These are E0100 removals (ADR-087 Wave 2); a live W0009 entry
        // would be a dead warning.
        assert(len(deprecated_call_message("sort_i32")) == 0)
        assert(len(deprecated_call_message("sum_i32")) == 0)
        assert(len(deprecated_call_message("map_option_i32_i32")) == 0)
        assert(len(deprecated_call_message("contains_string")) == 0)
        assert(len(deprecated_call_message("filter_i32")) == 0)
    }
    test "retired_stale_builtin_entries_are_not_warned" {
        // `clear`, `map_option_String_String`, and `map_result_i32_i32`
        // were stale non-callable builtin entries; they were retired with
        // their method replacements instead of being deprecated.
        assert(len(deprecated_call_message("clear")) == 0)
        assert(len(deprecated_call_message("map_option_String_String")) == 0)
        assert(len(deprecated_call_message("map_result_i32_i32")) == 0)
    }
    test "bytes_deprecated_frees_warn_w0009" {
        let names = Vec::new<String>()
        push(names, "bytes::bytes_new")
        push(names, "bytes::bytes_len")
        push(names, "bytes::bytes_get")
        push(names, "bytes::bytes_push")
        push(names, "bytes::bytes_eq")
        push(names, "bytes::bytes_from_string")
        push(names, "bytes::string_from_bytes")
        push(names, "bytes::bytes_concat")
        push(names, "bytes::bytes_slice")
        push(names, "bytes::byte_length")
        push(names, "bytes::hex_encode")
        push(names, "bytes::hex_decode")
        push(names, "bytes::leb128_encode_u32")
        push(names, "bytes::leb128_encode_i32")
        push(names, "bytes::u16_to_le_bytes")
        push(names, "bytes::u16_from_le_bytes")
        push(names, "bytes::u32_to_le_bytes")
        push(names, "bytes::u32_from_le_bytes")
        push(names, "bytes::u32_to_be_bytes")
        push(names, "bytes::u32_from_be_bytes")
        push(names, "bytes::bytes_from_array")
        push(names, "bytes::buf_new")
        push(names, "bytes::buf_with_capacity")
        push(names, "bytes::buf_push_u8")
        push(names, "bytes::buf_push_u16_le")
        push(names, "bytes::buf_push_u32_le")
        push(names, "bytes::buf_push_u64_le")
        push(names, "bytes::buf_extend")
        push(names, "bytes::buf_freeze")
        push(names, "bytes::buf_len")
        push(names, "bytes::cursor_new")
        push(names, "bytes::cursor_pos")
        push(names, "bytes::cursor_remaining")
        push(names, "bytes::read_u8")
        push(names, "bytes::read_u16_le")
        push(names, "bytes::read_u32_le")
        push(names, "bytes::read_u64_le")
        push(names, "bytes::read_u32_be")
        push(names, "bytes::read_bytes")
        push(names, "bytes::base64_encode")
        push(names, "bytes::base64_decode")
        push(names, "bytes::leb128_decode_u32")
        push(names, "bytes::leb128_decode_i32")
        push(names, "bytes::leb128_encode_u64")
        push(names, "bytes::leb128_decode_u64")
        let mut i = 0
        while i < len(names) {
            assert(len(deprecated_qualified_call_message(get_unchecked(names, i))) > 0)
            i = i + 1
        }
    }
