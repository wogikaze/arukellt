//
// Central registry of deprecated module paths, prelude function names,
// and target aliases.  Used by lint::checks for W0009 and W0002.

// ── Deprecated module paths (use std::io → use std::host::stdio) ───────

// Returns a non-empty replacement message if the `use` path is deprecated.
pub fn deprecated_use_message(path: String) -> String {
    if eq(clone(path), "std::io") {
        return "module `std::io` has moved to `std::host::stdio`"
    }
    if eq(clone(path), "std::time") {
        return "import `use std::host::clock` and call `clock::monotonic_now()`"
    }
    if eq(clone(path), "std::fs") {
        return "module `std::fs` has moved to `std::host::fs`"
    }
    if eq(clone(path), "std::env") {
        return "module `std::env` has moved to `std::host::env`"
    }
    if eq(clone(path), "std::process") {
        return "module `std::process` has moved to `std::host::process`"
    }
    String_new()
}

// ── Deprecated bare prelude calls (println → stdio::println) ───────────

// Returns a non-empty replacement message if the bare function name is deprecated.
pub fn deprecated_call_message(name: String) -> String {
    if eq(clone(name), "println") {
        return "import `use std::host::stdio` and call `stdio::println(...)`"
    }
    if eq(clone(name), "print") {
        return "import `use std::host::stdio` and call `stdio::print(...)`"
    }
    if eq(clone(name), "eprintln") {
        return "import `use std::host::stdio` and call `stdio::eprintln(...)`"
    }
    if eq(clone(name), "read_to_string") {
        return "import `use std::host::stdio` and call `stdio::read_stdin()`"
    }
    // Deprecated prelude free functions (issue #718, ADR-036)
    if eq(clone(name), "i32_to_string") {
        return "use `x.to_string()` (inherent method on i32) instead"
    }
    if eq(clone(name), "i64_to_string") {
        return "use `x.to_string()` (inherent method on i64) instead"
    }
    if eq(clone(name), "f64_to_string") {
        return "use `x.to_string()` (inherent method on f64) instead"
    }
    if eq(clone(name), "bool_to_string") {
        return "use `x.to_string()` (inherent method on bool) instead"
    }
    String_new()
}

// ── Deprecated qualified path calls (math::abs_i32 → x.abs()) ──────────

// Returns a non-empty replacement message if the qualified path call is deprecated.
// `path` is the full qualified path, e.g. "math::abs_i32" or "cmp::min".
pub fn deprecated_qualified_call_message(path: String) -> String {
    let msg = deprecated_math_qualified_message(path)
    if len(msg) > 0 {
        return msg
    }
    let msg2 = deprecated_cmp_qualified_message(path)
    if len(msg2) > 0 {
        return msg2
    }
    let msg3 = deprecated_convert_qualified_message(path)
    if len(msg3) > 0 {
        return msg3
    }
    return deprecated_hash_qualified_message(path)
}

fn deprecated_math_qualified_message(path: String) -> String {
    // std::core::math functions
    if eq(clone(path), "math::abs") {
        return "use `x.abs()` (inherent method on i32) instead"
    }
    if eq(clone(path), "math::abs_i32") {
        return "use `x.abs()` (inherent method on i32) instead"
    }
    if eq(clone(path), "math::min") {
        return "use `a.min(b)` (inherent method on i32) instead"
    }
    if eq(clone(path), "math::min_i32") {
        return "use `a.min(b)` (inherent method on i32) instead"
    }
    if eq(clone(path), "math::max") {
        return "use `a.max(b)` (inherent method on i32) instead"
    }
    if eq(clone(path), "math::max_i32") {
        return "use `a.max(b)` (inherent method on i32) instead"
    }
    if eq(clone(path), "math::sqrt") {
        return "use `x.sqrt()` (inherent method on f64) instead"
    }
    if eq(clone(path), "math::clamp") {
        return "use `x.clamp(lo, hi)` (inherent method on i32) instead"
    }
    if eq(clone(path), "math::pow_i32") {
        return "use `base.pow(exp)` (inherent method on i32) instead"
    }
    if eq(clone(path), "math::is_power_of_two") {
        return "use `n.is_power_of_two()` (Integer trait) instead"
    }
    if eq(clone(path), "math::next_power_of_two") {
        return "use `n.next_power_of_two()` (Integer trait) instead"
    }
    if eq(clone(path), "math::leading_zeros") {
        return "use `n.leading_zeros()` (Integer trait) instead"
    }
    if eq(clone(path), "math::trailing_zeros") {
        return "use `n.trailing_zeros()` (Integer trait) instead"
    }
    if eq(clone(path), "math::popcount") {
        return "use `n.popcount()` (Integer trait) instead"
    }
    String_new()
}

fn deprecated_cmp_qualified_message(path: String) -> String {
    // std::core::cmp functions
    if eq(clone(path), "cmp::cmp") {
        return "use `a.cmp(b)` (Ord trait method) instead"
    }
    if eq(clone(path), "cmp::min") {
        return "use `a.min(b)` (inherent method on i32) instead"
    }
    if eq(clone(path), "cmp::max") {
        return "use `a.max(b)` (inherent method on i32) instead"
    }
    if eq(clone(path), "cmp::clamp") {
        return "use `x.clamp(lo, hi)` (inherent method on i32) instead"
    }
    String_new()
}

fn deprecated_convert_qualified_message(path: String) -> String {
    // std::core::convert functions
    if eq(clone(path), "convert::i32_to_string") {
        return "use `x.to_string()` (inherent method on i32) instead"
    }
    if eq(clone(path), "convert::i64_to_string") {
        return "use `x.to_string()` (inherent method on i64) instead"
    }
    if eq(clone(path), "convert::f64_to_string") {
        return "use `x.to_string()` (inherent method on f64) instead"
    }
    if eq(clone(path), "convert::bool_to_string") {
        return "use `x.to_string()` (inherent method on bool) instead"
    }
    String_new()
}

fn deprecated_hash_qualified_message(path: String) -> String {
    // std::core::hash functions
    if eq(clone(path), "hash::hash_i32") {
        return "use `value.hash()` (Hash trait method) instead"
    }
    if eq(clone(path), "hash::hash_string") {
        return "use `value.hash()` (Hash trait method) instead"
    }
    if eq(clone(path), "hash::hash_combine") {
        return "use `combine(h1, h2)` instead"
    }
    String_new()
}

test mod "deprecated" {
    test "io" { assert(len(deprecated_use_message("std::io")) > 0) }
    test "fs" { assert(len(deprecated_use_message("std::fs")) > 0) }
    test "println" { assert(len(deprecated_call_message("println")) > 0) }
    test "i32_to_string" { assert(len(deprecated_call_message("i32_to_string")) > 0) }
    test "math_abs_i32" { assert(len(deprecated_qualified_call_message("math::abs_i32")) > 0) }
    test "math_popcount" { assert(len(deprecated_qualified_call_message("math::popcount")) > 0) }
    test "cmp_cmp" { assert(len(deprecated_qualified_call_message("cmp::cmp")) > 0) }
    test "hash_i32" { assert(len(deprecated_qualified_call_message("hash::hash_i32")) > 0) }
    test "non_deprecated" { assert(len(deprecated_qualified_call_message("math::gcd")) == 0) }
}
