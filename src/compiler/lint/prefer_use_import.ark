//
// When a module-style qualified path (snake_case::symbol) appears many times
// in one file, recommend importing via `use` and calling the short name.
// Type/enum qualifiers (PascalCase::...) are excluded.

use std::text
use diagnostics::codes
use diagnostics::record
use parser::ast
use resolver::ast_access
use resolver::ast_expr_predicates
use resolver::paths
use diagnostics::mod as diag_mod
fn prefer_use_import_threshold() -> i32 { 3 }

fn is_module_style_qualified_path(path: String) -> bool {
    let pos = path.clone().index_of("::")
    if pos < 0 {
        return false
    }
    let mod_part = paths::path_module_part(path.clone())
    if mod_part.clone().len() == 0 {
        return false
    }
    let sym_part = paths::path_symbol_part(path.clone())
    if sym_part.clone().len() == 0 {
        return false
    }
    let c = mod_part.byte_at(0)
    if c == 95 {
        return true
    }
    if c < 97 {
        return false
    }
    if c > 122 {
        return false
    }
    true
}

fn collect_paths(node: AstNode, mut paths: Vec<String>, mut starts: Vec<i32>, mut ends: Vec<i32>) {
    if ast_expr_predicates::node_is_path(node) {
        let path = ast_access::node_text(node)
        if is_module_style_qualified_path(path.clone()) {
            push(paths, path)
            push(starts, ast_access::node_span_start(node))
            push(ends, ast_access::node_span_end(node))
        }
        return
    }
    let n = ast_access::node_child_count(node)
    let mut i = 0
    while i < n {
        collect_paths(ast_access::node_child_at(node, i), paths, starts, ends)
        i = i + 1
    }
}

fn path_seen_before(paths: Vec<String>, path: String, before: i32) -> bool {
    let mut j = 0
    while j < before {
        if get_unchecked(paths, j).clone().eq(path.clone()) {
            return true
        }
        j = j + 1
    }
    false
}

fn count_same_path(paths: Vec<String>, path: String) -> i32 {
    let n = paths.len()
    let mut uses = 0
    let mut k = 0
    while k < n {
        if get_unchecked(paths, k).clone().eq(path.clone()) {
            uses = uses + 1
        }
        k = k + 1
    }
    uses
}

pub fn check_prefer_use_import(decls: Vec<AstNode>) -> Vec<Diagnostic> {
    let mut warnings = Vec::new<Diagnostic>()
    let mut paths = Vec::new<String>()
    let mut starts = Vec::new<i32>()
    let mut ends = Vec::new<i32>()
    let dn = decls.len()
    let mut di = 0
    while di < dn {
        collect_paths(get_unchecked(decls, di), paths, starts, ends)
        di = di + 1
    }
    let threshold = prefer_use_import_threshold()
    let n = paths.len()
    let mut i = 0
    while i < n {
        let path = get_unchecked(paths, i).clone()
        if path_seen_before(paths, path.clone(), i) {
            i = i + 1
            continue
        }
        let uses = count_same_path(paths, path.clone())
        if uses >= threshold {
            let msg = "qualified path `".concat(path.clone()).concat("` used repeatedly; prefer `use` and call the short name")
            let span = record::DiagnosticSpan_from_raw(get_unchecked(starts, i), get_unchecked(ends, i))
            push(warnings, diag_mod::Diagnostic_new(codes::DIAG_WARN_PREFER_USE_IMPORT(), diag_mod::SEV_WARNING(), span, msg))
        }
        i = i + 1
    }
    warnings
}
