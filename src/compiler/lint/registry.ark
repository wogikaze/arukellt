//
// Defines all lint rules with id, severity, category, and description.
// Used by `arukellt lint --list` and severity override filtering.
use std::text
use diagnostics::codes
use diagnostics::severity
fn LINT_ALLOW() -> i32 {
    0
}

fn LINT_WARN() -> i32 {
    1
}

fn LINT_DENY() -> i32 {
    2
}

// Lint categories.
fn CAT_CORRECTNESS() -> String {
    "correctness"
}

fn CAT_STYLE() -> String {
    "style"
}

fn CAT_MIGRATION() -> String {
    "migration"
}

fn CAT_PERFORMANCE() -> String {
    "performance"
}

fn CAT_DOCS() -> String {
    "docs"
}

struct LintRule {
    code: String,
    name: String,
    default_severity: i32,
    category: String,
    description: String,
}

fn LintRule_new(code: String, name: String, default_severity: i32, category: String, description: String) -> LintRule {
    LintRule { code: code, name: name, default_severity: default_severity, category: category, description: description }
}

fn lint_rule_code(rule: LintRule) -> String {
    rule.code.clone()
}

fn lint_rule_name(rule: LintRule) -> String {
    rule.name.clone()
}

fn lint_rule_default_severity(rule: LintRule) -> i32 {
    rule.default_severity
}

fn lint_rule_category(rule: LintRule) -> String {
    rule.category.clone()
}

fn lint_rule_description(rule: LintRule) -> String {
    rule.description.clone()
}

// Total number of registered lint rules.
fn lint_rule_count() -> i32 {
    12
}

// Return the LintRule at the given index (0-based).
fn lint_rule_at(index: i32) -> LintRule {
    if index == 0 {
        return LintRule_new(codes::DIAG_WARN_SHARED_MUT_ALIAS(), "shared-mut-alias", LINT_WARN(), CAT_CORRECTNESS(), "possible unintended sharing of reference type")
    }
    if index == 1 {
        return LintRule_new(codes::DIAG_WARN_DEPRECATED_TARGET_ALIAS(), "deprecated-target-alias", LINT_WARN(), CAT_MIGRATION(), "deprecated target alias")
    }
    if index == 2 {
        return LintRule_new(codes::DIAG_WARN_UNUSED_SYMBOL(), "unused-symbol", LINT_WARN(), CAT_STYLE(), "unused symbol")
    }
    if index == 3 {
        return LintRule_new(codes::DIAG_WARN_WASM_VALIDATION(), "wasm-validation", LINT_DENY(), CAT_CORRECTNESS(), "generated Wasm module failed validation")
    }
    if index == 4 {
        return LintRule_new(codes::DIAG_WARN_CAPABILITY_STUB(), "capability-stub", LINT_WARN(), CAT_CORRECTNESS(), "non-exportable function skipped from component exports")
    }
    if index == 5 {
        return LintRule_new(codes::DIAG_WARN_UNUSED_IMPORT(), "unused-import", LINT_WARN(), CAT_STYLE(), "unused import")
    }
    if index == 6 {
        return LintRule_new(codes::DIAG_WARN_UNUSED_BINDING(), "unused-binding", LINT_WARN(), CAT_STYLE(), "unused binding")
    }
    if index == 7 {
        return LintRule_new(codes::DIAG_WARN_DOC_DRIFT(), "doc-drift", LINT_WARN(), CAT_DOCS(), "documentation drift")
    }
    if index == 8 {
        return LintRule_new(codes::DIAG_WARN_DEPRECATED_API(), "deprecated-api", LINT_WARN(), CAT_MIGRATION(), "deprecated API usage")
    }
    if index == 9 {
        return LintRule_new(codes::DIAG_WARN_PREFER_USE_IMPORT(), "prefer-use-import", LINT_WARN(), CAT_STYLE(), "prefer use import for frequently qualified paths")
    }
    if index == 10 {
        return LintRule_new(codes::DIAG_WARN_PREFER_ELSE_IF(), "prefer-else-if", LINT_WARN(), CAT_STYLE(), "prefer else-if over nested else { if }")
    }
    LintRule_new(codes::DIAG_WARN_COMPONENT_LOWERING_NOTE(), "component-lowering-note", LINT_WARN(), CAT_DOCS(), "component lowering note")
}

// Look up a lint rule by its W-code string. Returns -1 if not found.
fn lint_rule_index_by_code(code: String) -> i32 {
    let count = lint_rule_count()
    let mut i = 0
    while i < count {
        if lint_rule_code(lint_rule_at(i)).eq(code.clone()) {
            return i
        }
        i = i + 1
    }
    -1
}

// Look up a lint rule by its short name (e.g. "unused-import"). Returns -1 if not found.
fn lint_rule_index_by_name(name: String) -> i32 {
    let count = lint_rule_count()
    let mut i = 0
    while i < count {
        if lint_rule_name(lint_rule_at(i)).eq(name.clone()) {
            return i
        }
        i = i + 1
    }
    -1
}

// Format a single lint rule as a list line: "  W0006  unused-import      warn  style  unused import".
fn format_lint_rule_line(rule: LintRule) -> String {
    let mut out = "  "
    out = out.concat(lint_rule_code(rule))
    out = out.concat("  ")
    out = out.concat(lint_rule_name(rule))
    out = out.concat("  ")
    out = out.concat(severity_label(lint_rule_default_severity(rule)))
    out = out.concat("  ")
    out = out.concat(lint_rule_category(rule))
    out = out.concat("  ")
    out = out.concat(lint_rule_description(rule))
    out
}

fn severity_label(sev: i32) -> String {
    if sev == LINT_ALLOW() {
        return "allow"
    }
    if sev == LINT_DENY() {
        return "deny"
    }
    "warn"
}

// Format the full `arukellt lint --list` output.
pub fn format_lint_rule_list() -> String {
    let mut out = "lint rules:\n"
    let count = lint_rule_count()
    let mut i = 0
    while i < count {
        out = out.concat(format_lint_rule_line(lint_rule_at(i)))
        out = out.concat("\n")
        i = i + 1
    }
    out
}

// Resolve the effective severity for a diagnostic code given allow/deny overrides.
// Returns LINT_ALLOW (suppress), LINT_WARN (default), or LINT_DENY (error).
pub fn effective_severity(code: String, allow_codes: Vec<String>, deny_codes: Vec<String>) -> i32 {
    let allow_count = allow_codes.len()
    let mut ai = 0
    while ai < allow_count {
        if get_unchecked(allow_codes, ai).clone().eq(code.clone()) {
            return LINT_ALLOW()
        }
        ai = ai + 1
    }
    let deny_count = deny_codes.len()
    let mut di = 0
    while di < deny_count {
        if get_unchecked(deny_codes, di).clone().eq(code.clone()) {
            return LINT_DENY()
        }
        di = di + 1
    }
    let idx = lint_rule_index_by_code(code.clone())
    if idx < 0 {
        return LINT_WARN()
    }
    lint_rule_default_severity(lint_rule_at(idx))
}

// Check whether a diagnostic should be suppressed (allow).
// Matches either by W-code (e.g. "W0006") or by rule name (e.g. "unused-import").
pub fn should_suppress(code: String, allow_codes: Vec<String>) -> bool {
    let count = allow_codes.len()
    let mut i = 0
    while i < count {
        let entry = get_unchecked(allow_codes, i)
        if entry.clone().eq(code.clone()) {
            return true
        }
        let resolved = resolve_rule_code(entry.clone())
        if resolved.clone().len() > 0 && resolved.clone().eq(code.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

// Check whether a diagnostic should be escalated to an error (deny).
// Matches either by W-code (e.g. "W0006") or by rule name (e.g. "unused-import").
pub fn should_deny(code: String, deny_codes: Vec<String>) -> bool {
    let count = deny_codes.len()
    let mut i = 0
    while i < count {
        let entry = get_unchecked(deny_codes, i)
        if entry.clone().eq(code.clone()) {
            return true
        }
        let resolved = resolve_rule_code(entry.clone())
        if resolved.clone().len() > 0 && resolved.clone().eq(code.clone()) {
            return true
        }
        i = i + 1
    }
    false
}

// Resolve a CLI --allow/--deny argument (either a W-code or a rule name) to a W-code.
// Returns empty string if not recognized.
pub fn resolve_rule_code(arg: String) -> String {
    let idx = lint_rule_index_by_code(arg.clone())
    if idx >= 0 {
        return lint_rule_code(lint_rule_at(idx))
    }
    let name_idx = lint_rule_index_by_name(arg.clone())
    if name_idx >= 0 {
        return lint_rule_code(lint_rule_at(name_idx))
    }
    String_new()
}
// Lint severity levels: Allow (suppress), Warn (default), Deny (escalate to error).
// Direct W-code match
// Rule name match: resolve the name to a W-code and compare
