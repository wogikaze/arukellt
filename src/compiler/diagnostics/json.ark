//
// Uses std::json JsonValue DOM for structured JSON construction.

use std::json::parser
use diagnostics::record
use diagnostics::severity

fn diagnostic_span_to_json(span: DiagnosticSpan) -> String {
    let mut fields = Vec::new<parser::JsonField>()
    fields.push(parser::JsonField::new("file", parser::JsonValue::string(record::diagnostic_span_file(span))))
    fields.push(parser::JsonField::new("line", parser::JsonValue::int(record::diagnostic_span_line(span))))
    fields.push(parser::JsonField::new("col", parser::JsonValue::int(record::diagnostic_span_column(span))))
    fields.push(parser::JsonField::new("start", parser::JsonValue::int(record::diagnostic_span_start(span))))
    fields.push(parser::JsonField::new("end", parser::JsonValue::int(record::diagnostic_span_end(span))))
    parser::JsonValue::object(fields).to_text()
}

fn diagnostic_to_json(diag: Diagnostic) -> String {
    let mut fields = Vec::new<parser::JsonField>()
    fields.push(parser::JsonField::new("code", parser::JsonValue::string(record::diagnostic_code(diag))))
    fields.push(parser::JsonField::new("severity", parser::JsonValue::string(severity::severity_name(record::diagnostic_severity(diag)))))
    fields.push(parser::JsonField::new("span", parser::JsonValue::raw(diagnostic_span_to_json(record::diagnostic_span(diag)))))
    fields.push(parser::JsonField::new("message", parser::JsonValue::string(record::diagnostic_message(diag))))
    parser::JsonValue::object(fields).to_text()
}
