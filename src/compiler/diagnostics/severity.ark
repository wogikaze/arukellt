fn SEV_ERROR() -> i32 {
    1
}

fn SEV_WARNING() -> i32 {
    2
}

fn SEV_NOTE() -> i32 {
    3
}

fn severity_name(sev: i32) -> String {
    if sev == SEV_ERROR() {
        return "error"
    }
    if sev == SEV_WARNING() {
        return "warning"
    }
    if sev == SEV_NOTE() {
        return "note"
    }
    "unknown"
}
