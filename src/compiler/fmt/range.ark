use std::text
use fmt::program
use fmt::whitespace

fn fmt_line_count(text: String) -> i32 {
    whitespace::fmt_split_lines(text).len()
}

fn fmt_snap_line_start(line: i32) -> i32 {
    if line < 0 {
        return 0
    }
    line
}

fn fmt_snap_line_end(line: i32, max_line: i32) -> i32 {
    if line > max_line {
        return max_line
    }
    if line < 0 {
        return 0
    }
    line
}

fn fmt_extract_line_range(text: String, start_line: i32, end_line: i32) -> String {
    let lines = whitespace::fmt_split_lines(text.clone())
    let max_line = lines.len() - 1
    let start = fmt_snap_line_start(start_line)
    let end = fmt_snap_line_end(end_line, max_line)
    let mut out = String_new()
    let mut i = start
    while i <= end && i < lines.len() {
        if i > start {
            out = out.concat("\n")
        }
        out = out.concat(lines.get_unchecked(i).clone())
        i = i + 1
    }
    if end < max_line {
        out = out.concat("\n")
    }
    out
}

fn fmt_replace_line_range(text: String, start_line: i32, end_line: i32, replacement: String) -> String {
    let lines = whitespace::fmt_split_lines(text.clone())
    let max_line = lines.len() - 1
    let start = fmt_snap_line_start(start_line)
    let end = fmt_snap_line_end(end_line, max_line)
    let mut out = String_new()
    let mut i = 0
    while i < start && i < lines.len() {
        if i > 0 {
            out = out.concat("\n")
        }
        out = out.concat(lines.get_unchecked(i).clone())
        i = i + 1
    }
    if replacement.len() > 0 {
        if start > 0 {
            out = out.concat("\n")
        }
        out = out.concat(replacement.clone())
    }
    for j in (end + 1)..lines.len() {
        out = out.concat("\n")
        out = out.concat(lines.get_unchecked(j).clone())
    }
    if lines.len() > 0 {
        out = out.concat("\n")
    }
    out
}

fn fmt_range_format(input: String, start_line: i32, end_line: i32) -> Option<String> {
    let formatted = match program::fmt_format_source(input.clone()) {
        Option::None => {
            return Option::None
        },
        Option::Some(text) => {
            text
        },
    }
    let original_region = fmt_extract_line_range(input.clone(), start_line, end_line)
    let formatted_region = fmt_extract_line_range(formatted.clone(), start_line, end_line)
    if original_region == formatted_region {
        return Option::Some(input.clone())
    }
    Option::Some(fmt_replace_line_range(input, start_line, end_line, formatted_region))
}
