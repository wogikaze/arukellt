use std::text
use fmt::import_block
use fmt::parse_gate
use resolver
use resolver::ast_access
use resolver::ast_decl_predicates
struct PruneImportEntry {
    line_start: i32,
    line_end: i32,
    path: String,
    sort_group: i32,
    has_alias: bool,
}

fn prune_import_entry_new(line_start: i32, line_end: i32, path: String, sort_group: i32, has_alias: bool) -> PruneImportEntry {
    PruneImportEntry { line_start: line_start, line_end: line_end, path: path, sort_group: sort_group, has_alias: has_alias }
}

fn prune_import_sort_group(path: String, has_alias: bool) -> i32 {
    if has_alias {
        return 2
    }
    if path.clone().starts_with("std::") {
        return 0
    }
    1
}

fn prune_import_line_end(text: String, line_start: i32) -> i32 {
    let n = text.len()
    let mut i = line_start
    while i < n && text.byte_at(i) != 10 {
        i = i + 1
    }
    if i < n {
        return i + 1
    }
    i
}

fn path_symbol_part(path: String) -> String {
    let pos = path.clone().index_of("::")
    if pos < 0 {
        return String_new()
    }
    path.slice(pos + 2, path.len())
}

fn is_ident_char(ch: i32) -> bool {
    if ch >= 97 && ch <= 122 { return true }
    if ch >= 65 && ch <= 90 { return true }
    if ch >= 48 && ch <= 57 { return true }
    ch == 95
}

fn contains_ident_usage(body: String, name: String) -> bool {
    let name_len = name.len()
    if name_len == 0 {
        return false
    }
    let n = body.len()
    let mut i = 0
    while i <= n - name_len {
        if body.clone().slice(i, i + name_len) == name {
            let before_ok = i == 0 || !is_ident_char(body.byte_at(i - 1))
            let after_ok = i + name_len >= n || !is_ident_char(body.byte_at(i + name_len))
            if before_ok && after_ok {
                return true
            }
        }
        i = i + 1
    }
    false
}

fn import_is_used(path: String, body: String) -> bool {
    let sym = path_symbol_part(path.clone())
    if sym.len() > 0 {
        return contains_ident_usage(body.clone(), sym)
    }
    let short = resolver::use_module_short_name(path.clone())
    let needle = short.clone().concat("::")
    if body.clone().index_of(needle) >= 0 {
        return true
    }
    contains_ident_usage(body.clone(), short)
}

fn collect_prune_import_entries(text: String, decls: Vec<AstNode>) -> Vec<PruneImportEntry> {
    let mut out = Vec::new<PruneImportEntry>()
    let n = decls.len()
    let mut i = 0
    while i < n {
        let d = decls.get_unchecked(i)
        if ast_decl_predicates::node_is_use(d) || ast_decl_predicates::node_is_import(d) {
            let path = ast_access::node_text(d)
            let has_alias = ast_access::node_type_ann_count(d) > 0
            let line_start = ast_access::node_span_start(d)
            let mut line_begin = line_start
            while line_begin > 0 && text.byte_at(line_begin - 1) != 10 {
                line_begin = line_begin - 1
            }
            let line_end = prune_import_line_end(text.clone(), line_begin)
            let group = prune_import_sort_group(path.clone(), has_alias)
            push(out, prune_import_entry_new(line_begin, line_end, path, group, has_alias))
        }
        i = i + 1
    }
    out
}

fn body_after_imports(text: String, entries: Vec<PruneImportEntry>) -> String {
    let en = entries.len()
    if en == 0 {
        return text.clone()
    }
    let mut last_end = 0
    let mut i = 0
    while i < en {
        let end = entries.get_unchecked(i).line_end
        if end > last_end {
            last_end = end
        }
        i = i + 1
    }
    text.slice(last_end, text.len())
}

fn pruned_import_text(text: String, entries: Vec<PruneImportEntry>) -> String {
    let body = body_after_imports(text.clone(), entries)
    let en = entries.len()
    let mut out = String_new()
    let mut group = 0
    while group <= 2 {
        let mut i = 0
        while i < en {
            let entry = entries.get_unchecked(i)
            if entry.sort_group == group && import_is_used(entry.path.clone(), body.clone()) {
                let line = text.clone().slice(entry.line_start, entry.line_end)
                out = out.concat(line)
            }
            i = i + 1
        }
        group = group + 1
    }
    out
}

fn import_block_bounds(entries: Vec<PruneImportEntry>) -> ImportBlockSpan {
    let en = entries.len()
    let mut first_start = entries.get_unchecked(0).line_start
    let mut last_end = entries.get_unchecked(0).line_end
    let mut i = 1
    while i < en {
        let entry = entries.get_unchecked(i)
        if entry.line_start < first_start {
            first_start = entry.line_start
        }
        if entry.line_end > last_end {
            last_end = entry.line_end
        }
        i = i + 1
    }
    import_block::ImportBlockSpan_new(first_start, last_end)
}

fn apply_pruned_imports(text: String, entries: Vec<PruneImportEntry>) -> String {
    let block = import_block_bounds(entries)
    let pruned = pruned_import_text(text.clone(), entries)
    text.clone().slice(0, import_block::ImportBlockSpan_start(block)).concat(pruned).concat(text.slice(import_block::ImportBlockSpan_end(block), text.len()))
}

fn pruned_import_block(input: String) -> Option<String> {
    let gate = parse_gate::fmt_parse_gate(input.clone())
    if parse_gate::fmt_parse_gate_error_count(gate) > 0 {
        return Option::None
    }
    let entries = collect_prune_import_entries(input.clone(), parse_gate::fmt_parse_gate_decls(gate))
    if entries.len() == 0 {
        return Option::Some(String_new())
    }
    Option::Some(pruned_import_text(input, entries))
}

fn import_block_span_value(input: String) -> Option<import_block::ImportBlockSpan> {
    let gate = parse_gate::fmt_parse_gate(input.clone())
    if parse_gate::fmt_parse_gate_error_count(gate) > 0 {
        return Option::None
    }
    let entries = collect_prune_import_entries(input.clone(), parse_gate::fmt_parse_gate_decls(gate))
    if entries.len() == 0 {
        return Option::None
    }
    Option::Some(import_block_bounds(entries))
}

fn prune_imports_source(input: String) -> Option<String> {
    let gate = parse_gate::fmt_parse_gate(input.clone())
    if parse_gate::fmt_parse_gate_error_count(gate) > 0 {
        return Option::None
    }
    let entries = collect_prune_import_entries(input.clone(), parse_gate::fmt_parse_gate_decls(gate))
    if entries.len() == 0 {
        return Option::Some(input.clone())
    }
    Option::Some(apply_pruned_imports(input, entries))
}
