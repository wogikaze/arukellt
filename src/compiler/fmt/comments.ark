use fmt::whitespace

fn fmt_is_full_line_comment(trimmed: String) -> bool {
    trimmed.len() >= 2 && trimmed.byte_at(0) == 47 && trimmed.byte_at(1) == 47
}

fn fmt_line_starts_block_comment(trimmed: String) -> bool {
    trimmed.clone().index_of("/*") >= 0
}

fn fmt_preserve_comment_lines(lines: Vec<String>) -> Vec<String> {
    let n = lines.len()
    let mut out = Vec::new<String>()
    let mut i = 0
    while i < n {
        let raw = get_unchecked(lines, i)
        let trimmed = whitespace::fmt_normalize_line(raw)
        if fmt_is_full_line_comment(trimmed.clone()) || fmt_line_starts_block_comment(trimmed.clone()) {
            out.push(trimmed)
        } else {
            out.push(raw)
        }
        i = i + 1
    }
    out
}
