use std::text

fn fmt_normalize_line(line: String) -> String {
    let n = line.clone().len()
    let mut end = n
    while end > 0 {
        let c = line.clone().byte_at(end - 1)
        if c != 32 && c != 9 {
            break
        }
        end = end - 1
    }
    let mut result = String_new()
    let mut pos = 0
    while pos < end {
        let c = line.clone().byte_at(pos)
        if c == 9 {
            result = result.concat("    ")
        } else {
            result = result.concat(line.clone().slice(pos, pos + 1))
        }
        pos = pos + 1
    }
    result
}

fn fmt_collapse_blank_lines(lines: Vec<String>) -> Vec<String> {
    let line_count = lines.len()
    let mut out_lines = Vec::new<String>()
    let mut prev_blank = false
    let mut j = 0
    while j < line_count {
        let raw = get_unchecked(lines, j)
        let processed = fmt_normalize_line(raw)
        let is_blank = processed.len() == 0
        if !(is_blank && prev_blank) {
            out_lines.push(processed)
        }
        prev_blank = is_blank
        j = j + 1
    }
    out_lines
}

fn fmt_join_lines(lines: Vec<String>) -> String {
    let mut end = lines.len()
    while end > 0 {
        let last = get_unchecked(lines, end - 1)
        if last.len() == 0 {
            end = end - 1
        } else {
            break
        }
    }
    let mut result = String_new()
    let mut k = 0
    while k < end {
        if k > 0 {
            result = result.concat("\n")
        }
        result = result.concat(get_unchecked(lines, k).clone())
        k = k + 1
    }
    result = result.concat("\n")
    result
}

fn fmt_split_lines(input: String) -> Vec<String> {
    let mut lines = Vec::new<String>()
    let n = input.clone().len()
    let mut start = 0
    let mut i = 0
    while i < n {
        if input.clone().byte_at(i) == 10 {
            lines.push(input.clone().slice(start, i))
            start = i + 1
        }
        i = i + 1
    }
    lines.push(input.clone().slice(start, n))
    lines
}
